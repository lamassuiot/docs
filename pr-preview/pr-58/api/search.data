331,"_44334":64334,"_44336":64337,"_44338":64340,"_44340":64343,"_44342":64346,"_44344":64349,"_44346":64352,"_44348":64355,"_44350":64358,"_44352":64361,"_44354":64364,"_44356":64367,"_44358":64370,"_44360":64373,"_44362":64376,"_44364":64379,"_44366":64382,"_44368":64385,"_44370":64388,"_44372":64391,"_44374":64394,"_44376":64397,"_44378":64400,"_44381":64403,"_44383":64406,"_44385":64409,"_44388":64412,"_44390":64415,"_44392":64418,"_44394":64421,"_44396":64424,"_44398":64427,"_44400":64430,"_44402":64433,"_44404":64436,"_44406":64439,"_44408":64442,"_44410":64445,"_44412":64448,"_44414":64451,"_44416":64454,"_44418":64457,"_44420":64460,"_44422":64463,"_44424":64466,"_44426":64469,"_44428":64472,"_44430":64475,"_44432":64478,"_44434":64481,"_44436":64484,"_44438":64487,"_44440":64490,"_44442":64493,"_44444":64496,"_44446":64499,"_44448":64502,"_44450":64505,"_44452":64508,"_44454":64511,"_44456":64514,"_44458":64517,"_44460":64520,"_44462":64523,"_44464":64526,"_44466":64529,"_44468":64532,"_44470":64535,"_44472":64538,"_44474":64541,"_44476":64544,"_44478":64547,"_44480":64550,"_44482":64553},{"_3844":15,"_33198":15,"_5":16006,"_3297":54400,"_33604":54401,"_22654":54405,"_29907":15},"Deploy from AWS Marketplace",[54402,54403,54404],"Docs","Deployment","Other models",[],{"_3844":16,"_33198":15,"_22654":54407,"_5":15607,"_29907":15,"_3297":54408},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3844":17,"_33198":15,"_5":33601,"_22654":54410,"_29907":54411,"_3297":54412},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3844":18,"_33198":15,"_5":33601,"_22654":54414,"_29907":54415,"_3297":54416},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3844":19,"_33198":15,"_5":33601,"_22654":54418,"_29907":54419,"_3297":54420},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3844":20,"_33198":15,"_5":33601,"_22654":54422,"_29907":54423,"_3297":54424},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3844":21,"_33198":15,"_5":33601,"_22654":54426,"_29907":54427,"_3297":54428},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3844":22,"_33198":15,"_5":33601,"_22654":54430,"_29907":54431,"_3297":54432},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3844":23,"_33198":15,"_5":33601,"_22654":54434,"_29907":54435,"_3297":54436},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#next-step","Next step",{"_3844":24,"_33198":15,"_22654":54438,"_5":15607,"_29907":15,"_3297":54439},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3844":25,"_33198":15,"_22654":54441,"_5":15607,"_29907":54411,"_3297":54442},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3844":26,"_33198":15,"_22654":54444,"_5":15607,"_29907":54411,"_3297":54445},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3844":27,"_33198":15,"_22654":54447,"_5":15607,"_29907":54411,"_3297":54448},[],"A security group allowing the necessary endpoints.",{"_3844":28,"_33198":15,"_22654":54450,"_5":15607,"_29907":54415,"_3297":54451},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3844":29,"_33198":15,"_22654":54453,"_5":15607,"_29907":54415,"_3297":54454},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3844":30,"_33198":15,"_22654":54456,"_5":15607,"_29907":54415,"_3297":54457},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3844":31,"_33198":15,"_22654":54459,"_5":15607,"_29907":54419,"_3297":54460},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3844":32,"_33198":15,"_22654":54462,"_5":15607,"_29907":54423,"_3297":54463},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3844":33,"_33198":15,"_22654":54465,"_5":15607,"_29907":54427,"_3297":54466},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3844":34,"_33198":15,"_22654":54468,"_5":15607,"_29907":54431,"_3297":54469},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3844":35,"_33198":15,"_22654":54471,"_5":15607,"_29907":54435,"_3297":54472},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3844":36,"_33198":36,"_5":16006,"_3297":54474,"_33604":54475,"_22654":54476,"_29907":36},"Deploy Lamassu",[54402,54403],[],{"_3844":37,"_33198":36,"_22654":54478,"_5":15607,"_29907":36,"_3297":54479},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3844":38,"_33198":36,"_5":33601,"_22654":54481,"_29907":54482,"_3297":54483},[],"/docs/pr-preview/pr-58/deployment/overview#choose-a-model","Choose a model",{"_3844":39,"_33198":36,"_5":33601,"_22654":54485,"_29907":54486,"_3297":54487},[],"/docs/pr-preview/pr-58/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3844":40,"_33198":36,"_5":33601,"_22654":54489,"_29907":54490,"_3297":54491},[],"/docs/pr-preview/pr-58/deployment/overview#after-deployment","After deployment",{"_3844":41,"_33198":36,"_22654":54493,"_5":15607,"_29907":36,"_3297":54494},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3844":42,"_33198":36,"_22654":54496,"_5":15607,"_29907":54482,"_3297":54497},[],"Model",{"_3844":43,"_33198":36,"_22654":54499,"_5":15607,"_29907":54482,"_3297":54500},[],"Recommended for",{"_3844":44,"_33198":36,"_22654":54502,"_5":15607,"_29907":54482,"_3297":54503},[],"Who operates the infrastructure",{"_3844":45,"_33198":36,"_22654":54505,"_5":15607,"_29907":54482,"_3297":54506},[],"Starting point",{"_3844":46,"_33198":36,"_22654":54508,"_5":15607,"_29907":54482,"_3297":54509},[],"Kubernetes self-managed",{"_3844":47,"_33198":36,"_22654":54511,"_5":15607,"_29907":54482,"_3297":54512},[],"Production, regulated environments and custom deployments",{"_3844":48,"_33198":36,"_22654":54514,"_5":15607,"_29907":54482,"_3297":54515},[],"Your team",{"_3844":49,"_33198":36,"_22654":54517,"_5":15607,"_29907":54482,"_3297":54518},[],"Helm or Fastlane",{"_3844":50,"_33198":36,"_22654":54520,"_5":15607,"_29907":54482,"_3297":54521},[],"AWS Marketplace",{"_3844":51,"_33198":36,"_22654":54523,"_5":15607,"_29907":54482,"_3297":54524},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3844":52,"_33198":36,"_22654":54526,"_5":15607,"_29907":54482,"_3297":54515},[],{"_3844":53,"_33198":36,"_22654":54528,"_5":15607,"_29907":54482,"_3297":54529},[],"Preconfigured image on EC2",{"_3844":54,"_33198":36,"_22654":54531,"_5":15607,"_29907":54482,"_3297":54532},[],"SaaS",{"_3844":55,"_33198":36,"_22654":54534,"_5":15607,"_29907":54482,"_3297":54535},[],"Teams that want to use the platform without operating it",{"_3844":56,"_33198":36,"_22654":54537,"_5":15607,"_29907":54482,"_3297":54538},[],"Lamassu",{"_3844":57,"_33198":36,"_22654":54540,"_5":15607,"_29907":54482,"_3297":54541},[],"Managed subscription",{"_3844":58,"_33198":36,"_22654":54543,"_5":15607,"_29907":54482,"_3297":54544},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3844":59,"_33198":36,"_22654":54546,"_5":15607,"_29907":54482,"_3297":54547},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3844":60,"_33198":36,"_22654":54549,"_5":15607,"_29907":54482,"_3297":54550},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3844":61,"_33198":36,"_22654":54552,"_5":15607,"_29907":54486,"_3297":54553},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3844":62,"_33198":36,"_22654":54555,"_5":15607,"_29907":54490,"_3297":54556},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3844":63,"_33198":63,"_5":16006,"_3297":54558,"_33604":54559,"_22654":54560,"_29907":63},"Use Lamassu as SaaS",[54402,54403,54404],[],{"_3844":64,"_33198":63,"_22654":54562,"_5":15607,"_29907":63,"_3297":54563},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3844":65,"_33198":63,"_5":33601,"_22654":54565,"_29907":54566,"_3297":54567},[],"/docs/pr-preview/pr-58/deployment/saas#what-the-service-manages","What the service manages",{"_3844":66,"_33198":63,"_5":33601,"_22654":54569,"_29907":54570,"_3297":54571},[],"/docs/pr-preview/pr-58/deployment/saas#plans","Plans",{"_3844":67,"_33198":63,"_5":33601,"_22654":54573,"_29907":54574,"_3297":54575},[],"/docs/pr-preview/pr-58/deployment/saas#request-access","Request access",{"_3844":68,"_33198":63,"_22654":54577,"_5":15607,"_29907":63,"_3297":54578},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3844":69,"_33198":63,"_22654":54580,"_5":15607,"_29907":54566,"_3297":54581},[],"Platform availability and maintenance.",{"_3844":70,"_33198":63,"_22654":54583,"_5":15607,"_29907":54566,"_3297":54584},[],"Automatic backups.",{"_3844":71,"_33198":63,"_22654":54586,"_5":15607,"_29907":54566,"_3297":54587},[],"Version upgrades.",{"_3844":72,"_33198":63,"_22654":54589,"_5":15607,"_29907":54566,"_3297":54590},[],"Technical support and SLA according to your plan.",{"_3844":73,"_33198":63,"_22654":54592,"_5":15607,"_29907":54570,"_3297":54593},[],"Plan",{"_3844":74,"_33198":63,"_22654":54595,"_5":15607,"_29907":54570,"_3297":54596},[],"Devices",{"_3844":75,"_33198":63,"_22654":54598,"_5":15607,"_29907":54570,"_3297":54599},[],"Support",{"_3844":76,"_33198":63,"_22654":54601,"_5":15607,"_29907":54570,"_3297":54602},[],"SLA",{"_3844":77,"_33198":63,"_22654":54604,"_5":15607,"_29907":54570,"_3297":54605},[],"Starter",{"_3844":78,"_33198":63,"_22654":54607,"_5":15607,"_29907":54570,"_3297":54608},[],"Up to 1,000",{"_3844":79,"_33198":63,"_22654":54610,"_5":15607,"_29907":54570,"_3297":54611},[],"Email",{"_3844":80,"_33198":63,"_22654":54613,"_5":15607,"_29907":54570,"_3297":54614},[],"99.5 %",{"_3844":81,"_33198":63,"_22654":54616,"_5":15607,"_29907":54570,"_3297":54617},[],"Professional",{"_3844":82,"_33198":63,"_22654":54619,"_5":15607,"_29907":54570,"_3297":54620},[],"Up to 10,000",{"_3844":83,"_33198":63,"_22654":54622,"_5":15607,"_29907":54570,"_3297":54623},[],"Email and chat",{"_3844":84,"_33198":63,"_22654":54625,"_5":15607,"_29907":54570,"_3297":54626},[],"99.9 %",{"_3844":85,"_33198":63,"_22654":54628,"_5":15607,"_29907":54570,"_3297":54629},[],"Enterprise",{"_3844":86,"_33198":63,"_22654":54631,"_5":15607,"_29907":54570,"_3297":54632},[],"Unlimited",{"_3844":87,"_33198":63,"_22654":54634,"_5":15607,"_29907":54570,"_3297":54635},[],"Dedicated",{"_3844":88,"_33198":63,"_22654":54637,"_5":15607,"_29907":54570,"_3297":54638},[],"99.99 %",{"_3844":89,"_33198":63,"_22654":54640,"_5":15607,"_29907":54574,"_3297":54641},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3844":90,"_33198":63,"_22654":54643,"_5":15607,"_29907":54574,"_3297":54644},[],"When you receive your instance's credentials, continue with Get started.",{"_3844":91,"_33198":91,"_5":16006,"_3297":54646,"_33604":54647,"_22654":54648,"_29907":91},"Fastlane",[54402,54403,54509],[],{"_3844":92,"_33198":91,"_22654":54650,"_5":15607,"_29907":91,"_3297":54651},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3844":93,"_33198":91,"_5":33601,"_22654":54653,"_29907":54654,"_3297":54655},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3844":94,"_33198":91,"_5":33601,"_22654":54657,"_29907":54658,"_3297":54659},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3844":95,"_33198":91,"_5":33601,"_22654":54661,"_29907":54662,"_3297":54412},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#before-you-begin",{"_3844":96,"_33198":91,"_5":33601,"_22654":54664,"_29907":54665,"_3297":54666},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3844":97,"_33198":91,"_5":33601,"_22654":54668,"_29907":54669,"_3297":54670},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3844":98,"_33198":91,"_5":33601,"_22654":54672,"_29907":54673,"_3297":54674},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3844":99,"_33198":91,"_5":33601,"_22654":54676,"_29907":54677,"_3297":54678},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3844":100,"_33198":91,"_5":33601,"_22654":54680,"_29907":54681,"_3297":54682},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3844":101,"_33198":91,"_5":33601,"_22654":54684,"_29907":54685,"_3297":54686},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3844":102,"_33198":91,"_5":33601,"_22654":54688,"_29907":54689,"_3297":54690},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3844":103,"_33198":91,"_5":33601,"_22654":54692,"_29907":54693,"_3297":54694},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3844":104,"_33198":91,"_22654":54696,"_5":15607,"_29907":54654,"_3297":54697},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3844":105,"_33198":91,"_22654":54699,"_5":15607,"_29907":54654,"_3297":54700},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3844":106,"_33198":91,"_22654":54702,"_5":15607,"_29907":54658,"_3297":54703},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3844":107,"_33198":91,"_22654":54705,"_5":15607,"_29907":54658,"_3297":54706},[],"Fastlane installs or configures",{"_3844":108,"_33198":91,"_22654":54708,"_5":15607,"_29907":54658,"_3297":54709},[],"You still provide",{"_3844":109,"_33198":91,"_22654":54711,"_5":15607,"_29907":54658,"_3297":54712},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3844":110,"_33198":91,"_22654":54714,"_5":15607,"_29907":54658,"_3297":54715},[],"The Kubernetes cluster, nodes and persistent storage",{"_3844":111,"_33198":91,"_22654":54717,"_5":15607,"_29907":54658,"_3297":54718},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3844":112,"_33198":91,"_22654":54720,"_5":15607,"_29907":54658,"_3297":54721},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3844":113,"_33198":91,"_22654":54723,"_5":15607,"_29907":54658,"_3297":54724},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3844":114,"_33198":91,"_22654":54726,"_5":15607,"_29907":54658,"_3297":54727},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3844":115,"_33198":91,"_22654":54729,"_5":15607,"_29907":54658,"_3297":54730},[],"Optional observability and lab HSM components",{"_3844":116,"_33198":91,"_22654":54732,"_5":15607,"_29907":54658,"_3297":54733},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3844":117,"_33198":91,"_22654":54735,"_5":15607,"_29907":54658,"_3297":54736},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3844":118,"_33198":91,"_22654":54738,"_5":15607,"_29907":54662,"_3297":54739},[],"You need:",{"_3844":119,"_33198":91,"_22654":54741,"_5":15607,"_29907":54662,"_3297":54742},[],"an existing Kubernetes cluster",{"_3844":120,"_33198":91,"_22654":54744,"_5":15607,"_29907":54662,"_3297":54745},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3844":121,"_33198":91,"_22654":54747,"_5":15607,"_29907":54662,"_3297":54748},[],"`yq`",{"_3844":122,"_33198":91,"_22654":54750,"_5":15607,"_29907":54662,"_3297":25695},[],{"_3844":123,"_33198":91,"_22654":54752,"_5":15607,"_29907":54662,"_3297":54753},[],"`jq` only when using `--sample-data` or `--development`",{"_3844":124,"_33198":91,"_22654":54755,"_5":15607,"_29907":54662,"_3297":54756},[],"`ssh-keygen` only when using `--with-hsm`",{"_3844":125,"_33198":91,"_22654":54758,"_5":15607,"_29907":54662,"_3297":54759},[],"free external ports 80 and 443 on a single-node K3s host",{"_3844":126,"_33198":91,"_22654":54761,"_5":15607,"_29907":54662,"_3297":54762},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3844":127,"_33198":91,"_22654":54764,"_5":15607,"_29907":54662,"_3297":54765},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3844":128,"_33198":91,"_22654":54767,"_5":15607,"_29907":54665,"_3297":54768},[],"Run the script from a clone of the Helm repository:",{"_3844":129,"_33198":91,"_22654":54770,"_5":15607,"_29907":54665,"_3297":54771},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3844":130,"_33198":91,"_22654":54773,"_5":15607,"_29907":54669,"_3297":54774},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3844":131,"_33198":91,"_22654":54776,"_5":15607,"_29907":54669,"_3297":54777},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3844":132,"_33198":91,"_22654":54779,"_5":15607,"_29907":54669,"_3297":54780},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3844":133,"_33198":91,"_22654":54782,"_5":15607,"_29907":54669,"_3297":54783},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3844":134,"_33198":91,"_22654":54785,"_5":15607,"_29907":54673,"_3297":54786},[],"Option",{"_3844":135,"_33198":91,"_22654":54788,"_5":15607,"_29907":54673,"_3297":54789},[],"Default",{"_3844":136,"_33198":91,"_22654":54791,"_5":15607,"_29907":54673,"_3297":54792},[],"Purpose",{"_3844":137,"_33198":91,"_22654":54794,"_5":15607,"_29907":54673,"_3297":54795},[],"`-h`, `--help`",{"_3844":138,"_33198":91,"_22654":54797,"_5":15607,"_29907":54673,"_3297":54798},[],"—",{"_3844":139,"_33198":91,"_22654":54800,"_5":15607,"_29907":54673,"_3297":54801},[],"Show help",{"_3844":140,"_33198":91,"_22654":54803,"_5":15607,"_29907":54673,"_3297":54804},[],"`-c`, `--context`",{"_3844":141,"_33198":91,"_22654":54806,"_5":15607,"_29907":54673,"_3297":54807},[],"current context",{"_3844":142,"_33198":91,"_22654":54809,"_5":15607,"_29907":54673,"_3297":54810},[],"Select the kubeconfig context for kubectl and Helm",{"_3844":143,"_33198":91,"_22654":54812,"_5":15607,"_29907":54673,"_3297":54813},[],"`-n`, `--non-interactive`",{"_3844":144,"_33198":91,"_22654":54815,"_5":15607,"_29907":54673,"_3297":7115},[],{"_3844":145,"_33198":91,"_22654":54817,"_5":15607,"_29907":54673,"_3297":54818},[],"Skip prompts and generate dependency credentials",{"_3844":146,"_33198":91,"_22654":54820,"_5":15607,"_29907":54673,"_3297":54821},[],"`-ns`, `--namespace`",{"_3844":147,"_33198":91,"_22654":54823,"_5":15607,"_29907":54673,"_3297":54824},[],"`lamassu-dev`",{"_3844":148,"_33198":91,"_22654":54826,"_5":15607,"_29907":54673,"_3297":54827},[],"Namespace for the installation",{"_3844":149,"_33198":91,"_22654":54829,"_5":15607,"_29907":54673,"_3297":54830},[],"`-d`, `--domain`",{"_3844":150,"_33198":91,"_22654":54832,"_5":15607,"_29907":54673,"_3297":54833},[],"`dev.lamassu.io`",{"_3844":151,"_33198":91,"_22654":54835,"_5":15607,"_29907":54673,"_3297":54836},[],"Domain used by the UI, OIDC and certificate",{"_3844":152,"_33198":91,"_22654":54838,"_5":15607,"_29907":54673,"_3297":54839},[],"`-v`, `--version`",{"_3844":153,"_33198":91,"_22654":54841,"_5":15607,"_29907":54673,"_3297":16408},[],{"_3844":154,"_33198":91,"_22654":54843,"_5":15607,"_29907":54673,"_3297":54844},[],"Lamassu chart version",{"_3844":155,"_33198":91,"_22654":54846,"_5":15607,"_29907":54673,"_3297":54847},[],"`--https-port`",{"_3844":156,"_33198":91,"_22654":54849,"_5":15607,"_29907":54673,"_3297":54850},[],"`443`",{"_3844":157,"_33198":91,"_22654":54852,"_5":15607,"_29907":54673,"_3297":54853},[],"Gateway HTTPS listener port",{"_3844":158,"_33198":91,"_22654":54855,"_5":15607,"_29907":54673,"_3297":54856},[],"`--http-port`",{"_3844":159,"_33198":91,"_22654":54858,"_5":15607,"_29907":54673,"_3297":54859},[],"`80`",{"_3844":160,"_33198":91,"_22654":54861,"_5":15607,"_29907":54673,"_3297":54862},[],"Gateway HTTP listener port",{"_3844":161,"_33198":91,"_22654":54864,"_5":15607,"_29907":54673,"_3297":54865},[],"`--tls-crt`",{"_3844":162,"_33198":91,"_22654":54867,"_5":15607,"_29907":54673,"_3297":54798},[],{"_3844":163,"_33198":91,"_22654":54869,"_5":15607,"_29907":54673,"_3297":54870},[],"PEM certificate for downstream TLS",{"_3844":164,"_33198":91,"_22654":54872,"_5":15607,"_29907":54673,"_3297":54873},[],"`--tls-key`",{"_3844":165,"_33198":91,"_22654":54875,"_5":15607,"_29907":54673,"_3297":54798},[],{"_3844":166,"_33198":91,"_22654":54877,"_5":15607,"_29907":54673,"_3297":54878},[],"PEM private key for downstream TLS",{"_3844":167,"_33198":91,"_22654":54880,"_5":15607,"_29907":54673,"_3297":54881},[],"`-l`, `--local-chart-path`",{"_3844":168,"_33198":91,"_22654":54883,"_5":15607,"_29907":54673,"_3297":54884},[],"repository chart",{"_3844":169,"_33198":91,"_22654":54886,"_5":15607,"_29907":54673,"_3297":54887},[],"Use an unpacked local Lamassu chart",{"_3844":170,"_33198":91,"_22654":54889,"_5":15607,"_29907":54673,"_3297":54890},[],"`-ip`, `--gateway-ip`",{"_3844":171,"_33198":91,"_22654":54892,"_5":15607,"_29907":54673,"_3297":9440},[],{"_3844":172,"_33198":91,"_22654":54894,"_5":15607,"_29907":54673,"_3297":54895},[],"Override the address written to `gateway.addresses`",{"_3844":173,"_33198":91,"_22654":54897,"_5":15607,"_29907":54673,"_3297":54898},[],"`--otel`",{"_3844":174,"_33198":91,"_22654":54900,"_5":15607,"_29907":54673,"_3297":7115},[],{"_3844":175,"_33198":91,"_22654":54902,"_5":15607,"_29907":54673,"_3297":54903},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3844":176,"_33198":91,"_22654":54905,"_5":15607,"_29907":54673,"_3297":54906},[],"`--development`",{"_3844":177,"_33198":91,"_22654":54908,"_5":15607,"_29907":54673,"_3297":7115},[],{"_3844":178,"_33198":91,"_22654":54910,"_5":15607,"_29907":54673,"_3297":54911},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3844":179,"_33198":91,"_22654":54913,"_5":15607,"_29907":54673,"_3297":54914},[],"`--sample-data`",{"_3844":180,"_33198":91,"_22654":54916,"_5":15607,"_29907":54673,"_3297":7115},[],{"_3844":181,"_33198":91,"_22654":54918,"_5":15607,"_29907":54673,"_3297":54919},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3844":182,"_33198":91,"_22654":54921,"_5":15607,"_29907":54673,"_3297":54922},[],"`--with-hsm`",{"_3844":183,"_33198":91,"_22654":54924,"_5":15607,"_29907":54673,"_3297":7115},[],{"_3844":184,"_33198":91,"_22654":54926,"_5":15607,"_29907":54673,"_3297":54927},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3844":185,"_33198":91,"_22654":54929,"_5":15607,"_29907":54673,"_3297":54930},[],"`--softhsm-chart-path`",{"_3844":186,"_33198":91,"_22654":54932,"_5":15607,"_29907":54673,"_3297":54933},[],"`./charts/softhsm`",{"_3844":187,"_33198":91,"_22654":54935,"_5":15607,"_29907":54673,"_3297":54936},[],"Use a different local SoftHSM chart",{"_3844":188,"_33198":91,"_22654":54938,"_5":15607,"_29907":54673,"_3297":54939},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3844":189,"_33198":91,"_22654":54941,"_5":15607,"_29907":54677,"_3297":54942},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3844":190,"_33198":91,"_22654":54944,"_5":15607,"_29907":54677,"_3297":54945},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3844":191,"_33198":91,"_22654":54947,"_5":15607,"_29907":54677,"_3297":54948},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3844":192,"_33198":91,"_22654":54950,"_5":15607,"_29907":54677,"_3297":54951},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3844":193,"_33198":91,"_22654":54953,"_5":15607,"_29907":54677,"_3297":54954},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3844":194,"_33198":91,"_22654":54956,"_5":15607,"_29907":54677,"_3297":54957},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3844":195,"_33198":91,"_22654":54959,"_5":15607,"_29907":54681,"_3297":54960},[],"Fastlane:",{"_3844":196,"_33198":91,"_22654":54962,"_5":15607,"_29907":54681,"_3297":54963},[],"validates local tools and the selected cluster",{"_3844":197,"_33198":91,"_22654":54965,"_5":15607,"_29907":54681,"_3297":54966},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3844":198,"_33198":91,"_22654":54968,"_5":15607,"_29907":54681,"_3297":54969},[],"creates the namespace",{"_3844":199,"_33198":91,"_22654":54971,"_5":15607,"_29907":54681,"_3297":54972},[],"installs PostgreSQL and creates the required databases",{"_3844":200,"_33198":91,"_22654":54974,"_5":15607,"_29907":54681,"_3297":54975},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3844":201,"_33198":91,"_22654":54977,"_5":15607,"_29907":54681,"_3297":54978},[],"installs RabbitMQ",{"_3844":202,"_33198":91,"_22654":54980,"_5":15607,"_29907":54681,"_3297":54981},[],"optionally installs observability and lab HSM components",{"_3844":203,"_33198":91,"_22654":54983,"_5":15607,"_29907":54681,"_3297":54984},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3844":204,"_33198":91,"_22654":54986,"_5":15607,"_29907":54681,"_3297":54987},[],"optionally loads sample data",{"_3844":205,"_33198":91,"_22654":54989,"_5":15607,"_29907":54681,"_3297":54990},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3844":206,"_33198":91,"_22654":54992,"_5":15607,"_29907":54685,"_3297":54993},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3844":207,"_33198":91,"_22654":54995,"_5":15607,"_29907":54685,"_3297":54996},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3844":208,"_33198":91,"_22654":54998,"_5":15607,"_29907":54689,"_3297":54999},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3844":209,"_33198":91,"_22654":55001,"_5":15607,"_29907":54689,"_3297":55002},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3844":210,"_33198":91,"_22654":55004,"_5":15607,"_29907":54689,"_3297":55005},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3844":211,"_33198":91,"_22654":55007,"_5":15607,"_29907":54693,"_3297":55008},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3844":212,"_33198":212,"_5":16006,"_3297":55010,"_33604":55011,"_22654":55012,"_29907":212},"Install with Helm",[54402,54403,54509],[],{"_3844":213,"_33198":212,"_22654":55014,"_5":15607,"_29907":212,"_3297":55015},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3844":214,"_33198":212,"_5":33601,"_22654":55017,"_29907":55018,"_3297":55019},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3844":215,"_33198":212,"_5":33601,"_22654":55021,"_29907":55022,"_3297":54412},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#before-you-begin",{"_3844":216,"_33198":212,"_5":33601,"_22654":55024,"_29907":55025,"_3297":55026},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3844":217,"_33198":212,"_5":33601,"_22654":55028,"_29907":55029,"_3297":55030},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3844":218,"_33198":212,"_5":33601,"_22654":55032,"_29907":55033,"_3297":55034},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3844":219,"_33198":212,"_5":33601,"_22654":55036,"_29907":55037,"_3297":55038},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3844":220,"_33198":212,"_5":33601,"_22654":55040,"_29907":55041,"_3297":55042},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3844":221,"_33198":212,"_5":33601,"_22654":55044,"_29907":55045,"_3297":55046},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3844":222,"_33198":212,"_5":33601,"_22654":55048,"_29907":55049,"_3297":55050},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3844":223,"_33198":212,"_5":33601,"_22654":55052,"_29907":55053,"_3297":55054},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3844":224,"_33198":212,"_5":33601,"_22654":55056,"_29907":55057,"_3297":55058},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3844":225,"_33198":212,"_22654":55060,"_5":15607,"_29907":55018,"_3297":55061},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3844":226,"_33198":212,"_22654":55063,"_5":15607,"_29907":55022,"_3297":55064},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3844":227,"_33198":212,"_22654":55066,"_5":15607,"_29907":55022,"_3297":55067},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3844":228,"_33198":212,"_22654":55069,"_5":15607,"_29907":55022,"_3297":55070},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3844":229,"_33198":212,"_22654":55072,"_5":15607,"_29907":55022,"_3297":55073},[],"a reachable RabbitMQ broker and credentials",{"_3844":230,"_33198":212,"_22654":55075,"_5":15607,"_29907":55022,"_3297":55076},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3844":231,"_33198":212,"_22654":55078,"_5":15607,"_29907":55022,"_3297":55079},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3844":232,"_33198":212,"_22654":55081,"_5":15607,"_29907":55022,"_3297":55082},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3844":233,"_33198":212,"_22654":55084,"_5":15607,"_29907":55022,"_3297":55085},[],"a StorageClass and an external traffic design",{"_3844":234,"_33198":212,"_22654":55087,"_5":15607,"_29907":55022,"_3297":55088},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3844":235,"_33198":212,"_22654":55090,"_5":15607,"_29907":55022,"_3297":55091},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3844":236,"_33198":212,"_22654":55093,"_5":15607,"_29907":55022,"_3297":55094},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3844":237,"_33198":212,"_22654":55096,"_5":15607,"_29907":55025,"_3297":55097},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3844":238,"_33198":212,"_22654":55099,"_5":15607,"_29907":55025,"_3297":55100},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3844":239,"_33198":212,"_22654":55102,"_5":15607,"_29907":55025,"_3297":55103},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3844":240,"_33198":212,"_22654":55105,"_5":15607,"_29907":55029,"_3297":55106},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3844":241,"_33198":212,"_22654":55108,"_5":15607,"_29907":55029,"_3297":55109},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3844":242,"_33198":212,"_22654":55111,"_5":15607,"_29907":55029,"_3297":55112},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3844":243,"_33198":212,"_22654":55114,"_5":15607,"_29907":55029,"_3297":55115},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3844":244,"_33198":212,"_22654":55117,"_5":15607,"_29907":55033,"_3297":55118},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3844":245,"_33198":212,"_22654":55120,"_5":15607,"_29907":55037,"_3297":55121},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3844":246,"_33198":212,"_22654":55123,"_5":15607,"_29907":55037,"_3297":55124},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3844":247,"_33198":212,"_22654":55126,"_5":15607,"_29907":55037,"_3297":55127},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3844":248,"_33198":212,"_22654":55129,"_5":15607,"_29907":55037,"_3297":55130},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3844":249,"_33198":212,"_22654":55132,"_5":15607,"_29907":55037,"_3297":55133},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3844":250,"_33198":212,"_22654":55135,"_5":15607,"_29907":55037,"_3297":55136},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3844":251,"_33198":212,"_22654":55138,"_5":15607,"_29907":55037,"_3297":55139},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3844":252,"_33198":212,"_22654":55141,"_5":15607,"_29907":55041,"_3297":55142},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3844":253,"_33198":212,"_22654":55144,"_5":15607,"_29907":55041,"_3297":55145},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3844":254,"_33198":212,"_22654":55147,"_5":15607,"_29907":55041,"_3297":55148},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3844":255,"_33198":212,"_22654":55150,"_5":15607,"_29907":55041,"_3297":55151},[],"See Access control for the principal and policy model.",{"_3844":256,"_33198":212,"_22654":55153,"_5":15607,"_29907":55045,"_3297":55154},[],"To install a local checkout instead:",{"_3844":257,"_33198":212,"_22654":55156,"_5":15607,"_29907":55049,"_3297":55157},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3844":258,"_33198":212,"_22654":55159,"_5":15607,"_29907":55049,"_3297":55160},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3844":259,"_33198":212,"_22654":55162,"_5":15607,"_29907":55053,"_3297":55163},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3844":260,"_33198":212,"_22654":55165,"_5":15607,"_29907":55053,"_3297":55166},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3844":261,"_33198":212,"_22654":55168,"_5":15607,"_29907":55053,"_3297":55169},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3844":262,"_33198":212,"_22654":55171,"_5":15607,"_29907":55053,"_3297":55172},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3844":263,"_33198":212,"_22654":55174,"_5":15607,"_29907":55053,"_3297":55175},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3844":264,"_33198":212,"_22654":55177,"_5":15607,"_29907":55057,"_3297":55178},[],"Before going live, review:",{"_3844":265,"_33198":212,"_22654":55180,"_5":15607,"_29907":55057,"_3297":55181},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3844":266,"_33198":212,"_22654":55183,"_5":15607,"_29907":55057,"_3297":55184},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3844":267,"_33198":212,"_22654":55186,"_5":15607,"_29907":55057,"_3297":55187},[],"shared VA storage before increasing VA replicas",{"_3844":268,"_33198":212,"_22654":55189,"_5":15607,"_29907":55057,"_3297":55190},[],"managed OIDC roles and removal of evaluation credentials",{"_3844":269,"_33198":212,"_22654":55192,"_5":15607,"_29907":55057,"_3297":55193},[],"a trusted TLS issuer or externally managed certificate",{"_3844":270,"_33198":212,"_22654":55195,"_5":15607,"_29907":55057,"_3297":55196},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3844":271,"_33198":212,"_22654":55198,"_5":15607,"_29907":55057,"_3297":55199},[],"SMTP, observability and alert delivery",{"_3844":272,"_33198":212,"_22654":55201,"_5":15607,"_29907":55057,"_3297":55202},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3844":273,"_33198":212,"_22654":55204,"_5":15607,"_29907":55057,"_3297":55205},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3844":274,"_33198":274,"_5":16006,"_3297":55207,"_33604":55208,"_22654":55209,"_29907":274},"Expose the Gateway",[54402,54403,54509],[],{"_3844":275,"_33198":274,"_22654":55211,"_5":15607,"_29907":274,"_3297":55212},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3844":276,"_33198":274,"_5":33601,"_22654":55214,"_29907":55215,"_3297":55216},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3844":277,"_33198":274,"_5":33601,"_22654":55218,"_29907":55219,"_3297":55220},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3844":278,"_33198":274,"_5":33601,"_22654":55222,"_29907":55223,"_3297":55224},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3844":279,"_33198":274,"_5":33601,"_22654":55226,"_29907":55227,"_3297":55228},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#k3s","K3s",{"_3844":280,"_33198":274,"_5":33601,"_22654":55230,"_29907":55231,"_3297":55232},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3844":281,"_33198":274,"_5":33601,"_22654":55234,"_29907":55235,"_3297":55236},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3844":282,"_33198":274,"_5":33601,"_22654":55238,"_29907":55239,"_3297":55240},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3844":283,"_33198":274,"_5":33601,"_22654":55242,"_29907":55243,"_3297":55244},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3844":284,"_33198":274,"_5":33601,"_22654":55246,"_29907":55247,"_3297":55248},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3844":285,"_33198":274,"_5":33601,"_22654":55250,"_29907":55251,"_3297":55252},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3844":286,"_33198":274,"_22654":55254,"_5":15607,"_29907":55215,"_3297":55255},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3844":287,"_33198":274,"_22654":55257,"_5":15607,"_29907":55215,"_3297":55258},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3844":288,"_33198":274,"_22654":55260,"_5":15607,"_29907":55219,"_3297":55261},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3844":289,"_33198":274,"_22654":55263,"_5":15607,"_29907":55219,"_3297":55264},[],"Set it only when:",{"_3844":290,"_33198":274,"_22654":55266,"_5":15607,"_29907":55219,"_3297":55267},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3844":291,"_33198":274,"_22654":55269,"_5":15607,"_29907":55219,"_3297":55270},[],"that address is allocated to this Gateway",{"_3844":292,"_33198":274,"_22654":55272,"_5":15607,"_29907":55219,"_3297":55273},[],"the surrounding network already routes traffic for it to the cluster",{"_3844":293,"_33198":274,"_22654":55275,"_5":15607,"_29907":55219,"_3297":55276},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3844":294,"_33198":274,"_22654":55278,"_5":15607,"_29907":55219,"_3297":55279},[],"Keep these two settings separate:",{"_3844":295,"_33198":274,"_22654":55281,"_5":15607,"_29907":55219,"_3297":55282},[],"`gateway.addresses` requests an address for the Gateway.",{"_3844":296,"_33198":274,"_22654":55284,"_5":15607,"_29907":55219,"_3297":55285},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3844":297,"_33198":274,"_22654":55287,"_5":15607,"_29907":55219,"_3297":55288},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3844":298,"_33198":274,"_22654":55290,"_5":15607,"_29907":55223,"_3297":55291},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3844":299,"_33198":274,"_22654":55293,"_5":15607,"_29907":55223,"_3297":55294},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3844":300,"_33198":274,"_22654":55296,"_5":15607,"_29907":55227,"_3297":55297},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3844":301,"_33198":274,"_22654":55299,"_5":15607,"_29907":55227,"_3297":55300},[],"For the recommended design:",{"_3844":302,"_33198":274,"_22654":55302,"_5":15607,"_29907":55227,"_3297":55303},[],"Use only one externally exposed Lamassu Gateway.",{"_3844":303,"_33198":274,"_22654":55305,"_5":15607,"_29907":55227,"_3297":55306},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3844":304,"_33198":274,"_22654":55308,"_5":15607,"_29907":55227,"_3297":55309},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3844":305,"_33198":274,"_22654":55311,"_5":15607,"_29907":55227,"_3297":55312},[],"Point DNS at the VM's reachable address.",{"_3844":306,"_33198":274,"_22654":55314,"_5":15607,"_29907":55227,"_3297":55315},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3844":307,"_33198":274,"_22654":55317,"_5":15607,"_29907":55231,"_3297":55318},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3844":308,"_33198":274,"_22654":55320,"_5":15607,"_29907":55235,"_3297":55321},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3844":309,"_33198":274,"_22654":55323,"_5":15607,"_29907":55235,"_3297":55324},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3844":310,"_33198":274,"_22654":55326,"_5":15607,"_29907":55239,"_3297":55327},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3844":311,"_33198":274,"_22654":55329,"_5":15607,"_29907":55239,"_3297":55330},[],"Requirement",{"_3844":312,"_33198":274,"_22654":55332,"_5":15607,"_29907":55239,"_3297":55333},[],"Recommended design",{"_3844":313,"_33198":274,"_22654":55335,"_5":15607,"_29907":55239,"_3297":55336},[],"Consequence",{"_3844":314,"_33198":274,"_22654":55338,"_5":15607,"_29907":55239,"_3297":55339},[],"Several Lamassu URLs or services",{"_3844":315,"_33198":274,"_22654":55341,"_5":15607,"_29907":55239,"_3297":55342},[],"One Gateway with multiple routes",{"_3844":316,"_33198":274,"_22654":55344,"_5":15607,"_29907":55239,"_3297":55345},[],"One IP and one proxy fleet; this is the chart default",{"_3844":317,"_33198":274,"_22654":55347,"_5":15607,"_29907":55239,"_3297":55348},[],"Independent Gateways and separate external IPs",{"_3844":318,"_33198":274,"_22654":55350,"_5":15607,"_29907":55239,"_3297":55351},[],"One VIP per Gateway",{"_3844":319,"_33198":274,"_22654":55353,"_5":15607,"_29907":55239,"_3297":55354},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3844":320,"_33198":274,"_22654":55356,"_5":15607,"_29907":55239,"_3297":55357},[],"Independent Gateways on one node and one IP",{"_3844":321,"_33198":274,"_22654":55359,"_5":15607,"_29907":55239,"_3297":55360},[],"Use different external ports",{"_3844":322,"_33198":274,"_22654":55362,"_5":15607,"_29907":55239,"_3297":55363},[],"Clients must include non-standard ports",{"_3844":323,"_33198":274,"_22654":55365,"_5":15607,"_29907":55239,"_3297":55366},[],"Separate TLS/mTLS termination behind one IP",{"_3844":324,"_33198":274,"_22654":55368,"_5":15607,"_29907":55239,"_3297":55369},[],"Front-door SNI routing to internal Gateways",{"_3844":325,"_33198":274,"_22654":55371,"_5":15607,"_29907":55239,"_3297":55372},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3844":326,"_33198":274,"_22654":55374,"_5":15607,"_29907":55239,"_3297":55375},[],"Separate Gateway resources but shared proxy infrastructure",{"_3844":327,"_33198":274,"_22654":55377,"_5":15607,"_29907":55239,"_3297":55378},[],"Envoy merged-Gateway mode",{"_3844":328,"_33198":274,"_22654":55380,"_5":15607,"_29907":55239,"_3297":55381},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3844":329,"_33198":274,"_22654":55383,"_5":15607,"_29907":55239,"_3297":55384},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3844":330,"_33198":274,"_22654":55386,"_5":15607,"_29907":55239,"_3297":55387},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3844":331,"_33198":274,"_22654":55389,"_5":15607,"_29907":55239,"_3297":55390},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3844":332,"_33198":274,"_22654":55392,"_5":15607,"_29907":55239,"_3297":55393},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3844":333,"_33198":274,"_22654":55395,"_5":15607,"_29907":55243,"_3297":55396},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3844":334,"_33198":274,"_22654":55398,"_5":15607,"_29907":55243,"_3297":55399},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3844":335,"_33198":274,"_22654":55401,"_5":15607,"_29907":55243,"_3297":55402},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3844":336,"_33198":274,"_22654":55404,"_5":15607,"_29907":55243,"_3297":55405},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3844":337,"_33198":274,"_22654":55407,"_5":15607,"_29907":55243,"_3297":55408},[],"If none of those are possible, use different external ports or change the external network design.",{"_3844":338,"_33198":274,"_22654":55410,"_5":15607,"_29907":55247,"_3297":55411},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3844":339,"_33198":274,"_22654":55413,"_5":15607,"_29907":55247,"_3297":55414},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3844":340,"_33198":274,"_22654":55416,"_5":15607,"_29907":55251,"_3297":55417},[],"Check, in order:",{"_3844":341,"_33198":274,"_22654":55419,"_5":15607,"_29907":55251,"_3297":55420},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3844":342,"_33198":274,"_22654":55422,"_5":15607,"_29907":55251,"_3297":55423},[],"Its status contains the expected address.",{"_3844":343,"_33198":274,"_22654":55425,"_5":15607,"_29907":55251,"_3297":55426},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3844":344,"_33198":274,"_22654":55428,"_5":15607,"_29907":55251,"_3297":55429},[],"Port 443 reaches that address from the client network.",{"_3844":345,"_33198":274,"_22654":55431,"_5":15607,"_29907":55251,"_3297":55432},[],"DNS resolves to the externally reachable endpoint.",{"_3844":346,"_33198":274,"_22654":55434,"_5":15607,"_29907":55251,"_3297":55435},[],"The certificate contains the DNS name or IP used by the client.",{"_3844":347,"_33198":274,"_22654":55437,"_5":15607,"_29907":55251,"_3297":55438},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3844":348,"_33198":348,"_5":16006,"_3297":54509,"_33604":55440,"_22654":55441,"_29907":348},[54402,54403,54509],[],{"_3844":349,"_33198":348,"_22654":55443,"_5":15607,"_29907":348,"_3297":55444},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3844":350,"_33198":348,"_5":33601,"_22654":55446,"_29907":55447,"_3297":55448},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3844":351,"_33198":348,"_5":33601,"_22654":55450,"_29907":55451,"_3297":55452},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3844":352,"_33198":348,"_5":33601,"_22654":55454,"_29907":55455,"_3297":55456},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3844":353,"_33198":348,"_5":33601,"_22654":55458,"_29907":55459,"_3297":55460},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3844":354,"_33198":348,"_5":33601,"_22654":55462,"_29907":55463,"_3297":55464},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3844":355,"_33198":348,"_5":33601,"_22654":55466,"_29907":55467,"_3297":55468},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3844":356,"_33198":348,"_22654":55470,"_5":15607,"_29907":55447,"_3297":55471},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3844":357,"_33198":348,"_22654":55473,"_5":15607,"_29907":55451,"_3297":55474},[],"Workflow",{"_3844":358,"_33198":348,"_22654":55476,"_5":15607,"_29907":55451,"_3297":55477},[],"Use it for",{"_3844":359,"_33198":348,"_22654":55479,"_5":15607,"_29907":55451,"_3297":55480},[],"What it installs",{"_3844":360,"_33198":348,"_22654":55482,"_5":15607,"_29907":55451,"_3297":55483},[],"Helm",{"_3844":361,"_33198":348,"_22654":55485,"_5":15607,"_29907":55451,"_3297":55486},[],"Production and controlled environments",{"_3844":362,"_33198":348,"_22654":55488,"_5":15607,"_29907":55451,"_3297":55489},[],"Lamassu services and Gateway API resources",{"_3844":363,"_33198":348,"_22654":55491,"_5":15607,"_29907":55451,"_3297":54646},[],{"_3844":364,"_33198":348,"_22654":55493,"_5":15607,"_29907":55451,"_3297":55494},[],"Evaluation, demos, CI and small lab clusters",{"_3844":365,"_33198":348,"_22654":55496,"_5":15607,"_29907":55451,"_3297":55497},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3844":366,"_33198":348,"_22654":55499,"_5":15607,"_29907":55455,"_3297":55500},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3844":367,"_33198":348,"_22654":55502,"_5":15607,"_29907":55455,"_3297":55503},[],"Area",{"_3844":368,"_33198":348,"_22654":55505,"_5":15607,"_29907":55455,"_3297":55506},[],"The Lamassu chart provides",{"_3844":369,"_33198":348,"_22654":55508,"_5":15607,"_29907":55455,"_3297":55509},[],"You provide",{"_3844":370,"_33198":348,"_22654":55511,"_5":15607,"_29907":55455,"_3297":55512},[],"Lamassu applications",{"_3844":371,"_33198":348,"_22654":55514,"_5":15607,"_29907":55455,"_3297":55515},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3844":372,"_33198":348,"_22654":55517,"_5":15607,"_29907":55455,"_3297":55518},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3844":373,"_33198":348,"_22654":55520,"_5":15607,"_29907":55455,"_3297":55521},[],"PostgreSQL data",{"_3844":374,"_33198":348,"_22654":55523,"_5":15607,"_29907":55455,"_3297":55524},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3844":375,"_33198":348,"_22654":55526,"_5":15607,"_29907":55455,"_3297":55527},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3844":376,"_33198":348,"_22654":55529,"_5":15607,"_29907":55455,"_3297":55530},[],"Messaging",{"_3844":377,"_33198":348,"_22654":55532,"_5":15607,"_29907":55455,"_3297":55533},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3844":378,"_33198":348,"_22654":55535,"_5":15607,"_29907":55455,"_3297":55536},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3844":379,"_33198":348,"_22654":55538,"_5":15607,"_29907":55455,"_3297":55539},[],"Identity",{"_3844":380,"_33198":348,"_22654":55541,"_5":15607,"_29907":55455,"_3297":55542},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3844":381,"_33198":348,"_22654":55544,"_5":15607,"_29907":55455,"_3297":55545},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3844":382,"_33198":348,"_22654":55547,"_5":15607,"_29907":55455,"_3297":55548},[],"External routing",{"_3844":383,"_33198":348,"_22654":55550,"_5":15607,"_29907":55455,"_3297":55551},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3844":384,"_33198":348,"_22654":55553,"_5":15607,"_29907":55455,"_3297":55554},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3844":385,"_33198":348,"_22654":55556,"_5":15607,"_29907":55455,"_3297":55557},[],"TLS",{"_3844":386,"_33198":348,"_22654":55559,"_5":15607,"_29907":55455,"_3297":55560},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3844":387,"_33198":348,"_22654":55562,"_5":15607,"_29907":55455,"_3297":55563},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3844":388,"_33198":348,"_22654":55565,"_5":15607,"_29907":55455,"_3297":55566},[],"Persistent application data",{"_3844":389,"_33198":348,"_22654":55568,"_5":15607,"_29907":55455,"_3297":55569},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3844":390,"_33198":348,"_22654":55571,"_5":15607,"_29907":55455,"_3297":55572},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3844":391,"_33198":348,"_22654":55574,"_5":15607,"_29907":55455,"_3297":55575},[],"Optional integrations",{"_3844":392,"_33198":348,"_22654":55577,"_5":15607,"_29907":55455,"_3297":55578},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3844":393,"_33198":348,"_22654":55580,"_5":15607,"_29907":55455,"_3297":55581},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3844":394,"_33198":348,"_22654":55583,"_5":15607,"_29907":55455,"_3297":55584},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3844":395,"_33198":348,"_22654":55586,"_5":15607,"_29907":55455,"_3297":55587},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3844":396,"_33198":348,"_22654":55589,"_5":15607,"_29907":55459,"_3297":55590},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3844":397,"_33198":348,"_22654":55592,"_5":15607,"_29907":55459,"_3297":55593},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3844":398,"_33198":348,"_22654":55595,"_5":15607,"_29907":55463,"_3297":55596},[],"Kubernetes 1.24 or newer",{"_3844":399,"_33198":348,"_22654":55598,"_5":15607,"_29907":55463,"_3297":55599},[],"Helm 3.2 or newer",{"_3844":400,"_33198":348,"_22654":55601,"_5":15607,"_29907":55463,"_3297":55602},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3844":401,"_33198":348,"_22654":55604,"_5":15607,"_29907":55463,"_3297":55605},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3844":402,"_33198":348,"_22654":55607,"_5":15607,"_29907":55463,"_3297":55608},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3844":403,"_33198":348,"_22654":55610,"_5":15607,"_29907":55463,"_3297":55611},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3844":404,"_33198":348,"_22654":55613,"_5":15607,"_29907":55463,"_3297":55614},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3844":405,"_33198":348,"_22654":55616,"_5":15607,"_29907":55467,"_3297":55617},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3844":406,"_33198":348,"_22654":55619,"_5":15607,"_29907":55467,"_3297":55620},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3844":407,"_33198":348,"_22654":55622,"_5":15607,"_29907":55467,"_3297":55623},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3844":408,"_33198":348,"_22654":55625,"_5":15607,"_29907":55467,"_3297":55626},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3844":409,"_33198":409,"_5":16006,"_3297":55628,"_33604":55629,"_22654":55631,"_29907":409},"Deployment troubleshooting",[54402,54403,55630],"Operations",[],{"_3844":410,"_33198":409,"_22654":55633,"_5":15607,"_29907":409,"_3297":55634},[],"Diagnose access, service health and infrastructure dependencies.",{"_3844":411,"_33198":409,"_5":33601,"_22654":55636,"_29907":55637,"_3297":55638},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3844":412,"_33198":409,"_5":33601,"_22654":55640,"_29907":55641,"_3297":55642},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3844":413,"_33198":409,"_5":33601,"_22654":55644,"_29907":55645,"_3297":55646},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3844":414,"_33198":409,"_5":33601,"_22654":55648,"_29907":55649,"_3297":55650},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3844":415,"_33198":409,"_5":33601,"_22654":55652,"_29907":55653,"_3297":55654},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3844":416,"_33198":409,"_5":33601,"_22654":55656,"_29907":55657,"_3297":55658},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3844":417,"_33198":409,"_5":33601,"_22654":55660,"_29907":55661,"_3297":55662},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3844":418,"_33198":409,"_5":33601,"_22654":55664,"_29907":55665,"_3297":55666},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3844":419,"_33198":409,"_5":33601,"_22654":55668,"_29907":55669,"_3297":55670},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3844":420,"_33198":409,"_5":33601,"_22654":55672,"_29907":55673,"_3297":55674},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3844":421,"_33198":409,"_5":33601,"_22654":55676,"_29907":55677,"_3297":55678},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3844":422,"_33198":409,"_5":33601,"_22654":55680,"_29907":55681,"_3297":55682},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3844":423,"_33198":409,"_5":33601,"_22654":55684,"_29907":55685,"_3297":55686},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#observability","Observability",{"_3844":424,"_33198":409,"_22654":55688,"_5":15607,"_29907":409,"_3297":55689},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3844":425,"_33198":409,"_22654":55691,"_5":15607,"_29907":55641,"_3297":55692},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3844":426,"_33198":409,"_22654":55694,"_5":15607,"_29907":55645,"_3297":55695},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3844":427,"_33198":409,"_22654":55697,"_5":15607,"_29907":55649,"_3297":55698},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3844":428,"_33198":409,"_22654":55700,"_5":15607,"_29907":55653,"_3297":55701},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3844":429,"_33198":409,"_22654":55703,"_5":15607,"_29907":55657,"_3297":55704},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3844":430,"_33198":409,"_22654":55706,"_5":15607,"_29907":55661,"_3297":55707},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3844":431,"_33198":409,"_22654":55709,"_5":15607,"_29907":55661,"_3297":55710},[],"Also run the chart's connectivity test:",{"_3844":432,"_33198":409,"_22654":55712,"_5":15607,"_29907":55661,"_3297":55713},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3844":433,"_33198":409,"_22654":55715,"_5":15607,"_29907":55661,"_3297":55716},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3844":434,"_33198":409,"_22654":55718,"_5":15607,"_29907":55665,"_3297":55719},[],"If you receive a 401:",{"_3844":435,"_33198":409,"_22654":55721,"_5":15607,"_29907":55665,"_3297":55722},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3844":436,"_33198":409,"_22654":55724,"_5":15607,"_29907":55665,"_3297":55725},[],"verify issuer, audience and expiration of the token;",{"_3844":437,"_33198":409,"_22654":55727,"_5":15607,"_29907":55665,"_3297":55728},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3844":438,"_33198":409,"_22654":55730,"_5":15607,"_29907":55665,"_3297":55731},[],"check that the provider's public and internal routes point to the same realm.",{"_3844":439,"_33198":409,"_22654":55733,"_5":15607,"_29907":55665,"_3297":55734},[],"If login succeeds but the APIs return 403:",{"_3844":440,"_33198":409,"_22654":55736,"_5":15607,"_29907":55665,"_3297":55737},[],"inspect the token's real claims;",{"_3844":441,"_33198":409,"_22654":55739,"_5":15607,"_29907":55665,"_3297":55740},[],"confirm they match an active principal;",{"_3844":442,"_33198":409,"_22654":55742,"_5":15607,"_29907":55665,"_3297":55743},[],"review the policies granted to that principal;",{"_3844":443,"_33198":409,"_22654":55745,"_5":15607,"_29907":55665,"_3297":55746},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3844":444,"_33198":409,"_22654":55748,"_5":15607,"_29907":55665,"_3297":55749},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3844":445,"_33198":409,"_22654":55751,"_5":15607,"_29907":55669,"_3297":55752},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3844":446,"_33198":409,"_22654":55754,"_5":15607,"_29907":55669,"_3297":55755},[],"Locate the authz pod and Service.",{"_3844":447,"_33198":409,"_22654":55757,"_5":15607,"_29907":55669,"_3297":55758},[],"Check /health, logs and its database connection.",{"_3844":448,"_33198":409,"_22654":55760,"_5":15607,"_29907":55669,"_3297":55761},[],"Verify the DNS and port configured in externalAuthorization.",{"_3844":449,"_33198":409,"_22654":55763,"_5":15607,"_29907":55669,"_3297":55764},[],"Check the check route is /v1/ext\\_authz/check.",{"_3844":450,"_33198":409,"_22654":55766,"_5":15607,"_29907":55669,"_3297":55767},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3844":451,"_33198":409,"_22654":55769,"_5":15607,"_29907":55673,"_3297":55770},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3844":452,"_33198":409,"_22654":55772,"_5":15607,"_29907":55677,"_3297":55773},[],"Review kubectl describe pod first. Common causes are:",{"_3844":453,"_33198":409,"_22654":55775,"_5":15607,"_29907":55677,"_3297":55776},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3844":454,"_33198":409,"_22654":55778,"_5":15607,"_29907":55677,"_3297":55779},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3844":455,"_33198":409,"_22654":55781,"_5":15607,"_29907":55677,"_3297":55782},[],"unbound persistent volume;",{"_3844":456,"_33198":409,"_22654":55784,"_5":15607,"_29907":55677,"_3297":55785},[],"inaccessible image or incorrect pull policy;",{"_3844":457,"_33198":409,"_22654":55787,"_5":15607,"_29907":55677,"_3297":55788},[],"invalid cryptographic engine configuration;",{"_3844":458,"_33198":409,"_22654":55790,"_5":15607,"_29907":55677,"_3297":55791},[],"CPU or memory limits set too low;",{"_3844":459,"_33198":409,"_22654":55793,"_5":15607,"_29907":55677,"_3297":55794},[],"an incomplete prior migration.",{"_3844":460,"_33198":409,"_22654":55796,"_5":15607,"_29907":55677,"_3297":55797},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3844":461,"_33198":409,"_22654":55799,"_5":15607,"_29907":55677,"_3297":55800},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3844":462,"_33198":409,"_22654":55802,"_5":15607,"_29907":55677,"_3297":55803},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3844":463,"_33198":409,"_22654":55805,"_5":15607,"_29907":55681,"_3297":55806},[],"Domain and audit events depend on the bus publisher:",{"_3844":464,"_33198":409,"_22654":55808,"_5":15607,"_29907":55681,"_3297":55809},[],"verify it is enabled in the emitting service;",{"_3844":465,"_33198":409,"_22654":55811,"_5":15607,"_29907":55681,"_3297":55812},[],"check AMQP connectivity and credentials;",{"_3844":466,"_33198":409,"_22654":55814,"_5":15607,"_29907":55681,"_3297":55815},[],"review exchange, routing key, queues and consumers;",{"_3844":467,"_33198":409,"_22654":55817,"_5":15607,"_29907":55681,"_3297":55818},[],"inspect dead-letter queues;",{"_3844":468,"_33198":409,"_22654":55820,"_5":15607,"_29907":55681,"_3297":55821},[],"alert on orphan durable queues and backlog growth.",{"_3844":469,"_33198":409,"_22654":55823,"_5":15607,"_29907":55681,"_3297":55824},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3844":470,"_33198":409,"_22654":55826,"_5":15607,"_29907":55681,"_3297":55827},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3844":471,"_33198":409,"_22654":55829,"_5":15607,"_29907":55681,"_3297":55830},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3844":472,"_33198":409,"_22654":55832,"_5":15607,"_29907":55681,"_3297":55833},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3844":473,"_33198":409,"_22654":55835,"_5":15607,"_29907":55681,"_3297":55836},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3844":474,"_33198":409,"_22654":55838,"_5":15607,"_29907":55681,"_3297":55839},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3844":475,"_33198":409,"_22654":55841,"_5":15607,"_29907":55681,"_3297":55842},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3844":476,"_33198":409,"_22654":55844,"_5":15607,"_29907":55685,"_3297":55845},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3844":477,"_33198":409,"_22654":55847,"_5":15607,"_29907":55685,"_3297":55848},[],"Before closing an incident, record:",{"_3844":478,"_33198":409,"_22654":55850,"_5":15607,"_29907":55685,"_3297":55851},[],"the confirmed cause;",{"_3844":479,"_33198":409,"_22654":55853,"_5":15607,"_29907":55685,"_3297":55854},[],"the time scope and affected resources;",{"_3844":480,"_33198":409,"_22654":55856,"_5":15607,"_29907":55685,"_3297":55857},[],"the commands or queries used;",{"_3844":481,"_33198":409,"_22654":55859,"_5":15607,"_29907":55685,"_3297":55860},[],"the applied change and how to revert it;",{"_3844":482,"_33198":409,"_22654":55862,"_5":15607,"_29907":55685,"_3297":55863},[],"validation from a consumer;",{"_3844":483,"_33198":409,"_22654":55865,"_5":15607,"_29907":55685,"_3297":55866},[],"the preventive action and its owner.",{"_3844":484,"_33198":484,"_5":16006,"_3297":55868,"_33604":55869,"_22654":55872,"_29907":484},"Access control",[54402,55870,55871],"Platform","Administration",[],{"_3844":485,"_33198":484,"_22654":55874,"_5":15607,"_29907":484,"_3297":55875},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3844":486,"_33198":484,"_5":33601,"_22654":55877,"_29907":55878,"_3297":55879},[],"/docs/pr-preview/pr-58/platform/administration/access-control#essential-concepts","Essential concepts",{"_3844":487,"_33198":484,"_5":33601,"_22654":55881,"_29907":55882,"_3297":55883},[],"/docs/pr-preview/pr-58/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3844":488,"_33198":484,"_5":33601,"_22654":55885,"_29907":55886,"_3297":55887},[],"/docs/pr-preview/pr-58/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3844":489,"_33198":484,"_5":33601,"_22654":55889,"_29907":55890,"_3297":55891},[],"/docs/pr-preview/pr-58/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3844":490,"_33198":484,"_5":33601,"_22654":55893,"_29907":55894,"_3297":55895},[],"/docs/pr-preview/pr-58/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3844":491,"_33198":484,"_5":33601,"_22654":55897,"_29907":55898,"_3297":55899},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3844":492,"_33198":484,"_5":33601,"_22654":55901,"_29907":55902,"_3297":55903},[],"/docs/pr-preview/pr-58/platform/administration/access-control#oidc-principals","OIDC principals",{"_3844":493,"_33198":484,"_5":33601,"_22654":55905,"_29907":55906,"_3297":55907},[],"/docs/pr-preview/pr-58/platform/administration/access-control#x509-principals","X.509 principals",{"_3844":494,"_33198":484,"_5":33601,"_22654":55909,"_29907":55910,"_3297":55911},[],"/docs/pr-preview/pr-58/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3844":495,"_33198":484,"_5":33601,"_22654":55913,"_29907":55914,"_3297":55915},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3844":496,"_33198":484,"_5":33601,"_22654":55917,"_29907":55918,"_3297":55919},[],"/docs/pr-preview/pr-58/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3844":497,"_33198":484,"_5":33601,"_22654":55921,"_29907":55922,"_3297":55923},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3844":498,"_33198":484,"_5":33601,"_22654":55925,"_29907":55926,"_3297":55927},[],"/docs/pr-preview/pr-58/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3844":499,"_33198":484,"_5":33601,"_22654":55929,"_29907":55930,"_3297":55931},[],"/docs/pr-preview/pr-58/platform/administration/access-control#http-rules","HTTP rules",{"_3844":500,"_33198":484,"_5":33601,"_22654":55933,"_29907":55934,"_3297":55935},[],"/docs/pr-preview/pr-58/platform/administration/access-control#included-policies","Included policies",{"_3844":501,"_33198":484,"_5":33601,"_22654":55937,"_29907":55938,"_3297":55042},[],"/docs/pr-preview/pr-58/platform/administration/access-control#provision-the-first-administrator",{"_3844":502,"_33198":484,"_5":33601,"_22654":55940,"_29907":55941,"_3297":55942},[],"/docs/pr-preview/pr-58/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3844":503,"_33198":484,"_5":33601,"_22654":55944,"_29907":55945,"_3297":55946},[],"/docs/pr-preview/pr-58/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3844":504,"_33198":484,"_5":33601,"_22654":55948,"_29907":55949,"_3297":55950},[],"/docs/pr-preview/pr-58/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3844":505,"_33198":484,"_5":33601,"_22654":55952,"_29907":55953,"_3297":55954},[],"/docs/pr-preview/pr-58/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3844":506,"_33198":484,"_5":33601,"_22654":55956,"_29907":55957,"_3297":55958},[],"/docs/pr-preview/pr-58/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3844":507,"_33198":484,"_5":33601,"_22654":55960,"_29907":55961,"_3297":55962},[],"/docs/pr-preview/pr-58/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3844":508,"_33198":484,"_5":33601,"_22654":55964,"_29907":55965,"_3297":55966},[],"/docs/pr-preview/pr-58/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3844":509,"_33198":484,"_5":33601,"_22654":55968,"_29907":55969,"_3297":55970},[],"/docs/pr-preview/pr-58/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3844":510,"_33198":484,"_5":33601,"_22654":55972,"_29907":55973,"_3297":55974},[],"/docs/pr-preview/pr-58/platform/administration/access-control#operational-checklist","Operational checklist",{"_3844":511,"_33198":484,"_5":33601,"_22654":55976,"_29907":55977,"_3297":55978},[],"/docs/pr-preview/pr-58/platform/administration/access-control#diagnostics","Diagnostics",{"_3844":512,"_33198":484,"_5":33601,"_22654":55980,"_29907":55981,"_3297":55982},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-401","The response is 401",{"_3844":513,"_33198":484,"_5":33601,"_22654":55984,"_29907":55985,"_3297":55986},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-403","The response is 403",{"_3844":514,"_33198":484,"_5":33601,"_22654":55988,"_29907":55989,"_3297":55990},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3844":515,"_33198":484,"_5":33601,"_22654":55992,"_29907":55993,"_3297":55994},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3844":516,"_33198":484,"_5":33601,"_22654":55996,"_29907":55997,"_3297":55998},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3844":517,"_33198":484,"_22654":56000,"_5":15607,"_29907":484,"_3297":56001},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3844":518,"_33198":484,"_22654":56003,"_5":15607,"_29907":484,"_3297":56004},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3844":519,"_33198":484,"_22654":56006,"_5":15607,"_29907":484,"_3297":56007},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3844":520,"_33198":484,"_22654":56009,"_5":15607,"_29907":55878,"_3297":56010},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3844":521,"_33198":484,"_22654":56012,"_5":15607,"_29907":55878,"_3297":56013},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3844":522,"_33198":484,"_22654":56015,"_5":15607,"_29907":55878,"_3297":56016},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3844":523,"_33198":484,"_22654":56018,"_5":15607,"_29907":55878,"_3297":56019},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3844":524,"_33198":484,"_22654":56021,"_5":15607,"_29907":55878,"_3297":56022},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3844":525,"_33198":484,"_22654":56024,"_5":15607,"_29907":55878,"_3297":56025},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3844":526,"_33198":484,"_22654":56027,"_5":15607,"_29907":55882,"_3297":56028},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3844":527,"_33198":484,"_22654":56030,"_5":15607,"_29907":55882,"_3297":56031},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3844":528,"_33198":484,"_22654":56033,"_5":15607,"_29907":55886,"_3297":56034},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3844":529,"_33198":484,"_22654":56036,"_5":15607,"_29907":55886,"_3297":56037},[],"The decision is made **before forwarding the request to the service**:",{"_3844":530,"_33198":484,"_22654":56039,"_5":15607,"_29907":55886,"_3297":56040},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3844":531,"_33198":484,"_22654":56042,"_5":15607,"_29907":55886,"_3297":56043},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3844":532,"_33198":484,"_22654":56045,"_5":15607,"_29907":55886,"_3297":56046},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3844":533,"_33198":484,"_22654":56048,"_5":15607,"_29907":55886,"_3297":56049},[],"It separately loads the policies granted to each principal.",{"_3844":534,"_33198":484,"_22654":56051,"_5":15607,"_29907":55886,"_3297":56052},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3844":535,"_33198":484,"_22654":56054,"_5":15607,"_29907":55886,"_3297":56055},[],"`authz` looks for an HTTP rule granting that action.",{"_3844":536,"_33198":484,"_22654":56057,"_5":15607,"_29907":55886,"_3297":56058},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3844":537,"_33198":484,"_22654":56060,"_5":15607,"_29907":55886,"_3297":56061},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3844":538,"_33198":484,"_22654":56063,"_5":15607,"_29907":55886,"_3297":56064},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3844":539,"_33198":484,"_22654":56066,"_5":15607,"_29907":55886,"_3297":56067},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3844":540,"_33198":484,"_22654":56069,"_5":15607,"_29907":55890,"_3297":56070},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3844":541,"_33198":484,"_22654":56072,"_5":15607,"_29907":55890,"_3297":56073},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3844":542,"_33198":484,"_22654":56075,"_5":15607,"_29907":55890,"_3297":56076},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3844":543,"_33198":484,"_22654":56078,"_5":15607,"_29907":55890,"_3297":56079},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3844":544,"_33198":484,"_22654":56081,"_5":15607,"_29907":55890,"_3297":56082},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3844":545,"_33198":484,"_22654":56084,"_5":15607,"_29907":55890,"_3297":56085},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3844":546,"_33198":484,"_22654":56087,"_5":15607,"_29907":55890,"_3297":56088},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3844":547,"_33198":484,"_22654":56090,"_5":15607,"_29907":55890,"_3297":56091},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3844":548,"_33198":484,"_22654":56093,"_5":15607,"_29907":55894,"_3297":56094},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3844":549,"_33198":484,"_22654":56096,"_5":15607,"_29907":55894,"_3297":56097},[],"The decision is made with the domain operation context:",{"_3844":550,"_33198":484,"_22654":56099,"_5":15607,"_29907":55894,"_3297":56100},[],"The middleware extracts the credential and resolves the matching principals.",{"_3844":551,"_33198":484,"_22654":56102,"_5":15607,"_29907":55894,"_3297":56103},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3844":552,"_33198":484,"_22654":56105,"_5":15607,"_29907":55894,"_3297":56106},[],"`authz` gathers the entity rules of the granted policies.",{"_3844":553,"_33198":484,"_22654":56108,"_5":15607,"_29907":55894,"_3297":56109},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3844":554,"_33198":484,"_22654":56111,"_5":15607,"_29907":55894,"_3297":56112},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3844":555,"_33198":484,"_22654":56114,"_5":15607,"_29907":55894,"_3297":56115},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3844":556,"_33198":484,"_22654":56117,"_5":15607,"_29907":55894,"_3297":56118},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3844":557,"_33198":484,"_22654":56120,"_5":15607,"_29907":55894,"_3297":56121},[],"Actions fall into two groups:",{"_3844":558,"_33198":484,"_22654":56123,"_5":15607,"_29907":55894,"_3297":56124},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3844":559,"_33198":484,"_22654":56126,"_5":15607,"_29907":55894,"_3297":56127},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3844":560,"_33198":484,"_22654":56129,"_5":15607,"_29907":55894,"_3297":56130},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3844":561,"_33198":484,"_22654":56132,"_5":15607,"_29907":55898,"_3297":56133},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3844":562,"_33198":484,"_22654":56135,"_5":15607,"_29907":55898,"_3297":56136},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3844":563,"_33198":484,"_22654":56138,"_5":15607,"_29907":55898,"_3297":56139},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3844":564,"_33198":484,"_22654":56141,"_5":15607,"_29907":55902,"_3297":56142},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3844":565,"_33198":484,"_22654":56144,"_5":15607,"_29907":55902,"_3297":56145},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3844":566,"_33198":484,"_22654":56147,"_5":15607,"_29907":55902,"_3297":56148},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3844":567,"_33198":484,"_22654":56150,"_5":15607,"_29907":55902,"_3297":56151},[],"The implemented operators are:",{"_3844":568,"_33198":484,"_22654":56153,"_5":15607,"_29907":55902,"_3297":56154},[],"`equals`, for exact equality;",{"_3844":569,"_33198":484,"_22654":56156,"_5":15607,"_29907":55902,"_3297":56157},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3844":570,"_33198":484,"_22654":56159,"_5":15607,"_29907":55902,"_3297":56160},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3844":571,"_33198":484,"_22654":56162,"_5":15607,"_29907":55902,"_3297":56163},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3844":572,"_33198":484,"_22654":56165,"_5":15607,"_29907":55906,"_3297":56166},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3844":573,"_33198":484,"_22654":56168,"_5":15607,"_29907":55906,"_3297":56169},[],"The available modes are:",{"_3844":574,"_33198":484,"_22654":56171,"_5":15607,"_29907":55906,"_3297":56172},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3844":575,"_33198":484,"_22654":56174,"_5":15607,"_29907":55906,"_3297":56175},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3844":576,"_33198":484,"_22654":56177,"_5":15607,"_29907":55906,"_3297":56178},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3844":577,"_33198":484,"_22654":56180,"_5":15607,"_29907":55906,"_3297":56181},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3844":578,"_33198":484,"_22654":56183,"_5":15607,"_29907":55906,"_3297":56184},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3844":579,"_33198":484,"_22654":56186,"_5":15607,"_29907":55906,"_3297":56187},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3844":580,"_33198":484,"_22654":56189,"_5":15607,"_29907":55910,"_3297":56190},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3844":581,"_33198":484,"_22654":56192,"_5":15607,"_29907":55910,"_3297":56193},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3844":582,"_33198":484,"_22654":56195,"_5":15607,"_29907":55910,"_3297":56196},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3844":583,"_33198":484,"_22654":56198,"_5":15607,"_29907":55910,"_3297":56199},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3844":584,"_33198":484,"_22654":56201,"_5":15607,"_29907":55918,"_3297":56202},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3844":585,"_33198":484,"_22654":56204,"_5":15607,"_29907":55918,"_3297":56205},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3844":586,"_33198":484,"_22654":56207,"_5":15607,"_29907":55922,"_3297":56208},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3844":587,"_33198":484,"_22654":56210,"_5":15607,"_29907":55922,"_3297":56211},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3844":588,"_33198":484,"_22654":56213,"_5":15607,"_29907":55926,"_3297":56214},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3844":589,"_33198":484,"_22654":56216,"_5":15607,"_29907":55926,"_3297":56217},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3844":590,"_33198":484,"_22654":56219,"_5":15607,"_29907":55926,"_3297":56220},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3844":591,"_33198":484,"_22654":56222,"_5":15607,"_29907":55930,"_3297":56223},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3844":592,"_33198":484,"_22654":56225,"_5":15607,"_29907":55930,"_3297":56226},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3844":593,"_33198":484,"_22654":56228,"_5":15607,"_29907":55930,"_3297":56229},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3844":594,"_33198":484,"_22654":56231,"_5":15607,"_29907":55930,"_3297":56232},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3844":595,"_33198":484,"_22654":56234,"_5":15607,"_29907":55930,"_3297":56235},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3844":596,"_33198":484,"_22654":56237,"_5":15607,"_29907":55930,"_3297":56238},[],"Note that:",{"_3844":597,"_33198":484,"_22654":56240,"_5":15607,"_29907":55930,"_3297":56241},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3844":598,"_33198":484,"_22654":56243,"_5":15607,"_29907":55930,"_3297":56244},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3844":599,"_33198":484,"_22654":56246,"_5":15607,"_29907":55930,"_3297":56247},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3844":600,"_33198":484,"_22654":56249,"_5":15607,"_29907":55934,"_3297":56250},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3844":601,"_33198":484,"_22654":56252,"_5":15607,"_29907":55934,"_3297":56253},[],"full and read-only access to certificates and authorities;",{"_3844":602,"_33198":484,"_22654":56255,"_5":15607,"_29907":55934,"_3297":56256},[],"full and read-only access to the KMS;",{"_3844":603,"_33198":484,"_22654":56258,"_5":15607,"_29907":55934,"_3297":56259},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3844":604,"_33198":484,"_22654":56261,"_5":15607,"_29907":55934,"_3297":56262},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3844":605,"_33198":484,"_22654":56264,"_5":15607,"_29907":55934,"_3297":56265},[],"console access;",{"_3844":606,"_33198":484,"_22654":56267,"_5":15607,"_29907":55934,"_3297":56268},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3844":607,"_33198":484,"_22654":56270,"_5":15607,"_29907":55934,"_3297":56271},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3844":608,"_33198":484,"_22654":56273,"_5":15607,"_29907":55934,"_3297":56274},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3844":609,"_33198":484,"_22654":56276,"_5":15607,"_29907":55938,"_3297":56277},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3844":610,"_33198":484,"_22654":56279,"_5":15607,"_29907":55938,"_3297":56280},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3844":611,"_33198":484,"_22654":56282,"_5":15607,"_29907":55938,"_3297":56283},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3844":612,"_33198":484,"_22654":56285,"_5":15607,"_29907":55941,"_3297":56286},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3844":613,"_33198":484,"_22654":56288,"_5":15607,"_29907":55945,"_3297":56289},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3844":614,"_33198":484,"_22654":56291,"_5":15607,"_29907":55945,"_3297":56292},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3844":615,"_33198":484,"_22654":56294,"_5":15607,"_29907":55949,"_3297":56295},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3844":616,"_33198":484,"_22654":56297,"_5":15607,"_29907":55953,"_3297":56298},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3844":617,"_33198":484,"_22654":56300,"_5":15607,"_29907":55957,"_3297":56301},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3844":618,"_33198":484,"_22654":56303,"_5":15607,"_29907":55961,"_3297":56304},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3844":619,"_33198":484,"_22654":56306,"_5":15607,"_29907":55961,"_3297":56307},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3844":620,"_33198":484,"_22654":56309,"_5":15607,"_29907":55965,"_3297":56310},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3844":621,"_33198":484,"_22654":56312,"_5":15607,"_29907":55965,"_3297":56313},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3844":622,"_33198":484,"_22654":56315,"_5":15607,"_29907":55965,"_3297":56316},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3844":623,"_33198":484,"_22654":56318,"_5":15607,"_29907":55965,"_3297":56319},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3844":624,"_33198":484,"_22654":56321,"_5":15607,"_29907":55965,"_3297":56322},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3844":625,"_33198":484,"_22654":56324,"_5":15607,"_29907":55965,"_3297":56325},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3844":626,"_33198":484,"_22654":56327,"_5":15607,"_29907":55965,"_3297":56328},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3844":627,"_33198":484,"_22654":56330,"_5":15607,"_29907":55965,"_3297":56331},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3844":628,"_33198":484,"_22654":56333,"_5":15607,"_29907":55969,"_3297":56334},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3844":629,"_33198":484,"_22654":56336,"_5":15607,"_29907":55969,"_3297":56337},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3844":630,"_33198":484,"_22654":56339,"_5":15607,"_29907":55969,"_3297":56340},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3844":631,"_33198":484,"_22654":56342,"_5":15607,"_29907":55973,"_3297":56343},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3844":632,"_33198":484,"_22654":56345,"_5":15607,"_29907":55973,"_3297":56346},[],"Use groups or stable roles for people and independent identities for automations.",{"_3844":633,"_33198":484,"_22654":56348,"_5":15607,"_29907":55973,"_3297":56349},[],"Keep at least two recovery administrators and test their access periodically.",{"_3844":634,"_33198":484,"_22654":56351,"_5":15607,"_29907":55973,"_3297":56352},[],"Review active principals, their matches and their grants after IdP changes.",{"_3844":635,"_33198":484,"_22654":56354,"_5":15607,"_29907":55973,"_3297":56355},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3844":636,"_33198":484,"_22654":56357,"_5":15607,"_29907":55973,"_3297":56358},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3844":637,"_33198":484,"_22654":56360,"_5":15607,"_29907":55973,"_3297":56361},[],"Always test one allowed and one denied operation for each role.",{"_3844":638,"_33198":484,"_22654":56363,"_5":15607,"_29907":55973,"_3297":56364},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3844":639,"_33198":484,"_22654":56366,"_5":15607,"_29907":55981,"_3297":56367},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3844":640,"_33198":484,"_22654":56369,"_5":15607,"_29907":55985,"_3297":56370},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3844":641,"_33198":484,"_22654":56372,"_5":15607,"_29907":55985,"_3297":56373},[],"that an active principal of the correct type exists;",{"_3844":642,"_33198":484,"_22654":56375,"_5":15607,"_29907":55985,"_3297":56376},[],"that the claim paths and values match the real token exactly;",{"_3844":643,"_33198":484,"_22654":56378,"_5":15607,"_29907":55985,"_3297":56379},[],"that all of the principal's conditions hold;",{"_3844":644,"_33198":484,"_22654":56381,"_5":15607,"_29907":55985,"_3297":56382},[],"that the principal has the expected policy granted;",{"_3844":645,"_33198":484,"_22654":56384,"_5":15607,"_29907":55985,"_3297":56385},[],"that the policy includes the action and the requested resource type or route;",{"_3844":646,"_33198":484,"_22654":56387,"_5":15607,"_29907":55985,"_3297":56388},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3844":647,"_33198":484,"_22654":56390,"_5":15607,"_29907":55985,"_3297":56391},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3844":648,"_33198":484,"_22654":56393,"_5":15607,"_29907":55989,"_3297":56394},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3844":649,"_33198":484,"_22654":56396,"_5":15607,"_29907":55993,"_3297":56397},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3844":650,"_33198":484,"_22654":56399,"_5":15607,"_29907":55997,"_3297":56400},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3844":651,"_33198":484,"_22654":56402,"_5":15607,"_29907":55997,"_3297":56403},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3844":652,"_33198":652,"_5":16006,"_3297":56405,"_33604":56406,"_22654":56407,"_29907":652},"Alerts and subscriptions",[54402,55870,55871],[],{"_3844":653,"_33198":652,"_22654":56409,"_5":15607,"_29907":652,"_3297":56410},[],"Send PKI events to people and external systems.",{"_3844":654,"_33198":652,"_5":33601,"_22654":56412,"_29907":56413,"_3297":56414},[],"/docs/pr-preview/pr-58/platform/administration/alerts#how-it-works","How it works",{"_3844":655,"_33198":652,"_5":33601,"_22654":56416,"_29907":56417,"_3297":56418},[],"/docs/pr-preview/pr-58/platform/administration/alerts#available-channels","Available channels",{"_3844":656,"_33198":652,"_5":33601,"_22654":56420,"_29907":56421,"_3297":56422},[],"/docs/pr-preview/pr-58/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3844":657,"_33198":652,"_5":33601,"_22654":56424,"_29907":56425,"_3297":56426},[],"/docs/pr-preview/pr-58/platform/administration/alerts#choose-the-event","Choose the event",{"_3844":658,"_33198":652,"_5":33601,"_22654":56428,"_29907":56429,"_3297":56430},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3844":659,"_33198":652,"_5":33601,"_22654":56432,"_29907":56433,"_3297":56434},[],"/docs/pr-preview/pr-58/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3844":660,"_33198":652,"_5":33601,"_22654":56436,"_29907":56437,"_3297":56438},[],"/docs/pr-preview/pr-58/platform/administration/alerts#review-and-activate","Review and activate",{"_3844":661,"_33198":652,"_5":33601,"_22654":56440,"_29907":56441,"_3297":56442},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3844":662,"_33198":652,"_5":33601,"_22654":56444,"_29907":56445,"_3297":56446},[],"/docs/pr-preview/pr-58/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3844":663,"_33198":652,"_5":33601,"_22654":56448,"_29907":56449,"_3297":56450},[],"/docs/pr-preview/pr-58/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3844":664,"_33198":652,"_5":33601,"_22654":56452,"_29907":56453,"_3297":56454},[],"/docs/pr-preview/pr-58/platform/administration/alerts#event-families","Event families",{"_3844":665,"_33198":652,"_22654":56456,"_5":15607,"_29907":652,"_3297":56457},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3844":666,"_33198":652,"_22654":56459,"_5":15607,"_29907":56413,"_3297":56460},[],"A service publishes a domain event.",{"_3844":667,"_33198":652,"_22654":56462,"_5":15607,"_29907":56413,"_3297":56463},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3844":668,"_33198":652,"_22654":56465,"_5":15607,"_29907":56413,"_3297":56466},[],"Each subscription's filter decides whether it should be notified.",{"_3844":669,"_33198":652,"_22654":56468,"_5":15607,"_29907":56413,"_3297":56469},[],"Lamassu delivers the event to the configured channel.",{"_3844":670,"_33198":652,"_22654":56471,"_5":15607,"_29907":56413,"_3297":56472},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3844":671,"_33198":652,"_22654":56474,"_5":15607,"_29907":56417,"_3297":56475},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3844":672,"_33198":652,"_22654":56477,"_5":15607,"_29907":56417,"_3297":56478},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3844":673,"_33198":652,"_22654":56480,"_5":15607,"_29907":56417,"_3297":56481},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3844":674,"_33198":652,"_22654":56483,"_5":15607,"_29907":56417,"_3297":56484},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3844":675,"_33198":652,"_22654":56486,"_5":15607,"_29907":56417,"_3297":56487},[],"`apikey_options` requires `header` and `key`.",{"_3844":676,"_33198":652,"_22654":56489,"_5":15607,"_29907":56417,"_3297":56490},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3844":677,"_33198":652,"_22654":56492,"_5":15607,"_29907":56417,"_3297":56493},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3844":678,"_33198":652,"_22654":56495,"_5":15607,"_29907":56417,"_3297":56496},[],"The alerts API reference documents the full `http_client` schema.",{"_3844":679,"_33198":652,"_22654":56498,"_5":15607,"_29907":56425,"_3297":56499},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3844":680,"_33198":652,"_22654":56501,"_5":15607,"_29907":56429,"_3297":56502},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3844":681,"_33198":652,"_22654":56504,"_5":15607,"_29907":56433,"_3297":56505},[],"Add a filter if you don't want to receive every instance of the event.",{"_3844":682,"_33198":652,"_22654":56507,"_5":15607,"_29907":56433,"_3297":56508},[],"**None** notifies all instances of the event.",{"_3844":683,"_33198":652,"_22654":56510,"_5":15607,"_29907":56433,"_3297":56511},[],"**JSON Path** evaluates one or more specific fields.",{"_3844":684,"_33198":652,"_22654":56513,"_5":15607,"_29907":56433,"_3297":56514},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3844":685,"_33198":652,"_22654":56516,"_5":15607,"_29907":56433,"_3297":56517},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3844":686,"_33198":652,"_22654":56519,"_5":15607,"_29907":56433,"_3297":56520},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3844":687,"_33198":652,"_22654":56522,"_5":15607,"_29907":56433,"_3297":56523},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3844":688,"_33198":652,"_22654":56525,"_5":15607,"_29907":56437,"_3297":56526},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3844":689,"_33198":652,"_22654":56528,"_5":15607,"_29907":56441,"_3297":56529},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3844":690,"_33198":652,"_22654":56531,"_5":15607,"_29907":56441,"_3297":56532},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3844":691,"_33198":652,"_22654":56534,"_5":15607,"_29907":56441,"_3297":56535},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3844":692,"_33198":652,"_22654":56537,"_5":15607,"_29907":56441,"_3297":56538},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3844":693,"_33198":652,"_22654":56540,"_5":15607,"_29907":56441,"_3297":56541},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3844":694,"_33198":652,"_22654":56543,"_5":15607,"_29907":56441,"_3297":56544},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3844":695,"_33198":652,"_22654":56546,"_5":15607,"_29907":56441,"_3297":56547},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3844":696,"_33198":652,"_22654":56549,"_5":15607,"_29907":56441,"_3297":56550},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3844":697,"_33198":652,"_22654":56552,"_5":15607,"_29907":56445,"_3297":56553},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3844":698,"_33198":652,"_22654":56555,"_5":15607,"_29907":56445,"_3297":56556},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3844":699,"_33198":652,"_22654":56558,"_5":15607,"_29907":56445,"_3297":56559},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3844":700,"_33198":652,"_22654":56561,"_5":15607,"_29907":56445,"_3297":56562},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3844":701,"_33198":652,"_22654":56564,"_5":15607,"_29907":56445,"_3297":56565},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3844":702,"_33198":652,"_22654":56567,"_5":15607,"_29907":56445,"_3297":56568},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3844":703,"_33198":652,"_22654":56570,"_5":15607,"_29907":56445,"_3297":56571},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3844":704,"_33198":652,"_22654":56573,"_5":15607,"_29907":56445,"_3297":56574},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3844":705,"_33198":652,"_22654":56576,"_5":15607,"_29907":56449,"_3297":56577},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3844":706,"_33198":652,"_22654":56579,"_5":15607,"_29907":56449,"_3297":56580},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3844":707,"_33198":652,"_22654":56582,"_5":15607,"_29907":56453,"_3297":56583},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3844":708,"_33198":652,"_22654":56585,"_5":15607,"_29907":56453,"_3297":56586},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3844":709,"_33198":652,"_22654":56588,"_5":15607,"_29907":56453,"_3297":56589},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3844":710,"_33198":652,"_22654":56591,"_5":15607,"_29907":56453,"_3297":56592},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3844":711,"_33198":652,"_22654":56594,"_5":15607,"_29907":56453,"_3297":56595},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3844":712,"_33198":652,"_22654":56597,"_5":15607,"_29907":56453,"_3297":56598},[],"**Validation:** `va.role.crl.create`.",{"_3844":713,"_33198":652,"_22654":56600,"_5":15607,"_29907":56453,"_3297":56601},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3844":714,"_33198":652,"_22654":56603,"_5":15607,"_29907":56453,"_3297":56604},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3844":715,"_33198":715,"_5":16006,"_3297":56606,"_33604":56607,"_22654":56608,"_29907":715},"Audit logs",[54402,55870,55871],[],{"_3844":716,"_33198":715,"_22654":56610,"_5":15607,"_29907":715,"_3297":56611},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3844":717,"_33198":715,"_5":33601,"_22654":56613,"_29907":56614,"_3297":56615},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3844":718,"_33198":715,"_5":33601,"_22654":56617,"_29907":56618,"_3297":56619},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#coverage","Coverage",{"_3844":719,"_33198":715,"_5":33601,"_22654":56621,"_29907":56622,"_3297":56623},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3844":720,"_33198":715,"_5":33601,"_22654":56625,"_29907":56626,"_3297":56627},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3844":721,"_33198":715,"_5":33601,"_22654":56629,"_29907":56630,"_3297":56631},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3844":722,"_33198":715,"_5":33601,"_22654":56633,"_29907":56634,"_3297":56635},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3844":723,"_33198":715,"_5":33601,"_22654":56637,"_29907":56638,"_3297":56639},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3844":724,"_33198":715,"_5":33601,"_22654":56641,"_29907":56642,"_3297":56643},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3844":725,"_33198":715,"_5":33601,"_22654":56645,"_29907":56646,"_3297":56647},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3844":726,"_33198":715,"_5":33601,"_22654":56649,"_29907":56650,"_3297":56651},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3844":727,"_33198":715,"_5":33601,"_22654":56653,"_29907":56654,"_3297":56655},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3844":728,"_33198":715,"_22654":56657,"_5":15607,"_29907":715,"_3297":56658},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3844":729,"_33198":715,"_22654":56660,"_5":15607,"_29907":56614,"_3297":56661},[],"The audit body includes:",{"_3844":730,"_33198":715,"_22654":56663,"_5":15607,"_29907":56614,"_3297":56664},[],"input: data received by the operation;",{"_3844":731,"_33198":715,"_22654":56666,"_5":15607,"_29907":56614,"_3297":56667},[],"has\\_error: whether the service returned an error;",{"_3844":732,"_33198":715,"_22654":56669,"_5":15607,"_29907":56614,"_3297":56670},[],"output: produced result or error message;",{"_3844":733,"_33198":715,"_22654":56672,"_5":15607,"_29907":56614,"_3297":56673},[],"principals: identifiers of the principals that matched the request.",{"_3844":734,"_33198":715,"_22654":56675,"_5":15607,"_29907":56614,"_3297":56676},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3844":735,"_33198":715,"_22654":56678,"_5":15607,"_29907":56614,"_3297":56679},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3844":736,"_33198":715,"_22654":56681,"_5":15607,"_29907":56618,"_3297":56682},[],"The backend applies auditing to mutations of:",{"_3844":737,"_33198":715,"_22654":56684,"_5":15607,"_29907":56618,"_3297":56685},[],"authorities, certificates and issuance profiles;",{"_3844":738,"_33198":715,"_22654":56687,"_5":15607,"_29907":56618,"_3297":56688},[],"keys and KMS engines;",{"_3844":739,"_33198":715,"_22654":56690,"_5":15607,"_29907":56618,"_3297":56691},[],"devices and identities;",{"_3844":740,"_33198":715,"_22654":56693,"_5":15607,"_29907":56618,"_3297":56694},[],"DMSs and enrollment operations;",{"_3844":741,"_33198":715,"_22654":56696,"_5":15607,"_29907":56618,"_3297":56697},[],"validation functions and CRL;",{"_3844":742,"_33198":715,"_22654":56699,"_5":15607,"_29907":56618,"_3297":56700},[],"principals, policies and authorization grants.",{"_3844":743,"_33198":715,"_22654":56702,"_5":15607,"_29907":56618,"_3297":56703},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3844":744,"_33198":715,"_22654":56705,"_5":15607,"_29907":56622,"_3297":56706},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3844":745,"_33198":715,"_22654":56708,"_5":15607,"_29907":56622,"_3297":56709},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3844":746,"_33198":715,"_22654":56711,"_5":15607,"_29907":56622,"_3297":56712},[],"Design the consumer to:",{"_3844":747,"_33198":715,"_22654":56714,"_5":15607,"_29907":56622,"_3297":56715},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3844":748,"_33198":715,"_22654":56717,"_5":15607,"_29907":56622,"_3297":56718},[],"keep the complete CloudEvent unmodified;",{"_3844":749,"_33198":715,"_22654":56720,"_5":15607,"_29907":56622,"_3297":56721},[],"record the ingestion time and detect duplicates by ID;",{"_3844":750,"_33198":715,"_22654":56723,"_5":15607,"_29907":56622,"_3297":56724},[],"encrypt in transit and at rest;",{"_3844":751,"_33198":715,"_22654":56726,"_5":15607,"_29907":56622,"_3297":56727},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3844":752,"_33198":715,"_22654":56729,"_5":15607,"_29907":56622,"_3297":56730},[],"apply an explicit retention and legal hold policy;",{"_3844":753,"_33198":715,"_22654":56732,"_5":15607,"_29907":56622,"_3297":56733},[],"alert if it stops consuming or the pending queue grows.",{"_3844":754,"_33198":715,"_22654":56735,"_5":15607,"_29907":56626,"_3297":56736},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3844":755,"_33198":715,"_22654":56738,"_5":15607,"_29907":56626,"_3297":56739},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3844":756,"_33198":715,"_22654":56741,"_5":15607,"_29907":56634,"_3297":56742},[],"Start from the reported time and normalize every source to UTC.",{"_3844":757,"_33198":715,"_22654":56744,"_5":15607,"_29907":56638,"_3297":56745},[],"Filter by event type, service source and resource identifier.",{"_3844":758,"_33198":715,"_22654":56747,"_5":15607,"_29907":56642,"_3297":56748},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3844":759,"_33198":715,"_22654":56750,"_5":15607,"_29907":56646,"_3297":56751},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3844":760,"_33198":715,"_22654":56753,"_5":15607,"_29907":56650,"_3297":56754},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3844":761,"_33198":715,"_22654":56756,"_5":15607,"_29907":56654,"_3297":56757},[],"Generate a controlled mutation in a test environment and check that:",{"_3844":762,"_33198":715,"_22654":56759,"_5":15607,"_29907":56654,"_3297":56760},[],"a successful audit event appears;",{"_3844":763,"_33198":715,"_22654":56762,"_5":15607,"_29907":56654,"_3297":56763},[],"the principal matches the identity used;",{"_3844":764,"_33198":715,"_22654":56765,"_5":15607,"_29907":56654,"_3297":56766},[],"the consumer persists it exactly once;",{"_3844":765,"_33198":715,"_22654":56768,"_5":15607,"_29907":56654,"_3297":56769},[],"it can be retrieved by resource, actor and period;",{"_3844":766,"_33198":715,"_22654":56771,"_5":15607,"_29907":56654,"_3297":56772},[],"a consumer outage raises an alert.",{"_3844":767,"_33198":715,"_22654":56774,"_5":15607,"_29907":56654,"_3297":56775},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3844":768,"_33198":768,"_5":16006,"_3297":56777,"_33604":56778,"_22654":56779,"_29907":768},"Platform architecture",[54402,55870],[],{"_3844":769,"_33198":768,"_22654":56781,"_5":15607,"_29907":768,"_3297":56782},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3844":770,"_33198":768,"_5":33601,"_22654":56784,"_29907":56785,"_3297":56786},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#control-plane","Control plane",{"_3844":771,"_33198":768,"_5":33601,"_22654":56788,"_29907":56789,"_3297":56790},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3844":772,"_33198":768,"_5":33601,"_22654":56792,"_29907":56793,"_3297":56794},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3844":773,"_33198":768,"_5":33601,"_22654":56796,"_29907":56797,"_3297":56798},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#status-and-validation","Status and validation",{"_3844":774,"_33198":768,"_5":33601,"_22654":56800,"_29907":56801,"_3297":56802},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3844":775,"_33198":768,"_22654":56804,"_5":15607,"_29907":768,"_3297":56805},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3844":776,"_33198":768,"_22654":56807,"_5":15607,"_29907":768,"_3297":56808},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3844":777,"_33198":768,"_22654":56810,"_5":15607,"_29907":56785,"_3297":56811},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3844":778,"_33198":768,"_22654":56813,"_5":15607,"_29907":56789,"_3297":56814},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3844":779,"_33198":768,"_22654":56816,"_5":15607,"_29907":56793,"_3297":56817},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3844":780,"_33198":768,"_22654":56819,"_5":15607,"_29907":56797,"_3297":56820},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3844":781,"_33198":768,"_22654":56822,"_5":15607,"_29907":56801,"_3297":56823},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3844":782,"_33198":782,"_5":16006,"_3297":56825,"_33604":56826,"_22654":56827,"_29907":782},"How Lamassu works",[54402,55870],[],{"_3844":783,"_33198":782,"_22654":56829,"_5":15607,"_29907":782,"_3297":56830},[],"The mental model of trust, keys, certificates and devices.",{"_3844":784,"_33198":782,"_5":33601,"_22654":56832,"_29907":56833,"_3297":56834},[],"/docs/pr-preview/pr-58/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3844":785,"_33198":782,"_5":33601,"_22654":56836,"_29907":56837,"_3297":56838},[],"/docs/pr-preview/pr-58/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3844":786,"_33198":782,"_22654":56840,"_5":15607,"_29907":782,"_3297":56841},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3844":787,"_33198":782,"_22654":56843,"_5":15607,"_29907":56833,"_3297":56844},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3844":788,"_33198":782,"_22654":56846,"_5":15607,"_29907":56833,"_3297":56847},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3844":789,"_33198":782,"_22654":56849,"_5":15607,"_29907":56833,"_3297":56850},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3844":790,"_33198":782,"_22654":56852,"_5":15607,"_29907":56833,"_3297":56853},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3844":791,"_33198":782,"_22654":56855,"_5":15607,"_29907":56833,"_3297":56856},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3844":792,"_33198":782,"_22654":56858,"_5":15607,"_29907":56837,"_3297":56859},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3844":793,"_33198":782,"_22654":56861,"_5":15607,"_29907":56837,"_3297":56862},[],"A DMS relates that CA to an enrollment policy.",{"_3844":794,"_33198":782,"_22654":56864,"_5":15607,"_29907":56837,"_3297":56865},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3844":795,"_33198":782,"_22654":56867,"_5":15607,"_29907":56837,"_3297":56868},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3844":796,"_33198":782,"_22654":56870,"_5":15607,"_29907":56837,"_3297":56871},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3844":797,"_33198":782,"_22654":56873,"_5":15607,"_29907":56837,"_3297":56874},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3844":798,"_33198":782,"_22654":56876,"_5":15607,"_29907":56837,"_3297":56877},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3844":799,"_33198":799,"_5":16006,"_3297":56879,"_33604":56880,"_22654":56882,"_29907":799},"Devices and identities",[54402,55870,56881,56879],"IoT Fleets",[],{"_3844":800,"_33198":799,"_22654":56884,"_5":15607,"_29907":799,"_3297":56885},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3844":801,"_33198":799,"_5":33601,"_22654":56887,"_29907":56888,"_3297":56889},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#device-states","Device states",{"_3844":802,"_33198":799,"_5":33601,"_22654":56891,"_29907":56892,"_3297":56893},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3844":803,"_33198":799,"_5":33601,"_22654":56895,"_29907":56896,"_3297":56897},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3844":804,"_33198":799,"_5":33601,"_22654":56899,"_29907":56900,"_3297":56901},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3844":805,"_33198":799,"_5":33601,"_22654":56903,"_29907":56904,"_3297":56905},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3844":806,"_33198":799,"_5":33601,"_22654":56907,"_29907":56908,"_3297":56909},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3844":807,"_33198":799,"_5":33601,"_22654":56911,"_29907":56912,"_3297":56913},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3844":808,"_33198":799,"_5":33601,"_22654":56915,"_29907":56916,"_3297":56917},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3844":809,"_33198":799,"_5":33601,"_22654":56919,"_29907":56920,"_3297":56921},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3844":810,"_33198":799,"_5":33601,"_22654":56923,"_29907":56924,"_3297":56925},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3844":811,"_33198":799,"_5":33601,"_22654":56927,"_29907":56928,"_3297":56929},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3844":812,"_33198":799,"_22654":56931,"_5":15607,"_29907":799,"_3297":56932},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3844":813,"_33198":799,"_22654":56934,"_5":15607,"_29907":799,"_3297":56935},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3844":814,"_33198":799,"_22654":56937,"_5":15607,"_29907":56888,"_3297":56938},[],"Operational view",{"_3844":815,"_33198":799,"_22654":56940,"_5":15607,"_29907":56888,"_3297":56941},[],"Meaning",{"_3844":816,"_33198":799,"_22654":56943,"_5":15607,"_29907":56888,"_3297":56944},[],"**No Identity**",{"_3844":817,"_33198":799,"_22654":56946,"_5":15607,"_29907":56888,"_3297":56947},[],"A record exists without an associated identity.",{"_3844":818,"_33198":799,"_22654":56949,"_5":15607,"_29907":56888,"_3297":56950},[],"**Active**",{"_3844":819,"_33198":799,"_22654":56952,"_5":15607,"_29907":56888,"_3297":56953},[],"The slot is active; also check certificate dates, status and usages.",{"_3844":820,"_33198":799,"_22654":56955,"_5":15607,"_29907":56888,"_3297":56956},[],"**Renewal Pending**",{"_3844":821,"_33198":799,"_22654":56958,"_5":15607,"_29907":56888,"_3297":56959},[],"The identity is in the operational renewal window.",{"_3844":822,"_33198":799,"_22654":56961,"_5":15607,"_29907":56888,"_3297":56962},[],"**Expiring Soon**",{"_3844":823,"_33198":799,"_22654":56964,"_5":15607,"_29907":56888,"_3297":56965},[],"Expiration is approaching according to configured thresholds.",{"_3844":824,"_33198":799,"_22654":56967,"_5":15607,"_29907":56888,"_3297":56968},[],"**Expired**",{"_3844":825,"_33198":799,"_22654":56970,"_5":15607,"_29907":56888,"_3297":56971},[],"The identity has expired.",{"_3844":826,"_33198":799,"_22654":56973,"_5":15607,"_29907":56888,"_3297":56974},[],"**Revoked**",{"_3844":827,"_33198":799,"_22654":56976,"_5":15607,"_29907":56888,"_3297":56977},[],"The identity is marked revoked.",{"_3844":828,"_33198":799,"_22654":56979,"_5":15607,"_29907":56888,"_3297":56980},[],"**Decommissioned**",{"_3844":829,"_33198":799,"_22654":56982,"_5":15607,"_29907":56888,"_3297":56983},[],"The record is retired and ordinary updates do not restore operation.",{"_3844":830,"_33198":799,"_22654":56985,"_5":15607,"_29907":56888,"_3297":56986},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3844":831,"_33198":799,"_22654":56988,"_5":15607,"_29907":56892,"_3297":56989},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3844":832,"_33198":799,"_22654":56991,"_5":15607,"_29907":56892,"_3297":56992},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3844":833,"_33198":799,"_22654":56994,"_5":15607,"_29907":56892,"_3297":56995},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3844":834,"_33198":799,"_22654":56997,"_5":15607,"_29907":56892,"_3297":56998},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3844":835,"_33198":799,"_22654":57000,"_5":15607,"_29907":56896,"_3297":57001},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3844":836,"_33198":799,"_22654":57003,"_5":15607,"_29907":56900,"_3297":57004},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3844":837,"_33198":799,"_22654":57006,"_5":15607,"_29907":56904,"_3297":57007},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3844":838,"_33198":799,"_22654":57009,"_5":15607,"_29907":56908,"_3297":57010},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3844":839,"_33198":799,"_22654":57012,"_5":15607,"_29907":56912,"_3297":57013},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3844":840,"_33198":799,"_22654":57015,"_5":15607,"_29907":56912,"_3297":57016},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3844":841,"_33198":799,"_22654":57018,"_5":15607,"_29907":56916,"_3297":57019},[],"From **No Identity**, use **Assign Identity**:",{"_3844":842,"_33198":799,"_22654":57021,"_5":15607,"_29907":56916,"_3297":57022},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3844":843,"_33198":799,"_22654":57024,"_5":15607,"_29907":56916,"_3297":57025},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3844":844,"_33198":799,"_22654":57027,"_5":15607,"_29907":56916,"_3297":57028},[],"Confirm and read the serial, active version and history again.",{"_3844":845,"_33198":799,"_22654":57030,"_5":15607,"_29907":56916,"_3297":57031},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3844":846,"_33198":799,"_22654":57033,"_5":15607,"_29907":56916,"_3297":57034},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3844":847,"_33198":799,"_22654":57036,"_5":15607,"_29907":56920,"_3297":57037},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3844":848,"_33198":799,"_22654":57039,"_5":15607,"_29907":56920,"_3297":57040},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3844":849,"_33198":799,"_22654":57042,"_5":15607,"_29907":56924,"_3297":57043},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3844":850,"_33198":799,"_22654":57045,"_5":15607,"_29907":56924,"_3297":57046},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3844":851,"_33198":799,"_22654":57048,"_5":15607,"_29907":56924,"_3297":57049},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3844":852,"_33198":799,"_22654":57051,"_5":15607,"_29907":56924,"_3297":57052},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3844":853,"_33198":799,"_22654":57054,"_5":15607,"_29907":56928,"_3297":57055},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3844":854,"_33198":799,"_22654":57057,"_5":15607,"_29907":56928,"_3297":57058},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3844":855,"_33198":855,"_5":16006,"_3297":57060,"_33604":57061,"_22654":57063,"_29907":855},"Bootstrap identity and authentication",[54402,55870,56881,56879,57062],"Enrollment with PKI",[],{"_3844":856,"_33198":855,"_22654":57065,"_5":15607,"_29907":855,"_3297":57066},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3844":857,"_33198":855,"_5":33601,"_22654":57068,"_29907":57069,"_3297":57070},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3844":858,"_33198":855,"_5":33601,"_22654":57072,"_29907":57073,"_3297":57074},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3844":859,"_33198":855,"_5":33601,"_22654":57076,"_29907":57077,"_3297":57078},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3844":860,"_33198":855,"_5":33601,"_22654":57080,"_29907":57081,"_3297":57082},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3844":861,"_33198":855,"_5":33601,"_22654":57084,"_29907":57085,"_3297":57086},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3844":862,"_33198":855,"_22654":57088,"_5":15607,"_29907":855,"_3297":57089},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3844":863,"_33198":855,"_22654":57091,"_5":15607,"_29907":57069,"_3297":57092},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3844":864,"_33198":855,"_22654":57094,"_5":15607,"_29907":57069,"_3297":57095},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3844":865,"_33198":855,"_22654":57097,"_5":15607,"_29907":57073,"_3297":57098},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3844":866,"_33198":855,"_22654":57100,"_5":15607,"_29907":57073,"_3297":57101},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3844":867,"_33198":855,"_22654":57103,"_5":15607,"_29907":57073,"_3297":57104},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3844":868,"_33198":855,"_22654":57106,"_5":15607,"_29907":57077,"_3297":57107},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3844":869,"_33198":855,"_22654":57109,"_5":15607,"_29907":57077,"_3297":57110},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3844":870,"_33198":855,"_22654":57112,"_5":15607,"_29907":57081,"_3297":57113},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3844":871,"_33198":855,"_22654":57115,"_5":15607,"_29907":57081,"_3297":57116},[],"Example body:",{"_3844":872,"_33198":855,"_22654":57118,"_5":15607,"_29907":57081,"_3297":57119},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3844":873,"_33198":855,"_22654":57121,"_5":15607,"_29907":57081,"_3297":57122},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3844":874,"_33198":855,"_22654":57124,"_5":15607,"_29907":57081,"_3297":57125},[],"Continuation requires a successful HTTP response and JSON:",{"_3844":875,"_33198":855,"_22654":57127,"_5":15607,"_29907":57081,"_3297":57128},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3844":876,"_33198":855,"_22654":57130,"_5":15607,"_29907":57085,"_3297":57131},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3844":877,"_33198":855,"_22654":57133,"_5":15607,"_29907":57085,"_3297":57134},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3844":878,"_33198":878,"_5":16006,"_3297":57136,"_33604":57137,"_22654":57138,"_29907":878},"Configure and operate the DMS",[54402,55870,56881,56879,57062],[],{"_3844":879,"_33198":878,"_22654":57140,"_5":15607,"_29907":878,"_3297":57141},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3844":880,"_33198":878,"_5":33601,"_22654":57143,"_29907":57144,"_3297":54412},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3844":881,"_33198":878,"_5":33601,"_22654":57146,"_29907":57147,"_3297":57148},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3844":882,"_33198":878,"_5":33601,"_22654":57150,"_29907":57151,"_3297":57152},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3844":883,"_33198":878,"_5":33601,"_22654":57154,"_29907":57155,"_3297":57156},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3844":884,"_33198":878,"_5":33601,"_22654":57158,"_29907":57159,"_3297":57160},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3844":885,"_33198":878,"_5":33601,"_22654":57162,"_29907":57163,"_3297":57164},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3844":886,"_33198":878,"_5":33601,"_22654":57166,"_29907":57167,"_3297":57168},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3844":887,"_33198":878,"_5":33601,"_22654":57170,"_29907":57171,"_3297":57172},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3844":888,"_33198":878,"_5":33601,"_22654":57174,"_29907":57175,"_3297":57176},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3844":889,"_33198":878,"_5":33601,"_22654":57178,"_29907":57179,"_3297":57180},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3844":890,"_33198":878,"_5":33601,"_22654":57182,"_29907":57183,"_3297":57184},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3844":891,"_33198":878,"_5":33601,"_22654":57186,"_29907":57187,"_3297":57188},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3844":892,"_33198":878,"_5":33601,"_22654":57190,"_29907":57191,"_3297":57192},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3844":893,"_33198":878,"_5":33601,"_22654":57194,"_29907":57195,"_3297":57196},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3844":894,"_33198":878,"_5":33601,"_22654":57198,"_29907":57199,"_3297":57200},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3844":895,"_33198":878,"_5":33601,"_22654":57202,"_29907":57203,"_3297":57204},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3844":896,"_33198":878,"_5":33601,"_22654":57206,"_29907":57207,"_3297":57208},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3844":897,"_33198":878,"_5":33601,"_22654":57210,"_29907":57211,"_3297":57212},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3844":898,"_33198":878,"_22654":57214,"_5":15607,"_29907":878,"_3297":57215},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3844":899,"_33198":878,"_22654":57217,"_5":15607,"_29907":57144,"_3297":57218},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3844":900,"_33198":878,"_22654":57220,"_5":15607,"_29907":57144,"_3297":57221},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3844":901,"_33198":878,"_22654":57223,"_5":15607,"_29907":57151,"_3297":57224},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3844":902,"_33198":878,"_22654":57226,"_5":15607,"_29907":57155,"_3297":57227},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3844":903,"_33198":878,"_22654":57229,"_5":15607,"_29907":57159,"_3297":57230},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3844":904,"_33198":878,"_22654":57232,"_5":15607,"_29907":57163,"_3297":57233},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3844":905,"_33198":878,"_22654":57235,"_5":15607,"_29907":57167,"_3297":57236},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3844":906,"_33198":878,"_22654":57238,"_5":15607,"_29907":57175,"_3297":57239},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3844":907,"_33198":878,"_22654":57241,"_5":15607,"_29907":57175,"_3297":57242},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3844":908,"_33198":878,"_22654":57244,"_5":15607,"_29907":57179,"_3297":57245},[],"`settings.enrollment_settings` field",{"_3844":909,"_33198":878,"_22654":57247,"_5":15607,"_29907":57179,"_3297":57248},[],"Decision",{"_3844":910,"_33198":878,"_22654":57250,"_5":15607,"_29907":57179,"_3297":57251},[],"`protocol`",{"_3844":911,"_33198":878,"_22654":57253,"_5":15607,"_29907":57179,"_3297":57254},[],"`EST_RFC7030` for these operations.",{"_3844":912,"_33198":878,"_22654":57256,"_5":15607,"_29907":57179,"_3297":57257},[],"`enrollment_ca`",{"_3844":913,"_33198":878,"_22654":57259,"_5":15607,"_29907":57179,"_3297":57260},[],"ID of the signing CA.",{"_3844":914,"_33198":878,"_22654":57262,"_5":15607,"_29907":57179,"_3297":57263},[],"`verify_csr_signature`",{"_3844":915,"_33198":878,"_22654":57265,"_5":15607,"_29907":57179,"_3297":57266},[],"Keep `true` to verify CSR key possession.",{"_3844":916,"_33198":878,"_22654":57268,"_5":15607,"_29907":57179,"_3297":57269},[],"`enable_replaceable_enrollment`",{"_3844":917,"_33198":878,"_22654":57271,"_5":15607,"_29907":57179,"_3297":57272},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3844":918,"_33198":878,"_22654":57274,"_5":15607,"_29907":57179,"_3297":57275},[],"`est_rfc7030_settings.auth_mode`",{"_3844":919,"_33198":878,"_22654":57277,"_5":15607,"_29907":57179,"_3297":57278},[],"One of the four authentication modes.",{"_3844":920,"_33198":878,"_22654":57280,"_5":15607,"_29907":57179,"_3297":57281},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3844":921,"_33198":878,"_22654":57283,"_5":15607,"_29907":57183,"_3297":57284},[],"The blocks are independent:",{"_3844":922,"_33198":878,"_22654":57286,"_5":15607,"_29907":57183,"_3297":57287},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3844":923,"_33198":878,"_22654":57289,"_5":15607,"_29907":57183,"_3297":57290},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3844":924,"_33198":878,"_22654":57292,"_5":15607,"_29907":57183,"_3297":57293},[],"`auth_mode`",{"_3844":925,"_33198":878,"_22654":57295,"_5":15607,"_29907":57183,"_3297":57296},[],"Control applied in the configured operation",{"_3844":926,"_33198":878,"_22654":57298,"_5":15607,"_29907":57183,"_3297":57299},[],"`CLIENT_CERTIFICATE`",{"_3844":927,"_33198":878,"_22654":57301,"_5":15607,"_29907":57183,"_3297":57302},[],"Presented certificate validation.",{"_3844":928,"_33198":878,"_22654":57304,"_5":15607,"_29907":57183,"_3297":57305},[],"`EXTERNAL_WEBHOOK`",{"_3844":929,"_33198":878,"_22654":57307,"_5":15607,"_29907":57183,"_3297":57308},[],"Configured webhook authorization.",{"_3844":930,"_33198":878,"_22654":57310,"_5":15607,"_29907":57183,"_3297":57311},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3844":931,"_33198":878,"_22654":57313,"_5":15607,"_29907":57183,"_3297":57314},[],"Certificate validation followed by webhook approval.",{"_3844":932,"_33198":878,"_22654":57316,"_5":15607,"_29907":57183,"_3297":57317},[],"`NO_AUTH`",{"_3844":933,"_33198":878,"_22654":57319,"_5":15607,"_29907":57183,"_3297":57320},[],"No DMS requester authentication.",{"_3844":934,"_33198":878,"_22654":57322,"_5":15607,"_29907":57183,"_3297":57323},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3844":935,"_33198":878,"_22654":57325,"_5":15607,"_29907":57183,"_3297":57326},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3844":936,"_33198":878,"_22654":57328,"_5":15607,"_29907":57183,"_3297":57329},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3844":937,"_33198":878,"_22654":57331,"_5":15607,"_29907":57183,"_3297":57332},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3844":938,"_33198":878,"_22654":57334,"_5":15607,"_29907":57187,"_3297":57335},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3844":939,"_33198":878,"_22654":57337,"_5":15607,"_29907":57187,"_3297":57338},[],"`external_webhook_settings` field",{"_3844":940,"_33198":878,"_22654":57340,"_5":15607,"_29907":57187,"_3297":57248},[],{"_3844":941,"_33198":878,"_22654":57342,"_5":15607,"_29907":57187,"_3297":57343},[],"`url`",{"_3844":942,"_33198":878,"_22654":57345,"_5":15607,"_29907":57187,"_3297":57346},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3844":943,"_33198":878,"_22654":57348,"_5":15607,"_29907":57187,"_3297":57349},[],"`method`",{"_3844":944,"_33198":878,"_22654":57351,"_5":15607,"_29907":57187,"_3297":57352},[],"`POST` or `PUT`; `POST` by default.",{"_3844":945,"_33198":878,"_22654":57354,"_5":15607,"_29907":57187,"_3297":57355},[],"`name`",{"_3844":946,"_33198":878,"_22654":57357,"_5":15607,"_29907":57187,"_3297":57358},[],"Label used in service logs.",{"_3844":947,"_33198":878,"_22654":57360,"_5":15607,"_29907":57187,"_3297":57361},[],"`config.auth_mode`",{"_3844":948,"_33198":878,"_22654":57363,"_5":15607,"_29907":57187,"_3297":57364},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3844":949,"_33198":878,"_22654":57366,"_5":15607,"_29907":57187,"_3297":57367},[],"`config.log_level`",{"_3844":950,"_33198":878,"_22654":57369,"_5":15607,"_29907":57187,"_3297":57370},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3844":951,"_33198":878,"_22654":57372,"_5":15607,"_29907":57187,"_3297":57373},[],"`config.apikey_options`",{"_3844":952,"_33198":878,"_22654":57375,"_5":15607,"_29907":57187,"_3297":57376},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3844":953,"_33198":878,"_22654":57378,"_5":15607,"_29907":57187,"_3297":57379},[],"`config.jwt_options`",{"_3844":954,"_33198":878,"_22654":57381,"_5":15607,"_29907":57187,"_3297":57382},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3844":955,"_33198":878,"_22654":57384,"_5":15607,"_29907":57187,"_3297":57385},[],"`config.mtls_options`",{"_3844":956,"_33198":878,"_22654":57387,"_5":15607,"_29907":57187,"_3297":57388},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3844":957,"_33198":878,"_22654":57390,"_5":15607,"_29907":57187,"_3297":57391},[],"`config.insecure_skip_verify`",{"_3844":958,"_33198":878,"_22654":57393,"_5":15607,"_29907":57187,"_3297":57394},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3844":959,"_33198":878,"_22654":57396,"_5":15607,"_29907":57187,"_3297":57397},[],"`config.call_timeout`",{"_3844":960,"_33198":878,"_22654":57399,"_5":15607,"_29907":57187,"_3297":57400},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3844":961,"_33198":878,"_22654":57402,"_5":15607,"_29907":57187,"_3297":57403},[],"Rules for that configuration:",{"_3844":962,"_33198":878,"_22654":57405,"_5":15607,"_29907":57187,"_3297":57406},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3844":963,"_33198":878,"_22654":57408,"_5":15607,"_29907":57187,"_3297":57409},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3844":964,"_33198":878,"_22654":57411,"_5":15607,"_29907":57187,"_3297":57412},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3844":965,"_33198":878,"_22654":57414,"_5":15607,"_29907":57187,"_3297":57415},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3844":966,"_33198":878,"_22654":57417,"_5":15607,"_29907":57187,"_3297":57418},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3844":967,"_33198":878,"_22654":57420,"_5":15607,"_29907":57187,"_3297":57421},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3844":968,"_33198":878,"_22654":57423,"_5":15607,"_29907":57187,"_3297":57424},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3844":969,"_33198":878,"_22654":57426,"_5":15607,"_29907":57187,"_3297":57427},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3844":970,"_33198":878,"_22654":57429,"_5":15607,"_29907":57187,"_3297":57430},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3844":971,"_33198":878,"_22654":57432,"_5":15607,"_29907":57191,"_3297":57433},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3844":972,"_33198":878,"_22654":57435,"_5":15607,"_29907":57195,"_3297":57436},[],"`settings.reenrollment_settings` field",{"_3844":973,"_33198":878,"_22654":57438,"_5":15607,"_29907":57195,"_3297":54792},[],{"_3844":974,"_33198":878,"_22654":57440,"_5":15607,"_29907":57195,"_3297":57441},[],"`reenrollment_delta`",{"_3844":975,"_33198":878,"_22654":57443,"_5":15607,"_29907":57195,"_3297":57444},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3844":976,"_33198":878,"_22654":57446,"_5":15607,"_29907":57195,"_3297":57447},[],"`preventive_delta`",{"_3844":977,"_33198":878,"_22654":57449,"_5":15607,"_29907":57195,"_3297":57450},[],"Preventive operational monitoring threshold.",{"_3844":978,"_33198":878,"_22654":57452,"_5":15607,"_29907":57195,"_3297":57453},[],"`critical_delta`",{"_3844":979,"_33198":878,"_22654":57455,"_5":15607,"_29907":57195,"_3297":57456},[],"Critical operational monitoring threshold.",{"_3844":980,"_33198":878,"_22654":57458,"_5":15607,"_29907":57195,"_3297":57459},[],"`enable_expired_renewal`",{"_3844":981,"_33198":878,"_22654":57461,"_5":15607,"_29907":57195,"_3297":57462},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3844":982,"_33198":878,"_22654":57464,"_5":15607,"_29907":57195,"_3297":57465},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3844":983,"_33198":878,"_22654":57467,"_5":15607,"_29907":57195,"_3297":57468},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3844":984,"_33198":878,"_22654":57470,"_5":15607,"_29907":57195,"_3297":57471},[],"`revoke_on_reenrollment`",{"_3844":985,"_33198":878,"_22654":57473,"_5":15607,"_29907":57195,"_3297":57474},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3844":986,"_33198":878,"_22654":57476,"_5":15607,"_29907":57195,"_3297":57477},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3844":987,"_33198":878,"_22654":57479,"_5":15607,"_29907":57199,"_3297":57480},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3844":988,"_33198":878,"_22654":57482,"_5":15607,"_29907":57203,"_3297":54786},[],{"_3844":989,"_33198":878,"_22654":57484,"_5":15607,"_29907":57203,"_3297":57485},[],"Published material",{"_3844":990,"_33198":878,"_22654":57487,"_5":15607,"_29907":57203,"_3297":57488},[],"**Include Lamassu System CA**",{"_3844":991,"_33198":878,"_22654":57490,"_5":15607,"_29907":57203,"_3297":57491},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3844":992,"_33198":878,"_22654":57493,"_5":15607,"_29907":57203,"_3297":57494},[],"**Include Enrollment CA**",{"_3844":993,"_33198":878,"_22654":57496,"_5":15607,"_29907":57203,"_3297":57497},[],"Selected issuing CA certificate.",{"_3844":994,"_33198":878,"_22654":57499,"_5":15607,"_29907":57203,"_3297":57500},[],"**Managed CAs**",{"_3844":995,"_33198":878,"_22654":57502,"_5":15607,"_29907":57203,"_3297":57503},[],"Explicitly selected CA certificates.",{"_3844":996,"_33198":878,"_22654":57505,"_5":15607,"_29907":57203,"_3297":57506},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3844":997,"_33198":878,"_22654":57508,"_5":15607,"_29907":57207,"_3297":57509},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3844":998,"_33198":878,"_22654":57511,"_5":15607,"_29907":57207,"_3297":57512},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3844":999,"_33198":878,"_22654":57514,"_5":15607,"_29907":57207,"_3297":57515},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3844":1000,"_33198":878,"_22654":57517,"_5":15607,"_29907":57211,"_3297":57518},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3844":1001,"_33198":1001,"_5":16006,"_3297":57520,"_33604":57521,"_22654":57522,"_29907":1001},"Integrate the EST client",[54402,55870,56881,56879,57062],[],{"_3844":1002,"_33198":1001,"_22654":57524,"_5":15607,"_29907":1001,"_3297":57525},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3844":1003,"_33198":1001,"_5":33601,"_22654":57527,"_29907":57528,"_3297":54412},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3844":1004,"_33198":1001,"_5":33601,"_22654":57530,"_29907":57531,"_3297":57532},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3844":1005,"_33198":1001,"_5":33601,"_22654":57534,"_29907":57535,"_3297":57536},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3844":1006,"_33198":1001,"_5":33601,"_22654":57538,"_29907":57539,"_3297":57540},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3844":1007,"_33198":1001,"_5":33601,"_22654":57542,"_29907":57543,"_3297":57544},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3844":1008,"_33198":1001,"_5":33601,"_22654":57546,"_29907":57547,"_3297":57548},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3844":1009,"_33198":1001,"_22654":57550,"_5":15607,"_29907":1001,"_3297":57551},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3844":1010,"_33198":1001,"_22654":57553,"_5":15607,"_29907":57528,"_3297":57554},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3844":1011,"_33198":1001,"_22654":57556,"_5":15607,"_29907":57528,"_3297":57557},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3844":1012,"_33198":1001,"_22654":57559,"_5":15607,"_29907":57528,"_3297":57560},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3844":1013,"_33198":1001,"_22654":57562,"_5":15607,"_29907":57531,"_3297":57563},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3844":1014,"_33198":1001,"_22654":57565,"_5":15607,"_29907":57531,"_3297":57566},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3844":1015,"_33198":1001,"_22654":57568,"_5":15607,"_29907":57535,"_3297":57569},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3844":1016,"_33198":1001,"_22654":57571,"_5":15607,"_29907":57535,"_3297":57572},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3844":1017,"_33198":1001,"_22654":57574,"_5":15607,"_29907":57539,"_3297":57575},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3844":1018,"_33198":1001,"_22654":57577,"_5":15607,"_29907":57539,"_3297":57578},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3844":1019,"_33198":1001,"_22654":57580,"_5":15607,"_29907":57543,"_3297":57581},[],"For a root that issues directly:",{"_3844":1020,"_33198":1001,"_22654":57583,"_5":15607,"_29907":57543,"_3297":57584},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3844":1021,"_33198":1001,"_22654":57586,"_5":15607,"_29907":57543,"_3297":57587},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3844":1022,"_33198":1001,"_22654":57589,"_5":15607,"_29907":57547,"_3297":57590},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3844":1023,"_33198":1023,"_5":16006,"_3297":57592,"_33604":57593,"_22654":57594,"_29907":1023},"EST reference",[54402,55870,56881,56879,57062],[],{"_3844":1024,"_33198":1023,"_22654":57596,"_5":15607,"_29907":1023,"_3297":57597},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3844":1025,"_33198":1023,"_5":33601,"_22654":57599,"_29907":57600,"_3297":57601},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3844":1026,"_33198":1023,"_5":33601,"_22654":57603,"_29907":57604,"_3297":24625},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3844":1027,"_33198":1023,"_5":33601,"_22654":57606,"_29907":57607,"_3297":28278},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3844":1028,"_33198":1023,"_5":33601,"_22654":57609,"_29907":57610,"_3297":28285},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3844":1029,"_33198":1023,"_5":33601,"_22654":57612,"_29907":57613,"_3297":27519},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3844":1030,"_33198":1023,"_5":33601,"_22654":57615,"_29907":57616,"_3297":57617},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3844":1031,"_33198":1023,"_5":33601,"_22654":57619,"_29907":57620,"_3297":57621},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3844":1032,"_33198":1023,"_5":33601,"_22654":57623,"_29907":57624,"_3297":57625},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3844":1033,"_33198":1023,"_22654":57627,"_5":15607,"_29907":1023,"_3297":57628},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3844":1034,"_33198":1023,"_22654":57630,"_5":15607,"_29907":57600,"_3297":57631},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3844":1035,"_33198":1023,"_22654":57633,"_5":15607,"_29907":57600,"_3297":57634},[],"Operation",{"_3844":1036,"_33198":1023,"_22654":57636,"_5":15607,"_29907":57600,"_3297":57637},[],"Method",{"_3844":1037,"_33198":1023,"_22654":57639,"_5":15607,"_29907":57600,"_3297":57640},[],"Authentication and condition",{"_3844":1038,"_33198":1023,"_22654":57642,"_5":15607,"_29907":57600,"_3297":57643},[],"`/cacerts`",{"_3844":1039,"_33198":1023,"_22654":57645,"_5":15607,"_29907":57600,"_3297":57646},[],"GET",{"_3844":1040,"_33198":1023,"_22654":57648,"_5":15607,"_29907":57600,"_3297":57649},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3844":1041,"_33198":1023,"_22654":57651,"_5":15607,"_29907":57600,"_3297":57652},[],"`/simpleenroll`",{"_3844":1042,"_33198":1023,"_22654":57654,"_5":15607,"_29907":57600,"_3297":57655},[],"POST",{"_3844":1043,"_33198":1023,"_22654":57657,"_5":15607,"_29907":57600,"_3297":57658},[],"Initial authentication and DMS registration/replacement policy.",{"_3844":1044,"_33198":1023,"_22654":57660,"_5":15607,"_29907":57600,"_3297":57661},[],"`/simplereenroll`",{"_3844":1045,"_33198":1023,"_22654":57663,"_5":15607,"_29907":57600,"_3297":57655},[],{"_3844":1046,"_33198":1023,"_22654":57665,"_5":15607,"_29907":57600,"_3297":57666},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3844":1047,"_33198":1023,"_22654":57668,"_5":15607,"_29907":57600,"_3297":57669},[],"`/serverkeygen`",{"_3844":1048,"_33198":1023,"_22654":57671,"_5":15607,"_29907":57600,"_3297":57655},[],{"_3844":1049,"_33198":1023,"_22654":57673,"_5":15607,"_29907":57600,"_3297":57674},[],"Initial authentication and admission; server generation enabled.",{"_3844":1050,"_33198":1023,"_22654":57676,"_5":15607,"_29907":57600,"_3297":57677},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3844":1051,"_33198":1023,"_22654":57679,"_5":15607,"_29907":57604,"_3297":57680},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3844":1052,"_33198":1023,"_22654":57682,"_5":15607,"_29907":57604,"_3297":57683},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3844":1053,"_33198":1023,"_22654":57685,"_5":15607,"_29907":57607,"_3297":57686},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3844":1054,"_33198":1023,"_22654":57688,"_5":15607,"_29907":57607,"_3297":57689},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3844":1055,"_33198":1023,"_22654":57691,"_5":15607,"_29907":57610,"_3297":57692},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3844":1056,"_33198":1023,"_22654":57694,"_5":15607,"_29907":57610,"_3297":57695},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3844":1057,"_33198":1023,"_22654":57697,"_5":15607,"_29907":57613,"_3297":57698},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3844":1058,"_33198":1023,"_22654":57700,"_5":15607,"_29907":57613,"_3297":57701},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3844":1059,"_33198":1023,"_22654":57703,"_5":15607,"_29907":57616,"_3297":57704},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3844":1060,"_33198":1023,"_22654":57706,"_5":15607,"_29907":57616,"_3297":57707},[],"Part",{"_3844":1061,"_33198":1023,"_22654":57709,"_5":15607,"_29907":57616,"_3297":57710},[],"Content after decoding its Base64",{"_3844":1062,"_33198":1023,"_22654":57712,"_5":15607,"_29907":57616,"_3297":57713},[],"`application/pkcs8`",{"_3844":1063,"_33198":1023,"_22654":57715,"_5":15607,"_29907":57616,"_3297":57716},[],"Unencrypted DER PKCS#8 private key.",{"_3844":1064,"_33198":1023,"_22654":57718,"_5":15607,"_29907":57616,"_3297":57719},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3844":1065,"_33198":1023,"_22654":57721,"_5":15607,"_29907":57616,"_3297":57722},[],"DER PKCS#7 containing the issued certificate.",{"_3844":1066,"_33198":1023,"_22654":57724,"_5":15607,"_29907":57616,"_3297":57725},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3844":1067,"_33198":1023,"_22654":57727,"_5":15607,"_29907":57620,"_3297":57728},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3844":1068,"_33198":1023,"_22654":57730,"_5":15607,"_29907":57620,"_3297":57731},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3844":1069,"_33198":1023,"_22654":57733,"_5":15607,"_29907":57620,"_3297":57734},[],"Convert and check the result:",{"_3844":1070,"_33198":1023,"_22654":57736,"_5":15607,"_29907":57620,"_3297":57737},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3844":1071,"_33198":1023,"_22654":57739,"_5":15607,"_29907":57624,"_3297":57740},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3844":1072,"_33198":1023,"_22654":57742,"_5":15607,"_29907":57624,"_3297":57743},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3844":1073,"_33198":1073,"_5":16006,"_3297":57062,"_33604":57745,"_22654":57746,"_29907":1073},[54402,55870,56881,56879,57062],[],{"_3844":1074,"_33198":1073,"_22654":57748,"_5":15607,"_29907":1073,"_3297":57749},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3844":1075,"_33198":1073,"_5":33601,"_22654":57751,"_29907":57752,"_3297":57753},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3844":1076,"_33198":1073,"_5":33601,"_22654":57755,"_29907":57756,"_3297":57757},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3844":1077,"_33198":1073,"_5":33601,"_22654":57759,"_29907":57760,"_3297":57761},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3844":1078,"_33198":1073,"_5":33601,"_22654":57763,"_29907":57764,"_3297":57765},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3844":1079,"_33198":1073,"_22654":57767,"_5":15607,"_29907":1073,"_3297":57768},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3844":1080,"_33198":1073,"_22654":57770,"_5":15607,"_29907":57752,"_3297":57771},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3844":1081,"_33198":1073,"_22654":57773,"_5":15607,"_29907":57752,"_3297":57774},[],"The integrator installs initial EST server trust and an admission credential.",{"_3844":1082,"_33198":1073,"_22654":57776,"_5":15607,"_29907":57752,"_3297":57777},[],"The client requests an identity for its `Device ID` through EST.",{"_3844":1083,"_33198":1073,"_22654":57779,"_5":15607,"_29907":57752,"_3297":57780},[],"Certificate, device binding and key/certificate installation are checked.",{"_3844":1084,"_33198":1073,"_22654":57782,"_5":15607,"_29907":57752,"_3297":57783},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3844":1085,"_33198":1073,"_22654":57785,"_5":15607,"_29907":57752,"_3297":57786},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3844":1086,"_33198":1073,"_22654":57788,"_5":15607,"_29907":57756,"_3297":57789},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3844":1087,"_33198":1073,"_22654":57791,"_5":15607,"_29907":57756,"_3297":57792},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3844":1088,"_33198":1073,"_22654":57794,"_5":15607,"_29907":57756,"_3297":57795},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3844":1089,"_33198":1073,"_22654":57797,"_5":15607,"_29907":57756,"_3297":57798},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3844":1090,"_33198":1073,"_22654":57800,"_5":15607,"_29907":57760,"_3297":57801},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3844":1091,"_33198":1073,"_22654":57803,"_5":15607,"_29907":57760,"_3297":57804},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3844":1092,"_33198":1073,"_22654":57806,"_5":15607,"_29907":57760,"_3297":57807},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3844":1093,"_33198":1073,"_22654":57809,"_5":15607,"_29907":57760,"_3297":57810},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3844":1094,"_33198":1073,"_22654":57812,"_5":15607,"_29907":57764,"_3297":57813},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3844":1095,"_33198":1073,"_22654":57815,"_5":15607,"_29907":57764,"_3297":57816},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3844":1096,"_33198":1096,"_5":16006,"_3297":57818,"_33604":57819,"_22654":57820,"_29907":1096},"Provisioning strategies",[54402,55870,56881,56879,57062],[],{"_3844":1097,"_33198":1096,"_22654":57822,"_5":15607,"_29907":1096,"_3297":57823},[],"Choose device registration, identity authorization and key generation.",{"_3844":1098,"_33198":1096,"_5":33601,"_22654":57825,"_29907":57826,"_3297":57827},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3844":1099,"_33198":1096,"_5":33601,"_22654":57829,"_29907":57830,"_3297":57831},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3844":1100,"_33198":1096,"_5":33601,"_22654":57833,"_29907":57834,"_3297":57835},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3844":1101,"_33198":1096,"_5":33601,"_22654":57837,"_29907":57838,"_3297":57839},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3844":1102,"_33198":1096,"_5":33601,"_22654":57841,"_29907":57842,"_3297":57843},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3844":1103,"_33198":1096,"_22654":57845,"_5":15607,"_29907":1096,"_3297":57846},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3844":1104,"_33198":1096,"_22654":57848,"_5":15607,"_29907":57826,"_3297":57849},[],"Path",{"_3844":1105,"_33198":1096,"_22654":57851,"_5":15607,"_29907":57826,"_3297":57852},[],"When the device exists",{"_3844":1106,"_33198":1096,"_22654":57854,"_5":15607,"_29907":57826,"_3297":57855},[],"What to check",{"_3844":1107,"_33198":1096,"_22654":57857,"_5":15607,"_29907":57826,"_3297":57858},[],"Manual assignment",{"_3844":1108,"_33198":1096,"_22654":57860,"_5":15607,"_29907":57826,"_3297":57861},[],"An operator creates it before associating a certificate.",{"_3844":1109,"_33198":1096,"_22654":57863,"_5":15607,"_29907":57826,"_3297":57864},[],"ID, owning DMS, certificate CN and bound serial.",{"_3844":1110,"_33198":1096,"_22654":57866,"_5":15607,"_29907":57826,"_3297":57867},[],"EST with `JITP`",{"_3844":1111,"_33198":1096,"_22654":57869,"_5":15607,"_29907":57826,"_3297":57870},[],"Created for an unknown CN during `/simpleenroll`.",{"_3844":1112,"_33198":1096,"_22654":57872,"_5":15607,"_29907":57826,"_3297":57873},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3844":1113,"_33198":1096,"_22654":57875,"_5":15607,"_29907":57826,"_3297":57876},[],"EST with `PRE_REGISTRATION`",{"_3844":1114,"_33198":1096,"_22654":57878,"_5":15607,"_29907":57826,"_3297":57879},[],"Must exist before `/simpleenroll`.",{"_3844":1115,"_33198":1096,"_22654":57881,"_5":15607,"_29907":57826,"_3297":57882},[],"Approved record, same DMS and replacement conditions for your version.",{"_3844":1116,"_33198":1096,"_22654":57884,"_5":15607,"_29907":57826,"_3297":57885},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3844":1117,"_33198":1096,"_22654":57887,"_5":15607,"_29907":57826,"_3297":57888},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3844":1118,"_33198":1096,"_22654":57890,"_5":15607,"_29907":57830,"_3297":57891},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3844":1119,"_33198":1096,"_22654":57893,"_5":15607,"_29907":57830,"_3297":57894},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3844":1120,"_33198":1096,"_22654":57896,"_5":15607,"_29907":57830,"_3297":57897},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3844":1121,"_33198":1096,"_22654":57899,"_5":15607,"_29907":57834,"_3297":57900},[],"Decide initial enrollment and re-enrollment separately:",{"_3844":1122,"_33198":1096,"_22654":57902,"_5":15607,"_29907":57834,"_3297":57903},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3844":1123,"_33198":1096,"_22654":57905,"_5":15607,"_29907":57834,"_3297":57906},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3844":1124,"_33198":1096,"_22654":57908,"_5":15607,"_29907":57834,"_3297":57909},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3844":1125,"_33198":1096,"_22654":57911,"_5":15607,"_29907":57834,"_3297":57912},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3844":1126,"_33198":1096,"_22654":57914,"_5":15607,"_29907":57834,"_3297":57915},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3844":1127,"_33198":1096,"_22654":57917,"_5":15607,"_29907":57838,"_3297":54786},[],{"_3844":1128,"_33198":1096,"_22654":57919,"_5":15607,"_29907":57838,"_3297":57920},[],"Material crossing EST",{"_3844":1129,"_33198":1096,"_22654":57922,"_5":15607,"_29907":57838,"_3297":57923},[],"Device-generated key",{"_3844":1130,"_33198":1096,"_22654":57925,"_5":15607,"_29907":57838,"_3297":57926},[],"Public CSR and certificate; the key stays on the client.",{"_3844":1131,"_33198":1096,"_22654":57928,"_5":15607,"_29907":57838,"_3297":57929},[],"Existing device key",{"_3844":1132,"_33198":1096,"_22654":57931,"_5":15607,"_29907":57838,"_3297":57932},[],"CSR signed with that key and a new certificate.",{"_3844":1133,"_33198":1096,"_22654":57934,"_5":15607,"_29907":57838,"_3297":57200},[],{"_3844":1134,"_33198":1096,"_22654":57936,"_5":15607,"_29907":57838,"_3297":57937},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3844":1135,"_33198":1096,"_22654":57939,"_5":15607,"_29907":57838,"_3297":57940},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3844":1136,"_33198":1096,"_22654":57942,"_5":15607,"_29907":57842,"_3297":57943},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3844":1137,"_33198":1137,"_5":16006,"_3297":57945,"_33604":57946,"_22654":57947,"_29907":1137},"Renewal and recovery",[54402,55870,56881,56879,57062],[],{"_3844":1138,"_33198":1137,"_22654":57949,"_5":15607,"_29907":1137,"_3297":57950},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3844":1139,"_33198":1137,"_5":33601,"_22654":57952,"_29907":57953,"_3297":57954},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3844":1140,"_33198":1137,"_5":33601,"_22654":57956,"_29907":57957,"_3297":57958},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3844":1141,"_33198":1137,"_5":33601,"_22654":57960,"_29907":57961,"_3297":57962},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3844":1142,"_33198":1137,"_5":33601,"_22654":57964,"_29907":57965,"_3297":57966},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3844":1143,"_33198":1137,"_5":33601,"_22654":57968,"_29907":57969,"_3297":57970},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3844":1144,"_33198":1137,"_22654":57972,"_5":15607,"_29907":1137,"_3297":57973},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3844":1145,"_33198":1137,"_22654":57975,"_5":15607,"_29907":57953,"_3297":57976},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3844":1146,"_33198":1137,"_22654":57978,"_5":15607,"_29907":57953,"_3297":57979},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3844":1147,"_33198":1137,"_22654":57981,"_5":15607,"_29907":57953,"_3297":57982},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3844":1148,"_33198":1137,"_22654":57984,"_5":15607,"_29907":57953,"_3297":57985},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3844":1149,"_33198":1137,"_22654":57987,"_5":15607,"_29907":57957,"_3297":57988},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3844":1150,"_33198":1137,"_22654":57990,"_5":15607,"_29907":57957,"_3297":57991},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3844":1151,"_33198":1137,"_22654":57993,"_5":15607,"_29907":57961,"_3297":57994},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3844":1152,"_33198":1137,"_22654":57996,"_5":15607,"_29907":57961,"_3297":57997},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3844":1153,"_33198":1137,"_22654":57999,"_5":15607,"_29907":57961,"_3297":58000},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3844":1154,"_33198":1137,"_22654":58002,"_5":15607,"_29907":57965,"_3297":58003},[],"Situation",{"_3844":1155,"_33198":1137,"_22654":58005,"_5":15607,"_29907":57965,"_3297":58006},[],"Procedure",{"_3844":1156,"_33198":1137,"_22654":58008,"_5":15607,"_29907":57965,"_3297":58009},[],"Valid certificate, outside the window",{"_3844":1157,"_33198":1137,"_22654":58011,"_5":15607,"_29907":57965,"_3297":58012},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3844":1158,"_33198":1137,"_22654":58014,"_5":15607,"_29907":57965,"_3297":58015},[],"Expired certificate, key available",{"_3844":1159,"_33198":1137,"_22654":58017,"_5":15607,"_29907":57965,"_3297":58018},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3844":1160,"_33198":1137,"_22654":58020,"_5":15607,"_29907":57965,"_3297":58021},[],"Renewal through webhook or `NO_AUTH`",{"_3844":1161,"_33198":1137,"_22654":58023,"_5":15607,"_29907":57965,"_3297":58024},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3844":1162,"_33198":1137,"_22654":58026,"_5":15607,"_29907":57965,"_3297":58027},[],"Lost or inaccessible key",{"_3844":1163,"_33198":1137,"_22654":58029,"_5":15607,"_29907":57965,"_3297":58030},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3844":1164,"_33198":1137,"_22654":58032,"_5":15607,"_29907":57965,"_3297":58033},[],"Current identity revoked",{"_3844":1165,"_33198":1137,"_22654":58035,"_5":15607,"_29907":57965,"_3297":58036},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3844":1166,"_33198":1137,"_22654":58038,"_5":15607,"_29907":57965,"_3297":58039},[],"Device without an identity",{"_3844":1167,"_33198":1137,"_22654":58041,"_5":15607,"_29907":57965,"_3297":58042},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3844":1168,"_33198":1137,"_22654":58044,"_5":15607,"_29907":57965,"_3297":58045},[],"Retired device",{"_3844":1169,"_33198":1137,"_22654":58047,"_5":15607,"_29907":57965,"_3297":58048},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3844":1170,"_33198":1137,"_22654":58050,"_5":15607,"_29907":57965,"_3297":58051},[],"Timeout, HTTP 500 or installation failure",{"_3844":1171,"_33198":1137,"_22654":58053,"_5":15607,"_29907":57965,"_3297":58054},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3844":1172,"_33198":1137,"_22654":58056,"_5":15607,"_29907":57969,"_3297":58057},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3844":1173,"_33198":1137,"_22654":58059,"_5":15607,"_29907":57969,"_3297":58060},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3844":1174,"_33198":1174,"_5":16006,"_3297":58062,"_33604":58063,"_22654":58064,"_29907":1174},"Enrollment troubleshooting",[54402,55870,56881,56879,57062],[],{"_3844":1175,"_33198":1174,"_22654":58066,"_5":15607,"_29907":1174,"_3297":58067},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3844":1176,"_33198":1174,"_5":33601,"_22654":58069,"_29907":58070,"_3297":58071},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3844":1177,"_33198":1174,"_5":33601,"_22654":58073,"_29907":58074,"_3297":58075},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3844":1178,"_33198":1174,"_5":33601,"_22654":58077,"_29907":58078,"_3297":57625},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3844":1179,"_33198":1174,"_5":33601,"_22654":58080,"_29907":58081,"_3297":58082},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3844":1180,"_33198":1174,"_22654":58084,"_5":15607,"_29907":1174,"_3297":58085},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3844":1181,"_33198":1174,"_22654":58087,"_5":15607,"_29907":58074,"_3297":58088},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3844":1182,"_33198":1174,"_22654":58090,"_5":15607,"_29907":58074,"_3297":58091},[],"Symptom or message",{"_3844":1183,"_33198":1174,"_22654":58093,"_5":15607,"_29907":58074,"_3297":57855},[],{"_3844":1184,"_33198":1174,"_22654":58095,"_5":15607,"_29907":58074,"_3297":58096},[],"curl rejects TLS, name or issuer",{"_3844":1185,"_33198":1174,"_22654":58098,"_5":15607,"_29907":58074,"_3297":58099},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3844":1186,"_33198":1174,"_22654":58101,"_5":15607,"_29907":58074,"_3297":58102},[],"404 or missing APS",{"_3844":1187,"_33198":1174,"_22654":58104,"_5":15607,"_29907":58074,"_3297":58105},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3844":1188,"_33198":1174,"_22654":58107,"_5":15607,"_29907":58074,"_3297":58108},[],"400, CSR or format error",{"_3844":1189,"_33198":1174,"_22654":58110,"_5":15607,"_29907":58074,"_3297":58111},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3844":1190,"_33198":1174,"_22654":58113,"_5":15607,"_29907":58074,"_3297":58114},[],"Missing credential or invalid certificate",{"_3844":1191,"_33198":1174,"_22654":58116,"_5":15607,"_29907":58074,"_3297":58117},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3844":1192,"_33198":1174,"_22654":58119,"_5":15607,"_29907":58074,"_3297":58120},[],"Webhook denies, times out or responds without authorization",{"_3844":1193,"_33198":1174,"_22654":58122,"_5":15607,"_29907":58074,"_3297":58123},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3844":1194,"_33198":1174,"_22654":58125,"_5":15607,"_29907":58074,"_3297":58126},[],"`unexpected status code: <n>: redirects are not followed`",{"_3844":1195,"_33198":1174,"_22654":58128,"_5":15607,"_29907":58074,"_3297":58129},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3844":1196,"_33198":1174,"_22654":58131,"_5":15607,"_29907":58074,"_3297":58132},[],"`webhook response exceeds 1048576 bytes`",{"_3844":1197,"_33198":1174,"_22654":58134,"_5":15607,"_29907":58074,"_3297":58135},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3844":1198,"_33198":1174,"_22654":58137,"_5":15607,"_29907":58074,"_3297":58138},[],"`webhook config must not reference files`",{"_3844":1199,"_33198":1174,"_22654":58140,"_5":15607,"_29907":58074,"_3297":58141},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3844":1200,"_33198":1174,"_22654":58143,"_5":15607,"_29907":58074,"_3297":58144},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3844":1201,"_33198":1174,"_22654":58146,"_5":15607,"_29907":58074,"_3297":58147},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3844":1202,"_33198":1174,"_22654":58149,"_5":15607,"_29907":58074,"_3297":58150},[],"`webhook mTLS certificate and key are invalid: …`",{"_3844":1203,"_33198":1174,"_22654":58152,"_5":15607,"_29907":58074,"_3297":58153},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3844":1204,"_33198":1174,"_22654":58155,"_5":15607,"_29907":58074,"_3297":58156},[],"400 `struct validation error` creating or updating a DMS",{"_3844":1205,"_33198":1174,"_22654":58158,"_5":15607,"_29907":58074,"_3297":58159},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3844":1206,"_33198":1174,"_22654":58161,"_5":15607,"_29907":58074,"_3297":58162},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3844":1207,"_33198":1174,"_22654":58164,"_5":15607,"_29907":58074,"_3297":58165},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3844":1208,"_33198":1174,"_22654":58167,"_5":15607,"_29907":58074,"_3297":58168},[],"`device not preregistered`",{"_3844":1209,"_33198":1174,"_22654":58170,"_5":15607,"_29907":58074,"_3297":58171},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3844":1210,"_33198":1174,"_22654":58173,"_5":15607,"_29907":58074,"_3297":58174},[],"`forbiddenNewEnrollment`",{"_3844":1211,"_33198":1174,"_22654":58176,"_5":15607,"_29907":58074,"_3297":58177},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3844":1212,"_33198":1174,"_22654":58179,"_5":15607,"_29907":58074,"_3297":58180},[],"Different owning DMS",{"_3844":1213,"_33198":1174,"_22654":58182,"_5":15607,"_29907":58074,"_3297":58183},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3844":1214,"_33198":1174,"_22654":58185,"_5":15607,"_29907":58074,"_3297":58186},[],"`invalid RawSubject bytes`",{"_3844":1215,"_33198":1174,"_22654":58188,"_5":15607,"_29907":58074,"_3297":58189},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3844":1216,"_33198":1174,"_22654":58191,"_5":15607,"_29907":58074,"_3297":58192},[],"`invalid reenroll window`",{"_3844":1217,"_33198":1174,"_22654":58194,"_5":15607,"_29907":58074,"_3297":58195},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3844":1218,"_33198":1174,"_22654":58197,"_5":15607,"_29907":58074,"_3297":58198},[],"Current certificate revoked",{"_3844":1219,"_33198":1174,"_22654":58200,"_5":15607,"_29907":58074,"_3297":58201},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3844":1220,"_33198":1174,"_22654":58203,"_5":15607,"_29907":58074,"_3297":58204},[],"CA, profile or signing error",{"_3844":1221,"_33198":1174,"_22654":58206,"_5":15607,"_29907":58074,"_3297":58207},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3844":1222,"_33198":1174,"_22654":58209,"_5":15607,"_29907":58074,"_3297":58210},[],"HTTP 200 without a device connection",{"_3844":1223,"_33198":1174,"_22654":58212,"_5":15607,"_29907":58074,"_3297":58213},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3844":1224,"_33198":1174,"_22654":58215,"_5":15607,"_29907":58074,"_3297":58216},[],"Timeout or error after issuance",{"_3844":1225,"_33198":1174,"_22654":58218,"_5":15607,"_29907":58074,"_3297":58219},[],"New certificates, current slot and previous identity's state before retrying.",{"_3844":1226,"_33198":1174,"_22654":58221,"_5":15607,"_29907":58078,"_3297":58222},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3844":1227,"_33198":1174,"_22654":58224,"_5":15607,"_29907":58078,"_3297":58225},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3844":1228,"_33198":1174,"_22654":58227,"_5":15607,"_29907":58081,"_3297":58228},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3844":1229,"_33198":1174,"_22654":58230,"_5":15607,"_29907":58081,"_3297":58231},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3844":1230,"_33198":1174,"_22654":58233,"_5":15607,"_29907":58081,"_3297":58234},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3844":1231,"_33198":1174,"_22654":58236,"_5":15607,"_29907":58081,"_3297":58237},[],"Make one request, save headers/body and query the device and certificates.",{"_3844":1232,"_33198":1174,"_22654":58239,"_5":15607,"_29907":58081,"_3297":58240},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3844":1233,"_33198":1174,"_22654":58242,"_5":15607,"_29907":58081,"_3297":58243},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3844":1234,"_33198":1174,"_22654":58245,"_5":15607,"_29907":58081,"_3297":58246},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3844":1235,"_33198":1235,"_5":16006,"_3297":58248,"_33604":58249,"_22654":58250,"_29907":1235},"Trust distribution and updates",[54402,55870,56881,56879,57062],[],{"_3844":1236,"_33198":1235,"_22654":58252,"_5":15607,"_29907":1235,"_3297":58253},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3844":1237,"_33198":1235,"_5":33601,"_22654":58255,"_29907":58256,"_3297":58257},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3844":1238,"_33198":1235,"_5":33601,"_22654":58259,"_29907":58260,"_3297":58261},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3844":1239,"_33198":1235,"_5":33601,"_22654":58263,"_29907":58264,"_3297":58265},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3844":1240,"_33198":1235,"_5":33601,"_22654":58267,"_29907":58268,"_3297":58269},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3844":1241,"_33198":1235,"_5":33601,"_22654":58271,"_29907":58272,"_3297":58273},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3844":1242,"_33198":1235,"_22654":58275,"_5":15607,"_29907":1235,"_3297":58276},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3844":1243,"_33198":1235,"_22654":58278,"_5":15607,"_29907":58256,"_3297":58279},[],"Relationship",{"_3844":1244,"_33198":1235,"_22654":58281,"_5":15607,"_29907":58256,"_3297":58282},[],"Material prepared by its owner",{"_3844":1245,"_33198":1235,"_22654":58284,"_5":15607,"_29907":58256,"_3297":58285},[],"Device → EST server",{"_3844":1246,"_33198":1235,"_22654":58287,"_5":15607,"_29907":58256,"_3297":58288},[],"Previously verified server root, chain or pin and TLS name.",{"_3844":1247,"_33198":1235,"_22654":58290,"_5":15607,"_29907":58256,"_3297":58291},[],"DMS → requester",{"_3844":1248,"_33198":1235,"_22654":58293,"_5":15607,"_29907":58256,"_3297":58294},[],"CAs and rules authorizing initial or renewal credentials.",{"_3844":1249,"_33198":1235,"_22654":58296,"_5":15607,"_29907":58256,"_3297":58297},[],"Consumer → device",{"_3844":1250,"_33198":1235,"_22654":58299,"_5":15607,"_29907":58256,"_3297":58300},[],"Operational identity roots, intermediates, validation and permissions.",{"_3844":1251,"_33198":1235,"_22654":58302,"_5":15607,"_29907":58256,"_3297":58303},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3844":1252,"_33198":1235,"_22654":58305,"_5":15607,"_29907":58260,"_3297":58306},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3844":1253,"_33198":1235,"_22654":58308,"_5":15607,"_29907":58260,"_3297":58309},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3844":1254,"_33198":1235,"_22654":58311,"_5":15607,"_29907":58264,"_3297":58312},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3844":1255,"_33198":1235,"_22654":58314,"_5":15607,"_29907":58264,"_3297":58315},[],"Select policy-approved roots as anchors.",{"_3844":1256,"_33198":1235,"_22654":58317,"_5":15607,"_29907":58264,"_3297":58318},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3844":1257,"_33198":1235,"_22654":58320,"_5":15607,"_29907":58264,"_3297":58321},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3844":1258,"_33198":1235,"_22654":58323,"_5":15607,"_29907":58264,"_3297":58324},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3844":1259,"_33198":1235,"_22654":58326,"_5":15607,"_29907":58264,"_3297":58327},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3844":1260,"_33198":1235,"_22654":58329,"_5":15607,"_29907":58268,"_3297":58330},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3844":1261,"_33198":1235,"_22654":58332,"_5":15607,"_29907":58268,"_3297":58333},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3844":1262,"_33198":1235,"_22654":58335,"_5":15607,"_29907":58268,"_3297":58336},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3844":1263,"_33198":1235,"_22654":58338,"_5":15607,"_29907":58272,"_3297":58339},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3844":1264,"_33198":1264,"_5":16006,"_3297":58341,"_33604":58342,"_22654":58344,"_29907":1264},"AWS IoT Core",[54402,55870,56881,56879,58343],"Integrations",[],{"_3844":1265,"_33198":1264,"_22654":58346,"_5":15607,"_29907":1264,"_3297":58347},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3844":1266,"_33198":1264,"_5":33601,"_22654":58349,"_29907":58350,"_3297":58351},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3844":1267,"_33198":1264,"_5":33601,"_22654":58353,"_29907":58354,"_3297":58355},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3844":1268,"_33198":1264,"_5":33601,"_22654":58357,"_29907":58358,"_3297":58359},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3844":1269,"_33198":1264,"_5":33601,"_22654":58361,"_29907":58362,"_3297":58363},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3844":1270,"_33198":1264,"_5":33601,"_22654":58365,"_29907":58366,"_3297":58367},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3844":1271,"_33198":1264,"_5":33601,"_22654":58369,"_29907":58370,"_3297":58371},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3844":1272,"_33198":1264,"_5":33601,"_22654":58373,"_29907":58374,"_3297":58375},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3844":1273,"_33198":1264,"_5":33601,"_22654":58377,"_29907":58378,"_3297":58379},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3844":1274,"_33198":1264,"_5":33601,"_22654":58381,"_29907":58382,"_3297":58383},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3844":1275,"_33198":1264,"_5":33601,"_22654":58385,"_29907":58386,"_3297":58387},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3844":1276,"_33198":1264,"_5":33601,"_22654":58389,"_29907":58390,"_3297":58391},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3844":1277,"_33198":1264,"_5":33601,"_22654":58393,"_29907":58394,"_3297":58395},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3844":1278,"_33198":1264,"_5":33601,"_22654":58397,"_29907":58398,"_3297":58399},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3844":1279,"_33198":1264,"_5":33601,"_22654":58401,"_29907":58402,"_3297":58403},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3844":1280,"_33198":1264,"_5":33601,"_22654":58405,"_29907":58406,"_3297":58407},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3844":1281,"_33198":1264,"_5":33601,"_22654":58409,"_29907":58410,"_3297":58411},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3844":1282,"_33198":1264,"_5":33601,"_22654":58413,"_29907":58414,"_3297":58415},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3844":1283,"_33198":1264,"_5":33601,"_22654":58417,"_29907":58418,"_3297":58419},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3844":1284,"_33198":1264,"_5":33601,"_22654":58421,"_29907":58422,"_3297":58423},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3844":1285,"_33198":1264,"_5":33601,"_22654":58425,"_29907":58426,"_3297":58427},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3844":1286,"_33198":1264,"_5":33601,"_22654":58429,"_29907":58430,"_3297":58431},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3844":1287,"_33198":1264,"_5":33601,"_22654":58433,"_29907":58434,"_3297":58435},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3844":1288,"_33198":1264,"_5":33601,"_22654":58437,"_29907":58438,"_3297":58439},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3844":1289,"_33198":1264,"_5":33601,"_22654":58441,"_29907":58442,"_3297":58443},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3844":1290,"_33198":1264,"_5":33601,"_22654":58445,"_29907":58446,"_3297":58447},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3844":1291,"_33198":1264,"_22654":58449,"_5":15607,"_29907":1264,"_3297":58450},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3844":1292,"_33198":1264,"_22654":58452,"_5":15607,"_29907":1264,"_3297":58453},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3844":1293,"_33198":1264,"_22654":58455,"_5":15607,"_29907":1264,"_3297":58456},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3844":1294,"_33198":1264,"_22654":58458,"_5":15607,"_29907":58350,"_3297":58459},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3844":1295,"_33198":1264,"_22654":58461,"_5":15607,"_29907":58350,"_3297":58462},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3844":1296,"_33198":1264,"_22654":58464,"_5":15607,"_29907":58350,"_3297":58465},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3844":1297,"_33198":1264,"_22654":58467,"_5":15607,"_29907":58350,"_3297":58468},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3844":1298,"_33198":1264,"_22654":58470,"_5":15607,"_29907":58354,"_3297":58471},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3844":1299,"_33198":1264,"_22654":58473,"_5":15607,"_29907":58358,"_3297":58474},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3844":1300,"_33198":1264,"_22654":58476,"_5":15607,"_29907":58358,"_3297":58477},[],"IAM action",{"_3844":1301,"_33198":1264,"_22654":58479,"_5":15607,"_29907":58358,"_3297":54792},[],{"_3844":1302,"_33198":1264,"_22654":58481,"_5":15607,"_29907":58358,"_3297":58482},[],"`iot:GetRegistrationCode`",{"_3844":1303,"_33198":1264,"_22654":58484,"_5":15607,"_29907":58358,"_3297":58485},[],"Obtain the verification code for CA registration in the Primary Account",{"_3844":1304,"_33198":1264,"_22654":58487,"_5":15607,"_29907":58358,"_3297":58488},[],"`iot:RegisterCACertificate`",{"_3844":1305,"_33198":1264,"_22654":58490,"_5":15607,"_29907":58358,"_3297":58491},[],"Register the CA in AWS IoT",{"_3844":1306,"_33198":1264,"_22654":58493,"_5":15607,"_29907":58358,"_3297":58494},[],"`iot:DescribeCACertificate`",{"_3844":1307,"_33198":1264,"_22654":58496,"_5":15607,"_29907":58358,"_3297":58497},[],"Check the CA registration status",{"_3844":1308,"_33198":1264,"_22654":58499,"_5":15607,"_29907":58358,"_3297":58500},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3844":1309,"_33198":1264,"_22654":58502,"_5":15607,"_29907":58358,"_3297":58503},[],"Create or update Things in IoT Core",{"_3844":1310,"_33198":1264,"_22654":58505,"_5":15607,"_29907":58358,"_3297":58506},[],"`iot:RegisterThing`",{"_3844":1311,"_33198":1264,"_22654":58508,"_5":15607,"_29907":58358,"_3297":58509},[],"Provision Things through a template",{"_3844":1312,"_33198":1264,"_22654":58511,"_5":15607,"_29907":58358,"_3297":58512},[],"`iot:RegisterCertificate`",{"_3844":1313,"_33198":1264,"_22654":58514,"_5":15607,"_29907":58358,"_3297":58515},[],"Register device certificates",{"_3844":1314,"_33198":1264,"_22654":58517,"_5":15607,"_29907":58358,"_3297":58518},[],"`iot:UpdateCertificate`",{"_3844":1315,"_33198":1264,"_22654":58520,"_5":15607,"_29907":58358,"_3297":58521},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3844":1316,"_33198":1264,"_22654":58523,"_5":15607,"_29907":58358,"_3297":58524},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3844":1317,"_33198":1264,"_22654":58526,"_5":15607,"_29907":58358,"_3297":58527},[],"Create and attach IoT policies",{"_3844":1318,"_33198":1264,"_22654":58529,"_5":15607,"_29907":58358,"_3297":58530},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3844":1319,"_33198":1264,"_22654":58532,"_5":15607,"_29907":58358,"_3297":58533},[],"Manage Thing groups",{"_3844":1320,"_33198":1264,"_22654":58535,"_5":15607,"_29907":58358,"_3297":58536},[],"`iot:CreateProvisioningTemplate`",{"_3844":1321,"_33198":1264,"_22654":58538,"_5":15607,"_29907":58358,"_3297":58539},[],"Create JITP templates",{"_3844":1322,"_33198":1264,"_22654":58541,"_5":15607,"_29907":58358,"_3297":58542},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3844":1323,"_33198":1264,"_22654":58544,"_5":15607,"_29907":58358,"_3297":58545},[],"Read and write the Device Shadow",{"_3844":1324,"_33198":1264,"_22654":58547,"_5":15607,"_29907":58358,"_3297":58548},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3844":1325,"_33198":1264,"_22654":58550,"_5":15607,"_29907":58362,"_3297":58551},[],"Parameter",{"_3844":1326,"_33198":1264,"_22654":58553,"_5":15607,"_29907":58362,"_3297":58554},[],"Type",{"_3844":1327,"_33198":1264,"_22654":58556,"_5":15607,"_29907":58362,"_3297":58557},[],"Required",{"_3844":1328,"_33198":1264,"_22654":58559,"_5":15607,"_29907":58362,"_3297":58560},[],"Description",{"_3844":1329,"_33198":1264,"_22654":58562,"_5":15607,"_29907":58362,"_3297":58563},[],"`connector_id`",{"_3844":1330,"_33198":1264,"_22654":58565,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1331,"_33198":1264,"_22654":58567,"_5":15607,"_29907":58362,"_3297":58568},[],"Yes",{"_3844":1332,"_33198":1264,"_22654":58570,"_5":15607,"_29907":58362,"_3297":58571},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3844":1333,"_33198":1264,"_22654":58573,"_5":15607,"_29907":58362,"_3297":58574},[],"`aws_config.region`",{"_3844":1334,"_33198":1264,"_22654":58576,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1335,"_33198":1264,"_22654":58578,"_5":15607,"_29907":58362,"_3297":58568},[],{"_3844":1336,"_33198":1264,"_22654":58580,"_5":15607,"_29907":58362,"_3297":58581},[],"AWS region where the connector operates.",{"_3844":1337,"_33198":1264,"_22654":58583,"_5":15607,"_29907":58362,"_3297":58584},[],"`aws_config.auth_method`",{"_3844":1338,"_33198":1264,"_22654":58586,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1339,"_33198":1264,"_22654":58588,"_5":15607,"_29907":58362,"_3297":58568},[],{"_3844":1340,"_33198":1264,"_22654":58590,"_5":15607,"_29907":58362,"_3297":58591},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3844":1341,"_33198":1264,"_22654":58593,"_5":15607,"_29907":58362,"_3297":58594},[],"`aws_config.access_key_id`",{"_3844":1342,"_33198":1264,"_22654":58596,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1343,"_33198":1264,"_22654":58598,"_5":15607,"_29907":58362,"_3297":58599},[],"Only with `auth_method=static`",{"_3844":1344,"_33198":1264,"_22654":58601,"_5":15607,"_29907":58362,"_3297":58602},[],"AWS access key.",{"_3844":1345,"_33198":1264,"_22654":58604,"_5":15607,"_29907":58362,"_3297":58605},[],"`aws_config.secret_access_key`",{"_3844":1346,"_33198":1264,"_22654":58607,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1347,"_33198":1264,"_22654":58609,"_5":15607,"_29907":58362,"_3297":58599},[],{"_3844":1348,"_33198":1264,"_22654":58611,"_5":15607,"_29907":58362,"_3297":58612},[],"AWS secret key.",{"_3844":1349,"_33198":1264,"_22654":58614,"_5":15607,"_29907":58362,"_3297":58615},[],"`aws_config.session_token`",{"_3844":1350,"_33198":1264,"_22654":58617,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1351,"_33198":1264,"_22654":58619,"_5":15607,"_29907":58362,"_3297":58620},[],"No",{"_3844":1352,"_33198":1264,"_22654":58622,"_5":15607,"_29907":58362,"_3297":58623},[],"Session token (with `auth_method=static`).",{"_3844":1353,"_33198":1264,"_22654":58625,"_5":15607,"_29907":58362,"_3297":58626},[],"`aws_config.role_arn`",{"_3844":1354,"_33198":1264,"_22654":58628,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1355,"_33198":1264,"_22654":58630,"_5":15607,"_29907":58362,"_3297":58631},[],"Only with `auth_method=role`",{"_3844":1356,"_33198":1264,"_22654":58633,"_5":15607,"_29907":58362,"_3297":58634},[],"ARN of the role to assume.",{"_3844":1357,"_33198":1264,"_22654":58636,"_5":15607,"_29907":58362,"_3297":58637},[],"`aws_config.endpoint_url`",{"_3844":1358,"_33198":1264,"_22654":58639,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1359,"_33198":1264,"_22654":58641,"_5":15607,"_29907":58362,"_3297":58620},[],{"_3844":1360,"_33198":1264,"_22654":58643,"_5":15607,"_29907":58362,"_3297":58644},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3844":1361,"_33198":1264,"_22654":58646,"_5":15607,"_29907":58362,"_3297":58647},[],"`subscriber_event_bus`",{"_3844":1362,"_33198":1264,"_22654":58649,"_5":15607,"_29907":58362,"_3297":19075},[],{"_3844":1363,"_33198":1264,"_22654":58651,"_5":15607,"_29907":58362,"_3297":58568},[],{"_3844":1364,"_33198":1264,"_22654":58653,"_5":15607,"_29907":58362,"_3297":58654},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3844":1365,"_33198":1264,"_22654":58656,"_5":15607,"_29907":58362,"_3297":58657},[],"`dms_manager_client`",{"_3844":1366,"_33198":1264,"_22654":58659,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1367,"_33198":1264,"_22654":58661,"_5":15607,"_29907":58362,"_3297":58568},[],{"_3844":1368,"_33198":1264,"_22654":58663,"_5":15607,"_29907":58362,"_3297":58664},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3844":1369,"_33198":1264,"_22654":58666,"_5":15607,"_29907":58362,"_3297":58667},[],"`device_manager_client`",{"_3844":1370,"_33198":1264,"_22654":58669,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1371,"_33198":1264,"_22654":58671,"_5":15607,"_29907":58362,"_3297":58568},[],{"_3844":1372,"_33198":1264,"_22654":58673,"_5":15607,"_29907":58362,"_3297":58674},[],"HTTP URL of Lamassu's Device Manager.",{"_3844":1373,"_33198":1264,"_22654":58676,"_5":15607,"_29907":58362,"_3297":58677},[],"`ca_client`",{"_3844":1374,"_33198":1264,"_22654":58679,"_5":15607,"_29907":58362,"_3297":27123},[],{"_3844":1375,"_33198":1264,"_22654":58681,"_5":15607,"_29907":58362,"_3297":58568},[],{"_3844":1376,"_33198":1264,"_22654":58683,"_5":15607,"_29907":58362,"_3297":58684},[],"HTTP URL of Lamassu's CA service.",{"_3844":1377,"_33198":1264,"_22654":58686,"_5":15607,"_29907":58366,"_3297":58687},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3844":1378,"_33198":1264,"_22654":58689,"_5":15607,"_29907":58366,"_3297":58690},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3844":1379,"_33198":1264,"_22654":58692,"_5":15607,"_29907":58366,"_3297":58693},[],"CloudEvent type",{"_3844":1380,"_33198":1264,"_22654":58695,"_5":15607,"_29907":58366,"_3297":58696},[],"Lamassu resource",{"_3844":1381,"_33198":1264,"_22654":58698,"_5":15607,"_29907":58366,"_3297":58699},[],"AWS Resource",{"_3844":1382,"_33198":1264,"_22654":58701,"_5":15607,"_29907":58366,"_3297":58702},[],"IAM actions",{"_3844":1383,"_33198":1264,"_22654":58704,"_5":15607,"_29907":58366,"_3297":58705},[],"AWS calls and effect",{"_3844":1384,"_33198":1264,"_22654":58707,"_5":15607,"_29907":58366,"_3297":58708},[],"Where in this page",{"_3844":1385,"_33198":1264,"_22654":58710,"_5":15607,"_29907":58366,"_3297":58711},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3844":1386,"_33198":1264,"_22654":58713,"_5":15607,"_29907":58366,"_3297":58714},[],"CA",{"_3844":1387,"_33198":1264,"_22654":58716,"_5":15607,"_29907":58366,"_3297":58717},[],"`IoTCore/CACertificate`",{"_3844":1388,"_33198":1264,"_22654":58719,"_5":15607,"_29907":58366,"_3297":58720},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3844":1389,"_33198":1264,"_22654":58722,"_5":15607,"_29907":58366,"_3297":58723},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3844":1390,"_33198":1264,"_22654":58725,"_5":15607,"_29907":58366,"_3297":58379},[],{"_3844":1391,"_33198":1264,"_22654":58727,"_5":15607,"_29907":58366,"_3297":58728},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3844":1392,"_33198":1264,"_22654":58730,"_5":15607,"_29907":58366,"_3297":58731},[],"DMS",{"_3844":1393,"_33198":1264,"_22654":58733,"_5":15607,"_29907":58366,"_3297":58734},[],"`IoTCore/ProvisioningTemplate`",{"_3844":1394,"_33198":1264,"_22654":58736,"_5":15607,"_29907":58366,"_3297":58737},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3844":1395,"_33198":1264,"_22654":58739,"_5":15607,"_29907":58366,"_3297":58740},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3844":1396,"_33198":1264,"_22654":58742,"_5":15607,"_29907":58366,"_3297":58407},[],{"_3844":1397,"_33198":1264,"_22654":58744,"_5":15607,"_29907":58366,"_3297":58745},[],"`EventBindDeviceIdentityKey`",{"_3844":1398,"_33198":1264,"_22654":58747,"_5":15607,"_29907":58366,"_3297":58748},[],"Device",{"_3844":1399,"_33198":1264,"_22654":58750,"_5":15607,"_29907":58366,"_3297":58751},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3844":1400,"_33198":1264,"_22654":58753,"_5":15607,"_29907":58366,"_3297":58754},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3844":1401,"_33198":1264,"_22654":58756,"_5":15607,"_29907":58366,"_3297":58757},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3844":1402,"_33198":1264,"_22654":58759,"_5":15607,"_29907":58366,"_3297":58415},[],{"_3844":1403,"_33198":1264,"_22654":58761,"_5":15607,"_29907":58366,"_3297":58762},[],"`EventUpdateCertificateStatusKey`",{"_3844":1404,"_33198":1264,"_22654":58764,"_5":15607,"_29907":58366,"_3297":58765},[],"Certificate",{"_3844":1405,"_33198":1264,"_22654":58767,"_5":15607,"_29907":58366,"_3297":58768},[],"`IoTCore/Certificate`",{"_3844":1406,"_33198":1264,"_22654":58770,"_5":15607,"_29907":58366,"_3297":58771},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3844":1407,"_33198":1264,"_22654":58773,"_5":15607,"_29907":58366,"_3297":58774},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3844":1408,"_33198":1264,"_22654":58776,"_5":15607,"_29907":58366,"_3297":58427},[],{"_3844":1409,"_33198":1264,"_22654":58778,"_5":15607,"_29907":58366,"_3297":58779},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3844":1410,"_33198":1264,"_22654":58781,"_5":15607,"_29907":58366,"_3297":58782},[],"Certificate / Device",{"_3844":1411,"_33198":1264,"_22654":58784,"_5":15607,"_29907":58366,"_3297":58785},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3844":1412,"_33198":1264,"_22654":58787,"_5":15607,"_29907":58366,"_3297":54798},[],{"_3844":1413,"_33198":1264,"_22654":58789,"_5":15607,"_29907":58366,"_3297":58790},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3844":1414,"_33198":1264,"_22654":58792,"_5":15607,"_29907":58366,"_3297":58435},[],{"_3844":1415,"_33198":1264,"_22654":58794,"_5":15607,"_29907":58370,"_3297":58795},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3844":1416,"_33198":1264,"_22654":58797,"_5":15607,"_29907":58374,"_3297":58798},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3844":1417,"_33198":1264,"_22654":58800,"_5":15607,"_29907":58374,"_3297":58801},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3844":1418,"_33198":1264,"_22654":58803,"_5":15607,"_29907":58378,"_3297":58804},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3844":1419,"_33198":1264,"_22654":58806,"_5":15607,"_29907":58378,"_3297":58807},[],"Transition",{"_3844":1420,"_33198":1264,"_22654":58809,"_5":15607,"_29907":58378,"_3297":58810},[],"AWS calls",{"_3844":1421,"_33198":1264,"_22654":58812,"_5":15607,"_29907":58378,"_3297":58813},[],"`NotRegistered` → `Requested`",{"_3844":1422,"_33198":1264,"_22654":58815,"_5":15607,"_29907":58378,"_3297":58816},[],"none (metadata write only)",{"_3844":1423,"_33198":1264,"_22654":58818,"_5":15607,"_29907":58378,"_3297":58819},[],"`Requested` → `Registering`",{"_3844":1424,"_33198":1264,"_22654":58821,"_5":15607,"_29907":58378,"_3297":58822},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3844":1425,"_33198":1264,"_22654":58824,"_5":15607,"_29907":58378,"_3297":58825},[],"`Registering` → `Succeeded`",{"_3844":1426,"_33198":1264,"_22654":58827,"_5":15607,"_29907":58378,"_3297":58828},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3844":1427,"_33198":1264,"_22654":58830,"_5":15607,"_29907":58378,"_3297":58831},[],"`Registering` → `Failed`",{"_3844":1428,"_33198":1264,"_22654":58833,"_5":15607,"_29907":58378,"_3297":58834},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3844":1429,"_33198":1264,"_22654":58836,"_5":15607,"_29907":58378,"_3297":58837},[],"`Failed` / `Succeeded` → `Requested`",{"_3844":1430,"_33198":1264,"_22654":58839,"_5":15607,"_29907":58378,"_3297":58840},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3844":1431,"_33198":1264,"_22654":58842,"_5":15607,"_29907":58382,"_3297":58843},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3844":1432,"_33198":1264,"_22654":58845,"_5":15607,"_29907":58382,"_3297":58846},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3844":1433,"_33198":1264,"_22654":58848,"_5":15607,"_29907":58382,"_3297":58849},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3844":1434,"_33198":1264,"_22654":58851,"_5":15607,"_29907":58382,"_3297":58852},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3844":1435,"_33198":1264,"_22654":58854,"_5":15607,"_29907":58382,"_3297":58855},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3844":1436,"_33198":1264,"_22654":58857,"_5":15607,"_29907":58382,"_3297":58858},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3844":1437,"_33198":1264,"_22654":58860,"_5":15607,"_29907":58386,"_3297":58861},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3844":1438,"_33198":1264,"_22654":58863,"_5":15607,"_29907":58390,"_3297":58864},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3844":1439,"_33198":1264,"_22654":58866,"_5":15607,"_29907":58390,"_3297":58867},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3844":1440,"_33198":1264,"_22654":58869,"_5":15607,"_29907":58394,"_3297":58870},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3844":1441,"_33198":1264,"_22654":58872,"_5":15607,"_29907":58398,"_3297":58873},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3844":1442,"_33198":1264,"_22654":58875,"_5":15607,"_29907":58398,"_3297":58876},[],"Creates or updates the IoT policies configured in the DMS.",{"_3844":1443,"_33198":1264,"_22654":58878,"_5":15607,"_29907":58398,"_3297":58879},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3844":1444,"_33198":1264,"_22654":58881,"_5":15607,"_29907":58398,"_3297":58882},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3844":1445,"_33198":1264,"_22654":58884,"_5":15607,"_29907":58398,"_3297":58885},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3844":1446,"_33198":1264,"_22654":58887,"_5":15607,"_29907":58398,"_3297":58888},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3844":1447,"_33198":1264,"_22654":58890,"_5":15607,"_29907":58398,"_3297":58891},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3844":1448,"_33198":1264,"_22654":58893,"_5":15607,"_29907":58402,"_3297":58894},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3844":1449,"_33198":1264,"_22654":58896,"_5":15607,"_29907":58402,"_3297":58897},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3844":1450,"_33198":1264,"_22654":58899,"_5":15607,"_29907":58402,"_3297":58900},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3844":1451,"_33198":1264,"_22654":58902,"_5":15607,"_29907":58402,"_3297":58903},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3844":1452,"_33198":1264,"_22654":58905,"_5":15607,"_29907":58402,"_3297":58906},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3844":1453,"_33198":1264,"_22654":58908,"_5":15607,"_29907":58406,"_3297":58909},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3844":1454,"_33198":1264,"_22654":58911,"_5":15607,"_29907":58406,"_3297":58807},[],{"_3844":1455,"_33198":1264,"_22654":58913,"_5":15607,"_29907":58406,"_3297":58810},[],{"_3844":1456,"_33198":1264,"_22654":58915,"_5":15607,"_29907":58406,"_3297":58916},[],"`Unconfigured` → `None` / `Auto`",{"_3844":1457,"_33198":1264,"_22654":58918,"_5":15607,"_29907":58406,"_3297":58919},[],"none (configuration only)",{"_3844":1458,"_33198":1264,"_22654":58921,"_5":15607,"_29907":58406,"_3297":58922},[],"`None` ↔ `Auto`",{"_3844":1459,"_33198":1264,"_22654":58924,"_5":15607,"_29907":58406,"_3297":58919},[],{"_3844":1460,"_33198":1264,"_22654":58926,"_5":15607,"_29907":58406,"_3297":58927},[],"Any → `Jitp`",{"_3844":1461,"_33198":1264,"_22654":58929,"_5":15607,"_29907":58406,"_3297":58930},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3844":1462,"_33198":1264,"_22654":58932,"_5":15607,"_29907":58406,"_3297":58933},[],"`Jitp` → `None` / `Auto`",{"_3844":1463,"_33198":1264,"_22654":58935,"_5":15607,"_29907":58406,"_3297":58936},[],"none (the template stays in the AWS account)",{"_3844":1464,"_33198":1264,"_22654":58938,"_5":15607,"_29907":58410,"_3297":58939},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3844":1465,"_33198":1264,"_22654":58941,"_5":15607,"_29907":58410,"_3297":58942},[],"The full flow from the device's perspective is:",{"_3844":1466,"_33198":1264,"_22654":58944,"_5":15607,"_29907":58410,"_3297":58945},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3844":1467,"_33198":1264,"_22654":58947,"_5":15607,"_29907":58414,"_3297":58948},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3844":1468,"_33198":1264,"_22654":58950,"_5":15607,"_29907":58414,"_3297":58807},[],{"_3844":1469,"_33198":1264,"_22654":58952,"_5":15607,"_29907":58414,"_3297":58810},[],{"_3844":1470,"_33198":1264,"_22654":58954,"_5":15607,"_29907":58414,"_3297":58955},[],"`Absent` → `Provisioned`",{"_3844":1471,"_33198":1264,"_22654":58957,"_5":15607,"_29907":58414,"_3297":58958},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3844":1472,"_33198":1264,"_22654":58960,"_5":15607,"_29907":58414,"_3297":58961},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3844":1473,"_33198":1264,"_22654":58963,"_5":15607,"_29907":58414,"_3297":58964},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3844":1474,"_33198":1264,"_22654":58966,"_5":15607,"_29907":58414,"_3297":58967},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3844":1475,"_33198":1264,"_22654":58969,"_5":15607,"_29907":58418,"_3297":58970},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3844":1476,"_33198":1264,"_22654":58972,"_5":15607,"_29907":58418,"_3297":58973},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3844":1477,"_33198":1264,"_22654":58975,"_5":15607,"_29907":58418,"_3297":58976},[],"For the JITP flow to work correctly:",{"_3844":1478,"_33198":1264,"_22654":58978,"_5":15607,"_29907":58418,"_3297":58979},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3844":1479,"_33198":1264,"_22654":58981,"_5":15607,"_29907":58418,"_3297":58982},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3844":1480,"_33198":1264,"_22654":58984,"_5":15607,"_29907":58418,"_3297":58985},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3844":1481,"_33198":1264,"_22654":58987,"_5":15607,"_29907":58418,"_3297":58988},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3844":1482,"_33198":1264,"_22654":58990,"_5":15607,"_29907":58422,"_3297":58991},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3844":1483,"_33198":1264,"_22654":58993,"_5":15607,"_29907":58422,"_3297":58994},[],"Status in Lamassu",{"_3844":1484,"_33198":1264,"_22654":58996,"_5":15607,"_29907":58422,"_3297":58997},[],"Revocation reason",{"_3844":1485,"_33198":1264,"_22654":58999,"_5":15607,"_29907":58422,"_3297":59000},[],"Status in AWS IoT Core",{"_3844":1486,"_33198":1264,"_22654":59002,"_5":15607,"_29907":58422,"_3297":59003},[],"`Active`",{"_3844":1487,"_33198":1264,"_22654":59005,"_5":15607,"_29907":58422,"_3297":59006},[],"None",{"_3844":1488,"_33198":1264,"_22654":59008,"_5":15607,"_29907":58422,"_3297":59009},[],"`ACTIVE`",{"_3844":1489,"_33198":1264,"_22654":59011,"_5":15607,"_29907":58422,"_3297":59012},[],"`Revoked`",{"_3844":1490,"_33198":1264,"_22654":59014,"_5":15607,"_29907":58422,"_3297":59015},[],"`certificateHold`",{"_3844":1491,"_33198":1264,"_22654":59017,"_5":15607,"_29907":58422,"_3297":59018},[],"`INACTIVE`",{"_3844":1492,"_33198":1264,"_22654":59020,"_5":15607,"_29907":58422,"_3297":59012},[],{"_3844":1493,"_33198":1264,"_22654":59022,"_5":15607,"_29907":58422,"_3297":59023},[],"Any other reason",{"_3844":1494,"_33198":1264,"_22654":59025,"_5":15607,"_29907":58422,"_3297":59026},[],"`REVOKED`",{"_3844":1495,"_33198":1264,"_22654":59028,"_5":15607,"_29907":58422,"_3297":59029},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3844":1496,"_33198":1264,"_22654":59031,"_5":15607,"_29907":58426,"_3297":59032},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3844":1497,"_33198":1264,"_22654":59034,"_5":15607,"_29907":58426,"_3297":58807},[],{"_3844":1498,"_33198":1264,"_22654":59036,"_5":15607,"_29907":58426,"_3297":58810},[],{"_3844":1499,"_33198":1264,"_22654":59038,"_5":15607,"_29907":58426,"_3297":59039},[],"`NotSynced` → `Active`",{"_3844":1500,"_33198":1264,"_22654":59041,"_5":15607,"_29907":58426,"_3297":58518},[],{"_3844":1501,"_33198":1264,"_22654":59043,"_5":15607,"_29907":58426,"_3297":59044},[],"`Active` → `Inactive`",{"_3844":1502,"_33198":1264,"_22654":59046,"_5":15607,"_29907":58426,"_3297":59047},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3844":1503,"_33198":1264,"_22654":59049,"_5":15607,"_29907":58426,"_3297":59050},[],"`Active` → `Revoked`",{"_3844":1504,"_33198":1264,"_22654":59052,"_5":15607,"_29907":58426,"_3297":59047},[],{"_3844":1505,"_33198":1264,"_22654":59054,"_5":15607,"_29907":58426,"_3297":59055},[],"`Inactive` / `Revoked` → `Active`",{"_3844":1506,"_33198":1264,"_22654":59057,"_5":15607,"_29907":58426,"_3297":58518},[],{"_3844":1507,"_33198":1264,"_22654":59059,"_5":15607,"_29907":58426,"_3297":59060},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3844":1508,"_33198":1264,"_22654":59062,"_5":15607,"_29907":58426,"_3297":59063},[],"none (these states are not synced to AWS)",{"_3844":1509,"_33198":1264,"_22654":59065,"_5":15607,"_29907":58430,"_3297":59066},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3844":1510,"_33198":1264,"_22654":59068,"_5":15607,"_29907":58430,"_3297":59069},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3844":1511,"_33198":1264,"_22654":59071,"_5":15607,"_29907":58430,"_3297":59072},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3844":1512,"_33198":1264,"_22654":59074,"_5":15607,"_29907":58434,"_3297":59075},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3844":1513,"_33198":1264,"_22654":59077,"_5":15607,"_29907":58434,"_3297":59078},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3844":1514,"_33198":1264,"_22654":59080,"_5":15607,"_29907":58438,"_3297":59081},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3844":1515,"_33198":1264,"_22654":59083,"_5":15607,"_29907":58438,"_3297":59084},[],"There are two action types:",{"_3844":1516,"_33198":1264,"_22654":59086,"_5":15607,"_29907":58438,"_3297":59087},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3844":1517,"_33198":1264,"_22654":59089,"_5":15607,"_29907":58438,"_3297":59090},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3844":1518,"_33198":1264,"_22654":59092,"_5":15607,"_29907":58438,"_3297":59093},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3844":1519,"_33198":1264,"_22654":59095,"_5":15607,"_29907":58442,"_3297":59096},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3844":1520,"_33198":1264,"_22654":59098,"_5":15607,"_29907":58442,"_3297":59099},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3844":1521,"_33198":1264,"_22654":59101,"_5":15607,"_29907":58442,"_3297":59102},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3844":1522,"_33198":1264,"_22654":59104,"_5":15607,"_29907":58446,"_3297":59105},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3844":1523,"_33198":1264,"_22654":59107,"_5":15607,"_29907":58446,"_3297":59108},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3844":1524,"_33198":1264,"_22654":59110,"_5":15607,"_29907":58446,"_3297":59111},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3844":1525,"_33198":1264,"_22654":59113,"_5":15607,"_29907":58446,"_3297":59114},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3844":1526,"_33198":1264,"_22654":59116,"_5":15607,"_29907":58446,"_3297":59117},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3844":1527,"_33198":1264,"_22654":59119,"_5":15607,"_29907":58446,"_3297":59120},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3844":1528,"_33198":1264,"_22654":59122,"_5":15607,"_29907":58446,"_3297":59123},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3844":1529,"_33198":1264,"_22654":59125,"_5":15607,"_29907":58446,"_3297":59126},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3844":1530,"_33198":1264,"_22654":59128,"_5":15607,"_29907":58446,"_3297":59129},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3844":1531,"_33198":1264,"_22654":59131,"_5":15607,"_29907":58446,"_3297":59132},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3844":1532,"_33198":1264,"_22654":59134,"_5":15607,"_29907":58446,"_3297":59135},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3844":1533,"_33198":1264,"_22654":59137,"_5":15607,"_29907":58446,"_3297":59138},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3844":1534,"_33198":1264,"_22654":59140,"_5":15607,"_29907":58446,"_3297":59141},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3844":1535,"_33198":1264,"_22654":59143,"_5":15607,"_29907":58446,"_3297":59144},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3844":1536,"_33198":1264,"_22654":59146,"_5":15607,"_29907":58446,"_3297":59147},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3844":1537,"_33198":1264,"_22654":59149,"_5":15607,"_29907":58446,"_3297":59150},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3844":1538,"_33198":1264,"_22654":59152,"_5":15607,"_29907":58446,"_3297":59153},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3844":1539,"_33198":1264,"_22654":59155,"_5":15607,"_29907":58446,"_3297":59156},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3844":1540,"_33198":1264,"_22654":59158,"_5":15607,"_29907":58446,"_3297":59159},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3844":1541,"_33198":1264,"_22654":59161,"_5":15607,"_29907":58446,"_3297":59162},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3844":1542,"_33198":1264,"_22654":59164,"_5":15607,"_29907":58446,"_3297":59165},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3844":1543,"_33198":1264,"_22654":59167,"_5":15607,"_29907":58446,"_3297":59168},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3844":1544,"_33198":1264,"_22654":59170,"_5":15607,"_29907":58446,"_3297":59171},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3844":1545,"_33198":1264,"_22654":59173,"_5":15607,"_29907":58446,"_3297":59174},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3844":1546,"_33198":1546,"_5":16006,"_3297":56881,"_33604":59176,"_22654":59177,"_29907":1546},[54402,55870,56881],[],{"_3844":1547,"_33198":1546,"_22654":59179,"_5":15607,"_29907":1546,"_3297":59180},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3844":1548,"_33198":1546,"_5":33601,"_22654":59182,"_29907":59183,"_3297":59184},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#start-here","Start here",{"_3844":1549,"_33198":1546,"_5":33601,"_22654":59186,"_29907":59187,"_3297":56879},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#devices-and-identities",{"_3844":1550,"_33198":1546,"_5":33601,"_22654":59189,"_29907":59190,"_3297":57062},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#enrollment-with-pki",{"_3844":1551,"_33198":1546,"_5":33601,"_22654":59192,"_29907":59193,"_3297":58343},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#integrations",{"_3844":1552,"_33198":1546,"_5":33601,"_22654":59195,"_29907":59196,"_3297":59197},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3844":1553,"_33198":1546,"_22654":59199,"_5":15607,"_29907":1546,"_3297":59200},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3844":1554,"_33198":1546,"_22654":59202,"_5":15607,"_29907":59183,"_3297":59203},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3844":1555,"_33198":1546,"_22654":59205,"_5":15607,"_29907":59183,"_3297":59206},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3844":1556,"_33198":1546,"_22654":59208,"_5":15607,"_29907":59187,"_3297":59209},[],"Resource",{"_3844":1557,"_33198":1546,"_22654":59211,"_5":15607,"_29907":59187,"_3297":59212},[],"What it represents",{"_3844":1558,"_33198":1546,"_22654":59214,"_5":15607,"_29907":59187,"_3297":59215},[],"**Device**",{"_3844":1559,"_33198":1546,"_22654":59217,"_5":15607,"_29907":59187,"_3297":59218},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3844":1560,"_33198":1546,"_22654":59220,"_5":15607,"_29907":59187,"_3297":59221},[],"**Identity**",{"_3844":1561,"_33198":1546,"_22654":59223,"_5":15607,"_29907":59187,"_3297":59224},[],"The device's association with its certificates: an active version and a history.",{"_3844":1562,"_33198":1546,"_22654":59226,"_5":15607,"_29907":59187,"_3297":59227},[],"**DMS**",{"_3844":1563,"_33198":1546,"_22654":59229,"_5":15607,"_29907":59187,"_3297":59230},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3844":1564,"_33198":1546,"_22654":59232,"_5":15607,"_29907":59187,"_3297":59233},[],"**Fleet**",{"_3844":1565,"_33198":1546,"_22654":59235,"_5":15607,"_29907":59187,"_3297":59236},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3844":1566,"_33198":1546,"_22654":59238,"_5":15607,"_29907":59187,"_3297":59239},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3844":1567,"_33198":1546,"_22654":59241,"_5":15607,"_29907":59187,"_3297":59242},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3844":1568,"_33198":1546,"_22654":59244,"_5":15607,"_29907":59190,"_3297":59245},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3844":1569,"_33198":1546,"_22654":59247,"_5":15607,"_29907":59190,"_3297":59248},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3844":1570,"_33198":1546,"_22654":59250,"_5":15607,"_29907":59190,"_3297":59251},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3844":1571,"_33198":1546,"_22654":59253,"_5":15607,"_29907":59190,"_3297":59254},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3844":1572,"_33198":1546,"_22654":59256,"_5":15607,"_29907":59190,"_3297":59257},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3844":1573,"_33198":1546,"_22654":59259,"_5":15607,"_29907":59190,"_3297":59260},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3844":1574,"_33198":1546,"_22654":59262,"_5":15607,"_29907":59190,"_3297":59263},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3844":1575,"_33198":1546,"_22654":59265,"_5":15607,"_29907":59190,"_3297":59266},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3844":1576,"_33198":1546,"_22654":59268,"_5":15607,"_29907":59193,"_3297":59269},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3844":1577,"_33198":1546,"_22654":59271,"_5":15607,"_29907":59193,"_3297":59272},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3844":1578,"_33198":1546,"_22654":59274,"_5":15607,"_29907":59196,"_3297":59275},[],"Participant",{"_3844":1579,"_33198":1546,"_22654":59277,"_5":15607,"_29907":59196,"_3297":59278},[],"Responsibility",{"_3844":1580,"_33198":1546,"_22654":59280,"_5":15607,"_29907":59196,"_3297":59281},[],"PKI administrator",{"_3844":1581,"_33198":1546,"_22654":59283,"_5":15607,"_29907":59196,"_3297":59284},[],"CA, issuance profile, chain and revocation publication.",{"_3844":1582,"_33198":1546,"_22654":59286,"_5":15607,"_29907":59196,"_3297":59287},[],"Provisioning administrator",{"_3844":1583,"_33198":1546,"_22654":59289,"_5":15607,"_29907":59196,"_3297":59290},[],"DMS, admission, authentication per operation and inventory.",{"_3844":1584,"_33198":1546,"_22654":59292,"_5":15607,"_29907":59196,"_3297":59293},[],"Device integrator",{"_3844":1585,"_33198":1546,"_22654":59295,"_5":15607,"_29907":59196,"_3297":59296},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3844":1586,"_33198":1546,"_22654":59298,"_5":15607,"_29907":59196,"_3297":59299},[],"Consumer integrator",{"_3844":1587,"_33198":1546,"_22654":59301,"_5":15607,"_29907":59196,"_3297":59302},[],"Trusted issuers, validation and device permissions in the destination.",{"_3844":1588,"_33198":1546,"_22654":59304,"_5":15607,"_29907":59196,"_3297":59305},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3844":1589,"_33198":1589,"_5":16006,"_3297":59307,"_33604":59308,"_22654":59310,"_29907":1589},"Enroll and connect your first device",[54402,55870,56881,59309],"Getting started",[],{"_3844":1590,"_33198":1589,"_22654":59312,"_5":15607,"_29907":1589,"_3297":59313},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3844":1591,"_33198":1589,"_5":33601,"_22654":59315,"_29907":59316,"_3297":54412},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3844":1592,"_33198":1589,"_5":33601,"_22654":59318,"_29907":59319,"_3297":59320},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3844":1593,"_33198":1589,"_5":33601,"_22654":59322,"_29907":59323,"_3297":59324},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3844":1594,"_33198":1589,"_5":33601,"_22654":59326,"_29907":59327,"_3297":59328},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3844":1595,"_33198":1589,"_5":33601,"_22654":59330,"_29907":59331,"_3297":59332},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3844":1596,"_33198":1589,"_5":33601,"_22654":59334,"_29907":59335,"_3297":59336},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3844":1597,"_33198":1589,"_5":33601,"_22654":59338,"_29907":59339,"_3297":59340},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3844":1598,"_33198":1589,"_5":33601,"_22654":59342,"_29907":59343,"_3297":59344},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3844":1599,"_33198":1589,"_22654":59346,"_5":15607,"_29907":1589,"_3297":59347},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3844":1600,"_33198":1589,"_22654":59349,"_5":15607,"_29907":59316,"_3297":59350},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3844":1601,"_33198":1589,"_22654":59352,"_5":15607,"_29907":59316,"_3297":59353},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3844":1602,"_33198":1589,"_22654":59355,"_5":15607,"_29907":59316,"_3297":59356},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3844":1603,"_33198":1589,"_22654":59358,"_5":15607,"_29907":59316,"_3297":59359},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3844":1604,"_33198":1589,"_22654":59361,"_5":15607,"_29907":59316,"_3297":59362},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3844":1605,"_33198":1589,"_22654":59364,"_5":15607,"_29907":59319,"_3297":59365},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3844":1606,"_33198":1589,"_22654":59367,"_5":15607,"_29907":59319,"_3297":59368},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3844":1607,"_33198":1589,"_22654":59370,"_5":15607,"_29907":59323,"_3297":59371},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3844":1608,"_33198":1589,"_22654":59373,"_5":15607,"_29907":59323,"_3297":59374},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3844":1609,"_33198":1589,"_22654":59376,"_5":15607,"_29907":59323,"_3297":59377},[],"Setting",{"_3844":1610,"_33198":1589,"_22654":59379,"_5":15607,"_29907":59323,"_3297":59380},[],"Evaluation value",{"_3844":1611,"_33198":1589,"_22654":59382,"_5":15607,"_29907":59323,"_3297":59383},[],"Enrollment CA",{"_3844":1612,"_33198":1589,"_22654":59385,"_5":15607,"_29907":59323,"_3297":59386},[],"Issuing root from `device-root.pem`.",{"_3844":1613,"_33198":1589,"_22654":59388,"_5":15607,"_29907":59323,"_3297":57192},[],{"_3844":1614,"_33198":1589,"_22654":59390,"_5":15607,"_29907":59323,"_3297":59391},[],"The 1-hour leaf profile you just prepared.",{"_3844":1615,"_33198":1589,"_22654":59393,"_5":15607,"_29907":59323,"_3297":59394},[],"Protocol / Registration Mode",{"_3844":1616,"_33198":1589,"_22654":59396,"_5":15607,"_29907":59323,"_3297":59397},[],"`EST_RFC7030` / `JITP`.",{"_3844":1617,"_33198":1589,"_22654":59399,"_5":15607,"_29907":59323,"_3297":59400},[],"Verify CSR Signature",{"_3844":1618,"_33198":1589,"_22654":59402,"_5":15607,"_29907":59323,"_3297":59403},[],"Enabled.",{"_3844":1619,"_33198":1589,"_22654":59405,"_5":15607,"_29907":59323,"_3297":59406},[],"Enable Replaceable Enrollment",{"_3844":1620,"_33198":1589,"_22654":59408,"_5":15607,"_29907":59323,"_3297":59409},[],"Disabled; the ID must be new.",{"_3844":1621,"_33198":1589,"_22654":59411,"_5":15607,"_29907":59323,"_3297":59412},[],"Initial authentication",{"_3844":1622,"_33198":1589,"_22654":59414,"_5":15607,"_29907":59323,"_3297":59415},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3844":1623,"_33198":1589,"_22654":59417,"_5":15607,"_29907":59323,"_3297":59418},[],"Renewal authentication",{"_3844":1624,"_33198":1589,"_22654":59420,"_5":15607,"_29907":59323,"_3297":59421},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3844":1625,"_33198":1589,"_22654":59423,"_5":15607,"_29907":59323,"_3297":59424},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3844":1626,"_33198":1589,"_22654":59426,"_5":15607,"_29907":59323,"_3297":59427},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3844":1627,"_33198":1589,"_22654":59429,"_5":15607,"_29907":59323,"_3297":59430},[],"Re-enrollment Delta",{"_3844":1628,"_33198":1589,"_22654":59432,"_5":15607,"_29907":59323,"_3297":59433},[],"1 hour.",{"_3844":1629,"_33198":1589,"_22654":59435,"_5":15607,"_29907":59323,"_3297":59436},[],"Preventive / Critical Delta",{"_3844":1630,"_33198":1589,"_22654":59438,"_5":15607,"_29907":59323,"_3297":59439},[],"30 minutes / 10 minutes.",{"_3844":1631,"_33198":1589,"_22654":59441,"_5":15607,"_29907":59323,"_3297":59442},[],"Revoke on Re-enrollment",{"_3844":1632,"_33198":1589,"_22654":59444,"_5":15607,"_29907":59323,"_3297":59445},[],"Disabled to test the successor before retiring the previous identity.",{"_3844":1633,"_33198":1589,"_22654":59447,"_5":15607,"_29907":59323,"_3297":57200},[],{"_3844":1634,"_33198":1589,"_22654":59449,"_5":15607,"_29907":59323,"_3297":59450},[],"Disabled; the operational key is generated in the client.",{"_3844":1635,"_33198":1589,"_22654":59452,"_5":15607,"_29907":59323,"_3297":59453},[],"CA Distribution",{"_3844":1636,"_33198":1589,"_22654":59455,"_5":15607,"_29907":59323,"_3297":59456},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3844":1637,"_33198":1589,"_22654":59458,"_5":15607,"_29907":59323,"_3297":59459},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3844":1638,"_33198":1589,"_22654":59461,"_5":15607,"_29907":59327,"_3297":59462},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3844":1639,"_33198":1589,"_22654":59464,"_5":15607,"_29907":59327,"_3297":59465},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3844":1640,"_33198":1589,"_22654":59467,"_5":15607,"_29907":59331,"_3297":59468},[],"Generate a new key and CSR with the selected identifier:",{"_3844":1641,"_33198":1589,"_22654":59470,"_5":15607,"_29907":59331,"_3297":59471},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3844":1642,"_33198":1589,"_22654":59473,"_5":15607,"_29907":59331,"_3297":59474},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3844":1643,"_33198":1589,"_22654":59476,"_5":15607,"_29907":59335,"_3297":59477},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3844":1644,"_33198":1589,"_22654":59479,"_5":15607,"_29907":59335,"_3297":59480},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3844":1645,"_33198":1589,"_22654":59482,"_5":15607,"_29907":59339,"_3297":59483},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3844":1646,"_33198":1589,"_22654":59485,"_5":15607,"_29907":59339,"_3297":59486},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3844":1647,"_33198":1589,"_22654":59488,"_5":15607,"_29907":59339,"_3297":59489},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3844":1648,"_33198":1589,"_22654":59491,"_5":15607,"_29907":59339,"_3297":59492},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3844":1649,"_33198":1589,"_22654":59494,"_5":15607,"_29907":59339,"_3297":59495},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3844":1650,"_33198":1589,"_22654":59497,"_5":15607,"_29907":59343,"_3297":59498},[],"Check",{"_3844":1651,"_33198":1589,"_22654":59500,"_5":15607,"_29907":59343,"_3297":59501},[],"Expected result",{"_3844":1652,"_33198":1589,"_22654":59503,"_5":15607,"_29907":59343,"_3297":59504},[],"Registration",{"_3844":1653,"_33198":1589,"_22654":59506,"_5":15607,"_29907":59343,"_3297":59507},[],"ID created automatically and correct DMS.",{"_3844":1654,"_33198":1589,"_22654":59509,"_5":15607,"_29907":59343,"_3297":58765},[],{"_3844":1655,"_33198":1589,"_22654":59511,"_5":15607,"_29907":59343,"_3297":59512},[],"CN, profile, serial and key verified.",{"_3844":1656,"_33198":1589,"_22654":59514,"_5":15607,"_29907":59343,"_3297":59515},[],"Inventory",{"_3844":1657,"_33198":1589,"_22654":59517,"_5":15607,"_29907":59343,"_3297":59518},[],"Received serial visible as the current identity and in history.",{"_3844":1658,"_33198":1589,"_22654":59520,"_5":15607,"_29907":59343,"_3297":59521},[],"Consumer",{"_3844":1659,"_33198":1589,"_22654":59523,"_5":15607,"_29907":59343,"_3297":59524},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3844":1660,"_33198":1589,"_22654":59526,"_5":15607,"_29907":59343,"_3297":59527},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3844":1661,"_33198":1589,"_22654":59529,"_5":15607,"_29907":59343,"_3297":59530},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3844":1662,"_33198":1662,"_5":16006,"_3297":56897,"_33604":59532,"_22654":59533,"_29907":1662},[54402,55870,56881,59309],[],{"_3844":1663,"_33198":1662,"_22654":59535,"_5":15607,"_29907":1662,"_3297":59536},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3844":1664,"_33198":1662,"_5":33601,"_22654":59538,"_29907":59539,"_3297":54412},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3844":1665,"_33198":1662,"_5":33601,"_22654":59541,"_29907":59542,"_3297":59543},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3844":1666,"_33198":1662,"_5":33601,"_22654":59545,"_29907":59546,"_3297":59547},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3844":1667,"_33198":1662,"_5":33601,"_22654":59549,"_29907":59550,"_3297":59551},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3844":1668,"_33198":1662,"_5":33601,"_22654":59553,"_29907":59554,"_3297":59555},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3844":1669,"_33198":1662,"_5":33601,"_22654":59557,"_29907":59558,"_3297":59559},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3844":1670,"_33198":1662,"_5":33601,"_22654":59561,"_29907":59562,"_3297":59501},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3844":1671,"_33198":1662,"_5":33601,"_22654":59564,"_29907":59565,"_3297":59566},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3844":1672,"_33198":1662,"_5":33601,"_22654":59568,"_29907":59569,"_3297":59570},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3844":1673,"_33198":1662,"_22654":59572,"_5":15607,"_29907":1662,"_3297":59573},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3844":1674,"_33198":1662,"_22654":59575,"_5":15607,"_29907":1662,"_3297":59576},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3844":1675,"_33198":1662,"_22654":59578,"_5":15607,"_29907":59539,"_3297":59579},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3844":1676,"_33198":1662,"_22654":59581,"_5":15607,"_29907":59539,"_3297":59582},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3844":1677,"_33198":1662,"_22654":59584,"_5":15607,"_29907":59539,"_3297":59585},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3844":1678,"_33198":1662,"_22654":59587,"_5":15607,"_29907":59539,"_3297":59588},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3844":1679,"_33198":1662,"_22654":59590,"_5":15607,"_29907":59542,"_3297":59591},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3844":1680,"_33198":1662,"_22654":59593,"_5":15607,"_29907":59542,"_3297":59594},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3844":1681,"_33198":1662,"_22654":59596,"_5":15607,"_29907":59542,"_3297":59597},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3844":1682,"_33198":1662,"_22654":59599,"_5":15607,"_29907":59542,"_3297":59600},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3844":1683,"_33198":1662,"_22654":59602,"_5":15607,"_29907":59542,"_3297":59603},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3844":1684,"_33198":1662,"_22654":59605,"_5":15607,"_29907":59542,"_3297":59606},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3844":1685,"_33198":1662,"_22654":59608,"_5":15607,"_29907":59542,"_3297":59609},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3844":1686,"_33198":1662,"_22654":59611,"_5":15607,"_29907":59542,"_3297":59612},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3844":1687,"_33198":1662,"_22654":59614,"_5":15607,"_29907":59546,"_3297":59615},[],"Open **Managed Devices** and the registration action. Complete:",{"_3844":1688,"_33198":1662,"_22654":59617,"_5":15607,"_29907":59546,"_3297":59618},[],"**Device ID**: `device-001`.",{"_3844":1689,"_33198":1662,"_22654":59620,"_5":15607,"_29907":59546,"_3297":59621},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3844":1690,"_33198":1662,"_22654":59623,"_5":15607,"_29907":59546,"_3297":59624},[],"**Icon** and **Tags**: optional classification.",{"_3844":1691,"_33198":1662,"_22654":59626,"_5":15607,"_29907":59546,"_3297":59627},[],"Confirm registration.",{"_3844":1692,"_33198":1662,"_22654":59629,"_5":15607,"_29907":59550,"_3297":59630},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3844":1693,"_33198":1662,"_22654":59632,"_5":15607,"_29907":59550,"_3297":59633},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3844":1694,"_33198":1662,"_22654":59635,"_5":15607,"_29907":59554,"_3297":59636},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3844":1695,"_33198":1662,"_22654":59638,"_5":15607,"_29907":59554,"_3297":59639},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3844":1696,"_33198":1662,"_22654":59641,"_5":15607,"_29907":59558,"_3297":59642},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3844":1697,"_33198":1662,"_22654":59644,"_5":15607,"_29907":59558,"_3297":59645},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3844":1698,"_33198":1662,"_22654":59647,"_5":15607,"_29907":59562,"_3297":59498},[],{"_3844":1699,"_33198":1662,"_22654":59649,"_5":15607,"_29907":59562,"_3297":59650},[],"Result",{"_3844":1700,"_33198":1662,"_22654":59652,"_5":15607,"_29907":59562,"_3297":58748},[],{"_3844":1701,"_33198":1662,"_22654":59654,"_5":15607,"_29907":59562,"_3297":59655},[],"`device-001` appears in inventory with the expected DMS.",{"_3844":1702,"_33198":1662,"_22654":59657,"_5":15607,"_29907":59562,"_3297":59658},[],"Current identity",{"_3844":1703,"_33198":1662,"_22654":59660,"_5":15607,"_29907":59562,"_3297":59661},[],"The associated certificate matches the one you verified in PKI.",{"_3844":1704,"_33198":1662,"_22654":59663,"_5":15607,"_29907":59562,"_3297":59664},[],"History",{"_3844":1705,"_33198":1662,"_22654":59666,"_5":15607,"_29907":59562,"_3297":59667},[],"The associated issuance appears with its serial number and dates.",{"_3844":1706,"_33198":1662,"_22654":59669,"_5":15607,"_29907":59562,"_3297":59670},[],"Key and certificate",{"_3844":1707,"_33198":1662,"_22654":59672,"_5":15607,"_29907":59562,"_3297":59673},[],"You have the verified pair ready to install on the device.",{"_3844":1708,"_33198":1662,"_22654":59675,"_5":15607,"_29907":59565,"_3297":59676},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3844":1709,"_33198":1662,"_22654":59678,"_5":15607,"_29907":59565,"_3297":59679},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3844":1710,"_33198":1662,"_22654":59681,"_5":15607,"_29907":59565,"_3297":59682},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3844":1711,"_33198":1662,"_22654":59684,"_5":15607,"_29907":59565,"_3297":59685},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3844":1712,"_33198":1662,"_22654":59687,"_5":15607,"_29907":59569,"_3297":59688},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3844":1713,"_33198":1662,"_22654":59690,"_5":15607,"_29907":59569,"_3297":59691},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3844":1714,"_33198":1662,"_22654":59693,"_5":15607,"_29907":59569,"_3297":59694},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3844":1715,"_33198":1715,"_5":16006,"_3297":59696,"_33604":59697,"_22654":59698,"_29907":1715},"Lamassu IoT Platform",[54402,55870],[],{"_3844":1716,"_33198":1715,"_22654":59700,"_5":15607,"_29907":1715,"_3297":59701},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3844":1717,"_33198":1715,"_5":33601,"_22654":59703,"_29907":59704,"_3297":59184},[],"/docs/pr-preview/pr-58/platform/overview#start-here",{"_3844":1718,"_33198":1715,"_5":33601,"_22654":59706,"_29907":59707,"_3297":59708},[],"/docs/pr-preview/pr-58/platform/overview#choose-your-path","Choose your path",{"_3844":1719,"_33198":1715,"_5":33601,"_22654":59710,"_29907":59711,"_3297":59712},[],"/docs/pr-preview/pr-58/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3844":1720,"_33198":1715,"_5":33601,"_22654":59714,"_29907":59715,"_3297":59716},[],"/docs/pr-preview/pr-58/platform/overview#core-capabilities","Core capabilities",{"_3844":1721,"_33198":1715,"_5":33601,"_22654":59718,"_29907":59719,"_3297":59720},[],"/docs/pr-preview/pr-58/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3844":1722,"_33198":1715,"_5":33601,"_22654":59722,"_29907":59723,"_3297":59724},[],"/docs/pr-preview/pr-58/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3844":1723,"_33198":1715,"_5":33601,"_22654":59726,"_29907":59727,"_3297":59728},[],"/docs/pr-preview/pr-58/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3844":1724,"_33198":1715,"_5":33601,"_22654":59730,"_29907":59731,"_3297":59732},[],"/docs/pr-preview/pr-58/platform/overview#automate-device-identities","Automate device identities",{"_3844":1725,"_33198":1715,"_5":33601,"_22654":59734,"_29907":59735,"_3297":59736},[],"/docs/pr-preview/pr-58/platform/overview#publish-validation-status","Publish validation status",{"_3844":1726,"_33198":1715,"_5":33601,"_22654":59738,"_29907":59739,"_3297":59740},[],"/docs/pr-preview/pr-58/platform/overview#react-to-events","React to events",{"_3844":1727,"_33198":1715,"_5":33601,"_22654":59742,"_29907":59743,"_3297":59744},[],"/docs/pr-preview/pr-58/platform/overview#operational-reference","Operational reference",{"_3844":1728,"_33198":1715,"_22654":59746,"_5":15607,"_29907":1715,"_3297":59747},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3844":1729,"_33198":1715,"_22654":59749,"_5":15607,"_29907":59704,"_3297":59750},[],"Choose the result you need:",{"_3844":1730,"_33198":1715,"_22654":59752,"_5":15607,"_29907":59704,"_3297":59753},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3844":1731,"_33198":1715,"_22654":59755,"_5":15607,"_29907":59704,"_3297":59756},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3844":1732,"_33198":1715,"_22654":59758,"_5":15607,"_29907":59704,"_3297":59759},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3844":1733,"_33198":1715,"_22654":59761,"_5":15607,"_29907":59707,"_3297":59762},[],"Section",{"_3844":1734,"_33198":1715,"_22654":59764,"_5":15607,"_29907":59707,"_3297":59765},[],"What you manage",{"_3844":1735,"_33198":1715,"_22654":59767,"_5":15607,"_29907":59707,"_3297":59768},[],"Entry point",{"_3844":1736,"_33198":1715,"_22654":59770,"_5":15607,"_29907":59707,"_3297":59771},[],"**PKI**",{"_3844":1737,"_33198":1715,"_22654":59773,"_5":15607,"_29907":59707,"_3297":59774},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3844":1738,"_33198":1715,"_22654":59776,"_5":15607,"_29907":59707,"_3297":59777},[],"PKI overview",{"_3844":1739,"_33198":1715,"_22654":59779,"_5":15607,"_29907":59707,"_3297":59780},[],"**IoT Fleets**",{"_3844":1740,"_33198":1715,"_22654":59782,"_5":15607,"_29907":59707,"_3297":59783},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3844":1741,"_33198":1715,"_22654":59785,"_5":15607,"_29907":59707,"_3297":59786},[],"IoT Fleets overview",{"_3844":1742,"_33198":1715,"_22654":59788,"_5":15607,"_29907":59707,"_3297":59789},[],"**Administration**",{"_3844":1743,"_33198":1715,"_22654":59791,"_5":15607,"_29907":59707,"_3297":59792},[],"Operator permissions, audit and event subscriptions.",{"_3844":1744,"_33198":1715,"_22654":59794,"_5":15607,"_29907":59707,"_3297":55868},[],{"_3844":1745,"_33198":1715,"_22654":59796,"_5":15607,"_29907":59707,"_3297":59797},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3844":1746,"_33198":1715,"_22654":59799,"_5":15607,"_29907":59711,"_3297":59800},[],"An identity's journey connects four responsibilities:",{"_3844":1747,"_33198":1715,"_22654":59802,"_5":15607,"_29907":59711,"_3297":59803},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3844":1748,"_33198":1715,"_22654":59805,"_5":15607,"_29907":59711,"_3297":59806},[],"The provisioning administrator configures the DMS and initial trust.",{"_3844":1749,"_33198":1715,"_22654":59808,"_5":15607,"_29907":59711,"_3297":59809},[],"The device client requests a certificate and installs it with the matching key.",{"_3844":1750,"_33198":1715,"_22654":59811,"_5":15607,"_29907":59711,"_3297":59812},[],"The consumer validates the identity and applies its access permissions.",{"_3844":1751,"_33198":1715,"_22654":59814,"_5":15607,"_29907":59711,"_3297":59815},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3844":1752,"_33198":1715,"_22654":59817,"_5":15607,"_29907":59719,"_3297":59818},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3844":1753,"_33198":1715,"_22654":59820,"_5":15607,"_29907":59723,"_3297":59821},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3844":1754,"_33198":1715,"_22654":59823,"_5":15607,"_29907":59727,"_3297":59824},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3844":1755,"_33198":1715,"_22654":59826,"_5":15607,"_29907":59731,"_3297":59827},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3844":1756,"_33198":1715,"_22654":59829,"_5":15607,"_29907":59735,"_3297":59830},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3844":1757,"_33198":1715,"_22654":59832,"_5":15607,"_29907":59739,"_3297":59833},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3844":1758,"_33198":1715,"_22654":59835,"_5":15607,"_29907":59743,"_3297":59278},[],{"_3844":1759,"_33198":1715,"_22654":59837,"_5":15607,"_29907":59743,"_3297":59838},[],"What it prepares or checks",{"_3844":1760,"_33198":1715,"_22654":59840,"_5":15607,"_29907":59743,"_3297":59281},[],{"_3844":1761,"_33198":1715,"_22654":59842,"_5":15607,"_29907":59743,"_3297":59843},[],"Key custody, CA hierarchy, profiles and validation.",{"_3844":1762,"_33198":1715,"_22654":59845,"_5":15607,"_29907":59743,"_3297":59846},[],"Fleet administrator",{"_3844":1763,"_33198":1715,"_22654":59848,"_5":15607,"_29907":59743,"_3297":59849},[],"DMS, device admission, renewal policy and inventory.",{"_3844":1764,"_33198":1715,"_22654":59851,"_5":15607,"_29907":59743,"_3297":59293},[],{"_3844":1765,"_33198":1715,"_22654":59853,"_5":15607,"_29907":59743,"_3297":59854},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3844":1766,"_33198":1715,"_22654":59856,"_5":15607,"_29907":59743,"_3297":59299},[],{"_3844":1767,"_33198":1715,"_22654":59858,"_5":15607,"_29907":59743,"_3297":59859},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3844":1768,"_33198":1715,"_22654":59861,"_5":15607,"_29907":59743,"_3297":59862},[],"Infrastructure operator",{"_3844":1769,"_33198":1715,"_22654":59864,"_5":15607,"_29907":59743,"_3297":59865},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3844":1770,"_33198":1715,"_22654":59867,"_5":15607,"_29907":59743,"_3297":59868},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3844":1771,"_33198":1771,"_5":16006,"_3297":59870,"_33604":59871,"_22654":59874,"_29907":1771},"CA hierarchy and rotation",[54402,55870,59872,59873],"PKI","Keys, authorities and certificates",[],{"_3844":1772,"_33198":1771,"_22654":59876,"_5":15607,"_29907":1771,"_3297":59877},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3844":1773,"_33198":1771,"_5":33601,"_22654":59879,"_29907":59880,"_3297":59881},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3844":1774,"_33198":1771,"_5":33601,"_22654":59883,"_29907":59884,"_3297":59885},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3844":1775,"_33198":1771,"_5":33601,"_22654":59887,"_29907":59888,"_3297":59889},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3844":1776,"_33198":1771,"_5":33601,"_22654":59891,"_29907":59892,"_3297":59893},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3844":1777,"_33198":1771,"_5":33601,"_22654":59895,"_29907":59896,"_3297":59897},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3844":1778,"_33198":1771,"_5":33601,"_22654":59899,"_29907":59900,"_3297":59901},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3844":1779,"_33198":1771,"_5":33601,"_22654":59903,"_29907":59904,"_3297":59905},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3844":1780,"_33198":1771,"_5":33601,"_22654":59907,"_29907":59908,"_3297":59909},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3844":1781,"_33198":1771,"_5":33601,"_22654":59911,"_29907":59912,"_3297":59913},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3844":1782,"_33198":1771,"_5":33601,"_22654":59915,"_29907":59916,"_3297":59917},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3844":1783,"_33198":1771,"_5":33601,"_22654":59919,"_29907":59920,"_3297":59921},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3844":1784,"_33198":1771,"_5":33601,"_22654":59923,"_29907":59924,"_3297":59925},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3844":1785,"_33198":1771,"_22654":59927,"_5":15607,"_29907":1771,"_3297":59928},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3844":1786,"_33198":1771,"_22654":59930,"_5":15607,"_29907":1771,"_3297":59931},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3844":1787,"_33198":1771,"_22654":59933,"_5":15607,"_29907":59880,"_3297":59934},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3844":1788,"_33198":1771,"_22654":59936,"_5":15607,"_29907":59880,"_3297":59937},[],"environment, such as production and preproduction;",{"_3844":1789,"_33198":1771,"_22654":59939,"_5":15607,"_29907":59880,"_3297":59940},[],"owner or operating team;",{"_3844":1790,"_33198":1771,"_22654":59942,"_5":15607,"_29907":59880,"_3297":59943},[],"device family or manufacturing process;",{"_3844":1791,"_33198":1771,"_22654":59945,"_5":15607,"_29907":59880,"_3297":59946},[],"region or regulatory requirement;",{"_3844":1792,"_33198":1771,"_22654":59948,"_5":15607,"_29907":59880,"_3297":59949},[],"cryptographic engine or key policy;",{"_3844":1793,"_33198":1771,"_22654":59951,"_5":15607,"_29907":59880,"_3297":59952},[],"maintenance window and renewal cadence.",{"_3844":1794,"_33198":1771,"_22654":59954,"_5":15607,"_29907":59880,"_3297":59955},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3844":1795,"_33198":1771,"_22654":59957,"_5":15607,"_29907":59880,"_3297":59958},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3844":1796,"_33198":1771,"_22654":59960,"_5":15607,"_29907":59884,"_3297":59961},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3844":1797,"_33198":1771,"_22654":59963,"_5":15607,"_29907":59884,"_3297":59964},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3844":1798,"_33198":1771,"_22654":59966,"_5":15607,"_29907":59884,"_3297":59967},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3844":1799,"_33198":1771,"_22654":59969,"_5":15607,"_29907":59888,"_3297":59970},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3844":1800,"_33198":1771,"_22654":59972,"_5":15607,"_29907":59888,"_3297":59973},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3844":1801,"_33198":1771,"_22654":59975,"_5":15607,"_29907":59888,"_3297":59976},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3844":1802,"_33198":1771,"_22654":59978,"_5":15607,"_29907":59888,"_3297":59979},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3844":1803,"_33198":1771,"_22654":59981,"_5":15607,"_29907":59896,"_3297":59982},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3844":1804,"_33198":1771,"_22654":59984,"_5":15607,"_29907":59900,"_3297":59985},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3844":1805,"_33198":1771,"_22654":59987,"_5":15607,"_29907":59904,"_3297":59988},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3844":1806,"_33198":1771,"_22654":59990,"_5":15607,"_29907":59908,"_3297":59991},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3844":1807,"_33198":1771,"_22654":59993,"_5":15607,"_29907":59912,"_3297":59994},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3844":1808,"_33198":1771,"_22654":59996,"_5":15607,"_29907":59916,"_3297":59997},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3844":1809,"_33198":1771,"_22654":59999,"_5":15607,"_29907":59920,"_3297":60000},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3844":1810,"_33198":1771,"_22654":60002,"_5":15607,"_29907":59920,"_3297":60003},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3844":1811,"_33198":1771,"_22654":60005,"_5":15607,"_29907":59920,"_3297":60006},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3844":1812,"_33198":1771,"_22654":60008,"_5":15607,"_29907":59920,"_3297":60009},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3844":1813,"_33198":1771,"_22654":60011,"_5":15607,"_29907":59924,"_3297":60012},[],"The new chain ends in an anchor installed by the consumer.",{"_3844":1814,"_33198":1771,"_22654":60014,"_5":15607,"_29907":59924,"_3297":60015},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3844":1815,"_33198":1771,"_22654":60017,"_5":15607,"_29907":59924,"_3297":60018},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3844":1816,"_33198":1771,"_22654":60020,"_5":15607,"_29907":59924,"_3297":60021},[],"Re-enrollment accepts the old identity during the planned period.",{"_3844":1817,"_33198":1771,"_22654":60023,"_5":15607,"_29907":59924,"_3297":60024},[],"OCSP and CRL respond for the authorities that remain active.",{"_3844":1818,"_33198":1771,"_22654":60026,"_5":15607,"_29907":59924,"_3297":60027},[],"No DMS is left accidentally issuing from the old CA.",{"_3844":1819,"_33198":1771,"_22654":60029,"_5":15607,"_29907":59924,"_3297":60030},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3844":1820,"_33198":1820,"_5":16006,"_3297":60032,"_33604":60033,"_22654":60034,"_29907":1820},"Certification authorities",[54402,55870,59872,59873],[],{"_3844":1821,"_33198":1820,"_22654":60036,"_5":15607,"_29907":1820,"_3297":60037},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3844":1822,"_33198":1820,"_5":33601,"_22654":60039,"_29907":60040,"_3297":60041},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3844":1823,"_33198":1820,"_5":33601,"_22654":60043,"_29907":60044,"_3297":60045},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3844":1824,"_33198":1820,"_5":33601,"_22654":60047,"_29907":60048,"_3297":54412},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#before-you-begin",{"_3844":1825,"_33198":1820,"_5":33601,"_22654":60050,"_29907":60051,"_3297":60052},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3844":1826,"_33198":1820,"_5":33601,"_22654":60054,"_29907":60055,"_3297":60056},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3844":1827,"_33198":1820,"_5":33601,"_22654":60058,"_29907":60059,"_3297":60060},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3844":1828,"_33198":1820,"_5":33601,"_22654":60062,"_29907":60063,"_3297":60064},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3844":1829,"_33198":1820,"_5":33601,"_22654":60066,"_29907":60067,"_3297":60068},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3844":1830,"_33198":1820,"_5":33601,"_22654":60070,"_29907":60071,"_3297":60072},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3844":1831,"_33198":1820,"_5":33601,"_22654":60074,"_29907":60075,"_3297":60076},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3844":1832,"_33198":1820,"_5":33601,"_22654":60078,"_29907":60079,"_3297":60080},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3844":1833,"_33198":1820,"_5":33601,"_22654":60082,"_29907":60083,"_3297":60084},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3844":1834,"_33198":1820,"_5":33601,"_22654":60086,"_29907":60087,"_3297":60088},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3844":1835,"_33198":1820,"_5":33601,"_22654":60090,"_29907":60091,"_3297":60092},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3844":1836,"_33198":1820,"_5":33601,"_22654":60094,"_29907":60095,"_3297":60096},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3844":1837,"_33198":1820,"_5":33601,"_22654":60098,"_29907":60099,"_3297":60100},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3844":1838,"_33198":1820,"_5":33601,"_22654":60102,"_29907":60103,"_3297":60104},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3844":1839,"_33198":1820,"_5":33601,"_22654":60106,"_29907":60107,"_3297":60108},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3844":1840,"_33198":1820,"_5":33601,"_22654":60110,"_29907":60111,"_3297":60112},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3844":1841,"_33198":1820,"_5":33601,"_22654":60114,"_29907":60115,"_3297":60116},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3844":1842,"_33198":1820,"_5":33601,"_22654":60118,"_29907":60119,"_3297":60120},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3844":1843,"_33198":1820,"_5":33601,"_22654":60122,"_29907":60123,"_3297":60124},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3844":1844,"_33198":1820,"_5":33601,"_22654":60126,"_29907":60127,"_3297":60128},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3844":1845,"_33198":1820,"_22654":60130,"_5":15607,"_29907":1820,"_3297":60131},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3844":1846,"_33198":1820,"_22654":60133,"_5":15607,"_29907":1820,"_3297":60134},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3844":1847,"_33198":1820,"_22654":60136,"_5":15607,"_29907":1820,"_3297":60137},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3844":1848,"_33198":1820,"_22654":60139,"_5":15607,"_29907":60040,"_3297":60140},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3844":1849,"_33198":1820,"_22654":60142,"_5":15607,"_29907":60040,"_3297":60143},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3844":1850,"_33198":1820,"_22654":60145,"_5":15607,"_29907":60040,"_3297":60146},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3844":1851,"_33198":1820,"_22654":60148,"_5":15607,"_29907":60040,"_3297":60149},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3844":1852,"_33198":1820,"_22654":60151,"_5":15607,"_29907":60040,"_3297":60152},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3844":1853,"_33198":1820,"_22654":60154,"_5":15607,"_29907":60048,"_3297":60155},[],"Decide whether the CA will be a root or an intermediate.",{"_3844":1854,"_33198":1820,"_22654":60157,"_5":15607,"_29907":60048,"_3297":60158},[],"Choose the engine that will keep the key.",{"_3844":1855,"_33198":1820,"_22654":60160,"_5":15607,"_29907":60048,"_3297":60161},[],"Define a validity longer than that of the certificates it will issue.",{"_3844":1856,"_33198":1820,"_22654":60163,"_5":15607,"_29907":60048,"_3297":60164},[],"For an intermediate CA, make sure the parent CA is active.",{"_3844":1857,"_33198":1820,"_22654":60166,"_5":15607,"_29907":60051,"_3297":60167},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3844":1858,"_33198":1820,"_22654":60169,"_5":15607,"_29907":60055,"_3297":60170},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3844":1859,"_33198":1820,"_22654":60172,"_5":15607,"_29907":60055,"_3297":60173},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3844":1860,"_33198":1820,"_22654":60175,"_5":15607,"_29907":60059,"_3297":60176},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3844":1861,"_33198":1820,"_22654":60178,"_5":15607,"_29907":60063,"_3297":60179},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3844":1862,"_33198":1820,"_22654":60181,"_5":15607,"_29907":60063,"_3297":60182},[],"`C`: two-letter ISO 3166-1 country code.",{"_3844":1863,"_33198":1820,"_22654":60184,"_5":15607,"_29907":60063,"_3297":60185},[],"`ST`: state or province.",{"_3844":1864,"_33198":1820,"_22654":60187,"_5":15607,"_29907":60063,"_3297":60188},[],"`L`: locality.",{"_3844":1865,"_33198":1820,"_22654":60190,"_5":15607,"_29907":60063,"_3297":60191},[],"`O`: organization.",{"_3844":1866,"_33198":1820,"_22654":60193,"_5":15607,"_29907":60063,"_3297":60194},[],"`OU`: organizational unit.",{"_3844":1867,"_33198":1820,"_22654":60196,"_5":15607,"_29907":60063,"_3297":60197},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3844":1868,"_33198":1820,"_22654":60199,"_5":15607,"_29907":60067,"_3297":60200},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3844":1869,"_33198":1820,"_22654":60202,"_5":15607,"_29907":60067,"_3297":60203},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3844":1870,"_33198":1820,"_22654":60205,"_5":15607,"_29907":60071,"_3297":60206},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3844":1871,"_33198":1820,"_22654":60208,"_5":15607,"_29907":60071,"_3297":60209},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3844":1872,"_33198":1820,"_22654":60211,"_5":15607,"_29907":60075,"_3297":60212},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3844":1873,"_33198":1820,"_22654":60214,"_5":15607,"_29907":60075,"_3297":60215},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3844":1874,"_33198":1820,"_22654":60217,"_5":15607,"_29907":60079,"_3297":60218},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3844":1875,"_33198":1820,"_22654":60220,"_5":15607,"_29907":60079,"_3297":60221},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3844":1876,"_33198":1820,"_22654":60223,"_5":15607,"_29907":60079,"_3297":60224},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3844":1877,"_33198":1820,"_22654":60226,"_5":15607,"_29907":60083,"_3297":60227},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3844":1878,"_33198":1820,"_22654":60229,"_5":15607,"_29907":60087,"_3297":60230},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3844":1879,"_33198":1820,"_22654":60232,"_5":15607,"_29907":60091,"_3297":60233},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3844":1880,"_33198":1820,"_22654":60235,"_5":15607,"_29907":60095,"_3297":60236},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3844":1881,"_33198":1820,"_22654":60238,"_5":15607,"_29907":60095,"_3297":60239},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3844":1882,"_33198":1820,"_22654":60241,"_5":15607,"_29907":60099,"_3297":60242},[],"Open a CA from the inventory to review:",{"_3844":1883,"_33198":1820,"_22654":60244,"_5":15607,"_29907":60099,"_3297":60245},[],"Status and validity period.",{"_3844":1884,"_33198":1820,"_22654":60247,"_5":15607,"_29907":60099,"_3297":60248},[],"Certificate and chain in PEM format.",{"_3844":1885,"_33198":1820,"_22654":60250,"_5":15607,"_29907":60099,"_3297":60251},[],"Number of active, expired and revoked certificates.",{"_3844":1886,"_33198":1820,"_22654":60253,"_5":15607,"_29907":60099,"_3297":60254},[],"Certificates issued in **Issued Certificates**.",{"_3844":1887,"_33198":1820,"_22654":60256,"_5":15607,"_29907":60099,"_3297":60257},[],"The CRL linked to the authority.",{"_3844":1888,"_33198":1820,"_22654":60259,"_5":15607,"_29907":60099,"_3297":60260},[],"Metadata and the associated cryptographic engine.",{"_3844":1889,"_33198":1820,"_22654":60262,"_5":15607,"_29907":60099,"_3297":60263},[],"You can filter the inventory by name, status and CA type.",{"_3844":1890,"_33198":1820,"_22654":60265,"_5":15607,"_29907":60103,"_3297":60266},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3844":1891,"_33198":1820,"_22654":60268,"_5":15607,"_29907":60103,"_3297":60269},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3844":1892,"_33198":1820,"_22654":60271,"_5":15607,"_29907":60103,"_3297":60272},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3844":1893,"_33198":1820,"_22654":60274,"_5":15607,"_29907":60103,"_3297":60275},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3844":1894,"_33198":1820,"_22654":60277,"_5":15607,"_29907":60107,"_3297":60278},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3844":1895,"_33198":1820,"_22654":60280,"_5":15607,"_29907":60111,"_3297":60281},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3844":1896,"_33198":1820,"_22654":60283,"_5":15607,"_29907":60115,"_3297":60284},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3844":1897,"_33198":1820,"_22654":60286,"_5":15607,"_29907":60119,"_3297":60287},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3844":1898,"_33198":1820,"_22654":60289,"_5":15607,"_29907":60123,"_3297":60290},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3844":1899,"_33198":1820,"_22654":60292,"_5":15607,"_29907":60127,"_3297":60293},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3844":1900,"_33198":1820,"_22654":60295,"_5":15607,"_29907":60127,"_3297":60296},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3844":1901,"_33198":1820,"_22654":60298,"_5":15607,"_29907":60127,"_3297":60299},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3844":1902,"_33198":1902,"_5":16006,"_3297":60301,"_33604":60302,"_22654":60303,"_29907":1902},"Certificate profiles",[54402,55870,59872,59873],[],{"_3844":1903,"_33198":1902,"_22654":60305,"_5":15607,"_29907":1902,"_3297":60306},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3844":1904,"_33198":1902,"_5":33601,"_22654":60308,"_29907":60309,"_3297":60310},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3844":1905,"_33198":1902,"_5":33601,"_22654":60312,"_29907":60313,"_3297":60314},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#validity","Validity",{"_3844":1906,"_33198":1902,"_5":33601,"_22654":60316,"_29907":60317,"_3297":60318},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3844":1907,"_33198":1902,"_5":33601,"_22654":60320,"_29907":60321,"_3297":60322},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3844":1908,"_33198":1902,"_5":33601,"_22654":60324,"_29907":60325,"_3297":60326},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#subject","Subject",{"_3844":1909,"_33198":1902,"_5":33601,"_22654":60328,"_29907":60329,"_3297":60330},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3844":1910,"_33198":1902,"_5":33601,"_22654":60332,"_29907":60333,"_3297":60334},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3844":1911,"_33198":1902,"_5":33601,"_22654":60336,"_29907":60337,"_3297":60338},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3844":1912,"_33198":1902,"_5":33601,"_22654":60340,"_29907":60341,"_3297":60342},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3844":1913,"_33198":1902,"_5":33601,"_22654":60344,"_29907":60345,"_3297":60346},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3844":1914,"_33198":1902,"_5":33601,"_22654":60348,"_29907":60349,"_3297":60350},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3844":1915,"_33198":1902,"_5":33601,"_22654":60352,"_29907":60353,"_3297":60354},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3844":1916,"_33198":1902,"_5":33601,"_22654":60356,"_29907":60357,"_3297":60358},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3844":1917,"_33198":1902,"_5":33601,"_22654":60360,"_29907":60361,"_3297":60362},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3844":1918,"_33198":1902,"_5":33601,"_22654":60364,"_29907":60365,"_3297":60366},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#design-examples","Design examples",{"_3844":1919,"_33198":1902,"_5":33601,"_22654":60368,"_29907":60369,"_3297":60370},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3844":1920,"_33198":1902,"_22654":60372,"_5":15607,"_29907":1902,"_3297":60373},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3844":1921,"_33198":1902,"_22654":60375,"_5":15607,"_29907":1902,"_3297":60376},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3844":1922,"_33198":1902,"_22654":60378,"_5":15607,"_29907":60313,"_3297":60379},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3844":1923,"_33198":1902,"_22654":60381,"_5":15607,"_29907":60313,"_3297":60382},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3844":1924,"_33198":1902,"_22654":60384,"_5":15607,"_29907":60317,"_3297":60385},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3844":1925,"_33198":1902,"_22654":60387,"_5":15607,"_29907":60321,"_3297":60388},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3844":1926,"_33198":1902,"_22654":60390,"_5":15607,"_29907":60321,"_3297":60391},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3844":1927,"_33198":1902,"_22654":60393,"_5":15607,"_29907":60321,"_3297":60394},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3844":1928,"_33198":1902,"_22654":60396,"_5":15607,"_29907":60325,"_3297":60397},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3844":1929,"_33198":1902,"_22654":60399,"_5":15607,"_29907":60329,"_3297":60400},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3844":1930,"_33198":1902,"_22654":60402,"_5":15607,"_29907":60329,"_3297":60403},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3844":1931,"_33198":1902,"_22654":60405,"_5":15607,"_29907":60333,"_3297":60406},[],"The cryptographic enforcement can:",{"_3844":1932,"_33198":1902,"_22654":60408,"_5":15607,"_29907":60333,"_3297":60409},[],"allow or block RSA keys;",{"_3844":1933,"_33198":1902,"_22654":60411,"_5":15607,"_29907":60333,"_3297":60412},[],"limit the supported RSA sizes;",{"_3844":1934,"_33198":1902,"_22654":60414,"_5":15607,"_29907":60333,"_3297":60415},[],"allow or block ECDSA keys;",{"_3844":1935,"_33198":1902,"_22654":60417,"_5":15607,"_29907":60333,"_3297":60418},[],"limit the supported ECDSA sizes or curves.",{"_3844":1936,"_33198":1902,"_22654":60420,"_5":15607,"_29907":60333,"_3297":60421},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3844":1937,"_33198":1902,"_22654":60423,"_5":15607,"_29907":60337,"_3297":60424},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3844":1938,"_33198":1902,"_22654":60426,"_5":15607,"_29907":60337,"_3297":57634},[],{"_3844":1939,"_33198":1902,"_22654":60428,"_5":15607,"_29907":60337,"_3297":60429},[],"First choice",{"_3844":1940,"_33198":1902,"_22654":60431,"_5":15607,"_29907":60337,"_3297":60432},[],"Second choice",{"_3844":1941,"_33198":1902,"_22654":60434,"_5":15607,"_29907":60337,"_3297":60435},[],"If neither is supplied",{"_3844":1942,"_33198":1902,"_22654":60437,"_5":15607,"_29907":60337,"_3297":60438},[],"Direct signing with a CA",{"_3844":1943,"_33198":1902,"_22654":60440,"_5":15607,"_29907":60337,"_3297":60441},[],"`issuance_profile` embedded in the request",{"_3844":1944,"_33198":1902,"_22654":60443,"_5":15607,"_29907":60337,"_3297":60444},[],"Request `issuance_profile_id`",{"_3844":1945,"_33198":1902,"_22654":60446,"_5":15607,"_29907":60337,"_3297":60447},[],"CA default profile (`profile_id`).",{"_3844":1946,"_33198":1902,"_22654":60449,"_5":15607,"_29907":60337,"_3297":60450},[],"Issuance through a DMS",{"_3844":1947,"_33198":1902,"_22654":60452,"_5":15607,"_29907":60337,"_3297":60453},[],"`settings.issuance_profile_id`",{"_3844":1948,"_33198":1902,"_22654":60455,"_5":15607,"_29907":60337,"_3297":60456},[],"`settings.issuance_profile` embedded in the DMS",{"_3844":1949,"_33198":1902,"_22654":60458,"_5":15607,"_29907":60337,"_3297":60459},[],"Enrollment CA default profile.",{"_3844":1950,"_33198":1902,"_22654":60461,"_5":15607,"_29907":60337,"_3297":60462},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3844":1951,"_33198":1902,"_22654":60464,"_5":15607,"_29907":60337,"_3297":60465},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3844":1952,"_33198":1902,"_22654":60467,"_5":15607,"_29907":60345,"_3297":60468},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3844":1953,"_33198":1902,"_22654":60470,"_5":15607,"_29907":60349,"_3297":60471},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3844":1954,"_33198":1902,"_22654":60473,"_5":15607,"_29907":60353,"_3297":60474},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3844":1955,"_33198":1902,"_22654":60476,"_5":15607,"_29907":60357,"_3297":60477},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3844":1956,"_33198":1902,"_22654":60479,"_5":15607,"_29907":60361,"_3297":60480},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3844":1957,"_33198":1902,"_22654":60482,"_5":15607,"_29907":60361,"_3297":60483},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3844":1958,"_33198":1902,"_22654":60485,"_5":15607,"_29907":60365,"_3297":60486},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3844":1959,"_33198":1902,"_22654":60488,"_5":15607,"_29907":60365,"_3297":60489},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3844":1960,"_33198":1902,"_22654":60491,"_5":15607,"_29907":60365,"_3297":60492},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3844":1961,"_33198":1902,"_22654":60494,"_5":15607,"_29907":60365,"_3297":60495},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3844":1962,"_33198":1902,"_22654":60497,"_5":15607,"_29907":60369,"_3297":60498},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3844":1963,"_33198":1902,"_22654":60500,"_5":15607,"_29907":60369,"_3297":60501},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3844":1964,"_33198":1964,"_5":16006,"_3297":60503,"_33604":60504,"_22654":60506,"_29907":1964},"Certificate validation",[54402,55870,59872,60505],"Validation",[],{"_3844":1965,"_33198":1964,"_22654":60508,"_5":15607,"_29907":1964,"_3297":60509},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3844":1966,"_33198":1964,"_5":33601,"_22654":60511,"_29907":60512,"_3297":60513},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3844":1967,"_33198":1964,"_5":33601,"_22654":60515,"_29907":60516,"_3297":60517},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3844":1968,"_33198":1964,"_5":33601,"_22654":60519,"_29907":60520,"_3297":60521},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3844":1969,"_33198":1964,"_22654":60523,"_5":15607,"_29907":1964,"_3297":60524},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3844":1970,"_33198":1964,"_22654":60526,"_5":15607,"_29907":60512,"_3297":60527},[],"Verify these criteria together:",{"_3844":1971,"_33198":1964,"_22654":60529,"_5":15607,"_29907":60512,"_3297":59498},[],{"_3844":1972,"_33198":1964,"_22654":60531,"_5":15607,"_29907":60512,"_3297":60532},[],"Required result",{"_3844":1973,"_33198":1964,"_22654":60534,"_5":15607,"_29907":60512,"_3297":60535},[],"Chain and signature",{"_3844":1974,"_33198":1964,"_22654":60537,"_5":15607,"_29907":60512,"_3297":60538},[],"Valid chain to a root deliberately installed in the consumer.",{"_3844":1975,"_33198":1964,"_22654":60540,"_5":15607,"_29907":60512,"_3297":60541},[],"Dates",{"_3844":1976,"_33198":1964,"_22654":60543,"_5":15607,"_29907":60512,"_3297":60544},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3844":1977,"_33198":1964,"_22654":60546,"_5":15607,"_29907":60512,"_3297":55539},[],{"_3844":1978,"_33198":1964,"_22654":60548,"_5":15607,"_29907":60512,"_3297":60549},[],"Name, SAN or identifier matches the expected peer.",{"_3844":1979,"_33198":1964,"_22654":60551,"_5":15607,"_29907":60512,"_3297":54792},[],{"_3844":1980,"_33198":1964,"_22654":60553,"_5":15607,"_29907":60512,"_3297":60554},[],"KU, EKU and constraints permit the specific operation.",{"_3844":1981,"_33198":1964,"_22654":60556,"_5":15607,"_29907":60512,"_3297":60557},[],"Revocation",{"_3844":1982,"_33198":1964,"_22654":60559,"_5":15607,"_29907":60512,"_3297":60560},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3844":1983,"_33198":1964,"_22654":60562,"_5":15607,"_29907":60512,"_3297":60563},[],"Authorization",{"_3844":1984,"_33198":1964,"_22654":60565,"_5":15607,"_29907":60512,"_3297":60566},[],"The application permits that identity to perform the action.",{"_3844":1985,"_33198":1964,"_22654":60568,"_5":15607,"_29907":60512,"_3297":60569},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3844":1986,"_33198":1964,"_22654":60571,"_5":15607,"_29907":60516,"_3297":60572},[],"Mechanism",{"_3844":1987,"_33198":1964,"_22654":60574,"_5":15607,"_29907":60516,"_3297":60575},[],"When to use it",{"_3844":1988,"_33198":1964,"_22654":60577,"_5":15607,"_29907":60516,"_3297":60578},[],"What you must maintain",{"_3844":1989,"_33198":1964,"_22654":60580,"_5":15607,"_29907":60516,"_3297":60581},[],"OCSP",{"_3844":1990,"_33198":1964,"_22654":60583,"_5":15607,"_29907":60516,"_3297":60584},[],"Status query for a specific certificate.",{"_3844":1991,"_33198":1964,"_22654":60586,"_5":15607,"_29907":60516,"_3297":60587},[],"Responder access, signature verification and cache/freshness policy.",{"_3844":1992,"_33198":1964,"_22654":60589,"_5":15607,"_29907":60516,"_3297":60590},[],"CRL",{"_3844":1993,"_33198":1964,"_22654":60592,"_5":15607,"_29907":60516,"_3297":60593},[],"Local checks for many certificates or offline operation.",{"_3844":1994,"_33198":1964,"_22654":60595,"_5":15607,"_29907":60516,"_3297":60596},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3844":1995,"_33198":1964,"_22654":60598,"_5":15607,"_29907":60516,"_3297":60599},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3844":1996,"_33198":1964,"_22654":60601,"_5":15607,"_29907":60516,"_3297":60602},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3844":1997,"_33198":1964,"_22654":60604,"_5":15607,"_29907":60520,"_3297":60605},[],"Accept a current, authorized certificate with a known chain.",{"_3844":1998,"_33198":1964,"_22654":60607,"_5":15607,"_29907":60520,"_3297":60608},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3844":1999,"_33198":1964,"_22654":60610,"_5":15607,"_29907":60520,"_3297":60611},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3844":2000,"_33198":1964,"_22654":60613,"_5":15607,"_29907":60520,"_3297":60614},[],"Check that a new connection with that identity is rejected.",{"_3844":2001,"_33198":1964,"_22654":60616,"_5":15607,"_29907":60520,"_3297":60617},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3844":2002,"_33198":1964,"_22654":60619,"_5":15607,"_29907":60520,"_3297":60620},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3844":2003,"_33198":1964,"_22654":60622,"_5":15607,"_29907":60520,"_3297":60623},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3844":2004,"_33198":1964,"_22654":60625,"_5":15607,"_29907":60520,"_3297":60626},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3844":2005,"_33198":1964,"_22654":60628,"_5":15607,"_29907":60520,"_3297":60629},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3844":2006,"_33198":2006,"_5":16006,"_3297":60631,"_33604":60632,"_22654":60633,"_29907":2006},"Certificates",[54402,55870,59872,59873],[],{"_3844":2007,"_33198":2006,"_22654":60635,"_5":15607,"_29907":2006,"_3297":60636},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3844":2008,"_33198":2006,"_5":33601,"_22654":60638,"_29907":60639,"_3297":60640},[],"/docs/pr-preview/pr-58/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3844":2009,"_33198":2006,"_5":33601,"_22654":60642,"_29907":60643,"_3297":60644},[],"/docs/pr-preview/pr-58/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3844":2010,"_33198":2006,"_5":33601,"_22654":60646,"_29907":60647,"_3297":60648},[],"/docs/pr-preview/pr-58/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3844":2011,"_33198":2006,"_5":33601,"_22654":60650,"_29907":60651,"_3297":60652},[],"/docs/pr-preview/pr-58/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3844":2012,"_33198":2006,"_5":33601,"_22654":60654,"_29907":60655,"_3297":60656},[],"/docs/pr-preview/pr-58/platform/pki/certificates#open-the-action","Open the action",{"_3844":2013,"_33198":2006,"_5":33601,"_22654":60658,"_29907":60659,"_3297":60660},[],"/docs/pr-preview/pr-58/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3844":2014,"_33198":2006,"_5":33601,"_22654":60662,"_29907":60663,"_3297":60664},[],"/docs/pr-preview/pr-58/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3844":2015,"_33198":2006,"_5":33601,"_22654":60666,"_29907":60667,"_3297":60668},[],"/docs/pr-preview/pr-58/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3844":2016,"_33198":2006,"_5":33601,"_22654":60670,"_29907":60671,"_3297":60672},[],"/docs/pr-preview/pr-58/platform/pki/certificates#continue","Continue",{"_3844":2017,"_33198":2006,"_22654":60674,"_5":15607,"_29907":2006,"_3297":60675},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3844":2018,"_33198":2006,"_22654":60677,"_5":15607,"_29907":60639,"_3297":60678},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3844":2019,"_33198":2006,"_22654":60680,"_5":15607,"_29907":60639,"_3297":60681},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3844":2020,"_33198":2006,"_22654":60683,"_5":15607,"_29907":60639,"_3297":60684},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3844":2021,"_33198":2006,"_22654":60686,"_5":15607,"_29907":60639,"_3297":60687},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3844":2022,"_33198":2006,"_22654":60689,"_5":15607,"_29907":60639,"_3297":60690},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3844":2023,"_33198":2006,"_22654":60692,"_5":15607,"_29907":60639,"_3297":60693},[],"Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`); certificate lists can be filtered on `has_private_key`.",{"_3844":2024,"_33198":2006,"_22654":60695,"_5":15607,"_29907":60639,"_3297":60696},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3844":2025,"_33198":2006,"_22654":60698,"_5":15607,"_29907":60643,"_3297":60699},[],"Download the PEM and inspect it:",{"_3844":2026,"_33198":2006,"_22654":60701,"_5":15607,"_29907":60643,"_3297":60702},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3844":2027,"_33198":2006,"_22654":60704,"_5":15607,"_29907":60647,"_3297":60705},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3844":2028,"_33198":2006,"_22654":60707,"_5":15607,"_29907":60647,"_3297":60708},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3844":2029,"_33198":2006,"_22654":60710,"_5":15607,"_29907":60647,"_3297":60711},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3844":2030,"_33198":2006,"_22654":60713,"_5":15607,"_29907":60647,"_3297":60714},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3844":2031,"_33198":2006,"_22654":60716,"_5":15607,"_29907":60647,"_3297":60717},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3844":2032,"_33198":2006,"_22654":60719,"_5":15607,"_29907":60647,"_3297":60720},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3844":2033,"_33198":2006,"_22654":60722,"_5":15607,"_29907":60647,"_3297":60723},[],"For browser key generation, follow Issue your first certificate.",{"_3844":2034,"_33198":2006,"_22654":60725,"_5":15607,"_29907":60651,"_3297":60726},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3844":2035,"_33198":2006,"_22654":60728,"_5":15607,"_29907":60655,"_3297":60729},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3844":2036,"_33198":2006,"_22654":60731,"_5":15607,"_29907":60659,"_3297":60732},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3844":2037,"_33198":2006,"_22654":60734,"_5":15607,"_29907":60663,"_3297":60735},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3844":2038,"_33198":2006,"_22654":60737,"_5":15607,"_29907":60663,"_3297":60738},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3844":2039,"_33198":2006,"_22654":60740,"_5":15607,"_29907":60663,"_3297":60741},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3844":2040,"_33198":2006,"_22654":60743,"_5":15607,"_29907":60667,"_3297":60744},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3844":2041,"_33198":2006,"_22654":60746,"_5":15607,"_29907":60667,"_3297":60747},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3844":2042,"_33198":2006,"_22654":60749,"_5":15607,"_29907":60667,"_3297":60750},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3844":2043,"_33198":2006,"_22654":60752,"_5":15607,"_29907":60671,"_3297":60753},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3844":2044,"_33198":2006,"_22654":60755,"_5":15607,"_29907":60671,"_3297":60756},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3844":2045,"_33198":2045,"_5":16006,"_3297":60758,"_33604":60759,"_22654":60761,"_29907":2045},"Certificate lifecycle",[54402,55870,59872,60760],"Concepts",[],{"_3844":2046,"_33198":2045,"_22654":60763,"_5":15607,"_29907":2045,"_3297":60764},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3844":2047,"_33198":2045,"_5":33601,"_22654":60766,"_29907":60767,"_3297":60768},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3844":2048,"_33198":2045,"_5":33601,"_22654":60770,"_29907":60771,"_3297":60772},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3844":2049,"_33198":2045,"_5":33601,"_22654":60774,"_29907":60775,"_3297":60776},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3844":2050,"_33198":2045,"_5":33601,"_22654":60778,"_29907":60779,"_3297":60780},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3844":2051,"_33198":2045,"_5":33601,"_22654":60782,"_29907":60783,"_3297":60784},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3844":2052,"_33198":2045,"_5":33601,"_22654":60786,"_29907":60787,"_3297":60788},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3844":2053,"_33198":2045,"_5":33601,"_22654":60790,"_29907":60791,"_3297":60792},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3844":2054,"_33198":2045,"_5":33601,"_22654":60794,"_29907":60795,"_3297":60796},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3844":2055,"_33198":2045,"_5":33601,"_22654":60798,"_29907":60799,"_3297":60800},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3844":2056,"_33198":2045,"_5":33601,"_22654":60802,"_29907":60803,"_3297":60804},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3844":2057,"_33198":2045,"_22654":60806,"_5":15607,"_29907":2045,"_3297":60807},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3844":2058,"_33198":2045,"_22654":60809,"_5":15607,"_29907":60771,"_3297":60810},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3844":2059,"_33198":2045,"_22654":60812,"_5":15607,"_29907":60775,"_3297":60813},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3844":2060,"_33198":2045,"_22654":60815,"_5":15607,"_29907":60779,"_3297":60816},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3844":2061,"_33198":2045,"_22654":60818,"_5":15607,"_29907":60783,"_3297":60819},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3844":2062,"_33198":2045,"_22654":60821,"_5":15607,"_29907":60787,"_3297":60822},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3844":2063,"_33198":2045,"_22654":60824,"_5":15607,"_29907":60791,"_3297":60825},[],"Lamassu persists four X.509 states:",{"_3844":2064,"_33198":2045,"_22654":60827,"_5":15607,"_29907":60791,"_3297":60828},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3844":2065,"_33198":2045,"_22654":60830,"_5":15607,"_29907":60791,"_3297":60831},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3844":2066,"_33198":2045,"_22654":60833,"_5":15607,"_29907":60791,"_3297":60834},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3844":2067,"_33198":2045,"_22654":60836,"_5":15607,"_29907":60791,"_3297":60837},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3844":2068,"_33198":2045,"_22654":60839,"_5":15607,"_29907":60791,"_3297":60840},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3844":2069,"_33198":2045,"_22654":60842,"_5":15607,"_29907":60795,"_3297":60843},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3844":2070,"_33198":2045,"_22654":60845,"_5":15607,"_29907":60795,"_3297":60846},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3844":2071,"_33198":2045,"_22654":60848,"_5":15607,"_29907":60795,"_3297":60849},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3844":2072,"_33198":2045,"_22654":60851,"_5":15607,"_29907":60799,"_3297":60852},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3844":2073,"_33198":2045,"_22654":60854,"_5":15607,"_29907":60799,"_3297":60855},[],"Before confirming:",{"_3844":2074,"_33198":2045,"_22654":60857,"_5":15607,"_29907":60799,"_3297":60858},[],"Identify DMSs, devices and services that trust that chain.",{"_3844":2075,"_33198":2045,"_22654":60860,"_5":15607,"_29907":60799,"_3297":60861},[],"Distribute the new chain of trust.",{"_3844":2076,"_33198":2045,"_22654":60863,"_5":15607,"_29907":60799,"_3297":60864},[],"Reissue the necessary identities.",{"_3844":2077,"_33198":2045,"_22654":60866,"_5":15607,"_29907":60799,"_3297":60867},[],"Check OCSP and CRL from a real consumer.",{"_3844":2078,"_33198":2045,"_22654":60869,"_5":15607,"_29907":60799,"_3297":60870},[],"Revoke the old CA once no legitimate traffic remains.",{"_3844":2079,"_33198":2045,"_22654":60872,"_5":15607,"_29907":60799,"_3297":60873},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3844":2080,"_33198":2045,"_22654":60875,"_5":15607,"_29907":60803,"_3297":60876},[],"Certificates entering the preventive or critical renewal window.",{"_3844":2081,"_33198":2045,"_22654":60878,"_5":15607,"_29907":60803,"_3297":60879},[],"Repeated enrollment or re-enrollment failures.",{"_3844":2082,"_33198":2045,"_22654":60881,"_5":15607,"_29907":60803,"_3297":60882},[],"Status changes and revocation reasons.",{"_3844":2083,"_33198":2045,"_22654":60884,"_5":15607,"_29907":60803,"_3297":60885},[],"OCSP and CRL publication and validity.",{"_3844":2084,"_33198":2045,"_22654":60887,"_5":15607,"_29907":60803,"_3297":60888},[],"Dependencies still presenting a replaced certificate.",{"_3844":2085,"_33198":2045,"_22654":60890,"_5":15607,"_29907":60803,"_3297":60891},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3844":2086,"_33198":2086,"_5":16006,"_3297":60893,"_33604":60894,"_22654":60895,"_29907":2086},"Trust model",[54402,55870,59872,60760],[],{"_3844":2087,"_33198":2086,"_22654":60897,"_5":15607,"_29907":2086,"_3297":60898},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3844":2088,"_33198":2086,"_5":33601,"_22654":60900,"_29907":60901,"_3297":60902},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3844":2089,"_33198":2086,"_5":33601,"_22654":60904,"_29907":60905,"_3297":60906},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3844":2090,"_33198":2086,"_5":33601,"_22654":60908,"_29907":60909,"_3297":60910},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3844":2091,"_33198":2086,"_5":33601,"_22654":60912,"_29907":60913,"_3297":60914},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3844":2092,"_33198":2086,"_5":33601,"_22654":60916,"_29907":60917,"_3297":60918},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3844":2093,"_33198":2086,"_5":33601,"_22654":60920,"_29907":60921,"_3297":60922},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3844":2094,"_33198":2086,"_5":33601,"_22654":60924,"_29907":60925,"_3297":60926},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3844":2095,"_33198":2086,"_5":33601,"_22654":60928,"_29907":60929,"_3297":60930},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3844":2096,"_33198":2086,"_5":33601,"_22654":60932,"_29907":60933,"_3297":60934},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3844":2097,"_33198":2086,"_5":33601,"_22654":60936,"_29907":60937,"_3297":60938},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3844":2098,"_33198":2086,"_22654":60940,"_5":15607,"_29907":2086,"_3297":60941},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3844":2099,"_33198":2086,"_22654":60943,"_5":15607,"_29907":60905,"_3297":60944},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3844":2100,"_33198":2086,"_22654":60946,"_5":15607,"_29907":60909,"_3297":60947},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3844":2101,"_33198":2086,"_22654":60949,"_5":15607,"_29907":60913,"_3297":60950},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3844":2102,"_33198":2086,"_22654":60952,"_5":15607,"_29907":60917,"_3297":60953},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3844":2103,"_33198":2086,"_22654":60955,"_5":15607,"_29907":60921,"_3297":60956},[],"The device proves it can enroll according to the DMS policy.",{"_3844":2104,"_33198":2086,"_22654":60958,"_5":15607,"_29907":60921,"_3297":60959},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3844":2105,"_33198":2086,"_22654":60961,"_5":15607,"_29907":60921,"_3297":60962},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3844":2106,"_33198":2086,"_22654":60964,"_5":15607,"_29907":60921,"_3297":60965},[],"The device installs the certificate and the chain it needs.",{"_3844":2107,"_33198":2086,"_22654":60967,"_5":15607,"_29907":60921,"_3297":60968},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3844":2108,"_33198":2086,"_22654":60970,"_5":15607,"_29907":60921,"_3297":60971},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3844":2109,"_33198":2086,"_22654":60973,"_5":15607,"_29907":60925,"_3297":60974},[],"A DMS relates three sets that are worth designing separately:",{"_3844":2110,"_33198":2086,"_22654":60976,"_5":15607,"_29907":60925,"_3297":60977},[],"**Enrollment CA:** signs the new identities.",{"_3844":2111,"_33198":2086,"_22654":60979,"_5":15607,"_29907":60925,"_3297":60980},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3844":2112,"_33198":2086,"_22654":60982,"_5":15607,"_29907":60925,"_3297":60983},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3844":2113,"_33198":2086,"_22654":60985,"_5":15607,"_29907":60925,"_3297":60986},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3844":2114,"_33198":2086,"_22654":60988,"_5":15607,"_29907":60929,"_3297":60989},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3844":2115,"_33198":2086,"_22654":60991,"_5":15607,"_29907":60929,"_3297":60992},[],"that the current date is between `Not Before` and `Not After`;",{"_3844":2116,"_33198":2086,"_22654":60994,"_5":15607,"_29907":60929,"_3297":60995},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3844":2117,"_33198":2086,"_22654":60997,"_5":15607,"_29907":60929,"_3297":60998},[],"that names, SANs and subject match the expected identity;",{"_3844":2118,"_33198":2086,"_22654":61000,"_5":15607,"_29907":60929,"_3297":61001},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3844":2119,"_33198":2086,"_22654":61003,"_5":15607,"_29907":60929,"_3297":61004},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3844":2120,"_33198":2086,"_22654":61006,"_5":15607,"_29907":60929,"_3297":61007},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3844":2121,"_33198":2086,"_22654":61009,"_5":15607,"_29907":60933,"_3297":61010},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3844":2122,"_33198":2086,"_22654":61012,"_5":15607,"_29907":60937,"_3297":61013},[],"Keep the root out of daily operations, or with very restricted access.",{"_3844":2123,"_33198":2086,"_22654":61015,"_5":15607,"_29907":60937,"_3297":61016},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3844":2124,"_33198":2086,"_22654":61018,"_5":15607,"_29907":60937,"_3297":61019},[],"Assign explicit profiles to every use case.",{"_3844":2125,"_33198":2086,"_22654":61021,"_5":15607,"_29907":60937,"_3297":61022},[],"Distribute the new trust before starting a rotation.",{"_3844":2126,"_33198":2086,"_22654":61024,"_5":15607,"_29907":60937,"_3297":61025},[],"Keep enough overlap to renew a disconnected fleet.",{"_3844":2127,"_33198":2086,"_22654":61027,"_5":15607,"_29907":60937,"_3297":61028},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3844":2128,"_33198":2086,"_22654":61030,"_5":15607,"_29907":60937,"_3297":61031},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3844":2129,"_33198":2129,"_5":16006,"_3297":61033,"_33604":61034,"_22654":61035,"_29907":2129},"Revocation lists (CRL)",[54402,55870,59872,60505],[],{"_3844":2130,"_33198":2129,"_22654":61037,"_5":15607,"_29907":2129,"_3297":61038},[],"Generate and distribute signed lists to validate certificates offline.",{"_3844":2131,"_33198":2129,"_5":33601,"_22654":61040,"_29907":61041,"_3297":61042},[],"/docs/pr-preview/pr-58/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3844":2132,"_33198":2129,"_5":33601,"_22654":61044,"_29907":61045,"_3297":61046},[],"/docs/pr-preview/pr-58/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3844":2133,"_33198":2129,"_5":33601,"_22654":61048,"_29907":61049,"_3297":61050},[],"/docs/pr-preview/pr-58/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3844":2134,"_33198":2129,"_5":33601,"_22654":61052,"_29907":61053,"_3297":61054},[],"/docs/pr-preview/pr-58/platform/pki/crl#crl-contents","CRL contents",{"_3844":2135,"_33198":2129,"_5":33601,"_22654":61056,"_29907":61057,"_3297":61058},[],"/docs/pr-preview/pr-58/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3844":2136,"_33198":2129,"_5":33601,"_22654":61060,"_29907":61061,"_3297":61062},[],"/docs/pr-preview/pr-58/platform/pki/crl#va-role-management-api","VA role management API",{"_3844":2137,"_33198":2129,"_5":33601,"_22654":61064,"_29907":61065,"_3297":61066},[],"/docs/pr-preview/pr-58/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3844":2138,"_33198":2129,"_5":33601,"_22654":61068,"_29907":61069,"_3297":61070},[],"/docs/pr-preview/pr-58/platform/pki/crl#from-the-interface","From the interface",{"_3844":2139,"_33198":2129,"_5":33601,"_22654":61072,"_29907":61073,"_3297":61074},[],"/docs/pr-preview/pr-58/platform/pki/crl#references","References",{"_3844":2140,"_33198":2129,"_22654":61076,"_5":15607,"_29907":2129,"_3297":61077},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3844":2141,"_33198":2129,"_22654":61079,"_5":15607,"_29907":61041,"_3297":61080},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3844":2142,"_33198":2129,"_22654":61082,"_5":15607,"_29907":61041,"_3297":61083},[],"`crl_options` field",{"_3844":2143,"_33198":2129,"_22654":61085,"_5":15607,"_29907":61041,"_3297":54792},[],{"_3844":2144,"_33198":2129,"_22654":61087,"_5":15607,"_29907":61041,"_3297":61088},[],"Backend initial value",{"_3844":2145,"_33198":2129,"_22654":61090,"_5":15607,"_29907":61041,"_3297":61091},[],"`validity`",{"_3844":2146,"_33198":2129,"_22654":61093,"_5":15607,"_29907":61041,"_3297":61094},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3844":2147,"_33198":2129,"_22654":61096,"_5":15607,"_29907":61041,"_3297":61097},[],"7 days.",{"_3844":2148,"_33198":2129,"_22654":61099,"_5":15607,"_29907":61041,"_3297":61100},[],"`refresh_interval`",{"_3844":2149,"_33198":2129,"_22654":61102,"_5":15607,"_29907":61041,"_3297":61103},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3844":2150,"_33198":2129,"_22654":61105,"_5":15607,"_29907":61041,"_3297":61106},[],"6 days and 23 hours.",{"_3844":2151,"_33198":2129,"_22654":61108,"_5":15607,"_29907":61041,"_3297":61109},[],"`regenerate_on_revoke`",{"_3844":2152,"_33198":2129,"_22654":61111,"_5":15607,"_29907":61041,"_3297":61112},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3844":2153,"_33198":2129,"_22654":61114,"_5":15607,"_29907":61041,"_3297":61115},[],"`true`.",{"_3844":2154,"_33198":2129,"_22654":61117,"_5":15607,"_29907":61041,"_3297":61118},[],"`signer_certificate_serial_number`",{"_3844":2155,"_33198":2129,"_22654":61120,"_5":15607,"_29907":61041,"_3297":61121},[],"Serial number of the existing certificate that signs the CRL.",{"_3844":2156,"_33198":2129,"_22654":61123,"_5":15607,"_29907":61041,"_3297":61124},[],"Serial number of the CA’s current certificate.",{"_3844":2157,"_33198":2129,"_22654":61126,"_5":15607,"_29907":61041,"_3297":61127},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3844":2158,"_33198":2129,"_22654":61129,"_5":15607,"_29907":61041,"_3297":61130},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3844":2159,"_33198":2129,"_22654":61132,"_5":15607,"_29907":61041,"_3297":61133},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3844":2160,"_33198":2129,"_22654":61135,"_5":15607,"_29907":61041,"_3297":61136},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3844":2161,"_33198":2129,"_22654":61138,"_5":15607,"_29907":61041,"_3297":61139},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3844":2162,"_33198":2129,"_22654":61141,"_5":15607,"_29907":61041,"_3297":61142},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_3844":2163,"_33198":2129,"_22654":61144,"_5":15607,"_29907":61041,"_3297":61145},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3844":2164,"_33198":2129,"_22654":61147,"_5":15607,"_29907":61045,"_3297":61148},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3844":2165,"_33198":2129,"_22654":61150,"_5":15607,"_29907":61045,"_3297":61151},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3844":2166,"_33198":2129,"_22654":61153,"_5":15607,"_29907":61045,"_3297":61154},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3844":2167,"_33198":2129,"_22654":61156,"_5":15607,"_29907":61045,"_3297":61157},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3844":2168,"_33198":2129,"_22654":61159,"_5":15607,"_29907":61049,"_3297":61160},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3844":2169,"_33198":2129,"_22654":61162,"_5":15607,"_29907":61049,"_3297":61163},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3844":2170,"_33198":2129,"_22654":61165,"_5":15607,"_29907":61049,"_3297":61166},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3844":2171,"_33198":2129,"_22654":61168,"_5":15607,"_29907":61049,"_3297":61169},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3844":2172,"_33198":2129,"_22654":61171,"_5":15607,"_29907":61053,"_3297":61172},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3844":2173,"_33198":2129,"_22654":61174,"_5":15607,"_29907":61053,"_3297":61175},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3844":2174,"_33198":2129,"_22654":61177,"_5":15607,"_29907":61057,"_3297":61178},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3844":2175,"_33198":2129,"_22654":61180,"_5":15607,"_29907":61057,"_3297":61181},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3844":2176,"_33198":2129,"_22654":61183,"_5":15607,"_29907":61057,"_3297":61184},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the role points to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3844":2177,"_33198":2129,"_22654":61186,"_5":15607,"_29907":61057,"_3297":61187},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3844":2178,"_33198":2129,"_22654":61189,"_5":15607,"_29907":61057,"_3297":61190},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3844":2179,"_33198":2129,"_22654":61192,"_5":15607,"_29907":61061,"_3297":61193},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3844":2180,"_33198":2129,"_22654":61195,"_5":15607,"_29907":61061,"_3297":57637},[],{"_3844":2181,"_33198":2129,"_22654":61197,"_5":15607,"_29907":61061,"_3297":61198},[],"Relative path",{"_3844":2182,"_33198":2129,"_22654":61200,"_5":15607,"_29907":61061,"_3297":57634},[],{"_3844":2183,"_33198":2129,"_22654":61202,"_5":15607,"_29907":61061,"_3297":61203},[],"`GET`",{"_3844":2184,"_33198":2129,"_22654":61205,"_5":15607,"_29907":61061,"_3297":61206},[],"`/v1/roles/{ca-ski}`",{"_3844":2185,"_33198":2129,"_22654":61208,"_5":15607,"_29907":61061,"_3297":61209},[],"Read `crl_options` and `latest_crl`.",{"_3844":2186,"_33198":2129,"_22654":61211,"_5":15607,"_29907":61061,"_3297":61212},[],"`PUT`",{"_3844":2187,"_33198":2129,"_22654":61214,"_5":15607,"_29907":61061,"_3297":61206},[],{"_3844":2188,"_33198":2129,"_22654":61216,"_5":15607,"_29907":61061,"_3297":61217},[],"Replace CRL configuration.",{"_3844":2189,"_33198":2129,"_22654":61219,"_5":15607,"_29907":61061,"_3297":61220},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3844":2190,"_33198":2129,"_22654":61222,"_5":15607,"_29907":61061,"_3297":61223},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3844":2191,"_33198":2129,"_22654":61225,"_5":15607,"_29907":61065,"_3297":61226},[],"Symptom",{"_3844":2192,"_33198":2129,"_22654":61228,"_5":15607,"_29907":61065,"_3297":61229},[],"Cause",{"_3844":2193,"_33198":2129,"_22654":61231,"_5":15607,"_29907":61065,"_3297":61232},[],"Action",{"_3844":2194,"_33198":2129,"_22654":61234,"_5":15607,"_29907":61065,"_3297":61235},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3844":2195,"_33198":2129,"_22654":61237,"_5":15607,"_29907":61065,"_3297":61238},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3844":2196,"_33198":2129,"_22654":61240,"_5":15607,"_29907":61065,"_3297":61241},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3844":2197,"_33198":2129,"_22654":61243,"_5":15607,"_29907":61065,"_3297":61244},[],"`PUT` returns 400.",{"_3844":2198,"_33198":2129,"_22654":61246,"_5":15607,"_29907":61065,"_3297":61247},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3844":2199,"_33198":2129,"_22654":61249,"_5":15607,"_29907":61065,"_3297":61250},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3844":2200,"_33198":2129,"_22654":61252,"_5":15607,"_29907":61065,"_3297":61253},[],"`PUT` returns 400 from a 3.x client.",{"_3844":2201,"_33198":2129,"_22654":61255,"_5":15607,"_29907":61065,"_3297":61256},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3844":2202,"_33198":2129,"_22654":61258,"_5":15607,"_29907":61065,"_3297":61259},[],"Update the client to send the new field.",{"_3844":2203,"_33198":2129,"_22654":61261,"_5":15607,"_29907":61065,"_3297":61262},[],"The CRL does not change after revoking a certificate.",{"_3844":2204,"_33198":2129,"_22654":61264,"_5":15607,"_29907":61065,"_3297":61265},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3844":2205,"_33198":2129,"_22654":61267,"_5":15607,"_29907":61065,"_3297":61268},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3844":2206,"_33198":2129,"_22654":61270,"_5":15607,"_29907":61065,"_3297":61271},[],"A verifier rejects the CRL because of the issuer.",{"_3844":2207,"_33198":2129,"_22654":61273,"_5":15607,"_29907":61065,"_3297":61274},[],"Several CAs share an SKI.",{"_3844":2208,"_33198":2129,"_22654":61276,"_5":15607,"_29907":61065,"_3297":61277},[],"See CAs that share a key.",{"_3844":2209,"_33198":2129,"_22654":61279,"_5":15607,"_29907":61069,"_3297":61280},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3844":2210,"_33198":2129,"_22654":61282,"_5":15607,"_29907":61073,"_3297":61283},[],"RFC 5280: X.509 and CRL profile.",{"_3844":2211,"_33198":2129,"_22654":61285,"_5":15607,"_29907":61073,"_3297":61286},[],"OpenSSL: openssl-crl.",{"_3844":2212,"_33198":2129,"_22654":61288,"_5":15607,"_29907":61073,"_3297":61289},[],"OpenSSL: openssl-verify.",{"_3844":2213,"_33198":2129,"_22654":61291,"_5":15607,"_29907":61073,"_3297":61292},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3844":2214,"_33198":2129,"_22654":61294,"_5":15607,"_29907":61073,"_3297":61295},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3844":2215,"_33198":2215,"_5":16006,"_3297":61297,"_33604":61298,"_22654":61299,"_29907":2215},"Keys and cryptographic engines",[54402,55870,59872,59873],[],{"_3844":2216,"_33198":2215,"_22654":61301,"_5":15607,"_29907":2215,"_3297":61302},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3844":2217,"_33198":2215,"_5":33601,"_22654":61304,"_29907":61305,"_3297":61306},[],"/docs/pr-preview/pr-58/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3844":2218,"_33198":2215,"_5":33601,"_22654":61308,"_29907":61309,"_3297":61310},[],"/docs/pr-preview/pr-58/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3844":2219,"_33198":2215,"_5":33601,"_22654":61312,"_29907":61313,"_3297":61314},[],"/docs/pr-preview/pr-58/platform/pki/key-management#file-system","File System",{"_3844":2220,"_33198":2215,"_5":33601,"_22654":61316,"_29907":61317,"_3297":61318},[],"/docs/pr-preview/pr-58/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3844":2221,"_33198":2215,"_5":33601,"_22654":61320,"_29907":61321,"_3297":61322},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3844":2222,"_33198":2215,"_5":33601,"_22654":61324,"_29907":61325,"_3297":61326},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-kms","AWS KMS",{"_3844":2223,"_33198":2215,"_5":33601,"_22654":61328,"_29907":61329,"_3297":61330},[],"/docs/pr-preview/pr-58/platform/pki/key-management#pkcs11","PKCS#11",{"_3844":2224,"_33198":2215,"_5":33601,"_22654":61332,"_29907":61333,"_3297":61334},[],"/docs/pr-preview/pr-58/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3844":2225,"_33198":2215,"_5":33601,"_22654":61336,"_29907":61337,"_3297":61338},[],"/docs/pr-preview/pr-58/platform/pki/key-management#key-inventory","Key inventory",{"_3844":2226,"_33198":2215,"_5":33601,"_22654":61340,"_29907":61341,"_3297":61342},[],"/docs/pr-preview/pr-58/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3844":2227,"_33198":2215,"_5":33601,"_22654":61344,"_29907":61345,"_3297":61346},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3844":2228,"_33198":2215,"_5":33601,"_22654":61348,"_29907":61349,"_3297":61350},[],"/docs/pr-preview/pr-58/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3844":2229,"_33198":2215,"_5":33601,"_22654":61352,"_29907":61353,"_3297":61354},[],"/docs/pr-preview/pr-58/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3844":2230,"_33198":2215,"_5":33601,"_22654":61356,"_29907":61357,"_3297":61358},[],"/docs/pr-preview/pr-58/platform/pki/key-management#view-details","View details",{"_3844":2231,"_33198":2215,"_5":33601,"_22654":61360,"_29907":61361,"_3297":61362},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3844":2232,"_33198":2215,"_5":33601,"_22654":61364,"_29907":61365,"_3297":61366},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign","Sign",{"_3844":2233,"_33198":2215,"_5":33601,"_22654":61368,"_29907":61369,"_3297":61370},[],"/docs/pr-preview/pr-58/platform/pki/key-management#verify","Verify",{"_3844":2234,"_33198":2215,"_5":33601,"_22654":61372,"_29907":61373,"_3297":61374},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3844":2235,"_33198":2215,"_5":33601,"_22654":61376,"_29907":61377,"_3297":61378},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3844":2236,"_33198":2215,"_5":33601,"_22654":61380,"_29907":61381,"_3297":61382},[],"/docs/pr-preview/pr-58/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3844":2237,"_33198":2215,"_22654":61384,"_5":15607,"_29907":2215,"_3297":61385},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3844":2238,"_33198":2215,"_22654":61387,"_5":15607,"_29907":2215,"_3297":61388},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3844":2239,"_33198":2215,"_22654":61390,"_5":15607,"_29907":61305,"_3297":61391},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3844":2240,"_33198":2215,"_22654":61393,"_5":15607,"_29907":61305,"_3297":61394},[],"In practice, it lets you:",{"_3844":2241,"_33198":2215,"_22654":61396,"_5":15607,"_29907":61305,"_3297":61397},[],"Generate new key pairs from Lamassu IoT.",{"_3844":2242,"_33198":2215,"_22654":61399,"_5":15607,"_29907":61305,"_3297":61400},[],"Import keys created externally.",{"_3844":2243,"_33198":2215,"_22654":61402,"_5":15607,"_29907":61305,"_3297":61403},[],"Delegate custody and cryptographic operations to external engines.",{"_3844":2244,"_33198":2215,"_22654":61405,"_5":15607,"_29907":61305,"_3297":61406},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3844":2245,"_33198":2215,"_22654":61408,"_5":15607,"_29907":61309,"_3297":61409},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3844":2246,"_33198":2215,"_22654":61411,"_5":15607,"_29907":61309,"_3297":61412},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3844":2247,"_33198":2215,"_22654":61414,"_5":15607,"_29907":61309,"_3297":61415},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3844":2248,"_33198":2215,"_22654":61417,"_5":15607,"_29907":61313,"_3297":61418},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3844":2249,"_33198":2215,"_22654":61420,"_5":15607,"_29907":61317,"_3297":61421},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3844":2250,"_33198":2215,"_22654":61423,"_5":15607,"_29907":61317,"_3297":61424},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3844":2251,"_33198":2215,"_22654":61426,"_5":15607,"_29907":61321,"_3297":61427},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3844":2252,"_33198":2215,"_22654":61429,"_5":15607,"_29907":61325,"_3297":61430},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3844":2253,"_33198":2215,"_22654":61432,"_5":15607,"_29907":61329,"_3297":61433},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3844":2254,"_33198":2215,"_22654":61435,"_5":15607,"_29907":61333,"_3297":61436},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3844":2255,"_33198":2215,"_22654":61438,"_5":15607,"_29907":61333,"_3297":61439},[],"Lamassu shows the enabled engines in the console.",{"_3844":2256,"_33198":2215,"_22654":61441,"_5":15607,"_29907":61333,"_3297":61442},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3844":2257,"_33198":2215,"_22654":61444,"_5":15607,"_29907":61333,"_3297":61445},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3844":2258,"_33198":2215,"_22654":61447,"_5":15607,"_29907":61337,"_3297":61448},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3844":2259,"_33198":2215,"_22654":61450,"_5":15607,"_29907":61337,"_3297":61451},[],"The table includes the following fields:",{"_3844":2260,"_33198":2215,"_22654":61453,"_5":15607,"_29907":61337,"_3297":61454},[],"**Name**: descriptive name of the key.",{"_3844":2261,"_33198":2215,"_22654":61456,"_5":15607,"_29907":61337,"_3297":61457},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3844":2262,"_33198":2215,"_22654":61459,"_5":15607,"_29907":61337,"_3297":61460},[],"**Strength**: visual indicator of cryptographic strength.",{"_3844":2263,"_33198":2215,"_22654":61462,"_5":15607,"_29907":61337,"_3297":61463},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3844":2264,"_33198":2215,"_22654":61465,"_5":15607,"_29907":61337,"_3297":61466},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3844":2265,"_33198":2215,"_22654":61468,"_5":15607,"_29907":61337,"_3297":61469},[],"**Aliases**: alternative names associated with the key.",{"_3844":2266,"_33198":2215,"_22654":61471,"_5":15607,"_29907":61337,"_3297":61472},[],"**Tags**: labels for classification and search.",{"_3844":2267,"_33198":2215,"_22654":61474,"_5":15607,"_29907":61337,"_3297":61475},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3844":2268,"_33198":2215,"_22654":61477,"_5":15607,"_29907":61337,"_3297":61478},[],"From this view you also reach the most common actions:",{"_3844":2269,"_33198":2215,"_22654":61480,"_5":15607,"_29907":61337,"_3297":61481},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3844":2270,"_33198":2215,"_22654":61483,"_5":15607,"_29907":61337,"_3297":61484},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3844":2271,"_33198":2215,"_22654":61486,"_5":15607,"_29907":61337,"_3297":61487},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3844":2272,"_33198":2215,"_22654":61489,"_5":15607,"_29907":61337,"_3297":61490},[],"**Delete Key** to remove the key from the system.",{"_3844":2273,"_33198":2215,"_22654":61492,"_5":15607,"_29907":61341,"_3297":61493},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3844":2274,"_33198":2215,"_22654":61495,"_5":15607,"_29907":61345,"_3297":61496},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3844":2275,"_33198":2215,"_22654":61498,"_5":15607,"_29907":61345,"_3297":61499},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3844":2276,"_33198":2215,"_22654":61501,"_5":15607,"_29907":61345,"_3297":61502},[],"**Key Name**: unique and descriptive name.",{"_3844":2277,"_33198":2215,"_22654":61504,"_5":15607,"_29907":61345,"_3297":61505},[],"**Crypto Engine**: engine that will keep the key.",{"_3844":2278,"_33198":2215,"_22654":61507,"_5":15607,"_29907":61345,"_3297":61508},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3844":2279,"_33198":2215,"_22654":61510,"_5":15607,"_29907":61345,"_3297":61511},[],"**Tags**: metadata to classify the key.",{"_3844":2280,"_33198":2215,"_22654":61513,"_5":15607,"_29907":61345,"_3297":61514},[],"**Metadata**: additional information for advanced uses.",{"_3844":2281,"_33198":2215,"_22654":61516,"_5":15607,"_29907":61349,"_3297":61517},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3844":2282,"_33198":2215,"_22654":61519,"_5":15607,"_29907":61349,"_3297":61520},[],"When you have an exportable private key and the destination engine supports import.",{"_3844":2283,"_33198":2215,"_22654":61522,"_5":15607,"_29907":61349,"_3297":61523},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3844":2284,"_33198":2215,"_22654":61525,"_5":15607,"_29907":61349,"_3297":61526},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3844":2285,"_33198":2215,"_22654":61528,"_5":15607,"_29907":61349,"_3297":61529},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3844":2286,"_33198":2215,"_22654":61531,"_5":15607,"_29907":61349,"_3297":61532},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3844":2287,"_33198":2215,"_22654":61534,"_5":15607,"_29907":61349,"_3297":61535},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3844":2288,"_33198":2215,"_22654":61537,"_5":15607,"_29907":61349,"_3297":61538},[],"**Tags**: labels for organization and search.",{"_3844":2289,"_33198":2215,"_22654":61540,"_5":15607,"_29907":61349,"_3297":61541},[],"**Metadata**: additional optional information.",{"_3844":2290,"_33198":2215,"_22654":61543,"_5":15607,"_29907":61349,"_3297":61544},[],"**Private Key (PEM)**: private key in PEM format.",{"_3844":2291,"_33198":2215,"_22654":61546,"_5":15607,"_29907":61349,"_3297":61547},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3844":2292,"_33198":2215,"_22654":61549,"_5":15607,"_29907":61353,"_3297":61550},[],"Each registered key has a detail view and several operational actions.",{"_3844":2293,"_33198":2215,"_22654":61552,"_5":15607,"_29907":61357,"_3297":61553},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3844":2294,"_33198":2215,"_22654":61555,"_5":15607,"_29907":61357,"_3297":61556},[],"The **Overview** tab shows, among others, these fields:",{"_3844":2295,"_33198":2215,"_22654":61558,"_5":15607,"_29907":61357,"_3297":61559},[],"**Key Name**: descriptive name.",{"_3844":2296,"_33198":2215,"_22654":61561,"_5":15607,"_29907":61357,"_3297":61562},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3844":2297,"_33198":2215,"_22654":61564,"_5":15607,"_29907":61357,"_3297":61565},[],"**Tags**: associated labels.",{"_3844":2298,"_33198":2215,"_22654":61567,"_5":15607,"_29907":61357,"_3297":61568},[],"**Aliases**: alternative names.",{"_3844":2299,"_33198":2215,"_22654":61570,"_5":15607,"_29907":61357,"_3297":61571},[],"**Crypto Engine**: engine where the key resides.",{"_3844":2300,"_33198":2215,"_22654":61573,"_5":15607,"_29907":61357,"_3297":61574},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3844":2301,"_33198":2215,"_22654":61576,"_5":15607,"_29907":61357,"_3297":61577},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3844":2302,"_33198":2215,"_22654":61579,"_5":15607,"_29907":61357,"_3297":61580},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3844":2303,"_33198":2215,"_22654":61582,"_5":15607,"_29907":61361,"_3297":61583},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3844":2304,"_33198":2215,"_22654":61585,"_5":15607,"_29907":61361,"_3297":61586},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3844":2305,"_33198":2215,"_22654":61588,"_5":15607,"_29907":61361,"_3297":61589},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3844":2306,"_33198":2215,"_22654":61591,"_5":15607,"_29907":61365,"_3297":61592},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3844":2307,"_33198":2215,"_22654":61594,"_5":15607,"_29907":61365,"_3297":61595},[],"Main fields:",{"_3844":2308,"_33198":2215,"_22654":61597,"_5":15607,"_29907":61365,"_3297":61598},[],"**Algorithm**: signing algorithm available for the key type.",{"_3844":2309,"_33198":2215,"_22654":61600,"_5":15607,"_29907":61365,"_3297":61601},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3844":2310,"_33198":2215,"_22654":61603,"_5":15607,"_29907":61365,"_3297":61604},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3844":2311,"_33198":2215,"_22654":61606,"_5":15607,"_29907":61365,"_3297":61607},[],"**Message**: content to sign.",{"_3844":2312,"_33198":2215,"_22654":61609,"_5":15607,"_29907":61365,"_3297":61610},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3844":2313,"_33198":2215,"_22654":61612,"_5":15607,"_29907":61369,"_3297":61613},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3844":2314,"_33198":2215,"_22654":61615,"_5":15607,"_29907":61369,"_3297":61595},[],{"_3844":2315,"_33198":2215,"_22654":61617,"_5":15607,"_29907":61369,"_3297":61618},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3844":2316,"_33198":2215,"_22654":61620,"_5":15607,"_29907":61369,"_3297":61621},[],"**Message Type**: `Raw` or `Digest`.",{"_3844":2317,"_33198":2215,"_22654":61623,"_5":15607,"_29907":61369,"_3297":61624},[],"**Payload Encoding**: encoding of the message.",{"_3844":2318,"_33198":2215,"_22654":61626,"_5":15607,"_29907":61369,"_3297":61627},[],"**Message**: original message or hash.",{"_3844":2319,"_33198":2215,"_22654":61629,"_5":15607,"_29907":61369,"_3297":61630},[],"**Signature**: signature to check.",{"_3844":2320,"_33198":2215,"_22654":61632,"_5":15607,"_29907":61369,"_3297":61633},[],"**Result**: indicator of the validation result.",{"_3844":2321,"_33198":2215,"_22654":61635,"_5":15607,"_29907":61373,"_3297":61636},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3844":2322,"_33198":2215,"_22654":61638,"_5":15607,"_29907":61373,"_3297":61639},[],"This flow is useful for:",{"_3844":2323,"_33198":2215,"_22654":61641,"_5":15607,"_29907":61373,"_3297":61642},[],"Requesting certificates from an external CA.",{"_3844":2324,"_33198":2215,"_22654":61644,"_5":15607,"_29907":61373,"_3297":61645},[],"Renewing an identity while keeping the same key.",{"_3844":2325,"_33198":2215,"_22654":61647,"_5":15607,"_29907":61373,"_3297":61648},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3844":2326,"_33198":2215,"_22654":61650,"_5":15607,"_29907":61373,"_3297":61651},[],"**Common Name (CN)**: main name of the identity.",{"_3844":2327,"_33198":2215,"_22654":61653,"_5":15607,"_29907":61373,"_3297":61654},[],"**Organization (O)**: organization or company.",{"_3844":2328,"_33198":2215,"_22654":61656,"_5":15607,"_29907":61373,"_3297":61657},[],"**Organizational Unit (OU)**: department or unit.",{"_3844":2329,"_33198":2215,"_22654":61659,"_5":15607,"_29907":61373,"_3297":61660},[],"**Country (C)**: two-letter country code.",{"_3844":2330,"_33198":2215,"_22654":61662,"_5":15607,"_29907":61373,"_3297":61663},[],"**State / Province (ST)**: state or province.",{"_3844":2331,"_33198":2215,"_22654":61665,"_5":15607,"_29907":61373,"_3297":61666},[],"**Locality (L)**: city or locality.",{"_3844":2332,"_33198":2215,"_22654":61668,"_5":15607,"_29907":61373,"_3297":61669},[],"**Email Address**: contact email.",{"_3844":2333,"_33198":2215,"_22654":61671,"_5":15607,"_29907":61373,"_3297":61672},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3844":2334,"_33198":2215,"_22654":61674,"_5":15607,"_29907":61373,"_3297":61675},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3844":2335,"_33198":2215,"_22654":61677,"_5":15607,"_29907":61377,"_3297":61678},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3844":2336,"_33198":2215,"_22654":61680,"_5":15607,"_29907":61377,"_3297":61681},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3844":2337,"_33198":2215,"_22654":61683,"_5":15607,"_29907":61381,"_3297":61684},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3844":2338,"_33198":2215,"_22654":61686,"_5":15607,"_29907":61381,"_3297":61687},[],"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3844":2339,"_33198":2339,"_5":16006,"_3297":61689,"_33604":61690,"_22654":61691,"_29907":2339},"Online validation with OCSP",[54402,55870,59872,60505],[],{"_3844":2340,"_33198":2339,"_22654":61693,"_5":15607,"_29907":2339,"_3297":61694},[],"Query signed status and verify the responder’s response.",{"_3844":2341,"_33198":2339,"_5":33601,"_22654":61696,"_29907":61697,"_3297":61698},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3844":2342,"_33198":2339,"_5":33601,"_22654":61700,"_29907":61701,"_3297":61702},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3844":2343,"_33198":2339,"_5":33601,"_22654":61704,"_29907":61705,"_3297":61706},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3844":2344,"_33198":2339,"_5":33601,"_22654":61708,"_29907":61709,"_3297":61710},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3844":2345,"_33198":2339,"_5":33601,"_22654":61712,"_29907":61713,"_3297":61714},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3844":2346,"_33198":2339,"_5":33601,"_22654":61716,"_29907":61717,"_3297":61074},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#references",{"_3844":2347,"_33198":2339,"_22654":61719,"_5":15607,"_29907":2339,"_3297":61720},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3844":2348,"_33198":2339,"_22654":61722,"_5":15607,"_29907":61697,"_3297":61723},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3844":2349,"_33198":2339,"_22654":61725,"_5":15607,"_29907":61697,"_3297":61726},[],"Record status",{"_3844":2350,"_33198":2339,"_22654":61728,"_5":15607,"_29907":61697,"_3297":61729},[],"Signed response",{"_3844":2351,"_33198":2339,"_22654":61731,"_5":15607,"_29907":61697,"_3297":59009},[],{"_3844":2352,"_33198":2339,"_22654":61733,"_5":15607,"_29907":61697,"_3297":61734},[],"`Good`.",{"_3844":2353,"_33198":2339,"_22654":61736,"_5":15607,"_29907":61697,"_3297":59026},[],{"_3844":2354,"_33198":2339,"_22654":61738,"_5":15607,"_29907":61697,"_3297":61739},[],"`Revoked`, with revocation reason and timestamp.",{"_3844":2355,"_33198":2339,"_22654":61741,"_5":15607,"_29907":61697,"_3297":61742},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3844":2356,"_33198":2339,"_22654":61744,"_5":15607,"_29907":61697,"_3297":61745},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3844":2357,"_33198":2339,"_22654":61747,"_5":15607,"_29907":61697,"_3297":61748},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3844":2358,"_33198":2339,"_22654":61750,"_5":15607,"_29907":61697,"_3297":61751},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3844":2359,"_33198":2339,"_22654":61753,"_5":15607,"_29907":61697,"_3297":61754},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3844":2360,"_33198":2339,"_22654":61756,"_5":15607,"_29907":61701,"_3297":61757},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3844":2361,"_33198":2339,"_22654":61759,"_5":15607,"_29907":61701,"_3297":61760},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3844":2362,"_33198":2339,"_22654":61762,"_5":15607,"_29907":61705,"_3297":61763},[],"The service accepts:",{"_3844":2363,"_33198":2339,"_22654":61765,"_5":15607,"_29907":61705,"_3297":57637},[],{"_3844":2364,"_33198":2339,"_22654":61767,"_5":15607,"_29907":61705,"_3297":61768},[],"VA service path",{"_3844":2365,"_33198":2339,"_22654":61770,"_5":15607,"_29907":61705,"_3297":61771},[],"Format",{"_3844":2366,"_33198":2339,"_22654":61773,"_5":15607,"_29907":61705,"_3297":61774},[],"`POST`",{"_3844":2367,"_33198":2339,"_22654":61776,"_5":15607,"_29907":61705,"_3297":61777},[],"`/ocsp`",{"_3844":2368,"_33198":2339,"_22654":61779,"_5":15607,"_29907":61705,"_3297":61780},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3844":2369,"_33198":2339,"_22654":61782,"_5":15607,"_29907":61705,"_3297":61203},[],{"_3844":2370,"_33198":2339,"_22654":61784,"_5":15607,"_29907":61705,"_3297":61785},[],"`/ocsp/{ocsp_request}`",{"_3844":2371,"_33198":2339,"_22654":61787,"_5":15607,"_29907":61705,"_3297":61788},[],"DER request encoded using padded URL Base64.",{"_3844":2372,"_33198":2339,"_22654":61790,"_5":15607,"_29907":61705,"_3297":61791},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3844":2373,"_33198":2339,"_22654":61793,"_5":15607,"_29907":61709,"_3297":61794},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3844":2374,"_33198":2339,"_22654":61796,"_5":15607,"_29907":61709,"_3297":61797},[],"Generate the request:",{"_3844":2375,"_33198":2339,"_22654":61799,"_5":15607,"_29907":61709,"_3297":61800},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3844":2376,"_33198":2339,"_22654":61802,"_5":15607,"_29907":61709,"_3297":61803},[],"Replace the example URL with the inspected endpoint:",{"_3844":2377,"_33198":2339,"_22654":61805,"_5":15607,"_29907":61709,"_3297":61806},[],"Verify the returned DER:",{"_3844":2378,"_33198":2339,"_22654":61808,"_5":15607,"_29907":61709,"_3297":61809},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3844":2379,"_33198":2339,"_22654":61811,"_5":15607,"_29907":61713,"_3297":61812},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3844":2380,"_33198":2339,"_22654":61814,"_5":15607,"_29907":61713,"_3297":61815},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3844":2381,"_33198":2339,"_22654":61817,"_5":15607,"_29907":61717,"_3297":61818},[],"RFC 6960: OCSP.",{"_3844":2382,"_33198":2339,"_22654":61820,"_5":15607,"_29907":61717,"_3297":61821},[],"OpenSSL: openssl-ocsp.",{"_3844":2383,"_33198":2339,"_22654":61823,"_5":15607,"_29907":61717,"_3297":61824},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3844":2384,"_33198":2339,"_22654":61826,"_5":15607,"_29907":61717,"_3297":61295},[],{"_3844":2385,"_33198":2385,"_5":16006,"_3297":59872,"_33604":61828,"_22654":61829,"_29907":2385},[54402,55870,59872],[],{"_3844":2386,"_33198":2385,"_22654":61831,"_5":15607,"_29907":2385,"_3297":61832},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3844":2387,"_33198":2385,"_5":33601,"_22654":61834,"_29907":61835,"_3297":59184},[],"/docs/pr-preview/pr-58/platform/pki/overview#start-here",{"_3844":2388,"_33198":2385,"_5":33601,"_22654":61837,"_29907":61838,"_3297":61839},[],"/docs/pr-preview/pr-58/platform/pki/overview#what-you-need","What you need",{"_3844":2389,"_33198":2385,"_5":33601,"_22654":61841,"_29907":61842,"_3297":59716},[],"/docs/pr-preview/pr-58/platform/pki/overview#core-capabilities",{"_3844":2390,"_33198":2385,"_5":33601,"_22654":61844,"_29907":61845,"_3297":59720},[],"/docs/pr-preview/pr-58/platform/pki/overview#build-your-trust-hierarchy",{"_3844":2391,"_33198":2385,"_5":33601,"_22654":61847,"_29907":61848,"_3297":59724},[],"/docs/pr-preview/pr-58/platform/pki/overview#protect-cryptographic-keys",{"_3844":2392,"_33198":2385,"_5":33601,"_22654":61850,"_29907":61851,"_3297":59728},[],"/docs/pr-preview/pr-58/platform/pki/overview#issue-and-control-certificates",{"_3844":2393,"_33198":2385,"_5":33601,"_22654":61853,"_29907":61854,"_3297":59736},[],"/docs/pr-preview/pr-58/platform/pki/overview#publish-validation-status",{"_3844":2394,"_33198":2385,"_5":33601,"_22654":61856,"_29907":61857,"_3297":61858},[],"/docs/pr-preview/pr-58/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3844":2395,"_33198":2385,"_5":33601,"_22654":61860,"_29907":61861,"_3297":60672},[],"/docs/pr-preview/pr-58/platform/pki/overview#continue",{"_3844":2396,"_33198":2385,"_22654":61863,"_5":15607,"_29907":2385,"_3297":61864},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3844":2397,"_33198":2385,"_22654":61866,"_5":15607,"_29907":61835,"_3297":61867},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3844":2398,"_33198":2385,"_22654":61869,"_5":15607,"_29907":61835,"_3297":61870},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3844":2399,"_33198":2385,"_22654":61872,"_5":15607,"_29907":61838,"_3297":61873},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3844":2400,"_33198":2385,"_22654":61875,"_5":15607,"_29907":61838,"_3297":61876},[],"An available cryptographic engine to keep the authority's key.",{"_3844":2401,"_33198":2385,"_22654":61878,"_5":15607,"_29907":61838,"_3297":61879},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3844":2402,"_33198":2385,"_22654":61881,"_5":15607,"_29907":61838,"_3297":61882},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3844":2403,"_33198":2385,"_22654":61884,"_5":15607,"_29907":61838,"_3297":61885},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3844":2404,"_33198":2385,"_22654":61887,"_5":15607,"_29907":61845,"_3297":61888},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3844":2405,"_33198":2385,"_22654":61890,"_5":15607,"_29907":61848,"_3297":61891},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3844":2406,"_33198":2385,"_22654":61893,"_5":15607,"_29907":61851,"_3297":61894},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3844":2407,"_33198":2385,"_22654":61896,"_5":15607,"_29907":61854,"_3297":61897},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3844":2408,"_33198":2385,"_22654":61899,"_5":15607,"_29907":61857,"_3297":61900},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3844":2409,"_33198":2385,"_22654":61902,"_5":15607,"_29907":61857,"_3297":61903},[],"its subject and extensions identify the expected client;",{"_3844":2410,"_33198":2385,"_22654":61905,"_5":15607,"_29907":61857,"_3297":61906},[],"its public key matches the client's private key;",{"_3844":2411,"_33198":2385,"_22654":61908,"_5":15607,"_29907":61857,"_3297":61909},[],"its chain reaches a root trusted by the consumer;",{"_3844":2412,"_33198":2385,"_22654":61911,"_5":15607,"_29907":61857,"_3297":61912},[],"its dates and usages allow the operation;",{"_3844":2413,"_33198":2385,"_22654":61914,"_5":15607,"_29907":61857,"_3297":61915},[],"the consumer applies revocation checks and authorization.",{"_3844":2414,"_33198":2385,"_22654":61917,"_5":15607,"_29907":61857,"_3297":61918},[],"The issuance path includes the first independent checks.",{"_3844":2415,"_33198":2385,"_22654":61920,"_5":15607,"_29907":61861,"_3297":61921},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3844":2416,"_33198":2385,"_22654":61923,"_5":15607,"_29907":61861,"_3297":61924},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3844":2417,"_33198":2385,"_22654":61926,"_5":15607,"_29907":61861,"_3297":61927},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3844":2418,"_33198":2418,"_5":16006,"_3297":61929,"_33604":61930,"_22654":61931,"_29907":2418},"Create your first CA",[54402,55870,59872,59309],[],{"_3844":2419,"_33198":2418,"_22654":61933,"_5":15607,"_29907":2418,"_3297":61934},[],"Create an evaluation root and check its certificate before issuing.",{"_3844":2420,"_33198":2418,"_5":33601,"_22654":61936,"_29907":61937,"_3297":54412},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3844":2421,"_33198":2418,"_5":33601,"_22654":61939,"_29907":61940,"_3297":61941},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3844":2422,"_33198":2418,"_5":33601,"_22654":61943,"_29907":61944,"_3297":61945},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3844":2423,"_33198":2418,"_5":33601,"_22654":61947,"_29907":61948,"_3297":61949},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3844":2424,"_33198":2418,"_5":33601,"_22654":61951,"_29907":61952,"_3297":61953},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3844":2425,"_33198":2418,"_5":33601,"_22654":61955,"_29907":61956,"_3297":61957},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3844":2426,"_33198":2418,"_5":33601,"_22654":61959,"_29907":61960,"_3297":61961},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3844":2427,"_33198":2418,"_5":33601,"_22654":61963,"_29907":61964,"_3297":59566},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3844":2428,"_33198":2418,"_5":33601,"_22654":61966,"_29907":61967,"_3297":54436},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3844":2429,"_33198":2418,"_22654":61969,"_5":15607,"_29907":2418,"_3297":61970},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3844":2430,"_33198":2418,"_22654":61972,"_5":15607,"_29907":61937,"_3297":61973},[],"Console access and permission to create keys and authorities.",{"_3844":2431,"_33198":2418,"_22654":61975,"_5":15607,"_29907":61937,"_3297":61976},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3844":2432,"_33198":2418,"_22654":61978,"_5":15607,"_29907":61937,"_3297":61979},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3844":2433,"_33198":2418,"_22654":61981,"_5":15607,"_29907":61937,"_3297":61982},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3844":2434,"_33198":2418,"_22654":61984,"_5":15607,"_29907":61940,"_3297":61985},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3844":2435,"_33198":2418,"_22654":61987,"_5":15607,"_29907":61940,"_3297":61988},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3844":2436,"_33198":2418,"_22654":61990,"_5":15607,"_29907":61944,"_3297":61991},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3844":2437,"_33198":2418,"_22654":61993,"_5":15607,"_29907":61944,"_3297":61994},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3844":2438,"_33198":2418,"_22654":61996,"_5":15607,"_29907":61948,"_3297":61997},[],"Select **Root CA** and complete:",{"_3844":2439,"_33198":2418,"_22654":61999,"_5":15607,"_29907":61948,"_3297":62000},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3844":2440,"_33198":2418,"_22654":62002,"_5":15607,"_29907":61948,"_3297":62003},[],"**Subject**: organization and country details for your evaluation.",{"_3844":2441,"_33198":2418,"_22654":62005,"_5":15607,"_29907":61948,"_3297":62006},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3844":2442,"_33198":2418,"_22654":62008,"_5":15607,"_29907":61948,"_3297":62009},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3844":2443,"_33198":2418,"_22654":62011,"_5":15607,"_29907":61948,"_3297":62012},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3844":2444,"_33198":2418,"_22654":62014,"_5":15607,"_29907":61952,"_3297":62015},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3844":2445,"_33198":2418,"_22654":62017,"_5":15607,"_29907":61956,"_3297":62018},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3844":2446,"_33198":2418,"_22654":62020,"_5":15607,"_29907":61956,"_3297":62021},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3844":2447,"_33198":2418,"_22654":62023,"_5":15607,"_29907":61960,"_3297":62024},[],"Run from the directory where you saved `ca.pem`:",{"_3844":2448,"_33198":2418,"_22654":62026,"_5":15607,"_29907":61960,"_3297":62027},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3844":2449,"_33198":2418,"_22654":62029,"_5":15607,"_29907":61960,"_3297":62030},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3844":2450,"_33198":2418,"_22654":62032,"_5":15607,"_29907":61964,"_3297":62033},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3844":2451,"_33198":2418,"_22654":62035,"_5":15607,"_29907":61964,"_3297":62036},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3844":2452,"_33198":2418,"_22654":62038,"_5":15607,"_29907":61964,"_3297":62039},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3844":2453,"_33198":2418,"_22654":62041,"_5":15607,"_29907":61964,"_3297":62042},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3844":2454,"_33198":2418,"_22654":62044,"_5":15607,"_29907":61967,"_3297":62045},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3844":2455,"_33198":2455,"_5":16006,"_3297":62047,"_33604":62048,"_22654":62049,"_29907":2455},"Issue and verify a certificate",[54402,55870,59872,59309],[],{"_3844":2456,"_33198":2455,"_22654":62051,"_5":15607,"_29907":2455,"_3297":62052},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3844":2457,"_33198":2455,"_5":33601,"_22654":62054,"_29907":62055,"_3297":54412},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3844":2458,"_33198":2455,"_5":33601,"_22654":62057,"_29907":62058,"_3297":62059},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3844":2459,"_33198":2455,"_5":33601,"_22654":62061,"_29907":62062,"_3297":62063},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3844":2460,"_33198":2455,"_5":33601,"_22654":62065,"_29907":62066,"_3297":62067},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3844":2461,"_33198":2455,"_5":33601,"_22654":62069,"_29907":62070,"_3297":62071},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3844":2462,"_33198":2455,"_5":33601,"_22654":62073,"_29907":62074,"_3297":62075},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3844":2463,"_33198":2455,"_5":33601,"_22654":62077,"_29907":62078,"_3297":62079},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3844":2464,"_33198":2455,"_5":33601,"_22654":62081,"_29907":62082,"_3297":62083},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3844":2465,"_33198":2455,"_5":33601,"_22654":62085,"_29907":62086,"_3297":62087},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3844":2466,"_33198":2455,"_5":33601,"_22654":62089,"_29907":62090,"_3297":62091},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3844":2467,"_33198":2455,"_5":33601,"_22654":62093,"_29907":62094,"_3297":59566},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3844":2468,"_33198":2455,"_5":33601,"_22654":62096,"_29907":62097,"_3297":54436},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#next-step",{"_3844":2469,"_33198":2455,"_22654":62099,"_5":15607,"_29907":2455,"_3297":62100},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3844":2470,"_33198":2455,"_22654":62102,"_5":15607,"_29907":62055,"_3297":62103},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3844":2471,"_33198":2455,"_22654":62105,"_5":15607,"_29907":62055,"_3297":62106},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3844":2472,"_33198":2455,"_22654":62108,"_5":15607,"_29907":62055,"_3297":62109},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3844":2473,"_33198":2455,"_22654":62111,"_5":15607,"_29907":62055,"_3297":62112},[],"A client identifier: here we use `device-001`.",{"_3844":2474,"_33198":2455,"_22654":62114,"_5":15607,"_29907":62055,"_3297":62115},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3844":2475,"_33198":2455,"_22654":62117,"_5":15607,"_29907":62058,"_3297":62118},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3844":2476,"_33198":2455,"_22654":62120,"_5":15607,"_29907":62062,"_3297":62121},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3844":2477,"_33198":2455,"_22654":62123,"_5":15607,"_29907":62062,"_3297":62124},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3844":2478,"_33198":2455,"_22654":62126,"_5":15607,"_29907":62066,"_3297":62127},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3844":2479,"_33198":2455,"_22654":62129,"_5":15607,"_29907":62066,"_3297":62130},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3844":2480,"_33198":2455,"_22654":62132,"_5":15607,"_29907":62070,"_3297":62133},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3844":2481,"_33198":2455,"_22654":62135,"_5":15607,"_29907":62070,"_3297":62136},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3844":2482,"_33198":2455,"_22654":62138,"_5":15607,"_29907":62074,"_3297":62139},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3844":2483,"_33198":2455,"_22654":62141,"_5":15607,"_29907":62078,"_3297":62142},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3844":2484,"_33198":2455,"_22654":62144,"_5":15607,"_29907":62082,"_3297":62145},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3844":2485,"_33198":2455,"_22654":62147,"_5":15607,"_29907":62086,"_3297":62148},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3844":2486,"_33198":2455,"_22654":62150,"_5":15607,"_29907":62086,"_3297":62151},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3844":2487,"_33198":2455,"_22654":62153,"_5":15607,"_29907":62086,"_3297":62154},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3844":2488,"_33198":2455,"_22654":62156,"_5":15607,"_29907":62090,"_3297":62157},[],"In Bash, compare the two public-key digests:",{"_3844":2489,"_33198":2455,"_22654":62159,"_5":15607,"_29907":62090,"_3297":62160},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3844":2490,"_33198":2455,"_22654":62162,"_5":15607,"_29907":62090,"_3297":62163},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3844":2491,"_33198":2455,"_22654":62165,"_5":15607,"_29907":62094,"_3297":59650},[],{"_3844":2492,"_33198":2455,"_22654":62167,"_5":15607,"_29907":62094,"_3297":62168},[],"What to review",{"_3844":2493,"_33198":2455,"_22654":62170,"_5":15607,"_29907":62094,"_3297":62171},[],"The CA rejects issuance",{"_3844":2494,"_33198":2455,"_22654":62173,"_5":15607,"_29907":62094,"_3297":62174},[],"Permissions, CA state and key, algorithm and profile.",{"_3844":2495,"_33198":2455,"_22654":62176,"_5":15607,"_29907":62094,"_3297":62177},[],"Different subject or usages",{"_3844":2496,"_33198":2455,"_22654":62179,"_5":15607,"_29907":62094,"_3297":62180},[],"Applied profile and requested values.",{"_3844":2497,"_33198":2455,"_22654":62182,"_5":15607,"_29907":62094,"_3297":62183},[],"Issuer cannot be found",{"_3844":2498,"_33198":2455,"_22654":62185,"_5":15607,"_29907":62094,"_3297":62186},[],"Downloaded CA and required intermediate chain.",{"_3844":2499,"_33198":2455,"_22654":62188,"_5":15607,"_29907":62094,"_3297":62189},[],"Validity fails",{"_3844":2500,"_33198":2455,"_22654":62191,"_5":15607,"_29907":62094,"_3297":62192},[],"Certificate and CA dates, and the computer's clock.",{"_3844":2501,"_33198":2455,"_22654":62194,"_5":15607,"_29907":62094,"_3297":62195},[],"Public-key digests differ",{"_3844":2502,"_33198":2455,"_22654":62197,"_5":15607,"_29907":62094,"_3297":62198},[],"Certificate and key files from the same issuance.",{"_3844":2503,"_33198":2455,"_22654":62200,"_5":15607,"_29907":62094,"_3297":62201},[],"See PKI diagnostics to narrow an issuance failure.",{"_3844":2504,"_33198":2455,"_22654":62203,"_5":15607,"_29907":62097,"_3297":62204},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3844":2505,"_33198":2455,"_22654":62206,"_5":15607,"_29907":62097,"_3297":62207},[],"Manage certificates for inspection, status and revocation.",{"_3844":2506,"_33198":2455,"_22654":62209,"_5":15607,"_29907":62097,"_3297":62210},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3844":2507,"_33198":2455,"_22654":62212,"_5":15607,"_29907":62097,"_3297":62213},[],"Prepare EST for the device to request its next identities.",{"_3844":2508,"_33198":2455,"_22654":62215,"_5":15607,"_29907":62097,"_3297":62216},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3844":2509,"_33198":2509,"_5":16006,"_3297":62218,"_33604":62219,"_22654":62220,"_29907":2509},"PKI getting started",[54402,55870,59872,59309],[],{"_3844":2510,"_33198":2509,"_22654":62222,"_5":15607,"_29907":2509,"_3297":62223},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3844":2511,"_33198":2509,"_5":33601,"_22654":62225,"_29907":62226,"_3297":54412},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#before-you-begin",{"_3844":2512,"_33198":2509,"_5":33601,"_22654":62228,"_29907":62229,"_3297":62230},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3844":2513,"_33198":2509,"_5":33601,"_22654":62232,"_29907":62233,"_3297":59501},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#expected-result",{"_3844":2514,"_33198":2509,"_5":33601,"_22654":62235,"_29907":62236,"_3297":62237},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3844":2515,"_33198":2509,"_22654":62239,"_5":15607,"_29907":2509,"_3297":62240},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3844":2516,"_33198":2509,"_22654":62242,"_5":15607,"_29907":62226,"_3297":62243},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3844":2517,"_33198":2509,"_22654":62245,"_5":15607,"_29907":62226,"_3297":62246},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3844":2518,"_33198":2509,"_22654":62248,"_5":15607,"_29907":62226,"_3297":62249},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3844":2519,"_33198":2509,"_22654":62251,"_5":15607,"_29907":62226,"_3297":62252},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3844":2520,"_33198":2509,"_22654":62254,"_5":15607,"_29907":62226,"_3297":62255},[],"A working directory with restricted access for the downloaded key.",{"_3844":2521,"_33198":2509,"_22654":62257,"_5":15607,"_29907":62229,"_3297":62258},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3844":2522,"_33198":2509,"_22654":62260,"_5":15607,"_29907":62229,"_3297":62261},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3844":2523,"_33198":2509,"_22654":62263,"_5":15607,"_29907":62229,"_3297":62264},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3844":2524,"_33198":2509,"_22654":62266,"_5":15607,"_29907":62229,"_3297":62267},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3844":2525,"_33198":2509,"_22654":62269,"_5":15607,"_29907":62233,"_3297":62270},[],"File or resource",{"_3844":2526,"_33198":2509,"_22654":62272,"_5":15607,"_29907":62233,"_3297":59498},[],{"_3844":2527,"_33198":2509,"_22654":62274,"_5":15607,"_29907":62233,"_3297":62275},[],"Active root CA and `ca.pem`",{"_3844":2528,"_33198":2509,"_22654":62277,"_5":15607,"_29907":62233,"_3297":62278},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3844":2529,"_33198":2509,"_22654":62280,"_5":15607,"_29907":62233,"_3297":62281},[],"End-entity certificate and `device.crt`",{"_3844":2530,"_33198":2509,"_22654":62283,"_5":15607,"_29907":62233,"_3297":62284},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3844":2531,"_33198":2509,"_22654":62286,"_5":15607,"_29907":62233,"_3297":62287},[],"Private key `device.key`",{"_3844":2532,"_33198":2509,"_22654":62289,"_5":15607,"_29907":62233,"_3297":62290},[],"Its public key matches the one included in `device.crt`.",{"_3844":2533,"_33198":2509,"_22654":62292,"_5":15607,"_29907":62233,"_3297":62293},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3844":2534,"_33198":2509,"_22654":62295,"_5":15607,"_29907":62236,"_3297":62296},[],"To operate certificates, continue with Certificates and Validation.",{"_3844":2535,"_33198":2509,"_22654":62298,"_5":15607,"_29907":62236,"_3297":62299},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3844":2536,"_33198":2509,"_22654":62301,"_5":15607,"_29907":62236,"_3297":62302},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3844":2537,"_33198":2537,"_5":16006,"_3297":62304,"_33604":62305,"_22654":62306,"_29907":2537},"PKI troubleshooting",[54402,55870,59872,58447],[],{"_3844":2538,"_33198":2537,"_22654":62308,"_5":15607,"_29907":2537,"_3297":62309},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3844":2539,"_33198":2537,"_5":33601,"_22654":62311,"_29907":62312,"_3297":62313},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3844":2540,"_33198":2537,"_5":33601,"_22654":62315,"_29907":62316,"_3297":62317},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3844":2541,"_33198":2537,"_5":33601,"_22654":62319,"_29907":62320,"_3297":62321},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3844":2542,"_33198":2537,"_22654":62323,"_5":15607,"_29907":2537,"_3297":62324},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3844":2543,"_33198":2537,"_22654":62326,"_5":15607,"_29907":2537,"_3297":62327},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3844":2544,"_33198":2537,"_22654":62329,"_5":15607,"_29907":62312,"_3297":59498},[],{"_3844":2545,"_33198":2537,"_22654":62331,"_5":15607,"_29907":62312,"_3297":62332},[],"What to inspect",{"_3844":2546,"_33198":2537,"_22654":62334,"_5":15607,"_29907":62312,"_3297":54436},[],{"_3844":2547,"_33198":2537,"_22654":62336,"_5":15607,"_29907":62312,"_3297":58714},[],{"_3844":2548,"_33198":2537,"_22654":62338,"_5":15607,"_29907":62312,"_3297":62339},[],"Exists, is active and has usable dates.",{"_3844":2549,"_33198":2537,"_22654":62341,"_5":15607,"_29907":62312,"_3297":62342},[],"Authorities.",{"_3844":2550,"_33198":2537,"_22654":62344,"_5":15607,"_29907":62312,"_3297":62345},[],"Key",{"_3844":2551,"_33198":2537,"_22654":62347,"_5":15607,"_29907":62312,"_3297":62348},[],"The record has a usable private key and the engine can sign.",{"_3844":2552,"_33198":2537,"_22654":62350,"_5":15607,"_29907":62312,"_3297":62351},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3844":2553,"_33198":2537,"_22654":62353,"_5":15607,"_29907":62312,"_3297":62354},[],"CSR",{"_3844":2554,"_33198":2537,"_22654":62356,"_5":15607,"_29907":62312,"_3297":62357},[],"Correct PEM and verifiable signature.",{"_3844":2555,"_33198":2537,"_22654":62359,"_5":15607,"_29907":62312,"_3297":62360},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3844":2556,"_33198":2537,"_22654":62362,"_5":15607,"_29907":62312,"_3297":62363},[],"Profile",{"_3844":2557,"_33198":2537,"_22654":62365,"_5":15607,"_29907":62312,"_3297":62366},[],"Selected source, existing ID, allowed algorithm and size.",{"_3844":2558,"_33198":2537,"_22654":62368,"_5":15607,"_29907":62312,"_3297":62369},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3844":2559,"_33198":2537,"_22654":62371,"_5":15607,"_29907":62312,"_3297":59650},[],{"_3844":2560,"_33198":2537,"_22654":62373,"_5":15607,"_29907":62312,"_3297":62374},[],"Appropriate subject, SAN, usages and dates.",{"_3844":2561,"_33198":2537,"_22654":62376,"_5":15607,"_29907":62312,"_3297":62377},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3844":2562,"_33198":2537,"_22654":62379,"_5":15607,"_29907":62312,"_3297":62380},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3844":2563,"_33198":2537,"_22654":62382,"_5":15607,"_29907":62312,"_3297":62383},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3844":2564,"_33198":2537,"_22654":62385,"_5":15607,"_29907":62316,"_3297":62386},[],"Check each boundary independently:",{"_3844":2565,"_33198":2537,"_22654":62388,"_5":15607,"_29907":62316,"_3297":62389},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3844":2566,"_33198":2537,"_22654":62391,"_5":15607,"_29907":62316,"_3297":62392},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3844":2567,"_33198":2537,"_22654":62394,"_5":15607,"_29907":62316,"_3297":62395},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3844":2568,"_33198":2537,"_22654":62397,"_5":15607,"_29907":62316,"_3297":62398},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3844":2569,"_33198":2537,"_22654":62400,"_5":15607,"_29907":62316,"_3297":62401},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3844":2570,"_33198":2537,"_22654":62403,"_5":15607,"_29907":62316,"_3297":62404},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3844":2571,"_33198":2537,"_22654":62406,"_5":15607,"_29907":62320,"_3297":62407},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3844":2572,"_33198":2537,"_22654":62409,"_5":15607,"_29907":62320,"_3297":62410},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3844":2573,"_33198":2573,"_5":16006,"_3297":62412,"_33604":62413,"_22654":62416,"_29907":2573},"Algorithms",[54402,55870,62414,62415],"[Beta] Post-quantum (PQC)","Algorithms and toolchain",[],{"_3844":2574,"_33198":2573,"_22654":62418,"_5":15607,"_29907":2573,"_3297":62419},[],"The post-quantum and composite signature algorithms Lamassu supports, how each is identified in API requests, and the standards they follow.",{"_3844":2575,"_33198":2573,"_5":33601,"_22654":62421,"_29907":62422,"_3297":62423},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#how-an-algorithm-is-selected","How an algorithm is selected",{"_3844":2576,"_33198":2573,"_5":33601,"_22654":62425,"_29907":62426,"_3297":62427},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ml-dsa","ML-DSA",{"_3844":2577,"_33198":2573,"_5":33601,"_22654":62429,"_29907":62430,"_3297":62431},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#slh-dsa","SLH-DSA",{"_3844":2578,"_33198":2573,"_5":33601,"_22654":62433,"_29907":62434,"_3297":62435},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#composite-ml-dsa","Composite ML-DSA",{"_3844":2579,"_33198":2573,"_5":33601,"_22654":62437,"_29907":62438,"_3297":62439},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ed25519","Ed25519",{"_3844":2580,"_33198":2573,"_5":33601,"_22654":62441,"_29907":62442,"_3297":62443},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#what-is-not-covered","What is not covered",{"_3844":2581,"_33198":2573,"_22654":62445,"_5":15607,"_29907":2573,"_3297":62446},[],"Lamassu supports four groups of signature algorithms beyond RSA and ECDSA: ML-DSA, SLH-DSA, composite ML-DSA and Ed25519. All of them come from the Go PQC toolchain; the backend only selects the algorithm and delegates the cryptography.",{"_3844":2582,"_33198":2573,"_22654":62448,"_5":15607,"_29907":62422,"_3297":62449},[],"A key or CA is created with a key type and a size. For RSA and ECDSA the size is a bit length or a curve. For the post-quantum algorithms the same field carries a **parameter set identifier**, not a number of bits:",{"_3844":2583,"_33198":2573,"_22654":62451,"_5":15607,"_29907":62422,"_3297":62452},[],"Key type (`algorithm` / `type`)",{"_3844":2584,"_33198":2573,"_22654":62454,"_5":15607,"_29907":62422,"_3297":62455},[],"Value of `size` / `bits`",{"_3844":2585,"_33198":2573,"_22654":62457,"_5":15607,"_29907":62422,"_3297":56941},[],{"_3844":2586,"_33198":2573,"_22654":62459,"_5":15607,"_29907":62422,"_3297":62460},[],"`RSA`",{"_3844":2587,"_33198":2573,"_22654":62462,"_5":15607,"_29907":62422,"_3297":62463},[],"2048, 3072, 4096",{"_3844":2588,"_33198":2573,"_22654":62465,"_5":15607,"_29907":62422,"_3297":62466},[],"Modulus length in bits.",{"_3844":2589,"_33198":2573,"_22654":62468,"_5":15607,"_29907":62422,"_3297":62469},[],"`ECDSA`",{"_3844":2590,"_33198":2573,"_22654":62471,"_5":15607,"_29907":62422,"_3297":62472},[],"256, 384, 521",{"_3844":2591,"_33198":2573,"_22654":62474,"_5":15607,"_29907":62422,"_3297":62475},[],"Curve size in bits (P-256, P-384, P-521).",{"_3844":2592,"_33198":2573,"_22654":62477,"_5":15607,"_29907":62422,"_3297":62478},[],"`Ed25519`",{"_3844":2593,"_33198":2573,"_22654":62480,"_5":15607,"_29907":62422,"_3297":25572},[],{"_3844":2594,"_33198":2573,"_22654":62482,"_5":15607,"_29907":62422,"_3297":62483},[],"Fixed. Any other value is replaced by 256.",{"_3844":2595,"_33198":2573,"_22654":62485,"_5":15607,"_29907":62422,"_3297":62486},[],"`ML-DSA`",{"_3844":2596,"_33198":2573,"_22654":62488,"_5":15607,"_29907":62422,"_3297":62489},[],"44, 65, 87",{"_3844":2597,"_33198":2573,"_22654":62491,"_5":15607,"_29907":62422,"_3297":62492},[],"ML-DSA parameter set.",{"_3844":2598,"_33198":2573,"_22654":62494,"_5":15607,"_29907":62422,"_3297":62495},[],"`SLH-DSA`",{"_3844":2599,"_33198":2573,"_22654":62497,"_5":15607,"_29907":62422,"_3297":62498},[],"1 to 12",{"_3844":2600,"_33198":2573,"_22654":62500,"_5":15607,"_29907":62422,"_3297":62501},[],"SLH-DSA parameter set, in the order below.",{"_3844":2601,"_33198":2573,"_22654":62503,"_5":15607,"_29907":62422,"_3297":62504},[],"`Composite-ML-DSA-RSA`",{"_3844":2602,"_33198":2573,"_22654":62506,"_5":15607,"_29907":62422,"_3297":62507},[],"1 to 8",{"_3844":2603,"_33198":2573,"_22654":62509,"_5":15607,"_29907":62422,"_3297":62510},[],"Composite variant with an RSA component.",{"_3844":2604,"_33198":2573,"_22654":62512,"_5":15607,"_29907":62422,"_3297":62513},[],"`Composite-ML-DSA-ECDSA`",{"_3844":2605,"_33198":2573,"_22654":62515,"_5":15607,"_29907":62422,"_3297":62516},[],"9 to 13",{"_3844":2606,"_33198":2573,"_22654":62518,"_5":15607,"_29907":62422,"_3297":62519},[],"Composite variant with an ECDSA component.",{"_3844":2607,"_33198":2573,"_22654":62521,"_5":15607,"_29907":62422,"_3297":62522},[],"`Composite-ML-DSA-Ed25519`",{"_3844":2608,"_33198":2573,"_22654":62524,"_5":15607,"_29907":62422,"_3297":62525},[],"14 and 15",{"_3844":2609,"_33198":2573,"_22654":62527,"_5":15607,"_29907":62422,"_3297":62528},[],"Composite variant with an Ed25519 component.",{"_3844":2610,"_33198":2573,"_22654":62530,"_5":15607,"_29907":62422,"_3297":62531},[],"An unknown key type string is not rejected when it is parsed; it becomes an unknown type and fails later. Use the exact strings above.",{"_3844":2611,"_33198":2573,"_22654":62533,"_5":15607,"_29907":62426,"_3297":62534},[],"ML-DSA is the lattice-based signature scheme standardized in FIPS 204. Lamassu accepts the three parameter sets ML-DSA-44, ML-DSA-65 and ML-DSA-87, selected with `size` 44, 65 or 87. The implementation is the `crypto/mldsa` package of Go 1.27, so it is the standard library's own code and not part of the fork. In certificates the algorithm identifiers are `2.16.840.1.101.3.4.3.17`, `.18` and `.19` for ML-DSA-44, -65 and -87.",{"_3844":2612,"_33198":2573,"_22654":62536,"_5":15607,"_29907":62426,"_3297":62537},[],"Go reads ML-DSA private keys in PKCS#8 only when they contain the 32-byte seed. Keys written by OpenSSL in its default seed-plus-expanded form are rejected, so export them in the seed-only form before importing them.",{"_3844":2613,"_33198":2573,"_22654":62539,"_5":15607,"_29907":62430,"_3297":62540},[],"SLH-DSA is the hash-based scheme of FIPS 205. It offers twelve parameter sets that combine a hash family (SHA-2 or SHAKE), the parameter n of 128, 192 or 256 bits, which corresponds to NIST security categories 1, 3 and 5 and a trade-off between signature size and signing speed (`s` for small signatures, `f` for fast signing). The identifier written in `size` follows the order of the underlying library:",{"_3844":2614,"_33198":2573,"_22654":62542,"_5":15607,"_29907":62430,"_3297":62543},[],"ID",{"_3844":2615,"_33198":2573,"_22654":62545,"_5":15607,"_29907":62430,"_3297":62546},[],"Parameter set",{"_3844":2616,"_33198":2573,"_22654":62548,"_5":15607,"_29907":62430,"_3297":62543},[],{"_3844":2617,"_33198":2573,"_22654":62550,"_5":15607,"_29907":62430,"_3297":62546},[],{"_3844":2618,"_33198":2573,"_22654":62552,"_5":15607,"_29907":62430,"_3297":15694},[],{"_3844":2619,"_33198":2573,"_22654":62554,"_5":15607,"_29907":62430,"_3297":62555},[],"SLH-DSA-SHA2-128s",{"_3844":2620,"_33198":2573,"_22654":62557,"_5":15607,"_29907":62430,"_3297":15715},[],{"_3844":2621,"_33198":2573,"_22654":62559,"_5":15607,"_29907":62430,"_3297":62560},[],"SLH-DSA-SHA2-192f",{"_3844":2622,"_33198":2573,"_22654":62562,"_5":15607,"_29907":62430,"_3297":11301},[],{"_3844":2623,"_33198":2573,"_22654":62564,"_5":15607,"_29907":62430,"_3297":62565},[],"SLH-DSA-SHAKE-128s",{"_3844":2624,"_33198":2573,"_22654":62567,"_5":15607,"_29907":62430,"_3297":11166},[],{"_3844":2625,"_33198":2573,"_22654":62569,"_5":15607,"_29907":62430,"_3297":62570},[],"SLH-DSA-SHAKE-192f",{"_3844":2626,"_33198":2573,"_22654":62572,"_5":15607,"_29907":62430,"_3297":11245},[],{"_3844":2627,"_33198":2573,"_22654":62574,"_5":15607,"_29907":62430,"_3297":62575},[],"SLH-DSA-SHA2-128f",{"_3844":2628,"_33198":2573,"_22654":62577,"_5":15607,"_29907":62430,"_3297":28527},[],{"_3844":2629,"_33198":2573,"_22654":62579,"_5":15607,"_29907":62430,"_3297":62580},[],"SLH-DSA-SHA2-256s",{"_3844":2630,"_33198":2573,"_22654":62582,"_5":15607,"_29907":62430,"_3297":11150},[],{"_3844":2631,"_33198":2573,"_22654":62584,"_5":15607,"_29907":62430,"_3297":62585},[],"SLH-DSA-SHAKE-128f",{"_3844":2632,"_33198":2573,"_22654":62587,"_5":15607,"_29907":62430,"_3297":32341},[],{"_3844":2633,"_33198":2573,"_22654":62589,"_5":15607,"_29907":62430,"_3297":62590},[],"SLH-DSA-SHAKE-256s",{"_3844":2634,"_33198":2573,"_22654":62592,"_5":15607,"_29907":62430,"_3297":11376},[],{"_3844":2635,"_33198":2573,"_22654":62594,"_5":15607,"_29907":62430,"_3297":62595},[],"SLH-DSA-SHA2-192s",{"_3844":2636,"_33198":2573,"_22654":62597,"_5":15607,"_29907":62430,"_3297":32375},[],{"_3844":2637,"_33198":2573,"_22654":62599,"_5":15607,"_29907":62430,"_3297":62600},[],"SLH-DSA-SHA2-256f",{"_3844":2638,"_33198":2573,"_22654":62602,"_5":15607,"_29907":62430,"_3297":11158},[],{"_3844":2639,"_33198":2573,"_22654":62604,"_5":15607,"_29907":62430,"_3297":62605},[],"SLH-DSA-SHAKE-192s",{"_3844":2640,"_33198":2573,"_22654":62607,"_5":15607,"_29907":62430,"_3297":31849},[],{"_3844":2641,"_33198":2573,"_22654":62609,"_5":15607,"_29907":62430,"_3297":62610},[],"SLH-DSA-SHAKE-256f",{"_3844":2642,"_33198":2573,"_22654":62612,"_5":15607,"_29907":62430,"_3297":62613},[],"The object identifiers run from `2.16.840.1.101.3.4.3.20` to `.31`. SLH-DSA signatures are large, between about 8 and 50 KB depending on the parameter set, which matters for certificate chains and for any transport with a size limit. SLH-DSA is available for keys, CAs and certificates, but the fork has no TLS signature scheme for it, so an SLH-DSA certificate cannot authenticate a TLS connection.",{"_3844":2643,"_33198":2573,"_22654":62615,"_5":15607,"_29907":62434,"_3297":62616},[],"A composite key pairs an ML-DSA key with a traditional key. A composite signature is the concatenation of the ML-DSA signature and the traditional signature, both computed over a message representative that contains a fixed prefix, an algorithm label, an optional context and a hash of the message; verification fails if either component fails. The ML-DSA component is pure ML-DSA, with the label as its context. Lamassu implements the 15 algorithms of draft 19 of the IETF specification that rely only on algorithms available in Go. The identifiers sit under the arc `1.3.6.1.5.5.7.6`.",{"_3844":2644,"_33198":2573,"_22654":62618,"_5":15607,"_29907":62434,"_3297":62619},[],"`size`",{"_3844":2645,"_33198":2573,"_22654":62621,"_5":15607,"_29907":62434,"_3297":62622},[],"Algorithm",{"_3844":2646,"_33198":2573,"_22654":62624,"_5":15607,"_29907":62434,"_3297":62625},[],"Final OID digit",{"_3844":2647,"_33198":2573,"_22654":62627,"_5":15607,"_29907":62434,"_3297":62628},[],"Family",{"_3844":2648,"_33198":2573,"_22654":62630,"_5":15607,"_29907":62434,"_3297":15694},[],{"_3844":2649,"_33198":2573,"_22654":62632,"_5":15607,"_29907":62434,"_3297":62633},[],"MLDSA44-RSA2048-PSS-SHA256",{"_3844":2650,"_33198":2573,"_22654":62635,"_5":15607,"_29907":62434,"_3297":33072},[],{"_3844":2651,"_33198":2573,"_22654":62637,"_5":15607,"_29907":62434,"_3297":62638},[],"RSA",{"_3844":2652,"_33198":2573,"_22654":62640,"_5":15607,"_29907":62434,"_3297":11301},[],{"_3844":2653,"_33198":2573,"_22654":62642,"_5":15607,"_29907":62434,"_3297":62643},[],"MLDSA44-RSA2048-PKCS15-SHA256",{"_3844":2654,"_33198":2573,"_22654":62645,"_5":15607,"_29907":62434,"_3297":33045},[],{"_3844":2655,"_33198":2573,"_22654":62647,"_5":15607,"_29907":62434,"_3297":62638},[],{"_3844":2656,"_33198":2573,"_22654":62649,"_5":15607,"_29907":62434,"_3297":11245},[],{"_3844":2657,"_33198":2573,"_22654":62651,"_5":15607,"_29907":62434,"_3297":62652},[],"MLDSA65-RSA3072-PSS-SHA512",{"_3844":2658,"_33198":2573,"_22654":62654,"_5":15607,"_29907":62434,"_3297":31960},[],{"_3844":2659,"_33198":2573,"_22654":62656,"_5":15607,"_29907":62434,"_3297":62638},[],{"_3844":2660,"_33198":2573,"_22654":62658,"_5":15607,"_29907":62434,"_3297":11150},[],{"_3844":2661,"_33198":2573,"_22654":62660,"_5":15607,"_29907":62434,"_3297":62661},[],"MLDSA65-RSA3072-PKCS15-SHA512",{"_3844":2662,"_33198":2573,"_22654":62663,"_5":15607,"_29907":62434,"_3297":31966},[],{"_3844":2663,"_33198":2573,"_22654":62665,"_5":15607,"_29907":62434,"_3297":62638},[],{"_3844":2664,"_33198":2573,"_22654":62667,"_5":15607,"_29907":62434,"_3297":11376},[],{"_3844":2665,"_33198":2573,"_22654":62669,"_5":15607,"_29907":62434,"_3297":62670},[],"MLDSA65-RSA4096-PSS-SHA512",{"_3844":2666,"_33198":2573,"_22654":62672,"_5":15607,"_29907":62434,"_3297":31972},[],{"_3844":2667,"_33198":2573,"_22654":62674,"_5":15607,"_29907":62434,"_3297":62638},[],{"_3844":2668,"_33198":2573,"_22654":62676,"_5":15607,"_29907":62434,"_3297":11158},[],{"_3844":2669,"_33198":2573,"_22654":62678,"_5":15607,"_29907":62434,"_3297":62679},[],"MLDSA65-RSA4096-PKCS15-SHA512",{"_3844":2670,"_33198":2573,"_22654":62681,"_5":15607,"_29907":62434,"_3297":11153},[],{"_3844":2671,"_33198":2573,"_22654":62683,"_5":15607,"_29907":62434,"_3297":62638},[],{"_3844":2672,"_33198":2573,"_22654":62685,"_5":15607,"_29907":62434,"_3297":15715},[],{"_3844":2673,"_33198":2573,"_22654":62687,"_5":15607,"_29907":62434,"_3297":62688},[],"MLDSA87-RSA3072-PSS-SHA512",{"_3844":2674,"_33198":2573,"_22654":62690,"_5":15607,"_29907":62434,"_3297":31854},[],{"_3844":2675,"_33198":2573,"_22654":62692,"_5":15607,"_29907":62434,"_3297":62638},[],{"_3844":2676,"_33198":2573,"_22654":62694,"_5":15607,"_29907":62434,"_3297":11166},[],{"_3844":2677,"_33198":2573,"_22654":62696,"_5":15607,"_29907":62434,"_3297":62697},[],"MLDSA87-RSA4096-PSS-SHA512",{"_3844":2678,"_33198":2573,"_22654":62699,"_5":15607,"_29907":62434,"_3297":31876},[],{"_3844":2679,"_33198":2573,"_22654":62701,"_5":15607,"_29907":62434,"_3297":62638},[],{"_3844":2680,"_33198":2573,"_22654":62703,"_5":15607,"_29907":62434,"_3297":28527},[],{"_3844":2681,"_33198":2573,"_22654":62705,"_5":15607,"_29907":62434,"_3297":62706},[],"MLDSA44-ECDSA-P256-SHA256",{"_3844":2682,"_33198":2573,"_22654":62708,"_5":15607,"_29907":62434,"_3297":31912},[],{"_3844":2683,"_33198":2573,"_22654":62710,"_5":15607,"_29907":62434,"_3297":62711},[],"ECDSA",{"_3844":2684,"_33198":2573,"_22654":62713,"_5":15607,"_29907":62434,"_3297":32341},[],{"_3844":2685,"_33198":2573,"_22654":62715,"_5":15607,"_29907":62434,"_3297":62716},[],"MLDSA65-ECDSA-P256-SHA512",{"_3844":2686,"_33198":2573,"_22654":62718,"_5":15607,"_29907":62434,"_3297":31978},[],{"_3844":2687,"_33198":2573,"_22654":62720,"_5":15607,"_29907":62434,"_3297":62711},[],{"_3844":2688,"_33198":2573,"_22654":62722,"_5":15607,"_29907":62434,"_3297":32375},[],{"_3844":2689,"_33198":2573,"_22654":62724,"_5":15607,"_29907":62434,"_3297":62725},[],"MLDSA65-ECDSA-P384-SHA512",{"_3844":2690,"_33198":2573,"_22654":62727,"_5":15607,"_29907":62434,"_3297":31984},[],{"_3844":2691,"_33198":2573,"_22654":62729,"_5":15607,"_29907":62434,"_3297":62711},[],{"_3844":2692,"_33198":2573,"_22654":62731,"_5":15607,"_29907":62434,"_3297":31849},[],{"_3844":2693,"_33198":2573,"_22654":62733,"_5":15607,"_29907":62434,"_3297":62734},[],"MLDSA87-ECDSA-P384-SHA512",{"_3844":2694,"_33198":2573,"_22654":62736,"_5":15607,"_29907":62434,"_3297":31990},[],{"_3844":2695,"_33198":2573,"_22654":62738,"_5":15607,"_29907":62434,"_3297":62711},[],{"_3844":2696,"_33198":2573,"_22654":62740,"_5":15607,"_29907":62434,"_3297":32441},[],{"_3844":2697,"_33198":2573,"_22654":62742,"_5":15607,"_29907":62434,"_3297":62743},[],"MLDSA87-ECDSA-P521-SHA512",{"_3844":2698,"_33198":2573,"_22654":62745,"_5":15607,"_29907":62434,"_3297":31882},[],{"_3844":2699,"_33198":2573,"_22654":62747,"_5":15607,"_29907":62434,"_3297":62711},[],{"_3844":2700,"_33198":2573,"_22654":62749,"_5":15607,"_29907":62434,"_3297":32030},[],{"_3844":2701,"_33198":2573,"_22654":62751,"_5":15607,"_29907":62434,"_3297":62752},[],"MLDSA44-Ed25519-SHA512",{"_3844":2702,"_33198":2573,"_22654":62754,"_5":15607,"_29907":62434,"_3297":33078},[],{"_3844":2703,"_33198":2573,"_22654":62756,"_5":15607,"_29907":62434,"_3297":62439},[],{"_3844":2704,"_33198":2573,"_22654":62758,"_5":15607,"_29907":62434,"_3297":32447},[],{"_3844":2705,"_33198":2573,"_22654":62760,"_5":15607,"_29907":62434,"_3297":62761},[],"MLDSA65-Ed25519-SHA512",{"_3844":2706,"_33198":2573,"_22654":62763,"_5":15607,"_29907":62434,"_3297":31954},[],{"_3844":2707,"_33198":2573,"_22654":62765,"_5":15607,"_29907":62434,"_3297":62439},[],{"_3844":2708,"_33198":2573,"_22654":62767,"_5":15607,"_29907":62434,"_3297":62768},[],"The key type must match the family of the variant: creating a `Composite-ML-DSA-ECDSA` key with `size` 3 fails with an error saying that the variant is not valid for that key type.",{"_3844":2709,"_33198":2573,"_22654":62770,"_5":15607,"_29907":62434,"_3297":62771},[],"Draft 19 has since been published as RFC 10073. The object identifiers and the domain separator prefix checked against the RFC match this page, but the implementation was written and tested against the draft and has not been compared with the final text. Three algorithms of the specification are not implemented because Go has no Brainpool curves and no Ed448: the two Brainpool variants (`MLDSA65-ECDSA-brainpoolP256r1` and `MLDSA87-ECDSA-brainpoolP384r1`, with their hash suffix) and the Ed448 variant. The fork passes the official test vectors of draft 19 for the 15 algorithms it does implement.",{"_3844":2710,"_33198":2573,"_22654":62773,"_5":15607,"_29907":62434,"_3297":62774},[],"The composite parameters of keys and signatures must be absent from the `AlgorithmIdentifier`; certificates that carry them are rejected. ECDSA components must use a private scalar of the exact length of the curve.",{"_3844":2711,"_33198":2573,"_22654":62776,"_5":15607,"_29907":62438,"_3297":62777},[],"Ed25519 is not post-quantum, but support for it as a CA and certificate key type was added in the same work and is selected with the `Ed25519` key type. It is classified in the traditional family.",{"_3844":2712,"_33198":2573,"_22654":62779,"_5":15607,"_29907":62442,"_3297":62780},[],"Lamassu does not implement post-quantum key exchange of its own. The hybrid key exchanges offered by the TLS endpoint, such as `X25519MLKEM768`, are those of the Go 1.27 standard library. The Chameleon and delta-certificate designs explored in earlier iterations were removed and are not part of the implementation.",{"_3844":2713,"_33198":2573,"_22654":62782,"_5":15607,"_29907":62442,"_3297":62783},[],"<Card title=\"Go PQC toolchain\" description=\"The fork that implements these algorithms and the API it adds.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_3844":2714,"_33198":2573,"_22654":62785,"_5":15607,"_29907":62442,"_3297":62786},[],"<Card title=\"Keys and certificate authorities\" description=\"Use these parameters in KMS and CA requests.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3844":2715,"_33198":2715,"_5":16006,"_3297":62788,"_33604":62789,"_22654":62791,"_29907":2715},"Dashboard",[54402,55870,62414,62790],"Platform support",[],{"_3844":2716,"_33198":2715,"_22654":62793,"_5":15607,"_29907":2715,"_3297":62794},[],"How the web interface exposes post-quantum algorithms when creating keys, CAs and certificates, and how it displays them.",{"_3844":2717,"_33198":2715,"_5":33601,"_22654":62796,"_29907":62797,"_3297":62798},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#choosing-a-key-type-and-specification","Choosing a key type and specification",{"_3844":2718,"_33198":2715,"_5":33601,"_22654":62800,"_29907":62801,"_3297":62802},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#issuing-a-certificate-with-a-browser-generated-key","Issuing a certificate with a browser-generated key",{"_3844":2719,"_33198":2715,"_5":33601,"_22654":62804,"_29907":62805,"_3297":62806},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#how-objects-are-displayed","How objects are displayed",{"_3844":2720,"_33198":2715,"_5":33601,"_22654":62808,"_29907":62809,"_3297":62810},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#related-certificates","Related certificates",{"_3844":2721,"_33198":2715,"_5":33601,"_22654":62812,"_29907":62813,"_3297":62814},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#things-to-know","Things to know",{"_3844":2722,"_33198":2715,"_22654":62816,"_5":15607,"_29907":2715,"_3297":62817},[],"The dashboard (branch `feat/lamassu-q`) lets an administrator create and inspect post-quantum keys, certificate authorities and certificates without writing API requests. It adds the algorithm choices, shows the algorithm family of every object and parses the new identifiers in certificates. Everything it sends is described in Keys and certificate authorities; this page covers what the interface shows and where its behaviour differs between screens.",{"_3844":2723,"_33198":2715,"_22654":62819,"_5":15607,"_29907":62797,"_3297":62820},[],"Creating a KMS key, a CA with a new key and a certificate with a server-generated key all use the same pair of selectors. *Key type* is grouped by family and *Key specification* depends on the type.",{"_3844":2724,"_33198":2715,"_22654":62822,"_5":15607,"_29907":62797,"_3297":62823},[],"Group",{"_3844":2725,"_33198":2715,"_22654":62825,"_5":15607,"_29907":62797,"_3297":62826},[],"Key types",{"_3844":2726,"_33198":2715,"_22654":62828,"_5":15607,"_29907":62797,"_3297":62829},[],"T (Traditional)",{"_3844":2727,"_33198":2715,"_22654":62831,"_5":15607,"_29907":62797,"_3297":62832},[],"`RSA`, `ECDSA`, `Ed25519`",{"_3844":2728,"_33198":2715,"_22654":62834,"_5":15607,"_29907":62797,"_3297":62835},[],"PQ (Pure PQC)",{"_3844":2729,"_33198":2715,"_22654":62837,"_5":15607,"_29907":62797,"_3297":62838},[],"`ML-DSA`, `SLH-DSA`",{"_3844":2730,"_33198":2715,"_22654":62840,"_5":15607,"_29907":62797,"_3297":62841},[],"PQ/T (Hybrid)",{"_3844":2731,"_33198":2715,"_22654":62843,"_5":15607,"_29907":62797,"_3297":62844},[],"`Composite-ML-DSA-RSA`, `Composite-ML-DSA-ECDSA`, `Composite-ML-DSA-Ed25519`",{"_3844":2732,"_33198":2715,"_22654":62846,"_5":15607,"_29907":62797,"_3297":62847},[],"The specification list shows ML-DSA-44, -65 or -87, the twelve SLH-DSA parameter sets (for example *4 - SHAKE\\_128f*) or the composite variants by name. The interface sends the identifier of the parameter set as `size`, as explained in Algorithms, and shows a strength indicator next to each option. For composite keys the indicator shows two bars, one for the classical component and one for the post-quantum component.",{"_3844":2733,"_33198":2715,"_22654":62849,"_5":15607,"_29907":62797,"_3297":62850},[],"Which options are enabled depends on the crypto engine. When creating a key or a CA, the interface lists every algorithm but disables those that the selected engine does not support, and asks to select an engine first. When creating a certificate on the server, unsupported types are hidden instead.",{"_3844":2734,"_33198":2715,"_22654":62852,"_5":15607,"_29907":62801,"_3297":62853},[],"Issuing a certificate from a CA generates the key pair in the browser, builds the certificate request and sends it to the CA for signing. The key types offered here are `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` and a single `Composite ML-DSA` entry, and they are generated with the `@noble` libraries for the post-quantum and composite algorithms and with WebCrypto for the classical ones. The generated private key is shown once at the end of the procedure.",{"_3844":2735,"_33198":2715,"_22654":62855,"_5":15607,"_29907":62801,"_3297":62856},[],"The browser does not verify the signatures of ML-DSA, SLH-DSA, composite or Ed25519 requests; it relies on the KMS.",{"_3844":2736,"_33198":2715,"_22654":62858,"_5":15607,"_29907":62805,"_3297":62859},[],"Lists and detail views show the algorithm family. The CA table has a *PQC* column with T, PQ or PQ/T, CA cards and the CA graph show a *PQC* badge, key lists show a quantum icon, and the details of a CA or certificate show the algorithm, its strength and the family badge. The family is computed from the algorithm identifier in the parsed certificate.",{"_3844":2737,"_33198":2715,"_22654":62861,"_5":15607,"_29907":62805,"_3297":62862},[],"Algorithm names are resolved from the object identifiers. ML-DSA, SLH-DSA, composite and Ed25519 identifiers are shown as names with their parameter set, for example *ML-DSA-65* or *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, and no bit length is shown for them. RSA and ECDSA signature algorithms are displayed with the dashboard's own labels, such as *RSA PKCS#1 v1.5 SHA-256* and *ECDSA SHA-256*, instead of the OpenSSL names `sha256WithRSAEncryption` and `ecdsa-with-SHA256`.",{"_3844":2738,"_33198":2715,"_22654":62864,"_5":15607,"_29907":62805,"_3297":62865},[],"The key detail page can sign and verify with a post-quantum key and enables only the signature algorithm that corresponds to it.",{"_3844":2739,"_33198":2715,"_22654":62867,"_5":15607,"_29907":62809,"_3297":62868},[],"The issuance profile form, the issue-certificate form and the detail pages include the related-certificate controls described in Related certificates.",{"_3844":2740,"_33198":2715,"_22654":62870,"_5":15607,"_29907":62813,"_3297":62871},[],"The key type names are not identical across all screens. Key and CA creation use `Composite-ML-DSA-RSA`, `-ECDSA` and `-Ed25519`; the issue-certificate form uses a single `Composite-ML-DSA`; and the server-side certificate form compares upper-case names. The names that the backend reports for a key may therefore differ in case from what the interface submits.",{"_3844":2741,"_33198":2715,"_22654":62873,"_5":15607,"_29907":62813,"_3297":62874},[],"The interface carries no experimental warning for these algorithms and has no translation: all texts are in English.",{"_3844":2742,"_33198":2715,"_22654":62876,"_5":15607,"_29907":62813,"_3297":62877},[],"The mapping from the SLH-DSA parameter set identifier to the algorithm used by the in-browser key generator does not follow the same order as the identifiers shown in the selector and used by the backend, except for identifier 1. A certificate issued through the browser flow with an SLH-DSA identifier from 2 to 12 may therefore use a different parameter set than the one named in the selector. Create SLH-DSA keys with the KMS until this is corrected.",{"_3844":2743,"_33198":2715,"_22654":62879,"_5":15607,"_29907":62813,"_3297":62880},[],"<Card title=\"Keys and certificate authorities\" description=\"The API behind these screens.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3844":2744,"_33198":2715,"_22654":62882,"_5":15607,"_29907":62813,"_3297":62883},[],"<Card title=\"Known limitations\" description=\"Gaps in the interface and the platform.\" href=\"/docs/platform/pqc/limitations\" />",{"_3844":2745,"_33198":2745,"_5":16006,"_3297":62885,"_33604":62886,"_22654":62887,"_29907":2745},"Deployment with the Helm chart",[54402,55870,62414,54403],[],{"_3844":2746,"_33198":2745,"_22654":62889,"_5":15607,"_29907":2745,"_3297":62890},[],"Deploy Lamassu with a Traefik front proxy that serves classical, post-quantum and composite certificates, using the chart values or the fast-lane installer.",{"_3844":2747,"_33198":2745,"_5":33601,"_22654":62892,"_29907":62893,"_3297":62894},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#topology","Topology",{"_3844":2748,"_33198":2745,"_5":33601,"_22654":62896,"_29907":62897,"_3297":62898},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#chart-values","Chart values",{"_3844":2749,"_33198":2745,"_5":33601,"_22654":62900,"_29907":62901,"_3297":62902},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#the-fast-lane-installer","The fast-lane installer",{"_3844":2750,"_33198":2745,"_22654":62904,"_5":15607,"_29907":2745,"_3297":62905},[],"The `pqc` branch of the Lamassu Helm chart adds a front proxy: a Traefik instance built with the Go PQC toolchain that terminates the devices' TLS, authenticates them and forwards the traffic to Envoy Gateway. This page describes the resulting topology, the values that control it and the installer that automates a laboratory deployment.",{"_3844":2751,"_33198":2745,"_22654":62907,"_5":15607,"_29907":2745,"_3297":62908},[],"The chart and the installer assume a development cluster. The proxy image uses a mutable tag, the PQC certificates are not renewed automatically and the hop between Traefik and Envoy does not verify certificates. Do not use this configuration as it is for production.",{"_3844":2752,"_33198":2745,"_22654":62910,"_5":15607,"_29907":62893,"_3297":62911},[],"Traefik is the public edge. It negotiates the key exchange, serves the certificate and, if requested, receives the client certificate. It then opens a second TLS connection to the `envoy-gateway-proxy` service of Envoy Gateway, which presents the chart's self-signed classical certificate; Traefik is configured to accept it without verifying it. Envoy therefore never sees a post-quantum handshake, and the post-quantum protection covers only the connection between the client and Traefik. Traefik and Envoy Gateway are installed once per cluster and shared across namespaces, whereas the front proxy resources (the Gateway, route, middleware, certificate and reference grant) belong to the Lamassu release.",{"_3844":2753,"_33198":2745,"_22654":62913,"_5":15607,"_29907":62893,"_3297":62914},[],"When the client sent a certificate, the `inject-client-cert` middleware of the chart adds it, in PEM form, to the `X-Forwarded-Tls-Client-Cert` header, and the `X-Forwarded-Proto: https` header is set on the request.",{"_3844":2754,"_33198":2745,"_22654":62916,"_5":15607,"_29907":62897,"_3297":62917},[],"All the new values are under `traefikFrontProxy` and are validated by the chart's schema, which rejects unknown keys.",{"_3844":2755,"_33198":2745,"_22654":62919,"_5":15607,"_29907":62897,"_3297":62920},[],"Name",{"_3844":2756,"_33198":2745,"_22654":62922,"_5":15607,"_29907":62897,"_3297":58554},[],{"_3844":2757,"_33198":2745,"_22654":62924,"_5":15607,"_29907":62897,"_3297":54789},[],{"_3844":2758,"_33198":2745,"_22654":62926,"_5":15607,"_29907":62897,"_3297":58560},[],{"_3844":2759,"_33198":2745,"_22654":62928,"_5":15607,"_29907":62897,"_3297":62929},[],"`traefikFrontProxy.enabled`",{"_3844":2760,"_33198":2745,"_22654":62931,"_5":15607,"_29907":62897,"_3297":21314},[],{"_3844":2761,"_33198":2745,"_22654":62933,"_5":15607,"_29907":62897,"_3297":62934},[],"`false`",{"_3844":2762,"_33198":2745,"_22654":62936,"_5":15607,"_29907":62897,"_3297":62937},[],"Deploys the front proxy resources.",{"_3844":2763,"_33198":2745,"_22654":62939,"_5":15607,"_29907":62897,"_3297":62940},[],"`traefikFrontProxy.domain`",{"_3844":2764,"_33198":2745,"_22654":62942,"_5":15607,"_29907":62897,"_3297":27123},[],{"_3844":2765,"_33198":2745,"_22654":62944,"_5":15607,"_29907":62897,"_3297":62945},[],"`\"\"`",{"_3844":2766,"_33198":2745,"_22654":62947,"_5":15607,"_29907":62897,"_3297":62948},[],"Name of the edge certificate and host name of the route. Set it when the proxy is enabled.",{"_3844":2767,"_33198":2745,"_22654":62950,"_5":15607,"_29907":62897,"_3297":62951},[],"`traefikFrontProxy.webSecurePort`",{"_3844":2768,"_33198":2745,"_22654":62953,"_5":15607,"_29907":62897,"_3297":17669},[],{"_3844":2769,"_33198":2745,"_22654":62955,"_5":15607,"_29907":62897,"_3297":62956},[],"`8443`",{"_3844":2770,"_33198":2745,"_22654":62958,"_5":15607,"_29907":62897,"_3297":62959},[],"Port of the HTTPS listener; it must match Traefik's `websecure` entry point.",{"_3844":2771,"_33198":2745,"_22654":62961,"_5":15607,"_29907":62897,"_3297":62962},[],"`traefikFrontProxy.tls.type`",{"_3844":2772,"_33198":2745,"_22654":62964,"_5":15607,"_29907":62897,"_3297":27123},[],{"_3844":2773,"_33198":2745,"_22654":62966,"_5":15607,"_29907":62897,"_3297":62967},[],"`certManager`",{"_3844":2774,"_33198":2745,"_22654":62969,"_5":15607,"_29907":62897,"_3297":62970},[],"Source of the classical certificate: `certManager`, `external` or `none`.",{"_3844":2775,"_33198":2745,"_22654":62972,"_5":15607,"_29907":62897,"_3297":62973},[],"`traefikFrontProxy.tls.certManagerOptions.addresses`",{"_3844":2776,"_33198":2745,"_22654":62975,"_5":15607,"_29907":62897,"_3297":16512},[],{"_3844":2777,"_33198":2745,"_22654":62977,"_5":15607,"_29907":62897,"_3297":62978},[],"`[]`",{"_3844":2778,"_33198":2745,"_22654":62980,"_5":15607,"_29907":62897,"_3297":62981},[],"IP addresses added to the self-signed certificate.",{"_3844":2779,"_33198":2745,"_22654":62983,"_5":15607,"_29907":62897,"_3297":62984},[],"`traefikFrontProxy.tls.externalOptions.secretName`",{"_3844":2780,"_33198":2745,"_22654":62986,"_5":15607,"_29907":62897,"_3297":27123},[],{"_3844":2781,"_33198":2745,"_22654":62988,"_5":15607,"_29907":62897,"_3297":62945},[],{"_3844":2782,"_33198":2745,"_22654":62990,"_5":15607,"_29907":62897,"_3297":62991},[],"Secret with `tls.crt` and `tls.key` when the type is `external`.",{"_3844":2783,"_33198":2745,"_22654":62993,"_5":15607,"_29907":62897,"_3297":62994},[],"`traefikFrontProxy.tls.additionalSecretNames`",{"_3844":2784,"_33198":2745,"_22654":62996,"_5":15607,"_29907":62897,"_3297":16512},[],{"_3844":2785,"_33198":2745,"_22654":62998,"_5":15607,"_29907":62897,"_3297":62978},[],{"_3844":2786,"_33198":2745,"_22654":63000,"_5":15607,"_29907":62897,"_3297":63001},[],"Extra TLS secrets, for example ML-DSA or composite certificates, served on the same listener.",{"_3844":2787,"_33198":2745,"_22654":63003,"_5":15607,"_29907":62897,"_3297":63004},[],"With `certManager`, the chart requests an ECDSA P-256 certificate valid for 2160 hours from its own self-signed issuer and stores it in the secret `edge-cert`. With `none`, only the additional secrets are served, and the chart stops with an error if there are none. The proxy chooses among all the certificates according to the client, as described in TLS front proxy with Traefik. The names of the resources the chart creates are fixed, so only one release per namespace is supported.",{"_3844":2788,"_33198":2745,"_22654":63006,"_5":15607,"_29907":62897,"_3297":63007},[],"The chart also changes the Envoy Gateway service so that its HTTPS port declares `appProtocol: https`, which recent Traefik versions require in order to speak TLS to it. When `gateway.addresses` is empty, the Envoy service is a `ClusterIP` instead of a load balancer.",{"_3844":2789,"_33198":2745,"_22654":63009,"_5":15607,"_29907":62897,"_3297":63010},[],"The chart does not deploy Traefik itself, the `traefik` GatewayClass, or the `default` TLS option in the `traefik-system` namespace; the installer creates them. Without them, the edge has no post-quantum key exchange and no client-certificate request. The chart also does not set the Lamassu service images: the defaults are the development images, and the installer overrides the UI, CA, KMS, VA, device manager, DMS manager, alerts and authorization images with the `:pqc` tags of `ghcr.io/lamassuiot`.",{"_3844":2790,"_33198":2745,"_22654":63012,"_5":15607,"_29907":62901,"_3297":63013},[],"`scripts/lamassu-fast-lane.sh` installs everything on a cluster: the Gateway API custom resource definitions (version 1.6.3, experimental channel), Envoy Gateway 1.8.0, the Traefik chart 41.0.2 with the PQC image, the TLS option, PostgreSQL, Keycloak, RabbitMQ, optionally observability and SoftHSM, and finally the Lamassu release. The two flags that matter here select which algorithms are offered.",{"_3844":2791,"_33198":2745,"_22654":63015,"_5":15607,"_29907":62901,"_3297":63016},[],"Both flags take a comma-separated list of `T`, `PQ` and `PQ/T`, and both default to all three. For the key exchange, `PQ/T` is a hybrid group that combines a classical and an ML-KEM exchange (`X25519MLKEM768`, `SecP256r1MLKEM768` and `SecP384r1MLKEM1024`) and `PQ` is pure ML-KEM (`MLKEM1024`); for authentication, `PQ/T` is a composite certificate. `--tls-kex` fills the `curvePreferences` of the TLS option, and `--tls-auth` selects which certificates are served:",{"_3844":2792,"_33198":2745,"_22654":63018,"_5":15607,"_29907":62901,"_3297":63019},[],"Value",{"_3844":2793,"_33198":2745,"_22654":63021,"_5":15607,"_29907":62901,"_3297":63022},[],"Key exchange groups",{"_3844":2794,"_33198":2745,"_22654":63024,"_5":15607,"_29907":62901,"_3297":58765},[],{"_3844":2795,"_33198":2745,"_22654":63026,"_5":15607,"_29907":62901,"_3297":63027},[],"`T`",{"_3844":2796,"_33198":2745,"_22654":63029,"_5":15607,"_29907":62901,"_3297":63030},[],"`X25519`, `CurveP256`, `CurveP384`",{"_3844":2797,"_33198":2745,"_22654":63032,"_5":15607,"_29907":62901,"_3297":63033},[],"cert-manager ECDSA P-256, or the files given with `--tls-crt` and `--tls-key`, in the secret `edge-cert`.",{"_3844":2798,"_33198":2745,"_22654":63035,"_5":15607,"_29907":62901,"_3297":63036},[],"`PQ`",{"_3844":2799,"_33198":2745,"_22654":63038,"_5":15607,"_29907":62901,"_3297":63039},[],"`MLKEM1024`",{"_3844":2800,"_33198":2745,"_22654":63041,"_5":15607,"_29907":62901,"_3297":63042},[],"ML-DSA-65, in the secret `edge-cert-pq`.",{"_3844":2801,"_33198":2745,"_22654":63044,"_5":15607,"_29907":62901,"_3297":63045},[],"`PQ/T`",{"_3844":2802,"_33198":2745,"_22654":63047,"_5":15607,"_29907":62901,"_3297":63048},[],"`X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024`",{"_3844":2803,"_33198":2745,"_22654":63050,"_5":15607,"_29907":62901,"_3297":63051},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, in the secret `edge-cert-pqt`.",{"_3844":2804,"_33198":2745,"_22654":63053,"_5":15607,"_29907":62901,"_3297":63054},[],"The minimum TLS version is 1.3 unless both flags are only `T`, in which case it is 1.2. cert-manager cannot issue post-quantum certificates, so the installer creates the PQ and PQ/T certificates locally with OpenSSL 3.5 or later; the composite certificate also needs the `hybrid-provider` module, which the script builds on demand with `git`, `cmake` and a C compiler. The ML-DSA private keys are written in the seed-only form that Go accepts, and the secrets are created from a manifest because `kubectl create secret tls` rejects ML-DSA keys. The certificates last 365 days and are kept if the secret already exists.",{"_3844":2805,"_33198":2745,"_22654":63056,"_5":15607,"_29907":62901,"_3297":63057},[],"The script requires `yq`, `kubectl` and `helm`, and `jq` with `--sample-data`. At the end it prints how to extract the CA that devices must trust, for example `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_3844":2806,"_33198":2745,"_22654":63059,"_5":15607,"_29907":62901,"_3297":63060},[],"Companion scripts for an MQTT broker behind Traefik (`scripts/emqx`), for exporting KMS keys and for restoring a backup are present in the working tree of the chart but not committed. They are for laboratory use only and are not described further here.",{"_3844":2807,"_33198":2745,"_22654":63062,"_5":15607,"_29907":62901,"_3297":63063},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the proxy chooses a certificate and how it is built.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_3844":2808,"_33198":2745,"_22654":63065,"_5":15607,"_29907":62901,"_3297":63066},[],"<Card title=\"Known limitations\" description=\"Caveats of the laboratory deployment.\" href=\"/docs/platform/pqc/limitations\" />",{"_3844":2809,"_33198":2809,"_5":16006,"_3297":63068,"_33604":63069,"_22654":63070,"_29907":2809},"Go PQC toolchain",[54402,55870,62414,62415],[],{"_3844":2810,"_33198":2809,"_22654":63072,"_5":15607,"_29907":2809,"_3297":63073},[],"The fork of Go that adds composite ML-DSA, SLH-DSA, related certificates and composite TLS signature schemes, the API it exposes and how it is built.",{"_3844":2811,"_33198":2809,"_5":33601,"_22654":63075,"_29907":63076,"_3297":63077},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#what-the-fork-adds","What the fork adds",{"_3844":2812,"_33198":2809,"_5":33601,"_22654":63079,"_29907":63080,"_3297":63081},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#tls-code-points","TLS code points",{"_3844":2813,"_33198":2809,"_5":33601,"_22654":63083,"_29907":63084,"_3297":63085},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#a-minimal-example","A minimal example",{"_3844":2814,"_33198":2809,"_5":33601,"_22654":63087,"_29907":63088,"_3297":63089},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#what-was-removed","What was removed",{"_3844":2815,"_33198":2809,"_5":33601,"_22654":63091,"_29907":63092,"_3297":63093},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#building-the-toolchain-and-the-images","Building the toolchain and the images",{"_3844":2816,"_33198":2809,"_22654":63095,"_5":15607,"_29907":2809,"_3297":63096},[],"Go 1.27 includes ML-DSA in `crypto/mldsa` and in X.509 and TLS, but it has no composite or SLH-DSA certificates, no related certificates and no composite TLS signature schemes. Lamassu therefore builds its backend and its TLS proxy with a fork of Go, maintained on the `release-branch.go1.27` branch. This page describes what the fork adds, for developers who build Lamassu or write a client that must talk to it.",{"_3844":2817,"_33198":2809,"_22654":63098,"_5":15607,"_29907":2809,"_3297":63099},[],"The fork exposes APIs that do not exist in the official Go distribution. Code that uses them compiles only with this toolchain, and a binary built with it must not be assumed to follow the Go compatibility promise for those APIs.",{"_3844":2818,"_33198":2809,"_22654":63101,"_5":15607,"_29907":63076,"_3297":63102},[],"**Composite ML-DSA in X.509.** The `x509` package gains `CompositePublicKey` and `CompositePrivateKey`, which implement `crypto.Signer`, and 15 `CompositeAlgorithm` values (for example `x509.MLDSA65_ECDSA_P384_SHA512`) that can generate keys, sign and verify. Certificates, certificate requests and revocation lists signed with these keys parse, marshal and verify like any other. PKCS#8 encoding of composite private keys is supported. The algorithms page lists the identifiers.",{"_3844":2819,"_33198":2809,"_22654":63104,"_5":15607,"_29907":63076,"_3297":63105},[],"**SLH-DSA in X.509.** The `x509.SLHDSA` public key algorithm and twelve `PureSLHDSA...` signature algorithms are available for parsing and verifying certificates and keys. The implementation is the vendored `circl` library of Cloudflare. It is the least tested part of the fork: it has no x509 tests of its own and no TLS support.",{"_3844":2820,"_33198":2809,"_22654":63107,"_5":15607,"_29907":63076,"_3297":63108},[],"**Related certificates (RFC 9763).** The fork provides `x509.CreateBoundCertificate`, which adds the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`) to a certificate, `x509.VerifyRelatedCertificate`, and the helpers to build and check the `relatedCertRequest` attribute of a certificate request (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` gains an `ExtraAttributes` field for carrying it. Related certificates explains how Lamassu uses them.",{"_3844":2821,"_33198":2809,"_22654":63110,"_5":15607,"_29907":63076,"_3297":63111},[],"**Composite signature schemes in TLS.** The `tls` package adds 15 `SignatureScheme` constants, one per composite algorithm, advertised by default after the native ML-DSA schemes. They work only with TLS 1.3 and are tested with mutual authentication. See below for their code points.",{"_3844":2822,"_33198":2809,"_22654":63113,"_5":15607,"_29907":63080,"_3297":63114},[],"IANA has assigned no code points to the composite TLS signature schemes, so the fork uses the private-use range `0xFE00` to `0xFE0E`, in the order of the composite table: `0xFE00` is `MLDSA44-RSA2048-PSS-SHA256` and `0xFE0E` is `MLDSA65-Ed25519-SHA512`. A client or server built with a standard TLS library does not recognize them and will fall back to another scheme or fail the handshake. Interoperability is therefore limited to peers built from this fork, or to the native ML-DSA schemes (`0x0904` to `0x0906`) that standard Go 1.27 implements.",{"_3844":2823,"_33198":2809,"_22654":63116,"_5":15607,"_29907":63080,"_3297":63117},[],"The three variants that use RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` and `MLDSA65-RSA4096-PKCS15-SHA512`) are announced only in the `signature_algorithms_cert` extension, so they can appear in a certificate chain but a leaf certificate with such a key cannot sign the handshake.",{"_3844":2824,"_33198":2809,"_22654":63119,"_5":15607,"_29907":63080,"_3297":63120},[],"The key exchange is unchanged from upstream Go. Hybrid groups such as `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` and the pure `MLKEM1024` are those of the Go 1.27 standard library.",{"_3844":2825,"_33198":2809,"_22654":63122,"_5":15607,"_29907":63084,"_3297":63123},[],"The following program creates a self-signed composite certificate and uses it as the server certificate of a TLS 1.3 configuration. Error handling is omitted.",{"_3844":2826,"_33198":2809,"_22654":63125,"_5":15607,"_29907":63084,"_3297":63126},[],"A composite key can also sign a message directly, with an optional context of at most 255 bytes:",{"_3844":2827,"_33198":2809,"_22654":63128,"_5":15607,"_29907":63088,"_3297":63129},[],"Earlier iterations of the fork explored Chameleon certificates (`draft-bonnell-lamps-chameleon-certs`) and a delta-certificate construction. They were removed because they are no longer pursued. The related-certificate mechanism was later restored on its own, following RFC 9763.",{"_3844":2828,"_33198":2809,"_22654":63131,"_5":15607,"_29907":63092,"_3297":63132},[],"The fork is built in CI by a workflow that runs the Go test suite and then publishes a multi-architecture image, `ghcr.io/lamassuiot/golang-pqc`, tagged `go1.27` and, for the `release-branch.go1.27` branch, `latest`. The image contains the toolchain under `/usr/local/go-pqc` with `GOROOT` pointing at it.",{"_3844":2829,"_33198":2809,"_22654":63134,"_5":15607,"_29907":63092,"_3297":63135},[],"Lamassu consumes the toolchain in two ways. The backend images (CA, KMS, VA, alerts, device manager, DMS manager and the monolithic build) use `ghcr.io/lamassuiot/golang-pqc:latest` as their builder image. The backend CI workflow installs the same toolchain through a custom setup action in place of `actions/setup-go`, and the backend requires `go 1.27.3` in its module file. Traefik is not built from the image: its `build.sh` script expects a compiled checkout of the fork in a sibling directory and produces the binary outside a container. See TLS front proxy with Traefik.",{"_3844":2830,"_33198":2809,"_22654":63137,"_5":15607,"_29907":63092,"_3297":63138},[],"<Card title=\"Algorithms\" description=\"The identifiers and parameter sets behind these constants.\" href=\"/docs/platform/pqc/algorithms\" />",{"_3844":2831,"_33198":2809,"_22654":63140,"_5":15607,"_29907":63092,"_3297":63141},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the fork is used to terminate device TLS.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_3844":2832,"_33198":2832,"_5":16006,"_3297":63143,"_33604":63144,"_22654":63145,"_29907":2832},"Keys and certificate authorities",[54402,55870,62414,62790],[],{"_3844":2833,"_33198":2832,"_22654":63147,"_5":15607,"_29907":2832,"_3297":63148},[],"Create post-quantum keys and CAs, sign with them and issue certificates, with the engine support, API values and constraints that apply.",{"_3844":2834,"_33198":2832,"_5":33601,"_22654":63150,"_29907":63151,"_3297":63152},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#choose-a-crypto-engine-that-supports-the-algorithm","Choose a crypto engine that supports the algorithm",{"_3844":2835,"_33198":2832,"_5":33601,"_22654":63154,"_29907":63155,"_3297":63156},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-key","Create a key",{"_3844":2836,"_33198":2832,"_5":33601,"_22654":63158,"_29907":63159,"_3297":63160},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-certificate-authority","Create a certificate authority",{"_3844":2837,"_33198":2832,"_5":33601,"_22654":63162,"_29907":63163,"_3297":63164},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#mixing-algorithms-in-a-hierarchy","Mixing algorithms in a hierarchy",{"_3844":2838,"_33198":2832,"_5":33601,"_22654":63166,"_29907":63167,"_3297":63168},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#signing-and-verifying-with-a-key","Signing and verifying with a key",{"_3844":2839,"_33198":2832,"_5":33601,"_22654":63170,"_29907":63171,"_3297":63172},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#constraints-to-keep-in-mind","Constraints to keep in mind",{"_3844":2840,"_33198":2832,"_22654":63174,"_5":15607,"_29907":2832,"_3297":63175},[],"The Lamassu backend treats post-quantum keys as one more key type of the Key Management Service (KMS). A certificate authority created with such a key signs certificates and revocation lists through the same paths as an RSA or ECDSA CA, because the fork of Go performs the signing. This page explains what to send to the API, which crypto engines can hold the keys and where the behaviour differs from classical keys. The backend must be built with the Go PQC toolchain.",{"_3844":2841,"_33198":2832,"_22654":63177,"_5":15607,"_29907":63151,"_3297":63178},[],"Not every crypto engine can create or hold post-quantum keys. Only the engines that run the cryptography in the Lamassu process can.",{"_3844":2842,"_33198":2832,"_22654":63180,"_5":15607,"_29907":63151,"_3297":63181},[],"Engine",{"_3844":2843,"_33198":2832,"_22654":63183,"_5":15607,"_29907":63151,"_3297":63184},[],"ML-DSA, SLH-DSA, Composite, Ed25519",{"_3844":2844,"_33198":2832,"_22654":63186,"_5":15607,"_29907":63151,"_3297":63187},[],"Filesystem",{"_3844":2845,"_33198":2832,"_22654":63189,"_5":15607,"_29907":63151,"_3297":63190},[],"Supported",{"_3844":2846,"_33198":2832,"_22654":63192,"_5":15607,"_29907":63151,"_3297":63193},[],"Software (golang)",{"_3844":2847,"_33198":2832,"_22654":63195,"_5":15607,"_29907":63151,"_3297":63190},[],{"_3844":2848,"_33198":2832,"_22654":63197,"_5":15607,"_29907":63151,"_3297":63198},[],"HashiCorp Vault KV2",{"_3844":2849,"_33198":2832,"_22654":63200,"_5":15607,"_29907":63151,"_3297":63201},[],"Not supported",{"_3844":2850,"_33198":2832,"_22654":63203,"_5":15607,"_29907":63151,"_3297":61322},[],{"_3844":2851,"_33198":2832,"_22654":63205,"_5":15607,"_29907":63151,"_3297":63201},[],{"_3844":2852,"_33198":2832,"_22654":63207,"_5":15607,"_29907":63151,"_3297":61326},[],{"_3844":2853,"_33198":2832,"_22654":63209,"_5":15607,"_29907":63151,"_3297":63201},[],{"_3844":2854,"_33198":2832,"_22654":63211,"_5":15607,"_29907":63151,"_3297":63212},[],"Azure Key Vault and Azure Secrets",{"_3844":2855,"_33198":2832,"_22654":63214,"_5":15607,"_29907":63151,"_3297":63201},[],{"_3844":2856,"_33198":2832,"_22654":63216,"_5":15607,"_29907":63151,"_3297":63217},[],"PKCS#11 (HSM)",{"_3844":2857,"_33198":2832,"_22654":63219,"_5":15607,"_29907":63151,"_3297":63201},[],{"_3844":2858,"_33198":2832,"_22654":63221,"_5":15607,"_29907":63151,"_3297":63222},[],"In practice, post-quantum keys currently require the filesystem engine, which has security level 1. Keys with a higher assurance level, in a hardware security module or a cloud KMS, are not available for these algorithms.",{"_3844":2859,"_33198":2832,"_22654":63224,"_5":15607,"_29907":63151,"_3297":63225},[],"The Vault KV2 and AWS Secrets Manager engines list the post-quantum key types among the types they support, so a request passes the compatibility check. The creation then fails with an `unsupported key type` error from the engine. Select a filesystem or software engine explicitly with `engine_id`.",{"_3844":2860,"_33198":2832,"_22654":63227,"_5":15607,"_29907":63155,"_3297":63228},[],"A KMS key is created with the algorithm and size described in Algorithms:",{"_3844":2861,"_33198":2832,"_22654":63230,"_5":15607,"_29907":63155,"_3297":63231},[],"Invalid parameters are rejected with an explicit message: an ML-DSA size other than 44, 65 or 87, an SLH-DSA identifier outside 1 to 12, a composite variant outside 1 to 15, or a composite variant that does not belong to the requested family. Importing a private key in PKCS#8 form detects the algorithm and the parameter set automatically; the import accepts ML-DSA, SLH-DSA, composite and Ed25519 keys.",{"_3844":2862,"_33198":2832,"_22654":63233,"_5":15607,"_29907":63159,"_3297":63234},[],"A CA with a post-quantum key uses the same request as any other CA, sent to `POST /api/ca/v1/cas`. Only `key_metadata` changes, where `bits` carries the parameter set. A root CA with ML-DSA-65:",{"_3844":2863,"_33198":2832,"_22654":63236,"_5":15607,"_29907":63159,"_3297":63237},[],"A root CA with a composite key of ML-DSA-44 and ECDSA P-256 uses `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 uses `\"type\": \"Ed25519\", \"bits\": 256` and SLH-DSA uses `\"type\": \"SLH-DSA\", \"bits\": 1` to select SLH-DSA-SHA2-128s. Subordinate CAs are created the same way: the subordinate signs its own certificate request with the KMS key and the parent CA issues the certificate.",{"_3844":2864,"_33198":2832,"_22654":63239,"_5":15607,"_29907":63159,"_3297":63240},[],"Existing CAs can be imported with a post-quantum private key for ML-DSA and Ed25519. Importing a CA with an SLH-DSA or composite key is not supported.",{"_3844":2865,"_33198":2832,"_22654":63242,"_5":15607,"_29907":63163,"_3297":63243},[],"The backend places no restriction on which algorithm issues which. A CA with an ML-DSA key can issue certificates to RSA, ECDSA, Ed25519 and ML-DSA subjects, and an RSA or ECDSA CA can issue certificates to post-quantum subjects. The test suite covers the full ML-DSA and Ed25519 matrix through the API, and covers SLH-DSA and composite CAs and leaves at the certificate engine level. This makes it possible to introduce a post-quantum CA beneath a classical root, or the reverse, but a relying party must be able to verify every algorithm in the chain. In TLS, the signatures in the certificate chain are checked against the client's `signature_algorithms_cert` extension, so a chain signed with ML-DSA or a composite algorithm needs a client that announces it there.",{"_3844":2866,"_33198":2832,"_22654":63245,"_5":15607,"_29907":63167,"_3297":63246},[],"The KMS signing endpoint accepts new `signature_algorithm` values. The `message_type` field is ignored for all of them. The ML-DSA, SLH-DSA and Ed25519 values are \"pure\": the message is signed directly, without pre-hashing (not HashML-DSA, HashSLH-DSA or Ed25519ph). The composite values hash the message with the hash of the variant and sign a message representative that includes a fixed label and the optional context.",{"_3844":2867,"_33198":2832,"_22654":63248,"_5":15607,"_29907":63167,"_3297":62345},[],{"_3844":2868,"_33198":2832,"_22654":63250,"_5":15607,"_29907":63167,"_3297":63251},[],"`signature_algorithm`",{"_3844":2869,"_33198":2832,"_22654":63253,"_5":15607,"_29907":63167,"_3297":63254},[],"ML-DSA-44, -65, -87",{"_3844":2870,"_33198":2832,"_22654":63256,"_5":15607,"_29907":63167,"_3297":63257},[],"`MLDSA_44_PURE`, `MLDSA_65_PURE`, `MLDSA_87_PURE`",{"_3844":2871,"_33198":2832,"_22654":63259,"_5":15607,"_29907":63167,"_3297":62431},[],{"_3844":2872,"_33198":2832,"_22654":63261,"_5":15607,"_29907":63167,"_3297":63262},[],"`SLHDSA_PURE`",{"_3844":2873,"_33198":2832,"_22654":63264,"_5":15607,"_29907":63167,"_3297":63265},[],"Composite",{"_3844":2874,"_33198":2832,"_22654":63267,"_5":15607,"_29907":63167,"_3297":63268},[],"`COMPOSITE_MLDSA_RSA_PURE`, `COMPOSITE_MLDSA_ECDSA_PURE`, `COMPOSITE_MLDSA_ED25519_PURE`",{"_3844":2875,"_33198":2832,"_22654":63270,"_5":15607,"_29907":63167,"_3297":62439},[],{"_3844":2876,"_33198":2832,"_22654":63272,"_5":15607,"_29907":63167,"_3297":63273},[],"`Ed25519_PURE`",{"_3844":2877,"_33198":2832,"_22654":63275,"_5":15607,"_29907":63167,"_3297":63276},[],"The backend does not check that the algorithm matches the key; choose the value that corresponds to the key type. When a CA signs a certificate or a revocation list, the algorithm is selected automatically.",{"_3844":2878,"_33198":2832,"_22654":63278,"_5":15607,"_29907":63171,"_3297":63279},[],"Several parts of the platform do not yet handle post-quantum keys. They are collected in Known limitations; the ones that affect daily operation are these.",{"_3844":2879,"_33198":2832,"_22654":63281,"_5":15607,"_29907":63171,"_3297":63282},[],"Issuance profiles enforce key restrictions only for RSA and ECDSA, through `allow_rsa_keys` and `allow_ecdsa_keys`. A profile with enforcement enabled does not block post-quantum keys, and has no switch to allow or deny them.",{"_3844":2880,"_33198":2832,"_22654":63284,"_5":15607,"_29907":63171,"_3297":63285},[],"The key strength recorded for a certificate whose key is post-quantum or Ed25519 is computed only for RSA and ECDSA, so those certificates are stored with an unknown key type and size and a low strength.",{"_3844":2881,"_33198":2832,"_22654":63287,"_5":15607,"_29907":63171,"_3297":63288},[],"OCSP responses are signed with the `golang.org/x/crypto/ocsp` library, which supports only RSA and ECDSA signing keys. A CA with a post-quantum, Ed25519 or composite key is therefore not expected to be able to sign OCSP responses; CRLs are produced with the fork and are not affected by this limit, although they are not covered by tests.",{"_3844":2882,"_33198":2832,"_22654":63290,"_5":15607,"_29907":63171,"_3297":63291},[],"Server-side key generation in the DMS (the EST `serverkeygen` operation) generates only RSA and ECDSA keys.",{"_3844":2883,"_33198":2832,"_22654":63293,"_5":15607,"_29907":63171,"_3297":63294},[],"<Card title=\"Related certificates\" description=\"Bind a post-quantum certificate to an existing classical one.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_3844":2884,"_33198":2832,"_22654":63296,"_5":15607,"_29907":63171,"_3297":63297},[],"<Card title=\"Dashboard\" description=\"Create the same objects from the web interface.\" href=\"/docs/platform/pqc/dashboard\" />",{"_3844":2885,"_33198":2885,"_5":16006,"_3297":63299,"_33604":63300,"_22654":63302,"_29907":2885},"Known limitations",[54402,55870,62414,63301],"Reference",[],{"_3844":2886,"_33198":2885,"_22654":63304,"_5":15607,"_29907":2885,"_3297":63305},[],"What is incomplete, non-standard or unverified in Lamassu's post-quantum support, grouped by component.",{"_3844":2887,"_33198":2885,"_5":33601,"_22654":63307,"_29907":63308,"_3297":63309},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#standards-and-interoperability","Standards and interoperability",{"_3844":2888,"_33198":2885,"_5":33601,"_22654":63311,"_29907":63312,"_3297":63313},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#keys-and-engines","Keys and engines",{"_3844":2889,"_33198":2885,"_5":33601,"_22654":63315,"_29907":63316,"_3297":63317},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#certificate-authority-and-validation","Certificate authority and validation",{"_3844":2890,"_33198":2885,"_5":33601,"_22654":63319,"_29907":63320,"_3297":62788},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#dashboard",{"_3844":2891,"_33198":2885,"_5":33601,"_22654":63322,"_29907":63323,"_3297":63324},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#build-and-deployment","Build and deployment",{"_3844":2892,"_33198":2885,"_22654":63326,"_5":15607,"_29907":2885,"_3297":63327},[],"This page collects the limits of the current implementation so they can be weighed before planning a deployment. Each one has been observed in the code or the tests of the branches described in this section.",{"_3844":2893,"_33198":2885,"_22654":63329,"_5":15607,"_29907":63308,"_3297":63330},[],"Composite certificates were implemented and tested against draft 19 of the IETF composite signatures specification, which has since been published as RFC 10073; the implementation has not been compared with the final text. Three of its algorithms (the two Brainpool variants and Ed448) are not implemented. The composite signature schemes in TLS use private-use code points in `0xFE00` to `0xFE0E` and no published draft or version is identified in the code, so they interoperate only with peers built from the same Go fork. Composite RSA-PKCS#1 v1.5 variants cannot authenticate a TLS handshake. SLH-DSA has no TLS signature scheme. The related-certificate request attribute has not been checked against other implementations of RFC 9763.",{"_3844":2894,"_33198":2885,"_22654":63332,"_5":15607,"_29907":63312,"_3297":63333},[],"Post-quantum, composite and Ed25519 keys work only with the filesystem and software engines. The Vault KV2 and AWS Secrets Manager engines announce support and then fail at creation, and AWS KMS, Azure and PKCS#11 do not support them. There is therefore no hardware-backed or cloud-KMS-backed post-quantum key. Some engine error messages are copied from other engines and name the wrong one.",{"_3844":2895,"_33198":2885,"_22654":63335,"_5":15607,"_29907":63312,"_3297":63336},[],"The `CryptoEngine` interface gained methods to create and import each new key type. Engines developed outside the Lamassu repository must implement them.",{"_3844":2896,"_33198":2885,"_22654":63338,"_5":15607,"_29907":63316,"_3297":63339},[],"OCSP responses cannot be signed by a CA with a post-quantum, Ed25519 or composite key, because the signing library supports only RSA and ECDSA. CRL generation uses the fork's signing and is expected to work, but neither CRL nor OCSP has tests with these keys.",{"_3844":2897,"_33198":2885,"_22654":63341,"_5":15607,"_29907":63316,"_3297":63342},[],"Issuance profiles cannot allow or deny post-quantum algorithms; their enforcement applies only to RSA and ECDSA. The key strength of an issued certificate is computed only for RSA and ECDSA, so other certificates are stored with unknown type and size and low strength. Importing an existing CA with an SLH-DSA or composite key is not supported.",{"_3844":2898,"_33198":2885,"_22654":63344,"_5":15607,"_29907":63316,"_3297":63345},[],"The DMS can generate keys on the server only for RSA and ECDSA, so `serverkeygen` cannot return a post-quantum key. The enrollment flows through EST and the device manager have no tests with post-quantum keys.",{"_3844":2899,"_33198":2885,"_22654":63347,"_5":15607,"_29907":63316,"_3297":63348},[],"The backend does not evaluate the related-certificate extension. It only issues it.",{"_3844":2900,"_33198":2885,"_22654":63350,"_5":15607,"_29907":63320,"_3297":63351},[],"The in-browser SLH-DSA key generator maps parameter set identifiers differently from the rest of the interface, as described in Dashboard. Key type names are not uniform between screens, and the interface has no experimental notice and no translation.",{"_3844":2901,"_33198":2885,"_22654":63353,"_5":15607,"_29907":63323,"_3297":63354},[],"Everything depends on forks of Go and Traefik that are not upstream, and the proxy image has a mutable tag. The backend's OpenAPI specification for the KMS still lists only RSA, ECDSA and Ed25519 and does not reflect the new key types.",{"_3844":2902,"_33198":2885,"_22654":63356,"_5":15607,"_29907":63323,"_3297":63357},[],"The Helm chart uses fixed resource names, supports one release per namespace and sends traffic from Traefik to Envoy without verifying certificates. The post-quantum certificates created by the installer are valid for 365 days and are not renewed. The installer needs a Linux host and runs a Helm install, not an upgrade.",{"_3844":2903,"_33198":2885,"_22654":63359,"_5":15607,"_29907":63323,"_3297":63360},[],"<Card title=\"Post-quantum cryptography overview\" description=\"Return to the summary of the section.\" href=\"/docs/platform/pqc/overview\" />",{"_3844":2904,"_33198":2904,"_5":16006,"_3297":63362,"_33604":63363,"_22654":63364,"_29907":2904},"Post-quantum cryptography overview",[54402,55870,62414],[],{"_3844":2905,"_33198":2904,"_22654":63366,"_5":15607,"_29907":2904,"_3297":63367},[],"What post-quantum (PQC) support Lamassu adds to keys, certificate authorities, device TLS and deployment, and how its pieces fit together.",{"_3844":2906,"_33198":2904,"_5":33601,"_22654":63369,"_29907":63370,"_3297":63371},[],"/docs/pr-preview/pr-58/platform/pqc/overview#why-it-matters-for-device-fleets","Why it matters for device fleets",{"_3844":2907,"_33198":2904,"_5":33601,"_22654":63373,"_29907":63374,"_3297":63375},[],"/docs/pr-preview/pr-58/platform/pqc/overview#three-families-of-algorithms","Three families of algorithms",{"_3844":2908,"_33198":2904,"_5":33601,"_22654":63377,"_29907":63378,"_3297":63379},[],"/docs/pr-preview/pr-58/platform/pqc/overview#how-the-pieces-fit","How the pieces fit",{"_3844":2909,"_33198":2904,"_5":33601,"_22654":63381,"_29907":63382,"_3297":63383},[],"/docs/pr-preview/pr-58/platform/pqc/overview#where-to-read-next","Where to read next",{"_3844":2910,"_33198":2904,"_22654":63385,"_5":15607,"_29907":2904,"_3297":63386},[],"Lamassu can create keys, certificate authorities (CAs) and certificates that use post-quantum signature algorithms, and it can serve and verify them over TLS. The work spans five codebases that depend on one another: a fork of the Go toolchain that implements the algorithms, the Lamassu backend, the web dashboard, a fork of the Traefik proxy that terminates TLS for devices, and the Helm chart that deploys all of it together.",{"_3844":2911,"_33198":2904,"_22654":63388,"_5":15607,"_29907":2904,"_3297":63389},[],"PQC support lives in development branches and in forks of Go and Traefik, not in the upstream projects or in the standard Lamassu images. The composite TLS signature schemes use private-use code points that no other TLS stack understands, and the composite certificate format follows an IETF draft that can still change. Plan pilots and laboratory deployments, not production fleets. Known limitations lists what is incomplete.",{"_3844":2912,"_33198":2904,"_22654":63391,"_5":15607,"_29907":63370,"_3297":63392},[],"Certificates issued to devices often live for years, and the devices that hold them are hard to replace. A signature algorithm that is broken by a future quantum computer would force a fleet-wide re-enrollment. Issuing devices a certificate signed with a post-quantum or composite algorithm today, and serving them a TLS endpoint that accepts it, lets a fleet be validated against that risk before it becomes urgent. Signatures are not exposed to \"harvest now, decrypt later\" attacks the way a key exchange is, so the urgency is about the lifetime of certificates and devices, not about recorded traffic.",{"_3844":2913,"_33198":2904,"_22654":63394,"_5":15607,"_29907":63374,"_3297":63395},[],"Lamassu groups signature algorithms in three families, the same labels the dashboard shows.",{"_3844":2914,"_33198":2904,"_22654":63397,"_5":15607,"_29907":63374,"_3297":63398},[],"Label",{"_3844":2915,"_33198":2904,"_22654":63400,"_5":15607,"_29907":63374,"_3297":62628},[],{"_3844":2916,"_33198":2904,"_22654":63402,"_5":15607,"_29907":63374,"_3297":62412},[],{"_3844":2917,"_33198":2904,"_22654":63404,"_5":15607,"_29907":63374,"_3297":63405},[],"**T**",{"_3844":2918,"_33198":2904,"_22654":63407,"_5":15607,"_29907":63374,"_3297":63408},[],"Traditional",{"_3844":2919,"_33198":2904,"_22654":63410,"_5":15607,"_29907":63374,"_3297":63411},[],"RSA, ECDSA, Ed25519",{"_3844":2920,"_33198":2904,"_22654":63413,"_5":15607,"_29907":63374,"_3297":63414},[],"**PQ**",{"_3844":2921,"_33198":2904,"_22654":63416,"_5":15607,"_29907":63374,"_3297":63417},[],"Pure post-quantum",{"_3844":2922,"_33198":2904,"_22654":63419,"_5":15607,"_29907":63374,"_3297":63420},[],"ML-DSA, SLH-DSA",{"_3844":2923,"_33198":2904,"_22654":63422,"_5":15607,"_29907":63374,"_3297":63423},[],"**PQ/T**",{"_3844":2924,"_33198":2904,"_22654":63425,"_5":15607,"_29907":63374,"_3297":63426},[],"Hybrid (composite)",{"_3844":2925,"_33198":2904,"_22654":63428,"_5":15607,"_29907":63374,"_3297":63429},[],"ML-DSA combined with RSA, ECDSA or Ed25519 in a single key and a single signature",{"_3844":2926,"_33198":2904,"_22654":63431,"_5":15607,"_29907":63374,"_3297":63432},[],"A composite signature is valid only if both of its components verify. Its unforgeability is intended to hold as long as at least one of the two algorithms remains unbroken, provided the relying party requires the composite and does not fall back to a classical certificate. In the key exchange, `PQ/T` means a hybrid group that combines a classical and an ML-KEM exchange, and `PQ` means pure ML-KEM. Algorithms describes each one and the parameter sets Lamassu accepts.",{"_3844":2927,"_33198":2904,"_22654":63434,"_5":15607,"_29907":63378,"_3297":63435},[],"The Go fork is the foundation: the backend and Traefik are compiled with it, because the standard Go toolchain does not provide the composite and SLH-DSA certificate support. The backend creates and holds the keys, issues certificates and signs revocation data. The dashboard drives the same REST API. Devices reach the platform through Traefik, which negotiates post-quantum authentication and key exchange with the device and then forwards the request to Envoy Gateway over ordinary TLS. Post-quantum protection therefore applies only to the hop between the device and Traefik.",{"_3844":2928,"_33198":2904,"_22654":63437,"_5":15607,"_29907":63382,"_3297":63438},[],"Read Algorithms first to learn what is supported and how parameter sets are written in API requests. Developers writing a device client should continue with Go PQC toolchain. Administrators who want to create a post-quantum CA follow Keys and certificate authorities, and those who deploy the platform go to Deployment with the Helm chart.",{"_3844":2929,"_33198":2904,"_22654":63440,"_5":15607,"_29907":63382,"_3297":63441},[],"<Card title=\"Algorithms\" description=\"ML-DSA, SLH-DSA and the 15 composite algorithms, with their parameter sets.\" href=\"/docs/platform/pqc/algorithms\" />",{"_3844":2930,"_33198":2904,"_22654":63443,"_5":15607,"_29907":63382,"_3297":63444},[],"<Card title=\"Keys and certificate authorities\" description=\"Create post-quantum keys and CAs and issue certificates through the API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3844":2931,"_33198":2904,"_22654":63446,"_5":15607,"_29907":63382,"_3297":63447},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the platform with a Traefik front proxy that serves PQC certificates.\" href=\"/docs/platform/pqc/deployment\" />",{"_3844":2932,"_33198":2932,"_5":16006,"_3297":62810,"_33604":63449,"_22654":63450,"_29907":2932},[54402,55870,62414,62790],[],{"_3844":2933,"_33198":2932,"_22654":63452,"_5":15607,"_29907":2932,"_3297":63453},[],"Bind a certificate with a post-quantum key to an existing classical certificate of the same device, following RFC 9763, and how Lamassu issues and checks them.",{"_3844":2934,"_33198":2932,"_5":33601,"_22654":63455,"_29907":63456,"_3297":63457},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#how-the-request-works","How the request works",{"_3844":2935,"_33198":2932,"_5":33601,"_22654":63459,"_29907":63460,"_3297":63461},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#locations-the-ca-may-fetch-from","Locations the CA may fetch from",{"_3844":2936,"_33198":2932,"_5":33601,"_22654":63463,"_29907":63464,"_3297":63465},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#configure-an-issuance-profile","Configure an issuance profile",{"_3844":2937,"_33198":2932,"_5":33601,"_22654":63467,"_29907":63468,"_3297":63469},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#what-the-issued-certificate-must-satisfy","What the issued certificate must satisfy",{"_3844":2938,"_33198":2932,"_5":33601,"_22654":63471,"_29907":63472,"_3297":63473},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#from-the-dashboard","From the dashboard",{"_3844":2939,"_33198":2932,"_22654":63475,"_5":15607,"_29907":2932,"_3297":63476},[],"A fleet that is migrating to post-quantum algorithms usually holds two certificates per device for a while: the classical one already in use and a new one with a post-quantum key. RFC 9763 defines a way to link them. The new certificate carries the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`), which holds a hash of the classical certificate, so a relying party can see that both identify the same entity. Lamassu implements the issuing side of this mechanism.",{"_3844":2940,"_33198":2932,"_22654":63478,"_5":15607,"_29907":63456,"_3297":63479},[],"The device asks for the bound certificate with an ordinary PKCS#10 certificate request that carries one extra attribute, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). The attribute identifies the existing certificate by issuer and serial number, states the time of the request, gives the location from which the certificate can be downloaded and carries a signature made with the private key of that existing certificate. The signature covers the issuer, the serial number and the request time, not the location, and shows that the requester controls the existing key; the key of the new certificate is proven by the signature of the certificate request itself. Lamassu accepts a list of locations, as in the ASN.1 module of the RFC, and tries them in order.",{"_3844":2941,"_33198":2932,"_22654":63481,"_5":15607,"_29907":63456,"_3297":63482},[],"When the CA service receives such a request it follows these steps:",{"_3844":2942,"_33198":2932,"_22654":63484,"_5":15607,"_29907":63456,"_3297":63485},[],"It checks that the issuance profile in use enables related certificates, and rejects the request otherwise.",{"_3844":2943,"_33198":2932,"_22654":63487,"_5":15607,"_29907":63456,"_3297":63488},[],"It reads the locations in the attribute in order and downloads the first certificate it can retrieve.",{"_3844":2944,"_33198":2932,"_22654":63490,"_5":15607,"_29907":63456,"_3297":63491},[],"It verifies that the issuer and serial number match, that the request time is within the allowed age, and that the signature is valid with the downloaded certificate's key.",{"_3844":2945,"_33198":2932,"_22654":63493,"_5":15607,"_29907":63456,"_3297":63494},[],"It issues the new certificate with the related certificate extension added.",{"_3844":2946,"_33198":2932,"_22654":63496,"_5":15607,"_29907":63456,"_3297":63497},[],"A request without the attribute is processed as usual, whether or not the profile enables the feature.",{"_3844":2947,"_33198":2932,"_22654":63499,"_5":15607,"_29907":63460,"_3297":63500},[],"A location is either a `data:` URI or an `http` or `https` URL. A `data:` URI must be base64-encoded and contains a PKCS#7 structure whose first certificate is the related one; it needs no network access and is always accepted when the feature is enabled. A URL is retrieved only if its host appears in the profile's list of allowed hosts. The CA does not follow redirects, applies a ten-second timeout and rejects responses larger than 1 MiB.",{"_3844":2948,"_33198":2932,"_22654":63502,"_5":15607,"_29907":63460,"_3297":63503},[],"Because the server performs the download, whoever can define an issuance profile decides which hosts the CA is allowed to contact. Restrict that permission accordingly and list only internal certificate repositories.",{"_3844":2949,"_33198":2932,"_22654":63505,"_5":15607,"_29907":63464,"_3297":63506},[],"The feature is configured in the `related_certificate` object of the issuance profile, which is stored with its own database columns:",{"_3844":2950,"_33198":2932,"_22654":63508,"_5":15607,"_29907":63464,"_3297":63509},[],"Field",{"_3844":2951,"_33198":2932,"_22654":63511,"_5":15607,"_29907":63464,"_3297":58554},[],{"_3844":2952,"_33198":2932,"_22654":63513,"_5":15607,"_29907":63464,"_3297":54789},[],{"_3844":2953,"_33198":2932,"_22654":63515,"_5":15607,"_29907":63464,"_3297":58560},[],{"_3844":2954,"_33198":2932,"_22654":63517,"_5":15607,"_29907":63464,"_3297":63518},[],"`enabled`",{"_3844":2955,"_33198":2932,"_22654":63520,"_5":15607,"_29907":63464,"_3297":21314},[],{"_3844":2956,"_33198":2932,"_22654":63522,"_5":15607,"_29907":63464,"_3297":62934},[],{"_3844":2957,"_33198":2932,"_22654":63524,"_5":15607,"_29907":63464,"_3297":63525},[],"When `false`, a request that carries the attribute is rejected.",{"_3844":2958,"_33198":2932,"_22654":63527,"_5":15607,"_29907":63464,"_3297":63528},[],"`allowed_hosts`",{"_3844":2959,"_33198":2932,"_22654":63530,"_5":15607,"_29907":63464,"_3297":63531},[],"list of strings",{"_3844":2960,"_33198":2932,"_22654":63533,"_5":15607,"_29907":63464,"_3297":20597},[],{"_3844":2961,"_33198":2932,"_22654":63535,"_5":15607,"_29907":63464,"_3297":63536},[],"Hosts from which `http` and `https` locations may be downloaded.",{"_3844":2962,"_33198":2932,"_22654":63538,"_5":15607,"_29907":63464,"_3297":63539},[],"`max_age`",{"_3844":2963,"_33198":2932,"_22654":63541,"_5":15607,"_29907":63464,"_3297":6276},[],{"_3844":2964,"_33198":2932,"_22654":63543,"_5":15607,"_29907":63464,"_3297":63544},[],"`5m`",{"_3844":2965,"_33198":2932,"_22654":63546,"_5":15607,"_29907":63464,"_3297":63547},[],"Maximum difference between the request time in the attribute and the time of issuance.",{"_3844":2966,"_33198":2932,"_22654":63549,"_5":15607,"_29907":63468,"_3297":63550},[],"The fork refuses to bind a certificate unless the new one is compatible with the related one. Neither certificate may be a CA. The related certificate must be valid at the time of issuance. The key usages and extended key usages requested for the new certificate must be a subset of those of the related certificate. Verification later compares only the hash, so a relying party that checks the link learns that the issuing CA linked the new certificate to that specific certificate, not that the related certificate is still valid.",{"_3844":2967,"_33198":2932,"_22654":63552,"_5":15607,"_29907":63472,"_3297":63553},[],"The dashboard exposes the feature in two places. The issuance profile form has a *Related Certificates* section with a switch, the allowed hosts and the maximum age. When issuing a certificate from a CA with a browser-generated key and a profile that enables the feature, the form offers *Bind to a related certificate*: the user supplies the existing certificate, or its issuer and serial number, signs the data shown with the existing key outside the browser, and pastes the signature. Certificate and CA details show a *Related Certificate* row with the hash algorithm and value. See Dashboard.",{"_3844":2968,"_33198":2932,"_22654":63555,"_5":15607,"_29907":63472,"_3297":63556},[],"The bound certificate is created by the fork's `CreateBoundCertificate`, whose tests cover an ML-DSA key bound to RSA, ECDSA and Ed25519 certificates. The tests do not use composite keys. Only the issuing side is implemented in Lamassu: the platform does not evaluate the extension when it validates certificates.",{"_3844":2969,"_33198":2932,"_22654":63558,"_5":15607,"_29907":63472,"_3297":63559},[],"<Card title=\"Keys and certificate authorities\" description=\"Create the post-quantum CA that issues the bound certificate.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3844":2970,"_33198":2932,"_22654":63561,"_5":15607,"_29907":63472,"_3297":63562},[],"<Card title=\"Known limitations\" description=\"What is not covered yet.\" href=\"/docs/platform/pqc/limitations\" />",{"_3844":2971,"_33198":2971,"_5":16006,"_3297":63564,"_33604":63565,"_22654":63566,"_29907":2971},"TLS front proxy with Traefik",[54402,55870,62414,54403],[],{"_3844":2972,"_33198":2971,"_22654":63568,"_5":15607,"_29907":2971,"_3297":63569},[],"The Traefik fork that terminates device TLS with classical and post-quantum certificates for the same host, how it picks a certificate and how it is built.",{"_3844":2973,"_33198":2971,"_5":33601,"_22654":63571,"_29907":63572,"_3297":63573},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#several-certificates-for-the-same-host","Several certificates for the same host",{"_3844":2974,"_33198":2971,"_5":33601,"_22654":63575,"_29907":63576,"_3297":63577},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#tls-options-on-gateway-api-listeners","TLS options on Gateway API listeners",{"_3844":2975,"_33198":2971,"_5":33601,"_22654":63579,"_29907":63580,"_3297":63581},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#mutual-tls","Mutual TLS",{"_3844":2976,"_33198":2971,"_5":33601,"_22654":63583,"_29907":63584,"_3297":63585},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#building-the-proxy","Building the proxy",{"_3844":2977,"_33198":2971,"_22654":63587,"_5":15607,"_29907":2971,"_3297":63588},[],"Devices connect to Lamassu over TLS, and EST enrollment relies on mutual TLS. To accept a post-quantum or composite certificate on that connection, the TLS endpoint must be built with the Go PQC toolchain. Lamassu does this with a fork of Traefik, based on Traefik 3.7.15, that sits in front of Envoy Gateway. The fork adds two behaviours: it can serve several certificates for the same host and chooses among them per client, and it lets a Gateway API listener reference a Traefik TLS option.",{"_3844":2978,"_33198":2971,"_22654":63590,"_5":15607,"_29907":63572,"_3297":63591},[],"Upstream Traefik keeps one certificate per set of names. If a classical ECDSA certificate and an ML-DSA certificate exist for `lab.example.com`, only the first is kept. The fork stores every distinct certificate (duplicates are detected by comparing the leaf certificate) and chooses one for each handshake.",{"_3844":2979,"_33198":2971,"_22654":63593,"_5":15607,"_29907":63572,"_3297":63594},[],"The choice follows the signature algorithms the client announces:",{"_3844":2980,"_33198":2971,"_22654":63596,"_5":15607,"_29907":63572,"_3297":63597},[],"The server name from the client is normalized and the certificates whose names match it are collected, with exact names ahead of wildcards. A common-name-only certificate still matches.",{"_3844":2981,"_33198":2971,"_22654":63599,"_5":15607,"_29907":63572,"_3297":63600},[],"If no certificate matches, the connection is closed in strict-SNI mode, or the default certificate is served.",{"_3844":2982,"_33198":2971,"_22654":63602,"_5":15607,"_29907":63572,"_3297":63603},[],"If exactly one certificate matches, it is served without further checks.",{"_3844":2983,"_33198":2971,"_22654":63605,"_5":15607,"_29907":63572,"_3297":63606},[],"Otherwise the proxy takes the client's signature schemes in the order the client sent them, and for each scheme returns the first certificate whose key the scheme, the TLS version and the key type allow. This matches the leaf key against `signature_algorithms`, the schemes the client accepts for the handshake signature; the signatures in the rest of the chain are a separate check against `signature_algorithms_cert`.",{"_3844":2984,"_33198":2971,"_22654":63608,"_5":15607,"_29907":63572,"_3297":63609},[],"If the client announces no scheme, the first compatible certificate is returned. If none is compatible, the first candidate is returned and the handshake fails with the underlying error.",{"_3844":2985,"_33198":2971,"_22654":63611,"_5":15607,"_29907":63572,"_3297":63612},[],"The client's order of preference prevails, so a client that lists ML-DSA first receives the post-quantum certificate and a client that lists ECDSA first receives the classical one, even if it also supports ML-DSA. A client with no post-quantum support never announces those schemes and receives the classical certificate. TLS 1.2 never selects ML-DSA or composite certificates. The server cannot be configured with its own order of preference.",{"_3844":2986,"_33198":2971,"_22654":63614,"_5":15607,"_29907":63576,"_3297":63615},[],"Traefik reads its Gateway API configuration from Kubernetes. The fork reads the listener option `traefik.io/tls-options`, whose value names the TLS option to apply to that listener: either `default`, or a qualified name such as `traefik-system-pqc@kubernetescrd`. This works for HTTPS listeners and for TLS listeners in `Terminate` mode that serve a `TLSRoute`. It is ignored in passthrough mode.",{"_3844":2987,"_33198":2971,"_22654":63617,"_5":15607,"_29907":63576,"_3297":63618},[],"A TLS option is where the supported key exchange groups and the client authentication mode are set. When several listeners share a parent router and name different options, the proxy logs a warning and uses isolated defaults for each. Without the fork, Traefik ignores the annotation, applies its own defaults and the settings cannot be controlled; devices that need mutual TLS then fail.",{"_3844":2988,"_33198":2971,"_22654":63620,"_5":15607,"_29907":63576,"_3297":63621},[],"The fork also adds `mlkem1024` to the group names accepted in `curvePreferences`, next to the hybrid groups that Traefik already maps.",{"_3844":2989,"_33198":2971,"_22654":63623,"_5":15607,"_29907":63580,"_3297":63624},[],"Client authentication is the standard Traefik mechanism, configured in the TLS option. With `RequireAndVerifyClientCert` and a client CA file the proxy validates the chain, and the verification of the client signature is done by the TLS stack of the Go fork, which has been tested with composite client certificates in a TLS 1.3 handshake. With `RequestClientCert`, which the Lamassu chart sets in its default option, the proxy checks that the client holds the key of the certificate it presents but does not validate the chain; the decision is delegated to the backend, which receives the certificate in a header (see Deployment with the Helm chart). No Traefik test covers post-quantum mutual TLS, and a client chain signed by a composite or post-quantum CA depends on the x509 code of the fork.",{"_3844":2990,"_33198":2971,"_22654":63626,"_5":15607,"_29907":63584,"_3297":63627},[],"The fork is not built from the Go image. The `build.sh` script requires an already compiled checkout of the Go fork, by default in `../go`, and checks that it is the fork before it forces `GOROOT` and `GOTOOLCHAIN=local`. It compiles the binary with `CGO_ENABLED=0`, builds the web UI unless `SKIP_WEBUI=1`, and packages the binary into an Alpine image with `docker buildx`. The default image is `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_3844":2991,"_33198":2971,"_22654":63629,"_5":15607,"_29907":63584,"_3297":63630},[],"Variable",{"_3844":2992,"_33198":2971,"_22654":63632,"_5":15607,"_29907":63584,"_3297":54792},[],{"_3844":2993,"_33198":2971,"_22654":63634,"_5":15607,"_29907":63584,"_3297":63635},[],"`GO_FORK_ROOT`",{"_3844":2994,"_33198":2971,"_22654":63637,"_5":15607,"_29907":63584,"_3297":63638},[],"Location of the compiled Go fork.",{"_3844":2995,"_33198":2971,"_22654":63640,"_5":15607,"_29907":63584,"_3297":63641},[],"`PLATFORMS`",{"_3844":2996,"_33198":2971,"_22654":63643,"_5":15607,"_29907":63584,"_3297":63644},[],"Target platforms; the default is `linux/amd64`.",{"_3844":2997,"_33198":2971,"_22654":63646,"_5":15607,"_29907":63584,"_3297":63647},[],"`SKIP_WEBUI`",{"_3844":2998,"_33198":2971,"_22654":63649,"_5":15607,"_29907":63584,"_3297":63650},[],"Skip building the web UI when set to `1`.",{"_3844":2999,"_33198":2971,"_22654":63652,"_5":15607,"_29907":63584,"_3297":63653},[],"`IMAGE`, `PUSH`",{"_3844":3000,"_33198":2971,"_22654":63655,"_5":15607,"_29907":63584,"_3297":63656},[],"Name of the image and whether to push it. Multi-platform builds require `PUSH=1`.",{"_3844":3001,"_33198":2971,"_22654":63658,"_5":15607,"_29907":63584,"_3297":63659},[],"The `pqc-*` tags are mutable and have been rebuilt in place, so pin the digest in production-like environments.",{"_3844":3002,"_33198":2971,"_22654":63661,"_5":15607,"_29907":63584,"_3297":63662},[],"The selection tests of the fork use pure ML-DSA-65 together with ECDSA P-256. Selecting a composite certificate depends on the fork's TLS stack knowing the composite key, which it does, but the proxy has no test for it.",{"_3844":3003,"_33198":2971,"_22654":63664,"_5":15607,"_29907":63584,"_3297":63665},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the proxy in front of Envoy Gateway with the chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_3844":3004,"_33198":2971,"_22654":63667,"_5":15607,"_29907":63584,"_3297":63668},[],"<Card title=\"Known limitations\" description=\"Interoperability and operational caveats.\" href=\"/docs/platform/pqc/limitations\" />",{"_3844":3005,"_33198":3005,"_5":16006,"_3297":63670,"_33604":63671,"_22654":63672,"_29907":3005},"Security",[54402],[],{"_3844":3006,"_33198":3005,"_22654":63674,"_5":15607,"_29907":3005,"_3297":63675},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3844":3007,"_33198":3005,"_5":33601,"_22654":63677,"_29907":63678,"_3297":63679},[],"/docs/pr-preview/pr-58/security#report-a-vulnerability","Report a vulnerability",{"_3844":3008,"_33198":3005,"_5":33601,"_22654":63681,"_29907":63682,"_3297":63683},[],"/docs/pr-preview/pr-58/security#what-to-include-in-a-report","What to include in a report",{"_3844":3009,"_33198":3005,"_5":33601,"_22654":63685,"_29907":63686,"_3297":63687},[],"/docs/pr-preview/pr-58/security#supported-versions","Supported versions",{"_3844":3010,"_33198":3005,"_5":33601,"_22654":63689,"_29907":63690,"_3297":63691},[],"/docs/pr-preview/pr-58/security#responsible-disclosure","Responsible disclosure",{"_3844":3011,"_33198":3005,"_22654":63693,"_5":15607,"_29907":3005,"_3297":63694},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3844":3012,"_33198":3005,"_22654":63696,"_5":15607,"_29907":63678,"_3297":63697},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3844":3013,"_33198":3005,"_22654":63699,"_5":15607,"_29907":63678,"_3297":63700},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3844":3014,"_33198":3005,"_22654":63702,"_5":15607,"_29907":63678,"_3297":16334},[],{"_3844":3015,"_33198":3005,"_22654":63704,"_5":15607,"_29907":63678,"_3297":16270},[],{"_3844":3016,"_33198":3005,"_22654":63706,"_5":15607,"_29907":63678,"_3297":16327},[],{"_3844":3017,"_33198":3005,"_22654":63708,"_5":15607,"_29907":63678,"_3297":63709},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3844":3018,"_33198":3005,"_22654":63711,"_5":15607,"_29907":63678,"_3297":63712},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3844":3019,"_33198":3005,"_22654":63714,"_5":15607,"_29907":63682,"_3297":63715},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3844":3020,"_33198":3005,"_22654":63717,"_5":15607,"_29907":63682,"_3297":63718},[],"Do not include in the report:",{"_3844":3021,"_33198":3005,"_22654":63720,"_5":15607,"_29907":63682,"_3297":63721},[],"Credentials, tokens, or private keys",{"_3844":3022,"_33198":3005,"_22654":63723,"_5":15607,"_29907":63682,"_3297":63724},[],"Customer data or customer-identifiable information",{"_3844":3023,"_33198":3005,"_22654":63726,"_5":15607,"_29907":63682,"_3297":63727},[],"Confidential architecture or internal infrastructure details",{"_3844":3024,"_33198":3005,"_22654":63729,"_5":15607,"_29907":63686,"_3297":63730},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3844":3025,"_33198":3005,"_22654":63732,"_5":15607,"_29907":63686,"_3297":63733},[],"For upgrade guidance, see Upgrades.",{"_3844":3026,"_33198":3005,"_22654":63735,"_5":15607,"_29907":63690,"_3297":63736},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3844":3027,"_33198":3005,"_22654":63738,"_5":15607,"_29907":63690,"_3297":63739},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3844":3028,"_33198":3005,"_22654":63741,"_5":15607,"_29907":63690,"_3297":63742},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3844":3029,"_33198":3005,"_22654":63744,"_5":15607,"_29907":63690,"_3297":63745},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3844":3030,"_33198":3005,"_22654":63747,"_5":15607,"_29907":63690,"_3297":63748},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3844":3031,"_33198":3031,"_5":16006,"_3297":63750,"_33604":63751,"_22654":63753,"_29907":3031},"3.8.0 to 4.0.0",[54402,63752],"Upgrades",[],{"_3844":3032,"_33198":3031,"_22654":63755,"_5":15607,"_29907":3031,"_3297":63756},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3844":3033,"_33198":3031,"_5":33601,"_22654":63758,"_29907":63759,"_3297":63760},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3844":3034,"_33198":3031,"_5":33601,"_22654":63762,"_29907":63763,"_3297":63764},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3844":3035,"_33198":3031,"_5":33601,"_22654":63766,"_29907":63767,"_3297":63768},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3844":3036,"_33198":3031,"_5":33601,"_22654":63770,"_29907":63771,"_3297":63772},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3844":3037,"_33198":3031,"_5":33601,"_22654":63774,"_29907":63775,"_3297":63776},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3844":3038,"_33198":3031,"_5":33601,"_22654":63778,"_29907":63779,"_3297":63780},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3844":3039,"_33198":3031,"_5":33601,"_22654":63782,"_29907":63783,"_3297":63784},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3844":3040,"_33198":3031,"_5":33601,"_22654":63786,"_29907":63787,"_3297":63788},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3844":3041,"_33198":3031,"_5":33601,"_22654":63790,"_29907":63791,"_3297":63792},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3844":3042,"_33198":3031,"_5":33601,"_22654":63794,"_29907":63795,"_3297":63796},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3844":3043,"_33198":3031,"_5":33601,"_22654":63798,"_29907":63799,"_3297":63800},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3844":3044,"_33198":3031,"_5":33601,"_22654":63802,"_29907":63803,"_3297":63804},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3844":3045,"_33198":3031,"_5":33601,"_22654":63806,"_29907":63807,"_3297":63808},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3844":3046,"_33198":3031,"_5":33601,"_22654":63810,"_29907":63811,"_3297":63812},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3844":3047,"_33198":3031,"_5":33601,"_22654":63814,"_29907":63815,"_3297":63816},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3844":3048,"_33198":3031,"_5":33601,"_22654":63818,"_29907":63819,"_3297":63820},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3844":3049,"_33198":3031,"_5":33601,"_22654":63822,"_29907":63823,"_3297":63824},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3844":3050,"_33198":3031,"_5":33601,"_22654":63826,"_29907":63827,"_3297":63828},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3844":3051,"_33198":3031,"_5":33601,"_22654":63830,"_29907":63831,"_3297":63832},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3844":3052,"_33198":3031,"_5":33601,"_22654":63834,"_29907":63835,"_3297":63836},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3844":3053,"_33198":3031,"_5":33601,"_22654":63838,"_29907":63839,"_3297":63840},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3844":3054,"_33198":3031,"_5":33601,"_22654":63842,"_29907":63843,"_3297":63844},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3844":3055,"_33198":3031,"_5":33601,"_22654":63846,"_29907":63847,"_3297":63848},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3844":3056,"_33198":3031,"_5":33601,"_22654":63850,"_29907":63851,"_3297":63852},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3844":3057,"_33198":3031,"_5":33601,"_22654":63854,"_29907":63855,"_3297":63856},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3844":3058,"_33198":3031,"_5":33601,"_22654":63858,"_29907":63859,"_3297":63860},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3844":3059,"_33198":3031,"_5":33601,"_22654":63862,"_29907":63863,"_3297":63864},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3844":3060,"_33198":3031,"_5":33601,"_22654":63866,"_29907":63867,"_3297":63868},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3844":3061,"_33198":3031,"_5":33601,"_22654":63870,"_29907":63871,"_3297":63872},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3844":3062,"_33198":3031,"_5":33601,"_22654":63874,"_29907":63875,"_3297":63876},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3844":3063,"_33198":3031,"_5":33601,"_22654":63878,"_29907":63879,"_3297":63880},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3844":3064,"_33198":3031,"_5":33601,"_22654":63882,"_29907":63883,"_3297":63884},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3844":3065,"_33198":3031,"_5":33601,"_22654":63886,"_29907":63887,"_3297":63888},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3844":3066,"_33198":3031,"_5":33601,"_22654":63890,"_29907":63891,"_3297":63892},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3844":3067,"_33198":3031,"_5":33601,"_22654":63894,"_29907":63895,"_3297":63896},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3844":3068,"_33198":3031,"_5":33601,"_22654":63898,"_29907":63899,"_3297":58447},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3844":3069,"_33198":3031,"_5":33601,"_22654":63901,"_29907":63902,"_3297":63903},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3844":3070,"_33198":3031,"_5":33601,"_22654":63905,"_29907":63906,"_3297":63907},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3844":3071,"_33198":3031,"_22654":63909,"_5":15607,"_29907":3031,"_3297":63910},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3844":3072,"_33198":3031,"_22654":63912,"_5":15607,"_29907":3031,"_3297":63913},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3844":3073,"_33198":3031,"_22654":63915,"_5":15607,"_29907":3031,"_3297":63916},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3844":3074,"_33198":3031,"_22654":63918,"_5":15607,"_29907":3031,"_3297":63919},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3844":3075,"_33198":3031,"_22654":63921,"_5":15607,"_29907":3031,"_3297":63922},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3844":3076,"_33198":3031,"_22654":63924,"_5":15607,"_29907":3031,"_3297":63925},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3844":3077,"_33198":3031,"_22654":63927,"_5":15607,"_29907":3031,"_3297":63928},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3844":3078,"_33198":3031,"_22654":63930,"_5":15607,"_29907":63763,"_3297":63931},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3844":3079,"_33198":3031,"_22654":63933,"_5":15607,"_29907":63763,"_3297":63934},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3844":3080,"_33198":3031,"_22654":63936,"_5":15607,"_29907":63767,"_3297":63937},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3844":3081,"_33198":3031,"_22654":63939,"_5":15607,"_29907":63767,"_3297":63940},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3844":3082,"_33198":3031,"_22654":63942,"_5":15607,"_29907":63771,"_3297":63943},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3844":3083,"_33198":3031,"_22654":63945,"_5":15607,"_29907":63775,"_3297":63946},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3844":3084,"_33198":3031,"_22654":63948,"_5":15607,"_29907":63775,"_3297":63949},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3844":3085,"_33198":3031,"_22654":63951,"_5":15607,"_29907":63775,"_3297":63952},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3844":3086,"_33198":3031,"_22654":63954,"_5":15607,"_29907":63775,"_3297":63955},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3844":3087,"_33198":3031,"_22654":63957,"_5":15607,"_29907":63775,"_3297":63958},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3844":3088,"_33198":3031,"_22654":63960,"_5":15607,"_29907":63779,"_3297":63961},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3844":3089,"_33198":3031,"_22654":63963,"_5":15607,"_29907":63779,"_3297":63964},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3844":3090,"_33198":3031,"_22654":63966,"_5":15607,"_29907":63779,"_3297":63967},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3844":3091,"_33198":3031,"_22654":63969,"_5":15607,"_29907":63779,"_3297":63970},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3844":3092,"_33198":3031,"_22654":63972,"_5":15607,"_29907":63779,"_3297":63973},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3844":3093,"_33198":3031,"_22654":63975,"_5":15607,"_29907":63783,"_3297":63976},[],"Change",{"_3844":3094,"_33198":3031,"_22654":63978,"_5":15607,"_29907":63783,"_3297":63979},[],"Who is affected",{"_3844":3095,"_33198":3031,"_22654":63981,"_5":15607,"_29907":63783,"_3297":63982},[],"Severity",{"_3844":3096,"_33198":3031,"_22654":63984,"_5":15607,"_29907":63783,"_3297":61232},[],{"_3844":3097,"_33198":3031,"_22654":63986,"_5":15607,"_29907":63783,"_3297":63792},[],{"_3844":3098,"_33198":3031,"_22654":63988,"_5":15607,"_29907":63783,"_3297":63989},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3844":3099,"_33198":3031,"_22654":63991,"_5":15607,"_29907":63783,"_3297":63992},[],"High: KMS and VA start on empty volumes",{"_3844":3100,"_33198":3031,"_22654":63994,"_5":15607,"_29907":63783,"_3297":63995},[],"Copy the data into the new volumes",{"_3844":3101,"_33198":3031,"_22654":63997,"_5":15607,"_29907":63783,"_3297":63796},[],{"_3844":3102,"_33198":3031,"_22654":63999,"_5":15607,"_29907":63783,"_3297":64000},[],"Every Helm release",{"_3844":3103,"_33198":3031,"_22654":64002,"_5":15607,"_29907":63783,"_3297":64003},[],"High: `helm upgrade` fails",{"_3844":3104,"_33198":3031,"_22654":64005,"_5":15607,"_29907":63783,"_3297":64006},[],"Remove or rename legacy keys",{"_3844":3105,"_33198":3031,"_22654":64008,"_5":15607,"_29907":63783,"_3297":63800},[],{"_3844":3106,"_33198":3031,"_22654":64010,"_5":15607,"_29907":63783,"_3297":64011},[],"Every deployment",{"_3844":3107,"_33198":3031,"_22654":64013,"_5":15607,"_29907":63783,"_3297":64014},[],"High: without a bootstrap principal there is no administrator",{"_3844":3108,"_33198":3031,"_22654":64016,"_5":15607,"_29907":63783,"_3297":64017},[],"Configure `services.authz`",{"_3844":3109,"_33198":3031,"_22654":64019,"_5":15607,"_29907":63783,"_3297":63804},[],{"_3844":3110,"_33198":3031,"_22654":64021,"_5":15607,"_29907":63783,"_3297":64000},[],{"_3844":3111,"_33198":3031,"_22654":64023,"_5":15607,"_29907":63783,"_3297":64024},[],"High: `helm upgrade` fails on the old keys",{"_3844":3112,"_33198":3031,"_22654":64026,"_5":15607,"_29907":63783,"_3297":64027},[],"Move JWKS and roles into `services.authz`",{"_3844":3113,"_33198":3031,"_22654":64029,"_5":15607,"_29907":63783,"_3297":63824},[],{"_3844":3114,"_33198":3031,"_22654":64031,"_5":15607,"_29907":63783,"_3297":64032},[],"3.8.0 deployments with per-service databases",{"_3844":3115,"_33198":3031,"_22654":64034,"_5":15607,"_29907":63783,"_3297":64035},[],"High: services find no data, or a migration aborts",{"_3844":3116,"_33198":3031,"_22654":64037,"_5":15607,"_29907":63783,"_3297":64038},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3844":3117,"_33198":3031,"_22654":64040,"_5":15607,"_29907":63783,"_3297":63828},[],{"_3844":3118,"_33198":3031,"_22654":64042,"_5":15607,"_29907":63783,"_3297":64043},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3844":3119,"_33198":3031,"_22654":64045,"_5":15607,"_29907":63783,"_3297":64046},[],"High: the backend no longer starts with them",{"_3844":3120,"_33198":3031,"_22654":64048,"_5":15607,"_29907":63783,"_3297":64049},[],"Move to PostgreSQL before upgrading",{"_3844":3121,"_33198":3031,"_22654":64051,"_5":15607,"_29907":63783,"_3297":64052},[],"Webhooks with file references",{"_3844":3122,"_33198":3031,"_22654":64054,"_5":15607,"_29907":63783,"_3297":64055},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3844":3123,"_33198":3031,"_22654":64057,"_5":15607,"_29907":63783,"_3297":64058},[],"High: enrollments calling the webhook fail",{"_3844":3124,"_33198":3031,"_22654":64060,"_5":15607,"_29907":63783,"_3297":64061},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3844":3125,"_33198":3031,"_22654":64063,"_5":15607,"_29907":63783,"_3297":63808},[],{"_3844":3126,"_33198":3031,"_22654":64065,"_5":15607,"_29907":63783,"_3297":64066},[],"Releases with per-service identity overrides or mounted key material",{"_3844":3127,"_33198":3031,"_22654":64068,"_5":15607,"_29907":63783,"_3297":64069},[],"Medium: services cannot read their files",{"_3844":3128,"_33198":3031,"_22654":64071,"_5":15607,"_29907":63783,"_3297":64072},[],"Remove the overrides and fix volume ownership",{"_3844":3129,"_33198":3031,"_22654":64074,"_5":15607,"_29907":63783,"_3297":63812},[],{"_3844":3130,"_33198":3031,"_22654":64076,"_5":15607,"_29907":63783,"_3297":64077},[],"Releases that set `amqp.tls`",{"_3844":3131,"_33198":3031,"_22654":64079,"_5":15607,"_29907":63783,"_3297":64080},[],"Medium: clients connect to the wrong port",{"_3844":3132,"_33198":3031,"_22654":64082,"_5":15607,"_29907":63783,"_3297":64083},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3844":3133,"_33198":3031,"_22654":64085,"_5":15607,"_29907":63783,"_3297":63832},[],{"_3844":3134,"_33198":3031,"_22654":64087,"_5":15607,"_29907":63783,"_3297":64088},[],"Installations whose CA keys predate the KMS",{"_3844":3135,"_33198":3031,"_22654":64090,"_5":15607,"_29907":63783,"_3297":64091},[],"Medium: CA keys stay unmanaged",{"_3844":3136,"_33198":3031,"_22654":64093,"_5":15607,"_29907":63783,"_3297":64094},[],"Run the CA-to-KMS migration",{"_3844":3137,"_33198":3031,"_22654":64096,"_5":15607,"_29907":63783,"_3297":64097},[],"Receiver certificate verification",{"_3844":3138,"_33198":3031,"_22654":64099,"_5":15607,"_29907":63783,"_3297":64100},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3844":3139,"_33198":3031,"_22654":64102,"_5":15607,"_29907":63783,"_3297":64103},[],"Medium: credentials go to an unverified receiver",{"_3844":3140,"_33198":3031,"_22654":64105,"_5":15607,"_29907":63783,"_3297":64106},[],"Set `insecure_skip_verify` to `false`",{"_3844":3141,"_33198":3031,"_22654":64108,"_5":15607,"_29907":63783,"_3297":63848},[],{"_3844":3142,"_33198":3031,"_22654":64110,"_5":15607,"_29907":63783,"_3297":64111},[],"Scripts and consoles that edit DMSs through the API",{"_3844":3143,"_33198":3031,"_22654":64113,"_5":15607,"_29907":63783,"_3297":64114},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3844":3144,"_33198":3031,"_22654":64116,"_5":15607,"_29907":63783,"_3297":64117},[],"Read the DMS before editing and use the new field",{"_3844":3145,"_33198":3031,"_22654":64119,"_5":15607,"_29907":63783,"_3297":63868},[],{"_3844":3146,"_33198":3031,"_22654":64121,"_5":15607,"_29907":63783,"_3297":64122},[],"Clients that create or update VA roles through the API",{"_3844":3147,"_33198":3031,"_22654":64124,"_5":15607,"_29907":63783,"_3297":64125},[],"Medium: requests with the old field return an error",{"_3844":3148,"_33198":3031,"_22654":64127,"_5":15607,"_29907":63783,"_3297":64128},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3844":3149,"_33198":3031,"_22654":64130,"_5":15607,"_29907":63783,"_3297":63864},[],{"_3844":3150,"_33198":3031,"_22654":64132,"_5":15607,"_29907":63783,"_3297":64133},[],"Consumers that read the device `events` field",{"_3844":3151,"_33198":3031,"_22654":64135,"_5":15607,"_29907":63783,"_3297":64136},[],"Medium: the field disappears",{"_3844":3152,"_33198":3031,"_22654":64138,"_5":15607,"_29907":63783,"_3297":64139},[],"Use the new event endpoints",{"_3844":3153,"_33198":3031,"_22654":64141,"_5":15607,"_29907":63783,"_3297":63816},[],{"_3844":3154,"_33198":3031,"_22654":64143,"_5":15607,"_29907":63783,"_3297":64144},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3844":3155,"_33198":3031,"_22654":64146,"_5":15607,"_29907":63783,"_3297":64147},[],"Low to medium: validation errors or changed defaults",{"_3844":3156,"_33198":3031,"_22654":64149,"_5":15607,"_29907":63783,"_3297":64150},[],"Update the values file",{"_3844":3157,"_33198":3031,"_22654":64152,"_5":15607,"_29907":63783,"_3297":63856},[],{"_3844":3158,"_33198":3031,"_22654":64154,"_5":15607,"_29907":63783,"_3297":64155},[],"Clients that send the DMS ID in the update body",{"_3844":3159,"_33198":3031,"_22654":64157,"_5":15607,"_29907":63783,"_3297":64158},[],"Low: the ID in the URL wins",{"_3844":3160,"_33198":3031,"_22654":64160,"_5":15607,"_29907":63783,"_3297":64161},[],"Send the ID in the URL",{"_3844":3161,"_33198":3031,"_22654":64163,"_5":15607,"_29907":63783,"_3297":63860},[],{"_3844":3162,"_33198":3031,"_22654":64165,"_5":15607,"_29907":63783,"_3297":64166},[],"Consumers that match on certificate `type`",{"_3844":3163,"_33198":3031,"_22654":64168,"_5":15607,"_29907":63783,"_3297":64169},[],"Low: two values are renamed",{"_3844":3164,"_33198":3031,"_22654":64171,"_5":15607,"_29907":63783,"_3297":64172},[],"Adapt consumers",{"_3844":3165,"_33198":3031,"_22654":64174,"_5":15607,"_29907":63783,"_3297":63852},[],{"_3844":3166,"_33198":3031,"_22654":64176,"_5":15607,"_29907":63783,"_3297":64177},[],"Any DMS",{"_3844":3167,"_33198":3031,"_22654":64179,"_5":15607,"_29907":63783,"_3297":64180},[],"Low: informational",{"_3844":3168,"_33198":3031,"_22654":64182,"_5":15607,"_29907":63783,"_3297":64183},[],"Read both blocks before editing",{"_3844":3169,"_33198":3031,"_22654":64185,"_5":15607,"_29907":63791,"_3297":64186},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3844":3170,"_33198":3031,"_22654":64188,"_5":15607,"_29907":63791,"_3297":64189},[],"Step 4 of the migration guide copies the data.",{"_3844":3171,"_33198":3031,"_22654":64191,"_5":15607,"_29907":63795,"_3297":64192},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3844":3172,"_33198":3031,"_22654":64194,"_5":15607,"_29907":63799,"_3297":64195},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3844":3173,"_33198":3031,"_22654":64197,"_5":15607,"_29907":63803,"_3297":64198},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3844":3174,"_33198":3031,"_22654":64200,"_5":15607,"_29907":63807,"_3297":64201},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3844":3175,"_33198":3031,"_22654":64203,"_5":15607,"_29907":63807,"_3297":64204},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3844":3176,"_33198":3031,"_22654":64206,"_5":15607,"_29907":63811,"_3297":64207},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3844":3177,"_33198":3031,"_22654":64209,"_5":15607,"_29907":63815,"_3297":64210},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3844":3178,"_33198":3031,"_22654":64212,"_5":15607,"_29907":63815,"_3297":64213},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3844":3179,"_33198":3031,"_22654":64215,"_5":15607,"_29907":63815,"_3297":64216},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3844":3180,"_33198":3031,"_22654":64218,"_5":15607,"_29907":63815,"_3297":64219},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3844":3181,"_33198":3031,"_22654":64221,"_5":15607,"_29907":63815,"_3297":64222},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3844":3182,"_33198":3031,"_22654":64224,"_5":15607,"_29907":63815,"_3297":64225},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3844":3183,"_33198":3031,"_22654":64227,"_5":15607,"_29907":63823,"_3297":64228},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3844":3184,"_33198":3031,"_22654":64230,"_5":15607,"_29907":63823,"_3297":64231},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3844":3185,"_33198":3031,"_22654":64233,"_5":15607,"_29907":63823,"_3297":64234},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3844":3186,"_33198":3031,"_22654":64236,"_5":15607,"_29907":63823,"_3297":64237},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3844":3187,"_33198":3031,"_22654":64239,"_5":15607,"_29907":63823,"_3297":64240},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3844":3188,"_33198":3031,"_22654":64242,"_5":15607,"_29907":63827,"_3297":64243},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3844":3189,"_33198":3031,"_22654":64245,"_5":15607,"_29907":63831,"_3297":64246},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3844":3190,"_33198":3031,"_22654":64248,"_5":15607,"_29907":63831,"_3297":64249},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3844":3191,"_33198":3031,"_22654":64251,"_5":15607,"_29907":63831,"_3297":64252},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3844":3192,"_33198":3031,"_22654":64254,"_5":15607,"_29907":63831,"_3297":64255},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3844":3193,"_33198":3031,"_22654":64257,"_5":15607,"_29907":63831,"_3297":64258},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3844":3194,"_33198":3031,"_22654":64260,"_5":15607,"_29907":63831,"_3297":64261},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3844":3195,"_33198":3031,"_22654":64263,"_5":15607,"_29907":63831,"_3297":64264},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_3844":3196,"_33198":3031,"_22654":64266,"_5":15607,"_29907":63835,"_3297":64267},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3844":3197,"_33198":3031,"_22654":64269,"_5":15607,"_29907":63843,"_3297":64270},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3844":3198,"_33198":3031,"_22654":64272,"_5":15607,"_29907":63843,"_3297":64273},[],"Field in 3.8.0",{"_3844":3199,"_33198":3031,"_22654":64275,"_5":15607,"_29907":63843,"_3297":64276},[],"Field in 4.0.0",{"_3844":3200,"_33198":3031,"_22654":64278,"_5":15607,"_29907":63843,"_3297":64279},[],"`validate_server_cert`",{"_3844":3201,"_33198":3031,"_22654":64281,"_5":15607,"_29907":63843,"_3297":64282},[],"`insecure_skip_verify` (value negated)",{"_3844":3202,"_33198":3031,"_22654":64284,"_5":15607,"_29907":63843,"_3297":64285},[],"`oidc`",{"_3844":3203,"_33198":3031,"_22654":64287,"_5":15607,"_29907":63843,"_3297":64288},[],"`jwt_options`",{"_3844":3204,"_33198":3031,"_22654":64290,"_5":15607,"_29907":63843,"_3297":64291},[],"`apikey`",{"_3844":3205,"_33198":3031,"_22654":64293,"_5":15607,"_29907":63843,"_3297":64294},[],"`apikey_options`",{"_3844":3206,"_33198":3031,"_22654":64296,"_5":15607,"_29907":63843,"_3297":64297},[],"`mtls`",{"_3844":3207,"_33198":3031,"_22654":64299,"_5":15607,"_29907":63843,"_3297":64300},[],"`mtls_options`",{"_3844":3208,"_33198":3031,"_22654":64302,"_5":15607,"_29907":63843,"_3297":64303},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3844":3209,"_33198":3031,"_22654":64305,"_5":15607,"_29907":63843,"_3297":64306},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3844":3210,"_33198":3031,"_22654":64308,"_5":15607,"_29907":63843,"_3297":64309},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3844":3211,"_33198":3031,"_22654":64311,"_5":15607,"_29907":63847,"_3297":64312},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3844":3212,"_33198":3031,"_22654":64314,"_5":15607,"_29907":63847,"_3297":64315},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3844":3213,"_33198":3031,"_22654":64317,"_5":15607,"_29907":63847,"_3297":64318},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3844":3214,"_33198":3031,"_22654":64320,"_5":15607,"_29907":63851,"_3297":64321},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3844":3215,"_33198":3031,"_22654":64323,"_5":15607,"_29907":63855,"_3297":64324},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3844":3216,"_33198":3031,"_22654":64326,"_5":15607,"_29907":63859,"_3297":64327},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3844":3217,"_33198":3031,"_22654":64329,"_5":15607,"_29907":63863,"_3297":64330},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3844":3218,"_33198":3031,"_22654":64332,"_5":15607,"_29907":63863,"_3297":64333},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3844":3219,"_33198":3031,"_22654":64335,"_5":15607,"_29907":63863,"_3297":64336},[],"`POST /v1/devices/:id/events` creates an event.",{"_3844":3220,"_33198":3031,"_22654":64338,"_5":15607,"_29907":63863,"_3297":64339},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3844":3221,"_33198":3031,"_22654":64341,"_5":15607,"_29907":63867,"_3297":64342},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3844":3222,"_33198":3031,"_22654":64344,"_5":15607,"_29907":63871,"_3297":64345},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3844":3223,"_33198":3031,"_22654":64347,"_5":15607,"_29907":63875,"_3297":64348},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3844":3224,"_33198":3031,"_22654":64350,"_5":15607,"_29907":63875,"_3297":64351},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3844":3225,"_33198":3031,"_22654":64353,"_5":15607,"_29907":63875,"_3297":64354},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3844":3226,"_33198":3031,"_22654":64356,"_5":15607,"_29907":63875,"_3297":64357},[],"Record the names of your local-storage PVCs:",{"_3844":3227,"_33198":3031,"_22654":64359,"_5":15607,"_29907":63875,"_3297":64360},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3844":3228,"_33198":3031,"_22654":64362,"_5":15607,"_29907":63879,"_3297":64363},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3844":3229,"_33198":3031,"_22654":64365,"_5":15607,"_29907":63879,"_3297":64366},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3844":3230,"_33198":3031,"_22654":64368,"_5":15607,"_29907":63879,"_3297":64369},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3844":3231,"_33198":3031,"_22654":64371,"_5":15607,"_29907":63879,"_3297":64372},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3844":3232,"_33198":3031,"_22654":64374,"_5":15607,"_29907":63879,"_3297":64375},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3844":3233,"_33198":3031,"_22654":64377,"_5":15607,"_29907":63879,"_3297":64378},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3844":3234,"_33198":3031,"_22654":64380,"_5":15607,"_29907":63879,"_3297":64381},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3844":3235,"_33198":3031,"_22654":64383,"_5":15607,"_29907":63879,"_3297":64384},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3844":3236,"_33198":3031,"_22654":64386,"_5":15607,"_29907":63879,"_3297":64387},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3844":3237,"_33198":3031,"_22654":64389,"_5":15607,"_29907":63879,"_3297":64390},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3844":3238,"_33198":3031,"_22654":64392,"_5":15607,"_29907":63879,"_3297":64393},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3844":3239,"_33198":3031,"_22654":64395,"_5":15607,"_29907":63879,"_3297":64396},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3844":3240,"_33198":3031,"_22654":64398,"_5":15607,"_29907":63883,"_3297":64399},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3844":3241,"_33198":3031,"_22654":64401,"_5":15607,"_29907":63883,"_3297":64402},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3844":3242,"_33198":3031,"_22654":64404,"_5":15607,"_29907":63887,"_3297":64405},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3844":3243,"_33198":3031,"_22654":64407,"_5":15607,"_29907":63887,"_3297":64408},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3844":3244,"_33198":3031,"_22654":64410,"_5":15607,"_29907":63887,"_3297":64411},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3844":3245,"_33198":3031,"_22654":64413,"_5":15607,"_29907":63887,"_3297":64414},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3844":3246,"_33198":3031,"_22654":64416,"_5":15607,"_29907":63887,"_3297":64417},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3844":3247,"_33198":3031,"_22654":64419,"_5":15607,"_29907":63887,"_3297":64420},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3844":3248,"_33198":3031,"_22654":64422,"_5":15607,"_29907":63887,"_3297":64423},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3844":3249,"_33198":3031,"_22654":64425,"_5":15607,"_29907":63887,"_3297":64426},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3844":3250,"_33198":3031,"_22654":64428,"_5":15607,"_29907":63887,"_3297":64429},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3844":3251,"_33198":3031,"_22654":64431,"_5":15607,"_29907":63887,"_3297":64432},[],"**Remove the helper and restore the recorded replica counts:**",{"_3844":3252,"_33198":3031,"_22654":64434,"_5":15607,"_29907":63887,"_3297":64435},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3844":3253,"_33198":3031,"_22654":64437,"_5":15607,"_29907":63891,"_3297":64438},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3844":3254,"_33198":3031,"_22654":64440,"_5":15607,"_29907":63891,"_3297":64441},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3844":3255,"_33198":3031,"_22654":64443,"_5":15607,"_29907":63895,"_3297":64444},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3844":3256,"_33198":3031,"_22654":64446,"_5":15607,"_29907":63895,"_3297":64447},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3844":3257,"_33198":3031,"_22654":64449,"_5":15607,"_29907":63895,"_3297":64450},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3844":3258,"_33198":3031,"_22654":64452,"_5":15607,"_29907":63895,"_3297":64453},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3844":3259,"_33198":3031,"_22654":64455,"_5":15607,"_29907":63895,"_3297":64456},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3844":3260,"_33198":3031,"_22654":64458,"_5":15607,"_29907":63895,"_3297":64459},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3844":3261,"_33198":3031,"_22654":64461,"_5":15607,"_29907":63895,"_3297":64462},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3844":3262,"_33198":3031,"_22654":64464,"_5":15607,"_29907":63899,"_3297":64465},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3844":3263,"_33198":3031,"_22654":64467,"_5":15607,"_29907":63899,"_3297":64468},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3844":3264,"_33198":3031,"_22654":64470,"_5":15607,"_29907":63899,"_3297":64471},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3844":3265,"_33198":3031,"_22654":64473,"_5":15607,"_29907":63899,"_3297":64474},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3844":3266,"_33198":3031,"_22654":64476,"_5":15607,"_29907":63899,"_3297":64477},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3844":3267,"_33198":3031,"_22654":64479,"_5":15607,"_29907":63899,"_3297":64480},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3844":3268,"_33198":3031,"_22654":64482,"_5":15607,"_29907":63899,"_3297":64483},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3844":3269,"_33198":3031,"_22654":64485,"_5":15607,"_29907":63899,"_3297":64486},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3844":3270,"_33198":3031,"_22654":64488,"_5":15607,"_29907":63899,"_3297":64489},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3844":3271,"_33198":3031,"_22654":64491,"_5":15607,"_29907":63899,"_3297":64492},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3844":3272,"_33198":3031,"_22654":64494,"_5":15607,"_29907":63899,"_3297":64495},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3844":3273,"_33198":3031,"_22654":64497,"_5":15607,"_29907":63902,"_3297":64498},[],"After the upgrade, check in this order:",{"_3844":3274,"_33198":3031,"_22654":64500,"_5":15607,"_29907":63902,"_3297":64501},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3844":3275,"_33198":3031,"_22654":64503,"_5":15607,"_29907":63902,"_3297":64504},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3844":3276,"_33198":3031,"_22654":64506,"_5":15607,"_29907":63902,"_3297":64507},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3844":3277,"_33198":3031,"_22654":64509,"_5":15607,"_29907":63902,"_3297":64510},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3844":3278,"_33198":3031,"_22654":64512,"_5":15607,"_29907":63902,"_3297":64513},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3844":3279,"_33198":3031,"_22654":64515,"_5":15607,"_29907":63902,"_3297":64516},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3844":3280,"_33198":3031,"_22654":64518,"_5":15607,"_29907":63902,"_3297":64519},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3844":3281,"_33198":3031,"_22654":64521,"_5":15607,"_29907":63902,"_3297":64522},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3844":3282,"_33198":3031,"_22654":64524,"_5":15607,"_29907":63902,"_3297":64525},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3844":3283,"_33198":3031,"_22654":64527,"_5":15607,"_29907":63902,"_3297":64528},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3844":3284,"_33198":3031,"_22654":64530,"_5":15607,"_29907":63902,"_3297":64531},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3844":3285,"_33198":3031,"_22654":64533,"_5":15607,"_29907":63902,"_3297":64534},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3844":3286,"_33198":3031,"_22654":64536,"_5":15607,"_29907":63902,"_3297":64537},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3844":3287,"_33198":3031,"_22654":64539,"_5":15607,"_29907":63902,"_3297":64540},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3844":3288,"_33198":3031,"_22654":64542,"_5":15607,"_29907":63906,"_3297":64543},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3844":3289,"_33198":3031,"_22654":64545,"_5":15607,"_29907":63906,"_3297":64546},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3844":3290,"_33198":3031,"_22654":64548,"_5":15607,"_29907":63906,"_3297":64549},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3844":3291,"_33198":3031,"_22654":64551,"_5":15607,"_29907":63906,"_3297":64552},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3844":3292,"_33198":3031,"_22654":64554,"_5":15607,"_29907":63906,"_3297":64555},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_64558":19484,"_64559":64560,"_64561":64562,"_64563":64564,"_19603":3332,"_77690":3332},"language","sortableProperties",[3297,33198,5,29907],"sortablePropertiesWithTypes",{"_3297":27123,"_33198":27123,"_5":27123,"_29907":27123},"sorts",{"_3297":64565,"_33198":67847,"_5":71128,"_29907":74409},{"_5104":64566,"_64567":64568,"_5":27123},{"_15694":3638,"_11301":10269,"_11245":5929,"_11150":8201,"_11376":5910,"_11158":5606,"_15715":3526,"_11166":13916,"_28527":5080,"_32341":4043,"_32375":5935,"_31849":15091,"_32441":3441,"_32030":26524,"_32447":6775,"_32409":32665,"_32453":5632,"_32458":5335,"_32399":3618,"_32943":11139,"_37981":5064,"_37983":9790,"_32987":6345,"_16152":8167,"_32967":4634,"_37989":8065,"_32996":6749,"_28511":3730,"_32938":9028,"_33013":7128,"_33055":8092,"_37996":6353,"_37998":3455,"_32047":3408,"_38001":3694,"_33084":5593,"_33072":7664,"_33045":4058,"_33078":6848,"_31912":6062,"_31960":33047,"_31966":4138,"_31972":4753,"_11153":5166,"_31978":6576,"_31984":3514,"_38015":6873,"_31954":8233,"_31990":13323,"_31807":11552,"_38021":3423,"_31854":29103,"_31876":5228,"_31882":4516,"_38027":7999,"_16145":8162,"_38030":5653,"_33265":13919,"_38034":12937,"_33116":7556,"_38037":3516,"_38039":5811,"_38041":21982,"_21496":7020,"_11161":19906,"_38045":19856,"_31827":4886,"_38048":3941,"_38050":5618,"_38052":4215,"_38054":22233,"_33029":5430,"_32354":13426,"_38058":16489,"_38060":6346,"_33180":4847,"_32494":7669,"_38064":9354,"_38066":11530,"_31866":5948,"_38069":3602,"_38071":4069,"_38073":3683,"_32002":3614,"_32024":7654,"_31195":4870,"_11169":21984,"_38079":6629,"_38081":11534,"_32079":12412,"_38085":5106,"_28530":6505,"_38089":26214,"_38091":4776,"_38093":5108,"_38095":6558,"_38097":10911,"_38099":4430,"_32068":9466,"_32348":6495,"_32370":3453,"_38104":4885,"_38106":7670,"_381