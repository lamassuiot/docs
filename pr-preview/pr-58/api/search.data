135":69160,"_47137":69163,"_47139":69166},{"_4190":15,"_34937":15,"_5":16871,"_3630":58060,"_35372":58061,"_23830":58065,"_31422":15},"Deploy from AWS Marketplace",[58062,58063,58064],"Docs","Deployment","Other models",[],{"_4190":16,"_34937":15,"_23830":58067,"_5":16479,"_31422":15,"_3630":58068},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_4190":17,"_34937":15,"_5":35369,"_23830":58070,"_31422":58071,"_3630":58072},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#before-you-begin","Before you begin",{"_4190":18,"_34937":15,"_5":35369,"_23830":58074,"_31422":58075,"_3630":58076},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_4190":19,"_34937":15,"_5":35369,"_23830":58078,"_31422":58079,"_3630":58080},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#open-the-offer","Open the offer",{"_4190":20,"_34937":15,"_5":35369,"_23830":58082,"_31422":58083,"_3630":58084},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_4190":21,"_34937":15,"_5":35369,"_23830":58086,"_31422":58087,"_3630":58088},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#limit-network-access","Limit network access",{"_4190":22,"_34937":15,"_5":35369,"_23830":58090,"_31422":58091,"_3630":58092},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_4190":23,"_34937":15,"_5":35369,"_23830":58094,"_31422":58095,"_3630":58096},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#next-step","Next step",{"_4190":24,"_34937":15,"_23830":58098,"_5":16479,"_31422":15,"_3630":58099},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_4190":25,"_34937":15,"_23830":58101,"_5":16479,"_31422":58071,"_3630":58102},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_4190":26,"_34937":15,"_23830":58104,"_5":16479,"_31422":58071,"_3630":58105},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_4190":27,"_34937":15,"_23830":58107,"_5":16479,"_31422":58071,"_3630":58108},[],"A security group allowing the necessary endpoints.",{"_4190":28,"_34937":15,"_23830":58110,"_5":16479,"_31422":58075,"_3630":58111},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_4190":29,"_34937":15,"_23830":58113,"_5":16479,"_31422":58075,"_3630":58114},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_4190":30,"_34937":15,"_23830":58116,"_5":16479,"_31422":58075,"_3630":58117},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_4190":31,"_34937":15,"_23830":58119,"_5":16479,"_31422":58079,"_3630":58120},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_4190":32,"_34937":15,"_23830":58122,"_5":16479,"_31422":58083,"_3630":58123},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_4190":33,"_34937":15,"_23830":58125,"_5":16479,"_31422":58087,"_3630":58126},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_4190":34,"_34937":15,"_23830":58128,"_5":16479,"_31422":58091,"_3630":58129},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_4190":35,"_34937":15,"_23830":58131,"_5":16479,"_31422":58095,"_3630":58132},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_4190":36,"_34937":36,"_5":16871,"_3630":58134,"_35372":58135,"_23830":58136,"_31422":36},"Deploy Lamassu",[58062,58063],[],{"_4190":37,"_34937":36,"_23830":58138,"_5":16479,"_31422":36,"_3630":58139},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_4190":38,"_34937":36,"_5":35369,"_23830":58141,"_31422":58142,"_3630":58143},[],"/docs/pr-preview/pr-58/deployment/overview#choose-a-model","Choose a model",{"_4190":39,"_34937":36,"_5":35369,"_23830":58145,"_31422":58146,"_3630":58147},[],"/docs/pr-preview/pr-58/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_4190":40,"_34937":36,"_5":35369,"_23830":58149,"_31422":58150,"_3630":58151},[],"/docs/pr-preview/pr-58/deployment/overview#after-deployment","After deployment",{"_4190":41,"_34937":36,"_23830":58153,"_5":16479,"_31422":36,"_3630":58154},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_4190":42,"_34937":36,"_23830":58156,"_5":16479,"_31422":58142,"_3630":58157},[],"Model",{"_4190":43,"_34937":36,"_23830":58159,"_5":16479,"_31422":58142,"_3630":58160},[],"Recommended for",{"_4190":44,"_34937":36,"_23830":58162,"_5":16479,"_31422":58142,"_3630":58163},[],"Who operates the infrastructure",{"_4190":45,"_34937":36,"_23830":58165,"_5":16479,"_31422":58142,"_3630":58166},[],"Starting point",{"_4190":46,"_34937":36,"_23830":58168,"_5":16479,"_31422":58142,"_3630":58169},[],"Kubernetes self-managed",{"_4190":47,"_34937":36,"_23830":58171,"_5":16479,"_31422":58142,"_3630":58172},[],"Production, regulated environments and custom deployments",{"_4190":48,"_34937":36,"_23830":58174,"_5":16479,"_31422":58142,"_3630":58175},[],"Your team",{"_4190":49,"_34937":36,"_23830":58177,"_5":16479,"_31422":58142,"_3630":58178},[],"Helm or Fastlane",{"_4190":50,"_34937":36,"_23830":58180,"_5":16479,"_31422":58142,"_3630":58181},[],"AWS Marketplace",{"_4190":51,"_34937":36,"_23830":58183,"_5":16479,"_31422":58142,"_3630":58184},[],"Evaluation or a dedicated deployment inside an AWS account",{"_4190":52,"_34937":36,"_23830":58186,"_5":16479,"_31422":58142,"_3630":58175},[],{"_4190":53,"_34937":36,"_23830":58188,"_5":16479,"_31422":58142,"_3630":58189},[],"Preconfigured image on EC2",{"_4190":54,"_34937":36,"_23830":58191,"_5":16479,"_31422":58142,"_3630":58192},[],"SaaS",{"_4190":55,"_34937":36,"_23830":58194,"_5":16479,"_31422":58142,"_3630":58195},[],"Teams that want to use the platform without operating it",{"_4190":56,"_34937":36,"_23830":58197,"_5":16479,"_31422":58142,"_3630":58198},[],"Lamassu",{"_4190":57,"_34937":36,"_23830":58200,"_5":16479,"_31422":58142,"_3630":58201},[],"Managed subscription",{"_4190":58,"_34937":36,"_23830":58203,"_5":16479,"_31422":58142,"_3630":58204},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_4190":59,"_34937":36,"_23830":58206,"_5":16479,"_31422":58142,"_3630":58207},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_4190":60,"_34937":36,"_23830":58209,"_5":16479,"_31422":58142,"_3630":58210},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_4190":61,"_34937":36,"_23830":58212,"_5":16479,"_31422":58146,"_3630":58213},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_4190":62,"_34937":36,"_23830":58215,"_5":16479,"_31422":58150,"_3630":58216},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_4190":63,"_34937":63,"_5":16871,"_3630":58218,"_35372":58219,"_23830":58220,"_31422":63},"Use Lamassu as SaaS",[58062,58063,58064],[],{"_4190":64,"_34937":63,"_23830":58222,"_5":16479,"_31422":63,"_3630":58223},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_4190":65,"_34937":63,"_5":35369,"_23830":58225,"_31422":58226,"_3630":58227},[],"/docs/pr-preview/pr-58/deployment/saas#what-the-service-manages","What the service manages",{"_4190":66,"_34937":63,"_5":35369,"_23830":58229,"_31422":58230,"_3630":58231},[],"/docs/pr-preview/pr-58/deployment/saas#plans","Plans",{"_4190":67,"_34937":63,"_5":35369,"_23830":58233,"_31422":58234,"_3630":58235},[],"/docs/pr-preview/pr-58/deployment/saas#request-access","Request access",{"_4190":68,"_34937":63,"_23830":58237,"_5":16479,"_31422":63,"_3630":58238},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_4190":69,"_34937":63,"_23830":58240,"_5":16479,"_31422":58226,"_3630":58241},[],"Platform availability and maintenance.",{"_4190":70,"_34937":63,"_23830":58243,"_5":16479,"_31422":58226,"_3630":58244},[],"Automatic backups.",{"_4190":71,"_34937":63,"_23830":58246,"_5":16479,"_31422":58226,"_3630":58247},[],"Version upgrades.",{"_4190":72,"_34937":63,"_23830":58249,"_5":16479,"_31422":58226,"_3630":58250},[],"Technical support and SLA according to your plan.",{"_4190":73,"_34937":63,"_23830":58252,"_5":16479,"_31422":58230,"_3630":58253},[],"Plan",{"_4190":74,"_34937":63,"_23830":58255,"_5":16479,"_31422":58230,"_3630":58256},[],"Devices",{"_4190":75,"_34937":63,"_23830":58258,"_5":16479,"_31422":58230,"_3630":58259},[],"Support",{"_4190":76,"_34937":63,"_23830":58261,"_5":16479,"_31422":58230,"_3630":58262},[],"SLA",{"_4190":77,"_34937":63,"_23830":58264,"_5":16479,"_31422":58230,"_3630":58265},[],"Starter",{"_4190":78,"_34937":63,"_23830":58267,"_5":16479,"_31422":58230,"_3630":58268},[],"Up to 1,000",{"_4190":79,"_34937":63,"_23830":58270,"_5":16479,"_31422":58230,"_3630":58271},[],"Email",{"_4190":80,"_34937":63,"_23830":58273,"_5":16479,"_31422":58230,"_3630":58274},[],"99.5 %",{"_4190":81,"_34937":63,"_23830":58276,"_5":16479,"_31422":58230,"_3630":58277},[],"Professional",{"_4190":82,"_34937":63,"_23830":58279,"_5":16479,"_31422":58230,"_3630":58280},[],"Up to 10,000",{"_4190":83,"_34937":63,"_23830":58282,"_5":16479,"_31422":58230,"_3630":58283},[],"Email and chat",{"_4190":84,"_34937":63,"_23830":58285,"_5":16479,"_31422":58230,"_3630":58286},[],"99.9 %",{"_4190":85,"_34937":63,"_23830":58288,"_5":16479,"_31422":58230,"_3630":58289},[],"Enterprise",{"_4190":86,"_34937":63,"_23830":58291,"_5":16479,"_31422":58230,"_3630":58292},[],"Unlimited",{"_4190":87,"_34937":63,"_23830":58294,"_5":16479,"_31422":58230,"_3630":58295},[],"Dedicated",{"_4190":88,"_34937":63,"_23830":58297,"_5":16479,"_31422":58230,"_3630":58298},[],"99.99 %",{"_4190":89,"_34937":63,"_23830":58300,"_5":16479,"_31422":58234,"_3630":58301},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_4190":90,"_34937":63,"_23830":58303,"_5":16479,"_31422":58234,"_3630":58304},[],"When you receive your instance's credentials, continue with Get started.",{"_4190":91,"_34937":91,"_5":16871,"_3630":58306,"_35372":58307,"_23830":58308,"_31422":91},"Fastlane",[58062,58063,58169],[],{"_4190":92,"_34937":91,"_23830":58310,"_5":16479,"_31422":91,"_3630":58311},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_4190":93,"_34937":91,"_5":35369,"_23830":58313,"_31422":58314,"_3630":58315},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_4190":94,"_34937":91,"_5":35369,"_23830":58317,"_31422":58318,"_3630":58319},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_4190":95,"_34937":91,"_5":35369,"_23830":58321,"_31422":58322,"_3630":58072},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#before-you-begin",{"_4190":96,"_34937":91,"_5":35369,"_23830":58324,"_31422":58325,"_3630":58326},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#quick-start","Quick start",{"_4190":97,"_34937":91,"_5":35369,"_23830":58328,"_31422":58329,"_3630":58330},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_4190":98,"_34937":91,"_5":35369,"_23830":58332,"_31422":58333,"_3630":58334},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_4190":99,"_34937":91,"_5":35369,"_23830":58336,"_31422":58337,"_3630":58338},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#development-mode","Development mode",{"_4190":100,"_34937":91,"_5":35369,"_23830":58340,"_31422":58341,"_3630":58342},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_4190":101,"_34937":91,"_5":35369,"_23830":58344,"_31422":58345,"_3630":58346},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_4190":102,"_34937":91,"_5":35369,"_23830":58348,"_31422":58349,"_3630":58350},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_4190":103,"_34937":91,"_5":35369,"_23830":58352,"_31422":58353,"_3630":58354},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_4190":104,"_34937":91,"_23830":58356,"_5":16479,"_31422":58314,"_3630":58357},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_4190":105,"_34937":91,"_23830":58359,"_5":16479,"_31422":58314,"_3630":58360},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_4190":106,"_34937":91,"_23830":58362,"_5":16479,"_31422":58318,"_3630":58363},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_4190":107,"_34937":91,"_23830":58365,"_5":16479,"_31422":58318,"_3630":58366},[],"Fastlane installs or configures",{"_4190":108,"_34937":91,"_23830":58368,"_5":16479,"_31422":58318,"_3630":58369},[],"You still provide",{"_4190":109,"_34937":91,"_23830":58371,"_5":16479,"_31422":58318,"_3630":58372},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_4190":110,"_34937":91,"_23830":58374,"_5":16479,"_31422":58318,"_3630":58375},[],"The Kubernetes cluster, nodes and persistent storage",{"_4190":111,"_34937":91,"_23830":58377,"_5":16479,"_31422":58318,"_3630":58378},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_4190":112,"_34937":91,"_23830":58380,"_5":16479,"_31422":58318,"_3630":58381},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_4190":113,"_34937":91,"_23830":58383,"_5":16479,"_31422":58318,"_3630":58384},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_4190":114,"_34937":91,"_23830":58386,"_5":16479,"_31422":58318,"_3630":58387},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_4190":115,"_34937":91,"_23830":58389,"_5":16479,"_31422":58318,"_3630":58390},[],"Optional observability and lab HSM components",{"_4190":116,"_34937":91,"_23830":58392,"_5":16479,"_31422":58318,"_3630":58393},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_4190":117,"_34937":91,"_23830":58395,"_5":16479,"_31422":58318,"_3630":58396},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_4190":118,"_34937":91,"_23830":58398,"_5":16479,"_31422":58322,"_3630":58399},[],"You need:",{"_4190":119,"_34937":91,"_23830":58401,"_5":16479,"_31422":58322,"_3630":58402},[],"an existing Kubernetes cluster",{"_4190":120,"_34937":91,"_23830":58404,"_5":16479,"_31422":58322,"_3630":58405},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_4190":121,"_34937":91,"_23830":58407,"_5":16479,"_31422":58322,"_3630":58408},[],"`yq`",{"_4190":122,"_34937":91,"_23830":58410,"_5":16479,"_31422":58322,"_3630":27019},[],{"_4190":123,"_34937":91,"_23830":58412,"_5":16479,"_31422":58322,"_3630":58413},[],"`jq` only when using `--sample-data` or `--development`",{"_4190":124,"_34937":91,"_23830":58415,"_5":16479,"_31422":58322,"_3630":58416},[],"`ssh-keygen` only when using `--with-hsm`",{"_4190":125,"_34937":91,"_23830":58418,"_5":16479,"_31422":58322,"_3630":58419},[],"free external ports 80 and 443 on a single-node K3s host",{"_4190":126,"_34937":91,"_23830":58421,"_5":16479,"_31422":58322,"_3630":58422},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_4190":127,"_34937":91,"_23830":58424,"_5":16479,"_31422":58322,"_3630":58425},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_4190":128,"_34937":91,"_23830":58427,"_5":16479,"_31422":58325,"_3630":58428},[],"Run the script from a clone of the Helm repository:",{"_4190":129,"_34937":91,"_23830":58430,"_5":16479,"_31422":58325,"_3630":58431},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_4190":130,"_34937":91,"_23830":58433,"_5":16479,"_31422":58329,"_3630":58434},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_4190":131,"_34937":91,"_23830":58436,"_5":16479,"_31422":58329,"_3630":58437},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_4190":132,"_34937":91,"_23830":58439,"_5":16479,"_31422":58329,"_3630":58440},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_4190":133,"_34937":91,"_23830":58442,"_5":16479,"_31422":58329,"_3630":58443},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_4190":134,"_34937":91,"_23830":58445,"_5":16479,"_31422":58333,"_3630":58446},[],"Option",{"_4190":135,"_34937":91,"_23830":58448,"_5":16479,"_31422":58333,"_3630":58449},[],"Default",{"_4190":136,"_34937":91,"_23830":58451,"_5":16479,"_31422":58333,"_3630":58452},[],"Purpose",{"_4190":137,"_34937":91,"_23830":58454,"_5":16479,"_31422":58333,"_3630":58455},[],"`-h`, `--help`",{"_4190":138,"_34937":91,"_23830":58457,"_5":16479,"_31422":58333,"_3630":58458},[],"—",{"_4190":139,"_34937":91,"_23830":58460,"_5":16479,"_31422":58333,"_3630":58461},[],"Show help",{"_4190":140,"_34937":91,"_23830":58463,"_5":16479,"_31422":58333,"_3630":58464},[],"`-c`, `--context`",{"_4190":141,"_34937":91,"_23830":58466,"_5":16479,"_31422":58333,"_3630":58467},[],"current context",{"_4190":142,"_34937":91,"_23830":58469,"_5":16479,"_31422":58333,"_3630":58470},[],"Select the kubeconfig context for kubectl and Helm",{"_4190":143,"_34937":91,"_23830":58472,"_5":16479,"_31422":58333,"_3630":58473},[],"`-n`, `--non-interactive`",{"_4190":144,"_34937":91,"_23830":58475,"_5":16479,"_31422":58333,"_3630":7581},[],{"_4190":145,"_34937":91,"_23830":58477,"_5":16479,"_31422":58333,"_3630":58478},[],"Skip prompts and generate dependency credentials",{"_4190":146,"_34937":91,"_23830":58480,"_5":16479,"_31422":58333,"_3630":58481},[],"`-ns`, `--namespace`",{"_4190":147,"_34937":91,"_23830":58483,"_5":16479,"_31422":58333,"_3630":58484},[],"`lamassu-dev`",{"_4190":148,"_34937":91,"_23830":58486,"_5":16479,"_31422":58333,"_3630":58487},[],"Namespace for the installation",{"_4190":149,"_34937":91,"_23830":58489,"_5":16479,"_31422":58333,"_3630":58490},[],"`-d`, `--domain`",{"_4190":150,"_34937":91,"_23830":58492,"_5":16479,"_31422":58333,"_3630":58493},[],"`dev.lamassu.io`",{"_4190":151,"_34937":91,"_23830":58495,"_5":16479,"_31422":58333,"_3630":58496},[],"Domain used by the UI, OIDC and certificate",{"_4190":152,"_34937":91,"_23830":58498,"_5":16479,"_31422":58333,"_3630":58499},[],"`-v`, `--version`",{"_4190":153,"_34937":91,"_23830":58501,"_5":16479,"_31422":58333,"_3630":17323},[],{"_4190":154,"_34937":91,"_23830":58503,"_5":16479,"_31422":58333,"_3630":58504},[],"Lamassu chart version",{"_4190":155,"_34937":91,"_23830":58506,"_5":16479,"_31422":58333,"_3630":58507},[],"`--https-port`",{"_4190":156,"_34937":91,"_23830":58509,"_5":16479,"_31422":58333,"_3630":58510},[],"`443`",{"_4190":157,"_34937":91,"_23830":58512,"_5":16479,"_31422":58333,"_3630":58513},[],"Gateway HTTPS listener port",{"_4190":158,"_34937":91,"_23830":58515,"_5":16479,"_31422":58333,"_3630":58516},[],"`--http-port`",{"_4190":159,"_34937":91,"_23830":58518,"_5":16479,"_31422":58333,"_3630":58519},[],"`80`",{"_4190":160,"_34937":91,"_23830":58521,"_5":16479,"_31422":58333,"_3630":58522},[],"Gateway HTTP listener port",{"_4190":161,"_34937":91,"_23830":58524,"_5":16479,"_31422":58333,"_3630":58525},[],"`--tls-crt`",{"_4190":162,"_34937":91,"_23830":58527,"_5":16479,"_31422":58333,"_3630":58458},[],{"_4190":163,"_34937":91,"_23830":58529,"_5":16479,"_31422":58333,"_3630":58530},[],"PEM certificate for downstream TLS",{"_4190":164,"_34937":91,"_23830":58532,"_5":16479,"_31422":58333,"_3630":58533},[],"`--tls-key`",{"_4190":165,"_34937":91,"_23830":58535,"_5":16479,"_31422":58333,"_3630":58458},[],{"_4190":166,"_34937":91,"_23830":58537,"_5":16479,"_31422":58333,"_3630":58538},[],"PEM private key for downstream TLS",{"_4190":167,"_34937":91,"_23830":58540,"_5":16479,"_31422":58333,"_3630":58541},[],"`-l`, `--local-chart-path`",{"_4190":168,"_34937":91,"_23830":58543,"_5":16479,"_31422":58333,"_3630":58544},[],"repository chart",{"_4190":169,"_34937":91,"_23830":58546,"_5":16479,"_31422":58333,"_3630":58547},[],"Use an unpacked local Lamassu chart",{"_4190":170,"_34937":91,"_23830":58549,"_5":16479,"_31422":58333,"_3630":58550},[],"`-ip`, `--gateway-ip`",{"_4190":171,"_34937":91,"_23830":58552,"_5":16479,"_31422":58333,"_3630":10007},[],{"_4190":172,"_34937":91,"_23830":58554,"_5":16479,"_31422":58333,"_3630":58555},[],"Override the address written to `gateway.addresses`",{"_4190":173,"_34937":91,"_23830":58557,"_5":16479,"_31422":58333,"_3630":58558},[],"`--otel`",{"_4190":174,"_34937":91,"_23830":58560,"_5":16479,"_31422":58333,"_3630":7581},[],{"_4190":175,"_34937":91,"_23830":58562,"_5":16479,"_31422":58333,"_3630":58563},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_4190":176,"_34937":91,"_23830":58565,"_5":16479,"_31422":58333,"_3630":58566},[],"`--development`",{"_4190":177,"_34937":91,"_23830":58568,"_5":16479,"_31422":58333,"_3630":7581},[],{"_4190":178,"_34937":91,"_23830":58570,"_5":16479,"_31422":58333,"_3630":58571},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_4190":179,"_34937":91,"_23830":58573,"_5":16479,"_31422":58333,"_3630":58574},[],"`--sample-data`",{"_4190":180,"_34937":91,"_23830":58576,"_5":16479,"_31422":58333,"_3630":7581},[],{"_4190":181,"_34937":91,"_23830":58578,"_5":16479,"_31422":58333,"_3630":58579},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_4190":182,"_34937":91,"_23830":58581,"_5":16479,"_31422":58333,"_3630":58582},[],"`--with-hsm`",{"_4190":183,"_34937":91,"_23830":58584,"_5":16479,"_31422":58333,"_3630":7581},[],{"_4190":184,"_34937":91,"_23830":58586,"_5":16479,"_31422":58333,"_3630":58587},[],"Install lab HSM components and configure KMS for PKCS#11",{"_4190":185,"_34937":91,"_23830":58589,"_5":16479,"_31422":58333,"_3630":58590},[],"`--softhsm-chart-path`",{"_4190":186,"_34937":91,"_23830":58592,"_5":16479,"_31422":58333,"_3630":58593},[],"`./charts/softhsm`",{"_4190":187,"_34937":91,"_23830":58595,"_5":16479,"_31422":58333,"_3630":58596},[],"Use a different local SoftHSM chart",{"_4190":188,"_34937":91,"_23830":58598,"_5":16479,"_31422":58333,"_3630":58599},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_4190":189,"_34937":91,"_23830":58601,"_5":16479,"_31422":58337,"_3630":58602},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_4190":190,"_34937":91,"_23830":58604,"_5":16479,"_31422":58337,"_3630":58605},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_4190":191,"_34937":91,"_23830":58607,"_5":16479,"_31422":58337,"_3630":58608},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_4190":192,"_34937":91,"_23830":58610,"_5":16479,"_31422":58337,"_3630":58611},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_4190":193,"_34937":91,"_23830":58613,"_5":16479,"_31422":58337,"_3630":58614},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_4190":194,"_34937":91,"_23830":58616,"_5":16479,"_31422":58337,"_3630":58617},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_4190":195,"_34937":91,"_23830":58619,"_5":16479,"_31422":58341,"_3630":58620},[],"Fastlane:",{"_4190":196,"_34937":91,"_23830":58622,"_5":16479,"_31422":58341,"_3630":58623},[],"validates local tools and the selected cluster",{"_4190":197,"_34937":91,"_23830":58625,"_5":16479,"_31422":58341,"_3630":58626},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_4190":198,"_34937":91,"_23830":58628,"_5":16479,"_31422":58341,"_3630":58629},[],"creates the namespace",{"_4190":199,"_34937":91,"_23830":58631,"_5":16479,"_31422":58341,"_3630":58632},[],"installs PostgreSQL and creates the required databases",{"_4190":200,"_34937":91,"_23830":58634,"_5":16479,"_31422":58341,"_3630":58635},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_4190":201,"_34937":91,"_23830":58637,"_5":16479,"_31422":58341,"_3630":58638},[],"installs RabbitMQ",{"_4190":202,"_34937":91,"_23830":58640,"_5":16479,"_31422":58341,"_3630":58641},[],"optionally installs observability and lab HSM components",{"_4190":203,"_34937":91,"_23830":58643,"_5":16479,"_31422":58341,"_3630":58644},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_4190":204,"_34937":91,"_23830":58646,"_5":16479,"_31422":58341,"_3630":58647},[],"optionally loads sample data",{"_4190":205,"_34937":91,"_23830":58649,"_5":16479,"_31422":58341,"_3630":58650},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_4190":206,"_34937":91,"_23830":58652,"_5":16479,"_31422":58345,"_3630":58653},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_4190":207,"_34937":91,"_23830":58655,"_5":16479,"_31422":58345,"_3630":58656},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_4190":208,"_34937":91,"_23830":58658,"_5":16479,"_31422":58349,"_3630":58659},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_4190":209,"_34937":91,"_23830":58661,"_5":16479,"_31422":58349,"_3630":58662},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_4190":210,"_34937":91,"_23830":58664,"_5":16479,"_31422":58349,"_3630":58665},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_4190":211,"_34937":91,"_23830":58667,"_5":16479,"_31422":58353,"_3630":58668},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_4190":212,"_34937":212,"_5":16871,"_3630":58670,"_35372":58671,"_23830":58672,"_31422":212},"Install with Helm",[58062,58063,58169],[],{"_4190":213,"_34937":212,"_23830":58674,"_5":16479,"_31422":212,"_3630":58675},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_4190":214,"_34937":212,"_5":35369,"_23830":58677,"_31422":58678,"_3630":58679},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_4190":215,"_34937":212,"_5":35369,"_23830":58681,"_31422":58682,"_3630":58072},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#before-you-begin",{"_4190":216,"_34937":212,"_5":35369,"_23830":58684,"_31422":58685,"_3630":58686},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_4190":217,"_34937":212,"_5":35369,"_23830":58688,"_31422":58689,"_3630":58690},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_4190":218,"_34937":212,"_5":35369,"_23830":58692,"_31422":58693,"_3630":58694},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_4190":219,"_34937":212,"_5":35369,"_23830":58696,"_31422":58697,"_3630":58698},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_4190":220,"_34937":212,"_5":35369,"_23830":58700,"_31422":58701,"_3630":58702},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_4190":221,"_34937":212,"_5":35369,"_23830":58704,"_31422":58705,"_3630":58706},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_4190":222,"_34937":212,"_5":35369,"_23830":58708,"_31422":58709,"_3630":58710},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_4190":223,"_34937":212,"_5":35369,"_23830":58712,"_31422":58713,"_3630":58714},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_4190":224,"_34937":212,"_5":35369,"_23830":58716,"_31422":58717,"_3630":58718},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#production-decisions","Production decisions",{"_4190":225,"_34937":212,"_23830":58720,"_5":16479,"_31422":58678,"_3630":58721},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_4190":226,"_34937":212,"_23830":58723,"_5":16479,"_31422":58682,"_3630":58724},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_4190":227,"_34937":212,"_23830":58726,"_5":16479,"_31422":58682,"_3630":58727},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_4190":228,"_34937":212,"_23830":58729,"_5":16479,"_31422":58682,"_3630":58730},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_4190":229,"_34937":212,"_23830":58732,"_5":16479,"_31422":58682,"_3630":58733},[],"a reachable RabbitMQ broker and credentials",{"_4190":230,"_34937":212,"_23830":58735,"_5":16479,"_31422":58682,"_3630":58736},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_4190":231,"_34937":212,"_23830":58738,"_5":16479,"_31422":58682,"_3630":58739},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_4190":232,"_34937":212,"_23830":58741,"_5":16479,"_31422":58682,"_3630":58742},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_4190":233,"_34937":212,"_23830":58744,"_5":16479,"_31422":58682,"_3630":58745},[],"a StorageClass and an external traffic design",{"_4190":234,"_34937":212,"_23830":58747,"_5":16479,"_31422":58682,"_3630":58748},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_4190":235,"_34937":212,"_23830":58750,"_5":16479,"_31422":58682,"_3630":58751},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_4190":236,"_34937":212,"_23830":58753,"_5":16479,"_31422":58682,"_3630":58754},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_4190":237,"_34937":212,"_23830":58756,"_5":16479,"_31422":58685,"_3630":58757},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_4190":238,"_34937":212,"_23830":58759,"_5":16479,"_31422":58685,"_3630":58760},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_4190":239,"_34937":212,"_23830":58762,"_5":16479,"_31422":58685,"_3630":58763},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_4190":240,"_34937":212,"_23830":58765,"_5":16479,"_31422":58689,"_3630":58766},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_4190":241,"_34937":212,"_23830":58768,"_5":16479,"_31422":58689,"_3630":58769},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_4190":242,"_34937":212,"_23830":58771,"_5":16479,"_31422":58689,"_3630":58772},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_4190":243,"_34937":212,"_23830":58774,"_5":16479,"_31422":58689,"_3630":58775},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_4190":244,"_34937":212,"_23830":58777,"_5":16479,"_31422":58693,"_3630":58778},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_4190":245,"_34937":212,"_23830":58780,"_5":16479,"_31422":58697,"_3630":58781},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_4190":246,"_34937":212,"_23830":58783,"_5":16479,"_31422":58697,"_3630":58784},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_4190":247,"_34937":212,"_23830":58786,"_5":16479,"_31422":58697,"_3630":58787},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_4190":248,"_34937":212,"_23830":58789,"_5":16479,"_31422":58697,"_3630":58790},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_4190":249,"_34937":212,"_23830":58792,"_5":16479,"_31422":58697,"_3630":58793},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_4190":250,"_34937":212,"_23830":58795,"_5":16479,"_31422":58697,"_3630":58796},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_4190":251,"_34937":212,"_23830":58798,"_5":16479,"_31422":58697,"_3630":58799},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_4190":252,"_34937":212,"_23830":58801,"_5":16479,"_31422":58701,"_3630":58802},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_4190":253,"_34937":212,"_23830":58804,"_5":16479,"_31422":58701,"_3630":58805},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_4190":254,"_34937":212,"_23830":58807,"_5":16479,"_31422":58701,"_3630":58808},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_4190":255,"_34937":212,"_23830":58810,"_5":16479,"_31422":58701,"_3630":58811},[],"See Access control for the principal and policy model.",{"_4190":256,"_34937":212,"_23830":58813,"_5":16479,"_31422":58705,"_3630":58814},[],"To install a local checkout instead:",{"_4190":257,"_34937":212,"_23830":58816,"_5":16479,"_31422":58709,"_3630":58817},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_4190":258,"_34937":212,"_23830":58819,"_5":16479,"_31422":58709,"_3630":58820},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_4190":259,"_34937":212,"_23830":58822,"_5":16479,"_31422":58713,"_3630":58823},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_4190":260,"_34937":212,"_23830":58825,"_5":16479,"_31422":58713,"_3630":58826},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_4190":261,"_34937":212,"_23830":58828,"_5":16479,"_31422":58713,"_3630":58829},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_4190":262,"_34937":212,"_23830":58831,"_5":16479,"_31422":58713,"_3630":58832},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_4190":263,"_34937":212,"_23830":58834,"_5":16479,"_31422":58713,"_3630":58835},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_4190":264,"_34937":212,"_23830":58837,"_5":16479,"_31422":58717,"_3630":58838},[],"Before going live, review:",{"_4190":265,"_34937":212,"_23830":58840,"_5":16479,"_31422":58717,"_3630":58841},[],"backup and recovery for PostgreSQL and persistent volumes",{"_4190":266,"_34937":212,"_23830":58843,"_5":16479,"_31422":58717,"_3630":58844},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_4190":267,"_34937":212,"_23830":58846,"_5":16479,"_31422":58717,"_3630":58847},[],"shared VA storage before increasing VA replicas",{"_4190":268,"_34937":212,"_23830":58849,"_5":16479,"_31422":58717,"_3630":58850},[],"managed OIDC roles and removal of evaluation credentials",{"_4190":269,"_34937":212,"_23830":58852,"_5":16479,"_31422":58717,"_3630":58853},[],"a trusted TLS issuer or externally managed certificate",{"_4190":270,"_34937":212,"_23830":58855,"_5":16479,"_31422":58717,"_3630":58856},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_4190":271,"_34937":212,"_23830":58858,"_5":16479,"_31422":58717,"_3630":58859},[],"SMTP, observability and alert delivery",{"_4190":272,"_34937":212,"_23830":58861,"_5":16479,"_31422":58717,"_3630":58862},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_4190":273,"_34937":212,"_23830":58864,"_5":16479,"_31422":58717,"_3630":58865},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_4190":274,"_34937":274,"_5":16871,"_3630":58867,"_35372":58868,"_23830":58869,"_31422":274},"Expose the Gateway",[58062,58063,58169],[],{"_4190":275,"_34937":274,"_23830":58871,"_5":16479,"_31422":274,"_3630":58872},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_4190":276,"_34937":274,"_5":35369,"_23830":58874,"_31422":58875,"_3630":58876},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_4190":277,"_34937":274,"_5":35369,"_23830":58878,"_31422":58879,"_3630":58880},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_4190":278,"_34937":274,"_5":35369,"_23830":58882,"_31422":58883,"_3630":58884},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_4190":279,"_34937":274,"_5":35369,"_23830":58886,"_31422":58887,"_3630":58888},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#k3s","K3s",{"_4190":280,"_34937":274,"_5":35369,"_23830":58890,"_31422":58891,"_3630":58892},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_4190":281,"_34937":274,"_5":35369,"_23830":58894,"_31422":58895,"_3630":58896},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_4190":282,"_34937":274,"_5":35369,"_23830":58898,"_31422":58899,"_3630":58900},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_4190":283,"_34937":274,"_5":35369,"_23830":58902,"_31422":58903,"_3630":58904},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_4190":284,"_34937":274,"_5":35369,"_23830":58906,"_31422":58907,"_3630":58908},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#decision-guide","Decision guide",{"_4190":285,"_34937":274,"_5":35369,"_23830":58910,"_31422":58911,"_3630":58912},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_4190":286,"_34937":274,"_5":35369,"_23830":58914,"_31422":58915,"_3630":58916},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_4190":287,"_34937":274,"_23830":58918,"_5":16479,"_31422":58875,"_3630":58919},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_4190":288,"_34937":274,"_23830":58921,"_5":16479,"_31422":58875,"_3630":58922},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_4190":289,"_34937":274,"_23830":58924,"_5":16479,"_31422":58879,"_3630":58925},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_4190":290,"_34937":274,"_23830":58927,"_5":16479,"_31422":58879,"_3630":58928},[],"Set it only when:",{"_4190":291,"_34937":274,"_23830":58930,"_5":16479,"_31422":58879,"_3630":58931},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_4190":292,"_34937":274,"_23830":58933,"_5":16479,"_31422":58879,"_3630":58934},[],"that address is allocated to this Gateway",{"_4190":293,"_34937":274,"_23830":58936,"_5":16479,"_31422":58879,"_3630":58937},[],"the surrounding network already routes traffic for it to the cluster",{"_4190":294,"_34937":274,"_23830":58939,"_5":16479,"_31422":58879,"_3630":58940},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_4190":295,"_34937":274,"_23830":58942,"_5":16479,"_31422":58879,"_3630":58943},[],"Keep these two settings separate:",{"_4190":296,"_34937":274,"_23830":58945,"_5":16479,"_31422":58879,"_3630":58946},[],"`gateway.addresses` requests an address for the Gateway.",{"_4190":297,"_34937":274,"_23830":58948,"_5":16479,"_31422":58879,"_3630":58949},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_4190":298,"_34937":274,"_23830":58951,"_5":16479,"_31422":58879,"_3630":58952},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_4190":299,"_34937":274,"_23830":58954,"_5":16479,"_31422":58883,"_3630":58955},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_4190":300,"_34937":274,"_23830":58957,"_5":16479,"_31422":58883,"_3630":58958},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_4190":301,"_34937":274,"_23830":58960,"_5":16479,"_31422":58887,"_3630":58961},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_4190":302,"_34937":274,"_23830":58963,"_5":16479,"_31422":58887,"_3630":58964},[],"For the recommended design:",{"_4190":303,"_34937":274,"_23830":58966,"_5":16479,"_31422":58887,"_3630":58967},[],"Use only one externally exposed Lamassu Gateway.",{"_4190":304,"_34937":274,"_23830":58969,"_5":16479,"_31422":58887,"_3630":58970},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_4190":305,"_34937":274,"_23830":58972,"_5":16479,"_31422":58887,"_3630":58973},[],"Allow those ports through the VM firewall and any upstream security group.",{"_4190":306,"_34937":274,"_23830":58975,"_5":16479,"_31422":58887,"_3630":58976},[],"Point DNS at the VM's reachable address.",{"_4190":307,"_34937":274,"_23830":58978,"_5":16479,"_31422":58887,"_3630":58979},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_4190":308,"_34937":274,"_23830":58981,"_5":16479,"_31422":58891,"_3630":58982},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_4190":309,"_34937":274,"_23830":58984,"_5":16479,"_31422":58895,"_3630":58985},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_4190":310,"_34937":274,"_23830":58987,"_5":16479,"_31422":58895,"_3630":58988},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_4190":311,"_34937":274,"_23830":58990,"_5":16479,"_31422":58899,"_3630":58991},[],"First decide whether you need three independent data planes or only three hostnames.",{"_4190":312,"_34937":274,"_23830":58993,"_5":16479,"_31422":58899,"_3630":58994},[],"Requirement",{"_4190":313,"_34937":274,"_23830":58996,"_5":16479,"_31422":58899,"_3630":58997},[],"Recommended design",{"_4190":314,"_34937":274,"_23830":58999,"_5":16479,"_31422":58899,"_3630":59000},[],"Consequence",{"_4190":315,"_34937":274,"_23830":59002,"_5":16479,"_31422":58899,"_3630":59003},[],"Several Lamassu URLs or services",{"_4190":316,"_34937":274,"_23830":59005,"_5":16479,"_31422":58899,"_3630":59006},[],"One Gateway with multiple routes",{"_4190":317,"_34937":274,"_23830":59008,"_5":16479,"_31422":58899,"_3630":59009},[],"One IP and one proxy fleet; this is the chart default",{"_4190":318,"_34937":274,"_23830":59011,"_5":16479,"_31422":58899,"_3630":59012},[],"Independent Gateways and separate external IPs",{"_4190":319,"_34937":274,"_23830":59014,"_5":16479,"_31422":58899,"_3630":59015},[],"One VIP per Gateway",{"_4190":320,"_34937":274,"_23830":59017,"_5":16479,"_31422":58899,"_3630":59018},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_4190":321,"_34937":274,"_23830":59020,"_5":16479,"_31422":58899,"_3630":59021},[],"Independent Gateways on one node and one IP",{"_4190":322,"_34937":274,"_23830":59023,"_5":16479,"_31422":58899,"_3630":59024},[],"Use different external ports",{"_4190":323,"_34937":274,"_23830":59026,"_5":16479,"_31422":58899,"_3630":59027},[],"Clients must include non-standard ports",{"_4190":324,"_34937":274,"_23830":59029,"_5":16479,"_31422":58899,"_3630":59030},[],"Separate TLS/mTLS termination behind one IP",{"_4190":325,"_34937":274,"_23830":59032,"_5":16479,"_31422":58899,"_3630":59033},[],"Front-door SNI routing to internal Gateways",{"_4190":326,"_34937":274,"_23830":59035,"_5":16479,"_31422":58899,"_3630":59036},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_4190":327,"_34937":274,"_23830":59038,"_5":16479,"_31422":58899,"_3630":59039},[],"Separate Gateway resources but shared proxy infrastructure",{"_4190":328,"_34937":274,"_23830":59041,"_5":16479,"_31422":58899,"_3630":59042},[],"Envoy merged-Gateway mode",{"_4190":329,"_34937":274,"_23830":59044,"_5":16479,"_31422":58899,"_3630":59045},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_4190":330,"_34937":274,"_23830":59047,"_5":16479,"_31422":58899,"_3630":59048},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_4190":331,"_34937":274,"_23830":59050,"_5":16479,"_31422":58899,"_3630":59051},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_4190":332,"_34937":274,"_23830":59053,"_5":16479,"_31422":58899,"_3630":59054},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_4190":333,"_34937":274,"_23830":59056,"_5":16479,"_31422":58899,"_3630":59057},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_4190":334,"_34937":274,"_23830":59059,"_5":16479,"_31422":58903,"_3630":59060},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_4190":335,"_34937":274,"_23830":59062,"_5":16479,"_31422":58907,"_3630":59063},[],"If one Gateway can own TLS and routing, use the chart default.",{"_4190":336,"_34937":274,"_23830":59065,"_5":16479,"_31422":58907,"_3630":59066},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_4190":337,"_34937":274,"_23830":59068,"_5":16479,"_31422":58907,"_3630":59069},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_4190":338,"_34937":274,"_23830":59071,"_5":16479,"_31422":58907,"_3630":59072},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_4190":339,"_34937":274,"_23830":59074,"_5":16479,"_31422":58907,"_3630":59075},[],"If none of those are possible, use different external ports or change the external network design.",{"_4190":340,"_34937":274,"_23830":59077,"_5":16479,"_31422":58911,"_3630":59078},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_4190":341,"_34937":274,"_23830":59080,"_5":16479,"_31422":58911,"_3630":59081},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_4190":342,"_34937":274,"_23830":59083,"_5":16479,"_31422":58915,"_3630":59084},[],"Check, in order:",{"_4190":343,"_34937":274,"_23830":59086,"_5":16479,"_31422":58915,"_3630":59087},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_4190":344,"_34937":274,"_23830":59089,"_5":16479,"_31422":58915,"_3630":59090},[],"Its status contains the expected address.",{"_4190":345,"_34937":274,"_23830":59092,"_5":16479,"_31422":58915,"_3630":59093},[],"The generated `LoadBalancer` Service has a usable external address.",{"_4190":346,"_34937":274,"_23830":59095,"_5":16479,"_31422":58915,"_3630":59096},[],"Port 443 reaches that address from the client network.",{"_4190":347,"_34937":274,"_23830":59098,"_5":16479,"_31422":58915,"_3630":59099},[],"DNS resolves to the externally reachable endpoint.",{"_4190":348,"_34937":274,"_23830":59101,"_5":16479,"_31422":58915,"_3630":59102},[],"The certificate contains the DNS name or IP used by the client.",{"_4190":349,"_34937":274,"_23830":59104,"_5":16479,"_31422":58915,"_3630":59105},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_4190":350,"_34937":350,"_5":16871,"_3630":58169,"_35372":59107,"_23830":59108,"_31422":350},[58062,58063,58169],[],{"_4190":351,"_34937":350,"_23830":59110,"_5":16479,"_31422":350,"_3630":59111},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_4190":352,"_34937":350,"_5":35369,"_23830":59113,"_31422":59114,"_3630":59115},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_4190":353,"_34937":350,"_5":35369,"_23830":59117,"_31422":59118,"_3630":59119},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_4190":354,"_34937":350,"_5":35369,"_23830":59121,"_31422":59122,"_3630":59123},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_4190":355,"_34937":350,"_5":35369,"_23830":59125,"_31422":59126,"_3630":59127},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_4190":356,"_34937":350,"_5":35369,"_23830":59129,"_31422":59130,"_3630":59131},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_4190":357,"_34937":350,"_5":35369,"_23830":59133,"_31422":59134,"_3630":59135},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_4190":358,"_34937":350,"_23830":59137,"_5":16479,"_31422":59114,"_3630":59138},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_4190":359,"_34937":350,"_23830":59140,"_5":16479,"_31422":59118,"_3630":59141},[],"Workflow",{"_4190":360,"_34937":350,"_23830":59143,"_5":16479,"_31422":59118,"_3630":59144},[],"Use it for",{"_4190":361,"_34937":350,"_23830":59146,"_5":16479,"_31422":59118,"_3630":59147},[],"What it installs",{"_4190":362,"_34937":350,"_23830":59149,"_5":16479,"_31422":59118,"_3630":59150},[],"Helm",{"_4190":363,"_34937":350,"_23830":59152,"_5":16479,"_31422":59118,"_3630":59153},[],"Production and controlled environments",{"_4190":364,"_34937":350,"_23830":59155,"_5":16479,"_31422":59118,"_3630":59156},[],"Lamassu services and Gateway API resources",{"_4190":365,"_34937":350,"_23830":59158,"_5":16479,"_31422":59118,"_3630":58306},[],{"_4190":366,"_34937":350,"_23830":59160,"_5":16479,"_31422":59118,"_3630":59161},[],"Evaluation, demos, CI and small lab clusters",{"_4190":367,"_34937":350,"_23830":59163,"_5":16479,"_31422":59118,"_3630":59164},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_4190":368,"_34937":350,"_23830":59166,"_5":16479,"_31422":59122,"_3630":59167},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_4190":369,"_34937":350,"_23830":59169,"_5":16479,"_31422":59122,"_3630":59170},[],"Area",{"_4190":370,"_34937":350,"_23830":59172,"_5":16479,"_31422":59122,"_3630":59173},[],"The Lamassu chart provides",{"_4190":371,"_34937":350,"_23830":59175,"_5":16479,"_31422":59122,"_3630":59176},[],"You provide",{"_4190":372,"_34937":350,"_23830":59178,"_5":16479,"_31422":59122,"_3630":59179},[],"Lamassu applications",{"_4190":373,"_34937":350,"_23830":59181,"_5":16479,"_31422":59122,"_3630":59182},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_4190":374,"_34937":350,"_23830":59184,"_5":16479,"_31422":59122,"_3630":59185},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_4190":375,"_34937":350,"_23830":59187,"_5":16479,"_31422":59122,"_3630":59188},[],"PostgreSQL data",{"_4190":376,"_34937":350,"_23830":59190,"_5":16479,"_31422":59122,"_3630":59191},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_4190":377,"_34937":350,"_23830":59193,"_5":16479,"_31422":59122,"_3630":59194},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_4190":378,"_34937":350,"_23830":59196,"_5":16479,"_31422":59122,"_3630":59197},[],"Messaging",{"_4190":379,"_34937":350,"_23830":59199,"_5":16479,"_31422":59122,"_3630":59200},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_4190":380,"_34937":350,"_23830":59202,"_5":16479,"_31422":59122,"_3630":59203},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_4190":381,"_34937":350,"_23830":59205,"_5":16479,"_31422":59122,"_3630":59206},[],"Identity",{"_4190":382,"_34937":350,"_23830":59208,"_5":16479,"_31422":59122,"_3630":59209},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_4190":383,"_34937":350,"_23830":59211,"_5":16479,"_31422":59122,"_3630":59212},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_4190":384,"_34937":350,"_23830":59214,"_5":16479,"_31422":59122,"_3630":59215},[],"External routing",{"_4190":385,"_34937":350,"_23830":59217,"_5":16479,"_31422":59122,"_3630":59218},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_4190":386,"_34937":350,"_23830":59220,"_5":16479,"_31422":59122,"_3630":59221},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_4190":387,"_34937":350,"_23830":59223,"_5":16479,"_31422":59122,"_3630":59224},[],"TLS",{"_4190":388,"_34937":350,"_23830":59226,"_5":16479,"_31422":59122,"_3630":59227},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_4190":389,"_34937":350,"_23830":59229,"_5":16479,"_31422":59122,"_3630":59230},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_4190":390,"_34937":350,"_23830":59232,"_5":16479,"_31422":59122,"_3630":59233},[],"Persistent application data",{"_4190":391,"_34937":350,"_23830":59235,"_5":16479,"_31422":59122,"_3630":59236},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_4190":392,"_34937":350,"_23830":59238,"_5":16479,"_31422":59122,"_3630":59239},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_4190":393,"_34937":350,"_23830":59241,"_5":16479,"_31422":59122,"_3630":59242},[],"Optional integrations",{"_4190":394,"_34937":350,"_23830":59244,"_5":16479,"_31422":59122,"_3630":59245},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_4190":395,"_34937":350,"_23830":59247,"_5":16479,"_31422":59122,"_3630":59248},[],"The observability backends, cloud credentials and production HSM or external key service",{"_4190":396,"_34937":350,"_23830":59250,"_5":16479,"_31422":59122,"_3630":59251},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_4190":397,"_34937":350,"_23830":59253,"_5":16479,"_31422":59122,"_3630":59254},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_4190":398,"_34937":350,"_23830":59256,"_5":16479,"_31422":59126,"_3630":59257},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_4190":399,"_34937":350,"_23830":59259,"_5":16479,"_31422":59126,"_3630":59260},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_4190":400,"_34937":350,"_23830":59262,"_5":16479,"_31422":59130,"_3630":59263},[],"Kubernetes 1.24 or newer",{"_4190":401,"_34937":350,"_23830":59265,"_5":16479,"_31422":59130,"_3630":59266},[],"Helm 3.2 or newer",{"_4190":402,"_34937":350,"_23830":59268,"_5":16479,"_31422":59130,"_3630":59269},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_4190":403,"_34937":350,"_23830":59271,"_5":16479,"_31422":59130,"_3630":59272},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_4190":404,"_34937":350,"_23830":59274,"_5":16479,"_31422":59130,"_3630":59275},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_4190":405,"_34937":350,"_23830":59277,"_5":16479,"_31422":59130,"_3630":59278},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_4190":406,"_34937":350,"_23830":59280,"_5":16479,"_31422":59130,"_3630":59281},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_4190":407,"_34937":350,"_23830":59283,"_5":16479,"_31422":59134,"_3630":59284},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4190":408,"_34937":350,"_23830":59286,"_5":16479,"_31422":59134,"_3630":59287},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_4190":409,"_34937":350,"_23830":59289,"_5":16479,"_31422":59134,"_3630":59290},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_4190":410,"_34937":350,"_23830":59292,"_5":16479,"_31422":59134,"_3630":59293},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_4190":411,"_34937":411,"_5":16871,"_3630":59295,"_35372":59296,"_23830":59298,"_31422":411},"Deployment troubleshooting",[58062,58063,59297],"Operations",[],{"_4190":412,"_34937":411,"_23830":59300,"_5":16479,"_31422":411,"_3630":59301},[],"Diagnose access, service health and infrastructure dependencies.",{"_4190":413,"_34937":411,"_5":35369,"_23830":59303,"_31422":59304,"_3630":59305},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_4190":414,"_34937":411,"_5":35369,"_23830":59307,"_31422":59308,"_3630":59309},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_4190":415,"_34937":411,"_5":35369,"_23830":59311,"_31422":59312,"_3630":59313},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_4190":416,"_34937":411,"_5":35369,"_23830":59315,"_31422":59316,"_3630":59317},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_4190":417,"_34937":411,"_5":35369,"_23830":59319,"_31422":59320,"_3630":59321},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_4190":418,"_34937":411,"_5":35369,"_23830":59323,"_31422":59324,"_3630":59325},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_4190":419,"_34937":411,"_5":35369,"_23830":59327,"_31422":59328,"_3630":59329},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_4190":420,"_34937":411,"_5":35369,"_23830":59331,"_31422":59332,"_3630":59333},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_4190":421,"_34937":411,"_5":35369,"_23830":59335,"_31422":59336,"_3630":59337},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_4190":422,"_34937":411,"_5":35369,"_23830":59339,"_31422":59340,"_3630":59341},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#api-500-errors","API 500 errors",{"_4190":423,"_34937":411,"_5":35369,"_23830":59343,"_31422":59344,"_3630":59345},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_4190":424,"_34937":411,"_5":35369,"_23830":59347,"_31422":59348,"_3630":59349},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_4190":425,"_34937":411,"_5":35369,"_23830":59351,"_31422":59352,"_3630":59353},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#observability","Observability",{"_4190":426,"_34937":411,"_23830":59355,"_5":16479,"_31422":411,"_3630":59356},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_4190":427,"_34937":411,"_23830":59358,"_5":16479,"_31422":59308,"_3630":59359},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_4190":428,"_34937":411,"_23830":59361,"_5":16479,"_31422":59312,"_3630":59362},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_4190":429,"_34937":411,"_23830":59364,"_5":16479,"_31422":59316,"_3630":59365},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_4190":430,"_34937":411,"_23830":59367,"_5":16479,"_31422":59320,"_3630":59368},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_4190":431,"_34937":411,"_23830":59370,"_5":16479,"_31422":59324,"_3630":59371},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_4190":432,"_34937":411,"_23830":59373,"_5":16479,"_31422":59328,"_3630":59374},[],"Replace the placeholders with your real release, namespace and deployment.",{"_4190":433,"_34937":411,"_23830":59376,"_5":16479,"_31422":59328,"_3630":59377},[],"Also run the chart's connectivity test:",{"_4190":434,"_34937":411,"_23830":59379,"_5":16479,"_31422":59328,"_3630":59380},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_4190":435,"_34937":411,"_23830":59382,"_5":16479,"_31422":59328,"_3630":59383},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_4190":436,"_34937":411,"_23830":59385,"_5":16479,"_31422":59332,"_3630":59386},[],"If you receive a 401:",{"_4190":437,"_34937":411,"_23830":59388,"_5":16479,"_31422":59332,"_3630":59389},[],"check that the UI's OIDC authority is reachable from the browser;",{"_4190":438,"_34937":411,"_23830":59391,"_5":16479,"_31422":59332,"_3630":59392},[],"verify issuer, audience and expiration of the token;",{"_4190":439,"_34937":411,"_23830":59394,"_5":16479,"_31422":59332,"_3630":59395},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_4190":440,"_34937":411,"_23830":59397,"_5":16479,"_31422":59332,"_3630":59398},[],"check that the provider's public and internal routes point to the same realm.",{"_4190":441,"_34937":411,"_23830":59400,"_5":16479,"_31422":59332,"_3630":59401},[],"If login succeeds but the APIs return 403:",{"_4190":442,"_34937":411,"_23830":59403,"_5":16479,"_31422":59332,"_3630":59404},[],"inspect the token's real claims;",{"_4190":443,"_34937":411,"_23830":59406,"_5":16479,"_31422":59332,"_3630":59407},[],"confirm they match an active principal;",{"_4190":444,"_34937":411,"_23830":59409,"_5":16479,"_31422":59332,"_3630":59410},[],"review the policies granted to that principal;",{"_4190":445,"_34937":411,"_23830":59412,"_5":16479,"_31422":59332,"_3630":59413},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_4190":446,"_34937":411,"_23830":59415,"_5":16479,"_31422":59332,"_3630":59416},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_4190":447,"_34937":411,"_23830":59418,"_5":16479,"_31422":59336,"_3630":59419},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_4190":448,"_34937":411,"_23830":59421,"_5":16479,"_31422":59336,"_3630":59422},[],"Locate the authz pod and Service.",{"_4190":449,"_34937":411,"_23830":59424,"_5":16479,"_31422":59336,"_3630":59425},[],"Check /health, logs and its database connection.",{"_4190":450,"_34937":411,"_23830":59427,"_5":16479,"_31422":59336,"_3630":59428},[],"Verify the DNS and port configured in externalAuthorization.",{"_4190":451,"_34937":411,"_23830":59430,"_5":16479,"_31422":59336,"_3630":59431},[],"Check the check route is /v1/ext\\_authz/check.",{"_4190":452,"_34937":411,"_23830":59433,"_5":16479,"_31422":59336,"_3630":59434},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_4190":453,"_34937":411,"_23830":59436,"_5":16479,"_31422":59340,"_3630":59437},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_4190":454,"_34937":411,"_23830":59439,"_5":16479,"_31422":59344,"_3630":59440},[],"Review kubectl describe pod first. Common causes are:",{"_4190":455,"_34937":411,"_23830":59442,"_5":16479,"_31422":59344,"_3630":59443},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_4190":456,"_34937":411,"_23830":59445,"_5":16479,"_31422":59344,"_3630":59446},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_4190":457,"_34937":411,"_23830":59448,"_5":16479,"_31422":59344,"_3630":59449},[],"unbound persistent volume;",{"_4190":458,"_34937":411,"_23830":59451,"_5":16479,"_31422":59344,"_3630":59452},[],"inaccessible image or incorrect pull policy;",{"_4190":459,"_34937":411,"_23830":59454,"_5":16479,"_31422":59344,"_3630":59455},[],"invalid cryptographic engine configuration;",{"_4190":460,"_34937":411,"_23830":59457,"_5":16479,"_31422":59344,"_3630":59458},[],"CPU or memory limits set too low;",{"_4190":461,"_34937":411,"_23830":59460,"_5":16479,"_31422":59344,"_3630":59461},[],"an incomplete prior migration.",{"_4190":462,"_34937":411,"_23830":59463,"_5":16479,"_31422":59344,"_3630":59464},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_4190":463,"_34937":411,"_23830":59466,"_5":16479,"_31422":59344,"_3630":59467},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_4190":464,"_34937":411,"_23830":59469,"_5":16479,"_31422":59344,"_3630":59470},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_4190":465,"_34937":411,"_23830":59472,"_5":16479,"_31422":59348,"_3630":59473},[],"Domain and audit events depend on the bus publisher:",{"_4190":466,"_34937":411,"_23830":59475,"_5":16479,"_31422":59348,"_3630":59476},[],"verify it is enabled in the emitting service;",{"_4190":467,"_34937":411,"_23830":59478,"_5":16479,"_31422":59348,"_3630":59479},[],"check AMQP connectivity and credentials;",{"_4190":468,"_34937":411,"_23830":59481,"_5":16479,"_31422":59348,"_3630":59482},[],"review exchange, routing key, queues and consumers;",{"_4190":469,"_34937":411,"_23830":59484,"_5":16479,"_31422":59348,"_3630":59485},[],"inspect dead-letter queues;",{"_4190":470,"_34937":411,"_23830":59487,"_5":16479,"_31422":59348,"_3630":59488},[],"alert on orphan durable queues and backlog growth.",{"_4190":471,"_34937":411,"_23830":59490,"_5":16479,"_31422":59348,"_3630":59491},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_4190":472,"_34937":411,"_23830":59493,"_5":16479,"_31422":59348,"_3630":59494},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_4190":473,"_34937":411,"_23830":59496,"_5":16479,"_31422":59348,"_3630":59497},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_4190":474,"_34937":411,"_23830":59499,"_5":16479,"_31422":59348,"_3630":59500},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_4190":475,"_34937":411,"_23830":59502,"_5":16479,"_31422":59348,"_3630":59503},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_4190":476,"_34937":411,"_23830":59505,"_5":16479,"_31422":59348,"_3630":59506},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_4190":477,"_34937":411,"_23830":59508,"_5":16479,"_31422":59348,"_3630":59509},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_4190":478,"_34937":411,"_23830":59511,"_5":16479,"_31422":59352,"_3630":59512},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_4190":479,"_34937":411,"_23830":59514,"_5":16479,"_31422":59352,"_3630":59515},[],"Before closing an incident, record:",{"_4190":480,"_34937":411,"_23830":59517,"_5":16479,"_31422":59352,"_3630":59518},[],"the confirmed cause;",{"_4190":481,"_34937":411,"_23830":59520,"_5":16479,"_31422":59352,"_3630":59521},[],"the time scope and affected resources;",{"_4190":482,"_34937":411,"_23830":59523,"_5":16479,"_31422":59352,"_3630":59524},[],"the commands or queries used;",{"_4190":483,"_34937":411,"_23830":59526,"_5":16479,"_31422":59352,"_3630":59527},[],"the applied change and how to revert it;",{"_4190":484,"_34937":411,"_23830":59529,"_5":16479,"_31422":59352,"_3630":59530},[],"validation from a consumer;",{"_4190":485,"_34937":411,"_23830":59532,"_5":16479,"_31422":59352,"_3630":59533},[],"the preventive action and its owner.",{"_4190":486,"_34937":486,"_5":16871,"_3630":59535,"_35372":59536,"_23830":59539,"_31422":486},"Access control",[58062,59537,59538],"Platform","Administration",[],{"_4190":487,"_34937":486,"_23830":59541,"_5":16479,"_31422":486,"_3630":59542},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_4190":488,"_34937":486,"_5":35369,"_23830":59544,"_31422":59545,"_3630":59546},[],"/docs/pr-preview/pr-58/platform/administration/access-control#essential-concepts","Essential concepts",{"_4190":489,"_34937":486,"_5":35369,"_23830":59548,"_31422":59549,"_3630":59550},[],"/docs/pr-preview/pr-58/platform/administration/access-control#two-decision-systems","Two decision systems",{"_4190":490,"_34937":486,"_5":35369,"_23830":59552,"_31422":59553,"_3630":59554},[],"/docs/pr-preview/pr-58/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_4190":491,"_34937":486,"_5":35369,"_23830":59556,"_31422":59557,"_3630":59558},[],"/docs/pr-preview/pr-58/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_4190":492,"_34937":486,"_5":35369,"_23830":59560,"_31422":59561,"_3630":59562},[],"/docs/pr-preview/pr-58/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_4190":493,"_34937":486,"_5":35369,"_23830":59564,"_31422":59565,"_3630":59566},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_4190":494,"_34937":486,"_5":35369,"_23830":59568,"_31422":59569,"_3630":59570},[],"/docs/pr-preview/pr-58/platform/administration/access-control#oidc-principals","OIDC principals",{"_4190":495,"_34937":486,"_5":35369,"_23830":59572,"_31422":59573,"_3630":59574},[],"/docs/pr-preview/pr-58/platform/administration/access-control#x509-principals","X.509 principals",{"_4190":496,"_34937":486,"_5":35369,"_23830":59576,"_31422":59577,"_3630":59578},[],"/docs/pr-preview/pr-58/platform/administration/access-control#when-several-principals-match","When several principals match",{"_4190":497,"_34937":486,"_5":35369,"_23830":59580,"_31422":59581,"_3630":59582},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-policies-express-access","How policies express access",{"_4190":498,"_34937":486,"_5":35369,"_23830":59584,"_31422":59585,"_3630":59586},[],"/docs/pr-preview/pr-58/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_4190":499,"_34937":486,"_5":35369,"_23830":59588,"_31422":59589,"_3630":59590},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_4190":500,"_34937":486,"_5":35369,"_23830":59592,"_31422":59593,"_3630":59594},[],"/docs/pr-preview/pr-58/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_4190":501,"_34937":486,"_5":35369,"_23830":59596,"_31422":59597,"_3630":59598},[],"/docs/pr-preview/pr-58/platform/administration/access-control#http-rules","HTTP rules",{"_4190":502,"_34937":486,"_5":35369,"_23830":59600,"_31422":59601,"_3630":59602},[],"/docs/pr-preview/pr-58/platform/administration/access-control#included-policies","Included policies",{"_4190":503,"_34937":486,"_5":35369,"_23830":59604,"_31422":59605,"_3630":58702},[],"/docs/pr-preview/pr-58/platform/administration/access-control#provision-the-first-administrator",{"_4190":504,"_34937":486,"_5":35369,"_23830":59607,"_31422":59608,"_3630":59609},[],"/docs/pr-preview/pr-58/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_4190":505,"_34937":486,"_5":35369,"_23830":59611,"_31422":59612,"_3630":59613},[],"/docs/pr-preview/pr-58/platform/administration/access-control#configure-token-validation","Configure token validation",{"_4190":506,"_34937":486,"_5":35369,"_23830":59615,"_31422":59616,"_3630":59617},[],"/docs/pr-preview/pr-58/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_4190":507,"_34937":486,"_5":35369,"_23830":59619,"_31422":59620,"_3630":59621},[],"/docs/pr-preview/pr-58/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_4190":508,"_34937":486,"_5":35369,"_23830":59623,"_31422":59624,"_3630":59625},[],"/docs/pr-preview/pr-58/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_4190":509,"_34937":486,"_5":35369,"_23830":59627,"_31422":59628,"_3630":59629},[],"/docs/pr-preview/pr-58/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_4190":510,"_34937":486,"_5":35369,"_23830":59631,"_31422":59632,"_3630":59633},[],"/docs/pr-preview/pr-58/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_4190":511,"_34937":486,"_5":35369,"_23830":59635,"_31422":59636,"_3630":59637},[],"/docs/pr-preview/pr-58/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_4190":512,"_34937":486,"_5":35369,"_23830":59639,"_31422":59640,"_3630":59641},[],"/docs/pr-preview/pr-58/platform/administration/access-control#operational-checklist","Operational checklist",{"_4190":513,"_34937":486,"_5":35369,"_23830":59643,"_31422":59644,"_3630":59645},[],"/docs/pr-preview/pr-58/platform/administration/access-control#diagnostics","Diagnostics",{"_4190":514,"_34937":486,"_5":35369,"_23830":59647,"_31422":59648,"_3630":59649},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-401","The response is 401",{"_4190":515,"_34937":486,"_5":35369,"_23830":59651,"_31422":59652,"_3630":59653},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-403","The response is 403",{"_4190":516,"_34937":486,"_5":35369,"_23830":59655,"_31422":59656,"_3630":59657},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_4190":517,"_34937":486,"_5":35369,"_23830":59659,"_31422":59660,"_3630":59661},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_4190":518,"_34937":486,"_5":35369,"_23830":59663,"_31422":59664,"_3630":59665},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_4190":519,"_34937":486,"_23830":59667,"_5":16479,"_31422":486,"_3630":59668},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_4190":520,"_34937":486,"_23830":59670,"_5":16479,"_31422":486,"_3630":59671},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_4190":521,"_34937":486,"_23830":59673,"_5":16479,"_31422":486,"_3630":59674},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_4190":522,"_34937":486,"_23830":59676,"_5":16479,"_31422":59545,"_3630":59677},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_4190":523,"_34937":486,"_23830":59679,"_5":16479,"_31422":59545,"_3630":59680},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_4190":524,"_34937":486,"_23830":59682,"_5":16479,"_31422":59545,"_3630":59683},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_4190":525,"_34937":486,"_23830":59685,"_5":16479,"_31422":59545,"_3630":59686},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_4190":526,"_34937":486,"_23830":59688,"_5":16479,"_31422":59545,"_3630":59689},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_4190":527,"_34937":486,"_23830":59691,"_5":16479,"_31422":59545,"_3630":59692},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_4190":528,"_34937":486,"_23830":59694,"_5":16479,"_31422":59549,"_3630":59695},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_4190":529,"_34937":486,"_23830":59697,"_5":16479,"_31422":59549,"_3630":59698},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_4190":530,"_34937":486,"_23830":59700,"_5":16479,"_31422":59553,"_3630":59701},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_4190":531,"_34937":486,"_23830":59703,"_5":16479,"_31422":59553,"_3630":59704},[],"The decision is made **before forwarding the request to the service**:",{"_4190":532,"_34937":486,"_23830":59706,"_5":16479,"_31422":59553,"_3630":59707},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_4190":533,"_34937":486,"_23830":59709,"_5":16479,"_31422":59553,"_3630":59710},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_4190":534,"_34937":486,"_23830":59712,"_5":16479,"_31422":59553,"_3630":59713},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_4190":535,"_34937":486,"_23830":59715,"_5":16479,"_31422":59553,"_3630":59716},[],"It separately loads the policies granted to each principal.",{"_4190":536,"_34937":486,"_23830":59718,"_5":16479,"_31422":59553,"_3630":59719},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_4190":537,"_34937":486,"_23830":59721,"_5":16479,"_31422":59553,"_3630":59722},[],"`authz` looks for an HTTP rule granting that action.",{"_4190":538,"_34937":486,"_23830":59724,"_5":16479,"_31422":59553,"_3630":59725},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_4190":539,"_34937":486,"_23830":59727,"_5":16479,"_31422":59553,"_3630":59728},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_4190":540,"_34937":486,"_23830":59730,"_5":16479,"_31422":59553,"_3630":59731},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_4190":541,"_34937":486,"_23830":59733,"_5":16479,"_31422":59553,"_3630":59734},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_4190":542,"_34937":486,"_23830":59736,"_5":16479,"_31422":59557,"_3630":59737},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_4190":543,"_34937":486,"_23830":59739,"_5":16479,"_31422":59557,"_3630":59740},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_4190":544,"_34937":486,"_23830":59742,"_5":16479,"_31422":59557,"_3630":59743},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_4190":545,"_34937":486,"_23830":59745,"_5":16479,"_31422":59557,"_3630":59746},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_4190":546,"_34937":486,"_23830":59748,"_5":16479,"_31422":59557,"_3630":59749},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_4190":547,"_34937":486,"_23830":59751,"_5":16479,"_31422":59557,"_3630":59752},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_4190":548,"_34937":486,"_23830":59754,"_5":16479,"_31422":59557,"_3630":59755},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_4190":549,"_34937":486,"_23830":59757,"_5":16479,"_31422":59557,"_3630":59758},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_4190":550,"_34937":486,"_23830":59760,"_5":16479,"_31422":59561,"_3630":59761},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_4190":551,"_34937":486,"_23830":59763,"_5":16479,"_31422":59561,"_3630":59764},[],"The decision is made with the domain operation context:",{"_4190":552,"_34937":486,"_23830":59766,"_5":16479,"_31422":59561,"_3630":59767},[],"The middleware extracts the credential and resolves the matching principals.",{"_4190":553,"_34937":486,"_23830":59769,"_5":16479,"_31422":59561,"_3630":59770},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_4190":554,"_34937":486,"_23830":59772,"_5":16479,"_31422":59561,"_3630":59773},[],"`authz` gathers the entity rules of the granted policies.",{"_4190":555,"_34937":486,"_23830":59775,"_5":16479,"_31422":59561,"_3630":59776},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_4190":556,"_34937":486,"_23830":59778,"_5":16479,"_31422":59561,"_3630":59779},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_4190":557,"_34937":486,"_23830":59781,"_5":16479,"_31422":59561,"_3630":59782},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_4190":558,"_34937":486,"_23830":59784,"_5":16479,"_31422":59561,"_3630":59785},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_4190":559,"_34937":486,"_23830":59787,"_5":16479,"_31422":59561,"_3630":59788},[],"Actions fall into two groups:",{"_4190":560,"_34937":486,"_23830":59790,"_5":16479,"_31422":59561,"_3630":59791},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_4190":561,"_34937":486,"_23830":59793,"_5":16479,"_31422":59561,"_3630":59794},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_4190":562,"_34937":486,"_23830":59796,"_5":16479,"_31422":59561,"_3630":59797},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_4190":563,"_34937":486,"_23830":59799,"_5":16479,"_31422":59565,"_3630":59800},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_4190":564,"_34937":486,"_23830":59802,"_5":16479,"_31422":59565,"_3630":59803},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_4190":565,"_34937":486,"_23830":59805,"_5":16479,"_31422":59565,"_3630":59806},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_4190":566,"_34937":486,"_23830":59808,"_5":16479,"_31422":59569,"_3630":59809},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_4190":567,"_34937":486,"_23830":59811,"_5":16479,"_31422":59569,"_3630":59812},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_4190":568,"_34937":486,"_23830":59814,"_5":16479,"_31422":59569,"_3630":59815},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_4190":569,"_34937":486,"_23830":59817,"_5":16479,"_31422":59569,"_3630":59818},[],"The implemented operators are:",{"_4190":570,"_34937":486,"_23830":59820,"_5":16479,"_31422":59569,"_3630":59821},[],"`equals`, for exact equality;",{"_4190":571,"_34937":486,"_23830":59823,"_5":16479,"_31422":59569,"_3630":59824},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_4190":572,"_34937":486,"_23830":59826,"_5":16479,"_31422":59569,"_3630":59827},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_4190":573,"_34937":486,"_23830":59829,"_5":16479,"_31422":59569,"_3630":59830},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_4190":574,"_34937":486,"_23830":59832,"_5":16479,"_31422":59573,"_3630":59833},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_4190":575,"_34937":486,"_23830":59835,"_5":16479,"_31422":59573,"_3630":59836},[],"The available modes are:",{"_4190":576,"_34937":486,"_23830":59838,"_5":16479,"_31422":59573,"_3630":59839},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_4190":577,"_34937":486,"_23830":59841,"_5":16479,"_31422":59573,"_3630":59842},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_4190":578,"_34937":486,"_23830":59844,"_5":16479,"_31422":59573,"_3630":59845},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_4190":579,"_34937":486,"_23830":59847,"_5":16479,"_31422":59573,"_3630":59848},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_4190":580,"_34937":486,"_23830":59850,"_5":16479,"_31422":59573,"_3630":59851},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_4190":581,"_34937":486,"_23830":59853,"_5":16479,"_31422":59573,"_3630":59854},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_4190":582,"_34937":486,"_23830":59856,"_5":16479,"_31422":59577,"_3630":59857},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_4190":583,"_34937":486,"_23830":59859,"_5":16479,"_31422":59577,"_3630":59860},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_4190":584,"_34937":486,"_23830":59862,"_5":16479,"_31422":59577,"_3630":59863},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_4190":585,"_34937":486,"_23830":59865,"_5":16479,"_31422":59577,"_3630":59866},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_4190":586,"_34937":486,"_23830":59868,"_5":16479,"_31422":59585,"_3630":59869},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_4190":587,"_34937":486,"_23830":59871,"_5":16479,"_31422":59585,"_3630":59872},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_4190":588,"_34937":486,"_23830":59874,"_5":16479,"_31422":59589,"_3630":59875},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_4190":589,"_34937":486,"_23830":59877,"_5":16479,"_31422":59589,"_3630":59878},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_4190":590,"_34937":486,"_23830":59880,"_5":16479,"_31422":59593,"_3630":59881},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_4190":591,"_34937":486,"_23830":59883,"_5":16479,"_31422":59593,"_3630":59884},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_4190":592,"_34937":486,"_23830":59886,"_5":16479,"_31422":59593,"_3630":59887},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_4190":593,"_34937":486,"_23830":59889,"_5":16479,"_31422":59597,"_3630":59890},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_4190":594,"_34937":486,"_23830":59892,"_5":16479,"_31422":59597,"_3630":59893},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_4190":595,"_34937":486,"_23830":59895,"_5":16479,"_31422":59597,"_3630":59896},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_4190":596,"_34937":486,"_23830":59898,"_5":16479,"_31422":59597,"_3630":59899},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_4190":597,"_34937":486,"_23830":59901,"_5":16479,"_31422":59597,"_3630":59902},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_4190":598,"_34937":486,"_23830":59904,"_5":16479,"_31422":59597,"_3630":59905},[],"Note that:",{"_4190":599,"_34937":486,"_23830":59907,"_5":16479,"_31422":59597,"_3630":59908},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_4190":600,"_34937":486,"_23830":59910,"_5":16479,"_31422":59597,"_3630":59911},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_4190":601,"_34937":486,"_23830":59913,"_5":16479,"_31422":59597,"_3630":59914},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_4190":602,"_34937":486,"_23830":59916,"_5":16479,"_31422":59601,"_3630":59917},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_4190":603,"_34937":486,"_23830":59919,"_5":16479,"_31422":59601,"_3630":59920},[],"full and read-only access to certificates and authorities;",{"_4190":604,"_34937":486,"_23830":59922,"_5":16479,"_31422":59601,"_3630":59923},[],"full and read-only access to the KMS;",{"_4190":605,"_34937":486,"_23830":59925,"_5":16479,"_31422":59601,"_3630":59926},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_4190":606,"_34937":486,"_23830":59928,"_5":16479,"_31422":59601,"_3630":59929},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_4190":607,"_34937":486,"_23830":59931,"_5":16479,"_31422":59601,"_3630":59932},[],"console access;",{"_4190":608,"_34937":486,"_23830":59934,"_5":16479,"_31422":59601,"_3630":59935},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_4190":609,"_34937":486,"_23830":59937,"_5":16479,"_31422":59601,"_3630":59938},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_4190":610,"_34937":486,"_23830":59940,"_5":16479,"_31422":59601,"_3630":59941},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_4190":611,"_34937":486,"_23830":59943,"_5":16479,"_31422":59605,"_3630":59944},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_4190":612,"_34937":486,"_23830":59946,"_5":16479,"_31422":59605,"_3630":59947},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_4190":613,"_34937":486,"_23830":59949,"_5":16479,"_31422":59605,"_3630":59950},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_4190":614,"_34937":486,"_23830":59952,"_5":16479,"_31422":59608,"_3630":59953},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_4190":615,"_34937":486,"_23830":59955,"_5":16479,"_31422":59612,"_3630":59956},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_4190":616,"_34937":486,"_23830":59958,"_5":16479,"_31422":59612,"_3630":59959},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_4190":617,"_34937":486,"_23830":59961,"_5":16479,"_31422":59616,"_3630":59962},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_4190":618,"_34937":486,"_23830":59964,"_5":16479,"_31422":59620,"_3630":59965},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_4190":619,"_34937":486,"_23830":59967,"_5":16479,"_31422":59624,"_3630":59968},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_4190":620,"_34937":486,"_23830":59970,"_5":16479,"_31422":59628,"_3630":59971},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_4190":621,"_34937":486,"_23830":59973,"_5":16479,"_31422":59628,"_3630":59974},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_4190":622,"_34937":486,"_23830":59976,"_5":16479,"_31422":59632,"_3630":59977},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_4190":623,"_34937":486,"_23830":59979,"_5":16479,"_31422":59632,"_3630":59980},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_4190":624,"_34937":486,"_23830":59982,"_5":16479,"_31422":59632,"_3630":59983},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_4190":625,"_34937":486,"_23830":59985,"_5":16479,"_31422":59632,"_3630":59986},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_4190":626,"_34937":486,"_23830":59988,"_5":16479,"_31422":59632,"_3630":59989},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_4190":627,"_34937":486,"_23830":59991,"_5":16479,"_31422":59632,"_3630":59992},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_4190":628,"_34937":486,"_23830":59994,"_5":16479,"_31422":59632,"_3630":59995},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_4190":629,"_34937":486,"_23830":59997,"_5":16479,"_31422":59632,"_3630":59998},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_4190":630,"_34937":486,"_23830":60000,"_5":16479,"_31422":59636,"_3630":60001},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_4190":631,"_34937":486,"_23830":60003,"_5":16479,"_31422":59636,"_3630":60004},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_4190":632,"_34937":486,"_23830":60006,"_5":16479,"_31422":59636,"_3630":60007},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_4190":633,"_34937":486,"_23830":60009,"_5":16479,"_31422":59640,"_3630":60010},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_4190":634,"_34937":486,"_23830":60012,"_5":16479,"_31422":59640,"_3630":60013},[],"Use groups or stable roles for people and independent identities for automations.",{"_4190":635,"_34937":486,"_23830":60015,"_5":16479,"_31422":59640,"_3630":60016},[],"Keep at least two recovery administrators and test their access periodically.",{"_4190":636,"_34937":486,"_23830":60018,"_5":16479,"_31422":59640,"_3630":60019},[],"Review active principals, their matches and their grants after IdP changes.",{"_4190":637,"_34937":486,"_23830":60021,"_5":16479,"_31422":59640,"_3630":60022},[],"Search for wildcards in policies before upgrading Lamassu.",{"_4190":638,"_34937":486,"_23830":60024,"_5":16479,"_31422":59640,"_3630":60025},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_4190":639,"_34937":486,"_23830":60027,"_5":16479,"_31422":59640,"_3630":60028},[],"Always test one allowed and one denied operation for each role.",{"_4190":640,"_34937":486,"_23830":60030,"_5":16479,"_31422":59640,"_3630":60031},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_4190":641,"_34937":486,"_23830":60033,"_5":16479,"_31422":59648,"_3630":60034},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_4190":642,"_34937":486,"_23830":60036,"_5":16479,"_31422":59652,"_3630":60037},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_4190":643,"_34937":486,"_23830":60039,"_5":16479,"_31422":59652,"_3630":60040},[],"that an active principal of the correct type exists;",{"_4190":644,"_34937":486,"_23830":60042,"_5":16479,"_31422":59652,"_3630":60043},[],"that the claim paths and values match the real token exactly;",{"_4190":645,"_34937":486,"_23830":60045,"_5":16479,"_31422":59652,"_3630":60046},[],"that all of the principal's conditions hold;",{"_4190":646,"_34937":486,"_23830":60048,"_5":16479,"_31422":59652,"_3630":60049},[],"that the principal has the expected policy granted;",{"_4190":647,"_34937":486,"_23830":60051,"_5":16479,"_31422":59652,"_3630":60052},[],"that the policy includes the action and the requested resource type or route;",{"_4190":648,"_34937":486,"_23830":60054,"_5":16479,"_31422":59652,"_3630":60055},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_4190":649,"_34937":486,"_23830":60057,"_5":16479,"_31422":59652,"_3630":60058},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_4190":650,"_34937":486,"_23830":60060,"_5":16479,"_31422":59656,"_3630":60061},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_4190":651,"_34937":486,"_23830":60063,"_5":16479,"_31422":59660,"_3630":60064},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_4190":652,"_34937":486,"_23830":60066,"_5":16479,"_31422":59664,"_3630":60067},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_4190":653,"_34937":486,"_23830":60069,"_5":16479,"_31422":59664,"_3630":60070},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_4190":654,"_34937":654,"_5":16871,"_3630":60072,"_35372":60073,"_23830":60074,"_31422":654},"Alerts and subscriptions",[58062,59537,59538],[],{"_4190":655,"_34937":654,"_23830":60076,"_5":16479,"_31422":654,"_3630":60077},[],"Send PKI events to people and external systems.",{"_4190":656,"_34937":654,"_5":35369,"_23830":60079,"_31422":60080,"_3630":60081},[],"/docs/pr-preview/pr-58/platform/administration/alerts#how-it-works","How it works",{"_4190":657,"_34937":654,"_5":35369,"_23830":60083,"_31422":60084,"_3630":60085},[],"/docs/pr-preview/pr-58/platform/administration/alerts#available-channels","Available channels",{"_4190":658,"_34937":654,"_5":35369,"_23830":60087,"_31422":60088,"_3630":60089},[],"/docs/pr-preview/pr-58/platform/administration/alerts#create-a-subscription","Create a subscription",{"_4190":659,"_34937":654,"_5":35369,"_23830":60091,"_31422":60092,"_3630":60093},[],"/docs/pr-preview/pr-58/platform/administration/alerts#choose-the-event","Choose the event",{"_4190":660,"_34937":654,"_5":35369,"_23830":60095,"_31422":60096,"_3630":60097},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-destination","Configure the destination",{"_4190":661,"_34937":654,"_5":35369,"_23830":60099,"_31422":60100,"_3630":60101},[],"/docs/pr-preview/pr-58/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_4190":662,"_34937":654,"_5":35369,"_23830":60103,"_31422":60104,"_3630":60105},[],"/docs/pr-preview/pr-58/platform/administration/alerts#review-and-activate","Review and activate",{"_4190":663,"_34937":654,"_5":35369,"_23830":60107,"_31422":60108,"_3630":60109},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_4190":664,"_34937":654,"_5":35369,"_23830":60111,"_31422":60112,"_3630":60113},[],"/docs/pr-preview/pr-58/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_4190":665,"_34937":654,"_5":35369,"_23830":60115,"_31422":60116,"_3630":60117},[],"/docs/pr-preview/pr-58/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_4190":666,"_34937":654,"_5":35369,"_23830":60119,"_31422":60120,"_3630":60121},[],"/docs/pr-preview/pr-58/platform/administration/alerts#event-families","Event families",{"_4190":667,"_34937":654,"_23830":60123,"_5":16479,"_31422":654,"_3630":60124},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_4190":668,"_34937":654,"_23830":60126,"_5":16479,"_31422":60080,"_3630":60127},[],"A service publishes a domain event.",{"_4190":669,"_34937":654,"_23830":60129,"_5":16479,"_31422":60080,"_3630":60130},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_4190":670,"_34937":654,"_23830":60132,"_5":16479,"_31422":60080,"_3630":60133},[],"Each subscription's filter decides whether it should be notified.",{"_4190":671,"_34937":654,"_23830":60135,"_5":16479,"_31422":60080,"_3630":60136},[],"Lamassu delivers the event to the configured channel.",{"_4190":672,"_34937":654,"_23830":60138,"_5":16479,"_31422":60080,"_3630":60139},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_4190":673,"_34937":654,"_23830":60141,"_5":16479,"_31422":60084,"_3630":60142},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_4190":674,"_34937":654,"_23830":60144,"_5":16479,"_31422":60084,"_3630":60145},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_4190":675,"_34937":654,"_23830":60147,"_5":16479,"_31422":60084,"_3630":60148},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_4190":676,"_34937":654,"_23830":60150,"_5":16479,"_31422":60084,"_3630":60151},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_4190":677,"_34937":654,"_23830":60153,"_5":16479,"_31422":60084,"_3630":60154},[],"`apikey_options` requires `header` and `key`.",{"_4190":678,"_34937":654,"_23830":60156,"_5":16479,"_31422":60084,"_3630":60157},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_4190":679,"_34937":654,"_23830":60159,"_5":16479,"_31422":60084,"_3630":60160},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_4190":680,"_34937":654,"_23830":60162,"_5":16479,"_31422":60084,"_3630":60163},[],"The alerts API reference documents the full `http_client` schema.",{"_4190":681,"_34937":654,"_23830":60165,"_5":16479,"_31422":60092,"_3630":60166},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_4190":682,"_34937":654,"_23830":60168,"_5":16479,"_31422":60096,"_3630":60169},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_4190":683,"_34937":654,"_23830":60171,"_5":16479,"_31422":60100,"_3630":60172},[],"Add a filter if you don't want to receive every instance of the event.",{"_4190":684,"_34937":654,"_23830":60174,"_5":16479,"_31422":60100,"_3630":60175},[],"**None** notifies all instances of the event.",{"_4190":685,"_34937":654,"_23830":60177,"_5":16479,"_31422":60100,"_3630":60178},[],"**JSON Path** evaluates one or more specific fields.",{"_4190":686,"_34937":654,"_23830":60180,"_5":16479,"_31422":60100,"_3630":60181},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_4190":687,"_34937":654,"_23830":60183,"_5":16479,"_31422":60100,"_3630":60184},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_4190":688,"_34937":654,"_23830":60186,"_5":16479,"_31422":60100,"_3630":60187},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_4190":689,"_34937":654,"_23830":60189,"_5":16479,"_31422":60100,"_3630":60190},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_4190":690,"_34937":654,"_23830":60192,"_5":16479,"_31422":60104,"_3630":60193},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_4190":691,"_34937":654,"_23830":60195,"_5":16479,"_31422":60108,"_3630":60196},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_4190":692,"_34937":654,"_23830":60198,"_5":16479,"_31422":60108,"_3630":60199},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_4190":693,"_34937":654,"_23830":60201,"_5":16479,"_31422":60108,"_3630":60202},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_4190":694,"_34937":654,"_23830":60204,"_5":16479,"_31422":60108,"_3630":60205},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_4190":695,"_34937":654,"_23830":60207,"_5":16479,"_31422":60108,"_3630":60208},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_4190":696,"_34937":654,"_23830":60210,"_5":16479,"_31422":60108,"_3630":60211},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_4190":697,"_34937":654,"_23830":60213,"_5":16479,"_31422":60108,"_3630":60214},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_4190":698,"_34937":654,"_23830":60216,"_5":16479,"_31422":60108,"_3630":60217},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_4190":699,"_34937":654,"_23830":60219,"_5":16479,"_31422":60112,"_3630":60220},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_4190":700,"_34937":654,"_23830":60222,"_5":16479,"_31422":60112,"_3630":60223},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_4190":701,"_34937":654,"_23830":60225,"_5":16479,"_31422":60112,"_3630":60226},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_4190":702,"_34937":654,"_23830":60228,"_5":16479,"_31422":60112,"_3630":60229},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_4190":703,"_34937":654,"_23830":60231,"_5":16479,"_31422":60112,"_3630":60232},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_4190":704,"_34937":654,"_23830":60234,"_5":16479,"_31422":60112,"_3630":60235},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_4190":705,"_34937":654,"_23830":60237,"_5":16479,"_31422":60112,"_3630":60238},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_4190":706,"_34937":654,"_23830":60240,"_5":16479,"_31422":60112,"_3630":60241},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_4190":707,"_34937":654,"_23830":60243,"_5":16479,"_31422":60116,"_3630":60244},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_4190":708,"_34937":654,"_23830":60246,"_5":16479,"_31422":60116,"_3630":60247},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_4190":709,"_34937":654,"_23830":60249,"_5":16479,"_31422":60120,"_3630":60250},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_4190":710,"_34937":654,"_23830":60252,"_5":16479,"_31422":60120,"_3630":60253},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_4190":711,"_34937":654,"_23830":60255,"_5":16479,"_31422":60120,"_3630":60256},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_4190":712,"_34937":654,"_23830":60258,"_5":16479,"_31422":60120,"_3630":60259},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_4190":713,"_34937":654,"_23830":60261,"_5":16479,"_31422":60120,"_3630":60262},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_4190":714,"_34937":654,"_23830":60264,"_5":16479,"_31422":60120,"_3630":60265},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_4190":715,"_34937":654,"_23830":60267,"_5":16479,"_31422":60120,"_3630":60268},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_4190":716,"_34937":654,"_23830":60270,"_5":16479,"_31422":60120,"_3630":60271},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_4190":717,"_34937":654,"_23830":60273,"_5":16479,"_31422":60120,"_3630":60274},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_4190":718,"_34937":718,"_5":16871,"_3630":60276,"_35372":60277,"_23830":60278,"_31422":718},"Audit logs",[58062,59537,59538],[],{"_4190":719,"_34937":718,"_23830":60280,"_5":16479,"_31422":718,"_3630":60281},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_4190":720,"_34937":718,"_5":35369,"_23830":60283,"_31422":60284,"_3630":60285},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_4190":721,"_34937":718,"_5":35369,"_23830":60287,"_31422":60288,"_3630":60289},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#coverage","Coverage",{"_4190":722,"_34937":718,"_5":35369,"_23830":60291,"_31422":60292,"_3630":60293},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_4190":723,"_34937":718,"_5":35369,"_23830":60295,"_31422":60296,"_3630":60297},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_4190":724,"_34937":718,"_5":35369,"_23830":60299,"_31422":60300,"_3630":60301},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_4190":725,"_34937":718,"_5":35369,"_23830":60303,"_31422":60304,"_3630":60305},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_4190":726,"_34937":718,"_5":35369,"_23830":60307,"_31422":60308,"_3630":60309},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_4190":727,"_34937":718,"_5":35369,"_23830":60311,"_31422":60312,"_3630":60313},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_4190":728,"_34937":718,"_5":35369,"_23830":60315,"_31422":60316,"_3630":60317},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_4190":729,"_34937":718,"_5":35369,"_23830":60319,"_31422":60320,"_3630":60321},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_4190":730,"_34937":718,"_5":35369,"_23830":60323,"_31422":60324,"_3630":60325},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_4190":731,"_34937":718,"_23830":60327,"_5":16479,"_31422":718,"_3630":60328},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_4190":732,"_34937":718,"_23830":60330,"_5":16479,"_31422":60284,"_3630":60331},[],"The audit body includes:",{"_4190":733,"_34937":718,"_23830":60333,"_5":16479,"_31422":60284,"_3630":60334},[],"input: data received by the operation;",{"_4190":734,"_34937":718,"_23830":60336,"_5":16479,"_31422":60284,"_3630":60337},[],"has\\_error: whether the service returned an error;",{"_4190":735,"_34937":718,"_23830":60339,"_5":16479,"_31422":60284,"_3630":60340},[],"output: produced result or error message;",{"_4190":736,"_34937":718,"_23830":60342,"_5":16479,"_31422":60284,"_3630":60343},[],"principals: identifiers of the principals that matched the request.",{"_4190":737,"_34937":718,"_23830":60345,"_5":16479,"_31422":60284,"_3630":60346},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_4190":738,"_34937":718,"_23830":60348,"_5":16479,"_31422":60284,"_3630":60349},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_4190":739,"_34937":718,"_23830":60351,"_5":16479,"_31422":60288,"_3630":60352},[],"The backend applies auditing to mutations of:",{"_4190":740,"_34937":718,"_23830":60354,"_5":16479,"_31422":60288,"_3630":60355},[],"authorities, certificates and issuance profiles;",{"_4190":741,"_34937":718,"_23830":60357,"_5":16479,"_31422":60288,"_3630":60358},[],"keys and KMS engines;",{"_4190":742,"_34937":718,"_23830":60360,"_5":16479,"_31422":60288,"_3630":60361},[],"devices and identities;",{"_4190":743,"_34937":718,"_23830":60363,"_5":16479,"_31422":60288,"_3630":60364},[],"DMSs and enrollment operations;",{"_4190":744,"_34937":718,"_23830":60366,"_5":16479,"_31422":60288,"_3630":60367},[],"validation functions and CRL;",{"_4190":745,"_34937":718,"_23830":60369,"_5":16479,"_31422":60288,"_3630":60370},[],"principals, policies and authorization grants.",{"_4190":746,"_34937":718,"_23830":60372,"_5":16479,"_31422":60288,"_3630":60373},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_4190":747,"_34937":718,"_23830":60375,"_5":16479,"_31422":60292,"_3630":60376},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_4190":748,"_34937":718,"_23830":60378,"_5":16479,"_31422":60292,"_3630":60379},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_4190":749,"_34937":718,"_23830":60381,"_5":16479,"_31422":60292,"_3630":60382},[],"Design the consumer to:",{"_4190":750,"_34937":718,"_23830":60384,"_5":16479,"_31422":60292,"_3630":60385},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_4190":751,"_34937":718,"_23830":60387,"_5":16479,"_31422":60292,"_3630":60388},[],"keep the complete CloudEvent unmodified;",{"_4190":752,"_34937":718,"_23830":60390,"_5":16479,"_31422":60292,"_3630":60391},[],"record the ingestion time and detect duplicates by ID;",{"_4190":753,"_34937":718,"_23830":60393,"_5":16479,"_31422":60292,"_3630":60394},[],"encrypt in transit and at rest;",{"_4190":754,"_34937":718,"_23830":60396,"_5":16479,"_31422":60292,"_3630":60397},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_4190":755,"_34937":718,"_23830":60399,"_5":16479,"_31422":60292,"_3630":60400},[],"apply an explicit retention and legal hold policy;",{"_4190":756,"_34937":718,"_23830":60402,"_5":16479,"_31422":60292,"_3630":60403},[],"alert if it stops consuming or the pending queue grows.",{"_4190":757,"_34937":718,"_23830":60405,"_5":16479,"_31422":60296,"_3630":60406},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_4190":758,"_34937":718,"_23830":60408,"_5":16479,"_31422":60296,"_3630":60409},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_4190":759,"_34937":718,"_23830":60411,"_5":16479,"_31422":60304,"_3630":60412},[],"Start from the reported time and normalize every source to UTC.",{"_4190":760,"_34937":718,"_23830":60414,"_5":16479,"_31422":60308,"_3630":60415},[],"Filter by event type, service source and resource identifier.",{"_4190":761,"_34937":718,"_23830":60417,"_5":16479,"_31422":60312,"_3630":60418},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_4190":762,"_34937":718,"_23830":60420,"_5":16479,"_31422":60316,"_3630":60421},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_4190":763,"_34937":718,"_23830":60423,"_5":16479,"_31422":60320,"_3630":60424},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_4190":764,"_34937":718,"_23830":60426,"_5":16479,"_31422":60324,"_3630":60427},[],"Generate a controlled mutation in a test environment and check that:",{"_4190":765,"_34937":718,"_23830":60429,"_5":16479,"_31422":60324,"_3630":60430},[],"a successful audit event appears;",{"_4190":766,"_34937":718,"_23830":60432,"_5":16479,"_31422":60324,"_3630":60433},[],"the principal matches the identity used;",{"_4190":767,"_34937":718,"_23830":60435,"_5":16479,"_31422":60324,"_3630":60436},[],"the consumer persists it exactly once;",{"_4190":768,"_34937":718,"_23830":60438,"_5":16479,"_31422":60324,"_3630":60439},[],"it can be retrieved by resource, actor and period;",{"_4190":769,"_34937":718,"_23830":60441,"_5":16479,"_31422":60324,"_3630":60442},[],"a consumer outage raises an alert.",{"_4190":770,"_34937":718,"_23830":60444,"_5":16479,"_31422":60324,"_3630":60445},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_4190":771,"_34937":771,"_5":16871,"_3630":60447,"_35372":60448,"_23830":60449,"_31422":771},"Platform architecture",[58062,59537],[],{"_4190":772,"_34937":771,"_23830":60451,"_5":16479,"_31422":771,"_3630":60452},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_4190":773,"_34937":771,"_5":35369,"_23830":60454,"_31422":60455,"_3630":60456},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#control-plane","Control plane",{"_4190":774,"_34937":771,"_5":35369,"_23830":60458,"_31422":60459,"_3630":60460},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_4190":775,"_34937":771,"_5":35369,"_23830":60462,"_31422":60463,"_3630":60464},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_4190":776,"_34937":771,"_5":35369,"_23830":60466,"_31422":60467,"_3630":60468},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#status-and-validation","Status and validation",{"_4190":777,"_34937":771,"_5":35369,"_23830":60470,"_31422":60471,"_3630":60472},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_4190":778,"_34937":771,"_23830":60474,"_5":16479,"_31422":771,"_3630":60475},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_4190":779,"_34937":771,"_23830":60477,"_5":16479,"_31422":771,"_3630":60478},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_4190":780,"_34937":771,"_23830":60480,"_5":16479,"_31422":60455,"_3630":60481},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_4190":781,"_34937":771,"_23830":60483,"_5":16479,"_31422":60459,"_3630":60484},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_4190":782,"_34937":771,"_23830":60486,"_5":16479,"_31422":60463,"_3630":60487},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_4190":783,"_34937":771,"_23830":60489,"_5":16479,"_31422":60467,"_3630":60490},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_4190":784,"_34937":771,"_23830":60492,"_5":16479,"_31422":60471,"_3630":60493},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_4190":785,"_34937":785,"_5":16871,"_3630":60495,"_35372":60496,"_23830":60497,"_31422":785},"How Lamassu works",[58062,59537],[],{"_4190":786,"_34937":785,"_23830":60499,"_5":16479,"_31422":785,"_3630":60500},[],"The mental model of trust, keys, certificates and devices.",{"_4190":787,"_34937":785,"_5":35369,"_23830":60502,"_31422":60503,"_3630":60504},[],"/docs/pr-preview/pr-58/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_4190":788,"_34937":785,"_5":35369,"_23830":60506,"_31422":60507,"_3630":60508},[],"/docs/pr-preview/pr-58/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_4190":789,"_34937":785,"_23830":60510,"_5":16479,"_31422":785,"_3630":60511},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_4190":790,"_34937":785,"_23830":60513,"_5":16479,"_31422":60503,"_3630":60514},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_4190":791,"_34937":785,"_23830":60516,"_5":16479,"_31422":60503,"_3630":60517},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_4190":792,"_34937":785,"_23830":60519,"_5":16479,"_31422":60503,"_3630":60520},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_4190":793,"_34937":785,"_23830":60522,"_5":16479,"_31422":60503,"_3630":60523},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_4190":794,"_34937":785,"_23830":60525,"_5":16479,"_31422":60503,"_3630":60526},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_4190":795,"_34937":785,"_23830":60528,"_5":16479,"_31422":60507,"_3630":60529},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_4190":796,"_34937":785,"_23830":60531,"_5":16479,"_31422":60507,"_3630":60532},[],"A DMS relates that CA to an enrollment policy.",{"_4190":797,"_34937":785,"_23830":60534,"_5":16479,"_31422":60507,"_3630":60535},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_4190":798,"_34937":785,"_23830":60537,"_5":16479,"_31422":60507,"_3630":60538},[],"Lamassu keeps the inventory, history and status of the identity.",{"_4190":799,"_34937":785,"_23830":60540,"_5":16479,"_31422":60507,"_3630":60541},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_4190":800,"_34937":785,"_23830":60543,"_5":16479,"_31422":60507,"_3630":60544},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_4190":801,"_34937":785,"_23830":60546,"_5":16479,"_31422":60507,"_3630":60547},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_4190":802,"_34937":802,"_5":16871,"_3630":60549,"_35372":60550,"_23830":60552,"_31422":802},"Devices and identities",[58062,59537,60551,60549],"IoT Fleets",[],{"_4190":803,"_34937":802,"_23830":60554,"_5":16479,"_31422":802,"_3630":60555},[],"Register, inspect and retire devices while checking their current identity and history.",{"_4190":804,"_34937":802,"_5":35369,"_23830":60557,"_31422":60558,"_3630":60559},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#device-states","Device states",{"_4190":805,"_34937":802,"_5":35369,"_23830":60561,"_31422":60562,"_3630":60563},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_4190":806,"_34937":802,"_5":35369,"_23830":60565,"_31422":60566,"_3630":60567},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_4190":807,"_34937":802,"_5":35369,"_23830":60569,"_31422":60570,"_3630":60571},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#create-the-device","Create the device",{"_4190":808,"_34937":802,"_5":35369,"_23830":60573,"_31422":60574,"_3630":60575},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_4190":809,"_34937":802,"_5":35369,"_23830":60577,"_31422":60578,"_3630":60579},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_4190":810,"_34937":802,"_5":35369,"_23830":60581,"_31422":60582,"_3630":60583},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_4190":811,"_34937":802,"_5":35369,"_23830":60585,"_31422":60586,"_3630":60587},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_4190":812,"_34937":802,"_5":35369,"_23830":60589,"_31422":60590,"_3630":60591},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_4190":813,"_34937":802,"_5":35369,"_23830":60593,"_31422":60594,"_3630":60595},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_4190":814,"_34937":802,"_5":35369,"_23830":60597,"_31422":60598,"_3630":60599},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_4190":815,"_34937":802,"_23830":60601,"_5":16479,"_31422":802,"_3630":60602},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_4190":816,"_34937":802,"_23830":60604,"_5":16479,"_31422":802,"_3630":60605},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_4190":817,"_34937":802,"_23830":60607,"_5":16479,"_31422":60558,"_3630":60608},[],"Operational view",{"_4190":818,"_34937":802,"_23830":60610,"_5":16479,"_31422":60558,"_3630":60611},[],"Meaning",{"_4190":819,"_34937":802,"_23830":60613,"_5":16479,"_31422":60558,"_3630":60614},[],"**No Identity**",{"_4190":820,"_34937":802,"_23830":60616,"_5":16479,"_31422":60558,"_3630":60617},[],"A record exists without an associated identity.",{"_4190":821,"_34937":802,"_23830":60619,"_5":16479,"_31422":60558,"_3630":60620},[],"**Active**",{"_4190":822,"_34937":802,"_23830":60622,"_5":16479,"_31422":60558,"_3630":60623},[],"The slot is active; also check certificate dates, status and usages.",{"_4190":823,"_34937":802,"_23830":60625,"_5":16479,"_31422":60558,"_3630":60626},[],"**Renewal Pending**",{"_4190":824,"_34937":802,"_23830":60628,"_5":16479,"_31422":60558,"_3630":60629},[],"The identity is in the operational renewal window.",{"_4190":825,"_34937":802,"_23830":60631,"_5":16479,"_31422":60558,"_3630":60632},[],"**Expiring Soon**",{"_4190":826,"_34937":802,"_23830":60634,"_5":16479,"_31422":60558,"_3630":60635},[],"Expiration is approaching according to configured thresholds.",{"_4190":827,"_34937":802,"_23830":60637,"_5":16479,"_31422":60558,"_3630":60638},[],"**Expired**",{"_4190":828,"_34937":802,"_23830":60640,"_5":16479,"_31422":60558,"_3630":60641},[],"The identity has expired.",{"_4190":829,"_34937":802,"_23830":60643,"_5":16479,"_31422":60558,"_3630":60644},[],"**Revoked**",{"_4190":830,"_34937":802,"_23830":60646,"_5":16479,"_31422":60558,"_3630":60647},[],"The identity is marked revoked.",{"_4190":831,"_34937":802,"_23830":60649,"_5":16479,"_31422":60558,"_3630":60650},[],"**Decommissioned**",{"_4190":832,"_34937":802,"_23830":60652,"_5":16479,"_31422":60558,"_3630":60653},[],"The record is retired and ordinary updates do not restore operation.",{"_4190":833,"_34937":802,"_23830":60655,"_5":16479,"_31422":60558,"_3630":60656},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_4190":834,"_34937":802,"_23830":60658,"_5":16479,"_31422":60562,"_3630":60659},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_4190":835,"_34937":802,"_23830":60661,"_5":16479,"_31422":60562,"_3630":60662},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_4190":836,"_34937":802,"_23830":60664,"_5":16479,"_31422":60562,"_3630":60665},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_4190":837,"_34937":802,"_23830":60667,"_5":16479,"_31422":60562,"_3630":60668},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_4190":838,"_34937":802,"_23830":60670,"_5":16479,"_31422":60566,"_3630":60671},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_4190":839,"_34937":802,"_23830":60673,"_5":16479,"_31422":60570,"_3630":60674},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_4190":840,"_34937":802,"_23830":60676,"_5":16479,"_31422":60574,"_3630":60677},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_4190":841,"_34937":802,"_23830":60679,"_5":16479,"_31422":60578,"_3630":60680},[],"Add model, environment or location tags and an icon according to your inventory.",{"_4190":842,"_34937":802,"_23830":60682,"_5":16479,"_31422":60582,"_3630":60683},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_4190":843,"_34937":802,"_23830":60685,"_5":16479,"_31422":60582,"_3630":60686},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_4190":844,"_34937":802,"_23830":60688,"_5":16479,"_31422":60586,"_3630":60689},[],"From **No Identity**, use **Assign Identity**:",{"_4190":845,"_34937":802,"_23830":60691,"_5":16479,"_31422":60586,"_3630":60692},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_4190":846,"_34937":802,"_23830":60694,"_5":16479,"_31422":60586,"_3630":60695},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_4190":847,"_34937":802,"_23830":60697,"_5":16479,"_31422":60586,"_3630":60698},[],"Confirm and read the serial, active version and history again.",{"_4190":848,"_34937":802,"_23830":60700,"_5":16479,"_31422":60586,"_3630":60701},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_4190":849,"_34937":802,"_23830":60703,"_5":16479,"_31422":60586,"_3630":60704},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_4190":850,"_34937":802,"_23830":60706,"_5":16479,"_31422":60590,"_3630":60707},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_4190":851,"_34937":802,"_23830":60709,"_5":16479,"_31422":60590,"_3630":60710},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_4190":852,"_34937":802,"_23830":60712,"_5":16479,"_31422":60594,"_3630":60713},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_4190":853,"_34937":802,"_23830":60715,"_5":16479,"_31422":60594,"_3630":60716},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_4190":854,"_34937":802,"_23830":60718,"_5":16479,"_31422":60594,"_3630":60719},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_4190":855,"_34937":802,"_23830":60721,"_5":16479,"_31422":60594,"_3630":60722},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_4190":856,"_34937":802,"_23830":60724,"_5":16479,"_31422":60598,"_3630":60725},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4190":857,"_34937":802,"_23830":60727,"_5":16479,"_31422":60598,"_3630":60728},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4190":858,"_34937":858,"_5":16871,"_3630":60730,"_35372":60731,"_23830":60733,"_31422":858},"Bootstrap identity and authentication",[58062,59537,60551,60549,60732],"Enrollment with PKI",[],{"_4190":859,"_34937":858,"_23830":60735,"_5":16479,"_31422":858,"_3630":60736},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_4190":860,"_34937":858,"_5":35369,"_23830":60738,"_31422":60739,"_3630":60740},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_4190":861,"_34937":858,"_5":35369,"_23830":60742,"_31422":60743,"_3630":60744},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_4190":862,"_34937":858,"_5":35369,"_23830":60746,"_31422":60747,"_3630":60748},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_4190":863,"_34937":858,"_5":35369,"_23830":60750,"_31422":60751,"_3630":60752},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_4190":864,"_34937":858,"_5":35369,"_23830":60754,"_31422":60755,"_3630":60756},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_4190":865,"_34937":858,"_23830":60758,"_5":16479,"_31422":858,"_3630":60759},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_4190":866,"_34937":858,"_23830":60761,"_5":16479,"_31422":60739,"_3630":60762},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_4190":867,"_34937":858,"_23830":60764,"_5":16479,"_31422":60739,"_3630":60765},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_4190":868,"_34937":858,"_23830":60767,"_5":16479,"_31422":60743,"_3630":60768},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_4190":869,"_34937":858,"_23830":60770,"_5":16479,"_31422":60743,"_3630":60771},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_4190":870,"_34937":858,"_23830":60773,"_5":16479,"_31422":60743,"_3630":60774},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_4190":871,"_34937":858,"_23830":60776,"_5":16479,"_31422":60747,"_3630":60777},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_4190":872,"_34937":858,"_23830":60779,"_5":16479,"_31422":60747,"_3630":60780},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_4190":873,"_34937":858,"_23830":60782,"_5":16479,"_31422":60751,"_3630":60783},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_4190":874,"_34937":858,"_23830":60785,"_5":16479,"_31422":60751,"_3630":60786},[],"Example body:",{"_4190":875,"_34937":858,"_23830":60788,"_5":16479,"_31422":60751,"_3630":60789},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_4190":876,"_34937":858,"_23830":60791,"_5":16479,"_31422":60751,"_3630":60792},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_4190":877,"_34937":858,"_23830":60794,"_5":16479,"_31422":60751,"_3630":60795},[],"Continuation requires a successful HTTP response and JSON:",{"_4190":878,"_34937":858,"_23830":60797,"_5":16479,"_31422":60751,"_3630":60798},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_4190":879,"_34937":858,"_23830":60800,"_5":16479,"_31422":60755,"_3630":60801},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_4190":880,"_34937":858,"_23830":60803,"_5":16479,"_31422":60755,"_3630":60804},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_4190":881,"_34937":881,"_5":16871,"_3630":60806,"_35372":60807,"_23830":60808,"_31422":881},"Configure and operate the DMS",[58062,59537,60551,60549,60732],[],{"_4190":882,"_34937":881,"_23830":60810,"_5":16479,"_31422":881,"_3630":60811},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_4190":883,"_34937":881,"_5":35369,"_23830":60813,"_31422":60814,"_3630":58072},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#before-you-begin",{"_4190":884,"_34937":881,"_5":35369,"_23830":60816,"_31422":60817,"_3630":60818},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_4190":885,"_34937":881,"_5":35369,"_23830":60820,"_31422":60821,"_3630":60822},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_4190":886,"_34937":881,"_5":35369,"_23830":60824,"_31422":60825,"_3630":60826},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_4190":887,"_34937":881,"_5":35369,"_23830":60828,"_31422":60829,"_3630":60830},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_4190":888,"_34937":881,"_5":35369,"_23830":60832,"_31422":60833,"_3630":60834},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_4190":889,"_34937":881,"_5":35369,"_23830":60836,"_31422":60837,"_3630":60838},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_4190":890,"_34937":881,"_5":35369,"_23830":60840,"_31422":60841,"_3630":60842},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_4190":891,"_34937":881,"_5":35369,"_23830":60844,"_31422":60845,"_3630":60846},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_4190":892,"_34937":881,"_5":35369,"_23830":60848,"_31422":60849,"_3630":60850},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_4190":893,"_34937":881,"_5":35369,"_23830":60852,"_31422":60853,"_3630":60854},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_4190":894,"_34937":881,"_5":35369,"_23830":60856,"_31422":60857,"_3630":60858},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_4190":895,"_34937":881,"_5":35369,"_23830":60860,"_31422":60861,"_3630":60862},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_4190":896,"_34937":881,"_5":35369,"_23830":60864,"_31422":60865,"_3630":60866},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_4190":897,"_34937":881,"_5":35369,"_23830":60868,"_31422":60869,"_3630":60870},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_4190":898,"_34937":881,"_5":35369,"_23830":60872,"_31422":60873,"_3630":60874},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_4190":899,"_34937":881,"_5":35369,"_23830":60876,"_31422":60877,"_3630":60878},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_4190":900,"_34937":881,"_5":35369,"_23830":60880,"_31422":60881,"_3630":60882},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_4190":901,"_34937":881,"_23830":60884,"_5":16479,"_31422":881,"_3630":60885},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_4190":902,"_34937":881,"_23830":60887,"_5":16479,"_31422":60814,"_3630":60888},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_4190":903,"_34937":881,"_23830":60890,"_5":16479,"_31422":60814,"_3630":60891},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_4190":904,"_34937":881,"_23830":60893,"_5":16479,"_31422":60821,"_3630":60894},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_4190":905,"_34937":881,"_23830":60896,"_5":16479,"_31422":60825,"_3630":60897},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_4190":906,"_34937":881,"_23830":60899,"_5":16479,"_31422":60829,"_3630":60900},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_4190":907,"_34937":881,"_23830":60902,"_5":16479,"_31422":60833,"_3630":60903},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_4190":908,"_34937":881,"_23830":60905,"_5":16479,"_31422":60837,"_3630":60906},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_4190":909,"_34937":881,"_23830":60908,"_5":16479,"_31422":60845,"_3630":60909},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_4190":910,"_34937":881,"_23830":60911,"_5":16479,"_31422":60845,"_3630":60912},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_4190":911,"_34937":881,"_23830":60914,"_5":16479,"_31422":60849,"_3630":60915},[],"`settings.enrollment_settings` field",{"_4190":912,"_34937":881,"_23830":60917,"_5":16479,"_31422":60849,"_3630":60918},[],"Decision",{"_4190":913,"_34937":881,"_23830":60920,"_5":16479,"_31422":60849,"_3630":60921},[],"`protocol`",{"_4190":914,"_34937":881,"_23830":60923,"_5":16479,"_31422":60849,"_3630":60924},[],"`EST_RFC7030` for these operations.",{"_4190":915,"_34937":881,"_23830":60926,"_5":16479,"_31422":60849,"_3630":60927},[],"`enrollment_ca`",{"_4190":916,"_34937":881,"_23830":60929,"_5":16479,"_31422":60849,"_3630":60930},[],"ID of the signing CA.",{"_4190":917,"_34937":881,"_23830":60932,"_5":16479,"_31422":60849,"_3630":60933},[],"`verify_csr_signature`",{"_4190":918,"_34937":881,"_23830":60935,"_5":16479,"_31422":60849,"_3630":60936},[],"Keep `true` to verify CSR key possession.",{"_4190":919,"_34937":881,"_23830":60938,"_5":16479,"_31422":60849,"_3630":60939},[],"`enable_replaceable_enrollment`",{"_4190":920,"_34937":881,"_23830":60941,"_5":16479,"_31422":60849,"_3630":60942},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_4190":921,"_34937":881,"_23830":60944,"_5":16479,"_31422":60849,"_3630":60945},[],"`est_rfc7030_settings.auth_mode`",{"_4190":922,"_34937":881,"_23830":60947,"_5":16479,"_31422":60849,"_3630":60948},[],"One of the four authentication modes.",{"_4190":923,"_34937":881,"_23830":60950,"_5":16479,"_31422":60849,"_3630":60951},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_4190":924,"_34937":881,"_23830":60953,"_5":16479,"_31422":60853,"_3630":60954},[],"The blocks are independent:",{"_4190":925,"_34937":881,"_23830":60956,"_5":16479,"_31422":60853,"_3630":60957},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_4190":926,"_34937":881,"_23830":60959,"_5":16479,"_31422":60853,"_3630":60960},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_4190":927,"_34937":881,"_23830":60962,"_5":16479,"_31422":60853,"_3630":60963},[],"`auth_mode`",{"_4190":928,"_34937":881,"_23830":60965,"_5":16479,"_31422":60853,"_3630":60966},[],"Control applied in the configured operation",{"_4190":929,"_34937":881,"_23830":60968,"_5":16479,"_31422":60853,"_3630":60969},[],"`CLIENT_CERTIFICATE`",{"_4190":930,"_34937":881,"_23830":60971,"_5":16479,"_31422":60853,"_3630":60972},[],"Presented certificate validation.",{"_4190":931,"_34937":881,"_23830":60974,"_5":16479,"_31422":60853,"_3630":60975},[],"`EXTERNAL_WEBHOOK`",{"_4190":932,"_34937":881,"_23830":60977,"_5":16479,"_31422":60853,"_3630":60978},[],"Configured webhook authorization.",{"_4190":933,"_34937":881,"_23830":60980,"_5":16479,"_31422":60853,"_3630":60981},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_4190":934,"_34937":881,"_23830":60983,"_5":16479,"_31422":60853,"_3630":60984},[],"Certificate validation followed by webhook approval.",{"_4190":935,"_34937":881,"_23830":60986,"_5":16479,"_31422":60853,"_3630":60987},[],"`NO_AUTH`",{"_4190":936,"_34937":881,"_23830":60989,"_5":16479,"_31422":60853,"_3630":60990},[],"No DMS requester authentication.",{"_4190":937,"_34937":881,"_23830":60992,"_5":16479,"_31422":60853,"_3630":60993},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_4190":938,"_34937":881,"_23830":60995,"_5":16479,"_31422":60853,"_3630":60996},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_4190":939,"_34937":881,"_23830":60998,"_5":16479,"_31422":60853,"_3630":60999},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_4190":940,"_34937":881,"_23830":61001,"_5":16479,"_31422":60853,"_3630":61002},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_4190":941,"_34937":881,"_23830":61004,"_5":16479,"_31422":60857,"_3630":61005},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_4190":942,"_34937":881,"_23830":61007,"_5":16479,"_31422":60857,"_3630":61008},[],"`external_webhook_settings` field",{"_4190":943,"_34937":881,"_23830":61010,"_5":16479,"_31422":60857,"_3630":60918},[],{"_4190":944,"_34937":881,"_23830":61012,"_5":16479,"_31422":60857,"_3630":61013},[],"`url`",{"_4190":945,"_34937":881,"_23830":61015,"_5":16479,"_31422":60857,"_3630":61016},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_4190":946,"_34937":881,"_23830":61018,"_5":16479,"_31422":60857,"_3630":61019},[],"`method`",{"_4190":947,"_34937":881,"_23830":61021,"_5":16479,"_31422":60857,"_3630":61022},[],"`POST` or `PUT`; `POST` by default.",{"_4190":948,"_34937":881,"_23830":61024,"_5":16479,"_31422":60857,"_3630":61025},[],"`name`",{"_4190":949,"_34937":881,"_23830":61027,"_5":16479,"_31422":60857,"_3630":61028},[],"Label used in service logs.",{"_4190":950,"_34937":881,"_23830":61030,"_5":16479,"_31422":60857,"_3630":61031},[],"`config.auth_mode`",{"_4190":951,"_34937":881,"_23830":61033,"_5":16479,"_31422":60857,"_3630":61034},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_4190":952,"_34937":881,"_23830":61036,"_5":16479,"_31422":60857,"_3630":61037},[],"`config.log_level`",{"_4190":953,"_34937":881,"_23830":61039,"_5":16479,"_31422":60857,"_3630":61040},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_4190":954,"_34937":881,"_23830":61042,"_5":16479,"_31422":60857,"_3630":61043},[],"`config.apikey_options`",{"_4190":955,"_34937":881,"_23830":61045,"_5":16479,"_31422":60857,"_3630":61046},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_4190":956,"_34937":881,"_23830":61048,"_5":16479,"_31422":60857,"_3630":61049},[],"`config.jwt_options`",{"_4190":957,"_34937":881,"_23830":61051,"_5":16479,"_31422":60857,"_3630":61052},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_4190":958,"_34937":881,"_23830":61054,"_5":16479,"_31422":60857,"_3630":61055},[],"`config.mtls_options`",{"_4190":959,"_34937":881,"_23830":61057,"_5":16479,"_31422":60857,"_3630":61058},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_4190":960,"_34937":881,"_23830":61060,"_5":16479,"_31422":60857,"_3630":61061},[],"`config.insecure_skip_verify`",{"_4190":961,"_34937":881,"_23830":61063,"_5":16479,"_31422":60857,"_3630":61064},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_4190":962,"_34937":881,"_23830":61066,"_5":16479,"_31422":60857,"_3630":61067},[],"`config.call_timeout`",{"_4190":963,"_34937":881,"_23830":61069,"_5":16479,"_31422":60857,"_3630":61070},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_4190":964,"_34937":881,"_23830":61072,"_5":16479,"_31422":60857,"_3630":61073},[],"Rules for that configuration:",{"_4190":965,"_34937":881,"_23830":61075,"_5":16479,"_31422":60857,"_3630":61076},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_4190":966,"_34937":881,"_23830":61078,"_5":16479,"_31422":60857,"_3630":61079},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_4190":967,"_34937":881,"_23830":61081,"_5":16479,"_31422":60857,"_3630":61082},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_4190":968,"_34937":881,"_23830":61084,"_5":16479,"_31422":60857,"_3630":61085},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_4190":969,"_34937":881,"_23830":61087,"_5":16479,"_31422":60857,"_3630":61088},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_4190":970,"_34937":881,"_23830":61090,"_5":16479,"_31422":60857,"_3630":61091},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_4190":971,"_34937":881,"_23830":61093,"_5":16479,"_31422":60857,"_3630":61094},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_4190":972,"_34937":881,"_23830":61096,"_5":16479,"_31422":60857,"_3630":61097},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_4190":973,"_34937":881,"_23830":61099,"_5":16479,"_31422":60857,"_3630":61100},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_4190":974,"_34937":881,"_23830":61102,"_5":16479,"_31422":60861,"_3630":61103},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_4190":975,"_34937":881,"_23830":61105,"_5":16479,"_31422":60865,"_3630":61106},[],"`settings.reenrollment_settings` field",{"_4190":976,"_34937":881,"_23830":61108,"_5":16479,"_31422":60865,"_3630":58452},[],{"_4190":977,"_34937":881,"_23830":61110,"_5":16479,"_31422":60865,"_3630":61111},[],"`reenrollment_delta`",{"_4190":978,"_34937":881,"_23830":61113,"_5":16479,"_31422":60865,"_3630":61114},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_4190":979,"_34937":881,"_23830":61116,"_5":16479,"_31422":60865,"_3630":61117},[],"`preventive_delta`",{"_4190":980,"_34937":881,"_23830":61119,"_5":16479,"_31422":60865,"_3630":61120},[],"Preventive operational monitoring threshold.",{"_4190":981,"_34937":881,"_23830":61122,"_5":16479,"_31422":60865,"_3630":61123},[],"`critical_delta`",{"_4190":982,"_34937":881,"_23830":61125,"_5":16479,"_31422":60865,"_3630":61126},[],"Critical operational monitoring threshold.",{"_4190":983,"_34937":881,"_23830":61128,"_5":16479,"_31422":60865,"_3630":61129},[],"`enable_expired_renewal`",{"_4190":984,"_34937":881,"_23830":61131,"_5":16479,"_31422":60865,"_3630":61132},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_4190":985,"_34937":881,"_23830":61134,"_5":16479,"_31422":60865,"_3630":61135},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_4190":986,"_34937":881,"_23830":61137,"_5":16479,"_31422":60865,"_3630":61138},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_4190":987,"_34937":881,"_23830":61140,"_5":16479,"_31422":60865,"_3630":61141},[],"`revoke_on_reenrollment`",{"_4190":988,"_34937":881,"_23830":61143,"_5":16479,"_31422":60865,"_3630":61144},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_4190":989,"_34937":881,"_23830":61146,"_5":16479,"_31422":60865,"_3630":61147},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_4190":990,"_34937":881,"_23830":61149,"_5":16479,"_31422":60869,"_3630":61150},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_4190":991,"_34937":881,"_23830":61152,"_5":16479,"_31422":60873,"_3630":58446},[],{"_4190":992,"_34937":881,"_23830":61154,"_5":16479,"_31422":60873,"_3630":61155},[],"Published material",{"_4190":993,"_34937":881,"_23830":61157,"_5":16479,"_31422":60873,"_3630":61158},[],"**Include Lamassu System CA**",{"_4190":994,"_34937":881,"_23830":61160,"_5":16479,"_31422":60873,"_3630":61161},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_4190":995,"_34937":881,"_23830":61163,"_5":16479,"_31422":60873,"_3630":61164},[],"**Include Enrollment CA**",{"_4190":996,"_34937":881,"_23830":61166,"_5":16479,"_31422":60873,"_3630":61167},[],"Selected issuing CA certificate.",{"_4190":997,"_34937":881,"_23830":61169,"_5":16479,"_31422":60873,"_3630":61170},[],"**Managed CAs**",{"_4190":998,"_34937":881,"_23830":61172,"_5":16479,"_31422":60873,"_3630":61173},[],"Explicitly selected CA certificates.",{"_4190":999,"_34937":881,"_23830":61175,"_5":16479,"_31422":60873,"_3630":61176},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_4190":1000,"_34937":881,"_23830":61178,"_5":16479,"_31422":60877,"_3630":61179},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_4190":1001,"_34937":881,"_23830":61181,"_5":16479,"_31422":60877,"_3630":61182},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_4190":1002,"_34937":881,"_23830":61184,"_5":16479,"_31422":60877,"_3630":61185},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_4190":1003,"_34937":881,"_23830":61187,"_5":16479,"_31422":60881,"_3630":61188},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_4190":1004,"_34937":1004,"_5":16871,"_3630":61190,"_35372":61191,"_23830":61192,"_31422":1004},"Integrate the EST client",[58062,59537,60551,60549,60732],[],{"_4190":1005,"_34937":1004,"_23830":61194,"_5":16479,"_31422":1004,"_3630":61195},[],"Prepare trust, send a CSR and check the identity you receive.",{"_4190":1006,"_34937":1004,"_5":35369,"_23830":61197,"_31422":61198,"_3630":58072},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_4190":1007,"_34937":1004,"_5":35369,"_23830":61200,"_31422":61201,"_3630":61202},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_4190":1008,"_34937":1004,"_5":35369,"_23830":61204,"_31422":61205,"_3630":61206},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_4190":1009,"_34937":1004,"_5":35369,"_23830":61208,"_31422":61209,"_3630":61210},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_4190":1010,"_34937":1004,"_5":35369,"_23830":61212,"_31422":61213,"_3630":61214},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_4190":1011,"_34937":1004,"_5":35369,"_23830":61216,"_31422":61217,"_3630":61218},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_4190":1012,"_34937":1004,"_23830":61220,"_5":16479,"_31422":1004,"_3630":61221},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_4190":1013,"_34937":1004,"_23830":61223,"_5":16479,"_31422":61198,"_3630":61224},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_4190":1014,"_34937":1004,"_23830":61226,"_5":16479,"_31422":61198,"_3630":61227},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_4190":1015,"_34937":1004,"_23830":61229,"_5":16479,"_31422":61198,"_3630":61230},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_4190":1016,"_34937":1004,"_23830":61232,"_5":16479,"_31422":61201,"_3630":61233},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_4190":1017,"_34937":1004,"_23830":61235,"_5":16479,"_31422":61201,"_3630":61236},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_4190":1018,"_34937":1004,"_23830":61238,"_5":16479,"_31422":61205,"_3630":61239},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_4190":1019,"_34937":1004,"_23830":61241,"_5":16479,"_31422":61205,"_3630":61242},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_4190":1020,"_34937":1004,"_23830":61244,"_5":16479,"_31422":61209,"_3630":61245},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_4190":1021,"_34937":1004,"_23830":61247,"_5":16479,"_31422":61209,"_3630":61248},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_4190":1022,"_34937":1004,"_23830":61250,"_5":16479,"_31422":61213,"_3630":61251},[],"For a root that issues directly:",{"_4190":1023,"_34937":1004,"_23830":61253,"_5":16479,"_31422":61213,"_3630":61254},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_4190":1024,"_34937":1004,"_23830":61256,"_5":16479,"_31422":61213,"_3630":61257},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_4190":1025,"_34937":1004,"_23830":61259,"_5":16479,"_31422":61217,"_3630":61260},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_4190":1026,"_34937":1026,"_5":16871,"_3630":61262,"_35372":61263,"_23830":61264,"_31422":1026},"EST reference",[58062,59537,60551,60549,60732],[],{"_4190":1027,"_34937":1026,"_23830":61266,"_5":16479,"_31422":1026,"_3630":61267},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_4190":1028,"_34937":1026,"_5":35369,"_23830":61269,"_31422":61270,"_3630":61271},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_4190":1029,"_34937":1026,"_5":35369,"_23830":61273,"_31422":61274,"_3630":25903},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#cacerts",{"_4190":1030,"_34937":1026,"_5":35369,"_23830":61276,"_31422":61277,"_3630":29715},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_4190":1031,"_34937":1026,"_5":35369,"_23830":61279,"_31422":61280,"_3630":29722},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_4190":1032,"_34937":1026,"_5":35369,"_23830":61282,"_31422":61283,"_3630":28944},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_4190":1033,"_34937":1026,"_5":35369,"_23830":61285,"_31422":61286,"_3630":61287},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_4190":1034,"_34937":1026,"_5":35369,"_23830":61289,"_31422":61290,"_3630":61291},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_4190":1035,"_34937":1026,"_5":35369,"_23830":61293,"_31422":61294,"_3630":61295},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_4190":1036,"_34937":1026,"_23830":61297,"_5":16479,"_31422":1026,"_3630":61298},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_4190":1037,"_34937":1026,"_23830":61300,"_5":16479,"_31422":61270,"_3630":61301},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_4190":1038,"_34937":1026,"_23830":61303,"_5":16479,"_31422":61270,"_3630":61304},[],"Operation",{"_4190":1039,"_34937":1026,"_23830":61306,"_5":16479,"_31422":61270,"_3630":61307},[],"Method",{"_4190":1040,"_34937":1026,"_23830":61309,"_5":16479,"_31422":61270,"_3630":61310},[],"Authentication and condition",{"_4190":1041,"_34937":1026,"_23830":61312,"_5":16479,"_31422":61270,"_3630":61313},[],"`/cacerts`",{"_4190":1042,"_34937":1026,"_23830":61315,"_5":16479,"_31422":61270,"_3630":61316},[],"GET",{"_4190":1043,"_34937":1026,"_23830":61318,"_5":16479,"_31422":61270,"_3630":61319},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_4190":1044,"_34937":1026,"_23830":61321,"_5":16479,"_31422":61270,"_3630":61322},[],"`/simpleenroll`",{"_4190":1045,"_34937":1026,"_23830":61324,"_5":16479,"_31422":61270,"_3630":61325},[],"POST",{"_4190":1046,"_34937":1026,"_23830":61327,"_5":16479,"_31422":61270,"_3630":61328},[],"Initial authentication and DMS registration/replacement policy.",{"_4190":1047,"_34937":1026,"_23830":61330,"_5":16479,"_31422":61270,"_3630":61331},[],"`/simplereenroll`",{"_4190":1048,"_34937":1026,"_23830":61333,"_5":16479,"_31422":61270,"_3630":61325},[],{"_4190":1049,"_34937":1026,"_23830":61335,"_5":16479,"_31422":61270,"_3630":61336},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_4190":1050,"_34937":1026,"_23830":61338,"_5":16479,"_31422":61270,"_3630":61339},[],"`/serverkeygen`",{"_4190":1051,"_34937":1026,"_23830":61341,"_5":16479,"_31422":61270,"_3630":61325},[],{"_4190":1052,"_34937":1026,"_23830":61343,"_5":16479,"_31422":61270,"_3630":61344},[],"Initial authentication and admission; server generation enabled.",{"_4190":1053,"_34937":1026,"_23830":61346,"_5":16479,"_31422":61270,"_3630":61347},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_4190":1054,"_34937":1026,"_23830":61349,"_5":16479,"_31422":61274,"_3630":61350},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_4190":1055,"_34937":1026,"_23830":61352,"_5":16479,"_31422":61274,"_3630":61353},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_4190":1056,"_34937":1026,"_23830":61355,"_5":16479,"_31422":61277,"_3630":61356},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_4190":1057,"_34937":1026,"_23830":61358,"_5":16479,"_31422":61277,"_3630":61359},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_4190":1058,"_34937":1026,"_23830":61361,"_5":16479,"_31422":61280,"_3630":61362},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_4190":1059,"_34937":1026,"_23830":61364,"_5":16479,"_31422":61280,"_3630":61365},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_4190":1060,"_34937":1026,"_23830":61367,"_5":16479,"_31422":61283,"_3630":61368},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_4190":1061,"_34937":1026,"_23830":61370,"_5":16479,"_31422":61283,"_3630":61371},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_4190":1062,"_34937":1026,"_23830":61373,"_5":16479,"_31422":61286,"_3630":61374},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_4190":1063,"_34937":1026,"_23830":61376,"_5":16479,"_31422":61286,"_3630":61377},[],"Part",{"_4190":1064,"_34937":1026,"_23830":61379,"_5":16479,"_31422":61286,"_3630":61380},[],"Content after decoding its Base64",{"_4190":1065,"_34937":1026,"_23830":61382,"_5":16479,"_31422":61286,"_3630":61383},[],"`application/pkcs8`",{"_4190":1066,"_34937":1026,"_23830":61385,"_5":16479,"_31422":61286,"_3630":61386},[],"Unencrypted DER PKCS#8 private key.",{"_4190":1067,"_34937":1026,"_23830":61388,"_5":16479,"_31422":61286,"_3630":61389},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_4190":1068,"_34937":1026,"_23830":61391,"_5":16479,"_31422":61286,"_3630":61392},[],"DER PKCS#7 containing the issued certificate.",{"_4190":1069,"_34937":1026,"_23830":61394,"_5":16479,"_31422":61286,"_3630":61395},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_4190":1070,"_34937":1026,"_23830":61397,"_5":16479,"_31422":61290,"_3630":61398},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_4190":1071,"_34937":1026,"_23830":61400,"_5":16479,"_31422":61290,"_3630":61401},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_4190":1072,"_34937":1026,"_23830":61403,"_5":16479,"_31422":61290,"_3630":61404},[],"Convert and check the result:",{"_4190":1073,"_34937":1026,"_23830":61406,"_5":16479,"_31422":61290,"_3630":61407},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_4190":1074,"_34937":1026,"_23830":61409,"_5":16479,"_31422":61294,"_3630":61410},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_4190":1075,"_34937":1026,"_23830":61412,"_5":16479,"_31422":61294,"_3630":61413},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_4190":1076,"_34937":1076,"_5":16871,"_3630":60732,"_35372":61415,"_23830":61416,"_31422":1076},[58062,59537,60551,60549,60732],[],{"_4190":1077,"_34937":1076,"_23830":61418,"_5":16479,"_31422":1076,"_3630":61419},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_4190":1078,"_34937":1076,"_5":35369,"_23830":61421,"_31422":61422,"_3630":61423},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_4190":1079,"_34937":1076,"_5":35369,"_23830":61425,"_31422":61426,"_3630":61427},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_4190":1080,"_34937":1076,"_5":35369,"_23830":61429,"_31422":61430,"_3630":61431},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_4190":1081,"_34937":1076,"_5":35369,"_23830":61433,"_31422":61434,"_3630":61435},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_4190":1082,"_34937":1076,"_23830":61437,"_5":16479,"_31422":1076,"_3630":61438},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_4190":1083,"_34937":1076,"_23830":61440,"_5":16479,"_31422":61422,"_3630":61441},[],"The administrator prepares the CA, issuance profile and DMS.",{"_4190":1084,"_34937":1076,"_23830":61443,"_5":16479,"_31422":61422,"_3630":61444},[],"The integrator installs initial EST server trust and an admission credential.",{"_4190":1085,"_34937":1076,"_23830":61446,"_5":16479,"_31422":61422,"_3630":61447},[],"The client requests an identity for its `Device ID` through EST.",{"_4190":1086,"_34937":1076,"_23830":61449,"_5":16479,"_31422":61422,"_3630":61450},[],"Certificate, device binding and key/certificate installation are checked.",{"_4190":1087,"_34937":1076,"_23830":61452,"_5":16479,"_31422":61422,"_3630":61453},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_4190":1088,"_34937":1076,"_23830":61455,"_5":16479,"_31422":61422,"_3630":61456},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_4190":1089,"_34937":1076,"_23830":61458,"_5":16479,"_31422":61426,"_3630":61459},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_4190":1090,"_34937":1076,"_23830":61461,"_5":16479,"_31422":61426,"_3630":61462},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4190":1091,"_34937":1076,"_23830":61464,"_5":16479,"_31422":61426,"_3630":61465},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_4190":1092,"_34937":1076,"_23830":61467,"_5":16479,"_31422":61426,"_3630":61468},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_4190":1093,"_34937":1076,"_23830":61470,"_5":16479,"_31422":61430,"_3630":61471},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4190":1094,"_34937":1076,"_23830":61473,"_5":16479,"_31422":61430,"_3630":61474},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4190":1095,"_34937":1076,"_23830":61476,"_5":16479,"_31422":61430,"_3630":61477},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_4190":1096,"_34937":1076,"_23830":61479,"_5":16479,"_31422":61430,"_3630":61480},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_4190":1097,"_34937":1076,"_23830":61482,"_5":16479,"_31422":61434,"_3630":61483},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_4190":1098,"_34937":1076,"_23830":61485,"_5":16479,"_31422":61434,"_3630":61486},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_4190":1099,"_34937":1099,"_5":16871,"_3630":61488,"_35372":61489,"_23830":61490,"_31422":1099},"Provisioning strategies",[58062,59537,60551,60549,60732],[],{"_4190":1100,"_34937":1099,"_23830":61492,"_5":16479,"_31422":1099,"_3630":61493},[],"Choose device registration, identity authorization and key generation.",{"_4190":1101,"_34937":1099,"_5":35369,"_23830":61495,"_31422":61496,"_3630":61497},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_4190":1102,"_34937":1099,"_5":35369,"_23830":61499,"_31422":61500,"_3630":61501},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_4190":1103,"_34937":1099,"_5":35369,"_23830":61503,"_31422":61504,"_3630":61505},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_4190":1104,"_34937":1099,"_5":35369,"_23830":61507,"_31422":61508,"_3630":61509},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_4190":1105,"_34937":1099,"_5":35369,"_23830":61511,"_31422":61512,"_3630":61513},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_4190":1106,"_34937":1099,"_23830":61515,"_5":16479,"_31422":1099,"_3630":61516},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_4190":1107,"_34937":1099,"_23830":61518,"_5":16479,"_31422":61496,"_3630":61519},[],"Path",{"_4190":1108,"_34937":1099,"_23830":61521,"_5":16479,"_31422":61496,"_3630":61522},[],"When the device exists",{"_4190":1109,"_34937":1099,"_23830":61524,"_5":16479,"_31422":61496,"_3630":61525},[],"What to check",{"_4190":1110,"_34937":1099,"_23830":61527,"_5":16479,"_31422":61496,"_3630":61528},[],"Manual assignment",{"_4190":1111,"_34937":1099,"_23830":61530,"_5":16479,"_31422":61496,"_3630":61531},[],"An operator creates it before associating a certificate.",{"_4190":1112,"_34937":1099,"_23830":61533,"_5":16479,"_31422":61496,"_3630":61534},[],"ID, owning DMS, certificate CN and bound serial.",{"_4190":1113,"_34937":1099,"_23830":61536,"_5":16479,"_31422":61496,"_3630":61537},[],"EST with `JITP`",{"_4190":1114,"_34937":1099,"_23830":61539,"_5":16479,"_31422":61496,"_3630":61540},[],"Created for an unknown CN during `/simpleenroll`.",{"_4190":1115,"_34937":1099,"_23830":61542,"_5":16479,"_31422":61496,"_3630":61543},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_4190":1116,"_34937":1099,"_23830":61545,"_5":16479,"_31422":61496,"_3630":61546},[],"EST with `PRE_REGISTRATION`",{"_4190":1117,"_34937":1099,"_23830":61548,"_5":16479,"_31422":61496,"_3630":61549},[],"Must exist before `/simpleenroll`.",{"_4190":1118,"_34937":1099,"_23830":61551,"_5":16479,"_31422":61496,"_3630":61552},[],"Approved record, same DMS and replacement conditions for your version.",{"_4190":1119,"_34937":1099,"_23830":61554,"_5":16479,"_31422":61496,"_3630":61555},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_4190":1120,"_34937":1099,"_23830":61557,"_5":16479,"_31422":61496,"_3630":61558},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_4190":1121,"_34937":1099,"_23830":61560,"_5":16479,"_31422":61500,"_3630":61561},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_4190":1122,"_34937":1099,"_23830":61563,"_5":16479,"_31422":61500,"_3630":61564},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_4190":1123,"_34937":1099,"_23830":61566,"_5":16479,"_31422":61500,"_3630":61567},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_4190":1124,"_34937":1099,"_23830":61569,"_5":16479,"_31422":61504,"_3630":61570},[],"Decide initial enrollment and re-enrollment separately:",{"_4190":1125,"_34937":1099,"_23830":61572,"_5":16479,"_31422":61504,"_3630":61573},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_4190":1126,"_34937":1099,"_23830":61575,"_5":16479,"_31422":61504,"_3630":61576},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_4190":1127,"_34937":1099,"_23830":61578,"_5":16479,"_31422":61504,"_3630":61579},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_4190":1128,"_34937":1099,"_23830":61581,"_5":16479,"_31422":61504,"_3630":61582},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_4190":1129,"_34937":1099,"_23830":61584,"_5":16479,"_31422":61504,"_3630":61585},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_4190":1130,"_34937":1099,"_23830":61587,"_5":16479,"_31422":61508,"_3630":58446},[],{"_4190":1131,"_34937":1099,"_23830":61589,"_5":16479,"_31422":61508,"_3630":61590},[],"Material crossing EST",{"_4190":1132,"_34937":1099,"_23830":61592,"_5":16479,"_31422":61508,"_3630":61593},[],"Device-generated key",{"_4190":1133,"_34937":1099,"_23830":61595,"_5":16479,"_31422":61508,"_3630":61596},[],"Public CSR and certificate; the key stays on the client.",{"_4190":1134,"_34937":1099,"_23830":61598,"_5":16479,"_31422":61508,"_3630":61599},[],"Existing device key",{"_4190":1135,"_34937":1099,"_23830":61601,"_5":16479,"_31422":61508,"_3630":61602},[],"CSR signed with that key and a new certificate.",{"_4190":1136,"_34937":1099,"_23830":61604,"_5":16479,"_31422":61508,"_3630":60870},[],{"_4190":1137,"_34937":1099,"_23830":61606,"_5":16479,"_31422":61508,"_3630":61607},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_4190":1138,"_34937":1099,"_23830":61609,"_5":16479,"_31422":61508,"_3630":61610},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_4190":1139,"_34937":1099,"_23830":61612,"_5":16479,"_31422":61512,"_3630":61613},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_4190":1140,"_34937":1140,"_5":16871,"_3630":61615,"_35372":61616,"_23830":61617,"_31422":1140},"Renewal and recovery",[58062,59537,60551,60549,60732],[],{"_4190":1141,"_34937":1140,"_23830":61619,"_5":16479,"_31422":1140,"_3630":61620},[],"Renew without losing the identity and recover devices according to their actual state.",{"_4190":1142,"_34937":1140,"_5":35369,"_23830":61622,"_31422":61623,"_3630":61624},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_4190":1143,"_34937":1140,"_5":35369,"_23830":61626,"_31422":61627,"_3630":61628},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_4190":1144,"_34937":1140,"_5":35369,"_23830":61630,"_31422":61631,"_3630":61632},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_4190":1145,"_34937":1140,"_5":35369,"_23830":61634,"_31422":61635,"_3630":61636},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_4190":1146,"_34937":1140,"_5":35369,"_23830":61638,"_31422":61639,"_3630":61640},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_4190":1147,"_34937":1140,"_23830":61642,"_5":16479,"_31422":1140,"_3630":61643},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_4190":1148,"_34937":1140,"_23830":61645,"_5":16479,"_31422":61623,"_3630":61646},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_4190":1149,"_34937":1140,"_23830":61648,"_5":16479,"_31422":61623,"_3630":61649},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_4190":1150,"_34937":1140,"_23830":61651,"_5":16479,"_31422":61623,"_3630":61652},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_4190":1151,"_34937":1140,"_23830":61654,"_5":16479,"_31422":61623,"_3630":61655},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_4190":1152,"_34937":1140,"_23830":61657,"_5":16479,"_31422":61627,"_3630":61658},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_4190":1153,"_34937":1140,"_23830":61660,"_5":16479,"_31422":61627,"_3630":61661},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_4190":1154,"_34937":1140,"_23830":61663,"_5":16479,"_31422":61631,"_3630":61664},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_4190":1155,"_34937":1140,"_23830":61666,"_5":16479,"_31422":61631,"_3630":61667},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_4190":1156,"_34937":1140,"_23830":61669,"_5":16479,"_31422":61631,"_3630":61670},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_4190":1157,"_34937":1140,"_23830":61672,"_5":16479,"_31422":61635,"_3630":61673},[],"Situation",{"_4190":1158,"_34937":1140,"_23830":61675,"_5":16479,"_31422":61635,"_3630":61676},[],"Procedure",{"_4190":1159,"_34937":1140,"_23830":61678,"_5":16479,"_31422":61635,"_3630":61679},[],"Valid certificate, outside the window",{"_4190":1160,"_34937":1140,"_23830":61681,"_5":16479,"_31422":61635,"_3630":61682},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_4190":1161,"_34937":1140,"_23830":61684,"_5":16479,"_31422":61635,"_3630":61685},[],"Expired certificate, key available",{"_4190":1162,"_34937":1140,"_23830":61687,"_5":16479,"_31422":61635,"_3630":61688},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_4190":1163,"_34937":1140,"_23830":61690,"_5":16479,"_31422":61635,"_3630":61691},[],"Renewal through webhook or `NO_AUTH`",{"_4190":1164,"_34937":1140,"_23830":61693,"_5":16479,"_31422":61635,"_3630":61694},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_4190":1165,"_34937":1140,"_23830":61696,"_5":16479,"_31422":61635,"_3630":61697},[],"Lost or inaccessible key",{"_4190":1166,"_34937":1140,"_23830":61699,"_5":16479,"_31422":61635,"_3630":61700},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_4190":1167,"_34937":1140,"_23830":61702,"_5":16479,"_31422":61635,"_3630":61703},[],"Current identity revoked",{"_4190":1168,"_34937":1140,"_23830":61705,"_5":16479,"_31422":61635,"_3630":61706},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_4190":1169,"_34937":1140,"_23830":61708,"_5":16479,"_31422":61635,"_3630":61709},[],"Device without an identity",{"_4190":1170,"_34937":1140,"_23830":61711,"_5":16479,"_31422":61635,"_3630":61712},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_4190":1171,"_34937":1140,"_23830":61714,"_5":16479,"_31422":61635,"_3630":61715},[],"Retired device",{"_4190":1172,"_34937":1140,"_23830":61717,"_5":16479,"_31422":61635,"_3630":61718},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_4190":1173,"_34937":1140,"_23830":61720,"_5":16479,"_31422":61635,"_3630":61721},[],"Timeout, HTTP 500 or installation failure",{"_4190":1174,"_34937":1140,"_23830":61723,"_5":16479,"_31422":61635,"_3630":61724},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_4190":1175,"_34937":1140,"_23830":61726,"_5":16479,"_31422":61639,"_3630":61727},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_4190":1176,"_34937":1140,"_23830":61729,"_5":16479,"_31422":61639,"_3630":61730},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_4190":1177,"_34937":1177,"_5":16871,"_3630":61732,"_35372":61733,"_23830":61734,"_31422":1177},"Enrollment troubleshooting",[58062,59537,60551,60549,60732],[],{"_4190":1178,"_34937":1177,"_23830":61736,"_5":16479,"_31422":1177,"_3630":61737},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_4190":1179,"_34937":1177,"_5":35369,"_23830":61739,"_31422":61740,"_3630":61741},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_4190":1180,"_34937":1177,"_5":35369,"_23830":61743,"_31422":61744,"_3630":61745},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_4190":1181,"_34937":1177,"_5":35369,"_23830":61747,"_31422":61748,"_3630":61295},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_4190":1182,"_34937":1177,"_5":35369,"_23830":61750,"_31422":61751,"_3630":61752},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_4190":1183,"_34937":1177,"_23830":61754,"_5":16479,"_31422":1177,"_3630":61755},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_4190":1184,"_34937":1177,"_23830":61757,"_5":16479,"_31422":61744,"_3630":61758},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_4190":1185,"_34937":1177,"_23830":61760,"_5":16479,"_31422":61744,"_3630":61761},[],"Symptom or message",{"_4190":1186,"_34937":1177,"_23830":61763,"_5":16479,"_31422":61744,"_3630":61525},[],{"_4190":1187,"_34937":1177,"_23830":61765,"_5":16479,"_31422":61744,"_3630":61766},[],"curl rejects TLS, name or issuer",{"_4190":1188,"_34937":1177,"_23830":61768,"_5":16479,"_31422":61744,"_3630":61769},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_4190":1189,"_34937":1177,"_23830":61771,"_5":16479,"_31422":61744,"_3630":61772},[],"404 or missing APS",{"_4190":1190,"_34937":1177,"_23830":61774,"_5":16479,"_31422":61744,"_3630":61775},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_4190":1191,"_34937":1177,"_23830":61777,"_5":16479,"_31422":61744,"_3630":61778},[],"400, CSR or format error",{"_4190":1192,"_34937":1177,"_23830":61780,"_5":16479,"_31422":61744,"_3630":61781},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_4190":1193,"_34937":1177,"_23830":61783,"_5":16479,"_31422":61744,"_3630":61784},[],"Missing credential or invalid certificate",{"_4190":1194,"_34937":1177,"_23830":61786,"_5":16479,"_31422":61744,"_3630":61787},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_4190":1195,"_34937":1177,"_23830":61789,"_5":16479,"_31422":61744,"_3630":61790},[],"Webhook denies, times out or responds without authorization",{"_4190":1196,"_34937":1177,"_23830":61792,"_5":16479,"_31422":61744,"_3630":61793},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_4190":1197,"_34937":1177,"_23830":61795,"_5":16479,"_31422":61744,"_3630":61796},[],"`unexpected status code: <n>: redirects are not followed`",{"_4190":1198,"_34937":1177,"_23830":61798,"_5":16479,"_31422":61744,"_3630":61799},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_4190":1199,"_34937":1177,"_23830":61801,"_5":16479,"_31422":61744,"_3630":61802},[],"`webhook response exceeds 1048576 bytes`",{"_4190":1200,"_34937":1177,"_23830":61804,"_5":16479,"_31422":61744,"_3630":61805},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_4190":1201,"_34937":1177,"_23830":61807,"_5":16479,"_31422":61744,"_3630":61808},[],"`webhook config must not reference files`",{"_4190":1202,"_34937":1177,"_23830":61810,"_5":16479,"_31422":61744,"_3630":61811},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_4190":1203,"_34937":1177,"_23830":61813,"_5":16479,"_31422":61744,"_3630":61814},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_4190":1204,"_34937":1177,"_23830":61816,"_5":16479,"_31422":61744,"_3630":61817},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_4190":1205,"_34937":1177,"_23830":61819,"_5":16479,"_31422":61744,"_3630":61820},[],"`webhook mTLS certificate and key are invalid: …`",{"_4190":1206,"_34937":1177,"_23830":61822,"_5":16479,"_31422":61744,"_3630":61823},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_4190":1207,"_34937":1177,"_23830":61825,"_5":16479,"_31422":61744,"_3630":61826},[],"400 `struct validation error` creating or updating a DMS",{"_4190":1208,"_34937":1177,"_23830":61828,"_5":16479,"_31422":61744,"_3630":61829},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_4190":1209,"_34937":1177,"_23830":61831,"_5":16479,"_31422":61744,"_3630":61832},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_4190":1210,"_34937":1177,"_23830":61834,"_5":16479,"_31422":61744,"_3630":61835},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_4190":1211,"_34937":1177,"_23830":61837,"_5":16479,"_31422":61744,"_3630":61838},[],"`device not preregistered`",{"_4190":1212,"_34937":1177,"_23830":61840,"_5":16479,"_31422":61744,"_3630":61841},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_4190":1213,"_34937":1177,"_23830":61843,"_5":16479,"_31422":61744,"_3630":61844},[],"`forbiddenNewEnrollment`",{"_4190":1214,"_34937":1177,"_23830":61846,"_5":16479,"_31422":61744,"_3630":61847},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_4190":1215,"_34937":1177,"_23830":61849,"_5":16479,"_31422":61744,"_3630":61850},[],"Different owning DMS",{"_4190":1216,"_34937":1177,"_23830":61852,"_5":16479,"_31422":61744,"_3630":61853},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_4190":1217,"_34937":1177,"_23830":61855,"_5":16479,"_31422":61744,"_3630":61856},[],"`invalid RawSubject bytes`",{"_4190":1218,"_34937":1177,"_23830":61858,"_5":16479,"_31422":61744,"_3630":61859},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_4190":1219,"_34937":1177,"_23830":61861,"_5":16479,"_31422":61744,"_3630":61862},[],"`invalid reenroll window`",{"_4190":1220,"_34937":1177,"_23830":61864,"_5":16479,"_31422":61744,"_3630":61865},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_4190":1221,"_34937":1177,"_23830":61867,"_5":16479,"_31422":61744,"_3630":61868},[],"Current certificate revoked",{"_4190":1222,"_34937":1177,"_23830":61870,"_5":16479,"_31422":61744,"_3630":61871},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_4190":1223,"_34937":1177,"_23830":61873,"_5":16479,"_31422":61744,"_3630":61874},[],"CA, profile or signing error",{"_4190":1224,"_34937":1177,"_23830":61876,"_5":16479,"_31422":61744,"_3630":61877},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_4190":1225,"_34937":1177,"_23830":61879,"_5":16479,"_31422":61744,"_3630":61880},[],"HTTP 200 without a device connection",{"_4190":1226,"_34937":1177,"_23830":61882,"_5":16479,"_31422":61744,"_3630":61883},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_4190":1227,"_34937":1177,"_23830":61885,"_5":16479,"_31422":61744,"_3630":61886},[],"Timeout or error after issuance",{"_4190":1228,"_34937":1177,"_23830":61888,"_5":16479,"_31422":61744,"_3630":61889},[],"New certificates, current slot and previous identity's state before retrying.",{"_4190":1229,"_34937":1177,"_23830":61891,"_5":16479,"_31422":61748,"_3630":61892},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_4190":1230,"_34937":1177,"_23830":61894,"_5":16479,"_31422":61748,"_3630":61895},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_4190":1231,"_34937":1177,"_23830":61897,"_5":16479,"_31422":61751,"_3630":61898},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_4190":1232,"_34937":1177,"_23830":61900,"_5":16479,"_31422":61751,"_3630":61901},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_4190":1233,"_34937":1177,"_23830":61903,"_5":16479,"_31422":61751,"_3630":61904},[],"Verify the CSR locally and relate its CN to the inventory.",{"_4190":1234,"_34937":1177,"_23830":61906,"_5":16479,"_31422":61751,"_3630":61907},[],"Make one request, save headers/body and query the device and certificates.",{"_4190":1235,"_34937":1177,"_23830":61909,"_5":16479,"_31422":61751,"_3630":61910},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_4190":1236,"_34937":1177,"_23830":61912,"_5":16479,"_31422":61751,"_3630":61913},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_4190":1237,"_34937":1177,"_23830":61915,"_5":16479,"_31422":61751,"_3630":61916},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_4190":1238,"_34937":1238,"_5":16871,"_3630":61918,"_35372":61919,"_23830":61920,"_31422":1238},"Trust distribution and updates",[58062,59537,60551,60549,60732],[],{"_4190":1239,"_34937":1238,"_23830":61922,"_5":16479,"_31422":1238,"_3630":61923},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_4190":1240,"_34937":1238,"_5":35369,"_23830":61925,"_31422":61926,"_3630":61927},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_4190":1241,"_34937":1238,"_5":35369,"_23830":61929,"_31422":61930,"_3630":61931},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_4190":1242,"_34937":1238,"_5":35369,"_23830":61933,"_31422":61934,"_3630":61935},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_4190":1243,"_34937":1238,"_5":35369,"_23830":61937,"_31422":61938,"_3630":61939},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_4190":1244,"_34937":1238,"_5":35369,"_23830":61941,"_31422":61942,"_3630":61943},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_4190":1245,"_34937":1238,"_23830":61945,"_5":16479,"_31422":1238,"_3630":61946},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_4190":1246,"_34937":1238,"_23830":61948,"_5":16479,"_31422":61926,"_3630":61949},[],"Relationship",{"_4190":1247,"_34937":1238,"_23830":61951,"_5":16479,"_31422":61926,"_3630":61952},[],"Material prepared by its owner",{"_4190":1248,"_34937":1238,"_23830":61954,"_5":16479,"_31422":61926,"_3630":61955},[],"Device → EST server",{"_4190":1249,"_34937":1238,"_23830":61957,"_5":16479,"_31422":61926,"_3630":61958},[],"Previously verified server root, chain or pin and TLS name.",{"_4190":1250,"_34937":1238,"_23830":61960,"_5":16479,"_31422":61926,"_3630":61961},[],"DMS → requester",{"_4190":1251,"_34937":1238,"_23830":61963,"_5":16479,"_31422":61926,"_3630":61964},[],"CAs and rules authorizing initial or renewal credentials.",{"_4190":1252,"_34937":1238,"_23830":61966,"_5":16479,"_31422":61926,"_3630":61967},[],"Consumer → device",{"_4190":1253,"_34937":1238,"_23830":61969,"_5":16479,"_31422":61926,"_3630":61970},[],"Operational identity roots, intermediates, validation and permissions.",{"_4190":1254,"_34937":1238,"_23830":61972,"_5":16479,"_31422":61926,"_3630":61973},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_4190":1255,"_34937":1238,"_23830":61975,"_5":16479,"_31422":61930,"_3630":61976},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_4190":1256,"_34937":1238,"_23830":61978,"_5":16479,"_31422":61930,"_3630":61979},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_4190":1257,"_34937":1238,"_23830":61981,"_5":16479,"_31422":61934,"_3630":61982},[],"Keep initial EST server trust separate from identity consumer trust.",{"_4190":1258,"_34937":1238,"_23830":61984,"_5":16479,"_31422":61934,"_3630":61985},[],"Select policy-approved roots as anchors.",{"_4190":1259,"_34937":1238,"_23830":61987,"_5":16479,"_31422":61934,"_3630":61988},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_4190":1260,"_34937":1238,"_23830":61990,"_5":16479,"_31422":61934,"_3630":61991},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_4190":1261,"_34937":1238,"_23830":61993,"_5":16479,"_31422":61934,"_3630":61994},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_4190":1262,"_34937":1238,"_23830":61996,"_5":16479,"_31422":61934,"_3630":61997},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_4190":1263,"_34937":1238,"_23830":61999,"_5":16479,"_31422":61938,"_3630":62000},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_4190":1264,"_34937":1238,"_23830":62002,"_5":16479,"_31422":61938,"_3630":62003},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_4190":1265,"_34937":1238,"_23830":62005,"_5":16479,"_31422":61938,"_3630":62006},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_4190":1266,"_34937":1238,"_23830":62008,"_5":16479,"_31422":61942,"_3630":62009},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_4190":1267,"_34937":1267,"_5":16871,"_3630":62011,"_35372":62012,"_23830":62014,"_31422":1267},"AWS IoT Core",[58062,59537,60551,60549,62013],"Integrations",[],{"_4190":1268,"_34937":1267,"_23830":62016,"_5":16479,"_31422":1267,"_3630":62017},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_4190":1269,"_34937":1267,"_5":35369,"_23830":62019,"_31422":62020,"_3630":62021},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_4190":1270,"_34937":1267,"_5":35369,"_23830":62023,"_31422":62024,"_3630":62025},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_4190":1271,"_34937":1267,"_5":35369,"_23830":62027,"_31422":62028,"_3630":62029},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_4190":1272,"_34937":1267,"_5":35369,"_23830":62031,"_31422":62032,"_3630":62033},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_4190":1273,"_34937":1267,"_5":35369,"_23830":62035,"_31422":62036,"_3630":62037},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_4190":1274,"_34937":1267,"_5":35369,"_23830":62039,"_31422":62040,"_3630":62041},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_4190":1275,"_34937":1267,"_5":35369,"_23830":62043,"_31422":62044,"_3630":62045},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_4190":1276,"_34937":1267,"_5":35369,"_23830":62047,"_31422":62048,"_3630":62049},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_4190":1277,"_34937":1267,"_5":35369,"_23830":62051,"_31422":62052,"_3630":62053},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_4190":1278,"_34937":1267,"_5":35369,"_23830":62055,"_31422":62056,"_3630":62057},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_4190":1279,"_34937":1267,"_5":35369,"_23830":62059,"_31422":62060,"_3630":62061},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_4190":1280,"_34937":1267,"_5":35369,"_23830":62063,"_31422":62064,"_3630":62065},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_4190":1281,"_34937":1267,"_5":35369,"_23830":62067,"_31422":62068,"_3630":62069},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_4190":1282,"_34937":1267,"_5":35369,"_23830":62071,"_31422":62072,"_3630":62073},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_4190":1283,"_34937":1267,"_5":35369,"_23830":62075,"_31422":62076,"_3630":62077},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_4190":1284,"_34937":1267,"_5":35369,"_23830":62079,"_31422":62080,"_3630":62081},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_4190":1285,"_34937":1267,"_5":35369,"_23830":62083,"_31422":62084,"_3630":62085},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_4190":1286,"_34937":1267,"_5":35369,"_23830":62087,"_31422":62088,"_3630":62089},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_4190":1287,"_34937":1267,"_5":35369,"_23830":62091,"_31422":62092,"_3630":62093},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_4190":1288,"_34937":1267,"_5":35369,"_23830":62095,"_31422":62096,"_3630":62097},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_4190":1289,"_34937":1267,"_5":35369,"_23830":62099,"_31422":62100,"_3630":62101},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_4190":1290,"_34937":1267,"_5":35369,"_23830":62103,"_31422":62104,"_3630":62105},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_4190":1291,"_34937":1267,"_5":35369,"_23830":62107,"_31422":62108,"_3630":62109},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_4190":1292,"_34937":1267,"_5":35369,"_23830":62111,"_31422":62112,"_3630":62113},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_4190":1293,"_34937":1267,"_5":35369,"_23830":62115,"_31422":62116,"_3630":62117},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_4190":1294,"_34937":1267,"_23830":62119,"_5":16479,"_31422":1267,"_3630":62120},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_4190":1295,"_34937":1267,"_23830":62122,"_5":16479,"_31422":1267,"_3630":62123},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_4190":1296,"_34937":1267,"_23830":62125,"_5":16479,"_31422":1267,"_3630":62126},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_4190":1297,"_34937":1267,"_23830":62128,"_5":16479,"_31422":62020,"_3630":62129},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_4190":1298,"_34937":1267,"_23830":62131,"_5":16479,"_31422":62020,"_3630":62132},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_4190":1299,"_34937":1267,"_23830":62134,"_5":16479,"_31422":62020,"_3630":62135},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_4190":1300,"_34937":1267,"_23830":62137,"_5":16479,"_31422":62020,"_3630":62138},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_4190":1301,"_34937":1267,"_23830":62140,"_5":16479,"_31422":62024,"_3630":62141},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_4190":1302,"_34937":1267,"_23830":62143,"_5":16479,"_31422":62028,"_3630":62144},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_4190":1303,"_34937":1267,"_23830":62146,"_5":16479,"_31422":62028,"_3630":62147},[],"IAM action",{"_4190":1304,"_34937":1267,"_23830":62149,"_5":16479,"_31422":62028,"_3630":58452},[],{"_4190":1305,"_34937":1267,"_23830":62151,"_5":16479,"_31422":62028,"_3630":62152},[],"`iot:GetRegistrationCode`",{"_4190":1306,"_34937":1267,"_23830":62154,"_5":16479,"_31422":62028,"_3630":62155},[],"Obtain the verification code for CA registration in the Primary Account",{"_4190":1307,"_34937":1267,"_23830":62157,"_5":16479,"_31422":62028,"_3630":62158},[],"`iot:RegisterCACertificate`",{"_4190":1308,"_34937":1267,"_23830":62160,"_5":16479,"_31422":62028,"_3630":62161},[],"Register the CA in AWS IoT",{"_4190":1309,"_34937":1267,"_23830":62163,"_5":16479,"_31422":62028,"_3630":62164},[],"`iot:DescribeCACertificate`",{"_4190":1310,"_34937":1267,"_23830":62166,"_5":16479,"_31422":62028,"_3630":62167},[],"Check the CA registration status",{"_4190":1311,"_34937":1267,"_23830":62169,"_5":16479,"_31422":62028,"_3630":62170},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_4190":1312,"_34937":1267,"_23830":62172,"_5":16479,"_31422":62028,"_3630":62173},[],"Create or update Things in IoT Core",{"_4190":1313,"_34937":1267,"_23830":62175,"_5":16479,"_31422":62028,"_3630":62176},[],"`iot:RegisterThing`",{"_4190":1314,"_34937":1267,"_23830":62178,"_5":16479,"_31422":62028,"_3630":62179},[],"Provision Things through a template",{"_4190":1315,"_34937":1267,"_23830":62181,"_5":16479,"_31422":62028,"_3630":62182},[],"`iot:RegisterCertificate`",{"_4190":1316,"_34937":1267,"_23830":62184,"_5":16479,"_31422":62028,"_3630":62185},[],"Register device certificates",{"_4190":1317,"_34937":1267,"_23830":62187,"_5":16479,"_31422":62028,"_3630":62188},[],"`iot:UpdateCertificate`",{"_4190":1318,"_34937":1267,"_23830":62190,"_5":16479,"_31422":62028,"_3630":62191},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_4190":1319,"_34937":1267,"_23830":62193,"_5":16479,"_31422":62028,"_3630":62194},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_4190":1320,"_34937":1267,"_23830":62196,"_5":16479,"_31422":62028,"_3630":62197},[],"Create and attach IoT policies",{"_4190":1321,"_34937":1267,"_23830":62199,"_5":16479,"_31422":62028,"_3630":62200},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_4190":1322,"_34937":1267,"_23830":62202,"_5":16479,"_31422":62028,"_3630":62203},[],"Manage Thing groups",{"_4190":1323,"_34937":1267,"_23830":62205,"_5":16479,"_31422":62028,"_3630":62206},[],"`iot:CreateProvisioningTemplate`",{"_4190":1324,"_34937":1267,"_23830":62208,"_5":16479,"_31422":62028,"_3630":62209},[],"Create JITP templates",{"_4190":1325,"_34937":1267,"_23830":62211,"_5":16479,"_31422":62028,"_3630":62212},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_4190":1326,"_34937":1267,"_23830":62214,"_5":16479,"_31422":62028,"_3630":62215},[],"Read and write the Device Shadow",{"_4190":1327,"_34937":1267,"_23830":62217,"_5":16479,"_31422":62028,"_3630":62218},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_4190":1328,"_34937":1267,"_23830":62220,"_5":16479,"_31422":62032,"_3630":62221},[],"Parameter",{"_4190":1329,"_34937":1267,"_23830":62223,"_5":16479,"_31422":62032,"_3630":62224},[],"Type",{"_4190":1330,"_34937":1267,"_23830":62226,"_5":16479,"_31422":62032,"_3630":62227},[],"Required",{"_4190":1331,"_34937":1267,"_23830":62229,"_5":16479,"_31422":62032,"_3630":62230},[],"Description",{"_4190":1332,"_34937":1267,"_23830":62232,"_5":16479,"_31422":62032,"_3630":62233},[],"`connector_id`",{"_4190":1333,"_34937":1267,"_23830":62235,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1334,"_34937":1267,"_23830":62237,"_5":16479,"_31422":62032,"_3630":62238},[],"Yes",{"_4190":1335,"_34937":1267,"_23830":62240,"_5":16479,"_31422":62032,"_3630":62241},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_4190":1336,"_34937":1267,"_23830":62243,"_5":16479,"_31422":62032,"_3630":62244},[],"`aws_config.region`",{"_4190":1337,"_34937":1267,"_23830":62246,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1338,"_34937":1267,"_23830":62248,"_5":16479,"_31422":62032,"_3630":62238},[],{"_4190":1339,"_34937":1267,"_23830":62250,"_5":16479,"_31422":62032,"_3630":62251},[],"AWS region where the connector operates.",{"_4190":1340,"_34937":1267,"_23830":62253,"_5":16479,"_31422":62032,"_3630":62254},[],"`aws_config.auth_method`",{"_4190":1341,"_34937":1267,"_23830":62256,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1342,"_34937":1267,"_23830":62258,"_5":16479,"_31422":62032,"_3630":62238},[],{"_4190":1343,"_34937":1267,"_23830":62260,"_5":16479,"_31422":62032,"_3630":62261},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_4190":1344,"_34937":1267,"_23830":62263,"_5":16479,"_31422":62032,"_3630":62264},[],"`aws_config.access_key_id`",{"_4190":1345,"_34937":1267,"_23830":62266,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1346,"_34937":1267,"_23830":62268,"_5":16479,"_31422":62032,"_3630":62269},[],"Only with `auth_method=static`",{"_4190":1347,"_34937":1267,"_23830":62271,"_5":16479,"_31422":62032,"_3630":62272},[],"AWS access key.",{"_4190":1348,"_34937":1267,"_23830":62274,"_5":16479,"_31422":62032,"_3630":62275},[],"`aws_config.secret_access_key`",{"_4190":1349,"_34937":1267,"_23830":62277,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1350,"_34937":1267,"_23830":62279,"_5":16479,"_31422":62032,"_3630":62269},[],{"_4190":1351,"_34937":1267,"_23830":62281,"_5":16479,"_31422":62032,"_3630":62282},[],"AWS secret key.",{"_4190":1352,"_34937":1267,"_23830":62284,"_5":16479,"_31422":62032,"_3630":62285},[],"`aws_config.session_token`",{"_4190":1353,"_34937":1267,"_23830":62287,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1354,"_34937":1267,"_23830":62289,"_5":16479,"_31422":62032,"_3630":62290},[],"No",{"_4190":1355,"_34937":1267,"_23830":62292,"_5":16479,"_31422":62032,"_3630":62293},[],"Session token (with `auth_method=static`).",{"_4190":1356,"_34937":1267,"_23830":62295,"_5":16479,"_31422":62032,"_3630":62296},[],"`aws_config.role_arn`",{"_4190":1357,"_34937":1267,"_23830":62298,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1358,"_34937":1267,"_23830":62300,"_5":16479,"_31422":62032,"_3630":62301},[],"Only with `auth_method=role`",{"_4190":1359,"_34937":1267,"_23830":62303,"_5":16479,"_31422":62032,"_3630":62304},[],"ARN of the role to assume.",{"_4190":1360,"_34937":1267,"_23830":62306,"_5":16479,"_31422":62032,"_3630":62307},[],"`aws_config.endpoint_url`",{"_4190":1361,"_34937":1267,"_23830":62309,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1362,"_34937":1267,"_23830":62311,"_5":16479,"_31422":62032,"_3630":62290},[],{"_4190":1363,"_34937":1267,"_23830":62313,"_5":16479,"_31422":62032,"_3630":62314},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_4190":1364,"_34937":1267,"_23830":62316,"_5":16479,"_31422":62032,"_3630":62317},[],"`subscriber_event_bus`",{"_4190":1365,"_34937":1267,"_23830":62319,"_5":16479,"_31422":62032,"_3630":20102},[],{"_4190":1366,"_34937":1267,"_23830":62321,"_5":16479,"_31422":62032,"_3630":62238},[],{"_4190":1367,"_34937":1267,"_23830":62323,"_5":16479,"_31422":62032,"_3630":62324},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_4190":1368,"_34937":1267,"_23830":62326,"_5":16479,"_31422":62032,"_3630":62327},[],"`dms_manager_client`",{"_4190":1369,"_34937":1267,"_23830":62329,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1370,"_34937":1267,"_23830":62331,"_5":16479,"_31422":62032,"_3630":62238},[],{"_4190":1371,"_34937":1267,"_23830":62333,"_5":16479,"_31422":62032,"_3630":62334},[],"HTTP URL of Lamassu's DMS Manager service.",{"_4190":1372,"_34937":1267,"_23830":62336,"_5":16479,"_31422":62032,"_3630":62337},[],"`device_manager_client`",{"_4190":1373,"_34937":1267,"_23830":62339,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1374,"_34937":1267,"_23830":62341,"_5":16479,"_31422":62032,"_3630":62238},[],{"_4190":1375,"_34937":1267,"_23830":62343,"_5":16479,"_31422":62032,"_3630":62344},[],"HTTP URL of Lamassu's Device Manager.",{"_4190":1376,"_34937":1267,"_23830":62346,"_5":16479,"_31422":62032,"_3630":62347},[],"`ca_client`",{"_4190":1377,"_34937":1267,"_23830":62349,"_5":16479,"_31422":62032,"_3630":28524},[],{"_4190":1378,"_34937":1267,"_23830":62351,"_5":16479,"_31422":62032,"_3630":62238},[],{"_4190":1379,"_34937":1267,"_23830":62353,"_5":16479,"_31422":62032,"_3630":62354},[],"HTTP URL of Lamassu's CA service.",{"_4190":1380,"_34937":1267,"_23830":62356,"_5":16479,"_31422":62036,"_3630":62357},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_4190":1381,"_34937":1267,"_23830":62359,"_5":16479,"_31422":62036,"_3630":62360},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_4190":1382,"_34937":1267,"_23830":62362,"_5":16479,"_31422":62036,"_3630":62363},[],"CloudEvent type",{"_4190":1383,"_34937":1267,"_23830":62365,"_5":16479,"_31422":62036,"_3630":62366},[],"Lamassu resource",{"_4190":1384,"_34937":1267,"_23830":62368,"_5":16479,"_31422":62036,"_3630":62369},[],"AWS Resource",{"_4190":1385,"_34937":1267,"_23830":62371,"_5":16479,"_31422":62036,"_3630":62372},[],"IAM actions",{"_4190":1386,"_34937":1267,"_23830":62374,"_5":16479,"_31422":62036,"_3630":62375},[],"AWS calls and effect",{"_4190":1387,"_34937":1267,"_23830":62377,"_5":16479,"_31422":62036,"_3630":62378},[],"Where in this page",{"_4190":1388,"_34937":1267,"_23830":62380,"_5":16479,"_31422":62036,"_3630":62381},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_4190":1389,"_34937":1267,"_23830":62383,"_5":16479,"_31422":62036,"_3630":62384},[],"CA",{"_4190":1390,"_34937":1267,"_23830":62386,"_5":16479,"_31422":62036,"_3630":62387},[],"`IoTCore/CACertificate`",{"_4190":1391,"_34937":1267,"_23830":62389,"_5":16479,"_31422":62036,"_3630":62390},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_4190":1392,"_34937":1267,"_23830":62392,"_5":16479,"_31422":62036,"_3630":62393},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_4190":1393,"_34937":1267,"_23830":62395,"_5":16479,"_31422":62036,"_3630":62049},[],{"_4190":1394,"_34937":1267,"_23830":62397,"_5":16479,"_31422":62036,"_3630":62398},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_4190":1395,"_34937":1267,"_23830":62400,"_5":16479,"_31422":62036,"_3630":62401},[],"DMS",{"_4190":1396,"_34937":1267,"_23830":62403,"_5":16479,"_31422":62036,"_3630":62404},[],"`IoTCore/ProvisioningTemplate`",{"_4190":1397,"_34937":1267,"_23830":62406,"_5":16479,"_31422":62036,"_3630":62407},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_4190":1398,"_34937":1267,"_23830":62409,"_5":16479,"_31422":62036,"_3630":62410},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_4190":1399,"_34937":1267,"_23830":62412,"_5":16479,"_31422":62036,"_3630":62077},[],{"_4190":1400,"_34937":1267,"_23830":62414,"_5":16479,"_31422":62036,"_3630":62415},[],"`EventBindDeviceIdentityKey`",{"_4190":1401,"_34937":1267,"_23830":62417,"_5":16479,"_31422":62036,"_3630":62418},[],"Device",{"_4190":1402,"_34937":1267,"_23830":62420,"_5":16479,"_31422":62036,"_3630":62421},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_4190":1403,"_34937":1267,"_23830":62423,"_5":16479,"_31422":62036,"_3630":62424},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_4190":1404,"_34937":1267,"_23830":62426,"_5":16479,"_31422":62036,"_3630":62427},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_4190":1405,"_34937":1267,"_23830":62429,"_5":16479,"_31422":62036,"_3630":62085},[],{"_4190":1406,"_34937":1267,"_23830":62431,"_5":16479,"_31422":62036,"_3630":62432},[],"`EventUpdateCertificateStatusKey`",{"_4190":1407,"_34937":1267,"_23830":62434,"_5":16479,"_31422":62036,"_3630":62435},[],"Certificate",{"_4190":1408,"_34937":1267,"_23830":62437,"_5":16479,"_31422":62036,"_3630":62438},[],"`IoTCore/Certificate`",{"_4190":1409,"_34937":1267,"_23830":62440,"_5":16479,"_31422":62036,"_3630":62441},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_4190":1410,"_34937":1267,"_23830":62443,"_5":16479,"_31422":62036,"_3630":62444},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_4190":1411,"_34937":1267,"_23830":62446,"_5":16479,"_31422":62036,"_3630":62097},[],{"_4190":1412,"_34937":1267,"_23830":62448,"_5":16479,"_31422":62036,"_3630":62449},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_4190":1413,"_34937":1267,"_23830":62451,"_5":16479,"_31422":62036,"_3630":62452},[],"Certificate / Device",{"_4190":1414,"_34937":1267,"_23830":62454,"_5":16479,"_31422":62036,"_3630":62455},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_4190":1415,"_34937":1267,"_23830":62457,"_5":16479,"_31422":62036,"_3630":58458},[],{"_4190":1416,"_34937":1267,"_23830":62459,"_5":16479,"_31422":62036,"_3630":62460},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_4190":1417,"_34937":1267,"_23830":62462,"_5":16479,"_31422":62036,"_3630":62105},[],{"_4190":1418,"_34937":1267,"_23830":62464,"_5":16479,"_31422":62040,"_3630":62465},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_4190":1419,"_34937":1267,"_23830":62467,"_5":16479,"_31422":62044,"_3630":62468},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_4190":1420,"_34937":1267,"_23830":62470,"_5":16479,"_31422":62044,"_3630":62471},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_4190":1421,"_34937":1267,"_23830":62473,"_5":16479,"_31422":62048,"_3630":62474},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_4190":1422,"_34937":1267,"_23830":62476,"_5":16479,"_31422":62048,"_3630":62477},[],"Transition",{"_4190":1423,"_34937":1267,"_23830":62479,"_5":16479,"_31422":62048,"_3630":62480},[],"AWS calls",{"_4190":1424,"_34937":1267,"_23830":62482,"_5":16479,"_31422":62048,"_3630":62483},[],"`NotRegistered` → `Requested`",{"_4190":1425,"_34937":1267,"_23830":62485,"_5":16479,"_31422":62048,"_3630":62486},[],"none (metadata write only)",{"_4190":1426,"_34937":1267,"_23830":62488,"_5":16479,"_31422":62048,"_3630":62489},[],"`Requested` → `Registering`",{"_4190":1427,"_34937":1267,"_23830":62491,"_5":16479,"_31422":62048,"_3630":62492},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_4190":1428,"_34937":1267,"_23830":62494,"_5":16479,"_31422":62048,"_3630":62495},[],"`Registering` → `Succeeded`",{"_4190":1429,"_34937":1267,"_23830":62497,"_5":16479,"_31422":62048,"_3630":62498},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_4190":1430,"_34937":1267,"_23830":62500,"_5":16479,"_31422":62048,"_3630":62501},[],"`Registering` → `Failed`",{"_4190":1431,"_34937":1267,"_23830":62503,"_5":16479,"_31422":62048,"_3630":62504},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_4190":1432,"_34937":1267,"_23830":62506,"_5":16479,"_31422":62048,"_3630":62507},[],"`Failed` / `Succeeded` → `Requested`",{"_4190":1433,"_34937":1267,"_23830":62509,"_5":16479,"_31422":62048,"_3630":62510},[],"none (a new `REQUESTED` write re-runs the flow)",{"_4190":1434,"_34937":1267,"_23830":62512,"_5":16479,"_31422":62052,"_3630":62513},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_4190":1435,"_34937":1267,"_23830":62515,"_5":16479,"_31422":62052,"_3630":62516},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_4190":1436,"_34937":1267,"_23830":62518,"_5":16479,"_31422":62052,"_3630":62519},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_4190":1437,"_34937":1267,"_23830":62521,"_5":16479,"_31422":62052,"_3630":62522},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_4190":1438,"_34937":1267,"_23830":62524,"_5":16479,"_31422":62052,"_3630":62525},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_4190":1439,"_34937":1267,"_23830":62527,"_5":16479,"_31422":62052,"_3630":62528},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_4190":1440,"_34937":1267,"_23830":62530,"_5":16479,"_31422":62056,"_3630":62531},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_4190":1441,"_34937":1267,"_23830":62533,"_5":16479,"_31422":62060,"_3630":62534},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_4190":1442,"_34937":1267,"_23830":62536,"_5":16479,"_31422":62060,"_3630":62537},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_4190":1443,"_34937":1267,"_23830":62539,"_5":16479,"_31422":62064,"_3630":62540},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_4190":1444,"_34937":1267,"_23830":62542,"_5":16479,"_31422":62068,"_3630":62543},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_4190":1445,"_34937":1267,"_23830":62545,"_5":16479,"_31422":62068,"_3630":62546},[],"Creates or updates the IoT policies configured in the DMS.",{"_4190":1446,"_34937":1267,"_23830":62548,"_5":16479,"_31422":62068,"_3630":62549},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_4190":1447,"_34937":1267,"_23830":62551,"_5":16479,"_31422":62068,"_3630":62552},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_4190":1448,"_34937":1267,"_23830":62554,"_5":16479,"_31422":62068,"_3630":62555},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_4190":1449,"_34937":1267,"_23830":62557,"_5":16479,"_31422":62068,"_3630":62558},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_4190":1450,"_34937":1267,"_23830":62560,"_5":16479,"_31422":62068,"_3630":62561},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_4190":1451,"_34937":1267,"_23830":62563,"_5":16479,"_31422":62072,"_3630":62564},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_4190":1452,"_34937":1267,"_23830":62566,"_5":16479,"_31422":62072,"_3630":62567},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_4190":1453,"_34937":1267,"_23830":62569,"_5":16479,"_31422":62072,"_3630":62570},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_4190":1454,"_34937":1267,"_23830":62572,"_5":16479,"_31422":62072,"_3630":62573},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_4190":1455,"_34937":1267,"_23830":62575,"_5":16479,"_31422":62072,"_3630":62576},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_4190":1456,"_34937":1267,"_23830":62578,"_5":16479,"_31422":62076,"_3630":62579},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_4190":1457,"_34937":1267,"_23830":62581,"_5":16479,"_31422":62076,"_3630":62477},[],{"_4190":1458,"_34937":1267,"_23830":62583,"_5":16479,"_31422":62076,"_3630":62480},[],{"_4190":1459,"_34937":1267,"_23830":62585,"_5":16479,"_31422":62076,"_3630":62586},[],"`Unconfigured` → `None` / `Auto`",{"_4190":1460,"_34937":1267,"_23830":62588,"_5":16479,"_31422":62076,"_3630":62589},[],"none (configuration only)",{"_4190":1461,"_34937":1267,"_23830":62591,"_5":16479,"_31422":62076,"_3630":62592},[],"`None` ↔ `Auto`",{"_4190":1462,"_34937":1267,"_23830":62594,"_5":16479,"_31422":62076,"_3630":62589},[],{"_4190":1463,"_34937":1267,"_23830":62596,"_5":16479,"_31422":62076,"_3630":62597},[],"Any → `Jitp`",{"_4190":1464,"_34937":1267,"_23830":62599,"_5":16479,"_31422":62076,"_3630":62600},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_4190":1465,"_34937":1267,"_23830":62602,"_5":16479,"_31422":62076,"_3630":62603},[],"`Jitp` → `None` / `Auto`",{"_4190":1466,"_34937":1267,"_23830":62605,"_5":16479,"_31422":62076,"_3630":62606},[],"none (the template stays in the AWS account)",{"_4190":1467,"_34937":1267,"_23830":62608,"_5":16479,"_31422":62080,"_3630":62609},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_4190":1468,"_34937":1267,"_23830":62611,"_5":16479,"_31422":62080,"_3630":62612},[],"The full flow from the device's perspective is:",{"_4190":1469,"_34937":1267,"_23830":62614,"_5":16479,"_31422":62080,"_3630":62615},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_4190":1470,"_34937":1267,"_23830":62617,"_5":16479,"_31422":62084,"_3630":62618},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_4190":1471,"_34937":1267,"_23830":62620,"_5":16479,"_31422":62084,"_3630":62477},[],{"_4190":1472,"_34937":1267,"_23830":62622,"_5":16479,"_31422":62084,"_3630":62480},[],{"_4190":1473,"_34937":1267,"_23830":62624,"_5":16479,"_31422":62084,"_3630":62625},[],"`Absent` → `Provisioned`",{"_4190":1474,"_34937":1267,"_23830":62627,"_5":16479,"_31422":62084,"_3630":62628},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_4190":1475,"_34937":1267,"_23830":62630,"_5":16479,"_31422":62084,"_3630":62631},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_4190":1476,"_34937":1267,"_23830":62633,"_5":16479,"_31422":62084,"_3630":62634},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_4190":1477,"_34937":1267,"_23830":62636,"_5":16479,"_31422":62084,"_3630":62637},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_4190":1478,"_34937":1267,"_23830":62639,"_5":16479,"_31422":62088,"_3630":62640},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_4190":1479,"_34937":1267,"_23830":62642,"_5":16479,"_31422":62088,"_3630":62643},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_4190":1480,"_34937":1267,"_23830":62645,"_5":16479,"_31422":62088,"_3630":62646},[],"For the JITP flow to work correctly:",{"_4190":1481,"_34937":1267,"_23830":62648,"_5":16479,"_31422":62088,"_3630":62649},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_4190":1482,"_34937":1267,"_23830":62651,"_5":16479,"_31422":62088,"_3630":62652},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_4190":1483,"_34937":1267,"_23830":62654,"_5":16479,"_31422":62088,"_3630":62655},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_4190":1484,"_34937":1267,"_23830":62657,"_5":16479,"_31422":62088,"_3630":62658},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_4190":1485,"_34937":1267,"_23830":62660,"_5":16479,"_31422":62092,"_3630":62661},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_4190":1486,"_34937":1267,"_23830":62663,"_5":16479,"_31422":62092,"_3630":62664},[],"Status in Lamassu",{"_4190":1487,"_34937":1267,"_23830":62666,"_5":16479,"_31422":62092,"_3630":62667},[],"Revocation reason",{"_4190":1488,"_34937":1267,"_23830":62669,"_5":16479,"_31422":62092,"_3630":62670},[],"Status in AWS IoT Core",{"_4190":1489,"_34937":1267,"_23830":62672,"_5":16479,"_31422":62092,"_3630":62673},[],"`Active`",{"_4190":1490,"_34937":1267,"_23830":62675,"_5":16479,"_31422":62092,"_3630":62676},[],"None",{"_4190":1491,"_34937":1267,"_23830":62678,"_5":16479,"_31422":62092,"_3630":62679},[],"`ACTIVE`",{"_4190":1492,"_34937":1267,"_23830":62681,"_5":16479,"_31422":62092,"_3630":62682},[],"`Revoked`",{"_4190":1493,"_34937":1267,"_23830":62684,"_5":16479,"_31422":62092,"_3630":62685},[],"`certificateHold`",{"_4190":1494,"_34937":1267,"_23830":62687,"_5":16479,"_31422":62092,"_3630":62688},[],"`INACTIVE`",{"_4190":1495,"_34937":1267,"_23830":62690,"_5":16479,"_31422":62092,"_3630":62682},[],{"_4190":1496,"_34937":1267,"_23830":62692,"_5":16479,"_31422":62092,"_3630":62693},[],"Any other reason",{"_4190":1497,"_34937":1267,"_23830":62695,"_5":16479,"_31422":62092,"_3630":62696},[],"`REVOKED`",{"_4190":1498,"_34937":1267,"_23830":62698,"_5":16479,"_31422":62092,"_3630":62699},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_4190":1499,"_34937":1267,"_23830":62701,"_5":16479,"_31422":62096,"_3630":62702},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_4190":1500,"_34937":1267,"_23830":62704,"_5":16479,"_31422":62096,"_3630":62477},[],{"_4190":1501,"_34937":1267,"_23830":62706,"_5":16479,"_31422":62096,"_3630":62480},[],{"_4190":1502,"_34937":1267,"_23830":62708,"_5":16479,"_31422":62096,"_3630":62709},[],"`NotSynced` → `Active`",{"_4190":1503,"_34937":1267,"_23830":62711,"_5":16479,"_31422":62096,"_3630":62188},[],{"_4190":1504,"_34937":1267,"_23830":62713,"_5":16479,"_31422":62096,"_3630":62714},[],"`Active` → `Inactive`",{"_4190":1505,"_34937":1267,"_23830":62716,"_5":16479,"_31422":62096,"_3630":62717},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_4190":1506,"_34937":1267,"_23830":62719,"_5":16479,"_31422":62096,"_3630":62720},[],"`Active` → `Revoked`",{"_4190":1507,"_34937":1267,"_23830":62722,"_5":16479,"_31422":62096,"_3630":62717},[],{"_4190":1508,"_34937":1267,"_23830":62724,"_5":16479,"_31422":62096,"_3630":62725},[],"`Inactive` / `Revoked` → `Active`",{"_4190":1509,"_34937":1267,"_23830":62727,"_5":16479,"_31422":62096,"_3630":62188},[],{"_4190":1510,"_34937":1267,"_23830":62729,"_5":16479,"_31422":62096,"_3630":62730},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_4190":1511,"_34937":1267,"_23830":62732,"_5":16479,"_31422":62096,"_3630":62733},[],"none (these states are not synced to AWS)",{"_4190":1512,"_34937":1267,"_23830":62735,"_5":16479,"_31422":62100,"_3630":62736},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_4190":1513,"_34937":1267,"_23830":62738,"_5":16479,"_31422":62100,"_3630":62739},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_4190":1514,"_34937":1267,"_23830":62741,"_5":16479,"_31422":62100,"_3630":62742},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_4190":1515,"_34937":1267,"_23830":62744,"_5":16479,"_31422":62104,"_3630":62745},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_4190":1516,"_34937":1267,"_23830":62747,"_5":16479,"_31422":62104,"_3630":62748},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_4190":1517,"_34937":1267,"_23830":62750,"_5":16479,"_31422":62108,"_3630":62751},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_4190":1518,"_34937":1267,"_23830":62753,"_5":16479,"_31422":62108,"_3630":62754},[],"There are two action types:",{"_4190":1519,"_34937":1267,"_23830":62756,"_5":16479,"_31422":62108,"_3630":62757},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_4190":1520,"_34937":1267,"_23830":62759,"_5":16479,"_31422":62108,"_3630":62760},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_4190":1521,"_34937":1267,"_23830":62762,"_5":16479,"_31422":62108,"_3630":62763},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_4190":1522,"_34937":1267,"_23830":62765,"_5":16479,"_31422":62112,"_3630":62766},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_4190":1523,"_34937":1267,"_23830":62768,"_5":16479,"_31422":62112,"_3630":62769},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_4190":1524,"_34937":1267,"_23830":62771,"_5":16479,"_31422":62112,"_3630":62772},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_4190":1525,"_34937":1267,"_23830":62774,"_5":16479,"_31422":62116,"_3630":62775},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_4190":1526,"_34937":1267,"_23830":62777,"_5":16479,"_31422":62116,"_3630":62778},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_4190":1527,"_34937":1267,"_23830":62780,"_5":16479,"_31422":62116,"_3630":62781},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_4190":1528,"_34937":1267,"_23830":62783,"_5":16479,"_31422":62116,"_3630":62784},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_4190":1529,"_34937":1267,"_23830":62786,"_5":16479,"_31422":62116,"_3630":62787},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_4190":1530,"_34937":1267,"_23830":62789,"_5":16479,"_31422":62116,"_3630":62790},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_4190":1531,"_34937":1267,"_23830":62792,"_5":16479,"_31422":62116,"_3630":62793},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_4190":1532,"_34937":1267,"_23830":62795,"_5":16479,"_31422":62116,"_3630":62796},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_4190":1533,"_34937":1267,"_23830":62798,"_5":16479,"_31422":62116,"_3630":62799},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_4190":1534,"_34937":1267,"_23830":62801,"_5":16479,"_31422":62116,"_3630":62802},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_4190":1535,"_34937":1267,"_23830":62804,"_5":16479,"_31422":62116,"_3630":62805},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_4190":1536,"_34937":1267,"_23830":62807,"_5":16479,"_31422":62116,"_3630":62808},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_4190":1537,"_34937":1267,"_23830":62810,"_5":16479,"_31422":62116,"_3630":62811},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_4190":1538,"_34937":1267,"_23830":62813,"_5":16479,"_31422":62116,"_3630":62814},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_4190":1539,"_34937":1267,"_23830":62816,"_5":16479,"_31422":62116,"_3630":62817},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_4190":1540,"_34937":1267,"_23830":62819,"_5":16479,"_31422":62116,"_3630":62820},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_4190":1541,"_34937":1267,"_23830":62822,"_5":16479,"_31422":62116,"_3630":62823},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_4190":1542,"_34937":1267,"_23830":62825,"_5":16479,"_31422":62116,"_3630":62826},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_4190":1543,"_34937":1267,"_23830":62828,"_5":16479,"_31422":62116,"_3630":62829},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_4190":1544,"_34937":1267,"_23830":62831,"_5":16479,"_31422":62116,"_3630":62832},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_4190":1545,"_34937":1267,"_23830":62834,"_5":16479,"_31422":62116,"_3630":62835},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_4190":1546,"_34937":1267,"_23830":62837,"_5":16479,"_31422":62116,"_3630":62838},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4190":1547,"_34937":1267,"_23830":62840,"_5":16479,"_31422":62116,"_3630":62841},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_4190":1548,"_34937":1267,"_23830":62843,"_5":16479,"_31422":62116,"_3630":62844},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_4190":1549,"_34937":1549,"_5":16871,"_3630":60551,"_35372":62846,"_23830":62847,"_31422":1549},[58062,59537,60551],[],{"_4190":1550,"_34937":1549,"_23830":62849,"_5":16479,"_31422":1549,"_3630":62850},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_4190":1551,"_34937":1549,"_5":35369,"_23830":62852,"_31422":62853,"_3630":62854},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#start-here","Start here",{"_4190":1552,"_34937":1549,"_5":35369,"_23830":62856,"_31422":62857,"_3630":60549},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#devices-and-identities",{"_4190":1553,"_34937":1549,"_5":35369,"_23830":62859,"_31422":62860,"_3630":60732},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#enrollment-with-pki",{"_4190":1554,"_34937":1549,"_5":35369,"_23830":62862,"_31422":62863,"_3630":62013},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#integrations",{"_4190":1555,"_34937":1549,"_5":35369,"_23830":62865,"_31422":62866,"_3630":62867},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_4190":1556,"_34937":1549,"_23830":62869,"_5":16479,"_31422":1549,"_3630":62870},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_4190":1557,"_34937":1549,"_23830":62872,"_5":16479,"_31422":62853,"_3630":62873},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_4190":1558,"_34937":1549,"_23830":62875,"_5":16479,"_31422":62853,"_3630":62876},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_4190":1559,"_34937":1549,"_23830":62878,"_5":16479,"_31422":62857,"_3630":62879},[],"Resource",{"_4190":1560,"_34937":1549,"_23830":62881,"_5":16479,"_31422":62857,"_3630":62882},[],"What it represents",{"_4190":1561,"_34937":1549,"_23830":62884,"_5":16479,"_31422":62857,"_3630":62885},[],"**Device**",{"_4190":1562,"_34937":1549,"_23830":62887,"_5":16479,"_31422":62857,"_3630":62888},[],"An inventory entry with an identifier, owning DMS and classification.",{"_4190":1563,"_34937":1549,"_23830":62890,"_5":16479,"_31422":62857,"_3630":62891},[],"**Identity**",{"_4190":1564,"_34937":1549,"_23830":62893,"_5":16479,"_31422":62857,"_3630":62894},[],"The device's association with its certificates: an active version and a history.",{"_4190":1565,"_34937":1549,"_23830":62896,"_5":16479,"_31422":62857,"_3630":62897},[],"**DMS**",{"_4190":1566,"_34937":1549,"_23830":62899,"_5":16479,"_31422":62857,"_3630":62900},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_4190":1567,"_34937":1549,"_23830":62902,"_5":16479,"_31422":62857,"_3630":62903},[],"**Fleet**",{"_4190":1568,"_34937":1549,"_23830":62905,"_5":16479,"_31422":62857,"_3630":62906},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_4190":1569,"_34937":1549,"_23830":62908,"_5":16479,"_31422":62857,"_3630":62909},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_4190":1570,"_34937":1549,"_23830":62911,"_5":16479,"_31422":62857,"_3630":62912},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_4190":1571,"_34937":1549,"_23830":62914,"_5":16479,"_31422":62860,"_3630":62915},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_4190":1572,"_34937":1549,"_23830":62917,"_5":16479,"_31422":62860,"_3630":62918},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_4190":1573,"_34937":1549,"_23830":62920,"_5":16479,"_31422":62860,"_3630":62921},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_4190":1574,"_34937":1549,"_23830":62923,"_5":16479,"_31422":62860,"_3630":62924},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_4190":1575,"_34937":1549,"_23830":62926,"_5":16479,"_31422":62860,"_3630":62927},[],"**Result:** request the certificate, install it and check its association with the device.",{"_4190":1576,"_34937":1549,"_23830":62929,"_5":16479,"_31422":62860,"_3630":62930},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_4190":1577,"_34937":1549,"_23830":62932,"_5":16479,"_31422":62860,"_3630":62933},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4190":1578,"_34937":1549,"_23830":62935,"_5":16479,"_31422":62860,"_3630":62936},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4190":1579,"_34937":1549,"_23830":62938,"_5":16479,"_31422":62863,"_3630":62939},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_4190":1580,"_34937":1549,"_23830":62941,"_5":16479,"_31422":62863,"_3630":62942},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_4190":1581,"_34937":1549,"_23830":62944,"_5":16479,"_31422":62866,"_3630":62945},[],"Participant",{"_4190":1582,"_34937":1549,"_23830":62947,"_5":16479,"_31422":62866,"_3630":62948},[],"Responsibility",{"_4190":1583,"_34937":1549,"_23830":62950,"_5":16479,"_31422":62866,"_3630":62951},[],"PKI administrator",{"_4190":1584,"_34937":1549,"_23830":62953,"_5":16479,"_31422":62866,"_3630":62954},[],"CA, issuance profile, chain and revocation publication.",{"_4190":1585,"_34937":1549,"_23830":62956,"_5":16479,"_31422":62866,"_3630":62957},[],"Provisioning administrator",{"_4190":1586,"_34937":1549,"_23830":62959,"_5":16479,"_31422":62866,"_3630":62960},[],"DMS, admission, authentication per operation and inventory.",{"_4190":1587,"_34937":1549,"_23830":62962,"_5":16479,"_31422":62866,"_3630":62963},[],"Device integrator",{"_4190":1588,"_34937":1549,"_23830":62965,"_5":16479,"_31422":62866,"_3630":62966},[],"Initial credential, key, EST client, trust and certificate installation.",{"_4190":1589,"_34937":1549,"_23830":62968,"_5":16479,"_31422":62866,"_3630":62969},[],"Consumer integrator",{"_4190":1590,"_34937":1549,"_23830":62971,"_5":16479,"_31422":62866,"_3630":62972},[],"Trusted issuers, validation and device permissions in the destination.",{"_4190":1591,"_34937":1549,"_23830":62974,"_5":16479,"_31422":62866,"_3630":62975},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_4190":1592,"_34937":1592,"_5":16871,"_3630":62977,"_35372":62978,"_23830":62980,"_31422":1592},"Enroll and connect your first device",[58062,59537,60551,62979],"Getting started",[],{"_4190":1593,"_34937":1592,"_23830":62982,"_5":16479,"_31422":1592,"_3630":62983},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_4190":1594,"_34937":1592,"_5":35369,"_23830":62985,"_31422":62986,"_3630":58072},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_4190":1595,"_34937":1592,"_5":35369,"_23830":62988,"_31422":62989,"_3630":62990},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_4190":1596,"_34937":1592,"_5":35369,"_23830":62992,"_31422":62993,"_3630":62994},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_4190":1597,"_34937":1592,"_5":35369,"_23830":62996,"_31422":62997,"_3630":62998},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_4190":1598,"_34937":1592,"_5":35369,"_23830":63000,"_31422":63001,"_3630":63002},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_4190":1599,"_34937":1592,"_5":35369,"_23830":63004,"_31422":63005,"_3630":63006},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_4190":1600,"_34937":1592,"_5":35369,"_23830":63008,"_31422":63009,"_3630":63010},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_4190":1601,"_34937":1592,"_5":35369,"_23830":63012,"_31422":63013,"_3630":63014},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_4190":1602,"_34937":1592,"_23830":63016,"_5":16479,"_31422":1592,"_3630":63017},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_4190":1603,"_34937":1592,"_23830":63019,"_5":16479,"_31422":62986,"_3630":63020},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_4190":1604,"_34937":1592,"_23830":63022,"_5":16479,"_31422":62986,"_3630":63023},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_4190":1605,"_34937":1592,"_23830":63025,"_5":16479,"_31422":62986,"_3630":63026},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_4190":1606,"_34937":1592,"_23830":63028,"_5":16479,"_31422":62986,"_3630":63029},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_4190":1607,"_34937":1592,"_23830":63031,"_5":16479,"_31422":62986,"_3630":63032},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_4190":1608,"_34937":1592,"_23830":63034,"_5":16479,"_31422":62989,"_3630":63035},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_4190":1609,"_34937":1592,"_23830":63037,"_5":16479,"_31422":62989,"_3630":63038},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_4190":1610,"_34937":1592,"_23830":63040,"_5":16479,"_31422":62993,"_3630":63041},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_4190":1611,"_34937":1592,"_23830":63043,"_5":16479,"_31422":62993,"_3630":63044},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_4190":1612,"_34937":1592,"_23830":63046,"_5":16479,"_31422":62993,"_3630":63047},[],"Setting",{"_4190":1613,"_34937":1592,"_23830":63049,"_5":16479,"_31422":62993,"_3630":63050},[],"Evaluation value",{"_4190":1614,"_34937":1592,"_23830":63052,"_5":16479,"_31422":62993,"_3630":63053},[],"Enrollment CA",{"_4190":1615,"_34937":1592,"_23830":63055,"_5":16479,"_31422":62993,"_3630":63056},[],"Issuing root from `device-root.pem`.",{"_4190":1616,"_34937":1592,"_23830":63058,"_5":16479,"_31422":62993,"_3630":60862},[],{"_4190":1617,"_34937":1592,"_23830":63060,"_5":16479,"_31422":62993,"_3630":63061},[],"The 1-hour leaf profile you just prepared.",{"_4190":1618,"_34937":1592,"_23830":63063,"_5":16479,"_31422":62993,"_3630":63064},[],"Protocol / Registration Mode",{"_4190":1619,"_34937":1592,"_23830":63066,"_5":16479,"_31422":62993,"_3630":63067},[],"`EST_RFC7030` / `JITP`.",{"_4190":1620,"_34937":1592,"_23830":63069,"_5":16479,"_31422":62993,"_3630":63070},[],"Verify CSR Signature",{"_4190":1621,"_34937":1592,"_23830":63072,"_5":16479,"_31422":62993,"_3630":63073},[],"Enabled.",{"_4190":1622,"_34937":1592,"_23830":63075,"_5":16479,"_31422":62993,"_3630":63076},[],"Enable Replaceable Enrollment",{"_4190":1623,"_34937":1592,"_23830":63078,"_5":16479,"_31422":62993,"_3630":63079},[],"Disabled; the ID must be new.",{"_4190":1624,"_34937":1592,"_23830":63081,"_5":16479,"_31422":62993,"_3630":63082},[],"Initial authentication",{"_4190":1625,"_34937":1592,"_23830":63084,"_5":16479,"_31422":62993,"_3630":63085},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_4190":1626,"_34937":1592,"_23830":63087,"_5":16479,"_31422":62993,"_3630":63088},[],"Renewal authentication",{"_4190":1627,"_34937":1592,"_23830":63090,"_5":16479,"_31422":62993,"_3630":63091},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_4190":1628,"_34937":1592,"_23830":63093,"_5":16479,"_31422":62993,"_3630":63094},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_4190":1629,"_34937":1592,"_23830":63096,"_5":16479,"_31422":62993,"_3630":63097},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_4190":1630,"_34937":1592,"_23830":63099,"_5":16479,"_31422":62993,"_3630":63100},[],"Re-enrollment Delta",{"_4190":1631,"_34937":1592,"_23830":63102,"_5":16479,"_31422":62993,"_3630":63103},[],"1 hour.",{"_4190":1632,"_34937":1592,"_23830":63105,"_5":16479,"_31422":62993,"_3630":63106},[],"Preventive / Critical Delta",{"_4190":1633,"_34937":1592,"_23830":63108,"_5":16479,"_31422":62993,"_3630":63109},[],"30 minutes / 10 minutes.",{"_4190":1634,"_34937":1592,"_23830":63111,"_5":16479,"_31422":62993,"_3630":63112},[],"Revoke on Re-enrollment",{"_4190":1635,"_34937":1592,"_23830":63114,"_5":16479,"_31422":62993,"_3630":63115},[],"Disabled to test the successor before retiring the previous identity.",{"_4190":1636,"_34937":1592,"_23830":63117,"_5":16479,"_31422":62993,"_3630":60870},[],{"_4190":1637,"_34937":1592,"_23830":63119,"_5":16479,"_31422":62993,"_3630":63120},[],"Disabled; the operational key is generated in the client.",{"_4190":1638,"_34937":1592,"_23830":63122,"_5":16479,"_31422":62993,"_3630":63123},[],"CA Distribution",{"_4190":1639,"_34937":1592,"_23830":63125,"_5":16479,"_31422":62993,"_3630":63126},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_4190":1640,"_34937":1592,"_23830":63128,"_5":16479,"_31422":62993,"_3630":63129},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_4190":1641,"_34937":1592,"_23830":63131,"_5":16479,"_31422":62997,"_3630":63132},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_4190":1642,"_34937":1592,"_23830":63134,"_5":16479,"_31422":62997,"_3630":63135},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_4190":1643,"_34937":1592,"_23830":63137,"_5":16479,"_31422":63001,"_3630":63138},[],"Generate a new key and CSR with the selected identifier:",{"_4190":1644,"_34937":1592,"_23830":63140,"_5":16479,"_31422":63001,"_3630":63141},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_4190":1645,"_34937":1592,"_23830":63143,"_5":16479,"_31422":63001,"_3630":63144},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_4190":1646,"_34937":1592,"_23830":63146,"_5":16479,"_31422":63005,"_3630":63147},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_4190":1647,"_34937":1592,"_23830":63149,"_5":16479,"_31422":63005,"_3630":63150},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_4190":1648,"_34937":1592,"_23830":63152,"_5":16479,"_31422":63009,"_3630":63153},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_4190":1649,"_34937":1592,"_23830":63155,"_5":16479,"_31422":63009,"_3630":63156},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_4190":1650,"_34937":1592,"_23830":63158,"_5":16479,"_31422":63009,"_3630":63159},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_4190":1651,"_34937":1592,"_23830":63161,"_5":16479,"_31422":63009,"_3630":63162},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_4190":1652,"_34937":1592,"_23830":63164,"_5":16479,"_31422":63009,"_3630":63165},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_4190":1653,"_34937":1592,"_23830":63167,"_5":16479,"_31422":63013,"_3630":63168},[],"Check",{"_4190":1654,"_34937":1592,"_23830":63170,"_5":16479,"_31422":63013,"_3630":63171},[],"Expected result",{"_4190":1655,"_34937":1592,"_23830":63173,"_5":16479,"_31422":63013,"_3630":63174},[],"Registration",{"_4190":1656,"_34937":1592,"_23830":63176,"_5":16479,"_31422":63013,"_3630":63177},[],"ID created automatically and correct DMS.",{"_4190":1657,"_34937":1592,"_23830":63179,"_5":16479,"_31422":63013,"_3630":62435},[],{"_4190":1658,"_34937":1592,"_23830":63181,"_5":16479,"_31422":63013,"_3630":63182},[],"CN, profile, serial and key verified.",{"_4190":1659,"_34937":1592,"_23830":63184,"_5":16479,"_31422":63013,"_3630":63185},[],"Inventory",{"_4190":1660,"_34937":1592,"_23830":63187,"_5":16479,"_31422":63013,"_3630":63188},[],"Received serial visible as the current identity and in history.",{"_4190":1661,"_34937":1592,"_23830":63190,"_5":16479,"_31422":63013,"_3630":63191},[],"Consumer",{"_4190":1662,"_34937":1592,"_23830":63193,"_5":16479,"_31422":63013,"_3630":63194},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_4190":1663,"_34937":1592,"_23830":63196,"_5":16479,"_31422":63013,"_3630":63197},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_4190":1664,"_34937":1592,"_23830":63199,"_5":16479,"_31422":63013,"_3630":63200},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_4190":1665,"_34937":1665,"_5":16871,"_3630":60567,"_35372":63202,"_23830":63203,"_31422":1665},[58062,59537,60551,62979],[],{"_4190":1666,"_34937":1665,"_23830":63205,"_5":16479,"_31422":1665,"_3630":63206},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_4190":1667,"_34937":1665,"_5":35369,"_23830":63208,"_31422":63209,"_3630":58072},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_4190":1668,"_34937":1665,"_5":35369,"_23830":63211,"_31422":63212,"_3630":63213},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_4190":1669,"_34937":1665,"_5":35369,"_23830":63215,"_31422":63216,"_3630":63217},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_4190":1670,"_34937":1665,"_5":35369,"_23830":63219,"_31422":63220,"_3630":63221},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_4190":1671,"_34937":1665,"_5":35369,"_23830":63223,"_31422":63224,"_3630":63225},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_4190":1672,"_34937":1665,"_5":35369,"_23830":63227,"_31422":63228,"_3630":63229},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_4190":1673,"_34937":1665,"_5":35369,"_23830":63231,"_31422":63232,"_3630":63171},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#expected-result",{"_4190":1674,"_34937":1665,"_5":35369,"_23830":63234,"_31422":63235,"_3630":63236},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_4190":1675,"_34937":1665,"_5":35369,"_23830":63238,"_31422":63239,"_3630":63240},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_4190":1676,"_34937":1665,"_23830":63242,"_5":16479,"_31422":1665,"_3630":63243},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_4190":1677,"_34937":1665,"_23830":63245,"_5":16479,"_31422":1665,"_3630":63246},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_4190":1678,"_34937":1665,"_23830":63248,"_5":16479,"_31422":63209,"_3630":63249},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_4190":1679,"_34937":1665,"_23830":63251,"_5":16479,"_31422":63209,"_3630":63252},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_4190":1680,"_34937":1665,"_23830":63254,"_5":16479,"_31422":63209,"_3630":63255},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_4190":1681,"_34937":1665,"_23830":63257,"_5":16479,"_31422":63209,"_3630":63258},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_4190":1682,"_34937":1665,"_23830":63260,"_5":16479,"_31422":63212,"_3630":63261},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_4190":1683,"_34937":1665,"_23830":63263,"_5":16479,"_31422":63212,"_3630":63264},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_4190":1684,"_34937":1665,"_23830":63266,"_5":16479,"_31422":63212,"_3630":63267},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_4190":1685,"_34937":1665,"_23830":63269,"_5":16479,"_31422":63212,"_3630":63270},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_4190":1686,"_34937":1665,"_23830":63272,"_5":16479,"_31422":63212,"_3630":63273},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_4190":1687,"_34937":1665,"_23830":63275,"_5":16479,"_31422":63212,"_3630":63276},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_4190":1688,"_34937":1665,"_23830":63278,"_5":16479,"_31422":63212,"_3630":63279},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_4190":1689,"_34937":1665,"_23830":63281,"_5":16479,"_31422":63212,"_3630":63282},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_4190":1690,"_34937":1665,"_23830":63284,"_5":16479,"_31422":63216,"_3630":63285},[],"Open **Managed Devices** and the registration action. Complete:",{"_4190":1691,"_34937":1665,"_23830":63287,"_5":16479,"_31422":63216,"_3630":63288},[],"**Device ID**: `device-001`.",{"_4190":1692,"_34937":1665,"_23830":63290,"_5":16479,"_31422":63216,"_3630":63291},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_4190":1693,"_34937":1665,"_23830":63293,"_5":16479,"_31422":63216,"_3630":63294},[],"**Icon** and **Tags**: optional classification.",{"_4190":1694,"_34937":1665,"_23830":63296,"_5":16479,"_31422":63216,"_3630":63297},[],"Confirm registration.",{"_4190":1695,"_34937":1665,"_23830":63299,"_5":16479,"_31422":63220,"_3630":63300},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_4190":1696,"_34937":1665,"_23830":63302,"_5":16479,"_31422":63220,"_3630":63303},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_4190":1697,"_34937":1665,"_23830":63305,"_5":16479,"_31422":63224,"_3630":63306},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_4190":1698,"_34937":1665,"_23830":63308,"_5":16479,"_31422":63224,"_3630":63309},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_4190":1699,"_34937":1665,"_23830":63311,"_5":16479,"_31422":63228,"_3630":63312},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_4190":1700,"_34937":1665,"_23830":63314,"_5":16479,"_31422":63228,"_3630":63315},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_4190":1701,"_34937":1665,"_23830":63317,"_5":16479,"_31422":63232,"_3630":63168},[],{"_4190":1702,"_34937":1665,"_23830":63319,"_5":16479,"_31422":63232,"_3630":63320},[],"Result",{"_4190":1703,"_34937":1665,"_23830":63322,"_5":16479,"_31422":63232,"_3630":62418},[],{"_4190":1704,"_34937":1665,"_23830":63324,"_5":16479,"_31422":63232,"_3630":63325},[],"`device-001` appears in inventory with the expected DMS.",{"_4190":1705,"_34937":1665,"_23830":63327,"_5":16479,"_31422":63232,"_3630":63328},[],"Current identity",{"_4190":1706,"_34937":1665,"_23830":63330,"_5":16479,"_31422":63232,"_3630":63331},[],"The associated certificate matches the one you verified in PKI.",{"_4190":1707,"_34937":1665,"_23830":63333,"_5":16479,"_31422":63232,"_3630":63334},[],"History",{"_4190":1708,"_34937":1665,"_23830":63336,"_5":16479,"_31422":63232,"_3630":63337},[],"The associated issuance appears with its serial number and dates.",{"_4190":1709,"_34937":1665,"_23830":63339,"_5":16479,"_31422":63232,"_3630":63340},[],"Key and certificate",{"_4190":1710,"_34937":1665,"_23830":63342,"_5":16479,"_31422":63232,"_3630":63343},[],"You have the verified pair ready to install on the device.",{"_4190":1711,"_34937":1665,"_23830":63345,"_5":16479,"_31422":63235,"_3630":63346},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_4190":1712,"_34937":1665,"_23830":63348,"_5":16479,"_31422":63235,"_3630":63349},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_4190":1713,"_34937":1665,"_23830":63351,"_5":16479,"_31422":63235,"_3630":63352},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_4190":1714,"_34937":1665,"_23830":63354,"_5":16479,"_31422":63235,"_3630":63355},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_4190":1715,"_34937":1665,"_23830":63357,"_5":16479,"_31422":63239,"_3630":63358},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_4190":1716,"_34937":1665,"_23830":63360,"_5":16479,"_31422":63239,"_3630":63361},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_4190":1717,"_34937":1665,"_23830":63363,"_5":16479,"_31422":63239,"_3630":63364},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_4190":1718,"_34937":1718,"_5":16871,"_3630":63366,"_35372":63367,"_23830":63368,"_31422":1718},"Lamassu IoT Platform",[58062,59537],[],{"_4190":1719,"_34937":1718,"_23830":63370,"_5":16479,"_31422":1718,"_3630":63371},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_4190":1720,"_34937":1718,"_5":35369,"_23830":63373,"_31422":63374,"_3630":62854},[],"/docs/pr-preview/pr-58/platform/overview#start-here",{"_4190":1721,"_34937":1718,"_5":35369,"_23830":63376,"_31422":63377,"_3630":63378},[],"/docs/pr-preview/pr-58/platform/overview#choose-your-path","Choose your path",{"_4190":1722,"_34937":1718,"_5":35369,"_23830":63380,"_31422":63381,"_3630":63382},[],"/docs/pr-preview/pr-58/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_4190":1723,"_34937":1718,"_5":35369,"_23830":63384,"_31422":63385,"_3630":63386},[],"/docs/pr-preview/pr-58/platform/overview#core-capabilities","Core capabilities",{"_4190":1724,"_34937":1718,"_5":35369,"_23830":63388,"_31422":63389,"_3630":63390},[],"/docs/pr-preview/pr-58/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_4190":1725,"_34937":1718,"_5":35369,"_23830":63392,"_31422":63393,"_3630":63394},[],"/docs/pr-preview/pr-58/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_4190":1726,"_34937":1718,"_5":35369,"_23830":63396,"_31422":63397,"_3630":63398},[],"/docs/pr-preview/pr-58/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_4190":1727,"_34937":1718,"_5":35369,"_23830":63400,"_31422":63401,"_3630":63402},[],"/docs/pr-preview/pr-58/platform/overview#automate-device-identities","Automate device identities",{"_4190":1728,"_34937":1718,"_5":35369,"_23830":63404,"_31422":63405,"_3630":63406},[],"/docs/pr-preview/pr-58/platform/overview#publish-validation-status","Publish validation status",{"_4190":1729,"_34937":1718,"_5":35369,"_23830":63408,"_31422":63409,"_3630":63410},[],"/docs/pr-preview/pr-58/platform/overview#react-to-events","React to events",{"_4190":1730,"_34937":1718,"_5":35369,"_23830":63412,"_31422":63413,"_3630":63414},[],"/docs/pr-preview/pr-58/platform/overview#operational-reference","Operational reference",{"_4190":1731,"_34937":1718,"_23830":63416,"_5":16479,"_31422":1718,"_3630":63417},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_4190":1732,"_34937":1718,"_23830":63419,"_5":16479,"_31422":63374,"_3630":63420},[],"Choose the result you need:",{"_4190":1733,"_34937":1718,"_23830":63422,"_5":16479,"_31422":63374,"_3630":63423},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4190":1734,"_34937":1718,"_23830":63425,"_5":16479,"_31422":63374,"_3630":63426},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4190":1735,"_34937":1718,"_23830":63428,"_5":16479,"_31422":63374,"_3630":63429},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_4190":1736,"_34937":1718,"_23830":63431,"_5":16479,"_31422":63377,"_3630":63432},[],"Section",{"_4190":1737,"_34937":1718,"_23830":63434,"_5":16479,"_31422":63377,"_3630":63435},[],"What you manage",{"_4190":1738,"_34937":1718,"_23830":63437,"_5":16479,"_31422":63377,"_3630":63438},[],"Entry point",{"_4190":1739,"_34937":1718,"_23830":63440,"_5":16479,"_31422":63377,"_3630":63441},[],"**PKI**",{"_4190":1740,"_34937":1718,"_23830":63443,"_5":16479,"_31422":63377,"_3630":63444},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_4190":1741,"_34937":1718,"_23830":63446,"_5":16479,"_31422":63377,"_3630":63447},[],"PKI overview",{"_4190":1742,"_34937":1718,"_23830":63449,"_5":16479,"_31422":63377,"_3630":63450},[],"**IoT Fleets**",{"_4190":1743,"_34937":1718,"_23830":63452,"_5":16479,"_31422":63377,"_3630":63453},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_4190":1744,"_34937":1718,"_23830":63455,"_5":16479,"_31422":63377,"_3630":63456},[],"IoT Fleets overview",{"_4190":1745,"_34937":1718,"_23830":63458,"_5":16479,"_31422":63377,"_3630":63459},[],"**Administration**",{"_4190":1746,"_34937":1718,"_23830":63461,"_5":16479,"_31422":63377,"_3630":63462},[],"Operator permissions, audit and event subscriptions.",{"_4190":1747,"_34937":1718,"_23830":63464,"_5":16479,"_31422":63377,"_3630":59535},[],{"_4190":1748,"_34937":1718,"_23830":63466,"_5":16479,"_31422":63377,"_3630":63467},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_4190":1749,"_34937":1718,"_23830":63469,"_5":16479,"_31422":63381,"_3630":63470},[],"An identity's journey connects four responsibilities:",{"_4190":1750,"_34937":1718,"_23830":63472,"_5":16479,"_31422":63381,"_3630":63473},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_4190":1751,"_34937":1718,"_23830":63475,"_5":16479,"_31422":63381,"_3630":63476},[],"The provisioning administrator configures the DMS and initial trust.",{"_4190":1752,"_34937":1718,"_23830":63478,"_5":16479,"_31422":63381,"_3630":63479},[],"The device client requests a certificate and installs it with the matching key.",{"_4190":1753,"_34937":1718,"_23830":63481,"_5":16479,"_31422":63381,"_3630":63482},[],"The consumer validates the identity and applies its access permissions.",{"_4190":1754,"_34937":1718,"_23830":63484,"_5":16479,"_31422":63381,"_3630":63485},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_4190":1755,"_34937":1718,"_23830":63487,"_5":16479,"_31422":63389,"_3630":63488},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_4190":1756,"_34937":1718,"_23830":63490,"_5":16479,"_31422":63393,"_3630":63491},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_4190":1757,"_34937":1718,"_23830":63493,"_5":16479,"_31422":63397,"_3630":63494},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_4190":1758,"_34937":1718,"_23830":63496,"_5":16479,"_31422":63401,"_3630":63497},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_4190":1759,"_34937":1718,"_23830":63499,"_5":16479,"_31422":63405,"_3630":63500},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_4190":1760,"_34937":1718,"_23830":63502,"_5":16479,"_31422":63409,"_3630":63503},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_4190":1761,"_34937":1718,"_23830":63505,"_5":16479,"_31422":63413,"_3630":62948},[],{"_4190":1762,"_34937":1718,"_23830":63507,"_5":16479,"_31422":63413,"_3630":63508},[],"What it prepares or checks",{"_4190":1763,"_34937":1718,"_23830":63510,"_5":16479,"_31422":63413,"_3630":62951},[],{"_4190":1764,"_34937":1718,"_23830":63512,"_5":16479,"_31422":63413,"_3630":63513},[],"Key custody, CA hierarchy, profiles and validation.",{"_4190":1765,"_34937":1718,"_23830":63515,"_5":16479,"_31422":63413,"_3630":63516},[],"Fleet administrator",{"_4190":1766,"_34937":1718,"_23830":63518,"_5":16479,"_31422":63413,"_3630":63519},[],"DMS, device admission, renewal policy and inventory.",{"_4190":1767,"_34937":1718,"_23830":63521,"_5":16479,"_31422":63413,"_3630":62963},[],{"_4190":1768,"_34937":1718,"_23830":63523,"_5":16479,"_31422":63413,"_3630":63524},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_4190":1769,"_34937":1718,"_23830":63526,"_5":16479,"_31422":63413,"_3630":62969},[],{"_4190":1770,"_34937":1718,"_23830":63528,"_5":16479,"_31422":63413,"_3630":63529},[],"Issuer trust, certificate validation and permissions in the destination.",{"_4190":1771,"_34937":1718,"_23830":63531,"_5":16479,"_31422":63413,"_3630":63532},[],"Infrastructure operator",{"_4190":1772,"_34937":1718,"_23830":63534,"_5":16479,"_31422":63413,"_3630":63535},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_4190":1773,"_34937":1718,"_23830":63537,"_5":16479,"_31422":63413,"_3630":63538},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_4190":1774,"_34937":1774,"_5":16871,"_3630":63540,"_35372":63541,"_23830":63544,"_31422":1774},"CA hierarchy and rotation",[58062,59537,63542,63543],"PKI","Keys, authorities and certificates",[],{"_4190":1775,"_34937":1774,"_23830":63546,"_5":16479,"_31422":1774,"_3630":63547},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_4190":1776,"_34937":1774,"_5":35369,"_23830":63549,"_31422":63550,"_3630":63551},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_4190":1777,"_34937":1774,"_5":35369,"_23830":63553,"_31422":63554,"_3630":63555},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_4190":1778,"_34937":1774,"_5":35369,"_23830":63557,"_31422":63558,"_3630":63559},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_4190":1779,"_34937":1774,"_5":35369,"_23830":63561,"_31422":63562,"_3630":63563},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_4190":1780,"_34937":1774,"_5":35369,"_23830":63565,"_31422":63566,"_3630":63567},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_4190":1781,"_34937":1774,"_5":35369,"_23830":63569,"_31422":63570,"_3630":63571},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_4190":1782,"_34937":1774,"_5":35369,"_23830":63573,"_31422":63574,"_3630":63575},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_4190":1783,"_34937":1774,"_5":35369,"_23830":63577,"_31422":63578,"_3630":63579},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_4190":1784,"_34937":1774,"_5":35369,"_23830":63581,"_31422":63582,"_3630":63583},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_4190":1785,"_34937":1774,"_5":35369,"_23830":63585,"_31422":63586,"_3630":63587},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_4190":1786,"_34937":1774,"_5":35369,"_23830":63589,"_31422":63590,"_3630":63591},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_4190":1787,"_34937":1774,"_5":35369,"_23830":63593,"_31422":63594,"_3630":63595},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_4190":1788,"_34937":1774,"_23830":63597,"_5":16479,"_31422":1774,"_3630":63598},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_4190":1789,"_34937":1774,"_23830":63600,"_5":16479,"_31422":1774,"_3630":63601},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_4190":1790,"_34937":1774,"_23830":63603,"_5":16479,"_31422":63550,"_3630":63604},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_4190":1791,"_34937":1774,"_23830":63606,"_5":16479,"_31422":63550,"_3630":63607},[],"environment, such as production and preproduction;",{"_4190":1792,"_34937":1774,"_23830":63609,"_5":16479,"_31422":63550,"_3630":63610},[],"owner or operating team;",{"_4190":1793,"_34937":1774,"_23830":63612,"_5":16479,"_31422":63550,"_3630":63613},[],"device family or manufacturing process;",{"_4190":1794,"_34937":1774,"_23830":63615,"_5":16479,"_31422":63550,"_3630":63616},[],"region or regulatory requirement;",{"_4190":1795,"_34937":1774,"_23830":63618,"_5":16479,"_31422":63550,"_3630":63619},[],"cryptographic engine or key policy;",{"_4190":1796,"_34937":1774,"_23830":63621,"_5":16479,"_31422":63550,"_3630":63622},[],"maintenance window and renewal cadence.",{"_4190":1797,"_34937":1774,"_23830":63624,"_5":16479,"_31422":63550,"_3630":63625},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_4190":1798,"_34937":1774,"_23830":63627,"_5":16479,"_31422":63550,"_3630":63628},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_4190":1799,"_34937":1774,"_23830":63630,"_5":16479,"_31422":63554,"_3630":63631},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_4190":1800,"_34937":1774,"_23830":63633,"_5":16479,"_31422":63554,"_3630":63634},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_4190":1801,"_34937":1774,"_23830":63636,"_5":16479,"_31422":63554,"_3630":63637},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_4190":1802,"_34937":1774,"_23830":63639,"_5":16479,"_31422":63554,"_3630":63640},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_4190":1803,"_34937":1774,"_23830":63642,"_5":16479,"_31422":63558,"_3630":63643},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_4190":1804,"_34937":1774,"_23830":63645,"_5":16479,"_31422":63558,"_3630":63646},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_4190":1805,"_34937":1774,"_23830":63648,"_5":16479,"_31422":63558,"_3630":63649},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_4190":1806,"_34937":1774,"_23830":63651,"_5":16479,"_31422":63558,"_3630":63652},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_4190":1807,"_34937":1774,"_23830":63654,"_5":16479,"_31422":63566,"_3630":63655},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_4190":1808,"_34937":1774,"_23830":63657,"_5":16479,"_31422":63570,"_3630":63658},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_4190":1809,"_34937":1774,"_23830":63660,"_5":16479,"_31422":63574,"_3630":63661},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_4190":1810,"_34937":1774,"_23830":63663,"_5":16479,"_31422":63578,"_3630":63664},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_4190":1811,"_34937":1774,"_23830":63666,"_5":16479,"_31422":63582,"_3630":63667},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_4190":1812,"_34937":1774,"_23830":63669,"_5":16479,"_31422":63586,"_3630":63670},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_4190":1813,"_34937":1774,"_23830":63672,"_5":16479,"_31422":63590,"_3630":63673},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_4190":1814,"_34937":1774,"_23830":63675,"_5":16479,"_31422":63590,"_3630":63676},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_4190":1815,"_34937":1774,"_23830":63678,"_5":16479,"_31422":63590,"_3630":63679},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_4190":1816,"_34937":1774,"_23830":63681,"_5":16479,"_31422":63590,"_3630":63682},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_4190":1817,"_34937":1774,"_23830":63684,"_5":16479,"_31422":63594,"_3630":63685},[],"The new chain ends in an anchor installed by the consumer.",{"_4190":1818,"_34937":1774,"_23830":63687,"_5":16479,"_31422":63594,"_3630":63688},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_4190":1819,"_34937":1774,"_23830":63690,"_5":16479,"_31422":63594,"_3630":63691},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_4190":1820,"_34937":1774,"_23830":63693,"_5":16479,"_31422":63594,"_3630":63694},[],"Re-enrollment accepts the old identity during the planned period.",{"_4190":1821,"_34937":1774,"_23830":63696,"_5":16479,"_31422":63594,"_3630":63697},[],"OCSP and CRL respond for the authorities that remain active.",{"_4190":1822,"_34937":1774,"_23830":63699,"_5":16479,"_31422":63594,"_3630":63700},[],"No DMS is left accidentally issuing from the old CA.",{"_4190":1823,"_34937":1774,"_23830":63702,"_5":16479,"_31422":63594,"_3630":63703},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_4190":1824,"_34937":1824,"_5":16871,"_3630":63705,"_35372":63706,"_23830":63707,"_31422":1824},"Certification authorities",[58062,59537,63542,63543],[],{"_4190":1825,"_34937":1824,"_23830":63709,"_5":16479,"_31422":1824,"_3630":63710},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_4190":1826,"_34937":1824,"_5":35369,"_23830":63712,"_31422":63713,"_3630":63714},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_4190":1827,"_34937":1824,"_5":35369,"_23830":63716,"_31422":63717,"_3630":63718},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_4190":1828,"_34937":1824,"_5":35369,"_23830":63720,"_31422":63721,"_3630":58072},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#before-you-begin",{"_4190":1829,"_34937":1824,"_5":35369,"_23830":63723,"_31422":63724,"_3630":63725},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_4190":1830,"_34937":1824,"_5":35369,"_23830":63727,"_31422":63728,"_3630":63729},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_4190":1831,"_34937":1824,"_5":35369,"_23830":63731,"_31422":63732,"_3630":63733},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_4190":1832,"_34937":1824,"_5":35369,"_23830":63735,"_31422":63736,"_3630":63737},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_4190":1833,"_34937":1824,"_5":35369,"_23830":63739,"_31422":63740,"_3630":63741},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_4190":1834,"_34937":1824,"_5":35369,"_23830":63743,"_31422":63744,"_3630":63745},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_4190":1835,"_34937":1824,"_5":35369,"_23830":63747,"_31422":63748,"_3630":63749},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_4190":1836,"_34937":1824,"_5":35369,"_23830":63751,"_31422":63752,"_3630":63753},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_4190":1837,"_34937":1824,"_5":35369,"_23830":63755,"_31422":63756,"_3630":63757},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_4190":1838,"_34937":1824,"_5":35369,"_23830":63759,"_31422":63760,"_3630":63761},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#load-the-material","Load the material",{"_4190":1839,"_34937":1824,"_5":35369,"_23830":63763,"_31422":63764,"_3630":63765},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_4190":1840,"_34937":1824,"_5":35369,"_23830":63767,"_31422":63768,"_3630":63769},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_4190":1841,"_34937":1824,"_5":35369,"_23830":63771,"_31422":63772,"_3630":63773},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_4190":1842,"_34937":1824,"_5":35369,"_23830":63775,"_31422":63776,"_3630":63777},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_4190":1843,"_34937":1824,"_5":35369,"_23830":63779,"_31422":63780,"_3630":63781},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_4190":1844,"_34937":1824,"_5":35369,"_23830":63783,"_31422":63784,"_3630":63785},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_4190":1845,"_34937":1824,"_5":35369,"_23830":63787,"_31422":63788,"_3630":63789},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_4190":1846,"_34937":1824,"_5":35369,"_23830":63791,"_31422":63792,"_3630":63793},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_4190":1847,"_34937":1824,"_5":35369,"_23830":63795,"_31422":63796,"_3630":63797},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_4190":1848,"_34937":1824,"_5":35369,"_23830":63799,"_31422":63800,"_3630":63801},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_4190":1849,"_34937":1824,"_23830":63803,"_5":16479,"_31422":1824,"_3630":63804},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_4190":1850,"_34937":1824,"_23830":63806,"_5":16479,"_31422":1824,"_3630":63807},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_4190":1851,"_34937":1824,"_23830":63809,"_5":16479,"_31422":1824,"_3630":63810},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_4190":1852,"_34937":1824,"_23830":63812,"_5":16479,"_31422":63713,"_3630":63813},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_4190":1853,"_34937":1824,"_23830":63815,"_5":16479,"_31422":63713,"_3630":63816},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_4190":1854,"_34937":1824,"_23830":63818,"_5":16479,"_31422":63713,"_3630":63819},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_4190":1855,"_34937":1824,"_23830":63821,"_5":16479,"_31422":63713,"_3630":63822},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_4190":1856,"_34937":1824,"_23830":63824,"_5":16479,"_31422":63713,"_3630":63825},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_4190":1857,"_34937":1824,"_23830":63827,"_5":16479,"_31422":63721,"_3630":63828},[],"Decide whether the CA will be a root or an intermediate.",{"_4190":1858,"_34937":1824,"_23830":63830,"_5":16479,"_31422":63721,"_3630":63831},[],"Choose the engine that will keep the key.",{"_4190":1859,"_34937":1824,"_23830":63833,"_5":16479,"_31422":63721,"_3630":63834},[],"Define a validity longer than that of the certificates it will issue.",{"_4190":1860,"_34937":1824,"_23830":63836,"_5":16479,"_31422":63721,"_3630":63837},[],"For an intermediate CA, make sure the parent CA is active.",{"_4190":1861,"_34937":1824,"_23830":63839,"_5":16479,"_31422":63724,"_3630":63840},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_4190":1862,"_34937":1824,"_23830":63842,"_5":16479,"_31422":63728,"_3630":63843},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_4190":1863,"_34937":1824,"_23830":63845,"_5":16479,"_31422":63728,"_3630":63846},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_4190":1864,"_34937":1824,"_23830":63848,"_5":16479,"_31422":63732,"_3630":63849},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_4190":1865,"_34937":1824,"_23830":63851,"_5":16479,"_31422":63736,"_3630":63852},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_4190":1866,"_34937":1824,"_23830":63854,"_5":16479,"_31422":63736,"_3630":63855},[],"`C`: two-letter ISO 3166-1 country code.",{"_4190":1867,"_34937":1824,"_23830":63857,"_5":16479,"_31422":63736,"_3630":63858},[],"`ST`: state or province.",{"_4190":1868,"_34937":1824,"_23830":63860,"_5":16479,"_31422":63736,"_3630":63861},[],"`L`: locality.",{"_4190":1869,"_34937":1824,"_23830":63863,"_5":16479,"_31422":63736,"_3630":63864},[],"`O`: organization.",{"_4190":1870,"_34937":1824,"_23830":63866,"_5":16479,"_31422":63736,"_3630":63867},[],"`OU`: organizational unit.",{"_4190":1871,"_34937":1824,"_23830":63869,"_5":16479,"_31422":63736,"_3630":63870},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_4190":1872,"_34937":1824,"_23830":63872,"_5":16479,"_31422":63740,"_3630":63873},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_4190":1873,"_34937":1824,"_23830":63875,"_5":16479,"_31422":63740,"_3630":63876},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_4190":1874,"_34937":1824,"_23830":63878,"_5":16479,"_31422":63744,"_3630":63879},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_4190":1875,"_34937":1824,"_23830":63881,"_5":16479,"_31422":63744,"_3630":63882},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_4190":1876,"_34937":1824,"_23830":63884,"_5":16479,"_31422":63748,"_3630":63885},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_4190":1877,"_34937":1824,"_23830":63887,"_5":16479,"_31422":63748,"_3630":63888},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_4190":1878,"_34937":1824,"_23830":63890,"_5":16479,"_31422":63752,"_3630":63891},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_4190":1879,"_34937":1824,"_23830":63893,"_5":16479,"_31422":63752,"_3630":63894},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_4190":1880,"_34937":1824,"_23830":63896,"_5":16479,"_31422":63752,"_3630":63897},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_4190":1881,"_34937":1824,"_23830":63899,"_5":16479,"_31422":63756,"_3630":63900},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_4190":1882,"_34937":1824,"_23830":63902,"_5":16479,"_31422":63760,"_3630":63903},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_4190":1883,"_34937":1824,"_23830":63905,"_5":16479,"_31422":63760,"_3630":63906},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_4190":1884,"_34937":1824,"_23830":63908,"_5":16479,"_31422":63764,"_3630":63909},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_4190":1885,"_34937":1824,"_23830":63911,"_5":16479,"_31422":63768,"_3630":63912},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_4190":1886,"_34937":1824,"_23830":63914,"_5":16479,"_31422":63768,"_3630":63915},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_4190":1887,"_34937":1824,"_23830":63917,"_5":16479,"_31422":63772,"_3630":63918},[],"Open a CA from the inventory to review:",{"_4190":1888,"_34937":1824,"_23830":63920,"_5":16479,"_31422":63772,"_3630":63921},[],"Status and validity period.",{"_4190":1889,"_34937":1824,"_23830":63923,"_5":16479,"_31422":63772,"_3630":63924},[],"Certificate and chain in PEM format.",{"_4190":1890,"_34937":1824,"_23830":63926,"_5":16479,"_31422":63772,"_3630":63927},[],"Number of active, expired and revoked certificates.",{"_4190":1891,"_34937":1824,"_23830":63929,"_5":16479,"_31422":63772,"_3630":63930},[],"Certificates issued in **Issued Certificates**.",{"_4190":1892,"_34937":1824,"_23830":63932,"_5":16479,"_31422":63772,"_3630":63933},[],"The CRL linked to the authority.",{"_4190":1893,"_34937":1824,"_23830":63935,"_5":16479,"_31422":63772,"_3630":63936},[],"Metadata and the associated cryptographic engine.",{"_4190":1894,"_34937":1824,"_23830":63938,"_5":16479,"_31422":63772,"_3630":63939},[],"You can filter the inventory by name, status and CA type.",{"_4190":1895,"_34937":1824,"_23830":63941,"_5":16479,"_31422":63776,"_3630":63942},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_4190":1896,"_34937":1824,"_23830":63944,"_5":16479,"_31422":63776,"_3630":63945},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_4190":1897,"_34937":1824,"_23830":63947,"_5":16479,"_31422":63776,"_3630":63948},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_4190":1898,"_34937":1824,"_23830":63950,"_5":16479,"_31422":63776,"_3630":63951},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_4190":1899,"_34937":1824,"_23830":63953,"_5":16479,"_31422":63780,"_3630":63954},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_4190":1900,"_34937":1824,"_23830":63956,"_5":16479,"_31422":63784,"_3630":63957},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_4190":1901,"_34937":1824,"_23830":63959,"_5":16479,"_31422":63788,"_3630":63960},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_4190":1902,"_34937":1824,"_23830":63962,"_5":16479,"_31422":63792,"_3630":63963},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_4190":1903,"_34937":1824,"_23830":63965,"_5":16479,"_31422":63796,"_3630":63966},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_4190":1904,"_34937":1824,"_23830":63968,"_5":16479,"_31422":63800,"_3630":63969},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_4190":1905,"_34937":1824,"_23830":63971,"_5":16479,"_31422":63800,"_3630":63972},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_4190":1906,"_34937":1824,"_23830":63974,"_5":16479,"_31422":63800,"_3630":63975},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_4190":1907,"_34937":1907,"_5":16871,"_3630":63977,"_35372":63978,"_23830":63979,"_31422":1907},"Certificate profiles",[58062,59537,63542,63543],[],{"_4190":1908,"_34937":1907,"_23830":63981,"_5":16479,"_31422":1907,"_3630":63982},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_4190":1909,"_34937":1907,"_5":35369,"_23830":63984,"_31422":63985,"_3630":63986},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_4190":1910,"_34937":1907,"_5":35369,"_23830":63988,"_31422":63989,"_3630":63990},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#validity","Validity",{"_4190":1911,"_34937":1907,"_5":35369,"_23830":63992,"_31422":63993,"_3630":63994},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_4190":1912,"_34937":1907,"_5":35369,"_23830":63996,"_31422":63997,"_3630":63998},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_4190":1913,"_34937":1907,"_5":35369,"_23830":64000,"_31422":64001,"_3630":64002},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#subject","Subject",{"_4190":1914,"_34937":1907,"_5":35369,"_23830":64004,"_31422":64005,"_3630":64006},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_4190":1915,"_34937":1907,"_5":35369,"_23830":64008,"_31422":64009,"_3630":64010},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_4190":1916,"_34937":1907,"_5":35369,"_23830":64012,"_31422":64013,"_3630":64014},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_4190":1917,"_34937":1907,"_5":35369,"_23830":64016,"_31422":64017,"_3630":64018},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_4190":1918,"_34937":1907,"_5":35369,"_23830":64020,"_31422":64021,"_3630":64022},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_4190":1919,"_34937":1907,"_5":35369,"_23830":64024,"_31422":64025,"_3630":64026},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_4190":1920,"_34937":1907,"_5":35369,"_23830":64028,"_31422":64029,"_3630":64030},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_4190":1921,"_34937":1907,"_5":35369,"_23830":64032,"_31422":64033,"_3630":64034},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_4190":1922,"_34937":1907,"_5":35369,"_23830":64036,"_31422":64037,"_3630":64038},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_4190":1923,"_34937":1907,"_5":35369,"_23830":64040,"_31422":64041,"_3630":64042},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#design-examples","Design examples",{"_4190":1924,"_34937":1907,"_5":35369,"_23830":64044,"_31422":64045,"_3630":64046},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_4190":1925,"_34937":1907,"_23830":64048,"_5":16479,"_31422":1907,"_3630":64049},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_4190":1926,"_34937":1907,"_23830":64051,"_5":16479,"_31422":1907,"_3630":64052},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_4190":1927,"_34937":1907,"_23830":64054,"_5":16479,"_31422":63989,"_3630":64055},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_4190":1928,"_34937":1907,"_23830":64057,"_5":16479,"_31422":63989,"_3630":64058},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_4190":1929,"_34937":1907,"_23830":64060,"_5":16479,"_31422":63993,"_3630":64061},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_4190":1930,"_34937":1907,"_23830":64063,"_5":16479,"_31422":63997,"_3630":64064},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_4190":1931,"_34937":1907,"_23830":64066,"_5":16479,"_31422":63997,"_3630":64067},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_4190":1932,"_34937":1907,"_23830":64069,"_5":16479,"_31422":63997,"_3630":64070},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_4190":1933,"_34937":1907,"_23830":64072,"_5":16479,"_31422":64001,"_3630":64073},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_4190":1934,"_34937":1907,"_23830":64075,"_5":16479,"_31422":64005,"_3630":64076},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_4190":1935,"_34937":1907,"_23830":64078,"_5":16479,"_31422":64005,"_3630":64079},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_4190":1936,"_34937":1907,"_23830":64081,"_5":16479,"_31422":64009,"_3630":64082},[],"The cryptographic enforcement can:",{"_4190":1937,"_34937":1907,"_23830":64084,"_5":16479,"_31422":64009,"_3630":64085},[],"allow or block RSA keys;",{"_4190":1938,"_34937":1907,"_23830":64087,"_5":16479,"_31422":64009,"_3630":64088},[],"limit the supported RSA sizes;",{"_4190":1939,"_34937":1907,"_23830":64090,"_5":16479,"_31422":64009,"_3630":64091},[],"allow or block ECDSA keys;",{"_4190":1940,"_34937":1907,"_23830":64093,"_5":16479,"_31422":64009,"_3630":64094},[],"limit the supported ECDSA sizes or curves.",{"_4190":1941,"_34937":1907,"_23830":64096,"_5":16479,"_31422":64009,"_3630":64097},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_4190":1942,"_34937":1907,"_23830":64099,"_5":16479,"_31422":64013,"_3630":64100},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_4190":1943,"_34937":1907,"_23830":64102,"_5":16479,"_31422":64013,"_3630":61304},[],{"_4190":1944,"_34937":1907,"_23830":64104,"_5":16479,"_31422":64013,"_3630":64105},[],"First choice",{"_4190":1945,"_34937":1907,"_23830":64107,"_5":16479,"_31422":64013,"_3630":64108},[],"Second choice",{"_4190":1946,"_34937":1907,"_23830":64110,"_5":16479,"_31422":64013,"_3630":64111},[],"If neither is supplied",{"_4190":1947,"_34937":1907,"_23830":64113,"_5":16479,"_31422":64013,"_3630":64114},[],"Direct signing with a CA",{"_4190":1948,"_34937":1907,"_23830":64116,"_5":16479,"_31422":64013,"_3630":64117},[],"`issuance_profile` embedded in the request",{"_4190":1949,"_34937":1907,"_23830":64119,"_5":16479,"_31422":64013,"_3630":64120},[],"Request `issuance_profile_id`",{"_4190":1950,"_34937":1907,"_23830":64122,"_5":16479,"_31422":64013,"_3630":64123},[],"CA default profile (`profile_id`).",{"_4190":1951,"_34937":1907,"_23830":64125,"_5":16479,"_31422":64013,"_3630":64126},[],"Issuance through a DMS",{"_4190":1952,"_34937":1907,"_23830":64128,"_5":16479,"_31422":64013,"_3630":64129},[],"`settings.issuance_profile_id`",{"_4190":1953,"_34937":1907,"_23830":64131,"_5":16479,"_31422":64013,"_3630":64132},[],"`settings.issuance_profile` embedded in the DMS",{"_4190":1954,"_34937":1907,"_23830":64134,"_5":16479,"_31422":64013,"_3630":64135},[],"Enrollment CA default profile.",{"_4190":1955,"_34937":1907,"_23830":64137,"_5":16479,"_31422":64013,"_3630":64138},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_4190":1956,"_34937":1907,"_23830":64140,"_5":16479,"_31422":64013,"_3630":64141},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_4190":1957,"_34937":1907,"_23830":64143,"_5":16479,"_31422":64021,"_3630":64144},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_4190":1958,"_34937":1907,"_23830":64146,"_5":16479,"_31422":64025,"_3630":64147},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_4190":1959,"_34937":1907,"_23830":64149,"_5":16479,"_31422":64029,"_3630":64150},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_4190":1960,"_34937":1907,"_23830":64152,"_5":16479,"_31422":64033,"_3630":64153},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_4190":1961,"_34937":1907,"_23830":64155,"_5":16479,"_31422":64037,"_3630":64156},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_4190":1962,"_34937":1907,"_23830":64158,"_5":16479,"_31422":64037,"_3630":64159},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_4190":1963,"_34937":1907,"_23830":64161,"_5":16479,"_31422":64041,"_3630":64162},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_4190":1964,"_34937":1907,"_23830":64164,"_5":16479,"_31422":64041,"_3630":64165},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_4190":1965,"_34937":1907,"_23830":64167,"_5":16479,"_31422":64041,"_3630":64168},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_4190":1966,"_34937":1907,"_23830":64170,"_5":16479,"_31422":64041,"_3630":64171},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_4190":1967,"_34937":1907,"_23830":64173,"_5":16479,"_31422":64045,"_3630":64174},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_4190":1968,"_34937":1907,"_23830":64176,"_5":16479,"_31422":64045,"_3630":64177},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_4190":1969,"_34937":1969,"_5":16871,"_3630":64179,"_35372":64180,"_23830":64182,"_31422":1969},"Certificate validation",[58062,59537,63542,64181],"Validation",[],{"_4190":1970,"_34937":1969,"_23830":64184,"_5":16479,"_31422":1969,"_3630":64185},[],"Check chain, identity, purpose and revocation from the consumer.",{"_4190":1971,"_34937":1969,"_5":35369,"_23830":64187,"_31422":64188,"_3630":64189},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_4190":1972,"_34937":1969,"_5":35369,"_23830":64191,"_31422":64192,"_3630":64193},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_4190":1973,"_34937":1969,"_5":35369,"_23830":64195,"_31422":64196,"_3630":64197},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_4190":1974,"_34937":1969,"_23830":64199,"_5":16479,"_31422":1969,"_3630":64200},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_4190":1975,"_34937":1969,"_23830":64202,"_5":16479,"_31422":64188,"_3630":64203},[],"Verify these criteria together:",{"_4190":1976,"_34937":1969,"_23830":64205,"_5":16479,"_31422":64188,"_3630":63168},[],{"_4190":1977,"_34937":1969,"_23830":64207,"_5":16479,"_31422":64188,"_3630":64208},[],"Required result",{"_4190":1978,"_34937":1969,"_23830":64210,"_5":16479,"_31422":64188,"_3630":64211},[],"Chain and signature",{"_4190":1979,"_34937":1969,"_23830":64213,"_5":16479,"_31422":64188,"_3630":64214},[],"Valid chain to a root deliberately installed in the consumer.",{"_4190":1980,"_34937":1969,"_23830":64216,"_5":16479,"_31422":64188,"_3630":64217},[],"Dates",{"_4190":1981,"_34937":1969,"_23830":64219,"_5":16479,"_31422":64188,"_3630":64220},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_4190":1982,"_34937":1969,"_23830":64222,"_5":16479,"_31422":64188,"_3630":59206},[],{"_4190":1983,"_34937":1969,"_23830":64224,"_5":16479,"_31422":64188,"_3630":64225},[],"Name, SAN or identifier matches the expected peer.",{"_4190":1984,"_34937":1969,"_23830":64227,"_5":16479,"_31422":64188,"_3630":58452},[],{"_4190":1985,"_34937":1969,"_23830":64229,"_5":16479,"_31422":64188,"_3630":64230},[],"KU, EKU and constraints permit the specific operation.",{"_4190":1986,"_34937":1969,"_23830":64232,"_5":16479,"_31422":64188,"_3630":64233},[],"Revocation",{"_4190":1987,"_34937":1969,"_23830":64235,"_5":16479,"_31422":64188,"_3630":64236},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_4190":1988,"_34937":1969,"_23830":64238,"_5":16479,"_31422":64188,"_3630":64239},[],"Authorization",{"_4190":1989,"_34937":1969,"_23830":64241,"_5":16479,"_31422":64188,"_3630":64242},[],"The application permits that identity to perform the action.",{"_4190":1990,"_34937":1969,"_23830":64244,"_5":16479,"_31422":64188,"_3630":64245},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_4190":1991,"_34937":1969,"_23830":64247,"_5":16479,"_31422":64192,"_3630":64248},[],"Mechanism",{"_4190":1992,"_34937":1969,"_23830":64250,"_5":16479,"_31422":64192,"_3630":64251},[],"When to use it",{"_4190":1993,"_34937":1969,"_23830":64253,"_5":16479,"_31422":64192,"_3630":64254},[],"What you must maintain",{"_4190":1994,"_34937":1969,"_23830":64256,"_5":16479,"_31422":64192,"_3630":64257},[],"OCSP",{"_4190":1995,"_34937":1969,"_23830":64259,"_5":16479,"_31422":64192,"_3630":64260},[],"Status query for a specific certificate.",{"_4190":1996,"_34937":1969,"_23830":64262,"_5":16479,"_31422":64192,"_3630":64263},[],"Responder access, signature verification and cache/freshness policy.",{"_4190":1997,"_34937":1969,"_23830":64265,"_5":16479,"_31422":64192,"_3630":64266},[],"CRL",{"_4190":1998,"_34937":1969,"_23830":64268,"_5":16479,"_31422":64192,"_3630":64269},[],"Local checks for many certificates or offline operation.",{"_4190":1999,"_34937":1969,"_23830":64271,"_5":16479,"_31422":64192,"_3630":64272},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_4190":2000,"_34937":1969,"_23830":64274,"_5":16479,"_31422":64192,"_3630":64275},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_4190":2001,"_34937":1969,"_23830":64277,"_5":16479,"_31422":64192,"_3630":64278},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_4190":2002,"_34937":1969,"_23830":64280,"_5":16479,"_31422":64196,"_3630":64281},[],"Accept a current, authorized certificate with a known chain.",{"_4190":2003,"_34937":1969,"_23830":64283,"_5":16479,"_31422":64196,"_3630":64284},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_4190":2004,"_34937":1969,"_23830":64286,"_5":16479,"_31422":64196,"_3630":64287},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_4190":2005,"_34937":1969,"_23830":64289,"_5":16479,"_31422":64196,"_3630":64290},[],"Check that a new connection with that identity is rejected.",{"_4190":2006,"_34937":1969,"_23830":64292,"_5":16479,"_31422":64196,"_3630":64293},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_4190":2007,"_34937":1969,"_23830":64295,"_5":16479,"_31422":64196,"_3630":64296},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_4190":2008,"_34937":1969,"_23830":64298,"_5":16479,"_31422":64196,"_3630":64299},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_4190":2009,"_34937":1969,"_23830":64301,"_5":16479,"_31422":64196,"_3630":64302},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_4190":2010,"_34937":1969,"_23830":64304,"_5":16479,"_31422":64196,"_3630":64305},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_4190":2011,"_34937":2011,"_5":16871,"_3630":64307,"_35372":64308,"_23830":64309,"_31422":2011},"Certificates",[58062,59537,63542,63543],[],{"_4190":2012,"_34937":2011,"_23830":64311,"_5":16479,"_31422":2011,"_3630":64312},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_4190":2013,"_34937":2011,"_5":35369,"_23830":64314,"_31422":64315,"_3630":64316},[],"/docs/pr-preview/pr-58/platform/pki/certificates#find-a-certificate","Find a certificate",{"_4190":2014,"_34937":2011,"_5":35369,"_23830":64318,"_31422":64319,"_3630":64320},[],"/docs/pr-preview/pr-58/platform/pki/certificates#download-the-certificate","Download the certificate",{"_4190":2015,"_34937":2011,"_5":35369,"_23830":64322,"_31422":64323,"_3630":64324},[],"/docs/pr-preview/pr-58/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_4190":2016,"_34937":2011,"_5":35369,"_23830":64326,"_31422":64327,"_3630":64328},[],"/docs/pr-preview/pr-58/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_4190":2017,"_34937":2011,"_5":35369,"_23830":64330,"_31422":64331,"_3630":64332},[],"/docs/pr-preview/pr-58/platform/pki/certificates#open-the-action","Open the action",{"_4190":2018,"_34937":2011,"_5":35369,"_23830":64334,"_31422":64335,"_3630":64336},[],"/docs/pr-preview/pr-58/platform/pki/certificates#choose-a-reason","Choose a reason",{"_4190":2019,"_34937":2011,"_5":35369,"_23830":64338,"_31422":64339,"_3630":64340},[],"/docs/pr-preview/pr-58/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_4190":2020,"_34937":2011,"_5":35369,"_23830":64342,"_31422":64343,"_3630":64344},[],"/docs/pr-preview/pr-58/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_4190":2021,"_34937":2011,"_5":35369,"_23830":64346,"_31422":64347,"_3630":64348},[],"/docs/pr-preview/pr-58/platform/pki/certificates#continue","Continue",{"_4190":2022,"_34937":2011,"_23830":64350,"_5":16479,"_31422":2011,"_3630":64351},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_4190":2023,"_34937":2011,"_23830":64353,"_5":16479,"_31422":64315,"_3630":64354},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_4190":2024,"_34937":2011,"_23830":64356,"_5":16479,"_31422":64315,"_3630":64357},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_4190":2025,"_34937":2011,"_23830":64359,"_5":16479,"_31422":64315,"_3630":64360},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_4190":2026,"_34937":2011,"_23830":64362,"_5":16479,"_31422":64315,"_3630":64363},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_4190":2027,"_34937":2011,"_23830":64365,"_5":16479,"_31422":64315,"_3630":64366},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_4190":2028,"_34937":2011,"_23830":64368,"_5":16479,"_31422":64315,"_3630":64369},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_4190":2029,"_34937":2011,"_23830":64371,"_5":16479,"_31422":64315,"_3630":64372},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_4190":2030,"_34937":2011,"_23830":64374,"_5":16479,"_31422":64319,"_3630":64375},[],"Download the PEM and inspect it:",{"_4190":2031,"_34937":2011,"_23830":64377,"_5":16479,"_31422":64319,"_3630":64378},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_4190":2032,"_34937":2011,"_23830":64380,"_5":16479,"_31422":64323,"_3630":64381},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_4190":2033,"_34937":2011,"_23830":64383,"_5":16479,"_31422":64323,"_3630":64384},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_4190":2034,"_34937":2011,"_23830":64386,"_5":16479,"_31422":64323,"_3630":64387},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_4190":2035,"_34937":2011,"_23830":64389,"_5":16479,"_31422":64323,"_3630":64390},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_4190":2036,"_34937":2011,"_23830":64392,"_5":16479,"_31422":64323,"_3630":64393},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_4190":2037,"_34937":2011,"_23830":64395,"_5":16479,"_31422":64323,"_3630":64396},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_4190":2038,"_34937":2011,"_23830":64398,"_5":16479,"_31422":64323,"_3630":64399},[],"For browser key generation, follow Issue your first certificate.",{"_4190":2039,"_34937":2011,"_23830":64401,"_5":16479,"_31422":64327,"_3630":64402},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_4190":2040,"_34937":2011,"_23830":64404,"_5":16479,"_31422":64331,"_3630":64405},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_4190":2041,"_34937":2011,"_23830":64407,"_5":16479,"_31422":64335,"_3630":64408},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_4190":2042,"_34937":2011,"_23830":64410,"_5":16479,"_31422":64339,"_3630":64411},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_4190":2043,"_34937":2011,"_23830":64413,"_5":16479,"_31422":64339,"_3630":64414},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_4190":2044,"_34937":2011,"_23830":64416,"_5":16479,"_31422":64339,"_3630":64417},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_4190":2045,"_34937":2011,"_23830":64419,"_5":16479,"_31422":64343,"_3630":64420},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_4190":2046,"_34937":2011,"_23830":64422,"_5":16479,"_31422":64343,"_3630":64423},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_4190":2047,"_34937":2011,"_23830":64425,"_5":16479,"_31422":64343,"_3630":64426},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_4190":2048,"_34937":2011,"_23830":64428,"_5":16479,"_31422":64347,"_3630":64429},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_4190":2049,"_34937":2011,"_23830":64431,"_5":16479,"_31422":64347,"_3630":64432},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_4190":2050,"_34937":2050,"_5":16871,"_3630":64434,"_35372":64435,"_23830":64437,"_31422":2050},"Certificate lifecycle",[58062,59537,63542,64436],"Concepts",[],{"_4190":2051,"_34937":2050,"_23830":64439,"_5":16479,"_31422":2050,"_3630":64440},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_4190":2052,"_34937":2050,"_5":35369,"_23830":64442,"_31422":64443,"_3630":64444},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_4190":2053,"_34937":2050,"_5":35369,"_23830":64446,"_31422":64447,"_3630":64448},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#request","Request",{"_4190":2054,"_34937":2050,"_5":35369,"_23830":64450,"_31422":64451,"_3630":64452},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_4190":2055,"_34937":2050,"_5":35369,"_23830":64454,"_31422":64455,"_3630":64456},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_4190":2056,"_34937":2050,"_5":35369,"_23830":64458,"_31422":64459,"_3630":64460},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_4190":2057,"_34937":2050,"_5":35369,"_23830":64462,"_31422":64463,"_3630":64464},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_4190":2058,"_34937":2050,"_5":35369,"_23830":64466,"_31422":64467,"_3630":64468},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_4190":2059,"_34937":2050,"_5":35369,"_23830":64470,"_31422":64471,"_3630":64472},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_4190":2060,"_34937":2050,"_5":35369,"_23830":64474,"_31422":64475,"_3630":64476},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_4190":2061,"_34937":2050,"_5":35369,"_23830":64478,"_31422":64479,"_3630":64480},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_4190":2062,"_34937":2050,"_23830":64482,"_5":16479,"_31422":2050,"_3630":64483},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_4190":2063,"_34937":2050,"_23830":64485,"_5":16479,"_31422":64447,"_3630":64486},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_4190":2064,"_34937":2050,"_23830":64488,"_5":16479,"_31422":64451,"_3630":64489},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_4190":2065,"_34937":2050,"_23830":64491,"_5":16479,"_31422":64455,"_3630":64492},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_4190":2066,"_34937":2050,"_23830":64494,"_5":16479,"_31422":64459,"_3630":64495},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_4190":2067,"_34937":2050,"_23830":64497,"_5":16479,"_31422":64463,"_3630":64498},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_4190":2068,"_34937":2050,"_23830":64500,"_5":16479,"_31422":64467,"_3630":64501},[],"Lamassu persists four X.509 states:",{"_4190":2069,"_34937":2050,"_23830":64503,"_5":16479,"_31422":64467,"_3630":64504},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_4190":2070,"_34937":2050,"_23830":64506,"_5":16479,"_31422":64467,"_3630":64507},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_4190":2071,"_34937":2050,"_23830":64509,"_5":16479,"_31422":64467,"_3630":64510},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_4190":2072,"_34937":2050,"_23830":64512,"_5":16479,"_31422":64467,"_3630":64513},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_4190":2073,"_34937":2050,"_23830":64515,"_5":16479,"_31422":64467,"_3630":64516},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_4190":2074,"_34937":2050,"_23830":64518,"_5":16479,"_31422":64471,"_3630":64519},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_4190":2075,"_34937":2050,"_23830":64521,"_5":16479,"_31422":64471,"_3630":64522},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_4190":2076,"_34937":2050,"_23830":64524,"_5":16479,"_31422":64471,"_3630":64525},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_4190":2077,"_34937":2050,"_23830":64527,"_5":16479,"_31422":64475,"_3630":64528},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_4190":2078,"_34937":2050,"_23830":64530,"_5":16479,"_31422":64475,"_3630":64531},[],"Before confirming:",{"_4190":2079,"_34937":2050,"_23830":64533,"_5":16479,"_31422":64475,"_3630":64534},[],"Identify DMSs, devices and services that trust that chain.",{"_4190":2080,"_34937":2050,"_23830":64536,"_5":16479,"_31422":64475,"_3630":64537},[],"Distribute the new chain of trust.",{"_4190":2081,"_34937":2050,"_23830":64539,"_5":16479,"_31422":64475,"_3630":64540},[],"Reissue the necessary identities.",{"_4190":2082,"_34937":2050,"_23830":64542,"_5":16479,"_31422":64475,"_3630":64543},[],"Check OCSP and CRL from a real consumer.",{"_4190":2083,"_34937":2050,"_23830":64545,"_5":16479,"_31422":64475,"_3630":64546},[],"Revoke the old CA once no legitimate traffic remains.",{"_4190":2084,"_34937":2050,"_23830":64548,"_5":16479,"_31422":64475,"_3630":64549},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_4190":2085,"_34937":2050,"_23830":64551,"_5":16479,"_31422":64479,"_3630":64552},[],"Certificates entering the preventive or critical renewal window.",{"_4190":2086,"_34937":2050,"_23830":64554,"_5":16479,"_31422":64479,"_3630":64555},[],"Repeated enrollment or re-enrollment failures.",{"_4190":2087,"_34937":2050,"_23830":64557,"_5":16479,"_31422":64479,"_3630":64558},[],"Status changes and revocation reasons.",{"_4190":2088,"_34937":2050,"_23830":64560,"_5":16479,"_31422":64479,"_3630":64561},[],"OCSP and CRL publication and validity.",{"_4190":2089,"_34937":2050,"_23830":64563,"_5":16479,"_31422":64479,"_3630":64564},[],"Dependencies still presenting a replaced certificate.",{"_4190":2090,"_34937":2050,"_23830":64566,"_5":16479,"_31422":64479,"_3630":64567},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_4190":2091,"_34937":2091,"_5":16871,"_3630":64569,"_35372":64570,"_23830":64571,"_31422":2091},"Trust model",[58062,59537,63542,64436],[],{"_4190":2092,"_34937":2091,"_23830":64573,"_5":16479,"_31422":2091,"_3630":64574},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_4190":2093,"_34937":2091,"_5":35369,"_23830":64576,"_31422":64577,"_3630":64578},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_4190":2094,"_34937":2091,"_5":35369,"_23830":64580,"_31422":64581,"_3630":64582},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_4190":2095,"_34937":2091,"_5":35369,"_23830":64584,"_31422":64585,"_3630":64586},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_4190":2096,"_34937":2091,"_5":35369,"_23830":64588,"_31422":64589,"_3630":64590},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_4190":2097,"_34937":2091,"_5":35369,"_23830":64592,"_31422":64593,"_3630":64594},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_4190":2098,"_34937":2091,"_5":35369,"_23830":64596,"_31422":64597,"_3630":64598},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_4190":2099,"_34937":2091,"_5":35369,"_23830":64600,"_31422":64601,"_3630":64602},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_4190":2100,"_34937":2091,"_5":35369,"_23830":64604,"_31422":64605,"_3630":64606},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_4190":2101,"_34937":2091,"_5":35369,"_23830":64608,"_31422":64609,"_3630":64610},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_4190":2102,"_34937":2091,"_5":35369,"_23830":64612,"_31422":64613,"_3630":64614},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_4190":2103,"_34937":2091,"_23830":64616,"_5":16479,"_31422":2091,"_3630":64617},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_4190":2104,"_34937":2091,"_23830":64619,"_5":16479,"_31422":64581,"_3630":64620},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_4190":2105,"_34937":2091,"_23830":64622,"_5":16479,"_31422":64585,"_3630":64623},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_4190":2106,"_34937":2091,"_23830":64625,"_5":16479,"_31422":64589,"_3630":64626},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_4190":2107,"_34937":2091,"_23830":64628,"_5":16479,"_31422":64593,"_3630":64629},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_4190":2108,"_34937":2091,"_23830":64631,"_5":16479,"_31422":64597,"_3630":64632},[],"The device proves it can enroll according to the DMS policy.",{"_4190":2109,"_34937":2091,"_23830":64634,"_5":16479,"_31422":64597,"_3630":64635},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_4190":2110,"_34937":2091,"_23830":64637,"_5":16479,"_31422":64597,"_3630":64638},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_4190":2111,"_34937":2091,"_23830":64640,"_5":16479,"_31422":64597,"_3630":64641},[],"The device installs the certificate and the chain it needs.",{"_4190":2112,"_34937":2091,"_23830":64643,"_5":16479,"_31422":64597,"_3630":64644},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_4190":2113,"_34937":2091,"_23830":64646,"_5":16479,"_31422":64597,"_3630":64647},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_4190":2114,"_34937":2091,"_23830":64649,"_5":16479,"_31422":64601,"_3630":64650},[],"A DMS relates three sets that are worth designing separately:",{"_4190":2115,"_34937":2091,"_23830":64652,"_5":16479,"_31422":64601,"_3630":64653},[],"**Enrollment CA:** signs the new identities.",{"_4190":2116,"_34937":2091,"_23830":64655,"_5":16479,"_31422":64601,"_3630":64656},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_4190":2117,"_34937":2091,"_23830":64658,"_5":16479,"_31422":64601,"_3630":64659},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_4190":2118,"_34937":2091,"_23830":64661,"_5":16479,"_31422":64601,"_3630":64662},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_4190":2119,"_34937":2091,"_23830":64664,"_5":16479,"_31422":64605,"_3630":64665},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_4190":2120,"_34937":2091,"_23830":64667,"_5":16479,"_31422":64605,"_3630":64668},[],"that the current date is between `Not Before` and `Not After`;",{"_4190":2121,"_34937":2091,"_23830":64670,"_5":16479,"_31422":64605,"_3630":64671},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_4190":2122,"_34937":2091,"_23830":64673,"_5":16479,"_31422":64605,"_3630":64674},[],"that names, SANs and subject match the expected identity;",{"_4190":2123,"_34937":2091,"_23830":64676,"_5":16479,"_31422":64605,"_3630":64677},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_4190":2124,"_34937":2091,"_23830":64679,"_5":16479,"_31422":64605,"_3630":64680},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_4190":2125,"_34937":2091,"_23830":64682,"_5":16479,"_31422":64605,"_3630":64683},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_4190":2126,"_34937":2091,"_23830":64685,"_5":16479,"_31422":64609,"_3630":64686},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_4190":2127,"_34937":2091,"_23830":64688,"_5":16479,"_31422":64613,"_3630":64689},[],"Keep the root out of daily operations, or with very restricted access.",{"_4190":2128,"_34937":2091,"_23830":64691,"_5":16479,"_31422":64613,"_3630":64692},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_4190":2129,"_34937":2091,"_23830":64694,"_5":16479,"_31422":64613,"_3630":64695},[],"Assign explicit profiles to every use case.",{"_4190":2130,"_34937":2091,"_23830":64697,"_5":16479,"_31422":64613,"_3630":64698},[],"Distribute the new trust before starting a rotation.",{"_4190":2131,"_34937":2091,"_23830":64700,"_5":16479,"_31422":64613,"_3630":64701},[],"Keep enough overlap to renew a disconnected fleet.",{"_4190":2132,"_34937":2091,"_23830":64703,"_5":16479,"_31422":64613,"_3630":64704},[],"Validate from the consuming system, not only from the Lamassu console.",{"_4190":2133,"_34937":2091,"_23830":64706,"_5":16479,"_31422":64613,"_3630":64707},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_4190":2134,"_34937":2134,"_5":16871,"_3630":64709,"_35372":64710,"_23830":64711,"_31422":2134},"Revocation lists (CRL)",[58062,59537,63542,64181],[],{"_4190":2135,"_34937":2134,"_23830":64713,"_5":16479,"_31422":2134,"_3630":64714},[],"Generate and distribute signed lists to validate certificates offline.",{"_4190":2136,"_34937":2134,"_5":35369,"_23830":64716,"_31422":64717,"_3630":64718},[],"/docs/pr-preview/pr-58/platform/pki/crl#crl-settings","CRL settings",{"_4190":2137,"_34937":2134,"_5":35369,"_23830":64720,"_31422":64721,"_3630":64722},[],"/docs/pr-preview/pr-58/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_4190":2138,"_34937":2134,"_5":35369,"_23830":64724,"_31422":64725,"_3630":64726},[],"/docs/pr-preview/pr-58/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_4190":2139,"_34937":2134,"_5":35369,"_23830":64728,"_31422":64729,"_3630":64730},[],"/docs/pr-preview/pr-58/platform/pki/crl#crl-contents","CRL contents",{"_4190":2140,"_34937":2134,"_5":35369,"_23830":64732,"_31422":64733,"_3630":64734},[],"/docs/pr-preview/pr-58/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_4190":2141,"_34937":2134,"_5":35369,"_23830":64736,"_31422":64737,"_3630":64738},[],"/docs/pr-preview/pr-58/platform/pki/crl#crl-settings-api","CRL settings API",{"_4190":2142,"_34937":2134,"_5":35369,"_23830":64740,"_31422":64741,"_3630":64742},[],"/docs/pr-preview/pr-58/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_4190":2143,"_34937":2134,"_5":35369,"_23830":64744,"_31422":64745,"_3630":64746},[],"/docs/pr-preview/pr-58/platform/pki/crl#from-the-interface","From the interface",{"_4190":2144,"_34937":2134,"_5":35369,"_23830":64748,"_31422":64749,"_3630":64750},[],"/docs/pr-preview/pr-58/platform/pki/crl#references","References",{"_4190":2145,"_34937":2134,"_23830":64752,"_5":16479,"_31422":2134,"_3630":64753},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_4190":2146,"_34937":2134,"_23830":64755,"_5":16479,"_31422":64717,"_3630":64756},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_4190":2147,"_34937":2134,"_23830":64758,"_5":16479,"_31422":64717,"_3630":64759},[],"Field",{"_4190":2148,"_34937":2134,"_23830":64761,"_5":16479,"_31422":64717,"_3630":58452},[],{"_4190":2149,"_34937":2134,"_23830":64763,"_5":16479,"_31422":64717,"_3630":64764},[],"`ca_id`",{"_4190":2150,"_34937":2134,"_23830":64766,"_5":16479,"_31422":64717,"_3630":64767},[],"ID of the CA the settings belong to.",{"_4190":2151,"_34937":2134,"_23830":64769,"_5":16479,"_31422":64717,"_3630":64770},[],"`status`",{"_4190":2152,"_34937":2134,"_23830":64772,"_5":16479,"_31422":64717,"_3630":64773},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_4190":2153,"_34937":2134,"_23830":64775,"_5":16479,"_31422":64717,"_3630":64776},[],"`legacy_ski`",{"_4190":2154,"_34937":2134,"_23830":64778,"_5":16479,"_31422":64717,"_3630":64779},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_4190":2155,"_34937":2134,"_23830":64781,"_5":16479,"_31422":64717,"_3630":64782},[],"`latest_crl`",{"_4190":2156,"_34937":2134,"_23830":64784,"_5":16479,"_31422":64717,"_3630":64785},[],"Version, validity start and end of the last published list. Read-only.",{"_4190":2157,"_34937":2134,"_23830":64787,"_5":16479,"_31422":64717,"_3630":64788},[],"`crl_options` field",{"_4190":2158,"_34937":2134,"_23830":64790,"_5":16479,"_31422":64717,"_3630":58452},[],{"_4190":2159,"_34937":2134,"_23830":64792,"_5":16479,"_31422":64717,"_3630":64793},[],"Initial value",{"_4190":2160,"_34937":2134,"_23830":64795,"_5":16479,"_31422":64717,"_3630":64796},[],"`validity`",{"_4190":2161,"_34937":2134,"_23830":64798,"_5":16479,"_31422":64717,"_3630":64799},[],"Time from `thisUpdate` to `nextUpdate`.",{"_4190":2162,"_34937":2134,"_23830":64801,"_5":16479,"_31422":64717,"_3630":64802},[],"7 days.",{"_4190":2163,"_34937":2134,"_23830":64804,"_5":16479,"_31422":64717,"_3630":64805},[],"`refresh_interval`",{"_4190":2164,"_34937":2134,"_23830":64807,"_5":16479,"_31422":64717,"_3630":64808},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_4190":2165,"_34937":2134,"_23830":64810,"_5":16479,"_31422":64717,"_3630":64811},[],"6 days and 23 hours.",{"_4190":2166,"_34937":2134,"_23830":64813,"_5":16479,"_31422":64717,"_3630":64814},[],"`regenerate_on_revoke`",{"_4190":2167,"_34937":2134,"_23830":64816,"_5":16479,"_31422":64717,"_3630":64817},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_4190":2168,"_34937":2134,"_23830":64819,"_5":16479,"_31422":64717,"_3630":64820},[],"`true`.",{"_4190":2169,"_34937":2134,"_23830":64822,"_5":16479,"_31422":64717,"_3630":64823},[],"`signer_serial_number`",{"_4190":2170,"_34937":2134,"_23830":64825,"_5":16479,"_31422":64717,"_3630":64826},[],"Serial number of the existing certificate that signs the CRL.",{"_4190":2171,"_34937":2134,"_23830":64828,"_5":16479,"_31422":64717,"_3630":64829},[],"Serial number of the CA’s current certificate.",{"_4190":2172,"_34937":2134,"_23830":64831,"_5":16479,"_31422":64717,"_3630":64832},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_4190":2173,"_34937":2134,"_23830":64834,"_5":16479,"_31422":64717,"_3630":64835},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_4190":2174,"_34937":2134,"_23830":64837,"_5":16479,"_31422":64717,"_3630":64838},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_4190":2175,"_34937":2134,"_23830":64840,"_5":16479,"_31422":64717,"_3630":64841},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_4190":2176,"_34937":2134,"_23830":64843,"_5":16479,"_31422":64717,"_3630":64844},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_4190":2177,"_34937":2134,"_23830":64846,"_5":16479,"_31422":64717,"_3630":64847},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_4190":2178,"_34937":2134,"_23830":64849,"_5":16479,"_31422":64717,"_3630":64850},[],"Adjust validity and signer before deleting a CA.",{"_4190":2179,"_34937":2134,"_23830":64852,"_5":16479,"_31422":64717,"_3630":64853},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_4190":2180,"_34937":2134,"_23830":64855,"_5":16479,"_31422":64717,"_3630":64856},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_4190":2181,"_34937":2134,"_23830":64858,"_5":16479,"_31422":64717,"_3630":64859},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_4190":2182,"_34937":2134,"_23830":64861,"_5":16479,"_31422":64721,"_3630":64862},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_4190":2183,"_34937":2134,"_23830":64864,"_5":16479,"_31422":64721,"_3630":64865},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_4190":2184,"_34937":2134,"_23830":64867,"_5":16479,"_31422":64721,"_3630":64868},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_4190":2185,"_34937":2134,"_23830":64870,"_5":16479,"_31422":64721,"_3630":64871},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_4190":2186,"_34937":2134,"_23830":64873,"_5":16479,"_31422":64725,"_3630":64874},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_4190":2187,"_34937":2134,"_23830":64876,"_5":16479,"_31422":64725,"_3630":64877},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_4190":2188,"_34937":2134,"_23830":64879,"_5":16479,"_31422":64725,"_3630":64880},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_4190":2189,"_34937":2134,"_23830":64882,"_5":16479,"_31422":64725,"_3630":64883},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_4190":2190,"_34937":2134,"_23830":64885,"_5":16479,"_31422":64725,"_3630":64886},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_4190":2191,"_34937":2134,"_23830":64888,"_5":16479,"_31422":64725,"_3630":64889},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_4190":2192,"_34937":2134,"_23830":64891,"_5":16479,"_31422":64725,"_3630":64892},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_4190":2193,"_34937":2134,"_23830":64894,"_5":16479,"_31422":64725,"_3630":64895},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_4190":2194,"_34937":2134,"_23830":64897,"_5":16479,"_31422":64725,"_3630":64898},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_4190":2195,"_34937":2134,"_23830":64900,"_5":16479,"_31422":64729,"_3630":64901},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_4190":2196,"_34937":2134,"_23830":64903,"_5":16479,"_31422":64729,"_3630":64904},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_4190":2197,"_34937":2134,"_23830":64906,"_5":16479,"_31422":64733,"_3630":64907},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_4190":2198,"_34937":2134,"_23830":64909,"_5":16479,"_31422":64733,"_3630":64910},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_4190":2199,"_34937":2134,"_23830":64912,"_5":16479,"_31422":64733,"_3630":64913},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_4190":2200,"_34937":2134,"_23830":64915,"_5":16479,"_31422":64733,"_3630":64916},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_4190":2201,"_34937":2134,"_23830":64918,"_5":16479,"_31422":64733,"_3630":64919},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_4190":2202,"_34937":2134,"_23830":64921,"_5":16479,"_31422":64737,"_3630":64922},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_4190":2203,"_34937":2134,"_23830":64924,"_5":16479,"_31422":64737,"_3630":61307},[],{"_4190":2204,"_34937":2134,"_23830":64926,"_5":16479,"_31422":64737,"_3630":64927},[],"Relative path",{"_4190":2205,"_34937":2134,"_23830":64929,"_5":16479,"_31422":64737,"_3630":61304},[],{"_4190":2206,"_34937":2134,"_23830":64931,"_5":16479,"_31422":64737,"_3630":64932},[],"`GET`",{"_4190":2207,"_34937":2134,"_23830":64934,"_5":16479,"_31422":64737,"_3630":64935},[],"`/v1/crl-settings`",{"_4190":2208,"_34937":2134,"_23830":64937,"_5":16479,"_31422":64737,"_3630":64938},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_4190":2209,"_34937":2134,"_23830":64940,"_5":16479,"_31422":64737,"_3630":64932},[],{"_4190":2210,"_34937":2134,"_23830":64942,"_5":16479,"_31422":64737,"_3630":64943},[],"`/v1/crl-settings/{ca-id}`",{"_4190":2211,"_34937":2134,"_23830":64945,"_5":16479,"_31422":64737,"_3630":64946},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_4190":2212,"_34937":2134,"_23830":64948,"_5":16479,"_31422":64737,"_3630":64949},[],"`PUT`",{"_4190":2213,"_34937":2134,"_23830":64951,"_5":16479,"_31422":64737,"_3630":64943},[],{"_4190":2214,"_34937":2134,"_23830":64953,"_5":16479,"_31422":64737,"_3630":64954},[],"Replace the CRL configuration of a CA.",{"_4190":2215,"_34937":2134,"_23830":64956,"_5":16479,"_31422":64737,"_3630":64957},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_4190":2216,"_34937":2134,"_23830":64959,"_5":16479,"_31422":64737,"_3630":64960},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_4190":2217,"_34937":2134,"_23830":64962,"_5":16479,"_31422":64741,"_3630":64963},[],"Symptom",{"_4190":2218,"_34937":2134,"_23830":64965,"_5":16479,"_31422":64741,"_3630":64966},[],"Cause",{"_4190":2219,"_34937":2134,"_23830":64968,"_5":16479,"_31422":64741,"_3630":64969},[],"Action",{"_4190":2220,"_34937":2134,"_23830":64971,"_5":16479,"_31422":64741,"_3630":64972},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_4190":2221,"_34937":2134,"_23830":64974,"_5":16479,"_31422":64741,"_3630":64975},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_4190":2222,"_34937":2134,"_23830":64977,"_5":16479,"_31422":64741,"_3630":64978},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_4190":2223,"_34937":2134,"_23830":64980,"_5":16479,"_31422":64741,"_3630":64981},[],"`PUT` returns 400.",{"_4190":2224,"_34937":2134,"_23830":64983,"_5":16479,"_31422":64741,"_3630":64984},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_4190":2225,"_34937":2134,"_23830":64986,"_5":16479,"_31422":64741,"_3630":64987},[],"Set the serial number of a valid certificate of that CA.",{"_4190":2226,"_34937":2134,"_23830":64989,"_5":16479,"_31422":64741,"_3630":64990},[],"`PUT` returns 404.",{"_4190":2227,"_34937":2134,"_23830":64992,"_5":16479,"_31422":64741,"_3630":64993},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_4190":2228,"_34937":2134,"_23830":64995,"_5":16479,"_31422":64741,"_3630":64996},[],"Check the CA ID and the signer serial number.",{"_4190":2229,"_34937":2134,"_23830":64998,"_5":16479,"_31422":64741,"_3630":64999},[],"`PUT` returns 400 from a 3.x client.",{"_4190":2230,"_34937":2134,"_23830":65001,"_5":16479,"_31422":64741,"_3630":65002},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_4190":2231,"_34937":2134,"_23830":65004,"_5":16479,"_31422":64741,"_3630":65005},[],"Update the client to send the new field.",{"_4190":2232,"_34937":2134,"_23830":65007,"_5":16479,"_31422":64741,"_3630":65008},[],"The CRL does not change after revoking a certificate.",{"_4190":2233,"_34937":2134,"_23830":65010,"_5":16479,"_31422":64741,"_3630":65011},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_4190":2234,"_34937":2134,"_23830":65013,"_5":16479,"_31422":64741,"_3630":65014},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_4190":2235,"_34937":2134,"_23830":65016,"_5":16479,"_31422":64741,"_3630":65017},[],"A verifier rejects the CRL because of the issuer.",{"_4190":2236,"_34937":2134,"_23830":65019,"_5":16479,"_31422":64741,"_3630":65020},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_4190":2237,"_34937":2134,"_23830":65022,"_5":16479,"_31422":64741,"_3630":65023},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_4190":2238,"_34937":2134,"_23830":65025,"_5":16479,"_31422":64745,"_3630":65026},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_4190":2239,"_34937":2134,"_23830":65028,"_5":16479,"_31422":64749,"_3630":65029},[],"RFC 5280: X.509 and CRL profile.",{"_4190":2240,"_34937":2134,"_23830":65031,"_5":16479,"_31422":64749,"_3630":65032},[],"OpenSSL: openssl-crl.",{"_4190":2241,"_34937":2134,"_23830":65034,"_5":16479,"_31422":64749,"_3630":65035},[],"OpenSSL: openssl-verify.",{"_4190":2242,"_34937":2134,"_23830":65037,"_5":16479,"_31422":64749,"_3630":65038},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_4190":2243,"_34937":2134,"_23830":65040,"_5":16479,"_31422":64749,"_3630":65041},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_4190":2244,"_34937":2244,"_5":16871,"_3630":65043,"_35372":65044,"_23830":65045,"_31422":2244},"Keys and cryptographic engines",[58062,59537,63542,63543],[],{"_4190":2245,"_34937":2244,"_23830":65047,"_5":16479,"_31422":2244,"_3630":65048},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_4190":2246,"_34937":2244,"_5":35369,"_23830":65050,"_31422":65051,"_3630":65052},[],"/docs/pr-preview/pr-58/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_4190":2247,"_34937":2244,"_5":35369,"_23830":65054,"_31422":65055,"_3630":65056},[],"/docs/pr-preview/pr-58/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_4190":2248,"_34937":2244,"_5":35369,"_23830":65058,"_31422":65059,"_3630":65060},[],"/docs/pr-preview/pr-58/platform/pki/key-management#file-system","File System",{"_4190":2249,"_34937":2244,"_5":35369,"_23830":65062,"_31422":65063,"_3630":65064},[],"/docs/pr-preview/pr-58/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_4190":2250,"_34937":2244,"_5":35369,"_23830":65066,"_31422":65067,"_3630":65068},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_4190":2251,"_34937":2244,"_5":35369,"_23830":65070,"_31422":65071,"_3630":65072},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-kms","AWS KMS",{"_4190":2252,"_34937":2244,"_5":35369,"_23830":65074,"_31422":65075,"_3630":65076},[],"/docs/pr-preview/pr-58/platform/pki/key-management#pkcs11","PKCS#11",{"_4190":2253,"_34937":2244,"_5":35369,"_23830":65078,"_31422":65079,"_3630":65080},[],"/docs/pr-preview/pr-58/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_4190":2254,"_34937":2244,"_5":35369,"_23830":65082,"_31422":65083,"_3630":65084},[],"/docs/pr-preview/pr-58/platform/pki/key-management#key-inventory","Key inventory",{"_4190":2255,"_34937":2244,"_5":35369,"_23830":65086,"_31422":65087,"_3630":65088},[],"/docs/pr-preview/pr-58/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_4190":2256,"_34937":2244,"_5":35369,"_23830":65090,"_31422":65091,"_3630":65092},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_4190":2257,"_34937":2244,"_5":35369,"_23830":65094,"_31422":65095,"_3630":65096},[],"/docs/pr-preview/pr-58/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_4190":2258,"_34937":2244,"_5":35369,"_23830":65098,"_31422":65099,"_3630":65100},[],"/docs/pr-preview/pr-58/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_4190":2259,"_34937":2244,"_5":35369,"_23830":65102,"_31422":65103,"_3630":65104},[],"/docs/pr-preview/pr-58/platform/pki/key-management#view-details","View details",{"_4190":2260,"_34937":2244,"_5":35369,"_23830":65106,"_31422":65107,"_3630":65108},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-and-verify","Sign and verify",{"_4190":2261,"_34937":2244,"_5":35369,"_23830":65110,"_31422":65111,"_3630":65112},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign","Sign",{"_4190":2262,"_34937":2244,"_5":35369,"_23830":65114,"_31422":65115,"_3630":65116},[],"/docs/pr-preview/pr-58/platform/pki/key-management#verify","Verify",{"_4190":2263,"_34937":2244,"_5":35369,"_23830":65118,"_31422":65119,"_3630":65120},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_4190":2264,"_34937":2244,"_5":35369,"_23830":65122,"_31422":65123,"_3630":65124},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_4190":2265,"_34937":2244,"_5":35369,"_23830":65126,"_31422":65127,"_3630":65128},[],"/docs/pr-preview/pr-58/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_4190":2266,"_34937":2244,"_23830":65130,"_5":16479,"_31422":2244,"_3630":65131},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_4190":2267,"_34937":2244,"_23830":65133,"_5":16479,"_31422":2244,"_3630":65134},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_4190":2268,"_34937":2244,"_23830":65136,"_5":16479,"_31422":65051,"_3630":65137},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_4190":2269,"_34937":2244,"_23830":65139,"_5":16479,"_31422":65051,"_3630":65140},[],"In practice, it lets you:",{"_4190":2270,"_34937":2244,"_23830":65142,"_5":16479,"_31422":65051,"_3630":65143},[],"Generate new key pairs from Lamassu IoT.",{"_4190":2271,"_34937":2244,"_23830":65145,"_5":16479,"_31422":65051,"_3630":65146},[],"Import keys created externally.",{"_4190":2272,"_34937":2244,"_23830":65148,"_5":16479,"_31422":65051,"_3630":65149},[],"Delegate custody and cryptographic operations to external engines.",{"_4190":2273,"_34937":2244,"_23830":65151,"_5":16479,"_31422":65051,"_3630":65152},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_4190":2274,"_34937":2244,"_23830":65154,"_5":16479,"_31422":65055,"_3630":65155},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_4190":2275,"_34937":2244,"_23830":65157,"_5":16479,"_31422":65055,"_3630":65158},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_4190":2276,"_34937":2244,"_23830":65160,"_5":16479,"_31422":65055,"_3630":65161},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_4190":2277,"_34937":2244,"_23830":65163,"_5":16479,"_31422":65059,"_3630":65164},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_4190":2278,"_34937":2244,"_23830":65166,"_5":16479,"_31422":65063,"_3630":65167},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_4190":2279,"_34937":2244,"_23830":65169,"_5":16479,"_31422":65063,"_3630":65170},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_4190":2280,"_34937":2244,"_23830":65172,"_5":16479,"_31422":65067,"_3630":65173},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_4190":2281,"_34937":2244,"_23830":65175,"_5":16479,"_31422":65071,"_3630":65176},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_4190":2282,"_34937":2244,"_23830":65178,"_5":16479,"_31422":65075,"_3630":65179},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_4190":2283,"_34937":2244,"_23830":65181,"_5":16479,"_31422":65079,"_3630":65182},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_4190":2284,"_34937":2244,"_23830":65184,"_5":16479,"_31422":65079,"_3630":65185},[],"Lamassu shows the enabled engines in the console.",{"_4190":2285,"_34937":2244,"_23830":65187,"_5":16479,"_31422":65079,"_3630":65188},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_4190":2286,"_34937":2244,"_23830":65190,"_5":16479,"_31422":65079,"_3630":65191},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_4190":2287,"_34937":2244,"_23830":65193,"_5":16479,"_31422":65083,"_3630":65194},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_4190":2288,"_34937":2244,"_23830":65196,"_5":16479,"_31422":65083,"_3630":65197},[],"The table includes the following fields:",{"_4190":2289,"_34937":2244,"_23830":65199,"_5":16479,"_31422":65083,"_3630":65200},[],"**Name**: descriptive name of the key.",{"_4190":2290,"_34937":2244,"_23830":65202,"_5":16479,"_31422":65083,"_3630":65203},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_4190":2291,"_34937":2244,"_23830":65205,"_5":16479,"_31422":65083,"_3630":65206},[],"**Strength**: visual indicator of cryptographic strength.",{"_4190":2292,"_34937":2244,"_23830":65208,"_5":16479,"_31422":65083,"_3630":65209},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_4190":2293,"_34937":2244,"_23830":65211,"_5":16479,"_31422":65083,"_3630":65212},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_4190":2294,"_34937":2244,"_23830":65214,"_5":16479,"_31422":65083,"_3630":65215},[],"**Aliases**: alternative names associated with the key.",{"_4190":2295,"_34937":2244,"_23830":65217,"_5":16479,"_31422":65083,"_3630":65218},[],"**Tags**: labels for classification and search.",{"_4190":2296,"_34937":2244,"_23830":65220,"_5":16479,"_31422":65083,"_3630":65221},[],"**Related Entities**: certificates or other entities linked to that key.",{"_4190":2297,"_34937":2244,"_23830":65223,"_5":16479,"_31422":65083,"_3630":65224},[],"From this view you also reach the most common actions:",{"_4190":2298,"_34937":2244,"_23830":65226,"_5":16479,"_31422":65083,"_3630":65227},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_4190":2299,"_34937":2244,"_23830":65229,"_5":16479,"_31422":65083,"_3630":65230},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_4190":2300,"_34937":2244,"_23830":65232,"_5":16479,"_31422":65083,"_3630":65233},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_4190":2301,"_34937":2244,"_23830":65235,"_5":16479,"_31422":65083,"_3630":65236},[],"**Delete Key** to remove the key from the system.",{"_4190":2302,"_34937":2244,"_23830":65238,"_5":16479,"_31422":65087,"_3630":65239},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_4190":2303,"_34937":2244,"_23830":65241,"_5":16479,"_31422":65091,"_3630":65242},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_4190":2304,"_34937":2244,"_23830":65244,"_5":16479,"_31422":65091,"_3630":65245},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_4190":2305,"_34937":2244,"_23830":65247,"_5":16479,"_31422":65091,"_3630":65248},[],"**Key Name**: unique and descriptive name.",{"_4190":2306,"_34937":2244,"_23830":65250,"_5":16479,"_31422":65091,"_3630":65251},[],"**Crypto Engine**: engine that will keep the key.",{"_4190":2307,"_34937":2244,"_23830":65253,"_5":16479,"_31422":65091,"_3630":65254},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_4190":2308,"_34937":2244,"_23830":65256,"_5":16479,"_31422":65091,"_3630":65257},[],"**Tags**: metadata to classify the key.",{"_4190":2309,"_34937":2244,"_23830":65259,"_5":16479,"_31422":65091,"_3630":65260},[],"**Metadata**: additional information for advanced uses.",{"_4190":2310,"_34937":2244,"_23830":65262,"_5":16479,"_31422":65095,"_3630":65263},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_4190":2311,"_34937":2244,"_23830":65265,"_5":16479,"_31422":65095,"_3630":65266},[],"When you have an exportable private key and the destination engine supports import.",{"_4190":2312,"_34937":2244,"_23830":65268,"_5":16479,"_31422":65095,"_3630":65269},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_4190":2313,"_34937":2244,"_23830":65271,"_5":16479,"_31422":65095,"_3630":65272},[],"When Lamassu must operate with a root of trust created by a third party.",{"_4190":2314,"_34937":2244,"_23830":65274,"_5":16479,"_31422":65095,"_3630":65275},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_4190":2315,"_34937":2244,"_23830":65277,"_5":16479,"_31422":65095,"_3630":65278},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_4190":2316,"_34937":2244,"_23830":65280,"_5":16479,"_31422":65095,"_3630":65281},[],"**Crypto Engine**: engine that will keep the imported key.",{"_4190":2317,"_34937":2244,"_23830":65283,"_5":16479,"_31422":65095,"_3630":65284},[],"**Tags**: labels for organization and search.",{"_4190":2318,"_34937":2244,"_23830":65286,"_5":16479,"_31422":65095,"_3630":65287},[],"**Metadata**: additional optional information.",{"_4190":2319,"_34937":2244,"_23830":65289,"_5":16479,"_31422":65095,"_3630":65290},[],"**Private Key (PEM)**: private key in PEM format.",{"_4190":2320,"_34937":2244,"_23830":65292,"_5":16479,"_31422":65095,"_3630":65293},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_4190":2321,"_34937":2244,"_23830":65295,"_5":16479,"_31422":65099,"_3630":65296},[],"Each registered key has a detail view and several operational actions.",{"_4190":2322,"_34937":2244,"_23830":65298,"_5":16479,"_31422":65103,"_3630":65299},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_4190":2323,"_34937":2244,"_23830":65301,"_5":16479,"_31422":65103,"_3630":65302},[],"The **Overview** tab shows, among others, these fields:",{"_4190":2324,"_34937":2244,"_23830":65304,"_5":16479,"_31422":65103,"_3630":65305},[],"**Key Name**: descriptive name.",{"_4190":2325,"_34937":2244,"_23830":65307,"_5":16479,"_31422":65103,"_3630":65308},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_4190":2326,"_34937":2244,"_23830":65310,"_5":16479,"_31422":65103,"_3630":65311},[],"**Tags**: associated labels.",{"_4190":2327,"_34937":2244,"_23830":65313,"_5":16479,"_31422":65103,"_3630":65314},[],"**Aliases**: alternative names.",{"_4190":2328,"_34937":2244,"_23830":65316,"_5":16479,"_31422":65103,"_3630":65317},[],"**Crypto Engine**: engine where the key resides.",{"_4190":2329,"_34937":2244,"_23830":65319,"_5":16479,"_31422":65103,"_3630":65320},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_4190":2330,"_34937":2244,"_23830":65322,"_5":16479,"_31422":65103,"_3630":65323},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_4190":2331,"_34937":2244,"_23830":65325,"_5":16479,"_31422":65103,"_3630":65326},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_4190":2332,"_34937":2244,"_23830":65328,"_5":16479,"_31422":65107,"_3630":65329},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_4190":2333,"_34937":2244,"_23830":65331,"_5":16479,"_31422":65107,"_3630":65332},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_4190":2334,"_34937":2244,"_23830":65334,"_5":16479,"_31422":65107,"_3630":65335},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_4190":2335,"_34937":2244,"_23830":65337,"_5":16479,"_31422":65111,"_3630":65338},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_4190":2336,"_34937":2244,"_23830":65340,"_5":16479,"_31422":65111,"_3630":65341},[],"Main fields:",{"_4190":2337,"_34937":2244,"_23830":65343,"_5":16479,"_31422":65111,"_3630":65344},[],"**Algorithm**: signing algorithm available for the key type.",{"_4190":2338,"_34937":2244,"_23830":65346,"_5":16479,"_31422":65111,"_3630":65347},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_4190":2339,"_34937":2244,"_23830":65349,"_5":16479,"_31422":65111,"_3630":65350},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_4190":2340,"_34937":2244,"_23830":65352,"_5":16479,"_31422":65111,"_3630":65353},[],"**Message**: content to sign.",{"_4190":2341,"_34937":2244,"_23830":65355,"_5":16479,"_31422":65111,"_3630":65356},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_4190":2342,"_34937":2244,"_23830":65358,"_5":16479,"_31422":65115,"_3630":65359},[],"This tab checks whether a signature corresponds to the associated public key.",{"_4190":2343,"_34937":2244,"_23830":65361,"_5":16479,"_31422":65115,"_3630":65341},[],{"_4190":2344,"_34937":2244,"_23830":65363,"_5":16479,"_31422":65115,"_3630":65364},[],"**Algorithm**: must match the algorithm used for the signature.",{"_4190":2345,"_34937":2244,"_23830":65366,"_5":16479,"_31422":65115,"_3630":65367},[],"**Message Type**: `Raw` or `Digest`.",{"_4190":2346,"_34937":2244,"_23830":65369,"_5":16479,"_31422":65115,"_3630":65370},[],"**Payload Encoding**: encoding of the message.",{"_4190":2347,"_34937":2244,"_23830":65372,"_5":16479,"_31422":65115,"_3630":65373},[],"**Message**: original message or hash.",{"_4190":2348,"_34937":2244,"_23830":65375,"_5":16479,"_31422":65115,"_3630":65376},[],"**Signature**: signature to check.",{"_4190":2349,"_34937":2244,"_23830":65378,"_5":16479,"_31422":65115,"_3630":65379},[],"**Result**: indicator of the validation result.",{"_4190":2350,"_34937":2244,"_23830":65381,"_5":16479,"_31422":65119,"_3630":65382},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_4190":2351,"_34937":2244,"_23830":65384,"_5":16479,"_31422":65119,"_3630":65385},[],"This flow is useful for:",{"_4190":2352,"_34937":2244,"_23830":65387,"_5":16479,"_31422":65119,"_3630":65388},[],"Requesting certificates from an external CA.",{"_4190":2353,"_34937":2244,"_23830":65390,"_5":16479,"_31422":65119,"_3630":65391},[],"Renewing an identity while keeping the same key.",{"_4190":2354,"_34937":2244,"_23830":65393,"_5":16479,"_31422":65119,"_3630":65394},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_4190":2355,"_34937":2244,"_23830":65396,"_5":16479,"_31422":65119,"_3630":65397},[],"**Common Name (CN)**: main name of the identity.",{"_4190":2356,"_34937":2244,"_23830":65399,"_5":16479,"_31422":65119,"_3630":65400},[],"**Organization (O)**: organization or company.",{"_4190":2357,"_34937":2244,"_23830":65402,"_5":16479,"_31422":65119,"_3630":65403},[],"**Organizational Unit (OU)**: department or unit.",{"_4190":2358,"_34937":2244,"_23830":65405,"_5":16479,"_31422":65119,"_3630":65406},[],"**Country (C)**: two-letter country code.",{"_4190":2359,"_34937":2244,"_23830":65408,"_5":16479,"_31422":65119,"_3630":65409},[],"**State / Province (ST)**: state or province.",{"_4190":2360,"_34937":2244,"_23830":65411,"_5":16479,"_31422":65119,"_3630":65412},[],"**Locality (L)**: city or locality.",{"_4190":2361,"_34937":2244,"_23830":65414,"_5":16479,"_31422":65119,"_3630":65415},[],"**Email Address**: contact email.",{"_4190":2362,"_34937":2244,"_23830":65417,"_5":16479,"_31422":65119,"_3630":65418},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_4190":2363,"_34937":2244,"_23830":65420,"_5":16479,"_31422":65119,"_3630":65421},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_4190":2364,"_34937":2244,"_23830":65423,"_5":16479,"_31422":65123,"_3630":65424},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_4190":2365,"_34937":2244,"_23830":65426,"_5":16479,"_31422":65123,"_3630":65427},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_4190":2366,"_34937":2244,"_23830":65429,"_5":16479,"_31422":65127,"_3630":65430},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_4190":2367,"_34937":2244,"_23830":65432,"_5":16479,"_31422":65127,"_3630":65433},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_4190":2368,"_34937":2368,"_5":16871,"_3630":65435,"_35372":65436,"_23830":65437,"_31422":2368},"Online validation with OCSP",[58062,59537,63542,64181],[],{"_4190":2369,"_34937":2368,"_23830":65439,"_5":16479,"_31422":2368,"_3630":65440},[],"Query signed status and verify the responder’s response.",{"_4190":2370,"_34937":2368,"_5":35369,"_23830":65442,"_31422":65443,"_3630":65444},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_4190":2371,"_34937":2368,"_5":35369,"_23830":65446,"_31422":65447,"_3630":65448},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_4190":2372,"_34937":2368,"_5":35369,"_23830":65450,"_31422":65451,"_3630":65452},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_4190":2373,"_34937":2368,"_5":35369,"_23830":65454,"_31422":65455,"_3630":65456},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_4190":2374,"_34937":2368,"_5":35369,"_23830":65458,"_31422":65459,"_3630":65460},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_4190":2375,"_34937":2368,"_5":35369,"_23830":65462,"_31422":65463,"_3630":64750},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#references",{"_4190":2376,"_34937":2368,"_23830":65465,"_5":16479,"_31422":2368,"_3630":65466},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_4190":2377,"_34937":2368,"_23830":65468,"_5":16479,"_31422":65443,"_3630":65469},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_4190":2378,"_34937":2368,"_23830":65471,"_5":16479,"_31422":65443,"_3630":65472},[],"Record status",{"_4190":2379,"_34937":2368,"_23830":65474,"_5":16479,"_31422":65443,"_3630":65475},[],"Signed response",{"_4190":2380,"_34937":2368,"_23830":65477,"_5":16479,"_31422":65443,"_3630":62679},[],{"_4190":2381,"_34937":2368,"_23830":65479,"_5":16479,"_31422":65443,"_3630":65480},[],"`Good`.",{"_4190":2382,"_34937":2368,"_23830":65482,"_5":16479,"_31422":65443,"_3630":62696},[],{"_4190":2383,"_34937":2368,"_23830":65484,"_5":16479,"_31422":65443,"_3630":65485},[],"`Revoked`, with revocation reason and timestamp.",{"_4190":2384,"_34937":2368,"_23830":65487,"_5":16479,"_31422":65443,"_3630":65488},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_4190":2385,"_34937":2368,"_23830":65490,"_5":16479,"_31422":65443,"_3630":65491},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_4190":2386,"_34937":2368,"_23830":65493,"_5":16479,"_31422":65443,"_3630":65494},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_4190":2387,"_34937":2368,"_23830":65496,"_5":16479,"_31422":65443,"_3630":65497},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_4190":2388,"_34937":2368,"_23830":65499,"_5":16479,"_31422":65443,"_3630":65500},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_4190":2389,"_34937":2368,"_23830":65502,"_5":16479,"_31422":65447,"_3630":65503},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_4190":2390,"_34937":2368,"_23830":65505,"_5":16479,"_31422":65447,"_3630":65506},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_4190":2391,"_34937":2368,"_23830":65508,"_5":16479,"_31422":65451,"_3630":65509},[],"The service accepts:",{"_4190":2392,"_34937":2368,"_23830":65511,"_5":16479,"_31422":65451,"_3630":61307},[],{"_4190":2393,"_34937":2368,"_23830":65513,"_5":16479,"_31422":65451,"_3630":65514},[],"VA service path",{"_4190":2394,"_34937":2368,"_23830":65516,"_5":16479,"_31422":65451,"_3630":65517},[],"Format",{"_4190":2395,"_34937":2368,"_23830":65519,"_5":16479,"_31422":65451,"_3630":65520},[],"`POST`",{"_4190":2396,"_34937":2368,"_23830":65522,"_5":16479,"_31422":65451,"_3630":65523},[],"`/ocsp`",{"_4190":2397,"_34937":2368,"_23830":65525,"_5":16479,"_31422":65451,"_3630":65526},[],"DER request, `Content-Type: application/ocsp-request`.",{"_4190":2398,"_34937":2368,"_23830":65528,"_5":16479,"_31422":65451,"_3630":64932},[],{"_4190":2399,"_34937":2368,"_23830":65530,"_5":16479,"_31422":65451,"_3630":65531},[],"`/ocsp/{ocsp_request}`",{"_4190":2400,"_34937":2368,"_23830":65533,"_5":16479,"_31422":65451,"_3630":65534},[],"DER request encoded using padded URL Base64.",{"_4190":2401,"_34937":2368,"_23830":65536,"_5":16479,"_31422":65451,"_3630":65537},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_4190":2402,"_34937":2368,"_23830":65539,"_5":16479,"_31422":65455,"_3630":65540},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_4190":2403,"_34937":2368,"_23830":65542,"_5":16479,"_31422":65455,"_3630":65543},[],"Generate the request:",{"_4190":2404,"_34937":2368,"_23830":65545,"_5":16479,"_31422":65455,"_3630":65546},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_4190":2405,"_34937":2368,"_23830":65548,"_5":16479,"_31422":65455,"_3630":65549},[],"Replace the example URL with the inspected endpoint:",{"_4190":2406,"_34937":2368,"_23830":65551,"_5":16479,"_31422":65455,"_3630":65552},[],"Verify the returned DER:",{"_4190":2407,"_34937":2368,"_23830":65554,"_5":16479,"_31422":65455,"_3630":65555},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_4190":2408,"_34937":2368,"_23830":65557,"_5":16479,"_31422":65459,"_3630":65558},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_4190":2409,"_34937":2368,"_23830":65560,"_5":16479,"_31422":65459,"_3630":65561},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_4190":2410,"_34937":2368,"_23830":65563,"_5":16479,"_31422":65463,"_3630":65564},[],"RFC 6960: OCSP.",{"_4190":2411,"_34937":2368,"_23830":65566,"_5":16479,"_31422":65463,"_3630":65567},[],"OpenSSL: openssl-ocsp.",{"_4190":2412,"_34937":2368,"_23830":65569,"_5":16479,"_31422":65463,"_3630":65570},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_4190":2413,"_34937":2368,"_23830":65572,"_5":16479,"_31422":65463,"_3630":65041},[],{"_4190":2414,"_34937":2414,"_5":16871,"_3630":63542,"_35372":65574,"_23830":65575,"_31422":2414},[58062,59537,63542],[],{"_4190":2415,"_34937":2414,"_23830":65577,"_5":16479,"_31422":2414,"_3630":65578},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_4190":2416,"_34937":2414,"_5":35369,"_23830":65580,"_31422":65581,"_3630":62854},[],"/docs/pr-preview/pr-58/platform/pki/overview#start-here",{"_4190":2417,"_34937":2414,"_5":35369,"_23830":65583,"_31422":65584,"_3630":65585},[],"/docs/pr-preview/pr-58/platform/pki/overview#what-you-need","What you need",{"_4190":2418,"_34937":2414,"_5":35369,"_23830":65587,"_31422":65588,"_3630":63386},[],"/docs/pr-preview/pr-58/platform/pki/overview#core-capabilities",{"_4190":2419,"_34937":2414,"_5":35369,"_23830":65590,"_31422":65591,"_3630":63390},[],"/docs/pr-preview/pr-58/platform/pki/overview#build-your-trust-hierarchy",{"_4190":2420,"_34937":2414,"_5":35369,"_23830":65593,"_31422":65594,"_3630":63394},[],"/docs/pr-preview/pr-58/platform/pki/overview#protect-cryptographic-keys",{"_4190":2421,"_34937":2414,"_5":35369,"_23830":65596,"_31422":65597,"_3630":63398},[],"/docs/pr-preview/pr-58/platform/pki/overview#issue-and-control-certificates",{"_4190":2422,"_34937":2414,"_5":35369,"_23830":65599,"_31422":65600,"_3630":63406},[],"/docs/pr-preview/pr-58/platform/pki/overview#publish-validation-status",{"_4190":2423,"_34937":2414,"_5":35369,"_23830":65602,"_31422":65603,"_3630":65604},[],"/docs/pr-preview/pr-58/platform/pki/overview#how-to-check-the-result","How to check the result",{"_4190":2424,"_34937":2414,"_5":35369,"_23830":65606,"_31422":65607,"_3630":64348},[],"/docs/pr-preview/pr-58/platform/pki/overview#continue",{"_4190":2425,"_34937":2414,"_23830":65609,"_5":16479,"_31422":2414,"_3630":65610},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_4190":2426,"_34937":2414,"_23830":65612,"_5":16479,"_31422":65581,"_3630":65613},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_4190":2427,"_34937":2414,"_23830":65615,"_5":16479,"_31422":65581,"_3630":65616},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_4190":2428,"_34937":2414,"_23830":65618,"_5":16479,"_31422":65584,"_3630":65619},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_4190":2429,"_34937":2414,"_23830":65621,"_5":16479,"_31422":65584,"_3630":65622},[],"An available cryptographic engine to keep the authority's key.",{"_4190":2430,"_34937":2414,"_23830":65624,"_5":16479,"_31422":65584,"_3630":65625},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_4190":2431,"_34937":2414,"_23830":65627,"_5":16479,"_31422":65584,"_3630":65628},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_4190":2432,"_34937":2414,"_23830":65630,"_5":16479,"_31422":65584,"_3630":65631},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_4190":2433,"_34937":2414,"_23830":65633,"_5":16479,"_31422":65591,"_3630":65634},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_4190":2434,"_34937":2414,"_23830":65636,"_5":16479,"_31422":65594,"_3630":65637},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_4190":2435,"_34937":2414,"_23830":65639,"_5":16479,"_31422":65597,"_3630":65640},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_4190":2436,"_34937":2414,"_23830":65642,"_5":16479,"_31422":65600,"_3630":65643},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_4190":2437,"_34937":2414,"_23830":65645,"_5":16479,"_31422":65603,"_3630":65646},[],"An active certificate in the console is one part of the check. Also verify that:",{"_4190":2438,"_34937":2414,"_23830":65648,"_5":16479,"_31422":65603,"_3630":65649},[],"its subject and extensions identify the expected client;",{"_4190":2439,"_34937":2414,"_23830":65651,"_5":16479,"_31422":65603,"_3630":65652},[],"its public key matches the client's private key;",{"_4190":2440,"_34937":2414,"_23830":65654,"_5":16479,"_31422":65603,"_3630":65655},[],"its chain reaches a root trusted by the consumer;",{"_4190":2441,"_34937":2414,"_23830":65657,"_5":16479,"_31422":65603,"_3630":65658},[],"its dates and usages allow the operation;",{"_4190":2442,"_34937":2414,"_23830":65660,"_5":16479,"_31422":65603,"_3630":65661},[],"the consumer applies revocation checks and authorization.",{"_4190":2443,"_34937":2414,"_23830":65663,"_5":16479,"_31422":65603,"_3630":65664},[],"The issuance path includes the first independent checks.",{"_4190":2444,"_34937":2414,"_23830":65666,"_5":16479,"_31422":65607,"_3630":65667},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4190":2445,"_34937":2414,"_23830":65669,"_5":16479,"_31422":65607,"_3630":65670},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_4190":2446,"_34937":2414,"_23830":65672,"_5":16479,"_31422":65607,"_3630":65673},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_4190":2447,"_34937":2447,"_5":16871,"_3630":65675,"_35372":65676,"_23830":65677,"_31422":2447},"Create your first CA",[58062,59537,63542,62979],[],{"_4190":2448,"_34937":2447,"_23830":65679,"_5":16479,"_31422":2447,"_3630":65680},[],"Create an evaluation root and check its certificate before issuing.",{"_4190":2449,"_34937":2447,"_5":35369,"_23830":65682,"_31422":65683,"_3630":58072},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_4190":2450,"_34937":2447,"_5":35369,"_23830":65685,"_31422":65686,"_3630":65687},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_4190":2451,"_34937":2447,"_5":35369,"_23830":65689,"_31422":65690,"_3630":65691},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_4190":2452,"_34937":2447,"_5":35369,"_23830":65693,"_31422":65694,"_3630":65695},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_4190":2453,"_34937":2447,"_5":35369,"_23830":65697,"_31422":65698,"_3630":65699},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_4190":2454,"_34937":2447,"_5":35369,"_23830":65701,"_31422":65702,"_3630":65703},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_4190":2455,"_34937":2447,"_5":35369,"_23830":65705,"_31422":65706,"_3630":65707},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_4190":2456,"_34937":2447,"_5":35369,"_23830":65709,"_31422":65710,"_3630":63236},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_4190":2457,"_34937":2447,"_5":35369,"_23830":65712,"_31422":65713,"_3630":58096},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#next-step",{"_4190":2458,"_34937":2447,"_23830":65715,"_5":16479,"_31422":2447,"_3630":65716},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_4190":2459,"_34937":2447,"_23830":65718,"_5":16479,"_31422":65683,"_3630":65719},[],"Console access and permission to create keys and authorities.",{"_4190":2460,"_34937":2447,"_23830":65721,"_5":16479,"_31422":65683,"_3630":65722},[],"An available cryptographic engine that supports the chosen algorithm.",{"_4190":2461,"_34937":2447,"_23830":65724,"_5":16479,"_31422":65683,"_3630":65725},[],"OpenSSL 3.x to check the downloaded certificate.",{"_4190":2462,"_34937":2447,"_23830":65727,"_5":16479,"_31422":65683,"_3630":65728},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_4190":2463,"_34937":2447,"_23830":65730,"_5":16479,"_31422":65686,"_3630":65731},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_4190":2464,"_34937":2447,"_23830":65733,"_5":16479,"_31422":65686,"_3630":65734},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_4190":2465,"_34937":2447,"_23830":65736,"_5":16479,"_31422":65690,"_3630":65737},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_4190":2466,"_34937":2447,"_23830":65739,"_5":16479,"_31422":65690,"_3630":65740},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_4190":2467,"_34937":2447,"_23830":65742,"_5":16479,"_31422":65694,"_3630":65743},[],"Select **Root CA** and complete:",{"_4190":2468,"_34937":2447,"_23830":65745,"_5":16479,"_31422":65694,"_3630":65746},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_4190":2469,"_34937":2447,"_23830":65748,"_5":16479,"_31422":65694,"_3630":65749},[],"**Subject**: organization and country details for your evaluation.",{"_4190":2470,"_34937":2447,"_23830":65751,"_5":16479,"_31422":65694,"_3630":65752},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_4190":2471,"_34937":2447,"_23830":65754,"_5":16479,"_31422":65694,"_3630":65755},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_4190":2472,"_34937":2447,"_23830":65757,"_5":16479,"_31422":65694,"_3630":65758},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_4190":2473,"_34937":2447,"_23830":65760,"_5":16479,"_31422":65698,"_3630":65761},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_4190":2474,"_34937":2447,"_23830":65763,"_5":16479,"_31422":65702,"_3630":65764},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_4190":2475,"_34937":2447,"_23830":65766,"_5":16479,"_31422":65702,"_3630":65767},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_4190":2476,"_34937":2447,"_23830":65769,"_5":16479,"_31422":65706,"_3630":65770},[],"Run from the directory where you saved `ca.pem`:",{"_4190":2477,"_34937":2447,"_23830":65772,"_5":16479,"_31422":65706,"_3630":65773},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_4190":2478,"_34937":2447,"_23830":65775,"_5":16479,"_31422":65706,"_3630":65776},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_4190":2479,"_34937":2447,"_23830":65778,"_5":16479,"_31422":65710,"_3630":65779},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_4190":2480,"_34937":2447,"_23830":65781,"_5":16479,"_31422":65710,"_3630":65782},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_4190":2481,"_34937":2447,"_23830":65784,"_5":16479,"_31422":65710,"_3630":65785},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_4190":2482,"_34937":2447,"_23830":65787,"_5":16479,"_31422":65710,"_3630":65788},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_4190":2483,"_34937":2447,"_23830":65790,"_5":16479,"_31422":65713,"_3630":65791},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_4190":2484,"_34937":2484,"_5":16871,"_3630":65793,"_35372":65794,"_23830":65795,"_31422":2484},"Issue and verify a certificate",[58062,59537,63542,62979],[],{"_4190":2485,"_34937":2484,"_23830":65797,"_5":16479,"_31422":2484,"_3630":65798},[],"Issue a client certificate and check content, chain and key correspondence.",{"_4190":2486,"_34937":2484,"_5":35369,"_23830":65800,"_31422":65801,"_3630":58072},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_4190":2487,"_34937":2484,"_5":35369,"_23830":65803,"_31422":65804,"_3630":65805},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_4190":2488,"_34937":2484,"_5":35369,"_23830":65807,"_31422":65808,"_3630":65809},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_4190":2489,"_34937":2484,"_5":35369,"_23830":65811,"_31422":65812,"_3630":65813},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_4190":2490,"_34937":2484,"_5":35369,"_23830":65815,"_31422":65816,"_3630":65817},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_4190":2491,"_34937":2484,"_5":35369,"_23830":65819,"_31422":65820,"_3630":65821},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_4190":2492,"_34937":2484,"_5":35369,"_23830":65823,"_31422":65824,"_3630":65825},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_4190":2493,"_34937":2484,"_5":35369,"_23830":65827,"_31422":65828,"_3630":65829},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_4190":2494,"_34937":2484,"_5":35369,"_23830":65831,"_31422":65832,"_3630":65833},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_4190":2495,"_34937":2484,"_5":35369,"_23830":65835,"_31422":65836,"_3630":65837},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_4190":2496,"_34937":2484,"_5":35369,"_23830":65839,"_31422":65840,"_3630":63236},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_4190":2497,"_34937":2484,"_5":35369,"_23830":65842,"_31422":65843,"_3630":58096},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#next-step",{"_4190":2498,"_34937":2484,"_23830":65845,"_5":16479,"_31422":2484,"_3630":65846},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_4190":2499,"_34937":2484,"_23830":65848,"_5":16479,"_31422":65801,"_3630":65849},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_4190":2500,"_34937":2484,"_23830":65851,"_5":16479,"_31422":65801,"_3630":65852},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_4190":2501,"_34937":2484,"_23830":65854,"_5":16479,"_31422":65801,"_3630":65855},[],"OpenSSL 3.x and a working directory with restricted access.",{"_4190":2502,"_34937":2484,"_23830":65857,"_5":16479,"_31422":65801,"_3630":65858},[],"A client identifier: here we use `device-001`.",{"_4190":2503,"_34937":2484,"_23830":65860,"_5":16479,"_31422":65801,"_3630":65861},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_4190":2504,"_34937":2484,"_23830":65863,"_5":16479,"_31422":65804,"_3630":65864},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_4190":2505,"_34937":2484,"_23830":65866,"_5":16479,"_31422":65808,"_3630":65867},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_4190":2506,"_34937":2484,"_23830":65869,"_5":16479,"_31422":65808,"_3630":65870},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_4190":2507,"_34937":2484,"_23830":65872,"_5":16479,"_31422":65812,"_3630":65873},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_4190":2508,"_34937":2484,"_23830":65875,"_5":16479,"_31422":65812,"_3630":65876},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_4190":2509,"_34937":2484,"_23830":65878,"_5":16479,"_31422":65816,"_3630":65879},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_4190":2510,"_34937":2484,"_23830":65881,"_5":16479,"_31422":65816,"_3630":65882},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_4190":2511,"_34937":2484,"_23830":65884,"_5":16479,"_31422":65820,"_3630":65885},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_4190":2512,"_34937":2484,"_23830":65887,"_5":16479,"_31422":65824,"_3630":65888},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_4190":2513,"_34937":2484,"_23830":65890,"_5":16479,"_31422":65828,"_3630":65891},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_4190":2514,"_34937":2484,"_23830":65893,"_5":16479,"_31422":65832,"_3630":65894},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_4190":2515,"_34937":2484,"_23830":65896,"_5":16479,"_31422":65832,"_3630":65897},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_4190":2516,"_34937":2484,"_23830":65899,"_5":16479,"_31422":65832,"_3630":65900},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_4190":2517,"_34937":2484,"_23830":65902,"_5":16479,"_31422":65836,"_3630":65903},[],"In Bash, compare the two public-key digests:",{"_4190":2518,"_34937":2484,"_23830":65905,"_5":16479,"_31422":65836,"_3630":65906},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_4190":2519,"_34937":2484,"_23830":65908,"_5":16479,"_31422":65836,"_3630":65909},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_4190":2520,"_34937":2484,"_23830":65911,"_5":16479,"_31422":65840,"_3630":63320},[],{"_4190":2521,"_34937":2484,"_23830":65913,"_5":16479,"_31422":65840,"_3630":65914},[],"What to review",{"_4190":2522,"_34937":2484,"_23830":65916,"_5":16479,"_31422":65840,"_3630":65917},[],"The CA rejects issuance",{"_4190":2523,"_34937":2484,"_23830":65919,"_5":16479,"_31422":65840,"_3630":65920},[],"Permissions, CA state and key, algorithm and profile.",{"_4190":2524,"_34937":2484,"_23830":65922,"_5":16479,"_31422":65840,"_3630":65923},[],"Different subject or usages",{"_4190":2525,"_34937":2484,"_23830":65925,"_5":16479,"_31422":65840,"_3630":65926},[],"Applied profile and requested values.",{"_4190":2526,"_34937":2484,"_23830":65928,"_5":16479,"_31422":65840,"_3630":65929},[],"Issuer cannot be found",{"_4190":2527,"_34937":2484,"_23830":65931,"_5":16479,"_31422":65840,"_3630":65932},[],"Downloaded CA and required intermediate chain.",{"_4190":2528,"_34937":2484,"_23830":65934,"_5":16479,"_31422":65840,"_3630":65935},[],"Validity fails",{"_4190":2529,"_34937":2484,"_23830":65937,"_5":16479,"_31422":65840,"_3630":65938},[],"Certificate and CA dates, and the computer's clock.",{"_4190":2530,"_34937":2484,"_23830":65940,"_5":16479,"_31422":65840,"_3630":65941},[],"Public-key digests differ",{"_4190":2531,"_34937":2484,"_23830":65943,"_5":16479,"_31422":65840,"_3630":65944},[],"Certificate and key files from the same issuance.",{"_4190":2532,"_34937":2484,"_23830":65946,"_5":16479,"_31422":65840,"_3630":65947},[],"See PKI diagnostics to narrow an issuance failure.",{"_4190":2533,"_34937":2484,"_23830":65949,"_5":16479,"_31422":65843,"_3630":65950},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_4190":2534,"_34937":2484,"_23830":65952,"_5":16479,"_31422":65843,"_3630":65953},[],"Manage certificates for inspection, status and revocation.",{"_4190":2535,"_34937":2484,"_23830":65955,"_5":16479,"_31422":65843,"_3630":65956},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_4190":2536,"_34937":2484,"_23830":65958,"_5":16479,"_31422":65843,"_3630":65959},[],"Prepare EST for the device to request its next identities.",{"_4190":2537,"_34937":2484,"_23830":65961,"_5":16479,"_31422":65843,"_3630":65962},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_4190":2538,"_34937":2538,"_5":16871,"_3630":65964,"_35372":65965,"_23830":65966,"_31422":2538},"PKI getting started",[58062,59537,63542,62979],[],{"_4190":2539,"_34937":2538,"_23830":65968,"_5":16479,"_31422":2538,"_3630":65969},[],"Create a CA, issue a client certificate and check its chain and key.",{"_4190":2540,"_34937":2538,"_5":35369,"_23830":65971,"_31422":65972,"_3630":58072},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#before-you-begin",{"_4190":2541,"_34937":2538,"_5":35369,"_23830":65974,"_31422":65975,"_3630":65976},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_4190":2542,"_34937":2538,"_5":35369,"_23830":65978,"_31422":65979,"_3630":63171},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#expected-result",{"_4190":2543,"_34937":2538,"_5":35369,"_23830":65981,"_31422":65982,"_3630":65983},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_4190":2544,"_34937":2538,"_23830":65985,"_5":16479,"_31422":2538,"_3630":65986},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_4190":2545,"_34937":2538,"_23830":65988,"_5":16479,"_31422":65972,"_3630":65989},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_4190":2546,"_34937":2538,"_23830":65991,"_5":16479,"_31422":65972,"_3630":65992},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_4190":2547,"_34937":2538,"_23830":65994,"_5":16479,"_31422":65972,"_3630":65995},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_4190":2548,"_34937":2538,"_23830":65997,"_5":16479,"_31422":65972,"_3630":65998},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_4190":2549,"_34937":2538,"_23830":66000,"_5":16479,"_31422":65972,"_3630":66001},[],"A working directory with restricted access for the downloaded key.",{"_4190":2550,"_34937":2538,"_23830":66003,"_5":16479,"_31422":65975,"_3630":66004},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_4190":2551,"_34937":2538,"_23830":66006,"_5":16479,"_31422":65975,"_3630":66007},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_4190":2552,"_34937":2538,"_23830":66009,"_5":16479,"_31422":65975,"_3630":66010},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_4190":2553,"_34937":2538,"_23830":66012,"_5":16479,"_31422":65975,"_3630":66013},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_4190":2554,"_34937":2538,"_23830":66015,"_5":16479,"_31422":65979,"_3630":66016},[],"File or resource",{"_4190":2555,"_34937":2538,"_23830":66018,"_5":16479,"_31422":65979,"_3630":63168},[],{"_4190":2556,"_34937":2538,"_23830":66020,"_5":16479,"_31422":65979,"_3630":66021},[],"Active root CA and `ca.pem`",{"_4190":2557,"_34937":2538,"_23830":66023,"_5":16479,"_31422":65979,"_3630":66024},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_4190":2558,"_34937":2538,"_23830":66026,"_5":16479,"_31422":65979,"_3630":66027},[],"End-entity certificate and `device.crt`",{"_4190":2559,"_34937":2538,"_23830":66029,"_5":16479,"_31422":65979,"_3630":66030},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_4190":2560,"_34937":2538,"_23830":66032,"_5":16479,"_31422":65979,"_3630":66033},[],"Private key `device.key`",{"_4190":2561,"_34937":2538,"_23830":66035,"_5":16479,"_31422":65979,"_3630":66036},[],"Its public key matches the one included in `device.crt`.",{"_4190":2562,"_34937":2538,"_23830":66038,"_5":16479,"_31422":65979,"_3630":66039},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_4190":2563,"_34937":2538,"_23830":66041,"_5":16479,"_31422":65982,"_3630":66042},[],"To operate certificates, continue with Certificates and Validation.",{"_4190":2564,"_34937":2538,"_23830":66044,"_5":16479,"_31422":65982,"_3630":66045},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_4190":2565,"_34937":2538,"_23830":66047,"_5":16479,"_31422":65982,"_3630":66048},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_4190":2566,"_34937":2566,"_5":16871,"_3630":66050,"_35372":66051,"_23830":66052,"_31422":2566},"PKI troubleshooting",[58062,59537,63542,62117],[],{"_4190":2567,"_34937":2566,"_23830":66054,"_5":16479,"_31422":2566,"_3630":66055},[],"Diagnose certificate issuance, OCSP and CRL.",{"_4190":2568,"_34937":2566,"_5":35369,"_23830":66057,"_31422":66058,"_3630":66059},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_4190":2569,"_34937":2566,"_5":35369,"_23830":66061,"_31422":66062,"_3630":66063},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_4190":2570,"_34937":2566,"_5":35369,"_23830":66065,"_31422":66066,"_3630":66067},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_4190":2571,"_34937":2566,"_23830":66069,"_5":16479,"_31422":2566,"_3630":66070},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_4190":2572,"_34937":2566,"_23830":66072,"_5":16479,"_31422":2566,"_3630":66073},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_4190":2573,"_34937":2566,"_23830":66075,"_5":16479,"_31422":66058,"_3630":63168},[],{"_4190":2574,"_34937":2566,"_23830":66077,"_5":16479,"_31422":66058,"_3630":66078},[],"What to inspect",{"_4190":2575,"_34937":2566,"_23830":66080,"_5":16479,"_31422":66058,"_3630":58096},[],{"_4190":2576,"_34937":2566,"_23830":66082,"_5":16479,"_31422":66058,"_3630":62384},[],{"_4190":2577,"_34937":2566,"_23830":66084,"_5":16479,"_31422":66058,"_3630":66085},[],"Exists, is active and has usable dates.",{"_4190":2578,"_34937":2566,"_23830":66087,"_5":16479,"_31422":66058,"_3630":66088},[],"Authorities.",{"_4190":2579,"_34937":2566,"_23830":66090,"_5":16479,"_31422":66058,"_3630":66091},[],"Key",{"_4190":2580,"_34937":2566,"_23830":66093,"_5":16479,"_31422":66058,"_3630":66094},[],"The record has a usable private key and the engine can sign.",{"_4190":2581,"_34937":2566,"_23830":66096,"_5":16479,"_31422":66058,"_3630":66097},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_4190":2582,"_34937":2566,"_23830":66099,"_5":16479,"_31422":66058,"_3630":66100},[],"CSR",{"_4190":2583,"_34937":2566,"_23830":66102,"_5":16479,"_31422":66058,"_3630":66103},[],"Correct PEM and verifiable signature.",{"_4190":2584,"_34937":2566,"_23830":66105,"_5":16479,"_31422":66058,"_3630":66106},[],"`openssl req -in request.csr -noout -verify -text`.",{"_4190":2585,"_34937":2566,"_23830":66108,"_5":16479,"_31422":66058,"_3630":66109},[],"Profile",{"_4190":2586,"_34937":2566,"_23830":66111,"_5":16479,"_31422":66058,"_3630":66112},[],"Selected source, existing ID, allowed algorithm and size.",{"_4190":2587,"_34937":2566,"_23830":66114,"_5":16479,"_31422":66058,"_3630":66115},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_4190":2588,"_34937":2566,"_23830":66117,"_5":16479,"_31422":66058,"_3630":63320},[],{"_4190":2589,"_34937":2566,"_23830":66119,"_5":16479,"_31422":66058,"_3630":66120},[],"Appropriate subject, SAN, usages and dates.",{"_4190":2590,"_34937":2566,"_23830":66122,"_5":16479,"_31422":66058,"_3630":66123},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_4190":2591,"_34937":2566,"_23830":66125,"_5":16479,"_31422":66058,"_3630":66126},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_4190":2592,"_34937":2566,"_23830":66128,"_5":16479,"_31422":66058,"_3630":66129},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_4190":2593,"_34937":2566,"_23830":66131,"_5":16479,"_31422":66062,"_3630":66132},[],"Check each boundary independently:",{"_4190":2594,"_34937":2566,"_23830":66134,"_5":16479,"_31422":66062,"_3630":66135},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_4190":2595,"_34937":2566,"_23830":66137,"_5":16479,"_31422":66062,"_3630":66138},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_4190":2596,"_34937":2566,"_23830":66140,"_5":16479,"_31422":66062,"_3630":66141},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_4190":2597,"_34937":2566,"_23830":66143,"_5":16479,"_31422":66062,"_3630":66144},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_4190":2598,"_34937":2566,"_23830":66146,"_5":16479,"_31422":66062,"_3630":66147},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_4190":2599,"_34937":2566,"_23830":66149,"_5":16479,"_31422":66062,"_3630":66150},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_4190":2600,"_34937":2566,"_23830":66152,"_5":16479,"_31422":66066,"_3630":66153},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_4190":2601,"_34937":2566,"_23830":66155,"_5":16479,"_31422":66066,"_3630":66156},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_4190":2602,"_34937":2602,"_5":16871,"_3630":66158,"_35372":66159,"_23830":66162,"_31422":2602},"Algorithms",[58062,59537,66160,66161],"[Beta] Post-quantum (PQC)","Algorithms and toolchain",[],{"_4190":2603,"_34937":2602,"_23830":66164,"_5":16479,"_31422":2602,"_3630":66165},[],"The post-quantum and composite signature algorithms Lamassu supports, how each is identified in API requests, and the standards they follow.",{"_4190":2604,"_34937":2602,"_5":35369,"_23830":66167,"_31422":66168,"_3630":66169},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#how-an-algorithm-is-selected","How an algorithm is selected",{"_4190":2605,"_34937":2602,"_5":35369,"_23830":66171,"_31422":66172,"_3630":66173},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ml-dsa","ML-DSA",{"_4190":2606,"_34937":2602,"_5":35369,"_23830":66175,"_31422":66176,"_3630":66177},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#slh-dsa","SLH-DSA",{"_4190":2607,"_34937":2602,"_5":35369,"_23830":66179,"_31422":66180,"_3630":66181},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#composite-ml-dsa","Composite ML-DSA",{"_4190":2608,"_34937":2602,"_5":35369,"_23830":66183,"_31422":66184,"_3630":66185},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ed25519","Ed25519",{"_4190":2609,"_34937":2602,"_5":35369,"_23830":66187,"_31422":66188,"_3630":66189},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#choosing-an-algorithm","Choosing an algorithm",{"_4190":2610,"_34937":2602,"_5":35369,"_23830":66191,"_31422":66192,"_3630":66193},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#what-is-not-covered","What is not covered",{"_4190":2611,"_34937":2602,"_23830":66195,"_5":16479,"_31422":2602,"_3630":66196},[],"Lamassu supports four groups of signature algorithms beyond RSA and ECDSA: ML-DSA, SLH-DSA, composite ML-DSA and Ed25519. All of them come from the Go PQC toolchain; the backend only selects the algorithm and delegates the cryptography.",{"_4190":2612,"_34937":2602,"_23830":66198,"_5":16479,"_31422":66168,"_3630":66199},[],"A key or CA is created with a key type and a size. For RSA and ECDSA the size is a bit length or a curve. For the post-quantum algorithms the same field carries a **parameter set identifier**, not a number of bits:",{"_4190":2613,"_34937":2602,"_23830":66201,"_5":16479,"_31422":66168,"_3630":66202},[],"Key type (`algorithm` / `type`)",{"_4190":2614,"_34937":2602,"_23830":66204,"_5":16479,"_31422":66168,"_3630":66205},[],"Value of `size` / `bits`",{"_4190":2615,"_34937":2602,"_23830":66207,"_5":16479,"_31422":66168,"_3630":60611},[],{"_4190":2616,"_34937":2602,"_23830":66209,"_5":16479,"_31422":66168,"_3630":66210},[],"`RSA`",{"_4190":2617,"_34937":2602,"_23830":66212,"_5":16479,"_31422":66168,"_3630":66213},[],"2048, 3072, 4096",{"_4190":2618,"_34937":2602,"_23830":66215,"_5":16479,"_31422":66168,"_3630":66216},[],"Modulus length in bits.",{"_4190":2619,"_34937":2602,"_23830":66218,"_5":16479,"_31422":66168,"_3630":66219},[],"`ECDSA`",{"_4190":2620,"_34937":2602,"_23830":66221,"_5":16479,"_31422":66168,"_3630":66222},[],"256, 384, 521",{"_4190":2621,"_34937":2602,"_23830":66224,"_5":16479,"_31422":66168,"_3630":66225},[],"Curve size in bits (P-256, P-384, P-521).",{"_4190":2622,"_34937":2602,"_23830":66227,"_5":16479,"_31422":66168,"_3630":66228},[],"`Ed25519`",{"_4190":2623,"_34937":2602,"_23830":66230,"_5":16479,"_31422":66168,"_3630":12054},[],{"_4190":2624,"_34937":2602,"_23830":66232,"_5":16479,"_31422":66168,"_3630":66233},[],"Fixed. Any other value is replaced by 256.",{"_4190":2625,"_34937":2602,"_23830":66235,"_5":16479,"_31422":66168,"_3630":66236},[],"`ML-DSA`",{"_4190":2626,"_34937":2602,"_23830":66238,"_5":16479,"_31422":66168,"_3630":66239},[],"44, 65, 87",{"_4190":2627,"_34937":2602,"_23830":66241,"_5":16479,"_31422":66168,"_3630":66242},[],"ML-DSA parameter set.",{"_4190":2628,"_34937":2602,"_23830":66244,"_5":16479,"_31422":66168,"_3630":66245},[],"`SLH-DSA`",{"_4190":2629,"_34937":2602,"_23830":66247,"_5":16479,"_31422":66168,"_3630":66248},[],"1 to 12",{"_4190":2630,"_34937":2602,"_23830":66250,"_5":16479,"_31422":66168,"_3630":66251},[],"SLH-DSA parameter set, in the order below.",{"_4190":2631,"_34937":2602,"_23830":66253,"_5":16479,"_31422":66168,"_3630":66254},[],"`Composite-ML-DSA-RSA`",{"_4190":2632,"_34937":2602,"_23830":66256,"_5":16479,"_31422":66168,"_3630":66257},[],"1 to 8",{"_4190":2633,"_34937":2602,"_23830":66259,"_5":16479,"_31422":66168,"_3630":66260},[],"Composite variant with an RSA component.",{"_4190":2634,"_34937":2602,"_23830":66262,"_5":16479,"_31422":66168,"_3630":66263},[],"`Composite-ML-DSA-ECDSA`",{"_4190":2635,"_34937":2602,"_23830":66265,"_5":16479,"_31422":66168,"_3630":66266},[],"9 to 13",{"_4190":2636,"_34937":2602,"_23830":66268,"_5":16479,"_31422":66168,"_3630":66269},[],"Composite variant with an ECDSA component.",{"_4190":2637,"_34937":2602,"_23830":66271,"_5":16479,"_31422":66168,"_3630":66272},[],"`Composite-ML-DSA-Ed25519`",{"_4190":2638,"_34937":2602,"_23830":66274,"_5":16479,"_31422":66168,"_3630":66275},[],"14 and 15",{"_4190":2639,"_34937":2602,"_23830":66277,"_5":16479,"_31422":66168,"_3630":66278},[],"Composite variant with an Ed25519 component.",{"_4190":2640,"_34937":2602,"_23830":66280,"_5":16479,"_31422":66168,"_3630":66281},[],"An unknown key type string is not rejected when it is parsed; it becomes an unknown type and fails later. Use the exact strings above.",{"_4190":2641,"_34937":2602,"_23830":66283,"_5":16479,"_31422":66172,"_3630":66284},[],"ML-DSA is the lattice-based signature scheme standardized in FIPS 204. Lamassu accepts the three parameter sets ML-DSA-44, ML-DSA-65 and ML-DSA-87, selected with `size` 44, 65 or 87. The implementation is the `crypto/mldsa` package of Go 1.27, so it is the standard library's own code and not part of the fork. In certificates the algorithm identifiers are `2.16.840.1.101.3.4.3.17`, `.18` and `.19` for ML-DSA-44, -65 and -87.",{"_4190":2642,"_34937":2602,"_23830":66286,"_5":16479,"_31422":66172,"_3630":66287},[],"Parameter set",{"_4190":2643,"_34937":2602,"_23830":66289,"_5":16479,"_31422":66172,"_3630":66290},[],"NIST security category",{"_4190":2644,"_34937":2602,"_23830":66292,"_5":16479,"_31422":66172,"_3630":66293},[],"ML-DSA-44",{"_4190":2645,"_34937":2602,"_23830":66295,"_5":16479,"_31422":66172,"_3630":11996},[],{"_4190":2646,"_34937":2602,"_23830":66297,"_5":16479,"_31422":66172,"_3630":66298},[],"ML-DSA-65",{"_4190":2647,"_34937":2602,"_23830":66300,"_5":16479,"_31422":66172,"_3630":11933},[],{"_4190":2648,"_34937":2602,"_23830":66302,"_5":16479,"_31422":66172,"_3630":66303},[],"ML-DSA-87",{"_4190":2649,"_34937":2602,"_23830":66305,"_5":16479,"_31422":66172,"_3630":12125},[],{"_4190":2650,"_34937":2602,"_23830":66307,"_5":16479,"_31422":66172,"_3630":66308},[],"A higher category means larger keys and signatures in exchange for more security margin.",{"_4190":2651,"_34937":2602,"_23830":66310,"_5":16479,"_31422":66172,"_3630":66311},[],"Go reads ML-DSA private keys in PKCS#8 only when they contain the 32-byte seed. Keys written by OpenSSL in its default seed-plus-expanded form are rejected, so export them in the seed-only form before importing them.",{"_4190":2652,"_34937":2602,"_23830":66313,"_5":16479,"_31422":66176,"_3630":66314},[],"SLH-DSA is the hash-based scheme of FIPS 205. It offers twelve parameter sets that combine a hash family (SHA-2 or SHAKE), the parameter n of 128, 192 or 256 bits, which corresponds to NIST security categories 1, 3 and 5 and a trade-off between signature size and signing speed (`s` for small signatures, `f` for fast signing). The identifier written in `size` follows the order of the underlying library:",{"_4190":2653,"_34937":2602,"_23830":66316,"_5":16479,"_31422":66176,"_3630":66317},[],"ID",{"_4190":2654,"_34937":2602,"_23830":66319,"_5":16479,"_31422":66176,"_3630":66287},[],{"_4190":2655,"_34937":2602,"_23830":66321,"_5":16479,"_31422":66176,"_3630":66317},[],{"_4190":2656,"_34937":2602,"_23830":66323,"_5":16479,"_31422":66176,"_3630":66287},[],{"_4190":2657,"_34937":2602,"_23830":66325,"_5":16479,"_31422":66176,"_3630":11835},[],{"_4190":2658,"_34937":2602,"_23830":66327,"_5":16479,"_31422":66176,"_3630":66328},[],"SLH-DSA-SHA2-128s",{"_4190":2659,"_34937":2602,"_23830":66330,"_5":16479,"_31422":66176,"_3630":11826},[],{"_4190":2660,"_34937":2602,"_23830":66332,"_5":16479,"_31422":66176,"_3630":66333},[],"SLH-DSA-SHA2-192f",{"_4190":2661,"_34937":2602,"_23830":66335,"_5":16479,"_31422":66176,"_3630":11996},[],{"_4190":2662,"_34937":2602,"_23830":66337,"_5":16479,"_31422":66176,"_3630":66338},[],"SLH-DSA-SHAKE-128s",{"_4190":2663,"_34937":2602,"_23830":66340,"_5":16479,"_31422":66176,"_3630":11807},[],{"_4190":2664,"_34937":2602,"_23830":66342,"_5":16479,"_31422":66176,"_3630":66343},[],"SLH-DSA-SHAKE-192f",{"_4190":2665,"_34937":2602,"_23830":66345,"_5":16479,"_31422":66176,"_3630":11933},[],{"_4190":2666,"_34937":2602,"_23830":66347,"_5":16479,"_31422":66176,"_3630":66348},[],"SLH-DSA-SHA2-128f",{"_4190":2667,"_34937":2602,"_23830":66350,"_5":16479,"_31422":66176,"_3630":29970},[],{"_4190":2668,"_34937":2602,"_23830":66352,"_5":16479,"_31422":66176,"_3630":66353},[],"SLH-DSA-SHA2-256s",{"_4190":2669,"_34937":2602,"_23830":66355,"_5":16479,"_31422":66176,"_3630":11786},[],{"_4190":2670,"_34937":2602,"_23830":66357,"_5":16479,"_31422":66176,"_3630":66358},[],"SLH-DSA-SHAKE-128f",{"_4190":2671,"_34937":2602,"_23830":66360,"_5":16479,"_31422":66176,"_3630":33980},[],{"_4190":2672,"_34937":2602,"_23830":66362,"_5":16479,"_31422":66176,"_3630":66363},[],"SLH-DSA-SHAKE-256s",{"_4190":2673,"_34937":2602,"_23830":66365,"_5":16479,"_31422":66176,"_3630":12125},[],{"_4190":2674,"_34937":2602,"_23830":66367,"_5":16479,"_31422":66176,"_3630":66368},[],"SLH-DSA-SHA2-192s",{"_4190":2675,"_34937":2602,"_23830":66370,"_5":16479,"_31422":66176,"_3630":34014},[],{"_4190":2676,"_34937":2602,"_23830":66372,"_5":16479,"_31422":66176,"_3630":66373},[],"SLH-DSA-SHA2-256f",{"_4190":2677,"_34937":2602,"_23830":66375,"_5":16479,"_31422":66176,"_3630":11795},[],{"_4190":2678,"_34937":2602,"_23830":66377,"_5":16479,"_31422":66176,"_3630":66378},[],"SLH-DSA-SHAKE-192s",{"_4190":2679,"_34937":2602,"_23830":66380,"_5":16479,"_31422":66176,"_3630":33476},[],{"_4190":2680,"_34937":2602,"_23830":66382,"_5":16479,"_31422":66176,"_3630":66383},[],"SLH-DSA-SHAKE-256f",{"_4190":2681,"_34937":2602,"_23830":66385,"_5":16479,"_31422":66176,"_3630":66386},[],"The SLH-DSA implementation is provided by Cloudflare's CIRCL library, which the fork integrates so that SLH-DSA keys can be used in X.509 certificates. The object identifiers run from `2.16.840.1.101.3.4.3.20` to `.31`. SLH-DSA signatures are large, between about 8 and 50 KB depending on the parameter set, which matters for certificate chains and for any transport with a size limit. SLH-DSA is available for keys, CAs and certificates, but the fork has no TLS signature scheme for it, so an SLH-DSA certificate cannot authenticate a TLS connection.",{"_4190":2682,"_34937":2602,"_23830":66388,"_5":16479,"_31422":66180,"_3630":66389},[],"A composite key pairs an ML-DSA key with a traditional key. A composite signature is the concatenation of the ML-DSA signature and the traditional signature, both computed over a message representative that contains a fixed prefix, an algorithm label, an optional context and a hash of the message; verification fails if either component fails. The ML-DSA component is pure ML-DSA, with the label as its context. Lamassu implements the 15 algorithms of RFC 10073 that rely only on algorithms available in Go. The identifiers sit under the arc `1.3.6.1.5.5.7.6`.",{"_4190":2683,"_34937":2602,"_23830":66391,"_5":16479,"_31422":66180,"_3630":66392},[],"`size`",{"_4190":2684,"_34937":2602,"_23830":66394,"_5":16479,"_31422":66180,"_3630":66395},[],"Algorithm",{"_4190":2685,"_34937":2602,"_23830":66397,"_5":16479,"_31422":66180,"_3630":66398},[],"Final OID digit",{"_4190":2686,"_34937":2602,"_23830":66400,"_5":16479,"_31422":66180,"_3630":66401},[],"Family",{"_4190":2687,"_34937":2602,"_23830":66403,"_5":16479,"_31422":66180,"_3630":11835},[],{"_4190":2688,"_34937":2602,"_23830":66405,"_5":16479,"_31422":66180,"_3630":66406},[],"MLDSA44-RSA2048-PSS-SHA256",{"_4190":2689,"_34937":2602,"_23830":66408,"_5":16479,"_31422":66180,"_3630":34805},[],{"_4190":2690,"_34937":2602,"_23830":66410,"_5":16479,"_31422":66180,"_3630":66411},[],"RSA",{"_4190":2691,"_34937":2602,"_23830":66413,"_5":16479,"_31422":66180,"_3630":11996},[],{"_4190":2692,"_34937":2602,"_23830":66415,"_5":16479,"_31422":66180,"_3630":66416},[],"MLDSA44-RSA2048-PKCS15-SHA256",{"_4190":2693,"_34937":2602,"_23830":66418,"_5":16479,"_31422":66180,"_3630":34778},[],{"_4190":2694,"_34937":2602,"_23830":66420,"_5":16479,"_31422":66180,"_3630":66411},[],{"_4190":2695,"_34937":2602,"_23830":66422,"_5":16479,"_31422":66180,"_3630":11933},[],{"_4190":2696,"_34937":2602,"_23830":66424,"_5":16479,"_31422":66180,"_3630":66425},[],"MLDSA65-RSA3072-PSS-SHA512",{"_4190":2697,"_34937":2602,"_23830":66427,"_5":16479,"_31422":66180,"_3630":33593},[],{"_4190":2698,"_34937":2602,"_23830":66429,"_5":16479,"_31422":66180,"_3630":66411},[],{"_4190":2699,"_34937":2602,"_23830":66431,"_5":16479,"_31422":66180,"_3630":11786},[],{"_4190":2700,"_34937":2602,"_23830":66433,"_5":16479,"_31422":66180,"_3630":66434},[],"MLDSA65-RSA3072-PKCS15-SHA512",{"_4190":2701,"_34937":2602,"_23830":66436,"_5":16479,"_31422":66180,"_3630":33599},[],{"_4190":2702,"_34937":2602,"_23830":66438,"_5":16479,"_31422":66180,"_3630":66411},[],{"_4190":2703,"_34937":2602,"_23830":66440,"_5":16479,"_31422":66180,"_3630":12125},[],{"_4190":2704,"_34937":2602,"_23830":66442,"_5":16479,"_31422":66180,"_3630":66443},[],"MLDSA65-RSA4096-PSS-SHA512",{"_4190":2705,"_34937":2602,"_23830":66445,"_5":16479,"_31422":66180,"_3630":33605},[],{"_4190":2706,"_34937":2602,"_23830":66447,"_5":16479,"_31422":66180,"_3630":66411},[],{"_4190":2707,"_34937":2602,"_23830":66449,"_5":16479,"_31422":66180,"_3630":11795},[],{"_4190":2708,"_34937":2602,"_23830":66451,"_5":16479,"_31422":66180,"_3630":66452},[],"MLDSA65-RSA4096-PKCS15-SHA512",{"_4190":2709,"_34937":2602,"_23830":66454,"_5":16479,"_31422":66180,"_3630":11789},[],{"_4190":2710,"_34937":2602,"_23830":66456,"_5":16479,"_31422":66180,"_3630":66411},[],{"_4190":2711,"_34937":2602,"_23830":66458,"_5":16479,"_31422":66180,"_3630":11826},[],{"_4190":2712,"_34937":2602,"_23830":66460,"_5":16479,"_31422":66180,"_3630":66461},[],"MLDSA87-RSA3072-PSS-SHA512",{"_4190":2713,"_34937":2602,"_23830":66463,"_5":16479,"_31422":66180,"_3630":33481},[],{"_4190":2714,"_34937":2602,"_23830":66465,"_5":16479,"_31422":66180,"_3630":66411},[],{"_4190":2715,"_34937":2602,"_23830":66467,"_5":16479,"_31422":66180,"_3630":11807},[],{"_4190":2716,"_34937":2602,"_23830":66469,"_5":16479,"_31422":66180,"_3630":66470},[],"MLDSA87-RSA4096-PSS-SHA512",{"_4190":2717,"_34937":2602,"_23830":66472,"_5":16479,"_31422":66180,"_3630":33503},[],{"_4190":2718,"_34937":2602,"_23830":66474,"_5":16479,"_31422":66180,"_3630":66411},[],{"_4190":2719,"_34937":2602,"_23830":66476,"_5":16479,"_31422":66180,"_3630":29970},[],{"_4190":2720,"_34937":2602,"_23830":66478,"_5":16479,"_31422":66180,"_3630":66479},[],"MLDSA44-ECDSA-P256-SHA256",{"_4190":2721,"_34937":2602,"_23830":66481,"_5":16479,"_31422":66180,"_3630":33545},[],{"_4190":2722,"_34937":2602,"_23830":66483,"_5":16479,"_31422":66180,"_3630":66484},[],"ECDSA",{"_4190":2723,"_34937":2602,"_23830":66486,"_5":16479,"_31422":66180,"_3630":33980},[],{"_4190":2724,"_34937":2602,"_23830":66488,"_5":16479,"_31422":66180,"_3630":66489},[],"MLDSA65-ECDSA-P256-SHA512",{"_4190":2725,"_34937":2602,"_23830":66491,"_5":16479,"_31422":66180,"_3630":33611},[],{"_4190":2726,"_34937":2602,"_23830":66493,"_5":16479,"_31422":66180,"_3630":66484},[],{"_4190":2727,"_34937":2602,"_23830":66495,"_5":16479,"_31422":66180,"_3630":34014},[],{"_4190":2728,"_34937":2602,"_23830":66497,"_5":16479,"_31422":66180,"_3630":66498},[],"MLDSA65-ECDSA-P384-SHA512",{"_4190":2729,"_34937":2602,"_23830":66500,"_5":16479,"_31422":66180,"_3630":33617},[],{"_4190":2730,"_34937":2602,"_23830":66502,"_5":16479,"_31422":66180,"_3630":66484},[],{"_4190":2731,"_34937":2602,"_23830":66504,"_5":16479,"_31422":66180,"_3630":33476},[],{"_4190":2732,"_34937":2602,"_23830":66506,"_5":16479,"_31422":66180,"_3630":66507},[],"MLDSA87-ECDSA-P384-SHA512",{"_4190":2733,"_34937":2602,"_23830":66509,"_5":16479,"_31422":66180,"_3630":33623},[],{"_4190":2734,"_34937":2602,"_23830":66511,"_5":16479,"_31422":66180,"_3630":66484},[],{"_4190":2735,"_34937":2602,"_23830":66513,"_5":16479,"_31422":66180,"_3630":34080},[],{"_4190":2736,"_34937":2602,"_23830":66515,"_5":16479,"_31422":66180,"_3630":66516},[],"MLDSA87-ECDSA-P521-SHA512",{"_4190":2737,"_34937":2602,"_23830":66518,"_5":16479,"_31422":66180,"_3630":33509},[],{"_4190":2738,"_34937":2602,"_23830":66520,"_5":16479,"_31422":66180,"_3630":66484},[],{"_4190":2739,"_34937":2602,"_23830":66522,"_5":16479,"_31422":66180,"_3630":33663},[],{"_4190":2740,"_34937":2602,"_23830":66524,"_5":16479,"_31422":66180,"_3630":66525},[],"MLDSA44-Ed25519-SHA512",{"_4190":2741,"_34937":2602,"_23830":66527,"_5":16479,"_31422":66180,"_3630":34811},[],{"_4190":2742,"_34937":2602,"_23830":66529,"_5":16479,"_31422":66180,"_3630":66185},[],{"_4190":2743,"_34937":2602,"_23830":66531,"_5":16479,"_31422":66180,"_3630":34086},[],{"_4190":2744,"_34937":2602,"_23830":66533,"_5":16479,"_31422":66180,"_3630":66534},[],"MLDSA65-Ed25519-SHA512",{"_4190":2745,"_34937":2602,"_23830":66536,"_5":16479,"_31422":66180,"_3630":33587},[],{"_4190":2746,"_34937":2602,"_23830":66538,"_5":16479,"_31422":66180,"_3630":66185},[],{"_4190":2747,"_34937":2602,"_23830":66540,"_5":16479,"_31422":66180,"_3630":66541},[],"The key type must match the family of the variant: creating a `Composite-ML-DSA-ECDSA` key with `size` 3 fails with an error saying that the variant is not valid for that key type.",{"_4190":2748,"_34937":2602,"_23830":66543,"_5":16479,"_31422":66180,"_3630":66544},[],"The implementation was written against draft 19 of the specification, which was later published as RFC 10073, and has been checked against the published text. The object identifiers, the domain separator prefix, the hash used for each ECDSA component and the RFC 5915 encoding of ECDSA private keys match the RFC. Three algorithms of the specification are not implemented because Go has no Brainpool curves and no Ed448: the two Brainpool variants (`MLDSA65-ECDSA-brainpoolP256r1` and `MLDSA87-ECDSA-brainpoolP384r1`, with their hash suffix) and the Ed448 variant. The fork passes the test vectors of RFC 10073 Appendix E for the 15 algorithms it does implement, including the signatures with and without context. These checks cover the vectors and the points listed above; they are not a full conformance assessment.",{"_4190":2749,"_34937":2602,"_23830":66546,"_5":16479,"_31422":66180,"_3630":66547},[],"The composite parameters of keys and signatures must be absent from the `AlgorithmIdentifier`; certificates that carry them are rejected. ECDSA components must use a private scalar of the exact length of the curve.",{"_4190":2750,"_34937":2602,"_23830":66549,"_5":16479,"_31422":66184,"_3630":66550},[],"Ed25519 is not post-quantum, but support for it as a CA and certificate key type was added in the same work and is selected with the `Ed25519` key type. It is classified in the traditional family.",{"_4190":2751,"_34937":2602,"_23830":66552,"_5":16479,"_31422":66188,"_3630":66553},[],"**Composite ML-DSA** is the most conservative option during the transition, because the signature stays valid only if both components verify and so keeps classical protection if a flaw is found in the new algorithm. Keys and signatures are larger than classical ones.",{"_4190":2752,"_34937":2602,"_23830":66555,"_5":16479,"_31422":66188,"_3630":66556},[],"**ML-DSA** alone gives post-quantum protection with moderate sizes and fast operations.",{"_4190":2753,"_34937":2602,"_23830":66558,"_5":16479,"_31422":66188,"_3630":66559},[],"**SLH-DSA** suits long-lived trust anchors where relying only on hash functions is valued. Signatures are considerably larger, and it cannot authenticate TLS connections.",{"_4190":2754,"_34937":2602,"_23830":66561,"_5":16479,"_31422":66188,"_3630":66562},[],"**Ed25519** is not post-quantum; use it only where a classical algorithm is acceptable.",{"_4190":2755,"_34937":2602,"_23830":66564,"_5":16479,"_31422":66192,"_3630":66565},[],"Lamassu does not implement post-quantum key exchange of its own. The hybrid key exchanges offered by the TLS endpoint, such as `X25519MLKEM768`, are those of the Go 1.27 standard library. The Chameleon and delta-certificate designs explored in earlier iterations were removed and are not part of the implementation.",{"_4190":2756,"_34937":2602,"_23830":66567,"_5":16479,"_31422":66192,"_3630":66568},[],"<Card title=\"Go PQC toolchain\" description=\"The fork that implements these algorithms and the API it adds.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_4190":2757,"_34937":2602,"_23830":66570,"_5":16479,"_31422":66192,"_3630":66571},[],"<Card title=\"Keys and certificate authorities\" description=\"Use these parameters in KMS and CA requests.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4190":2758,"_34937":2758,"_5":16871,"_3630":66573,"_35372":66574,"_23830":66576,"_31422":2758},"Dashboard",[58062,59537,66160,66575],"Platform support",[],{"_4190":2759,"_34937":2758,"_23830":66578,"_5":16479,"_31422":2758,"_3630":66579},[],"How the web interface exposes post-quantum algorithms when creating keys, CAs and certificates, and how it displays them.",{"_4190":2760,"_34937":2758,"_5":35369,"_23830":66581,"_31422":66582,"_3630":66583},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#choosing-a-key-type-and-specification","Choosing a key type and specification",{"_4190":2761,"_34937":2758,"_5":35369,"_23830":66585,"_31422":66586,"_3630":66587},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#issuing-a-certificate-with-a-browser-generated-key","Issuing a certificate with a browser-generated key",{"_4190":2762,"_34937":2758,"_5":35369,"_23830":66589,"_31422":66590,"_3630":66591},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#how-objects-are-displayed","How objects are displayed",{"_4190":2763,"_34937":2758,"_5":35369,"_23830":66593,"_31422":66594,"_3630":66595},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#related-certificates","Related certificates",{"_4190":2764,"_34937":2758,"_5":35369,"_23830":66597,"_31422":66598,"_3630":66599},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#create-an-issuance-profile-that-enables-the-feature","Create an issuance profile that enables the feature",{"_4190":2765,"_34937":2758,"_5":35369,"_23830":66601,"_31422":66602,"_3630":66603},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#check-which-profiles-allow-it","Check which profiles allow it",{"_4190":2766,"_34937":2758,"_5":35369,"_23830":66605,"_31422":66606,"_3630":66607},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#request-the-bound-certificate","Request the bound certificate",{"_4190":2767,"_34937":2758,"_5":35369,"_23830":66609,"_31422":66610,"_3630":66611},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#check-the-result","Check the result",{"_4190":2768,"_34937":2758,"_5":35369,"_23830":66613,"_31422":66614,"_3630":66615},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#things-to-know","Things to know",{"_4190":2769,"_34937":2758,"_23830":66617,"_5":16479,"_31422":2758,"_3630":66618},[],"The dashboard (branch `feat/lamassu-q`) lets an administrator create and inspect post-quantum keys, certificate authorities and certificates without writing API requests. It adds the algorithm choices, shows the algorithm family of every object and parses the new identifiers in certificates. Everything it sends is described in Keys and certificate authorities; this page covers what the interface shows and where its behaviour differs between screens.",{"_4190":2770,"_34937":2758,"_23830":66620,"_5":16479,"_31422":66582,"_3630":66621},[],"Creating a KMS key, a CA with a new key and a certificate with a server-generated key all use the same pair of selectors. *Key type* is grouped by family and *Key specification* depends on the type.",{"_4190":2771,"_34937":2758,"_23830":66623,"_5":16479,"_31422":66582,"_3630":66624},[],"Group",{"_4190":2772,"_34937":2758,"_23830":66626,"_5":16479,"_31422":66582,"_3630":66627},[],"Key types",{"_4190":2773,"_34937":2758,"_23830":66629,"_5":16479,"_31422":66582,"_3630":66630},[],"T (Traditional)",{"_4190":2774,"_34937":2758,"_23830":66632,"_5":16479,"_31422":66582,"_3630":66633},[],"`RSA`, `ECDSA`, `Ed25519`",{"_4190":2775,"_34937":2758,"_23830":66635,"_5":16479,"_31422":66582,"_3630":66636},[],"PQ (Pure PQC)",{"_4190":2776,"_34937":2758,"_23830":66638,"_5":16479,"_31422":66582,"_3630":66639},[],"`ML-DSA`, `SLH-DSA`",{"_4190":2777,"_34937":2758,"_23830":66641,"_5":16479,"_31422":66582,"_3630":66642},[],"PQ/T (Hybrid)",{"_4190":2778,"_34937":2758,"_23830":66644,"_5":16479,"_31422":66582,"_3630":66645},[],"`Composite-ML-DSA-RSA`, `Composite-ML-DSA-ECDSA`, `Composite-ML-DSA-Ed25519`",{"_4190":2779,"_34937":2758,"_23830":66647,"_5":16479,"_31422":66582,"_3630":66648},[],"The specification list shows ML-DSA-44, -65 or -87, the twelve SLH-DSA parameter sets (for example *4 - SHAKE\\_128f*) or the composite variants by name. The interface sends the identifier of the parameter set as `size`, as explained in Algorithms, and shows a strength indicator next to each option. For composite keys the indicator shows two bars, one for the classical component and one for the post-quantum component.",{"_4190":2780,"_34937":2758,"_23830":66650,"_5":16479,"_31422":66582,"_3630":66651},[],"Once created, the key list shows the type of each key and its strength. A composite key shows two indicators, one for its classical component (C) and one for its post-quantum component (PQ).",{"_4190":2781,"_34937":2758,"_23830":66653,"_5":16479,"_31422":66582,"_3630":66654},[],"Which options are enabled depends on the crypto engine. When creating a key or a CA, the interface lists every algorithm but disables those that the selected engine does not support, and asks to select an engine first. When creating a certificate on the server, unsupported types are hidden instead.",{"_4190":2782,"_34937":2758,"_23830":66656,"_5":16479,"_31422":66586,"_3630":66657},[],"Issuing a certificate from a CA generates the key pair in the browser, builds the certificate request and sends it to the CA for signing. The key types offered here are `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` and a single `Composite ML-DSA` entry, and they are generated in the browser: with the `@noble` libraries for ML-DSA and SLH-DSA and with WebCrypto for the classical algorithms.",{"_4190":2783,"_34937":2758,"_23830":66659,"_5":16479,"_31422":66586,"_3630":66660},[],"Composite key generation is not available in `@noble`. The Lamassu team implemented it for the dashboard, combining the ML-DSA key with an RSA, ECDSA or Ed25519 key and signing the composite message representative as the specification defines, so that a composite certificate request can be created entirely in the browser.",{"_4190":2784,"_34937":2758,"_23830":66662,"_5":16479,"_31422":66586,"_3630":66663},[],"The generated private key is shown once at the end of the procedure, next to the issued certificate, with a warning to store it securely. It is not kept by Lamassu, so download or copy it before leaving the page.",{"_4190":2785,"_34937":2758,"_23830":66665,"_5":16479,"_31422":66586,"_3630":66666},[],"The browser does not verify the signatures of ML-DSA, SLH-DSA, composite or Ed25519 requests; it relies on the KMS.",{"_4190":2786,"_34937":2758,"_23830":66668,"_5":16479,"_31422":66590,"_3630":66669},[],"Lists and detail views show the algorithm family. The CA table has a *PQC* column with T, PQ or PQ/T, CA cards and the CA graph show a *PQC* badge, key lists show a quantum icon, and the details of a CA or certificate show the algorithm, its strength and the family badge. The family is computed from the algorithm identifier in the parsed certificate.",{"_4190":2787,"_34937":2758,"_23830":66671,"_5":16479,"_31422":66590,"_3630":66672},[],"The Certificates list has an *Algorithm* column with the same labels: in the example below, a traditional certificate (T), a pure post-quantum certificate (PQ) and the composite CA that issued them (PQ/T).",{"_4190":2788,"_34937":2758,"_23830":66674,"_5":16479,"_31422":66590,"_3630":66675},[],"Algorithm names are resolved from the object identifiers. ML-DSA, SLH-DSA, composite and Ed25519 identifiers are shown as names with their parameter set, for example *ML-DSA-65* or *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, and no bit length is shown for them. RSA and ECDSA signature algorithms are displayed with the dashboard's own labels, such as *RSA PKCS#1 v1.5 SHA-256* and *ECDSA SHA-256*, instead of the OpenSSL names `sha256WithRSAEncryption` and `ecdsa-with-SHA256`.",{"_4190":2789,"_34937":2758,"_23830":66677,"_5":16479,"_31422":66590,"_3630":66678},[],"The key detail page can sign and verify with a post-quantum key and enables only the signature algorithm that corresponds to it.",{"_4190":2790,"_34937":2758,"_23830":66680,"_5":16479,"_31422":66590,"_3630":66681},[],"The following example signs a payload with the key of a composite CA, using the composite algorithm that matches the key.",{"_4190":2791,"_34937":2758,"_23830":66683,"_5":16479,"_31422":66594,"_3630":66684},[],"The dashboard covers the whole related certificates flow without API requests: enable the feature in an issuance profile, check which profiles have it, and request the bound certificate. The configuration fields are those described in Configure an issuance profile.",{"_4190":2792,"_34937":2758,"_23830":66686,"_5":16479,"_31422":66598,"_3630":66687},[],"Go to **Issuance Profiles** and select **Create New Profile**. In the *Related Certificates* section, turn on **Enable Related Certificates**. With the switch off, a certificate request that carries the `relatedCertRequest` attribute is rejected.",{"_4190":2793,"_34937":2758,"_23830":66689,"_5":16479,"_31422":66598,"_3630":66690},[],"**Allowed Hosts** lists one host name per line. The server downloads related certificates over `http` or `https` only from these hosts, as explained in Locations the CA may fetch from. Certificates embedded in the request as `data:` URIs are always accepted.",{"_4190":2794,"_34937":2758,"_23830":66692,"_5":16479,"_31422":66598,"_3630":66693},[],"**Max Attribute Age** is the maximum age of the request time in the attribute. Use the units `y`, `w`, `d`, `h`, `m` or `s`, for example `5m` or `1h`. If you leave it empty, the default of 5 minutes applies.",{"_4190":2795,"_34937":2758,"_23830":66695,"_5":16479,"_31422":66598,"_3630":66696},[],"Complete the rest of the profile as usual, as described in Certificate profiles.",{"_4190":2796,"_34937":2758,"_23830":66698,"_5":16479,"_31422":66602,"_3630":66699},[],"The list of issuance profiles shows a *Related certs* row on every card, with the value **Enabled** or **Disabled**. A profile where it is enabled also shows its allowed hosts and its maximum attribute age. In the example, the default profile has the feature disabled, and the second profile has it enabled with the host `certs.example.com` and a maximum age of one hour. Select **Edit** to change either setting later.",{"_4190":2797,"_34937":2758,"_23830":66701,"_5":16479,"_31422":66602,"_3630":66702},[],"Only a stored profile with the feature enabled lets you request a bound certificate. If you choose a profile without it, or an inline profile, the form explains why the option is unavailable.",{"_4190":2798,"_34937":2758,"_23830":66704,"_5":16479,"_31422":66606,"_3630":66705},[],"Open the CA that will sign it, select **Issue Certificate** and generate the key in the browser, as described in the section above. Under *Certificate Configuration*, choose **Reuse Existing** and select the profile from the previous step. Then turn on **Bind to a related certificate** in the *Related Certificate* section and complete it:",{"_4190":2799,"_34937":2758,"_23830":66707,"_5":16479,"_31422":66606,"_3630":66708},[],"**Related certificate (PEM, optional).** Paste the existing certificate. Its exact issuer and serial number are used and the fields below are locked. If you do not paste it, enter the issuer, as name fields or as raw DER, and the serial number in hexadecimal.",{"_4190":2800,"_34937":2758,"_23830":66710,"_5":16479,"_31422":66606,"_3630":66711},[],"**Location of the related certificate.** One URI per line: a `data:` URI with a base64 PKCS#7 that contains the certificate, or an `http` or `https` URL that points to a plain DER certificate on an allowed host.",{"_4190":2801,"_34937":2758,"_23830":66713,"_5":16479,"_31422":66606,"_3630":66714},[],"**Data to sign.** The form builds the issuer and serial number followed by the request time, which it stamps automatically. Copy it as hex or base64. **Refresh** recomputes it with the current time.",{"_4190":2802,"_34937":2758,"_23830":66716,"_5":16479,"_31422":66606,"_3630":66717},[],"**Signature.** Sign those bytes with the private key of the related certificate, outside the browser, and paste the signature as hex or base64. Use the key's usual algorithm: ECDSA with SHA-256, SHA-384 or SHA-512 depending on the curve, RSA PKCS#1 v1.5 with SHA-256, and pure Ed25519 or ML-DSA. An ECDSA signature may be DER or raw `r||s`.",{"_4190":2803,"_34937":2758,"_23830":66719,"_5":16479,"_31422":66606,"_3630":66720},[],"To build the `data:` URI from a certificate file, `cert.pem`, wrap it in a PKCS#7 structure and encode it in base64:",{"_4190":2804,"_34937":2758,"_23830":66722,"_5":16479,"_31422":66606,"_3630":66723},[],"Paste the output as one line in the location field. The server only checks that the URI is base64 encoded and that the payload is a PKCS#7 structure whose first certificate is the related one.",{"_4190":2805,"_34937":2758,"_23830":66725,"_5":16479,"_31422":66606,"_3630":66726},[],"The key of the related certificate normally stays on the device or system that owns it, so the signature is produced there. If that key is held in Lamassu, use **Sign / Verify** on the key, as described in Keys and cryptographic engines.",{"_4190":2806,"_34937":2758,"_23830":66728,"_5":16479,"_31422":66606,"_3630":66729},[],"The CA accepts the request only if its time is within the maximum attribute age of the profile, counted from the moment it receives the request. Sign and issue within that window, or select **Refresh** and sign the new data. Then issue the certificate as usual.",{"_4190":2807,"_34937":2758,"_23830":66731,"_5":16479,"_31422":66610,"_3630":66732},[],"The detail pages of the new certificate show a *Related Certificate* row with the hash algorithm and the hash of the related certificate. It appears only on certificates that carry the extension, so a certificate issued without the binding shows no such row.",{"_4190":2808,"_34937":2758,"_23830":66734,"_5":16479,"_31422":66610,"_3630":66735},[],"To check that the value belongs to the certificate you expect, compute the hash of its DER encoding with the same algorithm and compare it:",{"_4190":2809,"_34937":2758,"_23830":66737,"_5":16479,"_31422":66610,"_3630":66738},[],"The algorithm is SHA-256, SHA-384 or SHA-512, as shown in the row. The rules the bound certificate must satisfy are in What the issued certificate must satisfy.",{"_4190":2810,"_34937":2758,"_23830":66740,"_5":16479,"_31422":66614,"_3630":66741},[],"The key type names are not identical across all screens. Key and CA creation use `Composite-ML-DSA-RSA`, `-ECDSA` and `-Ed25519`; the issue-certificate form uses a single `Composite-ML-DSA`; and the server-side certificate form compares upper-case names. The names that the backend reports for a key may therefore differ in case from what the interface submits.",{"_4190":2811,"_34937":2758,"_23830":66743,"_5":16479,"_31422":66614,"_3630":66744},[],"The interface carries no experimental warning for these algorithms and has no translation: all texts are in English.",{"_4190":2812,"_34937":2758,"_23830":66746,"_5":16479,"_31422":66614,"_3630":66747},[],"The mapping from the SLH-DSA parameter set identifier to the algorithm used by the in-browser key generator does not follow the same order as the identifiers shown in the selector and used by the backend, except for identifier 1. A certificate issued through the browser flow with an SLH-DSA identifier from 2 to 12 may therefore use a different parameter set than the one named in the selector. Create SLH-DSA keys with the KMS until this is corrected.",{"_4190":2813,"_34937":2758,"_23830":66749,"_5":16479,"_31422":66614,"_3630":66750},[],"<Card title=\"Keys and certificate authorities\" description=\"The API behind these screens.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4190":2814,"_34937":2758,"_23830":66752,"_5":16479,"_31422":66614,"_3630":66753},[],"<Card title=\"Known limitations\" description=\"Gaps in the interface and the platform.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":2815,"_34937":2815,"_5":16871,"_3630":66755,"_35372":66756,"_23830":66757,"_31422":2815},"Deployment with the Helm chart",[58062,59537,66160,58063],[],{"_4190":2816,"_34937":2815,"_23830":66759,"_5":16479,"_31422":2815,"_3630":66760},[],"Deploy Lamassu with a Traefik front proxy that serves classical, post-quantum and composite certificates, using the chart values or the fast-lane installer.",{"_4190":2817,"_34937":2815,"_5":35369,"_23830":66762,"_31422":66763,"_3630":66764},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#topology","Topology",{"_4190":2818,"_34937":2815,"_5":35369,"_23830":66766,"_31422":66767,"_3630":66768},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#chart-values","Chart values",{"_4190":2819,"_34937":2815,"_5":35369,"_23830":66770,"_31422":66771,"_3630":66772},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#the-fast-lane-installer","The fast-lane installer",{"_4190":2820,"_34937":2815,"_23830":66774,"_5":16479,"_31422":2815,"_3630":66775},[],"The `pqc` branch of the Lamassu Helm chart adds a front proxy: a Traefik instance built with the Go PQC toolchain that terminates the devices' TLS, authenticates them and forwards the traffic to Envoy Gateway. This page describes the resulting topology, the values that control it and the installer that automates a laboratory deployment.",{"_4190":2821,"_34937":2815,"_23830":66777,"_5":16479,"_31422":2815,"_3630":66778},[],"The chart and the installer assume a development cluster. The proxy image uses a mutable tag, the PQC certificates are not renewed automatically and the hop between Traefik and Envoy does not verify certificates. Do not use this configuration as it is for production.",{"_4190":2822,"_34937":2815,"_23830":66780,"_5":16479,"_31422":66763,"_3630":66781},[],"Traefik is the public edge. It negotiates the key exchange, serves the certificate and, if requested, receives the client certificate. It then opens a second TLS connection to the `envoy-gateway-proxy` service of Envoy Gateway, which presents the chart's self-signed classical certificate; Traefik is configured to accept it without verifying it. Envoy therefore never sees a post-quantum handshake, and the post-quantum protection covers only the connection between the client and Traefik. Traefik and Envoy Gateway are installed once per cluster and shared across namespaces, whereas the front proxy resources (the Gateway, route, middleware, certificate and reference grant) belong to the Lamassu release.",{"_4190":2823,"_34937":2815,"_23830":66783,"_5":16479,"_31422":66763,"_3630":66784},[],"When the client sent a certificate, the `inject-client-cert` middleware of the chart adds it, in PEM form, to the `X-Forwarded-Tls-Client-Cert` header, and the `X-Forwarded-Proto: https` header is set on the request.",{"_4190":2824,"_34937":2815,"_23830":66786,"_5":16479,"_31422":66767,"_3630":66787},[],"All the new values are under `traefikFrontProxy` and are validated by the chart's schema, which rejects unknown keys.",{"_4190":2825,"_34937":2815,"_23830":66789,"_5":16479,"_31422":66767,"_3630":66790},[],"Name",{"_4190":2826,"_34937":2815,"_23830":66792,"_5":16479,"_31422":66767,"_3630":62224},[],{"_4190":2827,"_34937":2815,"_23830":66794,"_5":16479,"_31422":66767,"_3630":58449},[],{"_4190":2828,"_34937":2815,"_23830":66796,"_5":16479,"_31422":66767,"_3630":62230},[],{"_4190":2829,"_34937":2815,"_23830":66798,"_5":16479,"_31422":66767,"_3630":66799},[],"`traefikFrontProxy.enabled`",{"_4190":2830,"_34937":2815,"_23830":66801,"_5":16479,"_31422":66767,"_3630":22434},[],{"_4190":2831,"_34937":2815,"_23830":66803,"_5":16479,"_31422":66767,"_3630":66804},[],"`false`",{"_4190":2832,"_34937":2815,"_23830":66806,"_5":16479,"_31422":66767,"_3630":66807},[],"Deploys the front proxy resources.",{"_4190":2833,"_34937":2815,"_23830":66809,"_5":16479,"_31422":66767,"_3630":66810},[],"`traefikFrontProxy.domain`",{"_4190":2834,"_34937":2815,"_23830":66812,"_5":16479,"_31422":66767,"_3630":28524},[],{"_4190":2835,"_34937":2815,"_23830":66814,"_5":16479,"_31422":66767,"_3630":66815},[],"`\"\"`",{"_4190":2836,"_34937":2815,"_23830":66817,"_5":16479,"_31422":66767,"_3630":66818},[],"Name of the edge certificate and host name of the route. Set it when the proxy is enabled.",{"_4190":2837,"_34937":2815,"_23830":66820,"_5":16479,"_31422":66767,"_3630":66821},[],"`traefikFrontProxy.webSecurePort`",{"_4190":2838,"_34937":2815,"_23830":66823,"_5":16479,"_31422":66767,"_3630":18668},[],{"_4190":2839,"_34937":2815,"_23830":66825,"_5":16479,"_31422":66767,"_3630":66826},[],"`8443`",{"_4190":2840,"_34937":2815,"_23830":66828,"_5":16479,"_31422":66767,"_3630":66829},[],"Port of the HTTPS listener; it must match Traefik's `websecure` entry point.",{"_4190":2841,"_34937":2815,"_23830":66831,"_5":16479,"_31422":66767,"_3630":66832},[],"`traefikFrontProxy.tls.type`",{"_4190":2842,"_34937":2815,"_23830":66834,"_5":16479,"_31422":66767,"_3630":28524},[],{"_4190":2843,"_34937":2815,"_23830":66836,"_5":16479,"_31422":66767,"_3630":66837},[],"`certManager`",{"_4190":2844,"_34937":2815,"_23830":66839,"_5":16479,"_31422":66767,"_3630":66840},[],"Source of the classical certificate: `certManager`, `external` or `none`.",{"_4190":2845,"_34937":2815,"_23830":66842,"_5":16479,"_31422":66767,"_3630":66843},[],"`traefikFrontProxy.tls.certManagerOptions.addresses`",{"_4190":2846,"_34937":2815,"_23830":66845,"_5":16479,"_31422":66767,"_3630":17428},[],{"_4190":2847,"_34937":2815,"_23830":66847,"_5":16479,"_31422":66767,"_3630":66848},[],"`[]`",{"_4190":2848,"_34937":2815,"_23830":66850,"_5":16479,"_31422":66767,"_3630":66851},[],"IP addresses added to the self-signed certificate.",{"_4190":2849,"_34937":2815,"_23830":66853,"_5":16479,"_31422":66767,"_3630":66854},[],"`traefikFrontProxy.tls.externalOptions.secretName`",{"_4190":2850,"_34937":2815,"_23830":66856,"_5":16479,"_31422":66767,"_3630":28524},[],{"_4190":2851,"_34937":2815,"_23830":66858,"_5":16479,"_31422":66767,"_3630":66815},[],{"_4190":2852,"_34937":2815,"_23830":66860,"_5":16479,"_31422":66767,"_3630":66861},[],"Secret with `tls.crt` and `tls.key` when the type is `external`.",{"_4190":2853,"_34937":2815,"_23830":66863,"_5":16479,"_31422":66767,"_3630":66864},[],"`traefikFrontProxy.tls.additionalSecretNames`",{"_4190":2854,"_34937":2815,"_23830":66866,"_5":16479,"_31422":66767,"_3630":17428},[],{"_4190":2855,"_34937":2815,"_23830":66868,"_5":16479,"_31422":66767,"_3630":66848},[],{"_4190":2856,"_34937":2815,"_23830":66870,"_5":16479,"_31422":66767,"_3630":66871},[],"Extra TLS secrets, for example ML-DSA or composite certificates, served on the same listener.",{"_4190":2857,"_34937":2815,"_23830":66873,"_5":16479,"_31422":66767,"_3630":66874},[],"With `certManager`, the chart requests an ECDSA P-256 certificate valid for 2160 hours from its own self-signed issuer and stores it in the secret `edge-cert`. With `none`, only the additional secrets are served, and the chart stops with an error if there are none. The proxy chooses among all the certificates according to the client, as described in TLS front proxy with Traefik. The names of the resources the chart creates are fixed, so only one release per namespace is supported.",{"_4190":2858,"_34937":2815,"_23830":66876,"_5":16479,"_31422":66767,"_3630":66877},[],"The chart also changes the Envoy Gateway service so that its HTTPS port declares `appProtocol: https`, which recent Traefik versions require in order to speak TLS to it. When `gateway.addresses` is empty, the Envoy service is a `ClusterIP` instead of a load balancer.",{"_4190":2859,"_34937":2815,"_23830":66879,"_5":16479,"_31422":66767,"_3630":66880},[],"The chart does not deploy Traefik itself, the `traefik` GatewayClass, or the `default` TLS option in the `traefik-system` namespace; the installer creates them. Without them, the edge has no post-quantum key exchange and no client-certificate request. The chart also does not set the Lamassu service images: the defaults are the development images, and the installer overrides the UI, CA, KMS, VA, device manager, DMS manager, alerts and authorization images with the `:pqc` tags of `ghcr.io/lamassuiot`.",{"_4190":2860,"_34937":2815,"_23830":66882,"_5":16479,"_31422":66771,"_3630":66883},[],"`scripts/lamassu-fast-lane.sh` installs everything on a cluster: the Gateway API custom resource definitions (version 1.6.3, experimental channel), Envoy Gateway 1.8.0, the Traefik chart 41.0.2 with the PQC image, the TLS option, PostgreSQL, Keycloak, RabbitMQ, optionally observability and SoftHSM, and finally the Lamassu release. The two flags that matter here select which algorithms are offered.",{"_4190":2861,"_34937":2815,"_23830":66885,"_5":16479,"_31422":66771,"_3630":66886},[],"Both flags take a comma-separated list of `T`, `PQ` and `PQ/T`, and both default to all three. For the key exchange, `PQ/T` is a hybrid group that combines a classical and an ML-KEM exchange (`X25519MLKEM768`, `SecP256r1MLKEM768` and `SecP384r1MLKEM1024`) and `PQ` is pure ML-KEM (`MLKEM1024`); for authentication, `PQ/T` is a composite certificate. `--tls-kex` fills the `curvePreferences` of the TLS option, and `--tls-auth` selects which certificates are served:",{"_4190":2862,"_34937":2815,"_23830":66888,"_5":16479,"_31422":66771,"_3630":66889},[],"Value",{"_4190":2863,"_34937":2815,"_23830":66891,"_5":16479,"_31422":66771,"_3630":66892},[],"Key exchange groups",{"_4190":2864,"_34937":2815,"_23830":66894,"_5":16479,"_31422":66771,"_3630":62435},[],{"_4190":2865,"_34937":2815,"_23830":66896,"_5":16479,"_31422":66771,"_3630":66897},[],"`T`",{"_4190":2866,"_34937":2815,"_23830":66899,"_5":16479,"_31422":66771,"_3630":66900},[],"`X25519`, `CurveP256`, `CurveP384`",{"_4190":2867,"_34937":2815,"_23830":66902,"_5":16479,"_31422":66771,"_3630":66903},[],"cert-manager ECDSA P-256, or the files given with `--tls-crt` and `--tls-key`, in the secret `edge-cert`.",{"_4190":2868,"_34937":2815,"_23830":66905,"_5":16479,"_31422":66771,"_3630":66906},[],"`PQ`",{"_4190":2869,"_34937":2815,"_23830":66908,"_5":16479,"_31422":66771,"_3630":66909},[],"`MLKEM1024`",{"_4190":2870,"_34937":2815,"_23830":66911,"_5":16479,"_31422":66771,"_3630":66912},[],"ML-DSA-65, in the secret `edge-cert-pq`.",{"_4190":2871,"_34937":2815,"_23830":66914,"_5":16479,"_31422":66771,"_3630":66915},[],"`PQ/T`",{"_4190":2872,"_34937":2815,"_23830":66917,"_5":16479,"_31422":66771,"_3630":66918},[],"`X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024`",{"_4190":2873,"_34937":2815,"_23830":66920,"_5":16479,"_31422":66771,"_3630":66921},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, in the secret `edge-cert-pqt`.",{"_4190":2874,"_34937":2815,"_23830":66923,"_5":16479,"_31422":66771,"_3630":66924},[],"The minimum TLS version is 1.3 unless both flags are only `T`, in which case it is 1.2. cert-manager cannot issue post-quantum certificates, so the installer creates the PQ and PQ/T certificates locally with OpenSSL 3.5 or later; the composite certificate also needs the `hybrid-provider` module, which the script builds on demand with `git`, `cmake` and a C compiler. The ML-DSA private keys are written in the seed-only form that Go accepts, and the secrets are created from a manifest because `kubectl create secret tls` rejects ML-DSA keys. The certificates last 365 days and are kept if the secret already exists.",{"_4190":2875,"_34937":2815,"_23830":66926,"_5":16479,"_31422":66771,"_3630":66927},[],"The script requires `yq`, `kubectl` and `helm`, and `jq` with `--sample-data`. At the end it prints how to extract the CA that devices must trust, for example `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_4190":2876,"_34937":2815,"_23830":66929,"_5":16479,"_31422":66771,"_3630":66930},[],"Companion scripts for an MQTT broker behind Traefik (`scripts/emqx`), for exporting KMS keys and for restoring a backup are present in the working tree of the chart but not committed. They are for laboratory use only and are not described further here.",{"_4190":2877,"_34937":2815,"_23830":66932,"_5":16479,"_31422":66771,"_3630":66933},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the proxy chooses a certificate and how it is built.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4190":2878,"_34937":2815,"_23830":66935,"_5":16479,"_31422":66771,"_3630":66936},[],"<Card title=\"Known limitations\" description=\"Caveats of the laboratory deployment.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":2879,"_34937":2879,"_5":16871,"_3630":66938,"_35372":66939,"_23830":66940,"_31422":2879},"Go PQC toolchain",[58062,59537,66160,66161],[],{"_4190":2880,"_34937":2879,"_23830":66942,"_5":16479,"_31422":2879,"_3630":66943},[],"The fork of Go that adds composite ML-DSA, SLH-DSA, related certificates and composite TLS signature schemes, the API it exposes and how it is built.",{"_4190":2881,"_34937":2879,"_5":35369,"_23830":66945,"_31422":66946,"_3630":66947},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#what-the-fork-adds","What the fork adds",{"_4190":2882,"_34937":2879,"_5":35369,"_23830":66949,"_31422":66950,"_3630":66951},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#tls-code-points","TLS code points",{"_4190":2883,"_34937":2879,"_5":35369,"_23830":66953,"_31422":66954,"_3630":66955},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#a-minimal-example","A minimal example",{"_4190":2884,"_34937":2879,"_5":35369,"_23830":66957,"_31422":66958,"_3630":66959},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#discarded-approaches","Discarded approaches",{"_4190":2885,"_34937":2879,"_5":35369,"_23830":66961,"_31422":66962,"_3630":66963},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#building-the-toolchain-and-the-images","Building the toolchain and the images",{"_4190":2886,"_34937":2879,"_23830":66965,"_5":16479,"_31422":2879,"_3630":66966},[],"Go 1.27 includes ML-DSA in `crypto/mldsa` and in X.509 and TLS, but it has no composite or SLH-DSA certificates, no related certificates and no composite TLS signature schemes. Lamassu therefore builds its backend and its TLS proxy with a fork of Go, maintained on the `release-branch.go1.27` branch. This page describes what the fork adds, for developers who build Lamassu or write a client that must talk to it.",{"_4190":2887,"_34937":2879,"_23830":66968,"_5":16479,"_31422":2879,"_3630":66969},[],"The fork exposes APIs that do not exist in the official Go distribution. Code that uses them compiles only with this toolchain, and a binary built with it must not be assumed to follow the Go compatibility promise for those APIs.",{"_4190":2888,"_34937":2879,"_23830":66971,"_5":16479,"_31422":66946,"_3630":66972},[],"**Composite ML-DSA in X.509.** The `x509` package gains `CompositePublicKey` and `CompositePrivateKey`, which implement `crypto.Signer`, and 15 `CompositeAlgorithm` values (for example `x509.MLDSA65_ECDSA_P384_SHA512`) that can generate keys, sign and verify. Certificates, certificate requests and revocation lists signed with these keys parse, marshal and verify like any other. PKCS#8 encoding of composite private keys is supported. The algorithms page lists the identifiers.",{"_4190":2889,"_34937":2879,"_23830":66974,"_5":16479,"_31422":66946,"_3630":66975},[],"**SLH-DSA in X.509.** The `x509.SLHDSA` public key algorithm and twelve `PureSLHDSA...` signature algorithms are available for parsing and verifying certificates and keys. The implementation is the vendored `circl` library of Cloudflare. It is the least tested part of the fork: it has no x509 tests of its own and no TLS support.",{"_4190":2890,"_34937":2879,"_23830":66977,"_5":16479,"_31422":66946,"_3630":66978},[],"**Related certificates (RFC 9763).** The fork provides `x509.CreateBoundCertificate`, which adds the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`) to a certificate, `x509.VerifyRelatedCertificate`, and the helpers to build and check the `relatedCertRequest` attribute of a certificate request (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` gains an `ExtraAttributes` field for carrying it. Related certificates explains how Lamassu uses them.",{"_4190":2891,"_34937":2879,"_23830":66980,"_5":16479,"_31422":66946,"_3630":66981},[],"**Composite signature schemes in TLS.** The `tls` package adds 15 `SignatureScheme` constants, one per composite algorithm, advertised by default after the native ML-DSA schemes. They work only with TLS 1.3 and are tested with mutual authentication. See below for their code points.",{"_4190":2892,"_34937":2879,"_23830":66983,"_5":16479,"_31422":66950,"_3630":66984},[],"IANA has assigned no code points to the composite TLS signature schemes, so the fork uses the private-use range `0xFE00` to `0xFE0E`, in the order of the composite table: `0xFE00` is `MLDSA44-RSA2048-PSS-SHA256` and `0xFE0E` is `MLDSA65-Ed25519-SHA512`. A client or server built with a standard TLS library does not recognize them and will fall back to another scheme or fail the handshake. Interoperability is therefore limited to peers built from this fork, or to the native ML-DSA schemes (`0x0904` to `0x0906`) that standard Go 1.27 implements.",{"_4190":2893,"_34937":2879,"_23830":66986,"_5":16479,"_31422":66950,"_3630":66987},[],"The three variants that use RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` and `MLDSA65-RSA4096-PKCS15-SHA512`) are announced only in the `signature_algorithms_cert` extension, so they can appear in a certificate chain but a leaf certificate with such a key cannot sign the handshake.",{"_4190":2894,"_34937":2879,"_23830":66989,"_5":16479,"_31422":66950,"_3630":66990},[],"Code point",{"_4190":2895,"_34937":2879,"_23830":66992,"_5":16479,"_31422":66950,"_3630":66395},[],{"_4190":2896,"_34937":2879,"_23830":66994,"_5":16479,"_31422":66950,"_3630":66995},[],"`0xFE00`",{"_4190":2897,"_34937":2879,"_23830":66997,"_5":16479,"_31422":66950,"_3630":66406},[],{"_4190":2898,"_34937":2879,"_23830":66999,"_5":16479,"_31422":66950,"_3630":67000},[],"`0xFE01`",{"_4190":2899,"_34937":2879,"_23830":67002,"_5":16479,"_31422":66950,"_3630":66416},[],{"_4190":2900,"_34937":2879,"_23830":67004,"_5":16479,"_31422":66950,"_3630":67005},[],"`0xFE02`",{"_4190":2901,"_34937":2879,"_23830":67007,"_5":16479,"_31422":66950,"_3630":66425},[],{"_4190":2902,"_34937":2879,"_23830":67009,"_5":16479,"_31422":66950,"_3630":67010},[],"`0xFE03`",{"_4190":2903,"_34937":2879,"_23830":67012,"_5":16479,"_31422":66950,"_3630":66434},[],{"_4190":2904,"_34937":2879,"_23830":67014,"_5":16479,"_31422":66950,"_3630":67015},[],"`0xFE04`",{"_4190":2905,"_34937":2879,"_23830":67017,"_5":16479,"_31422":66950,"_3630":66443},[],{"_4190":2906,"_34937":2879,"_23830":67019,"_5":16479,"_31422":66950,"_3630":67020},[],"`0xFE05`",{"_4190":2907,"_34937":2879,"_23830":67022,"_5":16479,"_31422":66950,"_3630":66452},[],{"_4190":2908,"_34937":2879,"_23830":67024,"_5":16479,"_31422":66950,"_3630":67025},[],"`0xFE06`",{"_4190":2909,"_34937":2879,"_23830":67027,"_5":16479,"_31422":66950,"_3630":66461},[],{"_4190":2910,"_34937":2879,"_23830":67029,"_5":16479,"_31422":66950,"_3630":67030},[],"`0xFE07`",{"_4190":2911,"_34937":2879,"_23830":67032,"_5":16479,"_31422":66950,"_3630":66470},[],{"_4190":2912,"_34937":2879,"_23830":67034,"_5":16479,"_31422":66950,"_3630":67035},[],"`0xFE08`",{"_4190":2913,"_34937":2879,"_23830":67037,"_5":16479,"_31422":66950,"_3630":66479},[],{"_4190":2914,"_34937":2879,"_23830":67039,"_5":16479,"_31422":66950,"_3630":67040},[],"`0xFE09`",{"_4190":2915,"_34937":2879,"_23830":67042,"_5":16479,"_31422":66950,"_3630":66489},[],{"_4190":2916,"_34937":2879,"_23830":67044,"_5":16479,"_31422":66950,"_3630":67045},[],"`0xFE0A`",{"_4190":2917,"_34937":2879,"_23830":67047,"_5":16479,"_31422":66950,"_3630":66498},[],{"_4190":2918,"_34937":2879,"_23830":67049,"_5":16479,"_31422":66950,"_3630":67050},[],"`0xFE0B`",{"_4190":2919,"_34937":2879,"_23830":67052,"_5":16479,"_31422":66950,"_3630":66507},[],{"_4190":2920,"_34937":2879,"_23830":67054,"_5":16479,"_31422":66950,"_3630":67055},[],"`0xFE0C`",{"_4190":2921,"_34937":2879,"_23830":67057,"_5":16479,"_31422":66950,"_3630":66516},[],{"_4190":2922,"_34937":2879,"_23830":67059,"_5":16479,"_31422":66950,"_3630":67060},[],"`0xFE0D`",{"_4190":2923,"_34937":2879,"_23830":67062,"_5":16479,"_31422":66950,"_3630":66525},[],{"_4190":2924,"_34937":2879,"_23830":67064,"_5":16479,"_31422":66950,"_3630":67065},[],"`0xFE0E`",{"_4190":2925,"_34937":2879,"_23830":67067,"_5":16479,"_31422":66950,"_3630":66534},[],{"_4190":2926,"_34937":2879,"_23830":67069,"_5":16479,"_31422":66950,"_3630":67070},[],"The key exchange is unchanged from upstream Go. Hybrid groups such as `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` and the pure `MLKEM1024` are those of the Go 1.27 standard library.",{"_4190":2927,"_34937":2879,"_23830":67072,"_5":16479,"_31422":66950,"_3630":66624},[],{"_4190":2928,"_34937":2879,"_23830":67074,"_5":16479,"_31422":66950,"_3630":67075},[],"Composition",{"_4190":2929,"_34937":2879,"_23830":67077,"_5":16479,"_31422":66950,"_3630":67078},[],"`X25519MLKEM768`",{"_4190":2930,"_34937":2879,"_23830":67080,"_5":16479,"_31422":66950,"_3630":67081},[],"X25519 + ML-KEM-768",{"_4190":2931,"_34937":2879,"_23830":67083,"_5":16479,"_31422":66950,"_3630":67084},[],"`SecP256r1MLKEM768`",{"_4190":2932,"_34937":2879,"_23830":67086,"_5":16479,"_31422":66950,"_3630":67087},[],"P-256 + ML-KEM-768",{"_4190":2933,"_34937":2879,"_23830":67089,"_5":16479,"_31422":66950,"_3630":67090},[],"`SecP384r1MLKEM1024`",{"_4190":2934,"_34937":2879,"_23830":67092,"_5":16479,"_31422":66950,"_3630":67093},[],"P-384 + ML-KEM-1024",{"_4190":2935,"_34937":2879,"_23830":67095,"_5":16479,"_31422":66950,"_3630":66909},[],{"_4190":2936,"_34937":2879,"_23830":67097,"_5":16479,"_31422":66950,"_3630":67098},[],"ML-KEM-1024 alone",{"_4190":2937,"_34937":2879,"_23830":67100,"_5":16479,"_31422":66950,"_3630":67101},[],"The connection stays protected while at least one component of a hybrid group is secure. The key exchange is independent of the certificate type, so a connection can use a classical certificate and still have a post-quantum key exchange.",{"_4190":2938,"_34937":2879,"_23830":67103,"_5":16479,"_31422":66954,"_3630":67104},[],"The following program creates a self-signed composite certificate and uses it as the server certificate of a TLS 1.3 configuration. Error handling is omitted.",{"_4190":2939,"_34937":2879,"_23830":67106,"_5":16479,"_31422":66954,"_3630":67107},[],"A composite key can also sign a message directly, with an optional context of at most 255 bytes:",{"_4190":2940,"_34937":2879,"_23830":67109,"_5":16479,"_31422":66958,"_3630":67110},[],"The first iterations of the fork implemented Chameleon certificates, defined in `draft-bonnell-lamps-chameleon-certs`. The idea is to pair two certificates for the same subject, for example a classical one and a post-quantum one, by issuing the first with an extension that encodes only the differences to the second. A relying party that understands the extension can rebuild the paired certificate from it and validate that one, so a single issued certificate carries both identities without changing the path validation rules of RFC 5280.",{"_4190":2941,"_34937":2879,"_23830":67112,"_5":16479,"_31422":66958,"_3630":67113},[],"The work was dropped because the draft expired without becoming a standard and is no longer being pursued, so there was no stable specification to interoperate with. Nothing in the current implementation depends on it.",{"_4190":2942,"_34937":2879,"_23830":67115,"_5":16479,"_31422":66962,"_3630":67116},[],"The fork is built in CI by a workflow that runs the Go test suite and then publishes a multi-architecture image, `ghcr.io/lamassuiot/golang-pqc`, tagged `go1.27` and, for the `release-branch.go1.27` branch, `latest`. The image contains the toolchain under `/usr/local/go-pqc` with `GOROOT` pointing at it.",{"_4190":2943,"_34937":2879,"_23830":67118,"_5":16479,"_31422":66962,"_3630":67119},[],"To build the toolchain from source instead, use the `release-branch.go1.27` branch and the standard Go source build:",{"_4190":2944,"_34937":2879,"_23830":67121,"_5":16479,"_31422":66962,"_3630":67122},[],"The resulting `bin/go` command is used like any other Go toolchain.",{"_4190":2945,"_34937":2879,"_23830":67124,"_5":16479,"_31422":66962,"_3630":67125},[],"Lamassu consumes the toolchain in two ways. The backend images (CA, KMS, VA, alerts, device manager, DMS manager and the monolithic build) use `ghcr.io/lamassuiot/golang-pqc:latest` as their builder image. The backend CI workflow installs the same toolchain through a custom setup action in place of `actions/setup-go`, and the backend requires `go 1.27.3` in its module file. Traefik is not built from the image: its `build.sh` script expects a compiled checkout of the fork in a sibling directory and produces the binary outside a container. See TLS front proxy with Traefik.",{"_4190":2946,"_34937":2879,"_23830":67127,"_5":16479,"_31422":66962,"_3630":67128},[],"<Card title=\"Algorithms\" description=\"The identifiers and parameter sets behind these constants.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4190":2947,"_34937":2879,"_23830":67130,"_5":16479,"_31422":66962,"_3630":67131},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the fork is used to terminate device TLS.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4190":2948,"_34937":2948,"_5":16871,"_3630":67133,"_35372":67134,"_23830":67136,"_31422":2948},"HTTPS integration tests",[58062,59537,66160,67135],"Integration tests",[],{"_4190":2949,"_34937":2948,"_23830":67138,"_5":16479,"_31422":2948,"_3630":67139},[],"Results of testing a Lamassu HTTPS endpoint with OpenSSL and curl using post-quantum key exchange and post-quantum and composite certificates.",{"_4190":2950,"_34937":2948,"_5":35369,"_23830":67141,"_31422":67142,"_3630":67143},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#scenario","Scenario",{"_4190":2951,"_34937":2948,"_5":35369,"_23830":67145,"_31422":67146,"_3630":67147},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#results","Results",{"_4190":2952,"_34937":2948,"_5":35369,"_23830":67149,"_31422":67150,"_3630":67151},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#reproduce-a-case","Reproduce a case",{"_4190":2953,"_34937":2948,"_5":35369,"_23830":67153,"_31422":67154,"_3630":67155},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#connect-offering-one-group-and-one-signature-scheme","Connect offering one group and one signature scheme",{"_4190":2954,"_34937":2948,"_5":35369,"_23830":67157,"_31422":67158,"_3630":67159},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#send-a-request","Send a request",{"_4190":2955,"_34937":2948,"_5":35369,"_23830":67161,"_31422":67162,"_3630":67163},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#check-that-a-wrong-offer-is-rejected","Check that a wrong offer is rejected",{"_4190":2956,"_34937":2948,"_23830":67165,"_5":16479,"_31422":2948,"_3630":67166},[],"This test connects to a Lamassu API endpoint over HTTPS from an OpenSSL client and checks that the post-quantum handshake, the certificate chain and the application request all succeed. The overview explains the clients, the test matrix and what each check proves.",{"_4190":2957,"_34937":2948,"_23830":67168,"_5":16479,"_31422":67142,"_3630":67169},[],"The client requests `GET /api/ca/health` through the Traefik front proxy, which forwards it to Envoy Gateway and the CA service. The server certificate and the CA that signed it were created outside Lamassu and loaded into the front proxy for each case. For each case the proxy was configured with the key exchange groups and the certificate of that row and column of the matrix.",{"_4190":2958,"_34937":2948,"_23830":67171,"_5":16479,"_31422":67142,"_3630":67172},[],"The CAs and certificates are test material made outside Lamassu, valid for a short period and with the server name as their subject alternative name. They are not issued by the Lamassu CA service.",{"_4190":2959,"_34937":2948,"_23830":67174,"_5":16479,"_31422":67146,"_3630":67175},[],"All nine combinations of key exchange and certificate passed, and so did the three additional composite certificates.",{"_4190":2960,"_34937":2948,"_23830":67177,"_5":16479,"_31422":67146,"_3630":67178},[],"Key exchange ↓ / Certificate →",{"_4190":2961,"_34937":2948,"_23830":67180,"_5":16479,"_31422":67146,"_3630":67181},[],"**T**: ECDSA P-256",{"_4190":2962,"_34937":2948,"_23830":67183,"_5":16479,"_31422":67146,"_3630":67184},[],"**PQ**: ML-DSA-65",{"_4190":2963,"_34937":2948,"_23830":67186,"_5":16479,"_31422":67146,"_3630":67187},[],"**PQ/T**: `MLDSA65-RSA3072-PSS-SHA512`",{"_4190":2964,"_34937":2948,"_23830":67189,"_5":16479,"_31422":67146,"_3630":67190},[],"**T**",{"_4190":2965,"_34937":2948,"_23830":67192,"_5":16479,"_31422":67146,"_3630":67193},[],"✅ `X25519`, `ecdsa_secp256r1_sha256`",{"_4190":2966,"_34937":2948,"_23830":67195,"_5":16479,"_31422":67146,"_3630":67196},[],"✅ `X25519`, `mldsa65`",{"_4190":2967,"_34937":2948,"_23830":67198,"_5":16479,"_31422":67146,"_3630":67199},[],"✅ `X25519`, `mldsa65_rsa3072_pss`",{"_4190":2968,"_34937":2948,"_23830":67201,"_5":16479,"_31422":67146,"_3630":67202},[],"**PQ**",{"_4190":2969,"_34937":2948,"_23830":67204,"_5":16479,"_31422":67146,"_3630":67205},[],"✅ `MLKEM1024`, `ecdsa_secp256r1_sha256`",{"_4190":2970,"_34937":2948,"_23830":67207,"_5":16479,"_31422":67146,"_3630":67208},[],"✅ `MLKEM1024`, `mldsa65`",{"_4190":2971,"_34937":2948,"_23830":67210,"_5":16479,"_31422":67146,"_3630":67211},[],"✅ `MLKEM1024`, `mldsa65_rsa3072_pss`",{"_4190":2972,"_34937":2948,"_23830":67213,"_5":16479,"_31422":67146,"_3630":67214},[],"**PQ/T**",{"_4190":2973,"_34937":2948,"_23830":67216,"_5":16479,"_31422":67146,"_3630":67217},[],"✅ `X25519MLKEM768`, `ecdsa_secp256r1_sha256`",{"_4190":2974,"_34937":2948,"_23830":67219,"_5":16479,"_31422":67146,"_3630":67220},[],"✅ `X25519MLKEM768`, `mldsa65`",{"_4190":2975,"_34937":2948,"_23830":67222,"_5":16479,"_31422":67146,"_3630":67223},[],"✅ `X25519MLKEM768`, `mldsa65_rsa3072_pss`",{"_4190":2976,"_34937":2948,"_23830":67225,"_5":16479,"_31422":67146,"_3630":67226},[],"Each cell shows the negotiated group and the signature scheme of the handshake. In every case the chain verified, the request returned `200` and both negative checks were rejected with `handshake_failure`.",{"_4190":2977,"_34937":2948,"_23830":67228,"_5":16479,"_31422":67146,"_3630":67229},[],"Additional composite",{"_4190":2978,"_34937":2948,"_23830":67231,"_5":16479,"_31422":67146,"_3630":67232},[],"Signature scheme",{"_4190":2979,"_34937":2948,"_23830":67234,"_5":16479,"_31422":67146,"_3630":63320},[],{"_4190":2980,"_34937":2948,"_23830":67236,"_5":16479,"_31422":67146,"_3630":67237},[],"`MLDSA44-ECDSA-P256-SHA256`",{"_4190":2981,"_34937":2948,"_23830":67239,"_5":16479,"_31422":67146,"_3630":67240},[],"`mldsa44_ecdsa_p256`",{"_4190":2982,"_34937":2948,"_23830":67242,"_5":16479,"_31422":67146,"_3630":67243},[],"✅ with `X25519MLKEM768`",{"_4190":2983,"_34937":2948,"_23830":67245,"_5":16479,"_31422":67146,"_3630":67246},[],"`MLDSA65-ECDSA-P256-SHA512`",{"_4190":2984,"_34937":2948,"_23830":67248,"_5":16479,"_31422":67146,"_3630":67249},[],"`mldsa65_ecdsa_p256`",{"_4190":2985,"_34937":2948,"_23830":67251,"_5":16479,"_31422":67146,"_3630":67243},[],{"_4190":2986,"_34937":2948,"_23830":67253,"_5":16479,"_31422":67146,"_3630":67254},[],"`MLDSA65-Ed25519-SHA512`",{"_4190":2987,"_34937":2948,"_23830":67256,"_5":16479,"_31422":67146,"_3630":67257},[],"`mldsa65_ed25519`",{"_4190":2988,"_34937":2948,"_23830":67259,"_5":16479,"_31422":67146,"_3630":67243},[],{"_4190":2989,"_34937":2948,"_23830":67261,"_5":16479,"_31422":67146,"_3630":67262},[],"With a single server configuration that holds the ECDSA, ML-DSA-65 and composite certificates at once and accepts all three key exchange classes, a client that offered one group and one signature scheme negotiated each of the nine combinations. `curl` returned `200` when it trusted the three CAs.",{"_4190":2990,"_34937":2948,"_23830":67264,"_5":16479,"_31422":67146,"_3630":67265},[],"A server with certificates of several classes serves the first that matches the client's signature preference. A default OpenSSL 3.5 or later client prefers ML-DSA, so a client that trusts only the ECDSA CA fails with `unable to get local issuer certificate`, even though the connection itself worked. Give clients the CAs of every class the server may present.",{"_4190":2991,"_34937":2948,"_23830":67267,"_5":16479,"_31422":67150,"_3630":67268},[],"You need OpenSSL 3.5 or later. For composite certificates, also the `hybrid-provider` module with code points that match the Go PQC toolchain, loaded through `OPENSSL_CONF`. Use the CA file of the case as `ca.pem`.",{"_4190":2992,"_34937":2948,"_23830":67270,"_5":16479,"_31422":67154,"_3630":67271},[],"This example tests PQ/T key exchange with the composite certificate, and prints the negotiated values:",{"_4190":2993,"_34937":2948,"_23830":67273,"_5":16479,"_31422":67154,"_3630":67274},[],"Expected output:",{"_4190":2994,"_34937":2948,"_23830":67276,"_5":16479,"_31422":67158,"_3630":67277},[],"Replace the `grep` with an HTTP request to confirm that the application layer works through the proxy:",{"_4190":2995,"_34937":2948,"_23830":67279,"_5":16479,"_31422":67158,"_3630":67280},[],"The response starts with `HTTP/1.1 200 OK`. With `curl` and a bundle that contains the CAs of the classes the server presents, `curl --cacert ca-bundle.pem https://<LAMASSU_HOST>/api/ca/health` returns `200` as well.",{"_4190":2996,"_34937":2948,"_23830":67282,"_5":16479,"_31422":67162,"_3630":67283},[],"Offer only classical groups to a server configured for PQ key exchange:",{"_4190":2997,"_34937":2948,"_23830":67285,"_5":16479,"_31422":67162,"_3630":67286},[],"The handshake fails with a `handshake failure` alert. Offering every signature scheme except the certificate's gives the same result.",{"_4190":2998,"_34937":2948,"_23830":67288,"_5":16479,"_31422":67162,"_3630":67289},[],"<Card title=\"MQTTS\" description=\"The same checks for an MQTT broker.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4190":2999,"_34937":2948,"_23830":67291,"_5":16479,"_31422":67162,"_3630":67292},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the proxy chooses a certificate and enforces key exchange.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4190":3000,"_34937":3000,"_5":16871,"_3630":67294,"_35372":67295,"_23830":67296,"_31422":3000},"MQTTS integration tests",[58062,59537,66160,67135],[],{"_4190":3001,"_34937":3000,"_23830":67298,"_5":16479,"_31422":3000,"_3630":67299},[],"Results of testing an MQTT broker behind the Lamassu TLS front proxy with mosquitto, using post-quantum key exchange and post-quantum and composite certificates.",{"_4190":3002,"_34937":3000,"_5":35369,"_23830":67301,"_31422":67302,"_3630":67143},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#scenario",{"_4190":3003,"_34937":3000,"_5":35369,"_23830":67304,"_31422":67305,"_3630":67147},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#results",{"_4190":3004,"_34937":3000,"_5":35369,"_23830":67307,"_31422":67308,"_3630":67151},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#reproduce-a-case",{"_4190":3005,"_34937":3000,"_5":35369,"_23830":67310,"_31422":67311,"_3630":67312},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#create-the-openssl-configuration","Create the OpenSSL configuration",{"_4190":3006,"_34937":3000,"_5":35369,"_23830":67314,"_31422":67315,"_3630":67316},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#subscribe-and-publish","Subscribe and publish",{"_4190":3007,"_34937":3000,"_5":35369,"_23830":67318,"_31422":67319,"_3630":67163},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#check-that-a-wrong-offer-is-rejected",{"_4190":3008,"_34937":3000,"_5":35369,"_23830":67321,"_31422":67322,"_3630":66615},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#things-to-know",{"_4190":3009,"_34937":3000,"_23830":67324,"_5":16479,"_31422":3000,"_3630":67325},[],"This test connects `mosquitto_pub` and `mosquitto_sub` to an MQTT broker over TLS and checks that messages travel through it with post-quantum key exchange and post-quantum or composite server certificates. The overview explains the clients, the test matrix and what each check proves.",{"_4190":3010,"_34937":3000,"_23830":67327,"_5":16479,"_31422":67302,"_3630":67328},[],"The broker is EMQX 5.8.9. It listens for MQTT in clear text inside the cluster, and the Lamassu TLS front proxy (TLS front proxy with Traefik) terminates TLS for it on port 8883 and forwards the traffic. The TLS is one-way: the broker's endpoint presents its certificate, and the client presents none. The server certificate and its CA were created outside Lamassu, and the proxy was configured for each case with the key exchange groups and certificate of that row and column of the matrix.",{"_4190":3011,"_34937":3000,"_23830":67330,"_5":16479,"_31422":67302,"_3630":67331},[],"The clients are `mosquitto_pub` and `mosquitto_sub` 2.1.2, using MQTT 3.1.1 over TLS 1.3 and linked against OpenSSL 4.1.0. A case passes when the subscriber receives the message that the publisher sent through the broker, both clients validate the certificate chain against the CA of the case and the server name, and the two negative checks are rejected.",{"_4190":3012,"_34937":3000,"_23830":67333,"_5":16479,"_31422":67305,"_3630":67334},[],"All twelve cases passed. In each one, `mosquitto_sub` subscribed to a topic, `mosquitto_pub` published a unique value, and the subscriber received it. The test ran twice per case: once with the client offering every group and signature scheme, and once with the client offering only the group and the signature scheme expected for the case. The second run shows that the broker's endpoint negotiated exactly that group and scheme, because the client offered nothing else.",{"_4190":3013,"_34937":3000,"_23830":67336,"_5":16479,"_31422":67305,"_3630":67178},[],{"_4190":3014,"_34937":3000,"_23830":67338,"_5":16479,"_31422":67305,"_3630":67181},[],{"_4190":3015,"_34937":3000,"_23830":67340,"_5":16479,"_31422":67305,"_3630":67184},[],{"_4190":3016,"_34937":3000,"_23830":67342,"_5":16479,"_31422":67305,"_3630":67187},[],{"_4190":3017,"_34937":3000,"_23830":67344,"_5":16479,"_31422":67305,"_3630":67190},[],{"_4190":3018,"_34937":3000,"_23830":67346,"_5":16479,"_31422":67305,"_3630":67193},[],{"_4190":3019,"_34937":3000,"_23830":67348,"_5":16479,"_31422":67305,"_3630":67196},[],{"_4190":3020,"_34937":3000,"_23830":67350,"_5":16479,"_31422":67305,"_3630":67199},[],{"_4190":3021,"_34937":3000,"_23830":67352,"_5":16479,"_31422":67305,"_3630":67202},[],{"_4190":3022,"_34937":3000,"_23830":67354,"_5":16479,"_31422":67305,"_3630":67205},[],{"_4190":3023,"_34937":3000,"_23830":67356,"_5":16479,"_31422":67305,"_3630":67208},[],{"_4190":3024,"_34937":3000,"_23830":67358,"_5":16479,"_31422":67305,"_3630":67211},[],{"_4190":3025,"_34937":3000,"_23830":67360,"_5":16479,"_31422":67305,"_3630":67214},[],{"_4190":3026,"_34937":3000,"_23830":67362,"_5":16479,"_31422":67305,"_3630":67217},[],{"_4190":3027,"_34937":3000,"_23830":67364,"_5":16479,"_31422":67305,"_3630":67220},[],{"_4190":3028,"_34937":3000,"_23830":67366,"_5":16479,"_31422":67305,"_3630":67223},[],{"_4190":3029,"_34937":3000,"_23830":67368,"_5":16479,"_31422":67305,"_3630":67369},[],"The additional composite certificates behave the same way with PQ/T key exchange.",{"_4190":3030,"_34937":3000,"_23830":67371,"_5":16479,"_31422":67305,"_3630":67229},[],{"_4190":3031,"_34937":3000,"_23830":67373,"_5":16479,"_31422":67305,"_3630":67232},[],{"_4190":3032,"_34937":3000,"_23830":67375,"_5":16479,"_31422":67305,"_3630":63320},[],{"_4190":3033,"_34937":3000,"_23830":67377,"_5":16479,"_31422":67305,"_3630":67237},[],{"_4190":3034,"_34937":3000,"_23830":67379,"_5":16479,"_31422":67305,"_3630":67240},[],{"_4190":3035,"_34937":3000,"_23830":67381,"_5":16479,"_31422":67305,"_3630":67382},[],"✅",{"_4190":3036,"_34937":3000,"_23830":67384,"_5":16479,"_31422":67305,"_3630":67246},[],{"_4190":3037,"_34937":3000,"_23830":67386,"_5":16479,"_31422":67305,"_3630":67249},[],{"_4190":3038,"_34937":3000,"_23830":67388,"_5":16479,"_31422":67305,"_3630":67382},[],{"_4190":3039,"_34937":3000,"_23830":67390,"_5":16479,"_31422":67305,"_3630":67254},[],{"_4190":3040,"_34937":3000,"_23830":67392,"_5":16479,"_31422":67305,"_3630":67257},[],{"_4190":3041,"_34937":3000,"_23830":67394,"_5":16479,"_31422":67305,"_3630":67382},[],{"_4190":3042,"_34937":3000,"_23830":67396,"_5":16479,"_31422":67305,"_3630":67397},[],"When the client offered every group except those of the case, or every signature scheme except the certificate's, the TLS handshake failed with a `handshake failure` alert and the broker never sent a `CONNACK`. The same result held in all twelve cases.",{"_4190":3043,"_34937":3000,"_23830":67399,"_5":16479,"_31422":67305,"_3630":67400},[],"With a single server configuration that holds the ECDSA, ML-DSA-65 and composite certificates and accepts all three key exchange classes, each of the nine combinations connected on port 8883 when the client offered one group and one signature scheme. `mosquitto_pub` received `CONNACK (0)` every time.",{"_4190":3044,"_34937":3000,"_23830":67402,"_5":16479,"_31422":67308,"_3630":67403},[],"mosquitto has no options to choose key exchange groups or signature schemes, so they are set through an OpenSSL configuration file that `mosquitto_pub` and `mosquitto_sub` read from the `OPENSSL_CONF` environment variable. You need OpenSSL 3.5 or later; for composite certificates, also the `hybrid-provider` module with code points that match the Go PQC toolchain.",{"_4190":3045,"_34937":3000,"_23830":67405,"_5":16479,"_31422":67311,"_3630":67406},[],"This `pqc-client.cnf` makes the client offer only `X25519MLKEM768` and the composite signature scheme, and loads the composite provider:",{"_4190":3046,"_34937":3000,"_23830":67408,"_5":16479,"_31422":67311,"_3630":67409},[],"Remove the `hybrid` provider and the module for a case that uses ML-DSA or ECDSA only.",{"_4190":3047,"_34937":3000,"_23830":67411,"_5":16479,"_31422":67315,"_3630":67412},[],"Start the subscriber in one terminal and the publisher in another. Both validate the broker's certificate against `ca.pem`, the CA of the case:",{"_4190":3048,"_34937":3000,"_23830":67414,"_5":16479,"_31422":67315,"_3630":67415},[],"The subscriber prints `hello over pqc` and exits. Add `-d` to see the `CONNECT`, `CONNACK (0)`, `SUBACK` and `PUBLISH` packets.",{"_4190":3049,"_34937":3000,"_23830":67417,"_5":16479,"_31422":67319,"_3630":67418},[],"Change `Groups` to a list that does not include the group the server accepts, for example `Groups = X25519` against a server configured for `MLKEM1024`, and repeat the publish. The client fails with `tls alert handshake failure` and no `CONNACK` is received.",{"_4190":3050,"_34937":3000,"_23830":67420,"_5":16479,"_31422":67322,"_3630":67421},[],"**Hostname and certificate.** mosquitto uses the `-h` value as the connection target, the server name sent in the handshake and the name it verifies. The test certificates carry that name as a subject alternative name.",{"_4190":3051,"_34937":3000,"_23830":67423,"_5":16479,"_31422":67322,"_3630":67424},[],"**One certificate per name.** The front proxy keeps its certificates by name, not by port. An MQTT endpoint that shares its name with the HTTPS endpoint serves the same certificates, so give the broker its own name if it needs a different certificate.",{"_4190":3052,"_34937":3000,"_23830":67426,"_5":16479,"_31422":67322,"_3630":67427},[],"**Unpinned defaults were not tested.** Every run set the group and signature offer explicitly, so what mosquitto negotiates with the default OpenSSL offer was not checked in this test. The HTTPS tests do cover a default OpenSSL client: it is served the ML-DSA certificate if the server holds one.",{"_4190":3053,"_34937":3000,"_23830":67429,"_5":16479,"_31422":67322,"_3630":67430},[],"**Other clients on the same port.** Enforcing TLS 1.3 or post-quantum algorithms on a shared MQTT port affects every client that connects to it. During the tests the proxy logged connection attempts from other clients that only support TLS 1.2 or earlier, or that did not trust the certificate. Identify them before making the setting permanent.",{"_4190":3054,"_34937":3000,"_23830":67432,"_5":16479,"_31422":67322,"_3630":67433},[],"<Card title=\"HTTPS\" description=\"The same checks for a Lamassu HTTPS endpoint.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4190":3055,"_34937":3000,"_23830":67435,"_5":16479,"_31422":67322,"_3630":67436},[],"<Card title=\"Deployment with the Helm chart\" description=\"Deploy the front proxy that terminates the TLS.\" href=\"/docs/platform/pqc/deployment\" />",{"_4190":3056,"_34937":3056,"_5":16871,"_3630":67438,"_35372":67439,"_23830":67440,"_31422":3056},"Integration tests overview",[58062,59537,66160,67135],[],{"_4190":3057,"_34937":3056,"_23830":67442,"_5":16479,"_31422":3056,"_3630":67443},[],"Evidence that software outside Lamassu negotiates post-quantum key exchange and verifies post-quantum and composite certificates served by Lamassu.",{"_4190":3058,"_34937":3056,"_5":35369,"_23830":67445,"_31422":67446,"_3630":67447},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#what-was-tested","What was tested",{"_4190":3059,"_34937":3056,"_5":35369,"_23830":67449,"_31422":67450,"_3630":67451},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#the-test-matrix","The test matrix",{"_4190":3060,"_34937":3056,"_5":35369,"_23830":67453,"_31422":67454,"_3630":67455},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#what-each-case-checks","What each case checks",{"_4190":3061,"_34937":3056,"_5":35369,"_23830":67457,"_31422":67458,"_3630":67459},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#behaviour-to-expect","Behaviour to expect",{"_4190":3062,"_34937":3056,"_23830":67461,"_5":16479,"_31422":3056,"_3630":67462},[],"Post-quantum certificates only help if the systems that consume them can use them. These integration tests check that clients and brokers that are not part of Lamassu, built on a different cryptographic library, can connect to a Lamassu TLS endpoint, negotiate post-quantum key exchange and verify post-quantum and composite certificates. Two protocols were tested: HTTPS and MQTTS.",{"_4190":3063,"_34937":3056,"_23830":67464,"_5":16479,"_31422":3056,"_3630":67465},[],"The certificates and CAs used in the tests were generated outside Lamassu, with standard tools, to show that the Go PQC toolchain implements the X.509 and TLS formats in an interoperable way. They show that certificates created externally work with Lamassu's TLS endpoint, and that independent software verifies them. They do not test certificates issued by a Lamassu CA.",{"_4190":3064,"_34937":3056,"_23830":67467,"_5":16479,"_31422":67446,"_3630":67468},[],"The server is the Traefik front proxy that terminates device TLS in Lamassu (TLS front proxy with Traefik). It is built with the Go PQC toolchain and was configured for each test with one key exchange class and one certificate class.",{"_4190":3065,"_34937":3056,"_23830":67470,"_5":16479,"_31422":67446,"_3630":67471},[],"The clients are independent implementations:",{"_4190":3066,"_34937":3056,"_23830":67473,"_5":16479,"_31422":67446,"_3630":67474},[],"**OpenSSL 4.0.3 and 4.1.0**, with the native ML-KEM and ML-DSA support of OpenSSL 3.5 and later.",{"_4190":3067,"_34937":3056,"_23830":67476,"_5":16479,"_31422":67446,"_3630":67477},[],"**The OpenSSL `hybrid-provider` module**, for composite ML-DSA. The build used was written against draft 19 of the specification, which was later published as RFC 10073; the test vectors of both are identical, but the provider was not otherwise checked against the final text.",{"_4190":3068,"_34937":3056,"_23830":67479,"_5":16479,"_31422":67446,"_3630":67480},[],"**`curl`*&#x2A; for HTTPS and **`mosquitto_pub` and `mosquitto_sub` 2.1.2** for MQTTS, both linked against that OpenSSL.",{"_4190":3069,"_34937":3056,"_23830":67482,"_5":16479,"_31422":67450,"_3630":67483},[],"Each combination of key exchange and certificate was tested separately, using the families that Lamassu uses elsewhere (T, PQ and PQ/T, see Algorithms).",{"_4190":3070,"_34937":3056,"_23830":67485,"_5":16479,"_31422":67450,"_3630":67486},[],"Key exchange",{"_4190":3071,"_34937":3056,"_23830":67488,"_5":16479,"_31422":67450,"_3630":67489},[],"Groups the server accepts",{"_4190":3072,"_34937":3056,"_23830":67491,"_5":16479,"_31422":67450,"_3630":67190},[],{"_4190":3073,"_34937":3056,"_23830":67493,"_5":16479,"_31422":67450,"_3630":66900},[],{"_4190":3074,"_34937":3056,"_23830":67495,"_5":16479,"_31422":67450,"_3630":67202},[],{"_4190":3075,"_34937":3056,"_23830":67497,"_5":16479,"_31422":67450,"_3630":66909},[],{"_4190":3076,"_34937":3056,"_23830":67499,"_5":16479,"_31422":67450,"_3630":67214},[],{"_4190":3077,"_34937":3056,"_23830":67501,"_5":16479,"_31422":67450,"_3630":66918},[],{"_4190":3078,"_34937":3056,"_23830":67503,"_5":16479,"_31422":67450,"_3630":62435},[],{"_4190":3079,"_34937":3056,"_23830":67505,"_5":16479,"_31422":67450,"_3630":67506},[],"Server certificate",{"_4190":3080,"_34937":3056,"_23830":67508,"_5":16479,"_31422":67450,"_3630":67190},[],{"_4190":3081,"_34937":3056,"_23830":67510,"_5":16479,"_31422":67450,"_3630":67511},[],"ECDSA P-256",{"_4190":3082,"_34937":3056,"_23830":67513,"_5":16479,"_31422":67450,"_3630":67202},[],{"_4190":3083,"_34937":3056,"_23830":67515,"_5":16479,"_31422":67450,"_3630":66298},[],{"_4190":3084,"_34937":3056,"_23830":67517,"_5":16479,"_31422":67450,"_3630":67214},[],{"_4190":3085,"_34937":3056,"_23830":67519,"_5":16479,"_31422":67450,"_3630":67520},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`",{"_4190":3086,"_34937":3056,"_23830":67522,"_5":16479,"_31422":67450,"_3630":67523},[],"That gives nine combinations. Three more composite certificates were tested with PQ/T key exchange: `MLDSA44-ECDSA-P256-SHA256`, `MLDSA65-ECDSA-P256-SHA512` and `MLDSA65-Ed25519-SHA512`, for twelve cases in total. Every certificate was issued by a test CA with the same algorithm as the certificate.",{"_4190":3087,"_34937":3056,"_23830":67525,"_5":16479,"_31422":67454,"_3630":67526},[],"A case passes only if all of these hold:",{"_4190":3088,"_34937":3056,"_23830":67528,"_5":16479,"_31422":67454,"_3630":67529},[],"**Key exchange.** The group negotiated in the handshake is the one expected for the case.",{"_4190":3089,"_34937":3056,"_23830":67531,"_5":16479,"_31422":67454,"_3630":67532},[],"**Signature.** The signature scheme of the server's handshake signature is the one expected for the certificate.",{"_4190":3090,"_34937":3056,"_23830":67534,"_5":16479,"_31422":67454,"_3630":67535},[],"**Chain.** The client verifies the certificate chain against the CA of the case and the server name, with no verification error.",{"_4190":3091,"_34937":3056,"_23830":67537,"_5":16479,"_31422":67454,"_3630":67538},[],"**Application traffic.** The protocol works: an HTTP request returns `200`, or an MQTT message published to the broker reaches a subscriber.",{"_4190":3092,"_34937":3056,"_23830":67540,"_5":16479,"_31422":67454,"_3630":67541},[],"**Wrong key exchange is rejected.** A client that offers every group except those of the case's class fails with the TLS alert `handshake_failure`.",{"_4190":3093,"_34937":3056,"_23830":67543,"_5":16479,"_31422":67454,"_3630":67544},[],"**Wrong certificate scheme is rejected.** A client that offers every signature scheme except the certificate's fails with the same alert.",{"_4190":3094,"_34937":3056,"_23830":67546,"_5":16479,"_31422":67454,"_3630":67547},[],"The last two checks show that the server enforces its configuration, not just that it accepts a compatible client.",{"_4190":3095,"_34937":3056,"_23830":67549,"_5":16479,"_31422":67458,"_3630":67550},[],"**Composite code points had to be aligned.** The TLS signature schemes of composite algorithms use private-use code points. The `hybrid-provider` uses different values by default, so for the tests its code points were set to those of the Go PQC toolchain. A client that implements composite TLS must use the same values.",{"_4190":3096,"_34937":3056,"_23830":67552,"_5":16479,"_31422":67458,"_3630":67553},[],"**Pure ML-DSA and ML-KEM need nothing extra.** They work with OpenSSL 3.5 or later as it is; only composite certificates need the provider.",{"_4190":3097,"_34937":3056,"_23830":67555,"_5":16479,"_31422":67458,"_3630":67556},[],"**Some handshakes take an extra round trip.** A client sends the `X25519MLKEM768` key share first. When the server is configured for a class that does not include it (T and PQ), the server answers with a HelloRetryRequest and the handshake completes with the group it asks for.",{"_4190":3098,"_34937":3056,"_23830":67558,"_5":16479,"_31422":67458,"_3630":67559},[],"**The client's signature preference decides the certificate.** When the server holds certificates of several classes for the same name, it serves the first one that matches the client's list of signature schemes. A default OpenSSL 3.5 or later client lists ML-DSA first, so it is served the ML-DSA certificate and must trust that CA.",{"_4190":3099,"_34937":3056,"_23830":67561,"_5":16479,"_31422":67458,"_3630":67562},[],"<Card title=\"HTTPS\" description=\"A Lamassu API endpoint tested with openssl and curl.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4190":3100,"_34937":3056,"_23830":67564,"_5":16479,"_31422":67458,"_3630":67565},[],"<Card title=\"MQTTS\" description=\"An MQTT broker behind the TLS front proxy, tested with mosquitto.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4190":3101,"_34937":3056,"_23830":67567,"_5":16479,"_31422":67458,"_3630":67568},[],"<Card title=\"Known limitations\" description=\"What is not covered by these tests or by the platform.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":3102,"_34937":3102,"_5":16871,"_3630":67570,"_35372":67571,"_23830":67572,"_31422":3102},"Keys and certificate authorities",[58062,59537,66160,66575],[],{"_4190":3103,"_34937":3102,"_23830":67574,"_5":16479,"_31422":3102,"_3630":67575},[],"Create post-quantum keys and CAs, sign with them and issue certificates, with the engine support, API values and constraints that apply.",{"_4190":3104,"_34937":3102,"_5":35369,"_23830":67577,"_31422":67578,"_3630":67579},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#choose-a-crypto-engine-that-supports-the-algorithm","Choose a crypto engine that supports the algorithm",{"_4190":3105,"_34937":3102,"_5":35369,"_23830":67581,"_31422":67582,"_3630":67583},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-key","Create a key",{"_4190":3106,"_34937":3102,"_5":35369,"_23830":67585,"_31422":67586,"_3630":67587},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-certificate-authority","Create a certificate authority",{"_4190":3107,"_34937":3102,"_5":35369,"_23830":67589,"_31422":67590,"_3630":67591},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#mixing-algorithms-in-a-hierarchy","Mixing algorithms in a hierarchy",{"_4190":3108,"_34937":3102,"_5":35369,"_23830":67593,"_31422":67594,"_3630":67595},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#signing-and-verifying-with-a-key","Signing and verifying with a key",{"_4190":3109,"_34937":3102,"_5":35369,"_23830":67597,"_31422":67598,"_3630":67599},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#constraints-to-keep-in-mind","Constraints to keep in mind",{"_4190":3110,"_34937":3102,"_23830":67601,"_5":16479,"_31422":3102,"_3630":67602},[],"The Lamassu backend treats post-quantum keys as one more key type of the Key Management Service (KMS). A certificate authority created with such a key signs certificates and revocation lists through the same paths as an RSA or ECDSA CA, because the fork of Go performs the signing. This page explains what to send to the API, which crypto engines can hold the keys and where the behaviour differs from classical keys. The backend must be built with the Go PQC toolchain.",{"_4190":3111,"_34937":3102,"_23830":67604,"_5":16479,"_31422":67578,"_3630":67605},[],"Not every crypto engine can create or hold post-quantum keys. Only the engines that run the cryptography in the Lamassu process can.",{"_4190":3112,"_34937":3102,"_23830":67607,"_5":16479,"_31422":67578,"_3630":67608},[],"Engine",{"_4190":3113,"_34937":3102,"_23830":67610,"_5":16479,"_31422":67578,"_3630":67611},[],"ML-DSA, SLH-DSA, Composite, Ed25519",{"_4190":3114,"_34937":3102,"_23830":67613,"_5":16479,"_31422":67578,"_3630":67614},[],"Filesystem",{"_4190":3115,"_34937":3102,"_23830":67616,"_5":16479,"_31422":67578,"_3630":67617},[],"Supported",{"_4190":3116,"_34937":3102,"_23830":67619,"_5":16479,"_31422":67578,"_3630":67620},[],"Software (golang)",{"_4190":3117,"_34937":3102,"_23830":67622,"_5":16479,"_31422":67578,"_3630":67617},[],{"_4190":3118,"_34937":3102,"_23830":67624,"_5":16479,"_31422":67578,"_3630":67625},[],"HashiCorp Vault KV2",{"_4190":3119,"_34937":3102,"_23830":67627,"_5":16479,"_31422":67578,"_3630":67628},[],"Not supported",{"_4190":3120,"_34937":3102,"_23830":67630,"_5":16479,"_31422":67578,"_3630":65068},[],{"_4190":3121,"_34937":3102,"_23830":67632,"_5":16479,"_31422":67578,"_3630":67628},[],{"_4190":3122,"_34937":3102,"_23830":67634,"_5":16479,"_31422":67578,"_3630":65072},[],{"_4190":3123,"_34937":3102,"_23830":67636,"_5":16479,"_31422":67578,"_3630":67628},[],{"_4190":3124,"_34937":3102,"_23830":67638,"_5":16479,"_31422":67578,"_3630":67639},[],"Azure Key Vault and Azure Secrets",{"_4190":3125,"_34937":3102,"_23830":67641,"_5":16479,"_31422":67578,"_3630":67628},[],{"_4190":3126,"_34937":3102,"_23830":67643,"_5":16479,"_31422":67578,"_3630":67644},[],"PKCS#11 (HSM)",{"_4190":3127,"_34937":3102,"_23830":67646,"_5":16479,"_31422":67578,"_3630":67628},[],{"_4190":3128,"_34937":3102,"_23830":67648,"_5":16479,"_31422":67578,"_3630":67649},[],"In practice, post-quantum keys currently require the filesystem engine, which has security level 1. Keys with a higher assurance level, in a hardware security module or a cloud KMS, are not available for these algorithms.",{"_4190":3129,"_34937":3102,"_23830":67651,"_5":16479,"_31422":67578,"_3630":67652},[],"The Vault KV2 and AWS Secrets Manager engines list the post-quantum key types among the types they support, so a request passes the compatibility check. The creation then fails with an `unsupported key type` error from the engine. Select a filesystem or software engine explicitly with `engine_id`.",{"_4190":3130,"_34937":3102,"_23830":67654,"_5":16479,"_31422":67582,"_3630":67655},[],"A KMS key is created with the algorithm and size described in Algorithms:",{"_4190":3131,"_34937":3102,"_23830":67657,"_5":16479,"_31422":67582,"_3630":67658},[],"Invalid parameters are rejected with an explicit message: an ML-DSA size other than 44, 65 or 87, an SLH-DSA identifier outside 1 to 12, a composite variant outside 1 to 15, or a composite variant that does not belong to the requested family. Importing a private key in PKCS#8 form detects the algorithm and the parameter set automatically; the import accepts ML-DSA, SLH-DSA, composite and Ed25519 keys.",{"_4190":3132,"_34937":3102,"_23830":67660,"_5":16479,"_31422":67586,"_3630":67661},[],"A CA with a post-quantum key uses the same request as any other CA, sent to `POST /api/ca/v1/cas`. Only `key_metadata` changes, where `bits` carries the parameter set. A root CA with ML-DSA-65:",{"_4190":3133,"_34937":3102,"_23830":67663,"_5":16479,"_31422":67586,"_3630":67664},[],"A root CA with a composite key of ML-DSA-44 and ECDSA P-256 uses `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 uses `\"type\": \"Ed25519\", \"bits\": 256` and SLH-DSA uses `\"type\": \"SLH-DSA\", \"bits\": 1` to select SLH-DSA-SHA2-128s. Subordinate CAs are created the same way: the subordinate signs its own certificate request with the KMS key and the parent CA issues the certificate.",{"_4190":3134,"_34937":3102,"_23830":67666,"_5":16479,"_31422":67586,"_3630":67667},[],"Existing CAs can be imported with a post-quantum private key for ML-DSA and Ed25519. Importing a CA with an SLH-DSA or composite key is not supported.",{"_4190":3135,"_34937":3102,"_23830":67669,"_5":16479,"_31422":67590,"_3630":67670},[],"The backend places no restriction on which algorithm issues which. A CA with an ML-DSA key can issue certificates to RSA, ECDSA, Ed25519 and ML-DSA subjects, and an RSA or ECDSA CA can issue certificates to post-quantum subjects. The test suite covers the full ML-DSA and Ed25519 matrix through the API, and covers SLH-DSA and composite CAs and leaves at the certificate engine level. This makes it possible to introduce a post-quantum CA beneath a classical root, or the reverse, but a relying party must be able to verify every algorithm in the chain. In TLS, the signatures in the certificate chain are checked against the client's `signature_algorithms_cert` extension, so a chain signed with ML-DSA or a composite algorithm needs a client that announces it there.",{"_4190":3136,"_34937":3102,"_23830":67672,"_5":16479,"_31422":67594,"_3630":67673},[],"The KMS signing endpoint accepts new `signature_algorithm` values. The `message_type` field is ignored for all of them. The ML-DSA, SLH-DSA and Ed25519 values are \"pure\": the message is signed directly, without pre-hashing (not HashML-DSA, HashSLH-DSA or Ed25519ph). The composite values hash the message with the hash of the variant and sign a message representative that includes a fixed label and the optional context.",{"_4190":3137,"_34937":3102,"_23830":67675,"_5":16479,"_31422":67594,"_3630":66091},[],{"_4190":3138,"_34937":3102,"_23830":67677,"_5":16479,"_31422":67594,"_3630":67678},[],"`signature_algorithm`",{"_4190":3139,"_34937":3102,"_23830":67680,"_5":16479,"_31422":67594,"_3630":67681},[],"ML-DSA-44, -65, -87",{"_4190":3140,"_34937":3102,"_23830":67683,"_5":16479,"_31422":67594,"_3630":67684},[],"`MLDSA_44_PURE`, `MLDSA_65_PURE`, `MLDSA_87_PURE`",{"_4190":3141,"_34937":3102,"_23830":67686,"_5":16479,"_31422":67594,"_3630":66177},[],{"_4190":3142,"_34937":3102,"_23830":67688,"_5":16479,"_31422":67594,"_3630":67689},[],"`SLHDSA_PURE`",{"_4190":3143,"_34937":3102,"_23830":67691,"_5":16479,"_31422":67594,"_3630":67692},[],"Composite",{"_4190":3144,"_34937":3102,"_23830":67694,"_5":16479,"_31422":67594,"_3630":67695},[],"`COMPOSITE_MLDSA_RSA_PURE`, `COMPOSITE_MLDSA_ECDSA_PURE`, `COMPOSITE_MLDSA_ED25519_PURE`",{"_4190":3145,"_34937":3102,"_23830":67697,"_5":16479,"_31422":67594,"_3630":66185},[],{"_4190":3146,"_34937":3102,"_23830":67699,"_5":16479,"_31422":67594,"_3630":67700},[],"`Ed25519_PURE`",{"_4190":3147,"_34937":3102,"_23830":67702,"_5":16479,"_31422":67594,"_3630":67703},[],"The backend does not check that the algorithm matches the key; choose the value that corresponds to the key type. When a CA signs a certificate or a revocation list, the algorithm is selected automatically.",{"_4190":3148,"_34937":3102,"_23830":67705,"_5":16479,"_31422":67598,"_3630":67706},[],"Several parts of the platform do not yet handle post-quantum keys. They are collected in Known limitations; the ones that affect daily operation are these.",{"_4190":3149,"_34937":3102,"_23830":67708,"_5":16479,"_31422":67598,"_3630":67709},[],"Issuance profiles enforce key restrictions only for RSA and ECDSA, through `allow_rsa_keys` and `allow_ecdsa_keys`. A profile with enforcement enabled does not block post-quantum keys, and has no switch to allow or deny them.",{"_4190":3150,"_34937":3102,"_23830":67711,"_5":16479,"_31422":67598,"_3630":67712},[],"The key strength recorded for a certificate whose key is post-quantum or Ed25519 is computed only for RSA and ECDSA, so those certificates are stored with an unknown key type and size and a low strength.",{"_4190":3151,"_34937":3102,"_23830":67714,"_5":16479,"_31422":67598,"_3630":67715},[],"OCSP responses are signed with the `golang.org/x/crypto/ocsp` library, which supports only RSA and ECDSA signing keys. A CA with a post-quantum, Ed25519 or composite key is therefore not expected to be able to sign OCSP responses; CRLs are produced with the fork and are not affected by this limit, although they are not covered by tests.",{"_4190":3152,"_34937":3102,"_23830":67717,"_5":16479,"_31422":67598,"_3630":67718},[],"Server-side key generation in the DMS (the EST `serverkeygen` operation) generates only RSA and ECDSA keys.",{"_4190":3153,"_34937":3102,"_23830":67720,"_5":16479,"_31422":67598,"_3630":67721},[],"<Card title=\"Related certificates\" description=\"Bind a post-quantum certificate to an existing classical one.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_4190":3154,"_34937":3102,"_23830":67723,"_5":16479,"_31422":67598,"_3630":67724},[],"<Card title=\"Dashboard\" description=\"Create the same objects from the web interface.\" href=\"/docs/platform/pqc/dashboard\" />",{"_4190":3155,"_34937":3155,"_5":16871,"_3630":67726,"_35372":67727,"_23830":67729,"_31422":3155},"Known limitations",[58062,59537,66160,67728],"Reference",[],{"_4190":3156,"_34937":3155,"_23830":67731,"_5":16479,"_31422":3155,"_3630":67732},[],"What is incomplete, non-standard or unverified in Lamassu's post-quantum support, grouped by component.",{"_4190":3157,"_34937":3155,"_5":35369,"_23830":67734,"_31422":67735,"_3630":67736},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#standards-and-interoperability","Standards and interoperability",{"_4190":3158,"_34937":3155,"_5":35369,"_23830":67738,"_31422":67739,"_3630":67740},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#keys-and-engines","Keys and engines",{"_4190":3159,"_34937":3155,"_5":35369,"_23830":67742,"_31422":67743,"_3630":67744},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#certificate-authority-and-validation","Certificate authority and validation",{"_4190":3160,"_34937":3155,"_5":35369,"_23830":67746,"_31422":67747,"_3630":66573},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#dashboard",{"_4190":3161,"_34937":3155,"_5":35369,"_23830":67749,"_31422":67750,"_3630":67751},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#build-and-deployment","Build and deployment",{"_4190":3162,"_34937":3155,"_23830":67753,"_5":16479,"_31422":3155,"_3630":67754},[],"This page collects the limits of the current implementation so they can be weighed before planning a deployment. Each one has been observed in the code or the tests of the branches described in this section.",{"_4190":3163,"_34937":3155,"_23830":67756,"_5":16479,"_31422":67735,"_3630":67757},[],"Composite certificates follow RFC 10073. The implementation was written against draft 19 and passes the RFC's test vectors, but it has not had a full conformance assessment. Three of its algorithms (the two Brainpool variants and Ed448) are not implemented. The composite signature schemes in TLS use private-use code points in `0xFE00` to `0xFE0E` because IANA has assigned none, so they interoperate only with peers built from the same Go fork. Composite RSA-PKCS#1 v1.5 variants cannot authenticate a TLS handshake. SLH-DSA has no TLS signature scheme. The related-certificate request attribute has not been checked against other implementations of RFC 9763.",{"_4190":3164,"_34937":3155,"_23830":67759,"_5":16479,"_31422":67739,"_3630":67760},[],"Post-quantum, composite and Ed25519 keys work only with the filesystem and software engines. The Vault KV2 and AWS Secrets Manager engines announce support and then fail at creation, and AWS KMS, Azure and PKCS#11 do not support them. There is therefore no hardware-backed or cloud-KMS-backed post-quantum key. Some engine error messages are copied from other engines and name the wrong one.",{"_4190":3165,"_34937":3155,"_23830":67762,"_5":16479,"_31422":67739,"_3630":67763},[],"The `CryptoEngine` interface gained methods to create and import each new key type. Engines developed outside the Lamassu repository must implement them.",{"_4190":3166,"_34937":3155,"_23830":67765,"_5":16479,"_31422":67743,"_3630":67766},[],"OCSP responses cannot be signed by a CA with a post-quantum, Ed25519 or composite key, because the signing library supports only RSA and ECDSA. CRL generation uses the fork's signing and is expected to work, but neither CRL nor OCSP has tests with these keys.",{"_4190":3167,"_34937":3155,"_23830":67768,"_5":16479,"_31422":67743,"_3630":67769},[],"Issuance profiles cannot allow or deny post-quantum algorithms; their enforcement applies only to RSA and ECDSA. The key strength of an issued certificate is computed only for RSA and ECDSA, so other certificates are stored with unknown type and size and low strength. Importing an existing CA with an SLH-DSA or composite key is not supported.",{"_4190":3168,"_34937":3155,"_23830":67771,"_5":16479,"_31422":67743,"_3630":67772},[],"The DMS can generate keys on the server only for RSA and ECDSA, so `serverkeygen` cannot return a post-quantum key. The enrollment flows through EST and the device manager have no tests with post-quantum keys.",{"_4190":3169,"_34937":3155,"_23830":67774,"_5":16479,"_31422":67743,"_3630":67775},[],"The backend does not evaluate the related-certificate extension. It only issues it.",{"_4190":3170,"_34937":3155,"_23830":67777,"_5":16479,"_31422":67747,"_3630":67778},[],"The in-browser SLH-DSA key generator maps parameter set identifiers differently from the rest of the interface, as described in Dashboard. Key type names are not uniform between screens, and the interface has no experimental notice and no translation.",{"_4190":3171,"_34937":3155,"_23830":67780,"_5":16479,"_31422":67750,"_3630":67781},[],"Everything depends on forks of Go and Traefik that are not upstream, and the proxy image has a mutable tag. The backend's OpenAPI specification for the KMS still lists only RSA, ECDSA and Ed25519 and does not reflect the new key types.",{"_4190":3172,"_34937":3155,"_23830":67783,"_5":16479,"_31422":67750,"_3630":67784},[],"The Helm chart uses fixed resource names, supports one release per namespace and sends traffic from Traefik to Envoy without verifying certificates. The post-quantum certificates created by the installer are valid for 365 days and are not renewed. The installer needs a Linux host and runs a Helm install, not an upgrade.",{"_4190":3173,"_34937":3155,"_23830":67786,"_5":16479,"_31422":67750,"_3630":67787},[],"<Card title=\"Post-quantum cryptography overview\" description=\"Return to the summary of the section.\" href=\"/docs/platform/pqc/overview\" />",{"_4190":3174,"_34937":3174,"_5":16871,"_3630":67789,"_35372":67790,"_23830":67791,"_31422":3174},"Post-quantum cryptography overview",[58062,59537,66160],[],{"_4190":3175,"_34937":3174,"_23830":67793,"_5":16479,"_31422":3174,"_3630":67794},[],"What post-quantum (PQC) support Lamassu adds to keys, certificate authorities, device TLS and deployment, and how its pieces fit together.",{"_4190":3176,"_34937":3174,"_5":35369,"_23830":67796,"_31422":67797,"_3630":67798},[],"/docs/pr-preview/pr-58/platform/pqc/overview#why-it-matters-for-device-fleets","Why it matters for device fleets",{"_4190":3177,"_34937":3174,"_5":35369,"_23830":67800,"_31422":67801,"_3630":67802},[],"/docs/pr-preview/pr-58/platform/pqc/overview#three-families-of-algorithms","Three families of algorithms",{"_4190":3178,"_34937":3174,"_5":35369,"_23830":67804,"_31422":67805,"_3630":67806},[],"/docs/pr-preview/pr-58/platform/pqc/overview#how-the-pieces-fit","How the pieces fit",{"_4190":3179,"_34937":3174,"_5":35369,"_23830":67808,"_31422":67809,"_3630":67810},[],"/docs/pr-preview/pr-58/platform/pqc/overview#where-to-read-next","Where to read next",{"_4190":3180,"_34937":3174,"_23830":67812,"_5":16479,"_31422":3174,"_3630":67813},[],"Lamassu can create keys, certificate authorities (CAs) and certificates that use post-quantum signature algorithms, and it can serve and verify them over TLS. The work spans five codebases that depend on one another: a fork of the Go toolchain that implements the algorithms, the Lamassu backend, the web dashboard, a fork of the Traefik proxy that terminates TLS for devices, and the Helm chart that deploys all of it together.",{"_4190":3181,"_34937":3174,"_23830":67815,"_5":16479,"_31422":3174,"_3630":67816},[],"PQC support lives in development branches and in forks of Go and Traefik, not in the upstream projects or in the standard Lamassu images. The composite TLS signature schemes use private-use code points that no other TLS stack understands, and the composite certificate format follows RFC 10073, a recent standard that has little deployment experience yet. Plan pilots and laboratory deployments, not production fleets. Known limitations lists what is incomplete.",{"_4190":3182,"_34937":3174,"_23830":67818,"_5":16479,"_31422":67797,"_3630":67819},[],"Certificates issued to devices often live for years, and the devices that hold them are hard to replace. A signature algorithm that is broken by a future quantum computer would force a fleet-wide re-enrollment. Issuing devices a certificate signed with a post-quantum or composite algorithm today, and serving them a TLS endpoint that accepts it, lets a fleet be validated against that risk before it becomes urgent. Signatures are not exposed to \"harvest now, decrypt later\" attacks the way a key exchange is, so the urgency is about the lifetime of certificates and devices, not about recorded traffic.",{"_4190":3183,"_34937":3174,"_23830":67821,"_5":16479,"_31422":67801,"_3630":67822},[],"Lamassu groups signature algorithms in three families, the same labels the dashboard shows.",{"_4190":3184,"_34937":3174,"_23830":67824,"_5":16479,"_31422":67801,"_3630":67825},[],"Label",{"_4190":3185,"_34937":3174,"_23830":67827,"_5":16479,"_31422":67801,"_3630":66401},[],{"_4190":3186,"_34937":3174,"_23830":67829,"_5":16479,"_31422":67801,"_3630":66158},[],{"_4190":3187,"_34937":3174,"_23830":67831,"_5":16479,"_31422":67801,"_3630":67190},[],{"_4190":3188,"_34937":3174,"_23830":67833,"_5":16479,"_31422":67801,"_3630":67834},[],"Traditional",{"_4190":3189,"_34937":3174,"_23830":67836,"_5":16479,"_31422":67801,"_3630":67837},[],"RSA, ECDSA, Ed25519",{"_4190":3190,"_34937":3174,"_23830":67839,"_5":16479,"_31422":67801,"_3630":67202},[],{"_4190":3191,"_34937":3174,"_23830":67841,"_5":16479,"_31422":67801,"_3630":67842},[],"Pure post-quantum",{"_4190":3192,"_34937":3174,"_23830":67844,"_5":16479,"_31422":67801,"_3630":67845},[],"ML-DSA, SLH-DSA",{"_4190":3193,"_34937":3174,"_23830":67847,"_5":16479,"_31422":67801,"_3630":67214},[],{"_4190":3194,"_34937":3174,"_23830":67849,"_5":16479,"_31422":67801,"_3630":67850},[],"Hybrid (composite)",{"_4190":3195,"_34937":3174,"_23830":67852,"_5":16479,"_31422":67801,"_3630":67853},[],"ML-DSA combined with RSA, ECDSA or Ed25519 in a single key and a single signature",{"_4190":3196,"_34937":3174,"_23830":67855,"_5":16479,"_31422":67801,"_3630":67856},[],"A composite signature is valid only if both of its components verify. Its unforgeability is intended to hold as long as at least one of the two algorithms remains unbroken, provided the relying party requires the composite and does not fall back to a classical certificate. In the key exchange, `PQ/T` means a hybrid group that combines a classical and an ML-KEM exchange, and `PQ` means pure ML-KEM. Algorithms describes each one and the parameter sets Lamassu accepts.",{"_4190":3197,"_34937":3174,"_23830":67858,"_5":16479,"_31422":67805,"_3630":67859},[],"The Go fork is the foundation: the backend and Traefik are compiled with it, because the standard Go toolchain does not provide the composite and SLH-DSA certificate support. The backend creates and holds the keys, issues certificates and signs revocation data. The dashboard drives the same REST API. Devices reach the platform through Traefik, which negotiates post-quantum authentication and key exchange with the device and then forwards the request to Envoy Gateway over ordinary TLS. Post-quantum protection therefore applies only to the hop between the device and Traefik.",{"_4190":3198,"_34937":3174,"_23830":67861,"_5":16479,"_31422":67809,"_3630":67862},[],"Read Algorithms first to learn what is supported and how parameter sets are written in API requests. Developers writing a device client should continue with Go PQC toolchain. Administrators who want to create a post-quantum CA follow Keys and certificate authorities, and those who deploy the platform go to Deployment with the Helm chart.",{"_4190":3199,"_34937":3174,"_23830":67864,"_5":16479,"_31422":67809,"_3630":67865},[],"<Card title=\"Interactive tour\" description=\"Try the key exchange and authentication combinations and see the test results.\" href=\"/docs/platform/pqc/welcome\" />",{"_4190":3200,"_34937":3174,"_23830":67867,"_5":16479,"_31422":67809,"_3630":67868},[],"<Card title=\"Algorithms\" description=\"ML-DSA, SLH-DSA and the 15 composite algorithms, with their parameter sets.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4190":3201,"_34937":3174,"_23830":67870,"_5":16479,"_31422":67809,"_3630":67871},[],"<Card title=\"Keys and certificate authorities\" description=\"Create post-quantum keys and CAs and issue certificates through the API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4190":3202,"_34937":3174,"_23830":67873,"_5":16479,"_31422":67809,"_3630":67874},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the platform with a Traefik front proxy that serves PQC certificates.\" href=\"/docs/platform/pqc/deployment\" />",{"_4190":3203,"_34937":3203,"_5":16871,"_3630":66595,"_35372":67876,"_23830":67877,"_31422":3203},[58062,59537,66160,66575],[],{"_4190":3204,"_34937":3203,"_23830":67879,"_5":16479,"_31422":3203,"_3630":67880},[],"Bind a certificate with a post-quantum key to an existing classical certificate of the same device, following RFC 9763, and how Lamassu issues and checks them.",{"_4190":3205,"_34937":3203,"_5":35369,"_23830":67882,"_31422":67883,"_3630":67884},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#how-the-request-works","How the request works",{"_4190":3206,"_34937":3203,"_5":35369,"_23830":67886,"_31422":67887,"_3630":67888},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#locations-the-ca-may-fetch-from","Locations the CA may fetch from",{"_4190":3207,"_34937":3203,"_5":35369,"_23830":67890,"_31422":67891,"_3630":67892},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#configure-an-issuance-profile","Configure an issuance profile",{"_4190":3208,"_34937":3203,"_5":35369,"_23830":67894,"_31422":67895,"_3630":67896},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#what-the-issued-certificate-must-satisfy","What the issued certificate must satisfy",{"_4190":3209,"_34937":3203,"_5":35369,"_23830":67898,"_31422":67899,"_3630":67900},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#from-the-dashboard","From the dashboard",{"_4190":3210,"_34937":3203,"_23830":67902,"_5":16479,"_31422":3203,"_3630":67903},[],"A fleet that is migrating to post-quantum algorithms usually holds two certificates per device for a while: the classical one already in use and a new one with a post-quantum key. RFC 9763 defines a way to link them. The new certificate carries the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`), which holds a hash of the classical certificate, so a relying party can see that both identify the same entity. Lamassu implements the issuing side of this mechanism.",{"_4190":3211,"_34937":3203,"_23830":67905,"_5":16479,"_31422":3203,"_3630":67906},[],"This option fits when:",{"_4190":3212,"_34937":3203,"_23830":67908,"_5":16479,"_31422":3203,"_3630":67909},[],"the consumers cannot yet validate post-quantum or composite chains, so the classical certificate must remain the one in use;",{"_4190":3213,"_34937":3203,"_23830":67911,"_5":16479,"_31422":3203,"_3630":67912},[],"a device has to carry both certificates and show that they belong together, using each one where the peer supports it.",{"_4190":3214,"_34937":3203,"_23830":67914,"_5":16479,"_31422":3203,"_3630":67915},[],"The hash is SHA-256, SHA-384 or SHA-512, matching the hash of the related certificate's signature algorithm, and SHA-256 when it has none.",{"_4190":3215,"_34937":3203,"_23830":67917,"_5":16479,"_31422":67883,"_3630":67918},[],"The device asks for the bound certificate with an ordinary PKCS#10 certificate request that carries one extra attribute, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). The attribute identifies the existing certificate by issuer and serial number, states the time of the request, gives the location from which the certificate can be downloaded and carries a signature made with the private key of that existing certificate. The signature covers the issuer, the serial number and the request time, not the location, and shows that the requester controls the existing key; the key of the new certificate is proven by the signature of the certificate request itself. Lamassu accepts a list of locations, as in the ASN.1 module of the RFC, and tries them in order.",{"_4190":3216,"_34937":3203,"_23830":67920,"_5":16479,"_31422":67883,"_3630":67921},[],"When the CA service receives such a request it follows these steps:",{"_4190":3217,"_34937":3203,"_23830":67923,"_5":16479,"_31422":67883,"_3630":67924},[],"It checks that the issuance profile in use enables related certificates, and rejects the request otherwise.",{"_4190":3218,"_34937":3203,"_23830":67926,"_5":16479,"_31422":67883,"_3630":67927},[],"It reads the locations in the attribute in order and downloads the first certificate it can retrieve.",{"_4190":3219,"_34937":3203,"_23830":67929,"_5":16479,"_31422":67883,"_3630":67930},[],"It verifies that the issuer and serial number match, that the request time is within the allowed age, and that the signature is valid with the downloaded certificate's key.",{"_4190":3220,"_34937":3203,"_23830":67932,"_5":16479,"_31422":67883,"_3630":67933},[],"It issues the new certificate with the related certificate extension added.",{"_4190":3221,"_34937":3203,"_23830":67935,"_5":16479,"_31422":67883,"_3630":67936},[],"A request without the attribute is processed as usual, whether or not the profile enables the feature.",{"_4190":3222,"_34937":3203,"_23830":67938,"_5":16479,"_31422":67887,"_3630":67939},[],"A location is either a `data:` URI or an `http` or `https` URL. A `data:` URI must be base64-encoded and contains a PKCS#7 structure whose first certificate is the related one; it needs no network access and is always accepted when the feature is enabled. A URL is retrieved only if its host appears in the profile's list of allowed hosts. The CA does not follow redirects, applies a ten-second timeout and rejects responses larger than 1 MiB.",{"_4190":3223,"_34937":3203,"_23830":67941,"_5":16479,"_31422":67887,"_3630":67942},[],"Because the server performs the download, whoever can define an issuance profile decides which hosts the CA is allowed to contact. Restrict that permission accordingly and list only internal certificate repositories.",{"_4190":3224,"_34937":3203,"_23830":67944,"_5":16479,"_31422":67891,"_3630":67945},[],"The feature is configured in the `related_certificate` object of the issuance profile, which is stored with its own database columns:",{"_4190":3225,"_34937":3203,"_23830":67947,"_5":16479,"_31422":67891,"_3630":64759},[],{"_4190":3226,"_34937":3203,"_23830":67949,"_5":16479,"_31422":67891,"_3630":62224},[],{"_4190":3227,"_34937":3203,"_23830":67951,"_5":16479,"_31422":67891,"_3630":58449},[],{"_4190":3228,"_34937":3203,"_23830":67953,"_5":16479,"_31422":67891,"_3630":62230},[],{"_4190":3229,"_34937":3203,"_23830":67955,"_5":16479,"_31422":67891,"_3630":67956},[],"`enabled`",{"_4190":3230,"_34937":3203,"_23830":67958,"_5":16479,"_31422":67891,"_3630":22434},[],{"_4190":3231,"_34937":3203,"_23830":67960,"_5":16479,"_31422":67891,"_3630":66804},[],{"_4190":3232,"_34937":3203,"_23830":67962,"_5":16479,"_31422":67891,"_3630":67963},[],"When `false`, a request that carries the attribute is rejected.",{"_4190":3233,"_34937":3203,"_23830":67965,"_5":16479,"_31422":67891,"_3630":67966},[],"`allowed_hosts`",{"_4190":3234,"_34937":3203,"_23830":67968,"_5":16479,"_31422":67891,"_3630":67969},[],"list of strings",{"_4190":3235,"_34937":3203,"_23830":67971,"_5":16479,"_31422":67891,"_3630":21705},[],{"_4190":3236,"_34937":3203,"_23830":67973,"_5":16479,"_31422":67891,"_3630":67974},[],"Hosts from which `http` and `https` locations may be downloaded.",{"_4190":3237,"_34937":3203,"_23830":67976,"_5":16479,"_31422":67891,"_3630":67977},[],"`max_age`",{"_4190":3238,"_34937":3203,"_23830":67979,"_5":16479,"_31422":67891,"_3630":6696},[],{"_4190":3239,"_34937":3203,"_23830":67981,"_5":16479,"_31422":67891,"_3630":67982},[],"`5m`",{"_4190":3240,"_34937":3203,"_23830":67984,"_5":16479,"_31422":67891,"_3630":67985},[],"Maximum difference between the request time in the attribute and the time of issuance.",{"_4190":3241,"_34937":3203,"_23830":67987,"_5":16479,"_31422":67895,"_3630":67988},[],"The fork refuses to bind a certificate unless the new one is compatible with the related one. Neither certificate may be a CA. The related certificate must be valid at the time of issuance. The key usages and extended key usages requested for the new certificate must be a subset of those of the related certificate. Verification later compares only the hash, so a relying party that checks the link learns that the issuing CA linked the new certificate to that specific certificate, not that the related certificate is still valid.",{"_4190":3242,"_34937":3203,"_23830":67990,"_5":16479,"_31422":67895,"_3630":67991},[],"The extension is evidence of a relationship, not a dependency. A relying party must still validate each certificate against its own chain and revocation status, and revoking the classical certificate does not revoke the bound one.",{"_4190":3243,"_34937":3203,"_23830":67993,"_5":16479,"_31422":67899,"_3630":67994},[],"The dashboard covers the feature without API requests. The issuance profile form has a *Related Certificates* switch with the allowed hosts and the maximum age, and the issue-certificate form offers *Bind to a related certificate* when the selected profile enables it. Certificate and CA details show a *Related Certificate* row with the hash algorithm and value. The steps, with screenshots, are in Dashboard.",{"_4190":3244,"_34937":3203,"_23830":67996,"_5":16479,"_31422":67899,"_3630":67997},[],"The bound certificate is created by the fork's `CreateBoundCertificate`, whose tests cover an ML-DSA key bound to RSA, ECDSA and Ed25519 certificates. The tests do not use composite keys. Only the issuing side is implemented in Lamassu: the platform does not evaluate the extension when it validates certificates.",{"_4190":3245,"_34937":3203,"_23830":67999,"_5":16479,"_31422":67899,"_3630":68000},[],"<Card title=\"Keys and certificate authorities\" description=\"Create the post-quantum CA that issues the bound certificate.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4190":3246,"_34937":3203,"_23830":68002,"_5":16479,"_31422":67899,"_3630":68003},[],"<Card title=\"Known limitations\" description=\"What is not covered yet.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":3247,"_34937":3247,"_5":16871,"_3630":68005,"_35372":68006,"_23830":68007,"_31422":3247},"TLS front proxy with Traefik",[58062,59537,66160,58063],[],{"_4190":3248,"_34937":3247,"_23830":68009,"_5":16479,"_31422":3247,"_3630":68010},[],"The Traefik fork that terminates device TLS with classical and post-quantum certificates for the same host, how it picks a certificate and how it is built.",{"_4190":3249,"_34937":3247,"_5":35369,"_23830":68012,"_31422":68013,"_3630":68014},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#several-certificates-for-the-same-host","Several certificates for the same host",{"_4190":3250,"_34937":3247,"_5":35369,"_23830":68016,"_31422":68017,"_3630":68018},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#tls-options-on-gateway-api-listeners","TLS options on Gateway API listeners",{"_4190":3251,"_34937":3247,"_5":35369,"_23830":68020,"_31422":68021,"_3630":68022},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#mutual-tls","Mutual TLS",{"_4190":3252,"_34937":3247,"_5":35369,"_23830":68024,"_31422":68025,"_3630":68026},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#building-the-proxy","Building the proxy",{"_4190":3253,"_34937":3247,"_23830":68028,"_5":16479,"_31422":3247,"_3630":68029},[],"Devices connect to Lamassu over TLS, and EST enrollment relies on mutual TLS. To accept a post-quantum or composite certificate on that connection, the TLS endpoint must be built with the Go PQC toolchain. Lamassu does this with a fork of Traefik, based on Traefik 3.7.15, that sits in front of Envoy Gateway. The fork adds two behaviours: it can serve several certificates for the same host and chooses among them per client, and it lets a Gateway API listener reference a Traefik TLS option.",{"_4190":3254,"_34937":3247,"_23830":68031,"_5":16479,"_31422":68013,"_3630":68032},[],"Upstream Traefik keeps one certificate per set of names. If a classical ECDSA certificate and an ML-DSA certificate exist for `lab.example.com`, only the first is kept. The fork stores every distinct certificate (duplicates are detected by comparing the leaf certificate) and chooses one for each handshake.",{"_4190":3255,"_34937":3247,"_23830":68034,"_5":16479,"_31422":68013,"_3630":68035},[],"The choice follows the signature algorithms the client announces:",{"_4190":3256,"_34937":3247,"_23830":68037,"_5":16479,"_31422":68013,"_3630":68038},[],"The server name from the client is normalized and the certificates whose names match it are collected, with exact names ahead of wildcards. A common-name-only certificate still matches.",{"_4190":3257,"_34937":3247,"_23830":68040,"_5":16479,"_31422":68013,"_3630":68041},[],"If no certificate matches, the connection is closed in strict-SNI mode, or the default certificate is served.",{"_4190":3258,"_34937":3247,"_23830":68043,"_5":16479,"_31422":68013,"_3630":68044},[],"If exactly one certificate matches, it is served without further checks.",{"_4190":3259,"_34937":3247,"_23830":68046,"_5":16479,"_31422":68013,"_3630":68047},[],"Otherwise the proxy takes the client's signature schemes in the order the client sent them, and for each scheme returns the first certificate whose key the scheme, the TLS version and the key type allow. This matches the leaf key against `signature_algorithms`, the schemes the client accepts for the handshake signature; the signatures in the rest of the chain are a separate check against `signature_algorithms_cert`.",{"_4190":3260,"_34937":3247,"_23830":68049,"_5":16479,"_31422":68013,"_3630":68050},[],"If the client announces no scheme, the first compatible certificate is returned. If none is compatible, the first candidate is returned and the handshake fails with the underlying error.",{"_4190":3261,"_34937":3247,"_23830":68052,"_5":16479,"_31422":68013,"_3630":68053},[],"The client's order of preference prevails, so a client that lists ML-DSA first receives the post-quantum certificate and a client that lists ECDSA first receives the classical one, even if it also supports ML-DSA. A client with no post-quantum support never announces those schemes and receives the classical certificate. TLS 1.2 never selects ML-DSA or composite certificates. The server cannot be configured with its own order of preference.",{"_4190":3262,"_34937":3247,"_23830":68055,"_5":16479,"_31422":68017,"_3630":68056},[],"Traefik reads its Gateway API configuration from Kubernetes. The fork reads the listener option `traefik.io/tls-options`, whose value names the TLS option to apply to that listener: either `default`, or a qualified name such as `traefik-system-pqc@kubernetescrd`. This works for HTTPS listeners and for TLS listeners in `Terminate` mode that serve a `TLSRoute`. It is ignored in passthrough mode.",{"_4190":3263,"_34937":3247,"_23830":68058,"_5":16479,"_31422":68017,"_3630":68059},[],"A TLS option is where the supported key exchange groups and the client authentication mode are set. When several listeners share a parent router and name different options, the proxy logs a warning and uses isolated defaults for each. Without the fork, Traefik ignores the annotation, applies its own defaults and the settings cannot be controlled; devices that need mutual TLS then fail.",{"_4190":3264,"_34937":3247,"_23830":68061,"_5":16479,"_31422":68017,"_3630":68062},[],"The fork also adds `mlkem1024` to the group names accepted in `curvePreferences`, next to the hybrid groups that Traefik already maps.",{"_4190":3265,"_34937":3247,"_23830":68064,"_5":16479,"_31422":68021,"_3630":68065},[],"Client authentication is the standard Traefik mechanism, configured in the TLS option. With `RequireAndVerifyClientCert` and a client CA file the proxy validates the chain, and the verification of the client signature is done by the TLS stack of the Go fork, which has been tested with composite client certificates in a TLS 1.3 handshake. With `RequestClientCert`, which the Lamassu chart sets in its default option, the proxy checks that the client holds the key of the certificate it presents but does not validate the chain; the decision is delegated to the backend, which receives the certificate in a header (see Deployment with the Helm chart). No Traefik test covers post-quantum mutual TLS, and a client chain signed by a composite or post-quantum CA depends on the x509 code of the fork.",{"_4190":3266,"_34937":3247,"_23830":68067,"_5":16479,"_31422":68025,"_3630":68068},[],"The fork is not built from the Go image. The `build.sh` script requires an already compiled checkout of the Go fork, by default in `../go`, and checks that it is the fork before it forces `GOROOT` and `GOTOOLCHAIN=local`. It compiles the binary with `CGO_ENABLED=0`, builds the web UI unless `SKIP_WEBUI=1`, and packages the binary into an Alpine image with `docker buildx`. The default image is `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_4190":3267,"_34937":3247,"_23830":68070,"_5":16479,"_31422":68025,"_3630":68071},[],"Variable",{"_4190":3268,"_34937":3247,"_23830":68073,"_5":16479,"_31422":68025,"_3630":58452},[],{"_4190":3269,"_34937":3247,"_23830":68075,"_5":16479,"_31422":68025,"_3630":68076},[],"`GO_FORK_ROOT`",{"_4190":3270,"_34937":3247,"_23830":68078,"_5":16479,"_31422":68025,"_3630":68079},[],"Location of the compiled Go fork.",{"_4190":3271,"_34937":3247,"_23830":68081,"_5":16479,"_31422":68025,"_3630":68082},[],"`PLATFORMS`",{"_4190":3272,"_34937":3247,"_23830":68084,"_5":16479,"_31422":68025,"_3630":68085},[],"Target platforms; the default is `linux/amd64`.",{"_4190":3273,"_34937":3247,"_23830":68087,"_5":16479,"_31422":68025,"_3630":68088},[],"`SKIP_WEBUI`",{"_4190":3274,"_34937":3247,"_23830":68090,"_5":16479,"_31422":68025,"_3630":68091},[],"Skip building the web UI when set to `1`.",{"_4190":3275,"_34937":3247,"_23830":68093,"_5":16479,"_31422":68025,"_3630":68094},[],"`IMAGE`, `PUSH`",{"_4190":3276,"_34937":3247,"_23830":68096,"_5":16479,"_31422":68025,"_3630":68097},[],"Name of the image and whether to push it. Multi-platform builds require `PUSH=1`.",{"_4190":3277,"_34937":3247,"_23830":68099,"_5":16479,"_31422":68025,"_3630":68100},[],"The `pqc-*` tags are mutable and have been rebuilt in place, so pin the digest in production-like environments.",{"_4190":3278,"_34937":3247,"_23830":68102,"_5":16479,"_31422":68025,"_3630":68103},[],"The selection tests of the fork use pure ML-DSA-65 together with ECDSA P-256. Selecting a composite certificate depends on the fork's TLS stack knowing the composite key, which it does, but the proxy has no test for it.",{"_4190":3279,"_34937":3247,"_23830":68105,"_5":16479,"_31422":68025,"_3630":68106},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the proxy in front of Envoy Gateway with the chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_4190":3280,"_34937":3247,"_23830":68108,"_5":16479,"_31422":68025,"_3630":68109},[],"<Card title=\"Known limitations\" description=\"Interoperability and operational caveats.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":3281,"_34937":3281,"_5":16871,"_3630":68111,"_35372":68112,"_23830":68113,"_31422":3281},"Welcome to post-quantum Lamassu",[58062,59537,66160],[],{"_4190":3282,"_34937":3281,"_23830":68115,"_5":16479,"_31422":3281,"_3630":68116},[],"An interactive tour of Lamassu's post-quantum support, from the Go toolchain to the device, with the interoperability results.",{"_4190":3283,"_34937":3281,"_23830":68118,"_5":16479,"_31422":3281,"_3630":68119},[],"Lamassu negotiates post-quantum key exchange and authentication with devices, and issues post-quantum and composite certificates. This page lets you try it: combine the key exchange and authentication families in the configurator, explore the architecture and the algorithms, and see how independent clients fared in the interoperability tests. The reference documentation starts at the overview.",{"_4190":3284,"_34937":3284,"_5":16871,"_3630":68121,"_35372":68122,"_23830":68123,"_31422":3284},"Security",[58062],[],{"_4190":3285,"_34937":3284,"_23830":68125,"_5":16479,"_31422":3284,"_3630":68126},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_4190":3286,"_34937":3284,"_5":35369,"_23830":68128,"_31422":68129,"_3630":68130},[],"/docs/pr-preview/pr-58/security#report-a-vulnerability","Report a vulnerability",{"_4190":3287,"_34937":3284,"_5":35369,"_23830":68132,"_31422":68133,"_3630":68134},[],"/docs/pr-preview/pr-58/security#what-to-include-in-a-report","What to include in a report",{"_4190":3288,"_34937":3284,"_5":35369,"_23830":68136,"_31422":68137,"_3630":68138},[],"/docs/pr-preview/pr-58/security#supported-versions","Supported versions",{"_4190":3289,"_34937":3284,"_5":35369,"_23830":68140,"_31422":68141,"_3630":68142},[],"/docs/pr-preview/pr-58/security#responsible-disclosure","Responsible disclosure",{"_4190":3290,"_34937":3284,"_23830":68144,"_5":16479,"_31422":3284,"_3630":68145},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_4190":3291,"_34937":3284,"_23830":68147,"_5":16479,"_31422":68129,"_3630":68148},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_4190":3292,"_34937":3284,"_23830":68150,"_5":16479,"_31422":68129,"_3630":68151},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_4190":3293,"_34937":3284,"_23830":68153,"_5":16479,"_31422":68129,"_3630":17232},[],{"_4190":3294,"_34937":3284,"_23830":68155,"_5":16479,"_31422":68129,"_3630":17162},[],{"_4190":3295,"_34937":3284,"_23830":68157,"_5":16479,"_31422":68129,"_3630":17219},[],{"_4190":3296,"_34937":3284,"_23830":68159,"_5":16479,"_31422":68129,"_3630":68160},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_4190":3297,"_34937":3284,"_23830":68162,"_5":16479,"_31422":68129,"_3630":68163},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_4190":3298,"_34937":3284,"_23830":68165,"_5":16479,"_31422":68133,"_3630":68166},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_4190":3299,"_34937":3284,"_23830":68168,"_5":16479,"_31422":68133,"_3630":68169},[],"Do not include in the report:",{"_4190":3300,"_34937":3284,"_23830":68171,"_5":16479,"_31422":68133,"_3630":68172},[],"Credentials, tokens, or private keys",{"_4190":3301,"_34937":3284,"_23830":68174,"_5":16479,"_31422":68133,"_3630":68175},[],"Customer data or customer-identifiable information",{"_4190":3302,"_34937":3284,"_23830":68177,"_5":16479,"_31422":68133,"_3630":68178},[],"Confidential architecture or internal infrastructure details",{"_4190":3303,"_34937":3284,"_23830":68180,"_5":16479,"_31422":68137,"_3630":68181},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_4190":3304,"_34937":3284,"_23830":68183,"_5":16479,"_31422":68137,"_3630":68184},[],"For upgrade guidance, see Upgrades.",{"_4190":3305,"_34937":3284,"_23830":68186,"_5":16479,"_31422":68141,"_3630":68187},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_4190":3306,"_34937":3284,"_23830":68189,"_5":16479,"_31422":68141,"_3630":68190},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_4190":3307,"_34937":3284,"_23830":68192,"_5":16479,"_31422":68141,"_3630":68193},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_4190":3308,"_34937":3284,"_23830":68195,"_5":16479,"_31422":68141,"_3630":68196},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_4190":3309,"_34937":3284,"_23830":68198,"_5":16479,"_31422":68141,"_3630":68199},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_4190":3310,"_34937":3310,"_5":16871,"_3630":68201,"_35372":68202,"_23830":68204,"_31422":3310},"3.8.0 to 4.0.0",[58062,68203],"Upgrades",[],{"_4190":3311,"_34937":3310,"_23830":68206,"_5":16479,"_31422":3310,"_3630":68207},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_4190":3312,"_34937":3310,"_5":35369,"_23830":68209,"_31422":68210,"_3630":68211},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_4190":3313,"_34937":3310,"_5":35369,"_23830":68213,"_31422":68214,"_3630":68215},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_4190":3314,"_34937":3310,"_5":35369,"_23830":68217,"_31422":68218,"_3630":68219},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_4190":3315,"_34937":3310,"_5":35369,"_23830":68221,"_31422":68222,"_3630":68223},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_4190":3316,"_34937":3310,"_5":35369,"_23830":68225,"_31422":68226,"_3630":68227},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_4190":3317,"_34937":3310,"_5":35369,"_23830":68229,"_31422":68230,"_3630":68231},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_4190":3318,"_34937":3310,"_5":35369,"_23830":68233,"_31422":68234,"_3630":68235},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_4190":3319,"_34937":3310,"_5":35369,"_23830":68237,"_31422":68238,"_3630":68239},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_4190":3320,"_34937":3310,"_5":35369,"_23830":68241,"_31422":68242,"_3630":68243},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_4190":3321,"_34937":3310,"_5":35369,"_23830":68245,"_31422":68246,"_3630":68247},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_4190":3322,"_34937":3310,"_5":35369,"_23830":68249,"_31422":68250,"_3630":68251},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_4190":3323,"_34937":3310,"_5":35369,"_23830":68253,"_31422":68254,"_3630":68255},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_4190":3324,"_34937":3310,"_5":35369,"_23830":68257,"_31422":68258,"_3630":68259},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_4190":3325,"_34937":3310,"_5":35369,"_23830":68261,"_31422":68262,"_3630":68263},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_4190":3326,"_34937":3310,"_5":35369,"_23830":68265,"_31422":68266,"_3630":68267},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_4190":3327,"_34937":3310,"_5":35369,"_23830":68269,"_31422":68270,"_3630":68271},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_4190":3328,"_34937":3310,"_5":35369,"_23830":68273,"_31422":68274,"_3630":68275},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_4190":3329,"_34937":3310,"_5":35369,"_23830":68277,"_31422":68278,"_3630":68279},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_4190":3330,"_34937":3310,"_5":35369,"_23830":68281,"_31422":68282,"_3630":68283},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_4190":3331,"_34937":3310,"_5":35369,"_23830":68285,"_31422":68286,"_3630":68287},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_4190":3332,"_34937":3310,"_5":35369,"_23830":68289,"_31422":68290,"_3630":68291},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_4190":3333,"_34937":3310,"_5":35369,"_23830":68293,"_31422":68294,"_3630":68295},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_4190":3334,"_34937":3310,"_5":35369,"_23830":68297,"_31422":68298,"_3630":68299},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_4190":3335,"_34937":3310,"_5":35369,"_23830":68301,"_31422":68302,"_3630":68303},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_4190":3336,"_34937":3310,"_5":35369,"_23830":68305,"_31422":68306,"_3630":68307},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_4190":3337,"_34937":3310,"_5":35369,"_23830":68309,"_31422":68310,"_3630":68311},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_4190":3338,"_34937":3310,"_5":35369,"_23830":68313,"_31422":68314,"_3630":68315},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_4190":3339,"_34937":3310,"_5":35369,"_23830":68317,"_31422":68318,"_3630":68319},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_4190":3340,"_34937":3310,"_5":35369,"_23830":68321,"_31422":68322,"_3630":68323},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_4190":3341,"_34937":3310,"_5":35369,"_23830":68325,"_31422":68326,"_3630":68327},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_4190":3342,"_34937":3310,"_5":35369,"_23830":68329,"_31422":68330,"_3630":68331},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_4190":3343,"_34937":3310,"_5":35369,"_23830":68333,"_31422":68334,"_3630":68335},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_4190":3344,"_34937":3310,"_5":35369,"_23830":68337,"_31422":68338,"_3630":68339},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_4190":3345,"_34937":3310,"_5":35369,"_23830":68341,"_31422":68342,"_3630":68343},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_4190":3346,"_34937":3310,"_5":35369,"_23830":68345,"_31422":68346,"_3630":68347},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_4190":3347,"_34937":3310,"_5":35369,"_23830":68349,"_31422":68350,"_3630":68351},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_4190":3348,"_34937":3310,"_5":35369,"_23830":68353,"_31422":68354,"_3630":68355},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_4190":3349,"_34937":3310,"_5":35369,"_23830":68357,"_31422":68358,"_3630":68359},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_4190":3350,"_34937":3310,"_5":35369,"_23830":68361,"_31422":68362,"_3630":68363},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_4190":3351,"_34937":3310,"_5":35369,"_23830":68365,"_31422":68366,"_3630":68367},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_4190":3352,"_34937":3310,"_5":35369,"_23830":68369,"_31422":68370,"_3630":62117},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_4190":3353,"_34937":3310,"_5":35369,"_23830":68372,"_31422":68373,"_3630":68374},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_4190":3354,"_34937":3310,"_5":35369,"_23830":68376,"_31422":68377,"_3630":68378},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_4190":3355,"_34937":3310,"_23830":68380,"_5":16479,"_31422":3310,"_3630":68381},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_4190":3356,"_34937":3310,"_23830":68383,"_5":16479,"_31422":3310,"_3630":68384},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_4190":3357,"_34937":3310,"_23830":68386,"_5":16479,"_31422":3310,"_3630":68387},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_4190":3358,"_34937":3310,"_23830":68389,"_5":16479,"_31422":3310,"_3630":68390},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_4190":3359,"_34937":3310,"_23830":68392,"_5":16479,"_31422":3310,"_3630":68393},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_4190":3360,"_34937":3310,"_23830":68395,"_5":16479,"_31422":3310,"_3630":68396},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_4190":3361,"_34937":3310,"_23830":68398,"_5":16479,"_31422":3310,"_3630":68399},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_4190":3362,"_34937":3310,"_23830":68401,"_5":16479,"_31422":68214,"_3630":68402},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_4190":3363,"_34937":3310,"_23830":68404,"_5":16479,"_31422":68214,"_3630":68405},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_4190":3364,"_34937":3310,"_23830":68407,"_5":16479,"_31422":68218,"_3630":68408},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_4190":3365,"_34937":3310,"_23830":68410,"_5":16479,"_31422":68218,"_3630":68411},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_4190":3366,"_34937":3310,"_23830":68413,"_5":16479,"_31422":68222,"_3630":68414},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_4190":3367,"_34937":3310,"_23830":68416,"_5":16479,"_31422":68226,"_3630":68417},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_4190":3368,"_34937":3310,"_23830":68419,"_5":16479,"_31422":68226,"_3630":68420},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_4190":3369,"_34937":3310,"_23830":68422,"_5":16479,"_31422":68226,"_3630":68423},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_4190":3370,"_34937":3310,"_23830":68425,"_5":16479,"_31422":68226,"_3630":68426},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_4190":3371,"_34937":3310,"_23830":68428,"_5":16479,"_31422":68226,"_3630":68429},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_4190":3372,"_34937":3310,"_23830":68431,"_5":16479,"_31422":68230,"_3630":68432},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_4190":3373,"_34937":3310,"_23830":68434,"_5":16479,"_31422":68230,"_3630":68435},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_4190":3374,"_34937":3310,"_23830":68437,"_5":16479,"_31422":68230,"_3630":68438},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_4190":3375,"_34937":3310,"_23830":68440,"_5":16479,"_31422":68230,"_3630":68441},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_4190":3376,"_34937":3310,"_23830":68443,"_5":16479,"_31422":68230,"_3630":68444},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_4190":3377,"_34937":3310,"_23830":68446,"_5":16479,"_31422":68230,"_3630":68447},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_4190":3378,"_34937":3310,"_23830":68449,"_5":16479,"_31422":68234,"_3630":68450},[],"Change",{"_4190":3379,"_34937":3310,"_23830":68452,"_5":16479,"_31422":68234,"_3630":68453},[],"Who is affected",{"_4190":3380,"_34937":3310,"_23830":68455,"_5":16479,"_31422":68234,"_3630":68456},[],"Severity",{"_4190":3381,"_34937":3310,"_23830":68458,"_5":16479,"_31422":68234,"_3630":64969},[],{"_4190":3382,"_34937":3310,"_23830":68460,"_5":16479,"_31422":68234,"_3630":68243},[],{"_4190":3383,"_34937":3310,"_23830":68462,"_5":16479,"_31422":68234,"_3630":68463},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_4190":3384,"_34937":3310,"_23830":68465,"_5":16479,"_31422":68234,"_3630":68466},[],"High: KMS and VA start on empty volumes",{"_4190":3385,"_34937":3310,"_23830":68468,"_5":16479,"_31422":68234,"_3630":68469},[],"Copy the data into the new volumes",{"_4190":3386,"_34937":3310,"_23830":68471,"_5":16479,"_31422":68234,"_3630":68247},[],{"_4190":3387,"_34937":3310,"_23830":68473,"_5":16479,"_31422":68234,"_3630":68474},[],"Every Helm release",{"_4190":3388,"_34937":3310,"_23830":68476,"_5":16479,"_31422":68234,"_3630":68477},[],"High: `helm upgrade` fails",{"_4190":3389,"_34937":3310,"_23830":68479,"_5":16479,"_31422":68234,"_3630":68480},[],"Remove or rename legacy keys",{"_4190":3390,"_34937":3310,"_23830":68482,"_5":16479,"_31422":68234,"_3630":68251},[],{"_4190":3391,"_34937":3310,"_23830":68484,"_5":16479,"_31422":68234,"_3630":68485},[],"Every deployment",{"_4190":3392,"_34937":3310,"_23830":68487,"_5":16479,"_31422":68234,"_3630":68488},[],"High: without a bootstrap principal there is no administrator",{"_4190":3393,"_34937":3310,"_23830":68490,"_5":16479,"_31422":68234,"_3630":68491},[],"Configure `services.authz`",{"_4190":3394,"_34937":3310,"_23830":68493,"_5":16479,"_31422":68234,"_3630":68255},[],{"_4190":3395,"_34937":3310,"_23830":68495,"_5":16479,"_31422":68234,"_3630":68474},[],{"_4190":3396,"_34937":3310,"_23830":68497,"_5":16479,"_31422":68234,"_3630":68498},[],"High: `helm upgrade` fails on the old keys",{"_4190":3397,"_34937":3310,"_23830":68500,"_5":16479,"_31422":68234,"_3630":68501},[],"Move JWKS and roles into `services.authz`",{"_4190":3398,"_34937":3310,"_23830":68503,"_5":16479,"_31422":68234,"_3630":68275},[],{"_4190":3399,"_34937":3310,"_23830":68505,"_5":16479,"_31422":68234,"_3630":68506},[],"3.8.0 deployments with per-service databases",{"_4190":3400,"_34937":3310,"_23830":68508,"_5":16479,"_31422":68234,"_3630":68509},[],"High: services find no data, or a migration aborts",{"_4190":3401,"_34937":3310,"_23830":68511,"_5":16479,"_31422":68234,"_3630":68512},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_4190":3402,"_34937":3310,"_23830":68514,"_5":16479,"_31422":68234,"_3630":68279},[],{"_4190":3403,"_34937":3310,"_23830":68516,"_5":16479,"_31422":68234,"_3630":68517},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_4190":3404,"_34937":3310,"_23830":68519,"_5":16479,"_31422":68234,"_3630":68520},[],"High: the backend no longer starts with them",{"_4190":3405,"_34937":3310,"_23830":68522,"_5":16479,"_31422":68234,"_3630":68523},[],"Move to PostgreSQL before upgrading",{"_4190":3406,"_34937":3310,"_23830":68525,"_5":16479,"_31422":68234,"_3630":68323},[],{"_4190":3407,"_34937":3310,"_23830":68527,"_5":16479,"_31422":68234,"_3630":68528},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_4190":3408,"_34937":3310,"_23830":68530,"_5":16479,"_31422":68234,"_3630":68531},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_4190":3409,"_34937":3310,"_23830":68533,"_5":16479,"_31422":68234,"_3630":68534},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_4190":3410,"_34937":3310,"_23830":68536,"_5":16479,"_31422":68234,"_3630":68537},[],"Webhooks with file references",{"_4190":3411,"_34937":3310,"_23830":68539,"_5":16479,"_31422":68234,"_3630":68540},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_4190":3412,"_34937":3310,"_23830":68542,"_5":16479,"_31422":68234,"_3630":68543},[],"High: enrollments calling the webhook fail",{"_4190":3413,"_34937":3310,"_23830":68545,"_5":16479,"_31422":68234,"_3630":68546},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_4190":3414,"_34937":3310,"_23830":68548,"_5":16479,"_31422":68234,"_3630":68259},[],{"_4190":3415,"_34937":3310,"_23830":68550,"_5":16479,"_31422":68234,"_3630":68551},[],"Releases with per-service identity overrides or mounted key material",{"_4190":3416,"_34937":3310,"_23830":68553,"_5":16479,"_31422":68234,"_3630":68554},[],"Medium: services cannot read their files",{"_4190":3417,"_34937":3310,"_23830":68556,"_5":16479,"_31422":68234,"_3630":68557},[],"Remove the overrides and fix volume ownership",{"_4190":3418,"_34937":3310,"_23830":68559,"_5":16479,"_31422":68234,"_3630":68263},[],{"_4190":3419,"_34937":3310,"_23830":68561,"_5":16479,"_31422":68234,"_3630":68562},[],"Releases that set `amqp.tls`",{"_4190":3420,"_34937":3310,"_23830":68564,"_5":16479,"_31422":68234,"_3630":68565},[],"Medium: clients connect to the wrong port",{"_4190":3421,"_34937":3310,"_23830":68567,"_5":16479,"_31422":68234,"_3630":68568},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_4190":3422,"_34937":3310,"_23830":68570,"_5":16479,"_31422":68234,"_3630":68283},[],{"_4190":3423,"_34937":3310,"_23830":68572,"_5":16479,"_31422":68234,"_3630":68573},[],"Installations whose CA keys predate the KMS",{"_4190":3424,"_34937":3310,"_23830":68575,"_5":16479,"_31422":68234,"_3630":68576},[],"Medium: CA keys stay unmanaged",{"_4190":3425,"_34937":3310,"_23830":68578,"_5":16479,"_31422":68234,"_3630":68579},[],"Run the CA-to-KMS migration",{"_4190":3426,"_34937":3310,"_23830":68581,"_5":16479,"_31422":68234,"_3630":68582},[],"Receiver certificate verification",{"_4190":3427,"_34937":3310,"_23830":68584,"_5":16479,"_31422":68234,"_3630":68585},[],"DMSs whose webhook had `validate_server_cert: false`",{"_4190":3428,"_34937":3310,"_23830":68587,"_5":16479,"_31422":68234,"_3630":68588},[],"Medium: credentials go to an unverified receiver",{"_4190":3429,"_34937":3310,"_23830":68590,"_5":16479,"_31422":68234,"_3630":68591},[],"Set `insecure_skip_verify` to `false`",{"_4190":3430,"_34937":3310,"_23830":68593,"_5":16479,"_31422":68234,"_3630":68299},[],{"_4190":3431,"_34937":3310,"_23830":68595,"_5":16479,"_31422":68234,"_3630":68596},[],"Scripts and consoles that edit DMSs through the API",{"_4190":3432,"_34937":3310,"_23830":68598,"_5":16479,"_31422":68234,"_3630":68599},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_4190":3433,"_34937":3310,"_23830":68601,"_5":16479,"_31422":68234,"_3630":68602},[],"Read the DMS before editing and use the new field",{"_4190":3434,"_34937":3310,"_23830":68604,"_5":16479,"_31422":68234,"_3630":68319},[],{"_4190":3435,"_34937":3310,"_23830":68606,"_5":16479,"_31422":68234,"_3630":68607},[],"Clients that create or update CRL settings through the API",{"_4190":3436,"_34937":3310,"_23830":68609,"_5":16479,"_31422":68234,"_3630":68610},[],"Medium: requests with the old field return an error",{"_4190":3437,"_34937":3310,"_23830":68612,"_5":16479,"_31422":68234,"_3630":68613},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_4190":3438,"_34937":3310,"_23830":68615,"_5":16479,"_31422":68234,"_3630":68327},[],{"_4190":3439,"_34937":3310,"_23830":68617,"_5":16479,"_31422":68234,"_3630":68618},[],"Alert subscriptions and consumers of the VA events",{"_4190":3440,"_34937":3310,"_23830":68620,"_5":16479,"_31422":68234,"_3630":68621},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_4190":3441,"_34937":3310,"_23830":68623,"_5":16479,"_31422":68234,"_3630":68624},[],"Review conditions filtering on the old event payload or subject",{"_4190":3442,"_34937":3310,"_23830":68626,"_5":16479,"_31422":68234,"_3630":68315},[],{"_4190":3443,"_34937":3310,"_23830":68628,"_5":16479,"_31422":68234,"_3630":68629},[],"Consumers that read the device `events` field",{"_4190":3444,"_34937":3310,"_23830":68631,"_5":16479,"_31422":68234,"_3630":68632},[],"Medium: the field disappears",{"_4190":3445,"_34937":3310,"_23830":68634,"_5":16479,"_31422":68234,"_3630":68635},[],"Use the new event endpoints",{"_4190":3446,"_34937":3310,"_23830":68637,"_5":16479,"_31422":68234,"_3630":68335},[],{"_4190":3447,"_34937":3310,"_23830":68639,"_5":16479,"_31422":68234,"_3630":68640},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_4190":3448,"_34937":3310,"_23830":68642,"_5":16479,"_31422":68234,"_3630":68643},[],"Medium: the VA migration aborts",{"_4190":3449,"_34937":3310,"_23830":68645,"_5":16479,"_31422":68234,"_3630":68646},[],"Fix the affected roles before upgrading",{"_4190":3450,"_34937":3310,"_23830":68648,"_5":16479,"_31422":68234,"_3630":68267},[],{"_4190":3451,"_34937":3310,"_23830":68650,"_5":16479,"_31422":68234,"_3630":68651},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_4190":3452,"_34937":3310,"_23830":68653,"_5":16479,"_31422":68234,"_3630":68654},[],"Low to medium: validation errors or changed defaults",{"_4190":3453,"_34937":3310,"_23830":68656,"_5":16479,"_31422":68234,"_3630":68657},[],"Update the values file",{"_4190":3454,"_34937":3310,"_23830":68659,"_5":16479,"_31422":68234,"_3630":68307},[],{"_4190":3455,"_34937":3310,"_23830":68661,"_5":16479,"_31422":68234,"_3630":68662},[],"Clients that send the DMS ID in the update body",{"_4190":3456,"_34937":3310,"_23830":68664,"_5":16479,"_31422":68234,"_3630":68665},[],"Low: the ID in the URL wins",{"_4190":3457,"_34937":3310,"_23830":68667,"_5":16479,"_31422":68234,"_3630":68668},[],"Send the ID in the URL",{"_4190":3458,"_34937":3310,"_23830":68670,"_5":16479,"_31422":68234,"_3630":68331},[],{"_4190":3459,"_34937":3310,"_23830":68672,"_5":16479,"_31422":68234,"_3630":68673},[],"Clients that send an `id` when creating or importing CAs",{"_4190":3460,"_34937":3310,"_23830":68675,"_5":16479,"_31422":68234,"_3630":68676},[],"Low: the ID in the body is ignored, and the field is removed",{"_4190":3461,"_34937":3310,"_23830":68678,"_5":16479,"_31422":68234,"_3630":68679},[],"Let the backend assign the ID and use the returned one",{"_4190":3462,"_34937":3310,"_23830":68681,"_5":16479,"_31422":68234,"_3630":68311},[],{"_4190":3463,"_34937":3310,"_23830":68683,"_5":16479,"_31422":68234,"_3630":68684},[],"Consumers that match on certificate `type`",{"_4190":3464,"_34937":3310,"_23830":68686,"_5":16479,"_31422":68234,"_3630":68687},[],"Low: two values are renamed",{"_4190":3465,"_34937":3310,"_23830":68689,"_5":16479,"_31422":68234,"_3630":68690},[],"Adapt consumers",{"_4190":3466,"_34937":3310,"_23830":68692,"_5":16479,"_31422":68234,"_3630":68303},[],{"_4190":3467,"_34937":3310,"_23830":68694,"_5":16479,"_31422":68234,"_3630":68695},[],"Any DMS",{"_4190":3468,"_34937":3310,"_23830":68697,"_5":16479,"_31422":68234,"_3630":68698},[],"Low: informational",{"_4190":3469,"_34937":3310,"_23830":68700,"_5":16479,"_31422":68234,"_3630":68701},[],"Read both blocks before editing",{"_4190":3470,"_34937":3310,"_23830":68703,"_5":16479,"_31422":68242,"_3630":68704},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_4190":3471,"_34937":3310,"_23830":68706,"_5":16479,"_31422":68242,"_3630":68707},[],"Step 4 of the migration guide copies the data.",{"_4190":3472,"_34937":3310,"_23830":68709,"_5":16479,"_31422":68246,"_3630":68710},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_4190":3473,"_34937":3310,"_23830":68712,"_5":16479,"_31422":68250,"_3630":68713},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_4190":3474,"_34937":3310,"_23830":68715,"_5":16479,"_31422":68254,"_3630":68716},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_4190":3475,"_34937":3310,"_23830":68718,"_5":16479,"_31422":68258,"_3630":68719},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_4190":3476,"_34937":3310,"_23830":68721,"_5":16479,"_31422":68258,"_3630":68722},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_4190":3477,"_34937":3310,"_23830":68724,"_5":16479,"_31422":68262,"_3630":68725},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_4190":3478,"_34937":3310,"_23830":68727,"_5":16479,"_31422":68266,"_3630":68728},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_4190":3479,"_34937":3310,"_23830":68730,"_5":16479,"_31422":68266,"_3630":68731},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_4190":3480,"_34937":3310,"_23830":68733,"_5":16479,"_31422":68266,"_3630":68734},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_4190":3481,"_34937":3310,"_23830":68736,"_5":16479,"_31422":68266,"_3630":68737},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_4190":3482,"_34937":3310,"_23830":68739,"_5":16479,"_31422":68266,"_3630":68740},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_4190":3483,"_34937":3310,"_23830":68742,"_5":16479,"_31422":68266,"_3630":68743},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_4190":3484,"_34937":3310,"_23830":68745,"_5":16479,"_31422":68274,"_3630":68746},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_4190":3485,"_34937":3310,"_23830":68748,"_5":16479,"_31422":68274,"_3630":68749},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_4190":3486,"_34937":3310,"_23830":68751,"_5":16479,"_31422":68274,"_3630":68752},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_4190":3487,"_34937":3310,"_23830":68754,"_5":16479,"_31422":68274,"_3630":68755},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_4190":3488,"_34937":3310,"_23830":68757,"_5":16479,"_31422":68274,"_3630":68758},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_4190":3489,"_34937":3310,"_23830":68760,"_5":16479,"_31422":68278,"_3630":68761},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_4190":3490,"_34937":3310,"_23830":68763,"_5":16479,"_31422":68282,"_3630":68764},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_4190":3491,"_34937":3310,"_23830":68766,"_5":16479,"_31422":68282,"_3630":68767},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_4190":3492,"_34937":3310,"_23830":68769,"_5":16479,"_31422":68282,"_3630":68770},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_4190":3493,"_34937":3310,"_23830":68772,"_5":16479,"_31422":68282,"_3630":68773},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_4190":3494,"_34937":3310,"_23830":68775,"_5":16479,"_31422":68282,"_3630":68776},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_4190":3495,"_34937":3310,"_23830":68778,"_5":16479,"_31422":68282,"_3630":68779},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_4190":3496,"_34937":3310,"_23830":68781,"_5":16479,"_31422":68282,"_3630":68782},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_4190":3497,"_34937":3310,"_23830":68784,"_5":16479,"_31422":68282,"_3630":68785},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_4190":3498,"_34937":3310,"_23830":68787,"_5":16479,"_31422":68286,"_3630":68788},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_4190":3499,"_34937":3310,"_23830":68790,"_5":16479,"_31422":68294,"_3630":68791},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_4190":3500,"_34937":3310,"_23830":68793,"_5":16479,"_31422":68294,"_3630":68794},[],"Field in 3.8.0",{"_4190":3501,"_34937":3310,"_23830":68796,"_5":16479,"_31422":68294,"_3630":68797},[],"Field in 4.0.0",{"_4190":3502,"_34937":3310,"_23830":68799,"_5":16479,"_31422":68294,"_3630":68800},[],"`validate_server_cert`",{"_4190":3503,"_34937":3310,"_23830":68802,"_5":16479,"_31422":68294,"_3630":68803},[],"`insecure_skip_verify` (value negated)",{"_4190":3504,"_34937":3310,"_23830":68805,"_5":16479,"_31422":68294,"_3630":68806},[],"`oidc`",{"_4190":3505,"_34937":3310,"_23830":68808,"_5":16479,"_31422":68294,"_3630":68809},[],"`jwt_options`",{"_4190":3506,"_34937":3310,"_23830":68811,"_5":16479,"_31422":68294,"_3630":68812},[],"`apikey`",{"_4190":3507,"_34937":3310,"_23830":68814,"_5":16479,"_31422":68294,"_3630":68815},[],"`apikey_options`",{"_4190":3508,"_34937":3310,"_23830":68817,"_5":16479,"_31422":68294,"_3630":68818},[],"`mtls`",{"_4190":3509,"_34937":3310,"_23830":68820,"_5":16479,"_31422":68294,"_3630":68821},[],"`mtls_options`",{"_4190":3510,"_34937":3310,"_23830":68823,"_5":16479,"_31422":68294,"_3630":68824},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_4190":3511,"_34937":3310,"_23830":68826,"_5":16479,"_31422":68294,"_3630":68827},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_4190":3512,"_34937":3310,"_23830":68829,"_5":16479,"_31422":68294,"_3630":68830},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_4190":3513,"_34937":3310,"_23830":68832,"_5":16479,"_31422":68298,"_3630":68833},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_4190":3514,"_34937":3310,"_23830":68835,"_5":16479,"_31422":68298,"_3630":68836},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_4190":3515,"_34937":3310,"_23830":68838,"_5":16479,"_31422":68298,"_3630":68839},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_4190":3516,"_34937":3310,"_23830":68841,"_5":16479,"_31422":68302,"_3630":68842},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_4190":3517,"_34937":3310,"_23830":68844,"_5":16479,"_31422":68306,"_3630":68845},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_4190":3518,"_34937":3310,"_23830":68847,"_5":16479,"_31422":68310,"_3630":68848},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_4190":3519,"_34937":3310,"_23830":68850,"_5":16479,"_31422":68314,"_3630":68851},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_4190":3520,"_34937":3310,"_23830":68853,"_5":16479,"_31422":68314,"_3630":68854},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_4190":3521,"_34937":3310,"_23830":68856,"_5":16479,"_31422":68314,"_3630":68857},[],"`POST /v1/devices/:id/events` creates an event.",{"_4190":3522,"_34937":3310,"_23830":68859,"_5":16479,"_31422":68314,"_3630":68860},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_4190":3523,"_34937":3310,"_23830":68862,"_5":16479,"_31422":68318,"_3630":68863},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_4190":3524,"_34937":3310,"_23830":68865,"_5":16479,"_31422":68322,"_3630":68866},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_4190":3525,"_34937":3310,"_23830":68868,"_5":16479,"_31422":68322,"_3630":68869},[],"Route",{"_4190":3526,"_34937":3310,"_23830":68871,"_5":16479,"_31422":68322,"_3630":61304},[],{"_4190":3527,"_34937":3310,"_23830":68873,"_5":16479,"_31422":68322,"_3630":68874},[],"`GET /v1/crl-settings`",{"_4190":3528,"_34937":3310,"_23830":68876,"_5":16479,"_31422":68322,"_3630":68877},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_4190":3529,"_34937":3310,"_23830":68879,"_5":16479,"_31422":68322,"_3630":68880},[],"`GET /v1/crl-settings/{ca-id}`",{"_4190":3530,"_34937":3310,"_23830":68882,"_5":16479,"_31422":68322,"_3630":68883},[],"Reads the settings of a CA.",{"_4190":3531,"_34937":3310,"_23830":68885,"_5":16479,"_31422":68322,"_3630":68886},[],"`PUT /v1/crl-settings/{ca-id}`",{"_4190":3532,"_34937":3310,"_23830":68888,"_5":16479,"_31422":68322,"_3630":68889},[],"Replaces `crl_options`.",{"_4190":3533,"_34937":3310,"_23830":68891,"_5":16479,"_31422":68322,"_3630":68892},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_4190":3534,"_34937":3310,"_23830":68894,"_5":16479,"_31422":68322,"_3630":68895},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_4190":3535,"_34937":3310,"_23830":68897,"_5":16479,"_31422":68322,"_3630":68898},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_4190":3536,"_34937":3310,"_23830":68900,"_5":16479,"_31422":68322,"_3630":68901},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_4190":3537,"_34937":3310,"_23830":68903,"_5":16479,"_31422":68322,"_3630":68904},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_4190":3538,"_34937":3310,"_23830":68906,"_5":16479,"_31422":68322,"_3630":68907},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_4190":3539,"_34937":3310,"_23830":68909,"_5":16479,"_31422":68322,"_3630":68910},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_4190":3540,"_34937":3310,"_23830":68912,"_5":16479,"_31422":68322,"_3630":68913},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_4190":3541,"_34937":3310,"_23830":68915,"_5":16479,"_31422":68322,"_3630":68916},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_4190":3542,"_34937":3310,"_23830":68918,"_5":16479,"_31422":68322,"_3630":68919},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_4190":3543,"_34937":3310,"_23830":68921,"_5":16479,"_31422":68322,"_3630":68922},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_4190":3544,"_34937":3310,"_23830":68924,"_5":16479,"_31422":68326,"_3630":68925},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_4190":3545,"_34937":3310,"_23830":68927,"_5":16479,"_31422":68330,"_3630":68928},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_4190":3546,"_34937":3310,"_23830":68930,"_5":16479,"_31422":68334,"_3630":68931},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_4190":3547,"_34937":3310,"_23830":68933,"_5":16479,"_31422":68338,"_3630":68934},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_4190":3548,"_34937":3310,"_23830":68936,"_5":16479,"_31422":68342,"_3630":68937},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_4190":3549,"_34937":3310,"_23830":68939,"_5":16479,"_31422":68342,"_3630":68940},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_4190":3550,"_34937":3310,"_23830":68942,"_5":16479,"_31422":68342,"_3630":68943},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_4190":3551,"_34937":3310,"_23830":68945,"_5":16479,"_31422":68342,"_3630":68946},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_4190":3552,"_34937":3310,"_23830":68948,"_5":16479,"_31422":68342,"_3630":68949},[],"Record the names of your local-storage PVCs:",{"_4190":3553,"_34937":3310,"_23830":68951,"_5":16479,"_31422":68342,"_3630":68952},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_4190":3554,"_34937":3310,"_23830":68954,"_5":16479,"_31422":68346,"_3630":68955},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_4190":3555,"_34937":3310,"_23830":68957,"_5":16479,"_31422":68346,"_3630":68958},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_4190":3556,"_34937":3310,"_23830":68960,"_5":16479,"_31422":68346,"_3630":68961},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_4190":3557,"_34937":3310,"_23830":68963,"_5":16479,"_31422":68346,"_3630":68964},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_4190":3558,"_34937":3310,"_23830":68966,"_5":16479,"_31422":68346,"_3630":68967},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_4190":3559,"_34937":3310,"_23830":68969,"_5":16479,"_31422":68350,"_3630":68970},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_4190":3560,"_34937":3310,"_23830":68972,"_5":16479,"_31422":68350,"_3630":68973},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_4190":3561,"_34937":3310,"_23830":68975,"_5":16479,"_31422":68350,"_3630":68976},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_4190":3562,"_34937":3310,"_23830":68978,"_5":16479,"_31422":68350,"_3630":68979},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_4190":3563,"_34937":3310,"_23830":68981,"_5":16479,"_31422":68350,"_3630":68982},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_4190":3564,"_34937":3310,"_23830":68984,"_5":16479,"_31422":68350,"_3630":68985},[],"**Rename `toolbox` to `connectivityTest`:**",{"_4190":3565,"_34937":3310,"_23830":68987,"_5":16479,"_31422":68350,"_3630":68988},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_4190":3566,"_34937":3310,"_23830":68990,"_5":16479,"_31422":68350,"_3630":68991},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_4190":3567,"_34937":3310,"_23830":68993,"_5":16479,"_31422":68350,"_3630":68994},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_4190":3568,"_34937":3310,"_23830":68996,"_5":16479,"_31422":68350,"_3630":68997},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_4190":3569,"_34937":3310,"_23830":68999,"_5":16479,"_31422":68350,"_3630":69000},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_4190":3570,"_34937":3310,"_23830":69002,"_5":16479,"_31422":68350,"_3630":69003},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_4190":3571,"_34937":3310,"_23830":69005,"_5":16479,"_31422":68354,"_3630":69006},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_4190":3572,"_34937":3310,"_23830":69008,"_5":16479,"_31422":68354,"_3630":69009},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_4190":3573,"_34937":3310,"_23830":69011,"_5":16479,"_31422":68358,"_3630":69012},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_4190":3574,"_34937":3310,"_23830":69014,"_5":16479,"_31422":68358,"_3630":69015},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_4190":3575,"_34937":3310,"_23830":69017,"_5":16479,"_31422":68358,"_3630":69018},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_4190":3576,"_34937":3310,"_23830":69020,"_5":16479,"_31422":68358,"_3630":69021},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_4190":3577,"_34937":3310,"_23830":69023,"_5":16479,"_31422":68358,"_3630":69024},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_4190":3578,"_34937":3310,"_23830":69026,"_5":16479,"_31422":68358,"_3630":69027},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_4190":3579,"_34937":3310,"_23830":69029,"_5":16479,"_31422":68358,"_3630":69030},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_4190":3580,"_34937":3310,"_23830":69032,"_5":16479,"_31422":68358,"_3630":69033},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_4190":3581,"_34937":3310,"_23830":69035,"_5":16479,"_31422":68358,"_3630":69036},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_4190":3582,"_34937":3310,"_23830":69038,"_5":16479,"_31422":68358,"_3630":69039},[],"**Remove the helper and restore the recorded replica counts:**",{"_4190":3583,"_34937":3310,"_23830":69041,"_5":16479,"_31422":68358,"_3630":69042},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_4190":3584,"_34937":3310,"_23830":69044,"_5":16479,"_31422":68362,"_3630":69045},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_4190":3585,"_34937":3310,"_23830":69047,"_5":16479,"_31422":68362,"_3630":69048},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_4190":3586,"_34937":3310,"_23830":69050,"_5":16479,"_31422":68366,"_3630":69051},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_4190":3587,"_34937":3310,"_23830":69053,"_5":16479,"_31422":68366,"_3630":69054},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_4190":3588,"_34937":3310,"_23830":69056,"_5":16479,"_31422":68366,"_3630":69057},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_4190":3589,"_34937":3310,"_23830":69059,"_5":16479,"_31422":68366,"_3630":69060},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_4190":3590,"_34937":3310,"_23830":69062,"_5":16479,"_31422":68366,"_3630":69063},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_4190":3591,"_34937":3310,"_23830":69065,"_5":16479,"_31422":68366,"_3630":69066},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_4190":3592,"_34937":3310,"_23830":69068,"_5":16479,"_31422":68366,"_3630":69069},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_4190":3593,"_34937":3310,"_23830":69071,"_5":16479,"_31422":68366,"_3630":69072},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_4190":3594,"_34937":3310,"_23830":69074,"_5":16479,"_31422":68370,"_3630":69075},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_4190":3595,"_34937":3310,"_23830":69077,"_5":16479,"_31422":68370,"_3630":69078},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_4190":3596,"_34937":3310,"_23830":69080,"_5":16479,"_31422":68370,"_3630":69081},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_4190":3597,"_34937":3310,"_23830":69083,"_5":16479,"_31422":68370,"_3630":69084},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_4190":3598,"_34937":3310,"_23830":69086,"_5":16479,"_31422":68370,"_3630":69087},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_4190":3599,"_34937":3310,"_23830":69089,"_5":16479,"_31422":68370,"_3630":69090},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_4190":3600,"_34937":3310,"_23830":69092,"_5":16479,"_31422":68370,"_3630":69093},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_4190":3601,"_34937":3310,"_23830":69095,"_5":16479,"_31422":68370,"_3630":69096},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_4190":3602,"_34937":3310,"_23830":69098,"_5":16479,"_31422":68370,"_3630":69099},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_4190":3603,"_34937":3310,"_23830":69101,"_5":16479,"_31422":68370,"_3630":69102},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_4190":3604,"_34937":3310,"_23830":69104,"_5":16479,"_31422":68370,"_3630":69105},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_4190":3605,"_34937":3310,"_23830":69107,"_5":16479,"_31422":68373,"_3630":69108},[],"After the upgrade, check in this order:",{"_4190":3606,"_34937":3310,"_23830":69110,"_5":16479,"_31422":68373,"_3630":69111},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_4190":3607,"_34937":3310,"_23830":69113,"_5":16479,"_31422":68373,"_3630":69114},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_4190":3608,"_34937":3310,"_23830":69116,"_5":16479,"_31422":68373,"_3630":69117},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_4190":3609,"_34937":3310,"_23830":69119,"_5":16479,"_31422":68373,"_3630":69120},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_4190":3610,"_34937":3310,"_23830":69122,"_5":16479,"_31422":68373,"_3630":69123},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_4190":3611,"_34937":3310,"_23830":69125,"_5":16479,"_31422":68373,"_3630":69126},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_4190":3612,"_34937":3310,"_23830":69128,"_5":16479,"_31422":68373,"_3630":69129},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_4190":3613,"_34937":3310,"_23830":69131,"_5":16479,"_31422":68373,"_3630":69132},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_4190":3614,"_34937":3310,"_23830":69134,"_5":16479,"_31422":68373,"_3630":69135},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_4190":3615,"_34937":3310,"_23830":69137,"_5":16479,"_31422":68373,"_3630":69138},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_4190":3616,"_34937":3310,"_23830":69140,"_5":16479,"_31422":68373,"_3630":69141},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_4190":3617,"_34937":3310,"_23830":69143,"_5":16479,"_31422":68373,"_3630":69144},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_4190":3618,"_34937":3310,"_23830":69146,"_5":16479,"_31422":68373,"_3630":69147},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_4190":3619,"_34937":3310,"_23830":69149,"_5":16479,"_31422":68373,"_3630":69150},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_4190":3620,"_34937":3310,"_23830":69152,"_5":16479,"_31422":68373,"_3630":69153},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_4190":3621,"_34937":3310,"_23830":69155,"_5":16479,"_31422":68377,"_3630":69156},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_4190":3622,"_34937":3310,"_23830":69158,"_5":16479,"_31422":68377,"_3630":69159},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_4190":3623,"_34937":3310,"_23830":69161,"_5":16479,"_31422":68377,"_3630":69162},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4190":3624,"_34937":3310,"_23830":69164,"_5":16479,"_31422":68377,"_3630":69165},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_4190":3625,"_34937":3310,"_23830":69167,"_5":16479,"_31422":68377,"_3630":69168},[