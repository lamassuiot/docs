7747,"_47122":147750,"_47124":147753,"_47126":147756,"_47128":147759,"_47130":147762,"_47133":147765,"_47135":147768,"_47137":147771},{"_4190":83642,"_34937":83642,"_5":16871,"_3630":137012,"_35372":137013,"_23830":137016,"_31422":83642},"Despliega desde AWS Marketplace",[58062,137014,137015],"Despliegue","Otros modelos",[],{"_4190":83643,"_34937":83642,"_23830":137018,"_5":16479,"_31422":83642,"_3630":137019},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_4190":83644,"_34937":83642,"_5":35369,"_23830":137021,"_31422":137022,"_3630":137023},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_4190":83645,"_34937":83642,"_5":35369,"_23830":137025,"_31422":137026,"_3630":137027},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_4190":83646,"_34937":83642,"_5":35369,"_23830":137029,"_31422":137030,"_3630":137031},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_4190":83647,"_34937":83642,"_5":35369,"_23830":137033,"_31422":137034,"_3630":137035},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_4190":83648,"_34937":83642,"_5":35369,"_23830":137037,"_31422":137038,"_3630":137039},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_4190":83649,"_34937":83642,"_5":35369,"_23830":137041,"_31422":137042,"_3630":137043},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_4190":83650,"_34937":83642,"_5":35369,"_23830":137045,"_31422":137046,"_3630":137047},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_4190":83651,"_34937":83642,"_23830":137049,"_5":16479,"_31422":83642,"_3630":137050},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_4190":83652,"_34937":83642,"_23830":137052,"_5":16479,"_31422":137022,"_3630":137053},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_4190":83653,"_34937":83642,"_23830":137055,"_5":16479,"_31422":137022,"_3630":137056},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_4190":83654,"_34937":83642,"_23830":137058,"_5":16479,"_31422":137022,"_3630":137059},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_4190":83655,"_34937":83642,"_23830":137061,"_5":16479,"_31422":137026,"_3630":137062},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_4190":83656,"_34937":83642,"_23830":137064,"_5":16479,"_31422":137026,"_3630":137065},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_4190":83657,"_34937":83642,"_23830":137067,"_5":16479,"_31422":137026,"_3630":137068},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_4190":83658,"_34937":83642,"_23830":137070,"_5":16479,"_31422":137030,"_3630":137071},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_4190":83659,"_34937":83642,"_23830":137073,"_5":16479,"_31422":137034,"_3630":137074},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_4190":83660,"_34937":83642,"_23830":137076,"_5":16479,"_31422":137038,"_3630":137077},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_4190":83661,"_34937":83642,"_23830":137079,"_5":16479,"_31422":137042,"_3630":137080},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_4190":83662,"_34937":83642,"_23830":137082,"_5":16479,"_31422":137046,"_3630":137083},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_4190":83663,"_34937":83663,"_5":16871,"_3630":137085,"_35372":137086,"_23830":137087,"_31422":83663},"Despliega Lamassu",[58062,137014],[],{"_4190":83664,"_34937":83663,"_23830":137089,"_5":16479,"_31422":83663,"_3630":137090},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_4190":83665,"_34937":83663,"_5":35369,"_23830":137092,"_31422":137093,"_3630":137094},[],"/docs/pr-preview/pr-58/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_4190":83666,"_34937":83663,"_5":35369,"_23830":137096,"_31422":137097,"_3630":137098},[],"/docs/pr-preview/pr-58/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_4190":83667,"_34937":83663,"_5":35369,"_23830":137100,"_31422":137101,"_3630":137102},[],"/docs/pr-preview/pr-58/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_4190":83668,"_34937":83663,"_23830":137104,"_5":16479,"_31422":83663,"_3630":137105},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_4190":83669,"_34937":83663,"_23830":137107,"_5":16479,"_31422":137093,"_3630":137108},[],"Modelo",{"_4190":83670,"_34937":83663,"_23830":137110,"_5":16479,"_31422":137093,"_3630":137111},[],"Recomendado para",{"_4190":83671,"_34937":83663,"_23830":137113,"_5":16479,"_31422":137093,"_3630":137114},[],"Quién opera la infraestructura",{"_4190":83672,"_34937":83663,"_23830":137116,"_5":16479,"_31422":137093,"_3630":137117},[],"Punto de partida",{"_4190":83673,"_34937":83663,"_23830":137119,"_5":16479,"_31422":137093,"_3630":58169},[],{"_4190":83674,"_34937":83663,"_23830":137121,"_5":16479,"_31422":137093,"_3630":137122},[],"Producción, entornos regulados y despliegues personalizados",{"_4190":83675,"_34937":83663,"_23830":137124,"_5":16479,"_31422":137093,"_3630":137125},[],"Tu equipo",{"_4190":83676,"_34937":83663,"_23830":137127,"_5":16479,"_31422":137093,"_3630":137128},[],"Helm o Fastlane",{"_4190":83677,"_34937":83663,"_23830":137130,"_5":16479,"_31422":137093,"_3630":58181},[],{"_4190":83678,"_34937":83663,"_23830":137132,"_5":16479,"_31422":137093,"_3630":137133},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_4190":83679,"_34937":83663,"_23830":137135,"_5":16479,"_31422":137093,"_3630":137125},[],{"_4190":83680,"_34937":83663,"_23830":137137,"_5":16479,"_31422":137093,"_3630":137138},[],"Imagen preconfigurada en EC2",{"_4190":83681,"_34937":83663,"_23830":137140,"_5":16479,"_31422":137093,"_3630":58192},[],{"_4190":83682,"_34937":83663,"_23830":137142,"_5":16479,"_31422":137093,"_3630":137143},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_4190":83683,"_34937":83663,"_23830":137145,"_5":16479,"_31422":137093,"_3630":58198},[],{"_4190":83684,"_34937":83663,"_23830":137147,"_5":16479,"_31422":137093,"_3630":137148},[],"Suscripción gestionada",{"_4190":83685,"_34937":83663,"_23830":137150,"_5":16479,"_31422":137093,"_3630":137151},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_4190":83686,"_34937":83663,"_23830":137153,"_5":16479,"_31422":137093,"_3630":137154},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_4190":83687,"_34937":83663,"_23830":137156,"_5":16479,"_31422":137093,"_3630":137157},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_4190":83688,"_34937":83663,"_23830":137159,"_5":16479,"_31422":137097,"_3630":137160},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_4190":83689,"_34937":83663,"_23830":137162,"_5":16479,"_31422":137101,"_3630":137163},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_4190":83690,"_34937":83690,"_5":16871,"_3630":137165,"_35372":137166,"_23830":137167,"_31422":83690},"Utiliza Lamassu como SaaS",[58062,137014,137015],[],{"_4190":83691,"_34937":83690,"_23830":137169,"_5":16479,"_31422":83690,"_3630":137170},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_4190":83692,"_34937":83690,"_5":35369,"_23830":137172,"_31422":137173,"_3630":137174},[],"/docs/pr-preview/pr-58/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_4190":83693,"_34937":83690,"_5":35369,"_23830":137176,"_31422":137177,"_3630":137178},[],"/docs/pr-preview/pr-58/es/deployment/saas#planes","Planes",{"_4190":83694,"_34937":83690,"_5":35369,"_23830":137180,"_31422":137181,"_3630":137182},[],"/docs/pr-preview/pr-58/es/deployment/saas#solicita-acceso","Solicita acceso",{"_4190":83695,"_34937":83690,"_23830":137184,"_5":16479,"_31422":83690,"_3630":137185},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_4190":83696,"_34937":83690,"_23830":137187,"_5":16479,"_31422":137173,"_3630":137188},[],"Disponibilidad y mantenimiento de la plataforma.",{"_4190":83697,"_34937":83690,"_23830":137190,"_5":16479,"_31422":137173,"_3630":137191},[],"Copias de seguridad automáticas.",{"_4190":83698,"_34937":83690,"_23830":137193,"_5":16479,"_31422":137173,"_3630":137194},[],"Actualizaciones de versión.",{"_4190":83699,"_34937":83690,"_23830":137196,"_5":16479,"_31422":137173,"_3630":137197},[],"Soporte técnico y SLA según el plan contratado.",{"_4190":83700,"_34937":83690,"_23830":137199,"_5":16479,"_31422":137177,"_3630":58253},[],{"_4190":83701,"_34937":83690,"_23830":137201,"_5":16479,"_31422":137177,"_3630":137202},[],"Dispositivos",{"_4190":83702,"_34937":83690,"_23830":137204,"_5":16479,"_31422":137177,"_3630":137205},[],"Soporte",{"_4190":83703,"_34937":83690,"_23830":137207,"_5":16479,"_31422":137177,"_3630":58262},[],{"_4190":83704,"_34937":83690,"_23830":137209,"_5":16479,"_31422":137177,"_3630":58265},[],{"_4190":83705,"_34937":83690,"_23830":137211,"_5":16479,"_31422":137177,"_3630":137212},[],"Hasta 1.000",{"_4190":83706,"_34937":83690,"_23830":137214,"_5":16479,"_31422":137177,"_3630":58271},[],{"_4190":83707,"_34937":83690,"_23830":137216,"_5":16479,"_31422":137177,"_3630":137217},[],"99,5 %",{"_4190":83708,"_34937":83690,"_23830":137219,"_5":16479,"_31422":137177,"_3630":58277},[],{"_4190":83709,"_34937":83690,"_23830":137221,"_5":16479,"_31422":137177,"_3630":137222},[],"Hasta 10.000",{"_4190":83710,"_34937":83690,"_23830":137224,"_5":16479,"_31422":137177,"_3630":137225},[],"Email y chat",{"_4190":83711,"_34937":83690,"_23830":137227,"_5":16479,"_31422":137177,"_3630":137228},[],"99,9 %",{"_4190":83712,"_34937":83690,"_23830":137230,"_5":16479,"_31422":137177,"_3630":58289},[],{"_4190":83713,"_34937":83690,"_23830":137232,"_5":16479,"_31422":137177,"_3630":137233},[],"Ilimitados",{"_4190":83714,"_34937":83690,"_23830":137235,"_5":16479,"_31422":137177,"_3630":137236},[],"Dedicado",{"_4190":83715,"_34937":83690,"_23830":137238,"_5":16479,"_31422":137177,"_3630":137239},[],"99,99 %",{"_4190":83716,"_34937":83690,"_23830":137241,"_5":16479,"_31422":137181,"_3630":137242},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_4190":83717,"_34937":83690,"_23830":137244,"_5":16479,"_31422":137181,"_3630":137245},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_4190":83718,"_34937":83718,"_5":16871,"_3630":58306,"_35372":137247,"_23830":137249,"_31422":83718},[58062,137014,137248],"Kubernetes autogestionado",[],{"_4190":83719,"_34937":83718,"_23830":137251,"_5":16479,"_31422":83718,"_3630":137252},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_4190":83720,"_34937":83718,"_5":35369,"_23830":137254,"_31422":137255,"_3630":137256},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_4190":83721,"_34937":83718,"_5":35369,"_23830":137258,"_31422":137259,"_3630":137260},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_4190":83722,"_34937":83718,"_5":35369,"_23830":137262,"_31422":137263,"_3630":137264},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_4190":83723,"_34937":83718,"_5":35369,"_23830":137266,"_31422":137267,"_3630":137268},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_4190":83724,"_34937":83718,"_5":35369,"_23830":137270,"_31422":137271,"_3630":137272},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_4190":83725,"_34937":83718,"_5":35369,"_23830":137274,"_31422":137275,"_3630":137276},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_4190":83726,"_34937":83718,"_5":35369,"_23830":137278,"_31422":137279,"_3630":137280},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_4190":83727,"_34937":83718,"_5":35369,"_23830":137282,"_31422":137283,"_3630":137284},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_4190":83728,"_34937":83718,"_5":35369,"_23830":137286,"_31422":137287,"_3630":137288},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_4190":83729,"_34937":83718,"_5":35369,"_23830":137290,"_31422":137291,"_3630":137292},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_4190":83730,"_34937":83718,"_5":35369,"_23830":137294,"_31422":137295,"_3630":137296},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_4190":83731,"_34937":83718,"_23830":137298,"_5":16479,"_31422":137255,"_3630":137299},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_4190":83732,"_34937":83718,"_23830":137301,"_5":16479,"_31422":137255,"_3630":137302},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_4190":83733,"_34937":83718,"_23830":137304,"_5":16479,"_31422":137259,"_3630":137305},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_4190":83734,"_34937":83718,"_23830":137307,"_5":16479,"_31422":137259,"_3630":137308},[],"Fastlane instala o configura",{"_4190":83735,"_34937":83718,"_23830":137310,"_5":16479,"_31422":137259,"_3630":137311},[],"Tú sigues proporcionando",{"_4190":83736,"_34937":83718,"_23830":137313,"_5":16479,"_31422":137259,"_3630":137314},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_4190":83737,"_34937":83718,"_23830":137316,"_5":16479,"_31422":137259,"_3630":137317},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_4190":83738,"_34937":83718,"_23830":137319,"_5":16479,"_31422":137259,"_3630":137320},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_4190":83739,"_34937":83718,"_23830":137322,"_5":16479,"_31422":137259,"_3630":137323},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_4190":83740,"_34937":83718,"_23830":137325,"_5":16479,"_31422":137259,"_3630":137326},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_4190":83741,"_34937":83718,"_23830":137328,"_5":16479,"_31422":137259,"_3630":137329},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_4190":83742,"_34937":83718,"_23830":137331,"_5":16479,"_31422":137259,"_3630":137332},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_4190":83743,"_34937":83718,"_23830":137334,"_5":16479,"_31422":137259,"_3630":137335},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_4190":83744,"_34937":83718,"_23830":137337,"_5":16479,"_31422":137259,"_3630":137338},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_4190":83745,"_34937":83718,"_23830":137340,"_5":16479,"_31422":137263,"_3630":137341},[],"Necesitas:",{"_4190":83746,"_34937":83718,"_23830":137343,"_5":16479,"_31422":137263,"_3630":137344},[],"un clúster Kubernetes existente",{"_4190":83747,"_34937":83718,"_23830":137346,"_5":16479,"_31422":137263,"_3630":137347},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_4190":83748,"_34937":83718,"_23830":137349,"_5":16479,"_31422":137263,"_3630":58408},[],{"_4190":83749,"_34937":83718,"_23830":137351,"_5":16479,"_31422":137263,"_3630":27019},[],{"_4190":83750,"_34937":83718,"_23830":137353,"_5":16479,"_31422":137263,"_3630":137354},[],"`jq` solo si usas `--sample-data` o `--development`",{"_4190":83751,"_34937":83718,"_23830":137356,"_5":16479,"_31422":137263,"_3630":137357},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_4190":83752,"_34937":83718,"_23830":137359,"_5":16479,"_31422":137263,"_3630":137360},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_4190":83753,"_34937":83718,"_23830":137362,"_5":16479,"_31422":137263,"_3630":137363},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_4190":83754,"_34937":83718,"_23830":137365,"_5":16479,"_31422":137263,"_3630":137366},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_4190":83755,"_34937":83718,"_23830":137368,"_5":16479,"_31422":137267,"_3630":137369},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_4190":83756,"_34937":83718,"_23830":137371,"_5":16479,"_31422":137267,"_3630":137372},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_4190":83757,"_34937":83718,"_23830":137374,"_5":16479,"_31422":137271,"_3630":137375},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_4190":83758,"_34937":83718,"_23830":137377,"_5":16479,"_31422":137271,"_3630":137378},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_4190":83759,"_34937":83718,"_23830":137380,"_5":16479,"_31422":137271,"_3630":137381},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_4190":83760,"_34937":83718,"_23830":137383,"_5":16479,"_31422":137271,"_3630":137384},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_4190":83761,"_34937":83718,"_23830":137386,"_5":16479,"_31422":137275,"_3630":137387},[],"Opción",{"_4190":83762,"_34937":83718,"_23830":137389,"_5":16479,"_31422":137275,"_3630":137390},[],"Valor predeterminado",{"_4190":83763,"_34937":83718,"_23830":137392,"_5":16479,"_31422":137275,"_3630":137393},[],"Propósito",{"_4190":83764,"_34937":83718,"_23830":137395,"_5":16479,"_31422":137275,"_3630":58455},[],{"_4190":83765,"_34937":83718,"_23830":137397,"_5":16479,"_31422":137275,"_3630":58458},[],{"_4190":83766,"_34937":83718,"_23830":137399,"_5":16479,"_31422":137275,"_3630":137400},[],"Muestra la ayuda",{"_4190":83767,"_34937":83718,"_23830":137402,"_5":16479,"_31422":137275,"_3630":58464},[],{"_4190":83768,"_34937":83718,"_23830":137404,"_5":16479,"_31422":137275,"_3630":137405},[],"contexto actual",{"_4190":83769,"_34937":83718,"_23830":137407,"_5":16479,"_31422":137275,"_3630":137408},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_4190":83770,"_34937":83718,"_23830":137410,"_5":16479,"_31422":137275,"_3630":58473},[],{"_4190":83771,"_34937":83718,"_23830":137412,"_5":16479,"_31422":137275,"_3630":7581},[],{"_4190":83772,"_34937":83718,"_23830":137414,"_5":16479,"_31422":137275,"_3630":137415},[],"Omite prompts y genera credenciales para las dependencias",{"_4190":83773,"_34937":83718,"_23830":137417,"_5":16479,"_31422":137275,"_3630":58481},[],{"_4190":83774,"_34937":83718,"_23830":137419,"_5":16479,"_31422":137275,"_3630":58484},[],{"_4190":83775,"_34937":83718,"_23830":137421,"_5":16479,"_31422":137275,"_3630":137422},[],"Namespace de la instalación",{"_4190":83776,"_34937":83718,"_23830":137424,"_5":16479,"_31422":137275,"_3630":58490},[],{"_4190":83777,"_34937":83718,"_23830":137426,"_5":16479,"_31422":137275,"_3630":58493},[],{"_4190":83778,"_34937":83718,"_23830":137428,"_5":16479,"_31422":137275,"_3630":137429},[],"Dominio usado por la UI, OIDC y el certificado",{"_4190":83779,"_34937":83718,"_23830":137431,"_5":16479,"_31422":137275,"_3630":58499},[],{"_4190":83780,"_34937":83718,"_23830":137433,"_5":16479,"_31422":137275,"_3630":17323},[],{"_4190":83781,"_34937":83718,"_23830":137435,"_5":16479,"_31422":137275,"_3630":137436},[],"Versión del chart de Lamassu",{"_4190":83782,"_34937":83718,"_23830":137438,"_5":16479,"_31422":137275,"_3630":58507},[],{"_4190":83783,"_34937":83718,"_23830":137440,"_5":16479,"_31422":137275,"_3630":58510},[],{"_4190":83784,"_34937":83718,"_23830":137442,"_5":16479,"_31422":137275,"_3630":137443},[],"Puerto del listener HTTPS",{"_4190":83785,"_34937":83718,"_23830":137445,"_5":16479,"_31422":137275,"_3630":58516},[],{"_4190":83786,"_34937":83718,"_23830":137447,"_5":16479,"_31422":137275,"_3630":58519},[],{"_4190":83787,"_34937":83718,"_23830":137449,"_5":16479,"_31422":137275,"_3630":137450},[],"Puerto del listener HTTP",{"_4190":83788,"_34937":83718,"_23830":137452,"_5":16479,"_31422":137275,"_3630":58525},[],{"_4190":83789,"_34937":83718,"_23830":137454,"_5":16479,"_31422":137275,"_3630":58458},[],{"_4190":83790,"_34937":83718,"_23830":137456,"_5":16479,"_31422":137275,"_3630":137457},[],"Certificado PEM para TLS downstream",{"_4190":83791,"_34937":83718,"_23830":137459,"_5":16479,"_31422":137275,"_3630":58533},[],{"_4190":83792,"_34937":83718,"_23830":137461,"_5":16479,"_31422":137275,"_3630":58458},[],{"_4190":83793,"_34937":83718,"_23830":137463,"_5":16479,"_31422":137275,"_3630":137464},[],"Clave privada PEM para TLS downstream",{"_4190":83794,"_34937":83718,"_23830":137466,"_5":16479,"_31422":137275,"_3630":58541},[],{"_4190":83795,"_34937":83718,"_23830":137468,"_5":16479,"_31422":137275,"_3630":137469},[],"chart del repositorio",{"_4190":83796,"_34937":83718,"_23830":137471,"_5":16479,"_31422":137275,"_3630":137472},[],"Usa un chart local de Lamassu sin empaquetar",{"_4190":83797,"_34937":83718,"_23830":137474,"_5":16479,"_31422":137275,"_3630":58550},[],{"_4190":83798,"_34937":83718,"_23830":137476,"_5":16479,"_31422":137275,"_3630":137477},[],"detección automática",{"_4190":83799,"_34937":83718,"_23830":137479,"_5":16479,"_31422":137275,"_3630":137480},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_4190":83800,"_34937":83718,"_23830":137482,"_5":16479,"_31422":137275,"_3630":58558},[],{"_4190":83801,"_34937":83718,"_23830":137484,"_5":16479,"_31422":137275,"_3630":7581},[],{"_4190":83802,"_34937":83718,"_23830":137486,"_5":16479,"_31422":137275,"_3630":137487},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_4190":83803,"_34937":83718,"_23830":137489,"_5":16479,"_31422":137275,"_3630":58566},[],{"_4190":83804,"_34937":83718,"_23830":137491,"_5":16479,"_31422":137275,"_3630":7581},[],{"_4190":83805,"_34937":83718,"_23830":137493,"_5":16479,"_31422":137275,"_3630":137494},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_4190":83806,"_34937":83718,"_23830":137496,"_5":16479,"_31422":137275,"_3630":58574},[],{"_4190":83807,"_34937":83718,"_23830":137498,"_5":16479,"_31422":137275,"_3630":7581},[],{"_4190":83808,"_34937":83718,"_23830":137500,"_5":16479,"_31422":137275,"_3630":137501},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_4190":83809,"_34937":83718,"_23830":137503,"_5":16479,"_31422":137275,"_3630":58582},[],{"_4190":83810,"_34937":83718,"_23830":137505,"_5":16479,"_31422":137275,"_3630":7581},[],{"_4190":83811,"_34937":83718,"_23830":137507,"_5":16479,"_31422":137275,"_3630":137508},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_4190":83812,"_34937":83718,"_23830":137510,"_5":16479,"_31422":137275,"_3630":58590},[],{"_4190":83813,"_34937":83718,"_23830":137512,"_5":16479,"_31422":137275,"_3630":58593},[],{"_4190":83814,"_34937":83718,"_23830":137514,"_5":16479,"_31422":137275,"_3630":137515},[],"Usa otro chart local de SoftHSM",{"_4190":83815,"_34937":83718,"_23830":137517,"_5":16479,"_31422":137275,"_3630":137518},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_4190":83816,"_34937":83718,"_23830":137520,"_5":16479,"_31422":137279,"_3630":137521},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_4190":83817,"_34937":83718,"_23830":137523,"_5":16479,"_31422":137279,"_3630":137524},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_4190":83818,"_34937":83718,"_23830":137526,"_5":16479,"_31422":137279,"_3630":137527},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_4190":83819,"_34937":83718,"_23830":137529,"_5":16479,"_31422":137279,"_3630":137530},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_4190":83820,"_34937":83718,"_23830":137532,"_5":16479,"_31422":137279,"_3630":137533},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_4190":83821,"_34937":83718,"_23830":137535,"_5":16479,"_31422":137279,"_3630":137536},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_4190":83822,"_34937":83718,"_23830":137538,"_5":16479,"_31422":137283,"_3630":58620},[],{"_4190":83823,"_34937":83718,"_23830":137540,"_5":16479,"_31422":137283,"_3630":137541},[],"valida las herramientas locales y el clúster seleccionado",{"_4190":83824,"_34937":83718,"_23830":137543,"_5":16479,"_31422":137283,"_3630":137544},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_4190":83825,"_34937":83718,"_23830":137546,"_5":16479,"_31422":137283,"_3630":137547},[],"crea el namespace",{"_4190":83826,"_34937":83718,"_23830":137549,"_5":16479,"_31422":137283,"_3630":137550},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_4190":83827,"_34937":83718,"_23830":137552,"_5":16479,"_31422":137283,"_3630":137553},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_4190":83828,"_34937":83718,"_23830":137555,"_5":16479,"_31422":137283,"_3630":137556},[],"instala RabbitMQ",{"_4190":83829,"_34937":83718,"_23830":137558,"_5":16479,"_31422":137283,"_3630":137559},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_4190":83830,"_34937":83718,"_23830":137561,"_5":16479,"_31422":137283,"_3630":137562},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_4190":83831,"_34937":83718,"_23830":137564,"_5":16479,"_31422":137283,"_3630":137565},[],"carga datos de ejemplo opcionalmente",{"_4190":83832,"_34937":83718,"_23830":137567,"_5":16479,"_31422":137283,"_3630":137568},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_4190":83833,"_34937":83718,"_23830":137570,"_5":16479,"_31422":137287,"_3630":137571},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_4190":83834,"_34937":83718,"_23830":137573,"_5":16479,"_31422":137287,"_3630":137574},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_4190":83835,"_34937":83718,"_23830":137576,"_5":16479,"_31422":137291,"_3630":137577},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_4190":83836,"_34937":83718,"_23830":137579,"_5":16479,"_31422":137291,"_3630":137580},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_4190":83837,"_34937":83718,"_23830":137582,"_5":16479,"_31422":137291,"_3630":137583},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_4190":83838,"_34937":83718,"_23830":137585,"_5":16479,"_31422":137295,"_3630":137586},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_4190":83839,"_34937":83839,"_5":16871,"_3630":137588,"_35372":137589,"_23830":137590,"_31422":83839},"Instala con Helm",[58062,137014,137248],[],{"_4190":83840,"_34937":83839,"_23830":137592,"_5":16479,"_31422":83839,"_3630":137593},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_4190":83841,"_34937":83839,"_5":35369,"_23830":137595,"_31422":137596,"_3630":137597},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_4190":83842,"_34937":83839,"_5":35369,"_23830":137599,"_31422":137600,"_3630":137264},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#antes-de-comenzar",{"_4190":83843,"_34937":83839,"_5":35369,"_23830":137602,"_31422":137603,"_3630":137604},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_4190":83844,"_34937":83839,"_5":35369,"_23830":137606,"_31422":137607,"_3630":137608},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_4190":83845,"_34937":83839,"_5":35369,"_23830":137610,"_31422":137611,"_3630":137612},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_4190":83846,"_34937":83839,"_5":35369,"_23830":137614,"_31422":137615,"_3630":137616},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_4190":83847,"_34937":83839,"_5":35369,"_23830":137618,"_31422":137619,"_3630":137620},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_4190":83848,"_34937":83839,"_5":35369,"_23830":137622,"_31422":137623,"_3630":137624},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_4190":83849,"_34937":83839,"_5":35369,"_23830":137626,"_31422":137627,"_3630":137628},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_4190":83850,"_34937":83839,"_5":35369,"_23830":137630,"_31422":137631,"_3630":137632},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_4190":83851,"_34937":83839,"_5":35369,"_23830":137634,"_31422":137635,"_3630":137636},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_4190":83852,"_34937":83839,"_23830":137638,"_5":16479,"_31422":137596,"_3630":137639},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_4190":83853,"_34937":83839,"_23830":137641,"_5":16479,"_31422":137600,"_3630":137642},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_4190":83854,"_34937":83839,"_23830":137644,"_5":16479,"_31422":137600,"_3630":137645},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_4190":83855,"_34937":83839,"_23830":137647,"_5":16479,"_31422":137600,"_3630":137648},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_4190":83856,"_34937":83839,"_23830":137650,"_5":16479,"_31422":137600,"_3630":137651},[],"un broker RabbitMQ accesible y sus credenciales",{"_4190":83857,"_34937":83839,"_23830":137653,"_5":16479,"_31422":137600,"_3630":137654},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_4190":83858,"_34937":83839,"_23830":137656,"_5":16479,"_31422":137600,"_3630":137657},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_4190":83859,"_34937":83839,"_23830":137659,"_5":16479,"_31422":137600,"_3630":137660},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_4190":83860,"_34937":83839,"_23830":137662,"_5":16479,"_31422":137600,"_3630":137663},[],"una StorageClass y un diseño de tráfico externo",{"_4190":83861,"_34937":83839,"_23830":137665,"_5":16479,"_31422":137600,"_3630":137666},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_4190":83862,"_34937":83839,"_23830":137668,"_5":16479,"_31422":137600,"_3630":137669},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_4190":83863,"_34937":83839,"_23830":137671,"_5":16479,"_31422":137600,"_3630":137672},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_4190":83864,"_34937":83839,"_23830":137674,"_5":16479,"_31422":137603,"_3630":137675},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_4190":83865,"_34937":83839,"_23830":137677,"_5":16479,"_31422":137603,"_3630":137678},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_4190":83866,"_34937":83839,"_23830":137680,"_5":16479,"_31422":137603,"_3630":137681},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_4190":83867,"_34937":83839,"_23830":137683,"_5":16479,"_31422":137607,"_3630":137684},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_4190":83868,"_34937":83839,"_23830":137686,"_5":16479,"_31422":137607,"_3630":137687},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_4190":83869,"_34937":83839,"_23830":137689,"_5":16479,"_31422":137607,"_3630":137690},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_4190":83870,"_34937":83839,"_23830":137692,"_5":16479,"_31422":137607,"_3630":137693},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_4190":83871,"_34937":83839,"_23830":137695,"_5":16479,"_31422":137611,"_3630":137696},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_4190":83872,"_34937":83839,"_23830":137698,"_5":16479,"_31422":137615,"_3630":137699},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_4190":83873,"_34937":83839,"_23830":137701,"_5":16479,"_31422":137615,"_3630":137702},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_4190":83874,"_34937":83839,"_23830":137704,"_5":16479,"_31422":137615,"_3630":137705},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_4190":83875,"_34937":83839,"_23830":137707,"_5":16479,"_31422":137615,"_3630":137708},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_4190":83876,"_34937":83839,"_23830":137710,"_5":16479,"_31422":137615,"_3630":137711},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_4190":83877,"_34937":83839,"_23830":137713,"_5":16479,"_31422":137615,"_3630":137714},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_4190":83878,"_34937":83839,"_23830":137716,"_5":16479,"_31422":137615,"_3630":137717},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_4190":83879,"_34937":83839,"_23830":137719,"_5":16479,"_31422":137619,"_3630":137720},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_4190":83880,"_34937":83839,"_23830":137722,"_5":16479,"_31422":137619,"_3630":137723},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_4190":83881,"_34937":83839,"_23830":137725,"_5":16479,"_31422":137619,"_3630":137726},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_4190":83882,"_34937":83839,"_23830":137728,"_5":16479,"_31422":137619,"_3630":137729},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_4190":83883,"_34937":83839,"_23830":137731,"_5":16479,"_31422":137623,"_3630":137732},[],"Para instalar un checkout local:",{"_4190":83884,"_34937":83839,"_23830":137734,"_5":16479,"_31422":137627,"_3630":137735},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_4190":83885,"_34937":83839,"_23830":137737,"_5":16479,"_31422":137627,"_3630":137738},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_4190":83886,"_34937":83839,"_23830":137740,"_5":16479,"_31422":137631,"_3630":137741},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_4190":83887,"_34937":83839,"_23830":137743,"_5":16479,"_31422":137631,"_3630":137744},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_4190":83888,"_34937":83839,"_23830":137746,"_5":16479,"_31422":137631,"_3630":137747},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_4190":83889,"_34937":83839,"_23830":137749,"_5":16479,"_31422":137631,"_3630":137750},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_4190":83890,"_34937":83839,"_23830":137752,"_5":16479,"_31422":137631,"_3630":137753},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_4190":83891,"_34937":83839,"_23830":137755,"_5":16479,"_31422":137635,"_3630":137756},[],"Antes de pasar a producción, revisa:",{"_4190":83892,"_34937":83839,"_23830":137758,"_5":16479,"_31422":137635,"_3630":137759},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_4190":83893,"_34937":83839,"_23830":137761,"_5":16479,"_31422":137635,"_3630":137762},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_4190":83894,"_34937":83839,"_23830":137764,"_5":16479,"_31422":137635,"_3630":137765},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_4190":83895,"_34937":83839,"_23830":137767,"_5":16479,"_31422":137635,"_3630":137768},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_4190":83896,"_34937":83839,"_23830":137770,"_5":16479,"_31422":137635,"_3630":137771},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_4190":83897,"_34937":83839,"_23830":137773,"_5":16479,"_31422":137635,"_3630":137774},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_4190":83898,"_34937":83839,"_23830":137776,"_5":16479,"_31422":137635,"_3630":137777},[],"SMTP, observabilidad y entrega de alertas",{"_4190":83899,"_34937":83839,"_23830":137779,"_5":16479,"_31422":137635,"_3630":137780},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_4190":83900,"_34937":83839,"_23830":137782,"_5":16479,"_31422":137635,"_3630":137783},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_4190":83901,"_34937":83901,"_5":16871,"_3630":137785,"_35372":137786,"_23830":137787,"_31422":83901},"Expón el Gateway",[58062,137014,137248],[],{"_4190":83902,"_34937":83901,"_23830":137789,"_5":16479,"_31422":83901,"_3630":137790},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_4190":83903,"_34937":83901,"_5":35369,"_23830":137792,"_31422":137793,"_3630":137794},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_4190":83904,"_34937":83901,"_5":35369,"_23830":137796,"_31422":137797,"_3630":137798},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_4190":83905,"_34937":83901,"_5":35369,"_23830":137800,"_31422":137801,"_3630":137802},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_4190":83906,"_34937":83901,"_5":35369,"_23830":137804,"_31422":137805,"_3630":58888},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#k3s",{"_4190":83907,"_34937":83901,"_5":35369,"_23830":137807,"_31422":137808,"_3630":137809},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_4190":83908,"_34937":83901,"_5":35369,"_23830":137811,"_31422":137812,"_3630":137813},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_4190":83909,"_34937":83901,"_5":35369,"_23830":137815,"_31422":137816,"_3630":137817},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_4190":83910,"_34937":83901,"_5":35369,"_23830":137819,"_31422":137820,"_3630":137821},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_4190":83911,"_34937":83901,"_5":35369,"_23830":137823,"_31422":137824,"_3630":137825},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_4190":83912,"_34937":83901,"_5":35369,"_23830":137827,"_31422":137828,"_3630":137829},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_4190":83913,"_34937":83901,"_5":35369,"_23830":137831,"_31422":137832,"_3630":137833},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_4190":83914,"_34937":83901,"_23830":137835,"_5":16479,"_31422":137793,"_3630":137836},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_4190":83915,"_34937":83901,"_23830":137838,"_5":16479,"_31422":137793,"_3630":137839},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_4190":83916,"_34937":83901,"_23830":137841,"_5":16479,"_31422":137797,"_3630":137842},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_4190":83917,"_34937":83901,"_23830":137844,"_5":16479,"_31422":137797,"_3630":137845},[],"Defínelo únicamente cuando:",{"_4190":83918,"_34937":83901,"_23830":137847,"_5":16479,"_31422":137797,"_3630":137848},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_4190":83919,"_34937":83901,"_23830":137850,"_5":16479,"_31422":137797,"_3630":137851},[],"esa dirección está asignada a este Gateway",{"_4190":83920,"_34937":83901,"_23830":137853,"_5":16479,"_31422":137797,"_3630":137854},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_4190":83921,"_34937":83901,"_23830":137856,"_5":16479,"_31422":137797,"_3630":137857},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_4190":83922,"_34937":83901,"_23830":137859,"_5":16479,"_31422":137797,"_3630":137860},[],"No confundas estos valores:",{"_4190":83923,"_34937":83901,"_23830":137862,"_5":16479,"_31422":137797,"_3630":137863},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_4190":83924,"_34937":83901,"_23830":137865,"_5":16479,"_31422":137797,"_3630":137866},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_4190":83925,"_34937":83901,"_23830":137868,"_5":16479,"_31422":137797,"_3630":137869},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_4190":83926,"_34937":83901,"_23830":137871,"_5":16479,"_31422":137801,"_3630":137872},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_4190":83927,"_34937":83901,"_23830":137874,"_5":16479,"_31422":137801,"_3630":137875},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_4190":83928,"_34937":83901,"_23830":137877,"_5":16479,"_31422":137805,"_3630":137878},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_4190":83929,"_34937":83901,"_23830":137880,"_5":16479,"_31422":137805,"_3630":137881},[],"Para el diseño recomendado:",{"_4190":83930,"_34937":83901,"_23830":137883,"_5":16479,"_31422":137805,"_3630":137884},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_4190":83931,"_34937":83901,"_23830":137886,"_5":16479,"_31422":137805,"_3630":137887},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_4190":83932,"_34937":83901,"_23830":137889,"_5":16479,"_31422":137805,"_3630":137890},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_4190":83933,"_34937":83901,"_23830":137892,"_5":16479,"_31422":137805,"_3630":137893},[],"Apunta DNS a la dirección accesible de la VM.",{"_4190":83934,"_34937":83901,"_23830":137895,"_5":16479,"_31422":137805,"_3630":137896},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_4190":83935,"_34937":83901,"_23830":137898,"_5":16479,"_31422":137808,"_3630":137899},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_4190":83936,"_34937":83901,"_23830":137901,"_5":16479,"_31422":137812,"_3630":137902},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_4190":83937,"_34937":83901,"_23830":137904,"_5":16479,"_31422":137812,"_3630":137905},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_4190":83938,"_34937":83901,"_23830":137907,"_5":16479,"_31422":137816,"_3630":137908},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_4190":83939,"_34937":83901,"_23830":137910,"_5":16479,"_31422":137816,"_3630":137911},[],"Requisito",{"_4190":83940,"_34937":83901,"_23830":137913,"_5":16479,"_31422":137816,"_3630":137914},[],"Diseño recomendado",{"_4190":83941,"_34937":83901,"_23830":137916,"_5":16479,"_31422":137816,"_3630":137917},[],"Consecuencia",{"_4190":83942,"_34937":83901,"_23830":137919,"_5":16479,"_31422":137816,"_3630":137920},[],"Varias URL o servicios de Lamassu",{"_4190":83943,"_34937":83901,"_23830":137922,"_5":16479,"_31422":137816,"_3630":137923},[],"Un Gateway con varias rutas",{"_4190":83944,"_34937":83901,"_23830":137925,"_5":16479,"_31422":137816,"_3630":137926},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_4190":83945,"_34937":83901,"_23830":137928,"_5":16479,"_31422":137816,"_3630":137929},[],"Gateways independientes e IP externas distintas",{"_4190":83946,"_34937":83901,"_23830":137931,"_5":16479,"_31422":137816,"_3630":137932},[],"Una VIP por Gateway",{"_4190":83947,"_34937":83901,"_23830":137934,"_5":16479,"_31422":137816,"_3630":137935},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_4190":83948,"_34937":83901,"_23830":137937,"_5":16479,"_31422":137816,"_3630":137938},[],"Gateways independientes, un nodo y una IP",{"_4190":83949,"_34937":83901,"_23830":137940,"_5":16479,"_31422":137816,"_3630":137941},[],"Puertos externos diferentes",{"_4190":83950,"_34937":83901,"_23830":137943,"_5":16479,"_31422":137816,"_3630":137944},[],"Los clientes deben indicar puertos no estándar",{"_4190":83951,"_34937":83901,"_23830":137946,"_5":16479,"_31422":137816,"_3630":137947},[],"Terminación TLS/mTLS separada detrás de una IP",{"_4190":83952,"_34937":83901,"_23830":137949,"_5":16479,"_31422":137816,"_3630":137950},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_4190":83953,"_34937":83901,"_23830":137952,"_5":16479,"_31422":137816,"_3630":137953},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_4190":83954,"_34937":83901,"_23830":137955,"_5":16479,"_31422":137816,"_3630":137956},[],"Recursos Gateway separados pero proxy compartido",{"_4190":83955,"_34937":83901,"_23830":137958,"_5":16479,"_31422":137816,"_3630":137959},[],"Modo merged Gateway de Envoy",{"_4190":83956,"_34937":83901,"_23830":137961,"_5":16479,"_31422":137816,"_3630":137962},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_4190":83957,"_34937":83901,"_23830":137964,"_5":16479,"_31422":137816,"_3630":137965},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_4190":83958,"_34937":83901,"_23830":137967,"_5":16479,"_31422":137816,"_3630":137968},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_4190":83959,"_34937":83901,"_23830":137970,"_5":16479,"_31422":137816,"_3630":137971},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_4190":83960,"_34937":83901,"_23830":137973,"_5":16479,"_31422":137816,"_3630":137974},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_4190":83961,"_34937":83901,"_23830":137976,"_5":16479,"_31422":137820,"_3630":137977},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_4190":83962,"_34937":83901,"_23830":137979,"_5":16479,"_31422":137824,"_3630":137980},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_4190":83963,"_34937":83901,"_23830":137982,"_5":16479,"_31422":137824,"_3630":137983},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_4190":83964,"_34937":83901,"_23830":137985,"_5":16479,"_31422":137824,"_3630":137986},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_4190":83965,"_34937":83901,"_23830":137988,"_5":16479,"_31422":137824,"_3630":137989},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_4190":83966,"_34937":83901,"_23830":137991,"_5":16479,"_31422":137824,"_3630":137992},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_4190":83967,"_34937":83901,"_23830":137994,"_5":16479,"_31422":137828,"_3630":137995},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_4190":83968,"_34937":83901,"_23830":137997,"_5":16479,"_31422":137828,"_3630":137998},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_4190":83969,"_34937":83901,"_23830":138000,"_5":16479,"_31422":137832,"_3630":138001},[],"Comprueba, en orden:",{"_4190":83970,"_34937":83901,"_23830":138003,"_5":16479,"_31422":137832,"_3630":138004},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_4190":83971,"_34937":83901,"_23830":138006,"_5":16479,"_31422":137832,"_3630":138007},[],"Su estado contiene la dirección esperada.",{"_4190":83972,"_34937":83901,"_23830":138009,"_5":16479,"_31422":137832,"_3630":138010},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_4190":83973,"_34937":83901,"_23830":138012,"_5":16479,"_31422":137832,"_3630":138013},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_4190":83974,"_34937":83901,"_23830":138015,"_5":16479,"_31422":137832,"_3630":138016},[],"DNS resuelve al endpoint accesible externamente.",{"_4190":83975,"_34937":83901,"_23830":138018,"_5":16479,"_31422":137832,"_3630":138019},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_4190":83976,"_34937":83901,"_23830":138021,"_5":16479,"_31422":137832,"_3630":138022},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_4190":83977,"_34937":83977,"_5":16871,"_3630":58169,"_35372":138024,"_23830":138025,"_31422":83977},[58062,137014,137248],[],{"_4190":83978,"_34937":83977,"_23830":138027,"_5":16479,"_31422":83977,"_3630":138028},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_4190":83979,"_34937":83977,"_5":35369,"_23830":138030,"_31422":138031,"_3630":138032},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_4190":83980,"_34937":83977,"_5":35369,"_23830":138034,"_31422":138035,"_3630":138036},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_4190":83981,"_34937":83977,"_5":35369,"_23830":138038,"_31422":138039,"_3630":138040},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_4190":83982,"_34937":83977,"_5":35369,"_23830":138042,"_31422":138043,"_3630":138044},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_4190":83983,"_34937":83977,"_5":35369,"_23830":138046,"_31422":138047,"_3630":138048},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_4190":83984,"_34937":83977,"_5":35369,"_23830":138050,"_31422":138051,"_3630":138052},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_4190":83985,"_34937":83977,"_23830":138054,"_5":16479,"_31422":138031,"_3630":138055},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_4190":83986,"_34937":83977,"_23830":138057,"_5":16479,"_31422":138035,"_3630":138058},[],"Flujo",{"_4190":83987,"_34937":83977,"_23830":138060,"_5":16479,"_31422":138035,"_3630":138061},[],"Úsalo para",{"_4190":83988,"_34937":83977,"_23830":138063,"_5":16479,"_31422":138035,"_3630":138064},[],"Qué instala",{"_4190":83989,"_34937":83977,"_23830":138066,"_5":16479,"_31422":138035,"_3630":59150},[],{"_4190":83990,"_34937":83977,"_23830":138068,"_5":16479,"_31422":138035,"_3630":138069},[],"Producción y entornos controlados",{"_4190":83991,"_34937":83977,"_23830":138071,"_5":16479,"_31422":138035,"_3630":138072},[],"Servicios de Lamassu y recursos de Gateway API",{"_4190":83992,"_34937":83977,"_23830":138074,"_5":16479,"_31422":138035,"_3630":58306},[],{"_4190":83993,"_34937":83977,"_23830":138076,"_5":16479,"_31422":138035,"_3630":138077},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_4190":83994,"_34937":83977,"_23830":138079,"_5":16479,"_31422":138035,"_3630":138080},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_4190":83995,"_34937":83977,"_23830":138082,"_5":16479,"_31422":138039,"_3630":138083},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_4190":83996,"_34937":83977,"_23830":138085,"_5":16479,"_31422":138039,"_3630":138086},[],"Área",{"_4190":83997,"_34937":83977,"_23830":138088,"_5":16479,"_31422":138039,"_3630":138089},[],"El chart de Lamassu proporciona",{"_4190":83998,"_34937":83977,"_23830":138091,"_5":16479,"_31422":138039,"_3630":138092},[],"Tú proporcionas",{"_4190":83999,"_34937":83977,"_23830":138094,"_5":16479,"_31422":138039,"_3630":138095},[],"Aplicaciones Lamassu",{"_4190":84000,"_34937":83977,"_23830":138097,"_5":16479,"_31422":138039,"_3630":138098},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_4190":84001,"_34937":83977,"_23830":138100,"_5":16479,"_31422":138039,"_3630":138101},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_4190":84002,"_34937":83977,"_23830":138103,"_5":16479,"_31422":138039,"_3630":138104},[],"Datos PostgreSQL",{"_4190":84003,"_34937":83977,"_23830":138106,"_5":16479,"_31422":138039,"_3630":138107},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_4190":84004,"_34937":83977,"_23830":138109,"_5":16479,"_31422":138039,"_3630":138110},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_4190":84005,"_34937":83977,"_23830":138112,"_5":16479,"_31422":138039,"_3630":138113},[],"Mensajería",{"_4190":84006,"_34937":83977,"_23830":138115,"_5":16479,"_31422":138039,"_3630":138116},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_4190":84007,"_34937":83977,"_23830":138118,"_5":16479,"_31422":138039,"_3630":138119},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_4190":84008,"_34937":83977,"_23830":138121,"_5":16479,"_31422":138039,"_3630":138122},[],"Identidad",{"_4190":84009,"_34937":83977,"_23830":138124,"_5":16479,"_31422":138039,"_3630":138125},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_4190":84010,"_34937":83977,"_23830":138127,"_5":16479,"_31422":138039,"_3630":138128},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_4190":84011,"_34937":83977,"_23830":138130,"_5":16479,"_31422":138039,"_3630":138131},[],"Enrutamiento externo",{"_4190":84012,"_34937":83977,"_23830":138133,"_5":16479,"_31422":138039,"_3630":138134},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_4190":84013,"_34937":83977,"_23830":138136,"_5":16479,"_31422":138039,"_3630":138137},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_4190":84014,"_34937":83977,"_23830":138139,"_5":16479,"_31422":138039,"_3630":59224},[],{"_4190":84015,"_34937":83977,"_23830":138141,"_5":16479,"_31422":138039,"_3630":138142},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_4190":84016,"_34937":83977,"_23830":138144,"_5":16479,"_31422":138039,"_3630":138145},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_4190":84017,"_34937":83977,"_23830":138147,"_5":16479,"_31422":138039,"_3630":138148},[],"Datos persistentes de la aplicación",{"_4190":84018,"_34937":83977,"_23830":138150,"_5":16479,"_31422":138039,"_3630":138151},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_4190":84019,"_34937":83977,"_23830":138153,"_5":16479,"_31422":138039,"_3630":138154},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_4190":84020,"_34937":83977,"_23830":138156,"_5":16479,"_31422":138039,"_3630":138157},[],"Integraciones opcionales",{"_4190":84021,"_34937":83977,"_23830":138159,"_5":16479,"_31422":138039,"_3630":138160},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_4190":84022,"_34937":83977,"_23830":138162,"_5":16479,"_31422":138039,"_3630":138163},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_4190":84023,"_34937":83977,"_23830":138165,"_5":16479,"_31422":138039,"_3630":138166},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_4190":84024,"_34937":83977,"_23830":138168,"_5":16479,"_31422":138039,"_3630":138169},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_4190":84025,"_34937":83977,"_23830":138171,"_5":16479,"_31422":138043,"_3630":138172},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_4190":84026,"_34937":83977,"_23830":138174,"_5":16479,"_31422":138043,"_3630":138175},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_4190":84027,"_34937":83977,"_23830":138177,"_5":16479,"_31422":138047,"_3630":138178},[],"Kubernetes 1.24 o posterior",{"_4190":84028,"_34937":83977,"_23830":138180,"_5":16479,"_31422":138047,"_3630":138181},[],"Helm 3.2 o posterior",{"_4190":84029,"_34937":83977,"_23830":138183,"_5":16479,"_31422":138047,"_3630":138184},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_4190":84030,"_34937":83977,"_23830":138186,"_5":16479,"_31422":138047,"_3630":138187},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_4190":84031,"_34937":83977,"_23830":138189,"_5":16479,"_31422":138047,"_3630":138190},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_4190":84032,"_34937":83977,"_23830":138192,"_5":16479,"_31422":138047,"_3630":138193},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_4190":84033,"_34937":83977,"_23830":138195,"_5":16479,"_31422":138047,"_3630":138196},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_4190":84034,"_34937":83977,"_23830":138198,"_5":16479,"_31422":138051,"_3630":138199},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4190":84035,"_34937":83977,"_23830":138201,"_5":16479,"_31422":138051,"_3630":138202},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_4190":84036,"_34937":83977,"_23830":138204,"_5":16479,"_31422":138051,"_3630":138205},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_4190":84037,"_34937":83977,"_23830":138207,"_5":16479,"_31422":138051,"_3630":138208},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_4190":84038,"_34937":84038,"_5":16871,"_3630":138210,"_35372":138211,"_23830":138213,"_31422":84038},"Resolución de problemas de despliegue",[58062,137014,138212],"Operación",[],{"_4190":84039,"_34937":84038,"_23830":138215,"_5":16479,"_31422":84038,"_3630":138216},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_4190":84040,"_34937":84038,"_5":35369,"_23830":138218,"_31422":138219,"_3630":138220},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_4190":84041,"_34937":84038,"_5":35369,"_23830":138222,"_31422":138223,"_3630":138224},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_4190":84042,"_34937":84038,"_5":35369,"_23830":138226,"_31422":138227,"_3630":138228},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_4190":84043,"_34937":84038,"_5":35369,"_23830":138230,"_31422":138231,"_3630":138232},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_4190":84044,"_34937":84038,"_5":35369,"_23830":138234,"_31422":138235,"_3630":138236},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_4190":84045,"_34937":84038,"_5":35369,"_23830":138238,"_31422":138239,"_3630":138240},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_4190":84046,"_34937":84038,"_5":35369,"_23830":138242,"_31422":138243,"_3630":138244},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_4190":84047,"_34937":84038,"_5":35369,"_23830":138246,"_31422":138247,"_3630":138248},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_4190":84048,"_34937":84038,"_5":35369,"_23830":138250,"_31422":138251,"_3630":138252},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_4190":84049,"_34937":84038,"_5":35369,"_23830":138254,"_31422":138255,"_3630":138256},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_4190":84050,"_34937":84038,"_5":35369,"_23830":138258,"_31422":138259,"_3630":138260},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_4190":84051,"_34937":84038,"_5":35369,"_23830":138262,"_31422":138263,"_3630":138264},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_4190":84052,"_34937":84038,"_5":35369,"_23830":138266,"_31422":138267,"_3630":138268},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_4190":84053,"_34937":84038,"_23830":138270,"_5":16479,"_31422":84038,"_3630":138271},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_4190":84054,"_34937":84038,"_23830":138273,"_5":16479,"_31422":138223,"_3630":138274},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_4190":84055,"_34937":84038,"_23830":138276,"_5":16479,"_31422":138227,"_3630":138277},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_4190":84056,"_34937":84038,"_23830":138279,"_5":16479,"_31422":138231,"_3630":138280},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_4190":84057,"_34937":84038,"_23830":138282,"_5":16479,"_31422":138235,"_3630":138283},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_4190":84058,"_34937":84038,"_23830":138285,"_5":16479,"_31422":138239,"_3630":138286},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_4190":84059,"_34937":84038,"_23830":138288,"_5":16479,"_31422":138243,"_3630":138289},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_4190":84060,"_34937":84038,"_23830":138291,"_5":16479,"_31422":138243,"_3630":138292},[],"Ejecuta también la prueba de conectividad del chart:",{"_4190":84061,"_34937":84038,"_23830":138294,"_5":16479,"_31422":138243,"_3630":138295},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_4190":84062,"_34937":84038,"_23830":138297,"_5":16479,"_31422":138243,"_3630":138298},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_4190":84063,"_34937":84038,"_23830":138300,"_5":16479,"_31422":138247,"_3630":138301},[],"Si recibes un 401:",{"_4190":84064,"_34937":84038,"_23830":138303,"_5":16479,"_31422":138247,"_3630":138304},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_4190":84065,"_34937":84038,"_23830":138306,"_5":16479,"_31422":138247,"_3630":138307},[],"verifica emisor, audiencia y expiración del token;",{"_4190":84066,"_34937":84038,"_23830":138309,"_5":16479,"_31422":138247,"_3630":138310},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_4190":84067,"_34937":84038,"_23830":138312,"_5":16479,"_31422":138247,"_3630":138313},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_4190":84068,"_34937":84038,"_23830":138315,"_5":16479,"_31422":138247,"_3630":138316},[],"Si el login termina pero las APIs devuelven 403:",{"_4190":84069,"_34937":84038,"_23830":138318,"_5":16479,"_31422":138247,"_3630":138319},[],"inspecciona los claims reales del token;",{"_4190":84070,"_34937":84038,"_23830":138321,"_5":16479,"_31422":138247,"_3630":138322},[],"confirma que coinciden con un principal activo;",{"_4190":84071,"_34937":84038,"_23830":138324,"_5":16479,"_31422":138247,"_3630":138325},[],"revisa las políticas concedidas al principal;",{"_4190":84072,"_34937":84038,"_23830":138327,"_5":16479,"_31422":138247,"_3630":138328},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_4190":84073,"_34937":84038,"_23830":138330,"_5":16479,"_31422":138247,"_3630":138331},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_4190":84074,"_34937":84038,"_23830":138333,"_5":16479,"_31422":138251,"_3630":138334},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_4190":84075,"_34937":84038,"_23830":138336,"_5":16479,"_31422":138251,"_3630":138337},[],"Localiza el pod y Service de authz.",{"_4190":84076,"_34937":84038,"_23830":138339,"_5":16479,"_31422":138251,"_3630":138340},[],"Comprueba /health, logs y conexión a su base de datos.",{"_4190":84077,"_34937":84038,"_23830":138342,"_5":16479,"_31422":138251,"_3630":138343},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_4190":84078,"_34937":84038,"_23830":138345,"_5":16479,"_31422":138251,"_3630":138346},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_4190":84079,"_34937":84038,"_23830":138348,"_5":16479,"_31422":138251,"_3630":138349},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_4190":84080,"_34937":84038,"_23830":138351,"_5":16479,"_31422":138255,"_3630":138352},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_4190":84081,"_34937":84038,"_23830":138354,"_5":16479,"_31422":138259,"_3630":138355},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_4190":84082,"_34937":84038,"_23830":138357,"_5":16479,"_31422":138259,"_3630":138358},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_4190":84083,"_34937":84038,"_23830":138360,"_5":16479,"_31422":138259,"_3630":138361},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_4190":84084,"_34937":84038,"_23830":138363,"_5":16479,"_31422":138259,"_3630":138364},[],"volumen persistente sin enlazar;",{"_4190":84085,"_34937":84038,"_23830":138366,"_5":16479,"_31422":138259,"_3630":138367},[],"imagen inaccesible o política de pull incorrecta;",{"_4190":84086,"_34937":84038,"_23830":138369,"_5":16479,"_31422":138259,"_3630":138370},[],"configuración inválida del motor criptográfico;",{"_4190":84087,"_34937":84038,"_23830":138372,"_5":16479,"_31422":138259,"_3630":138373},[],"límites de CPU o memoria demasiado bajos;",{"_4190":84088,"_34937":84038,"_23830":138375,"_5":16479,"_31422":138259,"_3630":138376},[],"migración previa incompleta.",{"_4190":84089,"_34937":84038,"_23830":138378,"_5":16479,"_31422":138259,"_3630":138379},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_4190":84090,"_34937":84038,"_23830":138381,"_5":16479,"_31422":138259,"_3630":138382},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_4190":84091,"_34937":84038,"_23830":138384,"_5":16479,"_31422":138259,"_3630":138385},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_4190":84092,"_34937":84038,"_23830":138387,"_5":16479,"_31422":138263,"_3630":138388},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_4190":84093,"_34937":84038,"_23830":138390,"_5":16479,"_31422":138263,"_3630":138391},[],"verifica que esté habilitado en el servicio emisor;",{"_4190":84094,"_34937":84038,"_23830":138393,"_5":16479,"_31422":138263,"_3630":138394},[],"comprueba conectividad y credenciales AMQP;",{"_4190":84095,"_34937":84038,"_23830":138396,"_5":16479,"_31422":138263,"_3630":138397},[],"revisa exchange, routing key, colas y consumidores;",{"_4190":84096,"_34937":84038,"_23830":138399,"_5":16479,"_31422":138263,"_3630":138400},[],"inspecciona dead-letter queues;",{"_4190":84097,"_34937":84038,"_23830":138402,"_5":16479,"_31422":138263,"_3630":138403},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_4190":84098,"_34937":84038,"_23830":138405,"_5":16479,"_31422":138263,"_3630":138406},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_4190":84099,"_34937":84038,"_23830":138408,"_5":16479,"_31422":138263,"_3630":138409},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_4190":84100,"_34937":84038,"_23830":138411,"_5":16479,"_31422":138263,"_3630":138412},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_4190":84101,"_34937":84038,"_23830":138414,"_5":16479,"_31422":138263,"_3630":138415},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_4190":84102,"_34937":84038,"_23830":138417,"_5":16479,"_31422":138263,"_3630":138418},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_4190":84103,"_34937":84038,"_23830":138420,"_5":16479,"_31422":138263,"_3630":138421},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_4190":84104,"_34937":84038,"_23830":138423,"_5":16479,"_31422":138263,"_3630":138424},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_4190":84105,"_34937":84038,"_23830":138426,"_5":16479,"_31422":138267,"_3630":138427},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_4190":84106,"_34937":84038,"_23830":138429,"_5":16479,"_31422":138267,"_3630":138430},[],"Antes de cerrar una incidencia, guarda:",{"_4190":84107,"_34937":84038,"_23830":138432,"_5":16479,"_31422":138267,"_3630":138433},[],"causa confirmada;",{"_4190":84108,"_34937":84038,"_23830":138435,"_5":16479,"_31422":138267,"_3630":138436},[],"alcance temporal y recursos afectados;",{"_4190":84109,"_34937":84038,"_23830":138438,"_5":16479,"_31422":138267,"_3630":138439},[],"comandos o consultas utilizados;",{"_4190":84110,"_34937":84038,"_23830":138441,"_5":16479,"_31422":138267,"_3630":138442},[],"cambio aplicado y forma de revertirlo;",{"_4190":84111,"_34937":84038,"_23830":138444,"_5":16479,"_31422":138267,"_3630":138445},[],"validación desde un consumidor;",{"_4190":84112,"_34937":84038,"_23830":138447,"_5":16479,"_31422":138267,"_3630":138448},[],"acción preventiva y propietario.",{"_4190":84113,"_34937":84113,"_5":16871,"_3630":138450,"_35372":138451,"_23830":138454,"_31422":84113},"Control de acceso",[58062,138452,138453],"Plataforma","Administración",[],{"_4190":84114,"_34937":84113,"_23830":138456,"_5":16479,"_31422":84113,"_3630":138457},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_4190":84115,"_34937":84113,"_5":35369,"_23830":138459,"_31422":138460,"_3630":138461},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_4190":84116,"_34937":84113,"_5":35369,"_23830":138463,"_31422":138464,"_3630":138465},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_4190":84117,"_34937":84113,"_5":35369,"_23830":138467,"_31422":138468,"_3630":138469},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_4190":84118,"_34937":84113,"_5":35369,"_23830":138471,"_31422":138472,"_3630":138473},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_4190":84119,"_34937":84113,"_5":35369,"_23830":138475,"_31422":138476,"_3630":138477},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_4190":84120,"_34937":84113,"_5":35369,"_23830":138479,"_31422":138480,"_3630":138481},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_4190":84121,"_34937":84113,"_5":35369,"_23830":138483,"_31422":138484,"_3630":138485},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_4190":84122,"_34937":84113,"_5":35369,"_23830":138487,"_31422":138488,"_3630":138489},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-x509","Principales X.509",{"_4190":84123,"_34937":84113,"_5":35369,"_23830":138491,"_31422":138492,"_3630":138493},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_4190":84124,"_34937":84113,"_5":35369,"_23830":138495,"_31422":138496,"_3630":138497},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_4190":84125,"_34937":84113,"_5":35369,"_23830":138499,"_31422":138500,"_3630":138501},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_4190":84126,"_34937":84113,"_5":35369,"_23830":138503,"_31422":138504,"_3630":138505},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_4190":84127,"_34937":84113,"_5":35369,"_23830":138507,"_31422":138508,"_3630":138509},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_4190":84128,"_34937":84113,"_5":35369,"_23830":138511,"_31422":138512,"_3630":138513},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_4190":84129,"_34937":84113,"_5":35369,"_23830":138515,"_31422":138516,"_3630":138517},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_4190":84130,"_34937":84113,"_5":35369,"_23830":138519,"_31422":138520,"_3630":137620},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_4190":84131,"_34937":84113,"_5":35369,"_23830":138522,"_31422":138523,"_3630":138524},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_4190":84132,"_34937":84113,"_5":35369,"_23830":138526,"_31422":138527,"_3630":138528},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_4190":84133,"_34937":84113,"_5":35369,"_23830":138530,"_31422":138531,"_3630":138532},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_4190":84134,"_34937":84113,"_5":35369,"_23830":138534,"_31422":138535,"_3630":138536},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_4190":84135,"_34937":84113,"_5":35369,"_23830":138538,"_31422":138539,"_3630":138540},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_4190":84136,"_34937":84113,"_5":35369,"_23830":138542,"_31422":138543,"_3630":138544},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_4190":84137,"_34937":84113,"_5":35369,"_23830":138546,"_31422":138547,"_3630":138548},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_4190":84138,"_34937":84113,"_5":35369,"_23830":138550,"_31422":138551,"_3630":138552},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_4190":84139,"_34937":84113,"_5":35369,"_23830":138554,"_31422":138555,"_3630":138556},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_4190":84140,"_34937":84113,"_5":35369,"_23830":138558,"_31422":138559,"_3630":138560},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_4190":84141,"_34937":84113,"_5":35369,"_23830":138562,"_31422":138563,"_3630":138564},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_4190":84142,"_34937":84113,"_5":35369,"_23830":138566,"_31422":138567,"_3630":138568},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_4190":84143,"_34937":84113,"_5":35369,"_23830":138570,"_31422":138571,"_3630":138572},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_4190":84144,"_34937":84113,"_5":35369,"_23830":138574,"_31422":138575,"_3630":138576},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_4190":84145,"_34937":84113,"_5":35369,"_23830":138578,"_31422":138579,"_3630":138580},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_4190":84146,"_34937":84113,"_23830":138582,"_5":16479,"_31422":84113,"_3630":138583},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_4190":84147,"_34937":84113,"_23830":138585,"_5":16479,"_31422":84113,"_3630":138586},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_4190":84148,"_34937":84113,"_23830":138588,"_5":16479,"_31422":84113,"_3630":138589},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_4190":84149,"_34937":84113,"_23830":138591,"_5":16479,"_31422":138460,"_3630":138592},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_4190":84150,"_34937":84113,"_23830":138594,"_5":16479,"_31422":138460,"_3630":138595},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_4190":84151,"_34937":84113,"_23830":138597,"_5":16479,"_31422":138460,"_3630":138598},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_4190":84152,"_34937":84113,"_23830":138600,"_5":16479,"_31422":138460,"_3630":138601},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_4190":84153,"_34937":84113,"_23830":138603,"_5":16479,"_31422":138460,"_3630":138604},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_4190":84154,"_34937":84113,"_23830":138606,"_5":16479,"_31422":138460,"_3630":138607},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_4190":84155,"_34937":84113,"_23830":138609,"_5":16479,"_31422":138464,"_3630":138610},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_4190":84156,"_34937":84113,"_23830":138612,"_5":16479,"_31422":138464,"_3630":138613},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_4190":84157,"_34937":84113,"_23830":138615,"_5":16479,"_31422":138468,"_3630":138616},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_4190":84158,"_34937":84113,"_23830":138618,"_5":16479,"_31422":138468,"_3630":138619},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_4190":84159,"_34937":84113,"_23830":138621,"_5":16479,"_31422":138468,"_3630":138622},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_4190":84160,"_34937":84113,"_23830":138624,"_5":16479,"_31422":138468,"_3630":138625},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_4190":84161,"_34937":84113,"_23830":138627,"_5":16479,"_31422":138468,"_3630":138628},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_4190":84162,"_34937":84113,"_23830":138630,"_5":16479,"_31422":138468,"_3630":138631},[],"Carga por separado las políticas concedidas a cada principal.",{"_4190":84163,"_34937":84113,"_23830":138633,"_5":16479,"_31422":138468,"_3630":138634},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_4190":84164,"_34937":84113,"_23830":138636,"_5":16479,"_31422":138468,"_3630":138637},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_4190":84165,"_34937":84113,"_23830":138639,"_5":16479,"_31422":138468,"_3630":138640},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_4190":84166,"_34937":84113,"_23830":138642,"_5":16479,"_31422":138468,"_3630":138643},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_4190":84167,"_34937":84113,"_23830":138645,"_5":16479,"_31422":138468,"_3630":138646},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_4190":84168,"_34937":84113,"_23830":138648,"_5":16479,"_31422":138468,"_3630":138649},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_4190":84169,"_34937":84113,"_23830":138651,"_5":16479,"_31422":138472,"_3630":138652},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_4190":84170,"_34937":84113,"_23830":138654,"_5":16479,"_31422":138472,"_3630":138655},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_4190":84171,"_34937":84113,"_23830":138657,"_5":16479,"_31422":138472,"_3630":138658},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_4190":84172,"_34937":84113,"_23830":138660,"_5":16479,"_31422":138472,"_3630":138661},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_4190":84173,"_34937":84113,"_23830":138663,"_5":16479,"_31422":138472,"_3630":138664},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_4190":84174,"_34937":84113,"_23830":138666,"_5":16479,"_31422":138472,"_3630":138667},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_4190":84175,"_34937":84113,"_23830":138669,"_5":16479,"_31422":138472,"_3630":138670},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_4190":84176,"_34937":84113,"_23830":138672,"_5":16479,"_31422":138472,"_3630":138673},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_4190":84177,"_34937":84113,"_23830":138675,"_5":16479,"_31422":138476,"_3630":138676},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_4190":84178,"_34937":84113,"_23830":138678,"_5":16479,"_31422":138476,"_3630":138679},[],"La decisión se toma con el contexto de la operación de dominio:",{"_4190":84179,"_34937":84113,"_23830":138681,"_5":16479,"_31422":138476,"_3630":138682},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_4190":84180,"_34937":84113,"_23830":138684,"_5":16479,"_31422":138476,"_3630":138685},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_4190":84181,"_34937":84113,"_23830":138687,"_5":16479,"_31422":138476,"_3630":138688},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_4190":84182,"_34937":84113,"_23830":138690,"_5":16479,"_31422":138476,"_3630":138691},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_4190":84183,"_34937":84113,"_23830":138693,"_5":16479,"_31422":138476,"_3630":138694},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_4190":84184,"_34937":84113,"_23830":138696,"_5":16479,"_31422":138476,"_3630":138697},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_4190":84185,"_34937":84113,"_23830":138699,"_5":16479,"_31422":138476,"_3630":138700},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_4190":84186,"_34937":84113,"_23830":138702,"_5":16479,"_31422":138476,"_3630":138703},[],"Las acciones se dividen en dos grupos:",{"_4190":84187,"_34937":84113,"_23830":138705,"_5":16479,"_31422":138476,"_3630":138706},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_4190":84188,"_34937":84113,"_23830":138708,"_5":16479,"_31422":138476,"_3630":138709},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_4190":84189,"_34937":84113,"_23830":138711,"_5":16479,"_31422":138476,"_3630":138712},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_4190":84190,"_34937":84113,"_23830":138714,"_5":16479,"_31422":138480,"_3630":138715},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_4190":84191,"_34937":84113,"_23830":138717,"_5":16479,"_31422":138480,"_3630":138718},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_4190":84192,"_34937":84113,"_23830":138720,"_5":16479,"_31422":138480,"_3630":138721},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_4190":84193,"_34937":84113,"_23830":138723,"_5":16479,"_31422":138484,"_3630":138724},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_4190":84194,"_34937":84113,"_23830":138726,"_5":16479,"_31422":138484,"_3630":138727},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_4190":84195,"_34937":84113,"_23830":138729,"_5":16479,"_31422":138484,"_3630":138730},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_4190":84196,"_34937":84113,"_23830":138732,"_5":16479,"_31422":138484,"_3630":138733},[],"Los operadores implementados son:",{"_4190":84197,"_34937":84113,"_23830":138735,"_5":16479,"_31422":138484,"_3630":138736},[],"`equals`, para igualdad exacta;",{"_4190":84198,"_34937":84113,"_23830":138738,"_5":16479,"_31422":138484,"_3630":138739},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_4190":84199,"_34937":84113,"_23830":138741,"_5":16479,"_31422":138484,"_3630":138742},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_4190":84200,"_34937":84113,"_23830":138744,"_5":16479,"_31422":138484,"_3630":138745},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_4190":84201,"_34937":84113,"_23830":138747,"_5":16479,"_31422":138488,"_3630":138748},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_4190":84202,"_34937":84113,"_23830":138750,"_5":16479,"_31422":138488,"_3630":138751},[],"Los modos disponibles son:",{"_4190":84203,"_34937":84113,"_23830":138753,"_5":16479,"_31422":138488,"_3630":138754},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_4190":84204,"_34937":84113,"_23830":138756,"_5":16479,"_31422":138488,"_3630":138757},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_4190":84205,"_34937":84113,"_23830":138759,"_5":16479,"_31422":138488,"_3630":138760},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_4190":84206,"_34937":84113,"_23830":138762,"_5":16479,"_31422":138488,"_3630":138763},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_4190":84207,"_34937":84113,"_23830":138765,"_5":16479,"_31422":138488,"_3630":138766},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_4190":84208,"_34937":84113,"_23830":138768,"_5":16479,"_31422":138488,"_3630":138769},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_4190":84209,"_34937":84113,"_23830":138771,"_5":16479,"_31422":138492,"_3630":138772},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_4190":84210,"_34937":84113,"_23830":138774,"_5":16479,"_31422":138492,"_3630":138775},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_4190":84211,"_34937":84113,"_23830":138777,"_5":16479,"_31422":138492,"_3630":138778},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_4190":84212,"_34937":84113,"_23830":138780,"_5":16479,"_31422":138492,"_3630":138781},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_4190":84213,"_34937":84113,"_23830":138783,"_5":16479,"_31422":138500,"_3630":138784},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_4190":84214,"_34937":84113,"_23830":138786,"_5":16479,"_31422":138500,"_3630":138787},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_4190":84215,"_34937":84113,"_23830":138789,"_5":16479,"_31422":138504,"_3630":138790},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_4190":84216,"_34937":84113,"_23830":138792,"_5":16479,"_31422":138504,"_3630":138793},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_4190":84217,"_34937":84113,"_23830":138795,"_5":16479,"_31422":138508,"_3630":138796},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_4190":84218,"_34937":84113,"_23830":138798,"_5":16479,"_31422":138508,"_3630":138799},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_4190":84219,"_34937":84113,"_23830":138801,"_5":16479,"_31422":138508,"_3630":138802},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_4190":84220,"_34937":84113,"_23830":138804,"_5":16479,"_31422":138512,"_3630":138805},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_4190":84221,"_34937":84113,"_23830":138807,"_5":16479,"_31422":138512,"_3630":138808},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_4190":84222,"_34937":84113,"_23830":138810,"_5":16479,"_31422":138512,"_3630":138811},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_4190":84223,"_34937":84113,"_23830":138813,"_5":16479,"_31422":138512,"_3630":138814},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_4190":84224,"_34937":84113,"_23830":138816,"_5":16479,"_31422":138512,"_3630":138817},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_4190":84225,"_34937":84113,"_23830":138819,"_5":16479,"_31422":138512,"_3630":138820},[],"Ten en cuenta que:",{"_4190":84226,"_34937":84113,"_23830":138822,"_5":16479,"_31422":138512,"_3630":138823},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_4190":84227,"_34937":84113,"_23830":138825,"_5":16479,"_31422":138512,"_3630":138826},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_4190":84228,"_34937":84113,"_23830":138828,"_5":16479,"_31422":138512,"_3630":138829},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_4190":84229,"_34937":84113,"_23830":138831,"_5":16479,"_31422":138516,"_3630":138832},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_4190":84230,"_34937":84113,"_23830":138834,"_5":16479,"_31422":138516,"_3630":138835},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_4190":84231,"_34937":84113,"_23830":138837,"_5":16479,"_31422":138516,"_3630":138838},[],"acceso completo y de solo lectura a KMS;",{"_4190":84232,"_34937":84113,"_23830":138840,"_5":16479,"_31422":138516,"_3630":138841},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_4190":84233,"_34937":84113,"_23830":138843,"_5":16479,"_31422":138516,"_3630":138844},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_4190":84234,"_34937":84113,"_23830":138846,"_5":16479,"_31422":138516,"_3630":138847},[],"acceso a la interfaz;",{"_4190":84235,"_34937":84113,"_23830":138849,"_5":16479,"_31422":138516,"_3630":138850},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_4190":84236,"_34937":84113,"_23830":138852,"_5":16479,"_31422":138516,"_3630":138853},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_4190":84237,"_34937":84113,"_23830":138855,"_5":16479,"_31422":138516,"_3630":138856},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_4190":84238,"_34937":84113,"_23830":138858,"_5":16479,"_31422":138520,"_3630":138859},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_4190":84239,"_34937":84113,"_23830":138861,"_5":16479,"_31422":138520,"_3630":138862},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_4190":84240,"_34937":84113,"_23830":138864,"_5":16479,"_31422":138520,"_3630":138865},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_4190":84241,"_34937":84113,"_23830":138867,"_5":16479,"_31422":138523,"_3630":138868},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_4190":84242,"_34937":84113,"_23830":138870,"_5":16479,"_31422":138527,"_3630":138871},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_4190":84243,"_34937":84113,"_23830":138873,"_5":16479,"_31422":138527,"_3630":138874},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_4190":84244,"_34937":84113,"_23830":138876,"_5":16479,"_31422":138531,"_3630":138877},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_4190":84245,"_34937":84113,"_23830":138879,"_5":16479,"_31422":138535,"_3630":138880},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_4190":84246,"_34937":84113,"_23830":138882,"_5":16479,"_31422":138539,"_3630":138883},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_4190":84247,"_34937":84113,"_23830":138885,"_5":16479,"_31422":138543,"_3630":138886},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_4190":84248,"_34937":84113,"_23830":138888,"_5":16479,"_31422":138543,"_3630":138889},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_4190":84249,"_34937":84113,"_23830":138891,"_5":16479,"_31422":138547,"_3630":138892},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_4190":84250,"_34937":84113,"_23830":138894,"_5":16479,"_31422":138547,"_3630":138895},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_4190":84251,"_34937":84113,"_23830":138897,"_5":16479,"_31422":138547,"_3630":138898},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_4190":84252,"_34937":84113,"_23830":138900,"_5":16479,"_31422":138547,"_3630":138901},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_4190":84253,"_34937":84113,"_23830":138903,"_5":16479,"_31422":138547,"_3630":138904},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_4190":84254,"_34937":84113,"_23830":138906,"_5":16479,"_31422":138547,"_3630":138907},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_4190":84255,"_34937":84113,"_23830":138909,"_5":16479,"_31422":138547,"_3630":138910},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_4190":84256,"_34937":84113,"_23830":138912,"_5":16479,"_31422":138547,"_3630":138913},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_4190":84257,"_34937":84113,"_23830":138915,"_5":16479,"_31422":138551,"_3630":138916},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_4190":84258,"_34937":84113,"_23830":138918,"_5":16479,"_31422":138551,"_3630":138919},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_4190":84259,"_34937":84113,"_23830":138921,"_5":16479,"_31422":138551,"_3630":138922},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_4190":84260,"_34937":84113,"_23830":138924,"_5":16479,"_31422":138555,"_3630":138925},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_4190":84261,"_34937":84113,"_23830":138927,"_5":16479,"_31422":138555,"_3630":138928},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_4190":84262,"_34937":84113,"_23830":138930,"_5":16479,"_31422":138555,"_3630":138931},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_4190":84263,"_34937":84113,"_23830":138933,"_5":16479,"_31422":138555,"_3630":138934},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_4190":84264,"_34937":84113,"_23830":138936,"_5":16479,"_31422":138555,"_3630":138937},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_4190":84265,"_34937":84113,"_23830":138939,"_5":16479,"_31422":138555,"_3630":138940},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_4190":84266,"_34937":84113,"_23830":138942,"_5":16479,"_31422":138555,"_3630":138943},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_4190":84267,"_34937":84113,"_23830":138945,"_5":16479,"_31422":138555,"_3630":138946},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_4190":84268,"_34937":84113,"_23830":138948,"_5":16479,"_31422":138563,"_3630":138949},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_4190":84269,"_34937":84113,"_23830":138951,"_5":16479,"_31422":138567,"_3630":138952},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_4190":84270,"_34937":84113,"_23830":138954,"_5":16479,"_31422":138567,"_3630":138955},[],"que exista un principal activo del tipo correcto;",{"_4190":84271,"_34937":84113,"_23830":138957,"_5":16479,"_31422":138567,"_3630":138958},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_4190":84272,"_34937":84113,"_23830":138960,"_5":16479,"_31422":138567,"_3630":138961},[],"que todas las condiciones del principal se cumplan;",{"_4190":84273,"_34937":84113,"_23830":138963,"_5":16479,"_31422":138567,"_3630":138964},[],"que el principal tenga concedida la política esperada;",{"_4190":84274,"_34937":84113,"_23830":138966,"_5":16479,"_31422":138567,"_3630":138967},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_4190":84275,"_34937":84113,"_23830":138969,"_5":16479,"_31422":138567,"_3630":138970},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_4190":84276,"_34937":84113,"_23830":138972,"_5":16479,"_31422":138567,"_3630":138973},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_4190":84277,"_34937":84113,"_23830":138975,"_5":16479,"_31422":138571,"_3630":138976},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_4190":84278,"_34937":84113,"_23830":138978,"_5":16479,"_31422":138575,"_3630":138979},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_4190":84279,"_34937":84113,"_23830":138981,"_5":16479,"_31422":138579,"_3630":138982},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_4190":84280,"_34937":84113,"_23830":138984,"_5":16479,"_31422":138579,"_3630":138985},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_4190":84281,"_34937":84281,"_5":16871,"_3630":138987,"_35372":138988,"_23830":138989,"_31422":84281},"Alertas y suscripciones",[58062,138452,138453],[],{"_4190":84282,"_34937":84281,"_23830":138991,"_5":16479,"_31422":84281,"_3630":138992},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_4190":84283,"_34937":84281,"_5":35369,"_23830":138994,"_31422":138995,"_3630":138996},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_4190":84284,"_34937":84281,"_5":35369,"_23830":138998,"_31422":138999,"_3630":139000},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_4190":84285,"_34937":84281,"_5":35369,"_23830":139002,"_31422":139003,"_3630":139004},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_4190":84286,"_34937":84281,"_5":35369,"_23830":139006,"_31422":139007,"_3630":139008},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_4190":84287,"_34937":84281,"_5":35369,"_23830":139010,"_31422":139011,"_3630":139012},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_4190":84288,"_34937":84281,"_5":35369,"_23830":139014,"_31422":139015,"_3630":139016},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_4190":84289,"_34937":84281,"_5":35369,"_23830":139018,"_31422":139019,"_3630":139020},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_4190":84290,"_34937":84281,"_5":35369,"_23830":139022,"_31422":139023,"_3630":139024},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_4190":84291,"_34937":84281,"_5":35369,"_23830":139026,"_31422":139027,"_3630":139028},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_4190":84292,"_34937":84281,"_5":35369,"_23830":139030,"_31422":139031,"_3630":139032},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_4190":84293,"_34937":84281,"_5":35369,"_23830":139034,"_31422":139035,"_3630":139036},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_4190":84294,"_34937":84281,"_23830":139038,"_5":16479,"_31422":84281,"_3630":139039},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_4190":84295,"_34937":84281,"_23830":139041,"_5":16479,"_31422":138995,"_3630":139042},[],"Un servicio publica un evento de dominio.",{"_4190":84296,"_34937":84281,"_23830":139044,"_5":16479,"_31422":138995,"_3630":139045},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_4190":84297,"_34937":84281,"_23830":139047,"_5":16479,"_31422":138995,"_3630":139048},[],"El filtro de cada suscripción decide si debe notificarse.",{"_4190":84298,"_34937":84281,"_23830":139050,"_5":16479,"_31422":138995,"_3630":139051},[],"Lamassu entrega el evento al canal configurado.",{"_4190":84299,"_34937":84281,"_23830":139053,"_5":16479,"_31422":138995,"_3630":139054},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_4190":84300,"_34937":84281,"_23830":139056,"_5":16479,"_31422":138999,"_3630":139057},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_4190":84301,"_34937":84281,"_23830":139059,"_5":16479,"_31422":138999,"_3630":139060},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_4190":84302,"_34937":84281,"_23830":139062,"_5":16479,"_31422":138999,"_3630":139063},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_4190":84303,"_34937":84281,"_23830":139065,"_5":16479,"_31422":138999,"_3630":139066},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_4190":84304,"_34937":84281,"_23830":139068,"_5":16479,"_31422":138999,"_3630":139069},[],"`apikey_options` necesita `header` y `key`.",{"_4190":84305,"_34937":84281,"_23830":139071,"_5":16479,"_31422":138999,"_3630":139072},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_4190":84306,"_34937":84281,"_23830":139074,"_5":16479,"_31422":138999,"_3630":139075},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_4190":84307,"_34937":84281,"_23830":139077,"_5":16479,"_31422":138999,"_3630":139078},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_4190":84308,"_34937":84281,"_23830":139080,"_5":16479,"_31422":139007,"_3630":139081},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_4190":84309,"_34937":84281,"_23830":139083,"_5":16479,"_31422":139011,"_3630":139084},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_4190":84310,"_34937":84281,"_23830":139086,"_5":16479,"_31422":139015,"_3630":139087},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_4190":84311,"_34937":84281,"_23830":139089,"_5":16479,"_31422":139015,"_3630":139090},[],"**None** notifica todas las instancias del evento.",{"_4190":84312,"_34937":84281,"_23830":139092,"_5":16479,"_31422":139015,"_3630":139093},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_4190":84313,"_34937":84281,"_23830":139095,"_5":16479,"_31422":139015,"_3630":139096},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_4190":84314,"_34937":84281,"_23830":139098,"_5":16479,"_31422":139015,"_3630":139099},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_4190":84315,"_34937":84281,"_23830":139101,"_5":16479,"_31422":139015,"_3630":139102},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_4190":84316,"_34937":84281,"_23830":139104,"_5":16479,"_31422":139015,"_3630":139105},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_4190":84317,"_34937":84281,"_23830":139107,"_5":16479,"_31422":139019,"_3630":139108},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_4190":84318,"_34937":84281,"_23830":139110,"_5":16479,"_31422":139023,"_3630":139111},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_4190":84319,"_34937":84281,"_23830":139113,"_5":16479,"_31422":139023,"_3630":139114},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_4190":84320,"_34937":84281,"_23830":139116,"_5":16479,"_31422":139023,"_3630":139117},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_4190":84321,"_34937":84281,"_23830":139119,"_5":16479,"_31422":139023,"_3630":139120},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_4190":84322,"_34937":84281,"_23830":139122,"_5":16479,"_31422":139023,"_3630":139123},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_4190":84323,"_34937":84281,"_23830":139125,"_5":16479,"_31422":139023,"_3630":139126},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_4190":84324,"_34937":84281,"_23830":139128,"_5":16479,"_31422":139023,"_3630":139129},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_4190":84325,"_34937":84281,"_23830":139131,"_5":16479,"_31422":139023,"_3630":139132},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_4190":84326,"_34937":84281,"_23830":139134,"_5":16479,"_31422":139027,"_3630":139135},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_4190":84327,"_34937":84281,"_23830":139137,"_5":16479,"_31422":139027,"_3630":139138},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_4190":84328,"_34937":84281,"_23830":139140,"_5":16479,"_31422":139027,"_3630":139141},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_4190":84329,"_34937":84281,"_23830":139143,"_5":16479,"_31422":139027,"_3630":139144},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_4190":84330,"_34937":84281,"_23830":139146,"_5":16479,"_31422":139027,"_3630":139147},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_4190":84331,"_34937":84281,"_23830":139149,"_5":16479,"_31422":139027,"_3630":139150},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_4190":84332,"_34937":84281,"_23830":139152,"_5":16479,"_31422":139027,"_3630":139153},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_4190":84333,"_34937":84281,"_23830":139155,"_5":16479,"_31422":139027,"_3630":139156},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_4190":84334,"_34937":84281,"_23830":139158,"_5":16479,"_31422":139031,"_3630":139159},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_4190":84335,"_34937":84281,"_23830":139161,"_5":16479,"_31422":139031,"_3630":139162},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_4190":84336,"_34937":84281,"_23830":139164,"_5":16479,"_31422":139035,"_3630":139165},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_4190":84337,"_34937":84281,"_23830":139167,"_5":16479,"_31422":139035,"_3630":139168},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_4190":84338,"_34937":84281,"_23830":139170,"_5":16479,"_31422":139035,"_3630":139171},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_4190":84339,"_34937":84281,"_23830":139173,"_5":16479,"_31422":139035,"_3630":139174},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_4190":84340,"_34937":84281,"_23830":139176,"_5":16479,"_31422":139035,"_3630":139177},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_4190":84341,"_34937":84281,"_23830":139179,"_5":16479,"_31422":139035,"_3630":139180},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_4190":84342,"_34937":84281,"_23830":139182,"_5":16479,"_31422":139035,"_3630":139183},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_4190":84343,"_34937":84281,"_23830":139185,"_5":16479,"_31422":139035,"_3630":139186},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_4190":84344,"_34937":84281,"_23830":139188,"_5":16479,"_31422":139035,"_3630":139189},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_4190":84345,"_34937":84345,"_5":16871,"_3630":139191,"_35372":139192,"_23830":139193,"_31422":84345},"Registros de auditoría",[58062,138452,138453],[],{"_4190":84346,"_34937":84345,"_23830":139195,"_5":16479,"_31422":84345,"_3630":139196},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_4190":84347,"_34937":84345,"_5":35369,"_23830":139198,"_31422":139199,"_3630":139200},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_4190":84348,"_34937":84345,"_5":35369,"_23830":139202,"_31422":139203,"_3630":139204},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#cobertura","Cobertura",{"_4190":84349,"_34937":84345,"_5":35369,"_23830":139206,"_31422":139207,"_3630":139208},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_4190":84350,"_34937":84345,"_5":35369,"_23830":139210,"_31422":139211,"_3630":139212},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_4190":84351,"_34937":84345,"_5":35369,"_23830":139214,"_31422":139215,"_3630":139216},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_4190":84352,"_34937":84345,"_5":35369,"_23830":139218,"_31422":139219,"_3630":139220},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_4190":84353,"_34937":84345,"_5":35369,"_23830":139222,"_31422":139223,"_3630":139224},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_4190":84354,"_34937":84345,"_5":35369,"_23830":139226,"_31422":139227,"_3630":139228},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_4190":84355,"_34937":84345,"_5":35369,"_23830":139230,"_31422":139231,"_3630":139232},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_4190":84356,"_34937":84345,"_5":35369,"_23830":139234,"_31422":139235,"_3630":139236},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_4190":84357,"_34937":84345,"_5":35369,"_23830":139238,"_31422":139239,"_3630":139240},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_4190":84358,"_34937":84345,"_23830":139242,"_5":16479,"_31422":84345,"_3630":139243},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_4190":84359,"_34937":84345,"_23830":139245,"_5":16479,"_31422":139199,"_3630":139246},[],"El cuerpo de auditoría incluye:",{"_4190":84360,"_34937":84345,"_23830":139248,"_5":16479,"_31422":139199,"_3630":139249},[],"input: datos recibidos por la operación;",{"_4190":84361,"_34937":84345,"_23830":139251,"_5":16479,"_31422":139199,"_3630":139252},[],"has\\_error: indica si el servicio devolvió un error;",{"_4190":84362,"_34937":84345,"_23830":139254,"_5":16479,"_31422":139199,"_3630":139255},[],"output: resultado producido o mensaje de error;",{"_4190":84363,"_34937":84345,"_23830":139257,"_5":16479,"_31422":139199,"_3630":139258},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_4190":84364,"_34937":84345,"_23830":139260,"_5":16479,"_31422":139199,"_3630":139261},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_4190":84365,"_34937":84345,"_23830":139263,"_5":16479,"_31422":139199,"_3630":139264},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_4190":84366,"_34937":84345,"_23830":139266,"_5":16479,"_31422":139203,"_3630":139267},[],"El backend aplica auditoría a mutaciones de:",{"_4190":84367,"_34937":84345,"_23830":139269,"_5":16479,"_31422":139203,"_3630":139270},[],"autoridades, certificados y perfiles de emisión;",{"_4190":84368,"_34937":84345,"_23830":139272,"_5":16479,"_31422":139203,"_3630":139273},[],"claves y motores KMS;",{"_4190":84369,"_34937":84345,"_23830":139275,"_5":16479,"_31422":139203,"_3630":139276},[],"dispositivos e identidades;",{"_4190":84370,"_34937":84345,"_23830":139278,"_5":16479,"_31422":139203,"_3630":139279},[],"DMS y operaciones de enrolamiento;",{"_4190":84371,"_34937":84345,"_23830":139281,"_5":16479,"_31422":139203,"_3630":139282},[],"funciones de validación y CRL;",{"_4190":84372,"_34937":84345,"_23830":139284,"_5":16479,"_31422":139203,"_3630":139285},[],"principales, políticas y concesiones de autorización.",{"_4190":84373,"_34937":84345,"_23830":139287,"_5":16479,"_31422":139203,"_3630":139288},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_4190":84374,"_34937":84345,"_23830":139290,"_5":16479,"_31422":139207,"_3630":139291},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_4190":84375,"_34937":84345,"_23830":139293,"_5":16479,"_31422":139207,"_3630":139294},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_4190":84376,"_34937":84345,"_23830":139296,"_5":16479,"_31422":139207,"_3630":139297},[],"Diseña el consumidor para:",{"_4190":84377,"_34937":84345,"_23830":139299,"_5":16479,"_31422":139207,"_3630":139300},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_4190":84378,"_34937":84345,"_23830":139302,"_5":16479,"_31422":139207,"_3630":139303},[],"conservar el CloudEvent completo sin modificar;",{"_4190":84379,"_34937":84345,"_23830":139305,"_5":16479,"_31422":139207,"_3630":139306},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_4190":84380,"_34937":84345,"_23830":139308,"_5":16479,"_31422":139207,"_3630":139309},[],"cifrar en tránsito y en reposo;",{"_4190":84381,"_34937":84345,"_23830":139311,"_5":16479,"_31422":139207,"_3630":139312},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_4190":84382,"_34937":84345,"_23830":139314,"_5":16479,"_31422":139207,"_3630":139315},[],"aplicar una política explícita de retención y legal hold;",{"_4190":84383,"_34937":84345,"_23830":139317,"_5":16479,"_31422":139207,"_3630":139318},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_4190":84384,"_34937":84345,"_23830":139320,"_5":16479,"_31422":139211,"_3630":139321},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_4190":84385,"_34937":84345,"_23830":139323,"_5":16479,"_31422":139211,"_3630":139324},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_4190":84386,"_34937":84345,"_23830":139326,"_5":16479,"_31422":139219,"_3630":139327},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_4190":84387,"_34937":84345,"_23830":139329,"_5":16479,"_31422":139223,"_3630":139330},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_4190":84388,"_34937":84345,"_23830":139332,"_5":16479,"_31422":139227,"_3630":139333},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_4190":84389,"_34937":84345,"_23830":139335,"_5":16479,"_31422":139231,"_3630":139336},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_4190":84390,"_34937":84345,"_23830":139338,"_5":16479,"_31422":139235,"_3630":139339},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_4190":84391,"_34937":84345,"_23830":139341,"_5":16479,"_31422":139239,"_3630":139342},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_4190":84392,"_34937":84345,"_23830":139344,"_5":16479,"_31422":139239,"_3630":139345},[],"aparece un evento de auditoría correcto;",{"_4190":84393,"_34937":84345,"_23830":139347,"_5":16479,"_31422":139239,"_3630":139348},[],"el principal coincide con la identidad utilizada;",{"_4190":84394,"_34937":84345,"_23830":139350,"_5":16479,"_31422":139239,"_3630":139351},[],"el consumidor lo persiste una sola vez;",{"_4190":84395,"_34937":84345,"_23830":139353,"_5":16479,"_31422":139239,"_3630":139354},[],"puede recuperarse por recurso, actor y periodo;",{"_4190":84396,"_34937":84345,"_23830":139356,"_5":16479,"_31422":139239,"_3630":139357},[],"una interrupción del consumidor produce una alerta.",{"_4190":84397,"_34937":84345,"_23830":139359,"_5":16479,"_31422":139239,"_3630":139360},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_4190":84398,"_34937":84398,"_5":16871,"_3630":139362,"_35372":139363,"_23830":139364,"_31422":84398},"Arquitectura de la plataforma",[58062,138452],[],{"_4190":84399,"_34937":84398,"_23830":139366,"_5":16479,"_31422":84398,"_3630":139367},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_4190":84400,"_34937":84398,"_5":35369,"_23830":139369,"_31422":139370,"_3630":139371},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_4190":84401,"_34937":84398,"_5":35369,"_23830":139373,"_31422":139374,"_3630":139375},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_4190":84402,"_34937":84398,"_5":35369,"_23830":139377,"_31422":139378,"_3630":139379},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_4190":84403,"_34937":84398,"_5":35369,"_23830":139381,"_31422":139382,"_3630":139383},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_4190":84404,"_34937":84398,"_5":35369,"_23830":139385,"_31422":139386,"_3630":139387},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_4190":84405,"_34937":84398,"_23830":139389,"_5":16479,"_31422":84398,"_3630":139390},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_4190":84406,"_34937":84398,"_23830":139392,"_5":16479,"_31422":84398,"_3630":139393},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_4190":84407,"_34937":84398,"_23830":139395,"_5":16479,"_31422":139370,"_3630":139396},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_4190":84408,"_34937":84398,"_23830":139398,"_5":16479,"_31422":139374,"_3630":139399},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_4190":84409,"_34937":84398,"_23830":139401,"_5":16479,"_31422":139378,"_3630":139402},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_4190":84410,"_34937":84398,"_23830":139404,"_5":16479,"_31422":139382,"_3630":139405},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_4190":84411,"_34937":84398,"_23830":139407,"_5":16479,"_31422":139386,"_3630":139408},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_4190":84412,"_34937":84412,"_5":16871,"_3630":139410,"_35372":139411,"_23830":139412,"_31422":84412},"Cómo funciona Lamassu",[58062,138452],[],{"_4190":84413,"_34937":84412,"_23830":139414,"_5":16479,"_31422":84412,"_3630":139415},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_4190":84414,"_34937":84412,"_5":35369,"_23830":139417,"_31422":139418,"_3630":139419},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_4190":84415,"_34937":84412,"_5":35369,"_23830":139421,"_31422":139422,"_3630":139423},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_4190":84416,"_34937":84412,"_23830":139425,"_5":16479,"_31422":84412,"_3630":139426},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_4190":84417,"_34937":84412,"_23830":139428,"_5":16479,"_31422":139418,"_3630":139429},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_4190":84418,"_34937":84412,"_23830":139431,"_5":16479,"_31422":139418,"_3630":139432},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_4190":84419,"_34937":84412,"_23830":139434,"_5":16479,"_31422":139418,"_3630":139435},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_4190":84420,"_34937":84412,"_23830":139437,"_5":16479,"_31422":139418,"_3630":139438},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_4190":84421,"_34937":84412,"_23830":139440,"_5":16479,"_31422":139418,"_3630":139441},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_4190":84422,"_34937":84412,"_23830":139443,"_5":16479,"_31422":139422,"_3630":139444},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_4190":84423,"_34937":84412,"_23830":139446,"_5":16479,"_31422":139422,"_3630":139447},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_4190":84424,"_34937":84412,"_23830":139449,"_5":16479,"_31422":139422,"_3630":139450},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_4190":84425,"_34937":84412,"_23830":139452,"_5":16479,"_31422":139422,"_3630":139453},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_4190":84426,"_34937":84412,"_23830":139455,"_5":16479,"_31422":139422,"_3630":139456},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_4190":84427,"_34937":84412,"_23830":139458,"_5":16479,"_31422":139422,"_3630":139459},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_4190":84428,"_34937":84412,"_23830":139461,"_5":16479,"_31422":139422,"_3630":139462},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_4190":84429,"_34937":84429,"_5":16871,"_3630":139464,"_35372":139465,"_23830":139466,"_31422":84429},"Dispositivos e identidades",[58062,138452,60551,139464],[],{"_4190":84430,"_34937":84429,"_23830":139468,"_5":16479,"_31422":84429,"_3630":139469},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_4190":84431,"_34937":84429,"_5":35369,"_23830":139471,"_31422":139472,"_3630":139473},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_4190":84432,"_34937":84429,"_5":35369,"_23830":139475,"_31422":139476,"_3630":139477},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_4190":84433,"_34937":84429,"_5":35369,"_23830":139479,"_31422":139480,"_3630":139481},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_4190":84434,"_34937":84429,"_5":35369,"_23830":139483,"_31422":139484,"_3630":139485},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_4190":84435,"_34937":84429,"_5":35369,"_23830":139487,"_31422":139488,"_3630":139489},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_4190":84436,"_34937":84429,"_5":35369,"_23830":139491,"_31422":139492,"_3630":139493},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_4190":84437,"_34937":84429,"_5":35369,"_23830":139495,"_31422":139496,"_3630":139497},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_4190":84438,"_34937":84429,"_5":35369,"_23830":139499,"_31422":139500,"_3630":139501},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_4190":84439,"_34937":84429,"_5":35369,"_23830":139503,"_31422":139504,"_3630":139505},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_4190":84440,"_34937":84429,"_5":35369,"_23830":139507,"_31422":139508,"_3630":139509},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_4190":84441,"_34937":84429,"_5":35369,"_23830":139511,"_31422":139512,"_3630":139513},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_4190":84442,"_34937":84429,"_23830":139515,"_5":16479,"_31422":84429,"_3630":139516},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_4190":84443,"_34937":84429,"_23830":139518,"_5":16479,"_31422":84429,"_3630":139519},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_4190":84444,"_34937":84429,"_23830":139521,"_5":16479,"_31422":139472,"_3630":139522},[],"Vista operativa",{"_4190":84445,"_34937":84429,"_23830":139524,"_5":16479,"_31422":139472,"_3630":139525},[],"Interpretación",{"_4190":84446,"_34937":84429,"_23830":139527,"_5":16479,"_31422":139472,"_3630":60614},[],{"_4190":84447,"_34937":84429,"_23830":139529,"_5":16479,"_31422":139472,"_3630":139530},[],"Hay registro, pero todavía no hay identidad asociada.",{"_4190":84448,"_34937":84429,"_23830":139532,"_5":16479,"_31422":139472,"_3630":60620},[],{"_4190":84449,"_34937":84429,"_23830":139534,"_5":16479,"_31422":139472,"_3630":139535},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_4190":84450,"_34937":84429,"_23830":139537,"_5":16479,"_31422":139472,"_3630":60626},[],{"_4190":84451,"_34937":84429,"_23830":139539,"_5":16479,"_31422":139472,"_3630":139540},[],"La identidad está en la ventana operativa de renovación.",{"_4190":84452,"_34937":84429,"_23830":139542,"_5":16479,"_31422":139472,"_3630":60632},[],{"_4190":84453,"_34937":84429,"_23830":139544,"_5":16479,"_31422":139472,"_3630":139545},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_4190":84454,"_34937":84429,"_23830":139547,"_5":16479,"_31422":139472,"_3630":60638},[],{"_4190":84455,"_34937":84429,"_23830":139549,"_5":16479,"_31422":139472,"_3630":139550},[],"La identidad ha vencido.",{"_4190":84456,"_34937":84429,"_23830":139552,"_5":16479,"_31422":139472,"_3630":60644},[],{"_4190":84457,"_34937":84429,"_23830":139554,"_5":16479,"_31422":139472,"_3630":139555},[],"La identidad está marcada como revocada.",{"_4190":84458,"_34937":84429,"_23830":139557,"_5":16479,"_31422":139472,"_3630":60650},[],{"_4190":84459,"_34937":84429,"_23830":139559,"_5":16479,"_31422":139472,"_3630":139560},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_4190":84460,"_34937":84429,"_23830":139562,"_5":16479,"_31422":139472,"_3630":139563},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_4190":84461,"_34937":84429,"_23830":139565,"_5":16479,"_31422":139476,"_3630":139566},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_4190":84462,"_34937":84429,"_23830":139568,"_5":16479,"_31422":139476,"_3630":139569},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_4190":84463,"_34937":84429,"_23830":139571,"_5":16479,"_31422":139476,"_3630":139572},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_4190":84464,"_34937":84429,"_23830":139574,"_5":16479,"_31422":139476,"_3630":139575},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_4190":84465,"_34937":84429,"_23830":139577,"_5":16479,"_31422":139480,"_3630":139578},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_4190":84466,"_34937":84429,"_23830":139580,"_5":16479,"_31422":139484,"_3630":139581},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_4190":84467,"_34937":84429,"_23830":139583,"_5":16479,"_31422":139488,"_3630":139584},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_4190":84468,"_34937":84429,"_23830":139586,"_5":16479,"_31422":139492,"_3630":139587},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_4190":84469,"_34937":84429,"_23830":139589,"_5":16479,"_31422":139496,"_3630":139590},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_4190":84470,"_34937":84429,"_23830":139592,"_5":16479,"_31422":139496,"_3630":139593},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_4190":84471,"_34937":84429,"_23830":139595,"_5":16479,"_31422":139500,"_3630":139596},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_4190":84472,"_34937":84429,"_23830":139598,"_5":16479,"_31422":139500,"_3630":139599},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_4190":84473,"_34937":84429,"_23830":139601,"_5":16479,"_31422":139500,"_3630":139602},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_4190":84474,"_34937":84429,"_23830":139604,"_5":16479,"_31422":139500,"_3630":139605},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_4190":84475,"_34937":84429,"_23830":139607,"_5":16479,"_31422":139500,"_3630":139608},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_4190":84476,"_34937":84429,"_23830":139610,"_5":16479,"_31422":139500,"_3630":139611},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_4190":84477,"_34937":84429,"_23830":139613,"_5":16479,"_31422":139504,"_3630":139614},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_4190":84478,"_34937":84429,"_23830":139616,"_5":16479,"_31422":139504,"_3630":139617},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_4190":84479,"_34937":84429,"_23830":139619,"_5":16479,"_31422":139508,"_3630":139620},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_4190":84480,"_34937":84429,"_23830":139622,"_5":16479,"_31422":139508,"_3630":139623},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_4190":84481,"_34937":84429,"_23830":139625,"_5":16479,"_31422":139508,"_3630":139626},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_4190":84482,"_34937":84429,"_23830":139628,"_5":16479,"_31422":139508,"_3630":139629},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_4190":84483,"_34937":84429,"_23830":139631,"_5":16479,"_31422":139512,"_3630":139632},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4190":84484,"_34937":84429,"_23830":139634,"_5":16479,"_31422":139512,"_3630":139635},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4190":84485,"_34937":84485,"_5":16871,"_3630":139637,"_35372":139638,"_23830":139640,"_31422":84485},"Identidad inicial y autenticación",[58062,138452,60551,139464,139639],"Enrolamiento con PKI",[],{"_4190":84486,"_34937":84485,"_23830":139642,"_5":16479,"_31422":84485,"_3630":139643},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_4190":84487,"_34937":84485,"_5":35369,"_23830":139645,"_31422":139646,"_3630":139647},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_4190":84488,"_34937":84485,"_5":35369,"_23830":139649,"_31422":139650,"_3630":139651},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_4190":84489,"_34937":84485,"_5":35369,"_23830":139653,"_31422":139654,"_3630":139655},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_4190":84490,"_34937":84485,"_5":35369,"_23830":139657,"_31422":139658,"_3630":139659},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_4190":84491,"_34937":84485,"_5":35369,"_23830":139661,"_31422":139662,"_3630":139663},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_4190":84492,"_34937":84485,"_23830":139665,"_5":16479,"_31422":84485,"_3630":139666},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_4190":84493,"_34937":84485,"_23830":139668,"_5":16479,"_31422":139646,"_3630":139669},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_4190":84494,"_34937":84485,"_23830":139671,"_5":16479,"_31422":139646,"_3630":139672},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_4190":84495,"_34937":84485,"_23830":139674,"_5":16479,"_31422":139650,"_3630":139675},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_4190":84496,"_34937":84485,"_23830":139677,"_5":16479,"_31422":139650,"_3630":139678},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_4190":84497,"_34937":84485,"_23830":139680,"_5":16479,"_31422":139650,"_3630":139681},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_4190":84498,"_34937":84485,"_23830":139683,"_5":16479,"_31422":139654,"_3630":139684},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_4190":84499,"_34937":84485,"_23830":139686,"_5":16479,"_31422":139654,"_3630":139687},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_4190":84500,"_34937":84485,"_23830":139689,"_5":16479,"_31422":139658,"_3630":139690},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_4190":84501,"_34937":84485,"_23830":139692,"_5":16479,"_31422":139658,"_3630":139693},[],"Ejemplo de cuerpo:",{"_4190":84502,"_34937":84485,"_23830":139695,"_5":16479,"_31422":139658,"_3630":139696},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_4190":84503,"_34937":84485,"_23830":139698,"_5":16479,"_31422":139658,"_3630":139699},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_4190":84504,"_34937":84485,"_23830":139701,"_5":16479,"_31422":139658,"_3630":139702},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_4190":84505,"_34937":84485,"_23830":139704,"_5":16479,"_31422":139658,"_3630":139705},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_4190":84506,"_34937":84485,"_23830":139707,"_5":16479,"_31422":139662,"_3630":139708},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_4190":84507,"_34937":84485,"_23830":139710,"_5":16479,"_31422":139662,"_3630":139711},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_4190":84508,"_34937":84508,"_5":16871,"_3630":139713,"_35372":139714,"_23830":139715,"_31422":84508},"Configura y opera el DMS",[58062,138452,60551,139464,139639],[],{"_4190":84509,"_34937":84508,"_23830":139717,"_5":16479,"_31422":84508,"_3630":139718},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_4190":84510,"_34937":84508,"_5":35369,"_23830":139720,"_31422":139721,"_3630":137023},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_4190":84511,"_34937":84508,"_5":35369,"_23830":139723,"_31422":139724,"_3630":139725},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_4190":84512,"_34937":84508,"_5":35369,"_23830":139727,"_31422":139728,"_3630":139729},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_4190":84513,"_34937":84508,"_5":35369,"_23830":139731,"_31422":139732,"_3630":139733},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_4190":84514,"_34937":84508,"_5":35369,"_23830":139735,"_31422":139736,"_3630":139737},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_4190":84515,"_34937":84508,"_5":35369,"_23830":139739,"_31422":139740,"_3630":139741},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_4190":84516,"_34937":84508,"_5":35369,"_23830":139743,"_31422":139744,"_3630":139745},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_4190":84517,"_34937":84508,"_5":35369,"_23830":139747,"_31422":139748,"_3630":139749},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_4190":84518,"_34937":84508,"_5":35369,"_23830":139751,"_31422":139752,"_3630":60846},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_4190":84519,"_34937":84508,"_5":35369,"_23830":139754,"_31422":139755,"_3630":60850},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_4190":84520,"_34937":84508,"_5":35369,"_23830":139757,"_31422":139758,"_3630":139759},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_4190":84521,"_34937":84508,"_5":35369,"_23830":139761,"_31422":139762,"_3630":139763},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_4190":84522,"_34937":84508,"_5":35369,"_23830":139765,"_31422":139766,"_3630":139767},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_4190":84523,"_34937":84508,"_5":35369,"_23830":139769,"_31422":139770,"_3630":139771},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_4190":84524,"_34937":84508,"_5":35369,"_23830":139773,"_31422":139774,"_3630":60870},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_4190":84525,"_34937":84508,"_5":35369,"_23830":139776,"_31422":139777,"_3630":139778},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_4190":84526,"_34937":84508,"_5":35369,"_23830":139780,"_31422":139781,"_3630":139782},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_4190":84527,"_34937":84508,"_5":35369,"_23830":139784,"_31422":139785,"_3630":139786},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_4190":84528,"_34937":84508,"_23830":139788,"_5":16479,"_31422":84508,"_3630":139789},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_4190":84529,"_34937":84508,"_23830":139791,"_5":16479,"_31422":139721,"_3630":139792},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_4190":84530,"_34937":84508,"_23830":139794,"_5":16479,"_31422":139721,"_3630":139795},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_4190":84531,"_34937":84508,"_23830":139797,"_5":16479,"_31422":139728,"_3630":139798},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_4190":84532,"_34937":84508,"_23830":139800,"_5":16479,"_31422":139732,"_3630":139801},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_4190":84533,"_34937":84508,"_23830":139803,"_5":16479,"_31422":139736,"_3630":139804},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_4190":84534,"_34937":84508,"_23830":139806,"_5":16479,"_31422":139740,"_3630":139807},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_4190":84535,"_34937":84508,"_23830":139809,"_5":16479,"_31422":139744,"_3630":139810},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_4190":84536,"_34937":84508,"_23830":139812,"_5":16479,"_31422":139752,"_3630":139813},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_4190":84537,"_34937":84508,"_23830":139815,"_5":16479,"_31422":139752,"_3630":139816},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_4190":84538,"_34937":84508,"_23830":139818,"_5":16479,"_31422":139755,"_3630":139819},[],"Campo de `settings.enrollment_settings`",{"_4190":84539,"_34937":84508,"_23830":139821,"_5":16479,"_31422":139755,"_3630":139822},[],"Decisión",{"_4190":84540,"_34937":84508,"_23830":139824,"_5":16479,"_31422":139755,"_3630":60921},[],{"_4190":84541,"_34937":84508,"_23830":139826,"_5":16479,"_31422":139755,"_3630":139827},[],"`EST_RFC7030` para estas operaciones.",{"_4190":84542,"_34937":84508,"_23830":139829,"_5":16479,"_31422":139755,"_3630":60927},[],{"_4190":84543,"_34937":84508,"_23830":139831,"_5":16479,"_31422":139755,"_3630":139832},[],"ID de la CA que firmará.",{"_4190":84544,"_34937":84508,"_23830":139834,"_5":16479,"_31422":139755,"_3630":60933},[],{"_4190":84545,"_34937":84508,"_23830":139836,"_5":16479,"_31422":139755,"_3630":139837},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_4190":84546,"_34937":84508,"_23830":139839,"_5":16479,"_31422":139755,"_3630":60939},[],{"_4190":84547,"_34937":84508,"_23830":139841,"_5":16479,"_31422":139755,"_3630":139842},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_4190":84548,"_34937":84508,"_23830":139844,"_5":16479,"_31422":139755,"_3630":60945},[],{"_4190":84549,"_34937":84508,"_23830":139846,"_5":16479,"_31422":139755,"_3630":139847},[],"Uno de los cuatro modos de autenticación.",{"_4190":84550,"_34937":84508,"_23830":139849,"_5":16479,"_31422":139755,"_3630":139850},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_4190":84551,"_34937":84508,"_23830":139852,"_5":16479,"_31422":139758,"_3630":139853},[],"Los bloques son independientes:",{"_4190":84552,"_34937":84508,"_23830":139855,"_5":16479,"_31422":139758,"_3630":139856},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_4190":84553,"_34937":84508,"_23830":139858,"_5":16479,"_31422":139758,"_3630":139859},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_4190":84554,"_34937":84508,"_23830":139861,"_5":16479,"_31422":139758,"_3630":60963},[],{"_4190":84555,"_34937":84508,"_23830":139863,"_5":16479,"_31422":139758,"_3630":139864},[],"Control aplicado en la operación configurada",{"_4190":84556,"_34937":84508,"_23830":139866,"_5":16479,"_31422":139758,"_3630":60969},[],{"_4190":84557,"_34937":84508,"_23830":139868,"_5":16479,"_31422":139758,"_3630":139869},[],"Validación del certificado presentado.",{"_4190":84558,"_34937":84508,"_23830":139871,"_5":16479,"_31422":139758,"_3630":60975},[],{"_4190":84559,"_34937":84508,"_23830":139873,"_5":16479,"_31422":139758,"_3630":139874},[],"Autorización del webhook configurado.",{"_4190":84560,"_34937":84508,"_23830":139876,"_5":16479,"_31422":139758,"_3630":60981},[],{"_4190":84561,"_34937":84508,"_23830":139878,"_5":16479,"_31422":139758,"_3630":139879},[],"Validación del certificado y, después, aprobación del webhook.",{"_4190":84562,"_34937":84508,"_23830":139881,"_5":16479,"_31422":139758,"_3630":60987},[],{"_4190":84563,"_34937":84508,"_23830":139883,"_5":16479,"_31422":139758,"_3630":139884},[],"Sin autenticación del solicitante por el DMS.",{"_4190":84564,"_34937":84508,"_23830":139886,"_5":16479,"_31422":139758,"_3630":139887},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_4190":84565,"_34937":84508,"_23830":139889,"_5":16479,"_31422":139758,"_3630":139890},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_4190":84566,"_34937":84508,"_23830":139892,"_5":16479,"_31422":139758,"_3630":139893},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_4190":84567,"_34937":84508,"_23830":139895,"_5":16479,"_31422":139758,"_3630":139896},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_4190":84568,"_34937":84508,"_23830":139898,"_5":16479,"_31422":139762,"_3630":139899},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_4190":84569,"_34937":84508,"_23830":139901,"_5":16479,"_31422":139762,"_3630":139902},[],"Campo de `external_webhook_settings`",{"_4190":84570,"_34937":84508,"_23830":139904,"_5":16479,"_31422":139762,"_3630":139822},[],{"_4190":84571,"_34937":84508,"_23830":139906,"_5":16479,"_31422":139762,"_3630":61013},[],{"_4190":84572,"_34937":84508,"_23830":139908,"_5":16479,"_31422":139762,"_3630":139909},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_4190":84573,"_34937":84508,"_23830":139911,"_5":16479,"_31422":139762,"_3630":61019},[],{"_4190":84574,"_34937":84508,"_23830":139913,"_5":16479,"_31422":139762,"_3630":139914},[],"`POST` o `PUT`; `POST` por defecto.",{"_4190":84575,"_34937":84508,"_23830":139916,"_5":16479,"_31422":139762,"_3630":61025},[],{"_4190":84576,"_34937":84508,"_23830":139918,"_5":16479,"_31422":139762,"_3630":139919},[],"Etiqueta usada en los logs del servicio.",{"_4190":84577,"_34937":84508,"_23830":139921,"_5":16479,"_31422":139762,"_3630":61031},[],{"_4190":84578,"_34937":84508,"_23830":139923,"_5":16479,"_31422":139762,"_3630":139924},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_4190":84579,"_34937":84508,"_23830":139926,"_5":16479,"_31422":139762,"_3630":61037},[],{"_4190":84580,"_34937":84508,"_23830":139928,"_5":16479,"_31422":139762,"_3630":139929},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_4190":84581,"_34937":84508,"_23830":139931,"_5":16479,"_31422":139762,"_3630":61043},[],{"_4190":84582,"_34937":84508,"_23830":139933,"_5":16479,"_31422":139762,"_3630":139934},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_4190":84583,"_34937":84508,"_23830":139936,"_5":16479,"_31422":139762,"_3630":61049},[],{"_4190":84584,"_34937":84508,"_23830":139938,"_5":16479,"_31422":139762,"_3630":139939},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_4190":84585,"_34937":84508,"_23830":139941,"_5":16479,"_31422":139762,"_3630":61055},[],{"_4190":84586,"_34937":84508,"_23830":139943,"_5":16479,"_31422":139762,"_3630":139944},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_4190":84587,"_34937":84508,"_23830":139946,"_5":16479,"_31422":139762,"_3630":61061},[],{"_4190":84588,"_34937":84508,"_23830":139948,"_5":16479,"_31422":139762,"_3630":139949},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_4190":84589,"_34937":84508,"_23830":139951,"_5":16479,"_31422":139762,"_3630":61067},[],{"_4190":84590,"_34937":84508,"_23830":139953,"_5":16479,"_31422":139762,"_3630":139954},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_4190":84591,"_34937":84508,"_23830":139956,"_5":16479,"_31422":139762,"_3630":139957},[],"Reglas de esa configuración:",{"_4190":84592,"_34937":84508,"_23830":139959,"_5":16479,"_31422":139762,"_3630":139960},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_4190":84593,"_34937":84508,"_23830":139962,"_5":16479,"_31422":139762,"_3630":139963},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_4190":84594,"_34937":84508,"_23830":139965,"_5":16479,"_31422":139762,"_3630":139966},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_4190":84595,"_34937":84508,"_23830":139968,"_5":16479,"_31422":139762,"_3630":139969},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_4190":84596,"_34937":84508,"_23830":139971,"_5":16479,"_31422":139762,"_3630":139972},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_4190":84597,"_34937":84508,"_23830":139974,"_5":16479,"_31422":139762,"_3630":139975},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_4190":84598,"_34937":84508,"_23830":139977,"_5":16479,"_31422":139762,"_3630":139978},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_4190":84599,"_34937":84508,"_23830":139980,"_5":16479,"_31422":139762,"_3630":139981},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_4190":84600,"_34937":84508,"_23830":139983,"_5":16479,"_31422":139762,"_3630":139984},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_4190":84601,"_34937":84508,"_23830":139986,"_5":16479,"_31422":139766,"_3630":139987},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_4190":84602,"_34937":84508,"_23830":139989,"_5":16479,"_31422":139770,"_3630":139990},[],"Campo de `settings.reenrollment_settings`",{"_4190":84603,"_34937":84508,"_23830":139992,"_5":16479,"_31422":139770,"_3630":139993},[],"Función",{"_4190":84604,"_34937":84508,"_23830":139995,"_5":16479,"_31422":139770,"_3630":61111},[],{"_4190":84605,"_34937":84508,"_23830":139997,"_5":16479,"_31422":139770,"_3630":139998},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_4190":84606,"_34937":84508,"_23830":140000,"_5":16479,"_31422":139770,"_3630":61117},[],{"_4190":84607,"_34937":84508,"_23830":140002,"_5":16479,"_31422":139770,"_3630":140003},[],"Umbral operativo preventivo de monitorización.",{"_4190":84608,"_34937":84508,"_23830":140005,"_5":16479,"_31422":139770,"_3630":61123},[],{"_4190":84609,"_34937":84508,"_23830":140007,"_5":16479,"_31422":139770,"_3630":140008},[],"Umbral operativo crítico de monitorización.",{"_4190":84610,"_34937":84508,"_23830":140010,"_5":16479,"_31422":139770,"_3630":61129},[],{"_4190":84611,"_34937":84508,"_23830":140012,"_5":16479,"_31422":139770,"_3630":140013},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_4190":84612,"_34937":84508,"_23830":140015,"_5":16479,"_31422":139770,"_3630":61135},[],{"_4190":84613,"_34937":84508,"_23830":140017,"_5":16479,"_31422":139770,"_3630":140018},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_4190":84614,"_34937":84508,"_23830":140020,"_5":16479,"_31422":139770,"_3630":61141},[],{"_4190":84615,"_34937":84508,"_23830":140022,"_5":16479,"_31422":139770,"_3630":140023},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_4190":84616,"_34937":84508,"_23830":140025,"_5":16479,"_31422":139770,"_3630":140026},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_4190":84617,"_34937":84508,"_23830":140028,"_5":16479,"_31422":139774,"_3630":140029},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_4190":84618,"_34937":84508,"_23830":140031,"_5":16479,"_31422":139777,"_3630":137387},[],{"_4190":84619,"_34937":84508,"_23830":140033,"_5":16479,"_31422":139777,"_3630":140034},[],"Qué publica",{"_4190":84620,"_34937":84508,"_23830":140036,"_5":16479,"_31422":139777,"_3630":61158},[],{"_4190":84621,"_34937":84508,"_23830":140038,"_5":16479,"_31422":139777,"_3630":140039},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_4190":84622,"_34937":84508,"_23830":140041,"_5":16479,"_31422":139777,"_3630":61164},[],{"_4190":84623,"_34937":84508,"_23830":140043,"_5":16479,"_31422":139777,"_3630":140044},[],"Certificado de la CA emisora seleccionada.",{"_4190":84624,"_34937":84508,"_23830":140046,"_5":16479,"_31422":139777,"_3630":61170},[],{"_4190":84625,"_34937":84508,"_23830":140048,"_5":16479,"_31422":139777,"_3630":140049},[],"Certificados de las CAs elegidas explícitamente.",{"_4190":84626,"_34937":84508,"_23830":140051,"_5":16479,"_31422":139777,"_3630":140052},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_4190":84627,"_34937":84508,"_23830":140054,"_5":16479,"_31422":139781,"_3630":140055},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_4190":84628,"_34937":84508,"_23830":140057,"_5":16479,"_31422":139781,"_3630":140058},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_4190":84629,"_34937":84508,"_23830":140060,"_5":16479,"_31422":139781,"_3630":140061},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_4190":84630,"_34937":84508,"_23830":140063,"_5":16479,"_31422":139785,"_3630":140064},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_4190":84631,"_34937":84631,"_5":16871,"_3630":140066,"_35372":140067,"_23830":140068,"_31422":84631},"Integra el cliente EST",[58062,138452,60551,139464,139639],[],{"_4190":84632,"_34937":84631,"_23830":140070,"_5":16479,"_31422":84631,"_3630":140071},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_4190":84633,"_34937":84631,"_5":35369,"_23830":140073,"_31422":140074,"_3630":137023},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_4190":84634,"_34937":84631,"_5":35369,"_23830":140076,"_31422":140077,"_3630":140078},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_4190":84635,"_34937":84631,"_5":35369,"_23830":140080,"_31422":140081,"_3630":140082},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_4190":84636,"_34937":84631,"_5":35369,"_23830":140084,"_31422":140085,"_3630":140086},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_4190":84637,"_34937":84631,"_5":35369,"_23830":140088,"_31422":140089,"_3630":140090},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_4190":84638,"_34937":84631,"_5":35369,"_23830":140092,"_31422":140093,"_3630":140094},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_4190":84639,"_34937":84631,"_23830":140096,"_5":16479,"_31422":84631,"_3630":140097},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_4190":84640,"_34937":84631,"_23830":140099,"_5":16479,"_31422":140074,"_3630":140100},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_4190":84641,"_34937":84631,"_23830":140102,"_5":16479,"_31422":140074,"_3630":140103},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_4190":84642,"_34937":84631,"_23830":140105,"_5":16479,"_31422":140074,"_3630":140106},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_4190":84643,"_34937":84631,"_23830":140108,"_5":16479,"_31422":140077,"_3630":140109},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_4190":84644,"_34937":84631,"_23830":140111,"_5":16479,"_31422":140077,"_3630":140112},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_4190":84645,"_34937":84631,"_23830":140114,"_5":16479,"_31422":140081,"_3630":140115},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_4190":84646,"_34937":84631,"_23830":140117,"_5":16479,"_31422":140081,"_3630":140118},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_4190":84647,"_34937":84631,"_23830":140120,"_5":16479,"_31422":140085,"_3630":140121},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_4190":84648,"_34937":84631,"_23830":140123,"_5":16479,"_31422":140085,"_3630":140124},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_4190":84649,"_34937":84631,"_23830":140126,"_5":16479,"_31422":140089,"_3630":140127},[],"Para el caso de una raíz que emite directamente:",{"_4190":84650,"_34937":84631,"_23830":140129,"_5":16479,"_31422":140089,"_3630":140130},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_4190":84651,"_34937":84631,"_23830":140132,"_5":16479,"_31422":140089,"_3630":140133},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_4190":84652,"_34937":84631,"_23830":140135,"_5":16479,"_31422":140093,"_3630":140136},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_4190":84653,"_34937":84653,"_5":16871,"_3630":140138,"_35372":140139,"_23830":140140,"_31422":84653},"Referencia EST",[58062,138452,60551,139464,139639],[],{"_4190":84654,"_34937":84653,"_23830":140142,"_5":16479,"_31422":84653,"_3630":140143},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_4190":84655,"_34937":84653,"_5":35369,"_23830":140145,"_31422":140146,"_3630":140147},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_4190":84656,"_34937":84653,"_5":35369,"_23830":140149,"_31422":140150,"_3630":25903},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_4190":84657,"_34937":84653,"_5":35369,"_23830":140152,"_31422":140153,"_3630":29715},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_4190":84658,"_34937":84653,"_5":35369,"_23830":140155,"_31422":140156,"_3630":29722},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_4190":84659,"_34937":84653,"_5":35369,"_23830":140158,"_31422":140159,"_3630":28944},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_4190":84660,"_34937":84653,"_5":35369,"_23830":140161,"_31422":140162,"_3630":140163},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_4190":84661,"_34937":84653,"_5":35369,"_23830":140165,"_31422":140166,"_3630":140167},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_4190":84662,"_34937":84653,"_5":35369,"_23830":140169,"_31422":140170,"_3630":140171},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_4190":84663,"_34937":84653,"_23830":140173,"_5":16479,"_31422":84653,"_3630":140174},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_4190":84664,"_34937":84653,"_23830":140176,"_5":16479,"_31422":140146,"_3630":140177},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_4190":84665,"_34937":84653,"_23830":140179,"_5":16479,"_31422":140146,"_3630":138212},[],{"_4190":84666,"_34937":84653,"_23830":140181,"_5":16479,"_31422":140146,"_3630":140182},[],"Método",{"_4190":84667,"_34937":84653,"_23830":140184,"_5":16479,"_31422":140146,"_3630":140185},[],"Autenticación y condición",{"_4190":84668,"_34937":84653,"_23830":140187,"_5":16479,"_31422":140146,"_3630":61313},[],{"_4190":84669,"_34937":84653,"_23830":140189,"_5":16479,"_31422":140146,"_3630":61316},[],{"_4190":84670,"_34937":84653,"_23830":140191,"_5":16479,"_31422":140146,"_3630":140192},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_4190":84671,"_34937":84653,"_23830":140194,"_5":16479,"_31422":140146,"_3630":61322},[],{"_4190":84672,"_34937":84653,"_23830":140196,"_5":16479,"_31422":140146,"_3630":61325},[],{"_4190":84673,"_34937":84653,"_23830":140198,"_5":16479,"_31422":140146,"_3630":140199},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_4190":84674,"_34937":84653,"_23830":140201,"_5":16479,"_31422":140146,"_3630":61331},[],{"_4190":84675,"_34937":84653,"_23830":140203,"_5":16479,"_31422":140146,"_3630":61325},[],{"_4190":84676,"_34937":84653,"_23830":140205,"_5":16479,"_31422":140146,"_3630":140206},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_4190":84677,"_34937":84653,"_23830":140208,"_5":16479,"_31422":140146,"_3630":61339},[],{"_4190":84678,"_34937":84653,"_23830":140210,"_5":16479,"_31422":140146,"_3630":61325},[],{"_4190":84679,"_34937":84653,"_23830":140212,"_5":16479,"_31422":140146,"_3630":140213},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_4190":84680,"_34937":84653,"_23830":140215,"_5":16479,"_31422":140146,"_3630":140216},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_4190":84681,"_34937":84653,"_23830":140218,"_5":16479,"_31422":140150,"_3630":140219},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_4190":84682,"_34937":84653,"_23830":140221,"_5":16479,"_31422":140150,"_3630":140222},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_4190":84683,"_34937":84653,"_23830":140224,"_5":16479,"_31422":140153,"_3630":140225},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_4190":84684,"_34937":84653,"_23830":140227,"_5":16479,"_31422":140153,"_3630":140228},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_4190":84685,"_34937":84653,"_23830":140230,"_5":16479,"_31422":140156,"_3630":140231},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_4190":84686,"_34937":84653,"_23830":140233,"_5":16479,"_31422":140156,"_3630":140234},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_4190":84687,"_34937":84653,"_23830":140236,"_5":16479,"_31422":140159,"_3630":140237},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_4190":84688,"_34937":84653,"_23830":140239,"_5":16479,"_31422":140159,"_3630":140240},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_4190":84689,"_34937":84653,"_23830":140242,"_5":16479,"_31422":140162,"_3630":140243},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_4190":84690,"_34937":84653,"_23830":140245,"_5":16479,"_31422":140162,"_3630":140246},[],"Parte",{"_4190":84691,"_34937":84653,"_23830":140248,"_5":16479,"_31422":140162,"_3630":140249},[],"Contenido tras decodificar su Base64",{"_4190":84692,"_34937":84653,"_23830":140251,"_5":16479,"_31422":140162,"_3630":61383},[],{"_4190":84693,"_34937":84653,"_23830":140253,"_5":16479,"_31422":140162,"_3630":140254},[],"Clave privada PKCS#8 DER sin cifrar.",{"_4190":84694,"_34937":84653,"_23830":140256,"_5":16479,"_31422":140162,"_3630":61389},[],{"_4190":84695,"_34937":84653,"_23830":140258,"_5":16479,"_31422":140162,"_3630":140259},[],"PKCS#7 DER con el certificado emitido.",{"_4190":84696,"_34937":84653,"_23830":140261,"_5":16479,"_31422":140162,"_3630":140262},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_4190":84697,"_34937":84653,"_23830":140264,"_5":16479,"_31422":140166,"_3630":140265},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_4190":84698,"_34937":84653,"_23830":140267,"_5":16479,"_31422":140166,"_3630":140268},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_4190":84699,"_34937":84653,"_23830":140270,"_5":16479,"_31422":140166,"_3630":140271},[],"Convierte y comprueba el resultado:",{"_4190":84700,"_34937":84653,"_23830":140273,"_5":16479,"_31422":140166,"_3630":140274},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_4190":84701,"_34937":84653,"_23830":140276,"_5":16479,"_31422":140170,"_3630":140277},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_4190":84702,"_34937":84653,"_23830":140279,"_5":16479,"_31422":140170,"_3630":140280},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_4190":84703,"_34937":84703,"_5":16871,"_3630":139639,"_35372":140282,"_23830":140283,"_31422":84703},[58062,138452,60551,139464,139639],[],{"_4190":84704,"_34937":84703,"_23830":140285,"_5":16479,"_31422":84703,"_3630":140286},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_4190":84705,"_34937":84703,"_5":35369,"_23830":140288,"_31422":140289,"_3630":140290},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_4190":84706,"_34937":84703,"_5":35369,"_23830":140292,"_31422":140293,"_3630":140294},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_4190":84707,"_34937":84703,"_5":35369,"_23830":140296,"_31422":140297,"_3630":140298},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_4190":84708,"_34937":84703,"_5":35369,"_23830":140300,"_31422":140301,"_3630":140302},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_4190":84709,"_34937":84703,"_23830":140304,"_5":16479,"_31422":84703,"_3630":140305},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_4190":84710,"_34937":84703,"_23830":140307,"_5":16479,"_31422":140289,"_3630":140308},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_4190":84711,"_34937":84703,"_23830":140310,"_5":16479,"_31422":140289,"_3630":140311},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_4190":84712,"_34937":84703,"_23830":140313,"_5":16479,"_31422":140289,"_3630":140314},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_4190":84713,"_34937":84703,"_23830":140316,"_5":16479,"_31422":140289,"_3630":140317},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_4190":84714,"_34937":84703,"_23830":140319,"_5":16479,"_31422":140289,"_3630":140320},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_4190":84715,"_34937":84703,"_23830":140322,"_5":16479,"_31422":140289,"_3630":140323},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_4190":84716,"_34937":84703,"_23830":140325,"_5":16479,"_31422":140293,"_3630":140326},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_4190":84717,"_34937":84703,"_23830":140328,"_5":16479,"_31422":140293,"_3630":140329},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4190":84718,"_34937":84703,"_23830":140331,"_5":16479,"_31422":140293,"_3630":140332},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_4190":84719,"_34937":84703,"_23830":140334,"_5":16479,"_31422":140293,"_3630":140335},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_4190":84720,"_34937":84703,"_23830":140337,"_5":16479,"_31422":140297,"_3630":140338},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4190":84721,"_34937":84703,"_23830":140340,"_5":16479,"_31422":140297,"_3630":140341},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4190":84722,"_34937":84703,"_23830":140343,"_5":16479,"_31422":140297,"_3630":140344},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_4190":84723,"_34937":84703,"_23830":140346,"_5":16479,"_31422":140297,"_3630":140347},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_4190":84724,"_34937":84703,"_23830":140349,"_5":16479,"_31422":140301,"_3630":140350},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_4190":84725,"_34937":84703,"_23830":140352,"_5":16479,"_31422":140301,"_3630":140353},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_4190":84726,"_34937":84726,"_5":16871,"_3630":140355,"_35372":140356,"_23830":140357,"_31422":84726},"Estrategias de aprovisionamiento",[58062,138452,60551,139464,139639],[],{"_4190":84727,"_34937":84726,"_23830":140359,"_5":16479,"_31422":84726,"_3630":140360},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_4190":84728,"_34937":84726,"_5":35369,"_23830":140362,"_31422":140363,"_3630":140364},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_4190":84729,"_34937":84726,"_5":35369,"_23830":140366,"_31422":140367,"_3630":140368},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_4190":84730,"_34937":84726,"_5":35369,"_23830":140370,"_31422":140371,"_3630":140372},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_4190":84731,"_34937":84726,"_5":35369,"_23830":140374,"_31422":140375,"_3630":140376},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_4190":84732,"_34937":84726,"_5":35369,"_23830":140378,"_31422":140379,"_3630":140380},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_4190":84733,"_34937":84726,"_23830":140382,"_5":16479,"_31422":84726,"_3630":140383},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_4190":84734,"_34937":84726,"_23830":140385,"_5":16479,"_31422":140363,"_3630":140386},[],"Recorrido",{"_4190":84735,"_34937":84726,"_23830":140388,"_5":16479,"_31422":140363,"_3630":140389},[],"Cuándo existe el dispositivo",{"_4190":84736,"_34937":84726,"_23830":140391,"_5":16479,"_31422":140363,"_3630":140392},[],"Qué compruebas",{"_4190":84737,"_34937":84726,"_23830":140394,"_5":16479,"_31422":140363,"_3630":140395},[],"Asignación manual",{"_4190":84738,"_34937":84726,"_23830":140397,"_5":16479,"_31422":140363,"_3630":140398},[],"El operador lo crea antes de asociar un certificado.",{"_4190":84739,"_34937":84726,"_23830":140400,"_5":16479,"_31422":140363,"_3630":140401},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_4190":84740,"_34937":84726,"_23830":140403,"_5":16479,"_31422":140363,"_3630":140404},[],"EST con `JITP`",{"_4190":84741,"_34937":84726,"_23830":140406,"_5":16479,"_31422":140363,"_3630":140407},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_4190":84742,"_34937":84726,"_23830":140409,"_5":16479,"_31422":140363,"_3630":140410},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_4190":84743,"_34937":84726,"_23830":140412,"_5":16479,"_31422":140363,"_3630":140413},[],"EST con `PRE_REGISTRATION`",{"_4190":84744,"_34937":84726,"_23830":140415,"_5":16479,"_31422":140363,"_3630":140416},[],"Debe existir antes de `/simpleenroll`.",{"_4190":84745,"_34937":84726,"_23830":140418,"_5":16479,"_31422":140363,"_3630":140419},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_4190":84746,"_34937":84726,"_23830":140421,"_5":16479,"_31422":140363,"_3630":140422},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_4190":84747,"_34937":84726,"_23830":140424,"_5":16479,"_31422":140363,"_3630":140425},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_4190":84748,"_34937":84726,"_23830":140427,"_5":16479,"_31422":140367,"_3630":140428},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_4190":84749,"_34937":84726,"_23830":140430,"_5":16479,"_31422":140367,"_3630":140431},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_4190":84750,"_34937":84726,"_23830":140433,"_5":16479,"_31422":140367,"_3630":140434},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_4190":84751,"_34937":84726,"_23830":140436,"_5":16479,"_31422":140371,"_3630":140437},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_4190":84752,"_34937":84726,"_23830":140439,"_5":16479,"_31422":140371,"_3630":140440},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_4190":84753,"_34937":84726,"_23830":140442,"_5":16479,"_31422":140371,"_3630":140443},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_4190":84754,"_34937":84726,"_23830":140445,"_5":16479,"_31422":140371,"_3630":140446},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_4190":84755,"_34937":84726,"_23830":140448,"_5":16479,"_31422":140371,"_3630":140449},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_4190":84756,"_34937":84726,"_23830":140451,"_5":16479,"_31422":140371,"_3630":140452},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_4190":84757,"_34937":84726,"_23830":140454,"_5":16479,"_31422":140375,"_3630":137387},[],{"_4190":84758,"_34937":84726,"_23830":140456,"_5":16479,"_31422":140375,"_3630":140457},[],"Material que atraviesa EST",{"_4190":84759,"_34937":84726,"_23830":140459,"_5":16479,"_31422":140375,"_3630":140460},[],"Clave generada por el dispositivo",{"_4190":84760,"_34937":84726,"_23830":140462,"_5":16479,"_31422":140375,"_3630":140463},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_4190":84761,"_34937":84726,"_23830":140465,"_5":16479,"_31422":140375,"_3630":140466},[],"Clave ya disponible en el dispositivo",{"_4190":84762,"_34937":84726,"_23830":140468,"_5":16479,"_31422":140375,"_3630":140469},[],"CSR firmada con la clave existente y certificado nuevo.",{"_4190":84763,"_34937":84726,"_23830":140471,"_5":16479,"_31422":140375,"_3630":60870},[],{"_4190":84764,"_34937":84726,"_23830":140473,"_5":16479,"_31422":140375,"_3630":140474},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_4190":84765,"_34937":84726,"_23830":140476,"_5":16479,"_31422":140375,"_3630":140477},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_4190":84766,"_34937":84726,"_23830":140479,"_5":16479,"_31422":140379,"_3630":140480},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_4190":84767,"_34937":84767,"_5":16871,"_3630":140482,"_35372":140483,"_23830":140484,"_31422":84767},"Renovación y recuperación",[58062,138452,60551,139464,139639],[],{"_4190":84768,"_34937":84767,"_23830":140486,"_5":16479,"_31422":84767,"_3630":140487},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_4190":84769,"_34937":84767,"_5":35369,"_23830":140489,"_31422":140490,"_3630":140491},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_4190":84770,"_34937":84767,"_5":35369,"_23830":140493,"_31422":140494,"_3630":140495},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_4190":84771,"_34937":84767,"_5":35369,"_23830":140497,"_31422":140498,"_3630":140499},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_4190":84772,"_34937":84767,"_5":35369,"_23830":140501,"_31422":140502,"_3630":140503},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_4190":84773,"_34937":84767,"_5":35369,"_23830":140505,"_31422":140506,"_3630":140507},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_4190":84774,"_34937":84767,"_23830":140509,"_5":16479,"_31422":84767,"_3630":140510},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_4190":84775,"_34937":84767,"_23830":140512,"_5":16479,"_31422":140490,"_3630":140513},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_4190":84776,"_34937":84767,"_23830":140515,"_5":16479,"_31422":140490,"_3630":140516},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_4190":84777,"_34937":84767,"_23830":140518,"_5":16479,"_31422":140490,"_3630":140519},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_4190":84778,"_34937":84767,"_23830":140521,"_5":16479,"_31422":140490,"_3630":140522},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_4190":84779,"_34937":84767,"_23830":140524,"_5":16479,"_31422":140494,"_3630":140525},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_4190":84780,"_34937":84767,"_23830":140527,"_5":16479,"_31422":140494,"_3630":140528},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_4190":84781,"_34937":84767,"_23830":140530,"_5":16479,"_31422":140498,"_3630":140531},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_4190":84782,"_34937":84767,"_23830":140533,"_5":16479,"_31422":140498,"_3630":140534},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_4190":84783,"_34937":84767,"_23830":140536,"_5":16479,"_31422":140498,"_3630":140537},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_4190":84784,"_34937":84767,"_23830":140539,"_5":16479,"_31422":140502,"_3630":140540},[],"Situación",{"_4190":84785,"_34937":84767,"_23830":140542,"_5":16479,"_31422":140502,"_3630":140543},[],"Procedimiento",{"_4190":84786,"_34937":84767,"_23830":140545,"_5":16479,"_31422":140502,"_3630":140546},[],"Certificado vigente, fuera de ventana",{"_4190":84787,"_34937":84767,"_23830":140548,"_5":16479,"_31422":140502,"_3630":140549},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_4190":84788,"_34937":84767,"_23830":140551,"_5":16479,"_31422":140502,"_3630":140552},[],"Certificado vencido, clave disponible",{"_4190":84789,"_34937":84767,"_23830":140554,"_5":16479,"_31422":140502,"_3630":140555},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_4190":84790,"_34937":84767,"_23830":140557,"_5":16479,"_31422":140502,"_3630":140558},[],"Renovación por webhook o `NO_AUTH`",{"_4190":84791,"_34937":84767,"_23830":140560,"_5":16479,"_31422":140502,"_3630":140561},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_4190":84792,"_34937":84767,"_23830":140563,"_5":16479,"_31422":140502,"_3630":140564},[],"Clave perdida o inaccesible",{"_4190":84793,"_34937":84767,"_23830":140566,"_5":16479,"_31422":140502,"_3630":140567},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_4190":84794,"_34937":84767,"_23830":140569,"_5":16479,"_31422":140502,"_3630":140570},[],"Identidad actual revocada",{"_4190":84795,"_34937":84767,"_23830":140572,"_5":16479,"_31422":140502,"_3630":140573},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_4190":84796,"_34937":84767,"_23830":140575,"_5":16479,"_31422":140502,"_3630":140576},[],"Dispositivo sin identidad",{"_4190":84797,"_34937":84767,"_23830":140578,"_5":16479,"_31422":140502,"_3630":140579},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_4190":84798,"_34937":84767,"_23830":140581,"_5":16479,"_31422":140502,"_3630":140582},[],"Dispositivo retirado",{"_4190":84799,"_34937":84767,"_23830":140584,"_5":16479,"_31422":140502,"_3630":140585},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_4190":84800,"_34937":84767,"_23830":140587,"_5":16479,"_31422":140502,"_3630":140588},[],"Timeout, HTTP 500 o fallo de instalación",{"_4190":84801,"_34937":84767,"_23830":140590,"_5":16479,"_31422":140502,"_3630":140591},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_4190":84802,"_34937":84767,"_23830":140593,"_5":16479,"_31422":140506,"_3630":140594},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_4190":84803,"_34937":84767,"_23830":140596,"_5":16479,"_31422":140506,"_3630":140597},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_4190":84804,"_34937":84804,"_5":16871,"_3630":140599,"_35372":140600,"_23830":140601,"_31422":84804},"Diagnóstico de enrolamiento",[58062,138452,60551,139464,139639],[],{"_4190":84805,"_34937":84804,"_23830":140603,"_5":16479,"_31422":84804,"_3630":140604},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_4190":84806,"_34937":84804,"_5":35369,"_23830":140606,"_31422":140607,"_3630":140608},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_4190":84807,"_34937":84804,"_5":35369,"_23830":140610,"_31422":140611,"_3630":140612},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_4190":84808,"_34937":84804,"_5":35369,"_23830":140614,"_31422":140615,"_3630":140171},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_4190":84809,"_34937":84804,"_5":35369,"_23830":140617,"_31422":140618,"_3630":140619},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_4190":84810,"_34937":84804,"_23830":140621,"_5":16479,"_31422":84804,"_3630":140622},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_4190":84811,"_34937":84804,"_23830":140624,"_5":16479,"_31422":140611,"_3630":140625},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_4190":84812,"_34937":84804,"_23830":140627,"_5":16479,"_31422":140611,"_3630":140628},[],"Síntoma o mensaje",{"_4190":84813,"_34937":84804,"_23830":140630,"_5":16479,"_31422":140611,"_3630":140631},[],"Qué revisar",{"_4190":84814,"_34937":84804,"_23830":140633,"_5":16479,"_31422":140611,"_3630":140634},[],"curl rechaza TLS, nombre o emisor",{"_4190":84815,"_34937":84804,"_23830":140636,"_5":16479,"_31422":140611,"_3630":140637},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_4190":84816,"_34937":84804,"_23830":140639,"_5":16479,"_31422":140611,"_3630":140640},[],"404 o APS ausente",{"_4190":84817,"_34937":84804,"_23830":140642,"_5":16479,"_31422":140611,"_3630":140643},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_4190":84818,"_34937":84804,"_23830":140645,"_5":16479,"_31422":140611,"_3630":140646},[],"400, error de CSR o formato",{"_4190":84819,"_34937":84804,"_23830":140648,"_5":16479,"_31422":140611,"_3630":140649},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_4190":84820,"_34937":84804,"_23830":140651,"_5":16479,"_31422":140611,"_3630":140652},[],"Credencial ausente o certificado no válido",{"_4190":84821,"_34937":84804,"_23830":140654,"_5":16479,"_31422":140611,"_3630":140655},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_4190":84822,"_34937":84804,"_23830":140657,"_5":16479,"_31422":140611,"_3630":140658},[],"Webhook deniega, expira o responde sin autorización",{"_4190":84823,"_34937":84804,"_23830":140660,"_5":16479,"_31422":140611,"_3630":140661},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_4190":84824,"_34937":84804,"_23830":140663,"_5":16479,"_31422":140611,"_3630":61796},[],{"_4190":84825,"_34937":84804,"_23830":140665,"_5":16479,"_31422":140611,"_3630":140666},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_4190":84826,"_34937":84804,"_23830":140668,"_5":16479,"_31422":140611,"_3630":61802},[],{"_4190":84827,"_34937":84804,"_23830":140670,"_5":16479,"_31422":140611,"_3630":140671},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_4190":84828,"_34937":84804,"_23830":140673,"_5":16479,"_31422":140611,"_3630":61808},[],{"_4190":84829,"_34937":84804,"_23830":140675,"_5":16479,"_31422":140611,"_3630":140676},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_4190":84830,"_34937":84804,"_23830":140678,"_5":16479,"_31422":140611,"_3630":61814},[],{"_4190":84831,"_34937":84804,"_23830":140680,"_5":16479,"_31422":140611,"_3630":140681},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_4190":84832,"_34937":84804,"_23830":140683,"_5":16479,"_31422":140611,"_3630":61820},[],{"_4190":84833,"_34937":84804,"_23830":140685,"_5":16479,"_31422":140611,"_3630":140686},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_4190":84834,"_34937":84804,"_23830":140688,"_5":16479,"_31422":140611,"_3630":140689},[],"400 `struct validation error` al crear o actualizar un DMS",{"_4190":84835,"_34937":84804,"_23830":140691,"_5":16479,"_31422":140611,"_3630":140692},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_4190":84836,"_34937":84804,"_23830":140694,"_5":16479,"_31422":140611,"_3630":140695},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_4190":84837,"_34937":84804,"_23830":140697,"_5":16479,"_31422":140611,"_3630":140698},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_4190":84838,"_34937":84804,"_23830":140700,"_5":16479,"_31422":140611,"_3630":61838},[],{"_4190":84839,"_34937":84804,"_23830":140702,"_5":16479,"_31422":140611,"_3630":140703},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_4190":84840,"_34937":84804,"_23830":140705,"_5":16479,"_31422":140611,"_3630":61844},[],{"_4190":84841,"_34937":84804,"_23830":140707,"_5":16479,"_31422":140611,"_3630":140708},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_4190":84842,"_34937":84804,"_23830":140710,"_5":16479,"_31422":140611,"_3630":140711},[],"DMS propietario distinto",{"_4190":84843,"_34937":84804,"_23830":140713,"_5":16479,"_31422":140611,"_3630":140714},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_4190":84844,"_34937":84804,"_23830":140716,"_5":16479,"_31422":140611,"_3630":61856},[],{"_4190":84845,"_34937":84804,"_23830":140718,"_5":16479,"_31422":140611,"_3630":140719},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_4190":84846,"_34937":84804,"_23830":140721,"_5":16479,"_31422":140611,"_3630":61862},[],{"_4190":84847,"_34937":84804,"_23830":140723,"_5":16479,"_31422":140611,"_3630":140724},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_4190":84848,"_34937":84804,"_23830":140726,"_5":16479,"_31422":140611,"_3630":140727},[],"Certificado actual revocado",{"_4190":84849,"_34937":84804,"_23830":140729,"_5":16479,"_31422":140611,"_3630":140730},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_4190":84850,"_34937":84804,"_23830":140732,"_5":16479,"_31422":140611,"_3630":140733},[],"Error de CA, perfil o firma",{"_4190":84851,"_34937":84804,"_23830":140735,"_5":16479,"_31422":140611,"_3630":140736},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_4190":84852,"_34937":84804,"_23830":140738,"_5":16479,"_31422":140611,"_3630":140739},[],"HTTP 200 sin conexión del dispositivo",{"_4190":84853,"_34937":84804,"_23830":140741,"_5":16479,"_31422":140611,"_3630":140742},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_4190":84854,"_34937":84804,"_23830":140744,"_5":16479,"_31422":140611,"_3630":140745},[],"Timeout o error después de emitir",{"_4190":84855,"_34937":84804,"_23830":140747,"_5":16479,"_31422":140611,"_3630":140748},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_4190":84856,"_34937":84804,"_23830":140750,"_5":16479,"_31422":140615,"_3630":140751},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_4190":84857,"_34937":84804,"_23830":140753,"_5":16479,"_31422":140615,"_3630":140754},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_4190":84858,"_34937":84804,"_23830":140756,"_5":16479,"_31422":140618,"_3630":140757},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_4190":84859,"_34937":84804,"_23830":140759,"_5":16479,"_31422":140618,"_3630":140760},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_4190":84860,"_34937":84804,"_23830":140762,"_5":16479,"_31422":140618,"_3630":140763},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_4190":84861,"_34937":84804,"_23830":140765,"_5":16479,"_31422":140618,"_3630":140766},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_4190":84862,"_34937":84804,"_23830":140768,"_5":16479,"_31422":140618,"_3630":140769},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_4190":84863,"_34937":84804,"_23830":140771,"_5":16479,"_31422":140618,"_3630":140772},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_4190":84864,"_34937":84804,"_23830":140774,"_5":16479,"_31422":140618,"_3630":140775},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_4190":84865,"_34937":84865,"_5":16871,"_3630":140777,"_35372":140778,"_23830":140779,"_31422":84865},"Distribución y actualización de confianza",[58062,138452,60551,139464,139639],[],{"_4190":84866,"_34937":84865,"_23830":140781,"_5":16479,"_31422":84865,"_3630":140782},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_4190":84867,"_34937":84865,"_5":35369,"_23830":140784,"_31422":140785,"_3630":140786},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_4190":84868,"_34937":84865,"_5":35369,"_23830":140788,"_31422":140789,"_3630":140790},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_4190":84869,"_34937":84865,"_5":35369,"_23830":140792,"_31422":140793,"_3630":140794},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_4190":84870,"_34937":84865,"_5":35369,"_23830":140796,"_31422":140797,"_3630":140798},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_4190":84871,"_34937":84865,"_5":35369,"_23830":140800,"_31422":140801,"_3630":140802},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_4190":84872,"_34937":84865,"_23830":140804,"_5":16479,"_31422":84865,"_3630":140805},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_4190":84873,"_34937":84865,"_23830":140807,"_5":16479,"_31422":140785,"_3630":140808},[],"Relación",{"_4190":84874,"_34937":84865,"_23830":140810,"_5":16479,"_31422":140785,"_3630":140811},[],"Material que prepara el responsable",{"_4190":84875,"_34937":84865,"_23830":140813,"_5":16479,"_31422":140785,"_3630":140814},[],"Dispositivo → servidor EST",{"_4190":84876,"_34937":84865,"_23830":140816,"_5":16479,"_31422":140785,"_3630":140817},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_4190":84877,"_34937":84865,"_23830":140819,"_5":16479,"_31422":140785,"_3630":140820},[],"DMS → solicitante",{"_4190":84878,"_34937":84865,"_23830":140822,"_5":16479,"_31422":140785,"_3630":140823},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_4190":84879,"_34937":84865,"_23830":140825,"_5":16479,"_31422":140785,"_3630":140826},[],"Consumidor → dispositivo",{"_4190":84880,"_34937":84865,"_23830":140828,"_5":16479,"_31422":140785,"_3630":140829},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_4190":84881,"_34937":84865,"_23830":140831,"_5":16479,"_31422":140785,"_3630":140832},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_4190":84882,"_34937":84865,"_23830":140834,"_5":16479,"_31422":140789,"_3630":140835},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_4190":84883,"_34937":84865,"_23830":140837,"_5":16479,"_31422":140789,"_3630":140838},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_4190":84884,"_34937":84865,"_23830":140840,"_5":16479,"_31422":140793,"_3630":140841},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_4190":84885,"_34937":84865,"_23830":140843,"_5":16479,"_31422":140793,"_3630":140844},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_4190":84886,"_34937":84865,"_23830":140846,"_5":16479,"_31422":140793,"_3630":140847},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_4190":84887,"_34937":84865,"_23830":140849,"_5":16479,"_31422":140793,"_3630":140850},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_4190":84888,"_34937":84865,"_23830":140852,"_5":16479,"_31422":140793,"_3630":140853},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_4190":84889,"_34937":84865,"_23830":140855,"_5":16479,"_31422":140793,"_3630":140856},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_4190":84890,"_34937":84865,"_23830":140858,"_5":16479,"_31422":140797,"_3630":140859},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_4190":84891,"_34937":84865,"_23830":140861,"_5":16479,"_31422":140797,"_3630":140862},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_4190":84892,"_34937":84865,"_23830":140864,"_5":16479,"_31422":140797,"_3630":140865},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_4190":84893,"_34937":84865,"_23830":140867,"_5":16479,"_31422":140801,"_3630":140868},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_4190":84894,"_34937":84894,"_5":16871,"_3630":62011,"_35372":140870,"_23830":140872,"_31422":84894},[58062,138452,60551,139464,140871],"Integraciones",[],{"_4190":84895,"_34937":84894,"_23830":140874,"_5":16479,"_31422":84894,"_3630":140875},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_4190":84896,"_34937":84894,"_5":35369,"_23830":140877,"_31422":140878,"_3630":140879},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_4190":84897,"_34937":84894,"_5":35369,"_23830":140881,"_31422":140882,"_3630":140883},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_4190":84898,"_34937":84894,"_5":35369,"_23830":140885,"_31422":140886,"_3630":140887},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_4190":84899,"_34937":84894,"_5":35369,"_23830":140889,"_31422":140890,"_3630":140891},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_4190":84900,"_34937":84894,"_5":35369,"_23830":140893,"_31422":140894,"_3630":140895},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_4190":84901,"_34937":84894,"_5":35369,"_23830":140897,"_31422":140898,"_3630":140899},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_4190":84902,"_34937":84894,"_5":35369,"_23830":140901,"_31422":140902,"_3630":140903},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_4190":84903,"_34937":84894,"_5":35369,"_23830":140905,"_31422":140906,"_3630":140907},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_4190":84904,"_34937":84894,"_5":35369,"_23830":140909,"_31422":140910,"_3630":62053},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_4190":84905,"_34937":84894,"_5":35369,"_23830":140912,"_31422":140913,"_3630":62057},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_4190":84906,"_34937":84894,"_5":35369,"_23830":140915,"_31422":140916,"_3630":140917},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_4190":84907,"_34937":84894,"_5":35369,"_23830":140919,"_31422":140920,"_3630":140921},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_4190":84908,"_34937":84894,"_5":35369,"_23830":140923,"_31422":140924,"_3630":140925},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_4190":84909,"_34937":84894,"_5":35369,"_23830":140927,"_31422":140928,"_3630":140929},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_4190":84910,"_34937":84894,"_5":35369,"_23830":140931,"_31422":140932,"_3630":140933},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_4190":84911,"_34937":84894,"_5":35369,"_23830":140935,"_31422":140936,"_3630":140937},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_4190":84912,"_34937":84894,"_5":35369,"_23830":140939,"_31422":140940,"_3630":140941},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_4190":84913,"_34937":84894,"_5":35369,"_23830":140943,"_31422":140944,"_3630":140945},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_4190":84914,"_34937":84894,"_5":35369,"_23830":140947,"_31422":140948,"_3630":140949},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_4190":84915,"_34937":84894,"_5":35369,"_23830":140951,"_31422":140952,"_3630":140953},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_4190":84916,"_34937":84894,"_5":35369,"_23830":140955,"_31422":140956,"_3630":140957},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_4190":84917,"_34937":84894,"_5":35369,"_23830":140959,"_31422":140960,"_3630":140961},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_4190":84918,"_34937":84894,"_5":35369,"_23830":140963,"_31422":140964,"_3630":140965},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_4190":84919,"_34937":84894,"_5":35369,"_23830":140967,"_31422":140968,"_3630":140969},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_4190":84920,"_34937":84894,"_5":35369,"_23830":140971,"_31422":140972,"_3630":140973},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_4190":84921,"_34937":84894,"_23830":140975,"_5":16479,"_31422":84894,"_3630":140976},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_4190":84922,"_34937":84894,"_23830":140978,"_5":16479,"_31422":84894,"_3630":140979},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_4190":84923,"_34937":84894,"_23830":140981,"_5":16479,"_31422":84894,"_3630":140982},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_4190":84924,"_34937":84894,"_23830":140984,"_5":16479,"_31422":140878,"_3630":140985},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_4190":84925,"_34937":84894,"_23830":140987,"_5":16479,"_31422":140878,"_3630":140988},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_4190":84926,"_34937":84894,"_23830":140990,"_5":16479,"_31422":140878,"_3630":140991},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_4190":84927,"_34937":84894,"_23830":140993,"_5":16479,"_31422":140878,"_3630":140994},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_4190":84928,"_34937":84894,"_23830":140996,"_5":16479,"_31422":140882,"_3630":140997},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_4190":84929,"_34937":84894,"_23830":140999,"_5":16479,"_31422":140886,"_3630":141000},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_4190":84930,"_34937":84894,"_23830":141002,"_5":16479,"_31422":140886,"_3630":141003},[],"Acción IAM",{"_4190":84931,"_34937":84894,"_23830":141005,"_5":16479,"_31422":140886,"_3630":137393},[],{"_4190":84932,"_34937":84894,"_23830":141007,"_5":16479,"_31422":140886,"_3630":62152},[],{"_4190":84933,"_34937":84894,"_23830":141009,"_5":16479,"_31422":140886,"_3630":141010},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_4190":84934,"_34937":84894,"_23830":141012,"_5":16479,"_31422":140886,"_3630":62158},[],{"_4190":84935,"_34937":84894,"_23830":141014,"_5":16479,"_31422":140886,"_3630":141015},[],"Registrar la CA en AWS IoT",{"_4190":84936,"_34937":84894,"_23830":141017,"_5":16479,"_31422":140886,"_3630":62164},[],{"_4190":84937,"_34937":84894,"_23830":141019,"_5":16479,"_31422":140886,"_3630":141020},[],"Consultar el estado del registro de la CA",{"_4190":84938,"_34937":84894,"_23830":141022,"_5":16479,"_31422":140886,"_3630":62170},[],{"_4190":84939,"_34937":84894,"_23830":141024,"_5":16479,"_31422":140886,"_3630":141025},[],"Crear o actualizar Things en IoT Core",{"_4190":84940,"_34937":84894,"_23830":141027,"_5":16479,"_31422":140886,"_3630":62176},[],{"_4190":84941,"_34937":84894,"_23830":141029,"_5":16479,"_31422":140886,"_3630":141030},[],"Aprovisionar Things mediante plantilla",{"_4190":84942,"_34937":84894,"_23830":141032,"_5":16479,"_31422":140886,"_3630":62182},[],{"_4190":84943,"_34937":84894,"_23830":141034,"_5":16479,"_31422":140886,"_3630":141035},[],"Registrar certificados de dispositivo",{"_4190":84944,"_34937":84894,"_23830":141037,"_5":16479,"_31422":140886,"_3630":62188},[],{"_4190":84945,"_34937":84894,"_23830":141039,"_5":16479,"_31422":140886,"_3630":141040},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_4190":84946,"_34937":84894,"_23830":141042,"_5":16479,"_31422":140886,"_3630":62194},[],{"_4190":84947,"_34937":84894,"_23830":141044,"_5":16479,"_31422":140886,"_3630":141045},[],"Crear y adjuntar políticas IoT",{"_4190":84948,"_34937":84894,"_23830":141047,"_5":16479,"_31422":140886,"_3630":62200},[],{"_4190":84949,"_34937":84894,"_23830":141049,"_5":16479,"_31422":140886,"_3630":141050},[],"Gestionar grupos de Things",{"_4190":84950,"_34937":84894,"_23830":141052,"_5":16479,"_31422":140886,"_3630":62206},[],{"_4190":84951,"_34937":84894,"_23830":141054,"_5":16479,"_31422":140886,"_3630":141055},[],"Crear plantillas JITP",{"_4190":84952,"_34937":84894,"_23830":141057,"_5":16479,"_31422":140886,"_3630":62212},[],{"_4190":84953,"_34937":84894,"_23830":141059,"_5":16479,"_31422":140886,"_3630":141060},[],"Leer y escribir el Device Shadow",{"_4190":84954,"_34937":84894,"_23830":141062,"_5":16479,"_31422":140886,"_3630":141063},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_4190":84955,"_34937":84894,"_23830":141065,"_5":16479,"_31422":140890,"_3630":141066},[],"Parámetro",{"_4190":84956,"_34937":84894,"_23830":141068,"_5":16479,"_31422":140890,"_3630":141069},[],"Tipo",{"_4190":84957,"_34937":84894,"_23830":141071,"_5":16479,"_31422":140890,"_3630":141072},[],"Requerido",{"_4190":84958,"_34937":84894,"_23830":141074,"_5":16479,"_31422":140890,"_3630":141075},[],"Descripción",{"_4190":84959,"_34937":84894,"_23830":141077,"_5":16479,"_31422":140890,"_3630":62233},[],{"_4190":84960,"_34937":84894,"_23830":141079,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":84961,"_34937":84894,"_23830":141081,"_5":16479,"_31422":140890,"_3630":141082},[],"Sí",{"_4190":84962,"_34937":84894,"_23830":141084,"_5":16479,"_31422":140890,"_3630":141085},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_4190":84963,"_34937":84894,"_23830":141087,"_5":16479,"_31422":140890,"_3630":62244},[],{"_4190":84964,"_34937":84894,"_23830":141089,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":84965,"_34937":84894,"_23830":141091,"_5":16479,"_31422":140890,"_3630":141082},[],{"_4190":84966,"_34937":84894,"_23830":141093,"_5":16479,"_31422":140890,"_3630":141094},[],"Región AWS donde opera el conector.",{"_4190":84967,"_34937":84894,"_23830":141096,"_5":16479,"_31422":140890,"_3630":62254},[],{"_4190":84968,"_34937":84894,"_23830":141098,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":84969,"_34937":84894,"_23830":141100,"_5":16479,"_31422":140890,"_3630":141082},[],{"_4190":84970,"_34937":84894,"_23830":141102,"_5":16479,"_31422":140890,"_3630":141103},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_4190":84971,"_34937":84894,"_23830":141105,"_5":16479,"_31422":140890,"_3630":62264},[],{"_4190":84972,"_34937":84894,"_23830":141107,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":84973,"_34937":84894,"_23830":141109,"_5":16479,"_31422":140890,"_3630":141110},[],"Solo con `auth_method=static`",{"_4190":84974,"_34937":84894,"_23830":141112,"_5":16479,"_31422":140890,"_3630":141113},[],"Clave de acceso AWS.",{"_4190":84975,"_34937":84894,"_23830":141115,"_5":16479,"_31422":140890,"_3630":62275},[],{"_4190":84976,"_34937":84894,"_23830":141117,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":84977,"_34937":84894,"_23830":141119,"_5":16479,"_31422":140890,"_3630":141110},[],{"_4190":84978,"_34937":84894,"_23830":141121,"_5":16479,"_31422":140890,"_3630":141122},[],"Clave secreta AWS.",{"_4190":84979,"_34937":84894,"_23830":141124,"_5":16479,"_31422":140890,"_3630":62285},[],{"_4190":84980,"_34937":84894,"_23830":141126,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":84981,"_34937":84894,"_23830":141128,"_5":16479,"_31422":140890,"_3630":62290},[],{"_4190":84982,"_34937":84894,"_23830":141130,"_5":16479,"_31422":140890,"_3630":141131},[],"Token de sesión (con `auth_method=static`).",{"_4190":84983,"_34937":84894,"_23830":141133,"_5":16479,"_31422":140890,"_3630":62296},[],{"_4190":84984,"_34937":84894,"_23830":141135,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":84985,"_34937":84894,"_23830":141137,"_5":16479,"_31422":140890,"_3630":141138},[],"Solo con `auth_method=role`",{"_4190":84986,"_34937":84894,"_23830":141140,"_5":16479,"_31422":140890,"_3630":141141},[],"ARN del rol a asumir.",{"_4190":84987,"_34937":84894,"_23830":141143,"_5":16479,"_31422":140890,"_3630":62307},[],{"_4190":84988,"_34937":84894,"_23830":141145,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":84989,"_34937":84894,"_23830":141147,"_5":16479,"_31422":140890,"_3630":62290},[],{"_4190":84990,"_34937":84894,"_23830":141149,"_5":16479,"_31422":140890,"_3630":141150},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_4190":84991,"_34937":84894,"_23830":141152,"_5":16479,"_31422":140890,"_3630":62317},[],{"_4190":84992,"_34937":84894,"_23830":141154,"_5":16479,"_31422":140890,"_3630":105513},[],{"_4190":84993,"_34937":84894,"_23830":141156,"_5":16479,"_31422":140890,"_3630":141082},[],{"_4190":84994,"_34937":84894,"_23830":141158,"_5":16479,"_31422":140890,"_3630":141159},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_4190":84995,"_34937":84894,"_23830":141161,"_5":16479,"_31422":140890,"_3630":62327},[],{"_4190":84996,"_34937":84894,"_23830":141163,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":84997,"_34937":84894,"_23830":141165,"_5":16479,"_31422":140890,"_3630":141082},[],{"_4190":84998,"_34937":84894,"_23830":141167,"_5":16479,"_31422":140890,"_3630":141168},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_4190":84999,"_34937":84894,"_23830":141170,"_5":16479,"_31422":140890,"_3630":62337},[],{"_4190":85000,"_34937":84894,"_23830":141172,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":85001,"_34937":84894,"_23830":141174,"_5":16479,"_31422":140890,"_3630":141082},[],{"_4190":85002,"_34937":84894,"_23830":141176,"_5":16479,"_31422":140890,"_3630":141177},[],"URL HTTP del Device Manager de Lamassu.",{"_4190":85003,"_34937":84894,"_23830":141179,"_5":16479,"_31422":140890,"_3630":62347},[],{"_4190":85004,"_34937":84894,"_23830":141181,"_5":16479,"_31422":140890,"_3630":28524},[],{"_4190":85005,"_34937":84894,"_23830":141183,"_5":16479,"_31422":140890,"_3630":141082},[],{"_4190":85006,"_34937":84894,"_23830":141185,"_5":16479,"_31422":140890,"_3630":141186},[],"URL HTTP del servicio de CA de Lamassu.",{"_4190":85007,"_34937":84894,"_23830":141188,"_5":16479,"_31422":140894,"_3630":141189},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_4190":85008,"_34937":84894,"_23830":141191,"_5":16479,"_31422":140894,"_3630":141192},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_4190":85009,"_34937":84894,"_23830":141194,"_5":16479,"_31422":140894,"_3630":141195},[],"Tipo de CloudEvent",{"_4190":85010,"_34937":84894,"_23830":141197,"_5":16479,"_31422":140894,"_3630":141198},[],"Recurso en Lamassu",{"_4190":85011,"_34937":84894,"_23830":141200,"_5":16479,"_31422":140894,"_3630":141201},[],"Recurso AWS",{"_4190":85012,"_34937":84894,"_23830":141203,"_5":16479,"_31422":140894,"_3630":141204},[],"Acciones IAM",{"_4190":85013,"_34937":84894,"_23830":141206,"_5":16479,"_31422":140894,"_3630":141207},[],"Llamadas AWS y efecto",{"_4190":85014,"_34937":84894,"_23830":141209,"_5":16479,"_31422":140894,"_3630":141210},[],"Dónde en esta página",{"_4190":85015,"_34937":84894,"_23830":141212,"_5":16479,"_31422":140894,"_3630":62381},[],{"_4190":85016,"_34937":84894,"_23830":141214,"_5":16479,"_31422":140894,"_3630":62384},[],{"_4190":85017,"_34937":84894,"_23830":141216,"_5":16479,"_31422":140894,"_3630":62387},[],{"_4190":85018,"_34937":84894,"_23830":141218,"_5":16479,"_31422":140894,"_3630":62390},[],{"_4190":85019,"_34937":84894,"_23830":141220,"_5":16479,"_31422":140894,"_3630":141221},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_4190":85020,"_34937":84894,"_23830":141223,"_5":16479,"_31422":140894,"_3630":140907},[],{"_4190":85021,"_34937":84894,"_23830":141225,"_5":16479,"_31422":140894,"_3630":62398},[],{"_4190":85022,"_34937":84894,"_23830":141227,"_5":16479,"_31422":140894,"_3630":62401},[],{"_4190":85023,"_34937":84894,"_23830":141229,"_5":16479,"_31422":140894,"_3630":62404},[],{"_4190":85024,"_34937":84894,"_23830":141231,"_5":16479,"_31422":140894,"_3630":62407},[],{"_4190":85025,"_34937":84894,"_23830":141233,"_5":16479,"_31422":140894,"_3630":141234},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_4190":85026,"_34937":84894,"_23830":141236,"_5":16479,"_31422":140894,"_3630":140933},[],{"_4190":85027,"_34937":84894,"_23830":141238,"_5":16479,"_31422":140894,"_3630":62415},[],{"_4190":85028,"_34937":84894,"_23830":141240,"_5":16479,"_31422":140894,"_3630":141241},[],"Dispositivo",{"_4190":85029,"_34937":84894,"_23830":141243,"_5":16479,"_31422":140894,"_3630":62421},[],{"_4190":85030,"_34937":84894,"_23830":141245,"_5":16479,"_31422":140894,"_3630":62424},[],{"_4190":85031,"_34937":84894,"_23830":141247,"_5":16479,"_31422":140894,"_3630":141248},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_4190":85032,"_34937":84894,"_23830":141250,"_5":16479,"_31422":140894,"_3630":140941},[],{"_4190":85033,"_34937":84894,"_23830":141252,"_5":16479,"_31422":140894,"_3630":62432},[],{"_4190":85034,"_34937":84894,"_23830":141254,"_5":16479,"_31422":140894,"_3630":141255},[],"Certificado",{"_4190":85035,"_34937":84894,"_23830":141257,"_5":16479,"_31422":140894,"_3630":62438},[],{"_4190":85036,"_34937":84894,"_23830":141259,"_5":16479,"_31422":140894,"_3630":141260},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_4190":85037,"_34937":84894,"_23830":141262,"_5":16479,"_31422":140894,"_3630":141263},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_4190":85038,"_34937":84894,"_23830":141265,"_5":16479,"_31422":140894,"_3630":140953},[],{"_4190":85039,"_34937":84894,"_23830":141267,"_5":16479,"_31422":140894,"_3630":62449},[],{"_4190":85040,"_34937":84894,"_23830":141269,"_5":16479,"_31422":140894,"_3630":141270},[],"Certificado / Dispositivo",{"_4190":85041,"_34937":84894,"_23830":141272,"_5":16479,"_31422":140894,"_3630":62455},[],{"_4190":85042,"_34937":84894,"_23830":141274,"_5":16479,"_31422":140894,"_3630":58458},[],{"_4190":85043,"_34937":84894,"_23830":141276,"_5":16479,"_31422":140894,"_3630":141277},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_4190":85044,"_34937":84894,"_23830":141279,"_5":16479,"_31422":140894,"_3630":140961},[],{"_4190":85045,"_34937":84894,"_23830":141281,"_5":16479,"_31422":140898,"_3630":141282},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_4190":85046,"_34937":84894,"_23830":141284,"_5":16479,"_31422":140902,"_3630":141285},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_4190":85047,"_34937":84894,"_23830":141287,"_5":16479,"_31422":140902,"_3630":141288},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_4190":85048,"_34937":84894,"_23830":141290,"_5":16479,"_31422":140906,"_3630":141291},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_4190":85049,"_34937":84894,"_23830":141293,"_5":16479,"_31422":140906,"_3630":141294},[],"Transición",{"_4190":85050,"_34937":84894,"_23830":141296,"_5":16479,"_31422":140906,"_3630":141297},[],"Llamadas AWS",{"_4190":85051,"_34937":84894,"_23830":141299,"_5":16479,"_31422":140906,"_3630":141300},[],"`NoRegistrada` → `Solicitada`",{"_4190":85052,"_34937":84894,"_23830":141302,"_5":16479,"_31422":140906,"_3630":141303},[],"ninguna (solo escritura de metadatos)",{"_4190":85053,"_34937":84894,"_23830":141305,"_5":16479,"_31422":140906,"_3630":141306},[],"`Solicitada` → `Registrando`",{"_4190":85054,"_34937":84894,"_23830":141308,"_5":16479,"_31422":140906,"_3630":141309},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_4190":85055,"_34937":84894,"_23830":141311,"_5":16479,"_31422":140906,"_3630":141312},[],"`Registrando` → `Completada`",{"_4190":85056,"_34937":84894,"_23830":141314,"_5":16479,"_31422":140906,"_3630":141315},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_4190":85057,"_34937":84894,"_23830":141317,"_5":16479,"_31422":140906,"_3630":141318},[],"`Registrando` → `Fallida`",{"_4190":85058,"_34937":84894,"_23830":141320,"_5":16479,"_31422":140906,"_3630":141321},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_4190":85059,"_34937":84894,"_23830":141323,"_5":16479,"_31422":140906,"_3630":141324},[],"`Fallida` / `Completada` → `Solicitada`",{"_4190":85060,"_34937":84894,"_23830":141326,"_5":16479,"_31422":140906,"_3630":141327},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_4190":85061,"_34937":84894,"_23830":141329,"_5":16479,"_31422":140910,"_3630":141330},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_4190":85062,"_34937":84894,"_23830":141332,"_5":16479,"_31422":140910,"_3630":141333},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_4190":85063,"_34937":84894,"_23830":141335,"_5":16479,"_31422":140910,"_3630":141336},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_4190":85064,"_34937":84894,"_23830":141338,"_5":16479,"_31422":140910,"_3630":141339},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_4190":85065,"_34937":84894,"_23830":141341,"_5":16479,"_31422":140910,"_3630":141342},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_4190":85066,"_34937":84894,"_23830":141344,"_5":16479,"_31422":140910,"_3630":141345},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_4190":85067,"_34937":84894,"_23830":141347,"_5":16479,"_31422":140913,"_3630":141348},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_4190":85068,"_34937":84894,"_23830":141350,"_5":16479,"_31422":140916,"_3630":141351},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_4190":85069,"_34937":84894,"_23830":141353,"_5":16479,"_31422":140916,"_3630":141354},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_4190":85070,"_34937":84894,"_23830":141356,"_5":16479,"_31422":140920,"_3630":141357},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_4190":85071,"_34937":84894,"_23830":141359,"_5":16479,"_31422":140924,"_3630":141360},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_4190":85072,"_34937":84894,"_23830":141362,"_5":16479,"_31422":140924,"_3630":141363},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_4190":85073,"_34937":84894,"_23830":141365,"_5":16479,"_31422":140924,"_3630":141366},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_4190":85074,"_34937":84894,"_23830":141368,"_5":16479,"_31422":140924,"_3630":141369},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_4190":85075,"_34937":84894,"_23830":141371,"_5":16479,"_31422":140924,"_3630":141372},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_4190":85076,"_34937":84894,"_23830":141374,"_5":16479,"_31422":140924,"_3630":141375},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_4190":85077,"_34937":84894,"_23830":141377,"_5":16479,"_31422":140928,"_3630":141378},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_4190":85078,"_34937":84894,"_23830":141380,"_5":16479,"_31422":140928,"_3630":141381},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_4190":85079,"_34937":84894,"_23830":141383,"_5":16479,"_31422":140928,"_3630":141384},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_4190":85080,"_34937":84894,"_23830":141386,"_5":16479,"_31422":140928,"_3630":141387},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_4190":85081,"_34937":84894,"_23830":141389,"_5":16479,"_31422":140928,"_3630":141390},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_4190":85082,"_34937":84894,"_23830":141392,"_5":16479,"_31422":140932,"_3630":141393},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_4190":85083,"_34937":84894,"_23830":141395,"_5":16479,"_31422":140932,"_3630":141294},[],{"_4190":85084,"_34937":84894,"_23830":141397,"_5":16479,"_31422":140932,"_3630":141297},[],{"_4190":85085,"_34937":84894,"_23830":141399,"_5":16479,"_31422":140932,"_3630":141400},[],"`SinConfigurar` → `None` / `Auto`",{"_4190":85086,"_34937":84894,"_23830":141402,"_5":16479,"_31422":140932,"_3630":141403},[],"ninguna (solo configuración)",{"_4190":85087,"_34937":84894,"_23830":141405,"_5":16479,"_31422":140932,"_3630":62592},[],{"_4190":85088,"_34937":84894,"_23830":141407,"_5":16479,"_31422":140932,"_3630":141403},[],{"_4190":85089,"_34937":84894,"_23830":141409,"_5":16479,"_31422":140932,"_3630":141410},[],"Cualquiera → `Jitp`",{"_4190":85090,"_34937":84894,"_23830":141412,"_5":16479,"_31422":140932,"_3630":141413},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_4190":85091,"_34937":84894,"_23830":141415,"_5":16479,"_31422":140932,"_3630":62603},[],{"_4190":85092,"_34937":84894,"_23830":141417,"_5":16479,"_31422":140932,"_3630":141418},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_4190":85093,"_34937":84894,"_23830":141420,"_5":16479,"_31422":140936,"_3630":141421},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_4190":85094,"_34937":84894,"_23830":141423,"_5":16479,"_31422":140936,"_3630":141424},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_4190":85095,"_34937":84894,"_23830":141426,"_5":16479,"_31422":140936,"_3630":141427},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_4190":85096,"_34937":84894,"_23830":141429,"_5":16479,"_31422":140940,"_3630":141430},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_4190":85097,"_34937":84894,"_23830":141432,"_5":16479,"_31422":140940,"_3630":141294},[],{"_4190":85098,"_34937":84894,"_23830":141434,"_5":16479,"_31422":140940,"_3630":141297},[],{"_4190":85099,"_34937":84894,"_23830":141436,"_5":16479,"_31422":140940,"_3630":141437},[],"`Ausente` → `Aprovisionado`",{"_4190":85100,"_34937":84894,"_23830":141439,"_5":16479,"_31422":140940,"_3630":141440},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_4190":85101,"_34937":84894,"_23830":141442,"_5":16479,"_31422":140940,"_3630":141443},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_4190":85102,"_34937":84894,"_23830":141445,"_5":16479,"_31422":140940,"_3630":141446},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_4190":85103,"_34937":84894,"_23830":141448,"_5":16479,"_31422":140940,"_3630":141449},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_4190":85104,"_34937":84894,"_23830":141451,"_5":16479,"_31422":140944,"_3630":141452},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_4190":85105,"_34937":84894,"_23830":141454,"_5":16479,"_31422":140944,"_3630":141455},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_4190":85106,"_34937":84894,"_23830":141457,"_5":16479,"_31422":140944,"_3630":141458},[],"Para que el flujo JITP funcione correctamente:",{"_4190":85107,"_34937":84894,"_23830":141460,"_5":16479,"_31422":140944,"_3630":141461},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_4190":85108,"_34937":84894,"_23830":141463,"_5":16479,"_31422":140944,"_3630":141464},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_4190":85109,"_34937":84894,"_23830":141466,"_5":16479,"_31422":140944,"_3630":141467},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_4190":85110,"_34937":84894,"_23830":141469,"_5":16479,"_31422":140944,"_3630":141470},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_4190":85111,"_34937":84894,"_23830":141472,"_5":16479,"_31422":140948,"_3630":141473},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_4190":85112,"_34937":84894,"_23830":141475,"_5":16479,"_31422":140948,"_3630":141476},[],"Estado en Lamassu",{"_4190":85113,"_34937":84894,"_23830":141478,"_5":16479,"_31422":140948,"_3630":141479},[],"Razón de revocación",{"_4190":85114,"_34937":84894,"_23830":141481,"_5":16479,"_31422":140948,"_3630":141482},[],"Estado en AWS IoT Core",{"_4190":85115,"_34937":84894,"_23830":141484,"_5":16479,"_31422":140948,"_3630":62673},[],{"_4190":85116,"_34937":84894,"_23830":141486,"_5":16479,"_31422":140948,"_3630":141487},[],"Ninguna",{"_4190":85117,"_34937":84894,"_23830":141489,"_5":16479,"_31422":140948,"_3630":62679},[],{"_4190":85118,"_34937":84894,"_23830":141491,"_5":16479,"_31422":140948,"_3630":62682},[],{"_4190":85119,"_34937":84894,"_23830":141493,"_5":16479,"_31422":140948,"_3630":62685},[],{"_4190":85120,"_34937":84894,"_23830":141495,"_5":16479,"_31422":140948,"_3630":62688},[],{"_4190":85121,"_34937":84894,"_23830":141497,"_5":16479,"_31422":140948,"_3630":62682},[],{"_4190":85122,"_34937":84894,"_23830":141499,"_5":16479,"_31422":140948,"_3630":141500},[],"Cualquier otra razón",{"_4190":85123,"_34937":84894,"_23830":141502,"_5":16479,"_31422":140948,"_3630":62696},[],{"_4190":85124,"_34937":84894,"_23830":141504,"_5":16479,"_31422":140948,"_3630":141505},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_4190":85125,"_34937":84894,"_23830":141507,"_5":16479,"_31422":140952,"_3630":141508},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_4190":85126,"_34937":84894,"_23830":141510,"_5":16479,"_31422":140952,"_3630":141294},[],{"_4190":85127,"_34937":84894,"_23830":141512,"_5":16479,"_31422":140952,"_3630":141297},[],{"_4190":85128,"_34937":84894,"_23830":141514,"_5":16479,"_31422":140952,"_3630":141515},[],"`NoSincronizado` → `Active`",{"_4190":85129,"_34937":84894,"_23830":141517,"_5":16479,"_31422":140952,"_3630":62188},[],{"_4190":85130,"_34937":84894,"_23830":141519,"_5":16479,"_31422":140952,"_3630":62714},[],{"_4190":85131,"_34937":84894,"_23830":141521,"_5":16479,"_31422":140952,"_3630":141522},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_4190":85132,"_34937":84894,"_23830":141524,"_5":16479,"_31422":140952,"_3630":62720},[],{"_4190":85133,"_34937":84894,"_23830":141526,"_5":16479,"_31422":140952,"_3630":141522},[],{"_4190":85134,"_34937":84894,"_23830":141528,"_5":16479,"_31422":140952,"_3630":62725},[],{"_4190":85135,"_34937":84894,"_23830":141530,"_5":16479,"_31422":140952,"_3630":62188},[],{"_4190":85136,"_34937":84894,"_23830":141532,"_5":16479,"_31422":140952,"_3630":62730},[],{"_4190":85137,"_34937":84894,"_23830":141534,"_5":16479,"_31422":140952,"_3630":141535},[],"ninguna (estos estados no se sincronizan con AWS)",{"_4190":85138,"_34937":84894,"_23830":141537,"_5":16479,"_31422":140956,"_3630":141538},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_4190":85139,"_34937":84894,"_23830":141540,"_5":16479,"_31422":140956,"_3630":141541},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_4190":85140,"_34937":84894,"_23830":141543,"_5":16479,"_31422":140956,"_3630":141544},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_4190":85141,"_34937":84894,"_23830":141546,"_5":16479,"_31422":140960,"_3630":141547},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_4190":85142,"_34937":84894,"_23830":141549,"_5":16479,"_31422":140960,"_3630":141550},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_4190":85143,"_34937":84894,"_23830":141552,"_5":16479,"_31422":140964,"_3630":141553},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_4190":85144,"_34937":84894,"_23830":141555,"_5":16479,"_31422":140964,"_3630":141556},[],"Existen dos tipos de acciones:",{"_4190":85145,"_34937":84894,"_23830":141558,"_5":16479,"_31422":140964,"_3630":141559},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_4190":85146,"_34937":84894,"_23830":141561,"_5":16479,"_31422":140964,"_3630":141562},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_4190":85147,"_34937":84894,"_23830":141564,"_5":16479,"_31422":140964,"_3630":141565},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_4190":85148,"_34937":84894,"_23830":141567,"_5":16479,"_31422":140968,"_3630":141568},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_4190":85149,"_34937":84894,"_23830":141570,"_5":16479,"_31422":140968,"_3630":141571},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_4190":85150,"_34937":84894,"_23830":141573,"_5":16479,"_31422":140968,"_3630":141574},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_4190":85151,"_34937":84894,"_23830":141576,"_5":16479,"_31422":140972,"_3630":141577},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_4190":85152,"_34937":84894,"_23830":141579,"_5":16479,"_31422":140972,"_3630":141580},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_4190":85153,"_34937":84894,"_23830":141582,"_5":16479,"_31422":140972,"_3630":141583},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_4190":85154,"_34937":84894,"_23830":141585,"_5":16479,"_31422":140972,"_3630":141586},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_4190":85155,"_34937":84894,"_23830":141588,"_5":16479,"_31422":140972,"_3630":141589},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_4190":85156,"_34937":84894,"_23830":141591,"_5":16479,"_31422":140972,"_3630":141592},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_4190":85157,"_34937":84894,"_23830":141594,"_5":16479,"_31422":140972,"_3630":141595},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_4190":85158,"_34937":84894,"_23830":141597,"_5":16479,"_31422":140972,"_3630":141598},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_4190":85159,"_34937":84894,"_23830":141600,"_5":16479,"_31422":140972,"_3630":141601},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_4190":85160,"_34937":84894,"_23830":141603,"_5":16479,"_31422":140972,"_3630":141604},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_4190":85161,"_34937":84894,"_23830":141606,"_5":16479,"_31422":140972,"_3630":141607},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_4190":85162,"_34937":84894,"_23830":141609,"_5":16479,"_31422":140972,"_3630":141610},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_4190":85163,"_34937":84894,"_23830":141612,"_5":16479,"_31422":140972,"_3630":141613},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_4190":85164,"_34937":84894,"_23830":141615,"_5":16479,"_31422":140972,"_3630":141616},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_4190":85165,"_34937":84894,"_23830":141618,"_5":16479,"_31422":140972,"_3630":141619},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_4190":85166,"_34937":84894,"_23830":141621,"_5":16479,"_31422":140972,"_3630":141622},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_4190":85167,"_34937":84894,"_23830":141624,"_5":16479,"_31422":140972,"_3630":141625},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_4190":85168,"_34937":84894,"_23830":141627,"_5":16479,"_31422":140972,"_3630":141628},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_4190":85169,"_34937":84894,"_23830":141630,"_5":16479,"_31422":140972,"_3630":141631},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_4190":85170,"_34937":84894,"_23830":141633,"_5":16479,"_31422":140972,"_3630":141634},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_4190":85171,"_34937":84894,"_23830":141636,"_5":16479,"_31422":140972,"_3630":141637},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_4190":85172,"_34937":84894,"_23830":141639,"_5":16479,"_31422":140972,"_3630":141640},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4190":85173,"_34937":84894,"_23830":141642,"_5":16479,"_31422":140972,"_3630":141643},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_4190":85174,"_34937":84894,"_23830":141645,"_5":16479,"_31422":140972,"_3630":141646},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_4190":85175,"_34937":85175,"_5":16871,"_3630":60551,"_35372":141648,"_23830":141649,"_31422":85175},[58062,138452,60551],[],{"_4190":85176,"_34937":85175,"_23830":141651,"_5":16479,"_31422":85175,"_3630":141652},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_4190":85177,"_34937":85175,"_5":35369,"_23830":141654,"_31422":141655,"_3630":141656},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_4190":85178,"_34937":85175,"_5":35369,"_23830":141658,"_31422":141659,"_3630":139464},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_4190":85179,"_34937":85175,"_5":35369,"_23830":141661,"_31422":141662,"_3630":139639},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_4190":85180,"_34937":85175,"_5":35369,"_23830":141664,"_31422":141665,"_3630":140871},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#integraciones",{"_4190":85181,"_34937":85175,"_5":35369,"_23830":141667,"_31422":141668,"_3630":141669},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_4190":85182,"_34937":85175,"_23830":141671,"_5":16479,"_31422":85175,"_3630":141672},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_4190":85183,"_34937":85175,"_23830":141674,"_5":16479,"_31422":141655,"_3630":141675},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_4190":85184,"_34937":85175,"_23830":141677,"_5":16479,"_31422":141655,"_3630":141678},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_4190":85185,"_34937":85175,"_23830":141680,"_5":16479,"_31422":141659,"_3630":141681},[],"Recurso",{"_4190":85186,"_34937":85175,"_23830":141683,"_5":16479,"_31422":141659,"_3630":141684},[],"Qué representa",{"_4190":85187,"_34937":85175,"_23830":141686,"_5":16479,"_31422":141659,"_3630":141687},[],"**Dispositivo**",{"_4190":85188,"_34937":85175,"_23830":141689,"_5":16479,"_31422":141659,"_3630":141690},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_4190":85189,"_34937":85175,"_23830":141692,"_5":16479,"_31422":141659,"_3630":141693},[],"**Identidad**",{"_4190":85190,"_34937":85175,"_23830":141695,"_5":16479,"_31422":141659,"_3630":141696},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_4190":85191,"_34937":85175,"_23830":141698,"_5":16479,"_31422":141659,"_3630":62897},[],{"_4190":85192,"_34937":85175,"_23830":141700,"_5":16479,"_31422":141659,"_3630":141701},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_4190":85193,"_34937":85175,"_23830":141703,"_5":16479,"_31422":141659,"_3630":141704},[],"**Flota**",{"_4190":85194,"_34937":85175,"_23830":141706,"_5":16479,"_31422":141659,"_3630":141707},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_4190":85195,"_34937":85175,"_23830":141709,"_5":16479,"_31422":141659,"_3630":141710},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_4190":85196,"_34937":85175,"_23830":141712,"_5":16479,"_31422":141659,"_3630":141713},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_4190":85197,"_34937":85175,"_23830":141715,"_5":16479,"_31422":141662,"_3630":141716},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_4190":85198,"_34937":85175,"_23830":141718,"_5":16479,"_31422":141662,"_3630":141719},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_4190":85199,"_34937":85175,"_23830":141721,"_5":16479,"_31422":141662,"_3630":141722},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_4190":85200,"_34937":85175,"_23830":141724,"_5":16479,"_31422":141662,"_3630":141725},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_4190":85201,"_34937":85175,"_23830":141727,"_5":16479,"_31422":141662,"_3630":141728},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_4190":85202,"_34937":85175,"_23830":141730,"_5":16479,"_31422":141662,"_3630":141731},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_4190":85203,"_34937":85175,"_23830":141733,"_5":16479,"_31422":141662,"_3630":141734},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4190":85204,"_34937":85175,"_23830":141736,"_5":16479,"_31422":141662,"_3630":141737},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4190":85205,"_34937":85175,"_23830":141739,"_5":16479,"_31422":141665,"_3630":141740},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_4190":85206,"_34937":85175,"_23830":141742,"_5":16479,"_31422":141665,"_3630":141743},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_4190":85207,"_34937":85175,"_23830":141745,"_5":16479,"_31422":141668,"_3630":141746},[],"Participante",{"_4190":85208,"_34937":85175,"_23830":141748,"_5":16479,"_31422":141668,"_3630":141749},[],"Responsabilidad",{"_4190":85209,"_34937":85175,"_23830":141751,"_5":16479,"_31422":141668,"_3630":141752},[],"Administrador PKI",{"_4190":85210,"_34937":85175,"_23830":141754,"_5":16479,"_31422":141668,"_3630":141755},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_4190":85211,"_34937":85175,"_23830":141757,"_5":16479,"_31422":141668,"_3630":141758},[],"Administrador del aprovisionamiento",{"_4190":85212,"_34937":85175,"_23830":141760,"_5":16479,"_31422":141668,"_3630":141761},[],"DMS, admisión, autenticación por operación e inventario.",{"_4190":85213,"_34937":85175,"_23830":141763,"_5":16479,"_31422":141668,"_3630":141764},[],"Integrador del dispositivo",{"_4190":85214,"_34937":85175,"_23830":141766,"_5":16479,"_31422":141668,"_3630":141767},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_4190":85215,"_34937":85175,"_23830":141769,"_5":16479,"_31422":141668,"_3630":141770},[],"Integrador del consumidor",{"_4190":85216,"_34937":85175,"_23830":141772,"_5":16479,"_31422":141668,"_3630":141773},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_4190":85217,"_34937":85175,"_23830":141775,"_5":16479,"_31422":141668,"_3630":141776},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_4190":85218,"_34937":85218,"_5":16871,"_3630":141778,"_35372":141779,"_23830":141781,"_31422":85218},"Enrola y conecta tu primer dispositivo",[58062,138452,60551,141780],"Primeros pasos",[],{"_4190":85219,"_34937":85218,"_23830":141783,"_5":16479,"_31422":85218,"_3630":141784},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_4190":85220,"_34937":85218,"_5":35369,"_23830":141786,"_31422":141787,"_3630":137023},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_4190":85221,"_34937":85218,"_5":35369,"_23830":141789,"_31422":141790,"_3630":141791},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_4190":85222,"_34937":85218,"_5":35369,"_23830":141793,"_31422":141794,"_3630":141795},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_4190":85223,"_34937":85218,"_5":35369,"_23830":141797,"_31422":141798,"_3630":141799},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_4190":85224,"_34937":85218,"_5":35369,"_23830":141801,"_31422":141802,"_3630":141803},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_4190":85225,"_34937":85218,"_5":35369,"_23830":141805,"_31422":141806,"_3630":141807},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_4190":85226,"_34937":85218,"_5":35369,"_23830":141809,"_31422":141810,"_3630":141811},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_4190":85227,"_34937":85218,"_5":35369,"_23830":141813,"_31422":141814,"_3630":141815},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_4190":85228,"_34937":85218,"_23830":141817,"_5":16479,"_31422":85218,"_3630":141818},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_4190":85229,"_34937":85218,"_23830":141820,"_5":16479,"_31422":141787,"_3630":141821},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_4190":85230,"_34937":85218,"_23830":141823,"_5":16479,"_31422":141787,"_3630":141824},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_4190":85231,"_34937":85218,"_23830":141826,"_5":16479,"_31422":141787,"_3630":141827},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_4190":85232,"_34937":85218,"_23830":141829,"_5":16479,"_31422":141787,"_3630":141830},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_4190":85233,"_34937":85218,"_23830":141832,"_5":16479,"_31422":141787,"_3630":141833},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_4190":85234,"_34937":85218,"_23830":141835,"_5":16479,"_31422":141790,"_3630":141836},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_4190":85235,"_34937":85218,"_23830":141838,"_5":16479,"_31422":141790,"_3630":141839},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_4190":85236,"_34937":85218,"_23830":141841,"_5":16479,"_31422":141794,"_3630":141842},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_4190":85237,"_34937":85218,"_23830":141844,"_5":16479,"_31422":141794,"_3630":141845},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_4190":85238,"_34937":85218,"_23830":141847,"_5":16479,"_31422":141794,"_3630":141848},[],"Ajuste",{"_4190":85239,"_34937":85218,"_23830":141850,"_5":16479,"_31422":141794,"_3630":141851},[],"Valor de evaluación",{"_4190":85240,"_34937":85218,"_23830":141853,"_5":16479,"_31422":141794,"_3630":63053},[],{"_4190":85241,"_34937":85218,"_23830":141855,"_5":16479,"_31422":141794,"_3630":141856},[],"Raíz emisora de `device-root.pem`.",{"_4190":85242,"_34937":85218,"_23830":141858,"_5":16479,"_31422":141794,"_3630":139767},[],{"_4190":85243,"_34937":85218,"_23830":141860,"_5":16479,"_31422":141794,"_3630":141861},[],"Perfil final de 1 hora que acabas de preparar.",{"_4190":85244,"_34937":85218,"_23830":141863,"_5":16479,"_31422":141794,"_3630":63064},[],{"_4190":85245,"_34937":85218,"_23830":141865,"_5":16479,"_31422":141794,"_3630":63067},[],{"_4190":85246,"_34937":85218,"_23830":141867,"_5":16479,"_31422":141794,"_3630":63070},[],{"_4190":85247,"_34937":85218,"_23830":141869,"_5":16479,"_31422":141794,"_3630":141870},[],"Habilitado.",{"_4190":85248,"_34937":85218,"_23830":141872,"_5":16479,"_31422":141794,"_3630":63076},[],{"_4190":85249,"_34937":85218,"_23830":141874,"_5":16479,"_31422":141794,"_3630":141875},[],"Deshabilitado; el ID debe ser nuevo.",{"_4190":85250,"_34937":85218,"_23830":141877,"_5":16479,"_31422":141794,"_3630":141878},[],"Autenticación inicial",{"_4190":85251,"_34937":85218,"_23830":141880,"_5":16479,"_31422":141794,"_3630":141881},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_4190":85252,"_34937":85218,"_23830":141883,"_5":16479,"_31422":141794,"_3630":141884},[],"Autenticación de renovación",{"_4190":85253,"_34937":85218,"_23830":141886,"_5":16479,"_31422":141794,"_3630":141887},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_4190":85254,"_34937":85218,"_23830":141889,"_5":16479,"_31422":141794,"_3630":63094},[],{"_4190":85255,"_34937":85218,"_23830":141891,"_5":16479,"_31422":141794,"_3630":141892},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_4190":85256,"_34937":85218,"_23830":141894,"_5":16479,"_31422":141794,"_3630":63100},[],{"_4190":85257,"_34937":85218,"_23830":141896,"_5":16479,"_31422":141794,"_3630":141897},[],"1 hora.",{"_4190":85258,"_34937":85218,"_23830":141899,"_5":16479,"_31422":141794,"_3630":63106},[],{"_4190":85259,"_34937":85218,"_23830":141901,"_5":16479,"_31422":141794,"_3630":141902},[],"30 minutos / 10 minutos.",{"_4190":85260,"_34937":85218,"_23830":141904,"_5":16479,"_31422":141794,"_3630":63112},[],{"_4190":85261,"_34937":85218,"_23830":141906,"_5":16479,"_31422":141794,"_3630":141907},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_4190":85262,"_34937":85218,"_23830":141909,"_5":16479,"_31422":141794,"_3630":60870},[],{"_4190":85263,"_34937":85218,"_23830":141911,"_5":16479,"_31422":141794,"_3630":141912},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_4190":85264,"_34937":85218,"_23830":141914,"_5":16479,"_31422":141794,"_3630":63123},[],{"_4190":85265,"_34937":85218,"_23830":141916,"_5":16479,"_31422":141794,"_3630":141917},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_4190":85266,"_34937":85218,"_23830":141919,"_5":16479,"_31422":141794,"_3630":141920},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_4190":85267,"_34937":85218,"_23830":141922,"_5":16479,"_31422":141798,"_3630":141923},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_4190":85268,"_34937":85218,"_23830":141925,"_5":16479,"_31422":141798,"_3630":141926},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_4190":85269,"_34937":85218,"_23830":141928,"_5":16479,"_31422":141802,"_3630":141929},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_4190":85270,"_34937":85218,"_23830":141931,"_5":16479,"_31422":141802,"_3630":141932},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_4190":85271,"_34937":85218,"_23830":141934,"_5":16479,"_31422":141802,"_3630":141935},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_4190":85272,"_34937":85218,"_23830":141937,"_5":16479,"_31422":141806,"_3630":141938},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_4190":85273,"_34937":85218,"_23830":141940,"_5":16479,"_31422":141806,"_3630":141941},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_4190":85274,"_34937":85218,"_23830":141943,"_5":16479,"_31422":141810,"_3630":141944},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_4190":85275,"_34937":85218,"_23830":141946,"_5":16479,"_31422":141810,"_3630":141947},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_4190":85276,"_34937":85218,"_23830":141949,"_5":16479,"_31422":141810,"_3630":141950},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_4190":85277,"_34937":85218,"_23830":141952,"_5":16479,"_31422":141810,"_3630":141953},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_4190":85278,"_34937":85218,"_23830":141955,"_5":16479,"_31422":141810,"_3630":141956},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_4190":85279,"_34937":85218,"_23830":141958,"_5":16479,"_31422":141814,"_3630":141959},[],"Comprobación",{"_4190":85280,"_34937":85218,"_23830":141961,"_5":16479,"_31422":141814,"_3630":141962},[],"Resultado esperado",{"_4190":85281,"_34937":85218,"_23830":141964,"_5":16479,"_31422":141814,"_3630":141965},[],"Registro",{"_4190":85282,"_34937":85218,"_23830":141967,"_5":16479,"_31422":141814,"_3630":141968},[],"ID creado automáticamente y DMS correcto.",{"_4190":85283,"_34937":85218,"_23830":141970,"_5":16479,"_31422":141814,"_3630":141255},[],{"_4190":85284,"_34937":85218,"_23830":141972,"_5":16479,"_31422":141814,"_3630":141973},[],"CN, perfil, serie y clave verificados.",{"_4190":85285,"_34937":85218,"_23830":141975,"_5":16479,"_31422":141814,"_3630":141976},[],"Inventario",{"_4190":85286,"_34937":85218,"_23830":141978,"_5":16479,"_31422":141814,"_3630":141979},[],"Serie recibida visible como identidad actual y en el historial.",{"_4190":85287,"_34937":85218,"_23830":141981,"_5":16479,"_31422":141814,"_3630":141982},[],"Consumidor",{"_4190":85288,"_34937":85218,"_23830":141984,"_5":16479,"_31422":141814,"_3630":141985},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_4190":85289,"_34937":85218,"_23830":141987,"_5":16479,"_31422":141814,"_3630":141988},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_4190":85290,"_34937":85218,"_23830":141990,"_5":16479,"_31422":141814,"_3630":141991},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_4190":85291,"_34937":85291,"_5":16871,"_3630":139481,"_35372":141993,"_23830":141994,"_31422":85291},[58062,138452,60551,141780],[],{"_4190":85292,"_34937":85291,"_23830":141996,"_5":16479,"_31422":85291,"_3630":141997},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_4190":85293,"_34937":85291,"_5":35369,"_23830":141999,"_31422":142000,"_3630":137023},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_4190":85294,"_34937":85291,"_5":35369,"_23830":142002,"_31422":142003,"_3630":142004},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_4190":85295,"_34937":85291,"_5":35369,"_23830":142006,"_31422":142007,"_3630":142008},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_4190":85296,"_34937":85291,"_5":35369,"_23830":142010,"_31422":142011,"_3630":142012},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_4190":85297,"_34937":85291,"_5":35369,"_23830":142014,"_31422":142015,"_3630":142016},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_4190":85298,"_34937":85291,"_5":35369,"_23830":142018,"_31422":142019,"_3630":142020},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_4190":85299,"_34937":85291,"_5":35369,"_23830":142022,"_31422":142023,"_3630":141962},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_4190":85300,"_34937":85291,"_5":35369,"_23830":142025,"_31422":142026,"_3630":142027},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_4190":85301,"_34937":85291,"_5":35369,"_23830":142029,"_31422":142030,"_3630":142031},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_4190":85302,"_34937":85291,"_23830":142033,"_5":16479,"_31422":85291,"_3630":142034},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_4190":85303,"_34937":85291,"_23830":142036,"_5":16479,"_31422":85291,"_3630":142037},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_4190":85304,"_34937":85291,"_23830":142039,"_5":16479,"_31422":142000,"_3630":142040},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_4190":85305,"_34937":85291,"_23830":142042,"_5":16479,"_31422":142000,"_3630":142043},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_4190":85306,"_34937":85291,"_23830":142045,"_5":16479,"_31422":142000,"_3630":142046},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_4190":85307,"_34937":85291,"_23830":142048,"_5":16479,"_31422":142000,"_3630":142049},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_4190":85308,"_34937":85291,"_23830":142051,"_5":16479,"_31422":142003,"_3630":142052},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_4190":85309,"_34937":85291,"_23830":142054,"_5":16479,"_31422":142003,"_3630":142055},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_4190":85310,"_34937":85291,"_23830":142057,"_5":16479,"_31422":142003,"_3630":142058},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_4190":85311,"_34937":85291,"_23830":142060,"_5":16479,"_31422":142003,"_3630":142061},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_4190":85312,"_34937":85291,"_23830":142063,"_5":16479,"_31422":142003,"_3630":142064},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_4190":85313,"_34937":85291,"_23830":142066,"_5":16479,"_31422":142003,"_3630":142067},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_4190":85314,"_34937":85291,"_23830":142069,"_5":16479,"_31422":142003,"_3630":142070},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_4190":85315,"_34937":85291,"_23830":142072,"_5":16479,"_31422":142003,"_3630":142073},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_4190":85316,"_34937":85291,"_23830":142075,"_5":16479,"_31422":142007,"_3630":142076},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_4190":85317,"_34937":85291,"_23830":142078,"_5":16479,"_31422":142007,"_3630":63288},[],{"_4190":85318,"_34937":85291,"_23830":142080,"_5":16479,"_31422":142007,"_3630":142081},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_4190":85319,"_34937":85291,"_23830":142083,"_5":16479,"_31422":142007,"_3630":142084},[],"**Icon** y **Tags**: clasificación opcional.",{"_4190":85320,"_34937":85291,"_23830":142086,"_5":16479,"_31422":142007,"_3630":142087},[],"Confirma el registro.",{"_4190":85321,"_34937":85291,"_23830":142089,"_5":16479,"_31422":142011,"_3630":142090},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_4190":85322,"_34937":85291,"_23830":142092,"_5":16479,"_31422":142011,"_3630":142093},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_4190":85323,"_34937":85291,"_23830":142095,"_5":16479,"_31422":142015,"_3630":142096},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_4190":85324,"_34937":85291,"_23830":142098,"_5":16479,"_31422":142015,"_3630":142099},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_4190":85325,"_34937":85291,"_23830":142101,"_5":16479,"_31422":142019,"_3630":142102},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_4190":85326,"_34937":85291,"_23830":142104,"_5":16479,"_31422":142019,"_3630":142105},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_4190":85327,"_34937":85291,"_23830":142107,"_5":16479,"_31422":142023,"_3630":141959},[],{"_4190":85328,"_34937":85291,"_23830":142109,"_5":16479,"_31422":142023,"_3630":142110},[],"Resultado",{"_4190":85329,"_34937":85291,"_23830":142112,"_5":16479,"_31422":142023,"_3630":141241},[],{"_4190":85330,"_34937":85291,"_23830":142114,"_5":16479,"_31422":142023,"_3630":142115},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_4190":85331,"_34937":85291,"_23830":142117,"_5":16479,"_31422":142023,"_3630":142118},[],"Identidad actual",{"_4190":85332,"_34937":85291,"_23830":142120,"_5":16479,"_31422":142023,"_3630":142121},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_4190":85333,"_34937":85291,"_23830":142123,"_5":16479,"_31422":142023,"_3630":142124},[],"Historial",{"_4190":85334,"_34937":85291,"_23830":142126,"_5":16479,"_31422":142023,"_3630":142127},[],"La emisión asociada aparece con su número de serie y fechas.",{"_4190":85335,"_34937":85291,"_23830":142129,"_5":16479,"_31422":142023,"_3630":142130},[],"Clave y certificado",{"_4190":85336,"_34937":85291,"_23830":142132,"_5":16479,"_31422":142023,"_3630":142133},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_4190":85337,"_34937":85291,"_23830":142135,"_5":16479,"_31422":142026,"_3630":142136},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_4190":85338,"_34937":85291,"_23830":142138,"_5":16479,"_31422":142026,"_3630":142139},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_4190":85339,"_34937":85291,"_23830":142141,"_5":16479,"_31422":142026,"_3630":142142},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_4190":85340,"_34937":85291,"_23830":142144,"_5":16479,"_31422":142026,"_3630":142145},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_4190":85341,"_34937":85291,"_23830":142147,"_5":16479,"_31422":142030,"_3630":142148},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_4190":85342,"_34937":85291,"_23830":142150,"_5":16479,"_31422":142030,"_3630":142151},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_4190":85343,"_34937":85291,"_23830":142153,"_5":16479,"_31422":142030,"_3630":142154},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_4190":85344,"_34937":85344,"_5":16871,"_3630":142156,"_35372":142157,"_23830":142158,"_31422":85344},"Plataforma Lamassu IoT",[58062,138452],[],{"_4190":85345,"_34937":85344,"_23830":142160,"_5":16479,"_31422":85344,"_3630":142161},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_4190":85346,"_34937":85344,"_5":35369,"_23830":142163,"_31422":142164,"_3630":141656},[],"/docs/pr-preview/pr-58/es/platform/overview#empieza-aquí",{"_4190":85347,"_34937":85344,"_5":35369,"_23830":142166,"_31422":142167,"_3630":142168},[],"/docs/pr-preview/pr-58/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_4190":85348,"_34937":85344,"_5":35369,"_23830":142170,"_31422":142171,"_3630":142172},[],"/docs/pr-preview/pr-58/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_4190":85349,"_34937":85344,"_5":35369,"_23830":142174,"_31422":142175,"_3630":142176},[],"/docs/pr-preview/pr-58/es/platform/overview#capacidades-principales","Capacidades principales",{"_4190":85350,"_34937":85344,"_5":35369,"_23830":142178,"_31422":142179,"_3630":142180},[],"/docs/pr-preview/pr-58/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_4190":85351,"_34937":85344,"_5":35369,"_23830":142182,"_31422":142183,"_3630":142184},[],"/docs/pr-preview/pr-58/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_4190":85352,"_34937":85344,"_5":35369,"_23830":142186,"_31422":142187,"_3630":142188},[],"/docs/pr-preview/pr-58/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_4190":85353,"_34937":85344,"_5":35369,"_23830":142190,"_31422":142191,"_3630":142192},[],"/docs/pr-preview/pr-58/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_4190":85354,"_34937":85344,"_5":35369,"_23830":142194,"_31422":142195,"_3630":142196},[],"/docs/pr-preview/pr-58/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_4190":85355,"_34937":85344,"_5":35369,"_23830":142198,"_31422":142199,"_3630":142200},[],"/docs/pr-preview/pr-58/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_4190":85356,"_34937":85344,"_5":35369,"_23830":142202,"_31422":142203,"_3630":142204},[],"/docs/pr-preview/pr-58/es/platform/overview#referencia-operativa","Referencia operativa",{"_4190":85357,"_34937":85344,"_23830":142206,"_5":16479,"_31422":85344,"_3630":142207},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_4190":85358,"_34937":85344,"_23830":142209,"_5":16479,"_31422":142164,"_3630":142210},[],"Elige el resultado que necesitas obtener:",{"_4190":85359,"_34937":85344,"_23830":142212,"_5":16479,"_31422":142164,"_3630":142213},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4190":85360,"_34937":85344,"_23830":142215,"_5":16479,"_31422":142164,"_3630":142216},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4190":85361,"_34937":85344,"_23830":142218,"_5":16479,"_31422":142164,"_3630":142219},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_4190":85362,"_34937":85344,"_23830":142221,"_5":16479,"_31422":142167,"_3630":142222},[],"Bloque",{"_4190":85363,"_34937":85344,"_23830":142224,"_5":16479,"_31422":142167,"_3630":142225},[],"Qué gestionas",{"_4190":85364,"_34937":85344,"_23830":142227,"_5":16479,"_31422":142167,"_3630":142228},[],"Punto de entrada",{"_4190":85365,"_34937":85344,"_23830":142230,"_5":16479,"_31422":142167,"_3630":63441},[],{"_4190":85366,"_34937":85344,"_23830":142232,"_5":16479,"_31422":142167,"_3630":142233},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_4190":85367,"_34937":85344,"_23830":142235,"_5":16479,"_31422":142167,"_3630":142236},[],"Visión general de PKI",{"_4190":85368,"_34937":85344,"_23830":142238,"_5":16479,"_31422":142167,"_3630":63450},[],{"_4190":85369,"_34937":85344,"_23830":142240,"_5":16479,"_31422":142167,"_3630":142241},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_4190":85370,"_34937":85344,"_23830":142243,"_5":16479,"_31422":142167,"_3630":142244},[],"Visión general de IoT Fleets",{"_4190":85371,"_34937":85344,"_23830":142246,"_5":16479,"_31422":142167,"_3630":142247},[],"**Administración**",{"_4190":85372,"_34937":85344,"_23830":142249,"_5":16479,"_31422":142167,"_3630":142250},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_4190":85373,"_34937":85344,"_23830":142252,"_5":16479,"_31422":142167,"_3630":138450},[],{"_4190":85374,"_34937":85344,"_23830":142254,"_5":16479,"_31422":142167,"_3630":142255},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_4190":85375,"_34937":85344,"_23830":142257,"_5":16479,"_31422":142171,"_3630":142258},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_4190":85376,"_34937":85344,"_23830":142260,"_5":16479,"_31422":142171,"_3630":142261},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_4190":85377,"_34937":85344,"_23830":142263,"_5":16479,"_31422":142171,"_3630":142264},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_4190":85378,"_34937":85344,"_23830":142266,"_5":16479,"_31422":142171,"_3630":142267},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_4190":85379,"_34937":85344,"_23830":142269,"_5":16479,"_31422":142171,"_3630":142270},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_4190":85380,"_34937":85344,"_23830":142272,"_5":16479,"_31422":142171,"_3630":142273},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_4190":85381,"_34937":85344,"_23830":142275,"_5":16479,"_31422":142179,"_3630":142276},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_4190":85382,"_34937":85344,"_23830":142278,"_5":16479,"_31422":142183,"_3630":142279},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_4190":85383,"_34937":85344,"_23830":142281,"_5":16479,"_31422":142187,"_3630":142282},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_4190":85384,"_34937":85344,"_23830":142284,"_5":16479,"_31422":142191,"_3630":142285},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_4190":85385,"_34937":85344,"_23830":142287,"_5":16479,"_31422":142195,"_3630":142288},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_4190":85386,"_34937":85344,"_23830":142290,"_5":16479,"_31422":142199,"_3630":142291},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_4190":85387,"_34937":85344,"_23830":142293,"_5":16479,"_31422":142203,"_3630":141749},[],{"_4190":85388,"_34937":85344,"_23830":142295,"_5":16479,"_31422":142203,"_3630":142296},[],"Qué prepara o comprueba",{"_4190":85389,"_34937":85344,"_23830":142298,"_5":16479,"_31422":142203,"_3630":141752},[],{"_4190":85390,"_34937":85344,"_23830":142300,"_5":16479,"_31422":142203,"_3630":142301},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_4190":85391,"_34937":85344,"_23830":142303,"_5":16479,"_31422":142203,"_3630":142304},[],"Administrador de la flota",{"_4190":85392,"_34937":85344,"_23830":142306,"_5":16479,"_31422":142203,"_3630":142307},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_4190":85393,"_34937":85344,"_23830":142309,"_5":16479,"_31422":142203,"_3630":141764},[],{"_4190":85394,"_34937":85344,"_23830":142311,"_5":16479,"_31422":142203,"_3630":142312},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_4190":85395,"_34937":85344,"_23830":142314,"_5":16479,"_31422":142203,"_3630":141770},[],{"_4190":85396,"_34937":85344,"_23830":142316,"_5":16479,"_31422":142203,"_3630":142317},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_4190":85397,"_34937":85344,"_23830":142319,"_5":16479,"_31422":142203,"_3630":142320},[],"Operador de infraestructura",{"_4190":85398,"_34937":85344,"_23830":142322,"_5":16479,"_31422":142203,"_3630":142323},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_4190":85399,"_34937":85344,"_23830":142325,"_5":16479,"_31422":142203,"_3630":142326},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_4190":85400,"_34937":85400,"_5":16871,"_3630":142328,"_35372":142329,"_23830":142331,"_31422":85400},"Jerarquía y rotación de CAs",[58062,138452,63542,142330],"Claves, autoridades y certificados",[],{"_4190":85401,"_34937":85400,"_23830":142333,"_5":16479,"_31422":85400,"_3630":142334},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_4190":85402,"_34937":85400,"_5":35369,"_23830":142336,"_31422":142337,"_3630":142338},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_4190":85403,"_34937":85400,"_5":35369,"_23830":142340,"_31422":142341,"_3630":142342},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_4190":85404,"_34937":85400,"_5":35369,"_23830":142344,"_31422":142345,"_3630":142346},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_4190":85405,"_34937":85400,"_5":35369,"_23830":142348,"_31422":142349,"_3630":142350},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_4190":85406,"_34937":85400,"_5":35369,"_23830":142352,"_31422":142353,"_3630":142354},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_4190":85407,"_34937":85400,"_5":35369,"_23830":142356,"_31422":142357,"_3630":142358},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_4190":85408,"_34937":85400,"_5":35369,"_23830":142360,"_31422":142361,"_3630":142362},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_4190":85409,"_34937":85400,"_5":35369,"_23830":142364,"_31422":142365,"_3630":142366},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_4190":85410,"_34937":85400,"_5":35369,"_23830":142368,"_31422":142369,"_3630":142370},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_4190":85411,"_34937":85400,"_5":35369,"_23830":142372,"_31422":142373,"_3630":142374},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_4190":85412,"_34937":85400,"_5":35369,"_23830":142376,"_31422":142377,"_3630":142378},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_4190":85413,"_34937":85400,"_5":35369,"_23830":142380,"_31422":142381,"_3630":142382},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_4190":85414,"_34937":85400,"_23830":142384,"_5":16479,"_31422":85400,"_3630":142385},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_4190":85415,"_34937":85400,"_23830":142387,"_5":16479,"_31422":85400,"_3630":142388},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_4190":85416,"_34937":85400,"_23830":142390,"_5":16479,"_31422":142337,"_3630":142391},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_4190":85417,"_34937":85400,"_23830":142393,"_5":16479,"_31422":142337,"_3630":142394},[],"entorno, como producción y preproducción;",{"_4190":85418,"_34937":85400,"_23830":142396,"_5":16479,"_31422":142337,"_3630":142397},[],"propietario o equipo operador;",{"_4190":85419,"_34937":85400,"_23830":142399,"_5":16479,"_31422":142337,"_3630":142400},[],"familia de dispositivos o proceso de fabricación;",{"_4190":85420,"_34937":85400,"_23830":142402,"_5":16479,"_31422":142337,"_3630":142403},[],"región o requisito regulatorio;",{"_4190":85421,"_34937":85400,"_23830":142405,"_5":16479,"_31422":142337,"_3630":142406},[],"motor criptográfico o política de clave;",{"_4190":85422,"_34937":85400,"_23830":142408,"_5":16479,"_31422":142337,"_3630":142409},[],"ventana de mantenimiento y ritmo de renovación.",{"_4190":85423,"_34937":85400,"_23830":142411,"_5":16479,"_31422":142337,"_3630":142412},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_4190":85424,"_34937":85400,"_23830":142414,"_5":16479,"_31422":142337,"_3630":142415},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_4190":85425,"_34937":85400,"_23830":142417,"_5":16479,"_31422":142341,"_3630":142418},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_4190":85426,"_34937":85400,"_23830":142420,"_5":16479,"_31422":142341,"_3630":142421},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_4190":85427,"_34937":85400,"_23830":142423,"_5":16479,"_31422":142341,"_3630":142424},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_4190":85428,"_34937":85400,"_23830":142426,"_5":16479,"_31422":142341,"_3630":142427},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_4190":85429,"_34937":85400,"_23830":142429,"_5":16479,"_31422":142345,"_3630":142430},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_4190":85430,"_34937":85400,"_23830":142432,"_5":16479,"_31422":142345,"_3630":142433},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_4190":85431,"_34937":85400,"_23830":142435,"_5":16479,"_31422":142345,"_3630":142436},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_4190":85432,"_34937":85400,"_23830":142438,"_5":16479,"_31422":142345,"_3630":142439},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_4190":85433,"_34937":85400,"_23830":142441,"_5":16479,"_31422":142353,"_3630":142442},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_4190":85434,"_34937":85400,"_23830":142444,"_5":16479,"_31422":142357,"_3630":142445},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_4190":85435,"_34937":85400,"_23830":142447,"_5":16479,"_31422":142361,"_3630":142448},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_4190":85436,"_34937":85400,"_23830":142450,"_5":16479,"_31422":142365,"_3630":142451},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_4190":85437,"_34937":85400,"_23830":142453,"_5":16479,"_31422":142369,"_3630":142454},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_4190":85438,"_34937":85400,"_23830":142456,"_5":16479,"_31422":142373,"_3630":142457},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_4190":85439,"_34937":85400,"_23830":142459,"_5":16479,"_31422":142377,"_3630":142460},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_4190":85440,"_34937":85400,"_23830":142462,"_5":16479,"_31422":142377,"_3630":142463},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_4190":85441,"_34937":85400,"_23830":142465,"_5":16479,"_31422":142377,"_3630":142466},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_4190":85442,"_34937":85400,"_23830":142468,"_5":16479,"_31422":142377,"_3630":142469},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_4190":85443,"_34937":85400,"_23830":142471,"_5":16479,"_31422":142381,"_3630":142472},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_4190":85444,"_34937":85400,"_23830":142474,"_5":16479,"_31422":142381,"_3630":142475},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_4190":85445,"_34937":85400,"_23830":142477,"_5":16479,"_31422":142381,"_3630":142478},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_4190":85446,"_34937":85400,"_23830":142480,"_5":16479,"_31422":142381,"_3630":142481},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_4190":85447,"_34937":85400,"_23830":142483,"_5":16479,"_31422":142381,"_3630":142484},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_4190":85448,"_34937":85400,"_23830":142486,"_5":16479,"_31422":142381,"_3630":142487},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_4190":85449,"_34937":85400,"_23830":142489,"_5":16479,"_31422":142381,"_3630":142490},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_4190":85450,"_34937":85450,"_5":16871,"_3630":142492,"_35372":142493,"_23830":142494,"_31422":85450},"Autoridades de certificación",[58062,138452,63542,142330],[],{"_4190":85451,"_34937":85450,"_23830":142496,"_5":16479,"_31422":85450,"_3630":142497},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_4190":85452,"_34937":85450,"_5":35369,"_23830":142499,"_31422":142500,"_3630":142501},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_4190":85453,"_34937":85450,"_5":35369,"_23830":142503,"_31422":142504,"_3630":142505},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_4190":85454,"_34937":85450,"_5":35369,"_23830":142507,"_31422":142508,"_3630":137023},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#antes-de-empezar",{"_4190":85455,"_34937":85450,"_5":35369,"_23830":142510,"_31422":142511,"_3630":142512},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_4190":85456,"_34937":85450,"_5":35369,"_23830":142514,"_31422":142515,"_3630":142516},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_4190":85457,"_34937":85450,"_5":35369,"_23830":142518,"_31422":142519,"_3630":142520},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_4190":85458,"_34937":85450,"_5":35369,"_23830":142522,"_31422":142523,"_3630":142524},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_4190":85459,"_34937":85450,"_5":35369,"_23830":142526,"_31422":142527,"_3630":142528},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_4190":85460,"_34937":85450,"_5":35369,"_23830":142530,"_31422":142531,"_3630":142532},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_4190":85461,"_34937":85450,"_5":35369,"_23830":142534,"_31422":142535,"_3630":142536},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_4190":85462,"_34937":85450,"_5":35369,"_23830":142538,"_31422":142539,"_3630":142540},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_4190":85463,"_34937":85450,"_5":35369,"_23830":142542,"_31422":142543,"_3630":142544},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_4190":85464,"_34937":85450,"_5":35369,"_23830":142546,"_31422":142547,"_3630":142548},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_4190":85465,"_34937":85450,"_5":35369,"_23830":142550,"_31422":142551,"_3630":142552},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_4190":85466,"_34937":85450,"_5":35369,"_23830":142554,"_31422":142555,"_3630":142556},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_4190":85467,"_34937":85450,"_5":35369,"_23830":142558,"_31422":142559,"_3630":142560},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_4190":85468,"_34937":85450,"_5":35369,"_23830":142562,"_31422":142563,"_3630":142564},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_4190":85469,"_34937":85450,"_5":35369,"_23830":142566,"_31422":142567,"_3630":142568},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_4190":85470,"_34937":85450,"_5":35369,"_23830":142570,"_31422":142571,"_3630":142572},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_4190":85471,"_34937":85450,"_5":35369,"_23830":142574,"_31422":142575,"_3630":142576},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_4190":85472,"_34937":85450,"_5":35369,"_23830":142578,"_31422":142579,"_3630":142580},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_4190":85473,"_34937":85450,"_5":35369,"_23830":142582,"_31422":142583,"_3630":142584},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_4190":85474,"_34937":85450,"_5":35369,"_23830":142586,"_31422":142587,"_3630":142588},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_4190":85475,"_34937":85450,"_23830":142590,"_5":16479,"_31422":85450,"_3630":142591},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_4190":85476,"_34937":85450,"_23830":142593,"_5":16479,"_31422":85450,"_3630":142594},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_4190":85477,"_34937":85450,"_23830":142596,"_5":16479,"_31422":85450,"_3630":142597},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_4190":85478,"_34937":85450,"_23830":142599,"_5":16479,"_31422":142500,"_3630":142600},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_4190":85479,"_34937":85450,"_23830":142602,"_5":16479,"_31422":142500,"_3630":142603},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_4190":85480,"_34937":85450,"_23830":142605,"_5":16479,"_31422":142500,"_3630":142606},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_4190":85481,"_34937":85450,"_23830":142608,"_5":16479,"_31422":142500,"_3630":142609},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_4190":85482,"_34937":85450,"_23830":142611,"_5":16479,"_31422":142500,"_3630":142612},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_4190":85483,"_34937":85450,"_23830":142614,"_5":16479,"_31422":142508,"_3630":142615},[],"Decide si la CA será raíz o intermedia.",{"_4190":85484,"_34937":85450,"_23830":142617,"_5":16479,"_31422":142508,"_3630":142618},[],"Elige el motor que custodiará la clave.",{"_4190":85485,"_34937":85450,"_23830":142620,"_5":16479,"_31422":142508,"_3630":142621},[],"Define una validez superior a la de los certificados que emitirá.",{"_4190":85486,"_34937":85450,"_23830":142623,"_5":16479,"_31422":142508,"_3630":142624},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_4190":85487,"_34937":85450,"_23830":142626,"_5":16479,"_31422":142511,"_3630":142627},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_4190":85488,"_34937":85450,"_23830":142629,"_5":16479,"_31422":142515,"_3630":142630},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_4190":85489,"_34937":85450,"_23830":142632,"_5":16479,"_31422":142515,"_3630":142633},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_4190":85490,"_34937":85450,"_23830":142635,"_5":16479,"_31422":142519,"_3630":142636},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_4190":85491,"_34937":85450,"_23830":142638,"_5":16479,"_31422":142523,"_3630":142639},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_4190":85492,"_34937":85450,"_23830":142641,"_5":16479,"_31422":142523,"_3630":142642},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_4190":85493,"_34937":85450,"_23830":142644,"_5":16479,"_31422":142523,"_3630":142645},[],"`ST`: estado o provincia.",{"_4190":85494,"_34937":85450,"_23830":142647,"_5":16479,"_31422":142523,"_3630":142648},[],"`L`: localidad.",{"_4190":85495,"_34937":85450,"_23830":142650,"_5":16479,"_31422":142523,"_3630":142651},[],"`O`: organización.",{"_4190":85496,"_34937":85450,"_23830":142653,"_5":16479,"_31422":142523,"_3630":142654},[],"`OU`: unidad organizativa.",{"_4190":85497,"_34937":85450,"_23830":142656,"_5":16479,"_31422":142523,"_3630":142657},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_4190":85498,"_34937":85450,"_23830":142659,"_5":16479,"_31422":142527,"_3630":142660},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_4190":85499,"_34937":85450,"_23830":142662,"_5":16479,"_31422":142527,"_3630":142663},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_4190":85500,"_34937":85450,"_23830":142665,"_5":16479,"_31422":142531,"_3630":142666},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_4190":85501,"_34937":85450,"_23830":142668,"_5":16479,"_31422":142531,"_3630":142669},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_4190":85502,"_34937":85450,"_23830":142671,"_5":16479,"_31422":142535,"_3630":142672},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_4190":85503,"_34937":85450,"_23830":142674,"_5":16479,"_31422":142535,"_3630":142675},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_4190":85504,"_34937":85450,"_23830":142677,"_5":16479,"_31422":142539,"_3630":142678},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_4190":85505,"_34937":85450,"_23830":142680,"_5":16479,"_31422":142539,"_3630":142681},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_4190":85506,"_34937":85450,"_23830":142683,"_5":16479,"_31422":142539,"_3630":142684},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_4190":85507,"_34937":85450,"_23830":142686,"_5":16479,"_31422":142543,"_3630":142687},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_4190":85508,"_34937":85450,"_23830":142689,"_5":16479,"_31422":142547,"_3630":142690},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_4190":85509,"_34937":85450,"_23830":142692,"_5":16479,"_31422":142547,"_3630":142693},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_4190":85510,"_34937":85450,"_23830":142695,"_5":16479,"_31422":142551,"_3630":142696},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_4190":85511,"_34937":85450,"_23830":142698,"_5":16479,"_31422":142555,"_3630":142699},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_4190":85512,"_34937":85450,"_23830":142701,"_5":16479,"_31422":142555,"_3630":142702},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_4190":85513,"_34937":85450,"_23830":142704,"_5":16479,"_31422":142559,"_3630":142705},[],"Abre una CA desde el inventario para consultar:",{"_4190":85514,"_34937":85450,"_23830":142707,"_5":16479,"_31422":142559,"_3630":142708},[],"Estado y periodo de validez.",{"_4190":85515,"_34937":85450,"_23830":142710,"_5":16479,"_31422":142559,"_3630":142711},[],"Certificado y cadena en formato PEM.",{"_4190":85516,"_34937":85450,"_23830":142713,"_5":16479,"_31422":142559,"_3630":142714},[],"Número de certificados activos, expirados y revocados.",{"_4190":85517,"_34937":85450,"_23830":142716,"_5":16479,"_31422":142559,"_3630":142717},[],"Certificados emitidos en **Issued Certificates**.",{"_4190":85518,"_34937":85450,"_23830":142719,"_5":16479,"_31422":142559,"_3630":142720},[],"CRL vinculada a la autoridad.",{"_4190":85519,"_34937":85450,"_23830":142722,"_5":16479,"_31422":142559,"_3630":142723},[],"Metadatos y motor criptográfico asociado.",{"_4190":85520,"_34937":85450,"_23830":142725,"_5":16479,"_31422":142559,"_3630":142726},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_4190":85521,"_34937":85450,"_23830":142728,"_5":16479,"_31422":142563,"_3630":142729},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_4190":85522,"_34937":85450,"_23830":142731,"_5":16479,"_31422":142563,"_3630":142732},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_4190":85523,"_34937":85450,"_23830":142734,"_5":16479,"_31422":142563,"_3630":142735},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_4190":85524,"_34937":85450,"_23830":142737,"_5":16479,"_31422":142563,"_3630":142738},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_4190":85525,"_34937":85450,"_23830":142740,"_5":16479,"_31422":142567,"_3630":142741},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_4190":85526,"_34937":85450,"_23830":142743,"_5":16479,"_31422":142571,"_3630":142744},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_4190":85527,"_34937":85450,"_23830":142746,"_5":16479,"_31422":142575,"_3630":142747},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_4190":85528,"_34937":85450,"_23830":142749,"_5":16479,"_31422":142579,"_3630":142750},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_4190":85529,"_34937":85450,"_23830":142752,"_5":16479,"_31422":142583,"_3630":142753},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_4190":85530,"_34937":85450,"_23830":142755,"_5":16479,"_31422":142587,"_3630":142756},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_4190":85531,"_34937":85450,"_23830":142758,"_5":16479,"_31422":142587,"_3630":142759},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_4190":85532,"_34937":85450,"_23830":142761,"_5":16479,"_31422":142587,"_3630":142762},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_4190":85533,"_34937":85533,"_5":16871,"_3630":142764,"_35372":142765,"_23830":142766,"_31422":85533},"Perfiles de certificado",[58062,138452,63542,142330],[],{"_4190":85534,"_34937":85533,"_23830":142768,"_5":16479,"_31422":85533,"_3630":142769},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_4190":85535,"_34937":85533,"_5":35369,"_23830":142771,"_31422":142772,"_3630":142773},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_4190":85536,"_34937":85533,"_5":35369,"_23830":142775,"_31422":142776,"_3630":142777},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#validez","Validez",{"_4190":85537,"_34937":85533,"_5":35369,"_23830":142779,"_31422":142780,"_3630":142781},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_4190":85538,"_34937":85533,"_5":35369,"_23830":142783,"_31422":142784,"_3630":142785},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_4190":85539,"_34937":85533,"_5":35369,"_23830":142787,"_31422":142788,"_3630":142789},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_4190":85540,"_34937":85533,"_5":35369,"_23830":142791,"_31422":142792,"_3630":142793},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_4190":85541,"_34937":85533,"_5":35369,"_23830":142795,"_31422":142796,"_3630":142797},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_4190":85542,"_34937":85533,"_5":35369,"_23830":142799,"_31422":142800,"_3630":142801},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_4190":85543,"_34937":85533,"_5":35369,"_23830":142803,"_31422":142804,"_3630":142805},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_4190":85544,"_34937":85533,"_5":35369,"_23830":142807,"_31422":142808,"_3630":142809},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_4190":85545,"_34937":85533,"_5":35369,"_23830":142811,"_31422":142812,"_3630":142813},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_4190":85546,"_34937":85533,"_5":35369,"_23830":142815,"_31422":142816,"_3630":142817},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_4190":85547,"_34937":85533,"_5":35369,"_23830":142819,"_31422":142820,"_3630":142821},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_4190":85548,"_34937":85533,"_5":35369,"_23830":142823,"_31422":142824,"_3630":142825},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_4190":85549,"_34937":85533,"_5":35369,"_23830":142827,"_31422":142828,"_3630":142829},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_4190":85550,"_34937":85533,"_5":35369,"_23830":142831,"_31422":142832,"_3630":142833},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_4190":85551,"_34937":85533,"_23830":142835,"_5":16479,"_31422":85533,"_3630":142836},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_4190":85552,"_34937":85533,"_23830":142838,"_5":16479,"_31422":85533,"_3630":142839},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_4190":85553,"_34937":85533,"_23830":142841,"_5":16479,"_31422":142776,"_3630":142842},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_4190":85554,"_34937":85533,"_23830":142844,"_5":16479,"_31422":142776,"_3630":142845},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_4190":85555,"_34937":85533,"_23830":142847,"_5":16479,"_31422":142780,"_3630":142848},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_4190":85556,"_34937":85533,"_23830":142850,"_5":16479,"_31422":142784,"_3630":142851},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_4190":85557,"_34937":85533,"_23830":142853,"_5":16479,"_31422":142784,"_3630":142854},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_4190":85558,"_34937":85533,"_23830":142856,"_5":16479,"_31422":142784,"_3630":142857},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_4190":85559,"_34937":85533,"_23830":142859,"_5":16479,"_31422":142788,"_3630":142860},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_4190":85560,"_34937":85533,"_23830":142862,"_5":16479,"_31422":142792,"_3630":142863},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_4190":85561,"_34937":85533,"_23830":142865,"_5":16479,"_31422":142792,"_3630":142866},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_4190":85562,"_34937":85533,"_23830":142868,"_5":16479,"_31422":142796,"_3630":142869},[],"La aplicación criptográfica puede:",{"_4190":85563,"_34937":85533,"_23830":142871,"_5":16479,"_31422":142796,"_3630":142872},[],"permitir o bloquear claves RSA;",{"_4190":85564,"_34937":85533,"_23830":142874,"_5":16479,"_31422":142796,"_3630":142875},[],"limitar los tamaños RSA admitidos;",{"_4190":85565,"_34937":85533,"_23830":142877,"_5":16479,"_31422":142796,"_3630":142878},[],"permitir o bloquear claves ECDSA;",{"_4190":85566,"_34937":85533,"_23830":142880,"_5":16479,"_31422":142796,"_3630":142881},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_4190":85567,"_34937":85533,"_23830":142883,"_5":16479,"_31422":142796,"_3630":142884},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_4190":85568,"_34937":85533,"_23830":142886,"_5":16479,"_31422":142800,"_3630":142887},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_4190":85569,"_34937":85533,"_23830":142889,"_5":16479,"_31422":142800,"_3630":138212},[],{"_4190":85570,"_34937":85533,"_23830":142891,"_5":16479,"_31422":142800,"_3630":142892},[],"Primera opción",{"_4190":85571,"_34937":85533,"_23830":142894,"_5":16479,"_31422":142800,"_3630":142895},[],"Segunda opción",{"_4190":85572,"_34937":85533,"_23830":142897,"_5":16479,"_31422":142800,"_3630":142898},[],"Si no hay ninguna",{"_4190":85573,"_34937":85533,"_23830":142900,"_5":16479,"_31422":142800,"_3630":142901},[],"Firma directa con una CA",{"_4190":85574,"_34937":85533,"_23830":142903,"_5":16479,"_31422":142800,"_3630":142904},[],"`issuance_profile` incluido en la solicitud",{"_4190":85575,"_34937":85533,"_23830":142906,"_5":16479,"_31422":142800,"_3630":142907},[],"`issuance_profile_id` de la solicitud",{"_4190":85576,"_34937":85533,"_23830":142909,"_5":16479,"_31422":142800,"_3630":142910},[],"Perfil predeterminado de la CA (`profile_id`).",{"_4190":85577,"_34937":85533,"_23830":142912,"_5":16479,"_31422":142800,"_3630":142913},[],"Emisión mediante DMS",{"_4190":85578,"_34937":85533,"_23830":142915,"_5":16479,"_31422":142800,"_3630":64129},[],{"_4190":85579,"_34937":85533,"_23830":142917,"_5":16479,"_31422":142800,"_3630":142918},[],"`settings.issuance_profile` incluido en el DMS",{"_4190":85580,"_34937":85533,"_23830":142920,"_5":16479,"_31422":142800,"_3630":142921},[],"Perfil predeterminado de la CA de enrolamiento.",{"_4190":85581,"_34937":85533,"_23830":142923,"_5":16479,"_31422":142800,"_3630":142924},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_4190":85582,"_34937":85533,"_23830":142926,"_5":16479,"_31422":142800,"_3630":142927},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_4190":85583,"_34937":85533,"_23830":142929,"_5":16479,"_31422":142808,"_3630":142930},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_4190":85584,"_34937":85533,"_23830":142932,"_5":16479,"_31422":142812,"_3630":142933},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_4190":85585,"_34937":85533,"_23830":142935,"_5":16479,"_31422":142816,"_3630":142936},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_4190":85586,"_34937":85533,"_23830":142938,"_5":16479,"_31422":142820,"_3630":142939},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_4190":85587,"_34937":85533,"_23830":142941,"_5":16479,"_31422":142824,"_3630":142942},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_4190":85588,"_34937":85533,"_23830":142944,"_5":16479,"_31422":142824,"_3630":142945},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_4190":85589,"_34937":85533,"_23830":142947,"_5":16479,"_31422":142828,"_3630":142948},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_4190":85590,"_34937":85533,"_23830":142950,"_5":16479,"_31422":142828,"_3630":142951},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_4190":85591,"_34937":85533,"_23830":142953,"_5":16479,"_31422":142828,"_3630":142954},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_4190":85592,"_34937":85533,"_23830":142956,"_5":16479,"_31422":142828,"_3630":142957},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_4190":85593,"_34937":85533,"_23830":142959,"_5":16479,"_31422":142832,"_3630":142960},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_4190":85594,"_34937":85533,"_23830":142962,"_5":16479,"_31422":142832,"_3630":142963},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_4190":85595,"_34937":85595,"_5":16871,"_3630":142965,"_35372":142966,"_23830":142968,"_31422":85595},"Validación de certificados",[58062,138452,63542,142967],"Validación",[],{"_4190":85596,"_34937":85595,"_23830":142970,"_5":16479,"_31422":85595,"_3630":142971},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_4190":85597,"_34937":85595,"_5":35369,"_23830":142973,"_31422":142974,"_3630":142975},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_4190":85598,"_34937":85595,"_5":35369,"_23830":142977,"_31422":142978,"_3630":142979},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_4190":85599,"_34937":85595,"_5":35369,"_23830":142981,"_31422":142982,"_3630":142983},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_4190":85600,"_34937":85595,"_23830":142985,"_5":16479,"_31422":85595,"_3630":142986},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_4190":85601,"_34937":85595,"_23830":142988,"_5":16479,"_31422":142974,"_3630":142989},[],"Verifica estos criterios juntos:",{"_4190":85602,"_34937":85595,"_23830":142991,"_5":16479,"_31422":142974,"_3630":141959},[],{"_4190":85603,"_34937":85595,"_23830":142993,"_5":16479,"_31422":142974,"_3630":142994},[],"Resultado necesario",{"_4190":85604,"_34937":85595,"_23830":142996,"_5":16479,"_31422":142974,"_3630":142997},[],"Cadena y firma",{"_4190":85605,"_34937":85595,"_23830":142999,"_5":16479,"_31422":142974,"_3630":143000},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_4190":85606,"_34937":85595,"_23830":143002,"_5":16479,"_31422":142974,"_3630":143003},[],"Fechas",{"_4190":85607,"_34937":85595,"_23830":143005,"_5":16479,"_31422":142974,"_3630":143006},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_4190":85608,"_34937":85595,"_23830":143008,"_5":16479,"_31422":142974,"_3630":138122},[],{"_4190":85609,"_34937":85595,"_23830":143010,"_5":16479,"_31422":142974,"_3630":143011},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_4190":85610,"_34937":85595,"_23830":143013,"_5":16479,"_31422":142974,"_3630":143014},[],"Uso",{"_4190":85611,"_34937":85595,"_23830":143016,"_5":16479,"_31422":142974,"_3630":143017},[],"KU, EKU y restricciones permiten la operación concreta.",{"_4190":85612,"_34937":85595,"_23830":143019,"_5":16479,"_31422":142974,"_3630":143020},[],"Revocación",{"_4190":85613,"_34937":85595,"_23830":143022,"_5":16479,"_31422":142974,"_3630":143023},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_4190":85614,"_34937":85595,"_23830":143025,"_5":16479,"_31422":142974,"_3630":143026},[],"Autorización",{"_4190":85615,"_34937":85595,"_23830":143028,"_5":16479,"_31422":142974,"_3630":143029},[],"La aplicación permite la acción a esa identidad.",{"_4190":85616,"_34937":85595,"_23830":143031,"_5":16479,"_31422":142974,"_3630":143032},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_4190":85617,"_34937":85595,"_23830":143034,"_5":16479,"_31422":142978,"_3630":143035},[],"Mecanismo",{"_4190":85618,"_34937":85595,"_23830":143037,"_5":16479,"_31422":142978,"_3630":143038},[],"Cuándo utilizarlo",{"_4190":85619,"_34937":85595,"_23830":143040,"_5":16479,"_31422":142978,"_3630":143041},[],"Qué debes mantener",{"_4190":85620,"_34937":85595,"_23830":143043,"_5":16479,"_31422":142978,"_3630":64257},[],{"_4190":85621,"_34937":85595,"_23830":143045,"_5":16479,"_31422":142978,"_3630":143046},[],"Consulta del estado de un certificado concreto.",{"_4190":85622,"_34937":85595,"_23830":143048,"_5":16479,"_31422":142978,"_3630":143049},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_4190":85623,"_34937":85595,"_23830":143051,"_5":16479,"_31422":142978,"_3630":64266},[],{"_4190":85624,"_34937":85595,"_23830":143053,"_5":16479,"_31422":142978,"_3630":143054},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_4190":85625,"_34937":85595,"_23830":143056,"_5":16479,"_31422":142978,"_3630":143057},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_4190":85626,"_34937":85595,"_23830":143059,"_5":16479,"_31422":142978,"_3630":143060},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_4190":85627,"_34937":85595,"_23830":143062,"_5":16479,"_31422":142978,"_3630":143063},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_4190":85628,"_34937":85595,"_23830":143065,"_5":16479,"_31422":142982,"_3630":143066},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_4190":85629,"_34937":85595,"_23830":143068,"_5":16479,"_31422":142982,"_3630":143069},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_4190":85630,"_34937":85595,"_23830":143071,"_5":16479,"_31422":142982,"_3630":143072},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_4190":85631,"_34937":85595,"_23830":143074,"_5":16479,"_31422":142982,"_3630":143075},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_4190":85632,"_34937":85595,"_23830":143077,"_5":16479,"_31422":142982,"_3630":143078},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_4190":85633,"_34937":85595,"_23830":143080,"_5":16479,"_31422":142982,"_3630":143081},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_4190":85634,"_34937":85595,"_23830":143083,"_5":16479,"_31422":142982,"_3630":143084},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_4190":85635,"_34937":85595,"_23830":143086,"_5":16479,"_31422":142982,"_3630":143087},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_4190":85636,"_34937":85595,"_23830":143089,"_5":16479,"_31422":142982,"_3630":143090},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_4190":85637,"_34937":85637,"_5":16871,"_3630":143092,"_35372":143093,"_23830":143094,"_31422":85637},"Certificados",[58062,138452,63542,142330],[],{"_4190":85638,"_34937":85637,"_23830":143096,"_5":16479,"_31422":85637,"_3630":143097},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_4190":85639,"_34937":85637,"_5":35369,"_23830":143099,"_31422":143100,"_3630":143101},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_4190":85640,"_34937":85637,"_5":35369,"_23830":143103,"_31422":143104,"_3630":143105},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_4190":85641,"_34937":85637,"_5":35369,"_23830":143107,"_31422":143108,"_3630":143109},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_4190":85642,"_34937":85637,"_5":35369,"_23830":143111,"_31422":143112,"_3630":143113},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_4190":85643,"_34937":85637,"_5":35369,"_23830":143115,"_31422":143116,"_3630":143117},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_4190":85644,"_34937":85637,"_5":35369,"_23830":143119,"_31422":143120,"_3630":143121},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_4190":85645,"_34937":85637,"_5":35369,"_23830":143123,"_31422":143124,"_3630":143125},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_4190":85646,"_34937":85637,"_5":35369,"_23830":143127,"_31422":143128,"_3630":143129},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_4190":85647,"_34937":85637,"_5":35369,"_23830":143131,"_31422":143132,"_3630":143133},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#continúa","Continúa",{"_4190":85648,"_34937":85637,"_23830":143135,"_5":16479,"_31422":85637,"_3630":143136},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_4190":85649,"_34937":85637,"_23830":143138,"_5":16479,"_31422":143100,"_3630":143139},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_4190":85650,"_34937":85637,"_23830":143141,"_5":16479,"_31422":143100,"_3630":143142},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_4190":85651,"_34937":85637,"_23830":143144,"_5":16479,"_31422":143100,"_3630":143145},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_4190":85652,"_34937":85637,"_23830":143147,"_5":16479,"_31422":143100,"_3630":143148},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_4190":85653,"_34937":85637,"_23830":143150,"_5":16479,"_31422":143100,"_3630":143151},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_4190":85654,"_34937":85637,"_23830":143153,"_5":16479,"_31422":143100,"_3630":143154},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_4190":85655,"_34937":85637,"_23830":143156,"_5":16479,"_31422":143100,"_3630":143157},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_4190":85656,"_34937":85637,"_23830":143159,"_5":16479,"_31422":143104,"_3630":143160},[],"Descarga el PEM e inspecciónalo:",{"_4190":85657,"_34937":85637,"_23830":143162,"_5":16479,"_31422":143104,"_3630":143163},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_4190":85658,"_34937":85637,"_23830":143165,"_5":16479,"_31422":143108,"_3630":143166},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_4190":85659,"_34937":85637,"_23830":143168,"_5":16479,"_31422":143108,"_3630":143169},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_4190":85660,"_34937":85637,"_23830":143171,"_5":16479,"_31422":143108,"_3630":143172},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_4190":85661,"_34937":85637,"_23830":143174,"_5":16479,"_31422":143108,"_3630":143175},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_4190":85662,"_34937":85637,"_23830":143177,"_5":16479,"_31422":143108,"_3630":143178},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_4190":85663,"_34937":85637,"_23830":143180,"_5":16479,"_31422":143108,"_3630":143181},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_4190":85664,"_34937":85637,"_23830":143183,"_5":16479,"_31422":143108,"_3630":143184},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_4190":85665,"_34937":85637,"_23830":143186,"_5":16479,"_31422":143112,"_3630":143187},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_4190":85666,"_34937":85637,"_23830":143189,"_5":16479,"_31422":143116,"_3630":143190},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_4190":85667,"_34937":85637,"_23830":143192,"_5":16479,"_31422":143120,"_3630":143193},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_4190":85668,"_34937":85637,"_23830":143195,"_5":16479,"_31422":143124,"_3630":143196},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_4190":85669,"_34937":85637,"_23830":143198,"_5":16479,"_31422":143124,"_3630":143199},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_4190":85670,"_34937":85637,"_23830":143201,"_5":16479,"_31422":143124,"_3630":143202},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_4190":85671,"_34937":85637,"_23830":143204,"_5":16479,"_31422":143128,"_3630":143205},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_4190":85672,"_34937":85637,"_23830":143207,"_5":16479,"_31422":143128,"_3630":143208},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_4190":85673,"_34937":85637,"_23830":143210,"_5":16479,"_31422":143128,"_3630":143211},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_4190":85674,"_34937":85637,"_23830":143213,"_5":16479,"_31422":143132,"_3630":143214},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_4190":85675,"_34937":85637,"_23830":143216,"_5":16479,"_31422":143132,"_3630":143217},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_4190":85676,"_34937":85676,"_5":16871,"_3630":143219,"_35372":143220,"_23830":143222,"_31422":85676},"Ciclo de vida de un certificado",[58062,138452,63542,143221],"Conceptos",[],{"_4190":85677,"_34937":85676,"_23830":143224,"_5":16479,"_31422":85676,"_3630":143225},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_4190":85678,"_34937":85676,"_5":35369,"_23830":143227,"_31422":143228,"_3630":143229},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_4190":85679,"_34937":85676,"_5":35369,"_23830":143231,"_31422":143232,"_3630":143233},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_4190":85680,"_34937":85676,"_5":35369,"_23830":143235,"_31422":143236,"_3630":143237},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_4190":85681,"_34937":85676,"_5":35369,"_23830":143239,"_31422":143240,"_3630":143241},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_4190":85682,"_34937":85676,"_5":35369,"_23830":143243,"_31422":143244,"_3630":143245},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_4190":85683,"_34937":85676,"_5":35369,"_23830":143247,"_31422":143248,"_3630":143249},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_4190":85684,"_34937":85676,"_5":35369,"_23830":143251,"_31422":143252,"_3630":140953},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_4190":85685,"_34937":85676,"_5":35369,"_23830":143254,"_31422":143255,"_3630":143256},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_4190":85686,"_34937":85676,"_5":35369,"_23830":143258,"_31422":143259,"_3630":143260},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_4190":85687,"_34937":85676,"_5":35369,"_23830":143262,"_31422":143263,"_3630":143264},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_4190":85688,"_34937":85676,"_23830":143266,"_5":16479,"_31422":85676,"_3630":143267},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_4190":85689,"_34937":85676,"_23830":143269,"_5":16479,"_31422":143232,"_3630":143270},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_4190":85690,"_34937":85676,"_23830":143272,"_5":16479,"_31422":143236,"_3630":143273},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_4190":85691,"_34937":85676,"_23830":143275,"_5":16479,"_31422":143240,"_3630":143276},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_4190":85692,"_34937":85676,"_23830":143278,"_5":16479,"_31422":143244,"_3630":143279},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_4190":85693,"_34937":85676,"_23830":143281,"_5":16479,"_31422":143248,"_3630":143282},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_4190":85694,"_34937":85676,"_23830":143284,"_5":16479,"_31422":143252,"_3630":143285},[],"Lamassu persiste cuatro estados X.509:",{"_4190":85695,"_34937":85676,"_23830":143287,"_5":16479,"_31422":143252,"_3630":143288},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_4190":85696,"_34937":85676,"_23830":143290,"_5":16479,"_31422":143252,"_3630":143291},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_4190":85697,"_34937":85676,"_23830":143293,"_5":16479,"_31422":143252,"_3630":143294},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_4190":85698,"_34937":85676,"_23830":143296,"_5":16479,"_31422":143252,"_3630":143297},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_4190":85699,"_34937":85676,"_23830":143299,"_5":16479,"_31422":143252,"_3630":143300},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_4190":85700,"_34937":85676,"_23830":143302,"_5":16479,"_31422":143255,"_3630":143303},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_4190":85701,"_34937":85676,"_23830":143305,"_5":16479,"_31422":143255,"_3630":143306},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_4190":85702,"_34937":85676,"_23830":143308,"_5":16479,"_31422":143255,"_3630":143309},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_4190":85703,"_34937":85676,"_23830":143311,"_5":16479,"_31422":143259,"_3630":143312},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_4190":85704,"_34937":85676,"_23830":143314,"_5":16479,"_31422":143259,"_3630":143315},[],"Antes de confirmar:",{"_4190":85705,"_34937":85676,"_23830":143317,"_5":16479,"_31422":143259,"_3630":143318},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_4190":85706,"_34937":85676,"_23830":143320,"_5":16479,"_31422":143259,"_3630":143321},[],"Distribuye la nueva cadena de confianza.",{"_4190":85707,"_34937":85676,"_23830":143323,"_5":16479,"_31422":143259,"_3630":143324},[],"Reemite las identidades necesarias.",{"_4190":85708,"_34937":85676,"_23830":143326,"_5":16479,"_31422":143259,"_3630":143327},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_4190":85709,"_34937":85676,"_23830":143329,"_5":16479,"_31422":143259,"_3630":143330},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_4190":85710,"_34937":85676,"_23830":143332,"_5":16479,"_31422":143259,"_3630":143333},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_4190":85711,"_34937":85676,"_23830":143335,"_5":16479,"_31422":143263,"_3630":143336},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_4190":85712,"_34937":85676,"_23830":143338,"_5":16479,"_31422":143263,"_3630":143339},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_4190":85713,"_34937":85676,"_23830":143341,"_5":16479,"_31422":143263,"_3630":143342},[],"Cambios de estado y razones de revocación.",{"_4190":85714,"_34937":85676,"_23830":143344,"_5":16479,"_31422":143263,"_3630":143345},[],"Publicación y vigencia de OCSP y CRLs.",{"_4190":85715,"_34937":85676,"_23830":143347,"_5":16479,"_31422":143263,"_3630":143348},[],"Dependencias que todavía presentan un certificado sustituido.",{"_4190":85716,"_34937":85676,"_23830":143350,"_5":16479,"_31422":143263,"_3630":143351},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_4190":85717,"_34937":85717,"_5":16871,"_3630":143353,"_35372":143354,"_23830":143355,"_31422":85717},"Modelo de confianza",[58062,138452,63542,143221],[],{"_4190":85718,"_34937":85717,"_23830":143357,"_5":16479,"_31422":85717,"_3630":143358},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_4190":85719,"_34937":85717,"_5":35369,"_23830":143360,"_31422":143361,"_3630":143362},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_4190":85720,"_34937":85717,"_5":35369,"_23830":143364,"_31422":143365,"_3630":143366},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_4190":85721,"_34937":85717,"_5":35369,"_23830":143368,"_31422":143369,"_3630":143370},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_4190":85722,"_34937":85717,"_5":35369,"_23830":143372,"_31422":143373,"_3630":143374},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_4190":85723,"_34937":85717,"_5":35369,"_23830":143376,"_31422":143377,"_3630":143378},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_4190":85724,"_34937":85717,"_5":35369,"_23830":143380,"_31422":143381,"_3630":143382},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_4190":85725,"_34937":85717,"_5":35369,"_23830":143384,"_31422":143385,"_3630":143386},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_4190":85726,"_34937":85717,"_5":35369,"_23830":143388,"_31422":143389,"_3630":143390},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_4190":85727,"_34937":85717,"_5":35369,"_23830":143392,"_31422":143393,"_3630":143394},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_4190":85728,"_34937":85717,"_5":35369,"_23830":143396,"_31422":143397,"_3630":143398},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_4190":85729,"_34937":85717,"_23830":143400,"_5":16479,"_31422":85717,"_3630":143401},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_4190":85730,"_34937":85717,"_23830":143403,"_5":16479,"_31422":143365,"_3630":143404},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_4190":85731,"_34937":85717,"_23830":143406,"_5":16479,"_31422":143369,"_3630":143407},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_4190":85732,"_34937":85717,"_23830":143409,"_5":16479,"_31422":143373,"_3630":143410},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_4190":85733,"_34937":85717,"_23830":143412,"_5":16479,"_31422":143377,"_3630":143413},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_4190":85734,"_34937":85717,"_23830":143415,"_5":16479,"_31422":143381,"_3630":143416},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_4190":85735,"_34937":85717,"_23830":143418,"_5":16479,"_31422":143381,"_3630":143419},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_4190":85736,"_34937":85717,"_23830":143421,"_5":16479,"_31422":143381,"_3630":143422},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_4190":85737,"_34937":85717,"_23830":143424,"_5":16479,"_31422":143381,"_3630":143425},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_4190":85738,"_34937":85717,"_23830":143427,"_5":16479,"_31422":143381,"_3630":143428},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_4190":85739,"_34937":85717,"_23830":143430,"_5":16479,"_31422":143381,"_3630":143431},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_4190":85740,"_34937":85717,"_23830":143433,"_5":16479,"_31422":143385,"_3630":143434},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_4190":85741,"_34937":85717,"_23830":143436,"_5":16479,"_31422":143385,"_3630":143437},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_4190":85742,"_34937":85717,"_23830":143439,"_5":16479,"_31422":143385,"_3630":143440},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_4190":85743,"_34937":85717,"_23830":143442,"_5":16479,"_31422":143385,"_3630":143443},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_4190":85744,"_34937":85717,"_23830":143445,"_5":16479,"_31422":143385,"_3630":143446},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_4190":85745,"_34937":85717,"_23830":143448,"_5":16479,"_31422":143389,"_3630":143449},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_4190":85746,"_34937":85717,"_23830":143451,"_5":16479,"_31422":143389,"_3630":143452},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_4190":85747,"_34937":85717,"_23830":143454,"_5":16479,"_31422":143389,"_3630":143455},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_4190":85748,"_34937":85717,"_23830":143457,"_5":16479,"_31422":143389,"_3630":143458},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_4190":85749,"_34937":85717,"_23830":143460,"_5":16479,"_31422":143389,"_3630":143461},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_4190":85750,"_34937":85717,"_23830":143463,"_5":16479,"_31422":143389,"_3630":143464},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_4190":85751,"_34937":85717,"_23830":143466,"_5":16479,"_31422":143389,"_3630":143467},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_4190":85752,"_34937":85717,"_23830":143469,"_5":16479,"_31422":143393,"_3630":143470},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_4190":85753,"_34937":85717,"_23830":143472,"_5":16479,"_31422":143397,"_3630":143473},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_4190":85754,"_34937":85717,"_23830":143475,"_5":16479,"_31422":143397,"_3630":143476},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_4190":85755,"_34937":85717,"_23830":143478,"_5":16479,"_31422":143397,"_3630":143479},[],"Asigna perfiles explícitos a cada caso de uso.",{"_4190":85756,"_34937":85717,"_23830":143481,"_5":16479,"_31422":143397,"_3630":143482},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_4190":85757,"_34937":85717,"_23830":143484,"_5":16479,"_31422":143397,"_3630":143485},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_4190":85758,"_34937":85717,"_23830":143487,"_5":16479,"_31422":143397,"_3630":143488},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_4190":85759,"_34937":85717,"_23830":143490,"_5":16479,"_31422":143397,"_3630":143491},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_4190":85760,"_34937":85760,"_5":16871,"_3630":143493,"_35372":143494,"_23830":143495,"_31422":85760},"Listas de revocación (CRL)",[58062,138452,63542,142967],[],{"_4190":85761,"_34937":85760,"_23830":143497,"_5":16479,"_31422":85760,"_3630":143498},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_4190":85762,"_34937":85760,"_5":35369,"_23830":143500,"_31422":143501,"_3630":143502},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_4190":85763,"_34937":85760,"_5":35369,"_23830":143504,"_31422":143505,"_3630":143506},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_4190":85764,"_34937":85760,"_5":35369,"_23830":143508,"_31422":143509,"_3630":143510},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_4190":85765,"_34937":85760,"_5":35369,"_23830":143512,"_31422":143513,"_3630":143514},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_4190":85766,"_34937":85760,"_5":35369,"_23830":143516,"_31422":143517,"_3630":143518},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_4190":85767,"_34937":85760,"_5":35369,"_23830":143520,"_31422":143521,"_3630":143522},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_4190":85768,"_34937":85760,"_5":35369,"_23830":143524,"_31422":143525,"_3630":143526},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_4190":85769,"_34937":85760,"_5":35369,"_23830":143528,"_31422":143529,"_3630":143530},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_4190":85770,"_34937":85760,"_5":35369,"_23830":143532,"_31422":143533,"_3630":143534},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#referencias","Referencias",{"_4190":85771,"_34937":85760,"_23830":143536,"_5":16479,"_31422":85760,"_3630":143537},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_4190":85772,"_34937":85760,"_23830":143539,"_5":16479,"_31422":143501,"_3630":143540},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_4190":85773,"_34937":85760,"_23830":143542,"_5":16479,"_31422":143501,"_3630":143543},[],"Campo",{"_4190":85774,"_34937":85760,"_23830":143545,"_5":16479,"_31422":143501,"_3630":139993},[],{"_4190":85775,"_34937":85760,"_23830":143547,"_5":16479,"_31422":143501,"_3630":64764},[],{"_4190":85776,"_34937":85760,"_23830":143549,"_5":16479,"_31422":143501,"_3630":143550},[],"ID de la CA a la que pertenecen los ajustes.",{"_4190":85777,"_34937":85760,"_23830":143552,"_5":16479,"_31422":143501,"_3630":64770},[],{"_4190":85778,"_34937":85760,"_23830":143554,"_5":16479,"_31422":143501,"_3630":143555},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_4190":85779,"_34937":85760,"_23830":143557,"_5":16479,"_31422":143501,"_3630":64776},[],{"_4190":85780,"_34937":85760,"_23830":143559,"_5":16479,"_31422":143501,"_3630":143560},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_4190":85781,"_34937":85760,"_23830":143562,"_5":16479,"_31422":143501,"_3630":64782},[],{"_4190":85782,"_34937":85760,"_23830":143564,"_5":16479,"_31422":143501,"_3630":143565},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_4190":85783,"_34937":85760,"_23830":143567,"_5":16479,"_31422":143501,"_3630":143568},[],"Campo de `crl_options`",{"_4190":85784,"_34937":85760,"_23830":143570,"_5":16479,"_31422":143501,"_3630":139993},[],{"_4190":85785,"_34937":85760,"_23830":143572,"_5":16479,"_31422":143501,"_3630":143573},[],"Valor inicial",{"_4190":85786,"_34937":85760,"_23830":143575,"_5":16479,"_31422":143501,"_3630":64796},[],{"_4190":85787,"_34937":85760,"_23830":143577,"_5":16479,"_31422":143501,"_3630":143578},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_4190":85788,"_34937":85760,"_23830":143580,"_5":16479,"_31422":143501,"_3630":143581},[],"7 días.",{"_4190":85789,"_34937":85760,"_23830":143583,"_5":16479,"_31422":143501,"_3630":64805},[],{"_4190":85790,"_34937":85760,"_23830":143585,"_5":16479,"_31422":143501,"_3630":143586},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_4190":85791,"_34937":85760,"_23830":143588,"_5":16479,"_31422":143501,"_3630":143589},[],"6 días y 23 horas.",{"_4190":85792,"_34937":85760,"_23830":143591,"_5":16479,"_31422":143501,"_3630":64814},[],{"_4190":85793,"_34937":85760,"_23830":143593,"_5":16479,"_31422":143501,"_3630":143594},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_4190":85794,"_34937":85760,"_23830":143596,"_5":16479,"_31422":143501,"_3630":64820},[],{"_4190":85795,"_34937":85760,"_23830":143598,"_5":16479,"_31422":143501,"_3630":64823},[],{"_4190":85796,"_34937":85760,"_23830":143600,"_5":16479,"_31422":143501,"_3630":143601},[],"Número de serie del certificado existente que firma la CRL.",{"_4190":85797,"_34937":85760,"_23830":143603,"_5":16479,"_31422":143501,"_3630":143604},[],"Número de serie del certificado actual de la CA.",{"_4190":85798,"_34937":85760,"_23830":143606,"_5":16479,"_31422":143501,"_3630":143607},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_4190":85799,"_34937":85760,"_23830":143609,"_5":16479,"_31422":143501,"_3630":143610},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_4190":85800,"_34937":85760,"_23830":143612,"_5":16479,"_31422":143501,"_3630":143613},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_4190":85801,"_34937":85760,"_23830":143615,"_5":16479,"_31422":143501,"_3630":143616},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_4190":85802,"_34937":85760,"_23830":143618,"_5":16479,"_31422":143501,"_3630":143619},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_4190":85803,"_34937":85760,"_23830":143621,"_5":16479,"_31422":143501,"_3630":143622},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_4190":85804,"_34937":85760,"_23830":143624,"_5":16479,"_31422":143501,"_3630":143625},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_4190":85805,"_34937":85760,"_23830":143627,"_5":16479,"_31422":143501,"_3630":143628},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_4190":85806,"_34937":85760,"_23830":143630,"_5":16479,"_31422":143501,"_3630":143631},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_4190":85807,"_34937":85760,"_23830":143633,"_5":16479,"_31422":143501,"_3630":143634},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_4190":85808,"_34937":85760,"_23830":143636,"_5":16479,"_31422":143505,"_3630":143637},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_4190":85809,"_34937":85760,"_23830":143639,"_5":16479,"_31422":143505,"_3630":143640},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_4190":85810,"_34937":85760,"_23830":143642,"_5":16479,"_31422":143505,"_3630":143643},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_4190":85811,"_34937":85760,"_23830":143645,"_5":16479,"_31422":143505,"_3630":143646},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_4190":85812,"_34937":85760,"_23830":143648,"_5":16479,"_31422":143509,"_3630":143649},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_4190":85813,"_34937":85760,"_23830":143651,"_5":16479,"_31422":143509,"_3630":143652},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_4190":85814,"_34937":85760,"_23830":143654,"_5":16479,"_31422":143509,"_3630":143655},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_4190":85815,"_34937":85760,"_23830":143657,"_5":16479,"_31422":143509,"_3630":143658},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_4190":85816,"_34937":85760,"_23830":143660,"_5":16479,"_31422":143509,"_3630":143661},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_4190":85817,"_34937":85760,"_23830":143663,"_5":16479,"_31422":143509,"_3630":143664},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_4190":85818,"_34937":85760,"_23830":143666,"_5":16479,"_31422":143509,"_3630":143667},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_4190":85819,"_34937":85760,"_23830":143669,"_5":16479,"_31422":143509,"_3630":143670},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_4190":85820,"_34937":85760,"_23830":143672,"_5":16479,"_31422":143509,"_3630":143673},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_4190":85821,"_34937":85760,"_23830":143675,"_5":16479,"_31422":143513,"_3630":143676},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_4190":85822,"_34937":85760,"_23830":143678,"_5":16479,"_31422":143513,"_3630":143679},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_4190":85823,"_34937":85760,"_23830":143681,"_5":16479,"_31422":143517,"_3630":143682},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_4190":85824,"_34937":85760,"_23830":143684,"_5":16479,"_31422":143517,"_3630":143685},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_4190":85825,"_34937":85760,"_23830":143687,"_5":16479,"_31422":143517,"_3630":143688},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_4190":85826,"_34937":85760,"_23830":143690,"_5":16479,"_31422":143517,"_3630":143691},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_4190":85827,"_34937":85760,"_23830":143693,"_5":16479,"_31422":143517,"_3630":143694},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_4190":85828,"_34937":85760,"_23830":143696,"_5":16479,"_31422":143521,"_3630":143697},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_4190":85829,"_34937":85760,"_23830":143699,"_5":16479,"_31422":143521,"_3630":140182},[],{"_4190":85830,"_34937":85760,"_23830":143701,"_5":16479,"_31422":143521,"_3630":143702},[],"Path relativo",{"_4190":85831,"_34937":85760,"_23830":143704,"_5":16479,"_31422":143521,"_3630":138212},[],{"_4190":85832,"_34937":85760,"_23830":143706,"_5":16479,"_31422":143521,"_3630":64932},[],{"_4190":85833,"_34937":85760,"_23830":143708,"_5":16479,"_31422":143521,"_3630":64935},[],{"_4190":85834,"_34937":85760,"_23830":143710,"_5":16479,"_31422":143521,"_3630":143711},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_4190":85835,"_34937":85760,"_23830":143713,"_5":16479,"_31422":143521,"_3630":64932},[],{"_4190":85836,"_34937":85760,"_23830":143715,"_5":16479,"_31422":143521,"_3630":64943},[],{"_4190":85837,"_34937":85760,"_23830":143717,"_5":16479,"_31422":143521,"_3630":143718},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_4190":85838,"_34937":85760,"_23830":143720,"_5":16479,"_31422":143521,"_3630":64949},[],{"_4190":85839,"_34937":85760,"_23830":143722,"_5":16479,"_31422":143521,"_3630":64943},[],{"_4190":85840,"_34937":85760,"_23830":143724,"_5":16479,"_31422":143521,"_3630":143725},[],"Sustituir la configuración de CRL de una CA.",{"_4190":85841,"_34937":85760,"_23830":143727,"_5":16479,"_31422":143521,"_3630":143728},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_4190":85842,"_34937":85760,"_23830":143730,"_5":16479,"_31422":143521,"_3630":143731},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_4190":85843,"_34937":85760,"_23830":143733,"_5":16479,"_31422":143525,"_3630":143734},[],"Síntoma",{"_4190":85844,"_34937":85760,"_23830":143736,"_5":16479,"_31422":143525,"_3630":143737},[],"Causa",{"_4190":85845,"_34937":85760,"_23830":143739,"_5":16479,"_31422":143525,"_3630":143740},[],"Acción",{"_4190":85846,"_34937":85760,"_23830":143742,"_5":16479,"_31422":143525,"_3630":143743},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_4190":85847,"_34937":85760,"_23830":143745,"_5":16479,"_31422":143525,"_3630":143746},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_4190":85848,"_34937":85760,"_23830":143748,"_5":16479,"_31422":143525,"_3630":143749},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_4190":85849,"_34937":85760,"_23830":143751,"_5":16479,"_31422":143525,"_3630":143752},[],"`PUT` devuelve 400.",{"_4190":85850,"_34937":85760,"_23830":143754,"_5":16479,"_31422":143525,"_3630":143755},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_4190":85851,"_34937":85760,"_23830":143757,"_5":16479,"_31422":143525,"_3630":143758},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_4190":85852,"_34937":85760,"_23830":143760,"_5":16479,"_31422":143525,"_3630":143761},[],"`PUT` devuelve 404.",{"_4190":85853,"_34937":85760,"_23830":143763,"_5":16479,"_31422":143525,"_3630":143764},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_4190":85854,"_34937":85760,"_23830":143766,"_5":16479,"_31422":143525,"_3630":143767},[],"Revisa el ID de CA y el número de serie del firmante.",{"_4190":85855,"_34937":85760,"_23830":143769,"_5":16479,"_31422":143525,"_3630":143770},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_4190":85856,"_34937":85760,"_23830":143772,"_5":16479,"_31422":143525,"_3630":143773},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_4190":85857,"_34937":85760,"_23830":143775,"_5":16479,"_31422":143525,"_3630":143776},[],"Actualiza el cliente para enviar el campo nuevo.",{"_4190":85858,"_34937":85760,"_23830":143778,"_5":16479,"_31422":143525,"_3630":143779},[],"La CRL no cambia tras revocar un certificado.",{"_4190":85859,"_34937":85760,"_23830":143781,"_5":16479,"_31422":143525,"_3630":143782},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_4190":85860,"_34937":85760,"_23830":143784,"_5":16479,"_31422":143525,"_3630":143785},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_4190":85861,"_34937":85760,"_23830":143787,"_5":16479,"_31422":143525,"_3630":143788},[],"Un verificador rechaza la CRL por el emisor.",{"_4190":85862,"_34937":85760,"_23830":143790,"_5":16479,"_31422":143525,"_3630":143791},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_4190":85863,"_34937":85760,"_23830":143793,"_5":16479,"_31422":143525,"_3630":143794},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_4190":85864,"_34937":85760,"_23830":143796,"_5":16479,"_31422":143529,"_3630":143797},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_4190":85865,"_34937":85760,"_23830":143799,"_5":16479,"_31422":143533,"_3630":143800},[],"RFC 5280: perfil X.509 y CRL.",{"_4190":85866,"_34937":85760,"_23830":143802,"_5":16479,"_31422":143533,"_3630":65032},[],{"_4190":85867,"_34937":85760,"_23830":143804,"_5":16479,"_31422":143533,"_3630":65035},[],{"_4190":85868,"_34937":85760,"_23830":143806,"_5":16479,"_31422":143533,"_3630":143807},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_4190":85869,"_34937":85760,"_23830":143809,"_5":16479,"_31422":143533,"_3630":143810},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_4190":85870,"_34937":85870,"_5":16871,"_3630":143812,"_35372":143813,"_23830":143814,"_31422":85870},"Claves y motores criptográficos",[58062,138452,63542,142330],[],{"_4190":85871,"_34937":85870,"_23830":143816,"_5":16479,"_31422":85870,"_3630":143817},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_4190":85872,"_34937":85870,"_5":35369,"_23830":143819,"_31422":143820,"_3630":143821},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_4190":85873,"_34937":85870,"_5":35369,"_23830":143823,"_31422":143824,"_3630":143825},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_4190":85874,"_34937":85870,"_5":35369,"_23830":143827,"_31422":143828,"_3630":65060},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#file-system",{"_4190":85875,"_34937":85870,"_5":35369,"_23830":143830,"_31422":143831,"_3630":65064},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#hashicorp-vault",{"_4190":85876,"_34937":85870,"_5":35369,"_23830":143833,"_31422":143834,"_3630":65068},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-secrets-manager",{"_4190":85877,"_34937":85870,"_5":35369,"_23830":143836,"_31422":143837,"_3630":65072},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-kms",{"_4190":85878,"_34937":85870,"_5":35369,"_23830":143839,"_31422":143840,"_3630":65076},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#pkcs11",{"_4190":85879,"_34937":85870,"_5":35369,"_23830":143842,"_31422":143843,"_3630":65080},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#azure-key-vault",{"_4190":85880,"_34937":85870,"_5":35369,"_23830":143845,"_31422":143846,"_3630":143847},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_4190":85881,"_34937":85870,"_5":35369,"_23830":143849,"_31422":143850,"_3630":143851},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_4190":85882,"_34937":85870,"_5":35369,"_23830":143853,"_31422":143854,"_3630":143855},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_4190":85883,"_34937":85870,"_5":35369,"_23830":143857,"_31422":143858,"_3630":143859},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_4190":85884,"_34937":85870,"_5":35369,"_23830":143861,"_31422":143862,"_3630":143863},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_4190":85885,"_34937":85870,"_5":35369,"_23830":143865,"_31422":143866,"_3630":143867},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_4190":85886,"_34937":85870,"_5":35369,"_23830":143869,"_31422":143870,"_3630":143871},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_4190":85887,"_34937":85870,"_5":35369,"_23830":143873,"_31422":143874,"_3630":65112},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#sign",{"_4190":85888,"_34937":85870,"_5":35369,"_23830":143876,"_31422":143877,"_3630":65116},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#verify",{"_4190":85889,"_34937":85870,"_5":35369,"_23830":143879,"_31422":143880,"_3630":143881},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_4190":85890,"_34937":85870,"_5":35369,"_23830":143883,"_31422":143884,"_3630":143885},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_4190":85891,"_34937":85870,"_5":35369,"_23830":143887,"_31422":143888,"_3630":143889},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_4190":85892,"_34937":85870,"_23830":143891,"_5":16479,"_31422":85870,"_3630":143892},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_4190":85893,"_34937":85870,"_23830":143894,"_5":16479,"_31422":85870,"_3630":143895},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_4190":85894,"_34937":85870,"_23830":143897,"_5":16479,"_31422":143820,"_3630":143898},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_4190":85895,"_34937":85870,"_23830":143900,"_5":16479,"_31422":143820,"_3630":143901},[],"En la práctica, permite:",{"_4190":85896,"_34937":85870,"_23830":143903,"_5":16479,"_31422":143820,"_3630":143904},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_4190":85897,"_34937":85870,"_23830":143906,"_5":16479,"_31422":143820,"_3630":143907},[],"Importar claves creadas externamente.",{"_4190":85898,"_34937":85870,"_23830":143909,"_5":16479,"_31422":143820,"_3630":143910},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_4190":85899,"_34937":85870,"_23830":143912,"_5":16479,"_31422":143820,"_3630":143913},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_4190":85900,"_34937":85870,"_23830":143915,"_5":16479,"_31422":143824,"_3630":143916},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_4190":85901,"_34937":85870,"_23830":143918,"_5":16479,"_31422":143824,"_3630":143919},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_4190":85902,"_34937":85870,"_23830":143921,"_5":16479,"_31422":143824,"_3630":143922},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_4190":85903,"_34937":85870,"_23830":143924,"_5":16479,"_31422":143828,"_3630":143925},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_4190":85904,"_34937":85870,"_23830":143927,"_5":16479,"_31422":143831,"_3630":143928},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_4190":85905,"_34937":85870,"_23830":143930,"_5":16479,"_31422":143831,"_3630":143931},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_4190":85906,"_34937":85870,"_23830":143933,"_5":16479,"_31422":143834,"_3630":143934},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_4190":85907,"_34937":85870,"_23830":143936,"_5":16479,"_31422":143837,"_3630":143937},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_4190":85908,"_34937":85870,"_23830":143939,"_5":16479,"_31422":143840,"_3630":143940},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_4190":85909,"_34937":85870,"_23830":143942,"_5":16479,"_31422":143843,"_3630":143943},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_4190":85910,"_34937":85870,"_23830":143945,"_5":16479,"_31422":143843,"_3630":143946},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_4190":85911,"_34937":85870,"_23830":143948,"_5":16479,"_31422":143843,"_3630":143949},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_4190":85912,"_34937":85870,"_23830":143951,"_5":16479,"_31422":143843,"_3630":143952},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_4190":85913,"_34937":85870,"_23830":143954,"_5":16479,"_31422":143846,"_3630":143955},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_4190":85914,"_34937":85870,"_23830":143957,"_5":16479,"_31422":143846,"_3630":143958},[],"La tabla incluye los siguientes campos:",{"_4190":85915,"_34937":85870,"_23830":143960,"_5":16479,"_31422":143846,"_3630":143961},[],"**Name**: nombre descriptivo de la clave.",{"_4190":85916,"_34937":85870,"_23830":143963,"_5":16479,"_31422":143846,"_3630":143964},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_4190":85917,"_34937":85870,"_23830":143966,"_5":16479,"_31422":143846,"_3630":143967},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_4190":85918,"_34937":85870,"_23830":143969,"_5":16479,"_31422":143846,"_3630":143970},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_4190":85919,"_34937":85870,"_23830":143972,"_5":16479,"_31422":143846,"_3630":143973},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_4190":85920,"_34937":85870,"_23830":143975,"_5":16479,"_31422":143846,"_3630":143976},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_4190":85921,"_34937":85870,"_23830":143978,"_5":16479,"_31422":143846,"_3630":143979},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_4190":85922,"_34937":85870,"_23830":143981,"_5":16479,"_31422":143846,"_3630":143982},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_4190":85923,"_34937":85870,"_23830":143984,"_5":16479,"_31422":143846,"_3630":143985},[],"Desde esta vista también se accede a las acciones más habituales:",{"_4190":85924,"_34937":85870,"_23830":143987,"_5":16479,"_31422":143846,"_3630":143988},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_4190":85925,"_34937":85870,"_23830":143990,"_5":16479,"_31422":143846,"_3630":143991},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_4190":85926,"_34937":85870,"_23830":143993,"_5":16479,"_31422":143846,"_3630":143994},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_4190":85927,"_34937":85870,"_23830":143996,"_5":16479,"_31422":143846,"_3630":143997},[],"**Delete Key** para eliminar la clave del sistema.",{"_4190":85928,"_34937":85870,"_23830":143999,"_5":16479,"_31422":143850,"_3630":144000},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_4190":85929,"_34937":85870,"_23830":144002,"_5":16479,"_31422":143854,"_3630":144003},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_4190":85930,"_34937":85870,"_23830":144005,"_5":16479,"_31422":143854,"_3630":144006},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_4190":85931,"_34937":85870,"_23830":144008,"_5":16479,"_31422":143854,"_3630":144009},[],"**Key Name**: nombre único y descriptivo.",{"_4190":85932,"_34937":85870,"_23830":144011,"_5":16479,"_31422":143854,"_3630":144012},[],"**Crypto Engine**: motor que custodiará la clave.",{"_4190":85933,"_34937":85870,"_23830":144014,"_5":16479,"_31422":143854,"_3630":144015},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_4190":85934,"_34937":85870,"_23830":144017,"_5":16479,"_31422":143854,"_3630":144018},[],"**Tags**: metadatos para clasificar la clave.",{"_4190":85935,"_34937":85870,"_23830":144020,"_5":16479,"_31422":143854,"_3630":144021},[],"**Metadata**: información adicional para usos avanzados.",{"_4190":85936,"_34937":85870,"_23830":144023,"_5":16479,"_31422":143858,"_3630":144024},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_4190":85937,"_34937":85870,"_23830":144026,"_5":16479,"_31422":143858,"_3630":144027},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_4190":85938,"_34937":85870,"_23830":144029,"_5":16479,"_31422":143858,"_3630":144030},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_4190":85939,"_34937":85870,"_23830":144032,"_5":16479,"_31422":143858,"_3630":144033},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_4190":85940,"_34937":85870,"_23830":144035,"_5":16479,"_31422":143858,"_3630":144036},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_4190":85941,"_34937":85870,"_23830":144038,"_5":16479,"_31422":143858,"_3630":144039},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_4190":85942,"_34937":85870,"_23830":144041,"_5":16479,"_31422":143858,"_3630":144042},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_4190":85943,"_34937":85870,"_23830":144044,"_5":16479,"_31422":143858,"_3630":144045},[],"**Tags**: etiquetas para organización y búsqueda.",{"_4190":85944,"_34937":85870,"_23830":144047,"_5":16479,"_31422":143858,"_3630":144048},[],"**Metadata**: información adicional opcional.",{"_4190":85945,"_34937":85870,"_23830":144050,"_5":16479,"_31422":143858,"_3630":144051},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_4190":85946,"_34937":85870,"_23830":144053,"_5":16479,"_31422":143858,"_3630":144054},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_4190":85947,"_34937":85870,"_23830":144056,"_5":16479,"_31422":143862,"_3630":144057},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_4190":85948,"_34937":85870,"_23830":144059,"_5":16479,"_31422":143866,"_3630":144060},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_4190":85949,"_34937":85870,"_23830":144062,"_5":16479,"_31422":143866,"_3630":144063},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_4190":85950,"_34937":85870,"_23830":144065,"_5":16479,"_31422":143866,"_3630":144066},[],"**Key Name**: nombre descriptivo.",{"_4190":85951,"_34937":85870,"_23830":144068,"_5":16479,"_31422":143866,"_3630":144069},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_4190":85952,"_34937":85870,"_23830":144071,"_5":16479,"_31422":143866,"_3630":144072},[],"**Tags**: etiquetas asociadas.",{"_4190":85953,"_34937":85870,"_23830":144074,"_5":16479,"_31422":143866,"_3630":144075},[],"**Aliases**: nombres alternativos.",{"_4190":85954,"_34937":85870,"_23830":144077,"_5":16479,"_31422":143866,"_3630":144078},[],"**Crypto Engine**: motor en el que reside la clave.",{"_4190":85955,"_34937":85870,"_23830":144080,"_5":16479,"_31422":143866,"_3630":144081},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_4190":85956,"_34937":85870,"_23830":144083,"_5":16479,"_31422":143866,"_3630":144084},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_4190":85957,"_34937":85870,"_23830":144086,"_5":16479,"_31422":143866,"_3630":144087},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_4190":85958,"_34937":85870,"_23830":144089,"_5":16479,"_31422":143870,"_3630":144090},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_4190":85959,"_34937":85870,"_23830":144092,"_5":16479,"_31422":143870,"_3630":144093},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_4190":85960,"_34937":85870,"_23830":144095,"_5":16479,"_31422":143870,"_3630":144096},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_4190":85961,"_34937":85870,"_23830":144098,"_5":16479,"_31422":143874,"_3630":144099},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_4190":85962,"_34937":85870,"_23830":144101,"_5":16479,"_31422":143874,"_3630":144102},[],"Campos principales:",{"_4190":85963,"_34937":85870,"_23830":144104,"_5":16479,"_31422":143874,"_3630":144105},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_4190":85964,"_34937":85870,"_23830":144107,"_5":16479,"_31422":143874,"_3630":144108},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_4190":85965,"_34937":85870,"_23830":144110,"_5":16479,"_31422":143874,"_3630":144111},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_4190":85966,"_34937":85870,"_23830":144113,"_5":16479,"_31422":143874,"_3630":144114},[],"**Message**: contenido que se va a firmar.",{"_4190":85967,"_34937":85870,"_23830":144116,"_5":16479,"_31422":143874,"_3630":144117},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_4190":85968,"_34937":85870,"_23830":144119,"_5":16479,"_31422":143877,"_3630":144120},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_4190":85969,"_34937":85870,"_23830":144122,"_5":16479,"_31422":143877,"_3630":144102},[],{"_4190":85970,"_34937":85870,"_23830":144124,"_5":16479,"_31422":143877,"_3630":144125},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_4190":85971,"_34937":85870,"_23830":144127,"_5":16479,"_31422":143877,"_3630":144128},[],"**Message Type**: `Raw` o `Digest`.",{"_4190":85972,"_34937":85870,"_23830":144130,"_5":16479,"_31422":143877,"_3630":144131},[],"**Payload Encoding**: codificación del mensaje.",{"_4190":85973,"_34937":85870,"_23830":144133,"_5":16479,"_31422":143877,"_3630":144134},[],"**Message**: mensaje original o hash.",{"_4190":85974,"_34937":85870,"_23830":144136,"_5":16479,"_31422":143877,"_3630":144137},[],"**Signature**: firma que se desea comprobar.",{"_4190":85975,"_34937":85870,"_23830":144139,"_5":16479,"_31422":143877,"_3630":144140},[],"**Result**: indicador del resultado de la validación.",{"_4190":85976,"_34937":85870,"_23830":144142,"_5":16479,"_31422":143880,"_3630":144143},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_4190":85977,"_34937":85870,"_23830":144145,"_5":16479,"_31422":143880,"_3630":144146},[],"Este flujo es útil para:",{"_4190":85978,"_34937":85870,"_23830":144148,"_5":16479,"_31422":143880,"_3630":144149},[],"Solicitar certificados a una CA externa.",{"_4190":85979,"_34937":85870,"_23830":144151,"_5":16479,"_31422":143880,"_3630":144152},[],"Renovar una identidad manteniendo la misma clave.",{"_4190":85980,"_34937":85870,"_23830":144154,"_5":16479,"_31422":143880,"_3630":144155},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_4190":85981,"_34937":85870,"_23830":144157,"_5":16479,"_31422":143880,"_3630":144158},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_4190":85982,"_34937":85870,"_23830":144160,"_5":16479,"_31422":143880,"_3630":144161},[],"**Organization (O)**: organización o empresa.",{"_4190":85983,"_34937":85870,"_23830":144163,"_5":16479,"_31422":143880,"_3630":144164},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_4190":85984,"_34937":85870,"_23830":144166,"_5":16479,"_31422":143880,"_3630":144167},[],"**Country (C)**: código de país de dos letras.",{"_4190":85985,"_34937":85870,"_23830":144169,"_5":16479,"_31422":143880,"_3630":144170},[],"**State / Province (ST)**: estado o provincia.",{"_4190":85986,"_34937":85870,"_23830":144172,"_5":16479,"_31422":143880,"_3630":144173},[],"**Locality (L)**: ciudad o localidad.",{"_4190":85987,"_34937":85870,"_23830":144175,"_5":16479,"_31422":143880,"_3630":144176},[],"**Email Address**: correo de contacto.",{"_4190":85988,"_34937":85870,"_23830":144178,"_5":16479,"_31422":143880,"_3630":144179},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_4190":85989,"_34937":85870,"_23830":144181,"_5":16479,"_31422":143880,"_3630":144182},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_4190":85990,"_34937":85870,"_23830":144184,"_5":16479,"_31422":143884,"_3630":144185},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_4190":85991,"_34937":85870,"_23830":144187,"_5":16479,"_31422":143884,"_3630":144188},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_4190":85992,"_34937":85870,"_23830":144190,"_5":16479,"_31422":143888,"_3630":144191},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_4190":85993,"_34937":85870,"_23830":144193,"_5":16479,"_31422":143888,"_3630":144194},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_4190":85994,"_34937":85994,"_5":16871,"_3630":144196,"_35372":144197,"_23830":144198,"_31422":85994},"Validación online con OCSP",[58062,138452,63542,142967],[],{"_4190":85995,"_34937":85994,"_23830":144200,"_5":16479,"_31422":85994,"_3630":144201},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_4190":85996,"_34937":85994,"_5":35369,"_23830":144203,"_31422":144204,"_3630":144205},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_4190":85997,"_34937":85994,"_5":35369,"_23830":144207,"_31422":144208,"_3630":144209},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_4190":85998,"_34937":85994,"_5":35369,"_23830":144211,"_31422":144212,"_3630":144213},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_4190":85999,"_34937":85994,"_5":35369,"_23830":144215,"_31422":144216,"_3630":144217},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_4190":86000,"_34937":85994,"_5":35369,"_23830":144219,"_31422":144220,"_3630":144221},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_4190":86001,"_34937":85994,"_5":35369,"_23830":144223,"_31422":144224,"_3630":143534},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#referencias",{"_4190":86002,"_34937":85994,"_23830":144226,"_5":16479,"_31422":85994,"_3630":144227},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_4190":86003,"_34937":85994,"_23830":144229,"_5":16479,"_31422":144204,"_3630":144230},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_4190":86004,"_34937":85994,"_23830":144232,"_5":16479,"_31422":144204,"_3630":144233},[],"Estado del registro",{"_4190":86005,"_34937":85994,"_23830":144235,"_5":16479,"_31422":144204,"_3630":144236},[],"Respuesta firmada",{"_4190":86006,"_34937":85994,"_23830":144238,"_5":16479,"_31422":144204,"_3630":62679},[],{"_4190":86007,"_34937":85994,"_23830":144240,"_5":16479,"_31422":144204,"_3630":65480},[],{"_4190":86008,"_34937":85994,"_23830":144242,"_5":16479,"_31422":144204,"_3630":62696},[],{"_4190":86009,"_34937":85994,"_23830":144244,"_5":16479,"_31422":144204,"_3630":144245},[],"`Revoked`, con razón y fecha de revocación.",{"_4190":86010,"_34937":85994,"_23830":144247,"_5":16479,"_31422":144204,"_3630":144248},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_4190":86011,"_34937":85994,"_23830":144250,"_5":16479,"_31422":144204,"_3630":144251},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_4190":86012,"_34937":85994,"_23830":144253,"_5":16479,"_31422":144204,"_3630":144254},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_4190":86013,"_34937":85994,"_23830":144256,"_5":16479,"_31422":144204,"_3630":144257},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_4190":86014,"_34937":85994,"_23830":144259,"_5":16479,"_31422":144204,"_3630":144260},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_4190":86015,"_34937":85994,"_23830":144262,"_5":16479,"_31422":144208,"_3630":144263},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_4190":86016,"_34937":85994,"_23830":144265,"_5":16479,"_31422":144208,"_3630":144266},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_4190":86017,"_34937":85994,"_23830":144268,"_5":16479,"_31422":144212,"_3630":144269},[],"El servicio acepta:",{"_4190":86018,"_34937":85994,"_23830":144271,"_5":16479,"_31422":144212,"_3630":140182},[],{"_4190":86019,"_34937":85994,"_23830":144273,"_5":16479,"_31422":144212,"_3630":144274},[],"Ruta del servicio VA",{"_4190":86020,"_34937":85994,"_23830":144276,"_5":16479,"_31422":144212,"_3630":144277},[],"Formato",{"_4190":86021,"_34937":85994,"_23830":144279,"_5":16479,"_31422":144212,"_3630":65520},[],{"_4190":86022,"_34937":85994,"_23830":144281,"_5":16479,"_31422":144212,"_3630":65523},[],{"_4190":86023,"_34937":85994,"_23830":144283,"_5":16479,"_31422":144212,"_3630":144284},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_4190":86024,"_34937":85994,"_23830":144286,"_5":16479,"_31422":144212,"_3630":64932},[],{"_4190":86025,"_34937":85994,"_23830":144288,"_5":16479,"_31422":144212,"_3630":65531},[],{"_4190":86026,"_34937":85994,"_23830":144290,"_5":16479,"_31422":144212,"_3630":144291},[],"Solicitud DER codificada en Base64 URL con padding.",{"_4190":86027,"_34937":85994,"_23830":144293,"_5":16479,"_31422":144212,"_3630":144294},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_4190":86028,"_34937":85994,"_23830":144296,"_5":16479,"_31422":144216,"_3630":144297},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_4190":86029,"_34937":85994,"_23830":144299,"_5":16479,"_31422":144216,"_3630":144300},[],"Genera la solicitud:",{"_4190":86030,"_34937":85994,"_23830":144302,"_5":16479,"_31422":144216,"_3630":144303},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_4190":86031,"_34937":85994,"_23830":144305,"_5":16479,"_31422":144216,"_3630":144306},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_4190":86032,"_34937":85994,"_23830":144308,"_5":16479,"_31422":144216,"_3630":144309},[],"Verifica el DER recibido:",{"_4190":86033,"_34937":85994,"_23830":144311,"_5":16479,"_31422":144216,"_3630":144312},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_4190":86034,"_34937":85994,"_23830":144314,"_5":16479,"_31422":144220,"_3630":144315},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_4190":86035,"_34937":85994,"_23830":144317,"_5":16479,"_31422":144220,"_3630":144318},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_4190":86036,"_34937":85994,"_23830":144320,"_5":16479,"_31422":144224,"_3630":65564},[],{"_4190":86037,"_34937":85994,"_23830":144322,"_5":16479,"_31422":144224,"_3630":65567},[],{"_4190":86038,"_34937":85994,"_23830":144324,"_5":16479,"_31422":144224,"_3630":144325},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_4190":86039,"_34937":85994,"_23830":144327,"_5":16479,"_31422":144224,"_3630":143810},[],{"_4190":86040,"_34937":86040,"_5":16871,"_3630":63542,"_35372":144329,"_23830":144330,"_31422":86040},[58062,138452,63542],[],{"_4190":86041,"_34937":86040,"_23830":144332,"_5":16479,"_31422":86040,"_3630":144333},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_4190":86042,"_34937":86040,"_5":35369,"_23830":144335,"_31422":144336,"_3630":141656},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#empieza-aquí",{"_4190":86043,"_34937":86040,"_5":35369,"_23830":144338,"_31422":144339,"_3630":144340},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_4190":86044,"_34937":86040,"_5":35369,"_23830":144342,"_31422":144343,"_3630":142176},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#capacidades-principales",{"_4190":86045,"_34937":86040,"_5":35369,"_23830":144345,"_31422":144346,"_3630":142180},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_4190":86046,"_34937":86040,"_5":35369,"_23830":144348,"_31422":144349,"_3630":142184},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#protege-las-claves-criptográficas",{"_4190":86047,"_34937":86040,"_5":35369,"_23830":144351,"_31422":144352,"_3630":142188},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#emite-y-controla-certificados",{"_4190":86048,"_34937":86040,"_5":35369,"_23830":144354,"_31422":144355,"_3630":142196},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#publica-el-estado-de-validación",{"_4190":86049,"_34937":86040,"_5":35369,"_23830":144357,"_31422":144358,"_3630":144359},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_4190":86050,"_34937":86040,"_5":35369,"_23830":144361,"_31422":144362,"_3630":143133},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#continúa",{"_4190":86051,"_34937":86040,"_23830":144364,"_5":16479,"_31422":86040,"_3630":144365},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_4190":86052,"_34937":86040,"_23830":144367,"_5":16479,"_31422":144336,"_3630":144368},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_4190":86053,"_34937":86040,"_23830":144370,"_5":16479,"_31422":144336,"_3630":144371},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_4190":86054,"_34937":86040,"_23830":144373,"_5":16479,"_31422":144339,"_3630":144374},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_4190":86055,"_34937":86040,"_23830":144376,"_5":16479,"_31422":144339,"_3630":144377},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_4190":86056,"_34937":86040,"_23830":144379,"_5":16479,"_31422":144339,"_3630":144380},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_4190":86057,"_34937":86040,"_23830":144382,"_5":16479,"_31422":144339,"_3630":144383},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_4190":86058,"_34937":86040,"_23830":144385,"_5":16479,"_31422":144339,"_3630":144386},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_4190":86059,"_34937":86040,"_23830":144388,"_5":16479,"_31422":144346,"_3630":144389},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_4190":86060,"_34937":86040,"_23830":144391,"_5":16479,"_31422":144349,"_3630":144392},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_4190":86061,"_34937":86040,"_23830":144394,"_5":16479,"_31422":144352,"_3630":144395},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_4190":86062,"_34937":86040,"_23830":144397,"_5":16479,"_31422":144355,"_3630":144398},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_4190":86063,"_34937":86040,"_23830":144400,"_5":16479,"_31422":144358,"_3630":144401},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_4190":86064,"_34937":86040,"_23830":144403,"_5":16479,"_31422":144358,"_3630":144404},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_4190":86065,"_34937":86040,"_23830":144406,"_5":16479,"_31422":144358,"_3630":144407},[],"su clave pública corresponda a la clave privada del cliente;",{"_4190":86066,"_34937":86040,"_23830":144409,"_5":16479,"_31422":144358,"_3630":144410},[],"su cadena alcance una raíz confiable para el consumidor;",{"_4190":86067,"_34937":86040,"_23830":144412,"_5":16479,"_31422":144358,"_3630":144413},[],"sus fechas y usos permitan la operación;",{"_4190":86068,"_34937":86040,"_23830":144415,"_5":16479,"_31422":144358,"_3630":144416},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_4190":86069,"_34937":86040,"_23830":144418,"_5":16479,"_31422":144358,"_3630":144419},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_4190":86070,"_34937":86040,"_23830":144421,"_5":16479,"_31422":144362,"_3630":144422},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4190":86071,"_34937":86040,"_23830":144424,"_5":16479,"_31422":144362,"_3630":144425},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_4190":86072,"_34937":86040,"_23830":144427,"_5":16479,"_31422":144362,"_3630":144428},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_4190":86073,"_34937":86073,"_5":16871,"_3630":144430,"_35372":144431,"_23830":144432,"_31422":86073},"Crea tu primera CA",[58062,138452,63542,141780],[],{"_4190":86074,"_34937":86073,"_23830":144434,"_5":16479,"_31422":86073,"_3630":144435},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_4190":86075,"_34937":86073,"_5":35369,"_23830":144437,"_31422":144438,"_3630":137023},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_4190":86076,"_34937":86073,"_5":35369,"_23830":144440,"_31422":144441,"_3630":144442},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_4190":86077,"_34937":86073,"_5":35369,"_23830":144444,"_31422":144445,"_3630":144446},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_4190":86078,"_34937":86073,"_5":35369,"_23830":144448,"_31422":144449,"_3630":144450},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_4190":86079,"_34937":86073,"_5":35369,"_23830":144452,"_31422":144453,"_3630":144454},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_4190":86080,"_34937":86073,"_5":35369,"_23830":144456,"_31422":144457,"_3630":144458},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_4190":86081,"_34937":86073,"_5":35369,"_23830":144460,"_31422":144461,"_3630":144462},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_4190":86082,"_34937":86073,"_5":35369,"_23830":144464,"_31422":144465,"_3630":142027},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_4190":86083,"_34937":86073,"_5":35369,"_23830":144467,"_31422":144468,"_3630":137047},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_4190":86084,"_34937":86073,"_23830":144470,"_5":16479,"_31422":86073,"_3630":144471},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_4190":86085,"_34937":86073,"_23830":144473,"_5":16479,"_31422":144438,"_3630":144474},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_4190":86086,"_34937":86073,"_23830":144476,"_5":16479,"_31422":144438,"_3630":144477},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_4190":86087,"_34937":86073,"_23830":144479,"_5":16479,"_31422":144438,"_3630":144480},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_4190":86088,"_34937":86073,"_23830":144482,"_5":16479,"_31422":144438,"_3630":144483},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_4190":86089,"_34937":86073,"_23830":144485,"_5":16479,"_31422":144441,"_3630":144486},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_4190":86090,"_34937":86073,"_23830":144488,"_5":16479,"_31422":144441,"_3630":144489},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_4190":86091,"_34937":86073,"_23830":144491,"_5":16479,"_31422":144445,"_3630":144492},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_4190":86092,"_34937":86073,"_23830":144494,"_5":16479,"_31422":144445,"_3630":144495},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_4190":86093,"_34937":86073,"_23830":144497,"_5":16479,"_31422":144449,"_3630":144498},[],"Selecciona **Root CA** y completa:",{"_4190":86094,"_34937":86073,"_23830":144500,"_5":16479,"_31422":144449,"_3630":65746},[],{"_4190":86095,"_34937":86073,"_23830":144502,"_5":16479,"_31422":144449,"_3630":144503},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_4190":86096,"_34937":86073,"_23830":144505,"_5":16479,"_31422":144449,"_3630":144506},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_4190":86097,"_34937":86073,"_23830":144508,"_5":16479,"_31422":144449,"_3630":144509},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_4190":86098,"_34937":86073,"_23830":144511,"_5":16479,"_31422":144449,"_3630":144512},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_4190":86099,"_34937":86073,"_23830":144514,"_5":16479,"_31422":144453,"_3630":144515},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_4190":86100,"_34937":86073,"_23830":144517,"_5":16479,"_31422":144457,"_3630":144518},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_4190":86101,"_34937":86073,"_23830":144520,"_5":16479,"_31422":144457,"_3630":144521},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_4190":86102,"_34937":86073,"_23830":144523,"_5":16479,"_31422":144461,"_3630":144524},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_4190":86103,"_34937":86073,"_23830":144526,"_5":16479,"_31422":144461,"_3630":144527},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_4190":86104,"_34937":86073,"_23830":144529,"_5":16479,"_31422":144461,"_3630":144530},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_4190":86105,"_34937":86073,"_23830":144532,"_5":16479,"_31422":144465,"_3630":144533},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_4190":86106,"_34937":86073,"_23830":144535,"_5":16479,"_31422":144465,"_3630":144536},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_4190":86107,"_34937":86073,"_23830":144538,"_5":16479,"_31422":144465,"_3630":144539},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_4190":86108,"_34937":86073,"_23830":144541,"_5":16479,"_31422":144465,"_3630":144542},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_4190":86109,"_34937":86073,"_23830":144544,"_5":16479,"_31422":144468,"_3630":144545},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_4190":86110,"_34937":86110,"_5":16871,"_3630":144547,"_35372":144548,"_23830":144549,"_31422":86110},"Emite y verifica un certificado",[58062,138452,63542,141780],[],{"_4190":86111,"_34937":86110,"_23830":144551,"_5":16479,"_31422":86110,"_3630":144552},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_4190":86112,"_34937":86110,"_5":35369,"_23830":144554,"_31422":144555,"_3630":137023},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_4190":86113,"_34937":86110,"_5":35369,"_23830":144557,"_31422":144558,"_3630":144559},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_4190":86114,"_34937":86110,"_5":35369,"_23830":144561,"_31422":144562,"_3630":144563},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_4190":86115,"_34937":86110,"_5":35369,"_23830":144565,"_31422":144566,"_3630":144567},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_4190":86116,"_34937":86110,"_5":35369,"_23830":144569,"_31422":144570,"_3630":144571},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_4190":86117,"_34937":86110,"_5":35369,"_23830":144573,"_31422":144574,"_3630":144575},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_4190":86118,"_34937":86110,"_5":35369,"_23830":144577,"_31422":144578,"_3630":144579},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_4190":86119,"_34937":86110,"_5":35369,"_23830":144581,"_31422":144582,"_3630":144583},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_4190":86120,"_34937":86110,"_5":35369,"_23830":144585,"_31422":144586,"_3630":144587},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_4190":86121,"_34937":86110,"_5":35369,"_23830":144589,"_31422":144590,"_3630":144591},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_4190":86122,"_34937":86110,"_5":35369,"_23830":144593,"_31422":144594,"_3630":142027},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_4190":86123,"_34937":86110,"_5":35369,"_23830":144596,"_31422":144597,"_3630":137047},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_4190":86124,"_34937":86110,"_23830":144599,"_5":16479,"_31422":86110,"_3630":144600},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_4190":86125,"_34937":86110,"_23830":144602,"_5":16479,"_31422":144555,"_3630":144603},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_4190":86126,"_34937":86110,"_23830":144605,"_5":16479,"_31422":144555,"_3630":144606},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_4190":86127,"_34937":86110,"_23830":144608,"_5":16479,"_31422":144555,"_3630":144609},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_4190":86128,"_34937":86110,"_23830":144611,"_5":16479,"_31422":144555,"_3630":144612},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_4190":86129,"_34937":86110,"_23830":144614,"_5":16479,"_31422":144555,"_3630":144615},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_4190":86130,"_34937":86110,"_23830":144617,"_5":16479,"_31422":144558,"_3630":144618},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_4190":86131,"_34937":86110,"_23830":144620,"_5":16479,"_31422":144562,"_3630":144621},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_4190":86132,"_34937":86110,"_23830":144623,"_5":16479,"_31422":144562,"_3630":144624},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_4190":86133,"_34937":86110,"_23830":144626,"_5":16479,"_31422":144566,"_3630":144627},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_4190":86134,"_34937":86110,"_23830":144629,"_5":16479,"_31422":144566,"_3630":144630},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_4190":86135,"_34937":86110,"_23830":144632,"_5":16479,"_31422":144570,"_3630":144633},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_4190":86136,"_34937":86110,"_23830":144635,"_5":16479,"_31422":144570,"_3630":144636},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_4190":86137,"_34937":86110,"_23830":144638,"_5":16479,"_31422":144574,"_3630":144639},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_4190":86138,"_34937":86110,"_23830":144641,"_5":16479,"_31422":144578,"_3630":144642},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_4190":86139,"_34937":86110,"_23830":144644,"_5":16479,"_31422":144582,"_3630":144645},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_4190":86140,"_34937":86110,"_23830":144647,"_5":16479,"_31422":144586,"_3630":144648},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_4190":86141,"_34937":86110,"_23830":144650,"_5":16479,"_31422":144586,"_3630":144651},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_4190":86142,"_34937":86110,"_23830":144653,"_5":16479,"_31422":144586,"_3630":144654},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_4190":86143,"_34937":86110,"_23830":144656,"_5":16479,"_31422":144590,"_3630":144657},[],"En Bash, compara los dos resúmenes de clave pública:",{"_4190":86144,"_34937":86110,"_23830":144659,"_5":16479,"_31422":144590,"_3630":144660},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_4190":86145,"_34937":86110,"_23830":144662,"_5":16479,"_31422":144590,"_3630":144663},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_4190":86146,"_34937":86110,"_23830":144665,"_5":16479,"_31422":144594,"_3630":142110},[],{"_4190":86147,"_34937":86110,"_23830":144667,"_5":16479,"_31422":144594,"_3630":140631},[],{"_4190":86148,"_34937":86110,"_23830":144669,"_5":16479,"_31422":144594,"_3630":144670},[],"La CA rechaza la emisión",{"_4190":86149,"_34937":86110,"_23830":144672,"_5":16479,"_31422":144594,"_3630":144673},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_4190":86150,"_34937":86110,"_23830":144675,"_5":16479,"_31422":144594,"_3630":144676},[],"Sujeto o usos diferentes",{"_4190":86151,"_34937":86110,"_23830":144678,"_5":16479,"_31422":144594,"_3630":144679},[],"Perfil aplicado y valores solicitados.",{"_4190":86152,"_34937":86110,"_23830":144681,"_5":16479,"_31422":144594,"_3630":144682},[],"No se encuentra el emisor",{"_4190":86153,"_34937":86110,"_23830":144684,"_5":16479,"_31422":144594,"_3630":144685},[],"CA descargada y cadena intermedia necesaria.",{"_4190":86154,"_34937":86110,"_23830":144687,"_5":16479,"_31422":144594,"_3630":144688},[],"Falla la vigencia",{"_4190":86155,"_34937":86110,"_23830":144690,"_5":16479,"_31422":144594,"_3630":144691},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_4190":86156,"_34937":86110,"_23830":144693,"_5":16479,"_31422":144594,"_3630":144694},[],"Los resúmenes de clave difieren",{"_4190":86157,"_34937":86110,"_23830":144696,"_5":16479,"_31422":144594,"_3630":144697},[],"Archivos de certificado y clave de la misma emisión.",{"_4190":86158,"_34937":86110,"_23830":144699,"_5":16479,"_31422":144594,"_3630":144700},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_4190":86159,"_34937":86110,"_23830":144702,"_5":16479,"_31422":144597,"_3630":144703},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_4190":86160,"_34937":86110,"_23830":144705,"_5":16479,"_31422":144597,"_3630":144706},[],"Gestionar certificados para inspección, estado y revocación.",{"_4190":86161,"_34937":86110,"_23830":144708,"_5":16479,"_31422":144597,"_3630":144709},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_4190":86162,"_34937":86110,"_23830":144711,"_5":16479,"_31422":144597,"_3630":144712},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_4190":86163,"_34937":86110,"_23830":144714,"_5":16479,"_31422":144597,"_3630":144715},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_4190":86164,"_34937":86164,"_5":16871,"_3630":144717,"_35372":144718,"_23830":144719,"_31422":86164},"Primeros pasos de PKI",[58062,138452,63542,141780],[],{"_4190":86165,"_34937":86164,"_23830":144721,"_5":16479,"_31422":86164,"_3630":144722},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_4190":86166,"_34937":86164,"_5":35369,"_23830":144724,"_31422":144725,"_3630":137023},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_4190":86167,"_34937":86164,"_5":35369,"_23830":144727,"_31422":144728,"_3630":144729},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_4190":86168,"_34937":86164,"_5":35369,"_23830":144731,"_31422":144732,"_3630":141962},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#resultado-esperado",{"_4190":86169,"_34937":86164,"_5":35369,"_23830":144734,"_31422":144735,"_3630":144736},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_4190":86170,"_34937":86164,"_23830":144738,"_5":16479,"_31422":86164,"_3630":144739},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_4190":86171,"_34937":86164,"_23830":144741,"_5":16479,"_31422":144725,"_3630":144742},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_4190":86172,"_34937":86164,"_23830":144744,"_5":16479,"_31422":144725,"_3630":144745},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_4190":86173,"_34937":86164,"_23830":144747,"_5":16479,"_31422":144725,"_3630":144748},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_4190":86174,"_34937":86164,"_23830":144750,"_5":16479,"_31422":144725,"_3630":144751},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_4190":86175,"_34937":86164,"_23830":144753,"_5":16479,"_31422":144725,"_3630":144754},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_4190":86176,"_34937":86164,"_23830":144756,"_5":16479,"_31422":144728,"_3630":144757},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_4190":86177,"_34937":86164,"_23830":144759,"_5":16479,"_31422":144728,"_3630":144760},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_4190":86178,"_34937":86164,"_23830":144762,"_5":16479,"_31422":144728,"_3630":144763},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_4190":86179,"_34937":86164,"_23830":144765,"_5":16479,"_31422":144728,"_3630":144766},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_4190":86180,"_34937":86164,"_23830":144768,"_5":16479,"_31422":144732,"_3630":144769},[],"Archivo o recurso",{"_4190":86181,"_34937":86164,"_23830":144771,"_5":16479,"_31422":144732,"_3630":141959},[],{"_4190":86182,"_34937":86164,"_23830":144773,"_5":16479,"_31422":144732,"_3630":144774},[],"CA raíz activa y `ca.pem`",{"_4190":86183,"_34937":86164,"_23830":144776,"_5":16479,"_31422":144732,"_3630":144777},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_4190":86184,"_34937":86164,"_23830":144779,"_5":16479,"_31422":144732,"_3630":144780},[],"Certificado final y `device.crt`",{"_4190":86185,"_34937":86164,"_23830":144782,"_5":16479,"_31422":144732,"_3630":144783},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_4190":86186,"_34937":86164,"_23830":144785,"_5":16479,"_31422":144732,"_3630":144786},[],"Clave privada `device.key`",{"_4190":86187,"_34937":86164,"_23830":144788,"_5":16479,"_31422":144732,"_3630":144789},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_4190":86188,"_34937":86164,"_23830":144791,"_5":16479,"_31422":144732,"_3630":144792},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_4190":86189,"_34937":86164,"_23830":144794,"_5":16479,"_31422":144735,"_3630":144795},[],"Para operar certificados, continúa con Certificados y Validación.",{"_4190":86190,"_34937":86164,"_23830":144797,"_5":16479,"_31422":144735,"_3630":144798},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_4190":86191,"_34937":86164,"_23830":144800,"_5":16479,"_31422":144735,"_3630":144801},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_4190":86192,"_34937":86192,"_5":16871,"_3630":144803,"_35372":144804,"_23830":144806,"_31422":86192},"Resolución de problemas PKI",[58062,138452,63542,144805],"Resolución de problemas",[],{"_4190":86193,"_34937":86192,"_23830":144808,"_5":16479,"_31422":86192,"_3630":144809},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_4190":86194,"_34937":86192,"_5":35369,"_23830":144811,"_31422":144812,"_3630":144813},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_4190":86195,"_34937":86192,"_5":35369,"_23830":144815,"_31422":144816,"_3630":144817},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_4190":86196,"_34937":86192,"_5":35369,"_23830":144819,"_31422":144820,"_3630":144821},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_4190":86197,"_34937":86192,"_23830":144823,"_5":16479,"_31422":86192,"_3630":144824},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_4190":86198,"_34937":86192,"_23830":144826,"_5":16479,"_31422":86192,"_3630":144827},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_4190":86199,"_34937":86192,"_23830":144829,"_5":16479,"_31422":144812,"_3630":141959},[],{"_4190":86200,"_34937":86192,"_23830":144831,"_5":16479,"_31422":144812,"_3630":140631},[],{"_4190":86201,"_34937":86192,"_23830":144833,"_5":16479,"_31422":144812,"_3630":137047},[],{"_4190":86202,"_34937":86192,"_23830":144835,"_5":16479,"_31422":144812,"_3630":62384},[],{"_4190":86203,"_34937":86192,"_23830":144837,"_5":16479,"_31422":144812,"_3630":144838},[],"Existe, está activa y sus fechas son utilizables.",{"_4190":86204,"_34937":86192,"_23830":144840,"_5":16479,"_31422":144812,"_3630":144841},[],"Autoridades.",{"_4190":86205,"_34937":86192,"_23830":144843,"_5":16479,"_31422":144812,"_3630":144844},[],"Clave",{"_4190":86206,"_34937":86192,"_23830":144846,"_5":16479,"_31422":144812,"_3630":144847},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_4190":86207,"_34937":86192,"_23830":144849,"_5":16479,"_31422":144812,"_3630":144850},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_4190":86208,"_34937":86192,"_23830":144852,"_5":16479,"_31422":144812,"_3630":66100},[],{"_4190":86209,"_34937":86192,"_23830":144854,"_5":16479,"_31422":144812,"_3630":144855},[],"PEM correcto y firma verificable.",{"_4190":86210,"_34937":86192,"_23830":144857,"_5":16479,"_31422":144812,"_3630":66106},[],{"_4190":86211,"_34937":86192,"_23830":144859,"_5":16479,"_31422":144812,"_3630":144860},[],"Perfil",{"_4190":86212,"_34937":86192,"_23830":144862,"_5":16479,"_31422":144812,"_3630":144863},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_4190":86213,"_34937":86192,"_23830":144865,"_5":16479,"_31422":144812,"_3630":144866},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_4190":86214,"_34937":86192,"_23830":144868,"_5":16479,"_31422":144812,"_3630":142110},[],{"_4190":86215,"_34937":86192,"_23830":144870,"_5":16479,"_31422":144812,"_3630":144871},[],"Sujeto, SAN, usos y fechas adecuados.",{"_4190":86216,"_34937":86192,"_23830":144873,"_5":16479,"_31422":144812,"_3630":144874},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_4190":86217,"_34937":86192,"_23830":144876,"_5":16479,"_31422":144812,"_3630":144877},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_4190":86218,"_34937":86192,"_23830":144879,"_5":16479,"_31422":144812,"_3630":144880},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_4190":86219,"_34937":86192,"_23830":144882,"_5":16479,"_31422":144816,"_3630":144883},[],"Revisa cada frontera por separado:",{"_4190":86220,"_34937":86192,"_23830":144885,"_5":16479,"_31422":144816,"_3630":144886},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_4190":86221,"_34937":86192,"_23830":144888,"_5":16479,"_31422":144816,"_3630":144889},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_4190":86222,"_34937":86192,"_23830":144891,"_5":16479,"_31422":144816,"_3630":144892},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_4190":86223,"_34937":86192,"_23830":144894,"_5":16479,"_31422":144816,"_3630":144895},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_4190":86224,"_34937":86192,"_23830":144897,"_5":16479,"_31422":144816,"_3630":144898},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_4190":86225,"_34937":86192,"_23830":144900,"_5":16479,"_31422":144816,"_3630":144901},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_4190":86226,"_34937":86192,"_23830":144903,"_5":16479,"_31422":144820,"_3630":144904},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_4190":86227,"_34937":86192,"_23830":144906,"_5":16479,"_31422":144820,"_3630":144907},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_4190":86228,"_34937":86228,"_5":16871,"_3630":144909,"_35372":144910,"_23830":144913,"_31422":86228},"Algoritmos",[58062,138452,144911,144912],"[Beta] Poscuántica (PQC)","Algoritmos y toolchain",[],{"_4190":86229,"_34937":86228,"_23830":144915,"_5":16479,"_31422":86228,"_3630":144916},[],"Los algoritmos de firma poscuánticos y composite que soporta Lamassu, cómo se identifica cada uno en las peticiones a la API y los estándares que siguen.",{"_4190":86230,"_34937":86228,"_5":35369,"_23830":144918,"_31422":144919,"_3630":144920},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#cómo-se-selecciona-un-algoritmo","Cómo se selecciona un algoritmo",{"_4190":86231,"_34937":86228,"_5":35369,"_23830":144922,"_31422":144923,"_3630":66173},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa",{"_4190":86232,"_34937":86228,"_5":35369,"_23830":144925,"_31422":144926,"_3630":66177},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#slh-dsa",{"_4190":86233,"_34937":86228,"_5":35369,"_23830":144928,"_31422":144929,"_3630":144930},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa-composite","ML-DSA composite",{"_4190":86234,"_34937":86228,"_5":35369,"_23830":144932,"_31422":144933,"_3630":66185},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ed25519",{"_4190":86235,"_34937":86228,"_5":35369,"_23830":144935,"_31422":144936,"_3630":144937},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#elegir-un-algoritmo","Elegir un algoritmo",{"_4190":86236,"_34937":86228,"_5":35369,"_23830":144939,"_31422":144940,"_3630":144941},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#qué-no-se-cubre","Qué no se cubre",{"_4190":86237,"_34937":86228,"_23830":144943,"_5":16479,"_31422":86228,"_3630":144944},[],"Lamassu soporta cuatro grupos de algoritmos de firma además de RSA y ECDSA: ML-DSA, SLH-DSA, ML-DSA composite y Ed25519. Todos proceden del toolchain de Go PQC; el backend solo selecciona el algoritmo y delega la criptografía.",{"_4190":86238,"_34937":86228,"_23830":144946,"_5":16479,"_31422":144919,"_3630":144947},[],"Una clave o una CA se crea con un tipo de clave y un tamaño. En RSA y ECDSA el tamaño es una longitud en bits o una curva. En los algoritmos poscuánticos el mismo campo transporta un **identificador de conjunto de parámetros**, no un número de bits:",{"_4190":86239,"_34937":86228,"_23830":144949,"_5":16479,"_31422":144919,"_3630":144950},[],"Tipo de clave (`algorithm` / `type`)",{"_4190":86240,"_34937":86228,"_23830":144952,"_5":16479,"_31422":144919,"_3630":144953},[],"Valor de `size` / `bits`",{"_4190":86241,"_34937":86228,"_23830":144955,"_5":16479,"_31422":144919,"_3630":144956},[],"Significado",{"_4190":86242,"_34937":86228,"_23830":144958,"_5":16479,"_31422":144919,"_3630":66210},[],{"_4190":86243,"_34937":86228,"_23830":144960,"_5":16479,"_31422":144919,"_3630":66213},[],{"_4190":86244,"_34937":86228,"_23830":144962,"_5":16479,"_31422":144919,"_3630":144963},[],"Longitud del módulo en bits.",{"_4190":86245,"_34937":86228,"_23830":144965,"_5":16479,"_31422":144919,"_3630":66219},[],{"_4190":86246,"_34937":86228,"_23830":144967,"_5":16479,"_31422":144919,"_3630":66222},[],{"_4190":86247,"_34937":86228,"_23830":144969,"_5":16479,"_31422":144919,"_3630":144970},[],"Tamaño de la curva en bits (P-256, P-384, P-521).",{"_4190":86248,"_34937":86228,"_23830":144972,"_5":16479,"_31422":144919,"_3630":66228},[],{"_4190":86249,"_34937":86228,"_23830":144974,"_5":16479,"_31422":144919,"_3630":12054},[],{"_4190":86250,"_34937":86228,"_23830":144976,"_5":16479,"_31422":144919,"_3630":144977},[],"Fijo. Cualquier otro valor se sustituye por 256.",{"_4190":86251,"_34937":86228,"_23830":144979,"_5":16479,"_31422":144919,"_3630":66236},[],{"_4190":86252,"_34937":86228,"_23830":144981,"_5":16479,"_31422":144919,"_3630":66239},[],{"_4190":86253,"_34937":86228,"_23830":144983,"_5":16479,"_31422":144919,"_3630":144984},[],"Conjunto de parámetros de ML-DSA.",{"_4190":86254,"_34937":86228,"_23830":144986,"_5":16479,"_31422":144919,"_3630":66245},[],{"_4190":86255,"_34937":86228,"_23830":144988,"_5":16479,"_31422":144919,"_3630":144989},[],"1 a 12",{"_4190":86256,"_34937":86228,"_23830":144991,"_5":16479,"_31422":144919,"_3630":144992},[],"Conjunto de parámetros de SLH-DSA, en el orden de la tabla siguiente.",{"_4190":86257,"_34937":86228,"_23830":144994,"_5":16479,"_31422":144919,"_3630":66254},[],{"_4190":86258,"_34937":86228,"_23830":144996,"_5":16479,"_31422":144919,"_3630":144997},[],"1 a 8",{"_4190":86259,"_34937":86228,"_23830":144999,"_5":16479,"_31422":144919,"_3630":145000},[],"Variante composite con componente RSA.",{"_4190":86260,"_34937":86228,"_23830":145002,"_5":16479,"_31422":144919,"_3630":66263},[],{"_4190":86261,"_34937":86228,"_23830":145004,"_5":16479,"_31422":144919,"_3630":145005},[],"9 a 13",{"_4190":86262,"_34937":86228,"_23830":145007,"_5":16479,"_31422":144919,"_3630":145008},[],"Variante composite con componente ECDSA.",{"_4190":86263,"_34937":86228,"_23830":145010,"_5":16479,"_31422":144919,"_3630":66272},[],{"_4190":86264,"_34937":86228,"_23830":145012,"_5":16479,"_31422":144919,"_3630":145013},[],"14 y 15",{"_4190":86265,"_34937":86228,"_23830":145015,"_5":16479,"_31422":144919,"_3630":145016},[],"Variante composite con componente Ed25519.",{"_4190":86266,"_34937":86228,"_23830":145018,"_5":16479,"_31422":144919,"_3630":145019},[],"Una cadena de tipo de clave desconocida no se rechaza al interpretarla: se convierte en un tipo desconocido y falla más tarde. Deben usarse exactamente las cadenas anteriores.",{"_4190":86267,"_34937":86228,"_23830":145021,"_5":16479,"_31422":144923,"_3630":145022},[],"ML-DSA es el esquema de firma basado en retículos estandarizado en FIPS 204. Lamassu acepta los tres conjuntos de parámetros ML-DSA-44, ML-DSA-65 y ML-DSA-87, que se seleccionan con `size` 44, 65 o 87. La implementación es el paquete `crypto/mldsa` de Go 1.27, es decir, el código de la propia biblioteca estándar y no del fork. En los certificados, los identificadores de algoritmo son `2.16.840.1.101.3.4.3.17`, `.18` y `.19` para ML-DSA-44, -65 y -87.",{"_4190":86268,"_34937":86228,"_23830":145024,"_5":16479,"_31422":144923,"_3630":145025},[],"Conjunto de parámetros",{"_4190":86269,"_34937":86228,"_23830":145027,"_5":16479,"_31422":144923,"_3630":145028},[],"Categoría de seguridad NIST",{"_4190":86270,"_34937":86228,"_23830":145030,"_5":16479,"_31422":144923,"_3630":66293},[],{"_4190":86271,"_34937":86228,"_23830":145032,"_5":16479,"_31422":144923,"_3630":11996},[],{"_4190":86272,"_34937":86228,"_23830":145034,"_5":16479,"_31422":144923,"_3630":66298},[],{"_4190":86273,"_34937":86228,"_23830":145036,"_5":16479,"_31422":144923,"_3630":11933},[],{"_4190":86274,"_34937":86228,"_23830":145038,"_5":16479,"_31422":144923,"_3630":66303},[],{"_4190":86275,"_34937":86228,"_23830":145040,"_5":16479,"_31422":144923,"_3630":12125},[],{"_4190":86276,"_34937":86228,"_23830":145042,"_5":16479,"_31422":144923,"_3630":145043},[],"Una categoría más alta implica claves y firmas más grandes a cambio de mayor margen de seguridad.",{"_4190":86277,"_34937":86228,"_23830":145045,"_5":16479,"_31422":144923,"_3630":145046},[],"Go solo lee claves privadas ML-DSA en PKCS#8 cuando contienen únicamente la semilla de 32 bytes. Las claves que OpenSSL escribe por defecto en la forma semilla más clave expandida se rechazan, por lo que deben exportarse en la forma de solo semilla antes de importarlas.",{"_4190":86278,"_34937":86228,"_23830":145048,"_5":16479,"_31422":144926,"_3630":145049},[],"SLH-DSA es el esquema basado en funciones hash de FIPS 205. Ofrece doce conjuntos de parámetros que combinan una familia de hash (SHA-2 o SHAKE), el parámetro n de 128, 192 o 256 bits, que corresponde a las categorías de seguridad 1, 3 y 5 del NIST y un compromiso entre tamaño de firma y velocidad de firma (`s` para firmas pequeñas, `f` para firma rápida). El identificador que se escribe en `size` sigue el orden de la biblioteca subyacente:",{"_4190":86279,"_34937":86228,"_23830":145051,"_5":16479,"_31422":144926,"_3630":66317},[],{"_4190":86280,"_34937":86228,"_23830":145053,"_5":16479,"_31422":144926,"_3630":145025},[],{"_4190":86281,"_34937":86228,"_23830":145055,"_5":16479,"_31422":144926,"_3630":66317},[],{"_4190":86282,"_34937":86228,"_23830":145057,"_5":16479,"_31422":144926,"_3630":145025},[],{"_4190":86283,"_34937":86228,"_23830":145059,"_5":16479,"_31422":144926,"_3630":11835},[],{"_4190":86284,"_34937":86228,"_23830":145061,"_5":16479,"_31422":144926,"_3630":66328},[],{"_4190":86285,"_34937":86228,"_23830":145063,"_5":16479,"_31422":144926,"_3630":11826},[],{"_4190":86286,"_34937":86228,"_23830":145065,"_5":16479,"_31422":144926,"_3630":66333},[],{"_4190":86287,"_34937":86228,"_23830":145067,"_5":16479,"_31422":144926,"_3630":11996},[],{"_4190":86288,"_34937":86228,"_23830":145069,"_5":16479,"_31422":144926,"_3630":66338},[],{"_4190":86289,"_34937":86228,"_23830":145071,"_5":16479,"_31422":144926,"_3630":11807},[],{"_4190":86290,"_34937":86228,"_23830":145073,"_5":16479,"_31422":144926,"_3630":66343},[],{"_4190":86291,"_34937":86228,"_23830":145075,"_5":16479,"_31422":144926,"_3630":11933},[],{"_4190":86292,"_34937":86228,"_23830":145077,"_5":16479,"_31422":144926,"_3630":66348},[],{"_4190":86293,"_34937":86228,"_23830":145079,"_5":16479,"_31422":144926,"_3630":29970},[],{"_4190":86294,"_34937":86228,"_23830":145081,"_5":16479,"_31422":144926,"_3630":66353},[],{"_4190":86295,"_34937":86228,"_23830":145083,"_5":16479,"_31422":144926,"_3630":11786},[],{"_4190":86296,"_34937":86228,"_23830":145085,"_5":16479,"_31422":144926,"_3630":66358},[],{"_4190":86297,"_34937":86228,"_23830":145087,"_5":16479,"_31422":144926,"_3630":33980},[],{"_4190":86298,"_34937":86228,"_23830":145089,"_5":16479,"_31422":144926,"_3630":66363},[],{"_4190":86299,"_34937":86228,"_23830":145091,"_5":16479,"_31422":144926,"_3630":12125},[],{"_4190":86300,"_34937":86228,"_23830":145093,"_5":16479,"_31422":144926,"_3630":66368},[],{"_4190":86301,"_34937":86228,"_23830":145095,"_5":16479,"_31422":144926,"_3630":34014},[],{"_4190":86302,"_34937":86228,"_23830":145097,"_5":16479,"_31422":144926,"_3630":66373},[],{"_4190":86303,"_34937":86228,"_23830":145099,"_5":16479,"_31422":144926,"_3630":11795},[],{"_4190":86304,"_34937":86228,"_23830":145101,"_5":16479,"_31422":144926,"_3630":66378},[],{"_4190":86305,"_34937":86228,"_23830":145103,"_5":16479,"_31422":144926,"_3630":33476},[],{"_4190":86306,"_34937":86228,"_23830":145105,"_5":16479,"_31422":144926,"_3630":66383},[],{"_4190":86307,"_34937":86228,"_23830":145107,"_5":16479,"_31422":144926,"_3630":145108},[],"La implementación de SLH-DSA procede de la biblioteca CIRCL de Cloudflare, que el fork integra para poder usar claves SLH-DSA en certificados X.509. Los identificadores de objeto van de `2.16.840.1.101.3.4.3.20` a `.31`. Las firmas SLH-DSA son grandes, de entre unos 8 y 50 KB según el conjunto de parámetros, lo que importa en las cadenas de certificados y en cualquier transporte con un límite de tamaño. SLH-DSA está disponible para claves, CA y certificados, pero el fork no tiene esquema de firma TLS para él, por lo que un certificado SLH-DSA no puede autenticar una conexión TLS.",{"_4190":86308,"_34937":86228,"_23830":145110,"_5":16479,"_31422":144929,"_3630":145111},[],"Una clave composite empareja una clave ML-DSA con una clave tradicional. Una firma composite es la concatenación de la firma ML-DSA y la firma tradicional, ambas calculadas sobre un mensaje representativo que contiene un prefijo fijo, una etiqueta de algoritmo, un contexto opcional y un hash del mensaje; la verificación falla si falla cualquiera de los componentes. El componente ML-DSA es ML-DSA puro, con la etiqueta como contexto. Lamassu implementa los 15 algoritmos del RFC 10073 que dependen solo de algoritmos disponibles en Go. Los identificadores cuelgan del arco `1.3.6.1.5.5.7.6`.",{"_4190":86309,"_34937":86228,"_23830":145113,"_5":16479,"_31422":144929,"_3630":66392},[],{"_4190":86310,"_34937":86228,"_23830":145115,"_5":16479,"_31422":144929,"_3630":145116},[],"Algoritmo",{"_4190":86311,"_34937":86228,"_23830":145118,"_5":16479,"_31422":144929,"_3630":145119},[],"Último dígito del OID",{"_4190":86312,"_34937":86228,"_23830":145121,"_5":16479,"_31422":144929,"_3630":145122},[],"Familia",{"_4190":86313,"_34937":86228,"_23830":145124,"_5":16479,"_31422":144929,"_3630":11835},[],{"_4190":86314,"_34937":86228,"_23830":145126,"_5":16479,"_31422":144929,"_3630":66406},[],{"_4190":86315,"_34937":86228,"_23830":145128,"_5":16479,"_31422":144929,"_3630":34805},[],{"_4190":86316,"_34937":86228,"_23830":145130,"_5":16479,"_31422":144929,"_3630":66411},[],{"_4190":86317,"_34937":86228,"_23830":145132,"_5":16479,"_31422":144929,"_3630":11996},[],{"_4190":86318,"_34937":86228,"_23830":145134,"_5":16479,"_31422":144929,"_3630":66416},[],{"_4190":86319,"_34937":86228,"_23830":145136,"_5":16479,"_31422":144929,"_3630":34778},[],{"_4190":86320,"_34937":86228,"_23830":145138,"_5":16479,"_31422":144929,"_3630":66411},[],{"_4190":86321,"_34937":86228,"_23830":145140,"_5":16479,"_31422":144929,"_3630":11933},[],{"_4190":86322,"_34937":86228,"_23830":145142,"_5":16479,"_31422":144929,"_3630":66425},[],{"_4190":86323,"_34937":86228,"_23830":145144,"_5":16479,"_31422":144929,"_3630":33593},[],{"_4190":86324,"_34937":86228,"_23830":145146,"_5":16479,"_31422":144929,"_3630":66411},[],{"_4190":86325,"_34937":86228,"_23830":145148,"_5":16479,"_31422":144929,"_3630":11786},[],{"_4190":86326,"_34937":86228,"_23830":145150,"_5":16479,"_31422":144929,"_3630":66434},[],{"_4190":86327,"_34937":86228,"_23830":145152,"_5":16479,"_31422":144929,"_3630":33599},[],{"_4190":86328,"_34937":86228,"_23830":145154,"_5":16479,"_31422":144929,"_3630":66411},[],{"_4190":86329,"_34937":86228,"_23830":145156,"_5":16479,"_31422":144929,"_3630":12125},[],{"_4190":86330,"_34937":86228,"_23830":145158,"_5":16479,"_31422":144929,"_3630":66443},[],{"_4190":86331,"_34937":86228,"_23830":145160,"_5":16479,"_31422":144929,"_3630":33605},[],{"_4190":86332,"_34937":86228,"_23830":145162,"_5":16479,"_31422":144929,"_3630":66411},[],{"_4190":86333,"_34937":86228,"_23830":145164,"_5":16479,"_31422":144929,"_3630":11795},[],{"_4190":86334,"_34937":86228,"_23830":145166,"_5":16479,"_31422":144929,"_3630":66452},[],{"_4190":86335,"_34937":86228,"_23830":145168,"_5":16479,"_31422":144929,"_3630":11789},[],{"_4190":86336,"_34937":86228,"_23830":145170,"_5":16479,"_31422":144929,"_3630":66411},[],{"_4190":86337,"_34937":86228,"_23830":145172,"_5":16479,"_31422":144929,"_3630":11826},[],{"_4190":86338,"_34937":86228,"_23830":145174,"_5":16479,"_31422":144929,"_3630":66461},[],{"_4190":86339,"_34937":86228,"_23830":145176,"_5":16479,"_31422":144929,"_3630":33481},[],{"_4190":86340,"_34937":86228,"_23830":145178,"_5":16479,"_31422":144929,"_3630":66411},[],{"_4190":86341,"_34937":86228,"_23830":145180,"_5":16479,"_31422":144929,"_3630":11807},[],{"_4190":86342,"_34937":86228,"_23830":145182,"_5":16479,"_31422":144929,"_3630":66470},[],{"_4190":86343,"_34937":86228,"_23830":145184,"_5":16479,"_31422":144929,"_3630":33503},[],{"_4190":86344,"_34937":86228,"_23830":145186,"_5":16479,"_31422":144929,"_3630":66411},[],{"_4190":86345,"_34937":86228,"_23830":145188,"_5":16479,"_31422":144929,"_3630":29970},[],{"_4190":86346,"_34937":86228,"_23830":145190,"_5":16479,"_31422":144929,"_3630":66479},[],{"_4190":86347,"_34937":86228,"_23830":145192,"_5":16479,"_31422":144929,"_3630":33545},[],{"_4190":86348,"_34937":86228,"_23830":145194,"_5":16479,"_31422":144929,"_3630":66484},[],{"_4190":86349,"_34937":86228,"_23830":145196,"_5":16479,"_31422":144929,"_3630":33980},[],{"_4190":86350,"_34937":86228,"_23830":145198,"_5":16479,"_31422":144929,"_3630":66489},[],{"_4190":86351,"_34937":86228,"_23830":145200,"_5":16479,"_31422":144929,"_3630":33611},[],{"_4190":86352,"_34937":86228,"_23830":145202,"_5":16479,"_31422":144929,"_3630":66484},[],{"_4190":86353,"_34937":86228,"_23830":145204,"_5":16479,"_31422":144929,"_3630":34014},[],{"_4190":86354,"_34937":86228,"_23830":145206,"_5":16479,"_31422":144929,"_3630":66498},[],{"_4190":86355,"_34937":86228,"_23830":145208,"_5":16479,"_31422":144929,"_3630":33617},[],{"_4190":86356,"_34937":86228,"_23830":145210,"_5":16479,"_31422":144929,"_3630":66484},[],{"_4190":86357,"_34937":86228,"_23830":145212,"_5":16479,"_31422":144929,"_3630":33476},[],{"_4190":86358,"_34937":86228,"_23830":145214,"_5":16479,"_31422":144929,"_3630":66507},[],{"_4190":86359,"_34937":86228,"_23830":145216,"_5":16479,"_31422":144929,"_3630":33623},[],{"_4190":86360,"_34937":86228,"_23830":145218,"_5":16479,"_31422":144929,"_3630":66484},[],{"_4190":86361,"_34937":86228,"_23830":145220,"_5":16479,"_31422":144929,"_3630":34080},[],{"_4190":86362,"_34937":86228,"_23830":145222,"_5":16479,"_31422":144929,"_3630":66516},[],{"_4190":86363,"_34937":86228,"_23830":145224,"_5":16479,"_31422":144929,"_3630":33509},[],{"_4190":86364,"_34937":86228,"_23830":145226,"_5":16479,"_31422":144929,"_3630":66484},[],{"_4190":86365,"_34937":86228,"_23830":145228,"_5":16479,"_31422":144929,"_3630":33663},[],{"_4190":86366,"_34937":86228,"_23830":145230,"_5":16479,"_31422":144929,"_3630":66525},[],{"_4190":86367,"_34937":86228,"_23830":145232,"_5":16479,"_31422":144929,"_3630":34811},[],{"_4190":86368,"_34937":86228,"_23830":145234,"_5":16479,"_31422":144929,"_3630":66185},[],{"_4190":86369,"_34937":86228,"_23830":145236,"_5":16479,"_31422":144929,"_3630":34086},[],{"_4190":86370,"_34937":86228,"_23830":145238,"_5":16479,"_31422":144929,"_3630":66534},[],{"_4190":86371,"_34937":86228,"_23830":145240,"_5":16479,"_31422":144929,"_3630":33587},[],{"_4190":86372,"_34937":86228,"_23830":145242,"_5":16479,"_31422":144929,"_3630":66185},[],{"_4190":86373,"_34937":86228,"_23830":145244,"_5":16479,"_31422":144929,"_3630":145245},[],"El tipo de clave debe coincidir con la familia de la variante: crear una clave `Composite-ML-DSA-ECDSA` con `size` 3 falla con un error que indica que la variante no es válida para ese tipo de clave.",{"_4190":86374,"_34937":86228,"_23830":145247,"_5":16479,"_31422":144929,"_3630":145248},[],"La implementación se escribió contra el borrador 19 de la especificación, que después se publicó como RFC 10073, y se ha contrastado con el texto publicado. Los identificadores de objeto, el prefijo de separación de dominio, el hash que usa cada componente ECDSA y la codificación RFC 5915 de las claves privadas ECDSA coinciden con el RFC. Tres algoritmos de la especificación no están implementados porque Go no dispone de curvas Brainpool ni de Ed448: las dos variantes Brainpool (`MLDSA65-ECDSA-brainpoolP256r1` y `MLDSA87-ECDSA-brainpoolP384r1`, con su sufijo de hash) y la variante Ed448. El fork supera los vectores de prueba del Apéndice E del RFC 10073 para los 15 algoritmos que sí implementa, con firmas con y sin contexto. Estas comprobaciones cubren los vectores y los puntos indicados arriba; no son una evaluación completa de conformidad.",{"_4190":86375,"_34937":86228,"_23830":145250,"_5":16479,"_31422":144929,"_3630":145251},[],"Los parámetros de las claves y de las firmas composite deben estar ausentes en el `AlgorithmIdentifier`; los certificados que los incluyen se rechazan. Los componentes ECDSA deben usar un escalar privado con la longitud exacta de la curva.",{"_4190":86376,"_34937":86228,"_23830":145253,"_5":16479,"_31422":144933,"_3630":145254},[],"Ed25519 no es poscuántico, pero el soporte como tipo de clave de CA y de certificado se añadió en el mismo trabajo y se selecciona con el tipo de clave `Ed25519`. Se clasifica en la familia tradicional.",{"_4190":86377,"_34937":86228,"_23830":145256,"_5":16479,"_31422":144936,"_3630":145257},[],"**ML-DSA composite** es la opción más conservadora durante la transición, porque la firma solo es válida si ambos componentes se verifican y así mantiene la protección clásica si se encuentra un fallo en el algoritmo nuevo. Las claves y firmas son mayores que las clásicas.",{"_4190":86378,"_34937":86228,"_23830":145259,"_5":16479,"_31422":144936,"_3630":145260},[],"**ML-DSA** por sí solo ofrece protección poscuántica con tamaños moderados y operaciones rápidas.",{"_4190":86379,"_34937":86228,"_23830":145262,"_5":16479,"_31422":144936,"_3630":145263},[],"**SLH-DSA** es adecuado para anclas de confianza de larga vida donde se valora depender solo de funciones hash. Las firmas son considerablemente mayores y no puede autenticar conexiones TLS.",{"_4190":86380,"_34937":86228,"_23830":145265,"_5":16479,"_31422":144936,"_3630":145266},[],"**Ed25519** no es poscuántico; úsalo solo donde un algoritmo clásico sea aceptable.",{"_4190":86381,"_34937":86228,"_23830":145268,"_5":16479,"_31422":144940,"_3630":145269},[],"Lamassu no implementa intercambio de claves poscuántico propio. Los intercambios de claves híbridos que ofrece el endpoint TLS, como `X25519MLKEM768`, son los de la biblioteca estándar de Go 1.27. Los diseños de certificados Chameleon y delta que se exploraron en iteraciones anteriores se eliminaron y no forman parte de la implementación.",{"_4190":86382,"_34937":86228,"_23830":145271,"_5":16479,"_31422":144940,"_3630":145272},[],"<Card title=\"Toolchain de Go PQC\" description=\"El fork que implementa estos algoritmos y la API que añade.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_4190":86383,"_34937":86228,"_23830":145274,"_5":16479,"_31422":144940,"_3630":145275},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Usar estos parámetros en las peticiones al KMS y a la CA.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4190":86384,"_34937":86384,"_5":16871,"_3630":66573,"_35372":145277,"_23830":145279,"_31422":86384},[58062,138452,144911,145278],"Soporte en la plataforma",[],{"_4190":86385,"_34937":86384,"_23830":145281,"_5":16479,"_31422":86384,"_3630":145282},[],"Cómo expone la interfaz web los algoritmos poscuánticos al crear claves, CA y certificados, y cómo los muestra.",{"_4190":86386,"_34937":86384,"_5":35369,"_23830":145284,"_31422":145285,"_3630":145286},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#elegir-tipo-de-clave-y-especificación","Elegir tipo de clave y especificación",{"_4190":86387,"_34937":86384,"_5":35369,"_23830":145288,"_31422":145289,"_3630":145290},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#emitir-un-certificado-con-una-clave-generada-en-el-navegador","Emitir un certificado con una clave generada en el navegador",{"_4190":86388,"_34937":86384,"_5":35369,"_23830":145292,"_31422":145293,"_3630":145294},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#cómo-se-muestran-los-objetos","Cómo se muestran los objetos",{"_4190":86389,"_34937":86384,"_5":35369,"_23830":145296,"_31422":145297,"_3630":145298},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#certificados-relacionados","Certificados relacionados",{"_4190":86390,"_34937":86384,"_5":35369,"_23830":145300,"_31422":145301,"_3630":145302},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#crea-un-perfil-de-emisión-que-habilite-la-función","Crea un perfil de emisión que habilite la función",{"_4190":86391,"_34937":86384,"_5":35369,"_23830":145304,"_31422":145305,"_3630":145306},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#comprueba-qué-perfiles-la-permiten","Comprueba qué perfiles la permiten",{"_4190":86392,"_34937":86384,"_5":35369,"_23830":145308,"_31422":145309,"_3630":145310},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#solicita-el-certificado-vinculado","Solicita el certificado vinculado",{"_4190":86393,"_34937":86384,"_5":35369,"_23830":145312,"_31422":145313,"_3630":145314},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#comprueba-el-resultado","Comprueba el resultado",{"_4190":86394,"_34937":86384,"_5":35369,"_23830":145316,"_31422":145317,"_3630":145318},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#aspectos-a-tener-en-cuenta","Aspectos a tener en cuenta",{"_4190":86395,"_34937":86384,"_23830":145320,"_5":16479,"_31422":86384,"_3630":145321},[],"El dashboard (rama `feat/lamassu-q`) permite a un administrador crear e inspeccionar claves, autoridades de certificación y certificados poscuánticos sin escribir peticiones a la API. Añade las opciones de algoritmo, muestra la familia de algoritmo de cada objeto e interpreta los nuevos identificadores en los certificados. Todo lo que envía se describe en Claves y autoridades de certificación; esta página cubre lo que muestra la interfaz y dónde difiere su comportamiento entre pantallas.",{"_4190":86396,"_34937":86384,"_23830":145323,"_5":16479,"_31422":145285,"_3630":145324},[],"Crear una clave del KMS, una CA con una clave nueva y un certificado con clave generada en el servidor usan el mismo par de selectores. *Key type* está agrupado por familia y *Key specification* depende del tipo.",{"_4190":86397,"_34937":86384,"_23830":145326,"_5":16479,"_31422":145285,"_3630":145327},[],"Grupo",{"_4190":86398,"_34937":86384,"_23830":145329,"_5":16479,"_31422":145285,"_3630":145330},[],"Tipos de clave",{"_4190":86399,"_34937":86384,"_23830":145332,"_5":16479,"_31422":145285,"_3630":66630},[],{"_4190":86400,"_34937":86384,"_23830":145334,"_5":16479,"_31422":145285,"_3630":66633},[],{"_4190":86401,"_34937":86384,"_23830":145336,"_5":16479,"_31422":145285,"_3630":66636},[],{"_4190":86402,"_34937":86384,"_23830":145338,"_5":16479,"_31422":145285,"_3630":66639},[],{"_4190":86403,"_34937":86384,"_23830":145340,"_5":16479,"_31422":145285,"_3630":66642},[],{"_4190":86404,"_34937":86384,"_23830":145342,"_5":16479,"_31422":145285,"_3630":66645},[],{"_4190":86405,"_34937":86384,"_23830":145344,"_5":16479,"_31422":145285,"_3630":145345},[],"La lista de especificaciones muestra ML-DSA-44, -65 o -87, los doce conjuntos de parámetros de SLH-DSA (por ejemplo *4 - SHAKE\\_128f*) o las variantes composite por nombre. La interfaz envía como `size` el identificador del conjunto de parámetros, según se explica en Algoritmos, y muestra un indicador de fortaleza junto a cada opción. En las claves composite el indicador muestra dos barras, una para el componente clásico y otra para el poscuántico.",{"_4190":86406,"_34937":86384,"_23830":145347,"_5":16479,"_31422":145285,"_3630":145348},[],"Una vez creada, la lista de claves muestra el tipo de cada clave y su fortaleza. Una clave composite muestra dos indicadores, uno para su componente clásico (C) y otro para su componente poscuántico (PQ).",{"_4190":86407,"_34937":86384,"_23830":145350,"_5":16479,"_31422":145285,"_3630":145351},[],"Las opciones habilitadas dependen del motor criptográfico. Al crear una clave o una CA, la interfaz lista todos los algoritmos pero deshabilita los que el motor seleccionado no soporta, y pide seleccionar antes un motor. Al crear un certificado en el servidor, los tipos no soportados se ocultan en su lugar.",{"_4190":86408,"_34937":86384,"_23830":145353,"_5":16479,"_31422":145289,"_3630":145354},[],"Emitir un certificado desde una CA genera el par de claves en el navegador, construye la solicitud de certificado y la envía a la CA para su firma. Los tipos de clave que se ofrecen aquí son `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` y una única entrada `Composite ML-DSA`, y se generan en el navegador: con las bibliotecas `@noble` para ML-DSA y SLH-DSA y con WebCrypto para los algoritmos clásicos.",{"_4190":86409,"_34937":86384,"_23830":145356,"_5":16479,"_31422":145289,"_3630":145357},[],"La generación de claves composite no está disponible en `@noble`. El equipo de Lamassu la ha implementado para el dashboard: combina la clave ML-DSA con una clave RSA, ECDSA o Ed25519 y firma el mensaje representativo composite tal como define la especificación, de modo que una solicitud de certificado composite puede crearse íntegramente en el navegador.",{"_4190":86410,"_34937":86384,"_23830":145359,"_5":16479,"_31422":145289,"_3630":145360},[],"La clave privada generada se muestra una sola vez al final del procedimiento, junto al certificado emitido, con una advertencia para guardarla de forma segura. Lamassu no la conserva, así que descárgala o cópiala antes de salir de la página.",{"_4190":86411,"_34937":86384,"_23830":145362,"_5":16479,"_31422":145289,"_3630":145363},[],"El navegador no verifica las firmas de las solicitudes ML-DSA, SLH-DSA, composite ni Ed25519; confía en el KMS.",{"_4190":86412,"_34937":86384,"_23830":145365,"_5":16479,"_31422":145293,"_3630":145366},[],"Las listas y las vistas de detalle muestran la familia del algoritmo. La tabla de CA tiene una columna *PQC* con T, PQ o PQ/T, las tarjetas de CA y el grafo de CA muestran una insignia *PQC*, las listas de claves muestran un icono cuántico, y el detalle de una CA o un certificado muestra el algoritmo, su fortaleza y la insignia de familia. La familia se calcula a partir del identificador de algoritmo del certificado interpretado.",{"_4190":86413,"_34937":86384,"_23830":145368,"_5":16479,"_31422":145293,"_3630":145369},[],"La lista de certificados tiene una columna *Algorithm* con las mismas etiquetas: en el ejemplo siguiente, un certificado tradicional (T), un certificado poscuántico puro (PQ) y la CA composite que los emitió (PQ/T).",{"_4190":86414,"_34937":86384,"_23830":145371,"_5":16479,"_31422":145293,"_3630":145372},[],"Los nombres de algoritmo se resuelven a partir de los identificadores de objeto. Los identificadores de ML-DSA, SLH-DSA, composite y Ed25519 se muestran como nombres con su conjunto de parámetros, por ejemplo *ML-DSA-65* o *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, y para ellos no se muestra longitud en bits. Los algoritmos de firma RSA y ECDSA se muestran con etiquetas propias del dashboard, como *RSA PKCS#1 v1.5 SHA-256* y *ECDSA SHA-256*, en lugar de los nombres de OpenSSL `sha256WithRSAEncryption` y `ecdsa-with-SHA256`.",{"_4190":86415,"_34937":86384,"_23830":145374,"_5":16479,"_31422":145293,"_3630":145375},[],"La página de detalle de una clave puede firmar y verificar con una clave poscuántica y habilita únicamente el algoritmo de firma que le corresponde.",{"_4190":86416,"_34937":86384,"_23830":145377,"_5":16479,"_31422":145293,"_3630":145378},[],"El ejemplo siguiente firma un contenido con la clave de una CA composite, usando el algoritmo composite que corresponde a la clave.",{"_4190":86417,"_34937":86384,"_23830":145380,"_5":16479,"_31422":145297,"_3630":145381},[],"El dashboard cubre todo el flujo de certificados relacionados sin peticiones a la API: habilitar la función en un perfil de emisión, comprobar qué perfiles la tienen y solicitar el certificado vinculado. Los campos de configuración son los descritos en Configurar un perfil de emisión.",{"_4190":86418,"_34937":86384,"_23830":145383,"_5":16479,"_31422":145301,"_3630":145384},[],"Ve a **Issuance Profiles** y selecciona **Create New Profile**. En la sección *Related Certificates*, activa **Enable Related Certificates**. Con el interruptor desactivado, se rechaza una solicitud de certificado que lleve el atributo `relatedCertRequest`.",{"_4190":86419,"_34937":86384,"_23830":145386,"_5":16479,"_31422":145301,"_3630":145387},[],"**Allowed Hosts** lista un nombre de host por línea. El servidor descarga los certificados relacionados por `http` o `https` solo desde esos hosts, como se explica en Ubicaciones desde las que la CA puede descargar. Los certificados incluidos en la solicitud como URI `data:` se aceptan siempre.",{"_4190":86420,"_34937":86384,"_23830":145389,"_5":16479,"_31422":145301,"_3630":145390},[],"**Max Attribute Age** es la antigüedad máxima de la hora de solicitud del atributo. Usa las unidades `y`, `w`, `d`, `h`, `m` o `s`, por ejemplo `5m` o `1h`. Si lo dejas vacío, se aplica el valor por defecto de 5 minutos.",{"_4190":86421,"_34937":86384,"_23830":145392,"_5":16479,"_31422":145301,"_3630":145393},[],"Completa el resto del perfil como de costumbre, según se describe en Perfiles de certificado.",{"_4190":86422,"_34937":86384,"_23830":145395,"_5":16479,"_31422":145305,"_3630":145396},[],"La lista de perfiles de emisión muestra en cada tarjeta una fila *Related certs* con el valor **Enabled** o **Disabled**. Un perfil que la tiene habilitada muestra además sus hosts permitidos y su antigüedad máxima del atributo. En el ejemplo, el perfil por defecto tiene la función deshabilitada, y el segundo perfil la tiene habilitada con el host `certs.example.com` y una antigüedad máxima de una hora. Selecciona **Edit** para cambiar cualquiera de los dos ajustes más adelante.",{"_4190":86423,"_34937":86384,"_23830":145398,"_5":16479,"_31422":145305,"_3630":145399},[],"Solo un perfil guardado con la función habilitada permite solicitar un certificado vinculado. Si eliges un perfil que no la tiene, o un perfil en línea, el formulario explica por qué la opción no está disponible.",{"_4190":86424,"_34937":86384,"_23830":145401,"_5":16479,"_31422":145309,"_3630":145402},[],"Abre la CA que lo firmará, selecciona **Issue Certificate** y genera la clave en el navegador, según se describe en la sección anterior. En *Certificate Configuration*, elige **Reuse Existing** y selecciona el perfil del paso anterior. Después activa **Bind to a related certificate** en la sección *Related Certificate* y complétala:",{"_4190":86425,"_34937":86384,"_23830":145404,"_5":16479,"_31422":145309,"_3630":145405},[],"**Related certificate (PEM, optional).** Pega el certificado existente. Se usan su emisor y su número de serie exactos y los campos siguientes quedan bloqueados. Si no lo pegas, introduce el emisor, como campos de nombre o como DER sin procesar, y el número de serie en hexadecimal.",{"_4190":86426,"_34937":86384,"_23830":145407,"_5":16479,"_31422":145309,"_3630":145408},[],"**Location of the related certificate.** Una URI por línea: una URI `data:` con un PKCS#7 en base64 que contenga el certificado, o una URL `http` o `https` que apunte a un certificado DER simple en un host permitido.",{"_4190":86427,"_34937":86384,"_23830":145410,"_5":16479,"_31422":145309,"_3630":145411},[],"**Data to sign.** El formulario construye el emisor y el número de serie seguidos de la hora de solicitud, que estampa automáticamente. Cópialo como hex o base64. **Refresh** lo recalcula con la hora actual.",{"_4190":86428,"_34937":86384,"_23830":145413,"_5":16479,"_31422":145309,"_3630":145414},[],"**Signature.** Firma esos bytes con la clave privada del certificado relacionado, fuera del navegador, y pega la firma en hex o base64. Usa el algoritmo habitual de la clave: ECDSA con SHA-256, SHA-384 o SHA-512 según la curva, RSA PKCS#1 v1.5 con SHA-256, y Ed25519 o ML-DSA puros. Una firma ECDSA puede ser DER o `r||s` sin procesar.",{"_4190":86429,"_34937":86384,"_23830":145416,"_5":16479,"_31422":145309,"_3630":145417},[],"Para construir la URI `data:` a partir de un fichero de certificado, `cert.pem`, envuélvelo en una estructura PKCS#7 y codifícalo en base64:",{"_4190":86430,"_34937":86384,"_23830":145419,"_5":16479,"_31422":145309,"_3630":145420},[],"Pega la salida en una sola línea en el campo de ubicación. El servidor solo comprueba que la URI esté codificada en base64 y que el contenido sea una estructura PKCS#7 cuyo primer certificado sea el relacionado.",{"_4190":86431,"_34937":86384,"_23830":145422,"_5":16479,"_31422":145309,"_3630":145423},[],"La clave del certificado relacionado suele permanecer en el dispositivo o sistema que la posee, de modo que la firma se produce allí. Si esa clave está en Lamassu, usa **Sign / Verify** sobre la clave, según se describe en Claves y motores criptográficos.",{"_4190":86432,"_34937":86384,"_23830":145425,"_5":16479,"_31422":145309,"_3630":145426},[],"La CA solo acepta la solicitud si su hora está dentro de la antigüedad máxima del atributo del perfil, contada desde el momento en que recibe la solicitud. Firma y emite dentro de esa ventana, o selecciona **Refresh** y firma los datos nuevos. Después emite el certificado como de costumbre.",{"_4190":86433,"_34937":86384,"_23830":145428,"_5":16479,"_31422":145313,"_3630":145429},[],"Las páginas de detalle del nuevo certificado muestran una fila *Related Certificate* con el algoritmo de hash y el hash del certificado relacionado. Solo aparece en los certificados que llevan la extensión, de modo que un certificado emitido sin el vínculo no muestra esa fila.",{"_4190":86434,"_34937":86384,"_23830":145431,"_5":16479,"_31422":145313,"_3630":145432},[],"Para comprobar que el valor corresponde al certificado esperado, calcula el hash de su codificación DER con el mismo algoritmo y compáralo:",{"_4190":86435,"_34937":86384,"_23830":145434,"_5":16479,"_31422":145313,"_3630":145435},[],"El algoritmo es SHA-256, SHA-384 o SHA-512, el que indica la fila. Las reglas que debe cumplir el certificado vinculado están en Qué debe cumplir el certificado emitido.",{"_4190":86436,"_34937":86384,"_23830":145437,"_5":16479,"_31422":145317,"_3630":145438},[],"Los nombres de los tipos de clave no son idénticos en todas las pantallas. La creación de claves y de CA usa `Composite-ML-DSA-RSA`, `-ECDSA` y `-Ed25519`; el formulario de emisión de certificados usa un único `Composite-ML-DSA`; y el formulario de certificado en el servidor compara nombres en mayúsculas. Los nombres que el backend informa para una clave pueden diferir, por tanto, en mayúsculas y minúsculas de lo que envía la interfaz.",{"_4190":86437,"_34937":86384,"_23830":145440,"_5":16479,"_31422":145317,"_3630":145441},[],"La interfaz no incluye ningún aviso de carácter experimental para estos algoritmos y no está traducida: todos los textos están en inglés.",{"_4190":86438,"_34937":86384,"_23830":145443,"_5":16479,"_31422":145317,"_3630":145444},[],"La correspondencia entre el identificador del conjunto de parámetros de SLH-DSA y el algoritmo que usa el generador de claves del navegador no sigue el mismo orden que los identificadores que muestra el selector y que usa el backend, salvo en el identificador 1. Un certificado emitido por el flujo del navegador con un identificador SLH-DSA del 2 al 12 puede usar, por tanto, un conjunto de parámetros distinto del que nombra el selector. Hasta que se corrija, conviene crear las claves SLH-DSA con el KMS.",{"_4190":86439,"_34937":86384,"_23830":145446,"_5":16479,"_31422":145317,"_3630":145447},[],"<Card title=\"Claves y autoridades de certificación\" description=\"La API que hay detrás de estas pantallas.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4190":86440,"_34937":86384,"_23830":145449,"_5":16479,"_31422":145317,"_3630":145450},[],"<Card title=\"Limitaciones conocidas\" description=\"Carencias de la interfaz y de la plataforma.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":86441,"_34937":86441,"_5":16871,"_3630":145452,"_35372":145453,"_23830":145454,"_31422":86441},"Despliegue con el Helm chart",[58062,138452,144911,137014],[],{"_4190":86442,"_34937":86441,"_23830":145456,"_5":16479,"_31422":86441,"_3630":145457},[],"Desplegar Lamassu con un proxy frontal Traefik que sirve certificados clásicos, poscuánticos y composite, mediante los valores del chart o el instalador fast-lane.",{"_4190":86443,"_34937":86441,"_5":35369,"_23830":145459,"_31422":145460,"_3630":145461},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#topología","Topología",{"_4190":86444,"_34937":86441,"_5":35369,"_23830":145463,"_31422":145464,"_3630":145465},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#valores-del-chart","Valores del chart",{"_4190":86445,"_34937":86441,"_5":35369,"_23830":145467,"_31422":145468,"_3630":145469},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#el-instalador-fast-lane","El instalador fast-lane",{"_4190":86446,"_34937":86441,"_23830":145471,"_5":16479,"_31422":86441,"_3630":145472},[],"La rama `pqc` del Helm chart de Lamassu añade un proxy frontal: una instancia de Traefik compilada con el toolchain de Go PQC que termina el TLS de los dispositivos, los autentica y reenvía el tráfico a Envoy Gateway. Esta página describe la topología resultante, los valores que la controlan y el instalador que automatiza un despliegue de laboratorio.",{"_4190":86447,"_34937":86441,"_23830":145474,"_5":16479,"_31422":86441,"_3630":145475},[],"El chart y el instalador asumen un clúster de desarrollo. La imagen del proxy usa una etiqueta mutable, los certificados PQC no se renuevan automáticamente y el salto entre Traefik y Envoy no verifica certificados. Esta configuración no debe usarse tal cual en producción.",{"_4190":86448,"_34937":86441,"_23830":145477,"_5":16479,"_31422":145460,"_3630":145478},[],"Traefik es el borde público. Negocia el intercambio de claves, sirve el certificado y, si se solicita, recibe el certificado del cliente. Después abre una segunda conexión TLS hacia el servicio `envoy-gateway-proxy` de Envoy Gateway, que presenta el certificado clásico autofirmado del chart; Traefik está configurado para aceptarlo sin verificarlo. Envoy no llega a ver, por tanto, un handshake poscuántico, y la protección poscuántica cubre solo la conexión entre el cliente y Traefik. Traefik y Envoy Gateway se instalan una sola vez por clúster y se comparten entre espacios de nombres, mientras que los recursos del proxy frontal (el Gateway, la ruta, el middleware, el certificado y el reference grant) pertenecen a la release de Lamassu.",{"_4190":86449,"_34937":86441,"_23830":145480,"_5":16479,"_31422":145460,"_3630":145481},[],"Cuando el cliente ha enviado un certificado, el middleware `inject-client-cert` del chart lo añade, en formato PEM, a la cabecera `X-Forwarded-Tls-Client-Cert`, y se establece la cabecera `X-Forwarded-Proto: https` en la petición.",{"_4190":86450,"_34937":86441,"_23830":145483,"_5":16479,"_31422":145464,"_3630":145484},[],"Todos los valores nuevos están bajo `traefikFrontProxy` y los valida el esquema del chart, que rechaza claves desconocidas.",{"_4190":86451,"_34937":86441,"_23830":145486,"_5":16479,"_31422":145464,"_3630":145487},[],"Nombre",{"_4190":86452,"_34937":86441,"_23830":145489,"_5":16479,"_31422":145464,"_3630":141069},[],{"_4190":86453,"_34937":86441,"_23830":145491,"_5":16479,"_31422":145464,"_3630":145492},[],"Valor por defecto",{"_4190":86454,"_34937":86441,"_23830":145494,"_5":16479,"_31422":145464,"_3630":141075},[],{"_4190":86455,"_34937":86441,"_23830":145496,"_5":16479,"_31422":145464,"_3630":66799},[],{"_4190":86456,"_34937":86441,"_23830":145498,"_5":16479,"_31422":145464,"_3630":116525},[],{"_4190":86457,"_34937":86441,"_23830":145500,"_5":16479,"_31422":145464,"_3630":66804},[],{"_4190":86458,"_34937":86441,"_23830":145502,"_5":16479,"_31422":145464,"_3630":145503},[],"Despliega los recursos del proxy frontal.",{"_4190":86459,"_34937":86441,"_23830":145505,"_5":16479,"_31422":145464,"_3630":66810},[],{"_4190":86460,"_34937":86441,"_23830":145507,"_5":16479,"_31422":145464,"_3630":108667},[],{"_4190":86461,"_34937":86441,"_23830":145509,"_5":16479,"_31422":145464,"_3630":66815},[],{"_4190":86462,"_34937":86441,"_23830":145511,"_5":16479,"_31422":145464,"_3630":145512},[],"Nombre del certificado de borde y nombre de host de la ruta. Debe indicarse cuando el proxy está habilitado.",{"_4190":86463,"_34937":86441,"_23830":145514,"_5":16479,"_31422":145464,"_3630":66821},[],{"_4190":86464,"_34937":86441,"_23830":145516,"_5":16479,"_31422":145464,"_3630":93902},[],{"_4190":86465,"_34937":86441,"_23830":145518,"_5":16479,"_31422":145464,"_3630":66826},[],{"_4190":86466,"_34937":86441,"_23830":145520,"_5":16479,"_31422":145464,"_3630":145521},[],"Puerto del listener HTTPS; debe coincidir con el entry point `websecure` de Traefik.",{"_4190":86467,"_34937":86441,"_23830":145523,"_5":16479,"_31422":145464,"_3630":66832},[],{"_4190":86468,"_34937":86441,"_23830":145525,"_5":16479,"_31422":145464,"_3630":108667},[],{"_4190":86469,"_34937":86441,"_23830":145527,"_5":16479,"_31422":145464,"_3630":66837},[],{"_4190":86470,"_34937":86441,"_23830":145529,"_5":16479,"_31422":145464,"_3630":145530},[],"Origen del certificado clásico: `certManager`, `external` o `none`.",{"_4190":86471,"_34937":86441,"_23830":145532,"_5":16479,"_31422":145464,"_3630":66843},[],{"_4190":86472,"_34937":86441,"_23830":145534,"_5":16479,"_31422":145464,"_3630":101705},[],{"_4190":86473,"_34937":86441,"_23830":145536,"_5":16479,"_31422":145464,"_3630":66848},[],{"_4190":86474,"_34937":86441,"_23830":145538,"_5":16479,"_31422":145464,"_3630":145539},[],"Direcciones IP añadidas al certificado autofirmado.",{"_4190":86475,"_34937":86441,"_23830":145541,"_5":16479,"_31422":145464,"_3630":66854},[],{"_4190":86476,"_34937":86441,"_23830":145543,"_5":16479,"_31422":145464,"_3630":108667},[],{"_4190":86477,"_34937":86441,"_23830":145545,"_5":16479,"_31422":145464,"_3630":66815},[],{"_4190":86478,"_34937":86441,"_23830":145547,"_5":16479,"_31422":145464,"_3630":145548},[],"Secret con `tls.crt` y `tls.key` cuando el tipo es `external`.",{"_4190":86479,"_34937":86441,"_23830":145550,"_5":16479,"_31422":145464,"_3630":66864},[],{"_4190":86480,"_34937":86441,"_23830":145552,"_5":16479,"_31422":145464,"_3630":101705},[],{"_4190":86481,"_34937":86441,"_23830":145554,"_5":16479,"_31422":145464,"_3630":66848},[],{"_4190":86482,"_34937":86441,"_23830":145556,"_5":16479,"_31422":145464,"_3630":145557},[],"Secrets TLS adicionales, por ejemplo certificados ML-DSA o composite, que se sirven en el mismo listener.",{"_4190":86483,"_34937":86441,"_23830":145559,"_5":16479,"_31422":145464,"_3630":145560},[],"Con `certManager`, el chart solicita un certificado ECDSA P-256 válido durante 2160 horas a su propio emisor autofirmado y lo guarda en el secret `edge-cert`. Con `none`, solo se sirven los secrets adicionales, y el chart se detiene con un error si no hay ninguno. El proxy elige entre todos los certificados según el cliente, tal como describe Proxy TLS con Traefik. Los nombres de los recursos que crea el chart son fijos, por lo que solo se admite una release por espacio de nombres.",{"_4190":86484,"_34937":86441,"_23830":145562,"_5":16479,"_31422":145464,"_3630":145563},[],"El chart modifica además el servicio de Envoy Gateway para que su puerto HTTPS declare `appProtocol: https`, algo que las versiones recientes de Traefik necesitan para hablar TLS con él. Cuando `gateway.addresses` está vacío, el servicio de Envoy es de tipo `ClusterIP` en lugar de un balanceador de carga.",{"_4190":86485,"_34937":86441,"_23830":145565,"_5":16479,"_31422":145464,"_3630":145566},[],"El chart no despliega Traefik, ni la GatewayClass `traefik`, ni la opción TLS `default` en el espacio de nombres `traefik-system`; los crea el instalador. Sin ellos, el borde no tiene intercambio de claves poscuántico ni solicitud de certificado de cliente. Tampoco fija las imágenes de los servicios de Lamassu: los valores por defecto son las imágenes de desarrollo, y el instalador sustituye las de la interfaz, CA, KMS, VA, device manager, DMS manager, alertas y autorización por las etiquetas `:pqc` de `ghcr.io/lamassuiot`.",{"_4190":86486,"_34937":86441,"_23830":145568,"_5":16479,"_31422":145468,"_3630":145569},[],"`scripts/lamassu-fast-lane.sh` instala todo en un clúster: las definiciones de recursos personalizados de Gateway API (versión 1.6.3, canal experimental), Envoy Gateway 1.8.0, el chart de Traefik 41.0.2 con la imagen PQC, la opción TLS, PostgreSQL, Keycloak, RabbitMQ, opcionalmente observabilidad y SoftHSM, y por último la release de Lamassu. Los dos parámetros relevantes aquí seleccionan qué algoritmos se ofrecen.",{"_4190":86487,"_34937":86441,"_23830":145571,"_5":16479,"_31422":145468,"_3630":145572},[],"Ambos parámetros aceptan una lista separada por comas de `T`, `PQ` y `PQ/T`, y ambos toman por defecto los tres valores. En el intercambio de claves, `PQ/T` es un grupo híbrido que combina un intercambio clásico y uno ML-KEM (`X25519MLKEM768`, `SecP256r1MLKEM768` y `SecP384r1MLKEM1024`) y `PQ` es ML-KEM puro (`MLKEM1024`); en la autenticación, `PQ/T` es un certificado composite. `--tls-kex` rellena los `curvePreferences` de la opción TLS, y `--tls-auth` selecciona qué certificados se sirven:",{"_4190":86488,"_34937":86441,"_23830":145574,"_5":16479,"_31422":145468,"_3630":145575},[],"Valor",{"_4190":86489,"_34937":86441,"_23830":145577,"_5":16479,"_31422":145468,"_3630":145578},[],"Grupos de intercambio de claves",{"_4190":86490,"_34937":86441,"_23830":145580,"_5":16479,"_31422":145468,"_3630":141255},[],{"_4190":86491,"_34937":86441,"_23830":145582,"_5":16479,"_31422":145468,"_3630":66897},[],{"_4190":86492,"_34937":86441,"_23830":145584,"_5":16479,"_31422":145468,"_3630":66900},[],{"_4190":86493,"_34937":86441,"_23830":145586,"_5":16479,"_31422":145468,"_3630":145587},[],"ECDSA P-256 de cert-manager, o los ficheros indicados con `--tls-crt` y `--tls-key`, en el secret `edge-cert`.",{"_4190":86494,"_34937":86441,"_23830":145589,"_5":16479,"_31422":145468,"_3630":66906},[],{"_4190":86495,"_34937":86441,"_23830":145591,"_5":16479,"_31422":145468,"_3630":66909},[],{"_4190":86496,"_34937":86441,"_23830":145593,"_5":16479,"_31422":145468,"_3630":145594},[],"ML-DSA-65, en el secret `edge-cert-pq`.",{"_4190":86497,"_34937":86441,"_23830":145596,"_5":16479,"_31422":145468,"_3630":66915},[],{"_4190":86498,"_34937":86441,"_23830":145598,"_5":16479,"_31422":145468,"_3630":66918},[],{"_4190":86499,"_34937":86441,"_23830":145600,"_5":16479,"_31422":145468,"_3630":145601},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, en el secret `edge-cert-pqt`.",{"_4190":86500,"_34937":86441,"_23830":145603,"_5":16479,"_31422":145468,"_3630":145604},[],"La versión mínima de TLS es 1.3, salvo que ambos parámetros sean solo `T`, en cuyo caso es 1.2. cert-manager no puede emitir certificados poscuánticos, por lo que el instalador crea los certificados PQ y PQ/T localmente con OpenSSL 3.5 o posterior; el certificado composite necesita además el módulo `hybrid-provider`, que el script compila bajo demanda con `git`, `cmake` y un compilador de C. Las claves privadas ML-DSA se escriben en la forma de solo semilla que Go acepta, y los secrets se crean a partir de un manifiesto porque `kubectl create secret tls` rechaza claves ML-DSA. Los certificados duran 365 días y se conservan si el secret ya existe.",{"_4190":86501,"_34937":86441,"_23830":145606,"_5":16479,"_31422":145468,"_3630":145607},[],"El script requiere `yq`, `kubectl` y `helm`, y `jq` con `--sample-data`. Al terminar imprime cómo extraer la CA en la que deben confiar los dispositivos, por ejemplo `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_4190":86502,"_34937":86441,"_23830":145609,"_5":16479,"_31422":145468,"_3630":145610},[],"Los scripts complementarios para un broker MQTT detrás de Traefik (`scripts/emqx`), para exportar claves del KMS y para restaurar una copia de seguridad están presentes en el árbol de trabajo del chart, pero sin confirmar en el repositorio. Son solo para uso en laboratorio y no se describen más aquí.",{"_4190":86503,"_34937":86441,"_23830":145612,"_5":16479,"_31422":145468,"_3630":145613},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo elige certificado el proxy y cómo se compila.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4190":86504,"_34937":86441,"_23830":145615,"_5":16479,"_31422":145468,"_3630":145616},[],"<Card title=\"Limitaciones conocidas\" description=\"Advertencias del despliegue de laboratorio.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":86505,"_34937":86505,"_5":16871,"_3630":145618,"_35372":145619,"_23830":145620,"_31422":86505},"Toolchain de Go PQC",[58062,138452,144911,144912],[],{"_4190":86506,"_34937":86505,"_23830":145622,"_5":16479,"_31422":86505,"_3630":145623},[],"El fork de Go que añade ML-DSA composite, SLH-DSA, certificados relacionados y esquemas de firma TLS composite, la API que expone y cómo se compila.",{"_4190":86507,"_34937":86505,"_5":35369,"_23830":145625,"_31422":145626,"_3630":145627},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#qué-añade-el-fork","Qué añade el fork",{"_4190":86508,"_34937":86505,"_5":35369,"_23830":145629,"_31422":145630,"_3630":145631},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#puntos-de-código-tls","Puntos de código TLS",{"_4190":86509,"_34937":86505,"_5":35369,"_23830":145633,"_31422":145634,"_3630":145635},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#un-ejemplo-mínimo","Un ejemplo mínimo",{"_4190":86510,"_34937":86505,"_5":35369,"_23830":145637,"_31422":145638,"_3630":145639},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#enfoques-descartados","Enfoques descartados",{"_4190":86511,"_34937":86505,"_5":35369,"_23830":145641,"_31422":145642,"_3630":145643},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#compilación-del-toolchain-y-de-las-imágenes","Compilación del toolchain y de las imágenes",{"_4190":86512,"_34937":86505,"_23830":145645,"_5":16479,"_31422":86505,"_3630":145646},[],"Go 1.27 incluye ML-DSA en `crypto/mldsa` y en X.509 y TLS, pero no tiene certificados composite ni SLH-DSA, ni certificados relacionados, ni esquemas de firma TLS composite. Por ello Lamassu compila su backend y su proxy TLS con un fork de Go, mantenido en la rama `release-branch.go1.27`. Esta página describe lo que añade el fork, para quienes compilan Lamassu o escriben un cliente que debe comunicarse con él.",{"_4190":86513,"_34937":86505,"_23830":145648,"_5":16479,"_31422":86505,"_3630":145649},[],"El fork expone APIs que no existen en la distribución oficial de Go. El código que las usa solo compila con este toolchain, y no debe suponerse que un binario construido con él cumple la promesa de compatibilidad de Go para esas APIs.",{"_4190":86514,"_34937":86505,"_23830":145651,"_5":16479,"_31422":145626,"_3630":145652},[],"**ML-DSA composite en X.509.** El paquete `x509` incorpora `CompositePublicKey` y `CompositePrivateKey`, que implementan `crypto.Signer`, y 15 valores `CompositeAlgorithm` (por ejemplo `x509.MLDSA65_ECDSA_P384_SHA512`) que permiten generar claves, firmar y verificar. Los certificados, las solicitudes de certificado y las listas de revocación firmados con estas claves se interpretan, se serializan y se verifican como cualquier otro. Se admite la codificación PKCS#8 de claves privadas composite. La página de algoritmos enumera los identificadores.",{"_4190":86515,"_34937":86505,"_23830":145654,"_5":16479,"_31422":145626,"_3630":145655},[],"**SLH-DSA en X.509.** El algoritmo de clave pública `x509.SLHDSA` y doce algoritmos de firma `PureSLHDSA...` están disponibles para interpretar y verificar certificados y claves. La implementación es la biblioteca `circl` de Cloudflare incorporada al fork. Es la parte menos probada: no tiene pruebas propias en x509 ni soporte TLS.",{"_4190":86516,"_34937":86505,"_23830":145657,"_5":16479,"_31422":145626,"_3630":145658},[],"**Certificados relacionados (RFC 9763).** El fork ofrece `x509.CreateBoundCertificate`, que añade a un certificado la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), `x509.VerifyRelatedCertificate` y las funciones para construir y comprobar el atributo `relatedCertRequest` de una solicitud de certificado (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` incorpora el campo `ExtraAttributes` para transportarlo. Certificados relacionados explica cómo los usa Lamassu.",{"_4190":86517,"_34937":86505,"_23830":145660,"_5":16479,"_31422":145626,"_3630":145661},[],"**Esquemas de firma composite en TLS.** El paquete `tls` añade 15 constantes `SignatureScheme`, una por algoritmo composite, que se anuncian por defecto después de los esquemas ML-DSA nativos. Solo funcionan con TLS 1.3 y están probadas con autenticación mutua. Sus puntos de código se describen a continuación.",{"_4190":86518,"_34937":86505,"_23830":145663,"_5":16479,"_31422":145630,"_3630":145664},[],"IANA no ha asignado puntos de código a los esquemas de firma TLS composite, por lo que el fork usa el rango de uso privado `0xFE00` a `0xFE0E`, en el orden de la tabla composite: `0xFE00` es `MLDSA44-RSA2048-PSS-SHA256` y `0xFE0E` es `MLDSA65-Ed25519-SHA512`. Un cliente o un servidor construido con una biblioteca TLS estándar no los reconoce y recurrirá a otro esquema o fallará en el handshake. La interoperabilidad queda así limitada a pares construidos con este fork, o a los esquemas ML-DSA nativos (`0x0904` a `0x0906`) que implementa Go 1.27 estándar.",{"_4190":86519,"_34937":86505,"_23830":145666,"_5":16479,"_31422":145630,"_3630":145667},[],"Las tres variantes que usan RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` y `MLDSA65-RSA4096-PKCS15-SHA512`) se anuncian únicamente en la extensión `signature_algorithms_cert`, por lo que pueden aparecer en una cadena de certificados, pero un certificado hoja con una clave de ese tipo no puede firmar el handshake.",{"_4190":86520,"_34937":86505,"_23830":145669,"_5":16479,"_31422":145630,"_3630":145670},[],"Punto de código",{"_4190":86521,"_34937":86505,"_23830":145672,"_5":16479,"_31422":145630,"_3630":145116},[],{"_4190":86522,"_34937":86505,"_23830":145674,"_5":16479,"_31422":145630,"_3630":66995},[],{"_4190":86523,"_34937":86505,"_23830":145676,"_5":16479,"_31422":145630,"_3630":66406},[],{"_4190":86524,"_34937":86505,"_23830":145678,"_5":16479,"_31422":145630,"_3630":67000},[],{"_4190":86525,"_34937":86505,"_23830":145680,"_5":16479,"_31422":145630,"_3630":66416},[],{"_4190":86526,"_34937":86505,"_23830":145682,"_5":16479,"_31422":145630,"_3630":67005},[],{"_4190":86527,"_34937":86505,"_23830":145684,"_5":16479,"_31422":145630,"_3630":66425},[],{"_4190":86528,"_34937":86505,"_23830":145686,"_5":16479,"_31422":145630,"_3630":67010},[],{"_4190":86529,"_34937":86505,"_23830":145688,"_5":16479,"_31422":145630,"_3630":66434},[],{"_4190":86530,"_34937":86505,"_23830":145690,"_5":16479,"_31422":145630,"_3630":67015},[],{"_4190":86531,"_34937":86505,"_23830":145692,"_5":16479,"_31422":145630,"_3630":66443},[],{"_4190":86532,"_34937":86505,"_23830":145694,"_5":16479,"_31422":145630,"_3630":67020},[],{"_4190":86533,"_34937":86505,"_23830":145696,"_5":16479,"_31422":145630,"_3630":66452},[],{"_4190":86534,"_34937":86505,"_23830":145698,"_5":16479,"_31422":145630,"_3630":67025},[],{"_4190":86535,"_34937":86505,"_23830":145700,"_5":16479,"_31422":145630,"_3630":66461},[],{"_4190":86536,"_34937":86505,"_23830":145702,"_5":16479,"_31422":145630,"_3630":67030},[],{"_4190":86537,"_34937":86505,"_23830":145704,"_5":16479,"_31422":145630,"_3630":66470},[],{"_4190":86538,"_34937":86505,"_23830":145706,"_5":16479,"_31422":145630,"_3630":67035},[],{"_4190":86539,"_34937":86505,"_23830":145708,"_5":16479,"_31422":145630,"_3630":66479},[],{"_4190":86540,"_34937":86505,"_23830":145710,"_5":16479,"_31422":145630,"_3630":67040},[],{"_4190":86541,"_34937":86505,"_23830":145712,"_5":16479,"_31422":145630,"_3630":66489},[],{"_4190":86542,"_34937":86505,"_23830":145714,"_5":16479,"_31422":145630,"_3630":67045},[],{"_4190":86543,"_34937":86505,"_23830":145716,"_5":16479,"_31422":145630,"_3630":66498},[],{"_4190":86544,"_34937":86505,"_23830":145718,"_5":16479,"_31422":145630,"_3630":67050},[],{"_4190":86545,"_34937":86505,"_23830":145720,"_5":16479,"_31422":145630,"_3630":66507},[],{"_4190":86546,"_34937":86505,"_23830":145722,"_5":16479,"_31422":145630,"_3630":67055},[],{"_4190":86547,"_34937":86505,"_23830":145724,"_5":16479,"_31422":145630,"_3630":66516},[],{"_4190":86548,"_34937":86505,"_23830":145726,"_5":16479,"_31422":145630,"_3630":67060},[],{"_4190":86549,"_34937":86505,"_23830":145728,"_5":16479,"_31422":145630,"_3630":66525},[],{"_4190":86550,"_34937":86505,"_23830":145730,"_5":16479,"_31422":145630,"_3630":67065},[],{"_4190":86551,"_34937":86505,"_23830":145732,"_5":16479,"_31422":145630,"_3630":66534},[],{"_4190":86552,"_34937":86505,"_23830":145734,"_5":16479,"_31422":145630,"_3630":145735},[],"El intercambio de claves no cambia respecto a Go original. Los grupos híbridos como `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` y el `MLKEM1024` puro son los de la biblioteca estándar de Go 1.27.",{"_4190":86553,"_34937":86505,"_23830":145737,"_5":16479,"_31422":145630,"_3630":145327},[],{"_4190":86554,"_34937":86505,"_23830":145739,"_5":16479,"_31422":145630,"_3630":145740},[],"Composición",{"_4190":86555,"_34937":86505,"_23830":145742,"_5":16479,"_31422":145630,"_3630":67078},[],{"_4190":86556,"_34937":86505,"_23830":145744,"_5":16479,"_31422":145630,"_3630":67081},[],{"_4190":86557,"_34937":86505,"_23830":145746,"_5":16479,"_31422":145630,"_3630":67084},[],{"_4190":86558,"_34937":86505,"_23830":145748,"_5":16479,"_31422":145630,"_3630":67087},[],{"_4190":86559,"_34937":86505,"_23830":145750,"_5":16479,"_31422":145630,"_3630":67090},[],{"_4190":86560,"_34937":86505,"_23830":145752,"_5":16479,"_31422":145630,"_3630":67093},[],{"_4190":86561,"_34937":86505,"_23830":145754,"_5":16479,"_31422":145630,"_3630":66909},[],{"_4190":86562,"_34937":86505,"_23830":145756,"_5":16479,"_31422":145630,"_3630":145757},[],"ML-KEM-1024 solo",{"_4190":86563,"_34937":86505,"_23830":145759,"_5":16479,"_31422":145630,"_3630":145760},[],"La conexión sigue protegida mientras al menos un componente de un grupo híbrido se mantenga seguro. El intercambio de claves es independiente del tipo de certificado: una conexión puede usar un certificado clásico y aun así tener un intercambio de claves poscuántico.",{"_4190":86564,"_34937":86505,"_23830":145762,"_5":16479,"_31422":145634,"_3630":145763},[],"El siguiente programa crea un certificado composite autofirmado y lo usa como certificado de servidor en una configuración TLS 1.3. Se omite la gestión de errores.",{"_4190":86565,"_34937":86505,"_23830":145765,"_5":16479,"_31422":145634,"_3630":145766},[],"Una clave composite también puede firmar directamente un mensaje, con un contexto opcional de como máximo 255 bytes:",{"_4190":86566,"_34937":86505,"_23830":145768,"_5":16479,"_31422":145638,"_3630":145769},[],"Las primeras iteraciones del fork implementaron certificados Chameleon, definidos en `draft-bonnell-lamps-chameleon-certs`. La idea es emparejar dos certificados del mismo sujeto, por ejemplo uno clásico y otro poscuántico, emitiendo el primero con una extensión que codifica solo las diferencias respecto al segundo. Quien confía en el certificado y entiende la extensión puede reconstruir el certificado emparejado a partir de ella y validar ese, de modo que un único certificado emitido lleva ambas identidades sin cambiar las reglas de validación de ruta del RFC 5280.",{"_4190":86567,"_34937":86505,"_23830":145771,"_5":16479,"_31422":145638,"_3630":145772},[],"El trabajo se descartó porque el borrador caducó sin llegar a ser un estándar y ya no se persigue, de modo que no había una especificación estable con la que interoperar. Nada en la implementación actual depende de él.",{"_4190":86568,"_34937":86505,"_23830":145774,"_5":16479,"_31422":145642,"_3630":145775},[],"El fork se compila en CI mediante un workflow que ejecuta la batería de pruebas de Go y después publica una imagen multiarquitectura, `ghcr.io/lamassuiot/golang-pqc`, con la etiqueta `go1.27` y, para la rama `release-branch.go1.27`, `latest`. La imagen contiene el toolchain en `/usr/local/go-pqc`, con `GOROOT` apuntando a esa ruta.",{"_4190":86569,"_34937":86505,"_23830":145777,"_5":16479,"_31422":145642,"_3630":145778},[],"Para compilar el toolchain desde el código fuente, usa la rama `release-branch.go1.27` y la compilación estándar de Go:",{"_4190":86570,"_34937":86505,"_23830":145780,"_5":16479,"_31422":145642,"_3630":145781},[],"El comando `bin/go` resultante se usa como cualquier otra cadena de herramientas de Go.",{"_4190":86571,"_34937":86505,"_23830":145783,"_5":16479,"_31422":145642,"_3630":145784},[],"Lamassu consume el toolchain de dos maneras. Las imágenes del backend (CA, KMS, VA, alertas, device manager, DMS manager y la compilación monolítica) usan `ghcr.io/lamassuiot/golang-pqc:latest` como imagen de compilación. El workflow de CI del backend instala el mismo toolchain mediante una acción de configuración propia, en lugar de `actions/setup-go`, y el backend exige `go 1.27.3` en su fichero de módulo. Traefik no se compila desde la imagen: su script `build.sh` espera una copia ya compilada del fork en un directorio vecino y genera el binario fuera de un contenedor. Véase Proxy TLS con Traefik.",{"_4190":86572,"_34937":86505,"_23830":145786,"_5":16479,"_31422":145642,"_3630":145787},[],"<Card title=\"Algoritmos\" description=\"Los identificadores y conjuntos de parámetros que hay detrás de estas constantes.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4190":86573,"_34937":86505,"_23830":145789,"_5":16479,"_31422":145642,"_3630":145790},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo se usa el fork para terminar el TLS de los dispositivos.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4190":86574,"_34937":86574,"_5":16871,"_3630":145792,"_35372":145793,"_23830":145795,"_31422":86574},"Pruebas de integración HTTPS",[58062,138452,144911,145794],"Pruebas de integración",[],{"_4190":86575,"_34937":86574,"_23830":145797,"_5":16479,"_31422":86574,"_3630":145798},[],"Resultados de probar un endpoint HTTPS de Lamassu con OpenSSL y curl usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_4190":86576,"_34937":86574,"_5":35369,"_23830":145800,"_31422":145801,"_3630":145802},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#escenario","Escenario",{"_4190":86577,"_34937":86574,"_5":35369,"_23830":145804,"_31422":145805,"_3630":145806},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#resultados","Resultados",{"_4190":86578,"_34937":86574,"_5":35369,"_23830":145808,"_31422":145809,"_3630":145810},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#reproducir-un-caso","Reproducir un caso",{"_4190":86579,"_34937":86574,"_5":35369,"_23830":145812,"_31422":145813,"_3630":145814},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#conecta-ofreciendo-un-grupo-y-un-esquema-de-firma","Conecta ofreciendo un grupo y un esquema de firma",{"_4190":86580,"_34937":86574,"_5":35369,"_23830":145816,"_31422":145817,"_3630":145818},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#envía-una-petición","Envía una petición",{"_4190":86581,"_34937":86574,"_5":35369,"_23830":145820,"_31422":145821,"_3630":145822},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#comprueba-que-una-oferta-incorrecta-se-rechaza","Comprueba que una oferta incorrecta se rechaza",{"_4190":86582,"_34937":86574,"_23830":145824,"_5":16479,"_31422":86574,"_3630":145825},[],"Esta prueba conecta con un endpoint de la API de Lamassu por HTTPS desde un cliente OpenSSL y comprueba que el handshake poscuántico, la cadena de certificados y la petición de aplicación funcionan. El resumen explica los clientes, la matriz de pruebas y qué demuestra cada comprobación.",{"_4190":86583,"_34937":86574,"_23830":145827,"_5":16479,"_31422":145801,"_3630":145828},[],"El cliente solicita `GET /api/ca/health` a través del proxy Traefik, que la reenvía a Envoy Gateway y al servicio de CA. El certificado del servidor y la CA que lo firmó se crearon fuera de Lamassu y se cargaron en el proxy para cada caso. En cada caso el proxy se configuró con los grupos de intercambio de claves y el certificado de esa fila y columna de la matriz.",{"_4190":86584,"_34937":86574,"_23830":145830,"_5":16479,"_31422":145801,"_3630":145831},[],"Las CAs y los certificados son material de pruebas creado fuera de Lamassu, válido durante un periodo corto y con el nombre del servidor como nombre alternativo del sujeto. No los emite el servicio de CA de Lamassu.",{"_4190":86585,"_34937":86574,"_23830":145833,"_5":16479,"_31422":145805,"_3630":145834},[],"Las nueve combinaciones de intercambio de claves y certificado se superaron, igual que los tres certificados composite adicionales.",{"_4190":86586,"_34937":86574,"_23830":145836,"_5":16479,"_31422":145805,"_3630":145837},[],"Intercambio de claves ↓ / Certificado →",{"_4190":86587,"_34937":86574,"_23830":145839,"_5":16479,"_31422":145805,"_3630":67181},[],{"_4190":86588,"_34937":86574,"_23830":145841,"_5":16479,"_31422":145805,"_3630":67184},[],{"_4190":86589,"_34937":86574,"_23830":145843,"_5":16479,"_31422":145805,"_3630":67187},[],{"_4190":86590,"_34937":86574,"_23830":145845,"_5":16479,"_31422":145805,"_3630":67190},[],{"_4190":86591,"_34937":86574,"_23830":145847,"_5":16479,"_31422":145805,"_3630":67193},[],{"_4190":86592,"_34937":86574,"_23830":145849,"_5":16479,"_31422":145805,"_3630":67196},[],{"_4190":86593,"_34937":86574,"_23830":145851,"_5":16479,"_31422":145805,"_3630":67199},[],{"_4190":86594,"_34937":86574,"_23830":145853,"_5":16479,"_31422":145805,"_3630":67202},[],{"_4190":86595,"_34937":86574,"_23830":145855,"_5":16479,"_31422":145805,"_3630":67205},[],{"_4190":86596,"_34937":86574,"_23830":145857,"_5":16479,"_31422":145805,"_3630":67208},[],{"_4190":86597,"_34937":86574,"_23830":145859,"_5":16479,"_31422":145805,"_3630":67211},[],{"_4190":86598,"_34937":86574,"_23830":145861,"_5":16479,"_31422":145805,"_3630":67214},[],{"_4190":86599,"_34937":86574,"_23830":145863,"_5":16479,"_31422":145805,"_3630":67217},[],{"_4190":86600,"_34937":86574,"_23830":145865,"_5":16479,"_31422":145805,"_3630":67220},[],{"_4190":86601,"_34937":86574,"_23830":145867,"_5":16479,"_31422":145805,"_3630":67223},[],{"_4190":86602,"_34937":86574,"_23830":145869,"_5":16479,"_31422":145805,"_3630":145870},[],"Cada celda muestra el grupo negociado y el esquema de la firma del handshake. En todos los casos la cadena se verificó, la petición devolvió `200` y las dos comprobaciones negativas se rechazaron con `handshake_failure`.",{"_4190":86603,"_34937":86574,"_23830":145872,"_5":16479,"_31422":145805,"_3630":145873},[],"Composite adicional",{"_4190":86604,"_34937":86574,"_23830":145875,"_5":16479,"_31422":145805,"_3630":145876},[],"Esquema de firma",{"_4190":86605,"_34937":86574,"_23830":145878,"_5":16479,"_31422":145805,"_3630":142110},[],{"_4190":86606,"_34937":86574,"_23830":145880,"_5":16479,"_31422":145805,"_3630":67237},[],{"_4190":86607,"_34937":86574,"_23830":145882,"_5":16479,"_31422":145805,"_3630":67240},[],{"_4190":86608,"_34937":86574,"_23830":145884,"_5":16479,"_31422":145805,"_3630":145885},[],"✅ con `X25519MLKEM768`",{"_4190":86609,"_34937":86574,"_23830":145887,"_5":16479,"_31422":145805,"_3630":67246},[],{"_4190":86610,"_34937":86574,"_23830":145889,"_5":16479,"_31422":145805,"_3630":67249},[],{"_4190":86611,"_34937":86574,"_23830":145891,"_5":16479,"_31422":145805,"_3630":145885},[],{"_4190":86612,"_34937":86574,"_23830":145893,"_5":16479,"_31422":145805,"_3630":67254},[],{"_4190":86613,"_34937":86574,"_23830":145895,"_5":16479,"_31422":145805,"_3630":67257},[],{"_4190":86614,"_34937":86574,"_23830":145897,"_5":16479,"_31422":145805,"_3630":145885},[],{"_4190":86615,"_34937":86574,"_23830":145899,"_5":16479,"_31422":145805,"_3630":145900},[],"Con una única configuración de servidor que tiene a la vez los certificados ECDSA, ML-DSA-65 y composite y acepta las tres clases de intercambio de claves, un cliente que ofrecía un grupo y un esquema de firma negoció cada una de las nueve combinaciones. `curl` devolvió `200` cuando confiaba en las tres CAs.",{"_4190":86616,"_34937":86574,"_23830":145902,"_5":16479,"_31422":145805,"_3630":145903},[],"Un servidor con certificados de varias clases sirve el primero que coincide con la preferencia de firma del cliente. Un cliente OpenSSL 3.5 o posterior con la configuración por defecto prefiere ML-DSA, así que un cliente que solo confía en la CA ECDSA falla con `unable to get local issuer certificate`, aunque la conexión en sí haya funcionado. Da a los clientes las CAs de todas las clases que el servidor pueda presentar.",{"_4190":86617,"_34937":86574,"_23830":145905,"_5":16479,"_31422":145809,"_3630":145906},[],"Necesitas OpenSSL 3.5 o posterior. Para certificados composite, además el módulo `hybrid-provider` con puntos de código que coincidan con los del toolchain de Go PQC, cargado mediante `OPENSSL_CONF`. Usa el fichero de CA del caso como `ca.pem`.",{"_4190":86618,"_34937":86574,"_23830":145908,"_5":16479,"_31422":145813,"_3630":145909},[],"Este ejemplo prueba intercambio de claves PQ/T con el certificado composite e imprime los valores negociados:",{"_4190":86619,"_34937":86574,"_23830":145911,"_5":16479,"_31422":145813,"_3630":145912},[],"Salida esperada:",{"_4190":86620,"_34937":86574,"_23830":145914,"_5":16479,"_31422":145817,"_3630":145915},[],"Sustituye el `grep` por una petición HTTP para confirmar que la capa de aplicación funciona a través del proxy:",{"_4190":86621,"_34937":86574,"_23830":145917,"_5":16479,"_31422":145817,"_3630":145918},[],"La respuesta empieza por `HTTP/1.1 200 OK`. Con `curl` y un bundle que contenga las CAs de las clases que presenta el servidor, `curl --cacert ca-bundle.pem https://<LAMASSU_HOST>/api/ca/health` también devuelve `200`.",{"_4190":86622,"_34937":86574,"_23830":145920,"_5":16479,"_31422":145821,"_3630":145921},[],"Ofrece solo grupos clásicos a un servidor configurado para intercambio de claves PQ:",{"_4190":86623,"_34937":86574,"_23830":145923,"_5":16479,"_31422":145821,"_3630":145924},[],"El handshake falla con una alerta `handshake failure`. Ofrecer todos los esquemas de firma salvo el del certificado da el mismo resultado.",{"_4190":86624,"_34937":86574,"_23830":145926,"_5":16479,"_31422":145821,"_3630":145927},[],"<Card title=\"MQTTS\" description=\"Las mismas comprobaciones para un broker MQTT.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4190":86625,"_34937":86574,"_23830":145929,"_5":16479,"_31422":145821,"_3630":145930},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo elige el proxy el certificado e impone el intercambio de claves.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4190":86626,"_34937":86626,"_5":16871,"_3630":145932,"_35372":145933,"_23830":145934,"_31422":86626},"Pruebas de integración MQTTS",[58062,138452,144911,145794],[],{"_4190":86627,"_34937":86626,"_23830":145936,"_5":16479,"_31422":86626,"_3630":145937},[],"Resultados de probar un broker MQTT detrás del proxy TLS de Lamassu con mosquitto, usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_4190":86628,"_34937":86626,"_5":35369,"_23830":145939,"_31422":145940,"_3630":145802},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#escenario",{"_4190":86629,"_34937":86626,"_5":35369,"_23830":145942,"_31422":145943,"_3630":145806},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#resultados",{"_4190":86630,"_34937":86626,"_5":35369,"_23830":145945,"_31422":145946,"_3630":145810},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#reproducir-un-caso",{"_4190":86631,"_34937":86626,"_5":35369,"_23830":145948,"_31422":145949,"_3630":145950},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#crea-la-configuración-de-openssl","Crea la configuración de OpenSSL",{"_4190":86632,"_34937":86626,"_5":35369,"_23830":145952,"_31422":145953,"_3630":145954},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#suscríbete-y-publica","Suscríbete y publica",{"_4190":86633,"_34937":86626,"_5":35369,"_23830":145956,"_31422":145957,"_3630":145822},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#comprueba-que-una-oferta-incorrecta-se-rechaza",{"_4190":86634,"_34937":86626,"_5":35369,"_23830":145959,"_31422":145960,"_3630":145961},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#qué-debes-saber","Qué debes saber",{"_4190":86635,"_34937":86626,"_23830":145963,"_5":16479,"_31422":86626,"_3630":145964},[],"Esta prueba conecta `mosquitto_pub` y `mosquitto_sub` a un broker MQTT por TLS y comprueba que los mensajes lo atraviesan con intercambio de claves poscuántico y certificados de servidor poscuánticos o composite. El resumen explica los clientes, la matriz de pruebas y qué demuestra cada comprobación.",{"_4190":86636,"_34937":86626,"_23830":145966,"_5":16479,"_31422":145940,"_3630":145967},[],"El broker es EMQX 5.8.9. Escucha MQTT en claro dentro del clúster, y el proxy TLS de Lamassu (Proxy TLS con Traefik) termina el TLS por él en el puerto 8883 y reenvía el tráfico. El TLS es unidireccional: el endpoint del broker presenta su certificado y el cliente no presenta ninguno. El certificado del servidor y su CA se crearon fuera de Lamassu, y el proxy se configuró en cada caso con los grupos de intercambio de claves y el certificado de esa fila y columna de la matriz.",{"_4190":86637,"_34937":86626,"_23830":145969,"_5":16479,"_31422":145940,"_3630":145970},[],"Los clientes son `mosquitto_pub` y `mosquitto_sub` 2.1.2, con MQTT 3.1.1 sobre TLS 1.3 y enlazados con OpenSSL 4.1.0. Un caso se supera cuando el suscriptor recibe el mensaje que el publicador envió a través del broker, ambos clientes validan la cadena de certificados contra la CA del caso y el nombre del servidor, y las dos comprobaciones negativas se rechazan.",{"_4190":86638,"_34937":86626,"_23830":145972,"_5":16479,"_31422":145943,"_3630":145973},[],"Los doce casos se superaron. En cada uno, `mosquitto_sub` se suscribió a un tema, `mosquitto_pub` publicó un valor único y el suscriptor lo recibió. La prueba se ejecutó dos veces por caso: una con el cliente ofreciendo todos los grupos y esquemas de firma, y otra con el cliente ofreciendo solo el grupo y el esquema de firma esperados para el caso. La segunda ejecución demuestra que el endpoint del broker negoció exactamente ese grupo y ese esquema, porque el cliente no ofrecía nada más.",{"_4190":86639,"_34937":86626,"_23830":145975,"_5":16479,"_31422":145943,"_3630":145837},[],{"_4190":86640,"_34937":86626,"_23830":145977,"_5":16479,"_31422":145943,"_3630":67181},[],{"_4190":86641,"_34937":86626,"_23830":145979,"_5":16479,"_31422":145943,"_3630":67184},[],{"_4190":86642,"_34937":86626,"_23830":145981,"_5":16479,"_31422":145943,"_3630":67187},[],{"_4190":86643,"_34937":86626,"_23830":145983,"_5":16479,"_31422":145943,"_3630":67190},[],{"_4190":86644,"_34937":86626,"_23830":145985,"_5":16479,"_31422":145943,"_3630":67193},[],{"_4190":86645,"_34937":86626,"_23830":145987,"_5":16479,"_31422":145943,"_3630":67196},[],{"_4190":86646,"_34937":86626,"_23830":145989,"_5":16479,"_31422":145943,"_3630":67199},[],{"_4190":86647,"_34937":86626,"_23830":145991,"_5":16479,"_31422":145943,"_3630":67202},[],{"_4190":86648,"_34937":86626,"_23830":145993,"_5":16479,"_31422":145943,"_3630":67205},[],{"_4190":86649,"_34937":86626,"_23830":145995,"_5":16479,"_31422":145943,"_3630":67208},[],{"_4190":86650,"_34937":86626,"_23830":145997,"_5":16479,"_31422":145943,"_3630":67211},[],{"_4190":86651,"_34937":86626,"_23830":145999,"_5":16479,"_31422":145943,"_3630":67214},[],{"_4190":86652,"_34937":86626,"_23830":146001,"_5":16479,"_31422":145943,"_3630":67217},[],{"_4190":86653,"_34937":86626,"_23830":146003,"_5":16479,"_31422":145943,"_3630":67220},[],{"_4190":86654,"_34937":86626,"_23830":146005,"_5":16479,"_31422":145943,"_3630":67223},[],{"_4190":86655,"_34937":86626,"_23830":146007,"_5":16479,"_31422":145943,"_3630":146008},[],"Los certificados composite adicionales se comportan igual con intercambio de claves PQ/T.",{"_4190":86656,"_34937":86626,"_23830":146010,"_5":16479,"_31422":145943,"_3630":145873},[],{"_4190":86657,"_34937":86626,"_23830":146012,"_5":16479,"_31422":145943,"_3630":145876},[],{"_4190":86658,"_34937":86626,"_23830":146014,"_5":16479,"_31422":145943,"_3630":142110},[],{"_4190":86659,"_34937":86626,"_23830":146016,"_5":16479,"_31422":145943,"_3630":67237},[],{"_4190":86660,"_34937":86626,"_23830":146018,"_5":16479,"_31422":145943,"_3630":67240},[],{"_4190":86661,"_34937":86626,"_23830":146020,"_5":16479,"_31422":145943,"_3630":67382},[],{"_4190":86662,"_34937":86626,"_23830":146022,"_5":16479,"_31422":145943,"_3630":67246},[],{"_4190":86663,"_34937":86626,"_23830":146024,"_5":16479,"_31422":145943,"_3630":67249},[],{"_4190":86664,"_34937":86626,"_23830":146026,"_5":16479,"_31422":145943,"_3630":67382},[],{"_4190":86665,"_34937":86626,"_23830":146028,"_5":16479,"_31422":145943,"_3630":67254},[],{"_4190":86666,"_34937":86626,"_23830":146030,"_5":16479,"_31422":145943,"_3630":67257},[],{"_4190":86667,"_34937":86626,"_23830":146032,"_5":16479,"_31422":145943,"_3630":67382},[],{"_4190":86668,"_34937":86626,"_23830":146034,"_5":16479,"_31422":145943,"_3630":146035},[],"Cuando el cliente ofrecía todos los grupos salvo los de la clase del caso, o todos los esquemas de firma salvo el del certificado, el handshake TLS fallaba con una alerta `handshake failure` y el broker nunca enviaba un `CONNACK`. El resultado fue el mismo en los doce casos.",{"_4190":86669,"_34937":86626,"_23830":146037,"_5":16479,"_31422":145943,"_3630":146038},[],"Con una única configuración de servidor que tiene los certificados ECDSA, ML-DSA-65 y composite y acepta las tres clases de intercambio de claves, cada una de las nueve combinaciones conectó en el puerto 8883 cuando el cliente ofrecía un grupo y un esquema de firma. `mosquitto_pub` recibió `CONNACK (0)` en todas.",{"_4190":86670,"_34937":86626,"_23830":146040,"_5":16479,"_31422":145946,"_3630":146041},[],"mosquitto no tiene opciones para elegir grupos de intercambio de claves ni esquemas de firma, así que se fijan mediante un fichero de configuración de OpenSSL que `mosquitto_pub` y `mosquitto_sub` leen de la variable de entorno `OPENSSL_CONF`. Necesitas OpenSSL 3.5 o posterior; para certificados composite, además el módulo `hybrid-provider` con puntos de código que coincidan con los del toolchain de Go PQC.",{"_4190":86671,"_34937":86626,"_23830":146043,"_5":16479,"_31422":145949,"_3630":146044},[],"Este `pqc-client.cnf` hace que el cliente ofrezca solo `X25519MLKEM768` y el esquema de firma composite, y carga el provider composite:",{"_4190":86672,"_34937":86626,"_23830":146046,"_5":16479,"_31422":145949,"_3630":146047},[],"Elimina el provider `hybrid` y el módulo en un caso que use solo ML-DSA o ECDSA.",{"_4190":86673,"_34937":86626,"_23830":146049,"_5":16479,"_31422":145953,"_3630":146050},[],"Arranca el suscriptor en una terminal y el publicador en otra. Ambos validan el certificado del broker contra `ca.pem`, la CA del caso:",{"_4190":86674,"_34937":86626,"_23830":146052,"_5":16479,"_31422":145953,"_3630":146053},[],"El suscriptor imprime `hello over pqc` y termina. Añade `-d` para ver los paquetes `CONNECT`, `CONNACK (0)`, `SUBACK` y `PUBLISH`.",{"_4190":86675,"_34937":86626,"_23830":146055,"_5":16479,"_31422":145957,"_3630":146056},[],"Cambia `Groups` por una lista que no incluya el grupo que acepta el servidor, por ejemplo `Groups = X25519` frente a un servidor configurado para `MLKEM1024`, y repite la publicación. El cliente falla con `tls alert handshake failure` y no se recibe ningún `CONNACK`.",{"_4190":86676,"_34937":86626,"_23830":146058,"_5":16479,"_31422":145960,"_3630":146059},[],"**Nombre del host y certificado.** mosquitto usa el valor de `-h` como destino de la conexión, como nombre de servidor enviado en el handshake y como nombre que verifica. Los certificados de prueba llevan ese nombre como nombre alternativo del sujeto.",{"_4190":86677,"_34937":86626,"_23830":146061,"_5":16479,"_31422":145960,"_3630":146062},[],"**Un certificado por nombre.** El proxy TLS guarda sus certificados por nombre, no por puerto. Un endpoint MQTT que comparte nombre con el endpoint HTTPS sirve los mismos certificados, así que da al broker su propio nombre si necesita un certificado distinto.",{"_4190":86678,"_34937":86626,"_23830":146064,"_5":16479,"_31422":145960,"_3630":146065},[],"**No se probaron los valores por defecto sin fijar.** Todas las ejecuciones fijaron explícitamente la oferta de grupos y firmas, así que no se comprobó qué negocia mosquitto con la oferta por defecto de OpenSSL. Las pruebas HTTPS sí cubren un cliente OpenSSL por defecto: recibe el certificado ML-DSA si el servidor lo tiene.",{"_4190":86679,"_34937":86626,"_23830":146067,"_5":16479,"_31422":145960,"_3630":146068},[],"**Otros clientes en el mismo puerto.** Imponer TLS 1.3 o algoritmos poscuánticos en un puerto MQTT compartido afecta a todos los clientes que se conectan a él. Durante las pruebas el proxy registró intentos de conexión de otros clientes que solo admiten TLS 1.2 o anterior, o que no confiaban en el certificado. Identifícalos antes de dejar el ajuste de forma permanente.",{"_4190":86680,"_34937":86626,"_23830":146070,"_5":16479,"_31422":145960,"_3630":146071},[],"<Card title=\"HTTPS\" description=\"Las mismas comprobaciones para un endpoint HTTPS de Lamassu.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4190":86681,"_34937":86626,"_23830":146073,"_5":16479,"_31422":145960,"_3630":146074},[],"<Card title=\"Despliegue con el chart de Helm\" description=\"Despliega el proxy que termina el TLS.\" href=\"/docs/platform/pqc/deployment\" />",{"_4190":86682,"_34937":86682,"_5":16871,"_3630":146076,"_35372":146077,"_23830":146078,"_31422":86682},"Resumen de las pruebas de integración",[58062,138452,144911,145794],[],{"_4190":86683,"_34937":86682,"_23830":146080,"_5":16479,"_31422":86682,"_3630":146081},[],"Evidencia de que software ajeno a Lamassu negocia intercambio de claves poscuántico y verifica los certificados poscuánticos y composite que sirve Lamassu.",{"_4190":86684,"_34937":86682,"_5":35369,"_23830":146083,"_31422":146084,"_3630":146085},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#qué-se-probó","Qué se probó",{"_4190":86685,"_34937":86682,"_5":35369,"_23830":146087,"_31422":146088,"_3630":146089},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#la-matriz-de-pruebas","La matriz de pruebas",{"_4190":86686,"_34937":86682,"_5":35369,"_23830":146091,"_31422":146092,"_3630":146093},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#qué-comprueba-cada-caso","Qué comprueba cada caso",{"_4190":86687,"_34937":86682,"_5":35369,"_23830":146095,"_31422":146096,"_3630":146097},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#comportamiento-esperable","Comportamiento esperable",{"_4190":86688,"_34937":86682,"_23830":146099,"_5":16479,"_31422":86682,"_3630":146100},[],"Los certificados poscuánticos solo sirven si los sistemas que los consumen pueden usarlos. Estas pruebas de integración comprueban que clientes y brokers que no forman parte de Lamassu, construidos sobre otra biblioteca criptográfica, pueden conectarse a un endpoint TLS de Lamassu, negociar un intercambio de claves poscuántico y verificar certificados poscuánticos y composite. Se probaron dos protocolos: HTTPS y MQTTS.",{"_4190":86689,"_34937":86682,"_23830":146102,"_5":16479,"_31422":86682,"_3630":146103},[],"Los certificados y las CAs de las pruebas se generaron fuera de Lamassu, con herramientas estándar, para mostrar que el toolchain de Go PQC implementa los formatos X.509 y TLS de forma interoperable. Demuestran que los certificados creados externamente funcionan con el endpoint TLS de Lamassu y que software independiente los verifica. No prueban certificados emitidos por una CA de Lamassu.",{"_4190":86690,"_34937":86682,"_23830":146105,"_5":16479,"_31422":146084,"_3630":146106},[],"El servidor es el proxy Traefik que termina el TLS de los dispositivos en Lamassu (Proxy TLS con Traefik). Está compilado con el toolchain de Go PQC y se configuró en cada prueba con una clase de intercambio de claves y una clase de certificado.",{"_4190":86691,"_34937":86682,"_23830":146108,"_5":16479,"_31422":146084,"_3630":146109},[],"Los clientes son implementaciones independientes:",{"_4190":86692,"_34937":86682,"_23830":146111,"_5":16479,"_31422":146084,"_3630":146112},[],"**OpenSSL 4.0.3 y 4.1.0**, con el soporte nativo de ML-KEM y ML-DSA de OpenSSL 3.5 y posteriores.",{"_4190":86693,"_34937":86682,"_23830":146114,"_5":16479,"_31422":146084,"_3630":146115},[],"**El módulo `hybrid-provider` de OpenSSL**, para ML-DSA composite. La versión usada se escribió contra el borrador 19 de la especificación, que después se publicó como RFC 10073; los vectores de prueba de ambos son idénticos, pero el provider no se contrastó de otro modo con el texto final.",{"_4190":86694,"_34937":86682,"_23830":146117,"_5":16479,"_31422":146084,"_3630":146118},[],"**`curl`*&#x2A; para HTTPS y **`mosquitto_pub` y `mosquitto_sub` 2.1.2** para MQTTS, ambos enlazados con ese OpenSSL.",{"_4190":86695,"_34937":86682,"_23830":146120,"_5":16479,"_31422":146088,"_3630":146121},[],"Cada combinación de intercambio de claves y certificado se probó por separado, con las familias que Lamassu usa en el resto de la documentación (T, PQ y PQ/T, véase Algoritmos).",{"_4190":86696,"_34937":86682,"_23830":146123,"_5":16479,"_31422":146088,"_3630":146124},[],"Intercambio de claves",{"_4190":86697,"_34937":86682,"_23830":146126,"_5":16479,"_31422":146088,"_3630":146127},[],"Grupos que acepta el servidor",{"_4190":86698,"_34937":86682,"_23830":146129,"_5":16479,"_31422":146088,"_3630":67190},[],{"_4190":86699,"_34937":86682,"_23830":146131,"_5":16479,"_31422":146088,"_3630":66900},[],{"_4190":86700,"_34937":86682,"_23830":146133,"_5":16479,"_31422":146088,"_3630":67202},[],{"_4190":86701,"_34937":86682,"_23830":146135,"_5":16479,"_31422":146088,"_3630":66909},[],{"_4190":86702,"_34937":86682,"_23830":146137,"_5":16479,"_31422":146088,"_3630":67214},[],{"_4190":86703,"_34937":86682,"_23830":146139,"_5":16479,"_31422":146088,"_3630":66918},[],{"_4190":86704,"_34937":86682,"_23830":146141,"_5":16479,"_31422":146088,"_3630":141255},[],{"_4190":86705,"_34937":86682,"_23830":146143,"_5":16479,"_31422":146088,"_3630":146144},[],"Certificado del servidor",{"_4190":86706,"_34937":86682,"_23830":146146,"_5":16479,"_31422":146088,"_3630":67190},[],{"_4190":86707,"_34937":86682,"_23830":146148,"_5":16479,"_31422":146088,"_3630":67511},[],{"_4190":86708,"_34937":86682,"_23830":146150,"_5":16479,"_31422":146088,"_3630":67202},[],{"_4190":86709,"_34937":86682,"_23830":146152,"_5":16479,"_31422":146088,"_3630":66298},[],{"_4190":86710,"_34937":86682,"_23830":146154,"_5":16479,"_31422":146088,"_3630":67214},[],{"_4190":86711,"_34937":86682,"_23830":146156,"_5":16479,"_31422":146088,"_3630":67520},[],{"_4190":86712,"_34937":86682,"_23830":146158,"_5":16479,"_31422":146088,"_3630":146159},[],"Son nueve combinaciones. Se probaron además tres certificados composite con intercambio de claves PQ/T: `MLDSA44-ECDSA-P256-SHA256`, `MLDSA65-ECDSA-P256-SHA512` y `MLDSA65-Ed25519-SHA512`, hasta un total de doce casos. Cada certificado lo emitió una CA de pruebas con el mismo algoritmo que el certificado.",{"_4190":86713,"_34937":86682,"_23830":146161,"_5":16479,"_31422":146092,"_3630":146162},[],"Un caso se supera solo si se cumple todo lo siguiente:",{"_4190":86714,"_34937":86682,"_23830":146164,"_5":16479,"_31422":146092,"_3630":146165},[],"**Intercambio de claves.** El grupo negociado en el handshake es el esperado para el caso.",{"_4190":86715,"_34937":86682,"_23830":146167,"_5":16479,"_31422":146092,"_3630":146168},[],"**Firma.** El esquema de la firma del handshake del servidor es el esperado para el certificado.",{"_4190":86716,"_34937":86682,"_23830":146170,"_5":16479,"_31422":146092,"_3630":146171},[],"**Cadena.** El cliente verifica la cadena de certificados contra la CA del caso y el nombre del servidor, sin errores de verificación.",{"_4190":86717,"_34937":86682,"_23830":146173,"_5":16479,"_31422":146092,"_3630":146174},[],"**Tráfico de aplicación.** El protocolo funciona: una petición HTTP devuelve `200`, o un mensaje MQTT publicado en el broker llega a un suscriptor.",{"_4190":86718,"_34937":86682,"_23830":146176,"_5":16479,"_31422":146092,"_3630":146177},[],"**Se rechaza un intercambio de claves incorrecto.** Un cliente que ofrece todos los grupos salvo los de la clase del caso falla con la alerta TLS `handshake_failure`.",{"_4190":86719,"_34937":86682,"_23830":146179,"_5":16479,"_31422":146092,"_3630":146180},[],"**Se rechaza un esquema de certificado incorrecto.** Un cliente que ofrece todos los esquemas de firma salvo el del certificado falla con la misma alerta.",{"_4190":86720,"_34937":86682,"_23830":146182,"_5":16479,"_31422":146092,"_3630":146183},[],"Las dos últimas comprobaciones demuestran que el servidor impone su configuración, y no solo que acepta a un cliente compatible.",{"_4190":86721,"_34937":86682,"_23830":146185,"_5":16479,"_31422":146096,"_3630":146186},[],"**Hubo que alinear los puntos de código composite.** Los esquemas de firma TLS de los algoritmos composite usan puntos de código de uso privado. El `hybrid-provider` usa por defecto otros valores, así que para las pruebas se igualaron a los del toolchain de Go PQC. Un cliente que implemente TLS composite debe usar los mismos valores.",{"_4190":86722,"_34937":86682,"_23830":146188,"_5":16479,"_31422":146096,"_3630":146189},[],"**ML-DSA puro y ML-KEM no necesitan nada más.** Funcionan con OpenSSL 3.5 o posterior tal cual; solo los certificados composite necesitan el provider.",{"_4190":86723,"_34937":86682,"_23830":146191,"_5":16479,"_31422":146096,"_3630":146192},[],"**Algunos handshakes requieren un viaje de ida y vuelta adicional.** El cliente envía primero el key share de `X25519MLKEM768`. Cuando el servidor está configurado para una clase que no lo incluye (T y PQ), responde con un HelloRetryRequest y el handshake termina con el grupo que pide.",{"_4190":86724,"_34937":86682,"_23830":146194,"_5":16479,"_31422":146096,"_3630":146195},[],"**La preferencia de firma del cliente decide el certificado.** Cuando el servidor tiene certificados de varias clases para el mismo nombre, sirve el primero que coincide con la lista de esquemas de firma del cliente. Un cliente OpenSSL 3.5 o posterior con la configuración por defecto lista ML-DSA primero, de modo que recibe el certificado ML-DSA y debe confiar en esa CA.",{"_4190":86725,"_34937":86682,"_23830":146197,"_5":16479,"_31422":146096,"_3630":146198},[],"<Card title=\"HTTPS\" description=\"Un endpoint de la API de Lamassu probado con openssl y curl.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4190":86726,"_34937":86682,"_23830":146200,"_5":16479,"_31422":146096,"_3630":146201},[],"<Card title=\"MQTTS\" description=\"Un broker MQTT detrás del proxy TLS, probado con mosquitto.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4190":86727,"_34937":86682,"_23830":146203,"_5":16479,"_31422":146096,"_3630":146204},[],"<Card title=\"Limitaciones conocidas\" description=\"Qué no cubren estas pruebas ni la plataforma.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":86728,"_34937":86728,"_5":16871,"_3630":146206,"_35372":146207,"_23830":146208,"_31422":86728},"Claves y autoridades de certificación",[58062,138452,144911,145278],[],{"_4190":86729,"_34937":86728,"_23830":146210,"_5":16479,"_31422":86728,"_3630":146211},[],"Crear claves y CA poscuánticas, firmar con ellas y emitir certificados, con el soporte de motores, los valores de la API y las restricciones aplicables.",{"_4190":86730,"_34937":86728,"_5":35369,"_23830":146213,"_31422":146214,"_3630":146215},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#elegir-un-motor-criptográfico-compatible","Elegir un motor criptográfico compatible",{"_4190":86731,"_34937":86728,"_5":35369,"_23830":146217,"_31422":146218,"_3630":146219},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-clave","Crear una clave",{"_4190":86732,"_34937":86728,"_5":35369,"_23830":146221,"_31422":146222,"_3630":146223},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-autoridad-de-certificación","Crear una autoridad de certificación",{"_4190":86733,"_34937":86728,"_5":35369,"_23830":146225,"_31422":146226,"_3630":146227},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#combinar-algoritmos-en-una-jerarquía","Combinar algoritmos en una jerarquía",{"_4190":86734,"_34937":86728,"_5":35369,"_23830":146229,"_31422":146230,"_3630":146231},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#firmar-y-verificar-con-una-clave","Firmar y verificar con una clave",{"_4190":86735,"_34937":86728,"_5":35369,"_23830":146233,"_31422":146234,"_3630":146235},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#restricciones-a-tener-en-cuenta","Restricciones a tener en cuenta",{"_4190":86736,"_34937":86728,"_23830":146237,"_5":16479,"_31422":86728,"_3630":146238},[],"El backend de Lamassu trata las claves poscuánticas como un tipo más de clave del servicio de gestión de claves (KMS). Una autoridad de certificación creada con una clave así firma certificados y listas de revocación por las mismas rutas que una CA RSA o ECDSA, porque la firma la realiza el fork de Go. Esta página explica qué enviar a la API, qué motores criptográficos pueden custodiar las claves y dónde difiere el comportamiento respecto a las claves clásicas. El backend debe compilarse con el toolchain de Go PQC.",{"_4190":86737,"_34937":86728,"_23830":146240,"_5":16479,"_31422":146214,"_3630":146241},[],"No todos los motores criptográficos pueden crear o custodiar claves poscuánticas. Solo pueden los motores que ejecutan la criptografía dentro del proceso de Lamassu.",{"_4190":86738,"_34937":86728,"_23830":146243,"_5":16479,"_31422":146214,"_3630":146244},[],"Motor",{"_4190":86739,"_34937":86728,"_23830":146246,"_5":16479,"_31422":146214,"_3630":67611},[],{"_4190":86740,"_34937":86728,"_23830":146248,"_5":16479,"_31422":146214,"_3630":67614},[],{"_4190":86741,"_34937":86728,"_23830":146250,"_5":16479,"_31422":146214,"_3630":146251},[],"Soportado",{"_4190":86742,"_34937":86728,"_23830":146253,"_5":16479,"_31422":146214,"_3630":67620},[],{"_4190":86743,"_34937":86728,"_23830":146255,"_5":16479,"_31422":146214,"_3630":146251},[],{"_4190":86744,"_34937":86728,"_23830":146257,"_5":16479,"_31422":146214,"_3630":67625},[],{"_4190":86745,"_34937":86728,"_23830":146259,"_5":16479,"_31422":146214,"_3630":146260},[],"No soportado",{"_4190":86746,"_34937":86728,"_23830":146262,"_5":16479,"_31422":146214,"_3630":65068},[],{"_4190":86747,"_34937":86728,"_23830":146264,"_5":16479,"_31422":146214,"_3630":146260},[],{"_4190":86748,"_34937":86728,"_23830":146266,"_5":16479,"_31422":146214,"_3630":65072},[],{"_4190":86749,"_34937":86728,"_23830":146268,"_5":16479,"_31422":146214,"_3630":146260},[],{"_4190":86750,"_34937":86728,"_23830":146270,"_5":16479,"_31422":146214,"_3630":146271},[],"Azure Key Vault y Azure Secrets",{"_4190":86751,"_34937":86728,"_23830":146273,"_5":16479,"_31422":146214,"_3630":146260},[],{"_4190":86752,"_34937":86728,"_23830":146275,"_5":16479,"_31422":146214,"_3630":67644},[],{"_4190":86753,"_34937":86728,"_23830":146277,"_5":16479,"_31422":146214,"_3630":146260},[],{"_4190":86754,"_34937":86728,"_23830":146279,"_5":16479,"_31422":146214,"_3630":146280},[],"En la práctica, las claves poscuánticas requieren por ahora el motor filesystem, que tiene nivel de seguridad 1. No hay claves con un nivel de garantía superior, en un módulo de seguridad hardware o en un KMS en la nube, para estos algoritmos.",{"_4190":86755,"_34937":86728,"_23830":146282,"_5":16479,"_31422":146214,"_3630":146283},[],"Los motores Vault KV2 y AWS Secrets Manager incluyen los tipos de clave poscuánticos entre los que dicen soportar, por lo que una petición supera la comprobación de compatibilidad. La creación falla después con un error `unsupported key type` del motor. Debe seleccionarse explícitamente un motor filesystem o software con `engine_id`.",{"_4190":86756,"_34937":86728,"_23830":146285,"_5":16479,"_31422":146218,"_3630":146286},[],"Una clave del KMS se crea con el algoritmo y el tamaño descritos en Algoritmos:",{"_4190":86757,"_34937":86728,"_23830":146288,"_5":16479,"_31422":146218,"_3630":146289},[],"Los parámetros inválidos se rechazan con un mensaje explícito: un tamaño de ML-DSA distinto de 44, 65 o 87, un identificador de SLH-DSA fuera del rango 1 a 12, una variante composite fuera del rango 1 a 15, o una variante composite que no pertenece a la familia solicitada. La importación de una clave privada en formato PKCS#8 detecta automáticamente el algoritmo y el conjunto de parámetros; admite claves ML-DSA, SLH-DSA, composite y Ed25519.",{"_4190":86758,"_34937":86728,"_23830":146291,"_5":16479,"_31422":146222,"_3630":146292},[],"Una CA con clave poscuántica usa la misma petición que cualquier otra CA, enviada a `POST /api/ca/v1/cas`. Solo cambia `key_metadata`, donde `bits` transporta el conjunto de parámetros. Una CA raíz con ML-DSA-65:",{"_4190":86759,"_34937":86728,"_23830":146294,"_5":16479,"_31422":146222,"_3630":146295},[],"Una CA raíz con clave composite de ML-DSA-44 y ECDSA P-256 usa `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 usa `\"type\": \"Ed25519\", \"bits\": 256` y SLH-DSA usa `\"type\": \"SLH-DSA\", \"bits\": 1` para seleccionar SLH-DSA-SHA2-128s. Las CA subordinadas se crean del mismo modo: la subordinada firma su propia solicitud de certificado con la clave del KMS y la CA padre emite el certificado.",{"_4190":86760,"_34937":86728,"_23830":146297,"_5":16479,"_31422":146222,"_3630":146298},[],"Es posible importar CA existentes con una clave privada poscuántica en el caso de ML-DSA y Ed25519. La importación de una CA con clave SLH-DSA o composite no está soportada.",{"_4190":86761,"_34937":86728,"_23830":146300,"_5":16479,"_31422":146226,"_3630":146301},[],"El backend no impone restricciones sobre qué algoritmo emite a cuál. Una CA con clave ML-DSA puede emitir certificados a sujetos RSA, ECDSA, Ed25519 y ML-DSA, y una CA RSA o ECDSA puede emitir certificados a sujetos poscuánticos. La batería de pruebas cubre a través de la API la matriz completa de ML-DSA y Ed25519, y cubre CA y hojas SLH-DSA y composite a nivel del motor de certificados. Esto permite introducir una CA poscuántica bajo una raíz clásica, o a la inversa, pero la parte que confía debe poder verificar todos los algoritmos de la cadena. En TLS, las firmas de la cadena de certificados se comprueban frente a la extensión `signature_algorithms_cert` del cliente, por lo que una cadena firmada con ML-DSA o con un algoritmo composite necesita un cliente que lo anuncie ahí.",{"_4190":86762,"_34937":86728,"_23830":146303,"_5":16479,"_31422":146230,"_3630":146304},[],"El endpoint de firma del KMS acepta nuevos valores de `signature_algorithm`. El campo `message_type` se ignora en todos ellos. Los valores de ML-DSA, SLH-DSA y Ed25519 son «pure»: el mensaje se firma directamente, sin prehash (no son HashML-DSA, HashSLH-DSA ni Ed25519ph). Los valores composite calculan el hash del mensaje con el hash de la variante y firman un mensaje representativo que incluye una etiqueta fija y el contexto opcional.",{"_4190":86763,"_34937":86728,"_23830":146306,"_5":16479,"_31422":146230,"_3630":144844},[],{"_4190":86764,"_34937":86728,"_23830":146308,"_5":16479,"_31422":146230,"_3630":67678},[],{"_4190":86765,"_34937":86728,"_23830":146310,"_5":16479,"_31422":146230,"_3630":67681},[],{"_4190":86766,"_34937":86728,"_23830":146312,"_5":16479,"_31422":146230,"_3630":67684},[],{"_4190":86767,"_34937":86728,"_23830":146314,"_5":16479,"_31422":146230,"_3630":66177},[],{"_4190":86768,"_34937":86728,"_23830":146316,"_5":16479,"_31422":146230,"_3630":67689},[],{"_4190":86769,"_34937":86728,"_23830":146318,"_5":16479,"_31422":146230,"_3630":67692},[],{"_4190":86770,"_34937":86728,"_23830":146320,"_5":16479,"_31422":146230,"_3630":67695},[],{"_4190":86771,"_34937":86728,"_23830":146322,"_5":16479,"_31422":146230,"_3630":66185},[],{"_4190":86772,"_34937":86728,"_23830":146324,"_5":16479,"_31422":146230,"_3630":67700},[],{"_4190":86773,"_34937":86728,"_23830":146326,"_5":16479,"_31422":146230,"_3630":146327},[],"El backend no comprueba que el algoritmo coincida con la clave; debe elegirse el valor que corresponde al tipo de clave. Cuando una CA firma un certificado o una lista de revocación, el algoritmo se selecciona automáticamente.",{"_4190":86774,"_34937":86728,"_23830":146329,"_5":16479,"_31422":146234,"_3630":146330},[],"Varias partes de la plataforma aún no gestionan claves poscuánticas. Se reúnen en Limitaciones conocidas; las que afectan a la operación diaria son las siguientes.",{"_4190":86775,"_34937":86728,"_23830":146332,"_5":16479,"_31422":146234,"_3630":146333},[],"Los perfiles de emisión aplican restricciones de clave solo a RSA y ECDSA, mediante `allow_rsa_keys` y `allow_ecdsa_keys`. Un perfil con la aplicación de restricciones activada no bloquea las claves poscuánticas, y no dispone de un interruptor para permitirlas o denegarlas.",{"_4190":86776,"_34937":86728,"_23830":146335,"_5":16479,"_31422":146234,"_3630":146336},[],"La fortaleza de clave registrada para un certificado cuya clave es poscuántica o Ed25519 solo se calcula para RSA y ECDSA, por lo que esos certificados se almacenan con tipo y tamaño de clave desconocidos y fortaleza baja.",{"_4190":86777,"_34937":86728,"_23830":146338,"_5":16479,"_31422":146234,"_3630":146339},[],"Las respuestas OCSP se firman con la biblioteca `golang.org/x/crypto/ocsp`, que solo admite claves de firma RSA y ECDSA. No cabe esperar, por tanto, que una CA con clave poscuántica, Ed25519 o composite pueda firmar respuestas OCSP; las CRL se generan con el fork y no se ven afectadas por este límite, aunque no tienen pruebas.",{"_4190":86778,"_34937":86728,"_23830":146341,"_5":16479,"_31422":146234,"_3630":146342},[],"La generación de claves en el servidor del DMS (la operación `serverkeygen` de EST) genera únicamente claves RSA y ECDSA.",{"_4190":86779,"_34937":86728,"_23830":146344,"_5":16479,"_31422":146234,"_3630":146345},[],"<Card title=\"Certificados relacionados\" description=\"Vincular un certificado poscuántico a uno clásico existente.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_4190":86780,"_34937":86728,"_23830":146347,"_5":16479,"_31422":146234,"_3630":146348},[],"<Card title=\"Dashboard\" description=\"Crear los mismos objetos desde la interfaz web.\" href=\"/docs/platform/pqc/dashboard\" />",{"_4190":86781,"_34937":86781,"_5":16871,"_3630":146350,"_35372":146351,"_23830":146353,"_31422":86781},"Limitaciones conocidas",[58062,138452,144911,146352],"Referencia",[],{"_4190":86782,"_34937":86781,"_23830":146355,"_5":16479,"_31422":86781,"_3630":146356},[],"Qué está incompleto, es no estándar o no está verificado en el soporte poscuántico de Lamassu, agrupado por componente.",{"_4190":86783,"_34937":86781,"_5":35369,"_23830":146358,"_31422":146359,"_3630":146360},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#estándares-e-interoperabilidad","Estándares e interoperabilidad",{"_4190":86784,"_34937":86781,"_5":35369,"_23830":146362,"_31422":146363,"_3630":146364},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#claves-y-motores","Claves y motores",{"_4190":86785,"_34937":86781,"_5":35369,"_23830":146366,"_31422":146367,"_3630":146368},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#autoridad-de-certificación-y-validación","Autoridad de certificación y validación",{"_4190":86786,"_34937":86781,"_5":35369,"_23830":146370,"_31422":146371,"_3630":66573},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#dashboard",{"_4190":86787,"_34937":86781,"_5":35369,"_23830":146373,"_31422":146374,"_3630":146375},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#compilación-y-despliegue","Compilación y despliegue",{"_4190":86788,"_34937":86781,"_23830":146377,"_5":16479,"_31422":86781,"_3630":146378},[],"Esta página reúne los límites de la implementación actual para valorarlos antes de planificar un despliegue. Cada uno se ha observado en el código o en las pruebas de las ramas descritas en esta sección.",{"_4190":86789,"_34937":86781,"_23830":146380,"_5":16479,"_31422":146359,"_3630":146381},[],"Los certificados composite siguen el RFC 10073. La implementación se escribió contra el borrador 19 y supera los vectores de prueba del RFC, pero no ha pasado una evaluación completa de conformidad. Tres de sus algoritmos (las dos variantes Brainpool y Ed448) no están implementados. Los esquemas de firma composite en TLS usan puntos de código de uso privado de `0xFE00` a `0xFE0E` porque IANA no ha asignado ninguno, por lo que solo interoperan con pares construidos con el mismo fork de Go. Las variantes composite con RSA PKCS#1 v1.5 no pueden autenticar un handshake TLS. SLH-DSA no tiene esquema de firma TLS. El atributo de solicitud de certificado relacionado no se ha contrastado con otras implementaciones del RFC 9763.",{"_4190":86790,"_34937":86781,"_23830":146383,"_5":16479,"_31422":146363,"_3630":146384},[],"Las claves poscuánticas, composite y Ed25519 funcionan solo con los motores filesystem y software. Los motores Vault KV2 y AWS Secrets Manager anuncian soporte y después fallan en la creación, y AWS KMS, Azure y PKCS#11 no las soportan. No existe, por tanto, ninguna clave poscuántica respaldada por hardware o por un KMS en la nube. Algunos mensajes de error de los motores están copiados de otros motores y nombran el motor equivocado.",{"_4190":86791,"_34937":86781,"_23830":146386,"_5":16479,"_31422":146363,"_3630":146387},[],"La interfaz `CryptoEngine` ha incorporado métodos para crear e importar cada nuevo tipo de clave. Los motores desarrollados fuera del repositorio de Lamassu deben implementarlos.",{"_4190":86792,"_34937":86781,"_23830":146389,"_5":16479,"_31422":146367,"_3630":146390},[],"Una CA con clave poscuántica, Ed25519 o composite no puede firmar respuestas OCSP, porque la biblioteca de firma solo admite RSA y ECDSA. Se espera que la generación de CRL funcione, ya que usa la firma del fork, pero ni CRL ni OCSP tienen pruebas con estas claves.",{"_4190":86793,"_34937":86781,"_23830":146392,"_5":16479,"_31422":146367,"_3630":146393},[],"Los perfiles de emisión no pueden permitir ni denegar algoritmos poscuánticos; su aplicación de restricciones afecta solo a RSA y ECDSA. La fortaleza de clave de un certificado emitido solo se calcula para RSA y ECDSA, por lo que los demás certificados se almacenan con tipo y tamaño desconocidos y fortaleza baja. No está soportada la importación de una CA existente con clave SLH-DSA o composite.",{"_4190":86794,"_34937":86781,"_23830":146395,"_5":16479,"_31422":146367,"_3630":146396},[],"El DMS solo puede generar claves en el servidor para RSA y ECDSA, de modo que `serverkeygen` no puede devolver una clave poscuántica. Los flujos de enrolamiento por EST y por el device manager no tienen pruebas con claves poscuánticas.",{"_4190":86795,"_34937":86781,"_23830":146398,"_5":16479,"_31422":146367,"_3630":146399},[],"El backend no evalúa la extensión de certificado relacionado. Solo la emite.",{"_4190":86796,"_34937":86781,"_23830":146401,"_5":16479,"_31422":146371,"_3630":146402},[],"El generador de claves SLH-DSA del navegador asigna los identificadores de conjunto de parámetros de forma distinta al resto de la interfaz, según se describe en Dashboard. Los nombres de los tipos de clave no son uniformes entre pantallas, y la interfaz no incluye aviso de carácter experimental ni traducción.",{"_4190":86797,"_34937":86781,"_23830":146404,"_5":16479,"_31422":146374,"_3630":146405},[],"Todo depende de forks de Go y de Traefik que no son los proyectos originales, y la imagen del proxy tiene una etiqueta mutable. La especificación OpenAPI del KMS del backend sigue listando solo RSA, ECDSA y Ed25519 y no refleja los nuevos tipos de clave.",{"_4190":86798,"_34937":86781,"_23830":146407,"_5":16479,"_31422":146374,"_3630":146408},[],"El Helm chart usa nombres de recurso fijos, admite una sola release por espacio de nombres y envía el tráfico de Traefik a Envoy sin verificar certificados. Los certificados poscuánticos que crea el instalador son válidos durante 365 días y no se renuevan. El instalador necesita un host Linux y ejecuta una instalación de Helm, no una actualización.",{"_4190":86799,"_34937":86781,"_23830":146410,"_5":16479,"_31422":146374,"_3630":146411},[],"<Card title=\"Visión general de la criptografía poscuántica\" description=\"Volver al resumen de la sección.\" href=\"/docs/platform/pqc/overview\" />",{"_4190":86800,"_34937":86800,"_5":16871,"_3630":146413,"_35372":146414,"_23830":146415,"_31422":86800},"Visión general de la criptografía poscuántica",[58062,138452,144911],[],{"_4190":86801,"_34937":86800,"_23830":146417,"_5":16479,"_31422":86800,"_3630":146418},[],"Qué soporte poscuántico (PQC) añade Lamassu a las claves, las autoridades de certificación, el TLS de los dispositivos y el despliegue, y cómo encajan sus piezas.",{"_4190":86802,"_34937":86800,"_5":35369,"_23830":146420,"_31422":146421,"_3630":146422},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-qué-importa-en-flotas-de-dispositivos","Por qué importa en flotas de dispositivos",{"_4190":86803,"_34937":86800,"_5":35369,"_23830":146424,"_31422":146425,"_3630":146426},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#tres-familias-de-algoritmos","Tres familias de algoritmos",{"_4190":86804,"_34937":86800,"_5":35369,"_23830":146428,"_31422":146429,"_3630":146430},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#cómo-encajan-las-piezas","Cómo encajan las piezas",{"_4190":86805,"_34937":86800,"_5":35369,"_23830":146432,"_31422":146433,"_3630":146434},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-dónde-continuar","Por dónde continuar",{"_4190":86806,"_34937":86800,"_23830":146436,"_5":16479,"_31422":86800,"_3630":146437},[],"Lamassu puede crear claves, autoridades de certificación (CA) y certificados que usan algoritmos de firma poscuánticos, y puede servirlos y verificarlos por TLS. El trabajo abarca cinco bases de código que dependen unas de otras: un fork del toolchain de Go que implementa los algoritmos, el backend de Lamassu, el dashboard web, un fork del proxy Traefik que termina el TLS de los dispositivos y el Helm chart que despliega todo junto.",{"_4190":86807,"_34937":86800,"_23830":146439,"_5":16479,"_31422":86800,"_3630":146440},[],"El soporte PQC reside en ramas de desarrollo y en forks de Go y Traefik, no en los proyectos originales ni en las imágenes estándar de Lamassu. Los esquemas de firma TLS composite usan puntos de código de uso privado que ninguna otra pila TLS reconoce, y el formato de certificado composite sigue el RFC 10073, un estándar reciente con poca experiencia de despliegue todavía. Conviene planificar pilotos y despliegues de laboratorio, no flotas en producción. Limitaciones conocidas recoge lo que está incompleto.",{"_4190":86808,"_34937":86800,"_23830":146442,"_5":16479,"_31422":146421,"_3630":146443},[],"Los certificados emitidos a dispositivos suelen durar años, y los dispositivos que los almacenan son difíciles de sustituir. Un algoritmo de firma que un futuro ordenador cuántico llegase a romper obligaría a re-enrolar toda la flota. Emitir hoy certificados firmados con un algoritmo poscuántico o composite, y ofrecer un endpoint TLS que los acepte, permite validar la flota frente a ese riesgo antes de que sea urgente. Las firmas no están expuestas a ataques de tipo «almacenar ahora, descifrar después» como lo está un intercambio de claves, por lo que la urgencia depende de la vida útil de los certificados y de los dispositivos, no del tráfico registrado.",{"_4190":86809,"_34937":86800,"_23830":146445,"_5":16479,"_31422":146425,"_3630":146446},[],"Lamassu agrupa los algoritmos de firma en tres familias, con las mismas etiquetas que muestra el dashboard.",{"_4190":86810,"_34937":86800,"_23830":146448,"_5":16479,"_31422":146425,"_3630":146449},[],"Etiqueta",{"_4190":86811,"_34937":86800,"_23830":146451,"_5":16479,"_31422":146425,"_3630":145122},[],{"_4190":86812,"_34937":86800,"_23830":146453,"_5":16479,"_31422":146425,"_3630":144909},[],{"_4190":86813,"_34937":86800,"_23830":146455,"_5":16479,"_31422":146425,"_3630":67190},[],{"_4190":86814,"_34937":86800,"_23830":146457,"_5":16479,"_31422":146425,"_3630":146458},[],"Tradicional",{"_4190":86815,"_34937":86800,"_23830":146460,"_5":16479,"_31422":146425,"_3630":67837},[],{"_4190":86816,"_34937":86800,"_23830":146462,"_5":16479,"_31422":146425,"_3630":67202},[],{"_4190":86817,"_34937":86800,"_23830":146464,"_5":16479,"_31422":146425,"_3630":146465},[],"Poscuántica pura",{"_4190":86818,"_34937":86800,"_23830":146467,"_5":16479,"_31422":146425,"_3630":67845},[],{"_4190":86819,"_34937":86800,"_23830":146469,"_5":16479,"_31422":146425,"_3630":67214},[],{"_4190":86820,"_34937":86800,"_23830":146471,"_5":16479,"_31422":146425,"_3630":146472},[],"Híbrida (composite)",{"_4190":86821,"_34937":86800,"_23830":146474,"_5":16479,"_31422":146425,"_3630":146475},[],"ML-DSA combinado con RSA, ECDSA o Ed25519 en una única clave y una única firma",{"_4190":86822,"_34937":86800,"_23830":146477,"_5":16479,"_31422":146425,"_3630":146478},[],"Una firma composite solo es válida si se verifican sus dos componentes. Está pensada para que no sea falsificable mientras al menos uno de los dos algoritmos siga sin romperse, siempre que la parte que confía exija el composite y no recurra a un certificado clásico. En el intercambio de claves, `PQ/T` significa un grupo híbrido que combina un intercambio clásico y uno ML-KEM, y `PQ` significa ML-KEM puro. Algoritmos describe cada uno y los conjuntos de parámetros que Lamassu acepta.",{"_4190":86823,"_34937":86800,"_23830":146480,"_5":16479,"_31422":146429,"_3630":146481},[],"El fork de Go es la base: el backend y Traefik se compilan con él, porque el toolchain estándar de Go no incluye el soporte de certificados composite y SLH-DSA. El backend crea y custodia las claves, emite certificados y firma los datos de revocación. El dashboard usa la misma API REST. Los dispositivos llegan a la plataforma a través de Traefik, que negocia con ellos la autenticación y el intercambio de claves poscuánticos y después reenvía la petición a Envoy Gateway mediante TLS ordinario. La protección poscuántica se aplica, por tanto, solo al salto entre el dispositivo y Traefik.",{"_4190":86824,"_34937":86800,"_23830":146483,"_5":16479,"_31422":146433,"_3630":146484},[],"Conviene leer primero Algoritmos para conocer qué se soporta y cómo se escriben los conjuntos de parámetros en las peticiones a la API. Quien desarrolle un cliente de dispositivo debe seguir con Toolchain de Go PQC. Para crear una CA poscuántica, el camino es Claves y autoridades de certificación, y quien despliegue la plataforma consultará Despliegue con el Helm chart.",{"_4190":86825,"_34937":86800,"_23830":146486,"_5":16479,"_31422":146433,"_3630":146487},[],"<Card title=\"Recorrido interactivo\" description=\"Probar las combinaciones de intercambio de claves y autenticación y ver los resultados de las pruebas.\" href=\"/docs/platform/pqc/welcome\" />",{"_4190":86826,"_34937":86800,"_23830":146489,"_5":16479,"_31422":146433,"_3630":146490},[],"<Card title=\"Algoritmos\" description=\"ML-DSA, SLH-DSA y los 15 algoritmos composite, con sus conjuntos de parámetros.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4190":86827,"_34937":86800,"_23830":146492,"_5":16479,"_31422":146433,"_3630":146493},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear claves y CA poscuánticas y emitir certificados mediante la API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4190":86828,"_34937":86800,"_23830":146495,"_5":16479,"_31422":146433,"_3630":146496},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar la plataforma con un proxy Traefik que sirve certificados PQC.\" href=\"/docs/platform/pqc/deployment\" />",{"_4190":86829,"_34937":86829,"_5":16871,"_3630":145298,"_35372":146498,"_23830":146499,"_31422":86829},[58062,138452,144911,145278],[],{"_4190":86830,"_34937":86829,"_23830":146501,"_5":16479,"_31422":86829,"_3630":146502},[],"Vincular un certificado con clave poscuántica a un certificado clásico existente del mismo dispositivo, según el RFC 9763, y cómo los emite y comprueba Lamassu.",{"_4190":86831,"_34937":86829,"_5":35369,"_23830":146504,"_31422":146505,"_3630":146506},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#cómo-funciona-la-solicitud","Cómo funciona la solicitud",{"_4190":86832,"_34937":86829,"_5":35369,"_23830":146508,"_31422":146509,"_3630":146510},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#ubicaciones-desde-las-que-la-ca-puede-descargar","Ubicaciones desde las que la CA puede descargar",{"_4190":86833,"_34937":86829,"_5":35369,"_23830":146512,"_31422":146513,"_3630":146514},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#configurar-un-perfil-de-emisión","Configurar un perfil de emisión",{"_4190":86834,"_34937":86829,"_5":35369,"_23830":146516,"_31422":146517,"_3630":146518},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#qué-debe-cumplir-el-certificado-emitido","Qué debe cumplir el certificado emitido",{"_4190":86835,"_34937":86829,"_5":35369,"_23830":146520,"_31422":146521,"_3630":146522},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#desde-el-dashboard","Desde el dashboard",{"_4190":86836,"_34937":86829,"_23830":146524,"_5":16479,"_31422":86829,"_3630":146525},[],"Una flota que migra a algoritmos poscuánticos suele mantener durante un tiempo dos certificados por dispositivo: el clásico que ya se usa y uno nuevo con clave poscuántica. El RFC 9763 define una forma de enlazarlos. El certificado nuevo lleva la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), que contiene un hash del certificado clásico, de modo que una parte que confía puede comprobar que ambos identifican a la misma entidad. Lamassu implementa el lado emisor de este mecanismo.",{"_4190":86837,"_34937":86829,"_23830":146527,"_5":16479,"_31422":86829,"_3630":146528},[],"Esta opción encaja cuando:",{"_4190":86838,"_34937":86829,"_23830":146530,"_5":16479,"_31422":86829,"_3630":146531},[],"los consumidores aún no pueden validar cadenas poscuánticas o composite, por lo que el certificado clásico debe seguir siendo el que se usa;",{"_4190":86839,"_34937":86829,"_23830":146533,"_5":16479,"_31422":86829,"_3630":146534},[],"un dispositivo tiene que llevar ambos certificados y demostrar que van juntos, usando cada uno donde el interlocutor lo admita.",{"_4190":86840,"_34937":86829,"_23830":146536,"_5":16479,"_31422":86829,"_3630":146537},[],"El hash es SHA-256, SHA-384 o SHA-512, según el hash del algoritmo de firma del certificado relacionado, y SHA-256 si este no tiene ninguno.",{"_4190":86841,"_34937":86829,"_23830":146539,"_5":16479,"_31422":146505,"_3630":146540},[],"El dispositivo solicita el certificado vinculado con una solicitud PKCS#10 ordinaria que incluye un atributo adicional, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). El atributo identifica el certificado existente por emisor y número de serie, indica la hora de la solicitud, indica la ubicación desde la que puede descargarse el certificado y lleva una firma realizada con la clave privada de ese certificado existente. La firma cubre el emisor, el número de serie y la hora de la solicitud, no la ubicación, y demuestra que quien solicita controla la clave existente; la clave del nuevo certificado se prueba con la firma de la propia solicitud de certificado. Lamassu acepta una lista de ubicaciones, como en el módulo ASN.1 del RFC, y las prueba en orden.",{"_4190":86842,"_34937":86829,"_23830":146542,"_5":16479,"_31422":146505,"_3630":146543},[],"Cuando el servicio de CA recibe una solicitud así, sigue estos pasos:",{"_4190":86843,"_34937":86829,"_23830":146545,"_5":16479,"_31422":146505,"_3630":146546},[],"Comprueba que el perfil de emisión en uso habilita los certificados relacionados y, en caso contrario, rechaza la solicitud.",{"_4190":86844,"_34937":86829,"_23830":146548,"_5":16479,"_31422":146505,"_3630":146549},[],"Recorre en orden las ubicaciones del atributo y descarga el primer certificado que logra obtener.",{"_4190":86845,"_34937":86829,"_23830":146551,"_5":16479,"_31422":146505,"_3630":146552},[],"Verifica que el emisor y el número de serie coinciden, que la hora de la solicitud está dentro de la antigüedad permitida y que la firma es válida con la clave del certificado descargado.",{"_4190":86846,"_34937":86829,"_23830":146554,"_5":16479,"_31422":146505,"_3630":146555},[],"Emite el nuevo certificado con la extensión de certificado relacionado añadida.",{"_4190":86847,"_34937":86829,"_23830":146557,"_5":16479,"_31422":146505,"_3630":146558},[],"Una solicitud sin el atributo se procesa con normalidad, tanto si el perfil habilita la función como si no.",{"_4190":86848,"_34937":86829,"_23830":146560,"_5":16479,"_31422":146509,"_3630":146561},[],"Una ubicación es un URI `data:` o una URL `http` o `https`. Un URI `data:` debe estar codificado en base64 y contiene una estructura PKCS#7 cuyo primer certificado es el relacionado; no requiere acceso a la red y siempre se acepta cuando la función está habilitada. Una URL solo se descarga si su host figura en la lista de hosts permitidos del perfil. La CA no sigue redirecciones, aplica un tiempo de espera de diez segundos y rechaza respuestas de más de 1 MiB.",{"_4190":86849,"_34937":86829,"_23830":146563,"_5":16479,"_31422":146509,"_3630":146564},[],"Como la descarga la realiza el servidor, quien puede definir un perfil de emisión decide a qué hosts puede conectarse la CA. Conviene restringir ese permiso en consecuencia e incluir solo repositorios internos de certificados.",{"_4190":86850,"_34937":86829,"_23830":146566,"_5":16479,"_31422":146513,"_3630":146567},[],"La función se configura en el objeto `related_certificate` del perfil de emisión, que se almacena en columnas propias de la base de datos:",{"_4190":86851,"_34937":86829,"_23830":146569,"_5":16479,"_31422":146513,"_3630":145487},[],{"_4190":86852,"_34937":86829,"_23830":146571,"_5":16479,"_31422":146513,"_3630":141069},[],{"_4190":86853,"_34937":86829,"_23830":146573,"_5":16479,"_31422":146513,"_3630":145492},[],{"_4190":86854,"_34937":86829,"_23830":146575,"_5":16479,"_31422":146513,"_3630":141075},[],{"_4190":86855,"_34937":86829,"_23830":146577,"_5":16479,"_31422":146513,"_3630":67956},[],{"_4190":86856,"_34937":86829,"_23830":146579,"_5":16479,"_31422":146513,"_3630":116525},[],{"_4190":86857,"_34937":86829,"_23830":146581,"_5":16479,"_31422":146513,"_3630":66804},[],{"_4190":86858,"_34937":86829,"_23830":146583,"_5":16479,"_31422":146513,"_3630":146584},[],"Con `false`, se rechaza una solicitud que lleve el atributo.",{"_4190":86859,"_34937":86829,"_23830":146586,"_5":16479,"_31422":146513,"_3630":67966},[],{"_4190":86860,"_34937":86829,"_23830":146588,"_5":16479,"_31422":146513,"_3630":146589},[],"lista de cadenas",{"_4190":86861,"_34937":86829,"_23830":146591,"_5":16479,"_31422":146513,"_3630":146592},[],"vacía",{"_4190":86862,"_34937":86829,"_23830":146594,"_5":16479,"_31422":146513,"_3630":146595},[],"Hosts desde los que se pueden descargar ubicaciones `http` y `https`.",{"_4190":86863,"_34937":86829,"_23830":146597,"_5":16479,"_31422":146513,"_3630":67977},[],{"_4190":86864,"_34937":86829,"_23830":146599,"_5":16479,"_31422":146513,"_3630":146600},[],"duración",{"_4190":86865,"_34937":86829,"_23830":146602,"_5":16479,"_31422":146513,"_3630":67982},[],{"_4190":86866,"_34937":86829,"_23830":146604,"_5":16479,"_31422":146513,"_3630":146605},[],"Diferencia máxima entre la hora de la solicitud del atributo y el momento de la emisión.",{"_4190":86867,"_34937":86829,"_23830":146607,"_5":16479,"_31422":146517,"_3630":146608},[],"El fork se niega a vincular un certificado salvo que el nuevo sea compatible con el relacionado. Ninguno de los dos puede ser una CA. El certificado relacionado debe estar vigente en el momento de la emisión. Los usos de clave y los usos extendidos de clave solicitados para el nuevo certificado deben ser un subconjunto de los del certificado relacionado. La verificación posterior compara únicamente el hash, de modo que una parte que confía y comprueba el enlace averigua que la CA emisora vinculó el nuevo certificado a ese certificado concreto, no que el certificado relacionado siga siendo válido.",{"_4190":86868,"_34937":86829,"_23830":146610,"_5":16479,"_31422":146517,"_3630":146611},[],"La extensión es una prueba de relación, no una dependencia. Quien confía en ellos debe seguir validando cada certificado con su propia cadena y estado de revocación, y revocar el certificado clásico no revoca el vinculado.",{"_4190":86869,"_34937":86829,"_23830":146613,"_5":16479,"_31422":146521,"_3630":146614},[],"El dashboard cubre la función sin peticiones a la API. El formulario del perfil de emisión tiene un interruptor *Related Certificates* con los hosts permitidos y la antigüedad máxima, y el formulario de emisión ofrece *Bind to a related certificate* cuando el perfil seleccionado la habilita. Los detalles de certificados y CAs muestran una fila *Related Certificate* con el algoritmo de hash y su valor. Los pasos, con capturas, están en Dashboard.",{"_4190":86870,"_34937":86829,"_23830":146616,"_5":16479,"_31422":146521,"_3630":146617},[],"El certificado vinculado se crea con `CreateBoundCertificate` del fork, cuyas pruebas cubren una clave ML-DSA vinculada a certificados RSA, ECDSA y Ed25519. Las pruebas no usan claves composite. Solo el lado emisor está implementado en Lamassu: la plataforma no evalúa la extensión cuando valida certificados.",{"_4190":86871,"_34937":86829,"_23830":146619,"_5":16479,"_31422":146521,"_3630":146620},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear la CA poscuántica que emite el certificado vinculado.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4190":86872,"_34937":86829,"_23830":146622,"_5":16479,"_31422":146521,"_3630":146623},[],"<Card title=\"Limitaciones conocidas\" description=\"Lo que todavía no está cubierto.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":86873,"_34937":86873,"_5":16871,"_3630":146625,"_35372":146626,"_23830":146627,"_31422":86873},"Proxy TLS con Traefik",[58062,138452,144911,137014],[],{"_4190":86874,"_34937":86873,"_23830":146629,"_5":16479,"_31422":86873,"_3630":146630},[],"El fork de Traefik que termina el TLS de los dispositivos con certificados clásicos y poscuánticos para el mismo host, cómo elige certificado y cómo se compila.",{"_4190":86875,"_34937":86873,"_5":35369,"_23830":146632,"_31422":146633,"_3630":146634},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#varios-certificados-para-el-mismo-host","Varios certificados para el mismo host",{"_4190":86876,"_34937":86873,"_5":35369,"_23830":146636,"_31422":146637,"_3630":146638},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#opciones-tls-en-listeners-de-gateway-api","Opciones TLS en listeners de Gateway API",{"_4190":86877,"_34937":86873,"_5":35369,"_23830":146640,"_31422":146641,"_3630":146642},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#tls-mutuo","TLS mutuo",{"_4190":86878,"_34937":86873,"_5":35369,"_23830":146644,"_31422":146645,"_3630":146646},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#compilación-del-proxy","Compilación del proxy",{"_4190":86879,"_34937":86873,"_23830":146648,"_5":16479,"_31422":86873,"_3630":146649},[],"Los dispositivos se conectan a Lamassu por TLS, y el enrolamiento EST se apoya en TLS mutuo. Para aceptar un certificado poscuántico o composite en esa conexión, el endpoint TLS debe compilarse con el toolchain de Go PQC. Lamassu lo hace con un fork de Traefik, basado en Traefik 3.7.15, situado delante de Envoy Gateway. El fork añade dos comportamientos: puede servir varios certificados para el mismo host y elegir entre ellos según el cliente, y permite que un listener de Gateway API haga referencia a una opción TLS de Traefik.",{"_4190":86880,"_34937":86873,"_23830":146651,"_5":16479,"_31422":146633,"_3630":146652},[],"Traefik original conserva un certificado por conjunto de nombres. Si existen un certificado ECDSA clásico y un certificado ML-DSA para `lab.example.com`, solo se conserva el primero. El fork almacena cada certificado distinto (los duplicados se detectan comparando el certificado hoja) y elige uno en cada handshake.",{"_4190":86881,"_34937":86873,"_23830":146654,"_5":16479,"_31422":146633,"_3630":146655},[],"La elección sigue los algoritmos de firma que anuncia el cliente:",{"_4190":86882,"_34937":86873,"_23830":146657,"_5":16479,"_31422":146633,"_3630":146658},[],"Se normaliza el nombre de servidor del cliente y se reúnen los certificados cuyos nombres coinciden, con los nombres exactos por delante de los comodines. Un certificado con solo Common Name sigue coincidiendo.",{"_4190":86883,"_34937":86873,"_23830":146660,"_5":16479,"_31422":146633,"_3630":146661},[],"Si ningún certificado coincide, la conexión se cierra en modo SNI estricto, o se sirve el certificado por defecto.",{"_4190":86884,"_34937":86873,"_23830":146663,"_5":16479,"_31422":146633,"_3630":146664},[],"Si coincide exactamente un certificado, se sirve sin más comprobaciones.",{"_4190":86885,"_34937":86873,"_23830":146666,"_5":16479,"_31422":146633,"_3630":146667},[],"En otro caso, el proxy toma los esquemas de firma del cliente en el orden en que los envió y, para cada esquema, devuelve el primer certificado cuya clave permiten el esquema, la versión de TLS y el tipo de clave. Así se contrasta la clave hoja con `signature_algorithms`, los esquemas que el cliente acepta para la firma del handshake; las firmas del resto de la cadena son una comprobación distinta, frente a `signature_algorithms_cert`.",{"_4190":86886,"_34937":86873,"_23830":146669,"_5":16479,"_31422":146633,"_3630":146670},[],"Si el cliente no anuncia ningún esquema, se devuelve el primer certificado compatible. Si ninguno es compatible, se devuelve el primer candidato y el handshake falla con el error subyacente.",{"_4190":86887,"_34937":86873,"_23830":146672,"_5":16479,"_31422":146633,"_3630":146673},[],"Prevalece el orden de preferencia del cliente: un cliente que lista ML-DSA primero recibe el certificado poscuántico y uno que lista ECDSA primero recibe el clásico, aunque también soporte ML-DSA. Un cliente sin soporte poscuántico nunca anuncia esos esquemas y recibe el certificado clásico. TLS 1.2 nunca selecciona certificados ML-DSA ni composite. El servidor no puede configurarse con un orden de preferencia propio.",{"_4190":86888,"_34937":86873,"_23830":146675,"_5":16479,"_31422":146637,"_3630":146676},[],"Traefik lee su configuración de Gateway API desde Kubernetes. El fork lee la opción de listener `traefik.io/tls-options`, cuyo valor nombra la opción TLS que se aplica a ese listener: `default`, o un nombre cualificado como `traefik-system-pqc@kubernetescrd`. Funciona en listeners HTTPS y en listeners TLS en modo `Terminate` que sirven un `TLSRoute`. Se ignora en modo passthrough.",{"_4190":86889,"_34937":86873,"_23830":146678,"_5":16479,"_31422":146637,"_3630":146679},[],"En una opción TLS se establecen los grupos de intercambio de claves soportados y el modo de autenticación de cliente. Cuando varios listeners comparten un router padre y nombran opciones distintas, el proxy registra una advertencia y usa valores por defecto aislados para cada uno. Sin el fork, Traefik ignora la anotación, aplica sus propios valores por defecto y los ajustes no se pueden controlar; los dispositivos que necesitan TLS mutuo fallan entonces.",{"_4190":86890,"_34937":86873,"_23830":146681,"_5":16479,"_31422":146637,"_3630":146682},[],"El fork añade además `mlkem1024` a los nombres de grupo aceptados en `curvePreferences`, junto a los grupos híbridos que Traefik ya reconoce.",{"_4190":86891,"_34937":86873,"_23830":146684,"_5":16479,"_31422":146641,"_3630":146685},[],"La autenticación de cliente es el mecanismo estándar de Traefik, configurado en la opción TLS. Con `RequireAndVerifyClientCert` y un fichero de CA de cliente, el proxy valida la cadena, y la verificación de la firma del cliente la realiza la pila TLS del fork de Go, que se ha probado con certificados de cliente composite en un handshake TLS 1.3. Con `RequestClientCert`, que es lo que establece el chart de Lamassu en su opción por defecto, el proxy comprueba que el cliente posee la clave del certificado que presenta, pero no valida la cadena; la decisión se delega en el backend, que recibe el certificado en una cabecera (véase Despliegue con el Helm chart). Ninguna prueba de Traefik cubre el TLS mutuo poscuántico, y una cadena de cliente firmada por una CA composite o poscuántica depende del código x509 del fork.",{"_4190":86892,"_34937":86873,"_23830":146687,"_5":16479,"_31422":146645,"_3630":146688},[],"El fork no se compila desde la imagen de Go. El script `build.sh` exige una copia ya compilada del fork de Go, por defecto en `../go`, y comprueba que es el fork antes de forzar `GOROOT` y `GOTOOLCHAIN=local`. Compila el binario con `CGO_ENABLED=0`, genera la interfaz web salvo que se indique `SKIP_WEBUI=1` y empaqueta el binario en una imagen Alpine con `docker buildx`. La imagen por defecto es `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_4190":86893,"_34937":86873,"_23830":146690,"_5":16479,"_31422":146645,"_3630":68071},[],{"_4190":86894,"_34937":86873,"_23830":146692,"_5":16479,"_31422":146645,"_3630":146693},[],"Finalidad",{"_4190":86895,"_34937":86873,"_23830":146695,"_5":16479,"_31422":146645,"_3630":68076},[],{"_4190":86896,"_34937":86873,"_23830":146697,"_5":16479,"_31422":146645,"_3630":146698},[],"Ubicación del fork de Go compilado.",{"_4190":86897,"_34937":86873,"_23830":146700,"_5":16479,"_31422":146645,"_3630":68082},[],{"_4190":86898,"_34937":86873,"_23830":146702,"_5":16479,"_31422":146645,"_3630":146703},[],"Plataformas de destino; por defecto `linux/amd64`.",{"_4190":86899,"_34937":86873,"_23830":146705,"_5":16479,"_31422":146645,"_3630":68088},[],{"_4190":86900,"_34937":86873,"_23830":146707,"_5":16479,"_31422":146645,"_3630":146708},[],"Omite la generación de la interfaz web con el valor `1`.",{"_4190":86901,"_34937":86873,"_23830":146710,"_5":16479,"_31422":146645,"_3630":68094},[],{"_4190":86902,"_34937":86873,"_23830":146712,"_5":16479,"_31422":146645,"_3630":146713},[],"Nombre de la imagen y si se publica. Las compilaciones multiplataforma requieren `PUSH=1`.",{"_4190":86903,"_34937":86873,"_23830":146715,"_5":16479,"_31422":146645,"_3630":146716},[],"Las etiquetas `pqc-*` son mutables y se han reconstruido sobre sí mismas, por lo que en entornos próximos a producción conviene fijar el digest.",{"_4190":86904,"_34937":86873,"_23830":146718,"_5":16479,"_31422":146645,"_3630":146719},[],"Las pruebas de selección del fork usan ML-DSA-65 puro junto con ECDSA P-256. La selección de un certificado composite depende de que la pila TLS del fork conozca la clave composite, algo que ocurre, pero el proxy no tiene ninguna prueba para ello.",{"_4190":86905,"_34937":86873,"_23830":146721,"_5":16479,"_31422":146645,"_3630":146722},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar el proxy delante de Envoy Gateway con el chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_4190":86906,"_34937":86873,"_23830":146724,"_5":16479,"_31422":146645,"_3630":146725},[],"<Card title=\"Limitaciones conocidas\" description=\"Interoperabilidad y advertencias operativas.\" href=\"/docs/platform/pqc/limitations\" />",{"_4190":86907,"_34937":86907,"_5":16871,"_3630":146727,"_35372":146728,"_23830":146729,"_31422":86907},"Bienvenida a Lamassu poscuántico",[58062,138452,144911],[],{"_4190":86908,"_34937":86907,"_23830":146731,"_5":16479,"_31422":86907,"_3630":146732},[],"Un recorrido interactivo por el soporte poscuántico de Lamassu, del toolchain de Go al dispositivo, con los resultados de interoperabilidad.",{"_4190":86909,"_34937":86907,"_23830":146734,"_5":16479,"_31422":86907,"_3630":146735},[],"Lamassu negocia con los dispositivos el intercambio de claves y la autenticación poscuánticos, y emite certificados poscuánticos y composite. Esta página permite probarlo: combina las familias de intercambio de claves y de autenticación en el configurador, explora la arquitectura y los algoritmos, y comprueba cómo les fue a clientes independientes en las pruebas de interoperabilidad. La documentación de referencia empieza en la visión general.",{"_4190":86910,"_34937":86910,"_5":16871,"_3630":146737,"_35372":146738,"_23830":146739,"_31422":86910},"Seguridad",[58062],[],{"_4190":86911,"_34937":86910,"_23830":146741,"_5":16479,"_31422":86910,"_3630":146742},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_4190":86912,"_34937":86910,"_5":35369,"_23830":146744,"_31422":146745,"_3630":146746},[],"/docs/pr-preview/pr-58/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_4190":86913,"_34937":86910,"_5":35369,"_23830":146748,"_31422":146749,"_3630":146750},[],"/docs/pr-preview/pr-58/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_4190":86914,"_34937":86910,"_5":35369,"_23830":146752,"_31422":146753,"_3630":146754},[],"/docs/pr-preview/pr-58/es/security#versiones-soportadas","Versiones soportadas",{"_4190":86915,"_34937":86910,"_5":35369,"_23830":146756,"_31422":146757,"_3630":146758},[],"/docs/pr-preview/pr-58/es/security#divulgación-responsable","Divulgación responsable",{"_4190":86916,"_34937":86910,"_23830":146760,"_5":16479,"_31422":86910,"_3630":146761},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_4190":86917,"_34937":86910,"_23830":146763,"_5":16479,"_31422":146745,"_3630":146764},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_4190":86918,"_34937":86910,"_23830":146766,"_5":16479,"_31422":146745,"_3630":146767},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_4190":86919,"_34937":86910,"_23830":146769,"_5":16479,"_31422":146745,"_3630":17232},[],{"_4190":86920,"_34937":86910,"_23830":146771,"_5":16479,"_31422":146745,"_3630":17162},[],{"_4190":86921,"_34937":86910,"_23830":146773,"_5":16479,"_31422":146745,"_3630":17219},[],{"_4190":86922,"_34937":86910,"_23830":146775,"_5":16479,"_31422":146745,"_3630":146776},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_4190":86923,"_34937":86910,"_23830":146778,"_5":16479,"_31422":146745,"_3630":146779},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_4190":86924,"_34937":86910,"_23830":146781,"_5":16479,"_31422":146749,"_3630":146782},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_4190":86925,"_34937":86910,"_23830":146784,"_5":16479,"_31422":146749,"_3630":146785},[],"No incluyas en el reporte:",{"_4190":86926,"_34937":86910,"_23830":146787,"_5":16479,"_31422":146749,"_3630":146788},[],"Credenciales, tokens o claves privadas",{"_4190":86927,"_34937":86910,"_23830":146790,"_5":16479,"_31422":146749,"_3630":146791},[],"Datos de clientes o información identificable de clientes",{"_4190":86928,"_34937":86910,"_23830":146793,"_5":16479,"_31422":146749,"_3630":146794},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_4190":86929,"_34937":86910,"_23830":146796,"_5":16479,"_31422":146753,"_3630":146797},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_4190":86930,"_34937":86910,"_23830":146799,"_5":16479,"_31422":146753,"_3630":146800},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_4190":86931,"_34937":86910,"_23830":146802,"_5":16479,"_31422":146757,"_3630":146803},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_4190":86932,"_34937":86910,"_23830":146805,"_5":16479,"_31422":146757,"_3630":146806},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_4190":86933,"_34937":86910,"_23830":146808,"_5":16479,"_31422":146757,"_3630":146809},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_4190":86934,"_34937":86910,"_23830":146811,"_5":16479,"_31422":146757,"_3630":146812},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_4190":86935,"_34937":86910,"_23830":146814,"_5":16479,"_31422":146757,"_3630":146815},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_4190":86936,"_34937":86936,"_5":16871,"_3630":146817,"_35372":146818,"_23830":146820,"_31422":86936},"3.8.0 a 4.0.0",[58062,146819],"Actualizaciones",[],{"_4190":86937,"_34937":86936,"_23830":146822,"_5":16479,"_31422":86936,"_3630":146823},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_4190":86938,"_34937":86936,"_5":35369,"_23830":146825,"_31422":146826,"_3630":146827},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_4190":86939,"_34937":86936,"_5":35369,"_23830":146829,"_31422":146830,"_3630":146831},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_4190":86940,"_34937":86936,"_5":35369,"_23830":146833,"_31422":146834,"_3630":146835},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_4190":86941,"_34937":86936,"_5":35369,"_23830":146837,"_31422":146838,"_3630":146839},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_4190":86942,"_34937":86936,"_5":35369,"_23830":146841,"_31422":146842,"_3630":146843},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_4190":86943,"_34937":86936,"_5":35369,"_23830":146845,"_31422":146846,"_3630":146847},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_4190":86944,"_34937":86936,"_5":35369,"_23830":146849,"_31422":146850,"_3630":68235},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_4190":86945,"_34937":86936,"_5":35369,"_23830":146852,"_31422":146853,"_3630":146854},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_4190":86946,"_34937":86936,"_5":35369,"_23830":146856,"_31422":146857,"_3630":146858},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_4190":86947,"_34937":86936,"_5":35369,"_23830":146860,"_31422":146861,"_3630":146862},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_4190":86948,"_34937":86936,"_5":35369,"_23830":146864,"_31422":146865,"_3630":146866},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_4190":86949,"_34937":86936,"_5":35369,"_23830":146868,"_31422":146869,"_3630":146870},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_4190":86950,"_34937":86936,"_5":35369,"_23830":146872,"_31422":146873,"_3630":146874},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_4190":86951,"_34937":86936,"_5":35369,"_23830":146876,"_31422":146877,"_3630":146878},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_4190":86952,"_34937":86936,"_5":35369,"_23830":146880,"_31422":146881,"_3630":146882},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_4190":86953,"_34937":86936,"_5":35369,"_23830":146884,"_31422":146885,"_3630":146886},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_4190":86954,"_34937":86936,"_5":35369,"_23830":146888,"_31422":146889,"_3630":146890},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_4190":86955,"_34937":86936,"_5":35369,"_23830":146892,"_31422":146893,"_3630":146894},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_4190":86956,"_34937":86936,"_5":35369,"_23830":146896,"_31422":146897,"_3630":146898},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_4190":86957,"_34937":86936,"_5":35369,"_23830":146900,"_31422":146901,"_3630":146902},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_4190":86958,"_34937":86936,"_5":35369,"_23830":146904,"_31422":146905,"_3630":146906},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_4190":86959,"_34937":86936,"_5":35369,"_23830":146908,"_31422":146909,"_3630":146910},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_4190":86960,"_34937":86936,"_5":35369,"_23830":146912,"_31422":146913,"_3630":146914},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_4190":86961,"_34937":86936,"_5":35369,"_23830":146916,"_31422":146917,"_3630":146918},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_4190":86962,"_34937":86936,"_5":35369,"_23830":146920,"_31422":146921,"_3630":146922},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_4190":86963,"_34937":86936,"_5":35369,"_23830":146924,"_31422":146925,"_3630":146926},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_4190":86964,"_34937":86936,"_5":35369,"_23830":146928,"_31422":146929,"_3630":146930},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_4190":86965,"_34937":86936,"_5":35369,"_23830":146932,"_31422":146933,"_3630":146934},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_4190":86966,"_34937":86936,"_5":35369,"_23830":146936,"_31422":146937,"_3630":146938},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_4190":86967,"_34937":86936,"_5":35369,"_23830":146940,"_31422":146941,"_3630":146942},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_4190":86968,"_34937":86936,"_5":35369,"_23830":146944,"_31422":146945,"_3630":146946},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_4190":86969,"_34937":86936,"_5":35369,"_23830":146948,"_31422":146949,"_3630":146950},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_4190":86970,"_34937":86936,"_5":35369,"_23830":146952,"_31422":146953,"_3630":146954},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_4190":86971,"_34937":86936,"_5":35369,"_23830":146956,"_31422":146957,"_3630":146958},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_4190":86972,"_34937":86936,"_5":35369,"_23830":146960,"_31422":146961,"_3630":146962},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_4190":86973,"_34937":86936,"_5":35369,"_23830":146964,"_31422":146965,"_3630":146966},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_4190":86974,"_34937":86936,"_5":35369,"_23830":146968,"_31422":146969,"_3630":146970},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_4190":86975,"_34937":86936,"_5":35369,"_23830":146972,"_31422":146973,"_3630":146974},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_4190":86976,"_34937":86936,"_5":35369,"_23830":146976,"_31422":146977,"_3630":146978},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_4190":86977,"_34937":86936,"_5":35369,"_23830":146980,"_31422":146981,"_3630":146982},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_4190":86978,"_34937":86936,"_5":35369,"_23830":146984,"_31422":146985,"_3630":140973},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_4190":86979,"_34937":86936,"_5":35369,"_23830":146987,"_31422":146988,"_3630":146989},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_4190":86980,"_34937":86936,"_5":35369,"_23830":146991,"_31422":146992,"_3630":146993},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_4190":86981,"_34937":86936,"_23830":146995,"_5":16479,"_31422":86936,"_3630":146996},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_4190":86982,"_34937":86936,"_23830":146998,"_5":16479,"_31422":86936,"_3630":146999},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_4190":86983,"_34937":86936,"_23830":147001,"_5":16479,"_31422":86936,"_3630":147002},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_4190":86984,"_34937":86936,"_23830":147004,"_5":16479,"_31422":86936,"_3630":147005},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_4190":86985,"_34937":86936,"_23830":147007,"_5":16479,"_31422":86936,"_3630":147008},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_4190":86986,"_34937":86936,"_23830":147010,"_5":16479,"_31422":86936,"_3630":147011},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_4190":86987,"_34937":86936,"_23830":147013,"_5":16479,"_31422":86936,"_3630":147014},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_4190":86988,"_34937":86936,"_23830":147016,"_5":16479,"_31422":146830,"_3630":147017},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_4190":86989,"_34937":86936,"_23830":147019,"_5":16479,"_31422":146830,"_3630":147020},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_4190":86990,"_34937":86936,"_23830":147022,"_5":16479,"_31422":146834,"_3630":147023},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_4190":86991,"_34937":86936,"_23830":147025,"_5":16479,"_31422":146834,"_3630":147026},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_4190":86992,"_34937":86936,"_23830":147028,"_5":16479,"_31422":146838,"_3630":147029},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_4190":86993,"_34937":86936,"_23830":147031,"_5":16479,"_31422":146842,"_3630":147032},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_4190":86994,"_34937":86936,"_23830":147034,"_5":16479,"_31422":146842,"_3630":147035},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_4190":86995,"_34937":86936,"_23830":147037,"_5":16479,"_31422":146842,"_3630":147038},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_4190":86996,"_34937":86936,"_23830":147040,"_5":16479,"_31422":146842,"_3630":147041},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_4190":86997,"_34937":86936,"_23830":147043,"_5":16479,"_31422":146842,"_3630":147044},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_4190":86998,"_34937":86936,"_23830":147046,"_5":16479,"_31422":146846,"_3630":147047},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_4190":86999,"_34937":86936,"_23830":147049,"_5":16479,"_31422":146846,"_3630":147050},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_4190":87000,"_34937":86936,"_23830":147052,"_5":16479,"_31422":146846,"_3630":147053},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_4190":87001,"_34937":86936,"_23830":147055,"_5":16479,"_31422":146846,"_3630":147056},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_4190":87002,"_34937":86936,"_23830":147058,"_5":16479,"_31422":146846,"_3630":147059},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_4190":87003,"_34937":86936,"_23830":147061,"_5":16479,"_31422":146846,"_3630":147062},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_4190":87004,"_34937":86936,"_23830":147064,"_5":16479,"_31422":146850,"_3630":147065},[],"Cambio",{"_4190":87005,"_34937":86936,"_23830":147067,"_5":16479,"_31422":146850,"_3630":147068},[],"A quién afecta",{"_4190":87006,"_34937":86936,"_23830":147070,"_5":16479,"_31422":146850,"_3630":147071},[],"Gravedad",{"_4190":87007,"_34937":86936,"_23830":147073,"_5":16479,"_31422":146850,"_3630":143740},[],{"_4190":87008,"_34937":86936,"_23830":147075,"_5":16479,"_31422":146850,"_3630":146858},[],{"_4190":87009,"_34937":86936,"_23830":147077,"_5":16479,"_31422":146850,"_3630":147078},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_4190":87010,"_34937":86936,"_23830":147080,"_5":16479,"_31422":146850,"_3630":147081},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_4190":87011,"_34937":86936,"_23830":147083,"_5":16479,"_31422":146850,"_3630":147084},[],"Copiar los datos a los volúmenes nuevos",{"_4190":87012,"_34937":86936,"_23830":147086,"_5":16479,"_31422":146850,"_3630":146862},[],{"_4190":87013,"_34937":86936,"_23830":147088,"_5":16479,"_31422":146850,"_3630":147089},[],"Todas las releases de Helm",{"_4190":87014,"_34937":86936,"_23830":147091,"_5":16479,"_31422":146850,"_3630":147092},[],"Alta: `helm upgrade` falla",{"_4190":87015,"_34937":86936,"_23830":147094,"_5":16479,"_31422":146850,"_3630":147095},[],"Eliminar o renombrar las claves heredadas",{"_4190":87016,"_34937":86936,"_23830":147097,"_5":16479,"_31422":146850,"_3630":146866},[],{"_4190":87017,"_34937":86936,"_23830":147099,"_5":16479,"_31422":146850,"_3630":147100},[],"Todos los despliegues",{"_4190":87018,"_34937":86936,"_23830":147102,"_5":16479,"_31422":146850,"_3630":147103},[],"Alta: sin principal de bootstrap no hay administrador",{"_4190":87019,"_34937":86936,"_23830":147105,"_5":16479,"_31422":146850,"_3630":147106},[],"Configurar `services.authz`",{"_4190":87020,"_34937":86936,"_23830":147108,"_5":16479,"_31422":146850,"_3630":146870},[],{"_4190":87021,"_34937":86936,"_23830":147110,"_5":16479,"_31422":146850,"_3630":147089},[],{"_4190":87022,"_34937":86936,"_23830":147112,"_5":16479,"_31422":146850,"_3630":147113},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_4190":87023,"_34937":86936,"_23830":147115,"_5":16479,"_31422":146850,"_3630":147116},[],"Mover JWKS y roles a `services.authz`",{"_4190":87024,"_34937":86936,"_23830":147118,"_5":16479,"_31422":146850,"_3630":146890},[],{"_4190":87025,"_34937":86936,"_23830":147120,"_5":16479,"_31422":146850,"_3630":147121},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_4190":87026,"_34937":86936,"_23830":147123,"_5":16479,"_31422":146850,"_3630":147124},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_4190":87027,"_34937":86936,"_23830":147126,"_5":16479,"_31422":146850,"_3630":147127},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_4190":87028,"_34937":86936,"_23830":147129,"_5":16479,"_31422":146850,"_3630":146894},[],{"_4190":87029,"_34937":86936,"_23830":147131,"_5":16479,"_31422":146850,"_3630":147132},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_4190":87030,"_34937":86936,"_23830":147134,"_5":16479,"_31422":146850,"_3630":147135},[],"Alta: el backend ya no arranca con ellos",{"_4190":87031,"_34937":86936,"_23830":147137,"_5":16479,"_31422":146850,"_3630":147138},[],"Pasar a PostgreSQL antes de actualizar",{"_4190":87032,"_34937":86936,"_23830":147140,"_5":16479,"_31422":146850,"_3630":146938},[],{"_4190":87033,"_34937":86936,"_23830":147142,"_5":16479,"_31422":146850,"_3630":147143},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_4190":87034,"_34937":86936,"_23830":147145,"_5":16479,"_31422":146850,"_3630":147146},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_4190":87035,"_34937":86936,"_23830":147148,"_5":16479,"_31422":146850,"_3630":147149},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_4190":87036,"_34937":86936,"_23830":147151,"_5":16479,"_31422":146850,"_3630":147152},[],"Webhooks con referencias a archivos",{"_4190":87037,"_34937":86936,"_23830":147154,"_5":16479,"_31422":146850,"_3630":147155},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_4190":87038,"_34937":86936,"_23830":147157,"_5":16479,"_31422":146850,"_3630":147158},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_4190":87039,"_34937":86936,"_23830":147160,"_5":16479,"_31422":146850,"_3630":147161},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_4190":87040,"_34937":86936,"_23830":147163,"_5":16479,"_31422":146850,"_3630":146874},[],{"_4190":87041,"_34937":86936,"_23830":147165,"_5":16479,"_31422":146850,"_3630":147166},[],"Releases con identidades por servicio o material de claves montado",{"_4190":87042,"_34937":86936,"_23830":147168,"_5":16479,"_31422":146850,"_3630":147169},[],"Media: los servicios no pueden leer sus archivos",{"_4190":87043,"_34937":86936,"_23830":147171,"_5":16479,"_31422":146850,"_3630":147172},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_4190":87044,"_34937":86936,"_23830":147174,"_5":16479,"_31422":146850,"_3630":146878},[],{"_4190":87045,"_34937":86936,"_23830":147176,"_5":16479,"_31422":146850,"_3630":147177},[],"Releases que definen `amqp.tls`",{"_4190":87046,"_34937":86936,"_23830":147179,"_5":16479,"_31422":146850,"_3630":147180},[],"Media: los clientes se conectan al puerto equivocado",{"_4190":87047,"_34937":86936,"_23830":147182,"_5":16479,"_31422":146850,"_3630":147183},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_4190":87048,"_34937":86936,"_23830":147185,"_5":16479,"_31422":146850,"_3630":146898},[],{"_4190":87049,"_34937":86936,"_23830":147187,"_5":16479,"_31422":146850,"_3630":147188},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_4190":87050,"_34937":86936,"_23830":147190,"_5":16479,"_31422":146850,"_3630":147191},[],"Media: las claves de CA quedan sin gestionar",{"_4190":87051,"_34937":86936,"_23830":147193,"_5":16479,"_31422":146850,"_3630":147194},[],"Ejecutar la migración de CA a KMS",{"_4190":87052,"_34937":86936,"_23830":147196,"_5":16479,"_31422":146850,"_3630":147197},[],"Verificación del certificado del receptor",{"_4190":87053,"_34937":86936,"_23830":147199,"_5":16479,"_31422":146850,"_3630":147200},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_4190":87054,"_34937":86936,"_23830":147202,"_5":16479,"_31422":146850,"_3630":147203},[],"Media: las credenciales viajan a un receptor sin verificar",{"_4190":87055,"_34937":86936,"_23830":147205,"_5":16479,"_31422":146850,"_3630":147206},[],"Poner `insecure_skip_verify` a `false`",{"_4190":87056,"_34937":86936,"_23830":147208,"_5":16479,"_31422":146850,"_3630":146914},[],{"_4190":87057,"_34937":86936,"_23830":147210,"_5":16479,"_31422":146850,"_3630":147211},[],"Scripts y consolas que editan DMS por API",{"_4190":87058,"_34937":86936,"_23830":147213,"_5":16479,"_31422":146850,"_3630":147214},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_4190":87059,"_34937":86936,"_23830":147216,"_5":16479,"_31422":146850,"_3630":147217},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_4190":87060,"_34937":86936,"_23830":147219,"_5":16479,"_31422":146850,"_3630":146934},[],{"_4190":87061,"_34937":86936,"_23830":147221,"_5":16479,"_31422":146850,"_3630":147222},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_4190":87062,"_34937":86936,"_23830":147224,"_5":16479,"_31422":146850,"_3630":147225},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_4190":87063,"_34937":86936,"_23830":147227,"_5":16479,"_31422":146850,"_3630":147228},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_4190":87064,"_34937":86936,"_23830":147230,"_5":16479,"_31422":146850,"_3630":146942},[],{"_4190":87065,"_34937":86936,"_23830":147232,"_5":16479,"_31422":146850,"_3630":147233},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_4190":87066,"_34937":86936,"_23830":147235,"_5":16479,"_31422":146850,"_3630":147236},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_4190":87067,"_34937":86936,"_23830":147238,"_5":16479,"_31422":146850,"_3630":147239},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_4190":87068,"_34937":86936,"_23830":147241,"_5":16479,"_31422":146850,"_3630":146930},[],{"_4190":87069,"_34937":86936,"_23830":147243,"_5":16479,"_31422":146850,"_3630":147244},[],"Consumidores que leen el campo `events` del dispositivo",{"_4190":87070,"_34937":86936,"_23830":147246,"_5":16479,"_31422":146850,"_3630":147247},[],"Media: el campo desaparece",{"_4190":87071,"_34937":86936,"_23830":147249,"_5":16479,"_31422":146850,"_3630":147250},[],"Usar los nuevos endpoints de eventos",{"_4190":87072,"_34937":86936,"_23830":147252,"_5":16479,"_31422":146850,"_3630":146950},[],{"_4190":87073,"_34937":86936,"_23830":147254,"_5":16479,"_31422":146850,"_3630":147255},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_4190":87074,"_34937":86936,"_23830":147257,"_5":16479,"_31422":146850,"_3630":147258},[],"Media: la migración de la VA aborta",{"_4190":87075,"_34937":86936,"_23830":147260,"_5":16479,"_31422":146850,"_3630":147261},[],"Corregir los roles afectados antes de actualizar",{"_4190":87076,"_34937":86936,"_23830":147263,"_5":16479,"_31422":146850,"_3630":146882},[],{"_4190":87077,"_34937":86936,"_23830":147265,"_5":16479,"_31422":146850,"_3630":147266},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_4190":87078,"_34937":86936,"_23830":147268,"_5":16479,"_31422":146850,"_3630":147269},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_4190":87079,"_34937":86936,"_23830":147271,"_5":16479,"_31422":146850,"_3630":147272},[],"Actualizar el archivo de values",{"_4190":87080,"_34937":86936,"_23830":147274,"_5":16479,"_31422":146850,"_3630":146922},[],{"_4190":87081,"_34937":86936,"_23830":147276,"_5":16479,"_31422":146850,"_3630":147277},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_4190":87082,"_34937":86936,"_23830":147279,"_5":16479,"_31422":146850,"_3630":147280},[],"Baja: prevalece el ID de la URL",{"_4190":87083,"_34937":86936,"_23830":147282,"_5":16479,"_31422":146850,"_3630":147283},[],"Enviar el ID en la URL",{"_4190":87084,"_34937":86936,"_23830":147285,"_5":16479,"_31422":146850,"_3630":146946},[],{"_4190":87085,"_34937":86936,"_23830":147287,"_5":16479,"_31422":146850,"_3630":147288},[],"Clientes que envían un `id` al crear o importar CAs",{"_4190":87086,"_34937":86936,"_23830":147290,"_5":16479,"_31422":146850,"_3630":147291},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_4190":87087,"_34937":86936,"_23830":147293,"_5":16479,"_31422":146850,"_3630":147294},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_4190":87088,"_34937":86936,"_23830":147296,"_5":16479,"_31422":146850,"_3630":146926},[],{"_4190":87089,"_34937":86936,"_23830":147298,"_5":16479,"_31422":146850,"_3630":147299},[],"Consumidores que comparan el `type` del certificado",{"_4190":87090,"_34937":86936,"_23830":147301,"_5":16479,"_31422":146850,"_3630":147302},[],"Baja: dos valores cambian de nombre",{"_4190":87091,"_34937":86936,"_23830":147304,"_5":16479,"_31422":146850,"_3630":147305},[],"Adaptar los consumidores",{"_4190":87092,"_34937":86936,"_23830":147307,"_5":16479,"_31422":146850,"_3630":146918},[],{"_4190":87093,"_34937":86936,"_23830":147309,"_5":16479,"_31422":146850,"_3630":147310},[],"Cualquier DMS",{"_4190":87094,"_34937":86936,"_23830":147312,"_5":16479,"_31422":146850,"_3630":147313},[],"Baja: solo informativo",{"_4190":87095,"_34937":86936,"_23830":147315,"_5":16479,"_31422":146850,"_3630":147316},[],"Revisar ambos bloques antes de editar",{"_4190":87096,"_34937":86936,"_23830":147318,"_5":16479,"_31422":146857,"_3630":147319},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_4190":87097,"_34937":86936,"_23830":147321,"_5":16479,"_31422":146857,"_3630":147322},[],"El paso 4 de la guía de migración copia los datos.",{"_4190":87098,"_34937":86936,"_23830":147324,"_5":16479,"_31422":146861,"_3630":147325},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_4190":87099,"_34937":86936,"_23830":147327,"_5":16479,"_31422":146865,"_3630":147328},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_4190":87100,"_34937":86936,"_23830":147330,"_5":16479,"_31422":146869,"_3630":147331},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_4190":87101,"_34937":86936,"_23830":147333,"_5":16479,"_31422":146873,"_3630":147334},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_4190":87102,"_34937":86936,"_23830":147336,"_5":16479,"_31422":146873,"_3630":147337},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_4190":87103,"_34937":86936,"_23830":147339,"_5":16479,"_31422":146877,"_3630":147340},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_4190":87104,"_34937":86936,"_23830":147342,"_5":16479,"_31422":146881,"_3630":147343},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_4190":87105,"_34937":86936,"_23830":147345,"_5":16479,"_31422":146881,"_3630":147346},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_4190":87106,"_34937":86936,"_23830":147348,"_5":16479,"_31422":146881,"_3630":147349},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_4190":87107,"_34937":86936,"_23830":147351,"_5":16479,"_31422":146881,"_3630":147352},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_4190":87108,"_34937":86936,"_23830":147354,"_5":16479,"_31422":146881,"_3630":147355},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_4190":87109,"_34937":86936,"_23830":147357,"_5":16479,"_31422":146881,"_3630":147358},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_4190":87110,"_34937":86936,"_23830":147360,"_5":16479,"_31422":146889,"_3630":147361},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_4190":87111,"_34937":86936,"_23830":147363,"_5":16479,"_31422":146889,"_3630":147364},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_4190":87112,"_34937":86936,"_23830":147366,"_5":16479,"_31422":146889,"_3630":147367},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_4190":87113,"_34937":86936,"_23830":147369,"_5":16479,"_31422":146889,"_3630":147370},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_4190":87114,"_34937":86936,"_23830":147372,"_5":16479,"_31422":146889,"_3630":147373},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_4190":87115,"_34937":86936,"_23830":147375,"_5":16479,"_31422":146893,"_3630":147376},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_4190":87116,"_34937":86936,"_23830":147378,"_5":16479,"_31422":146897,"_3630":147379},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_4190":87117,"_34937":86936,"_23830":147381,"_5":16479,"_31422":146897,"_3630":147382},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_4190":87118,"_34937":86936,"_23830":147384,"_5":16479,"_31422":146897,"_3630":147385},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_4190":87119,"_34937":86936,"_23830":147387,"_5":16479,"_31422":146897,"_3630":147388},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_4190":87120,"_34937":86936,"_23830":147390,"_5":16479,"_31422":146897,"_3630":147391},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_4190":87121,"_34937":86936,"_23830":147393,"_5":16479,"_31422":146897,"_3630":147394},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_4190":87122,"_34937":86936,"_23830":147396,"_5":16479,"_31422":146897,"_3630":147397},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_4190":87123,"_34937":86936,"_23830":147399,"_5":16479,"_31422":146897,"_3630":147400},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_4190":87124,"_34937":86936,"_23830":147402,"_5":16479,"_31422":146901,"_3630":147403},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_4190":87125,"_34937":86936,"_23830":147405,"_5":16479,"_31422":146909,"_3630":147406},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_4190":87126,"_34937":86936,"_23830":147408,"_5":16479,"_31422":146909,"_3630":147409},[],"Campo en 3.8.0",{"_4190":87127,"_34937":86936,"_23830":147411,"_5":16479,"_31422":146909,"_3630":147412},[],"Campo en 4.0.0",{"_4190":87128,"_34937":86936,"_23830":147414,"_5":16479,"_31422":146909,"_3630":68800},[],{"_4190":87129,"_34937":86936,"_23830":147416,"_5":16479,"_31422":146909,"_3630":147417},[],"`insecure_skip_verify` (con el valor negado)",{"_4190":87130,"_34937":86936,"_23830":147419,"_5":16479,"_31422":146909,"_3630":68806},[],{"_4190":87131,"_34937":86936,"_23830":147421,"_5":16479,"_31422":146909,"_3630":68809},[],{"_4190":87132,"_34937":86936,"_23830":147423,"_5":16479,"_31422":146909,"_3630":68812},[],{"_4190":87133,"_34937":86936,"_23830":147425,"_5":16479,"_31422":146909,"_3630":68815},[],{"_4190":87134,"_34937":86936,"_23830":147427,"_5":16479,"_31422":146909,"_3630":68818},[],{"_4190":87135,"_34937":86936,"_23830":147429,"_5":16479,"_31422":146909,"_3630":68821},[],{"_4190":87136,"_34937":86936,"_23830":147431,"_5":16479,"_31422":146909,"_3630":147432},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_4190":87137,"_34937":86936,"_23830":147434,"_5":16479,"_31422":146909,"_3630":147435},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_4190":87138,"_34937":86936,"_23830":147437,"_5":16479,"_31422":146909,"_3630":147438},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_4190":87139,"_34937":86936,"_23830":147440,"_5":16479,"_31422":146913,"_3630":147441},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_4190":87140,"_34937":86936,"_23830":147443,"_5":16479,"_31422":146913,"_3630":147444},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_4190":87141,"_34937":86936,"_23830":147446,"_5":16479,"_31422":146913,"_3630":147447},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_4190":87142,"_34937":86936,"_23830":147449,"_5":16479,"_31422":146917,"_3630":147450},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_4190":87143,"_34937":86936,"_23830":147452,"_5":16479,"_31422":146921,"_3630":147453},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_4190":87144,"_34937":86936,"_23830":147455,"_5":16479,"_31422":146925,"_3630":147456},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_4190":87145,"_34937":86936,"_23830":147458,"_5":16479,"_31422":146929,"_3630":147459},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_4190":87146,"_34937":86936,"_23830":147461,"_5":16479,"_31422":146929,"_3630":147462},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_4190":87147,"_34937":86936,"_23830":147464,"_5":16479,"_31422":146929,"_3630":147465},[],"`POST /v1/devices/:id/events` crea un evento.",{"_4190":87148,"_34937":86936,"_23830":147467,"_5":16479,"_31422":146929,"_3630":147468},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_4190":87149,"_34937":86936,"_23830":147470,"_5":16479,"_31422":146933,"_3630":147471},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_4190":87150,"_34937":86936,"_23830":147473,"_5":16479,"_31422":146937,"_3630":147474},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_4190":87151,"_34937":86936,"_23830":147476,"_5":16479,"_31422":146937,"_3630":147477},[],"Ruta",{"_4190":87152,"_34937":86936,"_23830":147479,"_5":16479,"_31422":146937,"_3630":138212},[],{"_4190":87153,"_34937":86936,"_23830":147481,"_5":16479,"_31422":146937,"_3630":68874},[],{"_4190":87154,"_34937":86936,"_23830":147483,"_5":16479,"_31422":146937,"_3630":147484},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_4190":87155,"_34937":86936,"_23830":147486,"_5":16479,"_31422":146937,"_3630":68880},[],{"_4190":87156,"_34937":86936,"_23830":147488,"_5":16479,"_31422":146937,"_3630":147489},[],"Lee los ajustes de una CA.",{"_4190":87157,"_34937":86936,"_23830":147491,"_5":16479,"_31422":146937,"_3630":68886},[],{"_4190":87158,"_34937":86936,"_23830":147493,"_5":16479,"_31422":146937,"_3630":147494},[],"Sustituye los `crl_options`.",{"_4190":87159,"_34937":86936,"_23830":147496,"_5":16479,"_31422":146937,"_3630":147497},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_4190":87160,"_34937":86936,"_23830":147499,"_5":16479,"_31422":146937,"_3630":147500},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_4190":87161,"_34937":86936,"_23830":147502,"_5":16479,"_31422":146937,"_3630":147503},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_4190":87162,"_34937":86936,"_23830":147505,"_5":16479,"_31422":146937,"_3630":147506},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_4190":87163,"_34937":86936,"_23830":147508,"_5":16479,"_31422":146937,"_3630":147509},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_4190":87164,"_34937":86936,"_23830":147511,"_5":16479,"_31422":146937,"_3630":147512},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_4190":87165,"_34937":86936,"_23830":147514,"_5":16479,"_31422":146937,"_3630":147515},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_4190":87166,"_34937":86936,"_23830":147517,"_5":16479,"_31422":146937,"_3630":147518},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_4190":87167,"_34937":86936,"_23830":147520,"_5":16479,"_31422":146937,"_3630":147521},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_4190":87168,"_34937":86936,"_23830":147523,"_5":16479,"_31422":146937,"_3630":147524},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_4190":87169,"_34937":86936,"_23830":147526,"_5":16479,"_31422":146937,"_3630":147527},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_4190":87170,"_34937":86936,"_23830":147529,"_5":16479,"_31422":146941,"_3630":147530},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_4190":87171,"_34937":86936,"_23830":147532,"_5":16479,"_31422":146945,"_3630":147533},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_4190":87172,"_34937":86936,"_23830":147535,"_5":16479,"_31422":146949,"_3630":147536},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_4190":87173,"_34937":86936,"_23830":147538,"_5":16479,"_31422":146953,"_3630":147539},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_4190":87174,"_34937":86936,"_23830":147541,"_5":16479,"_31422":146957,"_3630":147542},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_4190":87175,"_34937":86936,"_23830":147544,"_5":16479,"_31422":146957,"_3630":147545},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_4190":87176,"_34937":86936,"_23830":147547,"_5":16479,"_31422":146957,"_3630":147548},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_4190":87177,"_34937":86936,"_23830":147550,"_5":16479,"_31422":146957,"_3630":147551},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_4190":87178,"_34937":86936,"_23830":147553,"_5":16479,"_31422":146957,"_3630":147554},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_4190":87179,"_34937":86936,"_23830":147556,"_5":16479,"_31422":146957,"_3630":147557},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_4190":87180,"_34937":86936,"_23830":147559,"_5":16479,"_31422":146961,"_3630":147560},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_4190":87181,"_34937":86936,"_23830":147562,"_5":16479,"_31422":146961,"_3630":147563},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_4190":87182,"_34937":86936,"_23830":147565,"_5":16479,"_31422":146961,"_3630":147566},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_4190":87183,"_34937":86936,"_23830":147568,"_5":16479,"_31422":146961,"_3630":147569},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_4190":87184,"_34937":86936,"_23830":147571,"_5":16479,"_31422":146961,"_3630":147572},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_4190":87185,"_34937":86936,"_23830":147574,"_5":16479,"_31422":146965,"_3630":147575},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_4190":87186,"_34937":86936,"_23830":147577,"_5":16479,"_31422":146965,"_3630":147578},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_4190":87187,"_34937":86936,"_23830":147580,"_5":16479,"_31422":146965,"_3630":147581},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_4190":87188,"_34937":86936,"_23830":147583,"_5":16479,"_31422":146965,"_3630":147584},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_4190":87189,"_34937":86936,"_23830":147586,"_5":16479,"_31422":146965,"_3630":147587},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_4190":87190,"_34937":86936,"_23830":147589,"_5":16479,"_31422":146965,"_3630":147590},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_4190":87191,"_34937":86936,"_23830":147592,"_5":16479,"_31422":146965,"_3630":147593},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_4190":87192,"_34937":86936,"_23830":147595,"_5":16479,"_31422":146965,"_3630":147596},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_4190":87193,"_34937":86936,"_23830":147598,"_5":16479,"_31422":146965,"_3630":147599},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_4190":87194,"_34937":86936,"_23830":147601,"_5":16479,"_31422":146965,"_3630":147602},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_4190":87195,"_34937":86936,"_23830":147604,"_5":16479,"_31422":146965,"_3630":147605},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_4190":87196,"_34937":86936,"_23830":147607,"_5":16479,"_31422":146965,"_3630":147608},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_4190":87197,"_34937":86936,"_23830":147610,"_5":16479,"_31422":146969,"_3630":147611},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_4190":87198,"_34937":86936,"_23830":147613,"_5":16479,"_31422":146969,"_3630":147614},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_4190":87199,"_34937":86936,"_23830":147616,"_5":16479,"_31422":146973,"_3630":147617},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_4190":87200,"_34937":86936,"_23830":147619,"_5":16479,"_31422":146973,"_3630":147620},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_4190":87201,"_34937":86936,"_23830":147622,"_5":16479,"_31422":146973,"_3630":147623},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_4190":87202,"_34937":86936,"_23830":147625,"_5":16479,"_31422":146973,"_3630":147626},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_4190":87203,"_34937":86936,"_23830":147628,"_5":16479,"_31422":146973,"_3630":147629},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_4190":87204,"_34937":86936,"_23830":147631,"_5":16479,"_31422":146973,"_3630":147632},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_4190":87205,"_34937":86936,"_23830":147634,"_5":16479,"_31422":146973,"_3630":147635},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_4190":87206,"_34937":86936,"_23830":147637,"_5":16479,"_31422":146973,"_3630":147638},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_4190":87207,"_34937":86936,"_23830":147640,"_5":16479,"_31422":146973,"_3630":147641},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_4190":87208,"_34937":86936,"_23830":147643,"_5":16479,"_31422":146973,"_3630":147644},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_4190":87209,"_34937":86936,"_23830":147646,"_5":16479,"_31422":146973,"_3630":147647},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_4190":87210,"_34937":86936,"_23830":147649,"_5":16479,"_31422":146977,"_3630":147650},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_4190":87211,"_34937":86936,"_23830":147652,"_5":16479,"_31422":146977,"_3630":147653},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_4190":87212,"_34937":86936,"_23830":147655,"_5":16479,"_31422":146981,"_3630":147656},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_4190":87213,"_34937":86936,"_23830":147658,"_5":16479,"_31422":146981,"_3630":147659},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_4190":87214,"_34937":86936,"_23830":147661,"_5":16479,"_31422":146981,"_3630":147662},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_4190":87215,"_34937":86936,"_23830":147664,"_5":16479,"_31422":146981,"_3630":147665},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_4190":87216,"_34937":86936,"_23830":147667,"_5":16479,"_31422":146981,"_3630":147668},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_4190":87217,"_34937":86936,"_23830":147670,"_5":16479,"_31422":146981,"_3630":147671},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_4190":87218,"_34937":86936,"_23830":147673,"_5":16479,"_31422":146981,"_3630":147674},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_4190":87219,"_34937":86936,"_23830":147676,"_5":16479,"_31422":146981,"_3630":147677},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_4190":87220,"_34937":86936,"_23830":147679,"_5":16479,"_31422":146985,"_3630":147680},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_4190":87221,"_34937":86936,"_23830":147682,"_5":16479,"_31422":146985,"_3630":147683},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_4190":87222,"_34937":86936,"_23830":147685,"_5":16479,"_31422":146985,"_3630":147686},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_4190":87223,"_34937":86936,"_23830":147688,"_5":16479,"_31422":146985,"_3630":147689},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_4190":87224,"_34937":86936,"_23830":147691,"_5":16479,"_31422":146985,"_3630":147692},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_4190":87225,"_34937":86936,"_23830":147694,"_5":16479,"_31422":146985,"_3630":147695},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_4190":87226,"_34937":86936,"_23830":147697,"_5":16479,"_31422":146985,"_3630":147698},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_4190":87227,"_34937":86936,"_23830":147700,"_5":16479,"_31422":146985,"_3630":147701},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_4190":87228,"_34937":86936,"_23830":147703,"_5":16479,"_31422":146985,"_3630":147704},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_4190":87229,"_34937":86936,"_23830":147706,"_5":16479,"_31422":146985,"_3630":147707},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_4190":87230,"_34937":86936,"_23830":147709,"_5":16479,"_31422":146985,"_3630":147710},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_4190":87231,"_34937":86936,"_23830":147712,"_5":16479,"_31422":146988,"_3630":147713},[],"Tras la actualización, comprueba en este orden:",{"_4190":87232,"_34937":86936,"_23830":147715,"_5":16479,"_31422":146988,"_3630":147716},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_4190":87233,"_34937":86936,"_23830":147718,"_5":16479,"_31422":146988,"_3630":147719},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_4190":87234,"_34937":86936,"_23830":147721,"_5":16479,"_31422":146988,"_3630":147722},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_4190":87235,"_34937":86936,"_23830":147724,"_5":16479,"_31422":146988,"_3630":147725},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_4190":87236,"_34937":86936,"_23830":147727,"_5":16479,"_31422":146988,"_3630":147728},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_4190":87237,"_34937":86936,"_23830":147730,"_5":16479,"_31422":146988,"_3630":147731},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_4190":87238,"_34937":86936,"_23830":147733,"_5":16479,"_31422":146988,"_3630":147734},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_4190":87239,"_34937":86936,"_23830":147736,"_5":16479,"_31422":146988,"_3630":147737},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_4190":87240,"_34937":86936,"_23830":147739,"_5":16479,"_31422":146988,"_3630":147740},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_4190":87241,"_34937":86936,"_23830":147742,"_5":16479,"_31422":146988,"_3630":147743},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_4190":87242,"_34937":86936,"_23830":147745,"_5":16479,"_31422":146988,"_3630":147746},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_4190":87243,"_34937":86936,"_23830":147748,"_5":16479,"_31422":146988,"_3630":147749},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_4190":87244,"_34937":86936,"_23830":147751,"_5":16479,"_31422":146988,"_3630":147752},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_4190":87245,"_34937":86936,"_23830":147754,"_5":16479,"_31422":146988,"_3630":147755},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_4190":87246,"_34937":86936,"_23830":147757,"_5":16479,"_31422":146988,"_3630":147758},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_4190":87247,"_34937":86936,"_23830":147760,"_5":16479,"_31422":146992,"_3630":147761},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_4190":87248,"_34937":86936,"_23830":147763,"_5":16479,"_31422":146992,"_3630":147764},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_4190":87249,"_34937":86936,"_23830":147766,"_5":16479,"_31422":146992,"_3630":147767},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4190":87250,"_34937":86936,"_23830":147769,"_5":16479,"_31422":146992,"_3630":147770},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_4190":87251,"_34937":86936,"_23830":147772,"_5":16479,"_31422":146992,"_3630":147773},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_69171":147775,"_69172":147776,"_69174":147777,"_69176":147778,"_20662":3647,"_83635":3647},"spanish",[3630,34937,5,31422],{"_3630":28524,"_34937":28524,"_5":28524,"_31422":28524},{"_3630":147779,"_34937":151392,"_5":155005,"_31422":158618},{"_5486":147780,"_69180":147781,"_5":28524},{"_11835":9945,"_11996":16523,"_11933":8032,"_11786":12076,"_12125":8697,"_11795":6008,"_11826":13724,"_11807":15401,"_29970":7592,"_33980":4420,"_34014":8108,"_33476":10322,"_34080":8258,"_33663":8643,"_34086":16047,"_34048":17128,"_34092":3914,"_34097":30803,"_34038":8603,"_34675":26323,"_39973":3983,"_39975":19496,"_34719":3713,"_17030":8745,"_34699":8639,"_39981":3999,"_34728":16049,"_29954":5929,"_34670":20407,"_34746":12851,"_34788":34181,"_39988":7048,"_39990":4811,"_33680":26112,"_39993":8357,"_34817":8600,"_34805":10872,"_34778":10081,"_34811":5255,"_33545":29335,"_33593":4468,"_33599":3792,"_33605":13625,"_11789":20946,"_33611":3907,"_33617":4572,"_40007":4171,"_33587":8535,"_33623":6140,"_33435":11202,"_40013":31549,"_33481":5385,"_33503":28085,"_33509":8089,"_40019":13180,"_17020":18102,"_40022":19283,"_35007":4739,"_40026":5384,"_34849":8182,"_40029":6248,"_40031":4109,"_40033":4432,"_22621":4077,"_11798":7711,"_40037":3769,"_33455":28055,"_40040":11210,"_40042":5578,"_40044":3815,"_40046":6772,"_34762":5601,"_33993":3990,"_40050":4135,"_40052":26941,"_34913":18126,"_34