/overview.mdx",{"_72":378,"_79":118,"_93":-7,"_74":379},"es:_7","Algoritmos y toolchain",{"_72":381,"_79":90,"_74":26,"_84":382,"_93":-7,"_11":24,"_95":383},"es:platform/pqc/algorithms.mdx","Los algoritmos de firma poscuánticos y composite que soporta Lamassu, cómo se identifica cada uno en las peticiones a la API y los estándares que siguen.",{"_97":384},"platform/pqc/algorithms.mdx",{"_72":386,"_79":90,"_74":37,"_84":387,"_93":-7,"_11":36,"_95":388},"es:platform/pqc/go-toolchain.mdx","El fork de Go que añade ML-DSA composite, SLH-DSA, certificados relacionados y esquemas de firma TLS composite, la API que expone y cómo se compila.",{"_97":389},"platform/pqc/go-toolchain.mdx",{"_72":391,"_79":118,"_93":-7,"_74":392},"es:_8","Soporte en la plataforma",{"_72":394,"_79":90,"_74":49,"_84":395,"_93":-7,"_11":48,"_95":396},"es:platform/pqc/keys-and-cas.mdx","Crear claves y CA poscuánticas, firmar con ellas y emitir certificados, con el soporte de motores, los valores de la API y las restricciones aplicables.",{"_97":397},"platform/pqc/keys-and-cas.mdx",{"_72":399,"_79":90,"_74":58,"_84":400,"_93":-7,"_11":57,"_95":401},"es:platform/pqc/related-certificates.mdx","Vincular un certificado con clave poscuántica a un certificado clásico existente del mismo dispositivo, según el RFC 9763, y cómo los emite y comprueba Lamassu.",{"_97":402},"platform/pqc/related-certificates.mdx",{"_72":404,"_79":90,"_74":31,"_84":405,"_93":-7,"_11":30,"_95":406},"es:platform/pqc/dashboard.mdx","Cómo expone la interfaz web los algoritmos poscuánticos al crear claves, CA y certificados, y cómo los muestra.",{"_97":407},"platform/pqc/dashboard.mdx",{"_72":409,"_79":118,"_93":-7,"_74":15},"es:_9",{"_72":411,"_79":90,"_74":61,"_84":412,"_93":-7,"_11":60,"_95":413},"es:platform/pqc/tls-front-proxy.mdx","El fork de Traefik que termina el TLS de los dispositivos con certificados clásicos y poscuánticos para el mismo host, cómo elige certificado y cómo se compila.",{"_97":414},"platform/pqc/tls-front-proxy.mdx",{"_72":416,"_79":90,"_74":34,"_84":417,"_93":-7,"_11":33,"_95":418},"es:platform/pqc/deployment.mdx","Desplegar Lamassu con un proxy frontal Traefik que sirve certificados clásicos, poscuánticos y composite, mediante los valores del chart o el instalador fast-lane.",{"_97":419},"platform/pqc/deployment.mdx",{"_72":421,"_79":118,"_93":-7,"_74":422},"es:_10","Pruebas de integración",{"_72":424,"_79":90,"_74":46,"_84":425,"_93":-7,"_11":45,"_95":426},"es:platform/pqc/integration-tests/overview.mdx","Evidencia de que software ajeno a Lamassu negocia intercambio de claves poscuántico y verifica los certificados poscuánticos y composite que sirve Lamassu.",{"_97":427},"platform/pqc/integration-tests/overview.mdx",{"_72":429,"_79":90,"_74":40,"_84":430,"_93":-7,"_11":39,"_95":431},"es:platform/pqc/integration-tests/https.mdx","Resultados de probar un endpoint HTTPS de Lamassu con OpenSSL y curl usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_97":432},"platform/pqc/integration-tests/https.mdx",{"_72":434,"_79":90,"_74":43,"_84":435,"_93":-7,"_11":42,"_95":436},"es:platform/pqc/integration-tests/mqtts.mdx","Resultados de probar un broker MQTT detrás del proxy TLS de Lamassu con mosquitto, usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_97":437},"platform/pqc/integration-tests/mqtts.mdx",{"_72":439,"_79":118,"_93":-7,"_74":440},"es:_11","Referencia",{"_72":442,"_79":90,"_74":52,"_84":443,"_93":-7,"_11":51,"_95":444},"es:platform/pqc/limitations.mdx","Qué está incompleto, es no estándar o no está verificado en el soporte poscuántico de Lamassu, agrupado por componente.",{"_97":445},"platform/pqc/limitations.mdx","es:platform/pqc",{"_232":448},"platform/pqc/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-atom shr