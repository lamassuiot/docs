view/pr-58/es/platform/iot-fleets/quickstarts/register-device",{"_94":257},"platform/iot-fleets/quickstarts/register-device.mdx",{"_71":259,"_78":115,"_91":-7,"_73":260},"es:_6","Dispositivos e identidades",{"_71":262,"_78":88,"_73":260,"_82":263,"_91":-7,"_11":264,"_92":265},"es:platform/iot-fleets/device-management.mdx","Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.","/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management",{"_94":266},"platform/iot-fleets/device-management.mdx",{"_78":79,"_73":268,"_80":-7,"_81":-7,"_82":-7,"_84":-7,"_75":269,"_71":326,"_92":327,"_91":329,"_232":330},"Enrolamiento con PKI",[270,277,284,291,298,305,312,319],{"_71":271,"_78":88,"_73":272,"_82":273,"_91":-7,"_11":274,"_92":275},"es:platform/iot-fleets/enrollment/provisioning-strategies.mdx","Estrategias de aprovisionamiento","Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies",{"_94":276},"platform/iot-fleets/enrollment/provisioning-strategies.mdx",{"_71":278,"_78":88,"_73":279,"_82":280,"_91":-7,"_11":281,"_92":282},"es:platform/iot-fleets/enrollment/dms.mdx","Configura y opera el DMS","Define registro, autenticación por operación, emisión, renovación y confianza distribuida.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms",{"_94":283},"platform/iot-fleets/enrollment/dms.mdx",{"_71":285,"_78":88,"_73":286,"_82":287,"_91":-7,"_11":288,"_92":289},"es:platform/iot-fleets/enrollment/bootstrap-identity.mdx","Identidad inicial y autenticación","Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity",{"_94":290},"platform/iot-fleets/enrollment/bootstrap-identity.mdx",{"_71":292,"_78":88,"_73":293,"_82":294,"_91":-7,"_11":295,"_92":296},"es:platform/iot-fleets/enrollment/est-client.mdx","Integra el 