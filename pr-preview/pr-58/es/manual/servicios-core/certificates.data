ets/quickstarts/register-device.mdx",{"_71":257,"_78":115,"_91":-7,"_73":258},"es:_6","Dispositivos e identidades",{"_71":260,"_78":88,"_73":258,"_82":261,"_91":-7,"_12":262,"_93":263},"es:platform/iot-fleets/device-management.mdx","Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.","/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management",{"_95":264},"platform/iot-fleets/device-management.mdx",{"_78":79,"_73":266,"_80":-7,"_81":-7,"_82":-7,"_84":-7,"_75":267,"_71":324,"_93":325,"_91":327,"_230":328},"Enrolamiento con PKI",[268,275,282,289,296,303,310,317],{"_71":269,"_78":88,"_73":270,"_82":271,"_91":-7,"_12":272,"_93":273},"es:platform/iot-fleets/enrollment/provisioning-strategies.mdx","Estrategias de aprovisionamiento","Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies",{"_95":274},"platform/iot-fleets/enrollment/provisioning-strategies.mdx",{"_71":276,"_78":88,"_73":277,"_82":278,"_91":-7,"_12":279,"_93":280},"es:platform/iot-fleets/enrollment/dms.mdx","Configura y opera el DMS","Define registro, autenticación por operación, emisión, renovación y confianza distribuida.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms",{"_95":281},"platform/iot-fleets/enrollment/dms.mdx",{"_71":283,"_78":88,"_73":284,"_82":285,"_91":-7,"_12":286,"_93":287},"es:platform/iot-fleets/enrollment/bootstrap-identity.mdx","Identidad inicial y autenticación","Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity",{"_95":288},"platform/iot-fleets/enrollment/bootstrap-identity.mdx",{"_71":290,"_78":88,"_73":291,"_82":292,"_91":-7,"_12":293,"_93":294},"es:platform/iot-fleets/enrollment/est-client.mdx","Integra el cliente EST","Prepara la confianza, envía una CSR y comprueba la identidad recibida.","/docs