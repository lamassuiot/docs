vice.mdx",{"_68":256,"_75":112,"_88":-7,"_70":257},"es:_6","Dispositivos e identidades",{"_68":259,"_75":85,"_70":257,"_79":260,"_88":-7,"_11":261,"_89":262},"es:platform/iot-fleets/device-management.mdx","Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.","/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management",{"_91":263},"platform/iot-fleets/device-management.mdx",{"_75":76,"_70":265,"_77":-7,"_78":-7,"_79":-7,"_81":-7,"_72":266,"_68":323,"_89":324,"_88":326,"_229":327},"Enrolamiento con PKI",[267,274,281,288,295,302,309,316],{"_68":268,"_75":85,"_70":269,"_79":270,"_88":-7,"_11":271,"_89":272},"es:platform/iot-fleets/enrollment/provisioning-strategies.mdx","Estrategias de aprovisionamiento","Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies",{"_91":273},"platform/iot-fleets/enrollment/provisioning-strategies.mdx",{"_68":275,"_75":85,"_70":276,"_79":277,"_88":-7,"_11":278,"_89":279},"es:platform/iot-fleets/enrollment/dms.mdx","Configura y opera el DMS","Define registro, autenticación por operación, emisión, renovación y confianza distribuida.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms",{"_91":280},"platform/iot-fleets/enrollment/dms.mdx",{"_68":282,"_75":85,"_70":283,"_79":284,"_88":-7,"_11":285,"_89":286},"es:platform/iot-fleets/enrollment/bootstrap-identity.mdx","Identidad inicial y autenticación","Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity",{"_91":287},"platform/iot-fleets/enrollment/bootstrap-identity.mdx",{"_68":289,"_75":85,"_70":290,"_79":291,"_88":-7,"_11":292,"_89":293},"es:platform/iot-fleets/enrollment/est-client.mdx","Integra el cliente EST","Prepara la confianza, envía una CSR y comprueba la identidad recibida.","/docs/pr-preview/pr-58/es/platfo