view.mdx",{"_74":379,"_81":119,"_94":-7,"_76":380},"es:_7","Algoritmos y toolchain",{"_74":382,"_81":91,"_76":29,"_85":383,"_94":-7,"_13":27,"_96":384},"es:platform/pqc/algorithms.mdx","Los algoritmos de firma poscuánticos y composite que soporta Lamassu, cómo se identifica cada uno en las peticiones a la API y los estándares que siguen.",{"_98":385},"platform/pqc/algorithms.mdx",{"_74":387,"_81":91,"_76":40,"_85":388,"_94":-7,"_13":39,"_96":389},"es:platform/pqc/go-toolchain.mdx","El fork de Go que añade ML-DSA composite, SLH-DSA, certificados relacionados y esquemas de firma TLS composite, la API que expone y cómo se compila.",{"_98":390},"platform/pqc/go-toolchain.mdx",{"_74":392,"_81":119,"_94":-7,"_76":393},"es:_8","Soporte en la plataforma",{"_74":395,"_81":91,"_76":51,"_85":396,"_94":-7,"_13":50,"_96":397},"es:platform/pqc/keys-and-cas.mdx","Crear claves y CA poscuánticas, firmar con ellas y emitir certificados, con el soporte de motores, los valores de la API y las restricciones aplicables.",{"_98":398},"platform/pqc/keys-and-cas.mdx",{"_74":400,"_81":91,"_76":60,"_85":401,"_94":-7,"_13":59,"_96":402},"es:platform/pqc/related-certificates.mdx","Vincular un certificado con clave poscuántica a un certificado clásico existente del mismo dispositivo, según el RFC 9763, y cómo los emite y comprueba Lamassu.",{"_98":403},"platform/pqc/related-certificates.mdx",{"_74":405,"_81":91,"_76":34,"_85":406,"_94":-7,"_13":33,"_96":407},"es:platform/pqc/dashboard.mdx","Cómo expone la interfaz web los algoritmos poscuánticos al crear claves, CA y certificados, y cómo los muestra.",{"_98":408},"platform/pqc/dashboard.mdx",{"_74":410,"_81":119,"_94":-7,"_76":411},"es:_9","Despliegue",{"_74":413,"_81":91,"_76":63,"_85":414,"_94":-7,"_13":62,"_96":415},"es:platform/pqc/tls-front-proxy.mdx","El fork de Traefik que termina el TLS de los dispositivos con certificados clásicos y poscuánticos para el mismo host, cómo elige certificado y cómo se compila.",{"_98":416},"platform/pqc/tls-front-proxy.mdx",{"_74":418,"_81":91,"_76":37,"_85":419,"_94":-7,"_13":36,"_96":420},"es:platform/pqc/deployment.mdx","Desplegar Lamassu con un proxy frontal Traefik que sirve certificados clásicos, poscuánticos y composite, mediante los valores del chart o el instalador fast-lane.",{"_98":421},"platform/pqc/deployment.mdx",{"_74":423,"_81":119,"_94":-7,"_76":19},"es:_10",{"_74":425,"_81":91,"_76":48,"_85":426,"_94":-7,"_13":47,"_96":427},"es:platform/pqc/integration-tests/overview.mdx","Evidencia de que software ajeno a Lamassu negocia intercambio de claves poscuántico y verifica los certificados poscuánticos y composite que sirve Lamassu.",{"_98":428},"platform/pqc/integration-tests/overview.mdx",{"_74":430,"_81":91,"_76":42,"_85":431,"_94":-7,"_13":14,"_96":432},"es:platform/pqc/integration-tests/https.mdx","Resultados de probar un endpoint HTTPS de Lamassu con OpenSSL y curl usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_98":433},"platform/pqc/integration-tests/https.mdx",{"_74":435,"_81":91,"_76":45,"_85":436,"_94":-7,"_13":44,"_96":437},"es:platform/pqc/integration-tests/mqtts.mdx","Resultados de probar un broker MQTT detrás del proxy TLS de Lamassu con mosquitto, usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_98":438},"platform/pqc/integration-tests/mqtts.mdx",{"_74":440,"_81":119,"_94":-7,"_76":441},"es:_11","Referencia",{"_74":443,"_81":91,"_76":54,"_85":444,"_94":-7,"_13":53,"_96":445},"es:platform/pqc/limitations.mdx","Qué está incompleto, es no estándar o no está verificado en el soporte poscuántico de Lamassu, agrupado por componente.",{"_98":446},"platform/pqc/limitations.mdx","es:platform/pqc",{"_233":449},"platform/pqc/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-atom shrink-0\" aria-hidd