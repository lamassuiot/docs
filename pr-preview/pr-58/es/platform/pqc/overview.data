form/iot-fleets/enrollment/renewal-and-recovery",{"_84":294},"platform/iot-fleets/enrollment/renewal-and-recovery.mdx",{"_60":296,"_67":77,"_62":297,"_71":298,"_80":-7,"_12":299,"_82":300},"es:platform/iot-fleets/enrollment/trust-distribution.mdx","Distribución y actualización de confianza","Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution",{"_84":301},"platform/iot-fleets/enrollment/trust-distribution.mdx",{"_60":303,"_67":77,"_62":304,"_71":305,"_80":-7,"_12":306,"_82":307},"es:platform/iot-fleets/enrollment/est-reference.mdx","Referencia EST","Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference",{"_84":308},"platform/iot-fleets/enrollment/est-reference.mdx",{"_60":310,"_67":77,"_62":311,"_71":312,"_80":-7,"_12":313,"_82":314},"es:platform/iot-fleets/enrollment/troubleshooting.mdx","Diagnóstico de enrolamiento","Localiza fallos de transporte, autenticación, registro, emisión e instalación.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting",{"_84":315},"platform/iot-fleets/enrollment/troubleshooting.mdx","es:platform/iot-fleets/enrollment",{"_219":318},"platform/iot-fleets/enrollment/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network shrink-0\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg>",{"_60":321,"_67":77,"_62":258,"_71":322,"_80":-7,"_12":323,"_82":324},"es:platform/iot-fleets/e