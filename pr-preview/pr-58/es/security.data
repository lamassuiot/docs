/register-device.mdx",{"_66":256,"_73":112,"_87":-7,"_68":257},"es:_6","Dispositivos e identidades",{"_66":259,"_73":84,"_68":257,"_78":260,"_87":-7,"_10":261,"_89":262},"es:platform/iot-fleets/device-management.mdx","Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.","/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management",{"_91":263},"platform/iot-fleets/device-management.mdx",{"_73":74,"_68":265,"_76":-7,"_77":-7,"_78":-7,"_80":-7,"_70":266,"_66":323,"_89":324,"_87":326,"_229":327},"Enrolamiento con PKI",[267,274,281,288,295,302,309,316],{"_66":268,"_73":84,"_68":269,"_78":270,"_87":-7,"_10":271,"_89":272},"es:platform/iot-fleets/enrollment/provisioning-strategies.mdx","Estrategias de aprovisionamiento","Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies",{"_91":273},"platform/iot-fleets/enrollment/provisioning-strategies.mdx",{"_66":275,"_73":84,"_68":276,"_78":277,"_87":-7,"_10":278,"_89":279},"es:platform/iot-fleets/enrollment/dms.mdx","Configura y opera el DMS","Define registro, autenticación por operación, emisión, renovación y confianza distribuida.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms",{"_91":280},"platform/iot-fleets/enrollment/dms.mdx",{"_66":282,"_73":84,"_68":283,"_78":284,"_87":-7,"_10":285,"_89":286},"es:platform/iot-fleets/enrollment/bootstrap-identity.mdx","Identidad inicial y autenticación","Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity",{"_91":287},"platform/iot-fleets/enrollment/bootstrap-identity.mdx",{"_66":289,"_73":84,"_68":290,"_78":291,"_87":-7,"_10":292,"_89":293},"es:platform/iot-fleets/enrollment/est-client.mdx","Integra el cliente EST","Prepara la confianza, envía una CSR y comprueba la identidad recibida.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client",{"_91":294},"platform/iot-fleets/enrollment/est-client.mdx",{"_66":296,"_73":84,"_68":297,"_78":298,"_87":-7,"_10":299,"_89":300},"es:platform/iot-fleets/enrollment/renewal-and-recovery.mdx","Renovación y recuperación","Renueva sin perder la identidad y recupera dispositivos según su estado real.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery",{"_91":301},"platform/iot-fleets/enrollment/renewal-and-recovery.mdx",{"_66":303,"_73":84,"_68":304,"_78":305,"_87":-7,"_10":306,"_89":307},"es:platform/iot-fleets/enrollment/trust-distribution.mdx","Distribución y actualización de confianza","Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution",{"_91":308},"platform/iot-fleets/enrollment/trust-distribution.mdx",{"_66":310,"_73":84,"_68":311,"_78":312,"_87":-7,"_10":313,"_89":314},"es:platform/iot-fleets/enrollment/est-reference.mdx","Referencia EST","Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference",{"_91":315},"platform/iot-fleets/enrollment/est-reference.mdx",{"_66":317,"_73":84,"_68":318,"_78":319,"_87":-7,"_10":320,"_89":321},"es:platform/iot-fleets/enrollment/troubleshooting.mdx","Diagnóstico de enrolamiento","Localiza fallos de transporte, autenticación, registro, emisión e instalación.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting",{"_91":322},"platform/iot-fleets/enrollment/troubleshooting.mdx","es:platform/iot-fleets/enrollment",{"_226":325},"platform/iot-fleets/enrollment/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network shrink-0\" aria-hidden=\"true\"><rect