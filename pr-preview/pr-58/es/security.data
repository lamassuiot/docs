ets/device-management.mdx",{"_64":65,"_59":256,"_67":-7,"_68":-7,"_69":-7,"_71":-7,"_61":257,"_57":314,"_80":315,"_78":317,"_220":318},"Enrolamiento con PKI",[258,265,272,279,286,293,300,307],{"_57":259,"_64":75,"_59":260,"_69":261,"_78":-7,"_10":262,"_80":263},"es:platform/iot-fleets/enrollment/provisioning-strategies.mdx","Estrategias de aprovisionamiento","Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies",{"_82":264},"platform/iot-fleets/enrollment/provisioning-strategies.mdx",{"_57":266,"_64":75,"_59":267,"_69":268,"_78":-7,"_10":269,"_80":270},"es:platform/iot-fleets/enrollment/dms.mdx","Configura y opera el DMS","Define registro, autenticación por operación, emisión, renovación y confianza distribuida.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms",{"_82":271},"platform/iot-fleets/enrollment/dms.mdx",{"_57":273,"_64":75,"_59":274,"_69":275,"_78":-7,"_10":276,"_80":277},"es:platform/iot-fleets/enrollment/bootstrap-identity.mdx","Identidad inicial y autenticación","Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity",{"_82":278},"platform/iot-fleets/enrollment/bootstrap-identity.mdx",{"_57":280,"_64":75,"_59":281,"_69":282,"_78":-7,"_10":283,"_80":284},"es:platform/iot-fleets/enrollment/est-client.mdx","Integra el cliente EST","Prepara la confianza, envía una CSR y comprueba la identidad recibida.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client",{"_82":285},"platform/iot-fleets/enrollment/est-client.mdx",{"_57":287,"_64":75,"_59":288,"_69":289,"_78":-7,"_10":290,"_80":291},"es:platform/iot-fleets/enrollment/renewal-and-recovery.mdx","Renovación y recuperación","Renueva sin perder la identidad y recupera dispositivos según su estado real.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery",{"_82":292},"platform/iot-fleets/enrollment/renewal-and-recovery.mdx",{"_57":294,"_64":75,"_59":295,"_69":296,"_78":-7,"_10":297,"_80":298},"es:platform/iot-fleets/enrollment/trust-distribution.mdx","Distribución y actualización de confianza","Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution",{"_82":299},"platform/iot-fleets/enrollment/trust-distribution.mdx",{"_57":301,"_64":75,"_59":302,"_69":303,"_78":-7,"_10":304,"_80":305},"es:platform/iot-fleets/enrollment/est-reference.mdx","Referencia EST","Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference",{"_82":306},"platform/iot-fleets/enrollment/est-reference.mdx",{"_57":308,"_64":75,"_59":309,"_69":310,"_78":-7,"_10":311,"_80":312},"es:platform/iot-fleets/enrollment/troubleshooting.mdx","Diagnóstico de enrolamiento","Localiza fallos de transporte, autenticación, registro, emisión e instalación.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting",{"_82":313},"platform/iot-fleets/enrollment/troubleshooting.mdx","es:platform/iot-fleets/enrollment",{"_217":316},"platform/iot-fleets/enrollment/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network shrink-0\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg>",{"_57":319,"_64":75,"_59":256,"_69":320,"_78":-7,"_10":321,"_80":322},"es:platform/iot-fleets/enrollment/overview.mdx","Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.","/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview",{"_82":323},"platform/iot-fleets/enrollment/overview.mdx",{"_64":65,"_59":325,"_67":-7,"_68":-7,"_69":-7,"_71":-7,"_61":326,"_57":334,"_80":335,"_78":337},"Integraciones",[327],{"_57":328,"_64":75,"_59":329,"_69":330,"_78":-7,"_10":331,"_80":332},"es:platform/iot-fleets/integrations/aws-iot-core.mdx","AWS IoT Core","El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.","/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core",{"_82":333},"platform/iot-fleets/integrations/aws-iot-core.mdx","es:platform/iot-fleets/integrations",{"_217":336},"platform/iot-fleets/integrations/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud shrink-0\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg>","es:platform/iot-fleets",{"_217":340},"platform/iot-fleets/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu shrink-0\" aria-hidden=\"true\"><path d=\"M12 20v2\"></path><path d=\"M12 2v2\"></path><path d=\"M17 20v2\"></path><path d=\"M17 2v2\"></path><path d=\"M2 12h2\"></path><path d=\"M2 17h2\"></path><path d=\"M2 7h2\"></path><path d=\"M20 12h2\"></path><path d=\"M20 17h2\"></path><path d=\"M20 7h2\"></path><path d=\"M7 20v2\"></path><path d=\"M7 2v2\"></path><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\