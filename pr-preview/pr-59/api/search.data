_39739":57336,"_39741":57339},{"_3394":15,"_29710":15,"_5":14491,"_2880":48399,"_30063":48400,"_20617":48404,"_27008":15},"Deploy from AWS Marketplace",[48401,48402,48403],"Docs","Deployment","Other models",[],{"_3394":16,"_29710":15,"_20617":48406,"_5":14139,"_27008":15,"_2880":48407},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3394":17,"_29710":15,"_5":30060,"_20617":48409,"_27008":48410,"_2880":48411},[],"/docs/pr-preview/pr-59/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3394":18,"_29710":15,"_5":30060,"_20617":48413,"_27008":48414,"_2880":48415},[],"/docs/pr-preview/pr-59/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3394":19,"_29710":15,"_5":30060,"_20617":48417,"_27008":48418,"_2880":48419},[],"/docs/pr-preview/pr-59/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3394":20,"_29710":15,"_5":30060,"_20617":48421,"_27008":48422,"_2880":48423},[],"/docs/pr-preview/pr-59/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3394":21,"_29710":15,"_5":30060,"_20617":48425,"_27008":48426,"_2880":48427},[],"/docs/pr-preview/pr-59/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3394":22,"_29710":15,"_5":30060,"_20617":48429,"_27008":48430,"_2880":48431},[],"/docs/pr-preview/pr-59/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3394":23,"_29710":15,"_5":30060,"_20617":48433,"_27008":48434,"_2880":48435},[],"/docs/pr-preview/pr-59/deployment/aws-marketplace#next-step","Next step",{"_3394":24,"_29710":15,"_20617":48437,"_5":14139,"_27008":15,"_2880":48438},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3394":25,"_29710":15,"_20617":48440,"_5":14139,"_27008":48410,"_2880":48441},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3394":26,"_29710":15,"_20617":48443,"_5":14139,"_27008":48410,"_2880":48444},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3394":27,"_29710":15,"_20617":48446,"_5":14139,"_27008":48410,"_2880":48447},[],"A security group allowing the necessary endpoints.",{"_3394":28,"_29710":15,"_20617":48449,"_5":14139,"_27008":48414,"_2880":48450},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3394":29,"_29710":15,"_20617":48452,"_5":14139,"_27008":48414,"_2880":48453},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3394":30,"_29710":15,"_20617":48455,"_5":14139,"_27008":48414,"_2880":48456},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3394":31,"_29710":15,"_20617":48458,"_5":14139,"_27008":48418,"_2880":48459},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3394":32,"_29710":15,"_20617":48461,"_5":14139,"_27008":48422,"_2880":48462},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3394":33,"_29710":15,"_20617":48464,"_5":14139,"_27008":48426,"_2880":48465},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3394":34,"_29710":15,"_20617":48467,"_5":14139,"_27008":48430,"_2880":48468},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3394":35,"_29710":15,"_20617":48470,"_5":14139,"_27008":48434,"_2880":48471},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3394":36,"_29710":36,"_5":14491,"_2880":48473,"_30063":48474,"_20617":48475,"_27008":36},"Deploy Lamassu",[48401,48402],[],{"_3394":37,"_29710":36,"_20617":48477,"_5":14139,"_27008":36,"_2880":48478},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3394":38,"_29710":36,"_5":30060,"_20617":48480,"_27008":48481,"_2880":48482},[],"/docs/pr-preview/pr-59/deployment/overview#choose-a-model","Choose a model",{"_3394":39,"_29710":36,"_5":30060,"_20617":48484,"_27008":48485,"_2880":48486},[],"/docs/pr-preview/pr-59/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3394":40,"_29710":36,"_5":30060,"_20617":48488,"_27008":48489,"_2880":48490},[],"/docs/pr-preview/pr-59/deployment/overview#after-deployment","After deployment",{"_3394":41,"_29710":36,"_20617":48492,"_5":14139,"_27008":36,"_2880":48493},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3394":42,"_29710":36,"_20617":48495,"_5":14139,"_27008":48481,"_2880":48496},[],"Model",{"_3394":43,"_29710":36,"_20617":48498,"_5":14139,"_27008":48481,"_2880":48499},[],"Recommended for",{"_3394":44,"_29710":36,"_20617":48501,"_5":14139,"_27008":48481,"_2880":48502},[],"Who operates the infrastructure",{"_3394":45,"_29710":36,"_20617":48504,"_5":14139,"_27008":48481,"_2880":48505},[],"Starting point",{"_3394":46,"_29710":36,"_20617":48507,"_5":14139,"_27008":48481,"_2880":48508},[],"Kubernetes self-managed",{"_3394":47,"_29710":36,"_20617":48510,"_5":14139,"_27008":48481,"_2880":48511},[],"Production, regulated environments and custom deployments",{"_3394":48,"_29710":36,"_20617":48513,"_5":14139,"_27008":48481,"_2880":48514},[],"Your team",{"_3394":49,"_29710":36,"_20617":48516,"_5":14139,"_27008":48481,"_2880":48517},[],"Helm or Fastlane",{"_3394":50,"_29710":36,"_20617":48519,"_5":14139,"_27008":48481,"_2880":48520},[],"AWS Marketplace",{"_3394":51,"_29710":36,"_20617":48522,"_5":14139,"_27008":48481,"_2880":48523},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3394":52,"_29710":36,"_20617":48525,"_5":14139,"_27008":48481,"_2880":48514},[],{"_3394":53,"_29710":36,"_20617":48527,"_5":14139,"_27008":48481,"_2880":48528},[],"Preconfigured image on EC2",{"_3394":54,"_29710":36,"_20617":48530,"_5":14139,"_27008":48481,"_2880":48531},[],"SaaS",{"_3394":55,"_29710":36,"_20617":48533,"_5":14139,"_27008":48481,"_2880":48534},[],"Teams that want to use the platform without operating it",{"_3394":56,"_29710":36,"_20617":48536,"_5":14139,"_27008":48481,"_2880":48537},[],"Lamassu",{"_3394":57,"_29710":36,"_20617":48539,"_5":14139,"_27008":48481,"_2880":48540},[],"Managed subscription",{"_3394":58,"_29710":36,"_20617":48542,"_5":14139,"_27008":48481,"_2880":48543},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3394":59,"_29710":36,"_20617":48545,"_5":14139,"_27008":48481,"_2880":48546},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3394":60,"_29710":36,"_20617":48548,"_5":14139,"_27008":48481,"_2880":48549},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3394":61,"_29710":36,"_20617":48551,"_5":14139,"_27008":48485,"_2880":48552},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3394":62,"_29710":36,"_20617":48554,"_5":14139,"_27008":48489,"_2880":48555},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3394":63,"_29710":63,"_5":14491,"_2880":48557,"_30063":48558,"_20617":48559,"_27008":63},"Use Lamassu as SaaS",[48401,48402,48403],[],{"_3394":64,"_29710":63,"_20617":48561,"_5":14139,"_27008":63,"_2880":48562},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3394":65,"_29710":63,"_5":30060,"_20617":48564,"_27008":48565,"_2880":48566},[],"/docs/pr-preview/pr-59/deployment/saas#what-the-service-manages","What the service manages",{"_3394":66,"_29710":63,"_5":30060,"_20617":48568,"_27008":48569,"_2880":48570},[],"/docs/pr-preview/pr-59/deployment/saas#plans","Plans",{"_3394":67,"_29710":63,"_5":30060,"_20617":48572,"_27008":48573,"_2880":48574},[],"/docs/pr-preview/pr-59/deployment/saas#request-access","Request access",{"_3394":68,"_29710":63,"_20617":48576,"_5":14139,"_27008":63,"_2880":48577},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3394":69,"_29710":63,"_20617":48579,"_5":14139,"_27008":48565,"_2880":48580},[],"Platform availability and maintenance.",{"_3394":70,"_29710":63,"_20617":48582,"_5":14139,"_27008":48565,"_2880":48583},[],"Automatic backups.",{"_3394":71,"_29710":63,"_20617":48585,"_5":14139,"_27008":48565,"_2880":48586},[],"Version upgrades.",{"_3394":72,"_29710":63,"_20617":48588,"_5":14139,"_27008":48565,"_2880":48589},[],"Technical support and SLA according to your plan.",{"_3394":73,"_29710":63,"_20617":48591,"_5":14139,"_27008":48569,"_2880":48592},[],"Plan",{"_3394":74,"_29710":63,"_20617":48594,"_5":14139,"_27008":48569,"_2880":48595},[],"Devices",{"_3394":75,"_29710":63,"_20617":48597,"_5":14139,"_27008":48569,"_2880":48598},[],"Support",{"_3394":76,"_29710":63,"_20617":48600,"_5":14139,"_27008":48569,"_2880":48601},[],"SLA",{"_3394":77,"_29710":63,"_20617":48603,"_5":14139,"_27008":48569,"_2880":48604},[],"Starter",{"_3394":78,"_29710":63,"_20617":48606,"_5":14139,"_27008":48569,"_2880":48607},[],"Up to 1,000",{"_3394":79,"_29710":63,"_20617":48609,"_5":14139,"_27008":48569,"_2880":48610},[],"Email",{"_3394":80,"_29710":63,"_20617":48612,"_5":14139,"_27008":48569,"_2880":48613},[],"99.5 %",{"_3394":81,"_29710":63,"_20617":48615,"_5":14139,"_27008":48569,"_2880":48616},[],"Professional",{"_3394":82,"_29710":63,"_20617":48618,"_5":14139,"_27008":48569,"_2880":48619},[],"Up to 10,000",{"_3394":83,"_29710":63,"_20617":48621,"_5":14139,"_27008":48569,"_2880":48622},[],"Email and chat",{"_3394":84,"_29710":63,"_20617":48624,"_5":14139,"_27008":48569,"_2880":48625},[],"99.9 %",{"_3394":85,"_29710":63,"_20617":48627,"_5":14139,"_27008":48569,"_2880":48628},[],"Enterprise",{"_3394":86,"_29710":63,"_20617":48630,"_5":14139,"_27008":48569,"_2880":48631},[],"Unlimited",{"_3394":87,"_29710":63,"_20617":48633,"_5":14139,"_27008":48569,"_2880":48634},[],"Dedicated",{"_3394":88,"_29710":63,"_20617":48636,"_5":14139,"_27008":48569,"_2880":48637},[],"99.99 %",{"_3394":89,"_29710":63,"_20617":48639,"_5":14139,"_27008":48573,"_2880":48640},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3394":90,"_29710":63,"_20617":48642,"_5":14139,"_27008":48573,"_2880":48643},[],"When you receive your instance's credentials, continue with Get started.",{"_3394":91,"_29710":91,"_5":14491,"_2880":48645,"_30063":48646,"_20617":48647,"_27008":91},"Fastlane",[48401,48402,48508],[],{"_3394":92,"_29710":91,"_20617":48649,"_5":14139,"_27008":91,"_2880":48650},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3394":93,"_29710":91,"_5":30060,"_20617":48652,"_27008":48653,"_2880":48654},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3394":94,"_29710":91,"_5":30060,"_20617":48656,"_27008":48657,"_2880":48658},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3394":95,"_29710":91,"_5":30060,"_20617":48660,"_27008":48661,"_2880":48411},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#before-you-begin",{"_3394":96,"_29710":91,"_5":30060,"_20617":48663,"_27008":48664,"_2880":48665},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3394":97,"_29710":91,"_5":30060,"_20617":48667,"_27008":48668,"_2880":48669},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3394":98,"_29710":91,"_5":30060,"_20617":48671,"_27008":48672,"_2880":48673},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3394":99,"_29710":91,"_5":30060,"_20617":48675,"_27008":48676,"_2880":48677},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3394":100,"_29710":91,"_5":30060,"_20617":48679,"_27008":48680,"_2880":48681},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3394":101,"_29710":91,"_5":30060,"_20617":48683,"_27008":48684,"_2880":48685},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3394":102,"_29710":91,"_5":30060,"_20617":48687,"_27008":48688,"_2880":48689},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3394":103,"_29710":91,"_5":30060,"_20617":48691,"_27008":48692,"_2880":48693},[],"/docs/pr-preview/pr-59/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3394":104,"_29710":91,"_20617":48695,"_5":14139,"_27008":48653,"_2880":48696},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3394":105,"_29710":91,"_20617":48698,"_5":14139,"_27008":48653,"_2880":48699},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3394":106,"_29710":91,"_20617":48701,"_5":14139,"_27008":48657,"_2880":48702},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3394":107,"_29710":91,"_20617":48704,"_5":14139,"_27008":48657,"_2880":48705},[],"Fastlane installs or configures",{"_3394":108,"_29710":91,"_20617":48707,"_5":14139,"_27008":48657,"_2880":48708},[],"You still provide",{"_3394":109,"_29710":91,"_20617":48710,"_5":14139,"_27008":48657,"_2880":48711},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3394":110,"_29710":91,"_20617":48713,"_5":14139,"_27008":48657,"_2880":48714},[],"The Kubernetes cluster, nodes and persistent storage",{"_3394":111,"_29710":91,"_20617":48716,"_5":14139,"_27008":48657,"_2880":48717},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3394":112,"_29710":91,"_20617":48719,"_5":14139,"_27008":48657,"_2880":48720},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3394":113,"_29710":91,"_20617":48722,"_5":14139,"_27008":48657,"_2880":48723},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3394":114,"_29710":91,"_20617":48725,"_5":14139,"_27008":48657,"_2880":48726},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3394":115,"_29710":91,"_20617":48728,"_5":14139,"_27008":48657,"_2880":48729},[],"Optional observability and lab HSM components",{"_3394":116,"_29710":91,"_20617":48731,"_5":14139,"_27008":48657,"_2880":48732},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3394":117,"_29710":91,"_20617":48734,"_5":14139,"_27008":48657,"_2880":48735},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3394":118,"_29710":91,"_20617":48737,"_5":14139,"_27008":48661,"_2880":48738},[],"You need:",{"_3394":119,"_29710":91,"_20617":48740,"_5":14139,"_27008":48661,"_2880":48741},[],"an existing Kubernetes cluster",{"_3394":120,"_29710":91,"_20617":48743,"_5":14139,"_27008":48661,"_2880":48744},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3394":121,"_29710":91,"_20617":48746,"_5":14139,"_27008":48661,"_2880":48747},[],"`yq`",{"_3394":122,"_29710":91,"_20617":48749,"_5":14139,"_27008":48661,"_2880":23295},[],{"_3394":123,"_29710":91,"_20617":48751,"_5":14139,"_27008":48661,"_2880":48752},[],"`jq` only when using `--sample-data` or `--development`",{"_3394":124,"_29710":91,"_20617":48754,"_5":14139,"_27008":48661,"_2880":48755},[],"`ssh-keygen` only when using `--with-hsm`",{"_3394":125,"_29710":91,"_20617":48757,"_5":14139,"_27008":48661,"_2880":48758},[],"free external ports 80 and 443 on a single-node K3s host",{"_3394":126,"_29710":91,"_20617":48760,"_5":14139,"_27008":48661,"_2880":48761},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3394":127,"_29710":91,"_20617":48763,"_5":14139,"_27008":48661,"_2880":48764},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3394":128,"_29710":91,"_20617":48766,"_5":14139,"_27008":48664,"_2880":48767},[],"Run the script from a clone of the Helm repository:",{"_3394":129,"_29710":91,"_20617":48769,"_5":14139,"_27008":48664,"_2880":48770},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3394":130,"_29710":91,"_20617":48772,"_5":14139,"_27008":48668,"_2880":48773},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3394":131,"_29710":91,"_20617":48775,"_5":14139,"_27008":48668,"_2880":48776},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3394":132,"_29710":91,"_20617":48778,"_5":14139,"_27008":48668,"_2880":48779},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3394":133,"_29710":91,"_20617":48781,"_5":14139,"_27008":48668,"_2880":48782},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3394":134,"_29710":91,"_20617":48784,"_5":14139,"_27008":48672,"_2880":48785},[],"Option",{"_3394":135,"_29710":91,"_20617":48787,"_5":14139,"_27008":48672,"_2880":48788},[],"Default",{"_3394":136,"_29710":91,"_20617":48790,"_5":14139,"_27008":48672,"_2880":48791},[],"Purpose",{"_3394":137,"_29710":91,"_20617":48793,"_5":14139,"_27008":48672,"_2880":48794},[],"`-h`, `--help`",{"_3394":138,"_29710":91,"_20617":48796,"_5":14139,"_27008":48672,"_2880":48797},[],"—",{"_3394":139,"_29710":91,"_20617":48799,"_5":14139,"_27008":48672,"_2880":48800},[],"Show help",{"_3394":140,"_29710":91,"_20617":48802,"_5":14139,"_27008":48672,"_2880":48803},[],"`-c`, `--context`",{"_3394":141,"_29710":91,"_20617":48805,"_5":14139,"_27008":48672,"_2880":48806},[],"current context",{"_3394":142,"_29710":91,"_20617":48808,"_5":14139,"_27008":48672,"_2880":48809},[],"Select the kubeconfig context for kubectl and Helm",{"_3394":143,"_29710":91,"_20617":48811,"_5":14139,"_27008":48672,"_2880":48812},[],"`-n`, `--non-interactive`",{"_3394":144,"_29710":91,"_20617":48814,"_5":14139,"_27008":48672,"_2880":6425},[],{"_3394":145,"_29710":91,"_20617":48816,"_5":14139,"_27008":48672,"_2880":48817},[],"Skip prompts and generate dependency credentials",{"_3394":146,"_29710":91,"_20617":48819,"_5":14139,"_27008":48672,"_2880":48820},[],"`-ns`, `--namespace`",{"_3394":147,"_29710":91,"_20617":48822,"_5":14139,"_27008":48672,"_2880":48823},[],"`lamassu-dev`",{"_3394":148,"_29710":91,"_20617":48825,"_5":14139,"_27008":48672,"_2880":48826},[],"Namespace for the installation",{"_3394":149,"_29710":91,"_20617":48828,"_5":14139,"_27008":48672,"_2880":48829},[],"`-d`, `--domain`",{"_3394":150,"_29710":91,"_20617":48831,"_5":14139,"_27008":48672,"_2880":48832},[],"`dev.lamassu.io`",{"_3394":151,"_29710":91,"_20617":48834,"_5":14139,"_27008":48672,"_2880":48835},[],"Domain used by the UI, OIDC and certificate",{"_3394":152,"_29710":91,"_20617":48837,"_5":14139,"_27008":48672,"_2880":48838},[],"`-v`, `--version`",{"_3394":153,"_29710":91,"_20617":48840,"_5":14139,"_27008":48672,"_2880":14825},[],{"_3394":154,"_29710":91,"_20617":48842,"_5":14139,"_27008":48672,"_2880":48843},[],"Lamassu chart version",{"_3394":155,"_29710":91,"_20617":48845,"_5":14139,"_27008":48672,"_2880":48846},[],"`--https-port`",{"_3394":156,"_29710":91,"_20617":48848,"_5":14139,"_27008":48672,"_2880":48849},[],"`443`",{"_3394":157,"_29710":91,"_20617":48851,"_5":14139,"_27008":48672,"_2880":48852},[],"Gateway HTTPS listener port",{"_3394":158,"_29710":91,"_20617":48854,"_5":14139,"_27008":48672,"_2880":48855},[],"`--http-port`",{"_3394":159,"_29710":91,"_20617":48857,"_5":14139,"_27008":48672,"_2880":48858},[],"`80`",{"_3394":160,"_29710":91,"_20617":48860,"_5":14139,"_27008":48672,"_2880":48861},[],"Gateway HTTP listener port",{"_3394":161,"_29710":91,"_20617":48863,"_5":14139,"_27008":48672,"_2880":48864},[],"`--tls-crt`",{"_3394":162,"_29710":91,"_20617":48866,"_5":14139,"_27008":48672,"_2880":48797},[],{"_3394":163,"_29710":91,"_20617":48868,"_5":14139,"_27008":48672,"_2880":48869},[],"PEM certificate for downstream TLS",{"_3394":164,"_29710":91,"_20617":48871,"_5":14139,"_27008":48672,"_2880":48872},[],"`--tls-key`",{"_3394":165,"_29710":91,"_20617":48874,"_5":14139,"_27008":48672,"_2880":48797},[],{"_3394":166,"_29710":91,"_20617":48876,"_5":14139,"_27008":48672,"_2880":48877},[],"PEM private key for downstream TLS",{"_3394":167,"_29710":91,"_20617":48879,"_5":14139,"_27008":48672,"_2880":48880},[],"`-l`, `--local-chart-path`",{"_3394":168,"_29710":91,"_20617":48882,"_5":14139,"_27008":48672,"_2880":48883},[],"repository chart",{"_3394":169,"_29710":91,"_20617":48885,"_5":14139,"_27008":48672,"_2880":48886},[],"Use an unpacked local Lamassu chart",{"_3394":170,"_29710":91,"_20617":48888,"_5":14139,"_27008":48672,"_2880":48889},[],"`-ip`, `--gateway-ip`",{"_3394":171,"_29710":91,"_20617":48891,"_5":14139,"_27008":48672,"_2880":8596},[],{"_3394":172,"_29710":91,"_20617":48893,"_5":14139,"_27008":48672,"_2880":48894},[],"Override the address written to `gateway.addresses`",{"_3394":173,"_29710":91,"_20617":48896,"_5":14139,"_27008":48672,"_2880":48897},[],"`--otel`",{"_3394":174,"_29710":91,"_20617":48899,"_5":14139,"_27008":48672,"_2880":6425},[],{"_3394":175,"_29710":91,"_20617":48901,"_5":14139,"_27008":48672,"_2880":48902},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3394":176,"_29710":91,"_20617":48904,"_5":14139,"_27008":48672,"_2880":48905},[],"`--development`",{"_3394":177,"_29710":91,"_20617":48907,"_5":14139,"_27008":48672,"_2880":6425},[],{"_3394":178,"_29710":91,"_20617":48909,"_5":14139,"_27008":48672,"_2880":48910},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3394":179,"_29710":91,"_20617":48912,"_5":14139,"_27008":48672,"_2880":48913},[],"`--sample-data`",{"_3394":180,"_29710":91,"_20617":48915,"_5":14139,"_27008":48672,"_2880":6425},[],{"_3394":181,"_29710":91,"_20617":48917,"_5":14139,"_27008":48672,"_2880":48918},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3394":182,"_29710":91,"_20617":48920,"_5":14139,"_27008":48672,"_2880":48921},[],"`--with-hsm`",{"_3394":183,"_29710":91,"_20617":48923,"_5":14139,"_27008":48672,"_2880":6425},[],{"_3394":184,"_29710":91,"_20617":48925,"_5":14139,"_27008":48672,"_2880":48926},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3394":185,"_29710":91,"_20617":48928,"_5":14139,"_27008":48672,"_2880":48929},[],"`--softhsm-chart-path`",{"_3394":186,"_29710":91,"_20617":48931,"_5":14139,"_27008":48672,"_2880":48932},[],"`./charts/softhsm`",{"_3394":187,"_29710":91,"_20617":48934,"_5":14139,"_27008":48672,"_2880":48935},[],"Use a different local SoftHSM chart",{"_3394":188,"_29710":91,"_20617":48937,"_5":14139,"_27008":48672,"_2880":48938},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3394":189,"_29710":91,"_20617":48940,"_5":14139,"_27008":48676,"_2880":48941},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3394":190,"_29710":91,"_20617":48943,"_5":14139,"_27008":48676,"_2880":48944},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3394":191,"_29710":91,"_20617":48946,"_5":14139,"_27008":48676,"_2880":48947},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3394":192,"_29710":91,"_20617":48949,"_5":14139,"_27008":48676,"_2880":48950},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3394":193,"_29710":91,"_20617":48952,"_5":14139,"_27008":48676,"_2880":48953},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3394":194,"_29710":91,"_20617":48955,"_5":14139,"_27008":48676,"_2880":48956},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3394":195,"_29710":91,"_20617":48958,"_5":14139,"_27008":48680,"_2880":48959},[],"Fastlane:",{"_3394":196,"_29710":91,"_20617":48961,"_5":14139,"_27008":48680,"_2880":48962},[],"validates local tools and the selected cluster",{"_3394":197,"_29710":91,"_20617":48964,"_5":14139,"_27008":48680,"_2880":48965},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3394":198,"_29710":91,"_20617":48967,"_5":14139,"_27008":48680,"_2880":48968},[],"creates the namespace",{"_3394":199,"_29710":91,"_20617":48970,"_5":14139,"_27008":48680,"_2880":48971},[],"installs PostgreSQL and creates the required databases",{"_3394":200,"_29710":91,"_20617":48973,"_5":14139,"_27008":48680,"_2880":48974},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3394":201,"_29710":91,"_20617":48976,"_5":14139,"_27008":48680,"_2880":48977},[],"installs RabbitMQ",{"_3394":202,"_29710":91,"_20617":48979,"_5":14139,"_27008":48680,"_2880":48980},[],"optionally installs observability and lab HSM components",{"_3394":203,"_29710":91,"_20617":48982,"_5":14139,"_27008":48680,"_2880":48983},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3394":204,"_29710":91,"_20617":48985,"_5":14139,"_27008":48680,"_2880":48986},[],"optionally loads sample data",{"_3394":205,"_29710":91,"_20617":48988,"_5":14139,"_27008":48680,"_2880":48989},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3394":206,"_29710":91,"_20617":48991,"_5":14139,"_27008":48684,"_2880":48992},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3394":207,"_29710":91,"_20617":48994,"_5":14139,"_27008":48684,"_2880":48995},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3394":208,"_29710":91,"_20617":48997,"_5":14139,"_27008":48688,"_2880":48998},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3394":209,"_29710":91,"_20617":49000,"_5":14139,"_27008":48688,"_2880":49001},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3394":210,"_29710":91,"_20617":49003,"_5":14139,"_27008":48688,"_2880":49004},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3394":211,"_29710":91,"_20617":49006,"_5":14139,"_27008":48692,"_2880":49007},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3394":212,"_29710":212,"_5":14491,"_2880":49009,"_30063":49010,"_20617":49011,"_27008":212},"Install with Helm",[48401,48402,48508],[],{"_3394":213,"_29710":212,"_20617":49013,"_5":14139,"_27008":212,"_2880":49014},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3394":214,"_29710":212,"_5":30060,"_20617":49016,"_27008":49017,"_2880":49018},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3394":215,"_29710":212,"_5":30060,"_20617":49020,"_27008":49021,"_2880":48411},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#before-you-begin",{"_3394":216,"_29710":212,"_5":30060,"_20617":49023,"_27008":49024,"_2880":49025},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3394":217,"_29710":212,"_5":30060,"_20617":49027,"_27008":49028,"_2880":49029},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3394":218,"_29710":212,"_5":30060,"_20617":49031,"_27008":49032,"_2880":49033},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3394":219,"_29710":212,"_5":30060,"_20617":49035,"_27008":49036,"_2880":49037},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3394":220,"_29710":212,"_5":30060,"_20617":49039,"_27008":49040,"_2880":49041},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3394":221,"_29710":212,"_5":30060,"_20617":49043,"_27008":49044,"_2880":49045},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3394":222,"_29710":212,"_5":30060,"_20617":49047,"_27008":49048,"_2880":49049},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3394":223,"_29710":212,"_5":30060,"_20617":49051,"_27008":49052,"_2880":49053},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3394":224,"_29710":212,"_5":30060,"_20617":49055,"_27008":49056,"_2880":49057},[],"/docs/pr-preview/pr-59/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3394":225,"_29710":212,"_20617":49059,"_5":14139,"_27008":49017,"_2880":49060},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3394":226,"_29710":212,"_20617":49062,"_5":14139,"_27008":49021,"_2880":49063},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3394":227,"_29710":212,"_20617":49065,"_5":14139,"_27008":49021,"_2880":49066},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3394":228,"_29710":212,"_20617":49068,"_5":14139,"_27008":49021,"_2880":49069},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3394":229,"_29710":212,"_20617":49071,"_5":14139,"_27008":49021,"_2880":49072},[],"a reachable RabbitMQ broker and credentials",{"_3394":230,"_29710":212,"_20617":49074,"_5":14139,"_27008":49021,"_2880":49075},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3394":231,"_29710":212,"_20617":49077,"_5":14139,"_27008":49021,"_2880":49078},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3394":232,"_29710":212,"_20617":49080,"_5":14139,"_27008":49021,"_2880":49081},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3394":233,"_29710":212,"_20617":49083,"_5":14139,"_27008":49021,"_2880":49084},[],"a StorageClass and an external traffic design",{"_3394":234,"_29710":212,"_20617":49086,"_5":14139,"_27008":49021,"_2880":49087},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3394":235,"_29710":212,"_20617":49089,"_5":14139,"_27008":49021,"_2880":49090},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3394":236,"_29710":212,"_20617":49092,"_5":14139,"_27008":49021,"_2880":49093},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3394":237,"_29710":212,"_20617":49095,"_5":14139,"_27008":49024,"_2880":49096},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3394":238,"_29710":212,"_20617":49098,"_5":14139,"_27008":49024,"_2880":49099},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3394":239,"_29710":212,"_20617":49101,"_5":14139,"_27008":49024,"_2880":49102},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3394":240,"_29710":212,"_20617":49104,"_5":14139,"_27008":49028,"_2880":49105},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3394":241,"_29710":212,"_20617":49107,"_5":14139,"_27008":49028,"_2880":49108},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3394":242,"_29710":212,"_20617":49110,"_5":14139,"_27008":49028,"_2880":49111},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3394":243,"_29710":212,"_20617":49113,"_5":14139,"_27008":49028,"_2880":49114},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3394":244,"_29710":212,"_20617":49116,"_5":14139,"_27008":49032,"_2880":49117},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3394":245,"_29710":212,"_20617":49119,"_5":14139,"_27008":49036,"_2880":49120},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3394":246,"_29710":212,"_20617":49122,"_5":14139,"_27008":49036,"_2880":49123},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3394":247,"_29710":212,"_20617":49125,"_5":14139,"_27008":49036,"_2880":49126},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3394":248,"_29710":212,"_20617":49128,"_5":14139,"_27008":49036,"_2880":49129},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3394":249,"_29710":212,"_20617":49131,"_5":14139,"_27008":49036,"_2880":49132},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3394":250,"_29710":212,"_20617":49134,"_5":14139,"_27008":49036,"_2880":49135},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3394":251,"_29710":212,"_20617":49137,"_5":14139,"_27008":49036,"_2880":49138},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3394":252,"_29710":212,"_20617":49140,"_5":14139,"_27008":49040,"_2880":49141},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3394":253,"_29710":212,"_20617":49143,"_5":14139,"_27008":49040,"_2880":49144},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3394":254,"_29710":212,"_20617":49146,"_5":14139,"_27008":49040,"_2880":49147},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3394":255,"_29710":212,"_20617":49149,"_5":14139,"_27008":49040,"_2880":49150},[],"See Access control for the principal and policy model.",{"_3394":256,"_29710":212,"_20617":49152,"_5":14139,"_27008":49044,"_2880":49153},[],"To install a local checkout instead:",{"_3394":257,"_29710":212,"_20617":49155,"_5":14139,"_27008":49048,"_2880":49156},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3394":258,"_29710":212,"_20617":49158,"_5":14139,"_27008":49048,"_2880":49159},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3394":259,"_29710":212,"_20617":49161,"_5":14139,"_27008":49052,"_2880":49162},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3394":260,"_29710":212,"_20617":49164,"_5":14139,"_27008":49052,"_2880":49165},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3394":261,"_29710":212,"_20617":49167,"_5":14139,"_27008":49052,"_2880":49168},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3394":262,"_29710":212,"_20617":49170,"_5":14139,"_27008":49052,"_2880":49171},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3394":263,"_29710":212,"_20617":49173,"_5":14139,"_27008":49052,"_2880":49174},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3394":264,"_29710":212,"_20617":49176,"_5":14139,"_27008":49056,"_2880":49177},[],"Before going live, review:",{"_3394":265,"_29710":212,"_20617":49179,"_5":14139,"_27008":49056,"_2880":49180},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3394":266,"_29710":212,"_20617":49182,"_5":14139,"_27008":49056,"_2880":49183},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3394":267,"_29710":212,"_20617":49185,"_5":14139,"_27008":49056,"_2880":49186},[],"shared VA storage before increasing VA replicas",{"_3394":268,"_29710":212,"_20617":49188,"_5":14139,"_27008":49056,"_2880":49189},[],"managed OIDC roles and removal of evaluation credentials",{"_3394":269,"_29710":212,"_20617":49191,"_5":14139,"_27008":49056,"_2880":49192},[],"a trusted TLS issuer or externally managed certificate",{"_3394":270,"_29710":212,"_20617":49194,"_5":14139,"_27008":49056,"_2880":49195},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3394":271,"_29710":212,"_20617":49197,"_5":14139,"_27008":49056,"_2880":49198},[],"SMTP, observability and alert delivery",{"_3394":272,"_29710":212,"_20617":49200,"_5":14139,"_27008":49056,"_2880":49201},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3394":273,"_29710":212,"_20617":49203,"_5":14139,"_27008":49056,"_2880":49204},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3394":274,"_29710":274,"_5":14491,"_2880":49206,"_30063":49207,"_20617":49208,"_27008":274},"Expose the Gateway",[48401,48402,48508],[],{"_3394":275,"_29710":274,"_20617":49210,"_5":14139,"_27008":274,"_2880":49211},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3394":276,"_29710":274,"_5":30060,"_20617":49213,"_27008":49214,"_2880":49215},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3394":277,"_29710":274,"_5":30060,"_20617":49217,"_27008":49218,"_2880":49219},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3394":278,"_29710":274,"_5":30060,"_20617":49221,"_27008":49222,"_2880":49223},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3394":279,"_29710":274,"_5":30060,"_20617":49225,"_27008":49226,"_2880":49227},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#k3s","K3s",{"_3394":280,"_29710":274,"_5":30060,"_20617":49229,"_27008":49230,"_2880":49231},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3394":281,"_29710":274,"_5":30060,"_20617":49233,"_27008":49234,"_2880":49235},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3394":282,"_29710":274,"_5":30060,"_20617":49237,"_27008":49238,"_2880":49239},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3394":283,"_29710":274,"_5":30060,"_20617":49241,"_27008":49242,"_2880":49243},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3394":284,"_29710":274,"_5":30060,"_20617":49245,"_27008":49246,"_2880":49247},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3394":285,"_29710":274,"_5":30060,"_20617":49249,"_27008":49250,"_2880":49251},[],"/docs/pr-preview/pr-59/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3394":286,"_29710":274,"_20617":49253,"_5":14139,"_27008":49214,"_2880":49254},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3394":287,"_29710":274,"_20617":49256,"_5":14139,"_27008":49214,"_2880":49257},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3394":288,"_29710":274,"_20617":49259,"_5":14139,"_27008":49218,"_2880":49260},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3394":289,"_29710":274,"_20617":49262,"_5":14139,"_27008":49218,"_2880":49263},[],"Set it only when:",{"_3394":290,"_29710":274,"_20617":49265,"_5":14139,"_27008":49218,"_2880":49266},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3394":291,"_29710":274,"_20617":49268,"_5":14139,"_27008":49218,"_2880":49269},[],"that address is allocated to this Gateway",{"_3394":292,"_29710":274,"_20617":49271,"_5":14139,"_27008":49218,"_2880":49272},[],"the surrounding network already routes traffic for it to the cluster",{"_3394":293,"_29710":274,"_20617":49274,"_5":14139,"_27008":49218,"_2880":49275},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3394":294,"_29710":274,"_20617":49277,"_5":14139,"_27008":49218,"_2880":49278},[],"Keep these two settings separate:",{"_3394":295,"_29710":274,"_20617":49280,"_5":14139,"_27008":49218,"_2880":49281},[],"`gateway.addresses` requests an address for the Gateway.",{"_3394":296,"_29710":274,"_20617":49283,"_5":14139,"_27008":49218,"_2880":49284},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3394":297,"_29710":274,"_20617":49286,"_5":14139,"_27008":49218,"_2880":49287},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3394":298,"_29710":274,"_20617":49289,"_5":14139,"_27008":49222,"_2880":49290},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3394":299,"_29710":274,"_20617":49292,"_5":14139,"_27008":49222,"_2880":49293},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3394":300,"_29710":274,"_20617":49295,"_5":14139,"_27008":49226,"_2880":49296},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3394":301,"_29710":274,"_20617":49298,"_5":14139,"_27008":49226,"_2880":49299},[],"For the recommended design:",{"_3394":302,"_29710":274,"_20617":49301,"_5":14139,"_27008":49226,"_2880":49302},[],"Use only one externally exposed Lamassu Gateway.",{"_3394":303,"_29710":274,"_20617":49304,"_5":14139,"_27008":49226,"_2880":49305},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3394":304,"_29710":274,"_20617":49307,"_5":14139,"_27008":49226,"_2880":49308},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3394":305,"_29710":274,"_20617":49310,"_5":14139,"_27008":49226,"_2880":49311},[],"Point DNS at the VM's reachable address.",{"_3394":306,"_29710":274,"_20617":49313,"_5":14139,"_27008":49226,"_2880":49314},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3394":307,"_29710":274,"_20617":49316,"_5":14139,"_27008":49230,"_2880":49317},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3394":308,"_29710":274,"_20617":49319,"_5":14139,"_27008":49234,"_2880":49320},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3394":309,"_29710":274,"_20617":49322,"_5":14139,"_27008":49234,"_2880":49323},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3394":310,"_29710":274,"_20617":49325,"_5":14139,"_27008":49238,"_2880":49326},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3394":311,"_29710":274,"_20617":49328,"_5":14139,"_27008":49238,"_2880":49329},[],"Requirement",{"_3394":312,"_29710":274,"_20617":49331,"_5":14139,"_27008":49238,"_2880":49332},[],"Recommended design",{"_3394":313,"_29710":274,"_20617":49334,"_5":14139,"_27008":49238,"_2880":49335},[],"Consequence",{"_3394":314,"_29710":274,"_20617":49337,"_5":14139,"_27008":49238,"_2880":49338},[],"Several Lamassu URLs or services",{"_3394":315,"_29710":274,"_20617":49340,"_5":14139,"_27008":49238,"_2880":49341},[],"One Gateway with multiple routes",{"_3394":316,"_29710":274,"_20617":49343,"_5":14139,"_27008":49238,"_2880":49344},[],"One IP and one proxy fleet; this is the chart default",{"_3394":317,"_29710":274,"_20617":49346,"_5":14139,"_27008":49238,"_2880":49347},[],"Independent Gateways and separate external IPs",{"_3394":318,"_29710":274,"_20617":49349,"_5":14139,"_27008":49238,"_2880":49350},[],"One VIP per Gateway",{"_3394":319,"_29710":274,"_20617":49352,"_5":14139,"_27008":49238,"_2880":49353},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3394":320,"_29710":274,"_20617":49355,"_5":14139,"_27008":49238,"_2880":49356},[],"Independent Gateways on one node and one IP",{"_3394":321,"_29710":274,"_20617":49358,"_5":14139,"_27008":49238,"_2880":49359},[],"Use different external ports",{"_3394":322,"_29710":274,"_20617":49361,"_5":14139,"_27008":49238,"_2880":49362},[],"Clients must include non-standard ports",{"_3394":323,"_29710":274,"_20617":49364,"_5":14139,"_27008":49238,"_2880":49365},[],"Separate TLS/mTLS termination behind one IP",{"_3394":324,"_29710":274,"_20617":49367,"_5":14139,"_27008":49238,"_2880":49368},[],"Front-door SNI routing to internal Gateways",{"_3394":325,"_29710":274,"_20617":49370,"_5":14139,"_27008":49238,"_2880":49371},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3394":326,"_29710":274,"_20617":49373,"_5":14139,"_27008":49238,"_2880":49374},[],"Separate Gateway resources but shared proxy infrastructure",{"_3394":327,"_29710":274,"_20617":49376,"_5":14139,"_27008":49238,"_2880":49377},[],"Envoy merged-Gateway mode",{"_3394":328,"_29710":274,"_20617":49379,"_5":14139,"_27008":49238,"_2880":49380},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3394":329,"_29710":274,"_20617":49382,"_5":14139,"_27008":49238,"_2880":49383},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3394":330,"_29710":274,"_20617":49385,"_5":14139,"_27008":49238,"_2880":49386},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3394":331,"_29710":274,"_20617":49388,"_5":14139,"_27008":49238,"_2880":49389},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3394":332,"_29710":274,"_20617":49391,"_5":14139,"_27008":49238,"_2880":49392},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3394":333,"_29710":274,"_20617":49394,"_5":14139,"_27008":49242,"_2880":49395},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3394":334,"_29710":274,"_20617":49397,"_5":14139,"_27008":49242,"_2880":49398},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3394":335,"_29710":274,"_20617":49400,"_5":14139,"_27008":49242,"_2880":49401},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3394":336,"_29710":274,"_20617":49403,"_5":14139,"_27008":49242,"_2880":49404},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3394":337,"_29710":274,"_20617":49406,"_5":14139,"_27008":49242,"_2880":49407},[],"If none of those are possible, use different external ports or change the external network design.",{"_3394":338,"_29710":274,"_20617":49409,"_5":14139,"_27008":49246,"_2880":49410},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3394":339,"_29710":274,"_20617":49412,"_5":14139,"_27008":49246,"_2880":49413},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3394":340,"_29710":274,"_20617":49415,"_5":14139,"_27008":49250,"_2880":49416},[],"Check, in order:",{"_3394":341,"_29710":274,"_20617":49418,"_5":14139,"_27008":49250,"_2880":49419},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3394":342,"_29710":274,"_20617":49421,"_5":14139,"_27008":49250,"_2880":49422},[],"Its status contains the expected address.",{"_3394":343,"_29710":274,"_20617":49424,"_5":14139,"_27008":49250,"_2880":49425},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3394":344,"_29710":274,"_20617":49427,"_5":14139,"_27008":49250,"_2880":49428},[],"Port 443 reaches that address from the client network.",{"_3394":345,"_29710":274,"_20617":49430,"_5":14139,"_27008":49250,"_2880":49431},[],"DNS resolves to the externally reachable endpoint.",{"_3394":346,"_29710":274,"_20617":49433,"_5":14139,"_27008":49250,"_2880":49434},[],"The certificate contains the DNS name or IP used by the client.",{"_3394":347,"_29710":274,"_20617":49436,"_5":14139,"_27008":49250,"_2880":49437},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3394":348,"_29710":348,"_5":14491,"_2880":48508,"_30063":49439,"_20617":49440,"_27008":348},[48401,48402,48508],[],{"_3394":349,"_29710":348,"_20617":49442,"_5":14139,"_27008":348,"_2880":49443},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3394":350,"_29710":348,"_5":30060,"_20617":49445,"_27008":49446,"_2880":49447},[],"/docs/pr-preview/pr-59/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3394":351,"_29710":348,"_5":30060,"_20617":49449,"_27008":49450,"_2880":49451},[],"/docs/pr-preview/pr-59/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3394":352,"_29710":348,"_5":30060,"_20617":49453,"_27008":49454,"_2880":49455},[],"/docs/pr-preview/pr-59/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3394":353,"_29710":348,"_5":30060,"_20617":49457,"_27008":49458,"_2880":49459},[],"/docs/pr-preview/pr-59/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3394":354,"_29710":348,"_5":30060,"_20617":49461,"_27008":49462,"_2880":49463},[],"/docs/pr-preview/pr-59/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3394":355,"_29710":348,"_5":30060,"_20617":49465,"_27008":49466,"_2880":49467},[],"/docs/pr-preview/pr-59/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3394":356,"_29710":348,"_20617":49469,"_5":14139,"_27008":49446,"_2880":49470},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3394":357,"_29710":348,"_20617":49472,"_5":14139,"_27008":49450,"_2880":49473},[],"Workflow",{"_3394":358,"_29710":348,"_20617":49475,"_5":14139,"_27008":49450,"_2880":49476},[],"Use it for",{"_3394":359,"_29710":348,"_20617":49478,"_5":14139,"_27008":49450,"_2880":49479},[],"What it installs",{"_3394":360,"_29710":348,"_20617":49481,"_5":14139,"_27008":49450,"_2880":49482},[],"Helm",{"_3394":361,"_29710":348,"_20617":49484,"_5":14139,"_27008":49450,"_2880":49485},[],"Production and controlled environments",{"_3394":362,"_29710":348,"_20617":49487,"_5":14139,"_27008":49450,"_2880":49488},[],"Lamassu services and Gateway API resources",{"_3394":363,"_29710":348,"_20617":49490,"_5":14139,"_27008":49450,"_2880":48645},[],{"_3394":364,"_29710":348,"_20617":49492,"_5":14139,"_27008":49450,"_2880":49493},[],"Evaluation, demos, CI and small lab clusters",{"_3394":365,"_29710":348,"_20617":49495,"_5":14139,"_27008":49450,"_2880":49496},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3394":366,"_29710":348,"_20617":49498,"_5":14139,"_27008":49454,"_2880":49499},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3394":367,"_29710":348,"_20617":49501,"_5":14139,"_27008":49454,"_2880":49502},[],"Area",{"_3394":368,"_29710":348,"_20617":49504,"_5":14139,"_27008":49454,"_2880":49505},[],"The Lamassu chart provides",{"_3394":369,"_29710":348,"_20617":49507,"_5":14139,"_27008":49454,"_2880":49508},[],"You provide",{"_3394":370,"_29710":348,"_20617":49510,"_5":14139,"_27008":49454,"_2880":49511},[],"Lamassu applications",{"_3394":371,"_29710":348,"_20617":49513,"_5":14139,"_27008":49454,"_2880":49514},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3394":372,"_29710":348,"_20617":49516,"_5":14139,"_27008":49454,"_2880":49517},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3394":373,"_29710":348,"_20617":49519,"_5":14139,"_27008":49454,"_2880":49520},[],"PostgreSQL data",{"_3394":374,"_29710":348,"_20617":49522,"_5":14139,"_27008":49454,"_2880":49523},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3394":375,"_29710":348,"_20617":49525,"_5":14139,"_27008":49454,"_2880":49526},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3394":376,"_29710":348,"_20617":49528,"_5":14139,"_27008":49454,"_2880":49529},[],"Messaging",{"_3394":377,"_29710":348,"_20617":49531,"_5":14139,"_27008":49454,"_2880":49532},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3394":378,"_29710":348,"_20617":49534,"_5":14139,"_27008":49454,"_2880":49535},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3394":379,"_29710":348,"_20617":49537,"_5":14139,"_27008":49454,"_2880":49538},[],"Identity",{"_3394":380,"_29710":348,"_20617":49540,"_5":14139,"_27008":49454,"_2880":49541},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3394":381,"_29710":348,"_20617":49543,"_5":14139,"_27008":49454,"_2880":49544},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3394":382,"_29710":348,"_20617":49546,"_5":14139,"_27008":49454,"_2880":49547},[],"External routing",{"_3394":383,"_29710":348,"_20617":49549,"_5":14139,"_27008":49454,"_2880":49550},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3394":384,"_29710":348,"_20617":49552,"_5":14139,"_27008":49454,"_2880":49553},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3394":385,"_29710":348,"_20617":49555,"_5":14139,"_27008":49454,"_2880":49556},[],"TLS",{"_3394":386,"_29710":348,"_20617":49558,"_5":14139,"_27008":49454,"_2880":49559},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3394":387,"_29710":348,"_20617":49561,"_5":14139,"_27008":49454,"_2880":49562},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3394":388,"_29710":348,"_20617":49564,"_5":14139,"_27008":49454,"_2880":49565},[],"Persistent application data",{"_3394":389,"_29710":348,"_20617":49567,"_5":14139,"_27008":49454,"_2880":49568},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3394":390,"_29710":348,"_20617":49570,"_5":14139,"_27008":49454,"_2880":49571},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3394":391,"_29710":348,"_20617":49573,"_5":14139,"_27008":49454,"_2880":49574},[],"Optional integrations",{"_3394":392,"_29710":348,"_20617":49576,"_5":14139,"_27008":49454,"_2880":49577},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3394":393,"_29710":348,"_20617":49579,"_5":14139,"_27008":49454,"_2880":49580},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3394":394,"_29710":348,"_20617":49582,"_5":14139,"_27008":49454,"_2880":49583},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3394":395,"_29710":348,"_20617":49585,"_5":14139,"_27008":49454,"_2880":49586},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3394":396,"_29710":348,"_20617":49588,"_5":14139,"_27008":49458,"_2880":49589},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3394":397,"_29710":348,"_20617":49591,"_5":14139,"_27008":49458,"_2880":49592},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3394":398,"_29710":348,"_20617":49594,"_5":14139,"_27008":49462,"_2880":49595},[],"Kubernetes 1.24 or newer",{"_3394":399,"_29710":348,"_20617":49597,"_5":14139,"_27008":49462,"_2880":49598},[],"Helm 3.2 or newer",{"_3394":400,"_29710":348,"_20617":49600,"_5":14139,"_27008":49462,"_2880":49601},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3394":401,"_29710":348,"_20617":49603,"_5":14139,"_27008":49462,"_2880":49604},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3394":402,"_29710":348,"_20617":49606,"_5":14139,"_27008":49462,"_2880":49607},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3394":403,"_29710":348,"_20617":49609,"_5":14139,"_27008":49462,"_2880":49610},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3394":404,"_29710":348,"_20617":49612,"_5":14139,"_27008":49462,"_2880":49613},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3394":405,"_29710":348,"_20617":49615,"_5":14139,"_27008":49466,"_2880":49616},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3394":406,"_29710":348,"_20617":49618,"_5":14139,"_27008":49466,"_2880":49619},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3394":407,"_29710":348,"_20617":49621,"_5":14139,"_27008":49466,"_2880":49622},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3394":408,"_29710":348,"_20617":49624,"_5":14139,"_27008":49466,"_2880":49625},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3394":409,"_29710":409,"_5":14491,"_2880":49627,"_30063":49628,"_20617":49630,"_27008":409},"Deployment troubleshooting",[48401,48402,49629],"Operations",[],{"_3394":410,"_29710":409,"_20617":49632,"_5":14139,"_27008":409,"_2880":49633},[],"Diagnose access, service health and infrastructure dependencies.",{"_3394":411,"_29710":409,"_5":30060,"_20617":49635,"_27008":49636,"_2880":49637},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3394":412,"_29710":409,"_5":30060,"_20617":49639,"_27008":49640,"_2880":49641},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3394":413,"_29710":409,"_5":30060,"_20617":49643,"_27008":49644,"_2880":49645},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3394":414,"_29710":409,"_5":30060,"_20617":49647,"_27008":49648,"_2880":49649},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3394":415,"_29710":409,"_5":30060,"_20617":49651,"_27008":49652,"_2880":49653},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3394":416,"_29710":409,"_5":30060,"_20617":49655,"_27008":49656,"_2880":49657},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3394":417,"_29710":409,"_5":30060,"_20617":49659,"_27008":49660,"_2880":49661},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3394":418,"_29710":409,"_5":30060,"_20617":49663,"_27008":49664,"_2880":49665},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3394":419,"_29710":409,"_5":30060,"_20617":49667,"_27008":49668,"_2880":49669},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3394":420,"_29710":409,"_5":30060,"_20617":49671,"_27008":49672,"_2880":49673},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3394":421,"_29710":409,"_5":30060,"_20617":49675,"_27008":49676,"_2880":49677},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3394":422,"_29710":409,"_5":30060,"_20617":49679,"_27008":49680,"_2880":49681},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3394":423,"_29710":409,"_5":30060,"_20617":49683,"_27008":49684,"_2880":49685},[],"/docs/pr-preview/pr-59/deployment/troubleshooting#observability","Observability",{"_3394":424,"_29710":409,"_20617":49687,"_5":14139,"_27008":409,"_2880":49688},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3394":425,"_29710":409,"_20617":49690,"_5":14139,"_27008":49640,"_2880":49691},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3394":426,"_29710":409,"_20617":49693,"_5":14139,"_27008":49644,"_2880":49694},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3394":427,"_29710":409,"_20617":49696,"_5":14139,"_27008":49648,"_2880":49697},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3394":428,"_29710":409,"_20617":49699,"_5":14139,"_27008":49652,"_2880":49700},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3394":429,"_29710":409,"_20617":49702,"_5":14139,"_27008":49656,"_2880":49703},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3394":430,"_29710":409,"_20617":49705,"_5":14139,"_27008":49660,"_2880":49706},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3394":431,"_29710":409,"_20617":49708,"_5":14139,"_27008":49660,"_2880":49709},[],"Also run the chart's connectivity test:",{"_3394":432,"_29710":409,"_20617":49711,"_5":14139,"_27008":49660,"_2880":49712},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3394":433,"_29710":409,"_20617":49714,"_5":14139,"_27008":49660,"_2880":49715},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3394":434,"_29710":409,"_20617":49717,"_5":14139,"_27008":49664,"_2880":49718},[],"If you receive a 401:",{"_3394":435,"_29710":409,"_20617":49720,"_5":14139,"_27008":49664,"_2880":49721},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3394":436,"_29710":409,"_20617":49723,"_5":14139,"_27008":49664,"_2880":49724},[],"verify issuer, audience and expiration of the token;",{"_3394":437,"_29710":409,"_20617":49726,"_5":14139,"_27008":49664,"_2880":49727},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3394":438,"_29710":409,"_20617":49729,"_5":14139,"_27008":49664,"_2880":49730},[],"check that the provider's public and internal routes point to the same realm.",{"_3394":439,"_29710":409,"_20617":49732,"_5":14139,"_27008":49664,"_2880":49733},[],"If login succeeds but the APIs return 403:",{"_3394":440,"_29710":409,"_20617":49735,"_5":14139,"_27008":49664,"_2880":49736},[],"inspect the token's real claims;",{"_3394":441,"_29710":409,"_20617":49738,"_5":14139,"_27008":49664,"_2880":49739},[],"confirm they match an active principal;",{"_3394":442,"_29710":409,"_20617":49741,"_5":14139,"_27008":49664,"_2880":49742},[],"review the policies granted to that principal;",{"_3394":443,"_29710":409,"_20617":49744,"_5":14139,"_27008":49664,"_2880":49745},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3394":444,"_29710":409,"_20617":49747,"_5":14139,"_27008":49664,"_2880":49748},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3394":445,"_29710":409,"_20617":49750,"_5":14139,"_27008":49668,"_2880":49751},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3394":446,"_29710":409,"_20617":49753,"_5":14139,"_27008":49668,"_2880":49754},[],"Locate the authz pod and Service.",{"_3394":447,"_29710":409,"_20617":49756,"_5":14139,"_27008":49668,"_2880":49757},[],"Check /health, logs and its database connection.",{"_3394":448,"_29710":409,"_20617":49759,"_5":14139,"_27008":49668,"_2880":49760},[],"Verify the DNS and port configured in externalAuthorization.",{"_3394":449,"_29710":409,"_20617":49762,"_5":14139,"_27008":49668,"_2880":49763},[],"Check the check route is /v1/ext\\_authz/check.",{"_3394":450,"_29710":409,"_20617":49765,"_5":14139,"_27008":49668,"_2880":49766},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3394":451,"_29710":409,"_20617":49768,"_5":14139,"_27008":49672,"_2880":49769},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3394":452,"_29710":409,"_20617":49771,"_5":14139,"_27008":49676,"_2880":49772},[],"Review kubectl describe pod first. Common causes are:",{"_3394":453,"_29710":409,"_20617":49774,"_5":14139,"_27008":49676,"_2880":49775},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3394":454,"_29710":409,"_20617":49777,"_5":14139,"_27008":49676,"_2880":49778},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3394":455,"_29710":409,"_20617":49780,"_5":14139,"_27008":49676,"_2880":49781},[],"unbound persistent volume;",{"_3394":456,"_29710":409,"_20617":49783,"_5":14139,"_27008":49676,"_2880":49784},[],"inaccessible image or incorrect pull policy;",{"_3394":457,"_29710":409,"_20617":49786,"_5":14139,"_27008":49676,"_2880":49787},[],"invalid cryptographic engine configuration;",{"_3394":458,"_29710":409,"_20617":49789,"_5":14139,"_27008":49676,"_2880":49790},[],"CPU or memory limits set too low;",{"_3394":459,"_29710":409,"_20617":49792,"_5":14139,"_27008":49676,"_2880":49793},[],"an incomplete prior migration.",{"_3394":460,"_29710":409,"_20617":49795,"_5":14139,"_27008":49676,"_2880":49796},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3394":461,"_29710":409,"_20617":49798,"_5":14139,"_27008":49676,"_2880":49799},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3394":462,"_29710":409,"_20617":49801,"_5":14139,"_27008":49676,"_2880":49802},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3394":463,"_29710":409,"_20617":49804,"_5":14139,"_27008":49680,"_2880":49805},[],"Domain and audit events depend on the bus publisher:",{"_3394":464,"_29710":409,"_20617":49807,"_5":14139,"_27008":49680,"_2880":49808},[],"verify it is enabled in the emitting service;",{"_3394":465,"_29710":409,"_20617":49810,"_5":14139,"_27008":49680,"_2880":49811},[],"check AMQP connectivity and credentials;",{"_3394":466,"_29710":409,"_20617":49813,"_5":14139,"_27008":49680,"_2880":49814},[],"review exchange, routing key, queues and consumers;",{"_3394":467,"_29710":409,"_20617":49816,"_5":14139,"_27008":49680,"_2880":49817},[],"inspect dead-letter queues;",{"_3394":468,"_29710":409,"_20617":49819,"_5":14139,"_27008":49680,"_2880":49820},[],"alert on orphan durable queues and backlog growth.",{"_3394":469,"_29710":409,"_20617":49822,"_5":14139,"_27008":49680,"_2880":49823},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3394":470,"_29710":409,"_20617":49825,"_5":14139,"_27008":49680,"_2880":49826},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3394":471,"_29710":409,"_20617":49828,"_5":14139,"_27008":49680,"_2880":49829},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3394":472,"_29710":409,"_20617":49831,"_5":14139,"_27008":49680,"_2880":49832},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3394":473,"_29710":409,"_20617":49834,"_5":14139,"_27008":49680,"_2880":49835},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3394":474,"_29710":409,"_20617":49837,"_5":14139,"_27008":49680,"_2880":49838},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3394":475,"_29710":409,"_20617":49840,"_5":14139,"_27008":49680,"_2880":49841},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3394":476,"_29710":409,"_20617":49843,"_5":14139,"_27008":49684,"_2880":49844},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3394":477,"_29710":409,"_20617":49846,"_5":14139,"_27008":49684,"_2880":49847},[],"Before closing an incident, record:",{"_3394":478,"_29710":409,"_20617":49849,"_5":14139,"_27008":49684,"_2880":49850},[],"the confirmed cause;",{"_3394":479,"_29710":409,"_20617":49852,"_5":14139,"_27008":49684,"_2880":49853},[],"the time scope and affected resources;",{"_3394":480,"_29710":409,"_20617":49855,"_5":14139,"_27008":49684,"_2880":49856},[],"the commands or queries used;",{"_3394":481,"_29710":409,"_20617":49858,"_5":14139,"_27008":49684,"_2880":49859},[],"the applied change and how to revert it;",{"_3394":482,"_29710":409,"_20617":49861,"_5":14139,"_27008":49684,"_2880":49862},[],"validation from a consumer;",{"_3394":483,"_29710":409,"_20617":49864,"_5":14139,"_27008":49684,"_2880":49865},[],"the preventive action and its owner.",{"_3394":484,"_29710":484,"_5":14491,"_2880":49867,"_30063":49868,"_20617":49871,"_27008":484},"Access control",[48401,49869,49870],"Platform","Administration",[],{"_3394":485,"_29710":484,"_20617":49873,"_5":14139,"_27008":484,"_2880":49874},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3394":486,"_29710":484,"_5":30060,"_20617":49876,"_27008":49877,"_2880":49878},[],"/docs/pr-preview/pr-59/platform/administration/access-control#essential-concepts","Essential concepts",{"_3394":487,"_29710":484,"_5":30060,"_20617":49880,"_27008":49881,"_2880":49882},[],"/docs/pr-preview/pr-59/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3394":488,"_29710":484,"_5":30060,"_20617":49884,"_27008":49885,"_2880":49886},[],"/docs/pr-preview/pr-59/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3394":489,"_29710":484,"_5":30060,"_20617":49888,"_27008":49889,"_2880":49890},[],"/docs/pr-preview/pr-59/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3394":490,"_29710":484,"_5":30060,"_20617":49892,"_27008":49893,"_2880":49894},[],"/docs/pr-preview/pr-59/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3394":491,"_29710":484,"_5":30060,"_20617":49896,"_27008":49897,"_2880":49898},[],"/docs/pr-preview/pr-59/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3394":492,"_29710":484,"_5":30060,"_20617":49900,"_27008":49901,"_2880":49902},[],"/docs/pr-preview/pr-59/platform/administration/access-control#oidc-principals","OIDC principals",{"_3394":493,"_29710":484,"_5":30060,"_20617":49904,"_27008":49905,"_2880":49906},[],"/docs/pr-preview/pr-59/platform/administration/access-control#x509-principals","X.509 principals",{"_3394":494,"_29710":484,"_5":30060,"_20617":49908,"_27008":49909,"_2880":49910},[],"/docs/pr-preview/pr-59/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3394":495,"_29710":484,"_5":30060,"_20617":49912,"_27008":49913,"_2880":49914},[],"/docs/pr-preview/pr-59/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3394":496,"_29710":484,"_5":30060,"_20617":49916,"_27008":49917,"_2880":49918},[],"/docs/pr-preview/pr-59/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3394":497,"_29710":484,"_5":30060,"_20617":49920,"_27008":49921,"_2880":49922},[],"/docs/pr-preview/pr-59/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3394":498,"_29710":484,"_5":30060,"_20617":49924,"_27008":49925,"_2880":49926},[],"/docs/pr-preview/pr-59/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3394":499,"_29710":484,"_5":30060,"_20617":49928,"_27008":49929,"_2880":49930},[],"/docs/pr-preview/pr-59/platform/administration/access-control#http-rules","HTTP rules",{"_3394":500,"_29710":484,"_5":30060,"_20617":49932,"_27008":49933,"_2880":49934},[],"/docs/pr-preview/pr-59/platform/administration/access-control#included-policies","Included policies",{"_3394":501,"_29710":484,"_5":30060,"_20617":49936,"_27008":49937,"_2880":49041},[],"/docs/pr-preview/pr-59/platform/administration/access-control#provision-the-first-administrator",{"_3394":502,"_29710":484,"_5":30060,"_20617":49939,"_27008":49940,"_2880":49941},[],"/docs/pr-preview/pr-59/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3394":503,"_29710":484,"_5":30060,"_20617":49943,"_27008":49944,"_2880":49945},[],"/docs/pr-preview/pr-59/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3394":504,"_29710":484,"_5":30060,"_20617":49947,"_27008":49948,"_2880":49949},[],"/docs/pr-preview/pr-59/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3394":505,"_29710":484,"_5":30060,"_20617":49951,"_27008":49952,"_2880":49953},[],"/docs/pr-preview/pr-59/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3394":506,"_29710":484,"_5":30060,"_20617":49955,"_27008":49956,"_2880":49957},[],"/docs/pr-preview/pr-59/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3394":507,"_29710":484,"_5":30060,"_20617":49959,"_27008":49960,"_2880":49961},[],"/docs/pr-preview/pr-59/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3394":508,"_29710":484,"_5":30060,"_20617":49963,"_27008":49964,"_2880":49965},[],"/docs/pr-preview/pr-59/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3394":509,"_29710":484,"_5":30060,"_20617":49967,"_27008":49968,"_2880":49969},[],"/docs/pr-preview/pr-59/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3394":510,"_29710":484,"_5":30060,"_20617":49971,"_27008":49972,"_2880":49973},[],"/docs/pr-preview/pr-59/platform/administration/access-control#operational-checklist","Operational checklist",{"_3394":511,"_29710":484,"_5":30060,"_20617":49975,"_27008":49976,"_2880":49977},[],"/docs/pr-preview/pr-59/platform/administration/access-control#diagnostics","Diagnostics",{"_3394":512,"_29710":484,"_5":30060,"_20617":49979,"_27008":49980,"_2880":49981},[],"/docs/pr-preview/pr-59/platform/administration/access-control#the-response-is-401","The response is 401",{"_3394":513,"_29710":484,"_5":30060,"_20617":49983,"_27008":49984,"_2880":49985},[],"/docs/pr-preview/pr-59/platform/administration/access-control#the-response-is-403","The response is 403",{"_3394":514,"_29710":484,"_5":30060,"_20617":49987,"_27008":49988,"_2880":49989},[],"/docs/pr-preview/pr-59/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3394":515,"_29710":484,"_5":30060,"_20617":49991,"_27008":49992,"_2880":49993},[],"/docs/pr-preview/pr-59/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3394":516,"_29710":484,"_5":30060,"_20617":49995,"_27008":49996,"_2880":49997},[],"/docs/pr-preview/pr-59/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3394":517,"_29710":484,"_20617":49999,"_5":14139,"_27008":484,"_2880":50000},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3394":518,"_29710":484,"_20617":50002,"_5":14139,"_27008":484,"_2880":50003},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3394":519,"_29710":484,"_20617":50005,"_5":14139,"_27008":484,"_2880":50006},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3394":520,"_29710":484,"_20617":50008,"_5":14139,"_27008":49877,"_2880":50009},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3394":521,"_29710":484,"_20617":50011,"_5":14139,"_27008":49877,"_2880":50012},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3394":522,"_29710":484,"_20617":50014,"_5":14139,"_27008":49877,"_2880":50015},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3394":523,"_29710":484,"_20617":50017,"_5":14139,"_27008":49877,"_2880":50018},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3394":524,"_29710":484,"_20617":50020,"_5":14139,"_27008":49877,"_2880":50021},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3394":525,"_29710":484,"_20617":50023,"_5":14139,"_27008":49877,"_2880":50024},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3394":526,"_29710":484,"_20617":50026,"_5":14139,"_27008":49881,"_2880":50027},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3394":527,"_29710":484,"_20617":50029,"_5":14139,"_27008":49881,"_2880":50030},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3394":528,"_29710":484,"_20617":50032,"_5":14139,"_27008":49885,"_2880":50033},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3394":529,"_29710":484,"_20617":50035,"_5":14139,"_27008":49885,"_2880":50036},[],"The decision is made **before forwarding the request to the service**:",{"_3394":530,"_29710":484,"_20617":50038,"_5":14139,"_27008":49885,"_2880":50039},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3394":531,"_29710":484,"_20617":50041,"_5":14139,"_27008":49885,"_2880":50042},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3394":532,"_29710":484,"_20617":50044,"_5":14139,"_27008":49885,"_2880":50045},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3394":533,"_29710":484,"_20617":50047,"_5":14139,"_27008":49885,"_2880":50048},[],"It separately loads the policies granted to each principal.",{"_3394":534,"_29710":484,"_20617":50050,"_5":14139,"_27008":49885,"_2880":50051},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3394":535,"_29710":484,"_20617":50053,"_5":14139,"_27008":49885,"_2880":50054},[],"`authz` looks for an HTTP rule granting that action.",{"_3394":536,"_29710":484,"_20617":50056,"_5":14139,"_27008":49885,"_2880":50057},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3394":537,"_29710":484,"_20617":50059,"_5":14139,"_27008":49885,"_2880":50060},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3394":538,"_29710":484,"_20617":50062,"_5":14139,"_27008":49885,"_2880":50063},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3394":539,"_29710":484,"_20617":50065,"_5":14139,"_27008":49885,"_2880":50066},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3394":540,"_29710":484,"_20617":50068,"_5":14139,"_27008":49889,"_2880":50069},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3394":541,"_29710":484,"_20617":50071,"_5":14139,"_27008":49889,"_2880":50072},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3394":542,"_29710":484,"_20617":50074,"_5":14139,"_27008":49889,"_2880":50075},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3394":543,"_29710":484,"_20617":50077,"_5":14139,"_27008":49889,"_2880":50078},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3394":544,"_29710":484,"_20617":50080,"_5":14139,"_27008":49889,"_2880":50081},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3394":545,"_29710":484,"_20617":50083,"_5":14139,"_27008":49889,"_2880":50084},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3394":546,"_29710":484,"_20617":50086,"_5":14139,"_27008":49889,"_2880":50087},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3394":547,"_29710":484,"_20617":50089,"_5":14139,"_27008":49889,"_2880":50090},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3394":548,"_29710":484,"_20617":50092,"_5":14139,"_27008":49893,"_2880":50093},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3394":549,"_29710":484,"_20617":50095,"_5":14139,"_27008":49893,"_2880":50096},[],"The decision is made with the domain operation context:",{"_3394":550,"_29710":484,"_20617":50098,"_5":14139,"_27008":49893,"_2880":50099},[],"The middleware extracts the credential and resolves the matching principals.",{"_3394":551,"_29710":484,"_20617":50101,"_5":14139,"_27008":49893,"_2880":50102},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3394":552,"_29710":484,"_20617":50104,"_5":14139,"_27008":49893,"_2880":50105},[],"`authz` gathers the entity rules of the granted policies.",{"_3394":553,"_29710":484,"_20617":50107,"_5":14139,"_27008":49893,"_2880":50108},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3394":554,"_29710":484,"_20617":50110,"_5":14139,"_27008":49893,"_2880":50111},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3394":555,"_29710":484,"_20617":50113,"_5":14139,"_27008":49893,"_2880":50114},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3394":556,"_29710":484,"_20617":50116,"_5":14139,"_27008":49893,"_2880":50117},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3394":557,"_29710":484,"_20617":50119,"_5":14139,"_27008":49893,"_2880":50120},[],"Actions fall into two groups:",{"_3394":558,"_29710":484,"_20617":50122,"_5":14139,"_27008":49893,"_2880":50123},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3394":559,"_29710":484,"_20617":50125,"_5":14139,"_27008":49893,"_2880":50126},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3394":560,"_29710":484,"_20617":50128,"_5":14139,"_27008":49893,"_2880":50129},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3394":561,"_29710":484,"_20617":50131,"_5":14139,"_27008":49897,"_2880":50132},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3394":562,"_29710":484,"_20617":50134,"_5":14139,"_27008":49897,"_2880":50135},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3394":563,"_29710":484,"_20617":50137,"_5":14139,"_27008":49897,"_2880":50138},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3394":564,"_29710":484,"_20617":50140,"_5":14139,"_27008":49901,"_2880":50141},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3394":565,"_29710":484,"_20617":50143,"_5":14139,"_27008":49901,"_2880":50144},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3394":566,"_29710":484,"_20617":50146,"_5":14139,"_27008":49901,"_2880":50147},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3394":567,"_29710":484,"_20617":50149,"_5":14139,"_27008":49901,"_2880":50150},[],"The implemented operators are:",{"_3394":568,"_29710":484,"_20617":50152,"_5":14139,"_27008":49901,"_2880":50153},[],"`equals`, for exact equality;",{"_3394":569,"_29710":484,"_20617":50155,"_5":14139,"_27008":49901,"_2880":50156},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3394":570,"_29710":484,"_20617":50158,"_5":14139,"_27008":49901,"_2880":50159},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3394":571,"_29710":484,"_20617":50161,"_5":14139,"_27008":49901,"_2880":50162},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3394":572,"_29710":484,"_20617":50164,"_5":14139,"_27008":49905,"_2880":50165},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3394":573,"_29710":484,"_20617":50167,"_5":14139,"_27008":49905,"_2880":50168},[],"The available modes are:",{"_3394":574,"_29710":484,"_20617":50170,"_5":14139,"_27008":49905,"_2880":50171},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3394":575,"_29710":484,"_20617":50173,"_5":14139,"_27008":49905,"_2880":50174},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3394":576,"_29710":484,"_20617":50176,"_5":14139,"_27008":49905,"_2880":50177},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3394":577,"_29710":484,"_20617":50179,"_5":14139,"_27008":49905,"_2880":50180},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3394":578,"_29710":484,"_20617":50182,"_5":14139,"_27008":49905,"_2880":50183},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3394":579,"_29710":484,"_20617":50185,"_5":14139,"_27008":49905,"_2880":50186},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3394":580,"_29710":484,"_20617":50188,"_5":14139,"_27008":49909,"_2880":50189},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3394":581,"_29710":484,"_20617":50191,"_5":14139,"_27008":49909,"_2880":50192},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3394":582,"_29710":484,"_20617":50194,"_5":14139,"_27008":49909,"_2880":50195},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3394":583,"_29710":484,"_20617":50197,"_5":14139,"_27008":49909,"_2880":50198},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3394":584,"_29710":484,"_20617":50200,"_5":14139,"_27008":49917,"_2880":50201},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3394":585,"_29710":484,"_20617":50203,"_5":14139,"_27008":49917,"_2880":50204},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3394":586,"_29710":484,"_20617":50206,"_5":14139,"_27008":49921,"_2880":50207},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3394":587,"_29710":484,"_20617":50209,"_5":14139,"_27008":49921,"_2880":50210},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3394":588,"_29710":484,"_20617":50212,"_5":14139,"_27008":49925,"_2880":50213},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3394":589,"_29710":484,"_20617":50215,"_5":14139,"_27008":49925,"_2880":50216},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3394":590,"_29710":484,"_20617":50218,"_5":14139,"_27008":49925,"_2880":50219},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3394":591,"_29710":484,"_20617":50221,"_5":14139,"_27008":49929,"_2880":50222},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3394":592,"_29710":484,"_20617":50224,"_5":14139,"_27008":49929,"_2880":50225},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3394":593,"_29710":484,"_20617":50227,"_5":14139,"_27008":49929,"_2880":50228},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3394":594,"_29710":484,"_20617":50230,"_5":14139,"_27008":49929,"_2880":50231},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3394":595,"_29710":484,"_20617":50233,"_5":14139,"_27008":49929,"_2880":50234},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3394":596,"_29710":484,"_20617":50236,"_5":14139,"_27008":49929,"_2880":50237},[],"Note that:",{"_3394":597,"_29710":484,"_20617":50239,"_5":14139,"_27008":49929,"_2880":50240},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3394":598,"_29710":484,"_20617":50242,"_5":14139,"_27008":49929,"_2880":50243},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3394":599,"_29710":484,"_20617":50245,"_5":14139,"_27008":49929,"_2880":50246},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3394":600,"_29710":484,"_20617":50248,"_5":14139,"_27008":49933,"_2880":50249},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3394":601,"_29710":484,"_20617":50251,"_5":14139,"_27008":49933,"_2880":50252},[],"full and read-only access to certificates and authorities;",{"_3394":602,"_29710":484,"_20617":50254,"_5":14139,"_27008":49933,"_2880":50255},[],"full and read-only access to the KMS;",{"_3394":603,"_29710":484,"_20617":50257,"_5":14139,"_27008":49933,"_2880":50258},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3394":604,"_29710":484,"_20617":50260,"_5":14139,"_27008":49933,"_2880":50261},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3394":605,"_29710":484,"_20617":50263,"_5":14139,"_27008":49933,"_2880":50264},[],"console access;",{"_3394":606,"_29710":484,"_20617":50266,"_5":14139,"_27008":49933,"_2880":50267},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3394":607,"_29710":484,"_20617":50269,"_5":14139,"_27008":49933,"_2880":50270},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3394":608,"_29710":484,"_20617":50272,"_5":14139,"_27008":49933,"_2880":50273},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3394":609,"_29710":484,"_20617":50275,"_5":14139,"_27008":49937,"_2880":50276},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3394":610,"_29710":484,"_20617":50278,"_5":14139,"_27008":49937,"_2880":50279},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3394":611,"_29710":484,"_20617":50281,"_5":14139,"_27008":49937,"_2880":50282},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3394":612,"_29710":484,"_20617":50284,"_5":14139,"_27008":49940,"_2880":50285},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3394":613,"_29710":484,"_20617":50287,"_5":14139,"_27008":49944,"_2880":50288},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3394":614,"_29710":484,"_20617":50290,"_5":14139,"_27008":49944,"_2880":50291},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3394":615,"_29710":484,"_20617":50293,"_5":14139,"_27008":49948,"_2880":50294},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3394":616,"_29710":484,"_20617":50296,"_5":14139,"_27008":49952,"_2880":50297},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3394":617,"_29710":484,"_20617":50299,"_5":14139,"_27008":49956,"_2880":50300},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3394":618,"_29710":484,"_20617":50302,"_5":14139,"_27008":49960,"_2880":50303},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3394":619,"_29710":484,"_20617":50305,"_5":14139,"_27008":49960,"_2880":50306},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3394":620,"_29710":484,"_20617":50308,"_5":14139,"_27008":49964,"_2880":50309},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3394":621,"_29710":484,"_20617":50311,"_5":14139,"_27008":49964,"_2880":50312},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3394":622,"_29710":484,"_20617":50314,"_5":14139,"_27008":49964,"_2880":50315},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3394":623,"_29710":484,"_20617":50317,"_5":14139,"_27008":49964,"_2880":50318},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3394":624,"_29710":484,"_20617":50320,"_5":14139,"_27008":49964,"_2880":50321},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3394":625,"_29710":484,"_20617":50323,"_5":14139,"_27008":49964,"_2880":50324},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3394":626,"_29710":484,"_20617":50326,"_5":14139,"_27008":49964,"_2880":50327},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3394":627,"_29710":484,"_20617":50329,"_5":14139,"_27008":49964,"_2880":50330},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3394":628,"_29710":484,"_20617":50332,"_5":14139,"_27008":49968,"_2880":50333},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3394":629,"_29710":484,"_20617":50335,"_5":14139,"_27008":49968,"_2880":50336},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3394":630,"_29710":484,"_20617":50338,"_5":14139,"_27008":49968,"_2880":50339},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3394":631,"_29710":484,"_20617":50341,"_5":14139,"_27008":49972,"_2880":50342},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3394":632,"_29710":484,"_20617":50344,"_5":14139,"_27008":49972,"_2880":50345},[],"Use groups or stable roles for people and independent identities for automations.",{"_3394":633,"_29710":484,"_20617":50347,"_5":14139,"_27008":49972,"_2880":50348},[],"Keep at least two recovery administrators and test their access periodically.",{"_3394":634,"_29710":484,"_20617":50350,"_5":14139,"_27008":49972,"_2880":50351},[],"Review active principals, their matches and their grants after IdP changes.",{"_3394":635,"_29710":484,"_20617":50353,"_5":14139,"_27008":49972,"_2880":50354},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3394":636,"_29710":484,"_20617":50356,"_5":14139,"_27008":49972,"_2880":50357},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3394":637,"_29710":484,"_20617":50359,"_5":14139,"_27008":49972,"_2880":50360},[],"Always test one allowed and one denied operation for each role.",{"_3394":638,"_29710":484,"_20617":50362,"_5":14139,"_27008":49972,"_2880":50363},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3394":639,"_29710":484,"_20617":50365,"_5":14139,"_27008":49980,"_2880":50366},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3394":640,"_29710":484,"_20617":50368,"_5":14139,"_27008":49984,"_2880":50369},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3394":641,"_29710":484,"_20617":50371,"_5":14139,"_27008":49984,"_2880":50372},[],"that an active principal of the correct type exists;",{"_3394":642,"_29710":484,"_20617":50374,"_5":14139,"_27008":49984,"_2880":50375},[],"that the claim paths and values match the real token exactly;",{"_3394":643,"_29710":484,"_20617":50377,"_5":14139,"_27008":49984,"_2880":50378},[],"that all of the principal's conditions hold;",{"_3394":644,"_29710":484,"_20617":50380,"_5":14139,"_27008":49984,"_2880":50381},[],"that the principal has the expected policy granted;",{"_3394":645,"_29710":484,"_20617":50383,"_5":14139,"_27008":49984,"_2880":50384},[],"that the policy includes the action and the requested resource type or route;",{"_3394":646,"_29710":484,"_20617":50386,"_5":14139,"_27008":49984,"_2880":50387},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3394":647,"_29710":484,"_20617":50389,"_5":14139,"_27008":49984,"_2880":50390},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3394":648,"_29710":484,"_20617":50392,"_5":14139,"_27008":49988,"_2880":50393},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3394":649,"_29710":484,"_20617":50395,"_5":14139,"_27008":49992,"_2880":50396},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3394":650,"_29710":484,"_20617":50398,"_5":14139,"_27008":49996,"_2880":50399},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3394":651,"_29710":484,"_20617":50401,"_5":14139,"_27008":49996,"_2880":50402},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3394":652,"_29710":652,"_5":14491,"_2880":50404,"_30063":50405,"_20617":50406,"_27008":652},"Alerts and subscriptions",[48401,49869,49870],[],{"_3394":653,"_29710":652,"_20617":50408,"_5":14139,"_27008":652,"_2880":50409},[],"Send PKI events to people and external systems.",{"_3394":654,"_29710":652,"_5":30060,"_20617":50411,"_27008":50412,"_2880":50413},[],"/docs/pr-preview/pr-59/platform/administration/alerts#how-it-works","How it works",{"_3394":655,"_29710":652,"_5":30060,"_20617":50415,"_27008":50416,"_2880":50417},[],"/docs/pr-preview/pr-59/platform/administration/alerts#available-channels","Available channels",{"_3394":656,"_29710":652,"_5":30060,"_20617":50419,"_27008":50420,"_2880":50421},[],"/docs/pr-preview/pr-59/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3394":657,"_29710":652,"_5":30060,"_20617":50423,"_27008":50424,"_2880":50425},[],"/docs/pr-preview/pr-59/platform/administration/alerts#choose-the-event","Choose the event",{"_3394":658,"_29710":652,"_5":30060,"_20617":50427,"_27008":50428,"_2880":50429},[],"/docs/pr-preview/pr-59/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3394":659,"_29710":652,"_5":30060,"_20617":50431,"_27008":50432,"_2880":50433},[],"/docs/pr-preview/pr-59/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3394":660,"_29710":652,"_5":30060,"_20617":50435,"_27008":50436,"_2880":50437},[],"/docs/pr-preview/pr-59/platform/administration/alerts#review-and-activate","Review and activate",{"_3394":661,"_29710":652,"_5":30060,"_20617":50439,"_27008":50440,"_2880":50441},[],"/docs/pr-preview/pr-59/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3394":662,"_29710":652,"_5":30060,"_20617":50443,"_27008":50444,"_2880":50445},[],"/docs/pr-preview/pr-59/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3394":663,"_29710":652,"_5":30060,"_20617":50447,"_27008":50448,"_2880":50449},[],"/docs/pr-preview/pr-59/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3394":664,"_29710":652,"_5":30060,"_20617":50451,"_27008":50452,"_2880":50453},[],"/docs/pr-preview/pr-59/platform/administration/alerts#event-families","Event families",{"_3394":665,"_29710":652,"_20617":50455,"_5":14139,"_27008":652,"_2880":50456},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3394":666,"_29710":652,"_20617":50458,"_5":14139,"_27008":50412,"_2880":50459},[],"A service publishes a domain event.",{"_3394":667,"_29710":652,"_20617":50461,"_5":14139,"_27008":50412,"_2880":50462},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3394":668,"_29710":652,"_20617":50464,"_5":14139,"_27008":50412,"_2880":50465},[],"Each subscription's filter decides whether it should be notified.",{"_3394":669,"_29710":652,"_20617":50467,"_5":14139,"_27008":50412,"_2880":50468},[],"Lamassu delivers the event to the configured channel.",{"_3394":670,"_29710":652,"_20617":50470,"_5":14139,"_27008":50412,"_2880":50471},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3394":671,"_29710":652,"_20617":50473,"_5":14139,"_27008":50416,"_2880":50474},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3394":672,"_29710":652,"_20617":50476,"_5":14139,"_27008":50416,"_2880":50477},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3394":673,"_29710":652,"_20617":50479,"_5":14139,"_27008":50416,"_2880":50480},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3394":674,"_29710":652,"_20617":50482,"_5":14139,"_27008":50416,"_2880":50483},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3394":675,"_29710":652,"_20617":50485,"_5":14139,"_27008":50416,"_2880":50486},[],"`apikey_options` requires `header` and `key`.",{"_3394":676,"_29710":652,"_20617":50488,"_5":14139,"_27008":50416,"_2880":50489},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3394":677,"_29710":652,"_20617":50491,"_5":14139,"_27008":50416,"_2880":50492},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3394":678,"_29710":652,"_20617":50494,"_5":14139,"_27008":50416,"_2880":50495},[],"The alerts API reference documents the full `http_client` schema.",{"_3394":679,"_29710":652,"_20617":50497,"_5":14139,"_27008":50424,"_2880":50498},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3394":680,"_29710":652,"_20617":50500,"_5":14139,"_27008":50428,"_2880":50501},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3394":681,"_29710":652,"_20617":50503,"_5":14139,"_27008":50432,"_2880":50504},[],"Add a filter if you don't want to receive every instance of the event.",{"_3394":682,"_29710":652,"_20617":50506,"_5":14139,"_27008":50432,"_2880":50507},[],"**None** notifies all instances of the event.",{"_3394":683,"_29710":652,"_20617":50509,"_5":14139,"_27008":50432,"_2880":50510},[],"**JSON Path** evaluates one or more specific fields.",{"_3394":684,"_29710":652,"_20617":50512,"_5":14139,"_27008":50432,"_2880":50513},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3394":685,"_29710":652,"_20617":50515,"_5":14139,"_27008":50432,"_2880":50516},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3394":686,"_29710":652,"_20617":50518,"_5":14139,"_27008":50432,"_2880":50519},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3394":687,"_29710":652,"_20617":50521,"_5":14139,"_27008":50432,"_2880":50522},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3394":688,"_29710":652,"_20617":50524,"_5":14139,"_27008":50436,"_2880":50525},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3394":689,"_29710":652,"_20617":50527,"_5":14139,"_27008":50440,"_2880":50528},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3394":690,"_29710":652,"_20617":50530,"_5":14139,"_27008":50440,"_2880":50531},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3394":691,"_29710":652,"_20617":50533,"_5":14139,"_27008":50440,"_2880":50534},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3394":692,"_29710":652,"_20617":50536,"_5":14139,"_27008":50440,"_2880":50537},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3394":693,"_29710":652,"_20617":50539,"_5":14139,"_27008":50440,"_2880":50540},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3394":694,"_29710":652,"_20617":50542,"_5":14139,"_27008":50440,"_2880":50543},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3394":695,"_29710":652,"_20617":50545,"_5":14139,"_27008":50440,"_2880":50546},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3394":696,"_29710":652,"_20617":50548,"_5":14139,"_27008":50440,"_2880":50549},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3394":697,"_29710":652,"_20617":50551,"_5":14139,"_27008":50444,"_2880":50552},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3394":698,"_29710":652,"_20617":50554,"_5":14139,"_27008":50444,"_2880":50555},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3394":699,"_29710":652,"_20617":50557,"_5":14139,"_27008":50444,"_2880":50558},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3394":700,"_29710":652,"_20617":50560,"_5":14139,"_27008":50444,"_2880":50561},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3394":701,"_29710":652,"_20617":50563,"_5":14139,"_27008":50444,"_2880":50564},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3394":702,"_29710":652,"_20617":50566,"_5":14139,"_27008":50444,"_2880":50567},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3394":703,"_29710":652,"_20617":50569,"_5":14139,"_27008":50444,"_2880":50570},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3394":704,"_29710":652,"_20617":50572,"_5":14139,"_27008":50444,"_2880":50573},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3394":705,"_29710":652,"_20617":50575,"_5":14139,"_27008":50448,"_2880":50576},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3394":706,"_29710":652,"_20617":50578,"_5":14139,"_27008":50448,"_2880":50579},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3394":707,"_29710":652,"_20617":50581,"_5":14139,"_27008":50452,"_2880":50582},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3394":708,"_29710":652,"_20617":50584,"_5":14139,"_27008":50452,"_2880":50585},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3394":709,"_29710":652,"_20617":50587,"_5":14139,"_27008":50452,"_2880":50588},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3394":710,"_29710":652,"_20617":50590,"_5":14139,"_27008":50452,"_2880":50591},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3394":711,"_29710":652,"_20617":50593,"_5":14139,"_27008":50452,"_2880":50594},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3394":712,"_29710":652,"_20617":50596,"_5":14139,"_27008":50452,"_2880":50597},[],"**Validation:** `va.role.crl.create`.",{"_3394":713,"_29710":652,"_20617":50599,"_5":14139,"_27008":50452,"_2880":50600},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3394":714,"_29710":652,"_20617":50602,"_5":14139,"_27008":50452,"_2880":50603},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3394":715,"_29710":715,"_5":14491,"_2880":50605,"_30063":50606,"_20617":50607,"_27008":715},"Audit logs",[48401,49869,49870],[],{"_3394":716,"_29710":715,"_20617":50609,"_5":14139,"_27008":715,"_2880":50610},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3394":717,"_29710":715,"_5":30060,"_20617":50612,"_27008":50613,"_2880":50614},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3394":718,"_29710":715,"_5":30060,"_20617":50616,"_27008":50617,"_2880":50618},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#coverage","Coverage",{"_3394":719,"_29710":715,"_5":30060,"_20617":50620,"_27008":50621,"_2880":50622},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3394":720,"_29710":715,"_5":30060,"_20617":50624,"_27008":50625,"_2880":50626},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3394":721,"_29710":715,"_5":30060,"_20617":50628,"_27008":50629,"_2880":50630},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3394":722,"_29710":715,"_5":30060,"_20617":50632,"_27008":50633,"_2880":50634},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3394":723,"_29710":715,"_5":30060,"_20617":50636,"_27008":50637,"_2880":50638},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3394":724,"_29710":715,"_5":30060,"_20617":50640,"_27008":50641,"_2880":50642},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3394":725,"_29710":715,"_5":30060,"_20617":50644,"_27008":50645,"_2880":50646},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3394":726,"_29710":715,"_5":30060,"_20617":50648,"_27008":50649,"_2880":50650},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3394":727,"_29710":715,"_5":30060,"_20617":50652,"_27008":50653,"_2880":50654},[],"/docs/pr-preview/pr-59/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3394":728,"_29710":715,"_20617":50656,"_5":14139,"_27008":715,"_2880":50657},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3394":729,"_29710":715,"_20617":50659,"_5":14139,"_27008":50613,"_2880":50660},[],"The audit body includes:",{"_3394":730,"_29710":715,"_20617":50662,"_5":14139,"_27008":50613,"_2880":50663},[],"input: data received by the operation;",{"_3394":731,"_29710":715,"_20617":50665,"_5":14139,"_27008":50613,"_2880":50666},[],"has\\_error: whether the service returned an error;",{"_3394":732,"_29710":715,"_20617":50668,"_5":14139,"_27008":50613,"_2880":50669},[],"output: produced result or error message;",{"_3394":733,"_29710":715,"_20617":50671,"_5":14139,"_27008":50613,"_2880":50672},[],"principals: identifiers of the principals that matched the request.",{"_3394":734,"_29710":715,"_20617":50674,"_5":14139,"_27008":50613,"_2880":50675},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3394":735,"_29710":715,"_20617":50677,"_5":14139,"_27008":50613,"_2880":50678},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3394":736,"_29710":715,"_20617":50680,"_5":14139,"_27008":50617,"_2880":50681},[],"The backend applies auditing to mutations of:",{"_3394":737,"_29710":715,"_20617":50683,"_5":14139,"_27008":50617,"_2880":50684},[],"authorities, certificates and issuance profiles;",{"_3394":738,"_29710":715,"_20617":50686,"_5":14139,"_27008":50617,"_2880":50687},[],"keys and KMS engines;",{"_3394":739,"_29710":715,"_20617":50689,"_5":14139,"_27008":50617,"_2880":50690},[],"devices and identities;",{"_3394":740,"_29710":715,"_20617":50692,"_5":14139,"_27008":50617,"_2880":50693},[],"DMSs and enrollment operations;",{"_3394":741,"_29710":715,"_20617":50695,"_5":14139,"_27008":50617,"_2880":50696},[],"validation functions and CRL;",{"_3394":742,"_29710":715,"_20617":50698,"_5":14139,"_27008":50617,"_2880":50699},[],"principals, policies and authorization grants.",{"_3394":743,"_29710":715,"_20617":50701,"_5":14139,"_27008":50617,"_2880":50702},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3394":744,"_29710":715,"_20617":50704,"_5":14139,"_27008":50621,"_2880":50705},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3394":745,"_29710":715,"_20617":50707,"_5":14139,"_27008":50621,"_2880":50708},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3394":746,"_29710":715,"_20617":50710,"_5":14139,"_27008":50621,"_2880":50711},[],"Design the consumer to:",{"_3394":747,"_29710":715,"_20617":50713,"_5":14139,"_27008":50621,"_2880":50714},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3394":748,"_29710":715,"_20617":50716,"_5":14139,"_27008":50621,"_2880":50717},[],"keep the complete CloudEvent unmodified;",{"_3394":749,"_29710":715,"_20617":50719,"_5":14139,"_27008":50621,"_2880":50720},[],"record the ingestion time and detect duplicates by ID;",{"_3394":750,"_29710":715,"_20617":50722,"_5":14139,"_27008":50621,"_2880":50723},[],"encrypt in transit and at rest;",{"_3394":751,"_29710":715,"_20617":50725,"_5":14139,"_27008":50621,"_2880":50726},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3394":752,"_29710":715,"_20617":50728,"_5":14139,"_27008":50621,"_2880":50729},[],"apply an explicit retention and legal hold policy;",{"_3394":753,"_29710":715,"_20617":50731,"_5":14139,"_27008":50621,"_2880":50732},[],"alert if it stops consuming or the pending queue grows.",{"_3394":754,"_29710":715,"_20617":50734,"_5":14139,"_27008":50625,"_2880":50735},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3394":755,"_29710":715,"_20617":50737,"_5":14139,"_27008":50625,"_2880":50738},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3394":756,"_29710":715,"_20617":50740,"_5":14139,"_27008":50633,"_2880":50741},[],"Start from the reported time and normalize every source to UTC.",{"_3394":757,"_29710":715,"_20617":50743,"_5":14139,"_27008":50637,"_2880":50744},[],"Filter by event type, service source and resource identifier.",{"_3394":758,"_29710":715,"_20617":50746,"_5":14139,"_27008":50641,"_2880":50747},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3394":759,"_29710":715,"_20617":50749,"_5":14139,"_27008":50645,"_2880":50750},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3394":760,"_29710":715,"_20617":50752,"_5":14139,"_27008":50649,"_2880":50753},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3394":761,"_29710":715,"_20617":50755,"_5":14139,"_27008":50653,"_2880":50756},[],"Generate a controlled mutation in a test environment and check that:",{"_3394":762,"_29710":715,"_20617":50758,"_5":14139,"_27008":50653,"_2880":50759},[],"a successful audit event appears;",{"_3394":763,"_29710":715,"_20617":50761,"_5":14139,"_27008":50653,"_2880":50762},[],"the principal matches the identity used;",{"_3394":764,"_29710":715,"_20617":50764,"_5":14139,"_27008":50653,"_2880":50765},[],"the consumer persists it exactly once;",{"_3394":765,"_29710":715,"_20617":50767,"_5":14139,"_27008":50653,"_2880":50768},[],"it can be retrieved by resource, actor and period;",{"_3394":766,"_29710":715,"_20617":50770,"_5":14139,"_27008":50653,"_2880":50771},[],"a consumer outage raises an alert.",{"_3394":767,"_29710":715,"_20617":50773,"_5":14139,"_27008":50653,"_2880":50774},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3394":768,"_29710":768,"_5":14491,"_2880":50776,"_30063":50777,"_20617":50778,"_27008":768},"Platform architecture",[48401,49869],[],{"_3394":769,"_29710":768,"_20617":50780,"_5":14139,"_27008":768,"_2880":50781},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3394":770,"_29710":768,"_5":30060,"_20617":50783,"_27008":50784,"_2880":50785},[],"/docs/pr-preview/pr-59/platform/concepts/architecture#control-plane","Control plane",{"_3394":771,"_29710":768,"_5":30060,"_20617":50787,"_27008":50788,"_2880":50789},[],"/docs/pr-preview/pr-59/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3394":772,"_29710":768,"_5":30060,"_20617":50791,"_27008":50792,"_2880":50793},[],"/docs/pr-preview/pr-59/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3394":773,"_29710":768,"_5":30060,"_20617":50795,"_27008":50796,"_2880":50797},[],"/docs/pr-preview/pr-59/platform/concepts/architecture#status-and-validation","Status and validation",{"_3394":774,"_29710":768,"_5":30060,"_20617":50799,"_27008":50800,"_2880":50801},[],"/docs/pr-preview/pr-59/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3394":775,"_29710":768,"_20617":50803,"_5":14139,"_27008":768,"_2880":50804},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3394":776,"_29710":768,"_20617":50806,"_5":14139,"_27008":768,"_2880":50807},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3394":777,"_29710":768,"_20617":50809,"_5":14139,"_27008":50784,"_2880":50810},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3394":778,"_29710":768,"_20617":50812,"_5":14139,"_27008":50788,"_2880":50813},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3394":779,"_29710":768,"_20617":50815,"_5":14139,"_27008":50792,"_2880":50816},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3394":780,"_29710":768,"_20617":50818,"_5":14139,"_27008":50796,"_2880":50819},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3394":781,"_29710":768,"_20617":50821,"_5":14139,"_27008":50800,"_2880":50822},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3394":782,"_29710":782,"_5":14491,"_2880":50824,"_30063":50825,"_20617":50826,"_27008":782},"How Lamassu works",[48401,49869],[],{"_3394":783,"_29710":782,"_20617":50828,"_5":14139,"_27008":782,"_2880":50829},[],"The mental model of trust, keys, certificates and devices.",{"_3394":784,"_29710":782,"_5":30060,"_20617":50831,"_27008":50832,"_2880":50833},[],"/docs/pr-preview/pr-59/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3394":785,"_29710":782,"_5":30060,"_20617":50835,"_27008":50836,"_2880":50837},[],"/docs/pr-preview/pr-59/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3394":786,"_29710":782,"_20617":50839,"_5":14139,"_27008":782,"_2880":50840},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3394":787,"_29710":782,"_20617":50842,"_5":14139,"_27008":50832,"_2880":50843},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3394":788,"_29710":782,"_20617":50845,"_5":14139,"_27008":50832,"_2880":50846},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3394":789,"_29710":782,"_20617":50848,"_5":14139,"_27008":50832,"_2880":50849},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3394":790,"_29710":782,"_20617":50851,"_5":14139,"_27008":50832,"_2880":50852},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3394":791,"_29710":782,"_20617":50854,"_5":14139,"_27008":50832,"_2880":50855},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3394":792,"_29710":782,"_20617":50857,"_5":14139,"_27008":50836,"_2880":50858},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3394":793,"_29710":782,"_20617":50860,"_5":14139,"_27008":50836,"_2880":50861},[],"A DMS relates that CA to an enrollment policy.",{"_3394":794,"_29710":782,"_20617":50863,"_5":14139,"_27008":50836,"_2880":50864},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3394":795,"_29710":782,"_20617":50866,"_5":14139,"_27008":50836,"_2880":50867},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3394":796,"_29710":782,"_20617":50869,"_5":14139,"_27008":50836,"_2880":50870},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3394":797,"_29710":782,"_20617":50872,"_5":14139,"_27008":50836,"_2880":50873},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3394":798,"_29710":782,"_20617":50875,"_5":14139,"_27008":50836,"_2880":50876},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3394":799,"_29710":799,"_5":14491,"_2880":50878,"_30063":50879,"_20617":50881,"_27008":799},"Devices and identities",[48401,49869,50880,50878],"IoT Fleets",[],{"_3394":800,"_29710":799,"_20617":50883,"_5":14139,"_27008":799,"_2880":50884},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3394":801,"_29710":799,"_5":30060,"_20617":50886,"_27008":50887,"_2880":50888},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#device-states","Device states",{"_3394":802,"_29710":799,"_5":30060,"_20617":50890,"_27008":50891,"_2880":50892},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3394":803,"_29710":799,"_5":30060,"_20617":50894,"_27008":50895,"_2880":50896},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3394":804,"_29710":799,"_5":30060,"_20617":50898,"_27008":50899,"_2880":50900},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3394":805,"_29710":799,"_5":30060,"_20617":50902,"_27008":50903,"_2880":50904},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3394":806,"_29710":799,"_5":30060,"_20617":50906,"_27008":50907,"_2880":50908},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3394":807,"_29710":799,"_5":30060,"_20617":50910,"_27008":50911,"_2880":50912},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3394":808,"_29710":799,"_5":30060,"_20617":50914,"_27008":50915,"_2880":50916},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3394":809,"_29710":799,"_5":30060,"_20617":50918,"_27008":50919,"_2880":50920},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3394":810,"_29710":799,"_5":30060,"_20617":50922,"_27008":50923,"_2880":50924},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3394":811,"_29710":799,"_5":30060,"_20617":50926,"_27008":50927,"_2880":50928},[],"/docs/pr-preview/pr-59/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3394":812,"_29710":799,"_20617":50930,"_5":14139,"_27008":799,"_2880":50931},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3394":813,"_29710":799,"_20617":50933,"_5":14139,"_27008":799,"_2880":50934},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3394":814,"_29710":799,"_20617":50936,"_5":14139,"_27008":50887,"_2880":50937},[],"Operational view",{"_3394":815,"_29710":799,"_20617":50939,"_5":14139,"_27008":50887,"_2880":50940},[],"Meaning",{"_3394":816,"_29710":799,"_20617":50942,"_5":14139,"_27008":50887,"_2880":50943},[],"**No Identity**",{"_3394":817,"_29710":799,"_20617":50945,"_5":14139,"_27008":50887,"_2880":50946},[],"A record exists without an associated identity.",{"_3394":818,"_29710":799,"_20617":50948,"_5":14139,"_27008":50887,"_2880":50949},[],"**Active**",{"_3394":819,"_29710":799,"_20617":50951,"_5":14139,"_27008":50887,"_2880":50952},[],"The slot is active; also check certificate dates, status and usages.",{"_3394":820,"_29710":799,"_20617":50954,"_5":14139,"_27008":50887,"_2880":50955},[],"**Renewal Pending**",{"_3394":821,"_29710":799,"_20617":50957,"_5":14139,"_27008":50887,"_2880":50958},[],"The identity is in the operational renewal window.",{"_3394":822,"_29710":799,"_20617":50960,"_5":14139,"_27008":50887,"_2880":50961},[],"**Expiring Soon**",{"_3394":823,"_29710":799,"_20617":50963,"_5":14139,"_27008":50887,"_2880":50964},[],"Expiration is approaching according to configured thresholds.",{"_3394":824,"_29710":799,"_20617":50966,"_5":14139,"_27008":50887,"_2880":50967},[],"**Expired**",{"_3394":825,"_29710":799,"_20617":50969,"_5":14139,"_27008":50887,"_2880":50970},[],"The identity has expired.",{"_3394":826,"_29710":799,"_20617":50972,"_5":14139,"_27008":50887,"_2880":50973},[],"**Revoked**",{"_3394":827,"_29710":799,"_20617":50975,"_5":14139,"_27008":50887,"_2880":50976},[],"The identity is marked revoked.",{"_3394":828,"_29710":799,"_20617":50978,"_5":14139,"_27008":50887,"_2880":50979},[],"**Decommissioned**",{"_3394":829,"_29710":799,"_20617":50981,"_5":14139,"_27008":50887,"_2880":50982},[],"The record is retired and ordinary updates do not restore operation.",{"_3394":830,"_29710":799,"_20617":50984,"_5":14139,"_27008":50887,"_2880":50985},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3394":831,"_29710":799,"_20617":50987,"_5":14139,"_27008":50891,"_2880":50988},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3394":832,"_29710":799,"_20617":50990,"_5":14139,"_27008":50891,"_2880":50991},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3394":833,"_29710":799,"_20617":50993,"_5":14139,"_27008":50891,"_2880":50994},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3394":834,"_29710":799,"_20617":50996,"_5":14139,"_27008":50891,"_2880":50997},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3394":835,"_29710":799,"_20617":50999,"_5":14139,"_27008":50895,"_2880":51000},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3394":836,"_29710":799,"_20617":51002,"_5":14139,"_27008":50899,"_2880":51003},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3394":837,"_29710":799,"_20617":51005,"_5":14139,"_27008":50903,"_2880":51006},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3394":838,"_29710":799,"_20617":51008,"_5":14139,"_27008":50907,"_2880":51009},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3394":839,"_29710":799,"_20617":51011,"_5":14139,"_27008":50911,"_2880":51012},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3394":840,"_29710":799,"_20617":51014,"_5":14139,"_27008":50911,"_2880":51015},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3394":841,"_29710":799,"_20617":51017,"_5":14139,"_27008":50915,"_2880":51018},[],"From **No Identity**, use **Assign Identity**:",{"_3394":842,"_29710":799,"_20617":51020,"_5":14139,"_27008":50915,"_2880":51021},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3394":843,"_29710":799,"_20617":51023,"_5":14139,"_27008":50915,"_2880":51024},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3394":844,"_29710":799,"_20617":51026,"_5":14139,"_27008":50915,"_2880":51027},[],"Confirm and read the serial, active version and history again.",{"_3394":845,"_29710":799,"_20617":51029,"_5":14139,"_27008":50915,"_2880":51030},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3394":846,"_29710":799,"_20617":51032,"_5":14139,"_27008":50915,"_2880":51033},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3394":847,"_29710":799,"_20617":51035,"_5":14139,"_27008":50919,"_2880":51036},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3394":848,"_29710":799,"_20617":51038,"_5":14139,"_27008":50919,"_2880":51039},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3394":849,"_29710":799,"_20617":51041,"_5":14139,"_27008":50923,"_2880":51042},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3394":850,"_29710":799,"_20617":51044,"_5":14139,"_27008":50923,"_2880":51045},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3394":851,"_29710":799,"_20617":51047,"_5":14139,"_27008":50923,"_2880":51048},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3394":852,"_29710":799,"_20617":51050,"_5":14139,"_27008":50923,"_2880":51051},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3394":853,"_29710":799,"_20617":51053,"_5":14139,"_27008":50927,"_2880":51054},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3394":854,"_29710":799,"_20617":51056,"_5":14139,"_27008":50927,"_2880":51057},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3394":855,"_29710":855,"_5":14491,"_2880":51059,"_30063":51060,"_20617":51062,"_27008":855},"Bootstrap identity and authentication",[48401,49869,50880,50878,51061],"Enrollment with PKI",[],{"_3394":856,"_29710":855,"_20617":51064,"_5":14139,"_27008":855,"_2880":51065},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3394":857,"_29710":855,"_5":30060,"_20617":51067,"_27008":51068,"_2880":51069},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3394":858,"_29710":855,"_5":30060,"_20617":51071,"_27008":51072,"_2880":51073},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3394":859,"_29710":855,"_5":30060,"_20617":51075,"_27008":51076,"_2880":51077},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3394":860,"_29710":855,"_5":30060,"_20617":51079,"_27008":51080,"_2880":51081},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3394":861,"_29710":855,"_5":30060,"_20617":51083,"_27008":51084,"_2880":51085},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3394":862,"_29710":855,"_20617":51087,"_5":14139,"_27008":855,"_2880":51088},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3394":863,"_29710":855,"_20617":51090,"_5":14139,"_27008":51068,"_2880":51091},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3394":864,"_29710":855,"_20617":51093,"_5":14139,"_27008":51068,"_2880":51094},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3394":865,"_29710":855,"_20617":51096,"_5":14139,"_27008":51072,"_2880":51097},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3394":866,"_29710":855,"_20617":51099,"_5":14139,"_27008":51072,"_2880":51100},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3394":867,"_29710":855,"_20617":51102,"_5":14139,"_27008":51072,"_2880":51103},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3394":868,"_29710":855,"_20617":51105,"_5":14139,"_27008":51076,"_2880":51106},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3394":869,"_29710":855,"_20617":51108,"_5":14139,"_27008":51076,"_2880":51109},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3394":870,"_29710":855,"_20617":51111,"_5":14139,"_27008":51080,"_2880":51112},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3394":871,"_29710":855,"_20617":51114,"_5":14139,"_27008":51080,"_2880":51115},[],"Example body:",{"_3394":872,"_29710":855,"_20617":51117,"_5":14139,"_27008":51080,"_2880":51118},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3394":873,"_29710":855,"_20617":51120,"_5":14139,"_27008":51080,"_2880":51121},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3394":874,"_29710":855,"_20617":51123,"_5":14139,"_27008":51080,"_2880":51124},[],"Continuation requires a successful HTTP response and JSON:",{"_3394":875,"_29710":855,"_20617":51126,"_5":14139,"_27008":51080,"_2880":51127},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3394":876,"_29710":855,"_20617":51129,"_5":14139,"_27008":51084,"_2880":51130},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3394":877,"_29710":855,"_20617":51132,"_5":14139,"_27008":51084,"_2880":51133},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3394":878,"_29710":878,"_5":14491,"_2880":51135,"_30063":51136,"_20617":51137,"_27008":878},"Configure and operate the DMS",[48401,49869,50880,50878,51061],[],{"_3394":879,"_29710":878,"_20617":51139,"_5":14139,"_27008":878,"_2880":51140},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3394":880,"_29710":878,"_5":30060,"_20617":51142,"_27008":51143,"_2880":48411},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3394":881,"_29710":878,"_5":30060,"_20617":51145,"_27008":51146,"_2880":51147},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3394":882,"_29710":878,"_5":30060,"_20617":51149,"_27008":51150,"_2880":51151},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3394":883,"_29710":878,"_5":30060,"_20617":51153,"_27008":51154,"_2880":51155},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3394":884,"_29710":878,"_5":30060,"_20617":51157,"_27008":51158,"_2880":51159},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3394":885,"_29710":878,"_5":30060,"_20617":51161,"_27008":51162,"_2880":51163},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3394":886,"_29710":878,"_5":30060,"_20617":51165,"_27008":51166,"_2880":51167},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3394":887,"_29710":878,"_5":30060,"_20617":51169,"_27008":51170,"_2880":51171},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3394":888,"_29710":878,"_5":30060,"_20617":51173,"_27008":51174,"_2880":51175},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3394":889,"_29710":878,"_5":30060,"_20617":51177,"_27008":51178,"_2880":51179},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3394":890,"_29710":878,"_5":30060,"_20617":51181,"_27008":51182,"_2880":51183},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3394":891,"_29710":878,"_5":30060,"_20617":51185,"_27008":51186,"_2880":51187},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3394":892,"_29710":878,"_5":30060,"_20617":51189,"_27008":51190,"_2880":51191},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3394":893,"_29710":878,"_5":30060,"_20617":51193,"_27008":51194,"_2880":51195},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3394":894,"_29710":878,"_5":30060,"_20617":51197,"_27008":51198,"_2880":51199},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3394":895,"_29710":878,"_5":30060,"_20617":51201,"_27008":51202,"_2880":51203},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3394":896,"_29710":878,"_5":30060,"_20617":51205,"_27008":51206,"_2880":51207},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3394":897,"_29710":878,"_5":30060,"_20617":51209,"_27008":51210,"_2880":51211},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3394":898,"_29710":878,"_20617":51213,"_5":14139,"_27008":878,"_2880":51214},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3394":899,"_29710":878,"_20617":51216,"_5":14139,"_27008":51143,"_2880":51217},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3394":900,"_29710":878,"_20617":51219,"_5":14139,"_27008":51143,"_2880":51220},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3394":901,"_29710":878,"_20617":51222,"_5":14139,"_27008":51150,"_2880":51223},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3394":902,"_29710":878,"_20617":51225,"_5":14139,"_27008":51154,"_2880":51226},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3394":903,"_29710":878,"_20617":51228,"_5":14139,"_27008":51158,"_2880":51229},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3394":904,"_29710":878,"_20617":51231,"_5":14139,"_27008":51162,"_2880":51232},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3394":905,"_29710":878,"_20617":51234,"_5":14139,"_27008":51166,"_2880":51235},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3394":906,"_29710":878,"_20617":51237,"_5":14139,"_27008":51174,"_2880":51238},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3394":907,"_29710":878,"_20617":51240,"_5":14139,"_27008":51174,"_2880":51241},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3394":908,"_29710":878,"_20617":51243,"_5":14139,"_27008":51178,"_2880":51244},[],"`settings.enrollment_settings` field",{"_3394":909,"_29710":878,"_20617":51246,"_5":14139,"_27008":51178,"_2880":51247},[],"Decision",{"_3394":910,"_29710":878,"_20617":51249,"_5":14139,"_27008":51178,"_2880":51250},[],"`protocol`",{"_3394":911,"_29710":878,"_20617":51252,"_5":14139,"_27008":51178,"_2880":51253},[],"`EST_RFC7030` for these operations.",{"_3394":912,"_29710":878,"_20617":51255,"_5":14139,"_27008":51178,"_2880":51256},[],"`enrollment_ca`",{"_3394":913,"_29710":878,"_20617":51258,"_5":14139,"_27008":51178,"_2880":51259},[],"ID of the signing CA.",{"_3394":914,"_29710":878,"_20617":51261,"_5":14139,"_27008":51178,"_2880":51262},[],"`verify_csr_signature`",{"_3394":915,"_29710":878,"_20617":51264,"_5":14139,"_27008":51178,"_2880":51265},[],"Keep `true` to verify CSR key possession.",{"_3394":916,"_29710":878,"_20617":51267,"_5":14139,"_27008":51178,"_2880":51268},[],"`enable_replaceable_enrollment`",{"_3394":917,"_29710":878,"_20617":51270,"_5":14139,"_27008":51178,"_2880":51271},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3394":918,"_29710":878,"_20617":51273,"_5":14139,"_27008":51178,"_2880":51274},[],"`est_rfc7030_settings.auth_mode`",{"_3394":919,"_29710":878,"_20617":51276,"_5":14139,"_27008":51178,"_2880":51277},[],"One of the four authentication modes.",{"_3394":920,"_29710":878,"_20617":51279,"_5":14139,"_27008":51178,"_2880":51280},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3394":921,"_29710":878,"_20617":51282,"_5":14139,"_27008":51182,"_2880":51283},[],"The blocks are independent:",{"_3394":922,"_29710":878,"_20617":51285,"_5":14139,"_27008":51182,"_2880":51286},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3394":923,"_29710":878,"_20617":51288,"_5":14139,"_27008":51182,"_2880":51289},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3394":924,"_29710":878,"_20617":51291,"_5":14139,"_27008":51182,"_2880":51292},[],"`auth_mode`",{"_3394":925,"_29710":878,"_20617":51294,"_5":14139,"_27008":51182,"_2880":51295},[],"Control applied in the configured operation",{"_3394":926,"_29710":878,"_20617":51297,"_5":14139,"_27008":51182,"_2880":51298},[],"`CLIENT_CERTIFICATE`",{"_3394":927,"_29710":878,"_20617":51300,"_5":14139,"_27008":51182,"_2880":51301},[],"Presented certificate validation.",{"_3394":928,"_29710":878,"_20617":51303,"_5":14139,"_27008":51182,"_2880":51304},[],"`EXTERNAL_WEBHOOK`",{"_3394":929,"_29710":878,"_20617":51306,"_5":14139,"_27008":51182,"_2880":51307},[],"Configured webhook authorization.",{"_3394":930,"_29710":878,"_20617":51309,"_5":14139,"_27008":51182,"_2880":51310},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3394":931,"_29710":878,"_20617":51312,"_5":14139,"_27008":51182,"_2880":51313},[],"Certificate validation followed by webhook approval.",{"_3394":932,"_29710":878,"_20617":51315,"_5":14139,"_27008":51182,"_2880":51316},[],"`NO_AUTH`",{"_3394":933,"_29710":878,"_20617":51318,"_5":14139,"_27008":51182,"_2880":51319},[],"No DMS requester authentication.",{"_3394":934,"_29710":878,"_20617":51321,"_5":14139,"_27008":51182,"_2880":51322},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3394":935,"_29710":878,"_20617":51324,"_5":14139,"_27008":51182,"_2880":51325},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3394":936,"_29710":878,"_20617":51327,"_5":14139,"_27008":51182,"_2880":51328},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3394":937,"_29710":878,"_20617":51330,"_5":14139,"_27008":51182,"_2880":51331},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3394":938,"_29710":878,"_20617":51333,"_5":14139,"_27008":51186,"_2880":51334},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3394":939,"_29710":878,"_20617":51336,"_5":14139,"_27008":51186,"_2880":51337},[],"`external_webhook_settings` field",{"_3394":940,"_29710":878,"_20617":51339,"_5":14139,"_27008":51186,"_2880":51247},[],{"_3394":941,"_29710":878,"_20617":51341,"_5":14139,"_27008":51186,"_2880":51342},[],"`url`",{"_3394":942,"_29710":878,"_20617":51344,"_5":14139,"_27008":51186,"_2880":51345},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3394":943,"_29710":878,"_20617":51347,"_5":14139,"_27008":51186,"_2880":51348},[],"`method`",{"_3394":944,"_29710":878,"_20617":51350,"_5":14139,"_27008":51186,"_2880":51351},[],"`POST` or `PUT`; `POST` by default.",{"_3394":945,"_29710":878,"_20617":51353,"_5":14139,"_27008":51186,"_2880":51354},[],"`name`",{"_3394":946,"_29710":878,"_20617":51356,"_5":14139,"_27008":51186,"_2880":51357},[],"Label used in service logs.",{"_3394":947,"_29710":878,"_20617":51359,"_5":14139,"_27008":51186,"_2880":51360},[],"`config.auth_mode`",{"_3394":948,"_29710":878,"_20617":51362,"_5":14139,"_27008":51186,"_2880":51363},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3394":949,"_29710":878,"_20617":51365,"_5":14139,"_27008":51186,"_2880":51366},[],"`config.log_level`",{"_3394":950,"_29710":878,"_20617":51368,"_5":14139,"_27008":51186,"_2880":51369},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3394":951,"_29710":878,"_20617":51371,"_5":14139,"_27008":51186,"_2880":51372},[],"`config.apikey_options`",{"_3394":952,"_29710":878,"_20617":51374,"_5":14139,"_27008":51186,"_2880":51375},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3394":953,"_29710":878,"_20617":51377,"_5":14139,"_27008":51186,"_2880":51378},[],"`config.jwt_options`",{"_3394":954,"_29710":878,"_20617":51380,"_5":14139,"_27008":51186,"_2880":51381},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3394":955,"_29710":878,"_20617":51383,"_5":14139,"_27008":51186,"_2880":51384},[],"`config.mtls_options`",{"_3394":956,"_29710":878,"_20617":51386,"_5":14139,"_27008":51186,"_2880":51387},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3394":957,"_29710":878,"_20617":51389,"_5":14139,"_27008":51186,"_2880":51390},[],"`config.insecure_skip_verify`",{"_3394":958,"_29710":878,"_20617":51392,"_5":14139,"_27008":51186,"_2880":51393},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3394":959,"_29710":878,"_20617":51395,"_5":14139,"_27008":51186,"_2880":51396},[],"`config.call_timeout`",{"_3394":960,"_29710":878,"_20617":51398,"_5":14139,"_27008":51186,"_2880":51399},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3394":961,"_29710":878,"_20617":51401,"_5":14139,"_27008":51186,"_2880":51402},[],"Rules for that configuration:",{"_3394":962,"_29710":878,"_20617":51404,"_5":14139,"_27008":51186,"_2880":51405},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3394":963,"_29710":878,"_20617":51407,"_5":14139,"_27008":51186,"_2880":51408},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3394":964,"_29710":878,"_20617":51410,"_5":14139,"_27008":51186,"_2880":51411},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3394":965,"_29710":878,"_20617":51413,"_5":14139,"_27008":51186,"_2880":51414},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3394":966,"_29710":878,"_20617":51416,"_5":14139,"_27008":51186,"_2880":51417},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3394":967,"_29710":878,"_20617":51419,"_5":14139,"_27008":51186,"_2880":51420},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3394":968,"_29710":878,"_20617":51422,"_5":14139,"_27008":51186,"_2880":51423},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3394":969,"_29710":878,"_20617":51425,"_5":14139,"_27008":51186,"_2880":51426},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3394":970,"_29710":878,"_20617":51428,"_5":14139,"_27008":51186,"_2880":51429},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3394":971,"_29710":878,"_20617":51431,"_5":14139,"_27008":51190,"_2880":51432},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3394":972,"_29710":878,"_20617":51434,"_5":14139,"_27008":51194,"_2880":51435},[],"`settings.reenrollment_settings` field",{"_3394":973,"_29710":878,"_20617":51437,"_5":14139,"_27008":51194,"_2880":48791},[],{"_3394":974,"_29710":878,"_20617":51439,"_5":14139,"_27008":51194,"_2880":51440},[],"`reenrollment_delta`",{"_3394":975,"_29710":878,"_20617":51442,"_5":14139,"_27008":51194,"_2880":51443},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3394":976,"_29710":878,"_20617":51445,"_5":14139,"_27008":51194,"_2880":51446},[],"`preventive_delta`",{"_3394":977,"_29710":878,"_20617":51448,"_5":14139,"_27008":51194,"_2880":51449},[],"Preventive operational monitoring threshold.",{"_3394":978,"_29710":878,"_20617":51451,"_5":14139,"_27008":51194,"_2880":51452},[],"`critical_delta`",{"_3394":979,"_29710":878,"_20617":51454,"_5":14139,"_27008":51194,"_2880":51455},[],"Critical operational monitoring threshold.",{"_3394":980,"_29710":878,"_20617":51457,"_5":14139,"_27008":51194,"_2880":51458},[],"`enable_expired_renewal`",{"_3394":981,"_29710":878,"_20617":51460,"_5":14139,"_27008":51194,"_2880":51461},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3394":982,"_29710":878,"_20617":51463,"_5":14139,"_27008":51194,"_2880":51464},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3394":983,"_29710":878,"_20617":51466,"_5":14139,"_27008":51194,"_2880":51467},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3394":984,"_29710":878,"_20617":51469,"_5":14139,"_27008":51194,"_2880":51470},[],"`revoke_on_reenrollment`",{"_3394":985,"_29710":878,"_20617":51472,"_5":14139,"_27008":51194,"_2880":51473},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3394":986,"_29710":878,"_20617":51475,"_5":14139,"_27008":51194,"_2880":51476},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3394":987,"_29710":878,"_20617":51478,"_5":14139,"_27008":51198,"_2880":51479},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3394":988,"_29710":878,"_20617":51481,"_5":14139,"_27008":51202,"_2880":48785},[],{"_3394":989,"_29710":878,"_20617":51483,"_5":14139,"_27008":51202,"_2880":51484},[],"Published material",{"_3394":990,"_29710":878,"_20617":51486,"_5":14139,"_27008":51202,"_2880":51487},[],"**Include Lamassu System CA**",{"_3394":991,"_29710":878,"_20617":51489,"_5":14139,"_27008":51202,"_2880":51490},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3394":992,"_29710":878,"_20617":51492,"_5":14139,"_27008":51202,"_2880":51493},[],"**Include Enrollment CA**",{"_3394":993,"_29710":878,"_20617":51495,"_5":14139,"_27008":51202,"_2880":51496},[],"Selected issuing CA certificate.",{"_3394":994,"_29710":878,"_20617":51498,"_5":14139,"_27008":51202,"_2880":51499},[],"**Managed CAs**",{"_3394":995,"_29710":878,"_20617":51501,"_5":14139,"_27008":51202,"_2880":51502},[],"Explicitly selected CA certificates.",{"_3394":996,"_29710":878,"_20617":51504,"_5":14139,"_27008":51202,"_2880":51505},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3394":997,"_29710":878,"_20617":51507,"_5":14139,"_27008":51206,"_2880":51508},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3394":998,"_29710":878,"_20617":51510,"_5":14139,"_27008":51206,"_2880":51511},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3394":999,"_29710":878,"_20617":51513,"_5":14139,"_27008":51206,"_2880":51514},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3394":1000,"_29710":878,"_20617":51516,"_5":14139,"_27008":51210,"_2880":51517},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3394":1001,"_29710":1001,"_5":14491,"_2880":51519,"_30063":51520,"_20617":51521,"_27008":1001},"Integrate the EST client",[48401,49869,50880,50878,51061],[],{"_3394":1002,"_29710":1001,"_20617":51523,"_5":14139,"_27008":1001,"_2880":51524},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3394":1003,"_29710":1001,"_5":30060,"_20617":51526,"_27008":51527,"_2880":48411},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3394":1004,"_29710":1001,"_5":30060,"_20617":51529,"_27008":51530,"_2880":51531},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3394":1005,"_29710":1001,"_5":30060,"_20617":51533,"_27008":51534,"_2880":51535},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3394":1006,"_29710":1001,"_5":30060,"_20617":51537,"_27008":51538,"_2880":51539},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3394":1007,"_29710":1001,"_5":30060,"_20617":51541,"_27008":51542,"_2880":51543},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3394":1008,"_29710":1001,"_5":30060,"_20617":51545,"_27008":51546,"_2880":51547},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3394":1009,"_29710":1001,"_20617":51549,"_5":14139,"_27008":1001,"_2880":51550},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3394":1010,"_29710":1001,"_20617":51552,"_5":14139,"_27008":51527,"_2880":51553},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3394":1011,"_29710":1001,"_20617":51555,"_5":14139,"_27008":51527,"_2880":51556},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3394":1012,"_29710":1001,"_20617":51558,"_5":14139,"_27008":51527,"_2880":51559},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3394":1013,"_29710":1001,"_20617":51561,"_5":14139,"_27008":51530,"_2880":51562},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3394":1014,"_29710":1001,"_20617":51564,"_5":14139,"_27008":51530,"_2880":51565},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3394":1015,"_29710":1001,"_20617":51567,"_5":14139,"_27008":51534,"_2880":51568},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3394":1016,"_29710":1001,"_20617":51570,"_5":14139,"_27008":51534,"_2880":51571},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3394":1017,"_29710":1001,"_20617":51573,"_5":14139,"_27008":51538,"_2880":51574},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3394":1018,"_29710":1001,"_20617":51576,"_5":14139,"_27008":51538,"_2880":51577},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3394":1019,"_29710":1001,"_20617":51579,"_5":14139,"_27008":51542,"_2880":51580},[],"For a root that issues directly:",{"_3394":1020,"_29710":1001,"_20617":51582,"_5":14139,"_27008":51542,"_2880":51583},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3394":1021,"_29710":1001,"_20617":51585,"_5":14139,"_27008":51542,"_2880":51586},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3394":1022,"_29710":1001,"_20617":51588,"_5":14139,"_27008":51546,"_2880":51589},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3394":1023,"_29710":1023,"_5":14491,"_2880":51591,"_30063":51592,"_20617":51593,"_27008":1023},"EST reference",[48401,49869,50880,50878,51061],[],{"_3394":1024,"_29710":1023,"_20617":51595,"_5":14139,"_27008":1023,"_2880":51596},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3394":1025,"_29710":1023,"_5":30060,"_20617":51598,"_27008":51599,"_2880":51600},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3394":1026,"_29710":1023,"_5":30060,"_20617":51602,"_27008":51603,"_2880":22340},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3394":1027,"_29710":1023,"_5":30060,"_20617":51605,"_27008":51606,"_2880":25638},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3394":1028,"_29710":1023,"_5":30060,"_20617":51608,"_27008":51609,"_2880":25645},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3394":1029,"_29710":1023,"_5":30060,"_20617":51611,"_27008":51612,"_2880":24968},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3394":1030,"_29710":1023,"_5":30060,"_20617":51614,"_27008":51615,"_2880":51616},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3394":1031,"_29710":1023,"_5":30060,"_20617":51618,"_27008":51619,"_2880":51620},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3394":1032,"_29710":1023,"_5":30060,"_20617":51622,"_27008":51623,"_2880":51624},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3394":1033,"_29710":1023,"_20617":51626,"_5":14139,"_27008":1023,"_2880":51627},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3394":1034,"_29710":1023,"_20617":51629,"_5":14139,"_27008":51599,"_2880":51630},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3394":1035,"_29710":1023,"_20617":51632,"_5":14139,"_27008":51599,"_2880":51633},[],"Operation",{"_3394":1036,"_29710":1023,"_20617":51635,"_5":14139,"_27008":51599,"_2880":51636},[],"Method",{"_3394":1037,"_29710":1023,"_20617":51638,"_5":14139,"_27008":51599,"_2880":51639},[],"Authentication and condition",{"_3394":1038,"_29710":1023,"_20617":51641,"_5":14139,"_27008":51599,"_2880":51642},[],"`/cacerts`",{"_3394":1039,"_29710":1023,"_20617":51644,"_5":14139,"_27008":51599,"_2880":51645},[],"GET",{"_3394":1040,"_29710":1023,"_20617":51647,"_5":14139,"_27008":51599,"_2880":51648},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3394":1041,"_29710":1023,"_20617":51650,"_5":14139,"_27008":51599,"_2880":51651},[],"`/simpleenroll`",{"_3394":1042,"_29710":1023,"_20617":51653,"_5":14139,"_27008":51599,"_2880":51654},[],"POST",{"_3394":1043,"_29710":1023,"_20617":51656,"_5":14139,"_27008":51599,"_2880":51657},[],"Initial authentication and DMS registration/replacement policy.",{"_3394":1044,"_29710":1023,"_20617":51659,"_5":14139,"_27008":51599,"_2880":51660},[],"`/simplereenroll`",{"_3394":1045,"_29710":1023,"_20617":51662,"_5":14139,"_27008":51599,"_2880":51654},[],{"_3394":1046,"_29710":1023,"_20617":51664,"_5":14139,"_27008":51599,"_2880":51665},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3394":1047,"_29710":1023,"_20617":51667,"_5":14139,"_27008":51599,"_2880":51668},[],"`/serverkeygen`",{"_3394":1048,"_29710":1023,"_20617":51670,"_5":14139,"_27008":51599,"_2880":51654},[],{"_3394":1049,"_29710":1023,"_20617":51672,"_5":14139,"_27008":51599,"_2880":51673},[],"Initial authentication and admission; server generation enabled.",{"_3394":1050,"_29710":1023,"_20617":51675,"_5":14139,"_27008":51599,"_2880":51676},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3394":1051,"_29710":1023,"_20617":51678,"_5":14139,"_27008":51603,"_2880":51679},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3394":1052,"_29710":1023,"_20617":51681,"_5":14139,"_27008":51603,"_2880":51682},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3394":1053,"_29710":1023,"_20617":51684,"_5":14139,"_27008":51606,"_2880":51685},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3394":1054,"_29710":1023,"_20617":51687,"_5":14139,"_27008":51606,"_2880":51688},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3394":1055,"_29710":1023,"_20617":51690,"_5":14139,"_27008":51609,"_2880":51691},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3394":1056,"_29710":1023,"_20617":51693,"_5":14139,"_27008":51609,"_2880":51694},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3394":1057,"_29710":1023,"_20617":51696,"_5":14139,"_27008":51612,"_2880":51697},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3394":1058,"_29710":1023,"_20617":51699,"_5":14139,"_27008":51612,"_2880":51700},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3394":1059,"_29710":1023,"_20617":51702,"_5":14139,"_27008":51615,"_2880":51703},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3394":1060,"_29710":1023,"_20617":51705,"_5":14139,"_27008":51615,"_2880":51706},[],"Part",{"_3394":1061,"_29710":1023,"_20617":51708,"_5":14139,"_27008":51615,"_2880":51709},[],"Content after decoding its Base64",{"_3394":1062,"_29710":1023,"_20617":51711,"_5":14139,"_27008":51615,"_2880":51712},[],"`application/pkcs8`",{"_3394":1063,"_29710":1023,"_20617":51714,"_5":14139,"_27008":51615,"_2880":51715},[],"Unencrypted DER PKCS#8 private key.",{"_3394":1064,"_29710":1023,"_20617":51717,"_5":14139,"_27008":51615,"_2880":51718},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3394":1065,"_29710":1023,"_20617":51720,"_5":14139,"_27008":51615,"_2880":51721},[],"DER PKCS#7 containing the issued certificate.",{"_3394":1066,"_29710":1023,"_20617":51723,"_5":14139,"_27008":51615,"_2880":51724},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3394":1067,"_29710":1023,"_20617":51726,"_5":14139,"_27008":51619,"_2880":51727},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3394":1068,"_29710":1023,"_20617":51729,"_5":14139,"_27008":51619,"_2880":51730},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3394":1069,"_29710":1023,"_20617":51732,"_5":14139,"_27008":51619,"_2880":51733},[],"Convert and check the result:",{"_3394":1070,"_29710":1023,"_20617":51735,"_5":14139,"_27008":51619,"_2880":51736},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3394":1071,"_29710":1023,"_20617":51738,"_5":14139,"_27008":51623,"_2880":51739},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3394":1072,"_29710":1023,"_20617":51741,"_5":14139,"_27008":51623,"_2880":51742},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3394":1073,"_29710":1073,"_5":14491,"_2880":51061,"_30063":51744,"_20617":51745,"_27008":1073},[48401,49869,50880,50878,51061],[],{"_3394":1074,"_29710":1073,"_20617":51747,"_5":14139,"_27008":1073,"_2880":51748},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3394":1075,"_29710":1073,"_5":30060,"_20617":51750,"_27008":51751,"_2880":51752},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3394":1076,"_29710":1073,"_5":30060,"_20617":51754,"_27008":51755,"_2880":51756},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3394":1077,"_29710":1073,"_5":30060,"_20617":51758,"_27008":51759,"_2880":51760},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3394":1078,"_29710":1073,"_5":30060,"_20617":51762,"_27008":51763,"_2880":51764},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3394":1079,"_29710":1073,"_20617":51766,"_5":14139,"_27008":1073,"_2880":51767},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3394":1080,"_29710":1073,"_20617":51769,"_5":14139,"_27008":51751,"_2880":51770},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3394":1081,"_29710":1073,"_20617":51772,"_5":14139,"_27008":51751,"_2880":51773},[],"The integrator installs initial EST server trust and an admission credential.",{"_3394":1082,"_29710":1073,"_20617":51775,"_5":14139,"_27008":51751,"_2880":51776},[],"The client requests an identity for its `Device ID` through EST.",{"_3394":1083,"_29710":1073,"_20617":51778,"_5":14139,"_27008":51751,"_2880":51779},[],"Certificate, device binding and key/certificate installation are checked.",{"_3394":1084,"_29710":1073,"_20617":51781,"_5":14139,"_27008":51751,"_2880":51782},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3394":1085,"_29710":1073,"_20617":51784,"_5":14139,"_27008":51751,"_2880":51785},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3394":1086,"_29710":1073,"_20617":51787,"_5":14139,"_27008":51755,"_2880":51788},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3394":1087,"_29710":1073,"_20617":51790,"_5":14139,"_27008":51755,"_2880":51791},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3394":1088,"_29710":1073,"_20617":51793,"_5":14139,"_27008":51755,"_2880":51794},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3394":1089,"_29710":1073,"_20617":51796,"_5":14139,"_27008":51755,"_2880":51797},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3394":1090,"_29710":1073,"_20617":51799,"_5":14139,"_27008":51759,"_2880":51800},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3394":1091,"_29710":1073,"_20617":51802,"_5":14139,"_27008":51759,"_2880":51803},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3394":1092,"_29710":1073,"_20617":51805,"_5":14139,"_27008":51759,"_2880":51806},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3394":1093,"_29710":1073,"_20617":51808,"_5":14139,"_27008":51759,"_2880":51809},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3394":1094,"_29710":1073,"_20617":51811,"_5":14139,"_27008":51763,"_2880":51812},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3394":1095,"_29710":1073,"_20617":51814,"_5":14139,"_27008":51763,"_2880":51815},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3394":1096,"_29710":1096,"_5":14491,"_2880":51817,"_30063":51818,"_20617":51819,"_27008":1096},"Provisioning strategies",[48401,49869,50880,50878,51061],[],{"_3394":1097,"_29710":1096,"_20617":51821,"_5":14139,"_27008":1096,"_2880":51822},[],"Choose device registration, identity authorization and key generation.",{"_3394":1098,"_29710":1096,"_5":30060,"_20617":51824,"_27008":51825,"_2880":51826},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3394":1099,"_29710":1096,"_5":30060,"_20617":51828,"_27008":51829,"_2880":51830},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3394":1100,"_29710":1096,"_5":30060,"_20617":51832,"_27008":51833,"_2880":51834},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3394":1101,"_29710":1096,"_5":30060,"_20617":51836,"_27008":51837,"_2880":51838},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3394":1102,"_29710":1096,"_5":30060,"_20617":51840,"_27008":51841,"_2880":51842},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3394":1103,"_29710":1096,"_20617":51844,"_5":14139,"_27008":1096,"_2880":51845},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3394":1104,"_29710":1096,"_20617":51847,"_5":14139,"_27008":51825,"_2880":51848},[],"Path",{"_3394":1105,"_29710":1096,"_20617":51850,"_5":14139,"_27008":51825,"_2880":51851},[],"When the device exists",{"_3394":1106,"_29710":1096,"_20617":51853,"_5":14139,"_27008":51825,"_2880":51854},[],"What to check",{"_3394":1107,"_29710":1096,"_20617":51856,"_5":14139,"_27008":51825,"_2880":51857},[],"Manual assignment",{"_3394":1108,"_29710":1096,"_20617":51859,"_5":14139,"_27008":51825,"_2880":51860},[],"An operator creates it before associating a certificate.",{"_3394":1109,"_29710":1096,"_20617":51862,"_5":14139,"_27008":51825,"_2880":51863},[],"ID, owning DMS, certificate CN and bound serial.",{"_3394":1110,"_29710":1096,"_20617":51865,"_5":14139,"_27008":51825,"_2880":51866},[],"EST with `JITP`",{"_3394":1111,"_29710":1096,"_20617":51868,"_5":14139,"_27008":51825,"_2880":51869},[],"Created for an unknown CN during `/simpleenroll`.",{"_3394":1112,"_29710":1096,"_20617":51871,"_5":14139,"_27008":51825,"_2880":51872},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3394":1113,"_29710":1096,"_20617":51874,"_5":14139,"_27008":51825,"_2880":51875},[],"EST with `PRE_REGISTRATION`",{"_3394":1114,"_29710":1096,"_20617":51877,"_5":14139,"_27008":51825,"_2880":51878},[],"Must exist before `/simpleenroll`.",{"_3394":1115,"_29710":1096,"_20617":51880,"_5":14139,"_27008":51825,"_2880":51881},[],"Approved record, same DMS and replacement conditions for your version.",{"_3394":1116,"_29710":1096,"_20617":51883,"_5":14139,"_27008":51825,"_2880":51884},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3394":1117,"_29710":1096,"_20617":51886,"_5":14139,"_27008":51825,"_2880":51887},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3394":1118,"_29710":1096,"_20617":51889,"_5":14139,"_27008":51829,"_2880":51890},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3394":1119,"_29710":1096,"_20617":51892,"_5":14139,"_27008":51829,"_2880":51893},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3394":1120,"_29710":1096,"_20617":51895,"_5":14139,"_27008":51829,"_2880":51896},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3394":1121,"_29710":1096,"_20617":51898,"_5":14139,"_27008":51833,"_2880":51899},[],"Decide initial enrollment and re-enrollment separately:",{"_3394":1122,"_29710":1096,"_20617":51901,"_5":14139,"_27008":51833,"_2880":51902},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3394":1123,"_29710":1096,"_20617":51904,"_5":14139,"_27008":51833,"_2880":51905},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3394":1124,"_29710":1096,"_20617":51907,"_5":14139,"_27008":51833,"_2880":51908},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3394":1125,"_29710":1096,"_20617":51910,"_5":14139,"_27008":51833,"_2880":51911},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3394":1126,"_29710":1096,"_20617":51913,"_5":14139,"_27008":51833,"_2880":51914},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3394":1127,"_29710":1096,"_20617":51916,"_5":14139,"_27008":51837,"_2880":48785},[],{"_3394":1128,"_29710":1096,"_20617":51918,"_5":14139,"_27008":51837,"_2880":51919},[],"Material crossing EST",{"_3394":1129,"_29710":1096,"_20617":51921,"_5":14139,"_27008":51837,"_2880":51922},[],"Device-generated key",{"_3394":1130,"_29710":1096,"_20617":51924,"_5":14139,"_27008":51837,"_2880":51925},[],"Public CSR and certificate; the key stays on the client.",{"_3394":1131,"_29710":1096,"_20617":51927,"_5":14139,"_27008":51837,"_2880":51928},[],"Existing device key",{"_3394":1132,"_29710":1096,"_20617":51930,"_5":14139,"_27008":51837,"_2880":51931},[],"CSR signed with that key and a new certificate.",{"_3394":1133,"_29710":1096,"_20617":51933,"_5":14139,"_27008":51837,"_2880":51199},[],{"_3394":1134,"_29710":1096,"_20617":51935,"_5":14139,"_27008":51837,"_2880":51936},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3394":1135,"_29710":1096,"_20617":51938,"_5":14139,"_27008":51837,"_2880":51939},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3394":1136,"_29710":1096,"_20617":51941,"_5":14139,"_27008":51841,"_2880":51942},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3394":1137,"_29710":1137,"_5":14491,"_2880":51944,"_30063":51945,"_20617":51946,"_27008":1137},"Renewal and recovery",[48401,49869,50880,50878,51061],[],{"_3394":1138,"_29710":1137,"_20617":51948,"_5":14139,"_27008":1137,"_2880":51949},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3394":1139,"_29710":1137,"_5":30060,"_20617":51951,"_27008":51952,"_2880":51953},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3394":1140,"_29710":1137,"_5":30060,"_20617":51955,"_27008":51956,"_2880":51957},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3394":1141,"_29710":1137,"_5":30060,"_20617":51959,"_27008":51960,"_2880":51961},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3394":1142,"_29710":1137,"_5":30060,"_20617":51963,"_27008":51964,"_2880":51965},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3394":1143,"_29710":1137,"_5":30060,"_20617":51967,"_27008":51968,"_2880":51969},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3394":1144,"_29710":1137,"_20617":51971,"_5":14139,"_27008":1137,"_2880":51972},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3394":1145,"_29710":1137,"_20617":51974,"_5":14139,"_27008":51952,"_2880":51975},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3394":1146,"_29710":1137,"_20617":51977,"_5":14139,"_27008":51952,"_2880":51978},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3394":1147,"_29710":1137,"_20617":51980,"_5":14139,"_27008":51952,"_2880":51981},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3394":1148,"_29710":1137,"_20617":51983,"_5":14139,"_27008":51952,"_2880":51984},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3394":1149,"_29710":1137,"_20617":51986,"_5":14139,"_27008":51956,"_2880":51987},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3394":1150,"_29710":1137,"_20617":51989,"_5":14139,"_27008":51956,"_2880":51990},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3394":1151,"_29710":1137,"_20617":51992,"_5":14139,"_27008":51960,"_2880":51993},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3394":1152,"_29710":1137,"_20617":51995,"_5":14139,"_27008":51960,"_2880":51996},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3394":1153,"_29710":1137,"_20617":51998,"_5":14139,"_27008":51960,"_2880":51999},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3394":1154,"_29710":1137,"_20617":52001,"_5":14139,"_27008":51964,"_2880":52002},[],"Situation",{"_3394":1155,"_29710":1137,"_20617":52004,"_5":14139,"_27008":51964,"_2880":52005},[],"Procedure",{"_3394":1156,"_29710":1137,"_20617":52007,"_5":14139,"_27008":51964,"_2880":52008},[],"Valid certificate, outside the window",{"_3394":1157,"_29710":1137,"_20617":52010,"_5":14139,"_27008":51964,"_2880":52011},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3394":1158,"_29710":1137,"_20617":52013,"_5":14139,"_27008":51964,"_2880":52014},[],"Expired certificate, key available",{"_3394":1159,"_29710":1137,"_20617":52016,"_5":14139,"_27008":51964,"_2880":52017},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3394":1160,"_29710":1137,"_20617":52019,"_5":14139,"_27008":51964,"_2880":52020},[],"Renewal through webhook or `NO_AUTH`",{"_3394":1161,"_29710":1137,"_20617":52022,"_5":14139,"_27008":51964,"_2880":52023},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3394":1162,"_29710":1137,"_20617":52025,"_5":14139,"_27008":51964,"_2880":52026},[],"Lost or inaccessible key",{"_3394":1163,"_29710":1137,"_20617":52028,"_5":14139,"_27008":51964,"_2880":52029},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3394":1164,"_29710":1137,"_20617":52031,"_5":14139,"_27008":51964,"_2880":52032},[],"Current identity revoked",{"_3394":1165,"_29710":1137,"_20617":52034,"_5":14139,"_27008":51964,"_2880":52035},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3394":1166,"_29710":1137,"_20617":52037,"_5":14139,"_27008":51964,"_2880":52038},[],"Device without an identity",{"_3394":1167,"_29710":1137,"_20617":52040,"_5":14139,"_27008":51964,"_2880":52041},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3394":1168,"_29710":1137,"_20617":52043,"_5":14139,"_27008":51964,"_2880":52044},[],"Retired device",{"_3394":1169,"_29710":1137,"_20617":52046,"_5":14139,"_27008":51964,"_2880":52047},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3394":1170,"_29710":1137,"_20617":52049,"_5":14139,"_27008":51964,"_2880":52050},[],"Timeout, HTTP 500 or installation failure",{"_3394":1171,"_29710":1137,"_20617":52052,"_5":14139,"_27008":51964,"_2880":52053},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3394":1172,"_29710":1137,"_20617":52055,"_5":14139,"_27008":51968,"_2880":52056},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3394":1173,"_29710":1137,"_20617":52058,"_5":14139,"_27008":51968,"_2880":52059},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3394":1174,"_29710":1174,"_5":14491,"_2880":52061,"_30063":52062,"_20617":52063,"_27008":1174},"Enrollment troubleshooting",[48401,49869,50880,50878,51061],[],{"_3394":1175,"_29710":1174,"_20617":52065,"_5":14139,"_27008":1174,"_2880":52066},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3394":1176,"_29710":1174,"_5":30060,"_20617":52068,"_27008":52069,"_2880":52070},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3394":1177,"_29710":1174,"_5":30060,"_20617":52072,"_27008":52073,"_2880":52074},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3394":1178,"_29710":1174,"_5":30060,"_20617":52076,"_27008":52077,"_2880":51624},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3394":1179,"_29710":1174,"_5":30060,"_20617":52079,"_27008":52080,"_2880":52081},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3394":1180,"_29710":1174,"_20617":52083,"_5":14139,"_27008":1174,"_2880":52084},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3394":1181,"_29710":1174,"_20617":52086,"_5":14139,"_27008":52073,"_2880":52087},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3394":1182,"_29710":1174,"_20617":52089,"_5":14139,"_27008":52073,"_2880":52090},[],"Symptom or message",{"_3394":1183,"_29710":1174,"_20617":52092,"_5":14139,"_27008":52073,"_2880":51854},[],{"_3394":1184,"_29710":1174,"_20617":52094,"_5":14139,"_27008":52073,"_2880":52095},[],"curl rejects TLS, name or issuer",{"_3394":1185,"_29710":1174,"_20617":52097,"_5":14139,"_27008":52073,"_2880":52098},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3394":1186,"_29710":1174,"_20617":52100,"_5":14139,"_27008":52073,"_2880":52101},[],"404 or missing APS",{"_3394":1187,"_29710":1174,"_20617":52103,"_5":14139,"_27008":52073,"_2880":52104},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3394":1188,"_29710":1174,"_20617":52106,"_5":14139,"_27008":52073,"_2880":52107},[],"400, CSR or format error",{"_3394":1189,"_29710":1174,"_20617":52109,"_5":14139,"_27008":52073,"_2880":52110},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3394":1190,"_29710":1174,"_20617":52112,"_5":14139,"_27008":52073,"_2880":52113},[],"Missing credential or invalid certificate",{"_3394":1191,"_29710":1174,"_20617":52115,"_5":14139,"_27008":52073,"_2880":52116},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3394":1192,"_29710":1174,"_20617":52118,"_5":14139,"_27008":52073,"_2880":52119},[],"Webhook denies, times out or responds without authorization",{"_3394":1193,"_29710":1174,"_20617":52121,"_5":14139,"_27008":52073,"_2880":52122},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3394":1194,"_29710":1174,"_20617":52124,"_5":14139,"_27008":52073,"_2880":52125},[],"`unexpected status code: <n>: redirects are not followed`",{"_3394":1195,"_29710":1174,"_20617":52127,"_5":14139,"_27008":52073,"_2880":52128},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3394":1196,"_29710":1174,"_20617":52130,"_5":14139,"_27008":52073,"_2880":52131},[],"`webhook response exceeds 1048576 bytes`",{"_3394":1197,"_29710":1174,"_20617":52133,"_5":14139,"_27008":52073,"_2880":52134},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3394":1198,"_29710":1174,"_20617":52136,"_5":14139,"_27008":52073,"_2880":52137},[],"`webhook config must not reference files`",{"_3394":1199,"_29710":1174,"_20617":52139,"_5":14139,"_27008":52073,"_2880":52140},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3394":1200,"_29710":1174,"_20617":52142,"_5":14139,"_27008":52073,"_2880":52143},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3394":1201,"_29710":1174,"_20617":52145,"_5":14139,"_27008":52073,"_2880":52146},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3394":1202,"_29710":1174,"_20617":52148,"_5":14139,"_27008":52073,"_2880":52149},[],"`webhook mTLS certificate and key are invalid: …`",{"_3394":1203,"_29710":1174,"_20617":52151,"_5":14139,"_27008":52073,"_2880":52152},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3394":1204,"_29710":1174,"_20617":52154,"_5":14139,"_27008":52073,"_2880":52155},[],"400 `struct validation error` creating or updating a DMS",{"_3394":1205,"_29710":1174,"_20617":52157,"_5":14139,"_27008":52073,"_2880":52158},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3394":1206,"_29710":1174,"_20617":52160,"_5":14139,"_27008":52073,"_2880":52161},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3394":1207,"_29710":1174,"_20617":52163,"_5":14139,"_27008":52073,"_2880":52164},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3394":1208,"_29710":1174,"_20617":52166,"_5":14139,"_27008":52073,"_2880":52167},[],"`device not preregistered`",{"_3394":1209,"_29710":1174,"_20617":52169,"_5":14139,"_27008":52073,"_2880":52170},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3394":1210,"_29710":1174,"_20617":52172,"_5":14139,"_27008":52073,"_2880":52173},[],"`forbiddenNewEnrollment`",{"_3394":1211,"_29710":1174,"_20617":52175,"_5":14139,"_27008":52073,"_2880":52176},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3394":1212,"_29710":1174,"_20617":52178,"_5":14139,"_27008":52073,"_2880":52179},[],"Different owning DMS",{"_3394":1213,"_29710":1174,"_20617":52181,"_5":14139,"_27008":52073,"_2880":52182},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3394":1214,"_29710":1174,"_20617":52184,"_5":14139,"_27008":52073,"_2880":52185},[],"`invalid RawSubject bytes`",{"_3394":1215,"_29710":1174,"_20617":52187,"_5":14139,"_27008":52073,"_2880":52188},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3394":1216,"_29710":1174,"_20617":52190,"_5":14139,"_27008":52073,"_2880":52191},[],"`invalid reenroll window`",{"_3394":1217,"_29710":1174,"_20617":52193,"_5":14139,"_27008":52073,"_2880":52194},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3394":1218,"_29710":1174,"_20617":52196,"_5":14139,"_27008":52073,"_2880":52197},[],"Current certificate revoked",{"_3394":1219,"_29710":1174,"_20617":52199,"_5":14139,"_27008":52073,"_2880":52200},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3394":1220,"_29710":1174,"_20617":52202,"_5":14139,"_27008":52073,"_2880":52203},[],"CA, profile or signing error",{"_3394":1221,"_29710":1174,"_20617":52205,"_5":14139,"_27008":52073,"_2880":52206},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3394":1222,"_29710":1174,"_20617":52208,"_5":14139,"_27008":52073,"_2880":52209},[],"HTTP 200 without a device connection",{"_3394":1223,"_29710":1174,"_20617":52211,"_5":14139,"_27008":52073,"_2880":52212},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3394":1224,"_29710":1174,"_20617":52214,"_5":14139,"_27008":52073,"_2880":52215},[],"Timeout or error after issuance",{"_3394":1225,"_29710":1174,"_20617":52217,"_5":14139,"_27008":52073,"_2880":52218},[],"New certificates, current slot and previous identity's state before retrying.",{"_3394":1226,"_29710":1174,"_20617":52220,"_5":14139,"_27008":52077,"_2880":52221},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3394":1227,"_29710":1174,"_20617":52223,"_5":14139,"_27008":52077,"_2880":52224},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3394":1228,"_29710":1174,"_20617":52226,"_5":14139,"_27008":52080,"_2880":52227},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3394":1229,"_29710":1174,"_20617":52229,"_5":14139,"_27008":52080,"_2880":52230},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3394":1230,"_29710":1174,"_20617":52232,"_5":14139,"_27008":52080,"_2880":52233},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3394":1231,"_29710":1174,"_20617":52235,"_5":14139,"_27008":52080,"_2880":52236},[],"Make one request, save headers/body and query the device and certificates.",{"_3394":1232,"_29710":1174,"_20617":52238,"_5":14139,"_27008":52080,"_2880":52239},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3394":1233,"_29710":1174,"_20617":52241,"_5":14139,"_27008":52080,"_2880":52242},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3394":1234,"_29710":1174,"_20617":52244,"_5":14139,"_27008":52080,"_2880":52245},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3394":1235,"_29710":1235,"_5":14491,"_2880":52247,"_30063":52248,"_20617":52249,"_27008":1235},"Trust distribution and updates",[48401,49869,50880,50878,51061],[],{"_3394":1236,"_29710":1235,"_20617":52251,"_5":14139,"_27008":1235,"_2880":52252},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3394":1237,"_29710":1235,"_5":30060,"_20617":52254,"_27008":52255,"_2880":52256},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3394":1238,"_29710":1235,"_5":30060,"_20617":52258,"_27008":52259,"_2880":52260},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3394":1239,"_29710":1235,"_5":30060,"_20617":52262,"_27008":52263,"_2880":52264},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3394":1240,"_29710":1235,"_5":30060,"_20617":52266,"_27008":52267,"_2880":52268},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3394":1241,"_29710":1235,"_5":30060,"_20617":52270,"_27008":52271,"_2880":52272},[],"/docs/pr-preview/pr-59/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3394":1242,"_29710":1235,"_20617":52274,"_5":14139,"_27008":1235,"_2880":52275},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3394":1243,"_29710":1235,"_20617":52277,"_5":14139,"_27008":52255,"_2880":52278},[],"Relationship",{"_3394":1244,"_29710":1235,"_20617":52280,"_5":14139,"_27008":52255,"_2880":52281},[],"Material prepared by its owner",{"_3394":1245,"_29710":1235,"_20617":52283,"_5":14139,"_27008":52255,"_2880":52284},[],"Device → EST server",{"_3394":1246,"_29710":1235,"_20617":52286,"_5":14139,"_27008":52255,"_2880":52287},[],"Previously verified server root, chain or pin and TLS name.",{"_3394":1247,"_29710":1235,"_20617":52289,"_5":14139,"_27008":52255,"_2880":52290},[],"DMS → requester",{"_3394":1248,"_29710":1235,"_20617":52292,"_5":14139,"_27008":52255,"_2880":52293},[],"CAs and rules authorizing initial or renewal credentials.",{"_3394":1249,"_29710":1235,"_20617":52295,"_5":14139,"_27008":52255,"_2880":52296},[],"Consumer → device",{"_3394":1250,"_29710":1235,"_20617":52298,"_5":14139,"_27008":52255,"_2880":52299},[],"Operational identity roots, intermediates, validation and permissions.",{"_3394":1251,"_29710":1235,"_20617":52301,"_5":14139,"_27008":52255,"_2880":52302},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3394":1252,"_29710":1235,"_20617":52304,"_5":14139,"_27008":52259,"_2880":52305},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3394":1253,"_29710":1235,"_20617":52307,"_5":14139,"_27008":52259,"_2880":52308},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3394":1254,"_29710":1235,"_20617":52310,"_5":14139,"_27008":52263,"_2880":52311},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3394":1255,"_29710":1235,"_20617":52313,"_5":14139,"_27008":52263,"_2880":52314},[],"Select policy-approved roots as anchors.",{"_3394":1256,"_29710":1235,"_20617":52316,"_5":14139,"_27008":52263,"_2880":52317},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3394":1257,"_29710":1235,"_20617":52319,"_5":14139,"_27008":52263,"_2880":52320},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3394":1258,"_29710":1235,"_20617":52322,"_5":14139,"_27008":52263,"_2880":52323},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3394":1259,"_29710":1235,"_20617":52325,"_5":14139,"_27008":52263,"_2880":52326},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3394":1260,"_29710":1235,"_20617":52328,"_5":14139,"_27008":52267,"_2880":52329},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3394":1261,"_29710":1235,"_20617":52331,"_5":14139,"_27008":52267,"_2880":52332},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3394":1262,"_29710":1235,"_20617":52334,"_5":14139,"_27008":52267,"_2880":52335},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3394":1263,"_29710":1235,"_20617":52337,"_5":14139,"_27008":52271,"_2880":52338},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3394":1264,"_29710":1264,"_5":14491,"_2880":52340,"_30063":52341,"_20617":52343,"_27008":1264},"AWS IoT Core",[48401,49869,50880,50878,52342],"Integrations",[],{"_3394":1265,"_29710":1264,"_20617":52345,"_5":14139,"_27008":1264,"_2880":52346},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3394":1266,"_29710":1264,"_5":30060,"_20617":52348,"_27008":52349,"_2880":52350},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3394":1267,"_29710":1264,"_5":30060,"_20617":52352,"_27008":52353,"_2880":52354},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3394":1268,"_29710":1264,"_5":30060,"_20617":52356,"_27008":52357,"_2880":52358},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3394":1269,"_29710":1264,"_5":30060,"_20617":52360,"_27008":52361,"_2880":52362},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3394":1270,"_29710":1264,"_5":30060,"_20617":52364,"_27008":52365,"_2880":52366},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3394":1271,"_29710":1264,"_5":30060,"_20617":52368,"_27008":52369,"_2880":52370},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3394":1272,"_29710":1264,"_5":30060,"_20617":52372,"_27008":52373,"_2880":52374},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3394":1273,"_29710":1264,"_5":30060,"_20617":52376,"_27008":52377,"_2880":52378},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3394":1274,"_29710":1264,"_5":30060,"_20617":52380,"_27008":52381,"_2880":52382},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3394":1275,"_29710":1264,"_5":30060,"_20617":52384,"_27008":52385,"_2880":52386},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3394":1276,"_29710":1264,"_5":30060,"_20617":52388,"_27008":52389,"_2880":52390},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3394":1277,"_29710":1264,"_5":30060,"_20617":52392,"_27008":52393,"_2880":52394},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3394":1278,"_29710":1264,"_5":30060,"_20617":52396,"_27008":52397,"_2880":52398},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3394":1279,"_29710":1264,"_5":30060,"_20617":52400,"_27008":52401,"_2880":52402},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3394":1280,"_29710":1264,"_5":30060,"_20617":52404,"_27008":52405,"_2880":52406},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3394":1281,"_29710":1264,"_5":30060,"_20617":52408,"_27008":52409,"_2880":52410},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3394":1282,"_29710":1264,"_5":30060,"_20617":52412,"_27008":52413,"_2880":52414},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3394":1283,"_29710":1264,"_5":30060,"_20617":52416,"_27008":52417,"_2880":52418},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3394":1284,"_29710":1264,"_5":30060,"_20617":52420,"_27008":52421,"_2880":52422},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3394":1285,"_29710":1264,"_5":30060,"_20617":52424,"_27008":52425,"_2880":52426},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3394":1286,"_29710":1264,"_5":30060,"_20617":52428,"_27008":52429,"_2880":52430},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3394":1287,"_29710":1264,"_5":30060,"_20617":52432,"_27008":52433,"_2880":52434},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3394":1288,"_29710":1264,"_5":30060,"_20617":52436,"_27008":52437,"_2880":52438},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3394":1289,"_29710":1264,"_5":30060,"_20617":52440,"_27008":52441,"_2880":52442},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3394":1290,"_29710":1264,"_5":30060,"_20617":52444,"_27008":52445,"_2880":52446},[],"/docs/pr-preview/pr-59/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3394":1291,"_29710":1264,"_20617":52448,"_5":14139,"_27008":1264,"_2880":52449},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3394":1292,"_29710":1264,"_20617":52451,"_5":14139,"_27008":1264,"_2880":52452},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3394":1293,"_29710":1264,"_20617":52454,"_5":14139,"_27008":1264,"_2880":52455},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3394":1294,"_29710":1264,"_20617":52457,"_5":14139,"_27008":52349,"_2880":52458},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3394":1295,"_29710":1264,"_20617":52460,"_5":14139,"_27008":52349,"_2880":52461},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3394":1296,"_29710":1264,"_20617":52463,"_5":14139,"_27008":52349,"_2880":52464},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3394":1297,"_29710":1264,"_20617":52466,"_5":14139,"_27008":52349,"_2880":52467},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3394":1298,"_29710":1264,"_20617":52469,"_5":14139,"_27008":52353,"_2880":52470},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3394":1299,"_29710":1264,"_20617":52472,"_5":14139,"_27008":52357,"_2880":52473},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3394":1300,"_29710":1264,"_20617":52475,"_5":14139,"_27008":52357,"_2880":52476},[],"IAM action",{"_3394":1301,"_29710":1264,"_20617":52478,"_5":14139,"_27008":52357,"_2880":48791},[],{"_3394":1302,"_29710":1264,"_20617":52480,"_5":14139,"_27008":52357,"_2880":52481},[],"`iot:GetRegistrationCode`",{"_3394":1303,"_29710":1264,"_20617":52483,"_5":14139,"_27008":52357,"_2880":52484},[],"Obtain the verification code for CA registration in the Primary Account",{"_3394":1304,"_29710":1264,"_20617":52486,"_5":14139,"_27008":52357,"_2880":52487},[],"`iot:RegisterCACertificate`",{"_3394":1305,"_29710":1264,"_20617":52489,"_5":14139,"_27008":52357,"_2880":52490},[],"Register the CA in AWS IoT",{"_3394":1306,"_29710":1264,"_20617":52492,"_5":14139,"_27008":52357,"_2880":52493},[],"`iot:DescribeCACertificate`",{"_3394":1307,"_29710":1264,"_20617":52495,"_5":14139,"_27008":52357,"_2880":52496},[],"Check the CA registration status",{"_3394":1308,"_29710":1264,"_20617":52498,"_5":14139,"_27008":52357,"_2880":52499},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3394":1309,"_29710":1264,"_20617":52501,"_5":14139,"_27008":52357,"_2880":52502},[],"Create or update Things in IoT Core",{"_3394":1310,"_29710":1264,"_20617":52504,"_5":14139,"_27008":52357,"_2880":52505},[],"`iot:RegisterThing`",{"_3394":1311,"_29710":1264,"_20617":52507,"_5":14139,"_27008":52357,"_2880":52508},[],"Provision Things through a template",{"_3394":1312,"_29710":1264,"_20617":52510,"_5":14139,"_27008":52357,"_2880":52511},[],"`iot:RegisterCertificate`",{"_3394":1313,"_29710":1264,"_20617":52513,"_5":14139,"_27008":52357,"_2880":52514},[],"Register device certificates",{"_3394":1314,"_29710":1264,"_20617":52516,"_5":14139,"_27008":52357,"_2880":52517},[],"`iot:UpdateCertificate`",{"_3394":1315,"_29710":1264,"_20617":52519,"_5":14139,"_27008":52357,"_2880":52520},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3394":1316,"_29710":1264,"_20617":52522,"_5":14139,"_27008":52357,"_2880":52523},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3394":1317,"_29710":1264,"_20617":52525,"_5":14139,"_27008":52357,"_2880":52526},[],"Create and attach IoT policies",{"_3394":1318,"_29710":1264,"_20617":52528,"_5":14139,"_27008":52357,"_2880":52529},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3394":1319,"_29710":1264,"_20617":52531,"_5":14139,"_27008":52357,"_2880":52532},[],"Manage Thing groups",{"_3394":1320,"_29710":1264,"_20617":52534,"_5":14139,"_27008":52357,"_2880":52535},[],"`iot:CreateProvisioningTemplate`",{"_3394":1321,"_29710":1264,"_20617":52537,"_5":14139,"_27008":52357,"_2880":52538},[],"Create JITP templates",{"_3394":1322,"_29710":1264,"_20617":52540,"_5":14139,"_27008":52357,"_2880":52541},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3394":1323,"_29710":1264,"_20617":52543,"_5":14139,"_27008":52357,"_2880":52544},[],"Read and write the Device Shadow",{"_3394":1324,"_29710":1264,"_20617":52546,"_5":14139,"_27008":52357,"_2880":52547},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3394":1325,"_29710":1264,"_20617":52549,"_5":14139,"_27008":52361,"_2880":52550},[],"Parameter",{"_3394":1326,"_29710":1264,"_20617":52552,"_5":14139,"_27008":52361,"_2880":52553},[],"Type",{"_3394":1327,"_29710":1264,"_20617":52555,"_5":14139,"_27008":52361,"_2880":52556},[],"Required",{"_3394":1328,"_29710":1264,"_20617":52558,"_5":14139,"_27008":52361,"_2880":52559},[],"Description",{"_3394":1329,"_29710":1264,"_20617":52561,"_5":14139,"_27008":52361,"_2880":52562},[],"`connector_id`",{"_3394":1330,"_29710":1264,"_20617":52564,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1331,"_29710":1264,"_20617":52566,"_5":14139,"_27008":52361,"_2880":52567},[],"Yes",{"_3394":1332,"_29710":1264,"_20617":52569,"_5":14139,"_27008":52361,"_2880":52570},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3394":1333,"_29710":1264,"_20617":52572,"_5":14139,"_27008":52361,"_2880":52573},[],"`aws_config.region`",{"_3394":1334,"_29710":1264,"_20617":52575,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1335,"_29710":1264,"_20617":52577,"_5":14139,"_27008":52361,"_2880":52567},[],{"_3394":1336,"_29710":1264,"_20617":52579,"_5":14139,"_27008":52361,"_2880":52580},[],"AWS region where the connector operates.",{"_3394":1337,"_29710":1264,"_20617":52582,"_5":14139,"_27008":52361,"_2880":52583},[],"`aws_config.auth_method`",{"_3394":1338,"_29710":1264,"_20617":52585,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1339,"_29710":1264,"_20617":52587,"_5":14139,"_27008":52361,"_2880":52567},[],{"_3394":1340,"_29710":1264,"_20617":52589,"_5":14139,"_27008":52361,"_2880":52590},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3394":1341,"_29710":1264,"_20617":52592,"_5":14139,"_27008":52361,"_2880":52593},[],"`aws_config.access_key_id`",{"_3394":1342,"_29710":1264,"_20617":52595,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1343,"_29710":1264,"_20617":52597,"_5":14139,"_27008":52361,"_2880":52598},[],"Only with `auth_method=static`",{"_3394":1344,"_29710":1264,"_20617":52600,"_5":14139,"_27008":52361,"_2880":52601},[],"AWS access key.",{"_3394":1345,"_29710":1264,"_20617":52603,"_5":14139,"_27008":52361,"_2880":52604},[],"`aws_config.secret_access_key`",{"_3394":1346,"_29710":1264,"_20617":52606,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1347,"_29710":1264,"_20617":52608,"_5":14139,"_27008":52361,"_2880":52598},[],{"_3394":1348,"_29710":1264,"_20617":52610,"_5":14139,"_27008":52361,"_2880":52611},[],"AWS secret key.",{"_3394":1349,"_29710":1264,"_20617":52613,"_5":14139,"_27008":52361,"_2880":52614},[],"`aws_config.session_token`",{"_3394":1350,"_29710":1264,"_20617":52616,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1351,"_29710":1264,"_20617":52618,"_5":14139,"_27008":52361,"_2880":52619},[],"No",{"_3394":1352,"_29710":1264,"_20617":52621,"_5":14139,"_27008":52361,"_2880":52622},[],"Session token (with `auth_method=static`).",{"_3394":1353,"_29710":1264,"_20617":52624,"_5":14139,"_27008":52361,"_2880":52625},[],"`aws_config.role_arn`",{"_3394":1354,"_29710":1264,"_20617":52627,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1355,"_29710":1264,"_20617":52629,"_5":14139,"_27008":52361,"_2880":52630},[],"Only with `auth_method=role`",{"_3394":1356,"_29710":1264,"_20617":52632,"_5":14139,"_27008":52361,"_2880":52633},[],"ARN of the role to assume.",{"_3394":1357,"_29710":1264,"_20617":52635,"_5":14139,"_27008":52361,"_2880":52636},[],"`aws_config.endpoint_url`",{"_3394":1358,"_29710":1264,"_20617":52638,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1359,"_29710":1264,"_20617":52640,"_5":14139,"_27008":52361,"_2880":52619},[],{"_3394":1360,"_29710":1264,"_20617":52642,"_5":14139,"_27008":52361,"_2880":52643},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3394":1361,"_29710":1264,"_20617":52645,"_5":14139,"_27008":52361,"_2880":52646},[],"`subscriber_event_bus`",{"_3394":1362,"_29710":1264,"_20617":52648,"_5":14139,"_27008":52361,"_2880":17335},[],{"_3394":1363,"_29710":1264,"_20617":52650,"_5":14139,"_27008":52361,"_2880":52567},[],{"_3394":1364,"_29710":1264,"_20617":52652,"_5":14139,"_27008":52361,"_2880":52653},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3394":1365,"_29710":1264,"_20617":52655,"_5":14139,"_27008":52361,"_2880":52656},[],"`dms_manager_client`",{"_3394":1366,"_29710":1264,"_20617":52658,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1367,"_29710":1264,"_20617":52660,"_5":14139,"_27008":52361,"_2880":52567},[],{"_3394":1368,"_29710":1264,"_20617":52662,"_5":14139,"_27008":52361,"_2880":52663},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3394":1369,"_29710":1264,"_20617":52665,"_5":14139,"_27008":52361,"_2880":52666},[],"`device_manager_client`",{"_3394":1370,"_29710":1264,"_20617":52668,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1371,"_29710":1264,"_20617":52670,"_5":14139,"_27008":52361,"_2880":52567},[],{"_3394":1372,"_29710":1264,"_20617":52672,"_5":14139,"_27008":52361,"_2880":52673},[],"HTTP URL of Lamassu's Device Manager.",{"_3394":1373,"_29710":1264,"_20617":52675,"_5":14139,"_27008":52361,"_2880":52676},[],"`ca_client`",{"_3394":1374,"_29710":1264,"_20617":52678,"_5":14139,"_27008":52361,"_2880":24618},[],{"_3394":1375,"_29710":1264,"_20617":52680,"_5":14139,"_27008":52361,"_2880":52567},[],{"_3394":1376,"_29710":1264,"_20617":52682,"_5":14139,"_27008":52361,"_2880":52683},[],"HTTP URL of Lamassu's CA service.",{"_3394":1377,"_29710":1264,"_20617":52685,"_5":14139,"_27008":52365,"_2880":52686},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3394":1378,"_29710":1264,"_20617":52688,"_5":14139,"_27008":52365,"_2880":52689},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3394":1379,"_29710":1264,"_20617":52691,"_5":14139,"_27008":52365,"_2880":52692},[],"CloudEvent type",{"_3394":1380,"_29710":1264,"_20617":52694,"_5":14139,"_27008":52365,"_2880":52695},[],"Lamassu resource",{"_3394":1381,"_29710":1264,"_20617":52697,"_5":14139,"_27008":52365,"_2880":52698},[],"AWS Resource",{"_3394":1382,"_29710":1264,"_20617":52700,"_5":14139,"_27008":52365,"_2880":52701},[],"IAM actions",{"_3394":1383,"_29710":1264,"_20617":52703,"_5":14139,"_27008":52365,"_2880":52704},[],"AWS calls and effect",{"_3394":1384,"_29710":1264,"_20617":52706,"_5":14139,"_27008":52365,"_2880":52707},[],"Where in this page",{"_3394":1385,"_29710":1264,"_20617":52709,"_5":14139,"_27008":52365,"_2880":52710},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3394":1386,"_29710":1264,"_20617":52712,"_5":14139,"_27008":52365,"_2880":52713},[],"CA",{"_3394":1387,"_29710":1264,"_20617":52715,"_5":14139,"_27008":52365,"_2880":52716},[],"`IoTCore/CACertificate`",{"_3394":1388,"_29710":1264,"_20617":52718,"_5":14139,"_27008":52365,"_2880":52719},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3394":1389,"_29710":1264,"_20617":52721,"_5":14139,"_27008":52365,"_2880":52722},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3394":1390,"_29710":1264,"_20617":52724,"_5":14139,"_27008":52365,"_2880":52378},[],{"_3394":1391,"_29710":1264,"_20617":52726,"_5":14139,"_27008":52365,"_2880":52727},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3394":1392,"_29710":1264,"_20617":52729,"_5":14139,"_27008":52365,"_2880":52730},[],"DMS",{"_3394":1393,"_29710":1264,"_20617":52732,"_5":14139,"_27008":52365,"_2880":52733},[],"`IoTCore/ProvisioningTemplate`",{"_3394":1394,"_29710":1264,"_20617":52735,"_5":14139,"_27008":52365,"_2880":52736},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3394":1395,"_29710":1264,"_20617":52738,"_5":14139,"_27008":52365,"_2880":52739},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3394":1396,"_29710":1264,"_20617":52741,"_5":14139,"_27008":52365,"_2880":52406},[],{"_3394":1397,"_29710":1264,"_20617":52743,"_5":14139,"_27008":52365,"_2880":52744},[],"`EventBindDeviceIdentityKey`",{"_3394":1398,"_29710":1264,"_20617":52746,"_5":14139,"_27008":52365,"_2880":52747},[],"Device",{"_3394":1399,"_29710":1264,"_20617":52749,"_5":14139,"_27008":52365,"_2880":52750},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3394":1400,"_29710":1264,"_20617":52752,"_5":14139,"_27008":52365,"_2880":52753},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3394":1401,"_29710":1264,"_20617":52755,"_5":14139,"_27008":52365,"_2880":52756},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3394":1402,"_29710":1264,"_20617":52758,"_5":14139,"_27008":52365,"_2880":52414},[],{"_3394":1403,"_29710":1264,"_20617":52760,"_5":14139,"_27008":52365,"_2880":52761},[],"`EventUpdateCertificateStatusKey`",{"_3394":1404,"_29710":1264,"_20617":52763,"_5":14139,"_27008":52365,"_2880":52764},[],"Certificate",{"_3394":1405,"_29710":1264,"_20617":52766,"_5":14139,"_27008":52365,"_2880":52767},[],"`IoTCore/Certificate`",{"_3394":1406,"_29710":1264,"_20617":52769,"_5":14139,"_27008":52365,"_2880":52770},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3394":1407,"_29710":1264,"_20617":52772,"_5":14139,"_27008":52365,"_2880":52773},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3394":1408,"_29710":1264,"_20617":52775,"_5":14139,"_27008":52365,"_2880":52426},[],{"_3394":1409,"_29710":1264,"_20617":52777,"_5":14139,"_27008":52365,"_2880":52778},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3394":1410,"_29710":1264,"_20617":52780,"_5":14139,"_27008":52365,"_2880":52781},[],"Certificate / Device",{"_3394":1411,"_29710":1264,"_20617":52783,"_5":14139,"_27008":52365,"_2880":52784},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3394":1412,"_29710":1264,"_20617":52786,"_5":14139,"_27008":52365,"_2880":48797},[],{"_3394":1413,"_29710":1264,"_20617":52788,"_5":14139,"_27008":52365,"_2880":52789},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3394":1414,"_29710":1264,"_20617":52791,"_5":14139,"_27008":52365,"_2880":52434},[],{"_3394":1415,"_29710":1264,"_20617":52793,"_5":14139,"_27008":52369,"_2880":52794},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3394":1416,"_29710":1264,"_20617":52796,"_5":14139,"_27008":52373,"_2880":52797},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3394":1417,"_29710":1264,"_20617":52799,"_5":14139,"_27008":52373,"_2880":52800},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3394":1418,"_29710":1264,"_20617":52802,"_5":14139,"_27008":52377,"_2880":52803},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3394":1419,"_29710":1264,"_20617":52805,"_5":14139,"_27008":52377,"_2880":52806},[],"Transition",{"_3394":1420,"_29710":1264,"_20617":52808,"_5":14139,"_27008":52377,"_2880":52809},[],"AWS calls",{"_3394":1421,"_29710":1264,"_20617":52811,"_5":14139,"_27008":52377,"_2880":52812},[],"`NotRegistered` → `Requested`",{"_3394":1422,"_29710":1264,"_20617":52814,"_5":14139,"_27008":52377,"_2880":52815},[],"none (metadata write only)",{"_3394":1423,"_29710":1264,"_20617":52817,"_5":14139,"_27008":52377,"_2880":52818},[],"`Requested` → `Registering`",{"_3394":1424,"_29710":1264,"_20617":52820,"_5":14139,"_27008":52377,"_2880":52821},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3394":1425,"_29710":1264,"_20617":52823,"_5":14139,"_27008":52377,"_2880":52824},[],"`Registering` → `Succeeded`",{"_3394":1426,"_29710":1264,"_20617":52826,"_5":14139,"_27008":52377,"_2880":52827},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3394":1427,"_29710":1264,"_20617":52829,"_5":14139,"_27008":52377,"_2880":52830},[],"`Registering` → `Failed`",{"_3394":1428,"_29710":1264,"_20617":52832,"_5":14139,"_27008":52377,"_2880":52833},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3394":1429,"_29710":1264,"_20617":52835,"_5":14139,"_27008":52377,"_2880":52836},[],"`Failed` / `Succeeded` → `Requested`",{"_3394":1430,"_29710":1264,"_20617":52838,"_5":14139,"_27008":52377,"_2880":52839},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3394":1431,"_29710":1264,"_20617":52841,"_5":14139,"_27008":52381,"_2880":52842},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3394":1432,"_29710":1264,"_20617":52844,"_5":14139,"_27008":52381,"_2880":52845},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3394":1433,"_29710":1264,"_20617":52847,"_5":14139,"_27008":52381,"_2880":52848},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3394":1434,"_29710":1264,"_20617":52850,"_5":14139,"_27008":52381,"_2880":52851},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3394":1435,"_29710":1264,"_20617":52853,"_5":14139,"_27008":52381,"_2880":52854},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3394":1436,"_29710":1264,"_20617":52856,"_5":14139,"_27008":52381,"_2880":52857},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3394":1437,"_29710":1264,"_20617":52859,"_5":14139,"_27008":52385,"_2880":52860},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3394":1438,"_29710":1264,"_20617":52862,"_5":14139,"_27008":52389,"_2880":52863},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3394":1439,"_29710":1264,"_20617":52865,"_5":14139,"_27008":52389,"_2880":52866},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3394":1440,"_29710":1264,"_20617":52868,"_5":14139,"_27008":52393,"_2880":52869},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3394":1441,"_29710":1264,"_20617":52871,"_5":14139,"_27008":52397,"_2880":52872},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3394":1442,"_29710":1264,"_20617":52874,"_5":14139,"_27008":52397,"_2880":52875},[],"Creates or updates the IoT policies configured in the DMS.",{"_3394":1443,"_29710":1264,"_20617":52877,"_5":14139,"_27008":52397,"_2880":52878},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3394":1444,"_29710":1264,"_20617":52880,"_5":14139,"_27008":52397,"_2880":52881},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3394":1445,"_29710":1264,"_20617":52883,"_5":14139,"_27008":52397,"_2880":52884},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3394":1446,"_29710":1264,"_20617":52886,"_5":14139,"_27008":52397,"_2880":52887},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3394":1447,"_29710":1264,"_20617":52889,"_5":14139,"_27008":52397,"_2880":52890},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3394":1448,"_29710":1264,"_20617":52892,"_5":14139,"_27008":52401,"_2880":52893},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3394":1449,"_29710":1264,"_20617":52895,"_5":14139,"_27008":52401,"_2880":52896},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3394":1450,"_29710":1264,"_20617":52898,"_5":14139,"_27008":52401,"_2880":52899},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3394":1451,"_29710":1264,"_20617":52901,"_5":14139,"_27008":52401,"_2880":52902},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3394":1452,"_29710":1264,"_20617":52904,"_5":14139,"_27008":52401,"_2880":52905},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3394":1453,"_29710":1264,"_20617":52907,"_5":14139,"_27008":52405,"_2880":52908},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3394":1454,"_29710":1264,"_20617":52910,"_5":14139,"_27008":52405,"_2880":52806},[],{"_3394":1455,"_29710":1264,"_20617":52912,"_5":14139,"_27008":52405,"_2880":52809},[],{"_3394":1456,"_29710":1264,"_20617":52914,"_5":14139,"_27008":52405,"_2880":52915},[],"`Unconfigured` → `None` / `Auto`",{"_3394":1457,"_29710":1264,"_20617":52917,"_5":14139,"_27008":52405,"_2880":52918},[],"none (configuration only)",{"_3394":1458,"_29710":1264,"_20617":52920,"_5":14139,"_27008":52405,"_2880":52921},[],"`None` ↔ `Auto`",{"_3394":1459,"_29710":1264,"_20617":52923,"_5":14139,"_27008":52405,"_2880":52918},[],{"_3394":1460,"_29710":1264,"_20617":52925,"_5":14139,"_27008":52405,"_2880":52926},[],"Any → `Jitp`",{"_3394":1461,"_29710":1264,"_20617":52928,"_5":14139,"_27008":52405,"_2880":52929},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3394":1462,"_29710":1264,"_20617":52931,"_5":14139,"_27008":52405,"_2880":52932},[],"`Jitp` → `None` / `Auto`",{"_3394":1463,"_29710":1264,"_20617":52934,"_5":14139,"_27008":52405,"_2880":52935},[],"none (the template stays in the AWS account)",{"_3394":1464,"_29710":1264,"_20617":52937,"_5":14139,"_27008":52409,"_2880":52938},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3394":1465,"_29710":1264,"_20617":52940,"_5":14139,"_27008":52409,"_2880":52941},[],"The full flow from the device's perspective is:",{"_3394":1466,"_29710":1264,"_20617":52943,"_5":14139,"_27008":52409,"_2880":52944},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3394":1467,"_29710":1264,"_20617":52946,"_5":14139,"_27008":52413,"_2880":52947},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3394":1468,"_29710":1264,"_20617":52949,"_5":14139,"_27008":52413,"_2880":52806},[],{"_3394":1469,"_29710":1264,"_20617":52951,"_5":14139,"_27008":52413,"_2880":52809},[],{"_3394":1470,"_29710":1264,"_20617":52953,"_5":14139,"_27008":52413,"_2880":52954},[],"`Absent` → `Provisioned`",{"_3394":1471,"_29710":1264,"_20617":52956,"_5":14139,"_27008":52413,"_2880":52957},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3394":1472,"_29710":1264,"_20617":52959,"_5":14139,"_27008":52413,"_2880":52960},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3394":1473,"_29710":1264,"_20617":52962,"_5":14139,"_27008":52413,"_2880":52963},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3394":1474,"_29710":1264,"_20617":52965,"_5":14139,"_27008":52413,"_2880":52966},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3394":1475,"_29710":1264,"_20617":52968,"_5":14139,"_27008":52417,"_2880":52969},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3394":1476,"_29710":1264,"_20617":52971,"_5":14139,"_27008":52417,"_2880":52972},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3394":1477,"_29710":1264,"_20617":52974,"_5":14139,"_27008":52417,"_2880":52975},[],"For the JITP flow to work correctly:",{"_3394":1478,"_29710":1264,"_20617":52977,"_5":14139,"_27008":52417,"_2880":52978},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3394":1479,"_29710":1264,"_20617":52980,"_5":14139,"_27008":52417,"_2880":52981},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3394":1480,"_29710":1264,"_20617":52983,"_5":14139,"_27008":52417,"_2880":52984},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3394":1481,"_29710":1264,"_20617":52986,"_5":14139,"_27008":52417,"_2880":52987},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3394":1482,"_29710":1264,"_20617":52989,"_5":14139,"_27008":52421,"_2880":52990},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3394":1483,"_29710":1264,"_20617":52992,"_5":14139,"_27008":52421,"_2880":52993},[],"Status in Lamassu",{"_3394":1484,"_29710":1264,"_20617":52995,"_5":14139,"_27008":52421,"_2880":52996},[],"Revocation reason",{"_3394":1485,"_29710":1264,"_20617":52998,"_5":14139,"_27008":52421,"_2880":52999},[],"Status in AWS IoT Core",{"_3394":1486,"_29710":1264,"_20617":53001,"_5":14139,"_27008":52421,"_2880":53002},[],"`Active`",{"_3394":1487,"_29710":1264,"_20617":53004,"_5":14139,"_27008":52421,"_2880":53005},[],"None",{"_3394":1488,"_29710":1264,"_20617":53007,"_5":14139,"_27008":52421,"_2880":53008},[],"`ACTIVE`",{"_3394":1489,"_29710":1264,"_20617":53010,"_5":14139,"_27008":52421,"_2880":53011},[],"`Revoked`",{"_3394":1490,"_29710":1264,"_20617":53013,"_5":14139,"_27008":52421,"_2880":53014},[],"`certificateHold`",{"_3394":1491,"_29710":1264,"_20617":53016,"_5":14139,"_27008":52421,"_2880":53017},[],"`INACTIVE`",{"_3394":1492,"_29710":1264,"_20617":53019,"_5":14139,"_27008":52421,"_2880":53011},[],{"_3394":1493,"_29710":1264,"_20617":53021,"_5":14139,"_27008":52421,"_2880":53022},[],"Any other reason",{"_3394":1494,"_29710":1264,"_20617":53024,"_5":14139,"_27008":52421,"_2880":53025},[],"`REVOKED`",{"_3394":1495,"_29710":1264,"_20617":53027,"_5":14139,"_27008":52421,"_2880":53028},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3394":1496,"_29710":1264,"_20617":53030,"_5":14139,"_27008":52425,"_2880":53031},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3394":1497,"_29710":1264,"_20617":53033,"_5":14139,"_27008":52425,"_2880":52806},[],{"_3394":1498,"_29710":1264,"_20617":53035,"_5":14139,"_27008":52425,"_2880":52809},[],{"_3394":1499,"_29710":1264,"_20617":53037,"_5":14139,"_27008":52425,"_2880":53038},[],"`NotSynced` → `Active`",{"_3394":1500,"_29710":1264,"_20617":53040,"_5":14139,"_27008":52425,"_2880":52517},[],{"_3394":1501,"_29710":1264,"_20617":53042,"_5":14139,"_27008":52425,"_2880":53043},[],"`Active` → `Inactive`",{"_3394":1502,"_29710":1264,"_20617":53045,"_5":14139,"_27008":52425,"_2880":53046},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3394":1503,"_29710":1264,"_20617":53048,"_5":14139,"_27008":52425,"_2880":53049},[],"`Active` → `Revoked`",{"_3394":1504,"_29710":1264,"_20617":53051,"_5":14139,"_27008":52425,"_2880":53046},[],{"_3394":1505,"_29710":1264,"_20617":53053,"_5":14139,"_27008":52425,"_2880":53054},[],"`Inactive` / `Revoked` → `Active`",{"_3394":1506,"_29710":1264,"_20617":53056,"_5":14139,"_27008":52425,"_2880":52517},[],{"_3394":1507,"_29710":1264,"_20617":53058,"_5":14139,"_27008":52425,"_2880":53059},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3394":1508,"_29710":1264,"_20617":53061,"_5":14139,"_27008":52425,"_2880":53062},[],"none (these states are not synced to AWS)",{"_3394":1509,"_29710":1264,"_20617":53064,"_5":14139,"_27008":52429,"_2880":53065},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3394":1510,"_29710":1264,"_20617":53067,"_5":14139,"_27008":52429,"_2880":53068},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3394":1511,"_29710":1264,"_20617":53070,"_5":14139,"_27008":52429,"_2880":53071},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3394":1512,"_29710":1264,"_20617":53073,"_5":14139,"_27008":52433,"_2880":53074},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3394":1513,"_29710":1264,"_20617":53076,"_5":14139,"_27008":52433,"_2880":53077},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3394":1514,"_29710":1264,"_20617":53079,"_5":14139,"_27008":52437,"_2880":53080},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3394":1515,"_29710":1264,"_20617":53082,"_5":14139,"_27008":52437,"_2880":53083},[],"There are two action types:",{"_3394":1516,"_29710":1264,"_20617":53085,"_5":14139,"_27008":52437,"_2880":53086},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3394":1517,"_29710":1264,"_20617":53088,"_5":14139,"_27008":52437,"_2880":53089},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3394":1518,"_29710":1264,"_20617":53091,"_5":14139,"_27008":52437,"_2880":53092},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3394":1519,"_29710":1264,"_20617":53094,"_5":14139,"_27008":52441,"_2880":53095},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3394":1520,"_29710":1264,"_20617":53097,"_5":14139,"_27008":52441,"_2880":53098},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3394":1521,"_29710":1264,"_20617":53100,"_5":14139,"_27008":52441,"_2880":53101},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3394":1522,"_29710":1264,"_20617":53103,"_5":14139,"_27008":52445,"_2880":53104},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3394":1523,"_29710":1264,"_20617":53106,"_5":14139,"_27008":52445,"_2880":53107},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3394":1524,"_29710":1264,"_20617":53109,"_5":14139,"_27008":52445,"_2880":53110},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3394":1525,"_29710":1264,"_20617":53112,"_5":14139,"_27008":52445,"_2880":53113},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3394":1526,"_29710":1264,"_20617":53115,"_5":14139,"_27008":52445,"_2880":53116},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3394":1527,"_29710":1264,"_20617":53118,"_5":14139,"_27008":52445,"_2880":53119},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3394":1528,"_29710":1264,"_20617":53121,"_5":14139,"_27008":52445,"_2880":53122},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3394":1529,"_29710":1264,"_20617":53124,"_5":14139,"_27008":52445,"_2880":53125},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3394":1530,"_29710":1264,"_20617":53127,"_5":14139,"_27008":52445,"_2880":53128},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3394":1531,"_29710":1264,"_20617":53130,"_5":14139,"_27008":52445,"_2880":53131},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3394":1532,"_29710":1264,"_20617":53133,"_5":14139,"_27008":52445,"_2880":53134},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3394":1533,"_29710":1264,"_20617":53136,"_5":14139,"_27008":52445,"_2880":53137},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3394":1534,"_29710":1264,"_20617":53139,"_5":14139,"_27008":52445,"_2880":53140},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3394":1535,"_29710":1264,"_20617":53142,"_5":14139,"_27008":52445,"_2880":53143},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3394":1536,"_29710":1264,"_20617":53145,"_5":14139,"_27008":52445,"_2880":53146},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3394":1537,"_29710":1264,"_20617":53148,"_5":14139,"_27008":52445,"_2880":53149},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3394":1538,"_29710":1264,"_20617":53151,"_5":14139,"_27008":52445,"_2880":53152},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3394":1539,"_29710":1264,"_20617":53154,"_5":14139,"_27008":52445,"_2880":53155},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3394":1540,"_29710":1264,"_20617":53157,"_5":14139,"_27008":52445,"_2880":53158},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3394":1541,"_29710":1264,"_20617":53160,"_5":14139,"_27008":52445,"_2880":53161},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3394":1542,"_29710":1264,"_20617":53163,"_5":14139,"_27008":52445,"_2880":53164},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3394":1543,"_29710":1264,"_20617":53166,"_5":14139,"_27008":52445,"_2880":53167},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3394":1544,"_29710":1264,"_20617":53169,"_5":14139,"_27008":52445,"_2880":53170},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3394":1545,"_29710":1264,"_20617":53172,"_5":14139,"_27008":52445,"_2880":53173},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3394":1546,"_29710":1546,"_5":14491,"_2880":50880,"_30063":53175,"_20617":53176,"_27008":1546},[48401,49869,50880],[],{"_3394":1547,"_29710":1546,"_20617":53178,"_5":14139,"_27008":1546,"_2880":53179},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3394":1548,"_29710":1546,"_5":30060,"_20617":53181,"_27008":53182,"_2880":53183},[],"/docs/pr-preview/pr-59/platform/iot-fleets/overview#start-here","Start here",{"_3394":1549,"_29710":1546,"_5":30060,"_20617":53185,"_27008":53186,"_2880":50878},[],"/docs/pr-preview/pr-59/platform/iot-fleets/overview#devices-and-identities",{"_3394":1550,"_29710":1546,"_5":30060,"_20617":53188,"_27008":53189,"_2880":51061},[],"/docs/pr-preview/pr-59/platform/iot-fleets/overview#enrollment-with-pki",{"_3394":1551,"_29710":1546,"_5":30060,"_20617":53191,"_27008":53192,"_2880":52342},[],"/docs/pr-preview/pr-59/platform/iot-fleets/overview#integrations",{"_3394":1552,"_29710":1546,"_5":30060,"_20617":53194,"_27008":53195,"_2880":53196},[],"/docs/pr-preview/pr-59/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3394":1553,"_29710":1546,"_20617":53198,"_5":14139,"_27008":1546,"_2880":53199},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3394":1554,"_29710":1546,"_20617":53201,"_5":14139,"_27008":53182,"_2880":53202},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3394":1555,"_29710":1546,"_20617":53204,"_5":14139,"_27008":53182,"_2880":53205},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3394":1556,"_29710":1546,"_20617":53207,"_5":14139,"_27008":53186,"_2880":53208},[],"Resource",{"_3394":1557,"_29710":1546,"_20617":53210,"_5":14139,"_27008":53186,"_2880":53211},[],"What it represents",{"_3394":1558,"_29710":1546,"_20617":53213,"_5":14139,"_27008":53186,"_2880":53214},[],"**Device**",{"_3394":1559,"_29710":1546,"_20617":53216,"_5":14139,"_27008":53186,"_2880":53217},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3394":1560,"_29710":1546,"_20617":53219,"_5":14139,"_27008":53186,"_2880":53220},[],"**Identity**",{"_3394":1561,"_29710":1546,"_20617":53222,"_5":14139,"_27008":53186,"_2880":53223},[],"The device's association with its certificates: an active version and a history.",{"_3394":1562,"_29710":1546,"_20617":53225,"_5":14139,"_27008":53186,"_2880":53226},[],"**DMS**",{"_3394":1563,"_29710":1546,"_20617":53228,"_5":14139,"_27008":53186,"_2880":53229},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3394":1564,"_29710":1546,"_20617":53231,"_5":14139,"_27008":53186,"_2880":53232},[],"**Fleet**",{"_3394":1565,"_29710":1546,"_20617":53234,"_5":14139,"_27008":53186,"_2880":53235},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3394":1566,"_29710":1546,"_20617":53237,"_5":14139,"_27008":53186,"_2880":53238},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3394":1567,"_29710":1546,"_20617":53240,"_5":14139,"_27008":53186,"_2880":53241},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3394":1568,"_29710":1546,"_20617":53243,"_5":14139,"_27008":53189,"_2880":53244},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3394":1569,"_29710":1546,"_20617":53246,"_5":14139,"_27008":53189,"_2880":53247},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3394":1570,"_29710":1546,"_20617":53249,"_5":14139,"_27008":53189,"_2880":53250},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3394":1571,"_29710":1546,"_20617":53252,"_5":14139,"_27008":53189,"_2880":53253},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3394":1572,"_29710":1546,"_20617":53255,"_5":14139,"_27008":53189,"_2880":53256},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3394":1573,"_29710":1546,"_20617":53258,"_5":14139,"_27008":53189,"_2880":53259},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3394":1574,"_29710":1546,"_20617":53261,"_5":14139,"_27008":53189,"_2880":53262},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3394":1575,"_29710":1546,"_20617":53264,"_5":14139,"_27008":53189,"_2880":53265},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3394":1576,"_29710":1546,"_20617":53267,"_5":14139,"_27008":53192,"_2880":53268},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3394":1577,"_29710":1546,"_20617":53270,"_5":14139,"_27008":53192,"_2880":53271},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3394":1578,"_29710":1546,"_20617":53273,"_5":14139,"_27008":53195,"_2880":53274},[],"Participant",{"_3394":1579,"_29710":1546,"_20617":53276,"_5":14139,"_27008":53195,"_2880":53277},[],"Responsibility",{"_3394":1580,"_29710":1546,"_20617":53279,"_5":14139,"_27008":53195,"_2880":53280},[],"PKI administrator",{"_3394":1581,"_29710":1546,"_20617":53282,"_5":14139,"_27008":53195,"_2880":53283},[],"CA, issuance profile, chain and revocation publication.",{"_3394":1582,"_29710":1546,"_20617":53285,"_5":14139,"_27008":53195,"_2880":53286},[],"Provisioning administrator",{"_3394":1583,"_29710":1546,"_20617":53288,"_5":14139,"_27008":53195,"_2880":53289},[],"DMS, admission, authentication per operation and inventory.",{"_3394":1584,"_29710":1546,"_20617":53291,"_5":14139,"_27008":53195,"_2880":53292},[],"Device integrator",{"_3394":1585,"_29710":1546,"_20617":53294,"_5":14139,"_27008":53195,"_2880":53295},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3394":1586,"_29710":1546,"_20617":53297,"_5":14139,"_27008":53195,"_2880":53298},[],"Consumer integrator",{"_3394":1587,"_29710":1546,"_20617":53300,"_5":14139,"_27008":53195,"_2880":53301},[],"Trusted issuers, validation and device permissions in the destination.",{"_3394":1588,"_29710":1546,"_20617":53303,"_5":14139,"_27008":53195,"_2880":53304},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3394":1589,"_29710":1589,"_5":14491,"_2880":53306,"_30063":53307,"_20617":53309,"_27008":1589},"Enroll and connect your first device",[48401,49869,50880,53308],"Getting started",[],{"_3394":1590,"_29710":1589,"_20617":53311,"_5":14139,"_27008":1589,"_2880":53312},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3394":1591,"_29710":1589,"_5":30060,"_20617":53314,"_27008":53315,"_2880":48411},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3394":1592,"_29710":1589,"_5":30060,"_20617":53317,"_27008":53318,"_2880":53319},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3394":1593,"_29710":1589,"_5":30060,"_20617":53321,"_27008":53322,"_2880":53323},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3394":1594,"_29710":1589,"_5":30060,"_20617":53325,"_27008":53326,"_2880":53327},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3394":1595,"_29710":1589,"_5":30060,"_20617":53329,"_27008":53330,"_2880":53331},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3394":1596,"_29710":1589,"_5":30060,"_20617":53333,"_27008":53334,"_2880":53335},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3394":1597,"_29710":1589,"_5":30060,"_20617":53337,"_27008":53338,"_2880":53339},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3394":1598,"_29710":1589,"_5":30060,"_20617":53341,"_27008":53342,"_2880":53343},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3394":1599,"_29710":1589,"_20617":53345,"_5":14139,"_27008":1589,"_2880":53346},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3394":1600,"_29710":1589,"_20617":53348,"_5":14139,"_27008":53315,"_2880":53349},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3394":1601,"_29710":1589,"_20617":53351,"_5":14139,"_27008":53315,"_2880":53352},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3394":1602,"_29710":1589,"_20617":53354,"_5":14139,"_27008":53315,"_2880":53355},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3394":1603,"_29710":1589,"_20617":53357,"_5":14139,"_27008":53315,"_2880":53358},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3394":1604,"_29710":1589,"_20617":53360,"_5":14139,"_27008":53315,"_2880":53361},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3394":1605,"_29710":1589,"_20617":53363,"_5":14139,"_27008":53318,"_2880":53364},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3394":1606,"_29710":1589,"_20617":53366,"_5":14139,"_27008":53318,"_2880":53367},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3394":1607,"_29710":1589,"_20617":53369,"_5":14139,"_27008":53322,"_2880":53370},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3394":1608,"_29710":1589,"_20617":53372,"_5":14139,"_27008":53322,"_2880":53373},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3394":1609,"_29710":1589,"_20617":53375,"_5":14139,"_27008":53322,"_2880":53376},[],"Setting",{"_3394":1610,"_29710":1589,"_20617":53378,"_5":14139,"_27008":53322,"_2880":53379},[],"Evaluation value",{"_3394":1611,"_29710":1589,"_20617":53381,"_5":14139,"_27008":53322,"_2880":53382},[],"Enrollment CA",{"_3394":1612,"_29710":1589,"_20617":53384,"_5":14139,"_27008":53322,"_2880":53385},[],"Issuing root from `device-root.pem`.",{"_3394":1613,"_29710":1589,"_20617":53387,"_5":14139,"_27008":53322,"_2880":51191},[],{"_3394":1614,"_29710":1589,"_20617":53389,"_5":14139,"_27008":53322,"_2880":53390},[],"The 1-hour leaf profile you just prepared.",{"_3394":1615,"_29710":1589,"_20617":53392,"_5":14139,"_27008":53322,"_2880":53393},[],"Protocol / Registration Mode",{"_3394":1616,"_29710":1589,"_20617":53395,"_5":14139,"_27008":53322,"_2880":53396},[],"`EST_RFC7030` / `JITP`.",{"_3394":1617,"_29710":1589,"_20617":53398,"_5":14139,"_27008":53322,"_2880":53399},[],"Verify CSR Signature",{"_3394":1618,"_29710":1589,"_20617":53401,"_5":14139,"_27008":53322,"_2880":53402},[],"Enabled.",{"_3394":1619,"_29710":1589,"_20617":53404,"_5":14139,"_27008":53322,"_2880":53405},[],"Enable Replaceable Enrollment",{"_3394":1620,"_29710":1589,"_20617":53407,"_5":14139,"_27008":53322,"_2880":53408},[],"Disabled; the ID must be new.",{"_3394":1621,"_29710":1589,"_20617":53410,"_5":14139,"_27008":53322,"_2880":53411},[],"Initial authentication",{"_3394":1622,"_29710":1589,"_20617":53413,"_5":14139,"_27008":53322,"_2880":53414},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3394":1623,"_29710":1589,"_20617":53416,"_5":14139,"_27008":53322,"_2880":53417},[],"Renewal authentication",{"_3394":1624,"_29710":1589,"_20617":53419,"_5":14139,"_27008":53322,"_2880":53420},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3394":1625,"_29710":1589,"_20617":53422,"_5":14139,"_27008":53322,"_2880":53423},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3394":1626,"_29710":1589,"_20617":53425,"_5":14139,"_27008":53322,"_2880":53426},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3394":1627,"_29710":1589,"_20617":53428,"_5":14139,"_27008":53322,"_2880":53429},[],"Re-enrollment Delta",{"_3394":1628,"_29710":1589,"_20617":53431,"_5":14139,"_27008":53322,"_2880":53432},[],"1 hour.",{"_3394":1629,"_29710":1589,"_20617":53434,"_5":14139,"_27008":53322,"_2880":53435},[],"Preventive / Critical Delta",{"_3394":1630,"_29710":1589,"_20617":53437,"_5":14139,"_27008":53322,"_2880":53438},[],"30 minutes / 10 minutes.",{"_3394":1631,"_29710":1589,"_20617":53440,"_5":14139,"_27008":53322,"_2880":53441},[],"Revoke on Re-enrollment",{"_3394":1632,"_29710":1589,"_20617":53443,"_5":14139,"_27008":53322,"_2880":53444},[],"Disabled to test the successor before retiring the previous identity.",{"_3394":1633,"_29710":1589,"_20617":53446,"_5":14139,"_27008":53322,"_2880":51199},[],{"_3394":1634,"_29710":1589,"_20617":53448,"_5":14139,"_27008":53322,"_2880":53449},[],"Disabled; the operational key is generated in the client.",{"_3394":1635,"_29710":1589,"_20617":53451,"_5":14139,"_27008":53322,"_2880":53452},[],"CA Distribution",{"_3394":1636,"_29710":1589,"_20617":53454,"_5":14139,"_27008":53322,"_2880":53455},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3394":1637,"_29710":1589,"_20617":53457,"_5":14139,"_27008":53322,"_2880":53458},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3394":1638,"_29710":1589,"_20617":53460,"_5":14139,"_27008":53326,"_2880":53461},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3394":1639,"_29710":1589,"_20617":53463,"_5":14139,"_27008":53326,"_2880":53464},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3394":1640,"_29710":1589,"_20617":53466,"_5":14139,"_27008":53330,"_2880":53467},[],"Generate a new key and CSR with the selected identifier:",{"_3394":1641,"_29710":1589,"_20617":53469,"_5":14139,"_27008":53330,"_2880":53470},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3394":1642,"_29710":1589,"_20617":53472,"_5":14139,"_27008":53330,"_2880":53473},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3394":1643,"_29710":1589,"_20617":53475,"_5":14139,"_27008":53334,"_2880":53476},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3394":1644,"_29710":1589,"_20617":53478,"_5":14139,"_27008":53334,"_2880":53479},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3394":1645,"_29710":1589,"_20617":53481,"_5":14139,"_27008":53338,"_2880":53482},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3394":1646,"_29710":1589,"_20617":53484,"_5":14139,"_27008":53338,"_2880":53485},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3394":1647,"_29710":1589,"_20617":53487,"_5":14139,"_27008":53338,"_2880":53488},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3394":1648,"_29710":1589,"_20617":53490,"_5":14139,"_27008":53338,"_2880":53491},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3394":1649,"_29710":1589,"_20617":53493,"_5":14139,"_27008":53338,"_2880":53494},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3394":1650,"_29710":1589,"_20617":53496,"_5":14139,"_27008":53342,"_2880":53497},[],"Check",{"_3394":1651,"_29710":1589,"_20617":53499,"_5":14139,"_27008":53342,"_2880":53500},[],"Expected result",{"_3394":1652,"_29710":1589,"_20617":53502,"_5":14139,"_27008":53342,"_2880":53503},[],"Registration",{"_3394":1653,"_29710":1589,"_20617":53505,"_5":14139,"_27008":53342,"_2880":53506},[],"ID created automatically and correct DMS.",{"_3394":1654,"_29710":1589,"_20617":53508,"_5":14139,"_27008":53342,"_2880":52764},[],{"_3394":1655,"_29710":1589,"_20617":53510,"_5":14139,"_27008":53342,"_2880":53511},[],"CN, profile, serial and key verified.",{"_3394":1656,"_29710":1589,"_20617":53513,"_5":14139,"_27008":53342,"_2880":53514},[],"Inventory",{"_3394":1657,"_29710":1589,"_20617":53516,"_5":14139,"_27008":53342,"_2880":53517},[],"Received serial visible as the current identity and in history.",{"_3394":1658,"_29710":1589,"_20617":53519,"_5":14139,"_27008":53342,"_2880":53520},[],"Consumer",{"_3394":1659,"_29710":1589,"_20617":53522,"_5":14139,"_27008":53342,"_2880":53523},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3394":1660,"_29710":1589,"_20617":53525,"_5":14139,"_27008":53342,"_2880":53526},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3394":1661,"_29710":1589,"_20617":53528,"_5":14139,"_27008":53342,"_2880":53529},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3394":1662,"_29710":1662,"_5":14491,"_2880":50896,"_30063":53531,"_20617":53532,"_27008":1662},[48401,49869,50880,53308],[],{"_3394":1663,"_29710":1662,"_20617":53534,"_5":14139,"_27008":1662,"_2880":53535},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3394":1664,"_29710":1662,"_5":30060,"_20617":53537,"_27008":53538,"_2880":48411},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3394":1665,"_29710":1662,"_5":30060,"_20617":53540,"_27008":53541,"_2880":53542},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3394":1666,"_29710":1662,"_5":30060,"_20617":53544,"_27008":53545,"_2880":53546},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3394":1667,"_29710":1662,"_5":30060,"_20617":53548,"_27008":53549,"_2880":53550},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3394":1668,"_29710":1662,"_5":30060,"_20617":53552,"_27008":53553,"_2880":53554},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3394":1669,"_29710":1662,"_5":30060,"_20617":53556,"_27008":53557,"_2880":53558},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3394":1670,"_29710":1662,"_5":30060,"_20617":53560,"_27008":53561,"_2880":53500},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3394":1671,"_29710":1662,"_5":30060,"_20617":53563,"_27008":53564,"_2880":53565},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3394":1672,"_29710":1662,"_5":30060,"_20617":53567,"_27008":53568,"_2880":53569},[],"/docs/pr-preview/pr-59/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3394":1673,"_29710":1662,"_20617":53571,"_5":14139,"_27008":1662,"_2880":53572},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3394":1674,"_29710":1662,"_20617":53574,"_5":14139,"_27008":1662,"_2880":53575},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3394":1675,"_29710":1662,"_20617":53577,"_5":14139,"_27008":53538,"_2880":53578},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3394":1676,"_29710":1662,"_20617":53580,"_5":14139,"_27008":53538,"_2880":53581},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3394":1677,"_29710":1662,"_20617":53583,"_5":14139,"_27008":53538,"_2880":53584},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3394":1678,"_29710":1662,"_20617":53586,"_5":14139,"_27008":53538,"_2880":53587},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3394":1679,"_29710":1662,"_20617":53589,"_5":14139,"_27008":53541,"_2880":53590},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3394":1680,"_29710":1662,"_20617":53592,"_5":14139,"_27008":53541,"_2880":53593},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3394":1681,"_29710":1662,"_20617":53595,"_5":14139,"_27008":53541,"_2880":53596},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3394":1682,"_29710":1662,"_20617":53598,"_5":14139,"_27008":53541,"_2880":53599},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3394":1683,"_29710":1662,"_20617":53601,"_5":14139,"_27008":53541,"_2880":53602},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3394":1684,"_29710":1662,"_20617":53604,"_5":14139,"_27008":53541,"_2880":53605},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3394":1685,"_29710":1662,"_20617":53607,"_5":14139,"_27008":53541,"_2880":53608},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3394":1686,"_29710":1662,"_20617":53610,"_5":14139,"_27008":53541,"_2880":53611},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3394":1687,"_29710":1662,"_20617":53613,"_5":14139,"_27008":53545,"_2880":53614},[],"Open **Managed Devices** and the registration action. Complete:",{"_3394":1688,"_29710":1662,"_20617":53616,"_5":14139,"_27008":53545,"_2880":53617},[],"**Device ID**: `device-001`.",{"_3394":1689,"_29710":1662,"_20617":53619,"_5":14139,"_27008":53545,"_2880":53620},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3394":1690,"_29710":1662,"_20617":53622,"_5":14139,"_27008":53545,"_2880":53623},[],"**Icon** and **Tags**: optional classification.",{"_3394":1691,"_29710":1662,"_20617":53625,"_5":14139,"_27008":53545,"_2880":53626},[],"Confirm registration.",{"_3394":1692,"_29710":1662,"_20617":53628,"_5":14139,"_27008":53549,"_2880":53629},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3394":1693,"_29710":1662,"_20617":53631,"_5":14139,"_27008":53549,"_2880":53632},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3394":1694,"_29710":1662,"_20617":53634,"_5":14139,"_27008":53553,"_2880":53635},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3394":1695,"_29710":1662,"_20617":53637,"_5":14139,"_27008":53553,"_2880":53638},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3394":1696,"_29710":1662,"_20617":53640,"_5":14139,"_27008":53557,"_2880":53641},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3394":1697,"_29710":1662,"_20617":53643,"_5":14139,"_27008":53557,"_2880":53644},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3394":1698,"_29710":1662,"_20617":53646,"_5":14139,"_27008":53561,"_2880":53497},[],{"_3394":1699,"_29710":1662,"_20617":53648,"_5":14139,"_27008":53561,"_2880":53649},[],"Result",{"_3394":1700,"_29710":1662,"_20617":53651,"_5":14139,"_27008":53561,"_2880":52747},[],{"_3394":1701,"_29710":1662,"_20617":53653,"_5":14139,"_27008":53561,"_2880":53654},[],"`device-001` appears in inventory with the expected DMS.",{"_3394":1702,"_29710":1662,"_20617":53656,"_5":14139,"_27008":53561,"_2880":53657},[],"Current identity",{"_3394":1703,"_29710":1662,"_20617":53659,"_5":14139,"_27008":53561,"_2880":53660},[],"The associated certificate matches the one you verified in PKI.",{"_3394":1704,"_29710":1662,"_20617":53662,"_5":14139,"_27008":53561,"_2880":53663},[],"History",{"_3394":1705,"_29710":1662,"_20617":53665,"_5":14139,"_27008":53561,"_2880":53666},[],"The associated issuance appears with its serial number and dates.",{"_3394":1706,"_29710":1662,"_20617":53668,"_5":14139,"_27008":53561,"_2880":53669},[],"Key and certificate",{"_3394":1707,"_29710":1662,"_20617":53671,"_5":14139,"_27008":53561,"_2880":53672},[],"You have the verified pair ready to install on the device.",{"_3394":1708,"_29710":1662,"_20617":53674,"_5":14139,"_27008":53564,"_2880":53675},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3394":1709,"_29710":1662,"_20617":53677,"_5":14139,"_27008":53564,"_2880":53678},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3394":1710,"_29710":1662,"_20617":53680,"_5":14139,"_27008":53564,"_2880":53681},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3394":1711,"_29710":1662,"_20617":53683,"_5":14139,"_27008":53564,"_2880":53684},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3394":1712,"_29710":1662,"_20617":53686,"_5":14139,"_27008":53568,"_2880":53687},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3394":1713,"_29710":1662,"_20617":53689,"_5":14139,"_27008":53568,"_2880":53690},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3394":1714,"_29710":1662,"_20617":53692,"_5":14139,"_27008":53568,"_2880":53693},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3394":1715,"_29710":1715,"_5":14491,"_2880":53695,"_30063":53696,"_20617":53697,"_27008":1715},"Lamassu IoT Platform",[48401,49869],[],{"_3394":1716,"_29710":1715,"_20617":53699,"_5":14139,"_27008":1715,"_2880":53700},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3394":1717,"_29710":1715,"_5":30060,"_20617":53702,"_27008":53703,"_2880":53183},[],"/docs/pr-preview/pr-59/platform/overview#start-here",{"_3394":1718,"_29710":1715,"_5":30060,"_20617":53705,"_27008":53706,"_2880":53707},[],"/docs/pr-preview/pr-59/platform/overview#choose-your-path","Choose your path",{"_3394":1719,"_29710":1715,"_5":30060,"_20617":53709,"_27008":53710,"_2880":53711},[],"/docs/pr-preview/pr-59/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3394":1720,"_29710":1715,"_5":30060,"_20617":53713,"_27008":53714,"_2880":53715},[],"/docs/pr-preview/pr-59/platform/overview#core-capabilities","Core capabilities",{"_3394":1721,"_29710":1715,"_5":30060,"_20617":53717,"_27008":53718,"_2880":53719},[],"/docs/pr-preview/pr-59/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3394":1722,"_29710":1715,"_5":30060,"_20617":53721,"_27008":53722,"_2880":53723},[],"/docs/pr-preview/pr-59/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3394":1723,"_29710":1715,"_5":30060,"_20617":53725,"_27008":53726,"_2880":53727},[],"/docs/pr-preview/pr-59/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3394":1724,"_29710":1715,"_5":30060,"_20617":53729,"_27008":53730,"_2880":53731},[],"/docs/pr-preview/pr-59/platform/overview#automate-device-identities","Automate device identities",{"_3394":1725,"_29710":1715,"_5":30060,"_20617":53733,"_27008":53734,"_2880":53735},[],"/docs/pr-preview/pr-59/platform/overview#publish-validation-status","Publish validation status",{"_3394":1726,"_29710":1715,"_5":30060,"_20617":53737,"_27008":53738,"_2880":53739},[],"/docs/pr-preview/pr-59/platform/overview#react-to-events","React to events",{"_3394":1727,"_29710":1715,"_5":30060,"_20617":53741,"_27008":53742,"_2880":53743},[],"/docs/pr-preview/pr-59/platform/overview#operational-reference","Operational reference",{"_3394":1728,"_29710":1715,"_20617":53745,"_5":14139,"_27008":1715,"_2880":53746},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3394":1729,"_29710":1715,"_20617":53748,"_5":14139,"_27008":53703,"_2880":53749},[],"Choose the result you need:",{"_3394":1730,"_29710":1715,"_20617":53751,"_5":14139,"_27008":53703,"_2880":53752},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3394":1731,"_29710":1715,"_20617":53754,"_5":14139,"_27008":53703,"_2880":53755},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3394":1732,"_29710":1715,"_20617":53757,"_5":14139,"_27008":53703,"_2880":53758},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3394":1733,"_29710":1715,"_20617":53760,"_5":14139,"_27008":53706,"_2880":53761},[],"Section",{"_3394":1734,"_29710":1715,"_20617":53763,"_5":14139,"_27008":53706,"_2880":53764},[],"What you manage",{"_3394":1735,"_29710":1715,"_20617":53766,"_5":14139,"_27008":53706,"_2880":53767},[],"Entry point",{"_3394":1736,"_29710":1715,"_20617":53769,"_5":14139,"_27008":53706,"_2880":53770},[],"**PKI**",{"_3394":1737,"_29710":1715,"_20617":53772,"_5":14139,"_27008":53706,"_2880":53773},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3394":1738,"_29710":1715,"_20617":53775,"_5":14139,"_27008":53706,"_2880":53776},[],"PKI overview",{"_3394":1739,"_29710":1715,"_20617":53778,"_5":14139,"_27008":53706,"_2880":53779},[],"**IoT Fleets**",{"_3394":1740,"_29710":1715,"_20617":53781,"_5":14139,"_27008":53706,"_2880":53782},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3394":1741,"_29710":1715,"_20617":53784,"_5":14139,"_27008":53706,"_2880":53785},[],"IoT Fleets overview",{"_3394":1742,"_29710":1715,"_20617":53787,"_5":14139,"_27008":53706,"_2880":53788},[],"**Administration**",{"_3394":1743,"_29710":1715,"_20617":53790,"_5":14139,"_27008":53706,"_2880":53791},[],"Operator permissions, audit and event subscriptions.",{"_3394":1744,"_29710":1715,"_20617":53793,"_5":14139,"_27008":53706,"_2880":49867},[],{"_3394":1745,"_29710":1715,"_20617":53795,"_5":14139,"_27008":53706,"_2880":53796},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3394":1746,"_29710":1715,"_20617":53798,"_5":14139,"_27008":53710,"_2880":53799},[],"An identity's journey connects four responsibilities:",{"_3394":1747,"_29710":1715,"_20617":53801,"_5":14139,"_27008":53710,"_2880":53802},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3394":1748,"_29710":1715,"_20617":53804,"_5":14139,"_27008":53710,"_2880":53805},[],"The provisioning administrator configures the DMS and initial trust.",{"_3394":1749,"_29710":1715,"_20617":53807,"_5":14139,"_27008":53710,"_2880":53808},[],"The device client requests a certificate and installs it with the matching key.",{"_3394":1750,"_29710":1715,"_20617":53810,"_5":14139,"_27008":53710,"_2880":53811},[],"The consumer validates the identity and applies its access permissions.",{"_3394":1751,"_29710":1715,"_20617":53813,"_5":14139,"_27008":53710,"_2880":53814},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3394":1752,"_29710":1715,"_20617":53816,"_5":14139,"_27008":53718,"_2880":53817},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3394":1753,"_29710":1715,"_20617":53819,"_5":14139,"_27008":53722,"_2880":53820},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3394":1754,"_29710":1715,"_20617":53822,"_5":14139,"_27008":53726,"_2880":53823},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3394":1755,"_29710":1715,"_20617":53825,"_5":14139,"_27008":53730,"_2880":53826},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3394":1756,"_29710":1715,"_20617":53828,"_5":14139,"_27008":53734,"_2880":53829},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3394":1757,"_29710":1715,"_20617":53831,"_5":14139,"_27008":53738,"_2880":53832},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3394":1758,"_29710":1715,"_20617":53834,"_5":14139,"_27008":53742,"_2880":53277},[],{"_3394":1759,"_29710":1715,"_20617":53836,"_5":14139,"_27008":53742,"_2880":53837},[],"What it prepares or checks",{"_3394":1760,"_29710":1715,"_20617":53839,"_5":14139,"_27008":53742,"_2880":53280},[],{"_3394":1761,"_29710":1715,"_20617":53841,"_5":14139,"_27008":53742,"_2880":53842},[],"Key custody, CA hierarchy, profiles and validation.",{"_3394":1762,"_29710":1715,"_20617":53844,"_5":14139,"_27008":53742,"_2880":53845},[],"Fleet administrator",{"_3394":1763,"_29710":1715,"_20617":53847,"_5":14139,"_27008":53742,"_2880":53848},[],"DMS, device admission, renewal policy and inventory.",{"_3394":1764,"_29710":1715,"_20617":53850,"_5":14139,"_27008":53742,"_2880":53292},[],{"_3394":1765,"_29710":1715,"_20617":53852,"_5":14139,"_27008":53742,"_2880":53853},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3394":1766,"_29710":1715,"_20617":53855,"_5":14139,"_27008":53742,"_2880":53298},[],{"_3394":1767,"_29710":1715,"_20617":53857,"_5":14139,"_27008":53742,"_2880":53858},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3394":1768,"_29710":1715,"_20617":53860,"_5":14139,"_27008":53742,"_2880":53861},[],"Infrastructure operator",{"_3394":1769,"_29710":1715,"_20617":53863,"_5":14139,"_27008":53742,"_2880":53864},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3394":1770,"_29710":1715,"_20617":53866,"_5":14139,"_27008":53742,"_2880":53867},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3394":1771,"_29710":1771,"_5":14491,"_2880":53869,"_30063":53870,"_20617":53873,"_27008":1771},"CA hierarchy and rotation",[48401,49869,53871,53872],"PKI","Keys, authorities and certificates",[],{"_3394":1772,"_29710":1771,"_20617":53875,"_5":14139,"_27008":1771,"_2880":53876},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3394":1773,"_29710":1771,"_5":30060,"_20617":53878,"_27008":53879,"_2880":53880},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3394":1774,"_29710":1771,"_5":30060,"_20617":53882,"_27008":53883,"_2880":53884},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3394":1775,"_29710":1771,"_5":30060,"_20617":53886,"_27008":53887,"_2880":53888},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3394":1776,"_29710":1771,"_5":30060,"_20617":53890,"_27008":53891,"_2880":53892},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3394":1777,"_29710":1771,"_5":30060,"_20617":53894,"_27008":53895,"_2880":53896},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3394":1778,"_29710":1771,"_5":30060,"_20617":53898,"_27008":53899,"_2880":53900},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3394":1779,"_29710":1771,"_5":30060,"_20617":53902,"_27008":53903,"_2880":53904},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3394":1780,"_29710":1771,"_5":30060,"_20617":53906,"_27008":53907,"_2880":53908},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3394":1781,"_29710":1771,"_5":30060,"_20617":53910,"_27008":53911,"_2880":53912},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3394":1782,"_29710":1771,"_5":30060,"_20617":53914,"_27008":53915,"_2880":53916},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3394":1783,"_29710":1771,"_5":30060,"_20617":53918,"_27008":53919,"_2880":53920},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3394":1784,"_29710":1771,"_5":30060,"_20617":53922,"_27008":53923,"_2880":53924},[],"/docs/pr-preview/pr-59/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3394":1785,"_29710":1771,"_20617":53926,"_5":14139,"_27008":1771,"_2880":53927},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3394":1786,"_29710":1771,"_20617":53929,"_5":14139,"_27008":1771,"_2880":53930},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3394":1787,"_29710":1771,"_20617":53932,"_5":14139,"_27008":53879,"_2880":53933},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3394":1788,"_29710":1771,"_20617":53935,"_5":14139,"_27008":53879,"_2880":53936},[],"environment, such as production and preproduction;",{"_3394":1789,"_29710":1771,"_20617":53938,"_5":14139,"_27008":53879,"_2880":53939},[],"owner or operating team;",{"_3394":1790,"_29710":1771,"_20617":53941,"_5":14139,"_27008":53879,"_2880":53942},[],"device family or manufacturing process;",{"_3394":1791,"_29710":1771,"_20617":53944,"_5":14139,"_27008":53879,"_2880":53945},[],"region or regulatory requirement;",{"_3394":1792,"_29710":1771,"_20617":53947,"_5":14139,"_27008":53879,"_2880":53948},[],"cryptographic engine or key policy;",{"_3394":1793,"_29710":1771,"_20617":53950,"_5":14139,"_27008":53879,"_2880":53951},[],"maintenance window and renewal cadence.",{"_3394":1794,"_29710":1771,"_20617":53953,"_5":14139,"_27008":53879,"_2880":53954},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3394":1795,"_29710":1771,"_20617":53956,"_5":14139,"_27008":53879,"_2880":53957},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3394":1796,"_29710":1771,"_20617":53959,"_5":14139,"_27008":53883,"_2880":53960},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3394":1797,"_29710":1771,"_20617":53962,"_5":14139,"_27008":53883,"_2880":53963},[],"If a VA CRL role for the CA is signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for a role signed by a different certificate, the role keeps its signer, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3394":1798,"_29710":1771,"_20617":53965,"_5":14139,"_27008":53883,"_2880":53966},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3394":1799,"_29710":1771,"_20617":53968,"_5":14139,"_27008":53883,"_2880":53969},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3394":1800,"_29710":1771,"_20617":53971,"_5":14139,"_27008":53887,"_2880":53972},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3394":1801,"_29710":1771,"_20617":53974,"_5":14139,"_27008":53887,"_2880":53975},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3394":1802,"_29710":1771,"_20617":53977,"_5":14139,"_27008":53887,"_2880":53978},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3394":1803,"_29710":1771,"_20617":53980,"_5":14139,"_27008":53887,"_2880":53981},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3394":1804,"_29710":1771,"_20617":53983,"_5":14139,"_27008":53895,"_2880":53984},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3394":1805,"_29710":1771,"_20617":53986,"_5":14139,"_27008":53899,"_2880":53987},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3394":1806,"_29710":1771,"_20617":53989,"_5":14139,"_27008":53903,"_2880":53990},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3394":1807,"_29710":1771,"_20617":53992,"_5":14139,"_27008":53907,"_2880":53993},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3394":1808,"_29710":1771,"_20617":53995,"_5":14139,"_27008":53911,"_2880":53996},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3394":1809,"_29710":1771,"_20617":53998,"_5":14139,"_27008":53915,"_2880":53999},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3394":1810,"_29710":1771,"_20617":54001,"_5":14139,"_27008":53919,"_2880":54002},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3394":1811,"_29710":1771,"_20617":54004,"_5":14139,"_27008":53919,"_2880":54005},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3394":1812,"_29710":1771,"_20617":54007,"_5":14139,"_27008":53919,"_2880":54008},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3394":1813,"_29710":1771,"_20617":54010,"_5":14139,"_27008":53919,"_2880":54011},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3394":1814,"_29710":1771,"_20617":54013,"_5":14139,"_27008":53923,"_2880":54014},[],"The new chain ends in an anchor installed by the consumer.",{"_3394":1815,"_29710":1771,"_20617":54016,"_5":14139,"_27008":53923,"_2880":54017},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3394":1816,"_29710":1771,"_20617":54019,"_5":14139,"_27008":53923,"_2880":54020},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3394":1817,"_29710":1771,"_20617":54022,"_5":14139,"_27008":53923,"_2880":54023},[],"Re-enrollment accepts the old identity during the planned period.",{"_3394":1818,"_29710":1771,"_20617":54025,"_5":14139,"_27008":53923,"_2880":54026},[],"OCSP and CRL respond for the authorities that remain active.",{"_3394":1819,"_29710":1771,"_20617":54028,"_5":14139,"_27008":53923,"_2880":54029},[],"No DMS is left accidentally issuing from the old CA.",{"_3394":1820,"_29710":1771,"_20617":54031,"_5":14139,"_27008":53923,"_2880":54032},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3394":1821,"_29710":1821,"_5":14491,"_2880":54034,"_30063":54035,"_20617":54036,"_27008":1821},"Certification authorities",[48401,49869,53871,53872],[],{"_3394":1822,"_29710":1821,"_20617":54038,"_5":14139,"_27008":1821,"_2880":54039},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3394":1823,"_29710":1821,"_5":30060,"_20617":54041,"_27008":54042,"_2880":54043},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3394":1824,"_29710":1821,"_5":30060,"_20617":54045,"_27008":54046,"_2880":54047},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3394":1825,"_29710":1821,"_5":30060,"_20617":54049,"_27008":54050,"_2880":48411},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#before-you-begin",{"_3394":1826,"_29710":1821,"_5":30060,"_20617":54052,"_27008":54053,"_2880":54054},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3394":1827,"_29710":1821,"_5":30060,"_20617":54056,"_27008":54057,"_2880":54058},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3394":1828,"_29710":1821,"_5":30060,"_20617":54060,"_27008":54061,"_2880":54062},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3394":1829,"_29710":1821,"_5":30060,"_20617":54064,"_27008":54065,"_2880":54066},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3394":1830,"_29710":1821,"_5":30060,"_20617":54068,"_27008":54069,"_2880":54070},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3394":1831,"_29710":1821,"_5":30060,"_20617":54072,"_27008":54073,"_2880":54074},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3394":1832,"_29710":1821,"_5":30060,"_20617":54076,"_27008":54077,"_2880":54078},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3394":1833,"_29710":1821,"_5":30060,"_20617":54080,"_27008":54081,"_2880":54082},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3394":1834,"_29710":1821,"_5":30060,"_20617":54084,"_27008":54085,"_2880":54086},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3394":1835,"_29710":1821,"_5":30060,"_20617":54088,"_27008":54089,"_2880":54090},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3394":1836,"_29710":1821,"_5":30060,"_20617":54092,"_27008":54093,"_2880":54094},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3394":1837,"_29710":1821,"_5":30060,"_20617":54096,"_27008":54097,"_2880":54098},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3394":1838,"_29710":1821,"_5":30060,"_20617":54100,"_27008":54101,"_2880":54102},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3394":1839,"_29710":1821,"_5":30060,"_20617":54104,"_27008":54105,"_2880":54106},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3394":1840,"_29710":1821,"_5":30060,"_20617":54108,"_27008":54109,"_2880":54110},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3394":1841,"_29710":1821,"_5":30060,"_20617":54112,"_27008":54113,"_2880":54114},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3394":1842,"_29710":1821,"_5":30060,"_20617":54116,"_27008":54117,"_2880":54118},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3394":1843,"_29710":1821,"_5":30060,"_20617":54120,"_27008":54121,"_2880":54122},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3394":1844,"_29710":1821,"_5":30060,"_20617":54124,"_27008":54125,"_2880":54126},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3394":1845,"_29710":1821,"_5":30060,"_20617":54128,"_27008":54129,"_2880":54130},[],"/docs/pr-preview/pr-59/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3394":1846,"_29710":1821,"_20617":54132,"_5":14139,"_27008":1821,"_2880":54133},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3394":1847,"_29710":1821,"_20617":54135,"_5":14139,"_27008":1821,"_2880":54136},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3394":1848,"_29710":1821,"_20617":54138,"_5":14139,"_27008":1821,"_2880":54139},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3394":1849,"_29710":1821,"_20617":54141,"_5":14139,"_27008":54042,"_2880":54142},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3394":1850,"_29710":1821,"_20617":54144,"_5":14139,"_27008":54042,"_2880":54145},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3394":1851,"_29710":1821,"_20617":54147,"_5":14139,"_27008":54042,"_2880":54148},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3394":1852,"_29710":1821,"_20617":54150,"_5":14139,"_27008":54042,"_2880":54151},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3394":1853,"_29710":1821,"_20617":54153,"_5":14139,"_27008":54042,"_2880":54154},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3394":1854,"_29710":1821,"_20617":54156,"_5":14139,"_27008":54050,"_2880":54157},[],"Decide whether the CA will be a root or an intermediate.",{"_3394":1855,"_29710":1821,"_20617":54159,"_5":14139,"_27008":54050,"_2880":54160},[],"Choose the engine that will keep the key.",{"_3394":1856,"_29710":1821,"_20617":54162,"_5":14139,"_27008":54050,"_2880":54163},[],"Define a validity longer than that of the certificates it will issue.",{"_3394":1857,"_29710":1821,"_20617":54165,"_5":14139,"_27008":54050,"_2880":54166},[],"For an intermediate CA, make sure the parent CA is active.",{"_3394":1858,"_29710":1821,"_20617":54168,"_5":14139,"_27008":54053,"_2880":54169},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3394":1859,"_29710":1821,"_20617":54171,"_5":14139,"_27008":54057,"_2880":54172},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3394":1860,"_29710":1821,"_20617":54174,"_5":14139,"_27008":54057,"_2880":54175},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3394":1861,"_29710":1821,"_20617":54177,"_5":14139,"_27008":54061,"_2880":54178},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3394":1862,"_29710":1821,"_20617":54180,"_5":14139,"_27008":54065,"_2880":54181},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3394":1863,"_29710":1821,"_20617":54183,"_5":14139,"_27008":54065,"_2880":54184},[],"`C`: two-letter ISO 3166-1 country code.",{"_3394":1864,"_29710":1821,"_20617":54186,"_5":14139,"_27008":54065,"_2880":54187},[],"`ST`: state or province.",{"_3394":1865,"_29710":1821,"_20617":54189,"_5":14139,"_27008":54065,"_2880":54190},[],"`L`: locality.",{"_3394":1866,"_29710":1821,"_20617":54192,"_5":14139,"_27008":54065,"_2880":54193},[],"`O`: organization.",{"_3394":1867,"_29710":1821,"_20617":54195,"_5":14139,"_27008":54065,"_2880":54196},[],"`OU`: organizational unit.",{"_3394":1868,"_29710":1821,"_20617":54198,"_5":14139,"_27008":54065,"_2880":54199},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3394":1869,"_29710":1821,"_20617":54201,"_5":14139,"_27008":54069,"_2880":54202},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3394":1870,"_29710":1821,"_20617":54204,"_5":14139,"_27008":54069,"_2880":54205},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3394":1871,"_29710":1821,"_20617":54207,"_5":14139,"_27008":54073,"_2880":54208},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3394":1872,"_29710":1821,"_20617":54210,"_5":14139,"_27008":54073,"_2880":54211},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3394":1873,"_29710":1821,"_20617":54213,"_5":14139,"_27008":54077,"_2880":54214},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3394":1874,"_29710":1821,"_20617":54216,"_5":14139,"_27008":54077,"_2880":54217},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3394":1875,"_29710":1821,"_20617":54219,"_5":14139,"_27008":54081,"_2880":54220},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3394":1876,"_29710":1821,"_20617":54222,"_5":14139,"_27008":54081,"_2880":54223},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3394":1877,"_29710":1821,"_20617":54225,"_5":14139,"_27008":54081,"_2880":54226},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3394":1878,"_29710":1821,"_20617":54228,"_5":14139,"_27008":54085,"_2880":54229},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3394":1879,"_29710":1821,"_20617":54231,"_5":14139,"_27008":54089,"_2880":54232},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3394":1880,"_29710":1821,"_20617":54234,"_5":14139,"_27008":54089,"_2880":54235},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3394":1881,"_29710":1821,"_20617":54237,"_5":14139,"_27008":54093,"_2880":54238},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3394":1882,"_29710":1821,"_20617":54240,"_5":14139,"_27008":54097,"_2880":54241},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3394":1883,"_29710":1821,"_20617":54243,"_5":14139,"_27008":54097,"_2880":54244},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3394":1884,"_29710":1821,"_20617":54246,"_5":14139,"_27008":54101,"_2880":54247},[],"Open a CA from the inventory to review:",{"_3394":1885,"_29710":1821,"_20617":54249,"_5":14139,"_27008":54101,"_2880":54250},[],"Status and validity period.",{"_3394":1886,"_29710":1821,"_20617":54252,"_5":14139,"_27008":54101,"_2880":54253},[],"Certificate and chain in PEM format.",{"_3394":1887,"_29710":1821,"_20617":54255,"_5":14139,"_27008":54101,"_2880":54256},[],"Number of active, expired and revoked certificates.",{"_3394":1888,"_29710":1821,"_20617":54258,"_5":14139,"_27008":54101,"_2880":54259},[],"Certificates issued in **Issued Certificates**.",{"_3394":1889,"_29710":1821,"_20617":54261,"_5":14139,"_27008":54101,"_2880":54262},[],"The CRL linked to the authority.",{"_3394":1890,"_29710":1821,"_20617":54264,"_5":14139,"_27008":54101,"_2880":54265},[],"Metadata and the associated cryptographic engine.",{"_3394":1891,"_29710":1821,"_20617":54267,"_5":14139,"_27008":54101,"_2880":54268},[],"You can filter the inventory by name, status and CA type.",{"_3394":1892,"_29710":1821,"_20617":54270,"_5":14139,"_27008":54105,"_2880":54271},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3394":1893,"_29710":1821,"_20617":54273,"_5":14139,"_27008":54105,"_2880":54274},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3394":1894,"_29710":1821,"_20617":54276,"_5":14139,"_27008":54105,"_2880":54277},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3394":1895,"_29710":1821,"_20617":54279,"_5":14139,"_27008":54105,"_2880":54280},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3394":1896,"_29710":1821,"_20617":54282,"_5":14139,"_27008":54109,"_2880":54283},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3394":1897,"_29710":1821,"_20617":54285,"_5":14139,"_27008":54113,"_2880":54286},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3394":1898,"_29710":1821,"_20617":54288,"_5":14139,"_27008":54117,"_2880":54289},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3394":1899,"_29710":1821,"_20617":54291,"_5":14139,"_27008":54121,"_2880":54292},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3394":1900,"_29710":1821,"_20617":54294,"_5":14139,"_27008":54125,"_2880":54295},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3394":1901,"_29710":1821,"_20617":54297,"_5":14139,"_27008":54129,"_2880":54298},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3394":1902,"_29710":1821,"_20617":54300,"_5":14139,"_27008":54129,"_2880":54301},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3394":1903,"_29710":1821,"_20617":54303,"_5":14139,"_27008":54129,"_2880":54304},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3394":1904,"_29710":1904,"_5":14491,"_2880":54306,"_30063":54307,"_20617":54308,"_27008":1904},"Certificate profiles",[48401,49869,53871,53872],[],{"_3394":1905,"_29710":1904,"_20617":54310,"_5":14139,"_27008":1904,"_2880":54311},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3394":1906,"_29710":1904,"_5":30060,"_20617":54313,"_27008":54314,"_2880":54315},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3394":1907,"_29710":1904,"_5":30060,"_20617":54317,"_27008":54318,"_2880":54319},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#validity","Validity",{"_3394":1908,"_29710":1904,"_5":30060,"_20617":54321,"_27008":54322,"_2880":54323},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3394":1909,"_29710":1904,"_5":30060,"_20617":54325,"_27008":54326,"_2880":54327},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3394":1910,"_29710":1904,"_5":30060,"_20617":54329,"_27008":54330,"_2880":54331},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#subject","Subject",{"_3394":1911,"_29710":1904,"_5":30060,"_20617":54333,"_27008":54334,"_2880":54335},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3394":1912,"_29710":1904,"_5":30060,"_20617":54337,"_27008":54338,"_2880":54339},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3394":1913,"_29710":1904,"_5":30060,"_20617":54341,"_27008":54342,"_2880":54343},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3394":1914,"_29710":1904,"_5":30060,"_20617":54345,"_27008":54346,"_2880":54347},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3394":1915,"_29710":1904,"_5":30060,"_20617":54349,"_27008":54350,"_2880":54351},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3394":1916,"_29710":1904,"_5":30060,"_20617":54353,"_27008":54354,"_2880":54355},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3394":1917,"_29710":1904,"_5":30060,"_20617":54357,"_27008":54358,"_2880":54359},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3394":1918,"_29710":1904,"_5":30060,"_20617":54361,"_27008":54362,"_2880":54363},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3394":1919,"_29710":1904,"_5":30060,"_20617":54365,"_27008":54366,"_2880":54367},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3394":1920,"_29710":1904,"_5":30060,"_20617":54369,"_27008":54370,"_2880":54371},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#design-examples","Design examples",{"_3394":1921,"_29710":1904,"_5":30060,"_20617":54373,"_27008":54374,"_2880":54375},[],"/docs/pr-preview/pr-59/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3394":1922,"_29710":1904,"_20617":54377,"_5":14139,"_27008":1904,"_2880":54378},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3394":1923,"_29710":1904,"_20617":54380,"_5":14139,"_27008":1904,"_2880":54381},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3394":1924,"_29710":1904,"_20617":54383,"_5":14139,"_27008":54318,"_2880":54384},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3394":1925,"_29710":1904,"_20617":54386,"_5":14139,"_27008":54318,"_2880":54387},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3394":1926,"_29710":1904,"_20617":54389,"_5":14139,"_27008":54322,"_2880":54390},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3394":1927,"_29710":1904,"_20617":54392,"_5":14139,"_27008":54326,"_2880":54393},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3394":1928,"_29710":1904,"_20617":54395,"_5":14139,"_27008":54326,"_2880":54396},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3394":1929,"_29710":1904,"_20617":54398,"_5":14139,"_27008":54326,"_2880":54399},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3394":1930,"_29710":1904,"_20617":54401,"_5":14139,"_27008":54330,"_2880":54402},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3394":1931,"_29710":1904,"_20617":54404,"_5":14139,"_27008":54334,"_2880":54405},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3394":1932,"_29710":1904,"_20617":54407,"_5":14139,"_27008":54334,"_2880":54408},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3394":1933,"_29710":1904,"_20617":54410,"_5":14139,"_27008":54338,"_2880":54411},[],"The cryptographic enforcement can:",{"_3394":1934,"_29710":1904,"_20617":54413,"_5":14139,"_27008":54338,"_2880":54414},[],"allow or block RSA keys;",{"_3394":1935,"_29710":1904,"_20617":54416,"_5":14139,"_27008":54338,"_2880":54417},[],"limit the supported RSA sizes;",{"_3394":1936,"_29710":1904,"_20617":54419,"_5":14139,"_27008":54338,"_2880":54420},[],"allow or block ECDSA keys;",{"_3394":1937,"_29710":1904,"_20617":54422,"_5":14139,"_27008":54338,"_2880":54423},[],"limit the supported ECDSA sizes or curves.",{"_3394":1938,"_29710":1904,"_20617":54425,"_5":14139,"_27008":54338,"_2880":54426},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3394":1939,"_29710":1904,"_20617":54428,"_5":14139,"_27008":54342,"_2880":54429},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3394":1940,"_29710":1904,"_20617":54431,"_5":14139,"_27008":54342,"_2880":51633},[],{"_3394":1941,"_29710":1904,"_20617":54433,"_5":14139,"_27008":54342,"_2880":54434},[],"First choice",{"_3394":1942,"_29710":1904,"_20617":54436,"_5":14139,"_27008":54342,"_2880":54437},[],"Second choice",{"_3394":1943,"_29710":1904,"_20617":54439,"_5":14139,"_27008":54342,"_2880":54440},[],"If neither is supplied",{"_3394":1944,"_29710":1904,"_20617":54442,"_5":14139,"_27008":54342,"_2880":54443},[],"Direct signing with a CA",{"_3394":1945,"_29710":1904,"_20617":54445,"_5":14139,"_27008":54342,"_2880":54446},[],"`issuance_profile` embedded in the request",{"_3394":1946,"_29710":1904,"_20617":54448,"_5":14139,"_27008":54342,"_2880":54449},[],"Request `issuance_profile_id`",{"_3394":1947,"_29710":1904,"_20617":54451,"_5":14139,"_27008":54342,"_2880":54452},[],"CA default profile (`profile_id`).",{"_3394":1948,"_29710":1904,"_20617":54454,"_5":14139,"_27008":54342,"_2880":54455},[],"Issuance through a DMS",{"_3394":1949,"_29710":1904,"_20617":54457,"_5":14139,"_27008":54342,"_2880":54458},[],"`settings.issuance_profile_id`",{"_3394":1950,"_29710":1904,"_20617":54460,"_5":14139,"_27008":54342,"_2880":54461},[],"`settings.issuance_profile` embedded in the DMS",{"_3394":1951,"_29710":1904,"_20617":54463,"_5":14139,"_27008":54342,"_2880":54464},[],"Enrollment CA default profile.",{"_3394":1952,"_29710":1904,"_20617":54466,"_5":14139,"_27008":54342,"_2880":54467},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3394":1953,"_29710":1904,"_20617":54469,"_5":14139,"_27008":54342,"_2880":54470},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3394":1954,"_29710":1904,"_20617":54472,"_5":14139,"_27008":54350,"_2880":54473},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3394":1955,"_29710":1904,"_20617":54475,"_5":14139,"_27008":54354,"_2880":54476},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3394":1956,"_29710":1904,"_20617":54478,"_5":14139,"_27008":54358,"_2880":54479},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3394":1957,"_29710":1904,"_20617":54481,"_5":14139,"_27008":54362,"_2880":54482},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3394":1958,"_29710":1904,"_20617":54484,"_5":14139,"_27008":54366,"_2880":54485},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3394":1959,"_29710":1904,"_20617":54487,"_5":14139,"_27008":54366,"_2880":54488},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3394":1960,"_29710":1904,"_20617":54490,"_5":14139,"_27008":54370,"_2880":54491},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3394":1961,"_29710":1904,"_20617":54493,"_5":14139,"_27008":54370,"_2880":54494},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3394":1962,"_29710":1904,"_20617":54496,"_5":14139,"_27008":54370,"_2880":54497},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3394":1963,"_29710":1904,"_20617":54499,"_5":14139,"_27008":54370,"_2880":54500},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3394":1964,"_29710":1904,"_20617":54502,"_5":14139,"_27008":54374,"_2880":54503},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3394":1965,"_29710":1904,"_20617":54505,"_5":14139,"_27008":54374,"_2880":54506},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3394":1966,"_29710":1966,"_5":14491,"_2880":54508,"_30063":54509,"_20617":54511,"_27008":1966},"Certificate validation",[48401,49869,53871,54510],"Validation",[],{"_3394":1967,"_29710":1966,"_20617":54513,"_5":14139,"_27008":1966,"_2880":54514},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3394":1968,"_29710":1966,"_5":30060,"_20617":54516,"_27008":54517,"_2880":54518},[],"/docs/pr-preview/pr-59/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3394":1969,"_29710":1966,"_5":30060,"_20617":54520,"_27008":54521,"_2880":54522},[],"/docs/pr-preview/pr-59/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3394":1970,"_29710":1966,"_5":30060,"_20617":54524,"_27008":54525,"_2880":54526},[],"/docs/pr-preview/pr-59/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3394":1971,"_29710":1966,"_20617":54528,"_5":14139,"_27008":1966,"_2880":54529},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3394":1972,"_29710":1966,"_20617":54531,"_5":14139,"_27008":54517,"_2880":54532},[],"Verify these criteria together:",{"_3394":1973,"_29710":1966,"_20617":54534,"_5":14139,"_27008":54517,"_2880":53497},[],{"_3394":1974,"_29710":1966,"_20617":54536,"_5":14139,"_27008":54517,"_2880":54537},[],"Required result",{"_3394":1975,"_29710":1966,"_20617":54539,"_5":14139,"_27008":54517,"_2880":54540},[],"Chain and signature",{"_3394":1976,"_29710":1966,"_20617":54542,"_5":14139,"_27008":54517,"_2880":54543},[],"Valid chain to a root deliberately installed in the consumer.",{"_3394":1977,"_29710":1966,"_20617":54545,"_5":14139,"_27008":54517,"_2880":54546},[],"Dates",{"_3394":1978,"_29710":1966,"_20617":54548,"_5":14139,"_27008":54517,"_2880":54549},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3394":1979,"_29710":1966,"_20617":54551,"_5":14139,"_27008":54517,"_2880":49538},[],{"_3394":1980,"_29710":1966,"_20617":54553,"_5":14139,"_27008":54517,"_2880":54554},[],"Name, SAN or identifier matches the expected peer.",{"_3394":1981,"_29710":1966,"_20617":54556,"_5":14139,"_27008":54517,"_2880":48791},[],{"_3394":1982,"_29710":1966,"_20617":54558,"_5":14139,"_27008":54517,"_2880":54559},[],"KU, EKU and constraints permit the specific operation.",{"_3394":1983,"_29710":1966,"_20617":54561,"_5":14139,"_27008":54517,"_2880":54562},[],"Revocation",{"_3394":1984,"_29710":1966,"_20617":54564,"_5":14139,"_27008":54517,"_2880":54565},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3394":1985,"_29710":1966,"_20617":54567,"_5":14139,"_27008":54517,"_2880":54568},[],"Authorization",{"_3394":1986,"_29710":1966,"_20617":54570,"_5":14139,"_27008":54517,"_2880":54571},[],"The application permits that identity to perform the action.",{"_3394":1987,"_29710":1966,"_20617":54573,"_5":14139,"_27008":54517,"_2880":54574},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3394":1988,"_29710":1966,"_20617":54576,"_5":14139,"_27008":54521,"_2880":54577},[],"Mechanism",{"_3394":1989,"_29710":1966,"_20617":54579,"_5":14139,"_27008":54521,"_2880":54580},[],"When to use it",{"_3394":1990,"_29710":1966,"_20617":54582,"_5":14139,"_27008":54521,"_2880":54583},[],"What you must maintain",{"_3394":1991,"_29710":1966,"_20617":54585,"_5":14139,"_27008":54521,"_2880":54586},[],"OCSP",{"_3394":1992,"_29710":1966,"_20617":54588,"_5":14139,"_27008":54521,"_2880":54589},[],"Status query for a specific certificate.",{"_3394":1993,"_29710":1966,"_20617":54591,"_5":14139,"_27008":54521,"_2880":54592},[],"Responder access, signature verification and cache/freshness policy.",{"_3394":1994,"_29710":1966,"_20617":54594,"_5":14139,"_27008":54521,"_2880":54595},[],"CRL",{"_3394":1995,"_29710":1966,"_20617":54597,"_5":14139,"_27008":54521,"_2880":54598},[],"Local checks for many certificates or offline operation.",{"_3394":1996,"_29710":1966,"_20617":54600,"_5":14139,"_27008":54521,"_2880":54601},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3394":1997,"_29710":1966,"_20617":54603,"_5":14139,"_27008":54521,"_2880":54604},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3394":1998,"_29710":1966,"_20617":54606,"_5":14139,"_27008":54521,"_2880":54607},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3394":1999,"_29710":1966,"_20617":54609,"_5":14139,"_27008":54525,"_2880":54610},[],"Accept a current, authorized certificate with a known chain.",{"_3394":2000,"_29710":1966,"_20617":54612,"_5":14139,"_27008":54525,"_2880":54613},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3394":2001,"_29710":1966,"_20617":54615,"_5":14139,"_27008":54525,"_2880":54616},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3394":2002,"_29710":1966,"_20617":54618,"_5":14139,"_27008":54525,"_2880":54619},[],"Check that a new connection with that identity is rejected.",{"_3394":2003,"_29710":1966,"_20617":54621,"_5":14139,"_27008":54525,"_2880":54622},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3394":2004,"_29710":1966,"_20617":54624,"_5":14139,"_27008":54525,"_2880":54625},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3394":2005,"_29710":1966,"_20617":54627,"_5":14139,"_27008":54525,"_2880":54628},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3394":2006,"_29710":1966,"_20617":54630,"_5":14139,"_27008":54525,"_2880":54631},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3394":2007,"_29710":1966,"_20617":54633,"_5":14139,"_27008":54525,"_2880":54634},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3394":2008,"_29710":2008,"_5":14491,"_2880":54636,"_30063":54637,"_20617":54638,"_27008":2008},"Certificates",[48401,49869,53871,53872],[],{"_3394":2009,"_29710":2008,"_20617":54640,"_5":14139,"_27008":2008,"_2880":54641},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3394":2010,"_29710":2008,"_5":30060,"_20617":54643,"_27008":54644,"_2880":54645},[],"/docs/pr-preview/pr-59/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3394":2011,"_29710":2008,"_5":30060,"_20617":54647,"_27008":54648,"_2880":54649},[],"/docs/pr-preview/pr-59/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3394":2012,"_29710":2008,"_5":30060,"_20617":54651,"_27008":54652,"_2880":54653},[],"/docs/pr-preview/pr-59/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3394":2013,"_29710":2008,"_5":30060,"_20617":54655,"_27008":54656,"_2880":54657},[],"/docs/pr-preview/pr-59/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3394":2014,"_29710":2008,"_5":30060,"_20617":54659,"_27008":54660,"_2880":54661},[],"/docs/pr-preview/pr-59/platform/pki/certificates#open-the-action","Open the action",{"_3394":2015,"_29710":2008,"_5":30060,"_20617":54663,"_27008":54664,"_2880":54665},[],"/docs/pr-preview/pr-59/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3394":2016,"_29710":2008,"_5":30060,"_20617":54667,"_27008":54668,"_2880":54669},[],"/docs/pr-preview/pr-59/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3394":2017,"_29710":2008,"_5":30060,"_20617":54671,"_27008":54672,"_2880":54673},[],"/docs/pr-preview/pr-59/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3394":2018,"_29710":2008,"_5":30060,"_20617":54675,"_27008":54676,"_2880":54677},[],"/docs/pr-preview/pr-59/platform/pki/certificates#continue","Continue",{"_3394":2019,"_29710":2008,"_20617":54679,"_5":14139,"_27008":2008,"_2880":54680},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3394":2020,"_29710":2008,"_20617":54682,"_5":14139,"_27008":54644,"_2880":54683},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3394":2021,"_29710":2008,"_20617":54685,"_5":14139,"_27008":54644,"_2880":54686},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3394":2022,"_29710":2008,"_20617":54688,"_5":14139,"_27008":54644,"_2880":54689},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3394":2023,"_29710":2008,"_20617":54691,"_5":14139,"_27008":54644,"_2880":54692},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3394":2024,"_29710":2008,"_20617":54694,"_5":14139,"_27008":54644,"_2880":54695},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3394":2025,"_29710":2008,"_20617":54697,"_5":14139,"_27008":54644,"_2880":54698},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3394":2026,"_29710":2008,"_20617":54700,"_5":14139,"_27008":54644,"_2880":54701},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3394":2027,"_29710":2008,"_20617":54703,"_5":14139,"_27008":54648,"_2880":54704},[],"Download the PEM and inspect it:",{"_3394":2028,"_29710":2008,"_20617":54706,"_5":14139,"_27008":54648,"_2880":54707},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3394":2029,"_29710":2008,"_20617":54709,"_5":14139,"_27008":54652,"_2880":54710},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3394":2030,"_29710":2008,"_20617":54712,"_5":14139,"_27008":54652,"_2880":54713},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3394":2031,"_29710":2008,"_20617":54715,"_5":14139,"_27008":54652,"_2880":54716},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3394":2032,"_29710":2008,"_20617":54718,"_5":14139,"_27008":54652,"_2880":54719},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3394":2033,"_29710":2008,"_20617":54721,"_5":14139,"_27008":54652,"_2880":54722},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3394":2034,"_29710":2008,"_20617":54724,"_5":14139,"_27008":54652,"_2880":54725},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3394":2035,"_29710":2008,"_20617":54727,"_5":14139,"_27008":54652,"_2880":54728},[],"For browser key generation, follow Issue your first certificate.",{"_3394":2036,"_29710":2008,"_20617":54730,"_5":14139,"_27008":54656,"_2880":54731},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3394":2037,"_29710":2008,"_20617":54733,"_5":14139,"_27008":54660,"_2880":54734},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3394":2038,"_29710":2008,"_20617":54736,"_5":14139,"_27008":54664,"_2880":54737},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3394":2039,"_29710":2008,"_20617":54739,"_5":14139,"_27008":54668,"_2880":54740},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3394":2040,"_29710":2008,"_20617":54742,"_5":14139,"_27008":54668,"_2880":54743},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3394":2041,"_29710":2008,"_20617":54745,"_5":14139,"_27008":54668,"_2880":54746},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3394":2042,"_29710":2008,"_20617":54748,"_5":14139,"_27008":54672,"_2880":54749},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3394":2043,"_29710":2008,"_20617":54751,"_5":14139,"_27008":54672,"_2880":54752},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3394":2044,"_29710":2008,"_20617":54754,"_5":14139,"_27008":54672,"_2880":54755},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3394":2045,"_29710":2008,"_20617":54757,"_5":14139,"_27008":54676,"_2880":54758},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3394":2046,"_29710":2008,"_20617":54760,"_5":14139,"_27008":54676,"_2880":54761},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3394":2047,"_29710":2047,"_5":14491,"_2880":54763,"_30063":54764,"_20617":54766,"_27008":2047},"Certificate lifecycle",[48401,49869,53871,54765],"Concepts",[],{"_3394":2048,"_29710":2047,"_20617":54768,"_5":14139,"_27008":2047,"_2880":54769},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3394":2049,"_29710":2047,"_5":30060,"_20617":54771,"_27008":54772,"_2880":54773},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3394":2050,"_29710":2047,"_5":30060,"_20617":54775,"_27008":54776,"_2880":54777},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3394":2051,"_29710":2047,"_5":30060,"_20617":54779,"_27008":54780,"_2880":54781},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3394":2052,"_29710":2047,"_5":30060,"_20617":54783,"_27008":54784,"_2880":54785},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3394":2053,"_29710":2047,"_5":30060,"_20617":54787,"_27008":54788,"_2880":54789},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3394":2054,"_29710":2047,"_5":30060,"_20617":54791,"_27008":54792,"_2880":54793},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3394":2055,"_29710":2047,"_5":30060,"_20617":54795,"_27008":54796,"_2880":54797},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3394":2056,"_29710":2047,"_5":30060,"_20617":54799,"_27008":54800,"_2880":54801},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3394":2057,"_29710":2047,"_5":30060,"_20617":54803,"_27008":54804,"_2880":54805},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3394":2058,"_29710":2047,"_5":30060,"_20617":54807,"_27008":54808,"_2880":54809},[],"/docs/pr-preview/pr-59/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3394":2059,"_29710":2047,"_20617":54811,"_5":14139,"_27008":2047,"_2880":54812},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3394":2060,"_29710":2047,"_20617":54814,"_5":14139,"_27008":54776,"_2880":54815},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3394":2061,"_29710":2047,"_20617":54817,"_5":14139,"_27008":54780,"_2880":54818},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3394":2062,"_29710":2047,"_20617":54820,"_5":14139,"_27008":54784,"_2880":54821},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3394":2063,"_29710":2047,"_20617":54823,"_5":14139,"_27008":54788,"_2880":54824},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3394":2064,"_29710":2047,"_20617":54826,"_5":14139,"_27008":54792,"_2880":54827},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3394":2065,"_29710":2047,"_20617":54829,"_5":14139,"_27008":54796,"_2880":54830},[],"Lamassu persists four X.509 states:",{"_3394":2066,"_29710":2047,"_20617":54832,"_5":14139,"_27008":54796,"_2880":54833},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3394":2067,"_29710":2047,"_20617":54835,"_5":14139,"_27008":54796,"_2880":54836},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3394":2068,"_29710":2047,"_20617":54838,"_5":14139,"_27008":54796,"_2880":54839},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3394":2069,"_29710":2047,"_20617":54841,"_5":14139,"_27008":54796,"_2880":54842},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3394":2070,"_29710":2047,"_20617":54844,"_5":14139,"_27008":54796,"_2880":54845},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3394":2071,"_29710":2047,"_20617":54847,"_5":14139,"_27008":54800,"_2880":54848},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3394":2072,"_29710":2047,"_20617":54850,"_5":14139,"_27008":54800,"_2880":54851},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3394":2073,"_29710":2047,"_20617":54853,"_5":14139,"_27008":54800,"_2880":54854},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3394":2074,"_29710":2047,"_20617":54856,"_5":14139,"_27008":54804,"_2880":54857},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3394":2075,"_29710":2047,"_20617":54859,"_5":14139,"_27008":54804,"_2880":54860},[],"Before confirming:",{"_3394":2076,"_29710":2047,"_20617":54862,"_5":14139,"_27008":54804,"_2880":54863},[],"Identify DMSs, devices and services that trust that chain.",{"_3394":2077,"_29710":2047,"_20617":54865,"_5":14139,"_27008":54804,"_2880":54866},[],"Distribute the new chain of trust.",{"_3394":2078,"_29710":2047,"_20617":54868,"_5":14139,"_27008":54804,"_2880":54869},[],"Reissue the necessary identities.",{"_3394":2079,"_29710":2047,"_20617":54871,"_5":14139,"_27008":54804,"_2880":54872},[],"Check OCSP and CRL from a real consumer.",{"_3394":2080,"_29710":2047,"_20617":54874,"_5":14139,"_27008":54804,"_2880":54875},[],"Revoke the old CA once no legitimate traffic remains.",{"_3394":2081,"_29710":2047,"_20617":54877,"_5":14139,"_27008":54804,"_2880":54878},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3394":2082,"_29710":2047,"_20617":54880,"_5":14139,"_27008":54808,"_2880":54881},[],"Certificates entering the preventive or critical renewal window.",{"_3394":2083,"_29710":2047,"_20617":54883,"_5":14139,"_27008":54808,"_2880":54884},[],"Repeated enrollment or re-enrollment failures.",{"_3394":2084,"_29710":2047,"_20617":54886,"_5":14139,"_27008":54808,"_2880":54887},[],"Status changes and revocation reasons.",{"_3394":2085,"_29710":2047,"_20617":54889,"_5":14139,"_27008":54808,"_2880":54890},[],"OCSP and CRL publication and validity.",{"_3394":2086,"_29710":2047,"_20617":54892,"_5":14139,"_27008":54808,"_2880":54893},[],"Dependencies still presenting a replaced certificate.",{"_3394":2087,"_29710":2047,"_20617":54895,"_5":14139,"_27008":54808,"_2880":54896},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3394":2088,"_29710":2088,"_5":14491,"_2880":54898,"_30063":54899,"_20617":54900,"_27008":2088},"Trust model",[48401,49869,53871,54765],[],{"_3394":2089,"_29710":2088,"_20617":54902,"_5":14139,"_27008":2088,"_2880":54903},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3394":2090,"_29710":2088,"_5":30060,"_20617":54905,"_27008":54906,"_2880":54907},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3394":2091,"_29710":2088,"_5":30060,"_20617":54909,"_27008":54910,"_2880":54911},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3394":2092,"_29710":2088,"_5":30060,"_20617":54913,"_27008":54914,"_2880":54915},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3394":2093,"_29710":2088,"_5":30060,"_20617":54917,"_27008":54918,"_2880":54919},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3394":2094,"_29710":2088,"_5":30060,"_20617":54921,"_27008":54922,"_2880":54923},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3394":2095,"_29710":2088,"_5":30060,"_20617":54925,"_27008":54926,"_2880":54927},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3394":2096,"_29710":2088,"_5":30060,"_20617":54929,"_27008":54930,"_2880":54931},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3394":2097,"_29710":2088,"_5":30060,"_20617":54933,"_27008":54934,"_2880":54935},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3394":2098,"_29710":2088,"_5":30060,"_20617":54937,"_27008":54938,"_2880":54939},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3394":2099,"_29710":2088,"_5":30060,"_20617":54941,"_27008":54942,"_2880":54943},[],"/docs/pr-preview/pr-59/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3394":2100,"_29710":2088,"_20617":54945,"_5":14139,"_27008":2088,"_2880":54946},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3394":2101,"_29710":2088,"_20617":54948,"_5":14139,"_27008":54910,"_2880":54949},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3394":2102,"_29710":2088,"_20617":54951,"_5":14139,"_27008":54914,"_2880":54952},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3394":2103,"_29710":2088,"_20617":54954,"_5":14139,"_27008":54918,"_2880":54955},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3394":2104,"_29710":2088,"_20617":54957,"_5":14139,"_27008":54922,"_2880":54958},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3394":2105,"_29710":2088,"_20617":54960,"_5":14139,"_27008":54926,"_2880":54961},[],"The device proves it can enroll according to the DMS policy.",{"_3394":2106,"_29710":2088,"_20617":54963,"_5":14139,"_27008":54926,"_2880":54964},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3394":2107,"_29710":2088,"_20617":54966,"_5":14139,"_27008":54926,"_2880":54967},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3394":2108,"_29710":2088,"_20617":54969,"_5":14139,"_27008":54926,"_2880":54970},[],"The device installs the certificate and the chain it needs.",{"_3394":2109,"_29710":2088,"_20617":54972,"_5":14139,"_27008":54926,"_2880":54973},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3394":2110,"_29710":2088,"_20617":54975,"_5":14139,"_27008":54926,"_2880":54976},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3394":2111,"_29710":2088,"_20617":54978,"_5":14139,"_27008":54930,"_2880":54979},[],"A DMS relates three sets that are worth designing separately:",{"_3394":2112,"_29710":2088,"_20617":54981,"_5":14139,"_27008":54930,"_2880":54982},[],"**Enrollment CA:** signs the new identities.",{"_3394":2113,"_29710":2088,"_20617":54984,"_5":14139,"_27008":54930,"_2880":54985},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3394":2114,"_29710":2088,"_20617":54987,"_5":14139,"_27008":54930,"_2880":54988},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3394":2115,"_29710":2088,"_20617":54990,"_5":14139,"_27008":54930,"_2880":54991},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3394":2116,"_29710":2088,"_20617":54993,"_5":14139,"_27008":54934,"_2880":54994},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3394":2117,"_29710":2088,"_20617":54996,"_5":14139,"_27008":54934,"_2880":54997},[],"that the current date is between `Not Before` and `Not After`;",{"_3394":2118,"_29710":2088,"_20617":54999,"_5":14139,"_27008":54934,"_2880":55000},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3394":2119,"_29710":2088,"_20617":55002,"_5":14139,"_27008":54934,"_2880":55003},[],"that names, SANs and subject match the expected identity;",{"_3394":2120,"_29710":2088,"_20617":55005,"_5":14139,"_27008":54934,"_2880":55006},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3394":2121,"_29710":2088,"_20617":55008,"_5":14139,"_27008":54934,"_2880":55009},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3394":2122,"_29710":2088,"_20617":55011,"_5":14139,"_27008":54934,"_2880":55012},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3394":2123,"_29710":2088,"_20617":55014,"_5":14139,"_27008":54938,"_2880":55015},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3394":2124,"_29710":2088,"_20617":55017,"_5":14139,"_27008":54942,"_2880":55018},[],"Keep the root out of daily operations, or with very restricted access.",{"_3394":2125,"_29710":2088,"_20617":55020,"_5":14139,"_27008":54942,"_2880":55021},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3394":2126,"_29710":2088,"_20617":55023,"_5":14139,"_27008":54942,"_2880":55024},[],"Assign explicit profiles to every use case.",{"_3394":2127,"_29710":2088,"_20617":55026,"_5":14139,"_27008":54942,"_2880":55027},[],"Distribute the new trust before starting a rotation.",{"_3394":2128,"_29710":2088,"_20617":55029,"_5":14139,"_27008":54942,"_2880":55030},[],"Keep enough overlap to renew a disconnected fleet.",{"_3394":2129,"_29710":2088,"_20617":55032,"_5":14139,"_27008":54942,"_2880":55033},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3394":2130,"_29710":2088,"_20617":55035,"_5":14139,"_27008":54942,"_2880":55036},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3394":2131,"_29710":2131,"_5":14491,"_2880":55038,"_30063":55039,"_20617":55040,"_27008":2131},"Revocation lists (CRL)",[48401,49869,53871,54510],[],{"_3394":2132,"_29710":2131,"_20617":55042,"_5":14139,"_27008":2131,"_2880":55043},[],"Generate and distribute signed lists to validate certificates offline.",{"_3394":2133,"_29710":2131,"_5":30060,"_20617":55045,"_27008":55046,"_2880":55047},[],"/docs/pr-preview/pr-59/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3394":2134,"_29710":2131,"_5":30060,"_20617":55049,"_27008":55050,"_2880":55051},[],"/docs/pr-preview/pr-59/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3394":2135,"_29710":2131,"_5":30060,"_20617":55053,"_27008":55054,"_2880":55055},[],"/docs/pr-preview/pr-59/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3394":2136,"_29710":2131,"_5":30060,"_20617":55057,"_27008":55058,"_2880":55059},[],"/docs/pr-preview/pr-59/platform/pki/crl#crl-contents","CRL contents",{"_3394":2137,"_29710":2131,"_5":30060,"_20617":55061,"_27008":55062,"_2880":55063},[],"/docs/pr-preview/pr-59/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3394":2138,"_29710":2131,"_5":30060,"_20617":55065,"_27008":55066,"_2880":55067},[],"/docs/pr-preview/pr-59/platform/pki/crl#va-role-management-api","VA role management API",{"_3394":2139,"_29710":2131,"_5":30060,"_20617":55069,"_27008":55070,"_2880":55071},[],"/docs/pr-preview/pr-59/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3394":2140,"_29710":2131,"_5":30060,"_20617":55073,"_27008":55074,"_2880":55075},[],"/docs/pr-preview/pr-59/platform/pki/crl#from-the-interface","From the interface",{"_3394":2141,"_29710":2131,"_5":30060,"_20617":55077,"_27008":55078,"_2880":55079},[],"/docs/pr-preview/pr-59/platform/pki/crl#references","References",{"_3394":2142,"_29710":2131,"_20617":55081,"_5":14139,"_27008":2131,"_2880":55082},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3394":2143,"_29710":2131,"_20617":55084,"_5":14139,"_27008":55046,"_2880":55085},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3394":2144,"_29710":2131,"_20617":55087,"_5":14139,"_27008":55046,"_2880":55088},[],"`crl_options` field",{"_3394":2145,"_29710":2131,"_20617":55090,"_5":14139,"_27008":55046,"_2880":48791},[],{"_3394":2146,"_29710":2131,"_20617":55092,"_5":14139,"_27008":55046,"_2880":55093},[],"Backend initial value",{"_3394":2147,"_29710":2131,"_20617":55095,"_5":14139,"_27008":55046,"_2880":55096},[],"`validity`",{"_3394":2148,"_29710":2131,"_20617":55098,"_5":14139,"_27008":55046,"_2880":55099},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3394":2149,"_29710":2131,"_20617":55101,"_5":14139,"_27008":55046,"_2880":55102},[],"7 days.",{"_3394":2150,"_29710":2131,"_20617":55104,"_5":14139,"_27008":55046,"_2880":55105},[],"`refresh_interval`",{"_3394":2151,"_29710":2131,"_20617":55107,"_5":14139,"_27008":55046,"_2880":55108},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3394":2152,"_29710":2131,"_20617":55110,"_5":14139,"_27008":55046,"_2880":55111},[],"6 days and 23 hours.",{"_3394":2153,"_29710":2131,"_20617":55113,"_5":14139,"_27008":55046,"_2880":55114},[],"`regenerate_on_revoke`",{"_3394":2154,"_29710":2131,"_20617":55116,"_5":14139,"_27008":55046,"_2880":55117},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3394":2155,"_29710":2131,"_20617":55119,"_5":14139,"_27008":55046,"_2880":55120},[],"`true`.",{"_3394":2156,"_29710":2131,"_20617":55122,"_5":14139,"_27008":55046,"_2880":55123},[],"`signer_certificate_serial_number`",{"_3394":2157,"_29710":2131,"_20617":55125,"_5":14139,"_27008":55046,"_2880":55126},[],"Serial number of the existing certificate that signs the CRL.",{"_3394":2158,"_29710":2131,"_20617":55128,"_5":14139,"_27008":55046,"_2880":55129},[],"Serial number of the CA’s current certificate.",{"_3394":2159,"_29710":2131,"_20617":55131,"_5":14139,"_27008":55046,"_2880":55132},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3394":2160,"_29710":2131,"_20617":55134,"_5":14139,"_27008":55046,"_2880":55135},[],"When a CA is reissued and the role’s signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the role uses it (the API rejects it with `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3394":2161,"_29710":2131,"_20617":55137,"_5":14139,"_27008":55046,"_2880":55138},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3394":2162,"_29710":2131,"_20617":55140,"_5":14139,"_27008":55046,"_2880":55141},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, check the key usage of the new certificate: if it lacks `cRLSign`, the VA keeps the previous signer and logs a warning, so the lists keep being signed by the superseded certificate until you fix the usage.",{"_3394":2163,"_29710":2131,"_20617":55143,"_5":14139,"_27008":55046,"_2880":55144},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3394":2164,"_29710":2131,"_20617":55146,"_5":14139,"_27008":55046,"_2880":55147},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_3394":2165,"_29710":2131,"_20617":55149,"_5":14139,"_27008":55046,"_2880":55150},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3394":2166,"_29710":2131,"_20617":55152,"_5":14139,"_27008":55050,"_2880":55153},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3394":2167,"_29710":2131,"_20617":55155,"_5":14139,"_27008":55050,"_2880":55156},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3394":2168,"_29710":2131,"_20617":55158,"_5":14139,"_27008":55050,"_2880":55159},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3394":2169,"_29710":2131,"_20617":55161,"_5":14139,"_27008":55050,"_2880":55162},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3394":2170,"_29710":2131,"_20617":55164,"_5":14139,"_27008":55054,"_2880":55165},[],"The VA scheduled job checks every role on each run and requests a new list when either of these conditions is met:",{"_3394":2171,"_29710":2131,"_20617":55167,"_5":14139,"_27008":55054,"_2880":55168},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3394":2172,"_29710":2131,"_20617":55170,"_5":14139,"_27008":55054,"_2880":55171},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3394":2173,"_29710":2131,"_20617":55173,"_5":14139,"_27008":55054,"_2880":55174},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3394":2174,"_29710":2131,"_20617":55176,"_5":14139,"_27008":55054,"_2880":55177},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3394":2175,"_29710":2131,"_20617":55179,"_5":14139,"_27008":55054,"_2880":55180},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3394":2176,"_29710":2131,"_20617":55182,"_5":14139,"_27008":55054,"_2880":55183},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no VA role, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3394":2177,"_29710":2131,"_20617":55185,"_5":14139,"_27008":55054,"_2880":55186},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3394":2178,"_29710":2131,"_20617":55188,"_5":14139,"_27008":55058,"_2880":55189},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3394":2179,"_29710":2131,"_20617":55191,"_5":14139,"_27008":55058,"_2880":55192},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3394":2180,"_29710":2131,"_20617":55194,"_5":14139,"_27008":55062,"_2880":55195},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3394":2181,"_29710":2131,"_20617":55197,"_5":14139,"_27008":55062,"_2880":55198},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3394":2182,"_29710":2131,"_20617":55200,"_5":14139,"_27008":55062,"_2880":55201},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the role points to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3394":2183,"_29710":2131,"_20617":55203,"_5":14139,"_27008":55062,"_2880":55204},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3394":2184,"_29710":2131,"_20617":55206,"_5":14139,"_27008":55062,"_2880":55207},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3394":2185,"_29710":2131,"_20617":55209,"_5":14139,"_27008":55066,"_2880":55210},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3394":2186,"_29710":2131,"_20617":55212,"_5":14139,"_27008":55066,"_2880":51636},[],{"_3394":2187,"_29710":2131,"_20617":55214,"_5":14139,"_27008":55066,"_2880":55215},[],"Relative path",{"_3394":2188,"_29710":2131,"_20617":55217,"_5":14139,"_27008":55066,"_2880":51633},[],{"_3394":2189,"_29710":2131,"_20617":55219,"_5":14139,"_27008":55066,"_2880":55220},[],"`GET`",{"_3394":2190,"_29710":2131,"_20617":55222,"_5":14139,"_27008":55066,"_2880":55223},[],"`/v1/roles/{ca-ski}`",{"_3394":2191,"_29710":2131,"_20617":55225,"_5":14139,"_27008":55066,"_2880":55226},[],"Read `crl_options` and `latest_crl`.",{"_3394":2192,"_29710":2131,"_20617":55228,"_5":14139,"_27008":55066,"_2880":55229},[],"`PUT`",{"_3394":2193,"_29710":2131,"_20617":55231,"_5":14139,"_27008":55066,"_2880":55223},[],{"_3394":2194,"_29710":2131,"_20617":55233,"_5":14139,"_27008":55066,"_2880":55234},[],"Replace CRL configuration.",{"_3394":2195,"_29710":2131,"_20617":55236,"_5":14139,"_27008":55066,"_2880":55237},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3394":2196,"_29710":2131,"_20617":55239,"_5":14139,"_27008":55066,"_2880":55240},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3394":2197,"_29710":2131,"_20617":55242,"_5":14139,"_27008":55070,"_2880":55243},[],"Symptom",{"_3394":2198,"_29710":2131,"_20617":55245,"_5":14139,"_27008":55070,"_2880":55246},[],"Cause",{"_3394":2199,"_29710":2131,"_20617":55248,"_5":14139,"_27008":55070,"_2880":55249},[],"Action",{"_3394":2200,"_29710":2131,"_20617":55251,"_5":14139,"_27008":55070,"_2880":55252},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3394":2201,"_29710":2131,"_20617":55254,"_5":14139,"_27008":55070,"_2880":55255},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3394":2202,"_29710":2131,"_20617":55257,"_5":14139,"_27008":55070,"_2880":55258},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3394":2203,"_29710":2131,"_20617":55260,"_5":14139,"_27008":55070,"_2880":55261},[],"`PUT` returns 400.",{"_3394":2204,"_29710":2131,"_20617":55263,"_5":14139,"_27008":55070,"_2880":55264},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3394":2205,"_29710":2131,"_20617":55266,"_5":14139,"_27008":55070,"_2880":55267},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3394":2206,"_29710":2131,"_20617":55269,"_5":14139,"_27008":55070,"_2880":55270},[],"`PUT` returns 400 from a 3.x client.",{"_3394":2207,"_29710":2131,"_20617":55272,"_5":14139,"_27008":55070,"_2880":55273},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3394":2208,"_29710":2131,"_20617":55275,"_5":14139,"_27008":55070,"_2880":55276},[],"Update the client to send the new field.",{"_3394":2209,"_29710":2131,"_20617":55278,"_5":14139,"_27008":55070,"_2880":55279},[],"The CRL does not change after revoking a certificate.",{"_3394":2210,"_29710":2131,"_20617":55281,"_5":14139,"_27008":55070,"_2880":55282},[],"`regenerate_on_revoke` is `false`, the issuing CA has no VA role, or generation failed because of an invalid signer.",{"_3394":2211,"_29710":2131,"_20617":55284,"_5":14139,"_27008":55070,"_2880":55285},[],"Check the VA logs. A missing role only produces a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3394":2212,"_29710":2131,"_20617":55287,"_5":14139,"_27008":55070,"_2880":55288},[],"A verifier rejects the CRL because of the issuer.",{"_3394":2213,"_29710":2131,"_20617":55290,"_5":14139,"_27008":55070,"_2880":55291},[],"Several CAs share an SKI.",{"_3394":2214,"_29710":2131,"_20617":55293,"_5":14139,"_27008":55070,"_2880":55294},[],"See CAs that share a key.",{"_3394":2215,"_29710":2131,"_20617":55296,"_5":14139,"_27008":55074,"_2880":55297},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3394":2216,"_29710":2131,"_20617":55299,"_5":14139,"_27008":55078,"_2880":55300},[],"RFC 5280: X.509 and CRL profile.",{"_3394":2217,"_29710":2131,"_20617":55302,"_5":14139,"_27008":55078,"_2880":55303},[],"OpenSSL: openssl-crl.",{"_3394":2218,"_29710":2131,"_20617":55305,"_5":14139,"_27008":55078,"_2880":55306},[],"OpenSSL: openssl-verify.",{"_3394":2219,"_29710":2131,"_20617":55308,"_5":14139,"_27008":55078,"_2880":55309},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3394":2220,"_29710":2131,"_20617":55311,"_5":14139,"_27008":55078,"_2880":55312},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3394":2221,"_29710":2221,"_5":14491,"_2880":55314,"_30063":55315,"_20617":55316,"_27008":2221},"Keys and cryptographic engines",[48401,49869,53871,53872],[],{"_3394":2222,"_29710":2221,"_20617":55318,"_5":14139,"_27008":2221,"_2880":55319},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3394":2223,"_29710":2221,"_5":30060,"_20617":55321,"_27008":55322,"_2880":55323},[],"/docs/pr-preview/pr-59/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3394":2224,"_29710":2221,"_5":30060,"_20617":55325,"_27008":55326,"_2880":55327},[],"/docs/pr-preview/pr-59/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3394":2225,"_29710":2221,"_5":30060,"_20617":55329,"_27008":55330,"_2880":55331},[],"/docs/pr-preview/pr-59/platform/pki/key-management#file-system","File System",{"_3394":2226,"_29710":2221,"_5":30060,"_20617":55333,"_27008":55334,"_2880":55335},[],"/docs/pr-preview/pr-59/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3394":2227,"_29710":2221,"_5":30060,"_20617":55337,"_27008":55338,"_2880":55339},[],"/docs/pr-preview/pr-59/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3394":2228,"_29710":2221,"_5":30060,"_20617":55341,"_27008":55342,"_2880":55343},[],"/docs/pr-preview/pr-59/platform/pki/key-management#aws-kms","AWS KMS",{"_3394":2229,"_29710":2221,"_5":30060,"_20617":55345,"_27008":55346,"_2880":55347},[],"/docs/pr-preview/pr-59/platform/pki/key-management#pkcs11","PKCS#11",{"_3394":2230,"_29710":2221,"_5":30060,"_20617":55349,"_27008":55350,"_2880":55351},[],"/docs/pr-preview/pr-59/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3394":2231,"_29710":2221,"_5":30060,"_20617":55353,"_27008":55354,"_2880":55355},[],"/docs/pr-preview/pr-59/platform/pki/key-management#key-inventory","Key inventory",{"_3394":2232,"_29710":2221,"_5":30060,"_20617":55357,"_27008":55358,"_2880":55359},[],"/docs/pr-preview/pr-59/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3394":2233,"_29710":2221,"_5":30060,"_20617":55361,"_27008":55362,"_2880":55363},[],"/docs/pr-preview/pr-59/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3394":2234,"_29710":2221,"_5":30060,"_20617":55365,"_27008":55366,"_2880":55367},[],"/docs/pr-preview/pr-59/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3394":2235,"_29710":2221,"_5":30060,"_20617":55369,"_27008":55370,"_2880":55371},[],"/docs/pr-preview/pr-59/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3394":2236,"_29710":2221,"_5":30060,"_20617":55373,"_27008":55374,"_2880":55375},[],"/docs/pr-preview/pr-59/platform/pki/key-management#view-details","View details",{"_3394":2237,"_29710":2221,"_5":30060,"_20617":55377,"_27008":55378,"_2880":55379},[],"/docs/pr-preview/pr-59/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3394":2238,"_29710":2221,"_5":30060,"_20617":55381,"_27008":55382,"_2880":55383},[],"/docs/pr-preview/pr-59/platform/pki/key-management#sign","Sign",{"_3394":2239,"_29710":2221,"_5":30060,"_20617":55385,"_27008":55386,"_2880":55387},[],"/docs/pr-preview/pr-59/platform/pki/key-management#verify","Verify",{"_3394":2240,"_29710":2221,"_5":30060,"_20617":55389,"_27008":55390,"_2880":55391},[],"/docs/pr-preview/pr-59/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3394":2241,"_29710":2221,"_5":30060,"_20617":55393,"_27008":55394,"_2880":55395},[],"/docs/pr-preview/pr-59/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3394":2242,"_29710":2221,"_5":30060,"_20617":55397,"_27008":55398,"_2880":55399},[],"/docs/pr-preview/pr-59/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3394":2243,"_29710":2221,"_20617":55401,"_5":14139,"_27008":2221,"_2880":55402},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3394":2244,"_29710":2221,"_20617":55404,"_5":14139,"_27008":2221,"_2880":55405},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3394":2245,"_29710":2221,"_20617":55407,"_5":14139,"_27008":55322,"_2880":55408},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3394":2246,"_29710":2221,"_20617":55410,"_5":14139,"_27008":55322,"_2880":55411},[],"In practice, it lets you:",{"_3394":2247,"_29710":2221,"_20617":55413,"_5":14139,"_27008":55322,"_2880":55414},[],"Generate new key pairs from Lamassu IoT.",{"_3394":2248,"_29710":2221,"_20617":55416,"_5":14139,"_27008":55322,"_2880":55417},[],"Import keys created externally.",{"_3394":2249,"_29710":2221,"_20617":55419,"_5":14139,"_27008":55322,"_2880":55420},[],"Delegate custody and cryptographic operations to external engines.",{"_3394":2250,"_29710":2221,"_20617":55422,"_5":14139,"_27008":55322,"_2880":55423},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3394":2251,"_29710":2221,"_20617":55425,"_5":14139,"_27008":55326,"_2880":55426},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3394":2252,"_29710":2221,"_20617":55428,"_5":14139,"_27008":55326,"_2880":55429},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3394":2253,"_29710":2221,"_20617":55431,"_5":14139,"_27008":55326,"_2880":55432},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3394":2254,"_29710":2221,"_20617":55434,"_5":14139,"_27008":55330,"_2880":55435},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3394":2255,"_29710":2221,"_20617":55437,"_5":14139,"_27008":55334,"_2880":55438},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3394":2256,"_29710":2221,"_20617":55440,"_5":14139,"_27008":55334,"_2880":55441},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3394":2257,"_29710":2221,"_20617":55443,"_5":14139,"_27008":55338,"_2880":55444},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3394":2258,"_29710":2221,"_20617":55446,"_5":14139,"_27008":55342,"_2880":55447},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3394":2259,"_29710":2221,"_20617":55449,"_5":14139,"_27008":55346,"_2880":55450},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3394":2260,"_29710":2221,"_20617":55452,"_5":14139,"_27008":55350,"_2880":55453},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3394":2261,"_29710":2221,"_20617":55455,"_5":14139,"_27008":55350,"_2880":55456},[],"Lamassu shows the enabled engines in the console.",{"_3394":2262,"_29710":2221,"_20617":55458,"_5":14139,"_27008":55350,"_2880":55459},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3394":2263,"_29710":2221,"_20617":55461,"_5":14139,"_27008":55350,"_2880":55462},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3394":2264,"_29710":2221,"_20617":55464,"_5":14139,"_27008":55354,"_2880":55465},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3394":2265,"_29710":2221,"_20617":55467,"_5":14139,"_27008":55354,"_2880":55468},[],"The table includes the following fields:",{"_3394":2266,"_29710":2221,"_20617":55470,"_5":14139,"_27008":55354,"_2880":55471},[],"**Name**: descriptive name of the key.",{"_3394":2267,"_29710":2221,"_20617":55473,"_5":14139,"_27008":55354,"_2880":55474},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3394":2268,"_29710":2221,"_20617":55476,"_5":14139,"_27008":55354,"_2880":55477},[],"**Strength**: visual indicator of cryptographic strength.",{"_3394":2269,"_29710":2221,"_20617":55479,"_5":14139,"_27008":55354,"_2880":55480},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3394":2270,"_29710":2221,"_20617":55482,"_5":14139,"_27008":55354,"_2880":55483},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3394":2271,"_29710":2221,"_20617":55485,"_5":14139,"_27008":55354,"_2880":55486},[],"**Aliases**: alternative names associated with the key.",{"_3394":2272,"_29710":2221,"_20617":55488,"_5":14139,"_27008":55354,"_2880":55489},[],"**Tags**: labels for classification and search.",{"_3394":2273,"_29710":2221,"_20617":55491,"_5":14139,"_27008":55354,"_2880":55492},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3394":2274,"_29710":2221,"_20617":55494,"_5":14139,"_27008":55354,"_2880":55495},[],"From this view you also reach the most common actions:",{"_3394":2275,"_29710":2221,"_20617":55497,"_5":14139,"_27008":55354,"_2880":55498},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3394":2276,"_29710":2221,"_20617":55500,"_5":14139,"_27008":55354,"_2880":55501},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3394":2277,"_29710":2221,"_20617":55503,"_5":14139,"_27008":55354,"_2880":55504},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3394":2278,"_29710":2221,"_20617":55506,"_5":14139,"_27008":55354,"_2880":55507},[],"**Delete Key** to remove the key from the system.",{"_3394":2279,"_29710":2221,"_20617":55509,"_5":14139,"_27008":55358,"_2880":55510},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3394":2280,"_29710":2221,"_20617":55512,"_5":14139,"_27008":55362,"_2880":55513},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3394":2281,"_29710":2221,"_20617":55515,"_5":14139,"_27008":55362,"_2880":55516},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3394":2282,"_29710":2221,"_20617":55518,"_5":14139,"_27008":55362,"_2880":55519},[],"**Key Name**: unique and descriptive name.",{"_3394":2283,"_29710":2221,"_20617":55521,"_5":14139,"_27008":55362,"_2880":55522},[],"**Crypto Engine**: engine that will keep the key.",{"_3394":2284,"_29710":2221,"_20617":55524,"_5":14139,"_27008":55362,"_2880":55525},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3394":2285,"_29710":2221,"_20617":55527,"_5":14139,"_27008":55362,"_2880":55528},[],"**Tags**: metadata to classify the key.",{"_3394":2286,"_29710":2221,"_20617":55530,"_5":14139,"_27008":55362,"_2880":55531},[],"**Metadata**: additional information for advanced uses.",{"_3394":2287,"_29710":2221,"_20617":55533,"_5":14139,"_27008":55366,"_2880":55534},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3394":2288,"_29710":2221,"_20617":55536,"_5":14139,"_27008":55366,"_2880":55537},[],"When you have an exportable private key and the destination engine supports import.",{"_3394":2289,"_29710":2221,"_20617":55539,"_5":14139,"_27008":55366,"_2880":55540},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3394":2290,"_29710":2221,"_20617":55542,"_5":14139,"_27008":55366,"_2880":55543},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3394":2291,"_29710":2221,"_20617":55545,"_5":14139,"_27008":55366,"_2880":55546},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3394":2292,"_29710":2221,"_20617":55548,"_5":14139,"_27008":55366,"_2880":55549},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3394":2293,"_29710":2221,"_20617":55551,"_5":14139,"_27008":55366,"_2880":55552},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3394":2294,"_29710":2221,"_20617":55554,"_5":14139,"_27008":55366,"_2880":55555},[],"**Tags**: labels for organization and search.",{"_3394":2295,"_29710":2221,"_20617":55557,"_5":14139,"_27008":55366,"_2880":55558},[],"**Metadata**: additional optional information.",{"_3394":2296,"_29710":2221,"_20617":55560,"_5":14139,"_27008":55366,"_2880":55561},[],"**Private Key (PEM)**: private key in PEM format.",{"_3394":2297,"_29710":2221,"_20617":55563,"_5":14139,"_27008":55366,"_2880":55564},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3394":2298,"_29710":2221,"_20617":55566,"_5":14139,"_27008":55370,"_2880":55567},[],"Each registered key has a detail view and several operational actions.",{"_3394":2299,"_29710":2221,"_20617":55569,"_5":14139,"_27008":55374,"_2880":55570},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3394":2300,"_29710":2221,"_20617":55572,"_5":14139,"_27008":55374,"_2880":55573},[],"The **Overview** tab shows, among others, these fields:",{"_3394":2301,"_29710":2221,"_20617":55575,"_5":14139,"_27008":55374,"_2880":55576},[],"**Key Name**: descriptive name.",{"_3394":2302,"_29710":2221,"_20617":55578,"_5":14139,"_27008":55374,"_2880":55579},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3394":2303,"_29710":2221,"_20617":55581,"_5":14139,"_27008":55374,"_2880":55582},[],"**Tags**: associated labels.",{"_3394":2304,"_29710":2221,"_20617":55584,"_5":14139,"_27008":55374,"_2880":55585},[],"**Aliases**: alternative names.",{"_3394":2305,"_29710":2221,"_20617":55587,"_5":14139,"_27008":55374,"_2880":55588},[],"**Crypto Engine**: engine where the key resides.",{"_3394":2306,"_29710":2221,"_20617":55590,"_5":14139,"_27008":55374,"_2880":55591},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3394":2307,"_29710":2221,"_20617":55593,"_5":14139,"_27008":55374,"_2880":55594},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3394":2308,"_29710":2221,"_20617":55596,"_5":14139,"_27008":55374,"_2880":55597},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3394":2309,"_29710":2221,"_20617":55599,"_5":14139,"_27008":55378,"_2880":55600},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3394":2310,"_29710":2221,"_20617":55602,"_5":14139,"_27008":55378,"_2880":55603},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3394":2311,"_29710":2221,"_20617":55605,"_5":14139,"_27008":55378,"_2880":55606},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3394":2312,"_29710":2221,"_20617":55608,"_5":14139,"_27008":55382,"_2880":55609},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3394":2313,"_29710":2221,"_20617":55611,"_5":14139,"_27008":55382,"_2880":55612},[],"Main fields:",{"_3394":2314,"_29710":2221,"_20617":55614,"_5":14139,"_27008":55382,"_2880":55615},[],"**Algorithm**: signing algorithm available for the key type.",{"_3394":2315,"_29710":2221,"_20617":55617,"_5":14139,"_27008":55382,"_2880":55618},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3394":2316,"_29710":2221,"_20617":55620,"_5":14139,"_27008":55382,"_2880":55621},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3394":2317,"_29710":2221,"_20617":55623,"_5":14139,"_27008":55382,"_2880":55624},[],"**Message**: content to sign.",{"_3394":2318,"_29710":2221,"_20617":55626,"_5":14139,"_27008":55382,"_2880":55627},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3394":2319,"_29710":2221,"_20617":55629,"_5":14139,"_27008":55386,"_2880":55630},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3394":2320,"_29710":2221,"_20617":55632,"_5":14139,"_27008":55386,"_2880":55612},[],{"_3394":2321,"_29710":2221,"_20617":55634,"_5":14139,"_27008":55386,"_2880":55635},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3394":2322,"_29710":2221,"_20617":55637,"_5":14139,"_27008":55386,"_2880":55638},[],"**Message Type**: `Raw` or `Digest`.",{"_3394":2323,"_29710":2221,"_20617":55640,"_5":14139,"_27008":55386,"_2880":55641},[],"**Payload Encoding**: encoding of the message.",{"_3394":2324,"_29710":2221,"_20617":55643,"_5":14139,"_27008":55386,"_2880":55644},[],"**Message**: original message or hash.",{"_3394":2325,"_29710":2221,"_20617":55646,"_5":14139,"_27008":55386,"_2880":55647},[],"**Signature**: signature to check.",{"_3394":2326,"_29710":2221,"_20617":55649,"_5":14139,"_27008":55386,"_2880":55650},[],"**Result**: indicator of the validation result.",{"_3394":2327,"_29710":2221,"_20617":55652,"_5":14139,"_27008":55390,"_2880":55653},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3394":2328,"_29710":2221,"_20617":55655,"_5":14139,"_27008":55390,"_2880":55656},[],"This flow is useful for:",{"_3394":2329,"_29710":2221,"_20617":55658,"_5":14139,"_27008":55390,"_2880":55659},[],"Requesting certificates from an external CA.",{"_3394":2330,"_29710":2221,"_20617":55661,"_5":14139,"_27008":55390,"_2880":55662},[],"Renewing an identity while keeping the same key.",{"_3394":2331,"_29710":2221,"_20617":55664,"_5":14139,"_27008":55390,"_2880":55665},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3394":2332,"_29710":2221,"_20617":55667,"_5":14139,"_27008":55390,"_2880":55668},[],"**Common Name (CN)**: main name of the identity.",{"_3394":2333,"_29710":2221,"_20617":55670,"_5":14139,"_27008":55390,"_2880":55671},[],"**Organization (O)**: organization or company.",{"_3394":2334,"_29710":2221,"_20617":55673,"_5":14139,"_27008":55390,"_2880":55674},[],"**Organizational Unit (OU)**: department or unit.",{"_3394":2335,"_29710":2221,"_20617":55676,"_5":14139,"_27008":55390,"_2880":55677},[],"**Country (C)**: two-letter country code.",{"_3394":2336,"_29710":2221,"_20617":55679,"_5":14139,"_27008":55390,"_2880":55680},[],"**State / Province (ST)**: state or province.",{"_3394":2337,"_29710":2221,"_20617":55682,"_5":14139,"_27008":55390,"_2880":55683},[],"**Locality (L)**: city or locality.",{"_3394":2338,"_29710":2221,"_20617":55685,"_5":14139,"_27008":55390,"_2880":55686},[],"**Email Address**: contact email.",{"_3394":2339,"_29710":2221,"_20617":55688,"_5":14139,"_27008":55390,"_2880":55689},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3394":2340,"_29710":2221,"_20617":55691,"_5":14139,"_27008":55390,"_2880":55692},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3394":2341,"_29710":2221,"_20617":55694,"_5":14139,"_27008":55394,"_2880":55695},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3394":2342,"_29710":2221,"_20617":55697,"_5":14139,"_27008":55394,"_2880":55698},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3394":2343,"_29710":2221,"_20617":55700,"_5":14139,"_27008":55398,"_2880":55701},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3394":2344,"_29710":2221,"_20617":55703,"_5":14139,"_27008":55398,"_2880":55704},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3394":2345,"_29710":2345,"_5":14491,"_2880":55706,"_30063":55707,"_20617":55708,"_27008":2345},"Online validation with OCSP",[48401,49869,53871,54510],[],{"_3394":2346,"_29710":2345,"_20617":55710,"_5":14139,"_27008":2345,"_2880":55711},[],"Query signed status and verify the responder’s response.",{"_3394":2347,"_29710":2345,"_5":30060,"_20617":55713,"_27008":55714,"_2880":55715},[],"/docs/pr-preview/pr-59/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3394":2348,"_29710":2345,"_5":30060,"_20617":55717,"_27008":55718,"_2880":55719},[],"/docs/pr-preview/pr-59/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3394":2349,"_29710":2345,"_5":30060,"_20617":55721,"_27008":55722,"_2880":55723},[],"/docs/pr-preview/pr-59/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3394":2350,"_29710":2345,"_5":30060,"_20617":55725,"_27008":55726,"_2880":55727},[],"/docs/pr-preview/pr-59/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3394":2351,"_29710":2345,"_5":30060,"_20617":55729,"_27008":55730,"_2880":55731},[],"/docs/pr-preview/pr-59/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3394":2352,"_29710":2345,"_5":30060,"_20617":55733,"_27008":55734,"_2880":55079},[],"/docs/pr-preview/pr-59/platform/pki/ocsp#references",{"_3394":2353,"_29710":2345,"_20617":55736,"_5":14139,"_27008":2345,"_2880":55737},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3394":2354,"_29710":2345,"_20617":55739,"_5":14139,"_27008":55714,"_2880":55740},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3394":2355,"_29710":2345,"_20617":55742,"_5":14139,"_27008":55714,"_2880":55743},[],"Record status",{"_3394":2356,"_29710":2345,"_20617":55745,"_5":14139,"_27008":55714,"_2880":55746},[],"Signed response",{"_3394":2357,"_29710":2345,"_20617":55748,"_5":14139,"_27008":55714,"_2880":53008},[],{"_3394":2358,"_29710":2345,"_20617":55750,"_5":14139,"_27008":55714,"_2880":55751},[],"`Good`.",{"_3394":2359,"_29710":2345,"_20617":55753,"_5":14139,"_27008":55714,"_2880":53025},[],{"_3394":2360,"_29710":2345,"_20617":55755,"_5":14139,"_27008":55714,"_2880":55756},[],"`Revoked`, with revocation reason and timestamp.",{"_3394":2361,"_29710":2345,"_20617":55758,"_5":14139,"_27008":55714,"_2880":55759},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3394":2362,"_29710":2345,"_20617":55761,"_5":14139,"_27008":55714,"_2880":55762},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3394":2363,"_29710":2345,"_20617":55764,"_5":14139,"_27008":55714,"_2880":55765},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3394":2364,"_29710":2345,"_20617":55767,"_5":14139,"_27008":55714,"_2880":55768},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3394":2365,"_29710":2345,"_20617":55770,"_5":14139,"_27008":55714,"_2880":55771},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3394":2366,"_29710":2345,"_20617":55773,"_5":14139,"_27008":55718,"_2880":55774},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3394":2367,"_29710":2345,"_20617":55776,"_5":14139,"_27008":55718,"_2880":55777},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3394":2368,"_29710":2345,"_20617":55779,"_5":14139,"_27008":55722,"_2880":55780},[],"The service accepts:",{"_3394":2369,"_29710":2345,"_20617":55782,"_5":14139,"_27008":55722,"_2880":51636},[],{"_3394":2370,"_29710":2345,"_20617":55784,"_5":14139,"_27008":55722,"_2880":55785},[],"VA service path",{"_3394":2371,"_29710":2345,"_20617":55787,"_5":14139,"_27008":55722,"_2880":55788},[],"Format",{"_3394":2372,"_29710":2345,"_20617":55790,"_5":14139,"_27008":55722,"_2880":55791},[],"`POST`",{"_3394":2373,"_29710":2345,"_20617":55793,"_5":14139,"_27008":55722,"_2880":55794},[],"`/ocsp`",{"_3394":2374,"_29710":2345,"_20617":55796,"_5":14139,"_27008":55722,"_2880":55797},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3394":2375,"_29710":2345,"_20617":55799,"_5":14139,"_27008":55722,"_2880":55220},[],{"_3394":2376,"_29710":2345,"_20617":55801,"_5":14139,"_27008":55722,"_2880":55802},[],"`/ocsp/{ocsp_request}`",{"_3394":2377,"_29710":2345,"_20617":55804,"_5":14139,"_27008":55722,"_2880":55805},[],"DER request encoded using padded URL Base64.",{"_3394":2378,"_29710":2345,"_20617":55807,"_5":14139,"_27008":55722,"_2880":55808},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3394":2379,"_29710":2345,"_20617":55810,"_5":14139,"_27008":55726,"_2880":55811},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3394":2380,"_29710":2345,"_20617":55813,"_5":14139,"_27008":55726,"_2880":55814},[],"Generate the request:",{"_3394":2381,"_29710":2345,"_20617":55816,"_5":14139,"_27008":55726,"_2880":55817},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3394":2382,"_29710":2345,"_20617":55819,"_5":14139,"_27008":55726,"_2880":55820},[],"Replace the example URL with the inspected endpoint:",{"_3394":2383,"_29710":2345,"_20617":55822,"_5":14139,"_27008":55726,"_2880":55823},[],"Verify the returned DER:",{"_3394":2384,"_29710":2345,"_20617":55825,"_5":14139,"_27008":55726,"_2880":55826},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3394":2385,"_29710":2345,"_20617":55828,"_5":14139,"_27008":55730,"_2880":55829},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3394":2386,"_29710":2345,"_20617":55831,"_5":14139,"_27008":55730,"_2880":55832},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3394":2387,"_29710":2345,"_20617":55834,"_5":14139,"_27008":55734,"_2880":55835},[],"RFC 6960: OCSP.",{"_3394":2388,"_29710":2345,"_20617":55837,"_5":14139,"_27008":55734,"_2880":55838},[],"OpenSSL: openssl-ocsp.",{"_3394":2389,"_29710":2345,"_20617":55840,"_5":14139,"_27008":55734,"_2880":55841},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3394":2390,"_29710":2345,"_20617":55843,"_5":14139,"_27008":55734,"_2880":55312},[],{"_3394":2391,"_29710":2391,"_5":14491,"_2880":53871,"_30063":55845,"_20617":55846,"_27008":2391},[48401,49869,53871],[],{"_3394":2392,"_29710":2391,"_20617":55848,"_5":14139,"_27008":2391,"_2880":55849},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3394":2393,"_29710":2391,"_5":30060,"_20617":55851,"_27008":55852,"_2880":53183},[],"/docs/pr-preview/pr-59/platform/pki/overview#start-here",{"_3394":2394,"_29710":2391,"_5":30060,"_20617":55854,"_27008":55855,"_2880":55856},[],"/docs/pr-preview/pr-59/platform/pki/overview#what-you-need","What you need",{"_3394":2395,"_29710":2391,"_5":30060,"_20617":55858,"_27008":55859,"_2880":53715},[],"/docs/pr-preview/pr-59/platform/pki/overview#core-capabilities",{"_3394":2396,"_29710":2391,"_5":30060,"_20617":55861,"_27008":55862,"_2880":53719},[],"/docs/pr-preview/pr-59/platform/pki/overview#build-your-trust-hierarchy",{"_3394":2397,"_29710":2391,"_5":30060,"_20617":55864,"_27008":55865,"_2880":53723},[],"/docs/pr-preview/pr-59/platform/pki/overview#protect-cryptographic-keys",{"_3394":2398,"_29710":2391,"_5":30060,"_20617":55867,"_27008":55868,"_2880":53727},[],"/docs/pr-preview/pr-59/platform/pki/overview#issue-and-control-certificates",{"_3394":2399,"_29710":2391,"_5":30060,"_20617":55870,"_27008":55871,"_2880":53735},[],"/docs/pr-preview/pr-59/platform/pki/overview#publish-validation-status",{"_3394":2400,"_29710":2391,"_5":30060,"_20617":55873,"_27008":55874,"_2880":55875},[],"/docs/pr-preview/pr-59/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3394":2401,"_29710":2391,"_5":30060,"_20617":55877,"_27008":55878,"_2880":54677},[],"/docs/pr-preview/pr-59/platform/pki/overview#continue",{"_3394":2402,"_29710":2391,"_20617":55880,"_5":14139,"_27008":2391,"_2880":55881},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3394":2403,"_29710":2391,"_20617":55883,"_5":14139,"_27008":55852,"_2880":55884},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3394":2404,"_29710":2391,"_20617":55886,"_5":14139,"_27008":55852,"_2880":55887},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3394":2405,"_29710":2391,"_20617":55889,"_5":14139,"_27008":55855,"_2880":55890},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3394":2406,"_29710":2391,"_20617":55892,"_5":14139,"_27008":55855,"_2880":55893},[],"An available cryptographic engine to keep the authority's key.",{"_3394":2407,"_29710":2391,"_20617":55895,"_5":14139,"_27008":55855,"_2880":55896},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3394":2408,"_29710":2391,"_20617":55898,"_5":14139,"_27008":55855,"_2880":55899},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3394":2409,"_29710":2391,"_20617":55901,"_5":14139,"_27008":55855,"_2880":55902},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3394":2410,"_29710":2391,"_20617":55904,"_5":14139,"_27008":55862,"_2880":55905},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3394":2411,"_29710":2391,"_20617":55907,"_5":14139,"_27008":55865,"_2880":55908},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3394":2412,"_29710":2391,"_20617":55910,"_5":14139,"_27008":55868,"_2880":55911},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3394":2413,"_29710":2391,"_20617":55913,"_5":14139,"_27008":55871,"_2880":55914},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3394":2414,"_29710":2391,"_20617":55916,"_5":14139,"_27008":55874,"_2880":55917},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3394":2415,"_29710":2391,"_20617":55919,"_5":14139,"_27008":55874,"_2880":55920},[],"its subject and extensions identify the expected client;",{"_3394":2416,"_29710":2391,"_20617":55922,"_5":14139,"_27008":55874,"_2880":55923},[],"its public key matches the client's private key;",{"_3394":2417,"_29710":2391,"_20617":55925,"_5":14139,"_27008":55874,"_2880":55926},[],"its chain reaches a root trusted by the consumer;",{"_3394":2418,"_29710":2391,"_20617":55928,"_5":14139,"_27008":55874,"_2880":55929},[],"its dates and usages allow the operation;",{"_3394":2419,"_29710":2391,"_20617":55931,"_5":14139,"_27008":55874,"_2880":55932},[],"the consumer applies revocation checks and authorization.",{"_3394":2420,"_29710":2391,"_20617":55934,"_5":14139,"_27008":55874,"_2880":55935},[],"The issuance path includes the first independent checks.",{"_3394":2421,"_29710":2391,"_20617":55937,"_5":14139,"_27008":55878,"_2880":55938},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3394":2422,"_29710":2391,"_20617":55940,"_5":14139,"_27008":55878,"_2880":55941},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3394":2423,"_29710":2391,"_20617":55943,"_5":14139,"_27008":55878,"_2880":55944},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3394":2424,"_29710":2424,"_5":14491,"_2880":55946,"_30063":55947,"_20617":55948,"_27008":2424},"Create your first CA",[48401,49869,53871,53308],[],{"_3394":2425,"_29710":2424,"_20617":55950,"_5":14139,"_27008":2424,"_2880":55951},[],"Create an evaluation root and check its certificate before issuing.",{"_3394":2426,"_29710":2424,"_5":30060,"_20617":55953,"_27008":55954,"_2880":48411},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3394":2427,"_29710":2424,"_5":30060,"_20617":55956,"_27008":55957,"_2880":55958},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3394":2428,"_29710":2424,"_5":30060,"_20617":55960,"_27008":55961,"_2880":55962},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3394":2429,"_29710":2424,"_5":30060,"_20617":55964,"_27008":55965,"_2880":55966},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3394":2430,"_29710":2424,"_5":30060,"_20617":55968,"_27008":55969,"_2880":55970},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3394":2431,"_29710":2424,"_5":30060,"_20617":55972,"_27008":55973,"_2880":55974},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3394":2432,"_29710":2424,"_5":30060,"_20617":55976,"_27008":55977,"_2880":55978},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3394":2433,"_29710":2424,"_5":30060,"_20617":55980,"_27008":55981,"_2880":53565},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3394":2434,"_29710":2424,"_5":30060,"_20617":55983,"_27008":55984,"_2880":48435},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3394":2435,"_29710":2424,"_20617":55986,"_5":14139,"_27008":2424,"_2880":55987},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3394":2436,"_29710":2424,"_20617":55989,"_5":14139,"_27008":55954,"_2880":55990},[],"Console access and permission to create keys and authorities.",{"_3394":2437,"_29710":2424,"_20617":55992,"_5":14139,"_27008":55954,"_2880":55993},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3394":2438,"_29710":2424,"_20617":55995,"_5":14139,"_27008":55954,"_2880":55996},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3394":2439,"_29710":2424,"_20617":55998,"_5":14139,"_27008":55954,"_2880":55999},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3394":2440,"_29710":2424,"_20617":56001,"_5":14139,"_27008":55957,"_2880":56002},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3394":2441,"_29710":2424,"_20617":56004,"_5":14139,"_27008":55957,"_2880":56005},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3394":2442,"_29710":2424,"_20617":56007,"_5":14139,"_27008":55961,"_2880":56008},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3394":2443,"_29710":2424,"_20617":56010,"_5":14139,"_27008":55961,"_2880":56011},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3394":2444,"_29710":2424,"_20617":56013,"_5":14139,"_27008":55965,"_2880":56014},[],"Select **Root CA** and complete:",{"_3394":2445,"_29710":2424,"_20617":56016,"_5":14139,"_27008":55965,"_2880":56017},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3394":2446,"_29710":2424,"_20617":56019,"_5":14139,"_27008":55965,"_2880":56020},[],"**Subject**: organization and country details for your evaluation.",{"_3394":2447,"_29710":2424,"_20617":56022,"_5":14139,"_27008":55965,"_2880":56023},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3394":2448,"_29710":2424,"_20617":56025,"_5":14139,"_27008":55965,"_2880":56026},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3394":2449,"_29710":2424,"_20617":56028,"_5":14139,"_27008":55965,"_2880":56029},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3394":2450,"_29710":2424,"_20617":56031,"_5":14139,"_27008":55969,"_2880":56032},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3394":2451,"_29710":2424,"_20617":56034,"_5":14139,"_27008":55973,"_2880":56035},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3394":2452,"_29710":2424,"_20617":56037,"_5":14139,"_27008":55973,"_2880":56038},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3394":2453,"_29710":2424,"_20617":56040,"_5":14139,"_27008":55977,"_2880":56041},[],"Run from the directory where you saved `ca.pem`:",{"_3394":2454,"_29710":2424,"_20617":56043,"_5":14139,"_27008":55977,"_2880":56044},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3394":2455,"_29710":2424,"_20617":56046,"_5":14139,"_27008":55977,"_2880":56047},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3394":2456,"_29710":2424,"_20617":56049,"_5":14139,"_27008":55981,"_2880":56050},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3394":2457,"_29710":2424,"_20617":56052,"_5":14139,"_27008":55981,"_2880":56053},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3394":2458,"_29710":2424,"_20617":56055,"_5":14139,"_27008":55981,"_2880":56056},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3394":2459,"_29710":2424,"_20617":56058,"_5":14139,"_27008":55981,"_2880":56059},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3394":2460,"_29710":2424,"_20617":56061,"_5":14139,"_27008":55984,"_2880":56062},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3394":2461,"_29710":2461,"_5":14491,"_2880":56064,"_30063":56065,"_20617":56066,"_27008":2461},"Issue and verify a certificate",[48401,49869,53871,53308],[],{"_3394":2462,"_29710":2461,"_20617":56068,"_5":14139,"_27008":2461,"_2880":56069},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3394":2463,"_29710":2461,"_5":30060,"_20617":56071,"_27008":56072,"_2880":48411},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3394":2464,"_29710":2461,"_5":30060,"_20617":56074,"_27008":56075,"_2880":56076},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3394":2465,"_29710":2461,"_5":30060,"_20617":56078,"_27008":56079,"_2880":56080},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3394":2466,"_29710":2461,"_5":30060,"_20617":56082,"_27008":56083,"_2880":56084},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3394":2467,"_29710":2461,"_5":30060,"_20617":56086,"_27008":56087,"_2880":56088},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3394":2468,"_29710":2461,"_5":30060,"_20617":56090,"_27008":56091,"_2880":56092},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3394":2469,"_29710":2461,"_5":30060,"_20617":56094,"_27008":56095,"_2880":56096},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3394":2470,"_29710":2461,"_5":30060,"_20617":56098,"_27008":56099,"_2880":56100},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3394":2471,"_29710":2461,"_5":30060,"_20617":56102,"_27008":56103,"_2880":56104},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3394":2472,"_29710":2461,"_5":30060,"_20617":56106,"_27008":56107,"_2880":56108},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3394":2473,"_29710":2461,"_5":30060,"_20617":56110,"_27008":56111,"_2880":53565},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3394":2474,"_29710":2461,"_5":30060,"_20617":56113,"_27008":56114,"_2880":48435},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/issue-certificate#next-step",{"_3394":2475,"_29710":2461,"_20617":56116,"_5":14139,"_27008":2461,"_2880":56117},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3394":2476,"_29710":2461,"_20617":56119,"_5":14139,"_27008":56072,"_2880":56120},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3394":2477,"_29710":2461,"_20617":56122,"_5":14139,"_27008":56072,"_2880":56123},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3394":2478,"_29710":2461,"_20617":56125,"_5":14139,"_27008":56072,"_2880":56126},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3394":2479,"_29710":2461,"_20617":56128,"_5":14139,"_27008":56072,"_2880":56129},[],"A client identifier: here we use `device-001`.",{"_3394":2480,"_29710":2461,"_20617":56131,"_5":14139,"_27008":56072,"_2880":56132},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3394":2481,"_29710":2461,"_20617":56134,"_5":14139,"_27008":56075,"_2880":56135},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3394":2482,"_29710":2461,"_20617":56137,"_5":14139,"_27008":56079,"_2880":56138},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3394":2483,"_29710":2461,"_20617":56140,"_5":14139,"_27008":56079,"_2880":56141},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3394":2484,"_29710":2461,"_20617":56143,"_5":14139,"_27008":56083,"_2880":56144},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3394":2485,"_29710":2461,"_20617":56146,"_5":14139,"_27008":56083,"_2880":56147},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3394":2486,"_29710":2461,"_20617":56149,"_5":14139,"_27008":56087,"_2880":56150},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3394":2487,"_29710":2461,"_20617":56152,"_5":14139,"_27008":56087,"_2880":56153},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3394":2488,"_29710":2461,"_20617":56155,"_5":14139,"_27008":56091,"_2880":56156},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3394":2489,"_29710":2461,"_20617":56158,"_5":14139,"_27008":56095,"_2880":56159},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3394":2490,"_29710":2461,"_20617":56161,"_5":14139,"_27008":56099,"_2880":56162},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3394":2491,"_29710":2461,"_20617":56164,"_5":14139,"_27008":56103,"_2880":56165},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3394":2492,"_29710":2461,"_20617":56167,"_5":14139,"_27008":56103,"_2880":56168},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3394":2493,"_29710":2461,"_20617":56170,"_5":14139,"_27008":56103,"_2880":56171},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3394":2494,"_29710":2461,"_20617":56173,"_5":14139,"_27008":56107,"_2880":56174},[],"In Bash, compare the two public-key digests:",{"_3394":2495,"_29710":2461,"_20617":56176,"_5":14139,"_27008":56107,"_2880":56177},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3394":2496,"_29710":2461,"_20617":56179,"_5":14139,"_27008":56107,"_2880":56180},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3394":2497,"_29710":2461,"_20617":56182,"_5":14139,"_27008":56111,"_2880":53649},[],{"_3394":2498,"_29710":2461,"_20617":56184,"_5":14139,"_27008":56111,"_2880":56185},[],"What to review",{"_3394":2499,"_29710":2461,"_20617":56187,"_5":14139,"_27008":56111,"_2880":56188},[],"The CA rejects issuance",{"_3394":2500,"_29710":2461,"_20617":56190,"_5":14139,"_27008":56111,"_2880":56191},[],"Permissions, CA state and key, algorithm and profile.",{"_3394":2501,"_29710":2461,"_20617":56193,"_5":14139,"_27008":56111,"_2880":56194},[],"Different subject or usages",{"_3394":2502,"_29710":2461,"_20617":56196,"_5":14139,"_27008":56111,"_2880":56197},[],"Applied profile and requested values.",{"_3394":2503,"_29710":2461,"_20617":56199,"_5":14139,"_27008":56111,"_2880":56200},[],"Issuer cannot be found",{"_3394":2504,"_29710":2461,"_20617":56202,"_5":14139,"_27008":56111,"_2880":56203},[],"Downloaded CA and required intermediate chain.",{"_3394":2505,"_29710":2461,"_20617":56205,"_5":14139,"_27008":56111,"_2880":56206},[],"Validity fails",{"_3394":2506,"_29710":2461,"_20617":56208,"_5":14139,"_27008":56111,"_2880":56209},[],"Certificate and CA dates, and the computer's clock.",{"_3394":2507,"_29710":2461,"_20617":56211,"_5":14139,"_27008":56111,"_2880":56212},[],"Public-key digests differ",{"_3394":2508,"_29710":2461,"_20617":56214,"_5":14139,"_27008":56111,"_2880":56215},[],"Certificate and key files from the same issuance.",{"_3394":2509,"_29710":2461,"_20617":56217,"_5":14139,"_27008":56111,"_2880":56218},[],"See PKI diagnostics to narrow an issuance failure.",{"_3394":2510,"_29710":2461,"_20617":56220,"_5":14139,"_27008":56114,"_2880":56221},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3394":2511,"_29710":2461,"_20617":56223,"_5":14139,"_27008":56114,"_2880":56224},[],"Manage certificates for inspection, status and revocation.",{"_3394":2512,"_29710":2461,"_20617":56226,"_5":14139,"_27008":56114,"_2880":56227},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3394":2513,"_29710":2461,"_20617":56229,"_5":14139,"_27008":56114,"_2880":56230},[],"Prepare EST for the device to request its next identities.",{"_3394":2514,"_29710":2461,"_20617":56232,"_5":14139,"_27008":56114,"_2880":56233},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3394":2515,"_29710":2515,"_5":14491,"_2880":56235,"_30063":56236,"_20617":56237,"_27008":2515},"PKI getting started",[48401,49869,53871,53308],[],{"_3394":2516,"_29710":2515,"_20617":56239,"_5":14139,"_27008":2515,"_2880":56240},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3394":2517,"_29710":2515,"_5":30060,"_20617":56242,"_27008":56243,"_2880":48411},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/overview#before-you-begin",{"_3394":2518,"_29710":2515,"_5":30060,"_20617":56245,"_27008":56246,"_2880":56247},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3394":2519,"_29710":2515,"_5":30060,"_20617":56249,"_27008":56250,"_2880":53500},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/overview#expected-result",{"_3394":2520,"_29710":2515,"_5":30060,"_20617":56252,"_27008":56253,"_2880":56254},[],"/docs/pr-preview/pr-59/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3394":2521,"_29710":2515,"_20617":56256,"_5":14139,"_27008":2515,"_2880":56257},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3394":2522,"_29710":2515,"_20617":56259,"_5":14139,"_27008":56243,"_2880":56260},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3394":2523,"_29710":2515,"_20617":56262,"_5":14139,"_27008":56243,"_2880":56263},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3394":2524,"_29710":2515,"_20617":56265,"_5":14139,"_27008":56243,"_2880":56266},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3394":2525,"_29710":2515,"_20617":56268,"_5":14139,"_27008":56243,"_2880":56269},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3394":2526,"_29710":2515,"_20617":56271,"_5":14139,"_27008":56243,"_2880":56272},[],"A working directory with restricted access for the downloaded key.",{"_3394":2527,"_29710":2515,"_20617":56274,"_5":14139,"_27008":56246,"_2880":56275},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3394":2528,"_29710":2515,"_20617":56277,"_5":14139,"_27008":56246,"_2880":56278},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3394":2529,"_29710":2515,"_20617":56280,"_5":14139,"_27008":56246,"_2880":56281},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3394":2530,"_29710":2515,"_20617":56283,"_5":14139,"_27008":56246,"_2880":56284},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3394":2531,"_29710":2515,"_20617":56286,"_5":14139,"_27008":56250,"_2880":56287},[],"File or resource",{"_3394":2532,"_29710":2515,"_20617":56289,"_5":14139,"_27008":56250,"_2880":53497},[],{"_3394":2533,"_29710":2515,"_20617":56291,"_5":14139,"_27008":56250,"_2880":56292},[],"Active root CA and `ca.pem`",{"_3394":2534,"_29710":2515,"_20617":56294,"_5":14139,"_27008":56250,"_2880":56295},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3394":2535,"_29710":2515,"_20617":56297,"_5":14139,"_27008":56250,"_2880":56298},[],"End-entity certificate and `device.crt`",{"_3394":2536,"_29710":2515,"_20617":56300,"_5":14139,"_27008":56250,"_2880":56301},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3394":2537,"_29710":2515,"_20617":56303,"_5":14139,"_27008":56250,"_2880":56304},[],"Private key `device.key`",{"_3394":2538,"_29710":2515,"_20617":56306,"_5":14139,"_27008":56250,"_2880":56307},[],"Its public key matches the one included in `device.crt`.",{"_3394":2539,"_29710":2515,"_20617":56309,"_5":14139,"_27008":56250,"_2880":56310},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3394":2540,"_29710":2515,"_20617":56312,"_5":14139,"_27008":56253,"_2880":56313},[],"To operate certificates, continue with Certificates and Validation.",{"_3394":2541,"_29710":2515,"_20617":56315,"_5":14139,"_27008":56253,"_2880":56316},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3394":2542,"_29710":2515,"_20617":56318,"_5":14139,"_27008":56253,"_2880":56319},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3394":2543,"_29710":2543,"_5":14491,"_2880":56321,"_30063":56322,"_20617":56323,"_27008":2543},"PKI troubleshooting",[48401,49869,53871,52446],[],{"_3394":2544,"_29710":2543,"_20617":56325,"_5":14139,"_27008":2543,"_2880":56326},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3394":2545,"_29710":2543,"_5":30060,"_20617":56328,"_27008":56329,"_2880":56330},[],"/docs/pr-preview/pr-59/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3394":2546,"_29710":2543,"_5":30060,"_20617":56332,"_27008":56333,"_2880":56334},[],"/docs/pr-preview/pr-59/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3394":2547,"_29710":2543,"_5":30060,"_20617":56336,"_27008":56337,"_2880":56338},[],"/docs/pr-preview/pr-59/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3394":2548,"_29710":2543,"_20617":56340,"_5":14139,"_27008":2543,"_2880":56341},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3394":2549,"_29710":2543,"_20617":56343,"_5":14139,"_27008":2543,"_2880":56344},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3394":2550,"_29710":2543,"_20617":56346,"_5":14139,"_27008":56329,"_2880":53497},[],{"_3394":2551,"_29710":2543,"_20617":56348,"_5":14139,"_27008":56329,"_2880":56349},[],"What to inspect",{"_3394":2552,"_29710":2543,"_20617":56351,"_5":14139,"_27008":56329,"_2880":48435},[],{"_3394":2553,"_29710":2543,"_20617":56353,"_5":14139,"_27008":56329,"_2880":52713},[],{"_3394":2554,"_29710":2543,"_20617":56355,"_5":14139,"_27008":56329,"_2880":56356},[],"Exists, is active and has usable dates.",{"_3394":2555,"_29710":2543,"_20617":56358,"_5":14139,"_27008":56329,"_2880":56359},[],"Authorities.",{"_3394":2556,"_29710":2543,"_20617":56361,"_5":14139,"_27008":56329,"_2880":56362},[],"Key",{"_3394":2557,"_29710":2543,"_20617":56364,"_5":14139,"_27008":56329,"_2880":56365},[],"The record has a usable private key and the engine can sign.",{"_3394":2558,"_29710":2543,"_20617":56367,"_5":14139,"_27008":56329,"_2880":56368},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3394":2559,"_29710":2543,"_20617":56370,"_5":14139,"_27008":56329,"_2880":56371},[],"CSR",{"_3394":2560,"_29710":2543,"_20617":56373,"_5":14139,"_27008":56329,"_2880":56374},[],"Correct PEM and verifiable signature.",{"_3394":2561,"_29710":2543,"_20617":56376,"_5":14139,"_27008":56329,"_2880":56377},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3394":2562,"_29710":2543,"_20617":56379,"_5":14139,"_27008":56329,"_2880":56380},[],"Profile",{"_3394":2563,"_29710":2543,"_20617":56382,"_5":14139,"_27008":56329,"_2880":56383},[],"Selected source, existing ID, allowed algorithm and size.",{"_3394":2564,"_29710":2543,"_20617":56385,"_5":14139,"_27008":56329,"_2880":56386},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3394":2565,"_29710":2543,"_20617":56388,"_5":14139,"_27008":56329,"_2880":53649},[],{"_3394":2566,"_29710":2543,"_20617":56390,"_5":14139,"_27008":56329,"_2880":56391},[],"Appropriate subject, SAN, usages and dates.",{"_3394":2567,"_29710":2543,"_20617":56393,"_5":14139,"_27008":56329,"_2880":56394},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3394":2568,"_29710":2543,"_20617":56396,"_5":14139,"_27008":56329,"_2880":56397},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3394":2569,"_29710":2543,"_20617":56399,"_5":14139,"_27008":56329,"_2880":56400},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3394":2570,"_29710":2543,"_20617":56402,"_5":14139,"_27008":56333,"_2880":56403},[],"Check each boundary independently:",{"_3394":2571,"_29710":2543,"_20617":56405,"_5":14139,"_27008":56333,"_2880":56406},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3394":2572,"_29710":2543,"_20617":56408,"_5":14139,"_27008":56333,"_2880":56409},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3394":2573,"_29710":2543,"_20617":56411,"_5":14139,"_27008":56333,"_2880":56412},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3394":2574,"_29710":2543,"_20617":56414,"_5":14139,"_27008":56333,"_2880":56415},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3394":2575,"_29710":2543,"_20617":56417,"_5":14139,"_27008":56333,"_2880":56418},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3394":2576,"_29710":2543,"_20617":56420,"_5":14139,"_27008":56333,"_2880":56421},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3394":2577,"_29710":2543,"_20617":56423,"_5":14139,"_27008":56337,"_2880":56424},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3394":2578,"_29710":2543,"_20617":56426,"_5":14139,"_27008":56337,"_2880":56427},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3394":2579,"_29710":2579,"_5":14491,"_2880":56429,"_30063":56430,"_20617":56431,"_27008":2579},"Security",[48401],[],{"_3394":2580,"_29710":2579,"_20617":56433,"_5":14139,"_27008":2579,"_2880":56434},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3394":2581,"_29710":2579,"_5":30060,"_20617":56436,"_27008":56437,"_2880":56438},[],"/docs/pr-preview/pr-59/security#report-a-vulnerability","Report a vulnerability",{"_3394":2582,"_29710":2579,"_5":30060,"_20617":56440,"_27008":56441,"_2880":56442},[],"/docs/pr-preview/pr-59/security#what-to-include-in-a-report","What to include in a report",{"_3394":2583,"_29710":2579,"_5":30060,"_20617":56444,"_27008":56445,"_2880":56446},[],"/docs/pr-preview/pr-59/security#supported-versions","Supported versions",{"_3394":2584,"_29710":2579,"_5":30060,"_20617":56448,"_27008":56449,"_2880":56450},[],"/docs/pr-preview/pr-59/security#responsible-disclosure","Responsible disclosure",{"_3394":2585,"_29710":2579,"_20617":56452,"_5":14139,"_27008":2579,"_2880":56453},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3394":2586,"_29710":2579,"_20617":56455,"_5":14139,"_27008":56437,"_2880":56456},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3394":2587,"_29710":2579,"_20617":56458,"_5":14139,"_27008":56437,"_2880":56459},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3394":2588,"_29710":2579,"_20617":56461,"_5":14139,"_27008":56437,"_2880":14758},[],{"_3394":2589,"_29710":2579,"_20617":56463,"_5":14139,"_27008":56437,"_2880":14704},[],{"_3394":2590,"_29710":2579,"_20617":56465,"_5":14139,"_27008":56437,"_2880":14751},[],{"_3394":2591,"_29710":2579,"_20617":56467,"_5":14139,"_27008":56437,"_2880":56468},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3394":2592,"_29710":2579,"_20617":56470,"_5":14139,"_27008":56437,"_2880":56471},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3394":2593,"_29710":2579,"_20617":56473,"_5":14139,"_27008":56441,"_2880":56474},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3394":2594,"_29710":2579,"_20617":56476,"_5":14139,"_27008":56441,"_2880":56477},[],"Do not include in the report:",{"_3394":2595,"_29710":2579,"_20617":56479,"_5":14139,"_27008":56441,"_2880":56480},[],"Credentials, tokens, or private keys",{"_3394":2596,"_29710":2579,"_20617":56482,"_5":14139,"_27008":56441,"_2880":56483},[],"Customer data or customer-identifiable information",{"_3394":2597,"_29710":2579,"_20617":56485,"_5":14139,"_27008":56441,"_2880":56486},[],"Confidential architecture or internal infrastructure details",{"_3394":2598,"_29710":2579,"_20617":56488,"_5":14139,"_27008":56445,"_2880":56489},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3394":2599,"_29710":2579,"_20617":56491,"_5":14139,"_27008":56445,"_2880":56492},[],"For upgrade guidance, see Upgrades.",{"_3394":2600,"_29710":2579,"_20617":56494,"_5":14139,"_27008":56449,"_2880":56495},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3394":2601,"_29710":2579,"_20617":56497,"_5":14139,"_27008":56449,"_2880":56498},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3394":2602,"_29710":2579,"_20617":56500,"_5":14139,"_27008":56449,"_2880":56501},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3394":2603,"_29710":2579,"_20617":56503,"_5":14139,"_27008":56449,"_2880":56504},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3394":2604,"_29710":2579,"_20617":56506,"_5":14139,"_27008":56449,"_2880":56507},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3394":2605,"_29710":2605,"_5":14491,"_2880":56509,"_30063":56510,"_20617":56512,"_27008":2605},"3.8.0 to 4.0.0",[48401,56511],"Upgrades",[],{"_3394":2606,"_29710":2605,"_20617":56514,"_5":14139,"_27008":2605,"_2880":56515},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3394":2607,"_29710":2605,"_5":30060,"_20617":56517,"_27008":56518,"_2880":56519},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3394":2608,"_29710":2605,"_5":30060,"_20617":56521,"_27008":56522,"_2880":56523},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3394":2609,"_29710":2605,"_5":30060,"_20617":56525,"_27008":56526,"_2880":56527},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3394":2610,"_29710":2605,"_5":30060,"_20617":56529,"_27008":56530,"_2880":56531},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3394":2611,"_29710":2605,"_5":30060,"_20617":56533,"_27008":56534,"_2880":56535},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3394":2612,"_29710":2605,"_5":30060,"_20617":56537,"_27008":56538,"_2880":56539},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3394":2613,"_29710":2605,"_5":30060,"_20617":56541,"_27008":56542,"_2880":56543},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3394":2614,"_29710":2605,"_5":30060,"_20617":56545,"_27008":56546,"_2880":56547},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3394":2615,"_29710":2605,"_5":30060,"_20617":56549,"_27008":56550,"_2880":56551},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3394":2616,"_29710":2605,"_5":30060,"_20617":56553,"_27008":56554,"_2880":56555},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3394":2617,"_29710":2605,"_5":30060,"_20617":56557,"_27008":56558,"_2880":56559},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3394":2618,"_29710":2605,"_5":30060,"_20617":56561,"_27008":56562,"_2880":56563},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3394":2619,"_29710":2605,"_5":30060,"_20617":56565,"_27008":56566,"_2880":56567},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3394":2620,"_29710":2605,"_5":30060,"_20617":56569,"_27008":56570,"_2880":56571},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3394":2621,"_29710":2605,"_5":30060,"_20617":56573,"_27008":56574,"_2880":56575},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3394":2622,"_29710":2605,"_5":30060,"_20617":56577,"_27008":56578,"_2880":56579},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3394":2623,"_29710":2605,"_5":30060,"_20617":56581,"_27008":56582,"_2880":56583},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3394":2624,"_29710":2605,"_5":30060,"_20617":56585,"_27008":56586,"_2880":56587},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3394":2625,"_29710":2605,"_5":30060,"_20617":56589,"_27008":56590,"_2880":56591},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3394":2626,"_29710":2605,"_5":30060,"_20617":56593,"_27008":56594,"_2880":56595},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3394":2627,"_29710":2605,"_5":30060,"_20617":56597,"_27008":56598,"_2880":56599},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3394":2628,"_29710":2605,"_5":30060,"_20617":56601,"_27008":56602,"_2880":56603},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3394":2629,"_29710":2605,"_5":30060,"_20617":56605,"_27008":56606,"_2880":56607},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3394":2630,"_29710":2605,"_5":30060,"_20617":56609,"_27008":56610,"_2880":56611},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3394":2631,"_29710":2605,"_5":30060,"_20617":56613,"_27008":56614,"_2880":56615},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3394":2632,"_29710":2605,"_5":30060,"_20617":56617,"_27008":56618,"_2880":56619},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3394":2633,"_29710":2605,"_5":30060,"_20617":56621,"_27008":56622,"_2880":56623},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3394":2634,"_29710":2605,"_5":30060,"_20617":56625,"_27008":56626,"_2880":56627},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3394":2635,"_29710":2605,"_5":30060,"_20617":56629,"_27008":56630,"_2880":56631},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3394":2636,"_29710":2605,"_5":30060,"_20617":56633,"_27008":56634,"_2880":56635},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3394":2637,"_29710":2605,"_5":30060,"_20617":56637,"_27008":56638,"_2880":56639},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3394":2638,"_29710":2605,"_5":30060,"_20617":56641,"_27008":56642,"_2880":56643},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3394":2639,"_29710":2605,"_5":30060,"_20617":56645,"_27008":56646,"_2880":56647},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3394":2640,"_29710":2605,"_5":30060,"_20617":56649,"_27008":56650,"_2880":56651},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3394":2641,"_29710":2605,"_5":30060,"_20617":56653,"_27008":56654,"_2880":56655},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3394":2642,"_29710":2605,"_5":30060,"_20617":56657,"_27008":56658,"_2880":56659},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3394":2643,"_29710":2605,"_5":30060,"_20617":56661,"_27008":56662,"_2880":52446},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3394":2644,"_29710":2605,"_5":30060,"_20617":56664,"_27008":56665,"_2880":56666},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3394":2645,"_29710":2605,"_5":30060,"_20617":56668,"_27008":56669,"_2880":56670},[],"/docs/pr-preview/pr-59/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3394":2646,"_29710":2605,"_20617":56672,"_5":14139,"_27008":2605,"_2880":56673},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3394":2647,"_29710":2605,"_20617":56675,"_5":14139,"_27008":2605,"_2880":56676},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3394":2648,"_29710":2605,"_20617":56678,"_5":14139,"_27008":2605,"_2880":56679},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3394":2649,"_29710":2605,"_20617":56681,"_5":14139,"_27008":2605,"_2880":56682},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3394":2650,"_29710":2605,"_20617":56684,"_5":14139,"_27008":2605,"_2880":56685},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3394":2651,"_29710":2605,"_20617":56687,"_5":14139,"_27008":2605,"_2880":56688},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3394":2652,"_29710":2605,"_20617":56690,"_5":14139,"_27008":2605,"_2880":56691},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3394":2653,"_29710":2605,"_20617":56693,"_5":14139,"_27008":56522,"_2880":56694},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3394":2654,"_29710":2605,"_20617":56696,"_5":14139,"_27008":56522,"_2880":56697},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3394":2655,"_29710":2605,"_20617":56699,"_5":14139,"_27008":56526,"_2880":56700},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3394":2656,"_29710":2605,"_20617":56702,"_5":14139,"_27008":56526,"_2880":56703},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3394":2657,"_29710":2605,"_20617":56705,"_5":14139,"_27008":56530,"_2880":56706},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3394":2658,"_29710":2605,"_20617":56708,"_5":14139,"_27008":56534,"_2880":56709},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3394":2659,"_29710":2605,"_20617":56711,"_5":14139,"_27008":56534,"_2880":56712},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3394":2660,"_29710":2605,"_20617":56714,"_5":14139,"_27008":56534,"_2880":56715},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3394":2661,"_29710":2605,"_20617":56717,"_5":14139,"_27008":56534,"_2880":56718},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3394":2662,"_29710":2605,"_20617":56720,"_5":14139,"_27008":56534,"_2880":56721},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3394":2663,"_29710":2605,"_20617":56723,"_5":14139,"_27008":56538,"_2880":56724},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3394":2664,"_29710":2605,"_20617":56726,"_5":14139,"_27008":56538,"_2880":56727},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3394":2665,"_29710":2605,"_20617":56729,"_5":14139,"_27008":56538,"_2880":56730},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3394":2666,"_29710":2605,"_20617":56732,"_5":14139,"_27008":56538,"_2880":56733},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3394":2667,"_29710":2605,"_20617":56735,"_5":14139,"_27008":56538,"_2880":56736},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3394":2668,"_29710":2605,"_20617":56738,"_5":14139,"_27008":56538,"_2880":56739},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3394":2669,"_29710":2605,"_20617":56741,"_5":14139,"_27008":56542,"_2880":56742},[],"Change",{"_3394":2670,"_29710":2605,"_20617":56744,"_5":14139,"_27008":56542,"_2880":56745},[],"Who is affected",{"_3394":2671,"_29710":2605,"_20617":56747,"_5":14139,"_27008":56542,"_2880":56748},[],"Severity",{"_3394":2672,"_29710":2605,"_20617":56750,"_5":14139,"_27008":56542,"_2880":55249},[],{"_3394":2673,"_29710":2605,"_20617":56752,"_5":14139,"_27008":56542,"_2880":56551},[],{"_3394":2674,"_29710":2605,"_20617":56754,"_5":14139,"_27008":56542,"_2880":56755},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3394":2675,"_29710":2605,"_20617":56757,"_5":14139,"_27008":56542,"_2880":56758},[],"High: KMS and VA start on empty volumes",{"_3394":2676,"_29710":2605,"_20617":56760,"_5":14139,"_27008":56542,"_2880":56761},[],"Copy the data into the new volumes",{"_3394":2677,"_29710":2605,"_20617":56763,"_5":14139,"_27008":56542,"_2880":56555},[],{"_3394":2678,"_29710":2605,"_20617":56765,"_5":14139,"_27008":56542,"_2880":56766},[],"Every Helm release",{"_3394":2679,"_29710":2605,"_20617":56768,"_5":14139,"_27008":56542,"_2880":56769},[],"High: `helm upgrade` fails",{"_3394":2680,"_29710":2605,"_20617":56771,"_5":14139,"_27008":56542,"_2880":56772},[],"Remove or rename legacy keys",{"_3394":2681,"_29710":2605,"_20617":56774,"_5":14139,"_27008":56542,"_2880":56559},[],{"_3394":2682,"_29710":2605,"_20617":56776,"_5":14139,"_27008":56542,"_2880":56777},[],"Every deployment",{"_3394":2683,"_29710":2605,"_20617":56779,"_5":14139,"_27008":56542,"_2880":56780},[],"High: without a bootstrap principal there is no administrator",{"_3394":2684,"_29710":2605,"_20617":56782,"_5":14139,"_27008":56542,"_2880":56783},[],"Configure `services.authz`",{"_3394":2685,"_29710":2605,"_20617":56785,"_5":14139,"_27008":56542,"_2880":56563},[],{"_3394":2686,"_29710":2605,"_20617":56787,"_5":14139,"_27008":56542,"_2880":56766},[],{"_3394":2687,"_29710":2605,"_20617":56789,"_5":14139,"_27008":56542,"_2880":56790},[],"High: `helm upgrade` fails on the old keys",{"_3394":2688,"_29710":2605,"_20617":56792,"_5":14139,"_27008":56542,"_2880":56793},[],"Move JWKS and roles into `services.authz`",{"_3394":2689,"_29710":2605,"_20617":56795,"_5":14139,"_27008":56542,"_2880":56583},[],{"_3394":2690,"_29710":2605,"_20617":56797,"_5":14139,"_27008":56542,"_2880":56798},[],"3.8.0 deployments with per-service databases",{"_3394":2691,"_29710":2605,"_20617":56800,"_5":14139,"_27008":56542,"_2880":56801},[],"High: services find no data, or a migration aborts",{"_3394":2692,"_29710":2605,"_20617":56803,"_5":14139,"_27008":56542,"_2880":56804},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3394":2693,"_29710":2605,"_20617":56806,"_5":14139,"_27008":56542,"_2880":56587},[],{"_3394":2694,"_29710":2605,"_20617":56808,"_5":14139,"_27008":56542,"_2880":56809},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3394":2695,"_29710":2605,"_20617":56811,"_5":14139,"_27008":56542,"_2880":56812},[],"High: the backend no longer starts with them",{"_3394":2696,"_29710":2605,"_20617":56814,"_5":14139,"_27008":56542,"_2880":56815},[],"Move to PostgreSQL before upgrading",{"_3394":2697,"_29710":2605,"_20617":56817,"_5":14139,"_27008":56542,"_2880":56818},[],"Webhooks with file references",{"_3394":2698,"_29710":2605,"_20617":56820,"_5":14139,"_27008":56542,"_2880":56821},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3394":2699,"_29710":2605,"_20617":56823,"_5":14139,"_27008":56542,"_2880":56824},[],"High: enrollments calling the webhook fail",{"_3394":2700,"_29710":2605,"_20617":56826,"_5":14139,"_27008":56542,"_2880":56827},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3394":2701,"_29710":2605,"_20617":56829,"_5":14139,"_27008":56542,"_2880":56567},[],{"_3394":2702,"_29710":2605,"_20617":56831,"_5":14139,"_27008":56542,"_2880":56832},[],"Releases with per-service identity overrides or mounted key material",{"_3394":2703,"_29710":2605,"_20617":56834,"_5":14139,"_27008":56542,"_2880":56835},[],"Medium: services cannot read their files",{"_3394":2704,"_29710":2605,"_20617":56837,"_5":14139,"_27008":56542,"_2880":56838},[],"Remove the overrides and fix volume ownership",{"_3394":2705,"_29710":2605,"_20617":56840,"_5":14139,"_27008":56542,"_2880":56571},[],{"_3394":2706,"_29710":2605,"_20617":56842,"_5":14139,"_27008":56542,"_2880":56843},[],"Releases that set `amqp.tls`",{"_3394":2707,"_29710":2605,"_20617":56845,"_5":14139,"_27008":56542,"_2880":56846},[],"Medium: clients connect to the wrong port",{"_3394":2708,"_29710":2605,"_20617":56848,"_5":14139,"_27008":56542,"_2880":56849},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3394":2709,"_29710":2605,"_20617":56851,"_5":14139,"_27008":56542,"_2880":56591},[],{"_3394":2710,"_29710":2605,"_20617":56853,"_5":14139,"_27008":56542,"_2880":56854},[],"Installations whose CA keys predate the KMS",{"_3394":2711,"_29710":2605,"_20617":56856,"_5":14139,"_27008":56542,"_2880":56857},[],"Medium: CA keys stay unmanaged",{"_3394":2712,"_29710":2605,"_20617":56859,"_5":14139,"_27008":56542,"_2880":56860},[],"Run the CA-to-KMS migration",{"_3394":2713,"_29710":2605,"_20617":56862,"_5":14139,"_27008":56542,"_2880":56863},[],"Receiver certificate verification",{"_3394":2714,"_29710":2605,"_20617":56865,"_5":14139,"_27008":56542,"_2880":56866},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3394":2715,"_29710":2605,"_20617":56868,"_5":14139,"_27008":56542,"_2880":56869},[],"Medium: credentials go to an unverified receiver",{"_3394":2716,"_29710":2605,"_20617":56871,"_5":14139,"_27008":56542,"_2880":56872},[],"Set `insecure_skip_verify` to `false`",{"_3394":2717,"_29710":2605,"_20617":56874,"_5":14139,"_27008":56542,"_2880":56607},[],{"_3394":2718,"_29710":2605,"_20617":56876,"_5":14139,"_27008":56542,"_2880":56877},[],"Scripts and consoles that edit DMSs through the API",{"_3394":2719,"_29710":2605,"_20617":56879,"_5":14139,"_27008":56542,"_2880":56880},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3394":2720,"_29710":2605,"_20617":56882,"_5":14139,"_27008":56542,"_2880":56883},[],"Read the DMS before editing and use the new field",{"_3394":2721,"_29710":2605,"_20617":56885,"_5":14139,"_27008":56542,"_2880":56627},[],{"_3394":2722,"_29710":2605,"_20617":56887,"_5":14139,"_27008":56542,"_2880":56888},[],"Clients that create or update VA roles through the API",{"_3394":2723,"_29710":2605,"_20617":56890,"_5":14139,"_27008":56542,"_2880":56891},[],"Medium: requests with the old field return an error",{"_3394":2724,"_29710":2605,"_20617":56893,"_5":14139,"_27008":56542,"_2880":56894},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3394":2725,"_29710":2605,"_20617":56896,"_5":14139,"_27008":56542,"_2880":56623},[],{"_3394":2726,"_29710":2605,"_20617":56898,"_5":14139,"_27008":56542,"_2880":56899},[],"Consumers that read the device `events` field",{"_3394":2727,"_29710":2605,"_20617":56901,"_5":14139,"_27008":56542,"_2880":56902},[],"Medium: the field disappears",{"_3394":2728,"_29710":2605,"_20617":56904,"_5":14139,"_27008":56542,"_2880":56905},[],"Use the new event endpoints",{"_3394":2729,"_29710":2605,"_20617":56907,"_5":14139,"_27008":56542,"_2880":56631},[],{"_3394":2730,"_29710":2605,"_20617":56909,"_5":14139,"_27008":56542,"_2880":56910},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3394":2731,"_29710":2605,"_20617":56912,"_5":14139,"_27008":56542,"_2880":56913},[],"Medium: the VA migration aborts",{"_3394":2732,"_29710":2605,"_20617":56915,"_5":14139,"_27008":56542,"_2880":56916},[],"Fix the affected roles before upgrading",{"_3394":2733,"_29710":2605,"_20617":56918,"_5":14139,"_27008":56542,"_2880":56575},[],{"_3394":2734,"_29710":2605,"_20617":56920,"_5":14139,"_27008":56542,"_2880":56921},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3394":2735,"_29710":2605,"_20617":56923,"_5":14139,"_27008":56542,"_2880":56924},[],"Low to medium: validation errors or changed defaults",{"_3394":2736,"_29710":2605,"_20617":56926,"_5":14139,"_27008":56542,"_2880":56927},[],"Update the values file",{"_3394":2737,"_29710":2605,"_20617":56929,"_5":14139,"_27008":56542,"_2880":56615},[],{"_3394":2738,"_29710":2605,"_20617":56931,"_5":14139,"_27008":56542,"_2880":56932},[],"Clients that send the DMS ID in the update body",{"_3394":2739,"_29710":2605,"_20617":56934,"_5":14139,"_27008":56542,"_2880":56935},[],"Low: the ID in the URL wins",{"_3394":2740,"_29710":2605,"_20617":56937,"_5":14139,"_27008":56542,"_2880":56938},[],"Send the ID in the URL",{"_3394":2741,"_29710":2605,"_20617":56940,"_5":14139,"_27008":56542,"_2880":56619},[],{"_3394":2742,"_29710":2605,"_20617":56942,"_5":14139,"_27008":56542,"_2880":56943},[],"Consumers that match on certificate `type`",{"_3394":2743,"_29710":2605,"_20617":56945,"_5":14139,"_27008":56542,"_2880":56946},[],"Low: two values are renamed",{"_3394":2744,"_29710":2605,"_20617":56948,"_5":14139,"_27008":56542,"_2880":56949},[],"Adapt consumers",{"_3394":2745,"_29710":2605,"_20617":56951,"_5":14139,"_27008":56542,"_2880":56611},[],{"_3394":2746,"_29710":2605,"_20617":56953,"_5":14139,"_27008":56542,"_2880":56954},[],"Any DMS",{"_3394":2747,"_29710":2605,"_20617":56956,"_5":14139,"_27008":56542,"_2880":56957},[],"Low: informational",{"_3394":2748,"_29710":2605,"_20617":56959,"_5":14139,"_27008":56542,"_2880":56960},[],"Read both blocks before editing",{"_3394":2749,"_29710":2605,"_20617":56962,"_5":14139,"_27008":56550,"_2880":56963},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3394":2750,"_29710":2605,"_20617":56965,"_5":14139,"_27008":56550,"_2880":56966},[],"Step 4 of the migration guide copies the data.",{"_3394":2751,"_29710":2605,"_20617":56968,"_5":14139,"_27008":56554,"_2880":56969},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3394":2752,"_29710":2605,"_20617":56971,"_5":14139,"_27008":56558,"_2880":56972},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3394":2753,"_29710":2605,"_20617":56974,"_5":14139,"_27008":56562,"_2880":56975},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3394":2754,"_29710":2605,"_20617":56977,"_5":14139,"_27008":56566,"_2880":56978},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3394":2755,"_29710":2605,"_20617":56980,"_5":14139,"_27008":56566,"_2880":56981},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3394":2756,"_29710":2605,"_20617":56983,"_5":14139,"_27008":56570,"_2880":56984},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3394":2757,"_29710":2605,"_20617":56986,"_5":14139,"_27008":56574,"_2880":56987},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3394":2758,"_29710":2605,"_20617":56989,"_5":14139,"_27008":56574,"_2880":56990},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3394":2759,"_29710":2605,"_20617":56992,"_5":14139,"_27008":56574,"_2880":56993},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3394":2760,"_29710":2605,"_20617":56995,"_5":14139,"_27008":56574,"_2880":56996},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3394":2761,"_29710":2605,"_20617":56998,"_5":14139,"_27008":56574,"_2880":56999},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3394":2762,"_29710":2605,"_20617":57001,"_5":14139,"_27008":56574,"_2880":57002},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3394":2763,"_29710":2605,"_20617":57004,"_5":14139,"_27008":56582,"_2880":57005},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3394":2764,"_29710":2605,"_20617":57007,"_5":14139,"_27008":56582,"_2880":57008},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3394":2765,"_29710":2605,"_20617":57010,"_5":14139,"_27008":56582,"_2880":57011},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3394":2766,"_29710":2605,"_20617":57013,"_5":14139,"_27008":56582,"_2880":57014},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3394":2767,"_29710":2605,"_20617":57016,"_5":14139,"_27008":56582,"_2880":57017},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3394":2768,"_29710":2605,"_20617":57019,"_5":14139,"_27008":56586,"_2880":57020},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3394":2769,"_29710":2605,"_20617":57022,"_5":14139,"_27008":56590,"_2880":57023},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3394":2770,"_29710":2605,"_20617":57025,"_5":14139,"_27008":56590,"_2880":57026},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3394":2771,"_29710":2605,"_20617":57028,"_5":14139,"_27008":56590,"_2880":57029},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3394":2772,"_29710":2605,"_20617":57031,"_5":14139,"_27008":56590,"_2880":57032},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3394":2773,"_29710":2605,"_20617":57034,"_5":14139,"_27008":56590,"_2880":57035},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3394":2774,"_29710":2605,"_20617":57037,"_5":14139,"_27008":56590,"_2880":57038},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3394":2775,"_29710":2605,"_20617":57040,"_5":14139,"_27008":56590,"_2880":57041},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3394":2776,"_29710":2605,"_20617":57043,"_5":14139,"_27008":56590,"_2880":57044},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3394":2777,"_29710":2605,"_20617":57046,"_5":14139,"_27008":56594,"_2880":57047},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3394":2778,"_29710":2605,"_20617":57049,"_5":14139,"_27008":56602,"_2880":57050},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3394":2779,"_29710":2605,"_20617":57052,"_5":14139,"_27008":56602,"_2880":57053},[],"Field in 3.8.0",{"_3394":2780,"_29710":2605,"_20617":57055,"_5":14139,"_27008":56602,"_2880":57056},[],"Field in 4.0.0",{"_3394":2781,"_29710":2605,"_20617":57058,"_5":14139,"_27008":56602,"_2880":57059},[],"`validate_server_cert`",{"_3394":2782,"_29710":2605,"_20617":57061,"_5":14139,"_27008":56602,"_2880":57062},[],"`insecure_skip_verify` (value negated)",{"_3394":2783,"_29710":2605,"_20617":57064,"_5":14139,"_27008":56602,"_2880":57065},[],"`oidc`",{"_3394":2784,"_29710":2605,"_20617":57067,"_5":14139,"_27008":56602,"_2880":57068},[],"`jwt_options`",{"_3394":2785,"_29710":2605,"_20617":57070,"_5":14139,"_27008":56602,"_2880":57071},[],"`apikey`",{"_3394":2786,"_29710":2605,"_20617":57073,"_5":14139,"_27008":56602,"_2880":57074},[],"`apikey_options`",{"_3394":2787,"_29710":2605,"_20617":57076,"_5":14139,"_27008":56602,"_2880":57077},[],"`mtls`",{"_3394":2788,"_29710":2605,"_20617":57079,"_5":14139,"_27008":56602,"_2880":57080},[],"`mtls_options`",{"_3394":2789,"_29710":2605,"_20617":57082,"_5":14139,"_27008":56602,"_2880":57083},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3394":2790,"_29710":2605,"_20617":57085,"_5":14139,"_27008":56602,"_2880":57086},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3394":2791,"_29710":2605,"_20617":57088,"_5":14139,"_27008":56602,"_2880":57089},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3394":2792,"_29710":2605,"_20617":57091,"_5":14139,"_27008":56606,"_2880":57092},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3394":2793,"_29710":2605,"_20617":57094,"_5":14139,"_27008":56606,"_2880":57095},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3394":2794,"_29710":2605,"_20617":57097,"_5":14139,"_27008":56606,"_2880":57098},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3394":2795,"_29710":2605,"_20617":57100,"_5":14139,"_27008":56610,"_2880":57101},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3394":2796,"_29710":2605,"_20617":57103,"_5":14139,"_27008":56614,"_2880":57104},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3394":2797,"_29710":2605,"_20617":57106,"_5":14139,"_27008":56618,"_2880":57107},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3394":2798,"_29710":2605,"_20617":57109,"_5":14139,"_27008":56622,"_2880":57110},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3394":2799,"_29710":2605,"_20617":57112,"_5":14139,"_27008":56622,"_2880":57113},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3394":2800,"_29710":2605,"_20617":57115,"_5":14139,"_27008":56622,"_2880":57116},[],"`POST /v1/devices/:id/events` creates an event.",{"_3394":2801,"_29710":2605,"_20617":57118,"_5":14139,"_27008":56622,"_2880":57119},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3394":2802,"_29710":2605,"_20617":57121,"_5":14139,"_27008":56626,"_2880":57122},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3394":2803,"_29710":2605,"_20617":57124,"_5":14139,"_27008":56630,"_2880":57125},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3394":2804,"_29710":2605,"_20617":57127,"_5":14139,"_27008":56634,"_2880":57128},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3394":2805,"_29710":2605,"_20617":57130,"_5":14139,"_27008":56638,"_2880":57131},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3394":2806,"_29710":2605,"_20617":57133,"_5":14139,"_27008":56638,"_2880":57134},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3394":2807,"_29710":2605,"_20617":57136,"_5":14139,"_27008":56638,"_2880":57137},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3394":2808,"_29710":2605,"_20617":57139,"_5":14139,"_27008":56638,"_2880":57140},[],"Record the names of your local-storage PVCs:",{"_3394":2809,"_29710":2605,"_20617":57142,"_5":14139,"_27008":56638,"_2880":57143},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3394":2810,"_29710":2605,"_20617":57145,"_5":14139,"_27008":56642,"_2880":57146},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3394":2811,"_29710":2605,"_20617":57148,"_5":14139,"_27008":56642,"_2880":57149},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3394":2812,"_29710":2605,"_20617":57151,"_5":14139,"_27008":56642,"_2880":57152},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3394":2813,"_29710":2605,"_20617":57154,"_5":14139,"_27008":56642,"_2880":57155},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3394":2814,"_29710":2605,"_20617":57157,"_5":14139,"_27008":56642,"_2880":57158},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3394":2815,"_29710":2605,"_20617":57160,"_5":14139,"_27008":56642,"_2880":57161},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3394":2816,"_29710":2605,"_20617":57163,"_5":14139,"_27008":56642,"_2880":57164},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3394":2817,"_29710":2605,"_20617":57166,"_5":14139,"_27008":56642,"_2880":57167},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3394":2818,"_29710":2605,"_20617":57169,"_5":14139,"_27008":56642,"_2880":57170},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3394":2819,"_29710":2605,"_20617":57172,"_5":14139,"_27008":56642,"_2880":57173},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3394":2820,"_29710":2605,"_20617":57175,"_5":14139,"_27008":56642,"_2880":57176},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3394":2821,"_29710":2605,"_20617":57178,"_5":14139,"_27008":56642,"_2880":57179},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3394":2822,"_29710":2605,"_20617":57181,"_5":14139,"_27008":56646,"_2880":57182},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3394":2823,"_29710":2605,"_20617":57184,"_5":14139,"_27008":56646,"_2880":57185},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3394":2824,"_29710":2605,"_20617":57187,"_5":14139,"_27008":56650,"_2880":57188},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3394":2825,"_29710":2605,"_20617":57190,"_5":14139,"_27008":56650,"_2880":57191},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3394":2826,"_29710":2605,"_20617":57193,"_5":14139,"_27008":56650,"_2880":57194},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3394":2827,"_29710":2605,"_20617":57196,"_5":14139,"_27008":56650,"_2880":57197},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3394":2828,"_29710":2605,"_20617":57199,"_5":14139,"_27008":56650,"_2880":57200},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3394":2829,"_29710":2605,"_20617":57202,"_5":14139,"_27008":56650,"_2880":57203},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3394":2830,"_29710":2605,"_20617":57205,"_5":14139,"_27008":56650,"_2880":57206},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3394":2831,"_29710":2605,"_20617":57208,"_5":14139,"_27008":56650,"_2880":57209},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3394":2832,"_29710":2605,"_20617":57211,"_5":14139,"_27008":56650,"_2880":57212},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3394":2833,"_29710":2605,"_20617":57214,"_5":14139,"_27008":56650,"_2880":57215},[],"**Remove the helper and restore the recorded replica counts:**",{"_3394":2834,"_29710":2605,"_20617":57217,"_5":14139,"_27008":56650,"_2880":57218},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3394":2835,"_29710":2605,"_20617":57220,"_5":14139,"_27008":56654,"_2880":57221},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3394":2836,"_29710":2605,"_20617":57223,"_5":14139,"_27008":56654,"_2880":57224},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3394":2837,"_29710":2605,"_20617":57226,"_5":14139,"_27008":56658,"_2880":57227},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3394":2838,"_29710":2605,"_20617":57229,"_5":14139,"_27008":56658,"_2880":57230},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3394":2839,"_29710":2605,"_20617":57232,"_5":14139,"_27008":56658,"_2880":57233},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3394":2840,"_29710":2605,"_20617":57235,"_5":14139,"_27008":56658,"_2880":57236},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3394":2841,"_29710":2605,"_20617":57238,"_5":14139,"_27008":56658,"_2880":57239},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3394":2842,"_29710":2605,"_20617":57241,"_5":14139,"_27008":56658,"_2880":57242},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3394":2843,"_29710":2605,"_20617":57244,"_5":14139,"_27008":56658,"_2880":57245},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3394":2844,"_29710":2605,"_20617":57247,"_5":14139,"_27008":56658,"_2880":57248},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3394":2845,"_29710":2605,"_20617":57250,"_5":14139,"_27008":56662,"_2880":57251},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3394":2846,"_29710":2605,"_20617":57253,"_5":14139,"_27008":56662,"_2880":57254},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3394":2847,"_29710":2605,"_20617":57256,"_5":14139,"_27008":56662,"_2880":57257},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3394":2848,"_29710":2605,"_20617":57259,"_5":14139,"_27008":56662,"_2880":57260},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3394":2849,"_29710":2605,"_20617":57262,"_5":14139,"_27008":56662,"_2880":57263},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3394":2850,"_29710":2605,"_20617":57265,"_5":14139,"_27008":56662,"_2880":57266},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3394":2851,"_29710":2605,"_20617":57268,"_5":14139,"_27008":56662,"_2880":57269},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3394":2852,"_29710":2605,"_20617":57271,"_5":14139,"_27008":56662,"_2880":57272},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3394":2853,"_29710":2605,"_20617":57274,"_5":14139,"_27008":56662,"_2880":57275},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3394":2854,"_29710":2605,"_20617":57277,"_5":14139,"_27008":56662,"_2880":57278},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** No CA certificate matched the stored signer SKI, and the fallback search found zero or multiple certificates. Review the SKI and candidates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3394":2855,"_29710":2605,"_20617":57280,"_5":14139,"_27008":56662,"_2880":57281},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3394":2856,"_29710":2605,"_20617":57283,"_5":14139,"_27008":56665,"_2880":57284},[],"After the upgrade, check in this order:",{"_3394":2857,"_29710":2605,"_20617":57286,"_5":14139,"_27008":56665,"_2880":57287},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3394":2858,"_29710":2605,"_20617":57289,"_5":14139,"_27008":56665,"_2880":57290},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3394":2859,"_29710":2605,"_20617":57292,"_5":14139,"_27008":56665,"_2880":57293},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3394":2860,"_29710":2605,"_20617":57295,"_5":14139,"_27008":56665,"_2880":57296},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3394":2861,"_29710":2605,"_20617":57298,"_5":14139,"_27008":56665,"_2880":57299},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3394":2862,"_29710":2605,"_20617":57301,"_5":14139,"_27008":56665,"_2880":57302},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3394":2863,"_29710":2605,"_20617":57304,"_5":14139,"_27008":56665,"_2880":57305},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3394":2864,"_29710":2605,"_20617":57307,"_5":14139,"_27008":56665,"_2880":57308},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3394":2865,"_29710":2605,"_20617":57310,"_5":14139,"_27008":56665,"_2880":57311},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3394":2866,"_29710":2605,"_20617":57313,"_5":14139,"_27008":56665,"_2880":57314},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3394":2867,"_29710":2605,"_20617":57316,"_5":14139,"_27008":56665,"_2880":57317},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3394":2868,"_29710":2605,"_20617":57319,"_5":14139,"_27008":56665,"_2880":57320},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3394":2869,"_29710":2605,"_20617":57322,"_5":14139,"_27008":56665,"_2880":57323},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3394":2870,"_29710":2605,"_20617":57325,"_5":14139,"_27008":56665,"_2880":57326},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3394":2871,"_29710":2605,"_20617":57328,"_5":14139,"_27008":56669,"_2880":57329},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3394":2872,"_29710":2605,"_20617":57331,"_5":14139,"_27008":56669,"_2880":57332},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3394":2873,"_29710":2605,"_20617":57334,"_5":14139,"_27008":56669,"_2880":57335},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3394":2874,"_29710":2605,"_20617":57337,"_5":14139,"_27008":56669,"_2880":57338},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3394":2875,"_29710":2605,"_20617":57340,"_5":14139,"_27008":56669,"_2880":57341},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_57344":57345,"_57346":57347,"_57348":57349,"_57350":57351,"_17857":2915,"_68809":2915},"language","english","sortableProperties",[2880,29710,5,27008],"sortablePropertiesWithTypes",{"_2880":24618,"_29710":24618,"_5":24618,"_27008":24618},"sorts",{"_2880":57352,"_29710":60217,"_5":63081,"_27008":65945},{"_4562":57353,"_57354":57355,"_5":24618},{"_14215":3569,"_14596":11520,"_14615":6826,"_28713":3482,"_14602":9436,"_19571":15266,"_14236":11424,"_14243":3362,"_28655":10947,"_29064":4714,"_29085":4963,"_28689":4410,"_34029":5860,"_28792":7379,"_29129":7387,"_34036":3113,"_34039":18152,"_34042":5745,"_34045":8883,"_29536":4356,"_34050":14675,"_34052":3570,"_29566":17949,"_14611":24971,"_34056":5432,"_34059":4807,"_34061":6094,"_29113":7473,"_29531":23237,"_29579":7568,"_34066":3593,"_34068":22431,"_34070":3369,"_28809":2979,"_34073":13154,"_34075":3342,"_34077":9588,"_34079":3584,"_34081":3697,"_28726":4362,"_34084":7272,"_34086":5059,"_28720":13216,"_29150":7336,"_34090":7263,"_34092":7695,"_34095":15340,"_28766":3367,"_34099":6462,"_28646":14063,"_34102":6371,"_28694":3632,"_34105":19134,"_34107":3361,"_34110":3664,"_14605":16648,"_34113":5361,"_34115":4684,"_29769":5903,"_34119":3184,"_34121":3596,"_34123":16336,"_34125":6054,"_19574":7545,"_34128":8430,"_34130":5946,"_28667":5664,"_29107":48