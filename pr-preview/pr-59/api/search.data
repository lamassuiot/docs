_39668":122773,"_39670":122776,"_39672":122779,"_39674":122782,"_39676":122785,"_39678":122788,"_39680":122791,"_39682":122794,"_39684":122797,"_39686":122800,"_39688":122803,"_39690":122806,"_39692":122809,"_39694":122812,"_39696":122815,"_39698":122818,"_39700":122821,"_39702":122824,"_39704":122827,"_39706":122830,"_39708":122833,"_39710":122836,"_39712":122839,"_39714":122842,"_39716":122845,"_39718":122848,"_39720":122851,"_39722":122854,"_39724":122857,"_39726":122860,"_39728":122863,"_39730":122866,"_39732":122869,"_39735":122872,"_39737":122875,"_39739":122878},{"_3394":68816,"_29710":68816,"_5":14491,"_2880":114142,"_30063":114143,"_20617":114146,"_27008":68816},"Despliega desde AWS Marketplace",[48401,114144,114145],"Despliegue","Otros modelos",[],{"_3394":68817,"_29710":68816,"_20617":114148,"_5":14139,"_27008":68816,"_2880":114149},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3394":68818,"_29710":68816,"_5":30060,"_20617":114151,"_27008":114152,"_2880":114153},[],"/docs/pr-preview/pr-59/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3394":68819,"_29710":68816,"_5":30060,"_20617":114155,"_27008":114156,"_2880":114157},[],"/docs/pr-preview/pr-59/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3394":68820,"_29710":68816,"_5":30060,"_20617":114159,"_27008":114160,"_2880":114161},[],"/docs/pr-preview/pr-59/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3394":68821,"_29710":68816,"_5":30060,"_20617":114163,"_27008":114164,"_2880":114165},[],"/docs/pr-preview/pr-59/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3394":68822,"_29710":68816,"_5":30060,"_20617":114167,"_27008":114168,"_2880":114169},[],"/docs/pr-preview/pr-59/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3394":68823,"_29710":68816,"_5":30060,"_20617":114171,"_27008":114172,"_2880":114173},[],"/docs/pr-preview/pr-59/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3394":68824,"_29710":68816,"_5":30060,"_20617":114175,"_27008":114176,"_2880":114177},[],"/docs/pr-preview/pr-59/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3394":68825,"_29710":68816,"_20617":114179,"_5":14139,"_27008":68816,"_2880":114180},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3394":68826,"_29710":68816,"_20617":114182,"_5":14139,"_27008":114152,"_2880":114183},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3394":68827,"_29710":68816,"_20617":114185,"_5":14139,"_27008":114152,"_2880":114186},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3394":68828,"_29710":68816,"_20617":114188,"_5":14139,"_27008":114152,"_2880":114189},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3394":68829,"_29710":68816,"_20617":114191,"_5":14139,"_27008":114156,"_2880":114192},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3394":68830,"_29710":68816,"_20617":114194,"_5":14139,"_27008":114156,"_2880":114195},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3394":68831,"_29710":68816,"_20617":114197,"_5":14139,"_27008":114156,"_2880":114198},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3394":68832,"_29710":68816,"_20617":114200,"_5":14139,"_27008":114160,"_2880":114201},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3394":68833,"_29710":68816,"_20617":114203,"_5":14139,"_27008":114164,"_2880":114204},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3394":68834,"_29710":68816,"_20617":114206,"_5":14139,"_27008":114168,"_2880":114207},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3394":68835,"_29710":68816,"_20617":114209,"_5":14139,"_27008":114172,"_2880":114210},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3394":68836,"_29710":68816,"_20617":114212,"_5":14139,"_27008":114176,"_2880":114213},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3394":68837,"_29710":68837,"_5":14491,"_2880":114215,"_30063":114216,"_20617":114217,"_27008":68837},"Despliega Lamassu",[48401,114144],[],{"_3394":68838,"_29710":68837,"_20617":114219,"_5":14139,"_27008":68837,"_2880":114220},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3394":68839,"_29710":68837,"_5":30060,"_20617":114222,"_27008":114223,"_2880":114224},[],"/docs/pr-preview/pr-59/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3394":68840,"_29710":68837,"_5":30060,"_20617":114226,"_27008":114227,"_2880":114228},[],"/docs/pr-preview/pr-59/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3394":68841,"_29710":68837,"_5":30060,"_20617":114230,"_27008":114231,"_2880":114232},[],"/docs/pr-preview/pr-59/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3394":68842,"_29710":68837,"_20617":114234,"_5":14139,"_27008":68837,"_2880":114235},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3394":68843,"_29710":68837,"_20617":114237,"_5":14139,"_27008":114223,"_2880":114238},[],"Modelo",{"_3394":68844,"_29710":68837,"_20617":114240,"_5":14139,"_27008":114223,"_2880":114241},[],"Recomendado para",{"_3394":68845,"_29710":68837,"_20617":114243,"_5":14139,"_27008":114223,"_2880":114244},[],"Quién opera la infraestructura",{"_3394":68846,"_29710":68837,"_20617":114246,"_5":14139,"_27008":114223,"_2880":114247},[],"Punto de partida",{"_3394":68847,"_29710":68837,"_20617":114249,"_5":14139,"_27008":114223,"_2880":48508},[],{"_3394":68848,"_29710":68837,"_20617":114251,"_5":14139,"_27008":114223,"_2880":114252},[],"Producción, entornos regulados y despliegues personalizados",{"_3394":68849,"_29710":68837,"_20617":114254,"_5":14139,"_27008":114223,"_2880":114255},[],"Tu equipo",{"_3394":68850,"_29710":68837,"_20617":114257,"_5":14139,"_27008":114223,"_2880":114258},[],"Helm o Fastlane",{"_3394":68851,"_29710":68837,"_20617":114260,"_5":14139,"_27008":114223,"_2880":48520},[],{"_3394":68852,"_29710":68837,"_20617":114262,"_5":14139,"_27008":114223,"_2880":114263},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3394":68853,"_29710":68837,"_20617":114265,"_5":14139,"_27008":114223,"_2880":114255},[],{"_3394":68854,"_29710":68837,"_20617":114267,"_5":14139,"_27008":114223,"_2880":114268},[],"Imagen preconfigurada en EC2",{"_3394":68855,"_29710":68837,"_20617":114270,"_5":14139,"_27008":114223,"_2880":48531},[],{"_3394":68856,"_29710":68837,"_20617":114272,"_5":14139,"_27008":114223,"_2880":114273},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3394":68857,"_29710":68837,"_20617":114275,"_5":14139,"_27008":114223,"_2880":48537},[],{"_3394":68858,"_29710":68837,"_20617":114277,"_5":14139,"_27008":114223,"_2880":114278},[],"Suscripción gestionada",{"_3394":68859,"_29710":68837,"_20617":114280,"_5":14139,"_27008":114223,"_2880":114281},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3394":68860,"_29710":68837,"_20617":114283,"_5":14139,"_27008":114223,"_2880":114284},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3394":68861,"_29710":68837,"_20617":114286,"_5":14139,"_27008":114223,"_2880":114287},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3394":68862,"_29710":68837,"_20617":114289,"_5":14139,"_27008":114227,"_2880":114290},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3394":68863,"_29710":68837,"_20617":114292,"_5":14139,"_27008":114231,"_2880":114293},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3394":68864,"_29710":68864,"_5":14491,"_2880":114295,"_30063":114296,"_20617":114297,"_27008":68864},"Utiliza Lamassu como SaaS",[48401,114144,114145],[],{"_3394":68865,"_29710":68864,"_20617":114299,"_5":14139,"_27008":68864,"_2880":114300},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3394":68866,"_29710":68864,"_5":30060,"_20617":114302,"_27008":114303,"_2880":114304},[],"/docs/pr-preview/pr-59/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3394":68867,"_29710":68864,"_5":30060,"_20617":114306,"_27008":114307,"_2880":114308},[],"/docs/pr-preview/pr-59/es/deployment/saas#planes","Planes",{"_3394":68868,"_29710":68864,"_5":30060,"_20617":114310,"_27008":114311,"_2880":114312},[],"/docs/pr-preview/pr-59/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3394":68869,"_29710":68864,"_20617":114314,"_5":14139,"_27008":68864,"_2880":114315},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3394":68870,"_29710":68864,"_20617":114317,"_5":14139,"_27008":114303,"_2880":114318},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3394":68871,"_29710":68864,"_20617":114320,"_5":14139,"_27008":114303,"_2880":114321},[],"Copias de seguridad automáticas.",{"_3394":68872,"_29710":68864,"_20617":114323,"_5":14139,"_27008":114303,"_2880":114324},[],"Actualizaciones de versión.",{"_3394":68873,"_29710":68864,"_20617":114326,"_5":14139,"_27008":114303,"_2880":114327},[],"Soporte técnico y SLA según el plan contratado.",{"_3394":68874,"_29710":68864,"_20617":114329,"_5":14139,"_27008":114307,"_2880":48592},[],{"_3394":68875,"_29710":68864,"_20617":114331,"_5":14139,"_27008":114307,"_2880":114332},[],"Dispositivos",{"_3394":68876,"_29710":68864,"_20617":114334,"_5":14139,"_27008":114307,"_2880":114335},[],"Soporte",{"_3394":68877,"_29710":68864,"_20617":114337,"_5":14139,"_27008":114307,"_2880":48601},[],{"_3394":68878,"_29710":68864,"_20617":114339,"_5":14139,"_27008":114307,"_2880":48604},[],{"_3394":68879,"_29710":68864,"_20617":114341,"_5":14139,"_27008":114307,"_2880":114342},[],"Hasta 1.000",{"_3394":68880,"_29710":68864,"_20617":114344,"_5":14139,"_27008":114307,"_2880":48610},[],{"_3394":68881,"_29710":68864,"_20617":114346,"_5":14139,"_27008":114307,"_2880":114347},[],"99,5 %",{"_3394":68882,"_29710":68864,"_20617":114349,"_5":14139,"_27008":114307,"_2880":48616},[],{"_3394":68883,"_29710":68864,"_20617":114351,"_5":14139,"_27008":114307,"_2880":114352},[],"Hasta 10.000",{"_3394":68884,"_29710":68864,"_20617":114354,"_5":14139,"_27008":114307,"_2880":114355},[],"Email y chat",{"_3394":68885,"_29710":68864,"_20617":114357,"_5":14139,"_27008":114307,"_2880":114358},[],"99,9 %",{"_3394":68886,"_29710":68864,"_20617":114360,"_5":14139,"_27008":114307,"_2880":48628},[],{"_3394":68887,"_29710":68864,"_20617":114362,"_5":14139,"_27008":114307,"_2880":114363},[],"Ilimitados",{"_3394":68888,"_29710":68864,"_20617":114365,"_5":14139,"_27008":114307,"_2880":114366},[],"Dedicado",{"_3394":68889,"_29710":68864,"_20617":114368,"_5":14139,"_27008":114307,"_2880":114369},[],"99,99 %",{"_3394":68890,"_29710":68864,"_20617":114371,"_5":14139,"_27008":114311,"_2880":114372},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3394":68891,"_29710":68864,"_20617":114374,"_5":14139,"_27008":114311,"_2880":114375},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3394":68892,"_29710":68892,"_5":14491,"_2880":48645,"_30063":114377,"_20617":114379,"_27008":68892},[48401,114144,114378],"Kubernetes autogestionado",[],{"_3394":68893,"_29710":68892,"_20617":114381,"_5":14139,"_27008":68892,"_2880":114382},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3394":68894,"_29710":68892,"_5":30060,"_20617":114384,"_27008":114385,"_2880":114386},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3394":68895,"_29710":68892,"_5":30060,"_20617":114388,"_27008":114389,"_2880":114390},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3394":68896,"_29710":68892,"_5":30060,"_20617":114392,"_27008":114393,"_2880":114394},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3394":68897,"_29710":68892,"_5":30060,"_20617":114396,"_27008":114397,"_2880":114398},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3394":68898,"_29710":68892,"_5":30060,"_20617":114400,"_27008":114401,"_2880":114402},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3394":68899,"_29710":68892,"_5":30060,"_20617":114404,"_27008":114405,"_2880":114406},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3394":68900,"_29710":68892,"_5":30060,"_20617":114408,"_27008":114409,"_2880":114410},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3394":68901,"_29710":68892,"_5":30060,"_20617":114412,"_27008":114413,"_2880":114414},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3394":68902,"_29710":68892,"_5":30060,"_20617":114416,"_27008":114417,"_2880":114418},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3394":68903,"_29710":68892,"_5":30060,"_20617":114420,"_27008":114421,"_2880":114422},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3394":68904,"_29710":68892,"_5":30060,"_20617":114424,"_27008":114425,"_2880":114426},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3394":68905,"_29710":68892,"_20617":114428,"_5":14139,"_27008":114385,"_2880":114429},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3394":68906,"_29710":68892,"_20617":114431,"_5":14139,"_27008":114385,"_2880":114432},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3394":68907,"_29710":68892,"_20617":114434,"_5":14139,"_27008":114389,"_2880":114435},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3394":68908,"_29710":68892,"_20617":114437,"_5":14139,"_27008":114389,"_2880":114438},[],"Fastlane instala o configura",{"_3394":68909,"_29710":68892,"_20617":114440,"_5":14139,"_27008":114389,"_2880":114441},[],"Tú sigues proporcionando",{"_3394":68910,"_29710":68892,"_20617":114443,"_5":14139,"_27008":114389,"_2880":114444},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3394":68911,"_29710":68892,"_20617":114446,"_5":14139,"_27008":114389,"_2880":114447},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3394":68912,"_29710":68892,"_20617":114449,"_5":14139,"_27008":114389,"_2880":114450},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3394":68913,"_29710":68892,"_20617":114452,"_5":14139,"_27008":114389,"_2880":114453},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3394":68914,"_29710":68892,"_20617":114455,"_5":14139,"_27008":114389,"_2880":114456},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3394":68915,"_29710":68892,"_20617":114458,"_5":14139,"_27008":114389,"_2880":114459},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3394":68916,"_29710":68892,"_20617":114461,"_5":14139,"_27008":114389,"_2880":114462},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3394":68917,"_29710":68892,"_20617":114464,"_5":14139,"_27008":114389,"_2880":114465},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3394":68918,"_29710":68892,"_20617":114467,"_5":14139,"_27008":114389,"_2880":114468},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3394":68919,"_29710":68892,"_20617":114470,"_5":14139,"_27008":114393,"_2880":114471},[],"Necesitas:",{"_3394":68920,"_29710":68892,"_20617":114473,"_5":14139,"_27008":114393,"_2880":114474},[],"un clúster Kubernetes existente",{"_3394":68921,"_29710":68892,"_20617":114476,"_5":14139,"_27008":114393,"_2880":114477},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3394":68922,"_29710":68892,"_20617":114479,"_5":14139,"_27008":114393,"_2880":48747},[],{"_3394":68923,"_29710":68892,"_20617":114481,"_5":14139,"_27008":114393,"_2880":23295},[],{"_3394":68924,"_29710":68892,"_20617":114483,"_5":14139,"_27008":114393,"_2880":114484},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3394":68925,"_29710":68892,"_20617":114486,"_5":14139,"_27008":114393,"_2880":114487},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3394":68926,"_29710":68892,"_20617":114489,"_5":14139,"_27008":114393,"_2880":114490},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3394":68927,"_29710":68892,"_20617":114492,"_5":14139,"_27008":114393,"_2880":114493},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3394":68928,"_29710":68892,"_20617":114495,"_5":14139,"_27008":114393,"_2880":114496},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3394":68929,"_29710":68892,"_20617":114498,"_5":14139,"_27008":114397,"_2880":114499},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3394":68930,"_29710":68892,"_20617":114501,"_5":14139,"_27008":114397,"_2880":114502},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3394":68931,"_29710":68892,"_20617":114504,"_5":14139,"_27008":114401,"_2880":114505},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3394":68932,"_29710":68892,"_20617":114507,"_5":14139,"_27008":114401,"_2880":114508},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3394":68933,"_29710":68892,"_20617":114510,"_5":14139,"_27008":114401,"_2880":114511},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3394":68934,"_29710":68892,"_20617":114513,"_5":14139,"_27008":114401,"_2880":114514},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3394":68935,"_29710":68892,"_20617":114516,"_5":14139,"_27008":114405,"_2880":114517},[],"Opción",{"_3394":68936,"_29710":68892,"_20617":114519,"_5":14139,"_27008":114405,"_2880":114520},[],"Valor predeterminado",{"_3394":68937,"_29710":68892,"_20617":114522,"_5":14139,"_27008":114405,"_2880":114523},[],"Propósito",{"_3394":68938,"_29710":68892,"_20617":114525,"_5":14139,"_27008":114405,"_2880":48794},[],{"_3394":68939,"_29710":68892,"_20617":114527,"_5":14139,"_27008":114405,"_2880":48797},[],{"_3394":68940,"_29710":68892,"_20617":114529,"_5":14139,"_27008":114405,"_2880":114530},[],"Muestra la ayuda",{"_3394":68941,"_29710":68892,"_20617":114532,"_5":14139,"_27008":114405,"_2880":48803},[],{"_3394":68942,"_29710":68892,"_20617":114534,"_5":14139,"_27008":114405,"_2880":114535},[],"contexto actual",{"_3394":68943,"_29710":68892,"_20617":114537,"_5":14139,"_27008":114405,"_2880":114538},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3394":68944,"_29710":68892,"_20617":114540,"_5":14139,"_27008":114405,"_2880":48812},[],{"_3394":68945,"_29710":68892,"_20617":114542,"_5":14139,"_27008":114405,"_2880":6425},[],{"_3394":68946,"_29710":68892,"_20617":114544,"_5":14139,"_27008":114405,"_2880":114545},[],"Omite prompts y genera credenciales para las dependencias",{"_3394":68947,"_29710":68892,"_20617":114547,"_5":14139,"_27008":114405,"_2880":48820},[],{"_3394":68948,"_29710":68892,"_20617":114549,"_5":14139,"_27008":114405,"_2880":48823},[],{"_3394":68949,"_29710":68892,"_20617":114551,"_5":14139,"_27008":114405,"_2880":114552},[],"Namespace de la instalación",{"_3394":68950,"_29710":68892,"_20617":114554,"_5":14139,"_27008":114405,"_2880":48829},[],{"_3394":68951,"_29710":68892,"_20617":114556,"_5":14139,"_27008":114405,"_2880":48832},[],{"_3394":68952,"_29710":68892,"_20617":114558,"_5":14139,"_27008":114405,"_2880":114559},[],"Dominio usado por la UI, OIDC y el certificado",{"_3394":68953,"_29710":68892,"_20617":114561,"_5":14139,"_27008":114405,"_2880":48838},[],{"_3394":68954,"_29710":68892,"_20617":114563,"_5":14139,"_27008":114405,"_2880":14825},[],{"_3394":68955,"_29710":68892,"_20617":114565,"_5":14139,"_27008":114405,"_2880":114566},[],"Versión del chart de Lamassu",{"_3394":68956,"_29710":68892,"_20617":114568,"_5":14139,"_27008":114405,"_2880":48846},[],{"_3394":68957,"_29710":68892,"_20617":114570,"_5":14139,"_27008":114405,"_2880":48849},[],{"_3394":68958,"_29710":68892,"_20617":114572,"_5":14139,"_27008":114405,"_2880":114573},[],"Puerto del listener HTTPS",{"_3394":68959,"_29710":68892,"_20617":114575,"_5":14139,"_27008":114405,"_2880":48855},[],{"_3394":68960,"_29710":68892,"_20617":114577,"_5":14139,"_27008":114405,"_2880":48858},[],{"_3394":68961,"_29710":68892,"_20617":114579,"_5":14139,"_27008":114405,"_2880":114580},[],"Puerto del listener HTTP",{"_3394":68962,"_29710":68892,"_20617":114582,"_5":14139,"_27008":114405,"_2880":48864},[],{"_3394":68963,"_29710":68892,"_20617":114584,"_5":14139,"_27008":114405,"_2880":48797},[],{"_3394":68964,"_29710":68892,"_20617":114586,"_5":14139,"_27008":114405,"_2880":114587},[],"Certificado PEM para TLS downstream",{"_3394":68965,"_29710":68892,"_20617":114589,"_5":14139,"_27008":114405,"_2880":48872},[],{"_3394":68966,"_29710":68892,"_20617":114591,"_5":14139,"_27008":114405,"_2880":48797},[],{"_3394":68967,"_29710":68892,"_20617":114593,"_5":14139,"_27008":114405,"_2880":114594},[],"Clave privada PEM para TLS downstream",{"_3394":68968,"_29710":68892,"_20617":114596,"_5":14139,"_27008":114405,"_2880":48880},[],{"_3394":68969,"_29710":68892,"_20617":114598,"_5":14139,"_27008":114405,"_2880":114599},[],"chart del repositorio",{"_3394":68970,"_29710":68892,"_20617":114601,"_5":14139,"_27008":114405,"_2880":114602},[],"Usa un chart local de Lamassu sin empaquetar",{"_3394":68971,"_29710":68892,"_20617":114604,"_5":14139,"_27008":114405,"_2880":48889},[],{"_3394":68972,"_29710":68892,"_20617":114606,"_5":14139,"_27008":114405,"_2880":114607},[],"detección automática",{"_3394":68973,"_29710":68892,"_20617":114609,"_5":14139,"_27008":114405,"_2880":114610},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3394":68974,"_29710":68892,"_20617":114612,"_5":14139,"_27008":114405,"_2880":48897},[],{"_3394":68975,"_29710":68892,"_20617":114614,"_5":14139,"_27008":114405,"_2880":6425},[],{"_3394":68976,"_29710":68892,"_20617":114616,"_5":14139,"_27008":114405,"_2880":114617},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3394":68977,"_29710":68892,"_20617":114619,"_5":14139,"_27008":114405,"_2880":48905},[],{"_3394":68978,"_29710":68892,"_20617":114621,"_5":14139,"_27008":114405,"_2880":6425},[],{"_3394":68979,"_29710":68892,"_20617":114623,"_5":14139,"_27008":114405,"_2880":114624},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3394":68980,"_29710":68892,"_20617":114626,"_5":14139,"_27008":114405,"_2880":48913},[],{"_3394":68981,"_29710":68892,"_20617":114628,"_5":14139,"_27008":114405,"_2880":6425},[],{"_3394":68982,"_29710":68892,"_20617":114630,"_5":14139,"_27008":114405,"_2880":114631},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3394":68983,"_29710":68892,"_20617":114633,"_5":14139,"_27008":114405,"_2880":48921},[],{"_3394":68984,"_29710":68892,"_20617":114635,"_5":14139,"_27008":114405,"_2880":6425},[],{"_3394":68985,"_29710":68892,"_20617":114637,"_5":14139,"_27008":114405,"_2880":114638},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3394":68986,"_29710":68892,"_20617":114640,"_5":14139,"_27008":114405,"_2880":48929},[],{"_3394":68987,"_29710":68892,"_20617":114642,"_5":14139,"_27008":114405,"_2880":48932},[],{"_3394":68988,"_29710":68892,"_20617":114644,"_5":14139,"_27008":114405,"_2880":114645},[],"Usa otro chart local de SoftHSM",{"_3394":68989,"_29710":68892,"_20617":114647,"_5":14139,"_27008":114405,"_2880":114648},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3394":68990,"_29710":68892,"_20617":114650,"_5":14139,"_27008":114409,"_2880":114651},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3394":68991,"_29710":68892,"_20617":114653,"_5":14139,"_27008":114409,"_2880":114654},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3394":68992,"_29710":68892,"_20617":114656,"_5":14139,"_27008":114409,"_2880":114657},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3394":68993,"_29710":68892,"_20617":114659,"_5":14139,"_27008":114409,"_2880":114660},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3394":68994,"_29710":68892,"_20617":114662,"_5":14139,"_27008":114409,"_2880":114663},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3394":68995,"_29710":68892,"_20617":114665,"_5":14139,"_27008":114409,"_2880":114666},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3394":68996,"_29710":68892,"_20617":114668,"_5":14139,"_27008":114413,"_2880":48959},[],{"_3394":68997,"_29710":68892,"_20617":114670,"_5":14139,"_27008":114413,"_2880":114671},[],"valida las herramientas locales y el clúster seleccionado",{"_3394":68998,"_29710":68892,"_20617":114673,"_5":14139,"_27008":114413,"_2880":114674},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3394":68999,"_29710":68892,"_20617":114676,"_5":14139,"_27008":114413,"_2880":114677},[],"crea el namespace",{"_3394":69000,"_29710":68892,"_20617":114679,"_5":14139,"_27008":114413,"_2880":114680},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3394":69001,"_29710":68892,"_20617":114682,"_5":14139,"_27008":114413,"_2880":114683},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3394":69002,"_29710":68892,"_20617":114685,"_5":14139,"_27008":114413,"_2880":114686},[],"instala RabbitMQ",{"_3394":69003,"_29710":68892,"_20617":114688,"_5":14139,"_27008":114413,"_2880":114689},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3394":69004,"_29710":68892,"_20617":114691,"_5":14139,"_27008":114413,"_2880":114692},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3394":69005,"_29710":68892,"_20617":114694,"_5":14139,"_27008":114413,"_2880":114695},[],"carga datos de ejemplo opcionalmente",{"_3394":69006,"_29710":68892,"_20617":114697,"_5":14139,"_27008":114413,"_2880":114698},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3394":69007,"_29710":68892,"_20617":114700,"_5":14139,"_27008":114417,"_2880":114701},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3394":69008,"_29710":68892,"_20617":114703,"_5":14139,"_27008":114417,"_2880":114704},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3394":69009,"_29710":68892,"_20617":114706,"_5":14139,"_27008":114421,"_2880":114707},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3394":69010,"_29710":68892,"_20617":114709,"_5":14139,"_27008":114421,"_2880":114710},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3394":69011,"_29710":68892,"_20617":114712,"_5":14139,"_27008":114421,"_2880":114713},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3394":69012,"_29710":68892,"_20617":114715,"_5":14139,"_27008":114425,"_2880":114716},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3394":69013,"_29710":69013,"_5":14491,"_2880":114718,"_30063":114719,"_20617":114720,"_27008":69013},"Instala con Helm",[48401,114144,114378],[],{"_3394":69014,"_29710":69013,"_20617":114722,"_5":14139,"_27008":69013,"_2880":114723},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3394":69015,"_29710":69013,"_5":30060,"_20617":114725,"_27008":114726,"_2880":114727},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3394":69016,"_29710":69013,"_5":30060,"_20617":114729,"_27008":114730,"_2880":114394},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3394":69017,"_29710":69013,"_5":30060,"_20617":114732,"_27008":114733,"_2880":114734},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3394":69018,"_29710":69013,"_5":30060,"_20617":114736,"_27008":114737,"_2880":114738},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3394":69019,"_29710":69013,"_5":30060,"_20617":114740,"_27008":114741,"_2880":114742},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3394":69020,"_29710":69013,"_5":30060,"_20617":114744,"_27008":114745,"_2880":114746},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3394":69021,"_29710":69013,"_5":30060,"_20617":114748,"_27008":114749,"_2880":114750},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3394":69022,"_29710":69013,"_5":30060,"_20617":114752,"_27008":114753,"_2880":114754},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3394":69023,"_29710":69013,"_5":30060,"_20617":114756,"_27008":114757,"_2880":114758},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3394":69024,"_29710":69013,"_5":30060,"_20617":114760,"_27008":114761,"_2880":114762},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3394":69025,"_29710":69013,"_5":30060,"_20617":114764,"_27008":114765,"_2880":114766},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3394":69026,"_29710":69013,"_20617":114768,"_5":14139,"_27008":114726,"_2880":114769},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3394":69027,"_29710":69013,"_20617":114771,"_5":14139,"_27008":114730,"_2880":114772},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3394":69028,"_29710":69013,"_20617":114774,"_5":14139,"_27008":114730,"_2880":114775},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3394":69029,"_29710":69013,"_20617":114777,"_5":14139,"_27008":114730,"_2880":114778},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3394":69030,"_29710":69013,"_20617":114780,"_5":14139,"_27008":114730,"_2880":114781},[],"un broker RabbitMQ accesible y sus credenciales",{"_3394":69031,"_29710":69013,"_20617":114783,"_5":14139,"_27008":114730,"_2880":114784},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3394":69032,"_29710":69013,"_20617":114786,"_5":14139,"_27008":114730,"_2880":114787},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3394":69033,"_29710":69013,"_20617":114789,"_5":14139,"_27008":114730,"_2880":114790},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3394":69034,"_29710":69013,"_20617":114792,"_5":14139,"_27008":114730,"_2880":114793},[],"una StorageClass y un diseño de tráfico externo",{"_3394":69035,"_29710":69013,"_20617":114795,"_5":14139,"_27008":114730,"_2880":114796},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3394":69036,"_29710":69013,"_20617":114798,"_5":14139,"_27008":114730,"_2880":114799},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3394":69037,"_29710":69013,"_20617":114801,"_5":14139,"_27008":114730,"_2880":114802},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3394":69038,"_29710":69013,"_20617":114804,"_5":14139,"_27008":114733,"_2880":114805},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3394":69039,"_29710":69013,"_20617":114807,"_5":14139,"_27008":114733,"_2880":114808},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3394":69040,"_29710":69013,"_20617":114810,"_5":14139,"_27008":114733,"_2880":114811},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3394":69041,"_29710":69013,"_20617":114813,"_5":14139,"_27008":114737,"_2880":114814},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3394":69042,"_29710":69013,"_20617":114816,"_5":14139,"_27008":114737,"_2880":114817},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3394":69043,"_29710":69013,"_20617":114819,"_5":14139,"_27008":114737,"_2880":114820},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3394":69044,"_29710":69013,"_20617":114822,"_5":14139,"_27008":114737,"_2880":114823},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3394":69045,"_29710":69013,"_20617":114825,"_5":14139,"_27008":114741,"_2880":114826},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3394":69046,"_29710":69013,"_20617":114828,"_5":14139,"_27008":114745,"_2880":114829},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3394":69047,"_29710":69013,"_20617":114831,"_5":14139,"_27008":114745,"_2880":114832},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3394":69048,"_29710":69013,"_20617":114834,"_5":14139,"_27008":114745,"_2880":114835},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3394":69049,"_29710":69013,"_20617":114837,"_5":14139,"_27008":114745,"_2880":114838},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3394":69050,"_29710":69013,"_20617":114840,"_5":14139,"_27008":114745,"_2880":114841},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3394":69051,"_29710":69013,"_20617":114843,"_5":14139,"_27008":114745,"_2880":114844},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3394":69052,"_29710":69013,"_20617":114846,"_5":14139,"_27008":114745,"_2880":114847},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3394":69053,"_29710":69013,"_20617":114849,"_5":14139,"_27008":114749,"_2880":114850},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3394":69054,"_29710":69013,"_20617":114852,"_5":14139,"_27008":114749,"_2880":114853},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3394":69055,"_29710":69013,"_20617":114855,"_5":14139,"_27008":114749,"_2880":114856},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3394":69056,"_29710":69013,"_20617":114858,"_5":14139,"_27008":114749,"_2880":114859},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3394":69057,"_29710":69013,"_20617":114861,"_5":14139,"_27008":114753,"_2880":114862},[],"Para instalar un checkout local:",{"_3394":69058,"_29710":69013,"_20617":114864,"_5":14139,"_27008":114757,"_2880":114865},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3394":69059,"_29710":69013,"_20617":114867,"_5":14139,"_27008":114757,"_2880":114868},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3394":69060,"_29710":69013,"_20617":114870,"_5":14139,"_27008":114761,"_2880":114871},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3394":69061,"_29710":69013,"_20617":114873,"_5":14139,"_27008":114761,"_2880":114874},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3394":69062,"_29710":69013,"_20617":114876,"_5":14139,"_27008":114761,"_2880":114877},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3394":69063,"_29710":69013,"_20617":114879,"_5":14139,"_27008":114761,"_2880":114880},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3394":69064,"_29710":69013,"_20617":114882,"_5":14139,"_27008":114761,"_2880":114883},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3394":69065,"_29710":69013,"_20617":114885,"_5":14139,"_27008":114765,"_2880":114886},[],"Antes de pasar a producción, revisa:",{"_3394":69066,"_29710":69013,"_20617":114888,"_5":14139,"_27008":114765,"_2880":114889},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3394":69067,"_29710":69013,"_20617":114891,"_5":14139,"_27008":114765,"_2880":114892},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3394":69068,"_29710":69013,"_20617":114894,"_5":14139,"_27008":114765,"_2880":114895},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3394":69069,"_29710":69013,"_20617":114897,"_5":14139,"_27008":114765,"_2880":114898},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3394":69070,"_29710":69013,"_20617":114900,"_5":14139,"_27008":114765,"_2880":114901},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3394":69071,"_29710":69013,"_20617":114903,"_5":14139,"_27008":114765,"_2880":114904},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3394":69072,"_29710":69013,"_20617":114906,"_5":14139,"_27008":114765,"_2880":114907},[],"SMTP, observabilidad y entrega de alertas",{"_3394":69073,"_29710":69013,"_20617":114909,"_5":14139,"_27008":114765,"_2880":114910},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3394":69074,"_29710":69013,"_20617":114912,"_5":14139,"_27008":114765,"_2880":114913},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3394":69075,"_29710":69075,"_5":14491,"_2880":114915,"_30063":114916,"_20617":114917,"_27008":69075},"Expón el Gateway",[48401,114144,114378],[],{"_3394":69076,"_29710":69075,"_20617":114919,"_5":14139,"_27008":69075,"_2880":114920},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3394":69077,"_29710":69075,"_5":30060,"_20617":114922,"_27008":114923,"_2880":114924},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3394":69078,"_29710":69075,"_5":30060,"_20617":114926,"_27008":114927,"_2880":114928},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3394":69079,"_29710":69075,"_5":30060,"_20617":114930,"_27008":114931,"_2880":114932},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3394":69080,"_29710":69075,"_5":30060,"_20617":114934,"_27008":114935,"_2880":49227},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#k3s",{"_3394":69081,"_29710":69075,"_5":30060,"_20617":114937,"_27008":114938,"_2880":114939},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3394":69082,"_29710":69075,"_5":30060,"_20617":114941,"_27008":114942,"_2880":114943},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3394":69083,"_29710":69075,"_5":30060,"_20617":114945,"_27008":114946,"_2880":114947},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3394":69084,"_29710":69075,"_5":30060,"_20617":114949,"_27008":114950,"_2880":114951},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3394":69085,"_29710":69075,"_5":30060,"_20617":114953,"_27008":114954,"_2880":114955},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3394":69086,"_29710":69075,"_5":30060,"_20617":114957,"_27008":114958,"_2880":114959},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3394":69087,"_29710":69075,"_20617":114961,"_5":14139,"_27008":114923,"_2880":114962},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3394":69088,"_29710":69075,"_20617":114964,"_5":14139,"_27008":114923,"_2880":114965},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3394":69089,"_29710":69075,"_20617":114967,"_5":14139,"_27008":114927,"_2880":114968},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3394":69090,"_29710":69075,"_20617":114970,"_5":14139,"_27008":114927,"_2880":114971},[],"Defínelo únicamente cuando:",{"_3394":69091,"_29710":69075,"_20617":114973,"_5":14139,"_27008":114927,"_2880":114974},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3394":69092,"_29710":69075,"_20617":114976,"_5":14139,"_27008":114927,"_2880":114977},[],"esa dirección está asignada a este Gateway",{"_3394":69093,"_29710":69075,"_20617":114979,"_5":14139,"_27008":114927,"_2880":114980},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3394":69094,"_29710":69075,"_20617":114982,"_5":14139,"_27008":114927,"_2880":114983},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3394":69095,"_29710":69075,"_20617":114985,"_5":14139,"_27008":114927,"_2880":114986},[],"No confundas estos valores:",{"_3394":69096,"_29710":69075,"_20617":114988,"_5":14139,"_27008":114927,"_2880":114989},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3394":69097,"_29710":69075,"_20617":114991,"_5":14139,"_27008":114927,"_2880":114992},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3394":69098,"_29710":69075,"_20617":114994,"_5":14139,"_27008":114927,"_2880":114995},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3394":69099,"_29710":69075,"_20617":114997,"_5":14139,"_27008":114931,"_2880":114998},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3394":69100,"_29710":69075,"_20617":115000,"_5":14139,"_27008":114931,"_2880":115001},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3394":69101,"_29710":69075,"_20617":115003,"_5":14139,"_27008":114935,"_2880":115004},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3394":69102,"_29710":69075,"_20617":115006,"_5":14139,"_27008":114935,"_2880":115007},[],"Para el diseño recomendado:",{"_3394":69103,"_29710":69075,"_20617":115009,"_5":14139,"_27008":114935,"_2880":115010},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3394":69104,"_29710":69075,"_20617":115012,"_5":14139,"_27008":114935,"_2880":115013},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3394":69105,"_29710":69075,"_20617":115015,"_5":14139,"_27008":114935,"_2880":115016},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3394":69106,"_29710":69075,"_20617":115018,"_5":14139,"_27008":114935,"_2880":115019},[],"Apunta DNS a la dirección accesible de la VM.",{"_3394":69107,"_29710":69075,"_20617":115021,"_5":14139,"_27008":114935,"_2880":115022},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3394":69108,"_29710":69075,"_20617":115024,"_5":14139,"_27008":114938,"_2880":115025},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3394":69109,"_29710":69075,"_20617":115027,"_5":14139,"_27008":114942,"_2880":115028},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3394":69110,"_29710":69075,"_20617":115030,"_5":14139,"_27008":114942,"_2880":115031},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3394":69111,"_29710":69075,"_20617":115033,"_5":14139,"_27008":114946,"_2880":115034},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3394":69112,"_29710":69075,"_20617":115036,"_5":14139,"_27008":114946,"_2880":115037},[],"Requisito",{"_3394":69113,"_29710":69075,"_20617":115039,"_5":14139,"_27008":114946,"_2880":115040},[],"Diseño recomendado",{"_3394":69114,"_29710":69075,"_20617":115042,"_5":14139,"_27008":114946,"_2880":115043},[],"Consecuencia",{"_3394":69115,"_29710":69075,"_20617":115045,"_5":14139,"_27008":114946,"_2880":115046},[],"Varias URL o servicios de Lamassu",{"_3394":69116,"_29710":69075,"_20617":115048,"_5":14139,"_27008":114946,"_2880":115049},[],"Un Gateway con varias rutas",{"_3394":69117,"_29710":69075,"_20617":115051,"_5":14139,"_27008":114946,"_2880":115052},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3394":69118,"_29710":69075,"_20617":115054,"_5":14139,"_27008":114946,"_2880":115055},[],"Gateways independientes e IP externas distintas",{"_3394":69119,"_29710":69075,"_20617":115057,"_5":14139,"_27008":114946,"_2880":115058},[],"Una VIP por Gateway",{"_3394":69120,"_29710":69075,"_20617":115060,"_5":14139,"_27008":114946,"_2880":115061},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3394":69121,"_29710":69075,"_20617":115063,"_5":14139,"_27008":114946,"_2880":115064},[],"Gateways independientes, un nodo y una IP",{"_3394":69122,"_29710":69075,"_20617":115066,"_5":14139,"_27008":114946,"_2880":115067},[],"Puertos externos diferentes",{"_3394":69123,"_29710":69075,"_20617":115069,"_5":14139,"_27008":114946,"_2880":115070},[],"Los clientes deben indicar puertos no estándar",{"_3394":69124,"_29710":69075,"_20617":115072,"_5":14139,"_27008":114946,"_2880":115073},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3394":69125,"_29710":69075,"_20617":115075,"_5":14139,"_27008":114946,"_2880":115076},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3394":69126,"_29710":69075,"_20617":115078,"_5":14139,"_27008":114946,"_2880":115079},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3394":69127,"_29710":69075,"_20617":115081,"_5":14139,"_27008":114946,"_2880":115082},[],"Recursos Gateway separados pero proxy compartido",{"_3394":69128,"_29710":69075,"_20617":115084,"_5":14139,"_27008":114946,"_2880":115085},[],"Modo merged Gateway de Envoy",{"_3394":69129,"_29710":69075,"_20617":115087,"_5":14139,"_27008":114946,"_2880":115088},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3394":69130,"_29710":69075,"_20617":115090,"_5":14139,"_27008":114946,"_2880":115091},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3394":69131,"_29710":69075,"_20617":115093,"_5":14139,"_27008":114946,"_2880":115094},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3394":69132,"_29710":69075,"_20617":115096,"_5":14139,"_27008":114946,"_2880":115097},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3394":69133,"_29710":69075,"_20617":115099,"_5":14139,"_27008":114946,"_2880":115100},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3394":69134,"_29710":69075,"_20617":115102,"_5":14139,"_27008":114950,"_2880":115103},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3394":69135,"_29710":69075,"_20617":115105,"_5":14139,"_27008":114950,"_2880":115106},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3394":69136,"_29710":69075,"_20617":115108,"_5":14139,"_27008":114950,"_2880":115109},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3394":69137,"_29710":69075,"_20617":115111,"_5":14139,"_27008":114950,"_2880":115112},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3394":69138,"_29710":69075,"_20617":115114,"_5":14139,"_27008":114950,"_2880":115115},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3394":69139,"_29710":69075,"_20617":115117,"_5":14139,"_27008":114954,"_2880":115118},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3394":69140,"_29710":69075,"_20617":115120,"_5":14139,"_27008":114954,"_2880":115121},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3394":69141,"_29710":69075,"_20617":115123,"_5":14139,"_27008":114958,"_2880":115124},[],"Comprueba, en orden:",{"_3394":69142,"_29710":69075,"_20617":115126,"_5":14139,"_27008":114958,"_2880":115127},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3394":69143,"_29710":69075,"_20617":115129,"_5":14139,"_27008":114958,"_2880":115130},[],"Su estado contiene la dirección esperada.",{"_3394":69144,"_29710":69075,"_20617":115132,"_5":14139,"_27008":114958,"_2880":115133},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3394":69145,"_29710":69075,"_20617":115135,"_5":14139,"_27008":114958,"_2880":115136},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3394":69146,"_29710":69075,"_20617":115138,"_5":14139,"_27008":114958,"_2880":115139},[],"DNS resuelve al endpoint accesible externamente.",{"_3394":69147,"_29710":69075,"_20617":115141,"_5":14139,"_27008":114958,"_2880":115142},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3394":69148,"_29710":69075,"_20617":115144,"_5":14139,"_27008":114958,"_2880":115145},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3394":69149,"_29710":69149,"_5":14491,"_2880":48508,"_30063":115147,"_20617":115148,"_27008":69149},[48401,114144,114378],[],{"_3394":69150,"_29710":69149,"_20617":115150,"_5":14139,"_27008":69149,"_2880":115151},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3394":69151,"_29710":69149,"_5":30060,"_20617":115153,"_27008":115154,"_2880":115155},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3394":69152,"_29710":69149,"_5":30060,"_20617":115157,"_27008":115158,"_2880":115159},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3394":69153,"_29710":69149,"_5":30060,"_20617":115161,"_27008":115162,"_2880":115163},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3394":69154,"_29710":69149,"_5":30060,"_20617":115165,"_27008":115166,"_2880":115167},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3394":69155,"_29710":69149,"_5":30060,"_20617":115169,"_27008":115170,"_2880":115171},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3394":69156,"_29710":69149,"_5":30060,"_20617":115173,"_27008":115174,"_2880":115175},[],"/docs/pr-preview/pr-59/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3394":69157,"_29710":69149,"_20617":115177,"_5":14139,"_27008":115154,"_2880":115178},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3394":69158,"_29710":69149,"_20617":115180,"_5":14139,"_27008":115158,"_2880":115181},[],"Flujo",{"_3394":69159,"_29710":69149,"_20617":115183,"_5":14139,"_27008":115158,"_2880":115184},[],"Úsalo para",{"_3394":69160,"_29710":69149,"_20617":115186,"_5":14139,"_27008":115158,"_2880":115187},[],"Qué instala",{"_3394":69161,"_29710":69149,"_20617":115189,"_5":14139,"_27008":115158,"_2880":49482},[],{"_3394":69162,"_29710":69149,"_20617":115191,"_5":14139,"_27008":115158,"_2880":115192},[],"Producción y entornos controlados",{"_3394":69163,"_29710":69149,"_20617":115194,"_5":14139,"_27008":115158,"_2880":115195},[],"Servicios de Lamassu y recursos de Gateway API",{"_3394":69164,"_29710":69149,"_20617":115197,"_5":14139,"_27008":115158,"_2880":48645},[],{"_3394":69165,"_29710":69149,"_20617":115199,"_5":14139,"_27008":115158,"_2880":115200},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3394":69166,"_29710":69149,"_20617":115202,"_5":14139,"_27008":115158,"_2880":115203},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3394":69167,"_29710":69149,"_20617":115205,"_5":14139,"_27008":115162,"_2880":115206},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3394":69168,"_29710":69149,"_20617":115208,"_5":14139,"_27008":115162,"_2880":115209},[],"Área",{"_3394":69169,"_29710":69149,"_20617":115211,"_5":14139,"_27008":115162,"_2880":115212},[],"El chart de Lamassu proporciona",{"_3394":69170,"_29710":69149,"_20617":115214,"_5":14139,"_27008":115162,"_2880":115215},[],"Tú proporcionas",{"_3394":69171,"_29710":69149,"_20617":115217,"_5":14139,"_27008":115162,"_2880":115218},[],"Aplicaciones Lamassu",{"_3394":69172,"_29710":69149,"_20617":115220,"_5":14139,"_27008":115162,"_2880":115221},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3394":69173,"_29710":69149,"_20617":115223,"_5":14139,"_27008":115162,"_2880":115224},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3394":69174,"_29710":69149,"_20617":115226,"_5":14139,"_27008":115162,"_2880":115227},[],"Datos PostgreSQL",{"_3394":69175,"_29710":69149,"_20617":115229,"_5":14139,"_27008":115162,"_2880":115230},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3394":69176,"_29710":69149,"_20617":115232,"_5":14139,"_27008":115162,"_2880":115233},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3394":69177,"_29710":69149,"_20617":115235,"_5":14139,"_27008":115162,"_2880":115236},[],"Mensajería",{"_3394":69178,"_29710":69149,"_20617":115238,"_5":14139,"_27008":115162,"_2880":115239},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3394":69179,"_29710":69149,"_20617":115241,"_5":14139,"_27008":115162,"_2880":115242},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3394":69180,"_29710":69149,"_20617":115244,"_5":14139,"_27008":115162,"_2880":115245},[],"Identidad",{"_3394":69181,"_29710":69149,"_20617":115247,"_5":14139,"_27008":115162,"_2880":115248},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3394":69182,"_29710":69149,"_20617":115250,"_5":14139,"_27008":115162,"_2880":115251},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3394":69183,"_29710":69149,"_20617":115253,"_5":14139,"_27008":115162,"_2880":115254},[],"Enrutamiento externo",{"_3394":69184,"_29710":69149,"_20617":115256,"_5":14139,"_27008":115162,"_2880":115257},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3394":69185,"_29710":69149,"_20617":115259,"_5":14139,"_27008":115162,"_2880":115260},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3394":69186,"_29710":69149,"_20617":115262,"_5":14139,"_27008":115162,"_2880":49556},[],{"_3394":69187,"_29710":69149,"_20617":115264,"_5":14139,"_27008":115162,"_2880":115265},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3394":69188,"_29710":69149,"_20617":115267,"_5":14139,"_27008":115162,"_2880":115268},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3394":69189,"_29710":69149,"_20617":115270,"_5":14139,"_27008":115162,"_2880":115271},[],"Datos persistentes de la aplicación",{"_3394":69190,"_29710":69149,"_20617":115273,"_5":14139,"_27008":115162,"_2880":115274},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3394":69191,"_29710":69149,"_20617":115276,"_5":14139,"_27008":115162,"_2880":115277},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3394":69192,"_29710":69149,"_20617":115279,"_5":14139,"_27008":115162,"_2880":115280},[],"Integraciones opcionales",{"_3394":69193,"_29710":69149,"_20617":115282,"_5":14139,"_27008":115162,"_2880":115283},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3394":69194,"_29710":69149,"_20617":115285,"_5":14139,"_27008":115162,"_2880":115286},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3394":69195,"_29710":69149,"_20617":115288,"_5":14139,"_27008":115162,"_2880":115289},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3394":69196,"_29710":69149,"_20617":115291,"_5":14139,"_27008":115162,"_2880":115292},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3394":69197,"_29710":69149,"_20617":115294,"_5":14139,"_27008":115166,"_2880":115295},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3394":69198,"_29710":69149,"_20617":115297,"_5":14139,"_27008":115166,"_2880":115298},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3394":69199,"_29710":69149,"_20617":115300,"_5":14139,"_27008":115170,"_2880":115301},[],"Kubernetes 1.24 o posterior",{"_3394":69200,"_29710":69149,"_20617":115303,"_5":14139,"_27008":115170,"_2880":115304},[],"Helm 3.2 o posterior",{"_3394":69201,"_29710":69149,"_20617":115306,"_5":14139,"_27008":115170,"_2880":115307},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3394":69202,"_29710":69149,"_20617":115309,"_5":14139,"_27008":115170,"_2880":115310},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3394":69203,"_29710":69149,"_20617":115312,"_5":14139,"_27008":115170,"_2880":115313},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3394":69204,"_29710":69149,"_20617":115315,"_5":14139,"_27008":115170,"_2880":115316},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3394":69205,"_29710":69149,"_20617":115318,"_5":14139,"_27008":115170,"_2880":115319},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3394":69206,"_29710":69149,"_20617":115321,"_5":14139,"_27008":115174,"_2880":115322},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3394":69207,"_29710":69149,"_20617":115324,"_5":14139,"_27008":115174,"_2880":115325},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3394":69208,"_29710":69149,"_20617":115327,"_5":14139,"_27008":115174,"_2880":115328},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3394":69209,"_29710":69149,"_20617":115330,"_5":14139,"_27008":115174,"_2880":115331},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3394":69210,"_29710":69210,"_5":14491,"_2880":115333,"_30063":115334,"_20617":115336,"_27008":69210},"Resolución de problemas de despliegue",[48401,114144,115335],"Operación",[],{"_3394":69211,"_29710":69210,"_20617":115338,"_5":14139,"_27008":69210,"_2880":115339},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3394":69212,"_29710":69210,"_5":30060,"_20617":115341,"_27008":115342,"_2880":115343},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3394":69213,"_29710":69210,"_5":30060,"_20617":115345,"_27008":115346,"_2880":115347},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3394":69214,"_29710":69210,"_5":30060,"_20617":115349,"_27008":115350,"_2880":115351},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3394":69215,"_29710":69210,"_5":30060,"_20617":115353,"_27008":115354,"_2880":115355},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3394":69216,"_29710":69210,"_5":30060,"_20617":115357,"_27008":115358,"_2880":115359},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3394":69217,"_29710":69210,"_5":30060,"_20617":115361,"_27008":115362,"_2880":115363},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3394":69218,"_29710":69210,"_5":30060,"_20617":115365,"_27008":115366,"_2880":115367},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3394":69219,"_29710":69210,"_5":30060,"_20617":115369,"_27008":115370,"_2880":115371},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3394":69220,"_29710":69210,"_5":30060,"_20617":115373,"_27008":115374,"_2880":115375},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3394":69221,"_29710":69210,"_5":30060,"_20617":115377,"_27008":115378,"_2880":115379},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3394":69222,"_29710":69210,"_5":30060,"_20617":115381,"_27008":115382,"_2880":115383},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3394":69223,"_29710":69210,"_5":30060,"_20617":115385,"_27008":115386,"_2880":115387},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3394":69224,"_29710":69210,"_5":30060,"_20617":115389,"_27008":115390,"_2880":115391},[],"/docs/pr-preview/pr-59/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3394":69225,"_29710":69210,"_20617":115393,"_5":14139,"_27008":69210,"_2880":115394},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3394":69226,"_29710":69210,"_20617":115396,"_5":14139,"_27008":115346,"_2880":115397},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3394":69227,"_29710":69210,"_20617":115399,"_5":14139,"_27008":115350,"_2880":115400},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3394":69228,"_29710":69210,"_20617":115402,"_5":14139,"_27008":115354,"_2880":115403},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3394":69229,"_29710":69210,"_20617":115405,"_5":14139,"_27008":115358,"_2880":115406},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3394":69230,"_29710":69210,"_20617":115408,"_5":14139,"_27008":115362,"_2880":115409},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3394":69231,"_29710":69210,"_20617":115411,"_5":14139,"_27008":115366,"_2880":115412},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3394":69232,"_29710":69210,"_20617":115414,"_5":14139,"_27008":115366,"_2880":115415},[],"Ejecuta también la prueba de conectividad del chart:",{"_3394":69233,"_29710":69210,"_20617":115417,"_5":14139,"_27008":115366,"_2880":115418},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3394":69234,"_29710":69210,"_20617":115420,"_5":14139,"_27008":115366,"_2880":115421},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3394":69235,"_29710":69210,"_20617":115423,"_5":14139,"_27008":115370,"_2880":115424},[],"Si recibes un 401:",{"_3394":69236,"_29710":69210,"_20617":115426,"_5":14139,"_27008":115370,"_2880":115427},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3394":69237,"_29710":69210,"_20617":115429,"_5":14139,"_27008":115370,"_2880":115430},[],"verifica emisor, audiencia y expiración del token;",{"_3394":69238,"_29710":69210,"_20617":115432,"_5":14139,"_27008":115370,"_2880":115433},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3394":69239,"_29710":69210,"_20617":115435,"_5":14139,"_27008":115370,"_2880":115436},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3394":69240,"_29710":69210,"_20617":115438,"_5":14139,"_27008":115370,"_2880":115439},[],"Si el login termina pero las APIs devuelven 403:",{"_3394":69241,"_29710":69210,"_20617":115441,"_5":14139,"_27008":115370,"_2880":115442},[],"inspecciona los claims reales del token;",{"_3394":69242,"_29710":69210,"_20617":115444,"_5":14139,"_27008":115370,"_2880":115445},[],"confirma que coinciden con un principal activo;",{"_3394":69243,"_29710":69210,"_20617":115447,"_5":14139,"_27008":115370,"_2880":115448},[],"revisa las políticas concedidas al principal;",{"_3394":69244,"_29710":69210,"_20617":115450,"_5":14139,"_27008":115370,"_2880":115451},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3394":69245,"_29710":69210,"_20617":115453,"_5":14139,"_27008":115370,"_2880":115454},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3394":69246,"_29710":69210,"_20617":115456,"_5":14139,"_27008":115374,"_2880":115457},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3394":69247,"_29710":69210,"_20617":115459,"_5":14139,"_27008":115374,"_2880":115460},[],"Localiza el pod y Service de authz.",{"_3394":69248,"_29710":69210,"_20617":115462,"_5":14139,"_27008":115374,"_2880":115463},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3394":69249,"_29710":69210,"_20617":115465,"_5":14139,"_27008":115374,"_2880":115466},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3394":69250,"_29710":69210,"_20617":115468,"_5":14139,"_27008":115374,"_2880":115469},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3394":69251,"_29710":69210,"_20617":115471,"_5":14139,"_27008":115374,"_2880":115472},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3394":69252,"_29710":69210,"_20617":115474,"_5":14139,"_27008":115378,"_2880":115475},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3394":69253,"_29710":69210,"_20617":115477,"_5":14139,"_27008":115382,"_2880":115478},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3394":69254,"_29710":69210,"_20617":115480,"_5":14139,"_27008":115382,"_2880":115481},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3394":69255,"_29710":69210,"_20617":115483,"_5":14139,"_27008":115382,"_2880":115484},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3394":69256,"_29710":69210,"_20617":115486,"_5":14139,"_27008":115382,"_2880":115487},[],"volumen persistente sin enlazar;",{"_3394":69257,"_29710":69210,"_20617":115489,"_5":14139,"_27008":115382,"_2880":115490},[],"imagen inaccesible o política de pull incorrecta;",{"_3394":69258,"_29710":69210,"_20617":115492,"_5":14139,"_27008":115382,"_2880":115493},[],"configuración inválida del motor criptográfico;",{"_3394":69259,"_29710":69210,"_20617":115495,"_5":14139,"_27008":115382,"_2880":115496},[],"límites de CPU o memoria demasiado bajos;",{"_3394":69260,"_29710":69210,"_20617":115498,"_5":14139,"_27008":115382,"_2880":115499},[],"migración previa incompleta.",{"_3394":69261,"_29710":69210,"_20617":115501,"_5":14139,"_27008":115382,"_2880":115502},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3394":69262,"_29710":69210,"_20617":115504,"_5":14139,"_27008":115382,"_2880":115505},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3394":69263,"_29710":69210,"_20617":115507,"_5":14139,"_27008":115382,"_2880":115508},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3394":69264,"_29710":69210,"_20617":115510,"_5":14139,"_27008":115386,"_2880":115511},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3394":69265,"_29710":69210,"_20617":115513,"_5":14139,"_27008":115386,"_2880":115514},[],"verifica que esté habilitado en el servicio emisor;",{"_3394":69266,"_29710":69210,"_20617":115516,"_5":14139,"_27008":115386,"_2880":115517},[],"comprueba conectividad y credenciales AMQP;",{"_3394":69267,"_29710":69210,"_20617":115519,"_5":14139,"_27008":115386,"_2880":115520},[],"revisa exchange, routing key, colas y consumidores;",{"_3394":69268,"_29710":69210,"_20617":115522,"_5":14139,"_27008":115386,"_2880":115523},[],"inspecciona dead-letter queues;",{"_3394":69269,"_29710":69210,"_20617":115525,"_5":14139,"_27008":115386,"_2880":115526},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3394":69270,"_29710":69210,"_20617":115528,"_5":14139,"_27008":115386,"_2880":115529},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3394":69271,"_29710":69210,"_20617":115531,"_5":14139,"_27008":115386,"_2880":115532},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3394":69272,"_29710":69210,"_20617":115534,"_5":14139,"_27008":115386,"_2880":115535},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3394":69273,"_29710":69210,"_20617":115537,"_5":14139,"_27008":115386,"_2880":115538},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3394":69274,"_29710":69210,"_20617":115540,"_5":14139,"_27008":115386,"_2880":115541},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3394":69275,"_29710":69210,"_20617":115543,"_5":14139,"_27008":115386,"_2880":115544},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3394":69276,"_29710":69210,"_20617":115546,"_5":14139,"_27008":115386,"_2880":115547},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3394":69277,"_29710":69210,"_20617":115549,"_5":14139,"_27008":115390,"_2880":115550},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3394":69278,"_29710":69210,"_20617":115552,"_5":14139,"_27008":115390,"_2880":115553},[],"Antes de cerrar una incidencia, guarda:",{"_3394":69279,"_29710":69210,"_20617":115555,"_5":14139,"_27008":115390,"_2880":115556},[],"causa confirmada;",{"_3394":69280,"_29710":69210,"_20617":115558,"_5":14139,"_27008":115390,"_2880":115559},[],"alcance temporal y recursos afectados;",{"_3394":69281,"_29710":69210,"_20617":115561,"_5":14139,"_27008":115390,"_2880":115562},[],"comandos o consultas utilizados;",{"_3394":69282,"_29710":69210,"_20617":115564,"_5":14139,"_27008":115390,"_2880":115565},[],"cambio aplicado y forma de revertirlo;",{"_3394":69283,"_29710":69210,"_20617":115567,"_5":14139,"_27008":115390,"_2880":115568},[],"validación desde un consumidor;",{"_3394":69284,"_29710":69210,"_20617":115570,"_5":14139,"_27008":115390,"_2880":115571},[],"acción preventiva y propietario.",{"_3394":69285,"_29710":69285,"_5":14491,"_2880":115573,"_30063":115574,"_20617":115577,"_27008":69285},"Control de acceso",[48401,115575,115576],"Plataforma","Administración",[],{"_3394":69286,"_29710":69285,"_20617":115579,"_5":14139,"_27008":69285,"_2880":115580},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3394":69287,"_29710":69285,"_5":30060,"_20617":115582,"_27008":115583,"_2880":115584},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3394":69288,"_29710":69285,"_5":30060,"_20617":115586,"_27008":115587,"_2880":115588},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3394":69289,"_29710":69285,"_5":30060,"_20617":115590,"_27008":115591,"_2880":115592},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3394":69290,"_29710":69285,"_5":30060,"_20617":115594,"_27008":115595,"_2880":115596},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3394":69291,"_29710":69285,"_5":30060,"_20617":115598,"_27008":115599,"_2880":115600},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3394":69292,"_29710":69285,"_5":30060,"_20617":115602,"_27008":115603,"_2880":115604},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3394":69293,"_29710":69285,"_5":30060,"_20617":115606,"_27008":115607,"_2880":115608},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3394":69294,"_29710":69285,"_5":30060,"_20617":115610,"_27008":115611,"_2880":115612},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3394":69295,"_29710":69285,"_5":30060,"_20617":115614,"_27008":115615,"_2880":115616},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3394":69296,"_29710":69285,"_5":30060,"_20617":115618,"_27008":115619,"_2880":115620},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3394":69297,"_29710":69285,"_5":30060,"_20617":115622,"_27008":115623,"_2880":115624},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3394":69298,"_29710":69285,"_5":30060,"_20617":115626,"_27008":115627,"_2880":115628},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3394":69299,"_29710":69285,"_5":30060,"_20617":115630,"_27008":115631,"_2880":115632},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3394":69300,"_29710":69285,"_5":30060,"_20617":115634,"_27008":115635,"_2880":115636},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3394":69301,"_29710":69285,"_5":30060,"_20617":115638,"_27008":115639,"_2880":115640},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3394":69302,"_29710":69285,"_5":30060,"_20617":115642,"_27008":115643,"_2880":114750},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3394":69303,"_29710":69285,"_5":30060,"_20617":115645,"_27008":115646,"_2880":115647},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3394":69304,"_29710":69285,"_5":30060,"_20617":115649,"_27008":115650,"_2880":115651},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3394":69305,"_29710":69285,"_5":30060,"_20617":115653,"_27008":115654,"_2880":115655},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3394":69306,"_29710":69285,"_5":30060,"_20617":115657,"_27008":115658,"_2880":115659},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3394":69307,"_29710":69285,"_5":30060,"_20617":115661,"_27008":115662,"_2880":115663},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3394":69308,"_29710":69285,"_5":30060,"_20617":115665,"_27008":115666,"_2880":115667},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3394":69309,"_29710":69285,"_5":30060,"_20617":115669,"_27008":115670,"_2880":115671},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3394":69310,"_29710":69285,"_5":30060,"_20617":115673,"_27008":115674,"_2880":115675},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3394":69311,"_29710":69285,"_5":30060,"_20617":115677,"_27008":115678,"_2880":115679},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3394":69312,"_29710":69285,"_5":30060,"_20617":115681,"_27008":115682,"_2880":115683},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3394":69313,"_29710":69285,"_5":30060,"_20617":115685,"_27008":115686,"_2880":115687},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3394":69314,"_29710":69285,"_5":30060,"_20617":115689,"_27008":115690,"_2880":115691},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3394":69315,"_29710":69285,"_5":30060,"_20617":115693,"_27008":115694,"_2880":115695},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3394":69316,"_29710":69285,"_5":30060,"_20617":115697,"_27008":115698,"_2880":115699},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3394":69317,"_29710":69285,"_5":30060,"_20617":115701,"_27008":115702,"_2880":115703},[],"/docs/pr-preview/pr-59/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3394":69318,"_29710":69285,"_20617":115705,"_5":14139,"_27008":69285,"_2880":115706},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3394":69319,"_29710":69285,"_20617":115708,"_5":14139,"_27008":69285,"_2880":115709},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3394":69320,"_29710":69285,"_20617":115711,"_5":14139,"_27008":69285,"_2880":115712},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3394":69321,"_29710":69285,"_20617":115714,"_5":14139,"_27008":115583,"_2880":115715},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3394":69322,"_29710":69285,"_20617":115717,"_5":14139,"_27008":115583,"_2880":115718},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3394":69323,"_29710":69285,"_20617":115720,"_5":14139,"_27008":115583,"_2880":115721},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3394":69324,"_29710":69285,"_20617":115723,"_5":14139,"_27008":115583,"_2880":115724},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3394":69325,"_29710":69285,"_20617":115726,"_5":14139,"_27008":115583,"_2880":115727},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3394":69326,"_29710":69285,"_20617":115729,"_5":14139,"_27008":115583,"_2880":115730},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3394":69327,"_29710":69285,"_20617":115732,"_5":14139,"_27008":115587,"_2880":115733},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3394":69328,"_29710":69285,"_20617":115735,"_5":14139,"_27008":115587,"_2880":115736},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3394":69329,"_29710":69285,"_20617":115738,"_5":14139,"_27008":115591,"_2880":115739},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3394":69330,"_29710":69285,"_20617":115741,"_5":14139,"_27008":115591,"_2880":115742},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3394":69331,"_29710":69285,"_20617":115744,"_5":14139,"_27008":115591,"_2880":115745},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3394":69332,"_29710":69285,"_20617":115747,"_5":14139,"_27008":115591,"_2880":115748},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3394":69333,"_29710":69285,"_20617":115750,"_5":14139,"_27008":115591,"_2880":115751},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3394":69334,"_29710":69285,"_20617":115753,"_5":14139,"_27008":115591,"_2880":115754},[],"Carga por separado las políticas concedidas a cada principal.",{"_3394":69335,"_29710":69285,"_20617":115756,"_5":14139,"_27008":115591,"_2880":115757},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3394":69336,"_29710":69285,"_20617":115759,"_5":14139,"_27008":115591,"_2880":115760},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3394":69337,"_29710":69285,"_20617":115762,"_5":14139,"_27008":115591,"_2880":115763},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3394":69338,"_29710":69285,"_20617":115765,"_5":14139,"_27008":115591,"_2880":115766},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3394":69339,"_29710":69285,"_20617":115768,"_5":14139,"_27008":115591,"_2880":115769},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3394":69340,"_29710":69285,"_20617":115771,"_5":14139,"_27008":115591,"_2880":115772},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3394":69341,"_29710":69285,"_20617":115774,"_5":14139,"_27008":115595,"_2880":115775},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3394":69342,"_29710":69285,"_20617":115777,"_5":14139,"_27008":115595,"_2880":115778},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3394":69343,"_29710":69285,"_20617":115780,"_5":14139,"_27008":115595,"_2880":115781},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3394":69344,"_29710":69285,"_20617":115783,"_5":14139,"_27008":115595,"_2880":115784},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3394":69345,"_29710":69285,"_20617":115786,"_5":14139,"_27008":115595,"_2880":115787},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3394":69346,"_29710":69285,"_20617":115789,"_5":14139,"_27008":115595,"_2880":115790},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3394":69347,"_29710":69285,"_20617":115792,"_5":14139,"_27008":115595,"_2880":115793},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3394":69348,"_29710":69285,"_20617":115795,"_5":14139,"_27008":115595,"_2880":115796},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3394":69349,"_29710":69285,"_20617":115798,"_5":14139,"_27008":115599,"_2880":115799},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3394":69350,"_29710":69285,"_20617":115801,"_5":14139,"_27008":115599,"_2880":115802},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3394":69351,"_29710":69285,"_20617":115804,"_5":14139,"_27008":115599,"_2880":115805},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3394":69352,"_29710":69285,"_20617":115807,"_5":14139,"_27008":115599,"_2880":115808},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3394":69353,"_29710":69285,"_20617":115810,"_5":14139,"_27008":115599,"_2880":115811},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3394":69354,"_29710":69285,"_20617":115813,"_5":14139,"_27008":115599,"_2880":115814},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3394":69355,"_29710":69285,"_20617":115816,"_5":14139,"_27008":115599,"_2880":115817},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3394":69356,"_29710":69285,"_20617":115819,"_5":14139,"_27008":115599,"_2880":115820},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3394":69357,"_29710":69285,"_20617":115822,"_5":14139,"_27008":115599,"_2880":115823},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3394":69358,"_29710":69285,"_20617":115825,"_5":14139,"_27008":115599,"_2880":115826},[],"Las acciones se dividen en dos grupos:",{"_3394":69359,"_29710":69285,"_20617":115828,"_5":14139,"_27008":115599,"_2880":115829},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3394":69360,"_29710":69285,"_20617":115831,"_5":14139,"_27008":115599,"_2880":115832},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3394":69361,"_29710":69285,"_20617":115834,"_5":14139,"_27008":115599,"_2880":115835},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3394":69362,"_29710":69285,"_20617":115837,"_5":14139,"_27008":115603,"_2880":115838},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3394":69363,"_29710":69285,"_20617":115840,"_5":14139,"_27008":115603,"_2880":115841},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3394":69364,"_29710":69285,"_20617":115843,"_5":14139,"_27008":115603,"_2880":115844},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3394":69365,"_29710":69285,"_20617":115846,"_5":14139,"_27008":115607,"_2880":115847},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3394":69366,"_29710":69285,"_20617":115849,"_5":14139,"_27008":115607,"_2880":115850},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3394":69367,"_29710":69285,"_20617":115852,"_5":14139,"_27008":115607,"_2880":115853},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3394":69368,"_29710":69285,"_20617":115855,"_5":14139,"_27008":115607,"_2880":115856},[],"Los operadores implementados son:",{"_3394":69369,"_29710":69285,"_20617":115858,"_5":14139,"_27008":115607,"_2880":115859},[],"`equals`, para igualdad exacta;",{"_3394":69370,"_29710":69285,"_20617":115861,"_5":14139,"_27008":115607,"_2880":115862},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3394":69371,"_29710":69285,"_20617":115864,"_5":14139,"_27008":115607,"_2880":115865},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3394":69372,"_29710":69285,"_20617":115867,"_5":14139,"_27008":115607,"_2880":115868},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3394":69373,"_29710":69285,"_20617":115870,"_5":14139,"_27008":115611,"_2880":115871},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3394":69374,"_29710":69285,"_20617":115873,"_5":14139,"_27008":115611,"_2880":115874},[],"Los modos disponibles son:",{"_3394":69375,"_29710":69285,"_20617":115876,"_5":14139,"_27008":115611,"_2880":115877},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3394":69376,"_29710":69285,"_20617":115879,"_5":14139,"_27008":115611,"_2880":115880},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3394":69377,"_29710":69285,"_20617":115882,"_5":14139,"_27008":115611,"_2880":115883},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3394":69378,"_29710":69285,"_20617":115885,"_5":14139,"_27008":115611,"_2880":115886},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3394":69379,"_29710":69285,"_20617":115888,"_5":14139,"_27008":115611,"_2880":115889},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3394":69380,"_29710":69285,"_20617":115891,"_5":14139,"_27008":115611,"_2880":115892},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3394":69381,"_29710":69285,"_20617":115894,"_5":14139,"_27008":115615,"_2880":115895},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3394":69382,"_29710":69285,"_20617":115897,"_5":14139,"_27008":115615,"_2880":115898},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3394":69383,"_29710":69285,"_20617":115900,"_5":14139,"_27008":115615,"_2880":115901},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3394":69384,"_29710":69285,"_20617":115903,"_5":14139,"_27008":115615,"_2880":115904},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3394":69385,"_29710":69285,"_20617":115906,"_5":14139,"_27008":115623,"_2880":115907},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3394":69386,"_29710":69285,"_20617":115909,"_5":14139,"_27008":115623,"_2880":115910},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3394":69387,"_29710":69285,"_20617":115912,"_5":14139,"_27008":115627,"_2880":115913},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3394":69388,"_29710":69285,"_20617":115915,"_5":14139,"_27008":115627,"_2880":115916},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3394":69389,"_29710":69285,"_20617":115918,"_5":14139,"_27008":115631,"_2880":115919},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3394":69390,"_29710":69285,"_20617":115921,"_5":14139,"_27008":115631,"_2880":115922},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3394":69391,"_29710":69285,"_20617":115924,"_5":14139,"_27008":115631,"_2880":115925},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3394":69392,"_29710":69285,"_20617":115927,"_5":14139,"_27008":115635,"_2880":115928},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3394":69393,"_29710":69285,"_20617":115930,"_5":14139,"_27008":115635,"_2880":115931},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3394":69394,"_29710":69285,"_20617":115933,"_5":14139,"_27008":115635,"_2880":115934},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3394":69395,"_29710":69285,"_20617":115936,"_5":14139,"_27008":115635,"_2880":115937},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3394":69396,"_29710":69285,"_20617":115939,"_5":14139,"_27008":115635,"_2880":115940},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3394":69397,"_29710":69285,"_20617":115942,"_5":14139,"_27008":115635,"_2880":115943},[],"Ten en cuenta que:",{"_3394":69398,"_29710":69285,"_20617":115945,"_5":14139,"_27008":115635,"_2880":115946},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3394":69399,"_29710":69285,"_20617":115948,"_5":14139,"_27008":115635,"_2880":115949},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3394":69400,"_29710":69285,"_20617":115951,"_5":14139,"_27008":115635,"_2880":115952},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3394":69401,"_29710":69285,"_20617":115954,"_5":14139,"_27008":115639,"_2880":115955},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3394":69402,"_29710":69285,"_20617":115957,"_5":14139,"_27008":115639,"_2880":115958},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3394":69403,"_29710":69285,"_20617":115960,"_5":14139,"_27008":115639,"_2880":115961},[],"acceso completo y de solo lectura a KMS;",{"_3394":69404,"_29710":69285,"_20617":115963,"_5":14139,"_27008":115639,"_2880":115964},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3394":69405,"_29710":69285,"_20617":115966,"_5":14139,"_27008":115639,"_2880":115967},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3394":69406,"_29710":69285,"_20617":115969,"_5":14139,"_27008":115639,"_2880":115970},[],"acceso a la interfaz;",{"_3394":69407,"_29710":69285,"_20617":115972,"_5":14139,"_27008":115639,"_2880":115973},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3394":69408,"_29710":69285,"_20617":115975,"_5":14139,"_27008":115639,"_2880":115976},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3394":69409,"_29710":69285,"_20617":115978,"_5":14139,"_27008":115639,"_2880":115979},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3394":69410,"_29710":69285,"_20617":115981,"_5":14139,"_27008":115643,"_2880":115982},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3394":69411,"_29710":69285,"_20617":115984,"_5":14139,"_27008":115643,"_2880":115985},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3394":69412,"_29710":69285,"_20617":115987,"_5":14139,"_27008":115643,"_2880":115988},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3394":69413,"_29710":69285,"_20617":115990,"_5":14139,"_27008":115646,"_2880":115991},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3394":69414,"_29710":69285,"_20617":115993,"_5":14139,"_27008":115650,"_2880":115994},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3394":69415,"_29710":69285,"_20617":115996,"_5":14139,"_27008":115650,"_2880":115997},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3394":69416,"_29710":69285,"_20617":115999,"_5":14139,"_27008":115654,"_2880":116000},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3394":69417,"_29710":69285,"_20617":116002,"_5":14139,"_27008":115658,"_2880":116003},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3394":69418,"_29710":69285,"_20617":116005,"_5":14139,"_27008":115662,"_2880":116006},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3394":69419,"_29710":69285,"_20617":116008,"_5":14139,"_27008":115666,"_2880":116009},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3394":69420,"_29710":69285,"_20617":116011,"_5":14139,"_27008":115666,"_2880":116012},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3394":69421,"_29710":69285,"_20617":116014,"_5":14139,"_27008":115670,"_2880":116015},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3394":69422,"_29710":69285,"_20617":116017,"_5":14139,"_27008":115670,"_2880":116018},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3394":69423,"_29710":69285,"_20617":116020,"_5":14139,"_27008":115670,"_2880":116021},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3394":69424,"_29710":69285,"_20617":116023,"_5":14139,"_27008":115670,"_2880":116024},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3394":69425,"_29710":69285,"_20617":116026,"_5":14139,"_27008":115670,"_2880":116027},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3394":69426,"_29710":69285,"_20617":116029,"_5":14139,"_27008":115670,"_2880":116030},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3394":69427,"_29710":69285,"_20617":116032,"_5":14139,"_27008":115670,"_2880":116033},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3394":69428,"_29710":69285,"_20617":116035,"_5":14139,"_27008":115670,"_2880":116036},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3394":69429,"_29710":69285,"_20617":116038,"_5":14139,"_27008":115674,"_2880":116039},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3394":69430,"_29710":69285,"_20617":116041,"_5":14139,"_27008":115674,"_2880":116042},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3394":69431,"_29710":69285,"_20617":116044,"_5":14139,"_27008":115674,"_2880":116045},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3394":69432,"_29710":69285,"_20617":116047,"_5":14139,"_27008":115678,"_2880":116048},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3394":69433,"_29710":69285,"_20617":116050,"_5":14139,"_27008":115678,"_2880":116051},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3394":69434,"_29710":69285,"_20617":116053,"_5":14139,"_27008":115678,"_2880":116054},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3394":69435,"_29710":69285,"_20617":116056,"_5":14139,"_27008":115678,"_2880":116057},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3394":69436,"_29710":69285,"_20617":116059,"_5":14139,"_27008":115678,"_2880":116060},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3394":69437,"_29710":69285,"_20617":116062,"_5":14139,"_27008":115678,"_2880":116063},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3394":69438,"_29710":69285,"_20617":116065,"_5":14139,"_27008":115678,"_2880":116066},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3394":69439,"_29710":69285,"_20617":116068,"_5":14139,"_27008":115678,"_2880":116069},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3394":69440,"_29710":69285,"_20617":116071,"_5":14139,"_27008":115686,"_2880":116072},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3394":69441,"_29710":69285,"_20617":116074,"_5":14139,"_27008":115690,"_2880":116075},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3394":69442,"_29710":69285,"_20617":116077,"_5":14139,"_27008":115690,"_2880":116078},[],"que exista un principal activo del tipo correcto;",{"_3394":69443,"_29710":69285,"_20617":116080,"_5":14139,"_27008":115690,"_2880":116081},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3394":69444,"_29710":69285,"_20617":116083,"_5":14139,"_27008":115690,"_2880":116084},[],"que todas las condiciones del principal se cumplan;",{"_3394":69445,"_29710":69285,"_20617":116086,"_5":14139,"_27008":115690,"_2880":116087},[],"que el principal tenga concedida la política esperada;",{"_3394":69446,"_29710":69285,"_20617":116089,"_5":14139,"_27008":115690,"_2880":116090},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3394":69447,"_29710":69285,"_20617":116092,"_5":14139,"_27008":115690,"_2880":116093},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3394":69448,"_29710":69285,"_20617":116095,"_5":14139,"_27008":115690,"_2880":116096},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3394":69449,"_29710":69285,"_20617":116098,"_5":14139,"_27008":115694,"_2880":116099},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3394":69450,"_29710":69285,"_20617":116101,"_5":14139,"_27008":115698,"_2880":116102},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3394":69451,"_29710":69285,"_20617":116104,"_5":14139,"_27008":115702,"_2880":116105},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3394":69452,"_29710":69285,"_20617":116107,"_5":14139,"_27008":115702,"_2880":116108},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3394":69453,"_29710":69453,"_5":14491,"_2880":116110,"_30063":116111,"_20617":116112,"_27008":69453},"Alertas y suscripciones",[48401,115575,115576],[],{"_3394":69454,"_29710":69453,"_20617":116114,"_5":14139,"_27008":69453,"_2880":116115},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3394":69455,"_29710":69453,"_5":30060,"_20617":116117,"_27008":116118,"_2880":116119},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3394":69456,"_29710":69453,"_5":30060,"_20617":116121,"_27008":116122,"_2880":116123},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3394":69457,"_29710":69453,"_5":30060,"_20617":116125,"_27008":116126,"_2880":116127},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3394":69458,"_29710":69453,"_5":30060,"_20617":116129,"_27008":116130,"_2880":116131},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3394":69459,"_29710":69453,"_5":30060,"_20617":116133,"_27008":116134,"_2880":116135},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3394":69460,"_29710":69453,"_5":30060,"_20617":116137,"_27008":116138,"_2880":116139},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3394":69461,"_29710":69453,"_5":30060,"_20617":116141,"_27008":116142,"_2880":116143},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3394":69462,"_29710":69453,"_5":30060,"_20617":116145,"_27008":116146,"_2880":116147},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3394":69463,"_29710":69453,"_5":30060,"_20617":116149,"_27008":116150,"_2880":116151},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3394":69464,"_29710":69453,"_5":30060,"_20617":116153,"_27008":116154,"_2880":116155},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3394":69465,"_29710":69453,"_5":30060,"_20617":116157,"_27008":116158,"_2880":116159},[],"/docs/pr-preview/pr-59/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3394":69466,"_29710":69453,"_20617":116161,"_5":14139,"_27008":69453,"_2880":116162},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3394":69467,"_29710":69453,"_20617":116164,"_5":14139,"_27008":116118,"_2880":116165},[],"Un servicio publica un evento de dominio.",{"_3394":69468,"_29710":69453,"_20617":116167,"_5":14139,"_27008":116118,"_2880":116168},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3394":69469,"_29710":69453,"_20617":116170,"_5":14139,"_27008":116118,"_2880":116171},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3394":69470,"_29710":69453,"_20617":116173,"_5":14139,"_27008":116118,"_2880":116174},[],"Lamassu entrega el evento al canal configurado.",{"_3394":69471,"_29710":69453,"_20617":116176,"_5":14139,"_27008":116118,"_2880":116177},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3394":69472,"_29710":69453,"_20617":116179,"_5":14139,"_27008":116122,"_2880":116180},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3394":69473,"_29710":69453,"_20617":116182,"_5":14139,"_27008":116122,"_2880":116183},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3394":69474,"_29710":69453,"_20617":116185,"_5":14139,"_27008":116122,"_2880":116186},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3394":69475,"_29710":69453,"_20617":116188,"_5":14139,"_27008":116122,"_2880":116189},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3394":69476,"_29710":69453,"_20617":116191,"_5":14139,"_27008":116122,"_2880":116192},[],"`apikey_options` necesita `header` y `key`.",{"_3394":69477,"_29710":69453,"_20617":116194,"_5":14139,"_27008":116122,"_2880":116195},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3394":69478,"_29710":69453,"_20617":116197,"_5":14139,"_27008":116122,"_2880":116198},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3394":69479,"_29710":69453,"_20617":116200,"_5":14139,"_27008":116122,"_2880":116201},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3394":69480,"_29710":69453,"_20617":116203,"_5":14139,"_27008":116130,"_2880":116204},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3394":69481,"_29710":69453,"_20617":116206,"_5":14139,"_27008":116134,"_2880":116207},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3394":69482,"_29710":69453,"_20617":116209,"_5":14139,"_27008":116138,"_2880":116210},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3394":69483,"_29710":69453,"_20617":116212,"_5":14139,"_27008":116138,"_2880":116213},[],"**None** notifica todas las instancias del evento.",{"_3394":69484,"_29710":69453,"_20617":116215,"_5":14139,"_27008":116138,"_2880":116216},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3394":69485,"_29710":69453,"_20617":116218,"_5":14139,"_27008":116138,"_2880":116219},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3394":69486,"_29710":69453,"_20617":116221,"_5":14139,"_27008":116138,"_2880":116222},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3394":69487,"_29710":69453,"_20617":116224,"_5":14139,"_27008":116138,"_2880":116225},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3394":69488,"_29710":69453,"_20617":116227,"_5":14139,"_27008":116138,"_2880":116228},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3394":69489,"_29710":69453,"_20617":116230,"_5":14139,"_27008":116142,"_2880":116231},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3394":69490,"_29710":69453,"_20617":116233,"_5":14139,"_27008":116146,"_2880":116234},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3394":69491,"_29710":69453,"_20617":116236,"_5":14139,"_27008":116146,"_2880":116237},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3394":69492,"_29710":69453,"_20617":116239,"_5":14139,"_27008":116146,"_2880":116240},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3394":69493,"_29710":69453,"_20617":116242,"_5":14139,"_27008":116146,"_2880":116243},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3394":69494,"_29710":69453,"_20617":116245,"_5":14139,"_27008":116146,"_2880":116246},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3394":69495,"_29710":69453,"_20617":116248,"_5":14139,"_27008":116146,"_2880":116249},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3394":69496,"_29710":69453,"_20617":116251,"_5":14139,"_27008":116146,"_2880":116252},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3394":69497,"_29710":69453,"_20617":116254,"_5":14139,"_27008":116146,"_2880":116255},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3394":69498,"_29710":69453,"_20617":116257,"_5":14139,"_27008":116150,"_2880":116258},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3394":69499,"_29710":69453,"_20617":116260,"_5":14139,"_27008":116150,"_2880":116261},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3394":69500,"_29710":69453,"_20617":116263,"_5":14139,"_27008":116150,"_2880":116264},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3394":69501,"_29710":69453,"_20617":116266,"_5":14139,"_27008":116150,"_2880":116267},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3394":69502,"_29710":69453,"_20617":116269,"_5":14139,"_27008":116150,"_2880":116270},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3394":69503,"_29710":69453,"_20617":116272,"_5":14139,"_27008":116150,"_2880":116273},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3394":69504,"_29710":69453,"_20617":116275,"_5":14139,"_27008":116150,"_2880":116276},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3394":69505,"_29710":69453,"_20617":116278,"_5":14139,"_27008":116150,"_2880":116279},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3394":69506,"_29710":69453,"_20617":116281,"_5":14139,"_27008":116154,"_2880":116282},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3394":69507,"_29710":69453,"_20617":116284,"_5":14139,"_27008":116154,"_2880":116285},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3394":69508,"_29710":69453,"_20617":116287,"_5":14139,"_27008":116158,"_2880":116288},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3394":69509,"_29710":69453,"_20617":116290,"_5":14139,"_27008":116158,"_2880":116291},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3394":69510,"_29710":69453,"_20617":116293,"_5":14139,"_27008":116158,"_2880":116294},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3394":69511,"_29710":69453,"_20617":116296,"_5":14139,"_27008":116158,"_2880":116297},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3394":69512,"_29710":69453,"_20617":116299,"_5":14139,"_27008":116158,"_2880":116300},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3394":69513,"_29710":69453,"_20617":116302,"_5":14139,"_27008":116158,"_2880":116303},[],"**Validación:** `va.role.crl.create`.",{"_3394":69514,"_29710":69453,"_20617":116305,"_5":14139,"_27008":116158,"_2880":116306},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3394":69515,"_29710":69453,"_20617":116308,"_5":14139,"_27008":116158,"_2880":116309},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3394":69516,"_29710":69516,"_5":14491,"_2880":116311,"_30063":116312,"_20617":116313,"_27008":69516},"Registros de auditoría",[48401,115575,115576],[],{"_3394":69517,"_29710":69516,"_20617":116315,"_5":14139,"_27008":69516,"_2880":116316},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3394":69518,"_29710":69516,"_5":30060,"_20617":116318,"_27008":116319,"_2880":116320},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3394":69519,"_29710":69516,"_5":30060,"_20617":116322,"_27008":116323,"_2880":116324},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3394":69520,"_29710":69516,"_5":30060,"_20617":116326,"_27008":116327,"_2880":116328},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3394":69521,"_29710":69516,"_5":30060,"_20617":116330,"_27008":116331,"_2880":116332},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3394":69522,"_29710":69516,"_5":30060,"_20617":116334,"_27008":116335,"_2880":116336},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3394":69523,"_29710":69516,"_5":30060,"_20617":116338,"_27008":116339,"_2880":116340},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3394":69524,"_29710":69516,"_5":30060,"_20617":116342,"_27008":116343,"_2880":116344},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3394":69525,"_29710":69516,"_5":30060,"_20617":116346,"_27008":116347,"_2880":116348},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3394":69526,"_29710":69516,"_5":30060,"_20617":116350,"_27008":116351,"_2880":116352},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3394":69527,"_29710":69516,"_5":30060,"_20617":116354,"_27008":116355,"_2880":116356},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3394":69528,"_29710":69516,"_5":30060,"_20617":116358,"_27008":116359,"_2880":116360},[],"/docs/pr-preview/pr-59/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3394":69529,"_29710":69516,"_20617":116362,"_5":14139,"_27008":69516,"_2880":116363},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3394":69530,"_29710":69516,"_20617":116365,"_5":14139,"_27008":116319,"_2880":116366},[],"El cuerpo de auditoría incluye:",{"_3394":69531,"_29710":69516,"_20617":116368,"_5":14139,"_27008":116319,"_2880":116369},[],"input: datos recibidos por la operación;",{"_3394":69532,"_29710":69516,"_20617":116371,"_5":14139,"_27008":116319,"_2880":116372},[],"has\\_error: indica si el servicio devolvió un error;",{"_3394":69533,"_29710":69516,"_20617":116374,"_5":14139,"_27008":116319,"_2880":116375},[],"output: resultado producido o mensaje de error;",{"_3394":69534,"_29710":69516,"_20617":116377,"_5":14139,"_27008":116319,"_2880":116378},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3394":69535,"_29710":69516,"_20617":116380,"_5":14139,"_27008":116319,"_2880":116381},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3394":69536,"_29710":69516,"_20617":116383,"_5":14139,"_27008":116319,"_2880":116384},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3394":69537,"_29710":69516,"_20617":116386,"_5":14139,"_27008":116323,"_2880":116387},[],"El backend aplica auditoría a mutaciones de:",{"_3394":69538,"_29710":69516,"_20617":116389,"_5":14139,"_27008":116323,"_2880":116390},[],"autoridades, certificados y perfiles de emisión;",{"_3394":69539,"_29710":69516,"_20617":116392,"_5":14139,"_27008":116323,"_2880":116393},[],"claves y motores KMS;",{"_3394":69540,"_29710":69516,"_20617":116395,"_5":14139,"_27008":116323,"_2880":116396},[],"dispositivos e identidades;",{"_3394":69541,"_29710":69516,"_20617":116398,"_5":14139,"_27008":116323,"_2880":116399},[],"DMS y operaciones de enrolamiento;",{"_3394":69542,"_29710":69516,"_20617":116401,"_5":14139,"_27008":116323,"_2880":116402},[],"funciones de validación y CRL;",{"_3394":69543,"_29710":69516,"_20617":116404,"_5":14139,"_27008":116323,"_2880":116405},[],"principales, políticas y concesiones de autorización.",{"_3394":69544,"_29710":69516,"_20617":116407,"_5":14139,"_27008":116323,"_2880":116408},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3394":69545,"_29710":69516,"_20617":116410,"_5":14139,"_27008":116327,"_2880":116411},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3394":69546,"_29710":69516,"_20617":116413,"_5":14139,"_27008":116327,"_2880":116414},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3394":69547,"_29710":69516,"_20617":116416,"_5":14139,"_27008":116327,"_2880":116417},[],"Diseña el consumidor para:",{"_3394":69548,"_29710":69516,"_20617":116419,"_5":14139,"_27008":116327,"_2880":116420},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3394":69549,"_29710":69516,"_20617":116422,"_5":14139,"_27008":116327,"_2880":116423},[],"conservar el CloudEvent completo sin modificar;",{"_3394":69550,"_29710":69516,"_20617":116425,"_5":14139,"_27008":116327,"_2880":116426},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3394":69551,"_29710":69516,"_20617":116428,"_5":14139,"_27008":116327,"_2880":116429},[],"cifrar en tránsito y en reposo;",{"_3394":69552,"_29710":69516,"_20617":116431,"_5":14139,"_27008":116327,"_2880":116432},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3394":69553,"_29710":69516,"_20617":116434,"_5":14139,"_27008":116327,"_2880":116435},[],"aplicar una política explícita de retención y legal hold;",{"_3394":69554,"_29710":69516,"_20617":116437,"_5":14139,"_27008":116327,"_2880":116438},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3394":69555,"_29710":69516,"_20617":116440,"_5":14139,"_27008":116331,"_2880":116441},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3394":69556,"_29710":69516,"_20617":116443,"_5":14139,"_27008":116331,"_2880":116444},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3394":69557,"_29710":69516,"_20617":116446,"_5":14139,"_27008":116339,"_2880":116447},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3394":69558,"_29710":69516,"_20617":116449,"_5":14139,"_27008":116343,"_2880":116450},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3394":69559,"_29710":69516,"_20617":116452,"_5":14139,"_27008":116347,"_2880":116453},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3394":69560,"_29710":69516,"_20617":116455,"_5":14139,"_27008":116351,"_2880":116456},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3394":69561,"_29710":69516,"_20617":116458,"_5":14139,"_27008":116355,"_2880":116459},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3394":69562,"_29710":69516,"_20617":116461,"_5":14139,"_27008":116359,"_2880":116462},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3394":69563,"_29710":69516,"_20617":116464,"_5":14139,"_27008":116359,"_2880":116465},[],"aparece un evento de auditoría correcto;",{"_3394":69564,"_29710":69516,"_20617":116467,"_5":14139,"_27008":116359,"_2880":116468},[],"el principal coincide con la identidad utilizada;",{"_3394":69565,"_29710":69516,"_20617":116470,"_5":14139,"_27008":116359,"_2880":116471},[],"el consumidor lo persiste una sola vez;",{"_3394":69566,"_29710":69516,"_20617":116473,"_5":14139,"_27008":116359,"_2880":116474},[],"puede recuperarse por recurso, actor y periodo;",{"_3394":69567,"_29710":69516,"_20617":116476,"_5":14139,"_27008":116359,"_2880":116477},[],"una interrupción del consumidor produce una alerta.",{"_3394":69568,"_29710":69516,"_20617":116479,"_5":14139,"_27008":116359,"_2880":116480},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3394":69569,"_29710":69569,"_5":14491,"_2880":116482,"_30063":116483,"_20617":116484,"_27008":69569},"Arquitectura de la plataforma",[48401,115575],[],{"_3394":69570,"_29710":69569,"_20617":116486,"_5":14139,"_27008":69569,"_2880":116487},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3394":69571,"_29710":69569,"_5":30060,"_20617":116489,"_27008":116490,"_2880":116491},[],"/docs/pr-preview/pr-59/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3394":69572,"_29710":69569,"_5":30060,"_20617":116493,"_27008":116494,"_2880":116495},[],"/docs/pr-preview/pr-59/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3394":69573,"_29710":69569,"_5":30060,"_20617":116497,"_27008":116498,"_2880":116499},[],"/docs/pr-preview/pr-59/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3394":69574,"_29710":69569,"_5":30060,"_20617":116501,"_27008":116502,"_2880":116503},[],"/docs/pr-preview/pr-59/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3394":69575,"_29710":69569,"_5":30060,"_20617":116505,"_27008":116506,"_2880":116507},[],"/docs/pr-preview/pr-59/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3394":69576,"_29710":69569,"_20617":116509,"_5":14139,"_27008":69569,"_2880":116510},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3394":69577,"_29710":69569,"_20617":116512,"_5":14139,"_27008":69569,"_2880":116513},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3394":69578,"_29710":69569,"_20617":116515,"_5":14139,"_27008":116490,"_2880":116516},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3394":69579,"_29710":69569,"_20617":116518,"_5":14139,"_27008":116494,"_2880":116519},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3394":69580,"_29710":69569,"_20617":116521,"_5":14139,"_27008":116498,"_2880":116522},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3394":69581,"_29710":69569,"_20617":116524,"_5":14139,"_27008":116502,"_2880":116525},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3394":69582,"_29710":69569,"_20617":116527,"_5":14139,"_27008":116506,"_2880":116528},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3394":69583,"_29710":69583,"_5":14491,"_2880":116530,"_30063":116531,"_20617":116532,"_27008":69583},"Cómo funciona Lamassu",[48401,115575],[],{"_3394":69584,"_29710":69583,"_20617":116534,"_5":14139,"_27008":69583,"_2880":116535},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3394":69585,"_29710":69583,"_5":30060,"_20617":116537,"_27008":116538,"_2880":116539},[],"/docs/pr-preview/pr-59/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3394":69586,"_29710":69583,"_5":30060,"_20617":116541,"_27008":116542,"_2880":116543},[],"/docs/pr-preview/pr-59/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3394":69587,"_29710":69583,"_20617":116545,"_5":14139,"_27008":69583,"_2880":116546},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3394":69588,"_29710":69583,"_20617":116548,"_5":14139,"_27008":116538,"_2880":116549},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3394":69589,"_29710":69583,"_20617":116551,"_5":14139,"_27008":116538,"_2880":116552},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3394":69590,"_29710":69583,"_20617":116554,"_5":14139,"_27008":116538,"_2880":116555},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3394":69591,"_29710":69583,"_20617":116557,"_5":14139,"_27008":116538,"_2880":116558},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3394":69592,"_29710":69583,"_20617":116560,"_5":14139,"_27008":116538,"_2880":116561},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3394":69593,"_29710":69583,"_20617":116563,"_5":14139,"_27008":116542,"_2880":116564},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3394":69594,"_29710":69583,"_20617":116566,"_5":14139,"_27008":116542,"_2880":116567},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3394":69595,"_29710":69583,"_20617":116569,"_5":14139,"_27008":116542,"_2880":116570},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3394":69596,"_29710":69583,"_20617":116572,"_5":14139,"_27008":116542,"_2880":116573},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3394":69597,"_29710":69583,"_20617":116575,"_5":14139,"_27008":116542,"_2880":116576},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3394":69598,"_29710":69583,"_20617":116578,"_5":14139,"_27008":116542,"_2880":116579},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3394":69599,"_29710":69583,"_20617":116581,"_5":14139,"_27008":116542,"_2880":116582},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3394":69600,"_29710":69600,"_5":14491,"_2880":116584,"_30063":116585,"_20617":116586,"_27008":69600},"Dispositivos e identidades",[48401,115575,50880,116584],[],{"_3394":69601,"_29710":69600,"_20617":116588,"_5":14139,"_27008":69600,"_2880":116589},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3394":69602,"_29710":69600,"_5":30060,"_20617":116591,"_27008":116592,"_2880":116593},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3394":69603,"_29710":69600,"_5":30060,"_20617":116595,"_27008":116596,"_2880":116597},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3394":69604,"_29710":69600,"_5":30060,"_20617":116599,"_27008":116600,"_2880":116601},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3394":69605,"_29710":69600,"_5":30060,"_20617":116603,"_27008":116604,"_2880":116605},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3394":69606,"_29710":69600,"_5":30060,"_20617":116607,"_27008":116608,"_2880":116609},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3394":69607,"_29710":69600,"_5":30060,"_20617":116611,"_27008":116612,"_2880":116613},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3394":69608,"_29710":69600,"_5":30060,"_20617":116615,"_27008":116616,"_2880":116617},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3394":69609,"_29710":69600,"_5":30060,"_20617":116619,"_27008":116620,"_2880":116621},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3394":69610,"_29710":69600,"_5":30060,"_20617":116623,"_27008":116624,"_2880":116625},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3394":69611,"_29710":69600,"_5":30060,"_20617":116627,"_27008":116628,"_2880":116629},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3394":69612,"_29710":69600,"_5":30060,"_20617":116631,"_27008":116632,"_2880":116633},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3394":69613,"_29710":69600,"_20617":116635,"_5":14139,"_27008":69600,"_2880":116636},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3394":69614,"_29710":69600,"_20617":116638,"_5":14139,"_27008":69600,"_2880":116639},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3394":69615,"_29710":69600,"_20617":116641,"_5":14139,"_27008":116592,"_2880":116642},[],"Vista operativa",{"_3394":69616,"_29710":69600,"_20617":116644,"_5":14139,"_27008":116592,"_2880":116645},[],"Interpretación",{"_3394":69617,"_29710":69600,"_20617":116647,"_5":14139,"_27008":116592,"_2880":50943},[],{"_3394":69618,"_29710":69600,"_20617":116649,"_5":14139,"_27008":116592,"_2880":116650},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3394":69619,"_29710":69600,"_20617":116652,"_5":14139,"_27008":116592,"_2880":50949},[],{"_3394":69620,"_29710":69600,"_20617":116654,"_5":14139,"_27008":116592,"_2880":116655},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3394":69621,"_29710":69600,"_20617":116657,"_5":14139,"_27008":116592,"_2880":50955},[],{"_3394":69622,"_29710":69600,"_20617":116659,"_5":14139,"_27008":116592,"_2880":116660},[],"La identidad está en la ventana operativa de renovación.",{"_3394":69623,"_29710":69600,"_20617":116662,"_5":14139,"_27008":116592,"_2880":50961},[],{"_3394":69624,"_29710":69600,"_20617":116664,"_5":14139,"_27008":116592,"_2880":116665},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3394":69625,"_29710":69600,"_20617":116667,"_5":14139,"_27008":116592,"_2880":50967},[],{"_3394":69626,"_29710":69600,"_20617":116669,"_5":14139,"_27008":116592,"_2880":116670},[],"La identidad ha vencido.",{"_3394":69627,"_29710":69600,"_20617":116672,"_5":14139,"_27008":116592,"_2880":50973},[],{"_3394":69628,"_29710":69600,"_20617":116674,"_5":14139,"_27008":116592,"_2880":116675},[],"La identidad está marcada como revocada.",{"_3394":69629,"_29710":69600,"_20617":116677,"_5":14139,"_27008":116592,"_2880":50979},[],{"_3394":69630,"_29710":69600,"_20617":116679,"_5":14139,"_27008":116592,"_2880":116680},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3394":69631,"_29710":69600,"_20617":116682,"_5":14139,"_27008":116592,"_2880":116683},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3394":69632,"_29710":69600,"_20617":116685,"_5":14139,"_27008":116596,"_2880":116686},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3394":69633,"_29710":69600,"_20617":116688,"_5":14139,"_27008":116596,"_2880":116689},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3394":69634,"_29710":69600,"_20617":116691,"_5":14139,"_27008":116596,"_2880":116692},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3394":69635,"_29710":69600,"_20617":116694,"_5":14139,"_27008":116596,"_2880":116695},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3394":69636,"_29710":69600,"_20617":116697,"_5":14139,"_27008":116600,"_2880":116698},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3394":69637,"_29710":69600,"_20617":116700,"_5":14139,"_27008":116604,"_2880":116701},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3394":69638,"_29710":69600,"_20617":116703,"_5":14139,"_27008":116608,"_2880":116704},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3394":69639,"_29710":69600,"_20617":116706,"_5":14139,"_27008":116612,"_2880":116707},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3394":69640,"_29710":69600,"_20617":116709,"_5":14139,"_27008":116616,"_2880":116710},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3394":69641,"_29710":69600,"_20617":116712,"_5":14139,"_27008":116616,"_2880":116713},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3394":69642,"_29710":69600,"_20617":116715,"_5":14139,"_27008":116620,"_2880":116716},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3394":69643,"_29710":69600,"_20617":116718,"_5":14139,"_27008":116620,"_2880":116719},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3394":69644,"_29710":69600,"_20617":116721,"_5":14139,"_27008":116620,"_2880":116722},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3394":69645,"_29710":69600,"_20617":116724,"_5":14139,"_27008":116620,"_2880":116725},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3394":69646,"_29710":69600,"_20617":116727,"_5":14139,"_27008":116620,"_2880":116728},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3394":69647,"_29710":69600,"_20617":116730,"_5":14139,"_27008":116620,"_2880":116731},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3394":69648,"_29710":69600,"_20617":116733,"_5":14139,"_27008":116624,"_2880":116734},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3394":69649,"_29710":69600,"_20617":116736,"_5":14139,"_27008":116624,"_2880":116737},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3394":69650,"_29710":69600,"_20617":116739,"_5":14139,"_27008":116628,"_2880":116740},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3394":69651,"_29710":69600,"_20617":116742,"_5":14139,"_27008":116628,"_2880":116743},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3394":69652,"_29710":69600,"_20617":116745,"_5":14139,"_27008":116628,"_2880":116746},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3394":69653,"_29710":69600,"_20617":116748,"_5":14139,"_27008":116628,"_2880":116749},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3394":69654,"_29710":69600,"_20617":116751,"_5":14139,"_27008":116632,"_2880":116752},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3394":69655,"_29710":69600,"_20617":116754,"_5":14139,"_27008":116632,"_2880":116755},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3394":69656,"_29710":69656,"_5":14491,"_2880":116757,"_30063":116758,"_20617":116760,"_27008":69656},"Identidad inicial y autenticación",[48401,115575,50880,116584,116759],"Enrolamiento con PKI",[],{"_3394":69657,"_29710":69656,"_20617":116762,"_5":14139,"_27008":69656,"_2880":116763},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3394":69658,"_29710":69656,"_5":30060,"_20617":116765,"_27008":116766,"_2880":116767},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3394":69659,"_29710":69656,"_5":30060,"_20617":116769,"_27008":116770,"_2880":116771},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3394":69660,"_29710":69656,"_5":30060,"_20617":116773,"_27008":116774,"_2880":116775},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3394":69661,"_29710":69656,"_5":30060,"_20617":116777,"_27008":116778,"_2880":116779},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3394":69662,"_29710":69656,"_5":30060,"_20617":116781,"_27008":116782,"_2880":116783},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3394":69663,"_29710":69656,"_20617":116785,"_5":14139,"_27008":69656,"_2880":116786},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3394":69664,"_29710":69656,"_20617":116788,"_5":14139,"_27008":116766,"_2880":116789},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3394":69665,"_29710":69656,"_20617":116791,"_5":14139,"_27008":116766,"_2880":116792},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3394":69666,"_29710":69656,"_20617":116794,"_5":14139,"_27008":116770,"_2880":116795},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3394":69667,"_29710":69656,"_20617":116797,"_5":14139,"_27008":116770,"_2880":116798},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3394":69668,"_29710":69656,"_20617":116800,"_5":14139,"_27008":116770,"_2880":116801},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3394":69669,"_29710":69656,"_20617":116803,"_5":14139,"_27008":116774,"_2880":116804},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3394":69670,"_29710":69656,"_20617":116806,"_5":14139,"_27008":116774,"_2880":116807},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3394":69671,"_29710":69656,"_20617":116809,"_5":14139,"_27008":116778,"_2880":116810},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3394":69672,"_29710":69656,"_20617":116812,"_5":14139,"_27008":116778,"_2880":116813},[],"Ejemplo de cuerpo:",{"_3394":69673,"_29710":69656,"_20617":116815,"_5":14139,"_27008":116778,"_2880":116816},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3394":69674,"_29710":69656,"_20617":116818,"_5":14139,"_27008":116778,"_2880":116819},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3394":69675,"_29710":69656,"_20617":116821,"_5":14139,"_27008":116778,"_2880":116822},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3394":69676,"_29710":69656,"_20617":116824,"_5":14139,"_27008":116778,"_2880":116825},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3394":69677,"_29710":69656,"_20617":116827,"_5":14139,"_27008":116782,"_2880":116828},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3394":69678,"_29710":69656,"_20617":116830,"_5":14139,"_27008":116782,"_2880":116831},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3394":69679,"_29710":69679,"_5":14491,"_2880":116833,"_30063":116834,"_20617":116835,"_27008":69679},"Configura y opera el DMS",[48401,115575,50880,116584,116759],[],{"_3394":69680,"_29710":69679,"_20617":116837,"_5":14139,"_27008":69679,"_2880":116838},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3394":69681,"_29710":69679,"_5":30060,"_20617":116840,"_27008":116841,"_2880":114153},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3394":69682,"_29710":69679,"_5":30060,"_20617":116843,"_27008":116844,"_2880":116845},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3394":69683,"_29710":69679,"_5":30060,"_20617":116847,"_27008":116848,"_2880":116849},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3394":69684,"_29710":69679,"_5":30060,"_20617":116851,"_27008":116852,"_2880":116853},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3394":69685,"_29710":69679,"_5":30060,"_20617":116855,"_27008":116856,"_2880":116857},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3394":69686,"_29710":69679,"_5":30060,"_20617":116859,"_27008":116860,"_2880":116861},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3394":69687,"_29710":69679,"_5":30060,"_20617":116863,"_27008":116864,"_2880":116865},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3394":69688,"_29710":69679,"_5":30060,"_20617":116867,"_27008":116868,"_2880":116869},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3394":69689,"_29710":69679,"_5":30060,"_20617":116871,"_27008":116872,"_2880":51175},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3394":69690,"_29710":69679,"_5":30060,"_20617":116874,"_27008":116875,"_2880":51179},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3394":69691,"_29710":69679,"_5":30060,"_20617":116877,"_27008":116878,"_2880":116879},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3394":69692,"_29710":69679,"_5":30060,"_20617":116881,"_27008":116882,"_2880":116883},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3394":69693,"_29710":69679,"_5":30060,"_20617":116885,"_27008":116886,"_2880":116887},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3394":69694,"_29710":69679,"_5":30060,"_20617":116889,"_27008":116890,"_2880":116891},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3394":69695,"_29710":69679,"_5":30060,"_20617":116893,"_27008":116894,"_2880":51199},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3394":69696,"_29710":69679,"_5":30060,"_20617":116896,"_27008":116897,"_2880":116898},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3394":69697,"_29710":69679,"_5":30060,"_20617":116900,"_27008":116901,"_2880":116902},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3394":69698,"_29710":69679,"_5":30060,"_20617":116904,"_27008":116905,"_2880":116906},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3394":69699,"_29710":69679,"_20617":116908,"_5":14139,"_27008":69679,"_2880":116909},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3394":69700,"_29710":69679,"_20617":116911,"_5":14139,"_27008":116841,"_2880":116912},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3394":69701,"_29710":69679,"_20617":116914,"_5":14139,"_27008":116841,"_2880":116915},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3394":69702,"_29710":69679,"_20617":116917,"_5":14139,"_27008":116848,"_2880":116918},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3394":69703,"_29710":69679,"_20617":116920,"_5":14139,"_27008":116852,"_2880":116921},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3394":69704,"_29710":69679,"_20617":116923,"_5":14139,"_27008":116856,"_2880":116924},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3394":69705,"_29710":69679,"_20617":116926,"_5":14139,"_27008":116860,"_2880":116927},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3394":69706,"_29710":69679,"_20617":116929,"_5":14139,"_27008":116864,"_2880":116930},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3394":69707,"_29710":69679,"_20617":116932,"_5":14139,"_27008":116872,"_2880":116933},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3394":69708,"_29710":69679,"_20617":116935,"_5":14139,"_27008":116872,"_2880":116936},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3394":69709,"_29710":69679,"_20617":116938,"_5":14139,"_27008":116875,"_2880":116939},[],"Campo de `settings.enrollment_settings`",{"_3394":69710,"_29710":69679,"_20617":116941,"_5":14139,"_27008":116875,"_2880":116942},[],"Decisión",{"_3394":69711,"_29710":69679,"_20617":116944,"_5":14139,"_27008":116875,"_2880":51250},[],{"_3394":69712,"_29710":69679,"_20617":116946,"_5":14139,"_27008":116875,"_2880":116947},[],"`EST_RFC7030` para estas operaciones.",{"_3394":69713,"_29710":69679,"_20617":116949,"_5":14139,"_27008":116875,"_2880":51256},[],{"_3394":69714,"_29710":69679,"_20617":116951,"_5":14139,"_27008":116875,"_2880":116952},[],"ID de la CA que firmará.",{"_3394":69715,"_29710":69679,"_20617":116954,"_5":14139,"_27008":116875,"_2880":51262},[],{"_3394":69716,"_29710":69679,"_20617":116956,"_5":14139,"_27008":116875,"_2880":116957},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3394":69717,"_29710":69679,"_20617":116959,"_5":14139,"_27008":116875,"_2880":51268},[],{"_3394":69718,"_29710":69679,"_20617":116961,"_5":14139,"_27008":116875,"_2880":116962},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3394":69719,"_29710":69679,"_20617":116964,"_5":14139,"_27008":116875,"_2880":51274},[],{"_3394":69720,"_29710":69679,"_20617":116966,"_5":14139,"_27008":116875,"_2880":116967},[],"Uno de los cuatro modos de autenticación.",{"_3394":69721,"_29710":69679,"_20617":116969,"_5":14139,"_27008":116875,"_2880":116970},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3394":69722,"_29710":69679,"_20617":116972,"_5":14139,"_27008":116878,"_2880":116973},[],"Los bloques son independientes:",{"_3394":69723,"_29710":69679,"_20617":116975,"_5":14139,"_27008":116878,"_2880":116976},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3394":69724,"_29710":69679,"_20617":116978,"_5":14139,"_27008":116878,"_2880":116979},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3394":69725,"_29710":69679,"_20617":116981,"_5":14139,"_27008":116878,"_2880":51292},[],{"_3394":69726,"_29710":69679,"_20617":116983,"_5":14139,"_27008":116878,"_2880":116984},[],"Control aplicado en la operación configurada",{"_3394":69727,"_29710":69679,"_20617":116986,"_5":14139,"_27008":116878,"_2880":51298},[],{"_3394":69728,"_29710":69679,"_20617":116988,"_5":14139,"_27008":116878,"_2880":116989},[],"Validación del certificado presentado.",{"_3394":69729,"_29710":69679,"_20617":116991,"_5":14139,"_27008":116878,"_2880":51304},[],{"_3394":69730,"_29710":69679,"_20617":116993,"_5":14139,"_27008":116878,"_2880":116994},[],"Autorización del webhook configurado.",{"_3394":69731,"_29710":69679,"_20617":116996,"_5":14139,"_27008":116878,"_2880":51310},[],{"_3394":69732,"_29710":69679,"_20617":116998,"_5":14139,"_27008":116878,"_2880":116999},[],"Validación del certificado y, después, aprobación del webhook.",{"_3394":69733,"_29710":69679,"_20617":117001,"_5":14139,"_27008":116878,"_2880":51316},[],{"_3394":69734,"_29710":69679,"_20617":117003,"_5":14139,"_27008":116878,"_2880":117004},[],"Sin autenticación del solicitante por el DMS.",{"_3394":69735,"_29710":69679,"_20617":117006,"_5":14139,"_27008":116878,"_2880":117007},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3394":69736,"_29710":69679,"_20617":117009,"_5":14139,"_27008":116878,"_2880":117010},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3394":69737,"_29710":69679,"_20617":117012,"_5":14139,"_27008":116878,"_2880":117013},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3394":69738,"_29710":69679,"_20617":117015,"_5":14139,"_27008":116878,"_2880":117016},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3394":69739,"_29710":69679,"_20617":117018,"_5":14139,"_27008":116882,"_2880":117019},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3394":69740,"_29710":69679,"_20617":117021,"_5":14139,"_27008":116882,"_2880":117022},[],"Campo de `external_webhook_settings`",{"_3394":69741,"_29710":69679,"_20617":117024,"_5":14139,"_27008":116882,"_2880":116942},[],{"_3394":69742,"_29710":69679,"_20617":117026,"_5":14139,"_27008":116882,"_2880":51342},[],{"_3394":69743,"_29710":69679,"_20617":117028,"_5":14139,"_27008":116882,"_2880":117029},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3394":69744,"_29710":69679,"_20617":117031,"_5":14139,"_27008":116882,"_2880":51348},[],{"_3394":69745,"_29710":69679,"_20617":117033,"_5":14139,"_27008":116882,"_2880":117034},[],"`POST` o `PUT`; `POST` por defecto.",{"_3394":69746,"_29710":69679,"_20617":117036,"_5":14139,"_27008":116882,"_2880":51354},[],{"_3394":69747,"_29710":69679,"_20617":117038,"_5":14139,"_27008":116882,"_2880":117039},[],"Etiqueta usada en los logs del servicio.",{"_3394":69748,"_29710":69679,"_20617":117041,"_5":14139,"_27008":116882,"_2880":51360},[],{"_3394":69749,"_29710":69679,"_20617":117043,"_5":14139,"_27008":116882,"_2880":117044},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3394":69750,"_29710":69679,"_20617":117046,"_5":14139,"_27008":116882,"_2880":51366},[],{"_3394":69751,"_29710":69679,"_20617":117048,"_5":14139,"_27008":116882,"_2880":117049},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3394":69752,"_29710":69679,"_20617":117051,"_5":14139,"_27008":116882,"_2880":51372},[],{"_3394":69753,"_29710":69679,"_20617":117053,"_5":14139,"_27008":116882,"_2880":117054},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3394":69754,"_29710":69679,"_20617":117056,"_5":14139,"_27008":116882,"_2880":51378},[],{"_3394":69755,"_29710":69679,"_20617":117058,"_5":14139,"_27008":116882,"_2880":117059},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3394":69756,"_29710":69679,"_20617":117061,"_5":14139,"_27008":116882,"_2880":51384},[],{"_3394":69757,"_29710":69679,"_20617":117063,"_5":14139,"_27008":116882,"_2880":117064},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3394":69758,"_29710":69679,"_20617":117066,"_5":14139,"_27008":116882,"_2880":51390},[],{"_3394":69759,"_29710":69679,"_20617":117068,"_5":14139,"_27008":116882,"_2880":117069},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3394":69760,"_29710":69679,"_20617":117071,"_5":14139,"_27008":116882,"_2880":51396},[],{"_3394":69761,"_29710":69679,"_20617":117073,"_5":14139,"_27008":116882,"_2880":117074},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3394":69762,"_29710":69679,"_20617":117076,"_5":14139,"_27008":116882,"_2880":117077},[],"Reglas de esa configuración:",{"_3394":69763,"_29710":69679,"_20617":117079,"_5":14139,"_27008":116882,"_2880":117080},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3394":69764,"_29710":69679,"_20617":117082,"_5":14139,"_27008":116882,"_2880":117083},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3394":69765,"_29710":69679,"_20617":117085,"_5":14139,"_27008":116882,"_2880":117086},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3394":69766,"_29710":69679,"_20617":117088,"_5":14139,"_27008":116882,"_2880":117089},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3394":69767,"_29710":69679,"_20617":117091,"_5":14139,"_27008":116882,"_2880":117092},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3394":69768,"_29710":69679,"_20617":117094,"_5":14139,"_27008":116882,"_2880":117095},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3394":69769,"_29710":69679,"_20617":117097,"_5":14139,"_27008":116882,"_2880":117098},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3394":69770,"_29710":69679,"_20617":117100,"_5":14139,"_27008":116882,"_2880":117101},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3394":69771,"_29710":69679,"_20617":117103,"_5":14139,"_27008":116882,"_2880":117104},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3394":69772,"_29710":69679,"_20617":117106,"_5":14139,"_27008":116886,"_2880":117107},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3394":69773,"_29710":69679,"_20617":117109,"_5":14139,"_27008":116890,"_2880":117110},[],"Campo de `settings.reenrollment_settings`",{"_3394":69774,"_29710":69679,"_20617":117112,"_5":14139,"_27008":116890,"_2880":117113},[],"Función",{"_3394":69775,"_29710":69679,"_20617":117115,"_5":14139,"_27008":116890,"_2880":51440},[],{"_3394":69776,"_29710":69679,"_20617":117117,"_5":14139,"_27008":116890,"_2880":117118},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3394":69777,"_29710":69679,"_20617":117120,"_5":14139,"_27008":116890,"_2880":51446},[],{"_3394":69778,"_29710":69679,"_20617":117122,"_5":14139,"_27008":116890,"_2880":117123},[],"Umbral operativo preventivo de monitorización.",{"_3394":69779,"_29710":69679,"_20617":117125,"_5":14139,"_27008":116890,"_2880":51452},[],{"_3394":69780,"_29710":69679,"_20617":117127,"_5":14139,"_27008":116890,"_2880":117128},[],"Umbral operativo crítico de monitorización.",{"_3394":69781,"_29710":69679,"_20617":117130,"_5":14139,"_27008":116890,"_2880":51458},[],{"_3394":69782,"_29710":69679,"_20617":117132,"_5":14139,"_27008":116890,"_2880":117133},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3394":69783,"_29710":69679,"_20617":117135,"_5":14139,"_27008":116890,"_2880":51464},[],{"_3394":69784,"_29710":69679,"_20617":117137,"_5":14139,"_27008":116890,"_2880":117138},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3394":69785,"_29710":69679,"_20617":117140,"_5":14139,"_27008":116890,"_2880":51470},[],{"_3394":69786,"_29710":69679,"_20617":117142,"_5":14139,"_27008":116890,"_2880":117143},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3394":69787,"_29710":69679,"_20617":117145,"_5":14139,"_27008":116890,"_2880":117146},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3394":69788,"_29710":69679,"_20617":117148,"_5":14139,"_27008":116894,"_2880":117149},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3394":69789,"_29710":69679,"_20617":117151,"_5":14139,"_27008":116897,"_2880":114517},[],{"_3394":69790,"_29710":69679,"_20617":117153,"_5":14139,"_27008":116897,"_2880":117154},[],"Qué publica",{"_3394":69791,"_29710":69679,"_20617":117156,"_5":14139,"_27008":116897,"_2880":51487},[],{"_3394":69792,"_29710":69679,"_20617":117158,"_5":14139,"_27008":116897,"_2880":117159},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3394":69793,"_29710":69679,"_20617":117161,"_5":14139,"_27008":116897,"_2880":51493},[],{"_3394":69794,"_29710":69679,"_20617":117163,"_5":14139,"_27008":116897,"_2880":117164},[],"Certificado de la CA emisora seleccionada.",{"_3394":69795,"_29710":69679,"_20617":117166,"_5":14139,"_27008":116897,"_2880":51499},[],{"_3394":69796,"_29710":69679,"_20617":117168,"_5":14139,"_27008":116897,"_2880":117169},[],"Certificados de las CAs elegidas explícitamente.",{"_3394":69797,"_29710":69679,"_20617":117171,"_5":14139,"_27008":116897,"_2880":117172},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3394":69798,"_29710":69679,"_20617":117174,"_5":14139,"_27008":116901,"_2880":117175},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3394":69799,"_29710":69679,"_20617":117177,"_5":14139,"_27008":116901,"_2880":117178},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3394":69800,"_29710":69679,"_20617":117180,"_5":14139,"_27008":116901,"_2880":117181},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3394":69801,"_29710":69679,"_20617":117183,"_5":14139,"_27008":116905,"_2880":117184},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3394":69802,"_29710":69802,"_5":14491,"_2880":117186,"_30063":117187,"_20617":117188,"_27008":69802},"Integra el cliente EST",[48401,115575,50880,116584,116759],[],{"_3394":69803,"_29710":69802,"_20617":117190,"_5":14139,"_27008":69802,"_2880":117191},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3394":69804,"_29710":69802,"_5":30060,"_20617":117193,"_27008":117194,"_2880":114153},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3394":69805,"_29710":69802,"_5":30060,"_20617":117196,"_27008":117197,"_2880":117198},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3394":69806,"_29710":69802,"_5":30060,"_20617":117200,"_27008":117201,"_2880":117202},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3394":69807,"_29710":69802,"_5":30060,"_20617":117204,"_27008":117205,"_2880":117206},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3394":69808,"_29710":69802,"_5":30060,"_20617":117208,"_27008":117209,"_2880":117210},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3394":69809,"_29710":69802,"_5":30060,"_20617":117212,"_27008":117213,"_2880":117214},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3394":69810,"_29710":69802,"_20617":117216,"_5":14139,"_27008":69802,"_2880":117217},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3394":69811,"_29710":69802,"_20617":117219,"_5":14139,"_27008":117194,"_2880":117220},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3394":69812,"_29710":69802,"_20617":117222,"_5":14139,"_27008":117194,"_2880":117223},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3394":69813,"_29710":69802,"_20617":117225,"_5":14139,"_27008":117194,"_2880":117226},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3394":69814,"_29710":69802,"_20617":117228,"_5":14139,"_27008":117197,"_2880":117229},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3394":69815,"_29710":69802,"_20617":117231,"_5":14139,"_27008":117197,"_2880":117232},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3394":69816,"_29710":69802,"_20617":117234,"_5":14139,"_27008":117201,"_2880":117235},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3394":69817,"_29710":69802,"_20617":117237,"_5":14139,"_27008":117201,"_2880":117238},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3394":69818,"_29710":69802,"_20617":117240,"_5":14139,"_27008":117205,"_2880":117241},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3394":69819,"_29710":69802,"_20617":117243,"_5":14139,"_27008":117205,"_2880":117244},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3394":69820,"_29710":69802,"_20617":117246,"_5":14139,"_27008":117209,"_2880":117247},[],"Para el caso de una raíz que emite directamente:",{"_3394":69821,"_29710":69802,"_20617":117249,"_5":14139,"_27008":117209,"_2880":117250},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3394":69822,"_29710":69802,"_20617":117252,"_5":14139,"_27008":117209,"_2880":117253},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3394":69823,"_29710":69802,"_20617":117255,"_5":14139,"_27008":117213,"_2880":117256},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3394":69824,"_29710":69824,"_5":14491,"_2880":117258,"_30063":117259,"_20617":117260,"_27008":69824},"Referencia EST",[48401,115575,50880,116584,116759],[],{"_3394":69825,"_29710":69824,"_20617":117262,"_5":14139,"_27008":69824,"_2880":117263},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3394":69826,"_29710":69824,"_5":30060,"_20617":117265,"_27008":117266,"_2880":117267},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3394":69827,"_29710":69824,"_5":30060,"_20617":117269,"_27008":117270,"_2880":22340},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3394":69828,"_29710":69824,"_5":30060,"_20617":117272,"_27008":117273,"_2880":25638},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3394":69829,"_29710":69824,"_5":30060,"_20617":117275,"_27008":117276,"_2880":25645},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3394":69830,"_29710":69824,"_5":30060,"_20617":117278,"_27008":117279,"_2880":24968},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3394":69831,"_29710":69824,"_5":30060,"_20617":117281,"_27008":117282,"_2880":117283},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3394":69832,"_29710":69824,"_5":30060,"_20617":117285,"_27008":117286,"_2880":117287},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3394":69833,"_29710":69824,"_5":30060,"_20617":117289,"_27008":117290,"_2880":117291},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3394":69834,"_29710":69824,"_20617":117293,"_5":14139,"_27008":69824,"_2880":117294},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3394":69835,"_29710":69824,"_20617":117296,"_5":14139,"_27008":117266,"_2880":117297},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3394":69836,"_29710":69824,"_20617":117299,"_5":14139,"_27008":117266,"_2880":115335},[],{"_3394":69837,"_29710":69824,"_20617":117301,"_5":14139,"_27008":117266,"_2880":117302},[],"Método",{"_3394":69838,"_29710":69824,"_20617":117304,"_5":14139,"_27008":117266,"_2880":117305},[],"Autenticación y condición",{"_3394":69839,"_29710":69824,"_20617":117307,"_5":14139,"_27008":117266,"_2880":51642},[],{"_3394":69840,"_29710":69824,"_20617":117309,"_5":14139,"_27008":117266,"_2880":51645},[],{"_3394":69841,"_29710":69824,"_20617":117311,"_5":14139,"_27008":117266,"_2880":117312},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3394":69842,"_29710":69824,"_20617":117314,"_5":14139,"_27008":117266,"_2880":51651},[],{"_3394":69843,"_29710":69824,"_20617":117316,"_5":14139,"_27008":117266,"_2880":51654},[],{"_3394":69844,"_29710":69824,"_20617":117318,"_5":14139,"_27008":117266,"_2880":117319},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3394":69845,"_29710":69824,"_20617":117321,"_5":14139,"_27008":117266,"_2880":51660},[],{"_3394":69846,"_29710":69824,"_20617":117323,"_5":14139,"_27008":117266,"_2880":51654},[],{"_3394":69847,"_29710":69824,"_20617":117325,"_5":14139,"_27008":117266,"_2880":117326},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3394":69848,"_29710":69824,"_20617":117328,"_5":14139,"_27008":117266,"_2880":51668},[],{"_3394":69849,"_29710":69824,"_20617":117330,"_5":14139,"_27008":117266,"_2880":51654},[],{"_3394":69850,"_29710":69824,"_20617":117332,"_5":14139,"_27008":117266,"_2880":117333},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3394":69851,"_29710":69824,"_20617":117335,"_5":14139,"_27008":117266,"_2880":117336},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3394":69852,"_29710":69824,"_20617":117338,"_5":14139,"_27008":117270,"_2880":117339},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3394":69853,"_29710":69824,"_20617":117341,"_5":14139,"_27008":117270,"_2880":117342},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3394":69854,"_29710":69824,"_20617":117344,"_5":14139,"_27008":117273,"_2880":117345},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3394":69855,"_29710":69824,"_20617":117347,"_5":14139,"_27008":117273,"_2880":117348},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3394":69856,"_29710":69824,"_20617":117350,"_5":14139,"_27008":117276,"_2880":117351},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3394":69857,"_29710":69824,"_20617":117353,"_5":14139,"_27008":117276,"_2880":117354},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3394":69858,"_29710":69824,"_20617":117356,"_5":14139,"_27008":117279,"_2880":117357},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3394":69859,"_29710":69824,"_20617":117359,"_5":14139,"_27008":117279,"_2880":117360},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3394":69860,"_29710":69824,"_20617":117362,"_5":14139,"_27008":117282,"_2880":117363},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3394":69861,"_29710":69824,"_20617":117365,"_5":14139,"_27008":117282,"_2880":117366},[],"Parte",{"_3394":69862,"_29710":69824,"_20617":117368,"_5":14139,"_27008":117282,"_2880":117369},[],"Contenido tras decodificar su Base64",{"_3394":69863,"_29710":69824,"_20617":117371,"_5":14139,"_27008":117282,"_2880":51712},[],{"_3394":69864,"_29710":69824,"_20617":117373,"_5":14139,"_27008":117282,"_2880":117374},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3394":69865,"_29710":69824,"_20617":117376,"_5":14139,"_27008":117282,"_2880":51718},[],{"_3394":69866,"_29710":69824,"_20617":117378,"_5":14139,"_27008":117282,"_2880":117379},[],"PKCS#7 DER con el certificado emitido.",{"_3394":69867,"_29710":69824,"_20617":117381,"_5":14139,"_27008":117282,"_2880":117382},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3394":69868,"_29710":69824,"_20617":117384,"_5":14139,"_27008":117286,"_2880":117385},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3394":69869,"_29710":69824,"_20617":117387,"_5":14139,"_27008":117286,"_2880":117388},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3394":69870,"_29710":69824,"_20617":117390,"_5":14139,"_27008":117286,"_2880":117391},[],"Convierte y comprueba el resultado:",{"_3394":69871,"_29710":69824,"_20617":117393,"_5":14139,"_27008":117286,"_2880":117394},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3394":69872,"_29710":69824,"_20617":117396,"_5":14139,"_27008":117290,"_2880":117397},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3394":69873,"_29710":69824,"_20617":117399,"_5":14139,"_27008":117290,"_2880":117400},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3394":69874,"_29710":69874,"_5":14491,"_2880":116759,"_30063":117402,"_20617":117403,"_27008":69874},[48401,115575,50880,116584,116759],[],{"_3394":69875,"_29710":69874,"_20617":117405,"_5":14139,"_27008":69874,"_2880":117406},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3394":69876,"_29710":69874,"_5":30060,"_20617":117408,"_27008":117409,"_2880":117410},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3394":69877,"_29710":69874,"_5":30060,"_20617":117412,"_27008":117413,"_2880":117414},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3394":69878,"_29710":69874,"_5":30060,"_20617":117416,"_27008":117417,"_2880":117418},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3394":69879,"_29710":69874,"_5":30060,"_20617":117420,"_27008":117421,"_2880":117422},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3394":69880,"_29710":69874,"_20617":117424,"_5":14139,"_27008":69874,"_2880":117425},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3394":69881,"_29710":69874,"_20617":117427,"_5":14139,"_27008":117409,"_2880":117428},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3394":69882,"_29710":69874,"_20617":117430,"_5":14139,"_27008":117409,"_2880":117431},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3394":69883,"_29710":69874,"_20617":117433,"_5":14139,"_27008":117409,"_2880":117434},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3394":69884,"_29710":69874,"_20617":117436,"_5":14139,"_27008":117409,"_2880":117437},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3394":69885,"_29710":69874,"_20617":117439,"_5":14139,"_27008":117409,"_2880":117440},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3394":69886,"_29710":69874,"_20617":117442,"_5":14139,"_27008":117409,"_2880":117443},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3394":69887,"_29710":69874,"_20617":117445,"_5":14139,"_27008":117413,"_2880":117446},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3394":69888,"_29710":69874,"_20617":117448,"_5":14139,"_27008":117413,"_2880":117449},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3394":69889,"_29710":69874,"_20617":117451,"_5":14139,"_27008":117413,"_2880":117452},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3394":69890,"_29710":69874,"_20617":117454,"_5":14139,"_27008":117413,"_2880":117455},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3394":69891,"_29710":69874,"_20617":117457,"_5":14139,"_27008":117417,"_2880":117458},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3394":69892,"_29710":69874,"_20617":117460,"_5":14139,"_27008":117417,"_2880":117461},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3394":69893,"_29710":69874,"_20617":117463,"_5":14139,"_27008":117417,"_2880":117464},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3394":69894,"_29710":69874,"_20617":117466,"_5":14139,"_27008":117417,"_2880":117467},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3394":69895,"_29710":69874,"_20617":117469,"_5":14139,"_27008":117421,"_2880":117470},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3394":69896,"_29710":69874,"_20617":117472,"_5":14139,"_27008":117421,"_2880":117473},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3394":69897,"_29710":69897,"_5":14491,"_2880":117475,"_30063":117476,"_20617":117477,"_27008":69897},"Estrategias de aprovisionamiento",[48401,115575,50880,116584,116759],[],{"_3394":69898,"_29710":69897,"_20617":117479,"_5":14139,"_27008":69897,"_2880":117480},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3394":69899,"_29710":69897,"_5":30060,"_20617":117482,"_27008":117483,"_2880":117484},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3394":69900,"_29710":69897,"_5":30060,"_20617":117486,"_27008":117487,"_2880":117488},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3394":69901,"_29710":69897,"_5":30060,"_20617":117490,"_27008":117491,"_2880":117492},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3394":69902,"_29710":69897,"_5":30060,"_20617":117494,"_27008":117495,"_2880":117496},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3394":69903,"_29710":69897,"_5":30060,"_20617":117498,"_27008":117499,"_2880":117500},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3394":69904,"_29710":69897,"_20617":117502,"_5":14139,"_27008":69897,"_2880":117503},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3394":69905,"_29710":69897,"_20617":117505,"_5":14139,"_27008":117483,"_2880":117506},[],"Recorrido",{"_3394":69906,"_29710":69897,"_20617":117508,"_5":14139,"_27008":117483,"_2880":117509},[],"Cuándo existe el dispositivo",{"_3394":69907,"_29710":69897,"_20617":117511,"_5":14139,"_27008":117483,"_2880":117512},[],"Qué compruebas",{"_3394":69908,"_29710":69897,"_20617":117514,"_5":14139,"_27008":117483,"_2880":117515},[],"Asignación manual",{"_3394":69909,"_29710":69897,"_20617":117517,"_5":14139,"_27008":117483,"_2880":117518},[],"El operador lo crea antes de asociar un certificado.",{"_3394":69910,"_29710":69897,"_20617":117520,"_5":14139,"_27008":117483,"_2880":117521},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3394":69911,"_29710":69897,"_20617":117523,"_5":14139,"_27008":117483,"_2880":117524},[],"EST con `JITP`",{"_3394":69912,"_29710":69897,"_20617":117526,"_5":14139,"_27008":117483,"_2880":117527},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3394":69913,"_29710":69897,"_20617":117529,"_5":14139,"_27008":117483,"_2880":117530},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3394":69914,"_29710":69897,"_20617":117532,"_5":14139,"_27008":117483,"_2880":117533},[],"EST con `PRE_REGISTRATION`",{"_3394":69915,"_29710":69897,"_20617":117535,"_5":14139,"_27008":117483,"_2880":117536},[],"Debe existir antes de `/simpleenroll`.",{"_3394":69916,"_29710":69897,"_20617":117538,"_5":14139,"_27008":117483,"_2880":117539},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3394":69917,"_29710":69897,"_20617":117541,"_5":14139,"_27008":117483,"_2880":117542},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3394":69918,"_29710":69897,"_20617":117544,"_5":14139,"_27008":117483,"_2880":117545},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3394":69919,"_29710":69897,"_20617":117547,"_5":14139,"_27008":117487,"_2880":117548},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3394":69920,"_29710":69897,"_20617":117550,"_5":14139,"_27008":117487,"_2880":117551},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3394":69921,"_29710":69897,"_20617":117553,"_5":14139,"_27008":117487,"_2880":117554},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3394":69922,"_29710":69897,"_20617":117556,"_5":14139,"_27008":117491,"_2880":117557},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3394":69923,"_29710":69897,"_20617":117559,"_5":14139,"_27008":117491,"_2880":117560},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3394":69924,"_29710":69897,"_20617":117562,"_5":14139,"_27008":117491,"_2880":117563},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3394":69925,"_29710":69897,"_20617":117565,"_5":14139,"_27008":117491,"_2880":117566},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3394":69926,"_29710":69897,"_20617":117568,"_5":14139,"_27008":117491,"_2880":117569},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3394":69927,"_29710":69897,"_20617":117571,"_5":14139,"_27008":117491,"_2880":117572},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3394":69928,"_29710":69897,"_20617":117574,"_5":14139,"_27008":117495,"_2880":114517},[],{"_3394":69929,"_29710":69897,"_20617":117576,"_5":14139,"_27008":117495,"_2880":117577},[],"Material que atraviesa EST",{"_3394":69930,"_29710":69897,"_20617":117579,"_5":14139,"_27008":117495,"_2880":117580},[],"Clave generada por el dispositivo",{"_3394":69931,"_29710":69897,"_20617":117582,"_5":14139,"_27008":117495,"_2880":117583},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3394":69932,"_29710":69897,"_20617":117585,"_5":14139,"_27008":117495,"_2880":117586},[],"Clave ya disponible en el dispositivo",{"_3394":69933,"_29710":69897,"_20617":117588,"_5":14139,"_27008":117495,"_2880":117589},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3394":69934,"_29710":69897,"_20617":117591,"_5":14139,"_27008":117495,"_2880":51199},[],{"_3394":69935,"_29710":69897,"_20617":117593,"_5":14139,"_27008":117495,"_2880":117594},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3394":69936,"_29710":69897,"_20617":117596,"_5":14139,"_27008":117495,"_2880":117597},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3394":69937,"_29710":69897,"_20617":117599,"_5":14139,"_27008":117499,"_2880":117600},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3394":69938,"_29710":69938,"_5":14491,"_2880":117602,"_30063":117603,"_20617":117604,"_27008":69938},"Renovación y recuperación",[48401,115575,50880,116584,116759],[],{"_3394":69939,"_29710":69938,"_20617":117606,"_5":14139,"_27008":69938,"_2880":117607},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3394":69940,"_29710":69938,"_5":30060,"_20617":117609,"_27008":117610,"_2880":117611},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3394":69941,"_29710":69938,"_5":30060,"_20617":117613,"_27008":117614,"_2880":117615},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3394":69942,"_29710":69938,"_5":30060,"_20617":117617,"_27008":117618,"_2880":117619},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3394":69943,"_29710":69938,"_5":30060,"_20617":117621,"_27008":117622,"_2880":117623},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3394":69944,"_29710":69938,"_5":30060,"_20617":117625,"_27008":117626,"_2880":117627},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3394":69945,"_29710":69938,"_20617":117629,"_5":14139,"_27008":69938,"_2880":117630},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3394":69946,"_29710":69938,"_20617":117632,"_5":14139,"_27008":117610,"_2880":117633},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3394":69947,"_29710":69938,"_20617":117635,"_5":14139,"_27008":117610,"_2880":117636},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3394":69948,"_29710":69938,"_20617":117638,"_5":14139,"_27008":117610,"_2880":117639},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3394":69949,"_29710":69938,"_20617":117641,"_5":14139,"_27008":117610,"_2880":117642},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3394":69950,"_29710":69938,"_20617":117644,"_5":14139,"_27008":117614,"_2880":117645},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3394":69951,"_29710":69938,"_20617":117647,"_5":14139,"_27008":117614,"_2880":117648},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3394":69952,"_29710":69938,"_20617":117650,"_5":14139,"_27008":117618,"_2880":117651},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3394":69953,"_29710":69938,"_20617":117653,"_5":14139,"_27008":117618,"_2880":117654},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3394":69954,"_29710":69938,"_20617":117656,"_5":14139,"_27008":117618,"_2880":117657},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3394":69955,"_29710":69938,"_20617":117659,"_5":14139,"_27008":117622,"_2880":117660},[],"Situación",{"_3394":69956,"_29710":69938,"_20617":117662,"_5":14139,"_27008":117622,"_2880":117663},[],"Procedimiento",{"_3394":69957,"_29710":69938,"_20617":117665,"_5":14139,"_27008":117622,"_2880":117666},[],"Certificado vigente, fuera de ventana",{"_3394":69958,"_29710":69938,"_20617":117668,"_5":14139,"_27008":117622,"_2880":117669},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3394":69959,"_29710":69938,"_20617":117671,"_5":14139,"_27008":117622,"_2880":117672},[],"Certificado vencido, clave disponible",{"_3394":69960,"_29710":69938,"_20617":117674,"_5":14139,"_27008":117622,"_2880":117675},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3394":69961,"_29710":69938,"_20617":117677,"_5":14139,"_27008":117622,"_2880":117678},[],"Renovación por webhook o `NO_AUTH`",{"_3394":69962,"_29710":69938,"_20617":117680,"_5":14139,"_27008":117622,"_2880":117681},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3394":69963,"_29710":69938,"_20617":117683,"_5":14139,"_27008":117622,"_2880":117684},[],"Clave perdida o inaccesible",{"_3394":69964,"_29710":69938,"_20617":117686,"_5":14139,"_27008":117622,"_2880":117687},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3394":69965,"_29710":69938,"_20617":117689,"_5":14139,"_27008":117622,"_2880":117690},[],"Identidad actual revocada",{"_3394":69966,"_29710":69938,"_20617":117692,"_5":14139,"_27008":117622,"_2880":117693},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3394":69967,"_29710":69938,"_20617":117695,"_5":14139,"_27008":117622,"_2880":117696},[],"Dispositivo sin identidad",{"_3394":69968,"_29710":69938,"_20617":117698,"_5":14139,"_27008":117622,"_2880":117699},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3394":69969,"_29710":69938,"_20617":117701,"_5":14139,"_27008":117622,"_2880":117702},[],"Dispositivo retirado",{"_3394":69970,"_29710":69938,"_20617":117704,"_5":14139,"_27008":117622,"_2880":117705},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3394":69971,"_29710":69938,"_20617":117707,"_5":14139,"_27008":117622,"_2880":117708},[],"Timeout, HTTP 500 o fallo de instalación",{"_3394":69972,"_29710":69938,"_20617":117710,"_5":14139,"_27008":117622,"_2880":117711},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3394":69973,"_29710":69938,"_20617":117713,"_5":14139,"_27008":117626,"_2880":117714},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3394":69974,"_29710":69938,"_20617":117716,"_5":14139,"_27008":117626,"_2880":117717},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3394":69975,"_29710":69975,"_5":14491,"_2880":117719,"_30063":117720,"_20617":117721,"_27008":69975},"Diagnóstico de enrolamiento",[48401,115575,50880,116584,116759],[],{"_3394":69976,"_29710":69975,"_20617":117723,"_5":14139,"_27008":69975,"_2880":117724},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3394":69977,"_29710":69975,"_5":30060,"_20617":117726,"_27008":117727,"_2880":117728},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3394":69978,"_29710":69975,"_5":30060,"_20617":117730,"_27008":117731,"_2880":117732},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3394":69979,"_29710":69975,"_5":30060,"_20617":117734,"_27008":117735,"_2880":117291},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3394":69980,"_29710":69975,"_5":30060,"_20617":117737,"_27008":117738,"_2880":117739},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3394":69981,"_29710":69975,"_20617":117741,"_5":14139,"_27008":69975,"_2880":117742},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3394":69982,"_29710":69975,"_20617":117744,"_5":14139,"_27008":117731,"_2880":117745},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3394":69983,"_29710":69975,"_20617":117747,"_5":14139,"_27008":117731,"_2880":117748},[],"Síntoma o mensaje",{"_3394":69984,"_29710":69975,"_20617":117750,"_5":14139,"_27008":117731,"_2880":117751},[],"Qué revisar",{"_3394":69985,"_29710":69975,"_20617":117753,"_5":14139,"_27008":117731,"_2880":117754},[],"curl rechaza TLS, nombre o emisor",{"_3394":69986,"_29710":69975,"_20617":117756,"_5":14139,"_27008":117731,"_2880":117757},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3394":69987,"_29710":69975,"_20617":117759,"_5":14139,"_27008":117731,"_2880":117760},[],"404 o APS ausente",{"_3394":69988,"_29710":69975,"_20617":117762,"_5":14139,"_27008":117731,"_2880":117763},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3394":69989,"_29710":69975,"_20617":117765,"_5":14139,"_27008":117731,"_2880":117766},[],"400, error de CSR o formato",{"_3394":69990,"_29710":69975,"_20617":117768,"_5":14139,"_27008":117731,"_2880":117769},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3394":69991,"_29710":69975,"_20617":117771,"_5":14139,"_27008":117731,"_2880":117772},[],"Credencial ausente o certificado no válido",{"_3394":69992,"_29710":69975,"_20617":117774,"_5":14139,"_27008":117731,"_2880":117775},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3394":69993,"_29710":69975,"_20617":117777,"_5":14139,"_27008":117731,"_2880":117778},[],"Webhook deniega, expira o responde sin autorización",{"_3394":69994,"_29710":69975,"_20617":117780,"_5":14139,"_27008":117731,"_2880":117781},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3394":69995,"_29710":69975,"_20617":117783,"_5":14139,"_27008":117731,"_2880":52125},[],{"_3394":69996,"_29710":69975,"_20617":117785,"_5":14139,"_27008":117731,"_2880":117786},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3394":69997,"_29710":69975,"_20617":117788,"_5":14139,"_27008":117731,"_2880":52131},[],{"_3394":69998,"_29710":69975,"_20617":117790,"_5":14139,"_27008":117731,"_2880":117791},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3394":69999,"_29710":69975,"_20617":117793,"_5":14139,"_27008":117731,"_2880":52137},[],{"_3394":70000,"_29710":69975,"_20617":117795,"_5":14139,"_27008":117731,"_2880":117796},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3394":70001,"_29710":69975,"_20617":117798,"_5":14139,"_27008":117731,"_2880":52143},[],{"_3394":70002,"_29710":69975,"_20617":117800,"_5":14139,"_27008":117731,"_2880":117801},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3394":70003,"_29710":69975,"_20617":117803,"_5":14139,"_27008":117731,"_2880":52149},[],{"_3394":70004,"_29710":69975,"_20617":117805,"_5":14139,"_27008":117731,"_2880":117806},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3394":70005,"_29710":69975,"_20617":117808,"_5":14139,"_27008":117731,"_2880":117809},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3394":70006,"_29710":69975,"_20617":117811,"_5":14139,"_27008":117731,"_2880":117812},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3394":70007,"_29710":69975,"_20617":117814,"_5":14139,"_27008":117731,"_2880":117815},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3394":70008,"_29710":69975,"_20617":117817,"_5":14139,"_27008":117731,"_2880":117818},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3394":70009,"_29710":69975,"_20617":117820,"_5":14139,"_27008":117731,"_2880":52167},[],{"_3394":70010,"_29710":69975,"_20617":117822,"_5":14139,"_27008":117731,"_2880":117823},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3394":70011,"_29710":69975,"_20617":117825,"_5":14139,"_27008":117731,"_2880":52173},[],{"_3394":70012,"_29710":69975,"_20617":117827,"_5":14139,"_27008":117731,"_2880":117828},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3394":70013,"_29710":69975,"_20617":117830,"_5":14139,"_27008":117731,"_2880":117831},[],"DMS propietario distinto",{"_3394":70014,"_29710":69975,"_20617":117833,"_5":14139,"_27008":117731,"_2880":117834},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3394":70015,"_29710":69975,"_20617":117836,"_5":14139,"_27008":117731,"_2880":52185},[],{"_3394":70016,"_29710":69975,"_20617":117838,"_5":14139,"_27008":117731,"_2880":117839},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3394":70017,"_29710":69975,"_20617":117841,"_5":14139,"_27008":117731,"_2880":52191},[],{"_3394":70018,"_29710":69975,"_20617":117843,"_5":14139,"_27008":117731,"_2880":117844},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3394":70019,"_29710":69975,"_20617":117846,"_5":14139,"_27008":117731,"_2880":117847},[],"Certificado actual revocado",{"_3394":70020,"_29710":69975,"_20617":117849,"_5":14139,"_27008":117731,"_2880":117850},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3394":70021,"_29710":69975,"_20617":117852,"_5":14139,"_27008":117731,"_2880":117853},[],"Error de CA, perfil o firma",{"_3394":70022,"_29710":69975,"_20617":117855,"_5":14139,"_27008":117731,"_2880":117856},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3394":70023,"_29710":69975,"_20617":117858,"_5":14139,"_27008":117731,"_2880":117859},[],"HTTP 200 sin conexión del dispositivo",{"_3394":70024,"_29710":69975,"_20617":117861,"_5":14139,"_27008":117731,"_2880":117862},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3394":70025,"_29710":69975,"_20617":117864,"_5":14139,"_27008":117731,"_2880":117865},[],"Timeout o error después de emitir",{"_3394":70026,"_29710":69975,"_20617":117867,"_5":14139,"_27008":117731,"_2880":117868},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3394":70027,"_29710":69975,"_20617":117870,"_5":14139,"_27008":117735,"_2880":117871},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3394":70028,"_29710":69975,"_20617":117873,"_5":14139,"_27008":117735,"_2880":117874},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3394":70029,"_29710":69975,"_20617":117876,"_5":14139,"_27008":117738,"_2880":117877},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3394":70030,"_29710":69975,"_20617":117879,"_5":14139,"_27008":117738,"_2880":117880},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3394":70031,"_29710":69975,"_20617":117882,"_5":14139,"_27008":117738,"_2880":117883},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3394":70032,"_29710":69975,"_20617":117885,"_5":14139,"_27008":117738,"_2880":117886},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3394":70033,"_29710":69975,"_20617":117888,"_5":14139,"_27008":117738,"_2880":117889},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3394":70034,"_29710":69975,"_20617":117891,"_5":14139,"_27008":117738,"_2880":117892},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3394":70035,"_29710":69975,"_20617":117894,"_5":14139,"_27008":117738,"_2880":117895},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3394":70036,"_29710":70036,"_5":14491,"_2880":117897,"_30063":117898,"_20617":117899,"_27008":70036},"Distribución y actualización de confianza",[48401,115575,50880,116584,116759],[],{"_3394":70037,"_29710":70036,"_20617":117901,"_5":14139,"_27008":70036,"_2880":117902},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3394":70038,"_29710":70036,"_5":30060,"_20617":117904,"_27008":117905,"_2880":117906},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3394":70039,"_29710":70036,"_5":30060,"_20617":117908,"_27008":117909,"_2880":117910},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3394":70040,"_29710":70036,"_5":30060,"_20617":117912,"_27008":117913,"_2880":117914},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3394":70041,"_29710":70036,"_5":30060,"_20617":117916,"_27008":117917,"_2880":117918},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3394":70042,"_29710":70036,"_5":30060,"_20617":117920,"_27008":117921,"_2880":117922},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3394":70043,"_29710":70036,"_20617":117924,"_5":14139,"_27008":70036,"_2880":117925},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3394":70044,"_29710":70036,"_20617":117927,"_5":14139,"_27008":117905,"_2880":117928},[],"Relación",{"_3394":70045,"_29710":70036,"_20617":117930,"_5":14139,"_27008":117905,"_2880":117931},[],"Material que prepara el responsable",{"_3394":70046,"_29710":70036,"_20617":117933,"_5":14139,"_27008":117905,"_2880":117934},[],"Dispositivo → servidor EST",{"_3394":70047,"_29710":70036,"_20617":117936,"_5":14139,"_27008":117905,"_2880":117937},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3394":70048,"_29710":70036,"_20617":117939,"_5":14139,"_27008":117905,"_2880":117940},[],"DMS → solicitante",{"_3394":70049,"_29710":70036,"_20617":117942,"_5":14139,"_27008":117905,"_2880":117943},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3394":70050,"_29710":70036,"_20617":117945,"_5":14139,"_27008":117905,"_2880":117946},[],"Consumidor → dispositivo",{"_3394":70051,"_29710":70036,"_20617":117948,"_5":14139,"_27008":117905,"_2880":117949},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3394":70052,"_29710":70036,"_20617":117951,"_5":14139,"_27008":117905,"_2880":117952},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3394":70053,"_29710":70036,"_20617":117954,"_5":14139,"_27008":117909,"_2880":117955},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3394":70054,"_29710":70036,"_20617":117957,"_5":14139,"_27008":117909,"_2880":117958},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3394":70055,"_29710":70036,"_20617":117960,"_5":14139,"_27008":117913,"_2880":117961},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3394":70056,"_29710":70036,"_20617":117963,"_5":14139,"_27008":117913,"_2880":117964},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3394":70057,"_29710":70036,"_20617":117966,"_5":14139,"_27008":117913,"_2880":117967},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3394":70058,"_29710":70036,"_20617":117969,"_5":14139,"_27008":117913,"_2880":117970},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3394":70059,"_29710":70036,"_20617":117972,"_5":14139,"_27008":117913,"_2880":117973},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3394":70060,"_29710":70036,"_20617":117975,"_5":14139,"_27008":117913,"_2880":117976},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3394":70061,"_29710":70036,"_20617":117978,"_5":14139,"_27008":117917,"_2880":117979},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3394":70062,"_29710":70036,"_20617":117981,"_5":14139,"_27008":117917,"_2880":117982},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3394":70063,"_29710":70036,"_20617":117984,"_5":14139,"_27008":117917,"_2880":117985},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3394":70064,"_29710":70036,"_20617":117987,"_5":14139,"_27008":117921,"_2880":117988},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3394":70065,"_29710":70065,"_5":14491,"_2880":52340,"_30063":117990,"_20617":117992,"_27008":70065},[48401,115575,50880,116584,117991],"Integraciones",[],{"_3394":70066,"_29710":70065,"_20617":117994,"_5":14139,"_27008":70065,"_2880":117995},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3394":70067,"_29710":70065,"_5":30060,"_20617":117997,"_27008":117998,"_2880":117999},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3394":70068,"_29710":70065,"_5":30060,"_20617":118001,"_27008":118002,"_2880":118003},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3394":70069,"_29710":70065,"_5":30060,"_20617":118005,"_27008":118006,"_2880":118007},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3394":70070,"_29710":70065,"_5":30060,"_20617":118009,"_27008":118010,"_2880":118011},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3394":70071,"_29710":70065,"_5":30060,"_20617":118013,"_27008":118014,"_2880":118015},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3394":70072,"_29710":70065,"_5":30060,"_20617":118017,"_27008":118018,"_2880":118019},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3394":70073,"_29710":70065,"_5":30060,"_20617":118021,"_27008":118022,"_2880":118023},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3394":70074,"_29710":70065,"_5":30060,"_20617":118025,"_27008":118026,"_2880":118027},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3394":70075,"_29710":70065,"_5":30060,"_20617":118029,"_27008":118030,"_2880":52382},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3394":70076,"_29710":70065,"_5":30060,"_20617":118032,"_27008":118033,"_2880":52386},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3394":70077,"_29710":70065,"_5":30060,"_20617":118035,"_27008":118036,"_2880":118037},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3394":70078,"_29710":70065,"_5":30060,"_20617":118039,"_27008":118040,"_2880":118041},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3394":70079,"_29710":70065,"_5":30060,"_20617":118043,"_27008":118044,"_2880":118045},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3394":70080,"_29710":70065,"_5":30060,"_20617":118047,"_27008":118048,"_2880":118049},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3394":70081,"_29710":70065,"_5":30060,"_20617":118051,"_27008":118052,"_2880":118053},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3394":70082,"_29710":70065,"_5":30060,"_20617":118055,"_27008":118056,"_2880":118057},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3394":70083,"_29710":70065,"_5":30060,"_20617":118059,"_27008":118060,"_2880":118061},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3394":70084,"_29710":70065,"_5":30060,"_20617":118063,"_27008":118064,"_2880":118065},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3394":70085,"_29710":70065,"_5":30060,"_20617":118067,"_27008":118068,"_2880":118069},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3394":70086,"_29710":70065,"_5":30060,"_20617":118071,"_27008":118072,"_2880":118073},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3394":70087,"_29710":70065,"_5":30060,"_20617":118075,"_27008":118076,"_2880":118077},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3394":70088,"_29710":70065,"_5":30060,"_20617":118079,"_27008":118080,"_2880":118081},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3394":70089,"_29710":70065,"_5":30060,"_20617":118083,"_27008":118084,"_2880":118085},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3394":70090,"_29710":70065,"_5":30060,"_20617":118087,"_27008":118088,"_2880":118089},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3394":70091,"_29710":70065,"_5":30060,"_20617":118091,"_27008":118092,"_2880":118093},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3394":70092,"_29710":70065,"_20617":118095,"_5":14139,"_27008":70065,"_2880":118096},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3394":70093,"_29710":70065,"_20617":118098,"_5":14139,"_27008":70065,"_2880":118099},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3394":70094,"_29710":70065,"_20617":118101,"_5":14139,"_27008":70065,"_2880":118102},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3394":70095,"_29710":70065,"_20617":118104,"_5":14139,"_27008":117998,"_2880":118105},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3394":70096,"_29710":70065,"_20617":118107,"_5":14139,"_27008":117998,"_2880":118108},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3394":70097,"_29710":70065,"_20617":118110,"_5":14139,"_27008":117998,"_2880":118111},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3394":70098,"_29710":70065,"_20617":118113,"_5":14139,"_27008":117998,"_2880":118114},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3394":70099,"_29710":70065,"_20617":118116,"_5":14139,"_27008":118002,"_2880":118117},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3394":70100,"_29710":70065,"_20617":118119,"_5":14139,"_27008":118006,"_2880":118120},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3394":70101,"_29710":70065,"_20617":118122,"_5":14139,"_27008":118006,"_2880":118123},[],"Acción IAM",{"_3394":70102,"_29710":70065,"_20617":118125,"_5":14139,"_27008":118006,"_2880":114523},[],{"_3394":70103,"_29710":70065,"_20617":118127,"_5":14139,"_27008":118006,"_2880":52481},[],{"_3394":70104,"_29710":70065,"_20617":118129,"_5":14139,"_27008":118006,"_2880":118130},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3394":70105,"_29710":70065,"_20617":118132,"_5":14139,"_27008":118006,"_2880":52487},[],{"_3394":70106,"_29710":70065,"_20617":118134,"_5":14139,"_27008":118006,"_2880":118135},[],"Registrar la CA en AWS IoT",{"_3394":70107,"_29710":70065,"_20617":118137,"_5":14139,"_27008":118006,"_2880":52493},[],{"_3394":70108,"_29710":70065,"_20617":118139,"_5":14139,"_27008":118006,"_2880":118140},[],"Consultar el estado del registro de la CA",{"_3394":70109,"_29710":70065,"_20617":118142,"_5":14139,"_27008":118006,"_2880":52499},[],{"_3394":70110,"_29710":70065,"_20617":118144,"_5":14139,"_27008":118006,"_2880":118145},[],"Crear o actualizar Things en IoT Core",{"_3394":70111,"_29710":70065,"_20617":118147,"_5":14139,"_27008":118006,"_2880":52505},[],{"_3394":70112,"_29710":70065,"_20617":118149,"_5":14139,"_27008":118006,"_2880":118150},[],"Aprovisionar Things mediante plantilla",{"_3394":70113,"_29710":70065,"_20617":118152,"_5":14139,"_27008":118006,"_2880":52511},[],{"_3394":70114,"_29710":70065,"_20617":118154,"_5":14139,"_27008":118006,"_2880":118155},[],"Registrar certificados de dispositivo",{"_3394":70115,"_29710":70065,"_20617":118157,"_5":14139,"_27008":118006,"_2880":52517},[],{"_3394":70116,"_29710":70065,"_20617":118159,"_5":14139,"_27008":118006,"_2880":118160},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3394":70117,"_29710":70065,"_20617":118162,"_5":14139,"_27008":118006,"_2880":52523},[],{"_3394":70118,"_29710":70065,"_20617":118164,"_5":14139,"_27008":118006,"_2880":118165},[],"Crear y adjuntar políticas IoT",{"_3394":70119,"_29710":70065,"_20617":118167,"_5":14139,"_27008":118006,"_2880":52529},[],{"_3394":70120,"_29710":70065,"_20617":118169,"_5":14139,"_27008":118006,"_2880":118170},[],"Gestionar grupos de Things",{"_3394":70121,"_29710":70065,"_20617":118172,"_5":14139,"_27008":118006,"_2880":52535},[],{"_3394":70122,"_29710":70065,"_20617":118174,"_5":14139,"_27008":118006,"_2880":118175},[],"Crear plantillas JITP",{"_3394":70123,"_29710":70065,"_20617":118177,"_5":14139,"_27008":118006,"_2880":52541},[],{"_3394":70124,"_29710":70065,"_20617":118179,"_5":14139,"_27008":118006,"_2880":118180},[],"Leer y escribir el Device Shadow",{"_3394":70125,"_29710":70065,"_20617":118182,"_5":14139,"_27008":118006,"_2880":118183},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3394":70126,"_29710":70065,"_20617":118185,"_5":14139,"_27008":118010,"_2880":118186},[],"Parámetro",{"_3394":70127,"_29710":70065,"_20617":118188,"_5":14139,"_27008":118010,"_2880":118189},[],"Tipo",{"_3394":70128,"_29710":70065,"_20617":118191,"_5":14139,"_27008":118010,"_2880":118192},[],"Requerido",{"_3394":70129,"_29710":70065,"_20617":118194,"_5":14139,"_27008":118010,"_2880":118195},[],"Descripción",{"_3394":70130,"_29710":70065,"_20617":118197,"_5":14139,"_27008":118010,"_2880":52562},[],{"_3394":70131,"_29710":70065,"_20617":118199,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70132,"_29710":70065,"_20617":118201,"_5":14139,"_27008":118010,"_2880":118202},[],"Sí",{"_3394":70133,"_29710":70065,"_20617":118204,"_5":14139,"_27008":118010,"_2880":118205},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3394":70134,"_29710":70065,"_20617":118207,"_5":14139,"_27008":118010,"_2880":52573},[],{"_3394":70135,"_29710":70065,"_20617":118209,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70136,"_29710":70065,"_20617":118211,"_5":14139,"_27008":118010,"_2880":118202},[],{"_3394":70137,"_29710":70065,"_20617":118213,"_5":14139,"_27008":118010,"_2880":118214},[],"Región AWS donde opera el conector.",{"_3394":70138,"_29710":70065,"_20617":118216,"_5":14139,"_27008":118010,"_2880":52583},[],{"_3394":70139,"_29710":70065,"_20617":118218,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70140,"_29710":70065,"_20617":118220,"_5":14139,"_27008":118010,"_2880":118202},[],{"_3394":70141,"_29710":70065,"_20617":118222,"_5":14139,"_27008":118010,"_2880":118223},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3394":70142,"_29710":70065,"_20617":118225,"_5":14139,"_27008":118010,"_2880":52593},[],{"_3394":70143,"_29710":70065,"_20617":118227,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70144,"_29710":70065,"_20617":118229,"_5":14139,"_27008":118010,"_2880":118230},[],"Solo con `auth_method=static`",{"_3394":70145,"_29710":70065,"_20617":118232,"_5":14139,"_27008":118010,"_2880":118233},[],"Clave de acceso AWS.",{"_3394":70146,"_29710":70065,"_20617":118235,"_5":14139,"_27008":118010,"_2880":52604},[],{"_3394":70147,"_29710":70065,"_20617":118237,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70148,"_29710":70065,"_20617":118239,"_5":14139,"_27008":118010,"_2880":118230},[],{"_3394":70149,"_29710":70065,"_20617":118241,"_5":14139,"_27008":118010,"_2880":118242},[],"Clave secreta AWS.",{"_3394":70150,"_29710":70065,"_20617":118244,"_5":14139,"_27008":118010,"_2880":52614},[],{"_3394":70151,"_29710":70065,"_20617":118246,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70152,"_29710":70065,"_20617":118248,"_5":14139,"_27008":118010,"_2880":52619},[],{"_3394":70153,"_29710":70065,"_20617":118250,"_5":14139,"_27008":118010,"_2880":118251},[],"Token de sesión (con `auth_method=static`).",{"_3394":70154,"_29710":70065,"_20617":118253,"_5":14139,"_27008":118010,"_2880":52625},[],{"_3394":70155,"_29710":70065,"_20617":118255,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70156,"_29710":70065,"_20617":118257,"_5":14139,"_27008":118010,"_2880":118258},[],"Solo con `auth_method=role`",{"_3394":70157,"_29710":70065,"_20617":118260,"_5":14139,"_27008":118010,"_2880":118261},[],"ARN del rol a asumir.",{"_3394":70158,"_29710":70065,"_20617":118263,"_5":14139,"_27008":118010,"_2880":52636},[],{"_3394":70159,"_29710":70065,"_20617":118265,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70160,"_29710":70065,"_20617":118267,"_5":14139,"_27008":118010,"_2880":52619},[],{"_3394":70161,"_29710":70065,"_20617":118269,"_5":14139,"_27008":118010,"_2880":118270},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3394":70162,"_29710":70065,"_20617":118272,"_5":14139,"_27008":118010,"_2880":52646},[],{"_3394":70163,"_29710":70065,"_20617":118274,"_5":14139,"_27008":118010,"_2880":88089},[],{"_3394":70164,"_29710":70065,"_20617":118276,"_5":14139,"_27008":118010,"_2880":118202},[],{"_3394":70165,"_29710":70065,"_20617":118278,"_5":14139,"_27008":118010,"_2880":118279},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3394":70166,"_29710":70065,"_20617":118281,"_5":14139,"_27008":118010,"_2880":52656},[],{"_3394":70167,"_29710":70065,"_20617":118283,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70168,"_29710":70065,"_20617":118285,"_5":14139,"_27008":118010,"_2880":118202},[],{"_3394":70169,"_29710":70065,"_20617":118287,"_5":14139,"_27008":118010,"_2880":118288},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3394":70170,"_29710":70065,"_20617":118290,"_5":14139,"_27008":118010,"_2880":52666},[],{"_3394":70171,"_29710":70065,"_20617":118292,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70172,"_29710":70065,"_20617":118294,"_5":14139,"_27008":118010,"_2880":118202},[],{"_3394":70173,"_29710":70065,"_20617":118296,"_5":14139,"_27008":118010,"_2880":118297},[],"URL HTTP del Device Manager de Lamassu.",{"_3394":70174,"_29710":70065,"_20617":118299,"_5":14139,"_27008":118010,"_2880":52676},[],{"_3394":70175,"_29710":70065,"_20617":118301,"_5":14139,"_27008":118010,"_2880":24618},[],{"_3394":70176,"_29710":70065,"_20617":118303,"_5":14139,"_27008":118010,"_2880":118202},[],{"_3394":70177,"_29710":70065,"_20617":118305,"_5":14139,"_27008":118010,"_2880":118306},[],"URL HTTP del servicio de CA de Lamassu.",{"_3394":70178,"_29710":70065,"_20617":118308,"_5":14139,"_27008":118014,"_2880":118309},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3394":70179,"_29710":70065,"_20617":118311,"_5":14139,"_27008":118014,"_2880":118312},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3394":70180,"_29710":70065,"_20617":118314,"_5":14139,"_27008":118014,"_2880":118315},[],"Tipo de CloudEvent",{"_3394":70181,"_29710":70065,"_20617":118317,"_5":14139,"_27008":118014,"_2880":118318},[],"Recurso en Lamassu",{"_3394":70182,"_29710":70065,"_20617":118320,"_5":14139,"_27008":118014,"_2880":118321},[],"Recurso AWS",{"_3394":70183,"_29710":70065,"_20617":118323,"_5":14139,"_27008":118014,"_2880":118324},[],"Acciones IAM",{"_3394":70184,"_29710":70065,"_20617":118326,"_5":14139,"_27008":118014,"_2880":118327},[],"Llamadas AWS y efecto",{"_3394":70185,"_29710":70065,"_20617":118329,"_5":14139,"_27008":118014,"_2880":118330},[],"Dónde en esta página",{"_3394":70186,"_29710":70065,"_20617":118332,"_5":14139,"_27008":118014,"_2880":52710},[],{"_3394":70187,"_29710":70065,"_20617":118334,"_5":14139,"_27008":118014,"_2880":52713},[],{"_3394":70188,"_29710":70065,"_20617":118336,"_5":14139,"_27008":118014,"_2880":52716},[],{"_3394":70189,"_29710":70065,"_20617":118338,"_5":14139,"_27008":118014,"_2880":52719},[],{"_3394":70190,"_29710":70065,"_20617":118340,"_5":14139,"_27008":118014,"_2880":118341},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3394":70191,"_29710":70065,"_20617":118343,"_5":14139,"_27008":118014,"_2880":118027},[],{"_3394":70192,"_29710":70065,"_20617":118345,"_5":14139,"_27008":118014,"_2880":52727},[],{"_3394":70193,"_29710":70065,"_20617":118347,"_5":14139,"_27008":118014,"_2880":52730},[],{"_3394":70194,"_29710":70065,"_20617":118349,"_5":14139,"_27008":118014,"_2880":52733},[],{"_3394":70195,"_29710":70065,"_20617":118351,"_5":14139,"_27008":118014,"_2880":52736},[],{"_3394":70196,"_29710":70065,"_20617":118353,"_5":14139,"_27008":118014,"_2880":118354},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3394":70197,"_29710":70065,"_20617":118356,"_5":14139,"_27008":118014,"_2880":118053},[],{"_3394":70198,"_29710":70065,"_20617":118358,"_5":14139,"_27008":118014,"_2880":52744},[],{"_3394":70199,"_29710":70065,"_20617":118360,"_5":14139,"_27008":118014,"_2880":118361},[],"Dispositivo",{"_3394":70200,"_29710":70065,"_20617":118363,"_5":14139,"_27008":118014,"_2880":52750},[],{"_3394":70201,"_29710":70065,"_20617":118365,"_5":14139,"_27008":118014,"_2880":52753},[],{"_3394":70202,"_29710":70065,"_20617":118367,"_5":14139,"_27008":118014,"_2880":118368},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3394":70203,"_29710":70065,"_20617":118370,"_5":14139,"_27008":118014,"_2880":118061},[],{"_3394":70204,"_29710":70065,"_20617":118372,"_5":14139,"_27008":118014,"_2880":52761},[],{"_3394":70205,"_29710":70065,"_20617":118374,"_5":14139,"_27008":118014,"_2880":118375},[],"Certificado",{"_3394":70206,"_29710":70065,"_20617":118377,"_5":14139,"_27008":118014,"_2880":52767},[],{"_3394":70207,"_29710":70065,"_20617":118379,"_5":14139,"_27008":118014,"_2880":118380},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3394":70208,"_29710":70065,"_20617":118382,"_5":14139,"_27008":118014,"_2880":118383},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3394":70209,"_29710":70065,"_20617":118385,"_5":14139,"_27008":118014,"_2880":118073},[],{"_3394":70210,"_29710":70065,"_20617":118387,"_5":14139,"_27008":118014,"_2880":52778},[],{"_3394":70211,"_29710":70065,"_20617":118389,"_5":14139,"_27008":118014,"_2880":118390},[],"Certificado / Dispositivo",{"_3394":70212,"_29710":70065,"_20617":118392,"_5":14139,"_27008":118014,"_2880":52784},[],{"_3394":70213,"_29710":70065,"_20617":118394,"_5":14139,"_27008":118014,"_2880":48797},[],{"_3394":70214,"_29710":70065,"_20617":118396,"_5":14139,"_27008":118014,"_2880":118397},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3394":70215,"_29710":70065,"_20617":118399,"_5":14139,"_27008":118014,"_2880":118081},[],{"_3394":70216,"_29710":70065,"_20617":118401,"_5":14139,"_27008":118018,"_2880":118402},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3394":70217,"_29710":70065,"_20617":118404,"_5":14139,"_27008":118022,"_2880":118405},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3394":70218,"_29710":70065,"_20617":118407,"_5":14139,"_27008":118022,"_2880":118408},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3394":70219,"_29710":70065,"_20617":118410,"_5":14139,"_27008":118026,"_2880":118411},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3394":70220,"_29710":70065,"_20617":118413,"_5":14139,"_27008":118026,"_2880":118414},[],"Transición",{"_3394":70221,"_29710":70065,"_20617":118416,"_5":14139,"_27008":118026,"_2880":118417},[],"Llamadas AWS",{"_3394":70222,"_29710":70065,"_20617":118419,"_5":14139,"_27008":118026,"_2880":118420},[],"`NoRegistrada` → `Solicitada`",{"_3394":70223,"_29710":70065,"_20617":118422,"_5":14139,"_27008":118026,"_2880":118423},[],"ninguna (solo escritura de metadatos)",{"_3394":70224,"_29710":70065,"_20617":118425,"_5":14139,"_27008":118026,"_2880":118426},[],"`Solicitada` → `Registrando`",{"_3394":70225,"_29710":70065,"_20617":118428,"_5":14139,"_27008":118026,"_2880":118429},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3394":70226,"_29710":70065,"_20617":118431,"_5":14139,"_27008":118026,"_2880":118432},[],"`Registrando` → `Completada`",{"_3394":70227,"_29710":70065,"_20617":118434,"_5":14139,"_27008":118026,"_2880":118435},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3394":70228,"_29710":70065,"_20617":118437,"_5":14139,"_27008":118026,"_2880":118438},[],"`Registrando` → `Fallida`",{"_3394":70229,"_29710":70065,"_20617":118440,"_5":14139,"_27008":118026,"_2880":118441},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3394":70230,"_29710":70065,"_20617":118443,"_5":14139,"_27008":118026,"_2880":118444},[],"`Fallida` / `Completada` → `Solicitada`",{"_3394":70231,"_29710":70065,"_20617":118446,"_5":14139,"_27008":118026,"_2880":118447},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3394":70232,"_29710":70065,"_20617":118449,"_5":14139,"_27008":118030,"_2880":118450},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3394":70233,"_29710":70065,"_20617":118452,"_5":14139,"_27008":118030,"_2880":118453},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3394":70234,"_29710":70065,"_20617":118455,"_5":14139,"_27008":118030,"_2880":118456},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3394":70235,"_29710":70065,"_20617":118458,"_5":14139,"_27008":118030,"_2880":118459},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3394":70236,"_29710":70065,"_20617":118461,"_5":14139,"_27008":118030,"_2880":118462},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3394":70237,"_29710":70065,"_20617":118464,"_5":14139,"_27008":118030,"_2880":118465},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3394":70238,"_29710":70065,"_20617":118467,"_5":14139,"_27008":118033,"_2880":118468},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3394":70239,"_29710":70065,"_20617":118470,"_5":14139,"_27008":118036,"_2880":118471},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3394":70240,"_29710":70065,"_20617":118473,"_5":14139,"_27008":118036,"_2880":118474},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3394":70241,"_29710":70065,"_20617":118476,"_5":14139,"_27008":118040,"_2880":118477},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3394":70242,"_29710":70065,"_20617":118479,"_5":14139,"_27008":118044,"_2880":118480},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3394":70243,"_29710":70065,"_20617":118482,"_5":14139,"_27008":118044,"_2880":118483},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3394":70244,"_29710":70065,"_20617":118485,"_5":14139,"_27008":118044,"_2880":118486},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3394":70245,"_29710":70065,"_20617":118488,"_5":14139,"_27008":118044,"_2880":118489},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3394":70246,"_29710":70065,"_20617":118491,"_5":14139,"_27008":118044,"_2880":118492},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3394":70247,"_29710":70065,"_20617":118494,"_5":14139,"_27008":118044,"_2880":118495},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3394":70248,"_29710":70065,"_20617":118497,"_5":14139,"_27008":118048,"_2880":118498},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3394":70249,"_29710":70065,"_20617":118500,"_5":14139,"_27008":118048,"_2880":118501},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3394":70250,"_29710":70065,"_20617":118503,"_5":14139,"_27008":118048,"_2880":118504},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3394":70251,"_29710":70065,"_20617":118506,"_5":14139,"_27008":118048,"_2880":118507},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3394":70252,"_29710":70065,"_20617":118509,"_5":14139,"_27008":118048,"_2880":118510},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3394":70253,"_29710":70065,"_20617":118512,"_5":14139,"_27008":118052,"_2880":118513},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3394":70254,"_29710":70065,"_20617":118515,"_5":14139,"_27008":118052,"_2880":118414},[],{"_3394":70255,"_29710":70065,"_20617":118517,"_5":14139,"_27008":118052,"_2880":118417},[],{"_3394":70256,"_29710":70065,"_20617":118519,"_5":14139,"_27008":118052,"_2880":118520},[],"`SinConfigurar` → `None` / `Auto`",{"_3394":70257,"_29710":70065,"_20617":118522,"_5":14139,"_27008":118052,"_2880":118523},[],"ninguna (solo configuración)",{"_3394":70258,"_29710":70065,"_20617":118525,"_5":14139,"_27008":118052,"_2880":52921},[],{"_3394":70259,"_29710":70065,"_20617":118527,"_5":14139,"_27008":118052,"_2880":118523},[],{"_3394":70260,"_29710":70065,"_20617":118529,"_5":14139,"_27008":118052,"_2880":118530},[],"Cualquiera → `Jitp`",{"_3394":70261,"_29710":70065,"_20617":118532,"_5":14139,"_27008":118052,"_2880":118533},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3394":70262,"_29710":70065,"_20617":118535,"_5":14139,"_27008":118052,"_2880":52932},[],{"_3394":70263,"_29710":70065,"_20617":118537,"_5":14139,"_27008":118052,"_2880":118538},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3394":70264,"_29710":70065,"_20617":118540,"_5":14139,"_27008":118056,"_2880":118541},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3394":70265,"_29710":70065,"_20617":118543,"_5":14139,"_27008":118056,"_2880":118544},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3394":70266,"_29710":70065,"_20617":118546,"_5":14139,"_27008":118056,"_2880":118547},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3394":70267,"_29710":70065,"_20617":118549,"_5":14139,"_27008":118060,"_2880":118550},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3394":70268,"_29710":70065,"_20617":118552,"_5":14139,"_27008":118060,"_2880":118414},[],{"_3394":70269,"_29710":70065,"_20617":118554,"_5":14139,"_27008":118060,"_2880":118417},[],{"_3394":70270,"_29710":70065,"_20617":118556,"_5":14139,"_27008":118060,"_2880":118557},[],"`Ausente` → `Aprovisionado`",{"_3394":70271,"_29710":70065,"_20617":118559,"_5":14139,"_27008":118060,"_2880":118560},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3394":70272,"_29710":70065,"_20617":118562,"_5":14139,"_27008":118060,"_2880":118563},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3394":70273,"_29710":70065,"_20617":118565,"_5":14139,"_27008":118060,"_2880":118566},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3394":70274,"_29710":70065,"_20617":118568,"_5":14139,"_27008":118060,"_2880":118569},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3394":70275,"_29710":70065,"_20617":118571,"_5":14139,"_27008":118064,"_2880":118572},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3394":70276,"_29710":70065,"_20617":118574,"_5":14139,"_27008":118064,"_2880":118575},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3394":70277,"_29710":70065,"_20617":118577,"_5":14139,"_27008":118064,"_2880":118578},[],"Para que el flujo JITP funcione correctamente:",{"_3394":70278,"_29710":70065,"_20617":118580,"_5":14139,"_27008":118064,"_2880":118581},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3394":70279,"_29710":70065,"_20617":118583,"_5":14139,"_27008":118064,"_2880":118584},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3394":70280,"_29710":70065,"_20617":118586,"_5":14139,"_27008":118064,"_2880":118587},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3394":70281,"_29710":70065,"_20617":118589,"_5":14139,"_27008":118064,"_2880":118590},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3394":70282,"_29710":70065,"_20617":118592,"_5":14139,"_27008":118068,"_2880":118593},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3394":70283,"_29710":70065,"_20617":118595,"_5":14139,"_27008":118068,"_2880":118596},[],"Estado en Lamassu",{"_3394":70284,"_29710":70065,"_20617":118598,"_5":14139,"_27008":118068,"_2880":118599},[],"Razón de revocación",{"_3394":70285,"_29710":70065,"_20617":118601,"_5":14139,"_27008":118068,"_2880":118602},[],"Estado en AWS IoT Core",{"_3394":70286,"_29710":70065,"_20617":118604,"_5":14139,"_27008":118068,"_2880":53002},[],{"_3394":70287,"_29710":70065,"_20617":118606,"_5":14139,"_27008":118068,"_2880":118607},[],"Ninguna",{"_3394":70288,"_29710":70065,"_20617":118609,"_5":14139,"_27008":118068,"_2880":53008},[],{"_3394":70289,"_29710":70065,"_20617":118611,"_5":14139,"_27008":118068,"_2880":53011},[],{"_3394":70290,"_29710":70065,"_20617":118613,"_5":14139,"_27008":118068,"_2880":53014},[],{"_3394":70291,"_29710":70065,"_20617":118615,"_5":14139,"_27008":118068,"_2880":53017},[],{"_3394":70292,"_29710":70065,"_20617":118617,"_5":14139,"_27008":118068,"_2880":53011},[],{"_3394":70293,"_29710":70065,"_20617":118619,"_5":14139,"_27008":118068,"_2880":118620},[],"Cualquier otra razón",{"_3394":70294,"_29710":70065,"_20617":118622,"_5":14139,"_27008":118068,"_2880":53025},[],{"_3394":70295,"_29710":70065,"_20617":118624,"_5":14139,"_27008":118068,"_2880":118625},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3394":70296,"_29710":70065,"_20617":118627,"_5":14139,"_27008":118072,"_2880":118628},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3394":70297,"_29710":70065,"_20617":118630,"_5":14139,"_27008":118072,"_2880":118414},[],{"_3394":70298,"_29710":70065,"_20617":118632,"_5":14139,"_27008":118072,"_2880":118417},[],{"_3394":70299,"_29710":70065,"_20617":118634,"_5":14139,"_27008":118072,"_2880":118635},[],"`NoSincronizado` → `Active`",{"_3394":70300,"_29710":70065,"_20617":118637,"_5":14139,"_27008":118072,"_2880":52517},[],{"_3394":70301,"_29710":70065,"_20617":118639,"_5":14139,"_27008":118072,"_2880":53043},[],{"_3394":70302,"_29710":70065,"_20617":118641,"_5":14139,"_27008":118072,"_2880":118642},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3394":70303,"_29710":70065,"_20617":118644,"_5":14139,"_27008":118072,"_2880":53049},[],{"_3394":70304,"_29710":70065,"_20617":118646,"_5":14139,"_27008":118072,"_2880":118642},[],{"_3394":70305,"_29710":70065,"_20617":118648,"_5":14139,"_27008":118072,"_2880":53054},[],{"_3394":70306,"_29710":70065,"_20617":118650,"_5":14139,"_27008":118072,"_2880":52517},[],{"_3394":70307,"_29710":70065,"_20617":118652,"_5":14139,"_27008":118072,"_2880":53059},[],{"_3394":70308,"_29710":70065,"_20617":118654,"_5":14139,"_27008":118072,"_2880":118655},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3394":70309,"_29710":70065,"_20617":118657,"_5":14139,"_27008":118076,"_2880":118658},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3394":70310,"_29710":70065,"_20617":118660,"_5":14139,"_27008":118076,"_2880":118661},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3394":70311,"_29710":70065,"_20617":118663,"_5":14139,"_27008":118076,"_2880":118664},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3394":70312,"_29710":70065,"_20617":118666,"_5":14139,"_27008":118080,"_2880":118667},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3394":70313,"_29710":70065,"_20617":118669,"_5":14139,"_27008":118080,"_2880":118670},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3394":70314,"_29710":70065,"_20617":118672,"_5":14139,"_27008":118084,"_2880":118673},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3394":70315,"_29710":70065,"_20617":118675,"_5":14139,"_27008":118084,"_2880":118676},[],"Existen dos tipos de acciones:",{"_3394":70316,"_29710":70065,"_20617":118678,"_5":14139,"_27008":118084,"_2880":118679},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3394":70317,"_29710":70065,"_20617":118681,"_5":14139,"_27008":118084,"_2880":118682},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3394":70318,"_29710":70065,"_20617":118684,"_5":14139,"_27008":118084,"_2880":118685},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3394":70319,"_29710":70065,"_20617":118687,"_5":14139,"_27008":118088,"_2880":118688},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3394":70320,"_29710":70065,"_20617":118690,"_5":14139,"_27008":118088,"_2880":118691},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3394":70321,"_29710":70065,"_20617":118693,"_5":14139,"_27008":118088,"_2880":118694},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3394":70322,"_29710":70065,"_20617":118696,"_5":14139,"_27008":118092,"_2880":118697},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3394":70323,"_29710":70065,"_20617":118699,"_5":14139,"_27008":118092,"_2880":118700},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3394":70324,"_29710":70065,"_20617":118702,"_5":14139,"_27008":118092,"_2880":118703},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3394":70325,"_29710":70065,"_20617":118705,"_5":14139,"_27008":118092,"_2880":118706},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3394":70326,"_29710":70065,"_20617":118708,"_5":14139,"_27008":118092,"_2880":118709},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3394":70327,"_29710":70065,"_20617":118711,"_5":14139,"_27008":118092,"_2880":118712},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3394":70328,"_29710":70065,"_20617":118714,"_5":14139,"_27008":118092,"_2880":118715},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3394":70329,"_29710":70065,"_20617":118717,"_5":14139,"_27008":118092,"_2880":118718},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3394":70330,"_29710":70065,"_20617":118720,"_5":14139,"_27008":118092,"_2880":118721},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3394":70331,"_29710":70065,"_20617":118723,"_5":14139,"_27008":118092,"_2880":118724},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3394":70332,"_29710":70065,"_20617":118726,"_5":14139,"_27008":118092,"_2880":118727},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3394":70333,"_29710":70065,"_20617":118729,"_5":14139,"_27008":118092,"_2880":118730},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3394":70334,"_29710":70065,"_20617":118732,"_5":14139,"_27008":118092,"_2880":118733},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3394":70335,"_29710":70065,"_20617":118735,"_5":14139,"_27008":118092,"_2880":118736},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3394":70336,"_29710":70065,"_20617":118738,"_5":14139,"_27008":118092,"_2880":118739},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3394":70337,"_29710":70065,"_20617":118741,"_5":14139,"_27008":118092,"_2880":118742},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3394":70338,"_29710":70065,"_20617":118744,"_5":14139,"_27008":118092,"_2880":118745},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3394":70339,"_29710":70065,"_20617":118747,"_5":14139,"_27008":118092,"_2880":118748},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3394":70340,"_29710":70065,"_20617":118750,"_5":14139,"_27008":118092,"_2880":118751},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3394":70341,"_29710":70065,"_20617":118753,"_5":14139,"_27008":118092,"_2880":118754},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3394":70342,"_29710":70065,"_20617":118756,"_5":14139,"_27008":118092,"_2880":118757},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3394":70343,"_29710":70065,"_20617":118759,"_5":14139,"_27008":118092,"_2880":118760},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3394":70344,"_29710":70065,"_20617":118762,"_5":14139,"_27008":118092,"_2880":118763},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3394":70345,"_29710":70065,"_20617":118765,"_5":14139,"_27008":118092,"_2880":118766},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3394":70346,"_29710":70346,"_5":14491,"_2880":50880,"_30063":118768,"_20617":118769,"_27008":70346},[48401,115575,50880],[],{"_3394":70347,"_29710":70346,"_20617":118771,"_5":14139,"_27008":70346,"_2880":118772},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3394":70348,"_29710":70346,"_5":30060,"_20617":118774,"_27008":118775,"_2880":118776},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3394":70349,"_29710":70346,"_5":30060,"_20617":118778,"_27008":118779,"_2880":116584},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3394":70350,"_29710":70346,"_5":30060,"_20617":118781,"_27008":118782,"_2880":116759},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3394":70351,"_29710":70346,"_5":30060,"_20617":118784,"_27008":118785,"_2880":117991},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/overview#integraciones",{"_3394":70352,"_29710":70346,"_5":30060,"_20617":118787,"_27008":118788,"_2880":118789},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3394":70353,"_29710":70346,"_20617":118791,"_5":14139,"_27008":70346,"_2880":118792},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3394":70354,"_29710":70346,"_20617":118794,"_5":14139,"_27008":118775,"_2880":118795},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3394":70355,"_29710":70346,"_20617":118797,"_5":14139,"_27008":118775,"_2880":118798},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3394":70356,"_29710":70346,"_20617":118800,"_5":14139,"_27008":118779,"_2880":118801},[],"Recurso",{"_3394":70357,"_29710":70346,"_20617":118803,"_5":14139,"_27008":118779,"_2880":118804},[],"Qué representa",{"_3394":70358,"_29710":70346,"_20617":118806,"_5":14139,"_27008":118779,"_2880":118807},[],"**Dispositivo**",{"_3394":70359,"_29710":70346,"_20617":118809,"_5":14139,"_27008":118779,"_2880":118810},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3394":70360,"_29710":70346,"_20617":118812,"_5":14139,"_27008":118779,"_2880":118813},[],"**Identidad**",{"_3394":70361,"_29710":70346,"_20617":118815,"_5":14139,"_27008":118779,"_2880":118816},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3394":70362,"_29710":70346,"_20617":118818,"_5":14139,"_27008":118779,"_2880":53226},[],{"_3394":70363,"_29710":70346,"_20617":118820,"_5":14139,"_27008":118779,"_2880":118821},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3394":70364,"_29710":70346,"_20617":118823,"_5":14139,"_27008":118779,"_2880":118824},[],"**Flota**",{"_3394":70365,"_29710":70346,"_20617":118826,"_5":14139,"_27008":118779,"_2880":118827},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3394":70366,"_29710":70346,"_20617":118829,"_5":14139,"_27008":118779,"_2880":118830},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3394":70367,"_29710":70346,"_20617":118832,"_5":14139,"_27008":118779,"_2880":118833},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3394":70368,"_29710":70346,"_20617":118835,"_5":14139,"_27008":118782,"_2880":118836},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3394":70369,"_29710":70346,"_20617":118838,"_5":14139,"_27008":118782,"_2880":118839},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3394":70370,"_29710":70346,"_20617":118841,"_5":14139,"_27008":118782,"_2880":118842},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3394":70371,"_29710":70346,"_20617":118844,"_5":14139,"_27008":118782,"_2880":118845},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3394":70372,"_29710":70346,"_20617":118847,"_5":14139,"_27008":118782,"_2880":118848},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3394":70373,"_29710":70346,"_20617":118850,"_5":14139,"_27008":118782,"_2880":118851},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3394":70374,"_29710":70346,"_20617":118853,"_5":14139,"_27008":118782,"_2880":118854},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3394":70375,"_29710":70346,"_20617":118856,"_5":14139,"_27008":118782,"_2880":118857},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3394":70376,"_29710":70346,"_20617":118859,"_5":14139,"_27008":118785,"_2880":118860},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3394":70377,"_29710":70346,"_20617":118862,"_5":14139,"_27008":118785,"_2880":118863},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3394":70378,"_29710":70346,"_20617":118865,"_5":14139,"_27008":118788,"_2880":118866},[],"Participante",{"_3394":70379,"_29710":70346,"_20617":118868,"_5":14139,"_27008":118788,"_2880":118869},[],"Responsabilidad",{"_3394":70380,"_29710":70346,"_20617":118871,"_5":14139,"_27008":118788,"_2880":118872},[],"Administrador PKI",{"_3394":70381,"_29710":70346,"_20617":118874,"_5":14139,"_27008":118788,"_2880":118875},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3394":70382,"_29710":70346,"_20617":118877,"_5":14139,"_27008":118788,"_2880":118878},[],"Administrador del aprovisionamiento",{"_3394":70383,"_29710":70346,"_20617":118880,"_5":14139,"_27008":118788,"_2880":118881},[],"DMS, admisión, autenticación por operación e inventario.",{"_3394":70384,"_29710":70346,"_20617":118883,"_5":14139,"_27008":118788,"_2880":118884},[],"Integrador del dispositivo",{"_3394":70385,"_29710":70346,"_20617":118886,"_5":14139,"_27008":118788,"_2880":118887},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3394":70386,"_29710":70346,"_20617":118889,"_5":14139,"_27008":118788,"_2880":118890},[],"Integrador del consumidor",{"_3394":70387,"_29710":70346,"_20617":118892,"_5":14139,"_27008":118788,"_2880":118893},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3394":70388,"_29710":70346,"_20617":118895,"_5":14139,"_27008":118788,"_2880":118896},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3394":70389,"_29710":70389,"_5":14491,"_2880":118898,"_30063":118899,"_20617":118901,"_27008":70389},"Enrola y conecta tu primer dispositivo",[48401,115575,50880,118900],"Primeros pasos",[],{"_3394":70390,"_29710":70389,"_20617":118903,"_5":14139,"_27008":70389,"_2880":118904},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3394":70391,"_29710":70389,"_5":30060,"_20617":118906,"_27008":118907,"_2880":114153},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3394":70392,"_29710":70389,"_5":30060,"_20617":118909,"_27008":118910,"_2880":118911},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3394":70393,"_29710":70389,"_5":30060,"_20617":118913,"_27008":118914,"_2880":118915},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3394":70394,"_29710":70389,"_5":30060,"_20617":118917,"_27008":118918,"_2880":118919},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3394":70395,"_29710":70389,"_5":30060,"_20617":118921,"_27008":118922,"_2880":118923},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3394":70396,"_29710":70389,"_5":30060,"_20617":118925,"_27008":118926,"_2880":118927},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3394":70397,"_29710":70389,"_5":30060,"_20617":118929,"_27008":118930,"_2880":118931},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3394":70398,"_29710":70389,"_5":30060,"_20617":118933,"_27008":118934,"_2880":118935},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3394":70399,"_29710":70389,"_20617":118937,"_5":14139,"_27008":70389,"_2880":118938},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3394":70400,"_29710":70389,"_20617":118940,"_5":14139,"_27008":118907,"_2880":118941},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3394":70401,"_29710":70389,"_20617":118943,"_5":14139,"_27008":118907,"_2880":118944},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3394":70402,"_29710":70389,"_20617":118946,"_5":14139,"_27008":118907,"_2880":118947},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3394":70403,"_29710":70389,"_20617":118949,"_5":14139,"_27008":118907,"_2880":118950},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3394":70404,"_29710":70389,"_20617":118952,"_5":14139,"_27008":118907,"_2880":118953},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3394":70405,"_29710":70389,"_20617":118955,"_5":14139,"_27008":118910,"_2880":118956},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3394":70406,"_29710":70389,"_20617":118958,"_5":14139,"_27008":118910,"_2880":118959},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3394":70407,"_29710":70389,"_20617":118961,"_5":14139,"_27008":118914,"_2880":118962},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3394":70408,"_29710":70389,"_20617":118964,"_5":14139,"_27008":118914,"_2880":118965},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3394":70409,"_29710":70389,"_20617":118967,"_5":14139,"_27008":118914,"_2880":118968},[],"Ajuste",{"_3394":70410,"_29710":70389,"_20617":118970,"_5":14139,"_27008":118914,"_2880":118971},[],"Valor de evaluación",{"_3394":70411,"_29710":70389,"_20617":118973,"_5":14139,"_27008":118914,"_2880":53382},[],{"_3394":70412,"_29710":70389,"_20617":118975,"_5":14139,"_27008":118914,"_2880":118976},[],"Raíz emisora de `device-root.pem`.",{"_3394":70413,"_29710":70389,"_20617":118978,"_5":14139,"_27008":118914,"_2880":116887},[],{"_3394":70414,"_29710":70389,"_20617":118980,"_5":14139,"_27008":118914,"_2880":118981},[],"Perfil final de 1 hora que acabas de preparar.",{"_3394":70415,"_29710":70389,"_20617":118983,"_5":14139,"_27008":118914,"_2880":53393},[],{"_3394":70416,"_29710":70389,"_20617":118985,"_5":14139,"_27008":118914,"_2880":53396},[],{"_3394":70417,"_29710":70389,"_20617":118987,"_5":14139,"_27008":118914,"_2880":53399},[],{"_3394":70418,"_29710":70389,"_20617":118989,"_5":14139,"_27008":118914,"_2880":118990},[],"Habilitado.",{"_3394":70419,"_29710":70389,"_20617":118992,"_5":14139,"_27008":118914,"_2880":53405},[],{"_3394":70420,"_29710":70389,"_20617":118994,"_5":14139,"_27008":118914,"_2880":118995},[],"Deshabilitado; el ID debe ser nuevo.",{"_3394":70421,"_29710":70389,"_20617":118997,"_5":14139,"_27008":118914,"_2880":118998},[],"Autenticación inicial",{"_3394":70422,"_29710":70389,"_20617":119000,"_5":14139,"_27008":118914,"_2880":119001},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3394":70423,"_29710":70389,"_20617":119003,"_5":14139,"_27008":118914,"_2880":119004},[],"Autenticación de renovación",{"_3394":70424,"_29710":70389,"_20617":119006,"_5":14139,"_27008":118914,"_2880":119007},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3394":70425,"_29710":70389,"_20617":119009,"_5":14139,"_27008":118914,"_2880":53423},[],{"_3394":70426,"_29710":70389,"_20617":119011,"_5":14139,"_27008":118914,"_2880":119012},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3394":70427,"_29710":70389,"_20617":119014,"_5":14139,"_27008":118914,"_2880":53429},[],{"_3394":70428,"_29710":70389,"_20617":119016,"_5":14139,"_27008":118914,"_2880":119017},[],"1 hora.",{"_3394":70429,"_29710":70389,"_20617":119019,"_5":14139,"_27008":118914,"_2880":53435},[],{"_3394":70430,"_29710":70389,"_20617":119021,"_5":14139,"_27008":118914,"_2880":119022},[],"30 minutos / 10 minutos.",{"_3394":70431,"_29710":70389,"_20617":119024,"_5":14139,"_27008":118914,"_2880":53441},[],{"_3394":70432,"_29710":70389,"_20617":119026,"_5":14139,"_27008":118914,"_2880":119027},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3394":70433,"_29710":70389,"_20617":119029,"_5":14139,"_27008":118914,"_2880":51199},[],{"_3394":70434,"_29710":70389,"_20617":119031,"_5":14139,"_27008":118914,"_2880":119032},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3394":70435,"_29710":70389,"_20617":119034,"_5":14139,"_27008":118914,"_2880":53452},[],{"_3394":70436,"_29710":70389,"_20617":119036,"_5":14139,"_27008":118914,"_2880":119037},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3394":70437,"_29710":70389,"_20617":119039,"_5":14139,"_27008":118914,"_2880":119040},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3394":70438,"_29710":70389,"_20617":119042,"_5":14139,"_27008":118918,"_2880":119043},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3394":70439,"_29710":70389,"_20617":119045,"_5":14139,"_27008":118918,"_2880":119046},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3394":70440,"_29710":70389,"_20617":119048,"_5":14139,"_27008":118922,"_2880":119049},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3394":70441,"_29710":70389,"_20617":119051,"_5":14139,"_27008":118922,"_2880":119052},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3394":70442,"_29710":70389,"_20617":119054,"_5":14139,"_27008":118922,"_2880":119055},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3394":70443,"_29710":70389,"_20617":119057,"_5":14139,"_27008":118926,"_2880":119058},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3394":70444,"_29710":70389,"_20617":119060,"_5":14139,"_27008":118926,"_2880":119061},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3394":70445,"_29710":70389,"_20617":119063,"_5":14139,"_27008":118930,"_2880":119064},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3394":70446,"_29710":70389,"_20617":119066,"_5":14139,"_27008":118930,"_2880":119067},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3394":70447,"_29710":70389,"_20617":119069,"_5":14139,"_27008":118930,"_2880":119070},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3394":70448,"_29710":70389,"_20617":119072,"_5":14139,"_27008":118930,"_2880":119073},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3394":70449,"_29710":70389,"_20617":119075,"_5":14139,"_27008":118930,"_2880":119076},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3394":70450,"_29710":70389,"_20617":119078,"_5":14139,"_27008":118934,"_2880":119079},[],"Comprobación",{"_3394":70451,"_29710":70389,"_20617":119081,"_5":14139,"_27008":118934,"_2880":119082},[],"Resultado esperado",{"_3394":70452,"_29710":70389,"_20617":119084,"_5":14139,"_27008":118934,"_2880":119085},[],"Registro",{"_3394":70453,"_29710":70389,"_20617":119087,"_5":14139,"_27008":118934,"_2880":119088},[],"ID creado automáticamente y DMS correcto.",{"_3394":70454,"_29710":70389,"_20617":119090,"_5":14139,"_27008":118934,"_2880":118375},[],{"_3394":70455,"_29710":70389,"_20617":119092,"_5":14139,"_27008":118934,"_2880":119093},[],"CN, perfil, serie y clave verificados.",{"_3394":70456,"_29710":70389,"_20617":119095,"_5":14139,"_27008":118934,"_2880":119096},[],"Inventario",{"_3394":70457,"_29710":70389,"_20617":119098,"_5":14139,"_27008":118934,"_2880":119099},[],"Serie recibida visible como identidad actual y en el historial.",{"_3394":70458,"_29710":70389,"_20617":119101,"_5":14139,"_27008":118934,"_2880":119102},[],"Consumidor",{"_3394":70459,"_29710":70389,"_20617":119104,"_5":14139,"_27008":118934,"_2880":119105},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3394":70460,"_29710":70389,"_20617":119107,"_5":14139,"_27008":118934,"_2880":119108},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3394":70461,"_29710":70389,"_20617":119110,"_5":14139,"_27008":118934,"_2880":119111},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3394":70462,"_29710":70462,"_5":14491,"_2880":116601,"_30063":119113,"_20617":119114,"_27008":70462},[48401,115575,50880,118900],[],{"_3394":70463,"_29710":70462,"_20617":119116,"_5":14139,"_27008":70462,"_2880":119117},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3394":70464,"_29710":70462,"_5":30060,"_20617":119119,"_27008":119120,"_2880":114153},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3394":70465,"_29710":70462,"_5":30060,"_20617":119122,"_27008":119123,"_2880":119124},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3394":70466,"_29710":70462,"_5":30060,"_20617":119126,"_27008":119127,"_2880":119128},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3394":70467,"_29710":70462,"_5":30060,"_20617":119130,"_27008":119131,"_2880":119132},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3394":70468,"_29710":70462,"_5":30060,"_20617":119134,"_27008":119135,"_2880":119136},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3394":70469,"_29710":70462,"_5":30060,"_20617":119138,"_27008":119139,"_2880":119140},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3394":70470,"_29710":70462,"_5":30060,"_20617":119142,"_27008":119143,"_2880":119082},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3394":70471,"_29710":70462,"_5":30060,"_20617":119145,"_27008":119146,"_2880":119147},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3394":70472,"_29710":70462,"_5":30060,"_20617":119149,"_27008":119150,"_2880":119151},[],"/docs/pr-preview/pr-59/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3394":70473,"_29710":70462,"_20617":119153,"_5":14139,"_27008":70462,"_2880":119154},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3394":70474,"_29710":70462,"_20617":119156,"_5":14139,"_27008":70462,"_2880":119157},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3394":70475,"_29710":70462,"_20617":119159,"_5":14139,"_27008":119120,"_2880":119160},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3394":70476,"_29710":70462,"_20617":119162,"_5":14139,"_27008":119120,"_2880":119163},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3394":70477,"_29710":70462,"_20617":119165,"_5":14139,"_27008":119120,"_2880":119166},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3394":70478,"_29710":70462,"_20617":119168,"_5":14139,"_27008":119120,"_2880":119169},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3394":70479,"_29710":70462,"_20617":119171,"_5":14139,"_27008":119123,"_2880":119172},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3394":70480,"_29710":70462,"_20617":119174,"_5":14139,"_27008":119123,"_2880":119175},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3394":70481,"_29710":70462,"_20617":119177,"_5":14139,"_27008":119123,"_2880":119178},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3394":70482,"_29710":70462,"_20617":119180,"_5":14139,"_27008":119123,"_2880":119181},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3394":70483,"_29710":70462,"_20617":119183,"_5":14139,"_27008":119123,"_2880":119184},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3394":70484,"_29710":70462,"_20617":119186,"_5":14139,"_27008":119123,"_2880":119187},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3394":70485,"_29710":70462,"_20617":119189,"_5":14139,"_27008":119123,"_2880":119190},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3394":70486,"_29710":70462,"_20617":119192,"_5":14139,"_27008":119123,"_2880":119193},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3394":70487,"_29710":70462,"_20617":119195,"_5":14139,"_27008":119127,"_2880":119196},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3394":70488,"_29710":70462,"_20617":119198,"_5":14139,"_27008":119127,"_2880":53617},[],{"_3394":70489,"_29710":70462,"_20617":119200,"_5":14139,"_27008":119127,"_2880":119201},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3394":70490,"_29710":70462,"_20617":119203,"_5":14139,"_27008":119127,"_2880":119204},[],"**Icon** y **Tags**: clasificación opcional.",{"_3394":70491,"_29710":70462,"_20617":119206,"_5":14139,"_27008":119127,"_2880":119207},[],"Confirma el registro.",{"_3394":70492,"_29710":70462,"_20617":119209,"_5":14139,"_27008":119131,"_2880":119210},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3394":70493,"_29710":70462,"_20617":119212,"_5":14139,"_27008":119131,"_2880":119213},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3394":70494,"_29710":70462,"_20617":119215,"_5":14139,"_27008":119135,"_2880":119216},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3394":70495,"_29710":70462,"_20617":119218,"_5":14139,"_27008":119135,"_2880":119219},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3394":70496,"_29710":70462,"_20617":119221,"_5":14139,"_27008":119139,"_2880":119222},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3394":70497,"_29710":70462,"_20617":119224,"_5":14139,"_27008":119139,"_2880":119225},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3394":70498,"_29710":70462,"_20617":119227,"_5":14139,"_27008":119143,"_2880":119079},[],{"_3394":70499,"_29710":70462,"_20617":119229,"_5":14139,"_27008":119143,"_2880":119230},[],"Resultado",{"_3394":70500,"_29710":70462,"_20617":119232,"_5":14139,"_27008":119143,"_2880":118361},[],{"_3394":70501,"_29710":70462,"_20617":119234,"_5":14139,"_27008":119143,"_2880":119235},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3394":70502,"_29710":70462,"_20617":119237,"_5":14139,"_27008":119143,"_2880":119238},[],"Identidad actual",{"_3394":70503,"_29710":70462,"_20617":119240,"_5":14139,"_27008":119143,"_2880":119241},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3394":70504,"_29710":70462,"_20617":119243,"_5":14139,"_27008":119143,"_2880":119244},[],"Historial",{"_3394":70505,"_29710":70462,"_20617":119246,"_5":14139,"_27008":119143,"_2880":119247},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3394":70506,"_29710":70462,"_20617":119249,"_5":14139,"_27008":119143,"_2880":119250},[],"Clave y certificado",{"_3394":70507,"_29710":70462,"_20617":119252,"_5":14139,"_27008":119143,"_2880":119253},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3394":70508,"_29710":70462,"_20617":119255,"_5":14139,"_27008":119146,"_2880":119256},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3394":70509,"_29710":70462,"_20617":119258,"_5":14139,"_27008":119146,"_2880":119259},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3394":70510,"_29710":70462,"_20617":119261,"_5":14139,"_27008":119146,"_2880":119262},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3394":70511,"_29710":70462,"_20617":119264,"_5":14139,"_27008":119146,"_2880":119265},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3394":70512,"_29710":70462,"_20617":119267,"_5":14139,"_27008":119150,"_2880":119268},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3394":70513,"_29710":70462,"_20617":119270,"_5":14139,"_27008":119150,"_2880":119271},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3394":70514,"_29710":70462,"_20617":119273,"_5":14139,"_27008":119150,"_2880":119274},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3394":70515,"_29710":70515,"_5":14491,"_2880":119276,"_30063":119277,"_20617":119278,"_27008":70515},"Plataforma Lamassu IoT",[48401,115575],[],{"_3394":70516,"_29710":70515,"_20617":119280,"_5":14139,"_27008":70515,"_2880":119281},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3394":70517,"_29710":70515,"_5":30060,"_20617":119283,"_27008":119284,"_2880":118776},[],"/docs/pr-preview/pr-59/es/platform/overview#empieza-aquí",{"_3394":70518,"_29710":70515,"_5":30060,"_20617":119286,"_27008":119287,"_2880":119288},[],"/docs/pr-preview/pr-59/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3394":70519,"_29710":70515,"_5":30060,"_20617":119290,"_27008":119291,"_2880":119292},[],"/docs/pr-preview/pr-59/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3394":70520,"_29710":70515,"_5":30060,"_20617":119294,"_27008":119295,"_2880":119296},[],"/docs/pr-preview/pr-59/es/platform/overview#capacidades-principales","Capacidades principales",{"_3394":70521,"_29710":70515,"_5":30060,"_20617":119298,"_27008":119299,"_2880":119300},[],"/docs/pr-preview/pr-59/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3394":70522,"_29710":70515,"_5":30060,"_20617":119302,"_27008":119303,"_2880":119304},[],"/docs/pr-preview/pr-59/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3394":70523,"_29710":70515,"_5":30060,"_20617":119306,"_27008":119307,"_2880":119308},[],"/docs/pr-preview/pr-59/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3394":70524,"_29710":70515,"_5":30060,"_20617":119310,"_27008":119311,"_2880":119312},[],"/docs/pr-preview/pr-59/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3394":70525,"_29710":70515,"_5":30060,"_20617":119314,"_27008":119315,"_2880":119316},[],"/docs/pr-preview/pr-59/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3394":70526,"_29710":70515,"_5":30060,"_20617":119318,"_27008":119319,"_2880":119320},[],"/docs/pr-preview/pr-59/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3394":70527,"_29710":70515,"_5":30060,"_20617":119322,"_27008":119323,"_2880":119324},[],"/docs/pr-preview/pr-59/es/platform/overview#referencia-operativa","Referencia operativa",{"_3394":70528,"_29710":70515,"_20617":119326,"_5":14139,"_27008":70515,"_2880":119327},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3394":70529,"_29710":70515,"_20617":119329,"_5":14139,"_27008":119284,"_2880":119330},[],"Elige el resultado que necesitas obtener:",{"_3394":70530,"_29710":70515,"_20617":119332,"_5":14139,"_27008":119284,"_2880":119333},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3394":70531,"_29710":70515,"_20617":119335,"_5":14139,"_27008":119284,"_2880":119336},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3394":70532,"_29710":70515,"_20617":119338,"_5":14139,"_27008":119284,"_2880":119339},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3394":70533,"_29710":70515,"_20617":119341,"_5":14139,"_27008":119287,"_2880":119342},[],"Bloque",{"_3394":70534,"_29710":70515,"_20617":119344,"_5":14139,"_27008":119287,"_2880":119345},[],"Qué gestionas",{"_3394":70535,"_29710":70515,"_20617":119347,"_5":14139,"_27008":119287,"_2880":119348},[],"Punto de entrada",{"_3394":70536,"_29710":70515,"_20617":119350,"_5":14139,"_27008":119287,"_2880":53770},[],{"_3394":70537,"_29710":70515,"_20617":119352,"_5":14139,"_27008":119287,"_2880":119353},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3394":70538,"_29710":70515,"_20617":119355,"_5":14139,"_27008":119287,"_2880":119356},[],"Visión general de PKI",{"_3394":70539,"_29710":70515,"_20617":119358,"_5":14139,"_27008":119287,"_2880":53779},[],{"_3394":70540,"_29710":70515,"_20617":119360,"_5":14139,"_27008":119287,"_2880":119361},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3394":70541,"_29710":70515,"_20617":119363,"_5":14139,"_27008":119287,"_2880":119364},[],"Visión general de IoT Fleets",{"_3394":70542,"_29710":70515,"_20617":119366,"_5":14139,"_27008":119287,"_2880":119367},[],"**Administración**",{"_3394":70543,"_29710":70515,"_20617":119369,"_5":14139,"_27008":119287,"_2880":119370},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3394":70544,"_29710":70515,"_20617":119372,"_5":14139,"_27008":119287,"_2880":115573},[],{"_3394":70545,"_29710":70515,"_20617":119374,"_5":14139,"_27008":119287,"_2880":119375},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3394":70546,"_29710":70515,"_20617":119377,"_5":14139,"_27008":119291,"_2880":119378},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3394":70547,"_29710":70515,"_20617":119380,"_5":14139,"_27008":119291,"_2880":119381},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3394":70548,"_29710":70515,"_20617":119383,"_5":14139,"_27008":119291,"_2880":119384},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3394":70549,"_29710":70515,"_20617":119386,"_5":14139,"_27008":119291,"_2880":119387},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3394":70550,"_29710":70515,"_20617":119389,"_5":14139,"_27008":119291,"_2880":119390},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3394":70551,"_29710":70515,"_20617":119392,"_5":14139,"_27008":119291,"_2880":119393},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3394":70552,"_29710":70515,"_20617":119395,"_5":14139,"_27008":119299,"_2880":119396},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3394":70553,"_29710":70515,"_20617":119398,"_5":14139,"_27008":119303,"_2880":119399},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3394":70554,"_29710":70515,"_20617":119401,"_5":14139,"_27008":119307,"_2880":119402},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3394":70555,"_29710":70515,"_20617":119404,"_5":14139,"_27008":119311,"_2880":119405},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3394":70556,"_29710":70515,"_20617":119407,"_5":14139,"_27008":119315,"_2880":119408},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3394":70557,"_29710":70515,"_20617":119410,"_5":14139,"_27008":119319,"_2880":119411},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3394":70558,"_29710":70515,"_20617":119413,"_5":14139,"_27008":119323,"_2880":118869},[],{"_3394":70559,"_29710":70515,"_20617":119415,"_5":14139,"_27008":119323,"_2880":119416},[],"Qué prepara o comprueba",{"_3394":70560,"_29710":70515,"_20617":119418,"_5":14139,"_27008":119323,"_2880":118872},[],{"_3394":70561,"_29710":70515,"_20617":119420,"_5":14139,"_27008":119323,"_2880":119421},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3394":70562,"_29710":70515,"_20617":119423,"_5":14139,"_27008":119323,"_2880":119424},[],"Administrador de la flota",{"_3394":70563,"_29710":70515,"_20617":119426,"_5":14139,"_27008":119323,"_2880":119427},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3394":70564,"_29710":70515,"_20617":119429,"_5":14139,"_27008":119323,"_2880":118884},[],{"_3394":70565,"_29710":70515,"_20617":119431,"_5":14139,"_27008":119323,"_2880":119432},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3394":70566,"_29710":70515,"_20617":119434,"_5":14139,"_27008":119323,"_2880":118890},[],{"_3394":70567,"_29710":70515,"_20617":119436,"_5":14139,"_27008":119323,"_2880":119437},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3394":70568,"_29710":70515,"_20617":119439,"_5":14139,"_27008":119323,"_2880":119440},[],"Operador de infraestructura",{"_3394":70569,"_29710":70515,"_20617":119442,"_5":14139,"_27008":119323,"_2880":119443},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3394":70570,"_29710":70515,"_20617":119445,"_5":14139,"_27008":119323,"_2880":119446},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3394":70571,"_29710":70571,"_5":14491,"_2880":119448,"_30063":119449,"_20617":119451,"_27008":70571},"Jerarquía y rotación de CAs",[48401,115575,53871,119450],"Claves, autoridades y certificados",[],{"_3394":70572,"_29710":70571,"_20617":119453,"_5":14139,"_27008":70571,"_2880":119454},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3394":70573,"_29710":70571,"_5":30060,"_20617":119456,"_27008":119457,"_2880":119458},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3394":70574,"_29710":70571,"_5":30060,"_20617":119460,"_27008":119461,"_2880":119462},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3394":70575,"_29710":70571,"_5":30060,"_20617":119464,"_27008":119465,"_2880":119466},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3394":70576,"_29710":70571,"_5":30060,"_20617":119468,"_27008":119469,"_2880":119470},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3394":70577,"_29710":70571,"_5":30060,"_20617":119472,"_27008":119473,"_2880":119474},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3394":70578,"_29710":70571,"_5":30060,"_20617":119476,"_27008":119477,"_2880":119478},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3394":70579,"_29710":70571,"_5":30060,"_20617":119480,"_27008":119481,"_2880":119482},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3394":70580,"_29710":70571,"_5":30060,"_20617":119484,"_27008":119485,"_2880":119486},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3394":70581,"_29710":70571,"_5":30060,"_20617":119488,"_27008":119489,"_2880":119490},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3394":70582,"_29710":70571,"_5":30060,"_20617":119492,"_27008":119493,"_2880":119494},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3394":70583,"_29710":70571,"_5":30060,"_20617":119496,"_27008":119497,"_2880":119498},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3394":70584,"_29710":70571,"_5":30060,"_20617":119500,"_27008":119501,"_2880":119502},[],"/docs/pr-preview/pr-59/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3394":70585,"_29710":70571,"_20617":119504,"_5":14139,"_27008":70571,"_2880":119505},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3394":70586,"_29710":70571,"_20617":119507,"_5":14139,"_27008":70571,"_2880":119508},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3394":70587,"_29710":70571,"_20617":119510,"_5":14139,"_27008":119457,"_2880":119511},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3394":70588,"_29710":70571,"_20617":119513,"_5":14139,"_27008":119457,"_2880":119514},[],"entorno, como producción y preproducción;",{"_3394":70589,"_29710":70571,"_20617":119516,"_5":14139,"_27008":119457,"_2880":119517},[],"propietario o equipo operador;",{"_3394":70590,"_29710":70571,"_20617":119519,"_5":14139,"_27008":119457,"_2880":119520},[],"familia de dispositivos o proceso de fabricación;",{"_3394":70591,"_29710":70571,"_20617":119522,"_5":14139,"_27008":119457,"_2880":119523},[],"región o requisito regulatorio;",{"_3394":70592,"_29710":70571,"_20617":119525,"_5":14139,"_27008":119457,"_2880":119526},[],"motor criptográfico o política de clave;",{"_3394":70593,"_29710":70571,"_20617":119528,"_5":14139,"_27008":119457,"_2880":119529},[],"ventana de mantenimiento y ritmo de renovación.",{"_3394":70594,"_29710":70571,"_20617":119531,"_5":14139,"_27008":119457,"_2880":119532},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3394":70595,"_29710":70571,"_20617":119534,"_5":14139,"_27008":119457,"_2880":119535},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3394":70596,"_29710":70571,"_20617":119537,"_5":14139,"_27008":119461,"_2880":119538},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3394":70597,"_29710":70571,"_20617":119540,"_5":14139,"_27008":119461,"_2880":119541},[],"Si un rol VA de CRL de la CA está firmado por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para un rol firmado por otro certificado, el rol conserva su firmante, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3394":70598,"_29710":70571,"_20617":119543,"_5":14139,"_27008":119461,"_2880":119544},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3394":70599,"_29710":70571,"_20617":119546,"_5":14139,"_27008":119461,"_2880":119547},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3394":70600,"_29710":70571,"_20617":119549,"_5":14139,"_27008":119465,"_2880":119550},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3394":70601,"_29710":70571,"_20617":119552,"_5":14139,"_27008":119465,"_2880":119553},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3394":70602,"_29710":70571,"_20617":119555,"_5":14139,"_27008":119465,"_2880":119556},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3394":70603,"_29710":70571,"_20617":119558,"_5":14139,"_27008":119465,"_2880":119559},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3394":70604,"_29710":70571,"_20617":119561,"_5":14139,"_27008":119473,"_2880":119562},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3394":70605,"_29710":70571,"_20617":119564,"_5":14139,"_27008":119477,"_2880":119565},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3394":70606,"_29710":70571,"_20617":119567,"_5":14139,"_27008":119481,"_2880":119568},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3394":70607,"_29710":70571,"_20617":119570,"_5":14139,"_27008":119485,"_2880":119571},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3394":70608,"_29710":70571,"_20617":119573,"_5":14139,"_27008":119489,"_2880":119574},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3394":70609,"_29710":70571,"_20617":119576,"_5":14139,"_27008":119493,"_2880":119577},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3394":70610,"_29710":70571,"_20617":119579,"_5":14139,"_27008":119497,"_2880":119580},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3394":70611,"_29710":70571,"_20617":119582,"_5":14139,"_27008":119497,"_2880":119583},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3394":70612,"_29710":70571,"_20617":119585,"_5":14139,"_27008":119497,"_2880":119586},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3394":70613,"_29710":70571,"_20617":119588,"_5":14139,"_27008":119497,"_2880":119589},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3394":70614,"_29710":70571,"_20617":119591,"_5":14139,"_27008":119501,"_2880":119592},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3394":70615,"_29710":70571,"_20617":119594,"_5":14139,"_27008":119501,"_2880":119595},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3394":70616,"_29710":70571,"_20617":119597,"_5":14139,"_27008":119501,"_2880":119598},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3394":70617,"_29710":70571,"_20617":119600,"_5":14139,"_27008":119501,"_2880":119601},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3394":70618,"_29710":70571,"_20617":119603,"_5":14139,"_27008":119501,"_2880":119604},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3394":70619,"_29710":70571,"_20617":119606,"_5":14139,"_27008":119501,"_2880":119607},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3394":70620,"_29710":70571,"_20617":119609,"_5":14139,"_27008":119501,"_2880":119610},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3394":70621,"_29710":70621,"_5":14491,"_2880":119612,"_30063":119613,"_20617":119614,"_27008":70621},"Autoridades de certificación",[48401,115575,53871,119450],[],{"_3394":70622,"_29710":70621,"_20617":119616,"_5":14139,"_27008":70621,"_2880":119617},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3394":70623,"_29710":70621,"_5":30060,"_20617":119619,"_27008":119620,"_2880":119621},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3394":70624,"_29710":70621,"_5":30060,"_20617":119623,"_27008":119624,"_2880":119625},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3394":70625,"_29710":70621,"_5":30060,"_20617":119627,"_27008":119628,"_2880":114153},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3394":70626,"_29710":70621,"_5":30060,"_20617":119630,"_27008":119631,"_2880":119632},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3394":70627,"_29710":70621,"_5":30060,"_20617":119634,"_27008":119635,"_2880":119636},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3394":70628,"_29710":70621,"_5":30060,"_20617":119638,"_27008":119639,"_2880":119640},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3394":70629,"_29710":70621,"_5":30060,"_20617":119642,"_27008":119643,"_2880":119644},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3394":70630,"_29710":70621,"_5":30060,"_20617":119646,"_27008":119647,"_2880":119648},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3394":70631,"_29710":70621,"_5":30060,"_20617":119650,"_27008":119651,"_2880":119652},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3394":70632,"_29710":70621,"_5":30060,"_20617":119654,"_27008":119655,"_2880":119656},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3394":70633,"_29710":70621,"_5":30060,"_20617":119658,"_27008":119659,"_2880":119660},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3394":70634,"_29710":70621,"_5":30060,"_20617":119662,"_27008":119663,"_2880":119664},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3394":70635,"_29710":70621,"_5":30060,"_20617":119666,"_27008":119667,"_2880":119668},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3394":70636,"_29710":70621,"_5":30060,"_20617":119670,"_27008":119671,"_2880":119672},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3394":70637,"_29710":70621,"_5":30060,"_20617":119674,"_27008":119675,"_2880":119676},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3394":70638,"_29710":70621,"_5":30060,"_20617":119678,"_27008":119679,"_2880":119680},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3394":70639,"_29710":70621,"_5":30060,"_20617":119682,"_27008":119683,"_2880":119684},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3394":70640,"_29710":70621,"_5":30060,"_20617":119686,"_27008":119687,"_2880":119688},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3394":70641,"_29710":70621,"_5":30060,"_20617":119690,"_27008":119691,"_2880":119692},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3394":70642,"_29710":70621,"_5":30060,"_20617":119694,"_27008":119695,"_2880":119696},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3394":70643,"_29710":70621,"_5":30060,"_20617":119698,"_27008":119699,"_2880":119700},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3394":70644,"_29710":70621,"_5":30060,"_20617":119702,"_27008":119703,"_2880":119704},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3394":70645,"_29710":70621,"_5":30060,"_20617":119706,"_27008":119707,"_2880":119708},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3394":70646,"_29710":70621,"_20617":119710,"_5":14139,"_27008":70621,"_2880":119711},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3394":70647,"_29710":70621,"_20617":119713,"_5":14139,"_27008":70621,"_2880":119714},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3394":70648,"_29710":70621,"_20617":119716,"_5":14139,"_27008":70621,"_2880":119717},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3394":70649,"_29710":70621,"_20617":119719,"_5":14139,"_27008":119620,"_2880":119720},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3394":70650,"_29710":70621,"_20617":119722,"_5":14139,"_27008":119620,"_2880":119723},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3394":70651,"_29710":70621,"_20617":119725,"_5":14139,"_27008":119620,"_2880":119726},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3394":70652,"_29710":70621,"_20617":119728,"_5":14139,"_27008":119620,"_2880":119729},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3394":70653,"_29710":70621,"_20617":119731,"_5":14139,"_27008":119620,"_2880":119732},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3394":70654,"_29710":70621,"_20617":119734,"_5":14139,"_27008":119628,"_2880":119735},[],"Decide si la CA será raíz o intermedia.",{"_3394":70655,"_29710":70621,"_20617":119737,"_5":14139,"_27008":119628,"_2880":119738},[],"Elige el motor que custodiará la clave.",{"_3394":70656,"_29710":70621,"_20617":119740,"_5":14139,"_27008":119628,"_2880":119741},[],"Define una validez superior a la de los certificados que emitirá.",{"_3394":70657,"_29710":70621,"_20617":119743,"_5":14139,"_27008":119628,"_2880":119744},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3394":70658,"_29710":70621,"_20617":119746,"_5":14139,"_27008":119631,"_2880":119747},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3394":70659,"_29710":70621,"_20617":119749,"_5":14139,"_27008":119635,"_2880":119750},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3394":70660,"_29710":70621,"_20617":119752,"_5":14139,"_27008":119635,"_2880":119753},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3394":70661,"_29710":70621,"_20617":119755,"_5":14139,"_27008":119639,"_2880":119756},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3394":70662,"_29710":70621,"_20617":119758,"_5":14139,"_27008":119643,"_2880":119759},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3394":70663,"_29710":70621,"_20617":119761,"_5":14139,"_27008":119643,"_2880":119762},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3394":70664,"_29710":70621,"_20617":119764,"_5":14139,"_27008":119643,"_2880":119765},[],"`ST`: estado o provincia.",{"_3394":70665,"_29710":70621,"_20617":119767,"_5":14139,"_27008":119643,"_2880":119768},[],"`L`: localidad.",{"_3394":70666,"_29710":70621,"_20617":119770,"_5":14139,"_27008":119643,"_2880":119771},[],"`O`: organización.",{"_3394":70667,"_29710":70621,"_20617":119773,"_5":14139,"_27008":119643,"_2880":119774},[],"`OU`: unidad organizativa.",{"_3394":70668,"_29710":70621,"_20617":119776,"_5":14139,"_27008":119643,"_2880":119777},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3394":70669,"_29710":70621,"_20617":119779,"_5":14139,"_27008":119647,"_2880":119780},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3394":70670,"_29710":70621,"_20617":119782,"_5":14139,"_27008":119647,"_2880":119783},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3394":70671,"_29710":70621,"_20617":119785,"_5":14139,"_27008":119651,"_2880":119786},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3394":70672,"_29710":70621,"_20617":119788,"_5":14139,"_27008":119651,"_2880":119789},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3394":70673,"_29710":70621,"_20617":119791,"_5":14139,"_27008":119655,"_2880":119792},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3394":70674,"_29710":70621,"_20617":119794,"_5":14139,"_27008":119655,"_2880":119795},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3394":70675,"_29710":70621,"_20617":119797,"_5":14139,"_27008":119659,"_2880":119798},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3394":70676,"_29710":70621,"_20617":119800,"_5":14139,"_27008":119659,"_2880":119801},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3394":70677,"_29710":70621,"_20617":119803,"_5":14139,"_27008":119659,"_2880":119804},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3394":70678,"_29710":70621,"_20617":119806,"_5":14139,"_27008":119663,"_2880":119807},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3394":70679,"_29710":70621,"_20617":119809,"_5":14139,"_27008":119667,"_2880":119810},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3394":70680,"_29710":70621,"_20617":119812,"_5":14139,"_27008":119667,"_2880":119813},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3394":70681,"_29710":70621,"_20617":119815,"_5":14139,"_27008":119671,"_2880":119816},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3394":70682,"_29710":70621,"_20617":119818,"_5":14139,"_27008":119675,"_2880":119819},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3394":70683,"_29710":70621,"_20617":119821,"_5":14139,"_27008":119675,"_2880":119822},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3394":70684,"_29710":70621,"_20617":119824,"_5":14139,"_27008":119679,"_2880":119825},[],"Abre una CA desde el inventario para consultar:",{"_3394":70685,"_29710":70621,"_20617":119827,"_5":14139,"_27008":119679,"_2880":119828},[],"Estado y periodo de validez.",{"_3394":70686,"_29710":70621,"_20617":119830,"_5":14139,"_27008":119679,"_2880":119831},[],"Certificado y cadena en formato PEM.",{"_3394":70687,"_29710":70621,"_20617":119833,"_5":14139,"_27008":119679,"_2880":119834},[],"Número de certificados activos, expirados y revocados.",{"_3394":70688,"_29710":70621,"_20617":119836,"_5":14139,"_27008":119679,"_2880":119837},[],"Certificados emitidos en **Issued Certificates**.",{"_3394":70689,"_29710":70621,"_20617":119839,"_5":14139,"_27008":119679,"_2880":119840},[],"CRL vinculada a la autoridad.",{"_3394":70690,"_29710":70621,"_20617":119842,"_5":14139,"_27008":119679,"_2880":119843},[],"Metadatos y motor criptográfico asociado.",{"_3394":70691,"_29710":70621,"_20617":119845,"_5":14139,"_27008":119679,"_2880":119846},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3394":70692,"_29710":70621,"_20617":119848,"_5":14139,"_27008":119683,"_2880":119849},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3394":70693,"_29710":70621,"_20617":119851,"_5":14139,"_27008":119683,"_2880":119852},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3394":70694,"_29710":70621,"_20617":119854,"_5":14139,"_27008":119683,"_2880":119855},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3394":70695,"_29710":70621,"_20617":119857,"_5":14139,"_27008":119683,"_2880":119858},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3394":70696,"_29710":70621,"_20617":119860,"_5":14139,"_27008":119687,"_2880":119861},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3394":70697,"_29710":70621,"_20617":119863,"_5":14139,"_27008":119691,"_2880":119864},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3394":70698,"_29710":70621,"_20617":119866,"_5":14139,"_27008":119695,"_2880":119867},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3394":70699,"_29710":70621,"_20617":119869,"_5":14139,"_27008":119699,"_2880":119870},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3394":70700,"_29710":70621,"_20617":119872,"_5":14139,"_27008":119703,"_2880":119873},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3394":70701,"_29710":70621,"_20617":119875,"_5":14139,"_27008":119707,"_2880":119876},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3394":70702,"_29710":70621,"_20617":119878,"_5":14139,"_27008":119707,"_2880":119879},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3394":70703,"_29710":70621,"_20617":119881,"_5":14139,"_27008":119707,"_2880":119882},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3394":70704,"_29710":70704,"_5":14491,"_2880":119884,"_30063":119885,"_20617":119886,"_27008":70704},"Perfiles de certificado",[48401,115575,53871,119450],[],{"_3394":70705,"_29710":70704,"_20617":119888,"_5":14139,"_27008":70704,"_2880":119889},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3394":70706,"_29710":70704,"_5":30060,"_20617":119891,"_27008":119892,"_2880":119893},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3394":70707,"_29710":70704,"_5":30060,"_20617":119895,"_27008":119896,"_2880":119897},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#validez","Validez",{"_3394":70708,"_29710":70704,"_5":30060,"_20617":119899,"_27008":119900,"_2880":119901},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3394":70709,"_29710":70704,"_5":30060,"_20617":119903,"_27008":119904,"_2880":119905},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3394":70710,"_29710":70704,"_5":30060,"_20617":119907,"_27008":119908,"_2880":119909},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3394":70711,"_29710":70704,"_5":30060,"_20617":119911,"_27008":119912,"_2880":119913},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3394":70712,"_29710":70704,"_5":30060,"_20617":119915,"_27008":119916,"_2880":119917},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3394":70713,"_29710":70704,"_5":30060,"_20617":119919,"_27008":119920,"_2880":119921},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3394":70714,"_29710":70704,"_5":30060,"_20617":119923,"_27008":119924,"_2880":119925},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3394":70715,"_29710":70704,"_5":30060,"_20617":119927,"_27008":119928,"_2880":119929},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3394":70716,"_29710":70704,"_5":30060,"_20617":119931,"_27008":119932,"_2880":119933},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3394":70717,"_29710":70704,"_5":30060,"_20617":119935,"_27008":119936,"_2880":119937},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3394":70718,"_29710":70704,"_5":30060,"_20617":119939,"_27008":119940,"_2880":119941},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3394":70719,"_29710":70704,"_5":30060,"_20617":119943,"_27008":119944,"_2880":119945},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3394":70720,"_29710":70704,"_5":30060,"_20617":119947,"_27008":119948,"_2880":119949},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3394":70721,"_29710":70704,"_5":30060,"_20617":119951,"_27008":119952,"_2880":119953},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3394":70722,"_29710":70704,"_20617":119955,"_5":14139,"_27008":70704,"_2880":119956},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3394":70723,"_29710":70704,"_20617":119958,"_5":14139,"_27008":70704,"_2880":119959},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3394":70724,"_29710":70704,"_20617":119961,"_5":14139,"_27008":119896,"_2880":119962},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3394":70725,"_29710":70704,"_20617":119964,"_5":14139,"_27008":119896,"_2880":119965},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3394":70726,"_29710":70704,"_20617":119967,"_5":14139,"_27008":119900,"_2880":119968},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3394":70727,"_29710":70704,"_20617":119970,"_5":14139,"_27008":119904,"_2880":119971},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3394":70728,"_29710":70704,"_20617":119973,"_5":14139,"_27008":119904,"_2880":119974},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3394":70729,"_29710":70704,"_20617":119976,"_5":14139,"_27008":119904,"_2880":119977},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3394":70730,"_29710":70704,"_20617":119979,"_5":14139,"_27008":119908,"_2880":119980},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3394":70731,"_29710":70704,"_20617":119982,"_5":14139,"_27008":119912,"_2880":119983},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3394":70732,"_29710":70704,"_20617":119985,"_5":14139,"_27008":119912,"_2880":119986},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3394":70733,"_29710":70704,"_20617":119988,"_5":14139,"_27008":119916,"_2880":119989},[],"La aplicación criptográfica puede:",{"_3394":70734,"_29710":70704,"_20617":119991,"_5":14139,"_27008":119916,"_2880":119992},[],"permitir o bloquear claves RSA;",{"_3394":70735,"_29710":70704,"_20617":119994,"_5":14139,"_27008":119916,"_2880":119995},[],"limitar los tamaños RSA admitidos;",{"_3394":70736,"_29710":70704,"_20617":119997,"_5":14139,"_27008":119916,"_2880":119998},[],"permitir o bloquear claves ECDSA;",{"_3394":70737,"_29710":70704,"_20617":120000,"_5":14139,"_27008":119916,"_2880":120001},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3394":70738,"_29710":70704,"_20617":120003,"_5":14139,"_27008":119916,"_2880":120004},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3394":70739,"_29710":70704,"_20617":120006,"_5":14139,"_27008":119920,"_2880":120007},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3394":70740,"_29710":70704,"_20617":120009,"_5":14139,"_27008":119920,"_2880":115335},[],{"_3394":70741,"_29710":70704,"_20617":120011,"_5":14139,"_27008":119920,"_2880":120012},[],"Primera opción",{"_3394":70742,"_29710":70704,"_20617":120014,"_5":14139,"_27008":119920,"_2880":120015},[],"Segunda opción",{"_3394":70743,"_29710":70704,"_20617":120017,"_5":14139,"_27008":119920,"_2880":120018},[],"Si no hay ninguna",{"_3394":70744,"_29710":70704,"_20617":120020,"_5":14139,"_27008":119920,"_2880":120021},[],"Firma directa con una CA",{"_3394":70745,"_29710":70704,"_20617":120023,"_5":14139,"_27008":119920,"_2880":120024},[],"`issuance_profile` incluido en la solicitud",{"_3394":70746,"_29710":70704,"_20617":120026,"_5":14139,"_27008":119920,"_2880":120027},[],"`issuance_profile_id` de la solicitud",{"_3394":70747,"_29710":70704,"_20617":120029,"_5":14139,"_27008":119920,"_2880":120030},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3394":70748,"_29710":70704,"_20617":120032,"_5":14139,"_27008":119920,"_2880":120033},[],"Emisión mediante DMS",{"_3394":70749,"_29710":70704,"_20617":120035,"_5":14139,"_27008":119920,"_2880":54458},[],{"_3394":70750,"_29710":70704,"_20617":120037,"_5":14139,"_27008":119920,"_2880":120038},[],"`settings.issuance_profile` incluido en el DMS",{"_3394":70751,"_29710":70704,"_20617":120040,"_5":14139,"_27008":119920,"_2880":120041},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3394":70752,"_29710":70704,"_20617":120043,"_5":14139,"_27008":119920,"_2880":120044},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3394":70753,"_29710":70704,"_20617":120046,"_5":14139,"_27008":119920,"_2880":120047},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3394":70754,"_29710":70704,"_20617":120049,"_5":14139,"_27008":119928,"_2880":120050},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3394":70755,"_29710":70704,"_20617":120052,"_5":14139,"_27008":119932,"_2880":120053},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3394":70756,"_29710":70704,"_20617":120055,"_5":14139,"_27008":119936,"_2880":120056},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3394":70757,"_29710":70704,"_20617":120058,"_5":14139,"_27008":119940,"_2880":120059},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3394":70758,"_29710":70704,"_20617":120061,"_5":14139,"_27008":119944,"_2880":120062},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3394":70759,"_29710":70704,"_20617":120064,"_5":14139,"_27008":119944,"_2880":120065},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3394":70760,"_29710":70704,"_20617":120067,"_5":14139,"_27008":119948,"_2880":120068},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3394":70761,"_29710":70704,"_20617":120070,"_5":14139,"_27008":119948,"_2880":120071},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3394":70762,"_29710":70704,"_20617":120073,"_5":14139,"_27008":119948,"_2880":120074},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3394":70763,"_29710":70704,"_20617":120076,"_5":14139,"_27008":119948,"_2880":120077},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3394":70764,"_29710":70704,"_20617":120079,"_5":14139,"_27008":119952,"_2880":120080},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3394":70765,"_29710":70704,"_20617":120082,"_5":14139,"_27008":119952,"_2880":120083},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3394":70766,"_29710":70766,"_5":14491,"_2880":120085,"_30063":120086,"_20617":120088,"_27008":70766},"Validación de certificados",[48401,115575,53871,120087],"Validación",[],{"_3394":70767,"_29710":70766,"_20617":120090,"_5":14139,"_27008":70766,"_2880":120091},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3394":70768,"_29710":70766,"_5":30060,"_20617":120093,"_27008":120094,"_2880":120095},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3394":70769,"_29710":70766,"_5":30060,"_20617":120097,"_27008":120098,"_2880":120099},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3394":70770,"_29710":70766,"_5":30060,"_20617":120101,"_27008":120102,"_2880":120103},[],"/docs/pr-preview/pr-59/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3394":70771,"_29710":70766,"_20617":120105,"_5":14139,"_27008":70766,"_2880":120106},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3394":70772,"_29710":70766,"_20617":120108,"_5":14139,"_27008":120094,"_2880":120109},[],"Verifica estos criterios juntos:",{"_3394":70773,"_29710":70766,"_20617":120111,"_5":14139,"_27008":120094,"_2880":119079},[],{"_3394":70774,"_29710":70766,"_20617":120113,"_5":14139,"_27008":120094,"_2880":120114},[],"Resultado necesario",{"_3394":70775,"_29710":70766,"_20617":120116,"_5":14139,"_27008":120094,"_2880":120117},[],"Cadena y firma",{"_3394":70776,"_29710":70766,"_20617":120119,"_5":14139,"_27008":120094,"_2880":120120},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3394":70777,"_29710":70766,"_20617":120122,"_5":14139,"_27008":120094,"_2880":120123},[],"Fechas",{"_3394":70778,"_29710":70766,"_20617":120125,"_5":14139,"_27008":120094,"_2880":120126},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3394":70779,"_29710":70766,"_20617":120128,"_5":14139,"_27008":120094,"_2880":115245},[],{"_3394":70780,"_29710":70766,"_20617":120130,"_5":14139,"_27008":120094,"_2880":120131},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3394":70781,"_29710":70766,"_20617":120133,"_5":14139,"_27008":120094,"_2880":120134},[],"Uso",{"_3394":70782,"_29710":70766,"_20617":120136,"_5":14139,"_27008":120094,"_2880":120137},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3394":70783,"_29710":70766,"_20617":120139,"_5":14139,"_27008":120094,"_2880":120140},[],"Revocación",{"_3394":70784,"_29710":70766,"_20617":120142,"_5":14139,"_27008":120094,"_2880":120143},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3394":70785,"_29710":70766,"_20617":120145,"_5":14139,"_27008":120094,"_2880":120146},[],"Autorización",{"_3394":70786,"_29710":70766,"_20617":120148,"_5":14139,"_27008":120094,"_2880":120149},[],"La aplicación permite la acción a esa identidad.",{"_3394":70787,"_29710":70766,"_20617":120151,"_5":14139,"_27008":120094,"_2880":120152},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3394":70788,"_29710":70766,"_20617":120154,"_5":14139,"_27008":120098,"_2880":120155},[],"Mecanismo",{"_3394":70789,"_29710":70766,"_20617":120157,"_5":14139,"_27008":120098,"_2880":120158},[],"Cuándo utilizarlo",{"_3394":70790,"_29710":70766,"_20617":120160,"_5":14139,"_27008":120098,"_2880":120161},[],"Qué debes mantener",{"_3394":70791,"_29710":70766,"_20617":120163,"_5":14139,"_27008":120098,"_2880":54586},[],{"_3394":70792,"_29710":70766,"_20617":120165,"_5":14139,"_27008":120098,"_2880":120166},[],"Consulta del estado de un certificado concreto.",{"_3394":70793,"_29710":70766,"_20617":120168,"_5":14139,"_27008":120098,"_2880":120169},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3394":70794,"_29710":70766,"_20617":120171,"_5":14139,"_27008":120098,"_2880":54595},[],{"_3394":70795,"_29710":70766,"_20617":120173,"_5":14139,"_27008":120098,"_2880":120174},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3394":70796,"_29710":70766,"_20617":120176,"_5":14139,"_27008":120098,"_2880":120177},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3394":70797,"_29710":70766,"_20617":120179,"_5":14139,"_27008":120098,"_2880":120180},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3394":70798,"_29710":70766,"_20617":120182,"_5":14139,"_27008":120098,"_2880":120183},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3394":70799,"_29710":70766,"_20617":120185,"_5":14139,"_27008":120102,"_2880":120186},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3394":70800,"_29710":70766,"_20617":120188,"_5":14139,"_27008":120102,"_2880":120189},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3394":70801,"_29710":70766,"_20617":120191,"_5":14139,"_27008":120102,"_2880":120192},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3394":70802,"_29710":70766,"_20617":120194,"_5":14139,"_27008":120102,"_2880":120195},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3394":70803,"_29710":70766,"_20617":120197,"_5":14139,"_27008":120102,"_2880":120198},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3394":70804,"_29710":70766,"_20617":120200,"_5":14139,"_27008":120102,"_2880":120201},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3394":70805,"_29710":70766,"_20617":120203,"_5":14139,"_27008":120102,"_2880":120204},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3394":70806,"_29710":70766,"_20617":120206,"_5":14139,"_27008":120102,"_2880":120207},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3394":70807,"_29710":70766,"_20617":120209,"_5":14139,"_27008":120102,"_2880":120210},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3394":70808,"_29710":70808,"_5":14491,"_2880":120212,"_30063":120213,"_20617":120214,"_27008":70808},"Certificados",[48401,115575,53871,119450],[],{"_3394":70809,"_29710":70808,"_20617":120216,"_5":14139,"_27008":70808,"_2880":120217},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3394":70810,"_29710":70808,"_5":30060,"_20617":120219,"_27008":120220,"_2880":120221},[],"/docs/pr-preview/pr-59/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3394":70811,"_29710":70808,"_5":30060,"_20617":120223,"_27008":120224,"_2880":120225},[],"/docs/pr-preview/pr-59/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3394":70812,"_29710":70808,"_5":30060,"_20617":120227,"_27008":120228,"_2880":120229},[],"/docs/pr-preview/pr-59/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3394":70813,"_29710":70808,"_5":30060,"_20617":120231,"_27008":120232,"_2880":120233},[],"/docs/pr-preview/pr-59/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3394":70814,"_29710":70808,"_5":30060,"_20617":120235,"_27008":120236,"_2880":120237},[],"/docs/pr-preview/pr-59/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3394":70815,"_29710":70808,"_5":30060,"_20617":120239,"_27008":120240,"_2880":120241},[],"/docs/pr-preview/pr-59/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3394":70816,"_29710":70808,"_5":30060,"_20617":120243,"_27008":120244,"_2880":120245},[],"/docs/pr-preview/pr-59/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3394":70817,"_29710":70808,"_5":30060,"_20617":120247,"_27008":120248,"_2880":120249},[],"/docs/pr-preview/pr-59/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3394":70818,"_29710":70808,"_5":30060,"_20617":120251,"_27008":120252,"_2880":120253},[],"/docs/pr-preview/pr-59/es/platform/pki/certificates#continúa","Continúa",{"_3394":70819,"_29710":70808,"_20617":120255,"_5":14139,"_27008":70808,"_2880":120256},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3394":70820,"_29710":70808,"_20617":120258,"_5":14139,"_27008":120220,"_2880":120259},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3394":70821,"_29710":70808,"_20617":120261,"_5":14139,"_27008":120220,"_2880":120262},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3394":70822,"_29710":70808,"_20617":120264,"_5":14139,"_27008":120220,"_2880":120265},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3394":70823,"_29710":70808,"_20617":120267,"_5":14139,"_27008":120220,"_2880":120268},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3394":70824,"_29710":70808,"_20617":120270,"_5":14139,"_27008":120220,"_2880":120271},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3394":70825,"_29710":70808,"_20617":120273,"_5":14139,"_27008":120220,"_2880":120274},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3394":70826,"_29710":70808,"_20617":120276,"_5":14139,"_27008":120220,"_2880":120277},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3394":70827,"_29710":70808,"_20617":120279,"_5":14139,"_27008":120224,"_2880":120280},[],"Descarga el PEM e inspecciónalo:",{"_3394":70828,"_29710":70808,"_20617":120282,"_5":14139,"_27008":120224,"_2880":120283},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3394":70829,"_29710":70808,"_20617":120285,"_5":14139,"_27008":120228,"_2880":120286},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3394":70830,"_29710":70808,"_20617":120288,"_5":14139,"_27008":120228,"_2880":120289},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3394":70831,"_29710":70808,"_20617":120291,"_5":14139,"_27008":120228,"_2880":120292},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3394":70832,"_29710":70808,"_20617":120294,"_5":14139,"_27008":120228,"_2880":120295},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3394":70833,"_29710":70808,"_20617":120297,"_5":14139,"_27008":120228,"_2880":120298},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3394":70834,"_29710":70808,"_20617":120300,"_5":14139,"_27008":120228,"_2880":120301},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3394":70835,"_29710":70808,"_20617":120303,"_5":14139,"_27008":120228,"_2880":120304},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3394":70836,"_29710":70808,"_20617":120306,"_5":14139,"_27008":120232,"_2880":120307},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3394":70837,"_29710":70808,"_20617":120309,"_5":14139,"_27008":120236,"_2880":120310},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3394":70838,"_29710":70808,"_20617":120312,"_5":14139,"_27008":120240,"_2880":120313},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3394":70839,"_29710":70808,"_20617":120315,"_5":14139,"_27008":120244,"_2880":120316},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3394":70840,"_29710":70808,"_20617":120318,"_5":14139,"_27008":120244,"_2880":120319},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3394":70841,"_29710":70808,"_20617":120321,"_5":14139,"_27008":120244,"_2880":120322},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3394":70842,"_29710":70808,"_20617":120324,"_5":14139,"_27008":120248,"_2880":120325},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3394":70843,"_29710":70808,"_20617":120327,"_5":14139,"_27008":120248,"_2880":120328},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3394":70844,"_29710":70808,"_20617":120330,"_5":14139,"_27008":120248,"_2880":120331},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3394":70845,"_29710":70808,"_20617":120333,"_5":14139,"_27008":120252,"_2880":120334},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3394":70846,"_29710":70808,"_20617":120336,"_5":14139,"_27008":120252,"_2880":120337},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3394":70847,"_29710":70847,"_5":14491,"_2880":120339,"_30063":120340,"_20617":120342,"_27008":70847},"Ciclo de vida de un certificado",[48401,115575,53871,120341],"Conceptos",[],{"_3394":70848,"_29710":70847,"_20617":120344,"_5":14139,"_27008":70847,"_2880":120345},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3394":70849,"_29710":70847,"_5":30060,"_20617":120347,"_27008":120348,"_2880":120349},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3394":70850,"_29710":70847,"_5":30060,"_20617":120351,"_27008":120352,"_2880":120353},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3394":70851,"_29710":70847,"_5":30060,"_20617":120355,"_27008":120356,"_2880":120357},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3394":70852,"_29710":70847,"_5":30060,"_20617":120359,"_27008":120360,"_2880":120361},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3394":70853,"_29710":70847,"_5":30060,"_20617":120363,"_27008":120364,"_2880":120365},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3394":70854,"_29710":70847,"_5":30060,"_20617":120367,"_27008":120368,"_2880":120369},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3394":70855,"_29710":70847,"_5":30060,"_20617":120371,"_27008":120372,"_2880":118073},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3394":70856,"_29710":70847,"_5":30060,"_20617":120374,"_27008":120375,"_2880":120376},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3394":70857,"_29710":70847,"_5":30060,"_20617":120378,"_27008":120379,"_2880":120380},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3394":70858,"_29710":70847,"_5":30060,"_20617":120382,"_27008":120383,"_2880":120384},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3394":70859,"_29710":70847,"_20617":120386,"_5":14139,"_27008":70847,"_2880":120387},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3394":70860,"_29710":70847,"_20617":120389,"_5":14139,"_27008":120352,"_2880":120390},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3394":70861,"_29710":70847,"_20617":120392,"_5":14139,"_27008":120356,"_2880":120393},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3394":70862,"_29710":70847,"_20617":120395,"_5":14139,"_27008":120360,"_2880":120396},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3394":70863,"_29710":70847,"_20617":120398,"_5":14139,"_27008":120364,"_2880":120399},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3394":70864,"_29710":70847,"_20617":120401,"_5":14139,"_27008":120368,"_2880":120402},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3394":70865,"_29710":70847,"_20617":120404,"_5":14139,"_27008":120372,"_2880":120405},[],"Lamassu persiste cuatro estados X.509:",{"_3394":70866,"_29710":70847,"_20617":120407,"_5":14139,"_27008":120372,"_2880":120408},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3394":70867,"_29710":70847,"_20617":120410,"_5":14139,"_27008":120372,"_2880":120411},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3394":70868,"_29710":70847,"_20617":120413,"_5":14139,"_27008":120372,"_2880":120414},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3394":70869,"_29710":70847,"_20617":120416,"_5":14139,"_27008":120372,"_2880":120417},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3394":70870,"_29710":70847,"_20617":120419,"_5":14139,"_27008":120372,"_2880":120420},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3394":70871,"_29710":70847,"_20617":120422,"_5":14139,"_27008":120375,"_2880":120423},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3394":70872,"_29710":70847,"_20617":120425,"_5":14139,"_27008":120375,"_2880":120426},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3394":70873,"_29710":70847,"_20617":120428,"_5":14139,"_27008":120375,"_2880":120429},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3394":70874,"_29710":70847,"_20617":120431,"_5":14139,"_27008":120379,"_2880":120432},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3394":70875,"_29710":70847,"_20617":120434,"_5":14139,"_27008":120379,"_2880":120435},[],"Antes de confirmar:",{"_3394":70876,"_29710":70847,"_20617":120437,"_5":14139,"_27008":120379,"_2880":120438},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3394":70877,"_29710":70847,"_20617":120440,"_5":14139,"_27008":120379,"_2880":120441},[],"Distribuye la nueva cadena de confianza.",{"_3394":70878,"_29710":70847,"_20617":120443,"_5":14139,"_27008":120379,"_2880":120444},[],"Reemite las identidades necesarias.",{"_3394":70879,"_29710":70847,"_20617":120446,"_5":14139,"_27008":120379,"_2880":120447},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3394":70880,"_29710":70847,"_20617":120449,"_5":14139,"_27008":120379,"_2880":120450},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3394":70881,"_29710":70847,"_20617":120452,"_5":14139,"_27008":120379,"_2880":120453},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3394":70882,"_29710":70847,"_20617":120455,"_5":14139,"_27008":120383,"_2880":120456},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3394":70883,"_29710":70847,"_20617":120458,"_5":14139,"_27008":120383,"_2880":120459},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3394":70884,"_29710":70847,"_20617":120461,"_5":14139,"_27008":120383,"_2880":120462},[],"Cambios de estado y razones de revocación.",{"_3394":70885,"_29710":70847,"_20617":120464,"_5":14139,"_27008":120383,"_2880":120465},[],"Publicación y vigencia de OCSP y CRLs.",{"_3394":70886,"_29710":70847,"_20617":120467,"_5":14139,"_27008":120383,"_2880":120468},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3394":70887,"_29710":70847,"_20617":120470,"_5":14139,"_27008":120383,"_2880":120471},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3394":70888,"_29710":70888,"_5":14491,"_2880":120473,"_30063":120474,"_20617":120475,"_27008":70888},"Modelo de confianza",[48401,115575,53871,120341],[],{"_3394":70889,"_29710":70888,"_20617":120477,"_5":14139,"_27008":70888,"_2880":120478},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3394":70890,"_29710":70888,"_5":30060,"_20617":120480,"_27008":120481,"_2880":120482},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3394":70891,"_29710":70888,"_5":30060,"_20617":120484,"_27008":120485,"_2880":120486},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3394":70892,"_29710":70888,"_5":30060,"_20617":120488,"_27008":120489,"_2880":120490},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3394":70893,"_29710":70888,"_5":30060,"_20617":120492,"_27008":120493,"_2880":120494},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3394":70894,"_29710":70888,"_5":30060,"_20617":120496,"_27008":120497,"_2880":120498},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3394":70895,"_29710":70888,"_5":30060,"_20617":120500,"_27008":120501,"_2880":120502},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3394":70896,"_29710":70888,"_5":30060,"_20617":120504,"_27008":120505,"_2880":120506},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3394":70897,"_29710":70888,"_5":30060,"_20617":120508,"_27008":120509,"_2880":120510},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3394":70898,"_29710":70888,"_5":30060,"_20617":120512,"_27008":120513,"_2880":120514},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3394":70899,"_29710":70888,"_5":30060,"_20617":120516,"_27008":120517,"_2880":120518},[],"/docs/pr-preview/pr-59/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3394":70900,"_29710":70888,"_20617":120520,"_5":14139,"_27008":70888,"_2880":120521},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3394":70901,"_29710":70888,"_20617":120523,"_5":14139,"_27008":120485,"_2880":120524},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3394":70902,"_29710":70888,"_20617":120526,"_5":14139,"_27008":120489,"_2880":120527},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3394":70903,"_29710":70888,"_20617":120529,"_5":14139,"_27008":120493,"_2880":120530},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3394":70904,"_29710":70888,"_20617":120532,"_5":14139,"_27008":120497,"_2880":120533},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3394":70905,"_29710":70888,"_20617":120535,"_5":14139,"_27008":120501,"_2880":120536},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3394":70906,"_29710":70888,"_20617":120538,"_5":14139,"_27008":120501,"_2880":120539},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3394":70907,"_29710":70888,"_20617":120541,"_5":14139,"_27008":120501,"_2880":120542},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3394":70908,"_29710":70888,"_20617":120544,"_5":14139,"_27008":120501,"_2880":120545},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3394":70909,"_29710":70888,"_20617":120547,"_5":14139,"_27008":120501,"_2880":120548},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3394":70910,"_29710":70888,"_20617":120550,"_5":14139,"_27008":120501,"_2880":120551},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3394":70911,"_29710":70888,"_20617":120553,"_5":14139,"_27008":120505,"_2880":120554},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3394":70912,"_29710":70888,"_20617":120556,"_5":14139,"_27008":120505,"_2880":120557},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3394":70913,"_29710":70888,"_20617":120559,"_5":14139,"_27008":120505,"_2880":120560},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3394":70914,"_29710":70888,"_20617":120562,"_5":14139,"_27008":120505,"_2880":120563},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3394":70915,"_29710":70888,"_20617":120565,"_5":14139,"_27008":120505,"_2880":120566},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3394":70916,"_29710":70888,"_20617":120568,"_5":14139,"_27008":120509,"_2880":120569},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3394":70917,"_29710":70888,"_20617":120571,"_5":14139,"_27008":120509,"_2880":120572},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3394":70918,"_29710":70888,"_20617":120574,"_5":14139,"_27008":120509,"_2880":120575},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3394":70919,"_29710":70888,"_20617":120577,"_5":14139,"_27008":120509,"_2880":120578},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3394":70920,"_29710":70888,"_20617":120580,"_5":14139,"_27008":120509,"_2880":120581},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3394":70921,"_29710":70888,"_20617":120583,"_5":14139,"_27008":120509,"_2880":120584},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3394":70922,"_29710":70888,"_20617":120586,"_5":14139,"_27008":120509,"_2880":120587},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3394":70923,"_29710":70888,"_20617":120589,"_5":14139,"_27008":120513,"_2880":120590},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3394":70924,"_29710":70888,"_20617":120592,"_5":14139,"_27008":120517,"_2880":120593},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3394":70925,"_29710":70888,"_20617":120595,"_5":14139,"_27008":120517,"_2880":120596},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3394":70926,"_29710":70888,"_20617":120598,"_5":14139,"_27008":120517,"_2880":120599},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3394":70927,"_29710":70888,"_20617":120601,"_5":14139,"_27008":120517,"_2880":120602},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3394":70928,"_29710":70888,"_20617":120604,"_5":14139,"_27008":120517,"_2880":120605},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3394":70929,"_29710":70888,"_20617":120607,"_5":14139,"_27008":120517,"_2880":120608},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3394":70930,"_29710":70888,"_20617":120610,"_5":14139,"_27008":120517,"_2880":120611},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3394":70931,"_29710":70931,"_5":14491,"_2880":120613,"_30063":120614,"_20617":120615,"_27008":70931},"Listas de revocación (CRL)",[48401,115575,53871,120087],[],{"_3394":70932,"_29710":70931,"_20617":120617,"_5":14139,"_27008":70931,"_2880":120618},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3394":70933,"_29710":70931,"_5":30060,"_20617":120620,"_27008":120621,"_2880":120622},[],"/docs/pr-preview/pr-59/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3394":70934,"_29710":70931,"_5":30060,"_20617":120624,"_27008":120625,"_2880":120626},[],"/docs/pr-preview/pr-59/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3394":70935,"_29710":70931,"_5":30060,"_20617":120628,"_27008":120629,"_2880":120630},[],"/docs/pr-preview/pr-59/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3394":70936,"_29710":70931,"_5":30060,"_20617":120632,"_27008":120633,"_2880":120634},[],"/docs/pr-preview/pr-59/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3394":70937,"_29710":70931,"_5":30060,"_20617":120636,"_27008":120637,"_2880":120638},[],"/docs/pr-preview/pr-59/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3394":70938,"_29710":70931,"_5":30060,"_20617":120640,"_27008":120641,"_2880":120642},[],"/docs/pr-preview/pr-59/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3394":70939,"_29710":70931,"_5":30060,"_20617":120644,"_27008":120645,"_2880":120646},[],"/docs/pr-preview/pr-59/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3394":70940,"_29710":70931,"_5":30060,"_20617":120648,"_27008":120649,"_2880":120650},[],"/docs/pr-preview/pr-59/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3394":70941,"_29710":70931,"_5":30060,"_20617":120652,"_27008":120653,"_2880":120654},[],"/docs/pr-preview/pr-59/es/platform/pki/crl#referencias","Referencias",{"_3394":70942,"_29710":70931,"_20617":120656,"_5":14139,"_27008":70931,"_2880":120657},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3394":70943,"_29710":70931,"_20617":120659,"_5":14139,"_27008":120621,"_2880":120660},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3394":70944,"_29710":70931,"_20617":120662,"_5":14139,"_27008":120621,"_2880":120663},[],"Campo de `crl_options`",{"_3394":70945,"_29710":70931,"_20617":120665,"_5":14139,"_27008":120621,"_2880":117113},[],{"_3394":70946,"_29710":70931,"_20617":120667,"_5":14139,"_27008":120621,"_2880":120668},[],"Valor inicial del backend",{"_3394":70947,"_29710":70931,"_20617":120670,"_5":14139,"_27008":120621,"_2880":55096},[],{"_3394":70948,"_29710":70931,"_20617":120672,"_5":14139,"_27008":120621,"_2880":120673},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3394":70949,"_29710":70931,"_20617":120675,"_5":14139,"_27008":120621,"_2880":120676},[],"7 días.",{"_3394":70950,"_29710":70931,"_20617":120678,"_5":14139,"_27008":120621,"_2880":55105},[],{"_3394":70951,"_29710":70931,"_20617":120680,"_5":14139,"_27008":120621,"_2880":120681},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3394":70952,"_29710":70931,"_20617":120683,"_5":14139,"_27008":120621,"_2880":120684},[],"6 días y 23 horas.",{"_3394":70953,"_29710":70931,"_20617":120686,"_5":14139,"_27008":120621,"_2880":55114},[],{"_3394":70954,"_29710":70931,"_20617":120688,"_5":14139,"_27008":120621,"_2880":120689},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3394":70955,"_29710":70931,"_20617":120691,"_5":14139,"_27008":120621,"_2880":55120},[],{"_3394":70956,"_29710":70931,"_20617":120693,"_5":14139,"_27008":120621,"_2880":55123},[],{"_3394":70957,"_29710":70931,"_20617":120695,"_5":14139,"_27008":120621,"_2880":120696},[],"Número de serie del certificado existente que firma la CRL.",{"_3394":70958,"_29710":70931,"_20617":120698,"_5":14139,"_27008":120621,"_2880":120699},[],"Número de serie del certificado actual de la CA.",{"_3394":70959,"_29710":70931,"_20617":120701,"_5":14139,"_27008":120621,"_2880":120702},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3394":70960,"_29710":70931,"_20617":120704,"_5":14139,"_27008":120621,"_2880":120705},[],"Al reemitir una CA, si el firmante del rol es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras el rol lo use (la API lo rechaza con `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3394":70961,"_29710":70931,"_20617":120707,"_5":14139,"_27008":120621,"_2880":120708},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3394":70962,"_29710":70931,"_20617":120710,"_5":14139,"_27008":120621,"_2880":120711},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba el uso de clave del certificado nuevo: si carece de `cRLSign`, la VA conserva el firmante anterior y registra un aviso, de modo que las listas siguen firmándose con el certificado sustituido hasta que corrijas el uso.",{"_3394":70963,"_29710":70931,"_20617":120713,"_5":14139,"_27008":120621,"_2880":120714},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3394":70964,"_29710":70931,"_20617":120716,"_5":14139,"_27008":120621,"_2880":120717},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3394":70965,"_29710":70931,"_20617":120719,"_5":14139,"_27008":120621,"_2880":120720},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3394":70966,"_29710":70931,"_20617":120722,"_5":14139,"_27008":120625,"_2880":120723},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3394":70967,"_29710":70931,"_20617":120725,"_5":14139,"_27008":120625,"_2880":120726},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3394":70968,"_29710":70931,"_20617":120728,"_5":14139,"_27008":120625,"_2880":120729},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3394":70969,"_29710":70931,"_20617":120731,"_5":14139,"_27008":120625,"_2880":120732},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3394":70970,"_29710":70931,"_20617":120734,"_5":14139,"_27008":120629,"_2880":120735},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3394":70971,"_29710":70931,"_20617":120737,"_5":14139,"_27008":120629,"_2880":120738},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3394":70972,"_29710":70931,"_20617":120740,"_5":14139,"_27008":120629,"_2880":120741},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3394":70973,"_29710":70931,"_20617":120743,"_5":14139,"_27008":120629,"_2880":120744},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3394":70974,"_29710":70931,"_20617":120746,"_5":14139,"_27008":120629,"_2880":120747},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3394":70975,"_29710":70931,"_20617":120749,"_5":14139,"_27008":120629,"_2880":120750},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3394":70976,"_29710":70931,"_20617":120752,"_5":14139,"_27008":120629,"_2880":120753},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene rol VA, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3394":70977,"_29710":70931,"_20617":120755,"_5":14139,"_27008":120629,"_2880":120756},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3394":70978,"_29710":70931,"_20617":120758,"_5":14139,"_27008":120633,"_2880":120759},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3394":70979,"_29710":70931,"_20617":120761,"_5":14139,"_27008":120633,"_2880":120762},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3394":70980,"_29710":70931,"_20617":120764,"_5":14139,"_27008":120637,"_2880":120765},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3394":70981,"_29710":70931,"_20617":120767,"_5":14139,"_27008":120637,"_2880":120768},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3394":70982,"_29710":70931,"_20617":120770,"_5":14139,"_27008":120637,"_2880":120771},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando el rol apunta a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3394":70983,"_29710":70931,"_20617":120773,"_5":14139,"_27008":120637,"_2880":120774},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3394":70984,"_29710":70931,"_20617":120776,"_5":14139,"_27008":120637,"_2880":120777},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3394":70985,"_29710":70931,"_20617":120779,"_5":14139,"_27008":120641,"_2880":120780},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3394":70986,"_29710":70931,"_20617":120782,"_5":14139,"_27008":120641,"_2880":117302},[],{"_3394":70987,"_29710":70931,"_20617":120784,"_5":14139,"_27008":120641,"_2880":120785},[],"Path relativo",{"_3394":70988,"_29710":70931,"_20617":120787,"_5":14139,"_27008":120641,"_2880":115335},[],{"_3394":70989,"_29710":70931,"_20617":120789,"_5":14139,"_27008":120641,"_2880":55220},[],{"_3394":70990,"_29710":70931,"_20617":120791,"_5":14139,"_27008":120641,"_2880":55223},[],{"_3394":70991,"_29710":70931,"_20617":120793,"_5":14139,"_27008":120641,"_2880":120794},[],"Consultar `crl_options` y `latest_crl`.",{"_3394":70992,"_29710":70931,"_20617":120796,"_5":14139,"_27008":120641,"_2880":55229},[],{"_3394":70993,"_29710":70931,"_20617":120798,"_5":14139,"_27008":120641,"_2880":55223},[],{"_3394":70994,"_29710":70931,"_20617":120800,"_5":14139,"_27008":120641,"_2880":120801},[],"Sustituir la configuración de CRL.",{"_3394":70995,"_29710":70931,"_20617":120803,"_5":14139,"_27008":120641,"_2880":120804},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3394":70996,"_29710":70931,"_20617":120806,"_5":14139,"_27008":120641,"_2880":120807},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3394":70997,"_29710":70931,"_20617":120809,"_5":14139,"_27008":120645,"_2880":120810},[],"Síntoma",{"_3394":70998,"_29710":70931,"_20617":120812,"_5":14139,"_27008":120645,"_2880":120813},[],"Causa",{"_3394":70999,"_29710":70931,"_20617":120815,"_5":14139,"_27008":120645,"_2880":120816},[],"Acción",{"_3394":71000,"_29710":70931,"_20617":120818,"_5":14139,"_27008":120645,"_2880":120819},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3394":71001,"_29710":70931,"_20617":120821,"_5":14139,"_27008":120645,"_2880":120822},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3394":71002,"_29710":70931,"_20617":120824,"_5":14139,"_27008":120645,"_2880":120825},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3394":71003,"_29710":70931,"_20617":120827,"_5":14139,"_27008":120645,"_2880":120828},[],"`PUT` devuelve 400.",{"_3394":71004,"_29710":70931,"_20617":120830,"_5":14139,"_27008":120645,"_2880":120831},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3394":71005,"_29710":70931,"_20617":120833,"_5":14139,"_27008":120645,"_2880":120834},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3394":71006,"_29710":70931,"_20617":120836,"_5":14139,"_27008":120645,"_2880":120837},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3394":71007,"_29710":70931,"_20617":120839,"_5":14139,"_27008":120645,"_2880":120840},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3394":71008,"_29710":70931,"_20617":120842,"_5":14139,"_27008":120645,"_2880":120843},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3394":71009,"_29710":70931,"_20617":120845,"_5":14139,"_27008":120645,"_2880":120846},[],"La CRL no cambia tras revocar un certificado.",{"_3394":71010,"_29710":70931,"_20617":120848,"_5":14139,"_27008":120645,"_2880":120849},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene rol VA, o la generación falló por un firmante inválido.",{"_3394":71011,"_29710":70931,"_20617":120851,"_5":14139,"_27008":120645,"_2880":120852},[],"Revisa los logs de la VA. La falta de rol solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3394":71012,"_29710":70931,"_20617":120854,"_5":14139,"_27008":120645,"_2880":120855},[],"Un verificador rechaza la CRL por el emisor.",{"_3394":71013,"_29710":70931,"_20617":120857,"_5":14139,"_27008":120645,"_2880":120858},[],"Varias CAs comparten SKI.",{"_3394":71014,"_29710":70931,"_20617":120860,"_5":14139,"_27008":120645,"_2880":120861},[],"Consulta CAs que comparten clave.",{"_3394":71015,"_29710":70931,"_20617":120863,"_5":14139,"_27008":120649,"_2880":120864},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3394":71016,"_29710":70931,"_20617":120866,"_5":14139,"_27008":120653,"_2880":120867},[],"RFC 5280: perfil X.509 y CRL.",{"_3394":71017,"_29710":70931,"_20617":120869,"_5":14139,"_27008":120653,"_2880":55303},[],{"_3394":71018,"_29710":70931,"_20617":120871,"_5":14139,"_27008":120653,"_2880":55306},[],{"_3394":71019,"_29710":70931,"_20617":120873,"_5":14139,"_27008":120653,"_2880":120874},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3394":71020,"_29710":70931,"_20617":120876,"_5":14139,"_27008":120653,"_2880":120877},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3394":71021,"_29710":71021,"_5":14491,"_2880":120879,"_30063":120880,"_20617":120881,"_27008":71021},"Claves y motores criptográficos",[48401,115575,53871,119450],[],{"_3394":71022,"_29710":71021,"_20617":120883,"_5":14139,"_27008":71021,"_2880":120884},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3394":71023,"_29710":71021,"_5":30060,"_20617":120886,"_27008":120887,"_2880":120888},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3394":71024,"_29710":71021,"_5":30060,"_20617":120890,"_27008":120891,"_2880":120892},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3394":71025,"_29710":71021,"_5":30060,"_20617":120894,"_27008":120895,"_2880":55331},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#file-system",{"_3394":71026,"_29710":71021,"_5":30060,"_20617":120897,"_27008":120898,"_2880":55335},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#hashicorp-vault",{"_3394":71027,"_29710":71021,"_5":30060,"_20617":120900,"_27008":120901,"_2880":55339},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#aws-secrets-manager",{"_3394":71028,"_29710":71021,"_5":30060,"_20617":120903,"_27008":120904,"_2880":55343},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#aws-kms",{"_3394":71029,"_29710":71021,"_5":30060,"_20617":120906,"_27008":120907,"_2880":55347},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#pkcs11",{"_3394":71030,"_29710":71021,"_5":30060,"_20617":120909,"_27008":120910,"_2880":55351},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#azure-key-vault",{"_3394":71031,"_29710":71021,"_5":30060,"_20617":120912,"_27008":120913,"_2880":120914},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3394":71032,"_29710":71021,"_5":30060,"_20617":120916,"_27008":120917,"_2880":120918},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3394":71033,"_29710":71021,"_5":30060,"_20617":120920,"_27008":120921,"_2880":120922},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3394":71034,"_29710":71021,"_5":30060,"_20617":120924,"_27008":120925,"_2880":120926},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3394":71035,"_29710":71021,"_5":30060,"_20617":120928,"_27008":120929,"_2880":120930},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3394":71036,"_29710":71021,"_5":30060,"_20617":120932,"_27008":120933,"_2880":120934},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3394":71037,"_29710":71021,"_5":30060,"_20617":120936,"_27008":120937,"_2880":120938},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3394":71038,"_29710":71021,"_5":30060,"_20617":120940,"_27008":120941,"_2880":55383},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#sign",{"_3394":71039,"_29710":71021,"_5":30060,"_20617":120943,"_27008":120944,"_2880":55387},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#verify",{"_3394":71040,"_29710":71021,"_5":30060,"_20617":120946,"_27008":120947,"_2880":120948},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3394":71041,"_29710":71021,"_5":30060,"_20617":120950,"_27008":120951,"_2880":120952},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3394":71042,"_29710":71021,"_5":30060,"_20617":120954,"_27008":120955,"_2880":120956},[],"/docs/pr-preview/pr-59/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3394":71043,"_29710":71021,"_20617":120958,"_5":14139,"_27008":71021,"_2880":120959},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3394":71044,"_29710":71021,"_20617":120961,"_5":14139,"_27008":71021,"_2880":120962},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3394":71045,"_29710":71021,"_20617":120964,"_5":14139,"_27008":120887,"_2880":120965},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3394":71046,"_29710":71021,"_20617":120967,"_5":14139,"_27008":120887,"_2880":120968},[],"En la práctica, permite:",{"_3394":71047,"_29710":71021,"_20617":120970,"_5":14139,"_27008":120887,"_2880":120971},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3394":71048,"_29710":71021,"_20617":120973,"_5":14139,"_27008":120887,"_2880":120974},[],"Importar claves creadas externamente.",{"_3394":71049,"_29710":71021,"_20617":120976,"_5":14139,"_27008":120887,"_2880":120977},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3394":71050,"_29710":71021,"_20617":120979,"_5":14139,"_27008":120887,"_2880":120980},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3394":71051,"_29710":71021,"_20617":120982,"_5":14139,"_27008":120891,"_2880":120983},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3394":71052,"_29710":71021,"_20617":120985,"_5":14139,"_27008":120891,"_2880":120986},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3394":71053,"_29710":71021,"_20617":120988,"_5":14139,"_27008":120891,"_2880":120989},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3394":71054,"_29710":71021,"_20617":120991,"_5":14139,"_27008":120895,"_2880":120992},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3394":71055,"_29710":71021,"_20617":120994,"_5":14139,"_27008":120898,"_2880":120995},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3394":71056,"_29710":71021,"_20617":120997,"_5":14139,"_27008":120898,"_2880":120998},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3394":71057,"_29710":71021,"_20617":121000,"_5":14139,"_27008":120901,"_2880":121001},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3394":71058,"_29710":71021,"_20617":121003,"_5":14139,"_27008":120904,"_2880":121004},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3394":71059,"_29710":71021,"_20617":121006,"_5":14139,"_27008":120907,"_2880":121007},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3394":71060,"_29710":71021,"_20617":121009,"_5":14139,"_27008":120910,"_2880":121010},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3394":71061,"_29710":71021,"_20617":121012,"_5":14139,"_27008":120910,"_2880":121013},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3394":71062,"_29710":71021,"_20617":121015,"_5":14139,"_27008":120910,"_2880":121016},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3394":71063,"_29710":71021,"_20617":121018,"_5":14139,"_27008":120910,"_2880":121019},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3394":71064,"_29710":71021,"_20617":121021,"_5":14139,"_27008":120913,"_2880":121022},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3394":71065,"_29710":71021,"_20617":121024,"_5":14139,"_27008":120913,"_2880":121025},[],"La tabla incluye los siguientes campos:",{"_3394":71066,"_29710":71021,"_20617":121027,"_5":14139,"_27008":120913,"_2880":121028},[],"**Name**: nombre descriptivo de la clave.",{"_3394":71067,"_29710":71021,"_20617":121030,"_5":14139,"_27008":120913,"_2880":121031},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3394":71068,"_29710":71021,"_20617":121033,"_5":14139,"_27008":120913,"_2880":121034},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3394":71069,"_29710":71021,"_20617":121036,"_5":14139,"_27008":120913,"_2880":121037},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3394":71070,"_29710":71021,"_20617":121039,"_5":14139,"_27008":120913,"_2880":121040},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3394":71071,"_29710":71021,"_20617":121042,"_5":14139,"_27008":120913,"_2880":121043},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3394":71072,"_29710":71021,"_20617":121045,"_5":14139,"_27008":120913,"_2880":121046},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3394":71073,"_29710":71021,"_20617":121048,"_5":14139,"_27008":120913,"_2880":121049},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3394":71074,"_29710":71021,"_20617":121051,"_5":14139,"_27008":120913,"_2880":121052},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3394":71075,"_29710":71021,"_20617":121054,"_5":14139,"_27008":120913,"_2880":121055},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3394":71076,"_29710":71021,"_20617":121057,"_5":14139,"_27008":120913,"_2880":121058},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3394":71077,"_29710":71021,"_20617":121060,"_5":14139,"_27008":120913,"_2880":121061},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3394":71078,"_29710":71021,"_20617":121063,"_5":14139,"_27008":120913,"_2880":121064},[],"**Delete Key** para eliminar la clave del sistema.",{"_3394":71079,"_29710":71021,"_20617":121066,"_5":14139,"_27008":120917,"_2880":121067},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3394":71080,"_29710":71021,"_20617":121069,"_5":14139,"_27008":120921,"_2880":121070},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3394":71081,"_29710":71021,"_20617":121072,"_5":14139,"_27008":120921,"_2880":121073},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3394":71082,"_29710":71021,"_20617":121075,"_5":14139,"_27008":120921,"_2880":121076},[],"**Key Name**: nombre único y descriptivo.",{"_3394":71083,"_29710":71021,"_20617":121078,"_5":14139,"_27008":120921,"_2880":121079},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3394":71084,"_29710":71021,"_20617":121081,"_5":14139,"_27008":120921,"_2880":121082},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3394":71085,"_29710":71021,"_20617":121084,"_5":14139,"_27008":120921,"_2880":121085},[],"**Tags**: metadatos para clasificar la clave.",{"_3394":71086,"_29710":71021,"_20617":121087,"_5":14139,"_27008":120921,"_2880":121088},[],"**Metadata**: información adicional para usos avanzados.",{"_3394":71087,"_29710":71021,"_20617":121090,"_5":14139,"_27008":120925,"_2880":121091},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3394":71088,"_29710":71021,"_20617":121093,"_5":14139,"_27008":120925,"_2880":121094},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3394":71089,"_29710":71021,"_20617":121096,"_5":14139,"_27008":120925,"_2880":121097},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3394":71090,"_29710":71021,"_20617":121099,"_5":14139,"_27008":120925,"_2880":121100},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3394":71091,"_29710":71021,"_20617":121102,"_5":14139,"_27008":120925,"_2880":121103},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3394":71092,"_29710":71021,"_20617":121105,"_5":14139,"_27008":120925,"_2880":121106},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3394":71093,"_29710":71021,"_20617":121108,"_5":14139,"_27008":120925,"_2880":121109},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3394":71094,"_29710":71021,"_20617":121111,"_5":14139,"_27008":120925,"_2880":121112},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3394":71095,"_29710":71021,"_20617":121114,"_5":14139,"_27008":120925,"_2880":121115},[],"**Metadata**: información adicional opcional.",{"_3394":71096,"_29710":71021,"_20617":121117,"_5":14139,"_27008":120925,"_2880":121118},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3394":71097,"_29710":71021,"_20617":121120,"_5":14139,"_27008":120925,"_2880":121121},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3394":71098,"_29710":71021,"_20617":121123,"_5":14139,"_27008":120929,"_2880":121124},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3394":71099,"_29710":71021,"_20617":121126,"_5":14139,"_27008":120933,"_2880":121127},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3394":71100,"_29710":71021,"_20617":121129,"_5":14139,"_27008":120933,"_2880":121130},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3394":71101,"_29710":71021,"_20617":121132,"_5":14139,"_27008":120933,"_2880":121133},[],"**Key Name**: nombre descriptivo.",{"_3394":71102,"_29710":71021,"_20617":121135,"_5":14139,"_27008":120933,"_2880":121136},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3394":71103,"_29710":71021,"_20617":121138,"_5":14139,"_27008":120933,"_2880":121139},[],"**Tags**: etiquetas asociadas.",{"_3394":71104,"_29710":71021,"_20617":121141,"_5":14139,"_27008":120933,"_2880":121142},[],"**Aliases**: nombres alternativos.",{"_3394":71105,"_29710":71021,"_20617":121144,"_5":14139,"_27008":120933,"_2880":121145},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3394":71106,"_29710":71021,"_20617":121147,"_5":14139,"_27008":120933,"_2880":121148},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3394":71107,"_29710":71021,"_20617":121150,"_5":14139,"_27008":120933,"_2880":121151},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3394":71108,"_29710":71021,"_20617":121153,"_5":14139,"_27008":120933,"_2880":121154},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3394":71109,"_29710":71021,"_20617":121156,"_5":14139,"_27008":120937,"_2880":121157},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3394":71110,"_29710":71021,"_20617":121159,"_5":14139,"_27008":120937,"_2880":121160},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3394":71111,"_29710":71021,"_20617":121162,"_5":14139,"_27008":120937,"_2880":121163},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3394":71112,"_29710":71021,"_20617":121165,"_5":14139,"_27008":120941,"_2880":121166},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3394":71113,"_29710":71021,"_20617":121168,"_5":14139,"_27008":120941,"_2880":121169},[],"Campos principales:",{"_3394":71114,"_29710":71021,"_20617":121171,"_5":14139,"_27008":120941,"_2880":121172},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3394":71115,"_29710":71021,"_20617":121174,"_5":14139,"_27008":120941,"_2880":121175},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3394":71116,"_29710":71021,"_20617":121177,"_5":14139,"_27008":120941,"_2880":121178},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3394":71117,"_29710":71021,"_20617":121180,"_5":14139,"_27008":120941,"_2880":121181},[],"**Message**: contenido que se va a firmar.",{"_3394":71118,"_29710":71021,"_20617":121183,"_5":14139,"_27008":120941,"_2880":121184},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3394":71119,"_29710":71021,"_20617":121186,"_5":14139,"_27008":120944,"_2880":121187},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3394":71120,"_29710":71021,"_20617":121189,"_5":14139,"_27008":120944,"_2880":121169},[],{"_3394":71121,"_29710":71021,"_20617":121191,"_5":14139,"_27008":120944,"_2880":121192},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3394":71122,"_29710":71021,"_20617":121194,"_5":14139,"_27008":120944,"_2880":121195},[],"**Message Type**: `Raw` o `Digest`.",{"_3394":71123,"_29710":71021,"_20617":121197,"_5":14139,"_27008":120944,"_2880":121198},[],"**Payload Encoding**: codificación del mensaje.",{"_3394":71124,"_29710":71021,"_20617":121200,"_5":14139,"_27008":120944,"_2880":121201},[],"**Message**: mensaje original o hash.",{"_3394":71125,"_29710":71021,"_20617":121203,"_5":14139,"_27008":120944,"_2880":121204},[],"**Signature**: firma que se desea comprobar.",{"_3394":71126,"_29710":71021,"_20617":121206,"_5":14139,"_27008":120944,"_2880":121207},[],"**Result**: indicador del resultado de la validación.",{"_3394":71127,"_29710":71021,"_20617":121209,"_5":14139,"_27008":120947,"_2880":121210},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3394":71128,"_29710":71021,"_20617":121212,"_5":14139,"_27008":120947,"_2880":121213},[],"Este flujo es útil para:",{"_3394":71129,"_29710":71021,"_20617":121215,"_5":14139,"_27008":120947,"_2880":121216},[],"Solicitar certificados a una CA externa.",{"_3394":71130,"_29710":71021,"_20617":121218,"_5":14139,"_27008":120947,"_2880":121219},[],"Renovar una identidad manteniendo la misma clave.",{"_3394":71131,"_29710":71021,"_20617":121221,"_5":14139,"_27008":120947,"_2880":121222},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3394":71132,"_29710":71021,"_20617":121224,"_5":14139,"_27008":120947,"_2880":121225},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3394":71133,"_29710":71021,"_20617":121227,"_5":14139,"_27008":120947,"_2880":121228},[],"**Organization (O)**: organización o empresa.",{"_3394":71134,"_29710":71021,"_20617":121230,"_5":14139,"_27008":120947,"_2880":121231},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3394":71135,"_29710":71021,"_20617":121233,"_5":14139,"_27008":120947,"_2880":121234},[],"**Country (C)**: código de país de dos letras.",{"_3394":71136,"_29710":71021,"_20617":121236,"_5":14139,"_27008":120947,"_2880":121237},[],"**State / Province (ST)**: estado o provincia.",{"_3394":71137,"_29710":71021,"_20617":121239,"_5":14139,"_27008":120947,"_2880":121240},[],"**Locality (L)**: ciudad o localidad.",{"_3394":71138,"_29710":71021,"_20617":121242,"_5":14139,"_27008":120947,"_2880":121243},[],"**Email Address**: correo de contacto.",{"_3394":71139,"_29710":71021,"_20617":121245,"_5":14139,"_27008":120947,"_2880":121246},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3394":71140,"_29710":71021,"_20617":121248,"_5":14139,"_27008":120947,"_2880":121249},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3394":71141,"_29710":71021,"_20617":121251,"_5":14139,"_27008":120951,"_2880":121252},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3394":71142,"_29710":71021,"_20617":121254,"_5":14139,"_27008":120951,"_2880":121255},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3394":71143,"_29710":71021,"_20617":121257,"_5":14139,"_27008":120955,"_2880":121258},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3394":71144,"_29710":71021,"_20617":121260,"_5":14139,"_27008":120955,"_2880":121261},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3394":71145,"_29710":71145,"_5":14491,"_2880":121263,"_30063":121264,"_20617":121265,"_27008":71145},"Validación online con OCSP",[48401,115575,53871,120087],[],{"_3394":71146,"_29710":71145,"_20617":121267,"_5":14139,"_27008":71145,"_2880":121268},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3394":71147,"_29710":71145,"_5":30060,"_20617":121270,"_27008":121271,"_2880":121272},[],"/docs/pr-preview/pr-59/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3394":71148,"_29710":71145,"_5":30060,"_20617":121274,"_27008":121275,"_2880":121276},[],"/docs/pr-preview/pr-59/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3394":71149,"_29710":71145,"_5":30060,"_20617":121278,"_27008":121279,"_2880":121280},[],"/docs/pr-preview/pr-59/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3394":71150,"_29710":71145,"_5":30060,"_20617":121282,"_27008":121283,"_2880":121284},[],"/docs/pr-preview/pr-59/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3394":71151,"_29710":71145,"_5":30060,"_20617":121286,"_27008":121287,"_2880":121288},[],"/docs/pr-preview/pr-59/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3394":71152,"_29710":71145,"_5":30060,"_20617":121290,"_27008":121291,"_2880":120654},[],"/docs/pr-preview/pr-59/es/platform/pki/ocsp#referencias",{"_3394":71153,"_29710":71145,"_20617":121293,"_5":14139,"_27008":71145,"_2880":121294},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3394":71154,"_29710":71145,"_20617":121296,"_5":14139,"_27008":121271,"_2880":121297},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3394":71155,"_29710":71145,"_20617":121299,"_5":14139,"_27008":121271,"_2880":121300},[],"Estado del registro",{"_3394":71156,"_29710":71145,"_20617":121302,"_5":14139,"_27008":121271,"_2880":121303},[],"Respuesta firmada",{"_3394":71157,"_29710":71145,"_20617":121305,"_5":14139,"_27008":121271,"_2880":53008},[],{"_3394":71158,"_29710":71145,"_20617":121307,"_5":14139,"_27008":121271,"_2880":55751},[],{"_3394":71159,"_29710":71145,"_20617":121309,"_5":14139,"_27008":121271,"_2880":53025},[],{"_3394":71160,"_29710":71145,"_20617":121311,"_5":14139,"_27008":121271,"_2880":121312},[],"`Revoked`, con razón y fecha de revocación.",{"_3394":71161,"_29710":71145,"_20617":121314,"_5":14139,"_27008":121271,"_2880":121315},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3394":71162,"_29710":71145,"_20617":121317,"_5":14139,"_27008":121271,"_2880":121318},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3394":71163,"_29710":71145,"_20617":121320,"_5":14139,"_27008":121271,"_2880":121321},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3394":71164,"_29710":71145,"_20617":121323,"_5":14139,"_27008":121271,"_2880":121324},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3394":71165,"_29710":71145,"_20617":121326,"_5":14139,"_27008":121271,"_2880":121327},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3394":71166,"_29710":71145,"_20617":121329,"_5":14139,"_27008":121275,"_2880":121330},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3394":71167,"_29710":71145,"_20617":121332,"_5":14139,"_27008":121275,"_2880":121333},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3394":71168,"_29710":71145,"_20617":121335,"_5":14139,"_27008":121279,"_2880":121336},[],"El servicio acepta:",{"_3394":71169,"_29710":71145,"_20617":121338,"_5":14139,"_27008":121279,"_2880":117302},[],{"_3394":71170,"_29710":71145,"_20617":121340,"_5":14139,"_27008":121279,"_2880":121341},[],"Ruta del servicio VA",{"_3394":71171,"_29710":71145,"_20617":121343,"_5":14139,"_27008":121279,"_2880":121344},[],"Formato",{"_3394":71172,"_29710":71145,"_20617":121346,"_5":14139,"_27008":121279,"_2880":55791},[],{"_3394":71173,"_29710":71145,"_20617":121348,"_5":14139,"_27008":121279,"_2880":55794},[],{"_3394":71174,"_29710":71145,"_20617":121350,"_5":14139,"_27008":121279,"_2880":121351},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3394":71175,"_29710":71145,"_20617":121353,"_5":14139,"_27008":121279,"_2880":55220},[],{"_3394":71176,"_29710":71145,"_20617":121355,"_5":14139,"_27008":121279,"_2880":55802},[],{"_3394":71177,"_29710":71145,"_20617":121357,"_5":14139,"_27008":121279,"_2880":121358},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3394":71178,"_29710":71145,"_20617":121360,"_5":14139,"_27008":121279,"_2880":121361},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3394":71179,"_29710":71145,"_20617":121363,"_5":14139,"_27008":121283,"_2880":121364},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3394":71180,"_29710":71145,"_20617":121366,"_5":14139,"_27008":121283,"_2880":121367},[],"Genera la solicitud:",{"_3394":71181,"_29710":71145,"_20617":121369,"_5":14139,"_27008":121283,"_2880":121370},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3394":71182,"_29710":71145,"_20617":121372,"_5":14139,"_27008":121283,"_2880":121373},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3394":71183,"_29710":71145,"_20617":121375,"_5":14139,"_27008":121283,"_2880":121376},[],"Verifica el DER recibido:",{"_3394":71184,"_29710":71145,"_20617":121378,"_5":14139,"_27008":121283,"_2880":121379},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3394":71185,"_29710":71145,"_20617":121381,"_5":14139,"_27008":121287,"_2880":121382},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3394":71186,"_29710":71145,"_20617":121384,"_5":14139,"_27008":121287,"_2880":121385},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3394":71187,"_29710":71145,"_20617":121387,"_5":14139,"_27008":121291,"_2880":55835},[],{"_3394":71188,"_29710":71145,"_20617":121389,"_5":14139,"_27008":121291,"_2880":55838},[],{"_3394":71189,"_29710":71145,"_20617":121391,"_5":14139,"_27008":121291,"_2880":121392},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3394":71190,"_29710":71145,"_20617":121394,"_5":14139,"_27008":121291,"_2880":120877},[],{"_3394":71191,"_29710":71191,"_5":14491,"_2880":53871,"_30063":121396,"_20617":121397,"_27008":71191},[48401,115575,53871],[],{"_3394":71192,"_29710":71191,"_20617":121399,"_5":14139,"_27008":71191,"_2880":121400},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3394":71193,"_29710":71191,"_5":30060,"_20617":121402,"_27008":121403,"_2880":118776},[],"/docs/pr-preview/pr-59/es/platform/pki/overview#empieza-aquí",{"_3394":71194,"_29710":71191,"_5":30060,"_20617":121405,"_27008":121406,"_2880":121407},[],"/docs/pr-preview/pr-59/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3394":71195,"_29710":71191,"_5":30060,"_20617":121409,"_27008":121410,"_2880":119296},[],"/docs/pr-preview/pr-59/es/platform/pki/overview#capacidades-principales",{"_3394":71196,"_29710":71191,"_5":30060,"_20617":121412,"_27008":121413,"_2880":119300},[],"/docs/pr-preview/pr-59/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3394":71197,"_29710":71191,"_5":30060,"_20617":121415,"_27008":121416,"_2880":119304},[],"/docs/pr-preview/pr-59/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3394":71198,"_29710":71191,"_5":30060,"_20617":121418,"_27008":121419,"_2880":119308},[],"/docs/pr-preview/pr-59/es/platform/pki/overview#emite-y-controla-certificados",{"_3394":71199,"_29710":71191,"_5":30060,"_20617":121421,"_27008":121422,"_2880":119316},[],"/docs/pr-preview/pr-59/es/platform/pki/overview#publica-el-estado-de-validación",{"_3394":71200,"_29710":71191,"_5":30060,"_20617":121424,"_27008":121425,"_2880":121426},[],"/docs/pr-preview/pr-59/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3394":71201,"_29710":71191,"_5":30060,"_20617":121428,"_27008":121429,"_2880":120253},[],"/docs/pr-preview/pr-59/es/platform/pki/overview#continúa",{"_3394":71202,"_29710":71191,"_20617":121431,"_5":14139,"_27008":71191,"_2880":121432},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3394":71203,"_29710":71191,"_20617":121434,"_5":14139,"_27008":121403,"_2880":121435},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3394":71204,"_29710":71191,"_20617":121437,"_5":14139,"_27008":121403,"_2880":121438},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3394":71205,"_29710":71191,"_20617":121440,"_5":14139,"_27008":121406,"_2880":121441},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3394":71206,"_29710":71191,"_20617":121443,"_5":14139,"_27008":121406,"_2880":121444},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3394":71207,"_29710":71191,"_20617":121446,"_5":14139,"_27008":121406,"_2880":121447},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3394":71208,"_29710":71191,"_20617":121449,"_5":14139,"_27008":121406,"_2880":121450},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3394":71209,"_29710":71191,"_20617":121452,"_5":14139,"_27008":121406,"_2880":121453},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3394":71210,"_29710":71191,"_20617":121455,"_5":14139,"_27008":121413,"_2880":121456},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3394":71211,"_29710":71191,"_20617":121458,"_5":14139,"_27008":121416,"_2880":121459},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3394":71212,"_29710":71191,"_20617":121461,"_5":14139,"_27008":121419,"_2880":121462},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3394":71213,"_29710":71191,"_20617":121464,"_5":14139,"_27008":121422,"_2880":121465},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3394":71214,"_29710":71191,"_20617":121467,"_5":14139,"_27008":121425,"_2880":121468},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3394":71215,"_29710":71191,"_20617":121470,"_5":14139,"_27008":121425,"_2880":121471},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3394":71216,"_29710":71191,"_20617":121473,"_5":14139,"_27008":121425,"_2880":121474},[],"su clave pública corresponda a la clave privada del cliente;",{"_3394":71217,"_29710":71191,"_20617":121476,"_5":14139,"_27008":121425,"_2880":121477},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3394":71218,"_29710":71191,"_20617":121479,"_5":14139,"_27008":121425,"_2880":121480},[],"sus fechas y usos permitan la operación;",{"_3394":71219,"_29710":71191,"_20617":121482,"_5":14139,"_27008":121425,"_2880":121483},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3394":71220,"_29710":71191,"_20617":121485,"_5":14139,"_27008":121425,"_2880":121486},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3394":71221,"_29710":71191,"_20617":121488,"_5":14139,"_27008":121429,"_2880":121489},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3394":71222,"_29710":71191,"_20617":121491,"_5":14139,"_27008":121429,"_2880":121492},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3394":71223,"_29710":71191,"_20617":121494,"_5":14139,"_27008":121429,"_2880":121495},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3394":71224,"_29710":71224,"_5":14491,"_2880":121497,"_30063":121498,"_20617":121499,"_27008":71224},"Crea tu primera CA",[48401,115575,53871,118900],[],{"_3394":71225,"_29710":71224,"_20617":121501,"_5":14139,"_27008":71224,"_2880":121502},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3394":71226,"_29710":71224,"_5":30060,"_20617":121504,"_27008":121505,"_2880":114153},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3394":71227,"_29710":71224,"_5":30060,"_20617":121507,"_27008":121508,"_2880":121509},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3394":71228,"_29710":71224,"_5":30060,"_20617":121511,"_27008":121512,"_2880":121513},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3394":71229,"_29710":71224,"_5":30060,"_20617":121515,"_27008":121516,"_2880":121517},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3394":71230,"_29710":71224,"_5":30060,"_20617":121519,"_27008":121520,"_2880":121521},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3394":71231,"_29710":71224,"_5":30060,"_20617":121523,"_27008":121524,"_2880":121525},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3394":71232,"_29710":71224,"_5":30060,"_20617":121527,"_27008":121528,"_2880":121529},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3394":71233,"_29710":71224,"_5":30060,"_20617":121531,"_27008":121532,"_2880":119147},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3394":71234,"_29710":71224,"_5":30060,"_20617":121534,"_27008":121535,"_2880":114177},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3394":71235,"_29710":71224,"_20617":121537,"_5":14139,"_27008":71224,"_2880":121538},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3394":71236,"_29710":71224,"_20617":121540,"_5":14139,"_27008":121505,"_2880":121541},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3394":71237,"_29710":71224,"_20617":121543,"_5":14139,"_27008":121505,"_2880":121544},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3394":71238,"_29710":71224,"_20617":121546,"_5":14139,"_27008":121505,"_2880":121547},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3394":71239,"_29710":71224,"_20617":121549,"_5":14139,"_27008":121505,"_2880":121550},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3394":71240,"_29710":71224,"_20617":121552,"_5":14139,"_27008":121508,"_2880":121553},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3394":71241,"_29710":71224,"_20617":121555,"_5":14139,"_27008":121508,"_2880":121556},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3394":71242,"_29710":71224,"_20617":121558,"_5":14139,"_27008":121512,"_2880":121559},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3394":71243,"_29710":71224,"_20617":121561,"_5":14139,"_27008":121512,"_2880":121562},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3394":71244,"_29710":71224,"_20617":121564,"_5":14139,"_27008":121516,"_2880":121565},[],"Selecciona **Root CA** y completa:",{"_3394":71245,"_29710":71224,"_20617":121567,"_5":14139,"_27008":121516,"_2880":56017},[],{"_3394":71246,"_29710":71224,"_20617":121569,"_5":14139,"_27008":121516,"_2880":121570},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3394":71247,"_29710":71224,"_20617":121572,"_5":14139,"_27008":121516,"_2880":121573},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3394":71248,"_29710":71224,"_20617":121575,"_5":14139,"_27008":121516,"_2880":121576},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3394":71249,"_29710":71224,"_20617":121578,"_5":14139,"_27008":121516,"_2880":121579},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3394":71250,"_29710":71224,"_20617":121581,"_5":14139,"_27008":121520,"_2880":121582},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3394":71251,"_29710":71224,"_20617":121584,"_5":14139,"_27008":121524,"_2880":121585},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3394":71252,"_29710":71224,"_20617":121587,"_5":14139,"_27008":121524,"_2880":121588},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3394":71253,"_29710":71224,"_20617":121590,"_5":14139,"_27008":121528,"_2880":121591},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3394":71254,"_29710":71224,"_20617":121593,"_5":14139,"_27008":121528,"_2880":121594},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3394":71255,"_29710":71224,"_20617":121596,"_5":14139,"_27008":121528,"_2880":121597},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3394":71256,"_29710":71224,"_20617":121599,"_5":14139,"_27008":121532,"_2880":121600},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3394":71257,"_29710":71224,"_20617":121602,"_5":14139,"_27008":121532,"_2880":121603},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3394":71258,"_29710":71224,"_20617":121605,"_5":14139,"_27008":121532,"_2880":121606},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3394":71259,"_29710":71224,"_20617":121608,"_5":14139,"_27008":121532,"_2880":121609},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3394":71260,"_29710":71224,"_20617":121611,"_5":14139,"_27008":121535,"_2880":121612},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3394":71261,"_29710":71261,"_5":14491,"_2880":121614,"_30063":121615,"_20617":121616,"_27008":71261},"Emite y verifica un certificado",[48401,115575,53871,118900],[],{"_3394":71262,"_29710":71261,"_20617":121618,"_5":14139,"_27008":71261,"_2880":121619},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3394":71263,"_29710":71261,"_5":30060,"_20617":121621,"_27008":121622,"_2880":114153},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3394":71264,"_29710":71261,"_5":30060,"_20617":121624,"_27008":121625,"_2880":121626},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3394":71265,"_29710":71261,"_5":30060,"_20617":121628,"_27008":121629,"_2880":121630},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3394":71266,"_29710":71261,"_5":30060,"_20617":121632,"_27008":121633,"_2880":121634},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3394":71267,"_29710":71261,"_5":30060,"_20617":121636,"_27008":121637,"_2880":121638},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3394":71268,"_29710":71261,"_5":30060,"_20617":121640,"_27008":121641,"_2880":121642},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3394":71269,"_29710":71261,"_5":30060,"_20617":121644,"_27008":121645,"_2880":121646},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3394":71270,"_29710":71261,"_5":30060,"_20617":121648,"_27008":121649,"_2880":121650},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3394":71271,"_29710":71261,"_5":30060,"_20617":121652,"_27008":121653,"_2880":121654},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3394":71272,"_29710":71261,"_5":30060,"_20617":121656,"_27008":121657,"_2880":121658},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3394":71273,"_29710":71261,"_5":30060,"_20617":121660,"_27008":121661,"_2880":119147},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3394":71274,"_29710":71261,"_5":30060,"_20617":121663,"_27008":121664,"_2880":114177},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3394":71275,"_29710":71261,"_20617":121666,"_5":14139,"_27008":71261,"_2880":121667},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3394":71276,"_29710":71261,"_20617":121669,"_5":14139,"_27008":121622,"_2880":121670},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3394":71277,"_29710":71261,"_20617":121672,"_5":14139,"_27008":121622,"_2880":121673},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3394":71278,"_29710":71261,"_20617":121675,"_5":14139,"_27008":121622,"_2880":121676},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3394":71279,"_29710":71261,"_20617":121678,"_5":14139,"_27008":121622,"_2880":121679},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3394":71280,"_29710":71261,"_20617":121681,"_5":14139,"_27008":121622,"_2880":121682},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3394":71281,"_29710":71261,"_20617":121684,"_5":14139,"_27008":121625,"_2880":121685},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3394":71282,"_29710":71261,"_20617":121687,"_5":14139,"_27008":121629,"_2880":121688},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3394":71283,"_29710":71261,"_20617":121690,"_5":14139,"_27008":121629,"_2880":121691},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3394":71284,"_29710":71261,"_20617":121693,"_5":14139,"_27008":121633,"_2880":121694},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3394":71285,"_29710":71261,"_20617":121696,"_5":14139,"_27008":121633,"_2880":121697},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3394":71286,"_29710":71261,"_20617":121699,"_5":14139,"_27008":121637,"_2880":121700},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3394":71287,"_29710":71261,"_20617":121702,"_5":14139,"_27008":121637,"_2880":121703},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3394":71288,"_29710":71261,"_20617":121705,"_5":14139,"_27008":121641,"_2880":121706},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3394":71289,"_29710":71261,"_20617":121708,"_5":14139,"_27008":121645,"_2880":121709},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3394":71290,"_29710":71261,"_20617":121711,"_5":14139,"_27008":121649,"_2880":121712},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3394":71291,"_29710":71261,"_20617":121714,"_5":14139,"_27008":121653,"_2880":121715},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3394":71292,"_29710":71261,"_20617":121717,"_5":14139,"_27008":121653,"_2880":121718},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3394":71293,"_29710":71261,"_20617":121720,"_5":14139,"_27008":121653,"_2880":121721},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3394":71294,"_29710":71261,"_20617":121723,"_5":14139,"_27008":121657,"_2880":121724},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3394":71295,"_29710":71261,"_20617":121726,"_5":14139,"_27008":121657,"_2880":121727},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3394":71296,"_29710":71261,"_20617":121729,"_5":14139,"_27008":121657,"_2880":121730},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3394":71297,"_29710":71261,"_20617":121732,"_5":14139,"_27008":121661,"_2880":119230},[],{"_3394":71298,"_29710":71261,"_20617":121734,"_5":14139,"_27008":121661,"_2880":117751},[],{"_3394":71299,"_29710":71261,"_20617":121736,"_5":14139,"_27008":121661,"_2880":121737},[],"La CA rechaza la emisión",{"_3394":71300,"_29710":71261,"_20617":121739,"_5":14139,"_27008":121661,"_2880":121740},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3394":71301,"_29710":71261,"_20617":121742,"_5":14139,"_27008":121661,"_2880":121743},[],"Sujeto o usos diferentes",{"_3394":71302,"_29710":71261,"_20617":121745,"_5":14139,"_27008":121661,"_2880":121746},[],"Perfil aplicado y valores solicitados.",{"_3394":71303,"_29710":71261,"_20617":121748,"_5":14139,"_27008":121661,"_2880":121749},[],"No se encuentra el emisor",{"_3394":71304,"_29710":71261,"_20617":121751,"_5":14139,"_27008":121661,"_2880":121752},[],"CA descargada y cadena intermedia necesaria.",{"_3394":71305,"_29710":71261,"_20617":121754,"_5":14139,"_27008":121661,"_2880":121755},[],"Falla la vigencia",{"_3394":71306,"_29710":71261,"_20617":121757,"_5":14139,"_27008":121661,"_2880":121758},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3394":71307,"_29710":71261,"_20617":121760,"_5":14139,"_27008":121661,"_2880":121761},[],"Los resúmenes de clave difieren",{"_3394":71308,"_29710":71261,"_20617":121763,"_5":14139,"_27008":121661,"_2880":121764},[],"Archivos de certificado y clave de la misma emisión.",{"_3394":71309,"_29710":71261,"_20617":121766,"_5":14139,"_27008":121661,"_2880":121767},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3394":71310,"_29710":71261,"_20617":121769,"_5":14139,"_27008":121664,"_2880":121770},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3394":71311,"_29710":71261,"_20617":121772,"_5":14139,"_27008":121664,"_2880":121773},[],"Gestionar certificados para inspección, estado y revocación.",{"_3394":71312,"_29710":71261,"_20617":121775,"_5":14139,"_27008":121664,"_2880":121776},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3394":71313,"_29710":71261,"_20617":121778,"_5":14139,"_27008":121664,"_2880":121779},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3394":71314,"_29710":71261,"_20617":121781,"_5":14139,"_27008":121664,"_2880":121782},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3394":71315,"_29710":71315,"_5":14491,"_2880":121784,"_30063":121785,"_20617":121786,"_27008":71315},"Primeros pasos de PKI",[48401,115575,53871,118900],[],{"_3394":71316,"_29710":71315,"_20617":121788,"_5":14139,"_27008":71315,"_2880":121789},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3394":71317,"_29710":71315,"_5":30060,"_20617":121791,"_27008":121792,"_2880":114153},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3394":71318,"_29710":71315,"_5":30060,"_20617":121794,"_27008":121795,"_2880":121796},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3394":71319,"_29710":71315,"_5":30060,"_20617":121798,"_27008":121799,"_2880":119082},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3394":71320,"_29710":71315,"_5":30060,"_20617":121801,"_27008":121802,"_2880":121803},[],"/docs/pr-preview/pr-59/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3394":71321,"_29710":71315,"_20617":121805,"_5":14139,"_27008":71315,"_2880":121806},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3394":71322,"_29710":71315,"_20617":121808,"_5":14139,"_27008":121792,"_2880":121809},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3394":71323,"_29710":71315,"_20617":121811,"_5":14139,"_27008":121792,"_2880":121812},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3394":71324,"_29710":71315,"_20617":121814,"_5":14139,"_27008":121792,"_2880":121815},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3394":71325,"_29710":71315,"_20617":121817,"_5":14139,"_27008":121792,"_2880":121818},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3394":71326,"_29710":71315,"_20617":121820,"_5":14139,"_27008":121792,"_2880":121821},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3394":71327,"_29710":71315,"_20617":121823,"_5":14139,"_27008":121795,"_2880":121824},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3394":71328,"_29710":71315,"_20617":121826,"_5":14139,"_27008":121795,"_2880":121827},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3394":71329,"_29710":71315,"_20617":121829,"_5":14139,"_27008":121795,"_2880":121830},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3394":71330,"_29710":71315,"_20617":121832,"_5":14139,"_27008":121795,"_2880":121833},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3394":71331,"_29710":71315,"_20617":121835,"_5":14139,"_27008":121799,"_2880":121836},[],"Archivo o recurso",{"_3394":71332,"_29710":71315,"_20617":121838,"_5":14139,"_27008":121799,"_2880":119079},[],{"_3394":71333,"_29710":71315,"_20617":121840,"_5":14139,"_27008":121799,"_2880":121841},[],"CA raíz activa y `ca.pem`",{"_3394":71334,"_29710":71315,"_20617":121843,"_5":14139,"_27008":121799,"_2880":121844},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3394":71335,"_29710":71315,"_20617":121846,"_5":14139,"_27008":121799,"_2880":121847},[],"Certificado final y `device.crt`",{"_3394":71336,"_29710":71315,"_20617":121849,"_5":14139,"_27008":121799,"_2880":121850},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3394":71337,"_29710":71315,"_20617":121852,"_5":14139,"_27008":121799,"_2880":121853},[],"Clave privada `device.key`",{"_3394":71338,"_29710":71315,"_20617":121855,"_5":14139,"_27008":121799,"_2880":121856},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3394":71339,"_29710":71315,"_20617":121858,"_5":14139,"_27008":121799,"_2880":121859},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3394":71340,"_29710":71315,"_20617":121861,"_5":14139,"_27008":121802,"_2880":121862},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3394":71341,"_29710":71315,"_20617":121864,"_5":14139,"_27008":121802,"_2880":121865},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3394":71342,"_29710":71315,"_20617":121867,"_5":14139,"_27008":121802,"_2880":121868},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3394":71343,"_29710":71343,"_5":14491,"_2880":121870,"_30063":121871,"_20617":121873,"_27008":71343},"Resolución de problemas PKI",[48401,115575,53871,121872],"Resolución de problemas",[],{"_3394":71344,"_29710":71343,"_20617":121875,"_5":14139,"_27008":71343,"_2880":121876},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3394":71345,"_29710":71343,"_5":30060,"_20617":121878,"_27008":121879,"_2880":121880},[],"/docs/pr-preview/pr-59/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3394":71346,"_29710":71343,"_5":30060,"_20617":121882,"_27008":121883,"_2880":121884},[],"/docs/pr-preview/pr-59/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3394":71347,"_29710":71343,"_5":30060,"_20617":121886,"_27008":121887,"_2880":121888},[],"/docs/pr-preview/pr-59/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3394":71348,"_29710":71343,"_20617":121890,"_5":14139,"_27008":71343,"_2880":121891},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3394":71349,"_29710":71343,"_20617":121893,"_5":14139,"_27008":71343,"_2880":121894},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3394":71350,"_29710":71343,"_20617":121896,"_5":14139,"_27008":121879,"_2880":119079},[],{"_3394":71351,"_29710":71343,"_20617":121898,"_5":14139,"_27008":121879,"_2880":117751},[],{"_3394":71352,"_29710":71343,"_20617":121900,"_5":14139,"_27008":121879,"_2880":114177},[],{"_3394":71353,"_29710":71343,"_20617":121902,"_5":14139,"_27008":121879,"_2880":52713},[],{"_3394":71354,"_29710":71343,"_20617":121904,"_5":14139,"_27008":121879,"_2880":121905},[],"Existe, está activa y sus fechas son utilizables.",{"_3394":71355,"_29710":71343,"_20617":121907,"_5":14139,"_27008":121879,"_2880":121908},[],"Autoridades.",{"_3394":71356,"_29710":71343,"_20617":121910,"_5":14139,"_27008":121879,"_2880":121911},[],"Clave",{"_3394":71357,"_29710":71343,"_20617":121913,"_5":14139,"_27008":121879,"_2880":121914},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3394":71358,"_29710":71343,"_20617":121916,"_5":14139,"_27008":121879,"_2880":121917},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3394":71359,"_29710":71343,"_20617":121919,"_5":14139,"_27008":121879,"_2880":56371},[],{"_3394":71360,"_29710":71343,"_20617":121921,"_5":14139,"_27008":121879,"_2880":121922},[],"PEM correcto y firma verificable.",{"_3394":71361,"_29710":71343,"_20617":121924,"_5":14139,"_27008":121879,"_2880":56377},[],{"_3394":71362,"_29710":71343,"_20617":121926,"_5":14139,"_27008":121879,"_2880":121927},[],"Perfil",{"_3394":71363,"_29710":71343,"_20617":121929,"_5":14139,"_27008":121879,"_2880":121930},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3394":71364,"_29710":71343,"_20617":121932,"_5":14139,"_27008":121879,"_2880":121933},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3394":71365,"_29710":71343,"_20617":121935,"_5":14139,"_27008":121879,"_2880":119230},[],{"_3394":71366,"_29710":71343,"_20617":121937,"_5":14139,"_27008":121879,"_2880":121938},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3394":71367,"_29710":71343,"_20617":121940,"_5":14139,"_27008":121879,"_2880":121941},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3394":71368,"_29710":71343,"_20617":121943,"_5":14139,"_27008":121879,"_2880":121944},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3394":71369,"_29710":71343,"_20617":121946,"_5":14139,"_27008":121879,"_2880":121947},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3394":71370,"_29710":71343,"_20617":121949,"_5":14139,"_27008":121883,"_2880":121950},[],"Revisa cada frontera por separado:",{"_3394":71371,"_29710":71343,"_20617":121952,"_5":14139,"_27008":121883,"_2880":121953},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3394":71372,"_29710":71343,"_20617":121955,"_5":14139,"_27008":121883,"_2880":121956},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3394":71373,"_29710":71343,"_20617":121958,"_5":14139,"_27008":121883,"_2880":121959},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3394":71374,"_29710":71343,"_20617":121961,"_5":14139,"_27008":121883,"_2880":121962},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3394":71375,"_29710":71343,"_20617":121964,"_5":14139,"_27008":121883,"_2880":121965},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3394":71376,"_29710":71343,"_20617":121967,"_5":14139,"_27008":121883,"_2880":121968},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3394":71377,"_29710":71343,"_20617":121970,"_5":14139,"_27008":121887,"_2880":121971},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3394":71378,"_29710":71343,"_20617":121973,"_5":14139,"_27008":121887,"_2880":121974},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3394":71379,"_29710":71379,"_5":14491,"_2880":121976,"_30063":121977,"_20617":121978,"_27008":71379},"Seguridad",[48401],[],{"_3394":71380,"_29710":71379,"_20617":121980,"_5":14139,"_27008":71379,"_2880":121981},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3394":71381,"_29710":71379,"_5":30060,"_20617":121983,"_27008":121984,"_2880":121985},[],"/docs/pr-preview/pr-59/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3394":71382,"_29710":71379,"_5":30060,"_20617":121987,"_27008":121988,"_2880":121989},[],"/docs/pr-preview/pr-59/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3394":71383,"_29710":71379,"_5":30060,"_20617":121991,"_27008":121992,"_2880":121993},[],"/docs/pr-preview/pr-59/es/security#versiones-soportadas","Versiones soportadas",{"_3394":71384,"_29710":71379,"_5":30060,"_20617":121995,"_27008":121996,"_2880":121997},[],"/docs/pr-preview/pr-59/es/security#divulgación-responsable","Divulgación responsable",{"_3394":71385,"_29710":71379,"_20617":121999,"_5":14139,"_27008":71379,"_2880":122000},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3394":71386,"_29710":71379,"_20617":122002,"_5":14139,"_27008":121984,"_2880":122003},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3394":71387,"_29710":71379,"_20617":122005,"_5":14139,"_27008":121984,"_2880":122006},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3394":71388,"_29710":71379,"_20617":122008,"_5":14139,"_27008":121984,"_2880":14758},[],{"_3394":71389,"_29710":71379,"_20617":122010,"_5":14139,"_27008":121984,"_2880":14704},[],{"_3394":71390,"_29710":71379,"_20617":122012,"_5":14139,"_27008":121984,"_2880":14751},[],{"_3394":71391,"_29710":71379,"_20617":122014,"_5":14139,"_27008":121984,"_2880":122015},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3394":71392,"_29710":71379,"_20617":122017,"_5":14139,"_27008":121984,"_2880":122018},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3394":71393,"_29710":71379,"_20617":122020,"_5":14139,"_27008":121988,"_2880":122021},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3394":71394,"_29710":71379,"_20617":122023,"_5":14139,"_27008":121988,"_2880":122024},[],"No incluyas en el reporte:",{"_3394":71395,"_29710":71379,"_20617":122026,"_5":14139,"_27008":121988,"_2880":122027},[],"Credenciales, tokens o claves privadas",{"_3394":71396,"_29710":71379,"_20617":122029,"_5":14139,"_27008":121988,"_2880":122030},[],"Datos de clientes o información identificable de clientes",{"_3394":71397,"_29710":71379,"_20617":122032,"_5":14139,"_27008":121988,"_2880":122033},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3394":71398,"_29710":71379,"_20617":122035,"_5":14139,"_27008":121992,"_2880":122036},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3394":71399,"_29710":71379,"_20617":122038,"_5":14139,"_27008":121992,"_2880":122039},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3394":71400,"_29710":71379,"_20617":122041,"_5":14139,"_27008":121996,"_2880":122042},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3394":71401,"_29710":71379,"_20617":122044,"_5":14139,"_27008":121996,"_2880":122045},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3394":71402,"_29710":71379,"_20617":122047,"_5":14139,"_27008":121996,"_2880":122048},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3394":71403,"_29710":71379,"_20617":122050,"_5":14139,"_27008":121996,"_2880":122051},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3394":71404,"_29710":71379,"_20617":122053,"_5":14139,"_27008":121996,"_2880":122054},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3394":71405,"_29710":71405,"_5":14491,"_2880":122056,"_30063":122057,"_20617":122059,"_27008":71405},"3.8.0 a 4.0.0",[48401,122058],"Actualizaciones",[],{"_3394":71406,"_29710":71405,"_20617":122061,"_5":14139,"_27008":71405,"_2880":122062},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3394":71407,"_29710":71405,"_5":30060,"_20617":122064,"_27008":122065,"_2880":122066},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3394":71408,"_29710":71405,"_5":30060,"_20617":122068,"_27008":122069,"_2880":122070},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3394":71409,"_29710":71405,"_5":30060,"_20617":122072,"_27008":122073,"_2880":122074},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3394":71410,"_29710":71405,"_5":30060,"_20617":122076,"_27008":122077,"_2880":122078},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3394":71411,"_29710":71405,"_5":30060,"_20617":122080,"_27008":122081,"_2880":122082},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3394":71412,"_29710":71405,"_5":30060,"_20617":122084,"_27008":122085,"_2880":122086},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3394":71413,"_29710":71405,"_5":30060,"_20617":122088,"_27008":122089,"_2880":56543},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3394":71414,"_29710":71405,"_5":30060,"_20617":122091,"_27008":122092,"_2880":122093},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3394":71415,"_29710":71405,"_5":30060,"_20617":122095,"_27008":122096,"_2880":122097},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3394":71416,"_29710":71405,"_5":30060,"_20617":122099,"_27008":122100,"_2880":122101},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3394":71417,"_29710":71405,"_5":30060,"_20617":122103,"_27008":122104,"_2880":122105},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3394":71418,"_29710":71405,"_5":30060,"_20617":122107,"_27008":122108,"_2880":122109},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3394":71419,"_29710":71405,"_5":30060,"_20617":122111,"_27008":122112,"_2880":122113},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3394":71420,"_29710":71405,"_5":30060,"_20617":122115,"_27008":122116,"_2880":122117},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3394":71421,"_29710":71405,"_5":30060,"_20617":122119,"_27008":122120,"_2880":122121},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3394":71422,"_29710":71405,"_5":30060,"_20617":122123,"_27008":122124,"_2880":122125},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3394":71423,"_29710":71405,"_5":30060,"_20617":122127,"_27008":122128,"_2880":122129},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3394":71424,"_29710":71405,"_5":30060,"_20617":122131,"_27008":122132,"_2880":122133},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3394":71425,"_29710":71405,"_5":30060,"_20617":122135,"_27008":122136,"_2880":122137},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3394":71426,"_29710":71405,"_5":30060,"_20617":122139,"_27008":122140,"_2880":122141},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3394":71427,"_29710":71405,"_5":30060,"_20617":122143,"_27008":122144,"_2880":122145},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3394":71428,"_29710":71405,"_5":30060,"_20617":122147,"_27008":122148,"_2880":122149},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3394":71429,"_29710":71405,"_5":30060,"_20617":122151,"_27008":122152,"_2880":122153},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3394":71430,"_29710":71405,"_5":30060,"_20617":122155,"_27008":122156,"_2880":122157},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3394":71431,"_29710":71405,"_5":30060,"_20617":122159,"_27008":122160,"_2880":122161},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3394":71432,"_29710":71405,"_5":30060,"_20617":122163,"_27008":122164,"_2880":122165},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3394":71433,"_29710":71405,"_5":30060,"_20617":122167,"_27008":122168,"_2880":122169},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3394":71434,"_29710":71405,"_5":30060,"_20617":122171,"_27008":122172,"_2880":122173},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3394":71435,"_29710":71405,"_5":30060,"_20617":122175,"_27008":122176,"_2880":122177},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3394":71436,"_29710":71405,"_5":30060,"_20617":122179,"_27008":122180,"_2880":122181},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3394":71437,"_29710":71405,"_5":30060,"_20617":122183,"_27008":122184,"_2880":122185},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3394":71438,"_29710":71405,"_5":30060,"_20617":122187,"_27008":122188,"_2880":122189},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3394":71439,"_29710":71405,"_5":30060,"_20617":122191,"_27008":122192,"_2880":122193},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3394":71440,"_29710":71405,"_5":30060,"_20617":122195,"_27008":122196,"_2880":122197},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3394":71441,"_29710":71405,"_5":30060,"_20617":122199,"_27008":122200,"_2880":122201},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3394":71442,"_29710":71405,"_5":30060,"_20617":122203,"_27008":122204,"_2880":122205},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3394":71443,"_29710":71405,"_5":30060,"_20617":122207,"_27008":122208,"_2880":118093},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3394":71444,"_29710":71405,"_5":30060,"_20617":122210,"_27008":122211,"_2880":122212},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3394":71445,"_29710":71405,"_5":30060,"_20617":122214,"_27008":122215,"_2880":122216},[],"/docs/pr-preview/pr-59/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3394":71446,"_29710":71405,"_20617":122218,"_5":14139,"_27008":71405,"_2880":122219},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3394":71447,"_29710":71405,"_20617":122221,"_5":14139,"_27008":71405,"_2880":122222},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3394":71448,"_29710":71405,"_20617":122224,"_5":14139,"_27008":71405,"_2880":122225},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3394":71449,"_29710":71405,"_20617":122227,"_5":14139,"_27008":71405,"_2880":122228},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3394":71450,"_29710":71405,"_20617":122230,"_5":14139,"_27008":71405,"_2880":122231},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3394":71451,"_29710":71405,"_20617":122233,"_5":14139,"_27008":71405,"_2880":122234},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3394":71452,"_29710":71405,"_20617":122236,"_5":14139,"_27008":71405,"_2880":122237},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3394":71453,"_29710":71405,"_20617":122239,"_5":14139,"_27008":122069,"_2880":122240},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3394":71454,"_29710":71405,"_20617":122242,"_5":14139,"_27008":122069,"_2880":122243},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3394":71455,"_29710":71405,"_20617":122245,"_5":14139,"_27008":122073,"_2880":122246},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3394":71456,"_29710":71405,"_20617":122248,"_5":14139,"_27008":122073,"_2880":122249},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3394":71457,"_29710":71405,"_20617":122251,"_5":14139,"_27008":122077,"_2880":122252},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3394":71458,"_29710":71405,"_20617":122254,"_5":14139,"_27008":122081,"_2880":122255},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3394":71459,"_29710":71405,"_20617":122257,"_5":14139,"_27008":122081,"_2880":122258},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3394":71460,"_29710":71405,"_20617":122260,"_5":14139,"_27008":122081,"_2880":122261},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3394":71461,"_29710":71405,"_20617":122263,"_5":14139,"_27008":122081,"_2880":122264},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3394":71462,"_29710":71405,"_20617":122266,"_5":14139,"_27008":122081,"_2880":122267},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3394":71463,"_29710":71405,"_20617":122269,"_5":14139,"_27008":122085,"_2880":122270},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3394":71464,"_29710":71405,"_20617":122272,"_5":14139,"_27008":122085,"_2880":122273},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3394":71465,"_29710":71405,"_20617":122275,"_5":14139,"_27008":122085,"_2880":122276},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3394":71466,"_29710":71405,"_20617":122278,"_5":14139,"_27008":122085,"_2880":122279},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3394":71467,"_29710":71405,"_20617":122281,"_5":14139,"_27008":122085,"_2880":122282},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3394":71468,"_29710":71405,"_20617":122284,"_5":14139,"_27008":122085,"_2880":122285},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3394":71469,"_29710":71405,"_20617":122287,"_5":14139,"_27008":122089,"_2880":122288},[],"Cambio",{"_3394":71470,"_29710":71405,"_20617":122290,"_5":14139,"_27008":122089,"_2880":122291},[],"A quién afecta",{"_3394":71471,"_29710":71405,"_20617":122293,"_5":14139,"_27008":122089,"_2880":122294},[],"Gravedad",{"_3394":71472,"_29710":71405,"_20617":122296,"_5":14139,"_27008":122089,"_2880":120816},[],{"_3394":71473,"_29710":71405,"_20617":122298,"_5":14139,"_27008":122089,"_2880":122097},[],{"_3394":71474,"_29710":71405,"_20617":122300,"_5":14139,"_27008":122089,"_2880":122301},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3394":71475,"_29710":71405,"_20617":122303,"_5":14139,"_27008":122089,"_2880":122304},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3394":71476,"_29710":71405,"_20617":122306,"_5":14139,"_27008":122089,"_2880":122307},[],"Copiar los datos a los volúmenes nuevos",{"_3394":71477,"_29710":71405,"_20617":122309,"_5":14139,"_27008":122089,"_2880":122101},[],{"_3394":71478,"_29710":71405,"_20617":122311,"_5":14139,"_27008":122089,"_2880":122312},[],"Todas las releases de Helm",{"_3394":71479,"_29710":71405,"_20617":122314,"_5":14139,"_27008":122089,"_2880":122315},[],"Alta: `helm upgrade` falla",{"_3394":71480,"_29710":71405,"_20617":122317,"_5":14139,"_27008":122089,"_2880":122318},[],"Eliminar o renombrar las claves heredadas",{"_3394":71481,"_29710":71405,"_20617":122320,"_5":14139,"_27008":122089,"_2880":122105},[],{"_3394":71482,"_29710":71405,"_20617":122322,"_5":14139,"_27008":122089,"_2880":122323},[],"Todos los despliegues",{"_3394":71483,"_29710":71405,"_20617":122325,"_5":14139,"_27008":122089,"_2880":122326},[],"Alta: sin principal de bootstrap no hay administrador",{"_3394":71484,"_29710":71405,"_20617":122328,"_5":14139,"_27008":122089,"_2880":122329},[],"Configurar `services.authz`",{"_3394":71485,"_29710":71405,"_20617":122331,"_5":14139,"_27008":122089,"_2880":122109},[],{"_3394":71486,"_29710":71405,"_20617":122333,"_5":14139,"_27008":122089,"_2880":122312},[],{"_3394":71487,"_29710":71405,"_20617":122335,"_5":14139,"_27008":122089,"_2880":122336},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3394":71488,"_29710":71405,"_20617":122338,"_5":14139,"_27008":122089,"_2880":122339},[],"Mover JWKS y roles a `services.authz`",{"_3394":71489,"_29710":71405,"_20617":122341,"_5":14139,"_27008":122089,"_2880":122129},[],{"_3394":71490,"_29710":71405,"_20617":122343,"_5":14139,"_27008":122089,"_2880":122344},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3394":71491,"_29710":71405,"_20617":122346,"_5":14139,"_27008":122089,"_2880":122347},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3394":71492,"_29710":71405,"_20617":122349,"_5":14139,"_27008":122089,"_2880":122350},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3394":71493,"_29710":71405,"_20617":122352,"_5":14139,"_27008":122089,"_2880":122133},[],{"_3394":71494,"_29710":71405,"_20617":122354,"_5":14139,"_27008":122089,"_2880":122355},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3394":71495,"_29710":71405,"_20617":122357,"_5":14139,"_27008":122089,"_2880":122358},[],"Alta: el backend ya no arranca con ellos",{"_3394":71496,"_29710":71405,"_20617":122360,"_5":14139,"_27008":122089,"_2880":122361},[],"Pasar a PostgreSQL antes de actualizar",{"_3394":71497,"_29710":71405,"_20617":122363,"_5":14139,"_27008":122089,"_2880":122364},[],"Webhooks con referencias a archivos",{"_3394":71498,"_29710":71405,"_20617":122366,"_5":14139,"_27008":122089,"_2880":122367},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3394":71499,"_29710":71405,"_20617":122369,"_5":14139,"_27008":122089,"_2880":122370},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3394":71500,"_29710":71405,"_20617":122372,"_5":14139,"_27008":122089,"_2880":122373},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3394":71501,"_29710":71405,"_20617":122375,"_5":14139,"_27008":122089,"_2880":122113},[],{"_3394":71502,"_29710":71405,"_20617":122377,"_5":14139,"_27008":122089,"_2880":122378},[],"Releases con identidades por servicio o material de claves montado",{"_3394":71503,"_29710":71405,"_20617":122380,"_5":14139,"_27008":122089,"_2880":122381},[],"Media: los servicios no pueden leer sus archivos",{"_3394":71504,"_29710":71405,"_20617":122383,"_5":14139,"_27008":122089,"_2880":122384},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3394":71505,"_29710":71405,"_20617":122386,"_5":14139,"_27008":122089,"_2880":122117},[],{"_3394":71506,"_29710":71405,"_20617":122388,"_5":14139,"_27008":122089,"_2880":122389},[],"Releases que definen `amqp.tls`",{"_3394":71507,"_29710":71405,"_20617":122391,"_5":14139,"_27008":122089,"_2880":122392},[],"Media: los clientes se conectan al puerto equivocado",{"_3394":71508,"_29710":71405,"_20617":122394,"_5":14139,"_27008":122089,"_2880":122395},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3394":71509,"_29710":71405,"_20617":122397,"_5":14139,"_27008":122089,"_2880":122137},[],{"_3394":71510,"_29710":71405,"_20617":122399,"_5":14139,"_27008":122089,"_2880":122400},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3394":71511,"_29710":71405,"_20617":122402,"_5":14139,"_27008":122089,"_2880":122403},[],"Media: las claves de CA quedan sin gestionar",{"_3394":71512,"_29710":71405,"_20617":122405,"_5":14139,"_27008":122089,"_2880":122406},[],"Ejecutar la migración de CA a KMS",{"_3394":71513,"_29710":71405,"_20617":122408,"_5":14139,"_27008":122089,"_2880":122409},[],"Verificación del certificado del receptor",{"_3394":71514,"_29710":71405,"_20617":122411,"_5":14139,"_27008":122089,"_2880":122412},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3394":71515,"_29710":71405,"_20617":122414,"_5":14139,"_27008":122089,"_2880":122415},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3394":71516,"_29710":71405,"_20617":122417,"_5":14139,"_27008":122089,"_2880":122418},[],"Poner `insecure_skip_verify` a `false`",{"_3394":71517,"_29710":71405,"_20617":122420,"_5":14139,"_27008":122089,"_2880":122153},[],{"_3394":71518,"_29710":71405,"_20617":122422,"_5":14139,"_27008":122089,"_2880":122423},[],"Scripts y consolas que editan DMS por API",{"_3394":71519,"_29710":71405,"_20617":122425,"_5":14139,"_27008":122089,"_2880":122426},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3394":71520,"_29710":71405,"_20617":122428,"_5":14139,"_27008":122089,"_2880":122429},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3394":71521,"_29710":71405,"_20617":122431,"_5":14139,"_27008":122089,"_2880":122173},[],{"_3394":71522,"_29710":71405,"_20617":122433,"_5":14139,"_27008":122089,"_2880":122434},[],"Clientes que crean o actualizan roles VA por API",{"_3394":71523,"_29710":71405,"_20617":122436,"_5":14139,"_27008":122089,"_2880":122437},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3394":71524,"_29710":71405,"_20617":122439,"_5":14139,"_27008":122089,"_2880":122440},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3394":71525,"_29710":71405,"_20617":122442,"_5":14139,"_27008":122089,"_2880":122169},[],{"_3394":71526,"_29710":71405,"_20617":122444,"_5":14139,"_27008":122089,"_2880":122445},[],"Consumidores que leen el campo `events` del dispositivo",{"_3394":71527,"_29710":71405,"_20617":122447,"_5":14139,"_27008":122089,"_2880":122448},[],"Media: el campo desaparece",{"_3394":71528,"_29710":71405,"_20617":122450,"_5":14139,"_27008":122089,"_2880":122451},[],"Usar los nuevos endpoints de eventos",{"_3394":71529,"_29710":71405,"_20617":122453,"_5":14139,"_27008":122089,"_2880":122177},[],{"_3394":71530,"_29710":71405,"_20617":122455,"_5":14139,"_27008":122089,"_2880":122456},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3394":71531,"_29710":71405,"_20617":122458,"_5":14139,"_27008":122089,"_2880":122459},[],"Media: la migración de la VA aborta",{"_3394":71532,"_29710":71405,"_20617":122461,"_5":14139,"_27008":122089,"_2880":122462},[],"Corregir los roles afectados antes de actualizar",{"_3394":71533,"_29710":71405,"_20617":122464,"_5":14139,"_27008":122089,"_2880":122121},[],{"_3394":71534,"_29710":71405,"_20617":122466,"_5":14139,"_27008":122089,"_2880":122467},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3394":71535,"_29710":71405,"_20617":122469,"_5":14139,"_27008":122089,"_2880":122470},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3394":71536,"_29710":71405,"_20617":122472,"_5":14139,"_27008":122089,"_2880":122473},[],"Actualizar el archivo de values",{"_3394":71537,"_29710":71405,"_20617":122475,"_5":14139,"_27008":122089,"_2880":122161},[],{"_3394":71538,"_29710":71405,"_20617":122477,"_5":14139,"_27008":122089,"_2880":122478},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3394":71539,"_29710":71405,"_20617":122480,"_5":14139,"_27008":122089,"_2880":122481},[],"Baja: prevalece el ID de la URL",{"_3394":71540,"_29710":71405,"_20617":122483,"_5":14139,"_27008":122089,"_2880":122484},[],"Enviar el ID en la URL",{"_3394":71541,"_29710":71405,"_20617":122486,"_5":14139,"_27008":122089,"_2880":122165},[],{"_3394":71542,"_29710":71405,"_20617":122488,"_5":14139,"_27008":122089,"_2880":122489},[],"Consumidores que comparan el `type` del certificado",{"_3394":71543,"_29710":71405,"_20617":122491,"_5":14139,"_27008":122089,"_2880":122492},[],"Baja: dos valores cambian de nombre",{"_3394":71544,"_29710":71405,"_20617":122494,"_5":14139,"_27008":122089,"_2880":122495},[],"Adaptar los consumidores",{"_3394":71545,"_29710":71405,"_20617":122497,"_5":14139,"_27008":122089,"_2880":122157},[],{"_3394":71546,"_29710":71405,"_20617":122499,"_5":14139,"_27008":122089,"_2880":122500},[],"Cualquier DMS",{"_3394":71547,"_29710":71405,"_20617":122502,"_5":14139,"_27008":122089,"_2880":122503},[],"Baja: solo informativo",{"_3394":71548,"_29710":71405,"_20617":122505,"_5":14139,"_27008":122089,"_2880":122506},[],"Revisar ambos bloques antes de editar",{"_3394":71549,"_29710":71405,"_20617":122508,"_5":14139,"_27008":122096,"_2880":122509},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3394":71550,"_29710":71405,"_20617":122511,"_5":14139,"_27008":122096,"_2880":122512},[],"El paso 4 de la guía de migración copia los datos.",{"_3394":71551,"_29710":71405,"_20617":122514,"_5":14139,"_27008":122100,"_2880":122515},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3394":71552,"_29710":71405,"_20617":122517,"_5":14139,"_27008":122104,"_2880":122518},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3394":71553,"_29710":71405,"_20617":122520,"_5":14139,"_27008":122108,"_2880":122521},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3394":71554,"_29710":71405,"_20617":122523,"_5":14139,"_27008":122112,"_2880":122524},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3394":71555,"_29710":71405,"_20617":122526,"_5":14139,"_27008":122112,"_2880":122527},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3394":71556,"_29710":71405,"_20617":122529,"_5":14139,"_27008":122116,"_2880":122530},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3394":71557,"_29710":71405,"_20617":122532,"_5":14139,"_27008":122120,"_2880":122533},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3394":71558,"_29710":71405,"_20617":122535,"_5":14139,"_27008":122120,"_2880":122536},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3394":71559,"_29710":71405,"_20617":122538,"_5":14139,"_27008":122120,"_2880":122539},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3394":71560,"_29710":71405,"_20617":122541,"_5":14139,"_27008":122120,"_2880":122542},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3394":71561,"_29710":71405,"_20617":122544,"_5":14139,"_27008":122120,"_2880":122545},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3394":71562,"_29710":71405,"_20617":122547,"_5":14139,"_27008":122120,"_2880":122548},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3394":71563,"_29710":71405,"_20617":122550,"_5":14139,"_27008":122128,"_2880":122551},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3394":71564,"_29710":71405,"_20617":122553,"_5":14139,"_27008":122128,"_2880":122554},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3394":71565,"_29710":71405,"_20617":122556,"_5":14139,"_27008":122128,"_2880":122557},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3394":71566,"_29710":71405,"_20617":122559,"_5":14139,"_27008":122128,"_2880":122560},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3394":71567,"_29710":71405,"_20617":122562,"_5":14139,"_27008":122128,"_2880":122563},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3394":71568,"_29710":71405,"_20617":122565,"_5":14139,"_27008":122132,"_2880":122566},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3394":71569,"_29710":71405,"_20617":122568,"_5":14139,"_27008":122136,"_2880":122569},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3394":71570,"_29710":71405,"_20617":122571,"_5":14139,"_27008":122136,"_2880":122572},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3394":71571,"_29710":71405,"_20617":122574,"_5":14139,"_27008":122136,"_2880":122575},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3394":71572,"_29710":71405,"_20617":122577,"_5":14139,"_27008":122136,"_2880":122578},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3394":71573,"_29710":71405,"_20617":122580,"_5":14139,"_27008":122136,"_2880":122581},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3394":71574,"_29710":71405,"_20617":122583,"_5":14139,"_27008":122136,"_2880":122584},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3394":71575,"_29710":71405,"_20617":122586,"_5":14139,"_27008":122136,"_2880":122587},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3394":71576,"_29710":71405,"_20617":122589,"_5":14139,"_27008":122136,"_2880":122590},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3394":71577,"_29710":71405,"_20617":122592,"_5":14139,"_27008":122140,"_2880":122593},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3394":71578,"_29710":71405,"_20617":122595,"_5":14139,"_27008":122148,"_2880":122596},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3394":71579,"_29710":71405,"_20617":122598,"_5":14139,"_27008":122148,"_2880":122599},[],"Campo en 3.8.0",{"_3394":71580,"_29710":71405,"_20617":122601,"_5":14139,"_27008":122148,"_2880":122602},[],"Campo en 4.0.0",{"_3394":71581,"_29710":71405,"_20617":122604,"_5":14139,"_27008":122148,"_2880":57059},[],{"_3394":71582,"_29710":71405,"_20617":122606,"_5":14139,"_27008":122148,"_2880":122607},[],"`insecure_skip_verify` (con el valor negado)",{"_3394":71583,"_29710":71405,"_20617":122609,"_5":14139,"_27008":122148,"_2880":57065},[],{"_3394":71584,"_29710":71405,"_20617":122611,"_5":14139,"_27008":122148,"_2880":57068},[],{"_3394":71585,"_29710":71405,"_20617":122613,"_5":14139,"_27008":122148,"_2880":57071},[],{"_3394":71586,"_29710":71405,"_20617":122615,"_5":14139,"_27008":122148,"_2880":57074},[],{"_3394":71587,"_29710":71405,"_20617":122617,"_5":14139,"_27008":122148,"_2880":57077},[],{"_3394":71588,"_29710":71405,"_20617":122619,"_5":14139,"_27008":122148,"_2880":57080},[],{"_3394":71589,"_29710":71405,"_20617":122621,"_5":14139,"_27008":122148,"_2880":122622},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3394":71590,"_29710":71405,"_20617":122624,"_5":14139,"_27008":122148,"_2880":122625},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3394":71591,"_29710":71405,"_20617":122627,"_5":14139,"_27008":122148,"_2880":122628},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3394":71592,"_29710":71405,"_20617":122630,"_5":14139,"_27008":122152,"_2880":122631},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3394":71593,"_29710":71405,"_20617":122633,"_5":14139,"_27008":122152,"_2880":122634},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3394":71594,"_29710":71405,"_20617":122636,"_5":14139,"_27008":122152,"_2880":122637},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3394":71595,"_29710":71405,"_20617":122639,"_5":14139,"_27008":122156,"_2880":122640},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3394":71596,"_29710":71405,"_20617":122642,"_5":14139,"_27008":122160,"_2880":122643},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3394":71597,"_29710":71405,"_20617":122645,"_5":14139,"_27008":122164,"_2880":122646},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3394":71598,"_29710":71405,"_20617":122648,"_5":14139,"_27008":122168,"_2880":122649},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3394":71599,"_29710":71405,"_20617":122651,"_5":14139,"_27008":122168,"_2880":122652},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3394":71600,"_29710":71405,"_20617":122654,"_5":14139,"_27008":122168,"_2880":122655},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3394":71601,"_29710":71405,"_20617":122657,"_5":14139,"_27008":122168,"_2880":122658},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3394":71602,"_29710":71405,"_20617":122660,"_5":14139,"_27008":122172,"_2880":122661},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3394":71603,"_29710":71405,"_20617":122663,"_5":14139,"_27008":122176,"_2880":122664},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3394":71604,"_29710":71405,"_20617":122666,"_5":14139,"_27008":122180,"_2880":122667},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3394":71605,"_29710":71405,"_20617":122669,"_5":14139,"_27008":122184,"_2880":122670},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3394":71606,"_29710":71405,"_20617":122672,"_5":14139,"_27008":122184,"_2880":122673},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3394":71607,"_29710":71405,"_20617":122675,"_5":14139,"_27008":122184,"_2880":122676},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3394":71608,"_29710":71405,"_20617":122678,"_5":14139,"_27008":122184,"_2880":122679},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3394":71609,"_29710":71405,"_20617":122681,"_5":14139,"_27008":122184,"_2880":122682},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3394":71610,"_29710":71405,"_20617":122684,"_5":14139,"_27008":122188,"_2880":122685},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3394":71611,"_29710":71405,"_20617":122687,"_5":14139,"_27008":122188,"_2880":122688},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3394":71612,"_29710":71405,"_20617":122690,"_5":14139,"_27008":122188,"_2880":122691},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3394":71613,"_29710":71405,"_20617":122693,"_5":14139,"_27008":122188,"_2880":122694},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3394":71614,"_29710":71405,"_20617":122696,"_5":14139,"_27008":122188,"_2880":122697},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3394":71615,"_29710":71405,"_20617":122699,"_5":14139,"_27008":122188,"_2880":122700},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3394":71616,"_29710":71405,"_20617":122702,"_5":14139,"_27008":122188,"_2880":122703},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3394":71617,"_29710":71405,"_20617":122705,"_5":14139,"_27008":122188,"_2880":122706},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3394":71618,"_29710":71405,"_20617":122708,"_5":14139,"_27008":122188,"_2880":122709},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3394":71619,"_29710":71405,"_20617":122711,"_5":14139,"_27008":122188,"_2880":122712},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3394":71620,"_29710":71405,"_20617":122714,"_5":14139,"_27008":122188,"_2880":122715},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3394":71621,"_29710":71405,"_20617":122717,"_5":14139,"_27008":122188,"_2880":122718},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3394":71622,"_29710":71405,"_20617":122720,"_5":14139,"_27008":122192,"_2880":122721},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3394":71623,"_29710":71405,"_20617":122723,"_5":14139,"_27008":122192,"_2880":122724},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3394":71624,"_29710":71405,"_20617":122726,"_5":14139,"_27008":122196,"_2880":122727},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3394":71625,"_29710":71405,"_20617":122729,"_5":14139,"_27008":122196,"_2880":122730},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3394":71626,"_29710":71405,"_20617":122732,"_5":14139,"_27008":122196,"_2880":122733},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3394":71627,"_29710":71405,"_20617":122735,"_5":14139,"_27008":122196,"_2880":122736},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3394":71628,"_29710":71405,"_20617":122738,"_5":14139,"_27008":122196,"_2880":122739},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3394":71629,"_29710":71405,"_20617":122741,"_5":14139,"_27008":122196,"_2880":122742},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3394":71630,"_29710":71405,"_20617":122744,"_5":14139,"_27008":122196,"_2880":122745},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3394":71631,"_29710":71405,"_20617":122747,"_5":14139,"_27008":122196,"_2880":122748},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3394":71632,"_29710":71405,"_20617":122750,"_5":14139,"_27008":122196,"_2880":122751},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3394":71633,"_29710":71405,"_20617":122753,"_5":14139,"_27008":122196,"_2880":122754},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3394":71634,"_29710":71405,"_20617":122756,"_5":14139,"_27008":122196,"_2880":122757},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3394":71635,"_29710":71405,"_20617":122759,"_5":14139,"_27008":122200,"_2880":122760},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3394":71636,"_29710":71405,"_20617":122762,"_5":14139,"_27008":122200,"_2880":122763},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3394":71637,"_29710":71405,"_20617":122765,"_5":14139,"_27008":122204,"_2880":122766},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3394":71638,"_29710":71405,"_20617":122768,"_5":14139,"_27008":122204,"_2880":122769},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3394":71639,"_29710":71405,"_20617":122771,"_5":14139,"_27008":122204,"_2880":122772},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3394":71640,"_29710":71405,"_20617":122774,"_5":14139,"_27008":122204,"_2880":122775},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3394":71641,"_29710":71405,"_20617":122777,"_5":14139,"_27008":122204,"_2880":122778},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3394":71642,"_29710":71405,"_20617":122780,"_5":14139,"_27008":122204,"_2880":122781},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3394":71643,"_29710":71405,"_20617":122783,"_5":14139,"_27008":122204,"_2880":122784},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3394":71644,"_29710":71405,"_20617":122786,"_5":14139,"_27008":122204,"_2880":122787},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3394":71645,"_29710":71405,"_20617":122789,"_5":14139,"_27008":122208,"_2880":122790},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3394":71646,"_29710":71405,"_20617":122792,"_5":14139,"_27008":122208,"_2880":122793},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3394":71647,"_29710":71405,"_20617":122795,"_5":14139,"_27008":122208,"_2880":122796},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3394":71648,"_29710":71405,"_20617":122798,"_5":14139,"_27008":122208,"_2880":122799},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3394":71649,"_29710":71405,"_20617":122801,"_5":14139,"_27008":122208,"_2880":122802},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3394":71650,"_29710":71405,"_20617":122804,"_5":14139,"_27008":122208,"_2880":122805},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3394":71651,"_29710":71405,"_20617":122807,"_5":14139,"_27008":122208,"_2880":122808},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3394":71652,"_29710":71405,"_20617":122810,"_5":14139,"_27008":122208,"_2880":122811},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3394":71653,"_29710":71405,"_20617":122813,"_5":14139,"_27008":122208,"_2880":122814},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3394":71654,"_29710":71405,"_20617":122816,"_5":14139,"_27008":122208,"_2880":122817},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** Ningún certificado de CA coincide con el SKI guardado del firmante, y la búsqueda alternativa encontró cero o varios certificados. Revisa el SKI y los candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3394":71655,"_29710":71405,"_20617":122819,"_5":14139,"_27008":122208,"_2880":122820},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3394":71656,"_29710":71405,"_20617":122822,"_5":14139,"_27008":122211,"_2880":122823},[],"Tras la actualización, comprueba en este orden:",{"_3394":71657,"_29710":71405,"_20617":122825,"_5":14139,"_27008":122211,"_2880":122826},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3394":71658,"_29710":71405,"_20617":122828,"_5":14139,"_27008":122211,"_2880":122829},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3394":71659,"_29710":71405,"_20617":122831,"_5":14139,"_27008":122211,"_2880":122832},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3394":71660,"_29710":71405,"_20617":122834,"_5":14139,"_27008":122211,"_2880":122835},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3394":71661,"_29710":71405,"_20617":122837,"_5":14139,"_27008":122211,"_2880":122838},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que puedes usar para confirmar el registro.",{"_3394":71662,"_29710":71405,"_20617":122840,"_5":14139,"_27008":122211,"_2880":122841},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3394":71663,"_29710":71405,"_20617":122843,"_5":14139,"_27008":122211,"_2880":122844},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3394":71664,"_29710":71405,"_20617":122846,"_5":14139,"_27008":122211,"_2880":122847},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3394":71665,"_29710":71405,"_20617":122849,"_5":14139,"_27008":122211,"_2880":122850},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3394":71666,"_29710":71405,"_20617":122852,"_5":14139,"_27008":122211,"_2880":122853},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3394":71667,"_29710":71405,"_20617":122855,"_5":14139,"_27008":122211,"_2880":122856},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3394":71668,"_29710":71405,"_20617":122858,"_5":14139,"_27008":122211,"_2880":122859},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3394":71669,"_29710":71405,"_20617":122861,"_5":14139,"_27008":122211,"_2880":122862},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3394":71670,"_29710":71405,"_20617":122864,"_5":14139,"_27008":122211,"_2880":122865},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3394":71671,"_29710":71405,"_20617":122867,"_5":14139,"_27008":122215,"_2880":122868},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3394":71672,"_29710":71405,"_20617":122870,"_5":14139,"_27008":122215,"_2880":122871},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3394":71673,"_29710":71405,"_20617":122873,"_5":14139,"_27008":122215,"_2880":122874},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3394":71674,"_29710":71405,"_20617":122876,"_5":14139,"_27008":122215,"_2880":122877},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3394":71675,"_29710":71405,"_20617":122879,"_5":14139,"_27008":122215,"_2880":122880},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_57344":122882,"_57346":122883,"_57348":122884,"_57350":122885,"_17857":2915,"_68809":2915},"spanish",[2880,29710,5,27008],{"_2880":24618,"_29710":24618,"_5":24618,"_27008":24618},{"_2880":122886,"_29710":125749,"_5":128612,"_27008":131475},{"_4562":122887,"_57354":122888,"_5":24618},{"_14215":3738,"_14596":6454,"_14615":4807,"_28713":12604,"_14602":4116,"_19571":3162,"_14236":3657,"_14243":16742,"_28655":16139,"_29064":4654,"_29085":3095,"_28689":5424,"_34029":10138,"_28792":20029,"_29129":9699,"_34036":5836,"_34039":3340,"_34042":5478,"_34045":5019,"_29536":3268,"_34050":4370,"_34052":3181,"_29566":19817,"_14611":22036,"_34056":7376,"_34059":7445,"_34061":8010,"_29113":6866,"_29531":4866,"_29579":9945,"_34066":6883,"_34068":6641,"_34070":14212,"_28809":10855,"_34073":22431,"_34075":3920,"_34077":3241,"_34079":6208,"_34081":3264,"_28726":3052,"_34084":10571,"_34086":14012,"_28720":6188,"_29150":6117,"_34090":19845,"_34092":12682,"_34095":10157,"_28766":6835,"_34099":3743,"_28646":5880,"_34102":5977,"_28694":12142,"_34105":14707,"_34107":7169,"_34110":6472,"_14605":14675,"_34113":3691,"_34115":19371,"_29769":10007,"_34119":25701,"_34121":8566,"_34123":4548,"_34125":7540,"_19574":3258,"_34128":15525,"_34130":6809,"_28667":4301,"_29107":5058,"_34134":5043,"_34136":4858,"_34138":8130,"_29596":1081