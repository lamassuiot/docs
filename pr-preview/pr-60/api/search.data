12,"_39960":124215,"_39962":124218,"_39964":124221,"_39966":124224,"_39968":124227,"_39970":124230,"_39972":124233,"_39974":124236,"_39977":124239,"_39979":124242,"_39981":124245,"_39983":124247,"_39985":124249,"_39987":124252,"_39989":124254,"_39991":124257,"_39993":124259,"_39995":124262,"_39997":124265,"_39999":124268,"_40001":124271,"_40003":124274,"_40005":124277,"_40007":124280,"_40009":124283,"_40011":124286,"_40013":124289,"_40015":124292,"_40017":124295,"_40019":124298,"_40022":124301,"_40024":124304,"_40026":124307,"_40028":124310,"_40030":124313,"_40032":124316,"_40034":124319,"_40036":124322,"_40038":124325,"_40040":124328,"_40042":124331,"_40044":124334,"_40046":124337,"_40048":124340,"_40050":124343,"_40052":124346,"_40054":124349,"_40056":124352,"_40058":124355,"_40060":124358,"_40062":124361,"_40064":124364,"_40066":124367,"_40068":124370,"_40070":124373,"_40072":124376,"_40074":124379,"_40077":124382,"_40079":124385,"_40081":124388,"_40084":124391,"_40086":124394,"_40088":124397,"_40090":124400,"_40092":124403,"_40094":124406,"_40096":124409,"_40098":124412,"_40100":124415,"_40102":124418,"_40104":124421,"_40106":124424,"_40108":124427,"_40110":124430,"_40112":124433,"_40114":124436,"_40116":124439,"_40118":124442,"_40120":124445,"_40123":124448,"_40125":124451,"_40127":124454,"_40129":124457,"_40131":124460,"_40133":124463,"_40135":124466,"_40137":124469,"_40139":124472,"_40141":124475,"_40143":124478,"_40145":124481,"_40147":124484,"_40149":124487,"_40151":124490,"_40153":124493,"_40155":124496,"_40157":124499,"_40159":124502,"_40161":124505,"_40163":124508,"_40165":124511,"_40167":124514,"_40169":124517,"_40171":124520,"_40173":124523,"_40176":124526,"_40178":124529,"_40180":124532},{"_3450":69815,"_30020":69815,"_5":14686,"_2936":115638,"_30373":115639,"_20858":115642,"_27317":69815},"Despliega desde AWS Marketplace",[49010,115640,115641],"Despliegue","Otros modelos",[],{"_3450":69816,"_30020":69815,"_20858":115644,"_5":14334,"_27317":69815,"_2936":115645},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3450":69817,"_30020":69815,"_5":30370,"_20858":115647,"_27317":115648,"_2936":115649},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3450":69818,"_30020":69815,"_5":30370,"_20858":115651,"_27317":115652,"_2936":115653},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3450":69819,"_30020":69815,"_5":30370,"_20858":115655,"_27317":115656,"_2936":115657},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3450":69820,"_30020":69815,"_5":30370,"_20858":115659,"_27317":115660,"_2936":115661},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3450":69821,"_30020":69815,"_5":30370,"_20858":115663,"_27317":115664,"_2936":115665},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3450":69822,"_30020":69815,"_5":30370,"_20858":115667,"_27317":115668,"_2936":115669},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3450":69823,"_30020":69815,"_5":30370,"_20858":115671,"_27317":115672,"_2936":115673},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3450":69824,"_30020":69815,"_20858":115675,"_5":14334,"_27317":69815,"_2936":115676},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3450":69825,"_30020":69815,"_20858":115678,"_5":14334,"_27317":115648,"_2936":115679},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3450":69826,"_30020":69815,"_20858":115681,"_5":14334,"_27317":115648,"_2936":115682},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3450":69827,"_30020":69815,"_20858":115684,"_5":14334,"_27317":115648,"_2936":115685},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3450":69828,"_30020":69815,"_20858":115687,"_5":14334,"_27317":115652,"_2936":115688},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3450":69829,"_30020":69815,"_20858":115690,"_5":14334,"_27317":115652,"_2936":115691},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3450":69830,"_30020":69815,"_20858":115693,"_5":14334,"_27317":115652,"_2936":115694},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3450":69831,"_30020":69815,"_20858":115696,"_5":14334,"_27317":115656,"_2936":115697},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3450":69832,"_30020":69815,"_20858":115699,"_5":14334,"_27317":115660,"_2936":115700},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3450":69833,"_30020":69815,"_20858":115702,"_5":14334,"_27317":115664,"_2936":115703},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3450":69834,"_30020":69815,"_20858":115705,"_5":14334,"_27317":115668,"_2936":115706},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3450":69835,"_30020":69815,"_20858":115708,"_5":14334,"_27317":115672,"_2936":115709},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3450":69836,"_30020":69836,"_5":14686,"_2936":115711,"_30373":115712,"_20858":115713,"_27317":69836},"Despliega Lamassu",[49010,115640],[],{"_3450":69837,"_30020":69836,"_20858":115715,"_5":14334,"_27317":69836,"_2936":115716},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3450":69838,"_30020":69836,"_5":30370,"_20858":115718,"_27317":115719,"_2936":115720},[],"/docs/pr-preview/pr-60/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3450":69839,"_30020":69836,"_5":30370,"_20858":115722,"_27317":115723,"_2936":115724},[],"/docs/pr-preview/pr-60/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3450":69840,"_30020":69836,"_5":30370,"_20858":115726,"_27317":115727,"_2936":115728},[],"/docs/pr-preview/pr-60/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3450":69841,"_30020":69836,"_20858":115730,"_5":14334,"_27317":69836,"_2936":115731},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3450":69842,"_30020":69836,"_20858":115733,"_5":14334,"_27317":115719,"_2936":115734},[],"Modelo",{"_3450":69843,"_30020":69836,"_20858":115736,"_5":14334,"_27317":115719,"_2936":115737},[],"Recomendado para",{"_3450":69844,"_30020":69836,"_20858":115739,"_5":14334,"_27317":115719,"_2936":115740},[],"Quién opera la infraestructura",{"_3450":69845,"_30020":69836,"_20858":115742,"_5":14334,"_27317":115719,"_2936":115743},[],"Punto de partida",{"_3450":69846,"_30020":69836,"_20858":115745,"_5":14334,"_27317":115719,"_2936":49117},[],{"_3450":69847,"_30020":69836,"_20858":115747,"_5":14334,"_27317":115719,"_2936":115748},[],"Producción, entornos regulados y despliegues personalizados",{"_3450":69848,"_30020":69836,"_20858":115750,"_5":14334,"_27317":115719,"_2936":115751},[],"Tu equipo",{"_3450":69849,"_30020":69836,"_20858":115753,"_5":14334,"_27317":115719,"_2936":115754},[],"Helm o Fastlane",{"_3450":69850,"_30020":69836,"_20858":115756,"_5":14334,"_27317":115719,"_2936":49129},[],{"_3450":69851,"_30020":69836,"_20858":115758,"_5":14334,"_27317":115719,"_2936":115759},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3450":69852,"_30020":69836,"_20858":115761,"_5":14334,"_27317":115719,"_2936":115751},[],{"_3450":69853,"_30020":69836,"_20858":115763,"_5":14334,"_27317":115719,"_2936":115764},[],"Imagen preconfigurada en EC2",{"_3450":69854,"_30020":69836,"_20858":115766,"_5":14334,"_27317":115719,"_2936":49140},[],{"_3450":69855,"_30020":69836,"_20858":115768,"_5":14334,"_27317":115719,"_2936":115769},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3450":69856,"_30020":69836,"_20858":115771,"_5":14334,"_27317":115719,"_2936":49146},[],{"_3450":69857,"_30020":69836,"_20858":115773,"_5":14334,"_27317":115719,"_2936":115774},[],"Suscripción gestionada",{"_3450":69858,"_30020":69836,"_20858":115776,"_5":14334,"_27317":115719,"_2936":115777},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3450":69859,"_30020":69836,"_20858":115779,"_5":14334,"_27317":115719,"_2936":115780},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3450":69860,"_30020":69836,"_20858":115782,"_5":14334,"_27317":115719,"_2936":115783},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3450":69861,"_30020":69836,"_20858":115785,"_5":14334,"_27317":115723,"_2936":115786},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3450":69862,"_30020":69836,"_20858":115788,"_5":14334,"_27317":115727,"_2936":115789},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3450":69863,"_30020":69863,"_5":14686,"_2936":115791,"_30373":115792,"_20858":115793,"_27317":69863},"Utiliza Lamassu como SaaS",[49010,115640,115641],[],{"_3450":69864,"_30020":69863,"_20858":115795,"_5":14334,"_27317":69863,"_2936":115796},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3450":69865,"_30020":69863,"_5":30370,"_20858":115798,"_27317":115799,"_2936":115800},[],"/docs/pr-preview/pr-60/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3450":69866,"_30020":69863,"_5":30370,"_20858":115802,"_27317":115803,"_2936":115804},[],"/docs/pr-preview/pr-60/es/deployment/saas#planes","Planes",{"_3450":69867,"_30020":69863,"_5":30370,"_20858":115806,"_27317":115807,"_2936":115808},[],"/docs/pr-preview/pr-60/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3450":69868,"_30020":69863,"_20858":115810,"_5":14334,"_27317":69863,"_2936":115811},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3450":69869,"_30020":69863,"_20858":115813,"_5":14334,"_27317":115799,"_2936":115814},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3450":69870,"_30020":69863,"_20858":115816,"_5":14334,"_27317":115799,"_2936":115817},[],"Copias de seguridad automáticas.",{"_3450":69871,"_30020":69863,"_20858":115819,"_5":14334,"_27317":115799,"_2936":115820},[],"Actualizaciones de versión.",{"_3450":69872,"_30020":69863,"_20858":115822,"_5":14334,"_27317":115799,"_2936":115823},[],"Soporte técnico y SLA según el plan contratado.",{"_3450":69873,"_30020":69863,"_20858":115825,"_5":14334,"_27317":115803,"_2936":49201},[],{"_3450":69874,"_30020":69863,"_20858":115827,"_5":14334,"_27317":115803,"_2936":115828},[],"Dispositivos",{"_3450":69875,"_30020":69863,"_20858":115830,"_5":14334,"_27317":115803,"_2936":115831},[],"Soporte",{"_3450":69876,"_30020":69863,"_20858":115833,"_5":14334,"_27317":115803,"_2936":49210},[],{"_3450":69877,"_30020":69863,"_20858":115835,"_5":14334,"_27317":115803,"_2936":49213},[],{"_3450":69878,"_30020":69863,"_20858":115837,"_5":14334,"_27317":115803,"_2936":115838},[],"Hasta 1.000",{"_3450":69879,"_30020":69863,"_20858":115840,"_5":14334,"_27317":115803,"_2936":49219},[],{"_3450":69880,"_30020":69863,"_20858":115842,"_5":14334,"_27317":115803,"_2936":115843},[],"99,5 %",{"_3450":69881,"_30020":69863,"_20858":115845,"_5":14334,"_27317":115803,"_2936":49225},[],{"_3450":69882,"_30020":69863,"_20858":115847,"_5":14334,"_27317":115803,"_2936":115848},[],"Hasta 10.000",{"_3450":69883,"_30020":69863,"_20858":115850,"_5":14334,"_27317":115803,"_2936":115851},[],"Email y chat",{"_3450":69884,"_30020":69863,"_20858":115853,"_5":14334,"_27317":115803,"_2936":115854},[],"99,9 %",{"_3450":69885,"_30020":69863,"_20858":115856,"_5":14334,"_27317":115803,"_2936":49237},[],{"_3450":69886,"_30020":69863,"_20858":115858,"_5":14334,"_27317":115803,"_2936":115859},[],"Ilimitados",{"_3450":69887,"_30020":69863,"_20858":115861,"_5":14334,"_27317":115803,"_2936":115862},[],"Dedicado",{"_3450":69888,"_30020":69863,"_20858":115864,"_5":14334,"_27317":115803,"_2936":115865},[],"99,99 %",{"_3450":69889,"_30020":69863,"_20858":115867,"_5":14334,"_27317":115807,"_2936":115868},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3450":69890,"_30020":69863,"_20858":115870,"_5":14334,"_27317":115807,"_2936":115871},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3450":69891,"_30020":69891,"_5":14686,"_2936":49254,"_30373":115873,"_20858":115875,"_27317":69891},[49010,115640,115874],"Kubernetes autogestionado",[],{"_3450":69892,"_30020":69891,"_20858":115877,"_5":14334,"_27317":69891,"_2936":115878},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3450":69893,"_30020":69891,"_5":30370,"_20858":115880,"_27317":115881,"_2936":115882},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3450":69894,"_30020":69891,"_5":30370,"_20858":115884,"_27317":115885,"_2936":115886},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3450":69895,"_30020":69891,"_5":30370,"_20858":115888,"_27317":115889,"_2936":115890},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3450":69896,"_30020":69891,"_5":30370,"_20858":115892,"_27317":115893,"_2936":115894},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3450":69897,"_30020":69891,"_5":30370,"_20858":115896,"_27317":115897,"_2936":115898},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3450":69898,"_30020":69891,"_5":30370,"_20858":115900,"_27317":115901,"_2936":115902},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3450":69899,"_30020":69891,"_5":30370,"_20858":115904,"_27317":115905,"_2936":115906},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3450":69900,"_30020":69891,"_5":30370,"_20858":115908,"_27317":115909,"_2936":115910},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3450":69901,"_30020":69891,"_5":30370,"_20858":115912,"_27317":115913,"_2936":115914},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3450":69902,"_30020":69891,"_5":30370,"_20858":115916,"_27317":115917,"_2936":115918},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3450":69903,"_30020":69891,"_5":30370,"_20858":115920,"_27317":115921,"_2936":115922},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3450":69904,"_30020":69891,"_20858":115924,"_5":14334,"_27317":115881,"_2936":115925},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3450":69905,"_30020":69891,"_20858":115927,"_5":14334,"_27317":115881,"_2936":115928},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3450":69906,"_30020":69891,"_20858":115930,"_5":14334,"_27317":115885,"_2936":115931},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3450":69907,"_30020":69891,"_20858":115933,"_5":14334,"_27317":115885,"_2936":115934},[],"Fastlane instala o configura",{"_3450":69908,"_30020":69891,"_20858":115936,"_5":14334,"_27317":115885,"_2936":115937},[],"Tú sigues proporcionando",{"_3450":69909,"_30020":69891,"_20858":115939,"_5":14334,"_27317":115885,"_2936":115940},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3450":69910,"_30020":69891,"_20858":115942,"_5":14334,"_27317":115885,"_2936":115943},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3450":69911,"_30020":69891,"_20858":115945,"_5":14334,"_27317":115885,"_2936":115946},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3450":69912,"_30020":69891,"_20858":115948,"_5":14334,"_27317":115885,"_2936":115949},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3450":69913,"_30020":69891,"_20858":115951,"_5":14334,"_27317":115885,"_2936":115952},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3450":69914,"_30020":69891,"_20858":115954,"_5":14334,"_27317":115885,"_2936":115955},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3450":69915,"_30020":69891,"_20858":115957,"_5":14334,"_27317":115885,"_2936":115958},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3450":69916,"_30020":69891,"_20858":115960,"_5":14334,"_27317":115885,"_2936":115961},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3450":69917,"_30020":69891,"_20858":115963,"_5":14334,"_27317":115885,"_2936":115964},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3450":69918,"_30020":69891,"_20858":115966,"_5":14334,"_27317":115889,"_2936":115967},[],"Necesitas:",{"_3450":69919,"_30020":69891,"_20858":115969,"_5":14334,"_27317":115889,"_2936":115970},[],"un clúster Kubernetes existente",{"_3450":69920,"_30020":69891,"_20858":115972,"_5":14334,"_27317":115889,"_2936":115973},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3450":69921,"_30020":69891,"_20858":115975,"_5":14334,"_27317":115889,"_2936":49356},[],{"_3450":69922,"_30020":69891,"_20858":115977,"_5":14334,"_27317":115889,"_2936":23570},[],{"_3450":69923,"_30020":69891,"_20858":115979,"_5":14334,"_27317":115889,"_2936":115980},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3450":69924,"_30020":69891,"_20858":115982,"_5":14334,"_27317":115889,"_2936":115983},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3450":69925,"_30020":69891,"_20858":115985,"_5":14334,"_27317":115889,"_2936":115986},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3450":69926,"_30020":69891,"_20858":115988,"_5":14334,"_27317":115889,"_2936":115989},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3450":69927,"_30020":69891,"_20858":115991,"_5":14334,"_27317":115889,"_2936":115992},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3450":69928,"_30020":69891,"_20858":115994,"_5":14334,"_27317":115893,"_2936":115995},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3450":69929,"_30020":69891,"_20858":115997,"_5":14334,"_27317":115893,"_2936":115998},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3450":69930,"_30020":69891,"_20858":116000,"_5":14334,"_27317":115897,"_2936":116001},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3450":69931,"_30020":69891,"_20858":116003,"_5":14334,"_27317":115897,"_2936":116004},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3450":69932,"_30020":69891,"_20858":116006,"_5":14334,"_27317":115897,"_2936":116007},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3450":69933,"_30020":69891,"_20858":116009,"_5":14334,"_27317":115897,"_2936":116010},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3450":69934,"_30020":69891,"_20858":116012,"_5":14334,"_27317":115901,"_2936":116013},[],"Opción",{"_3450":69935,"_30020":69891,"_20858":116015,"_5":14334,"_27317":115901,"_2936":116016},[],"Valor predeterminado",{"_3450":69936,"_30020":69891,"_20858":116018,"_5":14334,"_27317":115901,"_2936":116019},[],"Propósito",{"_3450":69937,"_30020":69891,"_20858":116021,"_5":14334,"_27317":115901,"_2936":49403},[],{"_3450":69938,"_30020":69891,"_20858":116023,"_5":14334,"_27317":115901,"_2936":49406},[],{"_3450":69939,"_30020":69891,"_20858":116025,"_5":14334,"_27317":115901,"_2936":116026},[],"Muestra la ayuda",{"_3450":69940,"_30020":69891,"_20858":116028,"_5":14334,"_27317":115901,"_2936":49412},[],{"_3450":69941,"_30020":69891,"_20858":116030,"_5":14334,"_27317":115901,"_2936":116031},[],"contexto actual",{"_3450":69942,"_30020":69891,"_20858":116033,"_5":14334,"_27317":115901,"_2936":116034},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3450":69943,"_30020":69891,"_20858":116036,"_5":14334,"_27317":115901,"_2936":49421},[],{"_3450":69944,"_30020":69891,"_20858":116038,"_5":14334,"_27317":115901,"_2936":6502},[],{"_3450":69945,"_30020":69891,"_20858":116040,"_5":14334,"_27317":115901,"_2936":116041},[],"Omite prompts y genera credenciales para las dependencias",{"_3450":69946,"_30020":69891,"_20858":116043,"_5":14334,"_27317":115901,"_2936":49429},[],{"_3450":69947,"_30020":69891,"_20858":116045,"_5":14334,"_27317":115901,"_2936":49432},[],{"_3450":69948,"_30020":69891,"_20858":116047,"_5":14334,"_27317":115901,"_2936":116048},[],"Namespace de la instalación",{"_3450":69949,"_30020":69891,"_20858":116050,"_5":14334,"_27317":115901,"_2936":49438},[],{"_3450":69950,"_30020":69891,"_20858":116052,"_5":14334,"_27317":115901,"_2936":49441},[],{"_3450":69951,"_30020":69891,"_20858":116054,"_5":14334,"_27317":115901,"_2936":116055},[],"Dominio usado por la UI, OIDC y el certificado",{"_3450":69952,"_30020":69891,"_20858":116057,"_5":14334,"_27317":115901,"_2936":49447},[],{"_3450":69953,"_30020":69891,"_20858":116059,"_5":14334,"_27317":115901,"_2936":15032},[],{"_3450":69954,"_30020":69891,"_20858":116061,"_5":14334,"_27317":115901,"_2936":116062},[],"Versión del chart de Lamassu",{"_3450":69955,"_30020":69891,"_20858":116064,"_5":14334,"_27317":115901,"_2936":49455},[],{"_3450":69956,"_30020":69891,"_20858":116066,"_5":14334,"_27317":115901,"_2936":49458},[],{"_3450":69957,"_30020":69891,"_20858":116068,"_5":14334,"_27317":115901,"_2936":116069},[],"Puerto del listener HTTPS",{"_3450":69958,"_30020":69891,"_20858":116071,"_5":14334,"_27317":115901,"_2936":49464},[],{"_3450":69959,"_30020":69891,"_20858":116073,"_5":14334,"_27317":115901,"_2936":49467},[],{"_3450":69960,"_30020":69891,"_20858":116075,"_5":14334,"_27317":115901,"_2936":116076},[],"Puerto del listener HTTP",{"_3450":69961,"_30020":69891,"_20858":116078,"_5":14334,"_27317":115901,"_2936":49473},[],{"_3450":69962,"_30020":69891,"_20858":116080,"_5":14334,"_27317":115901,"_2936":49406},[],{"_3450":69963,"_30020":69891,"_20858":116082,"_5":14334,"_27317":115901,"_2936":116083},[],"Certificado PEM para TLS downstream",{"_3450":69964,"_30020":69891,"_20858":116085,"_5":14334,"_27317":115901,"_2936":49481},[],{"_3450":69965,"_30020":69891,"_20858":116087,"_5":14334,"_27317":115901,"_2936":49406},[],{"_3450":69966,"_30020":69891,"_20858":116089,"_5":14334,"_27317":115901,"_2936":116090},[],"Clave privada PEM para TLS downstream",{"_3450":69967,"_30020":69891,"_20858":116092,"_5":14334,"_27317":115901,"_2936":49489},[],{"_3450":69968,"_30020":69891,"_20858":116094,"_5":14334,"_27317":115901,"_2936":116095},[],"chart del repositorio",{"_3450":69969,"_30020":69891,"_20858":116097,"_5":14334,"_27317":115901,"_2936":116098},[],"Usa un chart local de Lamassu sin empaquetar",{"_3450":69970,"_30020":69891,"_20858":116100,"_5":14334,"_27317":115901,"_2936":49498},[],{"_3450":69971,"_30020":69891,"_20858":116102,"_5":14334,"_27317":115901,"_2936":116103},[],"detección automática",{"_3450":69972,"_30020":69891,"_20858":116105,"_5":14334,"_27317":115901,"_2936":116106},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3450":69973,"_30020":69891,"_20858":116108,"_5":14334,"_27317":115901,"_2936":49506},[],{"_3450":69974,"_30020":69891,"_20858":116110,"_5":14334,"_27317":115901,"_2936":6502},[],{"_3450":69975,"_30020":69891,"_20858":116112,"_5":14334,"_27317":115901,"_2936":116113},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3450":69976,"_30020":69891,"_20858":116115,"_5":14334,"_27317":115901,"_2936":49514},[],{"_3450":69977,"_30020":69891,"_20858":116117,"_5":14334,"_27317":115901,"_2936":6502},[],{"_3450":69978,"_30020":69891,"_20858":116119,"_5":14334,"_27317":115901,"_2936":116120},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3450":69979,"_30020":69891,"_20858":116122,"_5":14334,"_27317":115901,"_2936":49522},[],{"_3450":69980,"_30020":69891,"_20858":116124,"_5":14334,"_27317":115901,"_2936":6502},[],{"_3450":69981,"_30020":69891,"_20858":116126,"_5":14334,"_27317":115901,"_2936":116127},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3450":69982,"_30020":69891,"_20858":116129,"_5":14334,"_27317":115901,"_2936":49530},[],{"_3450":69983,"_30020":69891,"_20858":116131,"_5":14334,"_27317":115901,"_2936":6502},[],{"_3450":69984,"_30020":69891,"_20858":116133,"_5":14334,"_27317":115901,"_2936":116134},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3450":69985,"_30020":69891,"_20858":116136,"_5":14334,"_27317":115901,"_2936":49538},[],{"_3450":69986,"_30020":69891,"_20858":116138,"_5":14334,"_27317":115901,"_2936":49541},[],{"_3450":69987,"_30020":69891,"_20858":116140,"_5":14334,"_27317":115901,"_2936":116141},[],"Usa otro chart local de SoftHSM",{"_3450":69988,"_30020":69891,"_20858":116143,"_5":14334,"_27317":115901,"_2936":116144},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3450":69989,"_30020":69891,"_20858":116146,"_5":14334,"_27317":115905,"_2936":116147},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3450":69990,"_30020":69891,"_20858":116149,"_5":14334,"_27317":115905,"_2936":116150},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3450":69991,"_30020":69891,"_20858":116152,"_5":14334,"_27317":115905,"_2936":116153},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3450":69992,"_30020":69891,"_20858":116155,"_5":14334,"_27317":115905,"_2936":116156},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3450":69993,"_30020":69891,"_20858":116158,"_5":14334,"_27317":115905,"_2936":116159},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3450":69994,"_30020":69891,"_20858":116161,"_5":14334,"_27317":115905,"_2936":116162},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3450":69995,"_30020":69891,"_20858":116164,"_5":14334,"_27317":115909,"_2936":49568},[],{"_3450":69996,"_30020":69891,"_20858":116166,"_5":14334,"_27317":115909,"_2936":116167},[],"valida las herramientas locales y el clúster seleccionado",{"_3450":69997,"_30020":69891,"_20858":116169,"_5":14334,"_27317":115909,"_2936":116170},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3450":69998,"_30020":69891,"_20858":116172,"_5":14334,"_27317":115909,"_2936":116173},[],"crea el namespace",{"_3450":69999,"_30020":69891,"_20858":116175,"_5":14334,"_27317":115909,"_2936":116176},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3450":70000,"_30020":69891,"_20858":116178,"_5":14334,"_27317":115909,"_2936":116179},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3450":70001,"_30020":69891,"_20858":116181,"_5":14334,"_27317":115909,"_2936":116182},[],"instala RabbitMQ",{"_3450":70002,"_30020":69891,"_20858":116184,"_5":14334,"_27317":115909,"_2936":116185},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3450":70003,"_30020":69891,"_20858":116187,"_5":14334,"_27317":115909,"_2936":116188},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3450":70004,"_30020":69891,"_20858":116190,"_5":14334,"_27317":115909,"_2936":116191},[],"carga datos de ejemplo opcionalmente",{"_3450":70005,"_30020":69891,"_20858":116193,"_5":14334,"_27317":115909,"_2936":116194},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3450":70006,"_30020":69891,"_20858":116196,"_5":14334,"_27317":115913,"_2936":116197},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3450":70007,"_30020":69891,"_20858":116199,"_5":14334,"_27317":115913,"_2936":116200},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3450":70008,"_30020":69891,"_20858":116202,"_5":14334,"_27317":115917,"_2936":116203},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3450":70009,"_30020":69891,"_20858":116205,"_5":14334,"_27317":115917,"_2936":116206},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3450":70010,"_30020":69891,"_20858":116208,"_5":14334,"_27317":115917,"_2936":116209},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3450":70011,"_30020":69891,"_20858":116211,"_5":14334,"_27317":115921,"_2936":116212},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3450":70012,"_30020":70012,"_5":14686,"_2936":116214,"_30373":116215,"_20858":116216,"_27317":70012},"Instala con Helm",[49010,115640,115874],[],{"_3450":70013,"_30020":70012,"_20858":116218,"_5":14334,"_27317":70012,"_2936":116219},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3450":70014,"_30020":70012,"_5":30370,"_20858":116221,"_27317":116222,"_2936":116223},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3450":70015,"_30020":70012,"_5":30370,"_20858":116225,"_27317":116226,"_2936":115890},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3450":70016,"_30020":70012,"_5":30370,"_20858":116228,"_27317":116229,"_2936":116230},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3450":70017,"_30020":70012,"_5":30370,"_20858":116232,"_27317":116233,"_2936":116234},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3450":70018,"_30020":70012,"_5":30370,"_20858":116236,"_27317":116237,"_2936":116238},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3450":70019,"_30020":70012,"_5":30370,"_20858":116240,"_27317":116241,"_2936":116242},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3450":70020,"_30020":70012,"_5":30370,"_20858":116244,"_27317":116245,"_2936":116246},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3450":70021,"_30020":70012,"_5":30370,"_20858":116248,"_27317":116249,"_2936":116250},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3450":70022,"_30020":70012,"_5":30370,"_20858":116252,"_27317":116253,"_2936":116254},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3450":70023,"_30020":70012,"_5":30370,"_20858":116256,"_27317":116257,"_2936":116258},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3450":70024,"_30020":70012,"_5":30370,"_20858":116260,"_27317":116261,"_2936":116262},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3450":70025,"_30020":70012,"_20858":116264,"_5":14334,"_27317":116222,"_2936":116265},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3450":70026,"_30020":70012,"_20858":116267,"_5":14334,"_27317":116226,"_2936":116268},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3450":70027,"_30020":70012,"_20858":116270,"_5":14334,"_27317":116226,"_2936":116271},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3450":70028,"_30020":70012,"_20858":116273,"_5":14334,"_27317":116226,"_2936":116274},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3450":70029,"_30020":70012,"_20858":116276,"_5":14334,"_27317":116226,"_2936":116277},[],"un broker RabbitMQ accesible y sus credenciales",{"_3450":70030,"_30020":70012,"_20858":116279,"_5":14334,"_27317":116226,"_2936":116280},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3450":70031,"_30020":70012,"_20858":116282,"_5":14334,"_27317":116226,"_2936":116283},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3450":70032,"_30020":70012,"_20858":116285,"_5":14334,"_27317":116226,"_2936":116286},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3450":70033,"_30020":70012,"_20858":116288,"_5":14334,"_27317":116226,"_2936":116289},[],"una StorageClass y un diseño de tráfico externo",{"_3450":70034,"_30020":70012,"_20858":116291,"_5":14334,"_27317":116226,"_2936":116292},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3450":70035,"_30020":70012,"_20858":116294,"_5":14334,"_27317":116226,"_2936":116295},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3450":70036,"_30020":70012,"_20858":116297,"_5":14334,"_27317":116226,"_2936":116298},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3450":70037,"_30020":70012,"_20858":116300,"_5":14334,"_27317":116229,"_2936":116301},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3450":70038,"_30020":70012,"_20858":116303,"_5":14334,"_27317":116229,"_2936":116304},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3450":70039,"_30020":70012,"_20858":116306,"_5":14334,"_27317":116229,"_2936":116307},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3450":70040,"_30020":70012,"_20858":116309,"_5":14334,"_27317":116233,"_2936":116310},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3450":70041,"_30020":70012,"_20858":116312,"_5":14334,"_27317":116233,"_2936":116313},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3450":70042,"_30020":70012,"_20858":116315,"_5":14334,"_27317":116233,"_2936":116316},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3450":70043,"_30020":70012,"_20858":116318,"_5":14334,"_27317":116233,"_2936":116319},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3450":70044,"_30020":70012,"_20858":116321,"_5":14334,"_27317":116237,"_2936":116322},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3450":70045,"_30020":70012,"_20858":116324,"_5":14334,"_27317":116241,"_2936":116325},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3450":70046,"_30020":70012,"_20858":116327,"_5":14334,"_27317":116241,"_2936":116328},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3450":70047,"_30020":70012,"_20858":116330,"_5":14334,"_27317":116241,"_2936":116331},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3450":70048,"_30020":70012,"_20858":116333,"_5":14334,"_27317":116241,"_2936":116334},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3450":70049,"_30020":70012,"_20858":116336,"_5":14334,"_27317":116241,"_2936":116337},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3450":70050,"_30020":70012,"_20858":116339,"_5":14334,"_27317":116241,"_2936":116340},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3450":70051,"_30020":70012,"_20858":116342,"_5":14334,"_27317":116241,"_2936":116343},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3450":70052,"_30020":70012,"_20858":116345,"_5":14334,"_27317":116245,"_2936":116346},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3450":70053,"_30020":70012,"_20858":116348,"_5":14334,"_27317":116245,"_2936":116349},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3450":70054,"_30020":70012,"_20858":116351,"_5":14334,"_27317":116245,"_2936":116352},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3450":70055,"_30020":70012,"_20858":116354,"_5":14334,"_27317":116245,"_2936":116355},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3450":70056,"_30020":70012,"_20858":116357,"_5":14334,"_27317":116249,"_2936":116358},[],"Para instalar un checkout local:",{"_3450":70057,"_30020":70012,"_20858":116360,"_5":14334,"_27317":116253,"_2936":116361},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3450":70058,"_30020":70012,"_20858":116363,"_5":14334,"_27317":116253,"_2936":116364},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3450":70059,"_30020":70012,"_20858":116366,"_5":14334,"_27317":116257,"_2936":116367},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3450":70060,"_30020":70012,"_20858":116369,"_5":14334,"_27317":116257,"_2936":116370},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3450":70061,"_30020":70012,"_20858":116372,"_5":14334,"_27317":116257,"_2936":116373},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3450":70062,"_30020":70012,"_20858":116375,"_5":14334,"_27317":116257,"_2936":116376},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3450":70063,"_30020":70012,"_20858":116378,"_5":14334,"_27317":116257,"_2936":116379},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3450":70064,"_30020":70012,"_20858":116381,"_5":14334,"_27317":116261,"_2936":116382},[],"Antes de pasar a producción, revisa:",{"_3450":70065,"_30020":70012,"_20858":116384,"_5":14334,"_27317":116261,"_2936":116385},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3450":70066,"_30020":70012,"_20858":116387,"_5":14334,"_27317":116261,"_2936":116388},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3450":70067,"_30020":70012,"_20858":116390,"_5":14334,"_27317":116261,"_2936":116391},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3450":70068,"_30020":70012,"_20858":116393,"_5":14334,"_27317":116261,"_2936":116394},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3450":70069,"_30020":70012,"_20858":116396,"_5":14334,"_27317":116261,"_2936":116397},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3450":70070,"_30020":70012,"_20858":116399,"_5":14334,"_27317":116261,"_2936":116400},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3450":70071,"_30020":70012,"_20858":116402,"_5":14334,"_27317":116261,"_2936":116403},[],"SMTP, observabilidad y entrega de alertas",{"_3450":70072,"_30020":70012,"_20858":116405,"_5":14334,"_27317":116261,"_2936":116406},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3450":70073,"_30020":70012,"_20858":116408,"_5":14334,"_27317":116261,"_2936":116409},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3450":70074,"_30020":70074,"_5":14686,"_2936":116411,"_30373":116412,"_20858":116413,"_27317":70074},"Expón el Gateway",[49010,115640,115874],[],{"_3450":70075,"_30020":70074,"_20858":116415,"_5":14334,"_27317":70074,"_2936":116416},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3450":70076,"_30020":70074,"_5":30370,"_20858":116418,"_27317":116419,"_2936":116420},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3450":70077,"_30020":70074,"_5":30370,"_20858":116422,"_27317":116423,"_2936":116424},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3450":70078,"_30020":70074,"_5":30370,"_20858":116426,"_27317":116427,"_2936":116428},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3450":70079,"_30020":70074,"_5":30370,"_20858":116430,"_27317":116431,"_2936":49836},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#k3s",{"_3450":70080,"_30020":70074,"_5":30370,"_20858":116433,"_27317":116434,"_2936":116435},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3450":70081,"_30020":70074,"_5":30370,"_20858":116437,"_27317":116438,"_2936":116439},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3450":70082,"_30020":70074,"_5":30370,"_20858":116441,"_27317":116442,"_2936":116443},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3450":70083,"_30020":70074,"_5":30370,"_20858":116445,"_27317":116446,"_2936":116447},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3450":70084,"_30020":70074,"_5":30370,"_20858":116449,"_27317":116450,"_2936":116451},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3450":70085,"_30020":70074,"_5":30370,"_20858":116453,"_27317":116454,"_2936":116455},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3450":70086,"_30020":70074,"_20858":116457,"_5":14334,"_27317":116419,"_2936":116458},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3450":70087,"_30020":70074,"_20858":116460,"_5":14334,"_27317":116419,"_2936":116461},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3450":70088,"_30020":70074,"_20858":116463,"_5":14334,"_27317":116423,"_2936":116464},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3450":70089,"_30020":70074,"_20858":116466,"_5":14334,"_27317":116423,"_2936":116467},[],"Defínelo únicamente cuando:",{"_3450":70090,"_30020":70074,"_20858":116469,"_5":14334,"_27317":116423,"_2936":116470},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3450":70091,"_30020":70074,"_20858":116472,"_5":14334,"_27317":116423,"_2936":116473},[],"esa dirección está asignada a este Gateway",{"_3450":70092,"_30020":70074,"_20858":116475,"_5":14334,"_27317":116423,"_2936":116476},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3450":70093,"_30020":70074,"_20858":116478,"_5":14334,"_27317":116423,"_2936":116479},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3450":70094,"_30020":70074,"_20858":116481,"_5":14334,"_27317":116423,"_2936":116482},[],"No confundas estos valores:",{"_3450":70095,"_30020":70074,"_20858":116484,"_5":14334,"_27317":116423,"_2936":116485},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3450":70096,"_30020":70074,"_20858":116487,"_5":14334,"_27317":116423,"_2936":116488},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3450":70097,"_30020":70074,"_20858":116490,"_5":14334,"_27317":116423,"_2936":116491},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3450":70098,"_30020":70074,"_20858":116493,"_5":14334,"_27317":116427,"_2936":116494},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3450":70099,"_30020":70074,"_20858":116496,"_5":14334,"_27317":116427,"_2936":116497},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3450":70100,"_30020":70074,"_20858":116499,"_5":14334,"_27317":116431,"_2936":116500},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3450":70101,"_30020":70074,"_20858":116502,"_5":14334,"_27317":116431,"_2936":116503},[],"Para el diseño recomendado:",{"_3450":70102,"_30020":70074,"_20858":116505,"_5":14334,"_27317":116431,"_2936":116506},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3450":70103,"_30020":70074,"_20858":116508,"_5":14334,"_27317":116431,"_2936":116509},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3450":70104,"_30020":70074,"_20858":116511,"_5":14334,"_27317":116431,"_2936":116512},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3450":70105,"_30020":70074,"_20858":116514,"_5":14334,"_27317":116431,"_2936":116515},[],"Apunta DNS a la dirección accesible de la VM.",{"_3450":70106,"_30020":70074,"_20858":116517,"_5":14334,"_27317":116431,"_2936":116518},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3450":70107,"_30020":70074,"_20858":116520,"_5":14334,"_27317":116434,"_2936":116521},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3450":70108,"_30020":70074,"_20858":116523,"_5":14334,"_27317":116438,"_2936":116524},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3450":70109,"_30020":70074,"_20858":116526,"_5":14334,"_27317":116438,"_2936":116527},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3450":70110,"_30020":70074,"_20858":116529,"_5":14334,"_27317":116442,"_2936":116530},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3450":70111,"_30020":70074,"_20858":116532,"_5":14334,"_27317":116442,"_2936":116533},[],"Requisito",{"_3450":70112,"_30020":70074,"_20858":116535,"_5":14334,"_27317":116442,"_2936":116536},[],"Diseño recomendado",{"_3450":70113,"_30020":70074,"_20858":116538,"_5":14334,"_27317":116442,"_2936":116539},[],"Consecuencia",{"_3450":70114,"_30020":70074,"_20858":116541,"_5":14334,"_27317":116442,"_2936":116542},[],"Varias URL o servicios de Lamassu",{"_3450":70115,"_30020":70074,"_20858":116544,"_5":14334,"_27317":116442,"_2936":116545},[],"Un Gateway con varias rutas",{"_3450":70116,"_30020":70074,"_20858":116547,"_5":14334,"_27317":116442,"_2936":116548},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3450":70117,"_30020":70074,"_20858":116550,"_5":14334,"_27317":116442,"_2936":116551},[],"Gateways independientes e IP externas distintas",{"_3450":70118,"_30020":70074,"_20858":116553,"_5":14334,"_27317":116442,"_2936":116554},[],"Una VIP por Gateway",{"_3450":70119,"_30020":70074,"_20858":116556,"_5":14334,"_27317":116442,"_2936":116557},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3450":70120,"_30020":70074,"_20858":116559,"_5":14334,"_27317":116442,"_2936":116560},[],"Gateways independientes, un nodo y una IP",{"_3450":70121,"_30020":70074,"_20858":116562,"_5":14334,"_27317":116442,"_2936":116563},[],"Puertos externos diferentes",{"_3450":70122,"_30020":70074,"_20858":116565,"_5":14334,"_27317":116442,"_2936":116566},[],"Los clientes deben indicar puertos no estándar",{"_3450":70123,"_30020":70074,"_20858":116568,"_5":14334,"_27317":116442,"_2936":116569},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3450":70124,"_30020":70074,"_20858":116571,"_5":14334,"_27317":116442,"_2936":116572},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3450":70125,"_30020":70074,"_20858":116574,"_5":14334,"_27317":116442,"_2936":116575},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3450":70126,"_30020":70074,"_20858":116577,"_5":14334,"_27317":116442,"_2936":116578},[],"Recursos Gateway separados pero proxy compartido",{"_3450":70127,"_30020":70074,"_20858":116580,"_5":14334,"_27317":116442,"_2936":116581},[],"Modo merged Gateway de Envoy",{"_3450":70128,"_30020":70074,"_20858":116583,"_5":14334,"_27317":116442,"_2936":116584},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3450":70129,"_30020":70074,"_20858":116586,"_5":14334,"_27317":116442,"_2936":116587},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3450":70130,"_30020":70074,"_20858":116589,"_5":14334,"_27317":116442,"_2936":116590},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3450":70131,"_30020":70074,"_20858":116592,"_5":14334,"_27317":116442,"_2936":116593},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3450":70132,"_30020":70074,"_20858":116595,"_5":14334,"_27317":116442,"_2936":116596},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3450":70133,"_30020":70074,"_20858":116598,"_5":14334,"_27317":116446,"_2936":116599},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3450":70134,"_30020":70074,"_20858":116601,"_5":14334,"_27317":116446,"_2936":116602},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3450":70135,"_30020":70074,"_20858":116604,"_5":14334,"_27317":116446,"_2936":116605},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3450":70136,"_30020":70074,"_20858":116607,"_5":14334,"_27317":116446,"_2936":116608},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3450":70137,"_30020":70074,"_20858":116610,"_5":14334,"_27317":116446,"_2936":116611},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3450":70138,"_30020":70074,"_20858":116613,"_5":14334,"_27317":116450,"_2936":116614},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3450":70139,"_30020":70074,"_20858":116616,"_5":14334,"_27317":116450,"_2936":116617},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3450":70140,"_30020":70074,"_20858":116619,"_5":14334,"_27317":116454,"_2936":116620},[],"Comprueba, en orden:",{"_3450":70141,"_30020":70074,"_20858":116622,"_5":14334,"_27317":116454,"_2936":116623},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3450":70142,"_30020":70074,"_20858":116625,"_5":14334,"_27317":116454,"_2936":116626},[],"Su estado contiene la dirección esperada.",{"_3450":70143,"_30020":70074,"_20858":116628,"_5":14334,"_27317":116454,"_2936":116629},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3450":70144,"_30020":70074,"_20858":116631,"_5":14334,"_27317":116454,"_2936":116632},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3450":70145,"_30020":70074,"_20858":116634,"_5":14334,"_27317":116454,"_2936":116635},[],"DNS resuelve al endpoint accesible externamente.",{"_3450":70146,"_30020":70074,"_20858":116637,"_5":14334,"_27317":116454,"_2936":116638},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3450":70147,"_30020":70074,"_20858":116640,"_5":14334,"_27317":116454,"_2936":116641},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3450":70148,"_30020":70148,"_5":14686,"_2936":49117,"_30373":116643,"_20858":116644,"_27317":70148},[49010,115640,115874],[],{"_3450":70149,"_30020":70148,"_20858":116646,"_5":14334,"_27317":70148,"_2936":116647},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3450":70150,"_30020":70148,"_5":30370,"_20858":116649,"_27317":116650,"_2936":116651},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3450":70151,"_30020":70148,"_5":30370,"_20858":116653,"_27317":116654,"_2936":116655},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3450":70152,"_30020":70148,"_5":30370,"_20858":116657,"_27317":116658,"_2936":116659},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3450":70153,"_30020":70148,"_5":30370,"_20858":116661,"_27317":116662,"_2936":116663},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3450":70154,"_30020":70148,"_5":30370,"_20858":116665,"_27317":116666,"_2936":116667},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3450":70155,"_30020":70148,"_5":30370,"_20858":116669,"_27317":116670,"_2936":116671},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3450":70156,"_30020":70148,"_20858":116673,"_5":14334,"_27317":116650,"_2936":116674},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3450":70157,"_30020":70148,"_20858":116676,"_5":14334,"_27317":116654,"_2936":116677},[],"Flujo",{"_3450":70158,"_30020":70148,"_20858":116679,"_5":14334,"_27317":116654,"_2936":116680},[],"Úsalo para",{"_3450":70159,"_30020":70148,"_20858":116682,"_5":14334,"_27317":116654,"_2936":116683},[],"Qué instala",{"_3450":70160,"_30020":70148,"_20858":116685,"_5":14334,"_27317":116654,"_2936":50091},[],{"_3450":70161,"_30020":70148,"_20858":116687,"_5":14334,"_27317":116654,"_2936":116688},[],"Producción y entornos controlados",{"_3450":70162,"_30020":70148,"_20858":116690,"_5":14334,"_27317":116654,"_2936":116691},[],"Servicios de Lamassu y recursos de Gateway API",{"_3450":70163,"_30020":70148,"_20858":116693,"_5":14334,"_27317":116654,"_2936":49254},[],{"_3450":70164,"_30020":70148,"_20858":116695,"_5":14334,"_27317":116654,"_2936":116696},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3450":70165,"_30020":70148,"_20858":116698,"_5":14334,"_27317":116654,"_2936":116699},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3450":70166,"_30020":70148,"_20858":116701,"_5":14334,"_27317":116658,"_2936":116702},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3450":70167,"_30020":70148,"_20858":116704,"_5":14334,"_27317":116658,"_2936":116705},[],"Área",{"_3450":70168,"_30020":70148,"_20858":116707,"_5":14334,"_27317":116658,"_2936":116708},[],"El chart de Lamassu proporciona",{"_3450":70169,"_30020":70148,"_20858":116710,"_5":14334,"_27317":116658,"_2936":116711},[],"Tú proporcionas",{"_3450":70170,"_30020":70148,"_20858":116713,"_5":14334,"_27317":116658,"_2936":116714},[],"Aplicaciones Lamassu",{"_3450":70171,"_30020":70148,"_20858":116716,"_5":14334,"_27317":116658,"_2936":116717},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3450":70172,"_30020":70148,"_20858":116719,"_5":14334,"_27317":116658,"_2936":116720},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3450":70173,"_30020":70148,"_20858":116722,"_5":14334,"_27317":116658,"_2936":116723},[],"Datos PostgreSQL",{"_3450":70174,"_30020":70148,"_20858":116725,"_5":14334,"_27317":116658,"_2936":116726},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3450":70175,"_30020":70148,"_20858":116728,"_5":14334,"_27317":116658,"_2936":116729},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3450":70176,"_30020":70148,"_20858":116731,"_5":14334,"_27317":116658,"_2936":116732},[],"Mensajería",{"_3450":70177,"_30020":70148,"_20858":116734,"_5":14334,"_27317":116658,"_2936":116735},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3450":70178,"_30020":70148,"_20858":116737,"_5":14334,"_27317":116658,"_2936":116738},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3450":70179,"_30020":70148,"_20858":116740,"_5":14334,"_27317":116658,"_2936":116741},[],"Identidad",{"_3450":70180,"_30020":70148,"_20858":116743,"_5":14334,"_27317":116658,"_2936":116744},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3450":70181,"_30020":70148,"_20858":116746,"_5":14334,"_27317":116658,"_2936":116747},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3450":70182,"_30020":70148,"_20858":116749,"_5":14334,"_27317":116658,"_2936":116750},[],"Enrutamiento externo",{"_3450":70183,"_30020":70148,"_20858":116752,"_5":14334,"_27317":116658,"_2936":116753},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3450":70184,"_30020":70148,"_20858":116755,"_5":14334,"_27317":116658,"_2936":116756},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3450":70185,"_30020":70148,"_20858":116758,"_5":14334,"_27317":116658,"_2936":50165},[],{"_3450":70186,"_30020":70148,"_20858":116760,"_5":14334,"_27317":116658,"_2936":116761},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3450":70187,"_30020":70148,"_20858":116763,"_5":14334,"_27317":116658,"_2936":116764},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3450":70188,"_30020":70148,"_20858":116766,"_5":14334,"_27317":116658,"_2936":116767},[],"Datos persistentes de la aplicación",{"_3450":70189,"_30020":70148,"_20858":116769,"_5":14334,"_27317":116658,"_2936":116770},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3450":70190,"_30020":70148,"_20858":116772,"_5":14334,"_27317":116658,"_2936":116773},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3450":70191,"_30020":70148,"_20858":116775,"_5":14334,"_27317":116658,"_2936":116776},[],"Integraciones opcionales",{"_3450":70192,"_30020":70148,"_20858":116778,"_5":14334,"_27317":116658,"_2936":116779},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3450":70193,"_30020":70148,"_20858":116781,"_5":14334,"_27317":116658,"_2936":116782},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3450":70194,"_30020":70148,"_20858":116784,"_5":14334,"_27317":116658,"_2936":116785},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3450":70195,"_30020":70148,"_20858":116787,"_5":14334,"_27317":116658,"_2936":116788},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3450":70196,"_30020":70148,"_20858":116790,"_5":14334,"_27317":116662,"_2936":116791},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3450":70197,"_30020":70148,"_20858":116793,"_5":14334,"_27317":116662,"_2936":116794},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3450":70198,"_30020":70148,"_20858":116796,"_5":14334,"_27317":116666,"_2936":116797},[],"Kubernetes 1.24 o posterior",{"_3450":70199,"_30020":70148,"_20858":116799,"_5":14334,"_27317":116666,"_2936":116800},[],"Helm 3.2 o posterior",{"_3450":70200,"_30020":70148,"_20858":116802,"_5":14334,"_27317":116666,"_2936":116803},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3450":70201,"_30020":70148,"_20858":116805,"_5":14334,"_27317":116666,"_2936":116806},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3450":70202,"_30020":70148,"_20858":116808,"_5":14334,"_27317":116666,"_2936":116809},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3450":70203,"_30020":70148,"_20858":116811,"_5":14334,"_27317":116666,"_2936":116812},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3450":70204,"_30020":70148,"_20858":116814,"_5":14334,"_27317":116666,"_2936":116815},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3450":70205,"_30020":70148,"_20858":116817,"_5":14334,"_27317":116670,"_2936":116818},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3450":70206,"_30020":70148,"_20858":116820,"_5":14334,"_27317":116670,"_2936":116821},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3450":70207,"_30020":70148,"_20858":116823,"_5":14334,"_27317":116670,"_2936":116824},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3450":70208,"_30020":70148,"_20858":116826,"_5":14334,"_27317":116670,"_2936":116827},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3450":70209,"_30020":70209,"_5":14686,"_2936":116829,"_30373":116830,"_20858":116832,"_27317":70209},"Resolución de problemas de despliegue",[49010,115640,116831],"Operación",[],{"_3450":70210,"_30020":70209,"_20858":116834,"_5":14334,"_27317":70209,"_2936":116835},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3450":70211,"_30020":70209,"_5":30370,"_20858":116837,"_27317":116838,"_2936":116839},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3450":70212,"_30020":70209,"_5":30370,"_20858":116841,"_27317":116842,"_2936":116843},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3450":70213,"_30020":70209,"_5":30370,"_20858":116845,"_27317":116846,"_2936":116847},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3450":70214,"_30020":70209,"_5":30370,"_20858":116849,"_27317":116850,"_2936":116851},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3450":70215,"_30020":70209,"_5":30370,"_20858":116853,"_27317":116854,"_2936":116855},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3450":70216,"_30020":70209,"_5":30370,"_20858":116857,"_27317":116858,"_2936":116859},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3450":70217,"_30020":70209,"_5":30370,"_20858":116861,"_27317":116862,"_2936":116863},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3450":70218,"_30020":70209,"_5":30370,"_20858":116865,"_27317":116866,"_2936":116867},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3450":70219,"_30020":70209,"_5":30370,"_20858":116869,"_27317":116870,"_2936":116871},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3450":70220,"_30020":70209,"_5":30370,"_20858":116873,"_27317":116874,"_2936":116875},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3450":70221,"_30020":70209,"_5":30370,"_20858":116877,"_27317":116878,"_2936":116879},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3450":70222,"_30020":70209,"_5":30370,"_20858":116881,"_27317":116882,"_2936":116883},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3450":70223,"_30020":70209,"_5":30370,"_20858":116885,"_27317":116886,"_2936":116887},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3450":70224,"_30020":70209,"_20858":116889,"_5":14334,"_27317":70209,"_2936":116890},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3450":70225,"_30020":70209,"_20858":116892,"_5":14334,"_27317":116842,"_2936":116893},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3450":70226,"_30020":70209,"_20858":116895,"_5":14334,"_27317":116846,"_2936":116896},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3450":70227,"_30020":70209,"_20858":116898,"_5":14334,"_27317":116850,"_2936":116899},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3450":70228,"_30020":70209,"_20858":116901,"_5":14334,"_27317":116854,"_2936":116902},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3450":70229,"_30020":70209,"_20858":116904,"_5":14334,"_27317":116858,"_2936":116905},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3450":70230,"_30020":70209,"_20858":116907,"_5":14334,"_27317":116862,"_2936":116908},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3450":70231,"_30020":70209,"_20858":116910,"_5":14334,"_27317":116862,"_2936":116911},[],"Ejecuta también la prueba de conectividad del chart:",{"_3450":70232,"_30020":70209,"_20858":116913,"_5":14334,"_27317":116862,"_2936":116914},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3450":70233,"_30020":70209,"_20858":116916,"_5":14334,"_27317":116862,"_2936":116917},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3450":70234,"_30020":70209,"_20858":116919,"_5":14334,"_27317":116866,"_2936":116920},[],"Si recibes un 401:",{"_3450":70235,"_30020":70209,"_20858":116922,"_5":14334,"_27317":116866,"_2936":116923},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3450":70236,"_30020":70209,"_20858":116925,"_5":14334,"_27317":116866,"_2936":116926},[],"verifica emisor, audiencia y expiración del token;",{"_3450":70237,"_30020":70209,"_20858":116928,"_5":14334,"_27317":116866,"_2936":116929},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3450":70238,"_30020":70209,"_20858":116931,"_5":14334,"_27317":116866,"_2936":116932},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3450":70239,"_30020":70209,"_20858":116934,"_5":14334,"_27317":116866,"_2936":116935},[],"Si el login termina pero las APIs devuelven 403:",{"_3450":70240,"_30020":70209,"_20858":116937,"_5":14334,"_27317":116866,"_2936":116938},[],"inspecciona los claims reales del token;",{"_3450":70241,"_30020":70209,"_20858":116940,"_5":14334,"_27317":116866,"_2936":116941},[],"confirma que coinciden con un principal activo;",{"_3450":70242,"_30020":70209,"_20858":116943,"_5":14334,"_27317":116866,"_2936":116944},[],"revisa las políticas concedidas al principal;",{"_3450":70243,"_30020":70209,"_20858":116946,"_5":14334,"_27317":116866,"_2936":116947},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3450":70244,"_30020":70209,"_20858":116949,"_5":14334,"_27317":116866,"_2936":116950},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3450":70245,"_30020":70209,"_20858":116952,"_5":14334,"_27317":116870,"_2936":116953},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3450":70246,"_30020":70209,"_20858":116955,"_5":14334,"_27317":116870,"_2936":116956},[],"Localiza el pod y Service de authz.",{"_3450":70247,"_30020":70209,"_20858":116958,"_5":14334,"_27317":116870,"_2936":116959},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3450":70248,"_30020":70209,"_20858":116961,"_5":14334,"_27317":116870,"_2936":116962},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3450":70249,"_30020":70209,"_20858":116964,"_5":14334,"_27317":116870,"_2936":116965},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3450":70250,"_30020":70209,"_20858":116967,"_5":14334,"_27317":116870,"_2936":116968},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3450":70251,"_30020":70209,"_20858":116970,"_5":14334,"_27317":116874,"_2936":116971},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3450":70252,"_30020":70209,"_20858":116973,"_5":14334,"_27317":116878,"_2936":116974},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3450":70253,"_30020":70209,"_20858":116976,"_5":14334,"_27317":116878,"_2936":116977},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3450":70254,"_30020":70209,"_20858":116979,"_5":14334,"_27317":116878,"_2936":116980},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3450":70255,"_30020":70209,"_20858":116982,"_5":14334,"_27317":116878,"_2936":116983},[],"volumen persistente sin enlazar;",{"_3450":70256,"_30020":70209,"_20858":116985,"_5":14334,"_27317":116878,"_2936":116986},[],"imagen inaccesible o política de pull incorrecta;",{"_3450":70257,"_30020":70209,"_20858":116988,"_5":14334,"_27317":116878,"_2936":116989},[],"configuración inválida del motor criptográfico;",{"_3450":70258,"_30020":70209,"_20858":116991,"_5":14334,"_27317":116878,"_2936":116992},[],"límites de CPU o memoria demasiado bajos;",{"_3450":70259,"_30020":70209,"_20858":116994,"_5":14334,"_27317":116878,"_2936":116995},[],"migración previa incompleta.",{"_3450":70260,"_30020":70209,"_20858":116997,"_5":14334,"_27317":116878,"_2936":116998},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3450":70261,"_30020":70209,"_20858":117000,"_5":14334,"_27317":116878,"_2936":117001},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3450":70262,"_30020":70209,"_20858":117003,"_5":14334,"_27317":116878,"_2936":117004},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3450":70263,"_30020":70209,"_20858":117006,"_5":14334,"_27317":116882,"_2936":117007},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3450":70264,"_30020":70209,"_20858":117009,"_5":14334,"_27317":116882,"_2936":117010},[],"verifica que esté habilitado en el servicio emisor;",{"_3450":70265,"_30020":70209,"_20858":117012,"_5":14334,"_27317":116882,"_2936":117013},[],"comprueba conectividad y credenciales AMQP;",{"_3450":70266,"_30020":70209,"_20858":117015,"_5":14334,"_27317":116882,"_2936":117016},[],"revisa exchange, routing key, colas y consumidores;",{"_3450":70267,"_30020":70209,"_20858":117018,"_5":14334,"_27317":116882,"_2936":117019},[],"inspecciona dead-letter queues;",{"_3450":70268,"_30020":70209,"_20858":117021,"_5":14334,"_27317":116882,"_2936":117022},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3450":70269,"_30020":70209,"_20858":117024,"_5":14334,"_27317":116882,"_2936":117025},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3450":70270,"_30020":70209,"_20858":117027,"_5":14334,"_27317":116882,"_2936":117028},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3450":70271,"_30020":70209,"_20858":117030,"_5":14334,"_27317":116882,"_2936":117031},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3450":70272,"_30020":70209,"_20858":117033,"_5":14334,"_27317":116882,"_2936":117034},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3450":70273,"_30020":70209,"_20858":117036,"_5":14334,"_27317":116882,"_2936":117037},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3450":70274,"_30020":70209,"_20858":117039,"_5":14334,"_27317":116882,"_2936":117040},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3450":70275,"_30020":70209,"_20858":117042,"_5":14334,"_27317":116882,"_2936":117043},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3450":70276,"_30020":70209,"_20858":117045,"_5":14334,"_27317":116886,"_2936":117046},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3450":70277,"_30020":70209,"_20858":117048,"_5":14334,"_27317":116886,"_2936":117049},[],"Antes de cerrar una incidencia, guarda:",{"_3450":70278,"_30020":70209,"_20858":117051,"_5":14334,"_27317":116886,"_2936":117052},[],"causa confirmada;",{"_3450":70279,"_30020":70209,"_20858":117054,"_5":14334,"_27317":116886,"_2936":117055},[],"alcance temporal y recursos afectados;",{"_3450":70280,"_30020":70209,"_20858":117057,"_5":14334,"_27317":116886,"_2936":117058},[],"comandos o consultas utilizados;",{"_3450":70281,"_30020":70209,"_20858":117060,"_5":14334,"_27317":116886,"_2936":117061},[],"cambio aplicado y forma de revertirlo;",{"_3450":70282,"_30020":70209,"_20858":117063,"_5":14334,"_27317":116886,"_2936":117064},[],"validación desde un consumidor;",{"_3450":70283,"_30020":70209,"_20858":117066,"_5":14334,"_27317":116886,"_2936":117067},[],"acción preventiva y propietario.",{"_3450":70284,"_30020":70284,"_5":14686,"_2936":117069,"_30373":117070,"_20858":117073,"_27317":70284},"Control de acceso",[49010,117071,117072],"Plataforma","Administración",[],{"_3450":70285,"_30020":70284,"_20858":117075,"_5":14334,"_27317":70284,"_2936":117076},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3450":70286,"_30020":70284,"_5":30370,"_20858":117078,"_27317":117079,"_2936":117080},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3450":70287,"_30020":70284,"_5":30370,"_20858":117082,"_27317":117083,"_2936":117084},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3450":70288,"_30020":70284,"_5":30370,"_20858":117086,"_27317":117087,"_2936":117088},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3450":70289,"_30020":70284,"_5":30370,"_20858":117090,"_27317":117091,"_2936":117092},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3450":70290,"_30020":70284,"_5":30370,"_20858":117094,"_27317":117095,"_2936":117096},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3450":70291,"_30020":70284,"_5":30370,"_20858":117098,"_27317":117099,"_2936":117100},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3450":70292,"_30020":70284,"_5":30370,"_20858":117102,"_27317":117103,"_2936":117104},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3450":70293,"_30020":70284,"_5":30370,"_20858":117106,"_27317":117107,"_2936":117108},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3450":70294,"_30020":70284,"_5":30370,"_20858":117110,"_27317":117111,"_2936":117112},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3450":70295,"_30020":70284,"_5":30370,"_20858":117114,"_27317":117115,"_2936":117116},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3450":70296,"_30020":70284,"_5":30370,"_20858":117118,"_27317":117119,"_2936":117120},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3450":70297,"_30020":70284,"_5":30370,"_20858":117122,"_27317":117123,"_2936":117124},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3450":70298,"_30020":70284,"_5":30370,"_20858":117126,"_27317":117127,"_2936":117128},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3450":70299,"_30020":70284,"_5":30370,"_20858":117130,"_27317":117131,"_2936":117132},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3450":70300,"_30020":70284,"_5":30370,"_20858":117134,"_27317":117135,"_2936":117136},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3450":70301,"_30020":70284,"_5":30370,"_20858":117138,"_27317":117139,"_2936":116246},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3450":70302,"_30020":70284,"_5":30370,"_20858":117141,"_27317":117142,"_2936":117143},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3450":70303,"_30020":70284,"_5":30370,"_20858":117145,"_27317":117146,"_2936":117147},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3450":70304,"_30020":70284,"_5":30370,"_20858":117149,"_27317":117150,"_2936":117151},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3450":70305,"_30020":70284,"_5":30370,"_20858":117153,"_27317":117154,"_2936":117155},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3450":70306,"_30020":70284,"_5":30370,"_20858":117157,"_27317":117158,"_2936":117159},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3450":70307,"_30020":70284,"_5":30370,"_20858":117161,"_27317":117162,"_2936":117163},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3450":70308,"_30020":70284,"_5":30370,"_20858":117165,"_27317":117166,"_2936":117167},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3450":70309,"_30020":70284,"_5":30370,"_20858":117169,"_27317":117170,"_2936":117171},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3450":70310,"_30020":70284,"_5":30370,"_20858":117173,"_27317":117174,"_2936":117175},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3450":70311,"_30020":70284,"_5":30370,"_20858":117177,"_27317":117178,"_2936":117179},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3450":70312,"_30020":70284,"_5":30370,"_20858":117181,"_27317":117182,"_2936":117183},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3450":70313,"_30020":70284,"_5":30370,"_20858":117185,"_27317":117186,"_2936":117187},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3450":70314,"_30020":70284,"_5":30370,"_20858":117189,"_27317":117190,"_2936":117191},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3450":70315,"_30020":70284,"_5":30370,"_20858":117193,"_27317":117194,"_2936":117195},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3450":70316,"_30020":70284,"_5":30370,"_20858":117197,"_27317":117198,"_2936":117199},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3450":70317,"_30020":70284,"_20858":117201,"_5":14334,"_27317":70284,"_2936":117202},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3450":70318,"_30020":70284,"_20858":117204,"_5":14334,"_27317":70284,"_2936":117205},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3450":70319,"_30020":70284,"_20858":117207,"_5":14334,"_27317":70284,"_2936":117208},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3450":70320,"_30020":70284,"_20858":117210,"_5":14334,"_27317":117079,"_2936":117211},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3450":70321,"_30020":70284,"_20858":117213,"_5":14334,"_27317":117079,"_2936":117214},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3450":70322,"_30020":70284,"_20858":117216,"_5":14334,"_27317":117079,"_2936":117217},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3450":70323,"_30020":70284,"_20858":117219,"_5":14334,"_27317":117079,"_2936":117220},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3450":70324,"_30020":70284,"_20858":117222,"_5":14334,"_27317":117079,"_2936":117223},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3450":70325,"_30020":70284,"_20858":117225,"_5":14334,"_27317":117079,"_2936":117226},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3450":70326,"_30020":70284,"_20858":117228,"_5":14334,"_27317":117083,"_2936":117229},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3450":70327,"_30020":70284,"_20858":117231,"_5":14334,"_27317":117083,"_2936":117232},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3450":70328,"_30020":70284,"_20858":117234,"_5":14334,"_27317":117087,"_2936":117235},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3450":70329,"_30020":70284,"_20858":117237,"_5":14334,"_27317":117087,"_2936":117238},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3450":70330,"_30020":70284,"_20858":117240,"_5":14334,"_27317":117087,"_2936":117241},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3450":70331,"_30020":70284,"_20858":117243,"_5":14334,"_27317":117087,"_2936":117244},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3450":70332,"_30020":70284,"_20858":117246,"_5":14334,"_27317":117087,"_2936":117247},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3450":70333,"_30020":70284,"_20858":117249,"_5":14334,"_27317":117087,"_2936":117250},[],"Carga por separado las políticas concedidas a cada principal.",{"_3450":70334,"_30020":70284,"_20858":117252,"_5":14334,"_27317":117087,"_2936":117253},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3450":70335,"_30020":70284,"_20858":117255,"_5":14334,"_27317":117087,"_2936":117256},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3450":70336,"_30020":70284,"_20858":117258,"_5":14334,"_27317":117087,"_2936":117259},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3450":70337,"_30020":70284,"_20858":117261,"_5":14334,"_27317":117087,"_2936":117262},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3450":70338,"_30020":70284,"_20858":117264,"_5":14334,"_27317":117087,"_2936":117265},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3450":70339,"_30020":70284,"_20858":117267,"_5":14334,"_27317":117087,"_2936":117268},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3450":70340,"_30020":70284,"_20858":117270,"_5":14334,"_27317":117091,"_2936":117271},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3450":70341,"_30020":70284,"_20858":117273,"_5":14334,"_27317":117091,"_2936":117274},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3450":70342,"_30020":70284,"_20858":117276,"_5":14334,"_27317":117091,"_2936":117277},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3450":70343,"_30020":70284,"_20858":117279,"_5":14334,"_27317":117091,"_2936":117280},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3450":70344,"_30020":70284,"_20858":117282,"_5":14334,"_27317":117091,"_2936":117283},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3450":70345,"_30020":70284,"_20858":117285,"_5":14334,"_27317":117091,"_2936":117286},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3450":70346,"_30020":70284,"_20858":117288,"_5":14334,"_27317":117091,"_2936":117289},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3450":70347,"_30020":70284,"_20858":117291,"_5":14334,"_27317":117091,"_2936":117292},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3450":70348,"_30020":70284,"_20858":117294,"_5":14334,"_27317":117095,"_2936":117295},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3450":70349,"_30020":70284,"_20858":117297,"_5":14334,"_27317":117095,"_2936":117298},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3450":70350,"_30020":70284,"_20858":117300,"_5":14334,"_27317":117095,"_2936":117301},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3450":70351,"_30020":70284,"_20858":117303,"_5":14334,"_27317":117095,"_2936":117304},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3450":70352,"_30020":70284,"_20858":117306,"_5":14334,"_27317":117095,"_2936":117307},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3450":70353,"_30020":70284,"_20858":117309,"_5":14334,"_27317":117095,"_2936":117310},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3450":70354,"_30020":70284,"_20858":117312,"_5":14334,"_27317":117095,"_2936":117313},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3450":70355,"_30020":70284,"_20858":117315,"_5":14334,"_27317":117095,"_2936":117316},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3450":70356,"_30020":70284,"_20858":117318,"_5":14334,"_27317":117095,"_2936":117319},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3450":70357,"_30020":70284,"_20858":117321,"_5":14334,"_27317":117095,"_2936":117322},[],"Las acciones se dividen en dos grupos:",{"_3450":70358,"_30020":70284,"_20858":117324,"_5":14334,"_27317":117095,"_2936":117325},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3450":70359,"_30020":70284,"_20858":117327,"_5":14334,"_27317":117095,"_2936":117328},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3450":70360,"_30020":70284,"_20858":117330,"_5":14334,"_27317":117095,"_2936":117331},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3450":70361,"_30020":70284,"_20858":117333,"_5":14334,"_27317":117099,"_2936":117334},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3450":70362,"_30020":70284,"_20858":117336,"_5":14334,"_27317":117099,"_2936":117337},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3450":70363,"_30020":70284,"_20858":117339,"_5":14334,"_27317":117099,"_2936":117340},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3450":70364,"_30020":70284,"_20858":117342,"_5":14334,"_27317":117103,"_2936":117343},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3450":70365,"_30020":70284,"_20858":117345,"_5":14334,"_27317":117103,"_2936":117346},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3450":70366,"_30020":70284,"_20858":117348,"_5":14334,"_27317":117103,"_2936":117349},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3450":70367,"_30020":70284,"_20858":117351,"_5":14334,"_27317":117103,"_2936":117352},[],"Los operadores implementados son:",{"_3450":70368,"_30020":70284,"_20858":117354,"_5":14334,"_27317":117103,"_2936":117355},[],"`equals`, para igualdad exacta;",{"_3450":70369,"_30020":70284,"_20858":117357,"_5":14334,"_27317":117103,"_2936":117358},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3450":70370,"_30020":70284,"_20858":117360,"_5":14334,"_27317":117103,"_2936":117361},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3450":70371,"_30020":70284,"_20858":117363,"_5":14334,"_27317":117103,"_2936":117364},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3450":70372,"_30020":70284,"_20858":117366,"_5":14334,"_27317":117107,"_2936":117367},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3450":70373,"_30020":70284,"_20858":117369,"_5":14334,"_27317":117107,"_2936":117370},[],"Los modos disponibles son:",{"_3450":70374,"_30020":70284,"_20858":117372,"_5":14334,"_27317":117107,"_2936":117373},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3450":70375,"_30020":70284,"_20858":117375,"_5":14334,"_27317":117107,"_2936":117376},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3450":70376,"_30020":70284,"_20858":117378,"_5":14334,"_27317":117107,"_2936":117379},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3450":70377,"_30020":70284,"_20858":117381,"_5":14334,"_27317":117107,"_2936":117382},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3450":70378,"_30020":70284,"_20858":117384,"_5":14334,"_27317":117107,"_2936":117385},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3450":70379,"_30020":70284,"_20858":117387,"_5":14334,"_27317":117107,"_2936":117388},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3450":70380,"_30020":70284,"_20858":117390,"_5":14334,"_27317":117111,"_2936":117391},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3450":70381,"_30020":70284,"_20858":117393,"_5":14334,"_27317":117111,"_2936":117394},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3450":70382,"_30020":70284,"_20858":117396,"_5":14334,"_27317":117111,"_2936":117397},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3450":70383,"_30020":70284,"_20858":117399,"_5":14334,"_27317":117111,"_2936":117400},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3450":70384,"_30020":70284,"_20858":117402,"_5":14334,"_27317":117119,"_2936":117403},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3450":70385,"_30020":70284,"_20858":117405,"_5":14334,"_27317":117119,"_2936":117406},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3450":70386,"_30020":70284,"_20858":117408,"_5":14334,"_27317":117123,"_2936":117409},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3450":70387,"_30020":70284,"_20858":117411,"_5":14334,"_27317":117123,"_2936":117412},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3450":70388,"_30020":70284,"_20858":117414,"_5":14334,"_27317":117127,"_2936":117415},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3450":70389,"_30020":70284,"_20858":117417,"_5":14334,"_27317":117127,"_2936":117418},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3450":70390,"_30020":70284,"_20858":117420,"_5":14334,"_27317":117127,"_2936":117421},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3450":70391,"_30020":70284,"_20858":117423,"_5":14334,"_27317":117131,"_2936":117424},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3450":70392,"_30020":70284,"_20858":117426,"_5":14334,"_27317":117131,"_2936":117427},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3450":70393,"_30020":70284,"_20858":117429,"_5":14334,"_27317":117131,"_2936":117430},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3450":70394,"_30020":70284,"_20858":117432,"_5":14334,"_27317":117131,"_2936":117433},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3450":70395,"_30020":70284,"_20858":117435,"_5":14334,"_27317":117131,"_2936":117436},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3450":70396,"_30020":70284,"_20858":117438,"_5":14334,"_27317":117131,"_2936":117439},[],"Ten en cuenta que:",{"_3450":70397,"_30020":70284,"_20858":117441,"_5":14334,"_27317":117131,"_2936":117442},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3450":70398,"_30020":70284,"_20858":117444,"_5":14334,"_27317":117131,"_2936":117445},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3450":70399,"_30020":70284,"_20858":117447,"_5":14334,"_27317":117131,"_2936":117448},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3450":70400,"_30020":70284,"_20858":117450,"_5":14334,"_27317":117135,"_2936":117451},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3450":70401,"_30020":70284,"_20858":117453,"_5":14334,"_27317":117135,"_2936":117454},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3450":70402,"_30020":70284,"_20858":117456,"_5":14334,"_27317":117135,"_2936":117457},[],"acceso completo y de solo lectura a KMS;",{"_3450":70403,"_30020":70284,"_20858":117459,"_5":14334,"_27317":117135,"_2936":117460},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3450":70404,"_30020":70284,"_20858":117462,"_5":14334,"_27317":117135,"_2936":117463},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3450":70405,"_30020":70284,"_20858":117465,"_5":14334,"_27317":117135,"_2936":117466},[],"acceso a la interfaz;",{"_3450":70406,"_30020":70284,"_20858":117468,"_5":14334,"_27317":117135,"_2936":117469},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3450":70407,"_30020":70284,"_20858":117471,"_5":14334,"_27317":117135,"_2936":117472},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3450":70408,"_30020":70284,"_20858":117474,"_5":14334,"_27317":117135,"_2936":117475},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3450":70409,"_30020":70284,"_20858":117477,"_5":14334,"_27317":117139,"_2936":117478},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3450":70410,"_30020":70284,"_20858":117480,"_5":14334,"_27317":117139,"_2936":117481},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3450":70411,"_30020":70284,"_20858":117483,"_5":14334,"_27317":117139,"_2936":117484},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3450":70412,"_30020":70284,"_20858":117486,"_5":14334,"_27317":117142,"_2936":117487},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3450":70413,"_30020":70284,"_20858":117489,"_5":14334,"_27317":117146,"_2936":117490},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3450":70414,"_30020":70284,"_20858":117492,"_5":14334,"_27317":117146,"_2936":117493},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3450":70415,"_30020":70284,"_20858":117495,"_5":14334,"_27317":117150,"_2936":117496},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3450":70416,"_30020":70284,"_20858":117498,"_5":14334,"_27317":117154,"_2936":117499},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3450":70417,"_30020":70284,"_20858":117501,"_5":14334,"_27317":117158,"_2936":117502},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3450":70418,"_30020":70284,"_20858":117504,"_5":14334,"_27317":117162,"_2936":117505},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3450":70419,"_30020":70284,"_20858":117507,"_5":14334,"_27317":117162,"_2936":117508},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3450":70420,"_30020":70284,"_20858":117510,"_5":14334,"_27317":117166,"_2936":117511},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3450":70421,"_30020":70284,"_20858":117513,"_5":14334,"_27317":117166,"_2936":117514},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3450":70422,"_30020":70284,"_20858":117516,"_5":14334,"_27317":117166,"_2936":117517},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3450":70423,"_30020":70284,"_20858":117519,"_5":14334,"_27317":117166,"_2936":117520},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3450":70424,"_30020":70284,"_20858":117522,"_5":14334,"_27317":117166,"_2936":117523},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3450":70425,"_30020":70284,"_20858":117525,"_5":14334,"_27317":117166,"_2936":117526},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3450":70426,"_30020":70284,"_20858":117528,"_5":14334,"_27317":117166,"_2936":117529},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3450":70427,"_30020":70284,"_20858":117531,"_5":14334,"_27317":117166,"_2936":117532},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3450":70428,"_30020":70284,"_20858":117534,"_5":14334,"_27317":117170,"_2936":117535},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3450":70429,"_30020":70284,"_20858":117537,"_5":14334,"_27317":117170,"_2936":117538},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3450":70430,"_30020":70284,"_20858":117540,"_5":14334,"_27317":117170,"_2936":117541},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3450":70431,"_30020":70284,"_20858":117543,"_5":14334,"_27317":117174,"_2936":117544},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3450":70432,"_30020":70284,"_20858":117546,"_5":14334,"_27317":117174,"_2936":117547},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3450":70433,"_30020":70284,"_20858":117549,"_5":14334,"_27317":117174,"_2936":117550},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3450":70434,"_30020":70284,"_20858":117552,"_5":14334,"_27317":117174,"_2936":117553},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3450":70435,"_30020":70284,"_20858":117555,"_5":14334,"_27317":117174,"_2936":117556},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3450":70436,"_30020":70284,"_20858":117558,"_5":14334,"_27317":117174,"_2936":117559},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3450":70437,"_30020":70284,"_20858":117561,"_5":14334,"_27317":117174,"_2936":117562},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3450":70438,"_30020":70284,"_20858":117564,"_5":14334,"_27317":117174,"_2936":117565},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3450":70439,"_30020":70284,"_20858":117567,"_5":14334,"_27317":117182,"_2936":117568},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3450":70440,"_30020":70284,"_20858":117570,"_5":14334,"_27317":117186,"_2936":117571},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3450":70441,"_30020":70284,"_20858":117573,"_5":14334,"_27317":117186,"_2936":117574},[],"que exista un principal activo del tipo correcto;",{"_3450":70442,"_30020":70284,"_20858":117576,"_5":14334,"_27317":117186,"_2936":117577},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3450":70443,"_30020":70284,"_20858":117579,"_5":14334,"_27317":117186,"_2936":117580},[],"que todas las condiciones del principal se cumplan;",{"_3450":70444,"_30020":70284,"_20858":117582,"_5":14334,"_27317":117186,"_2936":117583},[],"que el principal tenga concedida la política esperada;",{"_3450":70445,"_30020":70284,"_20858":117585,"_5":14334,"_27317":117186,"_2936":117586},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3450":70446,"_30020":70284,"_20858":117588,"_5":14334,"_27317":117186,"_2936":117589},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3450":70447,"_30020":70284,"_20858":117591,"_5":14334,"_27317":117186,"_2936":117592},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3450":70448,"_30020":70284,"_20858":117594,"_5":14334,"_27317":117190,"_2936":117595},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3450":70449,"_30020":70284,"_20858":117597,"_5":14334,"_27317":117194,"_2936":117598},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3450":70450,"_30020":70284,"_20858":117600,"_5":14334,"_27317":117198,"_2936":117601},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3450":70451,"_30020":70284,"_20858":117603,"_5":14334,"_27317":117198,"_2936":117604},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3450":70452,"_30020":70452,"_5":14686,"_2936":117606,"_30373":117607,"_20858":117608,"_27317":70452},"Alertas y suscripciones",[49010,117071,117072],[],{"_3450":70453,"_30020":70452,"_20858":117610,"_5":14334,"_27317":70452,"_2936":117611},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3450":70454,"_30020":70452,"_5":30370,"_20858":117613,"_27317":117614,"_2936":117615},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3450":70455,"_30020":70452,"_5":30370,"_20858":117617,"_27317":117618,"_2936":117619},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3450":70456,"_30020":70452,"_5":30370,"_20858":117621,"_27317":117622,"_2936":117623},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3450":70457,"_30020":70452,"_5":30370,"_20858":117625,"_27317":117626,"_2936":117627},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3450":70458,"_30020":70452,"_5":30370,"_20858":117629,"_27317":117630,"_2936":117631},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3450":70459,"_30020":70452,"_5":30370,"_20858":117633,"_27317":117634,"_2936":117635},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3450":70460,"_30020":70452,"_5":30370,"_20858":117637,"_27317":117638,"_2936":117639},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3450":70461,"_30020":70452,"_5":30370,"_20858":117641,"_27317":117642,"_2936":117643},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3450":70462,"_30020":70452,"_5":30370,"_20858":117645,"_27317":117646,"_2936":117647},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3450":70463,"_30020":70452,"_5":30370,"_20858":117649,"_27317":117650,"_2936":117651},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3450":70464,"_30020":70452,"_5":30370,"_20858":117653,"_27317":117654,"_2936":117655},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3450":70465,"_30020":70452,"_20858":117657,"_5":14334,"_27317":70452,"_2936":117658},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3450":70466,"_30020":70452,"_20858":117660,"_5":14334,"_27317":117614,"_2936":117661},[],"Un servicio publica un evento de dominio.",{"_3450":70467,"_30020":70452,"_20858":117663,"_5":14334,"_27317":117614,"_2936":117664},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3450":70468,"_30020":70452,"_20858":117666,"_5":14334,"_27317":117614,"_2936":117667},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3450":70469,"_30020":70452,"_20858":117669,"_5":14334,"_27317":117614,"_2936":117670},[],"Lamassu entrega el evento al canal configurado.",{"_3450":70470,"_30020":70452,"_20858":117672,"_5":14334,"_27317":117614,"_2936":117673},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3450":70471,"_30020":70452,"_20858":117675,"_5":14334,"_27317":117618,"_2936":117676},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3450":70472,"_30020":70452,"_20858":117678,"_5":14334,"_27317":117618,"_2936":117679},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3450":70473,"_30020":70452,"_20858":117681,"_5":14334,"_27317":117618,"_2936":117682},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3450":70474,"_30020":70452,"_20858":117684,"_5":14334,"_27317":117618,"_2936":117685},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3450":70475,"_30020":70452,"_20858":117687,"_5":14334,"_27317":117618,"_2936":117688},[],"`apikey_options` necesita `header` y `key`.",{"_3450":70476,"_30020":70452,"_20858":117690,"_5":14334,"_27317":117618,"_2936":117691},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3450":70477,"_30020":70452,"_20858":117693,"_5":14334,"_27317":117618,"_2936":117694},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3450":70478,"_30020":70452,"_20858":117696,"_5":14334,"_27317":117618,"_2936":117697},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3450":70479,"_30020":70452,"_20858":117699,"_5":14334,"_27317":117626,"_2936":117700},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3450":70480,"_30020":70452,"_20858":117702,"_5":14334,"_27317":117630,"_2936":117703},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3450":70481,"_30020":70452,"_20858":117705,"_5":14334,"_27317":117634,"_2936":117706},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3450":70482,"_30020":70452,"_20858":117708,"_5":14334,"_27317":117634,"_2936":117709},[],"**None** notifica todas las instancias del evento.",{"_3450":70483,"_30020":70452,"_20858":117711,"_5":14334,"_27317":117634,"_2936":117712},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3450":70484,"_30020":70452,"_20858":117714,"_5":14334,"_27317":117634,"_2936":117715},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3450":70485,"_30020":70452,"_20858":117717,"_5":14334,"_27317":117634,"_2936":117718},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3450":70486,"_30020":70452,"_20858":117720,"_5":14334,"_27317":117634,"_2936":117721},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3450":70487,"_30020":70452,"_20858":117723,"_5":14334,"_27317":117634,"_2936":117724},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3450":70488,"_30020":70452,"_20858":117726,"_5":14334,"_27317":117638,"_2936":117727},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3450":70489,"_30020":70452,"_20858":117729,"_5":14334,"_27317":117642,"_2936":117730},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3450":70490,"_30020":70452,"_20858":117732,"_5":14334,"_27317":117642,"_2936":117733},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3450":70491,"_30020":70452,"_20858":117735,"_5":14334,"_27317":117642,"_2936":117736},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3450":70492,"_30020":70452,"_20858":117738,"_5":14334,"_27317":117642,"_2936":117739},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3450":70493,"_30020":70452,"_20858":117741,"_5":14334,"_27317":117642,"_2936":117742},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3450":70494,"_30020":70452,"_20858":117744,"_5":14334,"_27317":117642,"_2936":117745},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3450":70495,"_30020":70452,"_20858":117747,"_5":14334,"_27317":117642,"_2936":117748},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3450":70496,"_30020":70452,"_20858":117750,"_5":14334,"_27317":117642,"_2936":117751},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3450":70497,"_30020":70452,"_20858":117753,"_5":14334,"_27317":117646,"_2936":117754},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3450":70498,"_30020":70452,"_20858":117756,"_5":14334,"_27317":117646,"_2936":117757},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3450":70499,"_30020":70452,"_20858":117759,"_5":14334,"_27317":117646,"_2936":117760},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3450":70500,"_30020":70452,"_20858":117762,"_5":14334,"_27317":117646,"_2936":117763},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3450":70501,"_30020":70452,"_20858":117765,"_5":14334,"_27317":117646,"_2936":117766},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3450":70502,"_30020":70452,"_20858":117768,"_5":14334,"_27317":117646,"_2936":117769},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3450":70503,"_30020":70452,"_20858":117771,"_5":14334,"_27317":117646,"_2936":117772},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3450":70504,"_30020":70452,"_20858":117774,"_5":14334,"_27317":117646,"_2936":117775},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3450":70505,"_30020":70452,"_20858":117777,"_5":14334,"_27317":117650,"_2936":117778},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3450":70506,"_30020":70452,"_20858":117780,"_5":14334,"_27317":117650,"_2936":117781},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3450":70507,"_30020":70452,"_20858":117783,"_5":14334,"_27317":117654,"_2936":117784},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3450":70508,"_30020":70452,"_20858":117786,"_5":14334,"_27317":117654,"_2936":117787},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3450":70509,"_30020":70452,"_20858":117789,"_5":14334,"_27317":117654,"_2936":117790},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3450":70510,"_30020":70452,"_20858":117792,"_5":14334,"_27317":117654,"_2936":117793},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3450":70511,"_30020":70452,"_20858":117795,"_5":14334,"_27317":117654,"_2936":117796},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3450":70512,"_30020":70452,"_20858":117798,"_5":14334,"_27317":117654,"_2936":117799},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3450":70513,"_30020":70452,"_20858":117801,"_5":14334,"_27317":117654,"_2936":117802},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3450":70514,"_30020":70452,"_20858":117804,"_5":14334,"_27317":117654,"_2936":117805},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3450":70515,"_30020":70452,"_20858":117807,"_5":14334,"_27317":117654,"_2936":117808},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa cualquier filtro que lea un campo del payload antiguo (consulta 3.8.0 a 4.0.0).",{"_3450":70516,"_30020":70516,"_5":14686,"_2936":117810,"_30373":117811,"_20858":117812,"_27317":70516},"Registros de auditoría",[49010,117071,117072],[],{"_3450":70517,"_30020":70516,"_20858":117814,"_5":14334,"_27317":70516,"_2936":117815},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3450":70518,"_30020":70516,"_5":30370,"_20858":117817,"_27317":117818,"_2936":117819},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3450":70519,"_30020":70516,"_5":30370,"_20858":117821,"_27317":117822,"_2936":117823},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3450":70520,"_30020":70516,"_5":30370,"_20858":117825,"_27317":117826,"_2936":117827},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3450":70521,"_30020":70516,"_5":30370,"_20858":117829,"_27317":117830,"_2936":117831},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3450":70522,"_30020":70516,"_5":30370,"_20858":117833,"_27317":117834,"_2936":117835},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3450":70523,"_30020":70516,"_5":30370,"_20858":117837,"_27317":117838,"_2936":117839},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3450":70524,"_30020":70516,"_5":30370,"_20858":117841,"_27317":117842,"_2936":117843},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3450":70525,"_30020":70516,"_5":30370,"_20858":117845,"_27317":117846,"_2936":117847},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3450":70526,"_30020":70516,"_5":30370,"_20858":117849,"_27317":117850,"_2936":117851},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3450":70527,"_30020":70516,"_5":30370,"_20858":117853,"_27317":117854,"_2936":117855},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3450":70528,"_30020":70516,"_5":30370,"_20858":117857,"_27317":117858,"_2936":117859},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3450":70529,"_30020":70516,"_20858":117861,"_5":14334,"_27317":70516,"_2936":117862},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3450":70530,"_30020":70516,"_20858":117864,"_5":14334,"_27317":117818,"_2936":117865},[],"El cuerpo de auditoría incluye:",{"_3450":70531,"_30020":70516,"_20858":117867,"_5":14334,"_27317":117818,"_2936":117868},[],"input: datos recibidos por la operación;",{"_3450":70532,"_30020":70516,"_20858":117870,"_5":14334,"_27317":117818,"_2936":117871},[],"has\\_error: indica si el servicio devolvió un error;",{"_3450":70533,"_30020":70516,"_20858":117873,"_5":14334,"_27317":117818,"_2936":117874},[],"output: resultado producido o mensaje de error;",{"_3450":70534,"_30020":70516,"_20858":117876,"_5":14334,"_27317":117818,"_2936":117877},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3450":70535,"_30020":70516,"_20858":117879,"_5":14334,"_27317":117818,"_2936":117880},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3450":70536,"_30020":70516,"_20858":117882,"_5":14334,"_27317":117818,"_2936":117883},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3450":70537,"_30020":70516,"_20858":117885,"_5":14334,"_27317":117822,"_2936":117886},[],"El backend aplica auditoría a mutaciones de:",{"_3450":70538,"_30020":70516,"_20858":117888,"_5":14334,"_27317":117822,"_2936":117889},[],"autoridades, certificados y perfiles de emisión;",{"_3450":70539,"_30020":70516,"_20858":117891,"_5":14334,"_27317":117822,"_2936":117892},[],"claves y motores KMS;",{"_3450":70540,"_30020":70516,"_20858":117894,"_5":14334,"_27317":117822,"_2936":117895},[],"dispositivos e identidades;",{"_3450":70541,"_30020":70516,"_20858":117897,"_5":14334,"_27317":117822,"_2936":117898},[],"DMS y operaciones de enrolamiento;",{"_3450":70542,"_30020":70516,"_20858":117900,"_5":14334,"_27317":117822,"_2936":117901},[],"funciones de validación y CRL;",{"_3450":70543,"_30020":70516,"_20858":117903,"_5":14334,"_27317":117822,"_2936":117904},[],"principales, políticas y concesiones de autorización.",{"_3450":70544,"_30020":70516,"_20858":117906,"_5":14334,"_27317":117822,"_2936":117907},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3450":70545,"_30020":70516,"_20858":117909,"_5":14334,"_27317":117826,"_2936":117910},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3450":70546,"_30020":70516,"_20858":117912,"_5":14334,"_27317":117826,"_2936":117913},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3450":70547,"_30020":70516,"_20858":117915,"_5":14334,"_27317":117826,"_2936":117916},[],"Diseña el consumidor para:",{"_3450":70548,"_30020":70516,"_20858":117918,"_5":14334,"_27317":117826,"_2936":117919},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3450":70549,"_30020":70516,"_20858":117921,"_5":14334,"_27317":117826,"_2936":117922},[],"conservar el CloudEvent completo sin modificar;",{"_3450":70550,"_30020":70516,"_20858":117924,"_5":14334,"_27317":117826,"_2936":117925},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3450":70551,"_30020":70516,"_20858":117927,"_5":14334,"_27317":117826,"_2936":117928},[],"cifrar en tránsito y en reposo;",{"_3450":70552,"_30020":70516,"_20858":117930,"_5":14334,"_27317":117826,"_2936":117931},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3450":70553,"_30020":70516,"_20858":117933,"_5":14334,"_27317":117826,"_2936":117934},[],"aplicar una política explícita de retención y legal hold;",{"_3450":70554,"_30020":70516,"_20858":117936,"_5":14334,"_27317":117826,"_2936":117937},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3450":70555,"_30020":70516,"_20858":117939,"_5":14334,"_27317":117830,"_2936":117940},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3450":70556,"_30020":70516,"_20858":117942,"_5":14334,"_27317":117830,"_2936":117943},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3450":70557,"_30020":70516,"_20858":117945,"_5":14334,"_27317":117838,"_2936":117946},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3450":70558,"_30020":70516,"_20858":117948,"_5":14334,"_27317":117842,"_2936":117949},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3450":70559,"_30020":70516,"_20858":117951,"_5":14334,"_27317":117846,"_2936":117952},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3450":70560,"_30020":70516,"_20858":117954,"_5":14334,"_27317":117850,"_2936":117955},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3450":70561,"_30020":70516,"_20858":117957,"_5":14334,"_27317":117854,"_2936":117958},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3450":70562,"_30020":70516,"_20858":117960,"_5":14334,"_27317":117858,"_2936":117961},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3450":70563,"_30020":70516,"_20858":117963,"_5":14334,"_27317":117858,"_2936":117964},[],"aparece un evento de auditoría correcto;",{"_3450":70564,"_30020":70516,"_20858":117966,"_5":14334,"_27317":117858,"_2936":117967},[],"el principal coincide con la identidad utilizada;",{"_3450":70565,"_30020":70516,"_20858":117969,"_5":14334,"_27317":117858,"_2936":117970},[],"el consumidor lo persiste una sola vez;",{"_3450":70566,"_30020":70516,"_20858":117972,"_5":14334,"_27317":117858,"_2936":117973},[],"puede recuperarse por recurso, actor y periodo;",{"_3450":70567,"_30020":70516,"_20858":117975,"_5":14334,"_27317":117858,"_2936":117976},[],"una interrupción del consumidor produce una alerta.",{"_3450":70568,"_30020":70516,"_20858":117978,"_5":14334,"_27317":117858,"_2936":117979},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3450":70569,"_30020":70569,"_5":14686,"_2936":117981,"_30373":117982,"_20858":117983,"_27317":70569},"Arquitectura de la plataforma",[49010,117071],[],{"_3450":70570,"_30020":70569,"_20858":117985,"_5":14334,"_27317":70569,"_2936":117986},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3450":70571,"_30020":70569,"_5":30370,"_20858":117988,"_27317":117989,"_2936":117990},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3450":70572,"_30020":70569,"_5":30370,"_20858":117992,"_27317":117993,"_2936":117994},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3450":70573,"_30020":70569,"_5":30370,"_20858":117996,"_27317":117997,"_2936":117998},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3450":70574,"_30020":70569,"_5":30370,"_20858":118000,"_27317":118001,"_2936":118002},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3450":70575,"_30020":70569,"_5":30370,"_20858":118004,"_27317":118005,"_2936":118006},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3450":70576,"_30020":70569,"_20858":118008,"_5":14334,"_27317":70569,"_2936":118009},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3450":70577,"_30020":70569,"_20858":118011,"_5":14334,"_27317":70569,"_2936":118012},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3450":70578,"_30020":70569,"_20858":118014,"_5":14334,"_27317":117989,"_2936":118015},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3450":70579,"_30020":70569,"_20858":118017,"_5":14334,"_27317":117993,"_2936":118018},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3450":70580,"_30020":70569,"_20858":118020,"_5":14334,"_27317":117997,"_2936":118021},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3450":70581,"_30020":70569,"_20858":118023,"_5":14334,"_27317":118001,"_2936":118024},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3450":70582,"_30020":70569,"_20858":118026,"_5":14334,"_27317":118005,"_2936":118027},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3450":70583,"_30020":70583,"_5":14686,"_2936":118029,"_30373":118030,"_20858":118031,"_27317":70583},"Cómo funciona Lamassu",[49010,117071],[],{"_3450":70584,"_30020":70583,"_20858":118033,"_5":14334,"_27317":70583,"_2936":118034},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3450":70585,"_30020":70583,"_5":30370,"_20858":118036,"_27317":118037,"_2936":118038},[],"/docs/pr-preview/pr-60/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3450":70586,"_30020":70583,"_5":30370,"_20858":118040,"_27317":118041,"_2936":118042},[],"/docs/pr-preview/pr-60/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3450":70587,"_30020":70583,"_20858":118044,"_5":14334,"_27317":70583,"_2936":118045},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3450":70588,"_30020":70583,"_20858":118047,"_5":14334,"_27317":118037,"_2936":118048},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3450":70589,"_30020":70583,"_20858":118050,"_5":14334,"_27317":118037,"_2936":118051},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3450":70590,"_30020":70583,"_20858":118053,"_5":14334,"_27317":118037,"_2936":118054},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3450":70591,"_30020":70583,"_20858":118056,"_5":14334,"_27317":118037,"_2936":118057},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3450":70592,"_30020":70583,"_20858":118059,"_5":14334,"_27317":118037,"_2936":118060},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3450":70593,"_30020":70583,"_20858":118062,"_5":14334,"_27317":118041,"_2936":118063},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3450":70594,"_30020":70583,"_20858":118065,"_5":14334,"_27317":118041,"_2936":118066},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3450":70595,"_30020":70583,"_20858":118068,"_5":14334,"_27317":118041,"_2936":118069},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3450":70596,"_30020":70583,"_20858":118071,"_5":14334,"_27317":118041,"_2936":118072},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3450":70597,"_30020":70583,"_20858":118074,"_5":14334,"_27317":118041,"_2936":118075},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3450":70598,"_30020":70583,"_20858":118077,"_5":14334,"_27317":118041,"_2936":118078},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3450":70599,"_30020":70583,"_20858":118080,"_5":14334,"_27317":118041,"_2936":118081},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3450":70600,"_30020":70600,"_5":14686,"_2936":118083,"_30373":118084,"_20858":118085,"_27317":70600},"Dispositivos e identidades",[49010,117071,51492,118083],[],{"_3450":70601,"_30020":70600,"_20858":118087,"_5":14334,"_27317":70600,"_2936":118088},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3450":70602,"_30020":70600,"_5":30370,"_20858":118090,"_27317":118091,"_2936":118092},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3450":70603,"_30020":70600,"_5":30370,"_20858":118094,"_27317":118095,"_2936":118096},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3450":70604,"_30020":70600,"_5":30370,"_20858":118098,"_27317":118099,"_2936":118100},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3450":70605,"_30020":70600,"_5":30370,"_20858":118102,"_27317":118103,"_2936":118104},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3450":70606,"_30020":70600,"_5":30370,"_20858":118106,"_27317":118107,"_2936":118108},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3450":70607,"_30020":70600,"_5":30370,"_20858":118110,"_27317":118111,"_2936":118112},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3450":70608,"_30020":70600,"_5":30370,"_20858":118114,"_27317":118115,"_2936":118116},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3450":70609,"_30020":70600,"_5":30370,"_20858":118118,"_27317":118119,"_2936":118120},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3450":70610,"_30020":70600,"_5":30370,"_20858":118122,"_27317":118123,"_2936":118124},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3450":70611,"_30020":70600,"_5":30370,"_20858":118126,"_27317":118127,"_2936":118128},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3450":70612,"_30020":70600,"_5":30370,"_20858":118130,"_27317":118131,"_2936":118132},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3450":70613,"_30020":70600,"_20858":118134,"_5":14334,"_27317":70600,"_2936":118135},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3450":70614,"_30020":70600,"_20858":118137,"_5":14334,"_27317":70600,"_2936":118138},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3450":70615,"_30020":70600,"_20858":118140,"_5":14334,"_27317":118091,"_2936":118141},[],"Vista operativa",{"_3450":70616,"_30020":70600,"_20858":118143,"_5":14334,"_27317":118091,"_2936":118144},[],"Interpretación",{"_3450":70617,"_30020":70600,"_20858":118146,"_5":14334,"_27317":118091,"_2936":51555},[],{"_3450":70618,"_30020":70600,"_20858":118148,"_5":14334,"_27317":118091,"_2936":118149},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3450":70619,"_30020":70600,"_20858":118151,"_5":14334,"_27317":118091,"_2936":51561},[],{"_3450":70620,"_30020":70600,"_20858":118153,"_5":14334,"_27317":118091,"_2936":118154},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3450":70621,"_30020":70600,"_20858":118156,"_5":14334,"_27317":118091,"_2936":51567},[],{"_3450":70622,"_30020":70600,"_20858":118158,"_5":14334,"_27317":118091,"_2936":118159},[],"La identidad está en la ventana operativa de renovación.",{"_3450":70623,"_30020":70600,"_20858":118161,"_5":14334,"_27317":118091,"_2936":51573},[],{"_3450":70624,"_30020":70600,"_20858":118163,"_5":14334,"_27317":118091,"_2936":118164},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3450":70625,"_30020":70600,"_20858":118166,"_5":14334,"_27317":118091,"_2936":51579},[],{"_3450":70626,"_30020":70600,"_20858":118168,"_5":14334,"_27317":118091,"_2936":118169},[],"La identidad ha vencido.",{"_3450":70627,"_30020":70600,"_20858":118171,"_5":14334,"_27317":118091,"_2936":51585},[],{"_3450":70628,"_30020":70600,"_20858":118173,"_5":14334,"_27317":118091,"_2936":118174},[],"La identidad está marcada como revocada.",{"_3450":70629,"_30020":70600,"_20858":118176,"_5":14334,"_27317":118091,"_2936":51591},[],{"_3450":70630,"_30020":70600,"_20858":118178,"_5":14334,"_27317":118091,"_2936":118179},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3450":70631,"_30020":70600,"_20858":118181,"_5":14334,"_27317":118091,"_2936":118182},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3450":70632,"_30020":70600,"_20858":118184,"_5":14334,"_27317":118095,"_2936":118185},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3450":70633,"_30020":70600,"_20858":118187,"_5":14334,"_27317":118095,"_2936":118188},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3450":70634,"_30020":70600,"_20858":118190,"_5":14334,"_27317":118095,"_2936":118191},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3450":70635,"_30020":70600,"_20858":118193,"_5":14334,"_27317":118095,"_2936":118194},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3450":70636,"_30020":70600,"_20858":118196,"_5":14334,"_27317":118099,"_2936":118197},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3450":70637,"_30020":70600,"_20858":118199,"_5":14334,"_27317":118103,"_2936":118200},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3450":70638,"_30020":70600,"_20858":118202,"_5":14334,"_27317":118107,"_2936":118203},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3450":70639,"_30020":70600,"_20858":118205,"_5":14334,"_27317":118111,"_2936":118206},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3450":70640,"_30020":70600,"_20858":118208,"_5":14334,"_27317":118115,"_2936":118209},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3450":70641,"_30020":70600,"_20858":118211,"_5":14334,"_27317":118115,"_2936":118212},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3450":70642,"_30020":70600,"_20858":118214,"_5":14334,"_27317":118119,"_2936":118215},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3450":70643,"_30020":70600,"_20858":118217,"_5":14334,"_27317":118119,"_2936":118218},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3450":70644,"_30020":70600,"_20858":118220,"_5":14334,"_27317":118119,"_2936":118221},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3450":70645,"_30020":70600,"_20858":118223,"_5":14334,"_27317":118119,"_2936":118224},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3450":70646,"_30020":70600,"_20858":118226,"_5":14334,"_27317":118119,"_2936":118227},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3450":70647,"_30020":70600,"_20858":118229,"_5":14334,"_27317":118119,"_2936":118230},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3450":70648,"_30020":70600,"_20858":118232,"_5":14334,"_27317":118123,"_2936":118233},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3450":70649,"_30020":70600,"_20858":118235,"_5":14334,"_27317":118123,"_2936":118236},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3450":70650,"_30020":70600,"_20858":118238,"_5":14334,"_27317":118127,"_2936":118239},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3450":70651,"_30020":70600,"_20858":118241,"_5":14334,"_27317":118127,"_2936":118242},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3450":70652,"_30020":70600,"_20858":118244,"_5":14334,"_27317":118127,"_2936":118245},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3450":70653,"_30020":70600,"_20858":118247,"_5":14334,"_27317":118127,"_2936":118248},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3450":70654,"_30020":70600,"_20858":118250,"_5":14334,"_27317":118131,"_2936":118251},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3450":70655,"_30020":70600,"_20858":118253,"_5":14334,"_27317":118131,"_2936":118254},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3450":70656,"_30020":70656,"_5":14686,"_2936":118256,"_30373":118257,"_20858":118259,"_27317":70656},"Identidad inicial y autenticación",[49010,117071,51492,118083,118258],"Enrolamiento con PKI",[],{"_3450":70657,"_30020":70656,"_20858":118261,"_5":14334,"_27317":70656,"_2936":118262},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3450":70658,"_30020":70656,"_5":30370,"_20858":118264,"_27317":118265,"_2936":118266},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3450":70659,"_30020":70656,"_5":30370,"_20858":118268,"_27317":118269,"_2936":118270},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3450":70660,"_30020":70656,"_5":30370,"_20858":118272,"_27317":118273,"_2936":118274},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3450":70661,"_30020":70656,"_5":30370,"_20858":118276,"_27317":118277,"_2936":118278},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3450":70662,"_30020":70656,"_5":30370,"_20858":118280,"_27317":118281,"_2936":118282},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3450":70663,"_30020":70656,"_20858":118284,"_5":14334,"_27317":70656,"_2936":118285},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3450":70664,"_30020":70656,"_20858":118287,"_5":14334,"_27317":118265,"_2936":118288},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3450":70665,"_30020":70656,"_20858":118290,"_5":14334,"_27317":118265,"_2936":118291},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3450":70666,"_30020":70656,"_20858":118293,"_5":14334,"_27317":118269,"_2936":118294},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3450":70667,"_30020":70656,"_20858":118296,"_5":14334,"_27317":118269,"_2936":118297},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3450":70668,"_30020":70656,"_20858":118299,"_5":14334,"_27317":118269,"_2936":118300},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3450":70669,"_30020":70656,"_20858":118302,"_5":14334,"_27317":118273,"_2936":118303},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3450":70670,"_30020":70656,"_20858":118305,"_5":14334,"_27317":118273,"_2936":118306},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3450":70671,"_30020":70656,"_20858":118308,"_5":14334,"_27317":118277,"_2936":118309},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3450":70672,"_30020":70656,"_20858":118311,"_5":14334,"_27317":118277,"_2936":118312},[],"Ejemplo de cuerpo:",{"_3450":70673,"_30020":70656,"_20858":118314,"_5":14334,"_27317":118277,"_2936":118315},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3450":70674,"_30020":70656,"_20858":118317,"_5":14334,"_27317":118277,"_2936":118318},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3450":70675,"_30020":70656,"_20858":118320,"_5":14334,"_27317":118277,"_2936":118321},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3450":70676,"_30020":70656,"_20858":118323,"_5":14334,"_27317":118277,"_2936":118324},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3450":70677,"_30020":70656,"_20858":118326,"_5":14334,"_27317":118281,"_2936":118327},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3450":70678,"_30020":70656,"_20858":118329,"_5":14334,"_27317":118281,"_2936":118330},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3450":70679,"_30020":70679,"_5":14686,"_2936":118332,"_30373":118333,"_20858":118334,"_27317":70679},"Configura y opera el DMS",[49010,117071,51492,118083,118258],[],{"_3450":70680,"_30020":70679,"_20858":118336,"_5":14334,"_27317":70679,"_2936":118337},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3450":70681,"_30020":70679,"_5":30370,"_20858":118339,"_27317":118340,"_2936":115649},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3450":70682,"_30020":70679,"_5":30370,"_20858":118342,"_27317":118343,"_2936":118344},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3450":70683,"_30020":70679,"_5":30370,"_20858":118346,"_27317":118347,"_2936":118348},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3450":70684,"_30020":70679,"_5":30370,"_20858":118350,"_27317":118351,"_2936":118352},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3450":70685,"_30020":70679,"_5":30370,"_20858":118354,"_27317":118355,"_2936":118356},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3450":70686,"_30020":70679,"_5":30370,"_20858":118358,"_27317":118359,"_2936":118360},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3450":70687,"_30020":70679,"_5":30370,"_20858":118362,"_27317":118363,"_2936":118364},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3450":70688,"_30020":70679,"_5":30370,"_20858":118366,"_27317":118367,"_2936":118368},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3450":70689,"_30020":70679,"_5":30370,"_20858":118370,"_27317":118371,"_2936":51787},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3450":70690,"_30020":70679,"_5":30370,"_20858":118373,"_27317":118374,"_2936":51791},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3450":70691,"_30020":70679,"_5":30370,"_20858":118376,"_27317":118377,"_2936":118378},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3450":70692,"_30020":70679,"_5":30370,"_20858":118380,"_27317":118381,"_2936":118382},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3450":70693,"_30020":70679,"_5":30370,"_20858":118384,"_27317":118385,"_2936":118386},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3450":70694,"_30020":70679,"_5":30370,"_20858":118388,"_27317":118389,"_2936":118390},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3450":70695,"_30020":70679,"_5":30370,"_20858":118392,"_27317":118393,"_2936":51811},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3450":70696,"_30020":70679,"_5":30370,"_20858":118395,"_27317":118396,"_2936":118397},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3450":70697,"_30020":70679,"_5":30370,"_20858":118399,"_27317":118400,"_2936":118401},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3450":70698,"_30020":70679,"_5":30370,"_20858":118403,"_27317":118404,"_2936":118405},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3450":70699,"_30020":70679,"_20858":118407,"_5":14334,"_27317":70679,"_2936":118408},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3450":70700,"_30020":70679,"_20858":118410,"_5":14334,"_27317":118340,"_2936":118411},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3450":70701,"_30020":70679,"_20858":118413,"_5":14334,"_27317":118340,"_2936":118414},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3450":70702,"_30020":70679,"_20858":118416,"_5":14334,"_27317":118347,"_2936":118417},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3450":70703,"_30020":70679,"_20858":118419,"_5":14334,"_27317":118351,"_2936":118420},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3450":70704,"_30020":70679,"_20858":118422,"_5":14334,"_27317":118355,"_2936":118423},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3450":70705,"_30020":70679,"_20858":118425,"_5":14334,"_27317":118359,"_2936":118426},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3450":70706,"_30020":70679,"_20858":118428,"_5":14334,"_27317":118363,"_2936":118429},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3450":70707,"_30020":70679,"_20858":118431,"_5":14334,"_27317":118371,"_2936":118432},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3450":70708,"_30020":70679,"_20858":118434,"_5":14334,"_27317":118371,"_2936":118435},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3450":70709,"_30020":70679,"_20858":118437,"_5":14334,"_27317":118374,"_2936":118438},[],"Campo de `settings.enrollment_settings`",{"_3450":70710,"_30020":70679,"_20858":118440,"_5":14334,"_27317":118374,"_2936":118441},[],"Decisión",{"_3450":70711,"_30020":70679,"_20858":118443,"_5":14334,"_27317":118374,"_2936":51862},[],{"_3450":70712,"_30020":70679,"_20858":118445,"_5":14334,"_27317":118374,"_2936":118446},[],"`EST_RFC7030` para estas operaciones.",{"_3450":70713,"_30020":70679,"_20858":118448,"_5":14334,"_27317":118374,"_2936":51868},[],{"_3450":70714,"_30020":70679,"_20858":118450,"_5":14334,"_27317":118374,"_2936":118451},[],"ID de la CA que firmará.",{"_3450":70715,"_30020":70679,"_20858":118453,"_5":14334,"_27317":118374,"_2936":51874},[],{"_3450":70716,"_30020":70679,"_20858":118455,"_5":14334,"_27317":118374,"_2936":118456},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3450":70717,"_30020":70679,"_20858":118458,"_5":14334,"_27317":118374,"_2936":51880},[],{"_3450":70718,"_30020":70679,"_20858":118460,"_5":14334,"_27317":118374,"_2936":118461},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3450":70719,"_30020":70679,"_20858":118463,"_5":14334,"_27317":118374,"_2936":51886},[],{"_3450":70720,"_30020":70679,"_20858":118465,"_5":14334,"_27317":118374,"_2936":118466},[],"Uno de los cuatro modos de autenticación.",{"_3450":70721,"_30020":70679,"_20858":118468,"_5":14334,"_27317":118374,"_2936":118469},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3450":70722,"_30020":70679,"_20858":118471,"_5":14334,"_27317":118377,"_2936":118472},[],"Los bloques son independientes:",{"_3450":70723,"_30020":70679,"_20858":118474,"_5":14334,"_27317":118377,"_2936":118475},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3450":70724,"_30020":70679,"_20858":118477,"_5":14334,"_27317":118377,"_2936":118478},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3450":70725,"_30020":70679,"_20858":118480,"_5":14334,"_27317":118377,"_2936":51904},[],{"_3450":70726,"_30020":70679,"_20858":118482,"_5":14334,"_27317":118377,"_2936":118483},[],"Control aplicado en la operación configurada",{"_3450":70727,"_30020":70679,"_20858":118485,"_5":14334,"_27317":118377,"_2936":51910},[],{"_3450":70728,"_30020":70679,"_20858":118487,"_5":14334,"_27317":118377,"_2936":118488},[],"Validación del certificado presentado.",{"_3450":70729,"_30020":70679,"_20858":118490,"_5":14334,"_27317":118377,"_2936":51916},[],{"_3450":70730,"_30020":70679,"_20858":118492,"_5":14334,"_27317":118377,"_2936":118493},[],"Autorización del webhook configurado.",{"_3450":70731,"_30020":70679,"_20858":118495,"_5":14334,"_27317":118377,"_2936":51922},[],{"_3450":70732,"_30020":70679,"_20858":118497,"_5":14334,"_27317":118377,"_2936":118498},[],"Validación del certificado y, después, aprobación del webhook.",{"_3450":70733,"_30020":70679,"_20858":118500,"_5":14334,"_27317":118377,"_2936":51928},[],{"_3450":70734,"_30020":70679,"_20858":118502,"_5":14334,"_27317":118377,"_2936":118503},[],"Sin autenticación del solicitante por el DMS.",{"_3450":70735,"_30020":70679,"_20858":118505,"_5":14334,"_27317":118377,"_2936":118506},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3450":70736,"_30020":70679,"_20858":118508,"_5":14334,"_27317":118377,"_2936":118509},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3450":70737,"_30020":70679,"_20858":118511,"_5":14334,"_27317":118377,"_2936":118512},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3450":70738,"_30020":70679,"_20858":118514,"_5":14334,"_27317":118377,"_2936":118515},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3450":70739,"_30020":70679,"_20858":118517,"_5":14334,"_27317":118381,"_2936":118518},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3450":70740,"_30020":70679,"_20858":118520,"_5":14334,"_27317":118381,"_2936":118521},[],"Campo de `external_webhook_settings`",{"_3450":70741,"_30020":70679,"_20858":118523,"_5":14334,"_27317":118381,"_2936":118441},[],{"_3450":70742,"_30020":70679,"_20858":118525,"_5":14334,"_27317":118381,"_2936":51954},[],{"_3450":70743,"_30020":70679,"_20858":118527,"_5":14334,"_27317":118381,"_2936":118528},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3450":70744,"_30020":70679,"_20858":118530,"_5":14334,"_27317":118381,"_2936":51960},[],{"_3450":70745,"_30020":70679,"_20858":118532,"_5":14334,"_27317":118381,"_2936":118533},[],"`POST` o `PUT`; `POST` por defecto.",{"_3450":70746,"_30020":70679,"_20858":118535,"_5":14334,"_27317":118381,"_2936":51966},[],{"_3450":70747,"_30020":70679,"_20858":118537,"_5":14334,"_27317":118381,"_2936":118538},[],"Etiqueta usada en los logs del servicio.",{"_3450":70748,"_30020":70679,"_20858":118540,"_5":14334,"_27317":118381,"_2936":51972},[],{"_3450":70749,"_30020":70679,"_20858":118542,"_5":14334,"_27317":118381,"_2936":118543},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3450":70750,"_30020":70679,"_20858":118545,"_5":14334,"_27317":118381,"_2936":51978},[],{"_3450":70751,"_30020":70679,"_20858":118547,"_5":14334,"_27317":118381,"_2936":118548},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3450":70752,"_30020":70679,"_20858":118550,"_5":14334,"_27317":118381,"_2936":51984},[],{"_3450":70753,"_30020":70679,"_20858":118552,"_5":14334,"_27317":118381,"_2936":118553},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3450":70754,"_30020":70679,"_20858":118555,"_5":14334,"_27317":118381,"_2936":51990},[],{"_3450":70755,"_30020":70679,"_20858":118557,"_5":14334,"_27317":118381,"_2936":118558},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3450":70756,"_30020":70679,"_20858":118560,"_5":14334,"_27317":118381,"_2936":51996},[],{"_3450":70757,"_30020":70679,"_20858":118562,"_5":14334,"_27317":118381,"_2936":118563},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3450":70758,"_30020":70679,"_20858":118565,"_5":14334,"_27317":118381,"_2936":52002},[],{"_3450":70759,"_30020":70679,"_20858":118567,"_5":14334,"_27317":118381,"_2936":118568},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3450":70760,"_30020":70679,"_20858":118570,"_5":14334,"_27317":118381,"_2936":52008},[],{"_3450":70761,"_30020":70679,"_20858":118572,"_5":14334,"_27317":118381,"_2936":118573},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3450":70762,"_30020":70679,"_20858":118575,"_5":14334,"_27317":118381,"_2936":118576},[],"Reglas de esa configuración:",{"_3450":70763,"_30020":70679,"_20858":118578,"_5":14334,"_27317":118381,"_2936":118579},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3450":70764,"_30020":70679,"_20858":118581,"_5":14334,"_27317":118381,"_2936":118582},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3450":70765,"_30020":70679,"_20858":118584,"_5":14334,"_27317":118381,"_2936":118585},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3450":70766,"_30020":70679,"_20858":118587,"_5":14334,"_27317":118381,"_2936":118588},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3450":70767,"_30020":70679,"_20858":118590,"_5":14334,"_27317":118381,"_2936":118591},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3450":70768,"_30020":70679,"_20858":118593,"_5":14334,"_27317":118381,"_2936":118594},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3450":70769,"_30020":70679,"_20858":118596,"_5":14334,"_27317":118381,"_2936":118597},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3450":70770,"_30020":70679,"_20858":118599,"_5":14334,"_27317":118381,"_2936":118600},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3450":70771,"_30020":70679,"_20858":118602,"_5":14334,"_27317":118381,"_2936":118603},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3450":70772,"_30020":70679,"_20858":118605,"_5":14334,"_27317":118385,"_2936":118606},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3450":70773,"_30020":70679,"_20858":118608,"_5":14334,"_27317":118389,"_2936":118609},[],"Campo de `settings.reenrollment_settings`",{"_3450":70774,"_30020":70679,"_20858":118611,"_5":14334,"_27317":118389,"_2936":118612},[],"Función",{"_3450":70775,"_30020":70679,"_20858":118614,"_5":14334,"_27317":118389,"_2936":52052},[],{"_3450":70776,"_30020":70679,"_20858":118616,"_5":14334,"_27317":118389,"_2936":118617},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3450":70777,"_30020":70679,"_20858":118619,"_5":14334,"_27317":118389,"_2936":52058},[],{"_3450":70778,"_30020":70679,"_20858":118621,"_5":14334,"_27317":118389,"_2936":118622},[],"Umbral operativo preventivo de monitorización.",{"_3450":70779,"_30020":70679,"_20858":118624,"_5":14334,"_27317":118389,"_2936":52064},[],{"_3450":70780,"_30020":70679,"_20858":118626,"_5":14334,"_27317":118389,"_2936":118627},[],"Umbral operativo crítico de monitorización.",{"_3450":70781,"_30020":70679,"_20858":118629,"_5":14334,"_27317":118389,"_2936":52070},[],{"_3450":70782,"_30020":70679,"_20858":118631,"_5":14334,"_27317":118389,"_2936":118632},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3450":70783,"_30020":70679,"_20858":118634,"_5":14334,"_27317":118389,"_2936":52076},[],{"_3450":70784,"_30020":70679,"_20858":118636,"_5":14334,"_27317":118389,"_2936":118637},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3450":70785,"_30020":70679,"_20858":118639,"_5":14334,"_27317":118389,"_2936":52082},[],{"_3450":70786,"_30020":70679,"_20858":118641,"_5":14334,"_27317":118389,"_2936":118642},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3450":70787,"_30020":70679,"_20858":118644,"_5":14334,"_27317":118389,"_2936":118645},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3450":70788,"_30020":70679,"_20858":118647,"_5":14334,"_27317":118393,"_2936":118648},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3450":70789,"_30020":70679,"_20858":118650,"_5":14334,"_27317":118396,"_2936":116013},[],{"_3450":70790,"_30020":70679,"_20858":118652,"_5":14334,"_27317":118396,"_2936":118653},[],"Qué publica",{"_3450":70791,"_30020":70679,"_20858":118655,"_5":14334,"_27317":118396,"_2936":52099},[],{"_3450":70792,"_30020":70679,"_20858":118657,"_5":14334,"_27317":118396,"_2936":118658},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3450":70793,"_30020":70679,"_20858":118660,"_5":14334,"_27317":118396,"_2936":52105},[],{"_3450":70794,"_30020":70679,"_20858":118662,"_5":14334,"_27317":118396,"_2936":118663},[],"Certificado de la CA emisora seleccionada.",{"_3450":70795,"_30020":70679,"_20858":118665,"_5":14334,"_27317":118396,"_2936":52111},[],{"_3450":70796,"_30020":70679,"_20858":118667,"_5":14334,"_27317":118396,"_2936":118668},[],"Certificados de las CAs elegidas explícitamente.",{"_3450":70797,"_30020":70679,"_20858":118670,"_5":14334,"_27317":118396,"_2936":118671},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3450":70798,"_30020":70679,"_20858":118673,"_5":14334,"_27317":118400,"_2936":118674},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3450":70799,"_30020":70679,"_20858":118676,"_5":14334,"_27317":118400,"_2936":118677},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3450":70800,"_30020":70679,"_20858":118679,"_5":14334,"_27317":118400,"_2936":118680},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3450":70801,"_30020":70679,"_20858":118682,"_5":14334,"_27317":118404,"_2936":118683},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3450":70802,"_30020":70802,"_5":14686,"_2936":118685,"_30373":118686,"_20858":118687,"_27317":70802},"Integra el cliente EST",[49010,117071,51492,118083,118258],[],{"_3450":70803,"_30020":70802,"_20858":118689,"_5":14334,"_27317":70802,"_2936":118690},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3450":70804,"_30020":70802,"_5":30370,"_20858":118692,"_27317":118693,"_2936":115649},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3450":70805,"_30020":70802,"_5":30370,"_20858":118695,"_27317":118696,"_2936":118697},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3450":70806,"_30020":70802,"_5":30370,"_20858":118699,"_27317":118700,"_2936":118701},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3450":70807,"_30020":70802,"_5":30370,"_20858":118703,"_27317":118704,"_2936":118705},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3450":70808,"_30020":70802,"_5":30370,"_20858":118707,"_27317":118708,"_2936":118709},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3450":70809,"_30020":70802,"_5":30370,"_20858":118711,"_27317":118712,"_2936":118713},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3450":70810,"_30020":70802,"_20858":118715,"_5":14334,"_27317":70802,"_2936":118716},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3450":70811,"_30020":70802,"_20858":118718,"_5":14334,"_27317":118693,"_2936":118719},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3450":70812,"_30020":70802,"_20858":118721,"_5":14334,"_27317":118693,"_2936":118722},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3450":70813,"_30020":70802,"_20858":118724,"_5":14334,"_27317":118693,"_2936":118725},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3450":70814,"_30020":70802,"_20858":118727,"_5":14334,"_27317":118696,"_2936":118728},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3450":70815,"_30020":70802,"_20858":118730,"_5":14334,"_27317":118696,"_2936":118731},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3450":70816,"_30020":70802,"_20858":118733,"_5":14334,"_27317":118700,"_2936":118734},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3450":70817,"_30020":70802,"_20858":118736,"_5":14334,"_27317":118700,"_2936":118737},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3450":70818,"_30020":70802,"_20858":118739,"_5":14334,"_27317":118704,"_2936":118740},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3450":70819,"_30020":70802,"_20858":118742,"_5":14334,"_27317":118704,"_2936":118743},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3450":70820,"_30020":70802,"_20858":118745,"_5":14334,"_27317":118708,"_2936":118746},[],"Para el caso de una raíz que emite directamente:",{"_3450":70821,"_30020":70802,"_20858":118748,"_5":14334,"_27317":118708,"_2936":118749},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3450":70822,"_30020":70802,"_20858":118751,"_5":14334,"_27317":118708,"_2936":118752},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3450":70823,"_30020":70802,"_20858":118754,"_5":14334,"_27317":118712,"_2936":118755},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3450":70824,"_30020":70824,"_5":14686,"_2936":118757,"_30373":118758,"_20858":118759,"_27317":70824},"Referencia EST",[49010,117071,51492,118083,118258],[],{"_3450":70825,"_30020":70824,"_20858":118761,"_5":14334,"_27317":70824,"_2936":118762},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3450":70826,"_30020":70824,"_5":30370,"_20858":118764,"_27317":118765,"_2936":118766},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3450":70827,"_30020":70824,"_5":30370,"_20858":118768,"_27317":118769,"_2936":22608},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3450":70828,"_30020":70824,"_5":30370,"_20858":118771,"_27317":118772,"_2936":25938},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3450":70829,"_30020":70824,"_5":30370,"_20858":118774,"_27317":118775,"_2936":25945},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3450":70830,"_30020":70824,"_5":30370,"_20858":118777,"_27317":118778,"_2936":25264},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3450":70831,"_30020":70824,"_5":30370,"_20858":118780,"_27317":118781,"_2936":118782},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3450":70832,"_30020":70824,"_5":30370,"_20858":118784,"_27317":118785,"_2936":118786},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3450":70833,"_30020":70824,"_5":30370,"_20858":118788,"_27317":118789,"_2936":118790},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3450":70834,"_30020":70824,"_20858":118792,"_5":14334,"_27317":70824,"_2936":118793},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3450":70835,"_30020":70824,"_20858":118795,"_5":14334,"_27317":118765,"_2936":118796},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3450":70836,"_30020":70824,"_20858":118798,"_5":14334,"_27317":118765,"_2936":116831},[],{"_3450":70837,"_30020":70824,"_20858":118800,"_5":14334,"_27317":118765,"_2936":118801},[],"Método",{"_3450":70838,"_30020":70824,"_20858":118803,"_5":14334,"_27317":118765,"_2936":118804},[],"Autenticación y condición",{"_3450":70839,"_30020":70824,"_20858":118806,"_5":14334,"_27317":118765,"_2936":52254},[],{"_3450":70840,"_30020":70824,"_20858":118808,"_5":14334,"_27317":118765,"_2936":52257},[],{"_3450":70841,"_30020":70824,"_20858":118810,"_5":14334,"_27317":118765,"_2936":118811},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3450":70842,"_30020":70824,"_20858":118813,"_5":14334,"_27317":118765,"_2936":52263},[],{"_3450":70843,"_30020":70824,"_20858":118815,"_5":14334,"_27317":118765,"_2936":52266},[],{"_3450":70844,"_30020":70824,"_20858":118817,"_5":14334,"_27317":118765,"_2936":118818},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3450":70845,"_30020":70824,"_20858":118820,"_5":14334,"_27317":118765,"_2936":52272},[],{"_3450":70846,"_30020":70824,"_20858":118822,"_5":14334,"_27317":118765,"_2936":52266},[],{"_3450":70847,"_30020":70824,"_20858":118824,"_5":14334,"_27317":118765,"_2936":118825},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3450":70848,"_30020":70824,"_20858":118827,"_5":14334,"_27317":118765,"_2936":52280},[],{"_3450":70849,"_30020":70824,"_20858":118829,"_5":14334,"_27317":118765,"_2936":52266},[],{"_3450":70850,"_30020":70824,"_20858":118831,"_5":14334,"_27317":118765,"_2936":118832},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3450":70851,"_30020":70824,"_20858":118834,"_5":14334,"_27317":118765,"_2936":118835},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3450":70852,"_30020":70824,"_20858":118837,"_5":14334,"_27317":118769,"_2936":118838},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3450":70853,"_30020":70824,"_20858":118840,"_5":14334,"_27317":118769,"_2936":118841},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3450":70854,"_30020":70824,"_20858":118843,"_5":14334,"_27317":118772,"_2936":118844},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3450":70855,"_30020":70824,"_20858":118846,"_5":14334,"_27317":118772,"_2936":118847},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3450":70856,"_30020":70824,"_20858":118849,"_5":14334,"_27317":118775,"_2936":118850},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3450":70857,"_30020":70824,"_20858":118852,"_5":14334,"_27317":118775,"_2936":118853},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3450":70858,"_30020":70824,"_20858":118855,"_5":14334,"_27317":118778,"_2936":118856},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3450":70859,"_30020":70824,"_20858":118858,"_5":14334,"_27317":118778,"_2936":118859},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3450":70860,"_30020":70824,"_20858":118861,"_5":14334,"_27317":118781,"_2936":118862},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3450":70861,"_30020":70824,"_20858":118864,"_5":14334,"_27317":118781,"_2936":118865},[],"Parte",{"_3450":70862,"_30020":70824,"_20858":118867,"_5":14334,"_27317":118781,"_2936":118868},[],"Contenido tras decodificar su Base64",{"_3450":70863,"_30020":70824,"_20858":118870,"_5":14334,"_27317":118781,"_2936":52324},[],{"_3450":70864,"_30020":70824,"_20858":118872,"_5":14334,"_27317":118781,"_2936":118873},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3450":70865,"_30020":70824,"_20858":118875,"_5":14334,"_27317":118781,"_2936":52330},[],{"_3450":70866,"_30020":70824,"_20858":118877,"_5":14334,"_27317":118781,"_2936":118878},[],"PKCS#7 DER con el certificado emitido.",{"_3450":70867,"_30020":70824,"_20858":118880,"_5":14334,"_27317":118781,"_2936":118881},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3450":70868,"_30020":70824,"_20858":118883,"_5":14334,"_27317":118785,"_2936":118884},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3450":70869,"_30020":70824,"_20858":118886,"_5":14334,"_27317":118785,"_2936":118887},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3450":70870,"_30020":70824,"_20858":118889,"_5":14334,"_27317":118785,"_2936":118890},[],"Convierte y comprueba el resultado:",{"_3450":70871,"_30020":70824,"_20858":118892,"_5":14334,"_27317":118785,"_2936":118893},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3450":70872,"_30020":70824,"_20858":118895,"_5":14334,"_27317":118789,"_2936":118896},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3450":70873,"_30020":70824,"_20858":118898,"_5":14334,"_27317":118789,"_2936":118899},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3450":70874,"_30020":70874,"_5":14686,"_2936":118258,"_30373":118901,"_20858":118902,"_27317":70874},[49010,117071,51492,118083,118258],[],{"_3450":70875,"_30020":70874,"_20858":118904,"_5":14334,"_27317":70874,"_2936":118905},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3450":70876,"_30020":70874,"_5":30370,"_20858":118907,"_27317":118908,"_2936":118909},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3450":70877,"_30020":70874,"_5":30370,"_20858":118911,"_27317":118912,"_2936":118913},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3450":70878,"_30020":70874,"_5":30370,"_20858":118915,"_27317":118916,"_2936":118917},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3450":70879,"_30020":70874,"_5":30370,"_20858":118919,"_27317":118920,"_2936":118921},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3450":70880,"_30020":70874,"_20858":118923,"_5":14334,"_27317":70874,"_2936":118924},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3450":70881,"_30020":70874,"_20858":118926,"_5":14334,"_27317":118908,"_2936":118927},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3450":70882,"_30020":70874,"_20858":118929,"_5":14334,"_27317":118908,"_2936":118930},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3450":70883,"_30020":70874,"_20858":118932,"_5":14334,"_27317":118908,"_2936":118933},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3450":70884,"_30020":70874,"_20858":118935,"_5":14334,"_27317":118908,"_2936":118936},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3450":70885,"_30020":70874,"_20858":118938,"_5":14334,"_27317":118908,"_2936":118939},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3450":70886,"_30020":70874,"_20858":118941,"_5":14334,"_27317":118908,"_2936":118942},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3450":70887,"_30020":70874,"_20858":118944,"_5":14334,"_27317":118912,"_2936":118945},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3450":70888,"_30020":70874,"_20858":118947,"_5":14334,"_27317":118912,"_2936":118948},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3450":70889,"_30020":70874,"_20858":118950,"_5":14334,"_27317":118912,"_2936":118951},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3450":70890,"_30020":70874,"_20858":118953,"_5":14334,"_27317":118912,"_2936":118954},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3450":70891,"_30020":70874,"_20858":118956,"_5":14334,"_27317":118916,"_2936":118957},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3450":70892,"_30020":70874,"_20858":118959,"_5":14334,"_27317":118916,"_2936":118960},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3450":70893,"_30020":70874,"_20858":118962,"_5":14334,"_27317":118916,"_2936":118963},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3450":70894,"_30020":70874,"_20858":118965,"_5":14334,"_27317":118916,"_2936":118966},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3450":70895,"_30020":70874,"_20858":118968,"_5":14334,"_27317":118920,"_2936":118969},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3450":70896,"_30020":70874,"_20858":118971,"_5":14334,"_27317":118920,"_2936":118972},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3450":70897,"_30020":70897,"_5":14686,"_2936":118974,"_30373":118975,"_20858":118976,"_27317":70897},"Estrategias de aprovisionamiento",[49010,117071,51492,118083,118258],[],{"_3450":70898,"_30020":70897,"_20858":118978,"_5":14334,"_27317":70897,"_2936":118979},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3450":70899,"_30020":70897,"_5":30370,"_20858":118981,"_27317":118982,"_2936":118983},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3450":70900,"_30020":70897,"_5":30370,"_20858":118985,"_27317":118986,"_2936":118987},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3450":70901,"_30020":70897,"_5":30370,"_20858":118989,"_27317":118990,"_2936":118991},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3450":70902,"_30020":70897,"_5":30370,"_20858":118993,"_27317":118994,"_2936":118995},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3450":70903,"_30020":70897,"_5":30370,"_20858":118997,"_27317":118998,"_2936":118999},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3450":70904,"_30020":70897,"_20858":119001,"_5":14334,"_27317":70897,"_2936":119002},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3450":70905,"_30020":70897,"_20858":119004,"_5":14334,"_27317":118982,"_2936":119005},[],"Recorrido",{"_3450":70906,"_30020":70897,"_20858":119007,"_5":14334,"_27317":118982,"_2936":119008},[],"Cuándo existe el dispositivo",{"_3450":70907,"_30020":70897,"_20858":119010,"_5":14334,"_27317":118982,"_2936":119011},[],"Qué compruebas",{"_3450":70908,"_30020":70897,"_20858":119013,"_5":14334,"_27317":118982,"_2936":119014},[],"Asignación manual",{"_3450":70909,"_30020":70897,"_20858":119016,"_5":14334,"_27317":118982,"_2936":119017},[],"El operador lo crea antes de asociar un certificado.",{"_3450":70910,"_30020":70897,"_20858":119019,"_5":14334,"_27317":118982,"_2936":119020},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3450":70911,"_30020":70897,"_20858":119022,"_5":14334,"_27317":118982,"_2936":119023},[],"EST con `JITP`",{"_3450":70912,"_30020":70897,"_20858":119025,"_5":14334,"_27317":118982,"_2936":119026},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3450":70913,"_30020":70897,"_20858":119028,"_5":14334,"_27317":118982,"_2936":119029},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3450":70914,"_30020":70897,"_20858":119031,"_5":14334,"_27317":118982,"_2936":119032},[],"EST con `PRE_REGISTRATION`",{"_3450":70915,"_30020":70897,"_20858":119034,"_5":14334,"_27317":118982,"_2936":119035},[],"Debe existir antes de `/simpleenroll`.",{"_3450":70916,"_30020":70897,"_20858":119037,"_5":14334,"_27317":118982,"_2936":119038},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3450":70917,"_30020":70897,"_20858":119040,"_5":14334,"_27317":118982,"_2936":119041},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3450":70918,"_30020":70897,"_20858":119043,"_5":14334,"_27317":118982,"_2936":119044},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3450":70919,"_30020":70897,"_20858":119046,"_5":14334,"_27317":118986,"_2936":119047},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3450":70920,"_30020":70897,"_20858":119049,"_5":14334,"_27317":118986,"_2936":119050},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3450":70921,"_30020":70897,"_20858":119052,"_5":14334,"_27317":118986,"_2936":119053},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3450":70922,"_30020":70897,"_20858":119055,"_5":14334,"_27317":118990,"_2936":119056},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3450":70923,"_30020":70897,"_20858":119058,"_5":14334,"_27317":118990,"_2936":119059},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3450":70924,"_30020":70897,"_20858":119061,"_5":14334,"_27317":118990,"_2936":119062},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3450":70925,"_30020":70897,"_20858":119064,"_5":14334,"_27317":118990,"_2936":119065},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3450":70926,"_30020":70897,"_20858":119067,"_5":14334,"_27317":118990,"_2936":119068},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3450":70927,"_30020":70897,"_20858":119070,"_5":14334,"_27317":118990,"_2936":119071},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3450":70928,"_30020":70897,"_20858":119073,"_5":14334,"_27317":118994,"_2936":116013},[],{"_3450":70929,"_30020":70897,"_20858":119075,"_5":14334,"_27317":118994,"_2936":119076},[],"Material que atraviesa EST",{"_3450":70930,"_30020":70897,"_20858":119078,"_5":14334,"_27317":118994,"_2936":119079},[],"Clave generada por el dispositivo",{"_3450":70931,"_30020":70897,"_20858":119081,"_5":14334,"_27317":118994,"_2936":119082},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3450":70932,"_30020":70897,"_20858":119084,"_5":14334,"_27317":118994,"_2936":119085},[],"Clave ya disponible en el dispositivo",{"_3450":70933,"_30020":70897,"_20858":119087,"_5":14334,"_27317":118994,"_2936":119088},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3450":70934,"_30020":70897,"_20858":119090,"_5":14334,"_27317":118994,"_2936":51811},[],{"_3450":70935,"_30020":70897,"_20858":119092,"_5":14334,"_27317":118994,"_2936":119093},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3450":70936,"_30020":70897,"_20858":119095,"_5":14334,"_27317":118994,"_2936":119096},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3450":70937,"_30020":70897,"_20858":119098,"_5":14334,"_27317":118998,"_2936":119099},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3450":70938,"_30020":70938,"_5":14686,"_2936":119101,"_30373":119102,"_20858":119103,"_27317":70938},"Renovación y recuperación",[49010,117071,51492,118083,118258],[],{"_3450":70939,"_30020":70938,"_20858":119105,"_5":14334,"_27317":70938,"_2936":119106},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3450":70940,"_30020":70938,"_5":30370,"_20858":119108,"_27317":119109,"_2936":119110},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3450":70941,"_30020":70938,"_5":30370,"_20858":119112,"_27317":119113,"_2936":119114},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3450":70942,"_30020":70938,"_5":30370,"_20858":119116,"_27317":119117,"_2936":119118},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3450":70943,"_30020":70938,"_5":30370,"_20858":119120,"_27317":119121,"_2936":119122},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3450":70944,"_30020":70938,"_5":30370,"_20858":119124,"_27317":119125,"_2936":119126},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3450":70945,"_30020":70938,"_20858":119128,"_5":14334,"_27317":70938,"_2936":119129},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3450":70946,"_30020":70938,"_20858":119131,"_5":14334,"_27317":119109,"_2936":119132},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3450":70947,"_30020":70938,"_20858":119134,"_5":14334,"_27317":119109,"_2936":119135},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3450":70948,"_30020":70938,"_20858":119137,"_5":14334,"_27317":119109,"_2936":119138},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3450":70949,"_30020":70938,"_20858":119140,"_5":14334,"_27317":119109,"_2936":119141},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3450":70950,"_30020":70938,"_20858":119143,"_5":14334,"_27317":119113,"_2936":119144},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3450":70951,"_30020":70938,"_20858":119146,"_5":14334,"_27317":119113,"_2936":119147},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3450":70952,"_30020":70938,"_20858":119149,"_5":14334,"_27317":119117,"_2936":119150},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3450":70953,"_30020":70938,"_20858":119152,"_5":14334,"_27317":119117,"_2936":119153},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3450":70954,"_30020":70938,"_20858":119155,"_5":14334,"_27317":119117,"_2936":119156},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3450":70955,"_30020":70938,"_20858":119158,"_5":14334,"_27317":119121,"_2936":119159},[],"Situación",{"_3450":70956,"_30020":70938,"_20858":119161,"_5":14334,"_27317":119121,"_2936":119162},[],"Procedimiento",{"_3450":70957,"_30020":70938,"_20858":119164,"_5":14334,"_27317":119121,"_2936":119165},[],"Certificado vigente, fuera de ventana",{"_3450":70958,"_30020":70938,"_20858":119167,"_5":14334,"_27317":119121,"_2936":119168},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3450":70959,"_30020":70938,"_20858":119170,"_5":14334,"_27317":119121,"_2936":119171},[],"Certificado vencido, clave disponible",{"_3450":70960,"_30020":70938,"_20858":119173,"_5":14334,"_27317":119121,"_2936":119174},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3450":70961,"_30020":70938,"_20858":119176,"_5":14334,"_27317":119121,"_2936":119177},[],"Renovación por webhook o `NO_AUTH`",{"_3450":70962,"_30020":70938,"_20858":119179,"_5":14334,"_27317":119121,"_2936":119180},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3450":70963,"_30020":70938,"_20858":119182,"_5":14334,"_27317":119121,"_2936":119183},[],"Clave perdida o inaccesible",{"_3450":70964,"_30020":70938,"_20858":119185,"_5":14334,"_27317":119121,"_2936":119186},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3450":70965,"_30020":70938,"_20858":119188,"_5":14334,"_27317":119121,"_2936":119189},[],"Identidad actual revocada",{"_3450":70966,"_30020":70938,"_20858":119191,"_5":14334,"_27317":119121,"_2936":119192},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3450":70967,"_30020":70938,"_20858":119194,"_5":14334,"_27317":119121,"_2936":119195},[],"Dispositivo sin identidad",{"_3450":70968,"_30020":70938,"_20858":119197,"_5":14334,"_27317":119121,"_2936":119198},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3450":70969,"_30020":70938,"_20858":119200,"_5":14334,"_27317":119121,"_2936":119201},[],"Dispositivo retirado",{"_3450":70970,"_30020":70938,"_20858":119203,"_5":14334,"_27317":119121,"_2936":119204},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3450":70971,"_30020":70938,"_20858":119206,"_5":14334,"_27317":119121,"_2936":119207},[],"Timeout, HTTP 500 o fallo de instalación",{"_3450":70972,"_30020":70938,"_20858":119209,"_5":14334,"_27317":119121,"_2936":119210},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3450":70973,"_30020":70938,"_20858":119212,"_5":14334,"_27317":119125,"_2936":119213},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3450":70974,"_30020":70938,"_20858":119215,"_5":14334,"_27317":119125,"_2936":119216},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3450":70975,"_30020":70975,"_5":14686,"_2936":119218,"_30373":119219,"_20858":119220,"_27317":70975},"Diagnóstico de enrolamiento",[49010,117071,51492,118083,118258],[],{"_3450":70976,"_30020":70975,"_20858":119222,"_5":14334,"_27317":70975,"_2936":119223},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3450":70977,"_30020":70975,"_5":30370,"_20858":119225,"_27317":119226,"_2936":119227},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3450":70978,"_30020":70975,"_5":30370,"_20858":119229,"_27317":119230,"_2936":119231},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3450":70979,"_30020":70975,"_5":30370,"_20858":119233,"_27317":119234,"_2936":118790},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3450":70980,"_30020":70975,"_5":30370,"_20858":119236,"_27317":119237,"_2936":119238},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3450":70981,"_30020":70975,"_20858":119240,"_5":14334,"_27317":70975,"_2936":119241},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3450":70982,"_30020":70975,"_20858":119243,"_5":14334,"_27317":119230,"_2936":119244},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3450":70983,"_30020":70975,"_20858":119246,"_5":14334,"_27317":119230,"_2936":119247},[],"Síntoma o mensaje",{"_3450":70984,"_30020":70975,"_20858":119249,"_5":14334,"_27317":119230,"_2936":119250},[],"Qué revisar",{"_3450":70985,"_30020":70975,"_20858":119252,"_5":14334,"_27317":119230,"_2936":119253},[],"curl rechaza TLS, nombre o emisor",{"_3450":70986,"_30020":70975,"_20858":119255,"_5":14334,"_27317":119230,"_2936":119256},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3450":70987,"_30020":70975,"_20858":119258,"_5":14334,"_27317":119230,"_2936":119259},[],"404 o APS ausente",{"_3450":70988,"_30020":70975,"_20858":119261,"_5":14334,"_27317":119230,"_2936":119262},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3450":70989,"_30020":70975,"_20858":119264,"_5":14334,"_27317":119230,"_2936":119265},[],"400, error de CSR o formato",{"_3450":70990,"_30020":70975,"_20858":119267,"_5":14334,"_27317":119230,"_2936":119268},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3450":70991,"_30020":70975,"_20858":119270,"_5":14334,"_27317":119230,"_2936":119271},[],"Credencial ausente o certificado no válido",{"_3450":70992,"_30020":70975,"_20858":119273,"_5":14334,"_27317":119230,"_2936":119274},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3450":70993,"_30020":70975,"_20858":119276,"_5":14334,"_27317":119230,"_2936":119277},[],"Webhook deniega, expira o responde sin autorización",{"_3450":70994,"_30020":70975,"_20858":119279,"_5":14334,"_27317":119230,"_2936":119280},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3450":70995,"_30020":70975,"_20858":119282,"_5":14334,"_27317":119230,"_2936":52737},[],{"_3450":70996,"_30020":70975,"_20858":119284,"_5":14334,"_27317":119230,"_2936":119285},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3450":70997,"_30020":70975,"_20858":119287,"_5":14334,"_27317":119230,"_2936":52743},[],{"_3450":70998,"_30020":70975,"_20858":119289,"_5":14334,"_27317":119230,"_2936":119290},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3450":70999,"_30020":70975,"_20858":119292,"_5":14334,"_27317":119230,"_2936":52749},[],{"_3450":71000,"_30020":70975,"_20858":119294,"_5":14334,"_27317":119230,"_2936":119295},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3450":71001,"_30020":70975,"_20858":119297,"_5":14334,"_27317":119230,"_2936":52755},[],{"_3450":71002,"_30020":70975,"_20858":119299,"_5":14334,"_27317":119230,"_2936":119300},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3450":71003,"_30020":70975,"_20858":119302,"_5":14334,"_27317":119230,"_2936":52761},[],{"_3450":71004,"_30020":70975,"_20858":119304,"_5":14334,"_27317":119230,"_2936":119305},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3450":71005,"_30020":70975,"_20858":119307,"_5":14334,"_27317":119230,"_2936":119308},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3450":71006,"_30020":70975,"_20858":119310,"_5":14334,"_27317":119230,"_2936":119311},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3450":71007,"_30020":70975,"_20858":119313,"_5":14334,"_27317":119230,"_2936":119314},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3450":71008,"_30020":70975,"_20858":119316,"_5":14334,"_27317":119230,"_2936":119317},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3450":71009,"_30020":70975,"_20858":119319,"_5":14334,"_27317":119230,"_2936":52779},[],{"_3450":71010,"_30020":70975,"_20858":119321,"_5":14334,"_27317":119230,"_2936":119322},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3450":71011,"_30020":70975,"_20858":119324,"_5":14334,"_27317":119230,"_2936":52785},[],{"_3450":71012,"_30020":70975,"_20858":119326,"_5":14334,"_27317":119230,"_2936":119327},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3450":71013,"_30020":70975,"_20858":119329,"_5":14334,"_27317":119230,"_2936":119330},[],"DMS propietario distinto",{"_3450":71014,"_30020":70975,"_20858":119332,"_5":14334,"_27317":119230,"_2936":119333},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3450":71015,"_30020":70975,"_20858":119335,"_5":14334,"_27317":119230,"_2936":52797},[],{"_3450":71016,"_30020":70975,"_20858":119337,"_5":14334,"_27317":119230,"_2936":119338},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3450":71017,"_30020":70975,"_20858":119340,"_5":14334,"_27317":119230,"_2936":52803},[],{"_3450":71018,"_30020":70975,"_20858":119342,"_5":14334,"_27317":119230,"_2936":119343},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3450":71019,"_30020":70975,"_20858":119345,"_5":14334,"_27317":119230,"_2936":119346},[],"Certificado actual revocado",{"_3450":71020,"_30020":70975,"_20858":119348,"_5":14334,"_27317":119230,"_2936":119349},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3450":71021,"_30020":70975,"_20858":119351,"_5":14334,"_27317":119230,"_2936":119352},[],"Error de CA, perfil o firma",{"_3450":71022,"_30020":70975,"_20858":119354,"_5":14334,"_27317":119230,"_2936":119355},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3450":71023,"_30020":70975,"_20858":119357,"_5":14334,"_27317":119230,"_2936":119358},[],"HTTP 200 sin conexión del dispositivo",{"_3450":71024,"_30020":70975,"_20858":119360,"_5":14334,"_27317":119230,"_2936":119361},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3450":71025,"_30020":70975,"_20858":119363,"_5":14334,"_27317":119230,"_2936":119364},[],"Timeout o error después de emitir",{"_3450":71026,"_30020":70975,"_20858":119366,"_5":14334,"_27317":119230,"_2936":119367},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3450":71027,"_30020":70975,"_20858":119369,"_5":14334,"_27317":119234,"_2936":119370},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3450":71028,"_30020":70975,"_20858":119372,"_5":14334,"_27317":119234,"_2936":119373},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3450":71029,"_30020":70975,"_20858":119375,"_5":14334,"_27317":119237,"_2936":119376},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3450":71030,"_30020":70975,"_20858":119378,"_5":14334,"_27317":119237,"_2936":119379},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3450":71031,"_30020":70975,"_20858":119381,"_5":14334,"_27317":119237,"_2936":119382},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3450":71032,"_30020":70975,"_20858":119384,"_5":14334,"_27317":119237,"_2936":119385},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3450":71033,"_30020":70975,"_20858":119387,"_5":14334,"_27317":119237,"_2936":119388},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3450":71034,"_30020":70975,"_20858":119390,"_5":14334,"_27317":119237,"_2936":119391},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3450":71035,"_30020":70975,"_20858":119393,"_5":14334,"_27317":119237,"_2936":119394},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3450":71036,"_30020":71036,"_5":14686,"_2936":119396,"_30373":119397,"_20858":119398,"_27317":71036},"Distribución y actualización de confianza",[49010,117071,51492,118083,118258],[],{"_3450":71037,"_30020":71036,"_20858":119400,"_5":14334,"_27317":71036,"_2936":119401},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3450":71038,"_30020":71036,"_5":30370,"_20858":119403,"_27317":119404,"_2936":119405},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3450":71039,"_30020":71036,"_5":30370,"_20858":119407,"_27317":119408,"_2936":119409},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3450":71040,"_30020":71036,"_5":30370,"_20858":119411,"_27317":119412,"_2936":119413},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3450":71041,"_30020":71036,"_5":30370,"_20858":119415,"_27317":119416,"_2936":119417},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3450":71042,"_30020":71036,"_5":30370,"_20858":119419,"_27317":119420,"_2936":119421},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3450":71043,"_30020":71036,"_20858":119423,"_5":14334,"_27317":71036,"_2936":119424},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3450":71044,"_30020":71036,"_20858":119426,"_5":14334,"_27317":119404,"_2936":119427},[],"Relación",{"_3450":71045,"_30020":71036,"_20858":119429,"_5":14334,"_27317":119404,"_2936":119430},[],"Material que prepara el responsable",{"_3450":71046,"_30020":71036,"_20858":119432,"_5":14334,"_27317":119404,"_2936":119433},[],"Dispositivo → servidor EST",{"_3450":71047,"_30020":71036,"_20858":119435,"_5":14334,"_27317":119404,"_2936":119436},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3450":71048,"_30020":71036,"_20858":119438,"_5":14334,"_27317":119404,"_2936":119439},[],"DMS → solicitante",{"_3450":71049,"_30020":71036,"_20858":119441,"_5":14334,"_27317":119404,"_2936":119442},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3450":71050,"_30020":71036,"_20858":119444,"_5":14334,"_27317":119404,"_2936":119445},[],"Consumidor → dispositivo",{"_3450":71051,"_30020":71036,"_20858":119447,"_5":14334,"_27317":119404,"_2936":119448},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3450":71052,"_30020":71036,"_20858":119450,"_5":14334,"_27317":119404,"_2936":119451},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3450":71053,"_30020":71036,"_20858":119453,"_5":14334,"_27317":119408,"_2936":119454},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3450":71054,"_30020":71036,"_20858":119456,"_5":14334,"_27317":119408,"_2936":119457},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3450":71055,"_30020":71036,"_20858":119459,"_5":14334,"_27317":119412,"_2936":119460},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3450":71056,"_30020":71036,"_20858":119462,"_5":14334,"_27317":119412,"_2936":119463},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3450":71057,"_30020":71036,"_20858":119465,"_5":14334,"_27317":119412,"_2936":119466},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3450":71058,"_30020":71036,"_20858":119468,"_5":14334,"_27317":119412,"_2936":119469},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3450":71059,"_30020":71036,"_20858":119471,"_5":14334,"_27317":119412,"_2936":119472},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3450":71060,"_30020":71036,"_20858":119474,"_5":14334,"_27317":119412,"_2936":119475},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3450":71061,"_30020":71036,"_20858":119477,"_5":14334,"_27317":119416,"_2936":119478},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3450":71062,"_30020":71036,"_20858":119480,"_5":14334,"_27317":119416,"_2936":119481},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3450":71063,"_30020":71036,"_20858":119483,"_5":14334,"_27317":119416,"_2936":119484},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3450":71064,"_30020":71036,"_20858":119486,"_5":14334,"_27317":119420,"_2936":119487},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3450":71065,"_30020":71065,"_5":14686,"_2936":52952,"_30373":119489,"_20858":119491,"_27317":71065},[49010,117071,51492,118083,119490],"Integraciones",[],{"_3450":71066,"_30020":71065,"_20858":119493,"_5":14334,"_27317":71065,"_2936":119494},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3450":71067,"_30020":71065,"_5":30370,"_20858":119496,"_27317":119497,"_2936":119498},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3450":71068,"_30020":71065,"_5":30370,"_20858":119500,"_27317":119501,"_2936":119502},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3450":71069,"_30020":71065,"_5":30370,"_20858":119504,"_27317":119505,"_2936":119506},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3450":71070,"_30020":71065,"_5":30370,"_20858":119508,"_27317":119509,"_2936":119510},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3450":71071,"_30020":71065,"_5":30370,"_20858":119512,"_27317":119513,"_2936":119514},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3450":71072,"_30020":71065,"_5":30370,"_20858":119516,"_27317":119517,"_2936":119518},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3450":71073,"_30020":71065,"_5":30370,"_20858":119520,"_27317":119521,"_2936":119522},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3450":71074,"_30020":71065,"_5":30370,"_20858":119524,"_27317":119525,"_2936":119526},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3450":71075,"_30020":71065,"_5":30370,"_20858":119528,"_27317":119529,"_2936":52994},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3450":71076,"_30020":71065,"_5":30370,"_20858":119531,"_27317":119532,"_2936":52998},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3450":71077,"_30020":71065,"_5":30370,"_20858":119534,"_27317":119535,"_2936":119536},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3450":71078,"_30020":71065,"_5":30370,"_20858":119538,"_27317":119539,"_2936":119540},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3450":71079,"_30020":71065,"_5":30370,"_20858":119542,"_27317":119543,"_2936":119544},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3450":71080,"_30020":71065,"_5":30370,"_20858":119546,"_27317":119547,"_2936":119548},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3450":71081,"_30020":71065,"_5":30370,"_20858":119550,"_27317":119551,"_2936":119552},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3450":71082,"_30020":71065,"_5":30370,"_20858":119554,"_27317":119555,"_2936":119556},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3450":71083,"_30020":71065,"_5":30370,"_20858":119558,"_27317":119559,"_2936":119560},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3450":71084,"_30020":71065,"_5":30370,"_20858":119562,"_27317":119563,"_2936":119564},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3450":71085,"_30020":71065,"_5":30370,"_20858":119566,"_27317":119567,"_2936":119568},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3450":71086,"_30020":71065,"_5":30370,"_20858":119570,"_27317":119571,"_2936":119572},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3450":71087,"_30020":71065,"_5":30370,"_20858":119574,"_27317":119575,"_2936":119576},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3450":71088,"_30020":71065,"_5":30370,"_20858":119578,"_27317":119579,"_2936":119580},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3450":71089,"_30020":71065,"_5":30370,"_20858":119582,"_27317":119583,"_2936":119584},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3450":71090,"_30020":71065,"_5":30370,"_20858":119586,"_27317":119587,"_2936":119588},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3450":71091,"_30020":71065,"_5":30370,"_20858":119590,"_27317":119591,"_2936":119592},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3450":71092,"_30020":71065,"_20858":119594,"_5":14334,"_27317":71065,"_2936":119595},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3450":71093,"_30020":71065,"_20858":119597,"_5":14334,"_27317":71065,"_2936":119598},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3450":71094,"_30020":71065,"_20858":119600,"_5":14334,"_27317":71065,"_2936":119601},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3450":71095,"_30020":71065,"_20858":119603,"_5":14334,"_27317":119497,"_2936":119604},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3450":71096,"_30020":71065,"_20858":119606,"_5":14334,"_27317":119497,"_2936":119607},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3450":71097,"_30020":71065,"_20858":119609,"_5":14334,"_27317":119497,"_2936":119610},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3450":71098,"_30020":71065,"_20858":119612,"_5":14334,"_27317":119497,"_2936":119613},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3450":71099,"_30020":71065,"_20858":119615,"_5":14334,"_27317":119501,"_2936":119616},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3450":71100,"_30020":71065,"_20858":119618,"_5":14334,"_27317":119505,"_2936":119619},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3450":71101,"_30020":71065,"_20858":119621,"_5":14334,"_27317":119505,"_2936":119622},[],"Acción IAM",{"_3450":71102,"_30020":71065,"_20858":119624,"_5":14334,"_27317":119505,"_2936":116019},[],{"_3450":71103,"_30020":71065,"_20858":119626,"_5":14334,"_27317":119505,"_2936":53093},[],{"_3450":71104,"_30020":71065,"_20858":119628,"_5":14334,"_27317":119505,"_2936":119629},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3450":71105,"_30020":71065,"_20858":119631,"_5":14334,"_27317":119505,"_2936":53099},[],{"_3450":71106,"_30020":71065,"_20858":119633,"_5":14334,"_27317":119505,"_2936":119634},[],"Registrar la CA en AWS IoT",{"_3450":71107,"_30020":71065,"_20858":119636,"_5":14334,"_27317":119505,"_2936":53105},[],{"_3450":71108,"_30020":71065,"_20858":119638,"_5":14334,"_27317":119505,"_2936":119639},[],"Consultar el estado del registro de la CA",{"_3450":71109,"_30020":71065,"_20858":119641,"_5":14334,"_27317":119505,"_2936":53111},[],{"_3450":71110,"_30020":71065,"_20858":119643,"_5":14334,"_27317":119505,"_2936":119644},[],"Crear o actualizar Things en IoT Core",{"_3450":71111,"_30020":71065,"_20858":119646,"_5":14334,"_27317":119505,"_2936":53117},[],{"_3450":71112,"_30020":71065,"_20858":119648,"_5":14334,"_27317":119505,"_2936":119649},[],"Aprovisionar Things mediante plantilla",{"_3450":71113,"_30020":71065,"_20858":119651,"_5":14334,"_27317":119505,"_2936":53123},[],{"_3450":71114,"_30020":71065,"_20858":119653,"_5":14334,"_27317":119505,"_2936":119654},[],"Registrar certificados de dispositivo",{"_3450":71115,"_30020":71065,"_20858":119656,"_5":14334,"_27317":119505,"_2936":53129},[],{"_3450":71116,"_30020":71065,"_20858":119658,"_5":14334,"_27317":119505,"_2936":119659},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3450":71117,"_30020":71065,"_20858":119661,"_5":14334,"_27317":119505,"_2936":53135},[],{"_3450":71118,"_30020":71065,"_20858":119663,"_5":14334,"_27317":119505,"_2936":119664},[],"Crear y adjuntar políticas IoT",{"_3450":71119,"_30020":71065,"_20858":119666,"_5":14334,"_27317":119505,"_2936":53141},[],{"_3450":71120,"_30020":71065,"_20858":119668,"_5":14334,"_27317":119505,"_2936":119669},[],"Gestionar grupos de Things",{"_3450":71121,"_30020":71065,"_20858":119671,"_5":14334,"_27317":119505,"_2936":53147},[],{"_3450":71122,"_30020":71065,"_20858":119673,"_5":14334,"_27317":119505,"_2936":119674},[],"Crear plantillas JITP",{"_3450":71123,"_30020":71065,"_20858":119676,"_5":14334,"_27317":119505,"_2936":53153},[],{"_3450":71124,"_30020":71065,"_20858":119678,"_5":14334,"_27317":119505,"_2936":119679},[],"Leer y escribir el Device Shadow",{"_3450":71125,"_30020":71065,"_20858":119681,"_5":14334,"_27317":119505,"_2936":119682},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3450":71126,"_30020":71065,"_20858":119684,"_5":14334,"_27317":119509,"_2936":119685},[],"Parámetro",{"_3450":71127,"_30020":71065,"_20858":119687,"_5":14334,"_27317":119509,"_2936":119688},[],"Tipo",{"_3450":71128,"_30020":71065,"_20858":119690,"_5":14334,"_27317":119509,"_2936":119691},[],"Requerido",{"_3450":71129,"_30020":71065,"_20858":119693,"_5":14334,"_27317":119509,"_2936":119694},[],"Descripción",{"_3450":71130,"_30020":71065,"_20858":119696,"_5":14334,"_27317":119509,"_2936":53174},[],{"_3450":71131,"_30020":71065,"_20858":119698,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71132,"_30020":71065,"_20858":119700,"_5":14334,"_27317":119509,"_2936":119701},[],"Sí",{"_3450":71133,"_30020":71065,"_20858":119703,"_5":14334,"_27317":119509,"_2936":119704},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3450":71134,"_30020":71065,"_20858":119706,"_5":14334,"_27317":119509,"_2936":53185},[],{"_3450":71135,"_30020":71065,"_20858":119708,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71136,"_30020":71065,"_20858":119710,"_5":14334,"_27317":119509,"_2936":119701},[],{"_3450":71137,"_30020":71065,"_20858":119712,"_5":14334,"_27317":119509,"_2936":119713},[],"Región AWS donde opera el conector.",{"_3450":71138,"_30020":71065,"_20858":119715,"_5":14334,"_27317":119509,"_2936":53195},[],{"_3450":71139,"_30020":71065,"_20858":119717,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71140,"_30020":71065,"_20858":119719,"_5":14334,"_27317":119509,"_2936":119701},[],{"_3450":71141,"_30020":71065,"_20858":119721,"_5":14334,"_27317":119509,"_2936":119722},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3450":71142,"_30020":71065,"_20858":119724,"_5":14334,"_27317":119509,"_2936":53205},[],{"_3450":71143,"_30020":71065,"_20858":119726,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71144,"_30020":71065,"_20858":119728,"_5":14334,"_27317":119509,"_2936":119729},[],"Solo con `auth_method=static`",{"_3450":71145,"_30020":71065,"_20858":119731,"_5":14334,"_27317":119509,"_2936":119732},[],"Clave de acceso AWS.",{"_3450":71146,"_30020":71065,"_20858":119734,"_5":14334,"_27317":119509,"_2936":53216},[],{"_3450":71147,"_30020":71065,"_20858":119736,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71148,"_30020":71065,"_20858":119738,"_5":14334,"_27317":119509,"_2936":119729},[],{"_3450":71149,"_30020":71065,"_20858":119740,"_5":14334,"_27317":119509,"_2936":119741},[],"Clave secreta AWS.",{"_3450":71150,"_30020":71065,"_20858":119743,"_5":14334,"_27317":119509,"_2936":53226},[],{"_3450":71151,"_30020":71065,"_20858":119745,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71152,"_30020":71065,"_20858":119747,"_5":14334,"_27317":119509,"_2936":53231},[],{"_3450":71153,"_30020":71065,"_20858":119749,"_5":14334,"_27317":119509,"_2936":119750},[],"Token de sesión (con `auth_method=static`).",{"_3450":71154,"_30020":71065,"_20858":119752,"_5":14334,"_27317":119509,"_2936":53237},[],{"_3450":71155,"_30020":71065,"_20858":119754,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71156,"_30020":71065,"_20858":119756,"_5":14334,"_27317":119509,"_2936":119757},[],"Solo con `auth_method=role`",{"_3450":71157,"_30020":71065,"_20858":119759,"_5":14334,"_27317":119509,"_2936":119760},[],"ARN del rol a asumir.",{"_3450":71158,"_30020":71065,"_20858":119762,"_5":14334,"_27317":119509,"_2936":53248},[],{"_3450":71159,"_30020":71065,"_20858":119764,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71160,"_30020":71065,"_20858":119766,"_5":14334,"_27317":119509,"_2936":53231},[],{"_3450":71161,"_30020":71065,"_20858":119768,"_5":14334,"_27317":119509,"_2936":119769},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3450":71162,"_30020":71065,"_20858":119771,"_5":14334,"_27317":119509,"_2936":53258},[],{"_3450":71163,"_30020":71065,"_20858":119773,"_5":14334,"_27317":119509,"_2936":89266},[],{"_3450":71164,"_30020":71065,"_20858":119775,"_5":14334,"_27317":119509,"_2936":119701},[],{"_3450":71165,"_30020":71065,"_20858":119777,"_5":14334,"_27317":119509,"_2936":119778},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3450":71166,"_30020":71065,"_20858":119780,"_5":14334,"_27317":119509,"_2936":53268},[],{"_3450":71167,"_30020":71065,"_20858":119782,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71168,"_30020":71065,"_20858":119784,"_5":14334,"_27317":119509,"_2936":119701},[],{"_3450":71169,"_30020":71065,"_20858":119786,"_5":14334,"_27317":119509,"_2936":119787},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3450":71170,"_30020":71065,"_20858":119789,"_5":14334,"_27317":119509,"_2936":53278},[],{"_3450":71171,"_30020":71065,"_20858":119791,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71172,"_30020":71065,"_20858":119793,"_5":14334,"_27317":119509,"_2936":119701},[],{"_3450":71173,"_30020":71065,"_20858":119795,"_5":14334,"_27317":119509,"_2936":119796},[],"URL HTTP del Device Manager de Lamassu.",{"_3450":71174,"_30020":71065,"_20858":119798,"_5":14334,"_27317":119509,"_2936":53288},[],{"_3450":71175,"_30020":71065,"_20858":119800,"_5":14334,"_27317":119509,"_2936":24910},[],{"_3450":71176,"_30020":71065,"_20858":119802,"_5":14334,"_27317":119509,"_2936":119701},[],{"_3450":71177,"_30020":71065,"_20858":119804,"_5":14334,"_27317":119509,"_2936":119805},[],"URL HTTP del servicio de CA de Lamassu.",{"_3450":71178,"_30020":71065,"_20858":119807,"_5":14334,"_27317":119513,"_2936":119808},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3450":71179,"_30020":71065,"_20858":119810,"_5":14334,"_27317":119513,"_2936":119811},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3450":71180,"_30020":71065,"_20858":119813,"_5":14334,"_27317":119513,"_2936":119814},[],"Tipo de CloudEvent",{"_3450":71181,"_30020":71065,"_20858":119816,"_5":14334,"_27317":119513,"_2936":119817},[],"Recurso en Lamassu",{"_3450":71182,"_30020":71065,"_20858":119819,"_5":14334,"_27317":119513,"_2936":119820},[],"Recurso AWS",{"_3450":71183,"_30020":71065,"_20858":119822,"_5":14334,"_27317":119513,"_2936":119823},[],"Acciones IAM",{"_3450":71184,"_30020":71065,"_20858":119825,"_5":14334,"_27317":119513,"_2936":119826},[],"Llamadas AWS y efecto",{"_3450":71185,"_30020":71065,"_20858":119828,"_5":14334,"_27317":119513,"_2936":119829},[],"Dónde en esta página",{"_3450":71186,"_30020":71065,"_20858":119831,"_5":14334,"_27317":119513,"_2936":53322},[],{"_3450":71187,"_30020":71065,"_20858":119833,"_5":14334,"_27317":119513,"_2936":53325},[],{"_3450":71188,"_30020":71065,"_20858":119835,"_5":14334,"_27317":119513,"_2936":53328},[],{"_3450":71189,"_30020":71065,"_20858":119837,"_5":14334,"_27317":119513,"_2936":53331},[],{"_3450":71190,"_30020":71065,"_20858":119839,"_5":14334,"_27317":119513,"_2936":119840},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3450":71191,"_30020":71065,"_20858":119842,"_5":14334,"_27317":119513,"_2936":119526},[],{"_3450":71192,"_30020":71065,"_20858":119844,"_5":14334,"_27317":119513,"_2936":53339},[],{"_3450":71193,"_30020":71065,"_20858":119846,"_5":14334,"_27317":119513,"_2936":53342},[],{"_3450":71194,"_30020":71065,"_20858":119848,"_5":14334,"_27317":119513,"_2936":53345},[],{"_3450":71195,"_30020":71065,"_20858":119850,"_5":14334,"_27317":119513,"_2936":53348},[],{"_3450":71196,"_30020":71065,"_20858":119852,"_5":14334,"_27317":119513,"_2936":119853},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3450":71197,"_30020":71065,"_20858":119855,"_5":14334,"_27317":119513,"_2936":119552},[],{"_3450":71198,"_30020":71065,"_20858":119857,"_5":14334,"_27317":119513,"_2936":53356},[],{"_3450":71199,"_30020":71065,"_20858":119859,"_5":14334,"_27317":119513,"_2936":119860},[],"Dispositivo",{"_3450":71200,"_30020":71065,"_20858":119862,"_5":14334,"_27317":119513,"_2936":53362},[],{"_3450":71201,"_30020":71065,"_20858":119864,"_5":14334,"_27317":119513,"_2936":53365},[],{"_3450":71202,"_30020":71065,"_20858":119866,"_5":14334,"_27317":119513,"_2936":119867},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3450":71203,"_30020":71065,"_20858":119869,"_5":14334,"_27317":119513,"_2936":119560},[],{"_3450":71204,"_30020":71065,"_20858":119871,"_5":14334,"_27317":119513,"_2936":53373},[],{"_3450":71205,"_30020":71065,"_20858":119873,"_5":14334,"_27317":119513,"_2936":119874},[],"Certificado",{"_3450":71206,"_30020":71065,"_20858":119876,"_5":14334,"_27317":119513,"_2936":53379},[],{"_3450":71207,"_30020":71065,"_20858":119878,"_5":14334,"_27317":119513,"_2936":119879},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3450":71208,"_30020":71065,"_20858":119881,"_5":14334,"_27317":119513,"_2936":119882},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3450":71209,"_30020":71065,"_20858":119884,"_5":14334,"_27317":119513,"_2936":119572},[],{"_3450":71210,"_30020":71065,"_20858":119886,"_5":14334,"_27317":119513,"_2936":53390},[],{"_3450":71211,"_30020":71065,"_20858":119888,"_5":14334,"_27317":119513,"_2936":119889},[],"Certificado / Dispositivo",{"_3450":71212,"_30020":71065,"_20858":119891,"_5":14334,"_27317":119513,"_2936":53396},[],{"_3450":71213,"_30020":71065,"_20858":119893,"_5":14334,"_27317":119513,"_2936":49406},[],{"_3450":71214,"_30020":71065,"_20858":119895,"_5":14334,"_27317":119513,"_2936":119896},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3450":71215,"_30020":71065,"_20858":119898,"_5":14334,"_27317":119513,"_2936":119580},[],{"_3450":71216,"_30020":71065,"_20858":119900,"_5":14334,"_27317":119517,"_2936":119901},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3450":71217,"_30020":71065,"_20858":119903,"_5":14334,"_27317":119521,"_2936":119904},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3450":71218,"_30020":71065,"_20858":119906,"_5":14334,"_27317":119521,"_2936":119907},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3450":71219,"_30020":71065,"_20858":119909,"_5":14334,"_27317":119525,"_2936":119910},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3450":71220,"_30020":71065,"_20858":119912,"_5":14334,"_27317":119525,"_2936":119913},[],"Transición",{"_3450":71221,"_30020":71065,"_20858":119915,"_5":14334,"_27317":119525,"_2936":119916},[],"Llamadas AWS",{"_3450":71222,"_30020":71065,"_20858":119918,"_5":14334,"_27317":119525,"_2936":119919},[],"`NoRegistrada` → `Solicitada`",{"_3450":71223,"_30020":71065,"_20858":119921,"_5":14334,"_27317":119525,"_2936":119922},[],"ninguna (solo escritura de metadatos)",{"_3450":71224,"_30020":71065,"_20858":119924,"_5":14334,"_27317":119525,"_2936":119925},[],"`Solicitada` → `Registrando`",{"_3450":71225,"_30020":71065,"_20858":119927,"_5":14334,"_27317":119525,"_2936":119928},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3450":71226,"_30020":71065,"_20858":119930,"_5":14334,"_27317":119525,"_2936":119931},[],"`Registrando` → `Completada`",{"_3450":71227,"_30020":71065,"_20858":119933,"_5":14334,"_27317":119525,"_2936":119934},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3450":71228,"_30020":71065,"_20858":119936,"_5":14334,"_27317":119525,"_2936":119937},[],"`Registrando` → `Fallida`",{"_3450":71229,"_30020":71065,"_20858":119939,"_5":14334,"_27317":119525,"_2936":119940},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3450":71230,"_30020":71065,"_20858":119942,"_5":14334,"_27317":119525,"_2936":119943},[],"`Fallida` / `Completada` → `Solicitada`",{"_3450":71231,"_30020":71065,"_20858":119945,"_5":14334,"_27317":119525,"_2936":119946},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3450":71232,"_30020":71065,"_20858":119948,"_5":14334,"_27317":119529,"_2936":119949},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3450":71233,"_30020":71065,"_20858":119951,"_5":14334,"_27317":119529,"_2936":119952},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3450":71234,"_30020":71065,"_20858":119954,"_5":14334,"_27317":119529,"_2936":119955},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3450":71235,"_30020":71065,"_20858":119957,"_5":14334,"_27317":119529,"_2936":119958},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3450":71236,"_30020":71065,"_20858":119960,"_5":14334,"_27317":119529,"_2936":119961},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3450":71237,"_30020":71065,"_20858":119963,"_5":14334,"_27317":119529,"_2936":119964},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3450":71238,"_30020":71065,"_20858":119966,"_5":14334,"_27317":119532,"_2936":119967},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3450":71239,"_30020":71065,"_20858":119969,"_5":14334,"_27317":119535,"_2936":119970},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3450":71240,"_30020":71065,"_20858":119972,"_5":14334,"_27317":119535,"_2936":119973},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3450":71241,"_30020":71065,"_20858":119975,"_5":14334,"_27317":119539,"_2936":119976},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3450":71242,"_30020":71065,"_20858":119978,"_5":14334,"_27317":119543,"_2936":119979},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3450":71243,"_30020":71065,"_20858":119981,"_5":14334,"_27317":119543,"_2936":119982},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3450":71244,"_30020":71065,"_20858":119984,"_5":14334,"_27317":119543,"_2936":119985},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3450":71245,"_30020":71065,"_20858":119987,"_5":14334,"_27317":119543,"_2936":119988},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3450":71246,"_30020":71065,"_20858":119990,"_5":14334,"_27317":119543,"_2936":119991},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3450":71247,"_30020":71065,"_20858":119993,"_5":14334,"_27317":119543,"_2936":119994},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3450":71248,"_30020":71065,"_20858":119996,"_5":14334,"_27317":119547,"_2936":119997},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3450":71249,"_30020":71065,"_20858":119999,"_5":14334,"_27317":119547,"_2936":120000},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3450":71250,"_30020":71065,"_20858":120002,"_5":14334,"_27317":119547,"_2936":120003},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3450":71251,"_30020":71065,"_20858":120005,"_5":14334,"_27317":119547,"_2936":120006},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3450":71252,"_30020":71065,"_20858":120008,"_5":14334,"_27317":119547,"_2936":120009},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3450":71253,"_30020":71065,"_20858":120011,"_5":14334,"_27317":119551,"_2936":120012},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3450":71254,"_30020":71065,"_20858":120014,"_5":14334,"_27317":119551,"_2936":119913},[],{"_3450":71255,"_30020":71065,"_20858":120016,"_5":14334,"_27317":119551,"_2936":119916},[],{"_3450":71256,"_30020":71065,"_20858":120018,"_5":14334,"_27317":119551,"_2936":120019},[],"`SinConfigurar` → `None` / `Auto`",{"_3450":71257,"_30020":71065,"_20858":120021,"_5":14334,"_27317":119551,"_2936":120022},[],"ninguna (solo configuración)",{"_3450":71258,"_30020":71065,"_20858":120024,"_5":14334,"_27317":119551,"_2936":53533},[],{"_3450":71259,"_30020":71065,"_20858":120026,"_5":14334,"_27317":119551,"_2936":120022},[],{"_3450":71260,"_30020":71065,"_20858":120028,"_5":14334,"_27317":119551,"_2936":120029},[],"Cualquiera → `Jitp`",{"_3450":71261,"_30020":71065,"_20858":120031,"_5":14334,"_27317":119551,"_2936":120032},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3450":71262,"_30020":71065,"_20858":120034,"_5":14334,"_27317":119551,"_2936":53544},[],{"_3450":71263,"_30020":71065,"_20858":120036,"_5":14334,"_27317":119551,"_2936":120037},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3450":71264,"_30020":71065,"_20858":120039,"_5":14334,"_27317":119555,"_2936":120040},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3450":71265,"_30020":71065,"_20858":120042,"_5":14334,"_27317":119555,"_2936":120043},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3450":71266,"_30020":71065,"_20858":120045,"_5":14334,"_27317":119555,"_2936":120046},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3450":71267,"_30020":71065,"_20858":120048,"_5":14334,"_27317":119559,"_2936":120049},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3450":71268,"_30020":71065,"_20858":120051,"_5":14334,"_27317":119559,"_2936":119913},[],{"_3450":71269,"_30020":71065,"_20858":120053,"_5":14334,"_27317":119559,"_2936":119916},[],{"_3450":71270,"_30020":71065,"_20858":120055,"_5":14334,"_27317":119559,"_2936":120056},[],"`Ausente` → `Aprovisionado`",{"_3450":71271,"_30020":71065,"_20858":120058,"_5":14334,"_27317":119559,"_2936":120059},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3450":71272,"_30020":71065,"_20858":120061,"_5":14334,"_27317":119559,"_2936":120062},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3450":71273,"_30020":71065,"_20858":120064,"_5":14334,"_27317":119559,"_2936":120065},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3450":71274,"_30020":71065,"_20858":120067,"_5":14334,"_27317":119559,"_2936":120068},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3450":71275,"_30020":71065,"_20858":120070,"_5":14334,"_27317":119563,"_2936":120071},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3450":71276,"_30020":71065,"_20858":120073,"_5":14334,"_27317":119563,"_2936":120074},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3450":71277,"_30020":71065,"_20858":120076,"_5":14334,"_27317":119563,"_2936":120077},[],"Para que el flujo JITP funcione correctamente:",{"_3450":71278,"_30020":71065,"_20858":120079,"_5":14334,"_27317":119563,"_2936":120080},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3450":71279,"_30020":71065,"_20858":120082,"_5":14334,"_27317":119563,"_2936":120083},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3450":71280,"_30020":71065,"_20858":120085,"_5":14334,"_27317":119563,"_2936":120086},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3450":71281,"_30020":71065,"_20858":120088,"_5":14334,"_27317":119563,"_2936":120089},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3450":71282,"_30020":71065,"_20858":120091,"_5":14334,"_27317":119567,"_2936":120092},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3450":71283,"_30020":71065,"_20858":120094,"_5":14334,"_27317":119567,"_2936":120095},[],"Estado en Lamassu",{"_3450":71284,"_30020":71065,"_20858":120097,"_5":14334,"_27317":119567,"_2936":120098},[],"Razón de revocación",{"_3450":71285,"_30020":71065,"_20858":120100,"_5":14334,"_27317":119567,"_2936":120101},[],"Estado en AWS IoT Core",{"_3450":71286,"_30020":71065,"_20858":120103,"_5":14334,"_27317":119567,"_2936":53614},[],{"_3450":71287,"_30020":71065,"_20858":120105,"_5":14334,"_27317":119567,"_2936":120106},[],"Ninguna",{"_3450":71288,"_30020":71065,"_20858":120108,"_5":14334,"_27317":119567,"_2936":53620},[],{"_3450":71289,"_30020":71065,"_20858":120110,"_5":14334,"_27317":119567,"_2936":53623},[],{"_3450":71290,"_30020":71065,"_20858":120112,"_5":14334,"_27317":119567,"_2936":53626},[],{"_3450":71291,"_30020":71065,"_20858":120114,"_5":14334,"_27317":119567,"_2936":53629},[],{"_3450":71292,"_30020":71065,"_20858":120116,"_5":14334,"_27317":119567,"_2936":53623},[],{"_3450":71293,"_30020":71065,"_20858":120118,"_5":14334,"_27317":119567,"_2936":120119},[],"Cualquier otra razón",{"_3450":71294,"_30020":71065,"_20858":120121,"_5":14334,"_27317":119567,"_2936":53637},[],{"_3450":71295,"_30020":71065,"_20858":120123,"_5":14334,"_27317":119567,"_2936":120124},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3450":71296,"_30020":71065,"_20858":120126,"_5":14334,"_27317":119571,"_2936":120127},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3450":71297,"_30020":71065,"_20858":120129,"_5":14334,"_27317":119571,"_2936":119913},[],{"_3450":71298,"_30020":71065,"_20858":120131,"_5":14334,"_27317":119571,"_2936":119916},[],{"_3450":71299,"_30020":71065,"_20858":120133,"_5":14334,"_27317":119571,"_2936":120134},[],"`NoSincronizado` → `Active`",{"_3450":71300,"_30020":71065,"_20858":120136,"_5":14334,"_27317":119571,"_2936":53129},[],{"_3450":71301,"_30020":71065,"_20858":120138,"_5":14334,"_27317":119571,"_2936":53655},[],{"_3450":71302,"_30020":71065,"_20858":120140,"_5":14334,"_27317":119571,"_2936":120141},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3450":71303,"_30020":71065,"_20858":120143,"_5":14334,"_27317":119571,"_2936":53661},[],{"_3450":71304,"_30020":71065,"_20858":120145,"_5":14334,"_27317":119571,"_2936":120141},[],{"_3450":71305,"_30020":71065,"_20858":120147,"_5":14334,"_27317":119571,"_2936":53666},[],{"_3450":71306,"_30020":71065,"_20858":120149,"_5":14334,"_27317":119571,"_2936":53129},[],{"_3450":71307,"_30020":71065,"_20858":120151,"_5":14334,"_27317":119571,"_2936":53671},[],{"_3450":71308,"_30020":71065,"_20858":120153,"_5":14334,"_27317":119571,"_2936":120154},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3450":71309,"_30020":71065,"_20858":120156,"_5":14334,"_27317":119575,"_2936":120157},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3450":71310,"_30020":71065,"_20858":120159,"_5":14334,"_27317":119575,"_2936":120160},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3450":71311,"_30020":71065,"_20858":120162,"_5":14334,"_27317":119575,"_2936":120163},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3450":71312,"_30020":71065,"_20858":120165,"_5":14334,"_27317":119579,"_2936":120166},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3450":71313,"_30020":71065,"_20858":120168,"_5":14334,"_27317":119579,"_2936":120169},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3450":71314,"_30020":71065,"_20858":120171,"_5":14334,"_27317":119583,"_2936":120172},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3450":71315,"_30020":71065,"_20858":120174,"_5":14334,"_27317":119583,"_2936":120175},[],"Existen dos tipos de acciones:",{"_3450":71316,"_30020":71065,"_20858":120177,"_5":14334,"_27317":119583,"_2936":120178},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3450":71317,"_30020":71065,"_20858":120180,"_5":14334,"_27317":119583,"_2936":120181},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3450":71318,"_30020":71065,"_20858":120183,"_5":14334,"_27317":119583,"_2936":120184},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3450":71319,"_30020":71065,"_20858":120186,"_5":14334,"_27317":119587,"_2936":120187},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3450":71320,"_30020":71065,"_20858":120189,"_5":14334,"_27317":119587,"_2936":120190},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3450":71321,"_30020":71065,"_20858":120192,"_5":14334,"_27317":119587,"_2936":120193},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3450":71322,"_30020":71065,"_20858":120195,"_5":14334,"_27317":119591,"_2936":120196},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3450":71323,"_30020":71065,"_20858":120198,"_5":14334,"_27317":119591,"_2936":120199},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3450":71324,"_30020":71065,"_20858":120201,"_5":14334,"_27317":119591,"_2936":120202},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3450":71325,"_30020":71065,"_20858":120204,"_5":14334,"_27317":119591,"_2936":120205},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3450":71326,"_30020":71065,"_20858":120207,"_5":14334,"_27317":119591,"_2936":120208},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3450":71327,"_30020":71065,"_20858":120210,"_5":14334,"_27317":119591,"_2936":120211},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3450":71328,"_30020":71065,"_20858":120213,"_5":14334,"_27317":119591,"_2936":120214},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3450":71329,"_30020":71065,"_20858":120216,"_5":14334,"_27317":119591,"_2936":120217},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3450":71330,"_30020":71065,"_20858":120219,"_5":14334,"_27317":119591,"_2936":120220},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3450":71331,"_30020":71065,"_20858":120222,"_5":14334,"_27317":119591,"_2936":120223},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3450":71332,"_30020":71065,"_20858":120225,"_5":14334,"_27317":119591,"_2936":120226},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3450":71333,"_30020":71065,"_20858":120228,"_5":14334,"_27317":119591,"_2936":120229},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3450":71334,"_30020":71065,"_20858":120231,"_5":14334,"_27317":119591,"_2936":120232},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3450":71335,"_30020":71065,"_20858":120234,"_5":14334,"_27317":119591,"_2936":120235},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3450":71336,"_30020":71065,"_20858":120237,"_5":14334,"_27317":119591,"_2936":120238},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3450":71337,"_30020":71065,"_20858":120240,"_5":14334,"_27317":119591,"_2936":120241},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3450":71338,"_30020":71065,"_20858":120243,"_5":14334,"_27317":119591,"_2936":120244},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3450":71339,"_30020":71065,"_20858":120246,"_5":14334,"_27317":119591,"_2936":120247},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3450":71340,"_30020":71065,"_20858":120249,"_5":14334,"_27317":119591,"_2936":120250},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3450":71341,"_30020":71065,"_20858":120252,"_5":14334,"_27317":119591,"_2936":120253},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3450":71342,"_30020":71065,"_20858":120255,"_5":14334,"_27317":119591,"_2936":120256},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3450":71343,"_30020":71065,"_20858":120258,"_5":14334,"_27317":119591,"_2936":120259},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3450":71344,"_30020":71065,"_20858":120261,"_5":14334,"_27317":119591,"_2936":120262},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3450":71345,"_30020":71065,"_20858":120264,"_5":14334,"_27317":119591,"_2936":120265},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3450":71346,"_30020":71346,"_5":14686,"_2936":51492,"_30373":120267,"_20858":120268,"_27317":71346},[49010,117071,51492],[],{"_3450":71347,"_30020":71346,"_20858":120270,"_5":14334,"_27317":71346,"_2936":120271},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3450":71348,"_30020":71346,"_5":30370,"_20858":120273,"_27317":120274,"_2936":120275},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3450":71349,"_30020":71346,"_5":30370,"_20858":120277,"_27317":120278,"_2936":118083},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3450":71350,"_30020":71346,"_5":30370,"_20858":120280,"_27317":120281,"_2936":118258},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3450":71351,"_30020":71346,"_5":30370,"_20858":120283,"_27317":120284,"_2936":119490},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#integraciones",{"_3450":71352,"_30020":71346,"_5":30370,"_20858":120286,"_27317":120287,"_2936":120288},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3450":71353,"_30020":71346,"_20858":120290,"_5":14334,"_27317":71346,"_2936":120291},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3450":71354,"_30020":71346,"_20858":120293,"_5":14334,"_27317":120274,"_2936":120294},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3450":71355,"_30020":71346,"_20858":120296,"_5":14334,"_27317":120274,"_2936":120297},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3450":71356,"_30020":71346,"_20858":120299,"_5":14334,"_27317":120278,"_2936":120300},[],"Recurso",{"_3450":71357,"_30020":71346,"_20858":120302,"_5":14334,"_27317":120278,"_2936":120303},[],"Qué representa",{"_3450":71358,"_30020":71346,"_20858":120305,"_5":14334,"_27317":120278,"_2936":120306},[],"**Dispositivo**",{"_3450":71359,"_30020":71346,"_20858":120308,"_5":14334,"_27317":120278,"_2936":120309},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3450":71360,"_30020":71346,"_20858":120311,"_5":14334,"_27317":120278,"_2936":120312},[],"**Identidad**",{"_3450":71361,"_30020":71346,"_20858":120314,"_5":14334,"_27317":120278,"_2936":120315},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3450":71362,"_30020":71346,"_20858":120317,"_5":14334,"_27317":120278,"_2936":53838},[],{"_3450":71363,"_30020":71346,"_20858":120319,"_5":14334,"_27317":120278,"_2936":120320},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3450":71364,"_30020":71346,"_20858":120322,"_5":14334,"_27317":120278,"_2936":120323},[],"**Flota**",{"_3450":71365,"_30020":71346,"_20858":120325,"_5":14334,"_27317":120278,"_2936":120326},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3450":71366,"_30020":71346,"_20858":120328,"_5":14334,"_27317":120278,"_2936":120329},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3450":71367,"_30020":71346,"_20858":120331,"_5":14334,"_27317":120278,"_2936":120332},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3450":71368,"_30020":71346,"_20858":120334,"_5":14334,"_27317":120281,"_2936":120335},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3450":71369,"_30020":71346,"_20858":120337,"_5":14334,"_27317":120281,"_2936":120338},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3450":71370,"_30020":71346,"_20858":120340,"_5":14334,"_27317":120281,"_2936":120341},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3450":71371,"_30020":71346,"_20858":120343,"_5":14334,"_27317":120281,"_2936":120344},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3450":71372,"_30020":71346,"_20858":120346,"_5":14334,"_27317":120281,"_2936":120347},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3450":71373,"_30020":71346,"_20858":120349,"_5":14334,"_27317":120281,"_2936":120350},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3450":71374,"_30020":71346,"_20858":120352,"_5":14334,"_27317":120281,"_2936":120353},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3450":71375,"_30020":71346,"_20858":120355,"_5":14334,"_27317":120281,"_2936":120356},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3450":71376,"_30020":71346,"_20858":120358,"_5":14334,"_27317":120284,"_2936":120359},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3450":71377,"_30020":71346,"_20858":120361,"_5":14334,"_27317":120284,"_2936":120362},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3450":71378,"_30020":71346,"_20858":120364,"_5":14334,"_27317":120287,"_2936":120365},[],"Participante",{"_3450":71379,"_30020":71346,"_20858":120367,"_5":14334,"_27317":120287,"_2936":120368},[],"Responsabilidad",{"_3450":71380,"_30020":71346,"_20858":120370,"_5":14334,"_27317":120287,"_2936":120371},[],"Administrador PKI",{"_3450":71381,"_30020":71346,"_20858":120373,"_5":14334,"_27317":120287,"_2936":120374},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3450":71382,"_30020":71346,"_20858":120376,"_5":14334,"_27317":120287,"_2936":120377},[],"Administrador del aprovisionamiento",{"_3450":71383,"_30020":71346,"_20858":120379,"_5":14334,"_27317":120287,"_2936":120380},[],"DMS, admisión, autenticación por operación e inventario.",{"_3450":71384,"_30020":71346,"_20858":120382,"_5":14334,"_27317":120287,"_2936":120383},[],"Integrador del dispositivo",{"_3450":71385,"_30020":71346,"_20858":120385,"_5":14334,"_27317":120287,"_2936":120386},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3450":71386,"_30020":71346,"_20858":120388,"_5":14334,"_27317":120287,"_2936":120389},[],"Integrador del consumidor",{"_3450":71387,"_30020":71346,"_20858":120391,"_5":14334,"_27317":120287,"_2936":120392},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3450":71388,"_30020":71346,"_20858":120394,"_5":14334,"_27317":120287,"_2936":120395},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3450":71389,"_30020":71389,"_5":14686,"_2936":120397,"_30373":120398,"_20858":120400,"_27317":71389},"Enrola y conecta tu primer dispositivo",[49010,117071,51492,120399],"Primeros pasos",[],{"_3450":71390,"_30020":71389,"_20858":120402,"_5":14334,"_27317":71389,"_2936":120403},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3450":71391,"_30020":71389,"_5":30370,"_20858":120405,"_27317":120406,"_2936":115649},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3450":71392,"_30020":71389,"_5":30370,"_20858":120408,"_27317":120409,"_2936":120410},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3450":71393,"_30020":71389,"_5":30370,"_20858":120412,"_27317":120413,"_2936":120414},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3450":71394,"_30020":71389,"_5":30370,"_20858":120416,"_27317":120417,"_2936":120418},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3450":71395,"_30020":71389,"_5":30370,"_20858":120420,"_27317":120421,"_2936":120422},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3450":71396,"_30020":71389,"_5":30370,"_20858":120424,"_27317":120425,"_2936":120426},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3450":71397,"_30020":71389,"_5":30370,"_20858":120428,"_27317":120429,"_2936":120430},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3450":71398,"_30020":71389,"_5":30370,"_20858":120432,"_27317":120433,"_2936":120434},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3450":71399,"_30020":71389,"_20858":120436,"_5":14334,"_27317":71389,"_2936":120437},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3450":71400,"_30020":71389,"_20858":120439,"_5":14334,"_27317":120406,"_2936":120440},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3450":71401,"_30020":71389,"_20858":120442,"_5":14334,"_27317":120406,"_2936":120443},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3450":71402,"_30020":71389,"_20858":120445,"_5":14334,"_27317":120406,"_2936":120446},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3450":71403,"_30020":71389,"_20858":120448,"_5":14334,"_27317":120406,"_2936":120449},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3450":71404,"_30020":71389,"_20858":120451,"_5":14334,"_27317":120406,"_2936":120452},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3450":71405,"_30020":71389,"_20858":120454,"_5":14334,"_27317":120409,"_2936":120455},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3450":71406,"_30020":71389,"_20858":120457,"_5":14334,"_27317":120409,"_2936":120458},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3450":71407,"_30020":71389,"_20858":120460,"_5":14334,"_27317":120413,"_2936":120461},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3450":71408,"_30020":71389,"_20858":120463,"_5":14334,"_27317":120413,"_2936":120464},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3450":71409,"_30020":71389,"_20858":120466,"_5":14334,"_27317":120413,"_2936":120467},[],"Ajuste",{"_3450":71410,"_30020":71389,"_20858":120469,"_5":14334,"_27317":120413,"_2936":120470},[],"Valor de evaluación",{"_3450":71411,"_30020":71389,"_20858":120472,"_5":14334,"_27317":120413,"_2936":53994},[],{"_3450":71412,"_30020":71389,"_20858":120474,"_5":14334,"_27317":120413,"_2936":120475},[],"Raíz emisora de `device-root.pem`.",{"_3450":71413,"_30020":71389,"_20858":120477,"_5":14334,"_27317":120413,"_2936":118386},[],{"_3450":71414,"_30020":71389,"_20858":120479,"_5":14334,"_27317":120413,"_2936":120480},[],"Perfil final de 1 hora que acabas de preparar.",{"_3450":71415,"_30020":71389,"_20858":120482,"_5":14334,"_27317":120413,"_2936":54005},[],{"_3450":71416,"_30020":71389,"_20858":120484,"_5":14334,"_27317":120413,"_2936":54008},[],{"_3450":71417,"_30020":71389,"_20858":120486,"_5":14334,"_27317":120413,"_2936":54011},[],{"_3450":71418,"_30020":71389,"_20858":120488,"_5":14334,"_27317":120413,"_2936":120489},[],"Habilitado.",{"_3450":71419,"_30020":71389,"_20858":120491,"_5":14334,"_27317":120413,"_2936":54017},[],{"_3450":71420,"_30020":71389,"_20858":120493,"_5":14334,"_27317":120413,"_2936":120494},[],"Deshabilitado; el ID debe ser nuevo.",{"_3450":71421,"_30020":71389,"_20858":120496,"_5":14334,"_27317":120413,"_2936":120497},[],"Autenticación inicial",{"_3450":71422,"_30020":71389,"_20858":120499,"_5":14334,"_27317":120413,"_2936":120500},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3450":71423,"_30020":71389,"_20858":120502,"_5":14334,"_27317":120413,"_2936":120503},[],"Autenticación de renovación",{"_3450":71424,"_30020":71389,"_20858":120505,"_5":14334,"_27317":120413,"_2936":120506},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3450":71425,"_30020":71389,"_20858":120508,"_5":14334,"_27317":120413,"_2936":54035},[],{"_3450":71426,"_30020":71389,"_20858":120510,"_5":14334,"_27317":120413,"_2936":120511},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3450":71427,"_30020":71389,"_20858":120513,"_5":14334,"_27317":120413,"_2936":54041},[],{"_3450":71428,"_30020":71389,"_20858":120515,"_5":14334,"_27317":120413,"_2936":120516},[],"1 hora.",{"_3450":71429,"_30020":71389,"_20858":120518,"_5":14334,"_27317":120413,"_2936":54047},[],{"_3450":71430,"_30020":71389,"_20858":120520,"_5":14334,"_27317":120413,"_2936":120521},[],"30 minutos / 10 minutos.",{"_3450":71431,"_30020":71389,"_20858":120523,"_5":14334,"_27317":120413,"_2936":54053},[],{"_3450":71432,"_30020":71389,"_20858":120525,"_5":14334,"_27317":120413,"_2936":120526},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3450":71433,"_30020":71389,"_20858":120528,"_5":14334,"_27317":120413,"_2936":51811},[],{"_3450":71434,"_30020":71389,"_20858":120530,"_5":14334,"_27317":120413,"_2936":120531},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3450":71435,"_30020":71389,"_20858":120533,"_5":14334,"_27317":120413,"_2936":54064},[],{"_3450":71436,"_30020":71389,"_20858":120535,"_5":14334,"_27317":120413,"_2936":120536},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3450":71437,"_30020":71389,"_20858":120538,"_5":14334,"_27317":120413,"_2936":120539},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3450":71438,"_30020":71389,"_20858":120541,"_5":14334,"_27317":120417,"_2936":120542},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3450":71439,"_30020":71389,"_20858":120544,"_5":14334,"_27317":120417,"_2936":120545},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3450":71440,"_30020":71389,"_20858":120547,"_5":14334,"_27317":120421,"_2936":120548},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3450":71441,"_30020":71389,"_20858":120550,"_5":14334,"_27317":120421,"_2936":120551},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3450":71442,"_30020":71389,"_20858":120553,"_5":14334,"_27317":120421,"_2936":120554},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3450":71443,"_30020":71389,"_20858":120556,"_5":14334,"_27317":120425,"_2936":120557},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3450":71444,"_30020":71389,"_20858":120559,"_5":14334,"_27317":120425,"_2936":120560},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3450":71445,"_30020":71389,"_20858":120562,"_5":14334,"_27317":120429,"_2936":120563},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3450":71446,"_30020":71389,"_20858":120565,"_5":14334,"_27317":120429,"_2936":120566},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3450":71447,"_30020":71389,"_20858":120568,"_5":14334,"_27317":120429,"_2936":120569},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3450":71448,"_30020":71389,"_20858":120571,"_5":14334,"_27317":120429,"_2936":120572},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3450":71449,"_30020":71389,"_20858":120574,"_5":14334,"_27317":120429,"_2936":120575},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3450":71450,"_30020":71389,"_20858":120577,"_5":14334,"_27317":120433,"_2936":120578},[],"Comprobación",{"_3450":71451,"_30020":71389,"_20858":120580,"_5":14334,"_27317":120433,"_2936":120581},[],"Resultado esperado",{"_3450":71452,"_30020":71389,"_20858":120583,"_5":14334,"_27317":120433,"_2936":120584},[],"Registro",{"_3450":71453,"_30020":71389,"_20858":120586,"_5":14334,"_27317":120433,"_2936":120587},[],"ID creado automáticamente y DMS correcto.",{"_3450":71454,"_30020":71389,"_20858":120589,"_5":14334,"_27317":120433,"_2936":119874},[],{"_3450":71455,"_30020":71389,"_20858":120591,"_5":14334,"_27317":120433,"_2936":120592},[],"CN, perfil, serie y clave verificados.",{"_3450":71456,"_30020":71389,"_20858":120594,"_5":14334,"_27317":120433,"_2936":120595},[],"Inventario",{"_3450":71457,"_30020":71389,"_20858":120597,"_5":14334,"_27317":120433,"_2936":120598},[],"Serie recibida visible como identidad actual y en el historial.",{"_3450":71458,"_30020":71389,"_20858":120600,"_5":14334,"_27317":120433,"_2936":120601},[],"Consumidor",{"_3450":71459,"_30020":71389,"_20858":120603,"_5":14334,"_27317":120433,"_2936":120604},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3450":71460,"_30020":71389,"_20858":120606,"_5":14334,"_27317":120433,"_2936":120607},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3450":71461,"_30020":71389,"_20858":120609,"_5":14334,"_27317":120433,"_2936":120610},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3450":71462,"_30020":71462,"_5":14686,"_2936":118100,"_30373":120612,"_20858":120613,"_27317":71462},[49010,117071,51492,120399],[],{"_3450":71463,"_30020":71462,"_20858":120615,"_5":14334,"_27317":71462,"_2936":120616},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3450":71464,"_30020":71462,"_5":30370,"_20858":120618,"_27317":120619,"_2936":115649},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3450":71465,"_30020":71462,"_5":30370,"_20858":120621,"_27317":120622,"_2936":120623},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3450":71466,"_30020":71462,"_5":30370,"_20858":120625,"_27317":120626,"_2936":120627},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3450":71467,"_30020":71462,"_5":30370,"_20858":120629,"_27317":120630,"_2936":120631},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3450":71468,"_30020":71462,"_5":30370,"_20858":120633,"_27317":120634,"_2936":120635},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3450":71469,"_30020":71462,"_5":30370,"_20858":120637,"_27317":120638,"_2936":120639},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3450":71470,"_30020":71462,"_5":30370,"_20858":120641,"_27317":120642,"_2936":120581},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3450":71471,"_30020":71462,"_5":30370,"_20858":120644,"_27317":120645,"_2936":120646},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3450":71472,"_30020":71462,"_5":30370,"_20858":120648,"_27317":120649,"_2936":120650},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3450":71473,"_30020":71462,"_20858":120652,"_5":14334,"_27317":71462,"_2936":120653},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3450":71474,"_30020":71462,"_20858":120655,"_5":14334,"_27317":71462,"_2936":120656},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3450":71475,"_30020":71462,"_20858":120658,"_5":14334,"_27317":120619,"_2936":120659},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3450":71476,"_30020":71462,"_20858":120661,"_5":14334,"_27317":120619,"_2936":120662},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3450":71477,"_30020":71462,"_20858":120664,"_5":14334,"_27317":120619,"_2936":120665},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3450":71478,"_30020":71462,"_20858":120667,"_5":14334,"_27317":120619,"_2936":120668},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3450":71479,"_30020":71462,"_20858":120670,"_5":14334,"_27317":120622,"_2936":120671},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3450":71480,"_30020":71462,"_20858":120673,"_5":14334,"_27317":120622,"_2936":120674},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3450":71481,"_30020":71462,"_20858":120676,"_5":14334,"_27317":120622,"_2936":120677},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3450":71482,"_30020":71462,"_20858":120679,"_5":14334,"_27317":120622,"_2936":120680},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3450":71483,"_30020":71462,"_20858":120682,"_5":14334,"_27317":120622,"_2936":120683},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3450":71484,"_30020":71462,"_20858":120685,"_5":14334,"_27317":120622,"_2936":120686},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3450":71485,"_30020":71462,"_20858":120688,"_5":14334,"_27317":120622,"_2936":120689},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3450":71486,"_30020":71462,"_20858":120691,"_5":14334,"_27317":120622,"_2936":120692},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3450":71487,"_30020":71462,"_20858":120694,"_5":14334,"_27317":120626,"_2936":120695},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3450":71488,"_30020":71462,"_20858":120697,"_5":14334,"_27317":120626,"_2936":54229},[],{"_3450":71489,"_30020":71462,"_20858":120699,"_5":14334,"_27317":120626,"_2936":120700},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3450":71490,"_30020":71462,"_20858":120702,"_5":14334,"_27317":120626,"_2936":120703},[],"**Icon** y **Tags**: clasificación opcional.",{"_3450":71491,"_30020":71462,"_20858":120705,"_5":14334,"_27317":120626,"_2936":120706},[],"Confirma el registro.",{"_3450":71492,"_30020":71462,"_20858":120708,"_5":14334,"_27317":120630,"_2936":120709},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3450":71493,"_30020":71462,"_20858":120711,"_5":14334,"_27317":120630,"_2936":120712},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3450":71494,"_30020":71462,"_20858":120714,"_5":14334,"_27317":120634,"_2936":120715},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3450":71495,"_30020":71462,"_20858":120717,"_5":14334,"_27317":120634,"_2936":120718},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3450":71496,"_30020":71462,"_20858":120720,"_5":14334,"_27317":120638,"_2936":120721},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3450":71497,"_30020":71462,"_20858":120723,"_5":14334,"_27317":120638,"_2936":120724},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3450":71498,"_30020":71462,"_20858":120726,"_5":14334,"_27317":120642,"_2936":120578},[],{"_3450":71499,"_30020":71462,"_20858":120728,"_5":14334,"_27317":120642,"_2936":120729},[],"Resultado",{"_3450":71500,"_30020":71462,"_20858":120731,"_5":14334,"_27317":120642,"_2936":119860},[],{"_3450":71501,"_30020":71462,"_20858":120733,"_5":14334,"_27317":120642,"_2936":120734},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3450":71502,"_30020":71462,"_20858":120736,"_5":14334,"_27317":120642,"_2936":120737},[],"Identidad actual",{"_3450":71503,"_30020":71462,"_20858":120739,"_5":14334,"_27317":120642,"_2936":120740},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3450":71504,"_30020":71462,"_20858":120742,"_5":14334,"_27317":120642,"_2936":120743},[],"Historial",{"_3450":71505,"_30020":71462,"_20858":120745,"_5":14334,"_27317":120642,"_2936":120746},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3450":71506,"_30020":71462,"_20858":120748,"_5":14334,"_27317":120642,"_2936":120749},[],"Clave y certificado",{"_3450":71507,"_30020":71462,"_20858":120751,"_5":14334,"_27317":120642,"_2936":120752},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3450":71508,"_30020":71462,"_20858":120754,"_5":14334,"_27317":120645,"_2936":120755},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3450":71509,"_30020":71462,"_20858":120757,"_5":14334,"_27317":120645,"_2936":120758},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3450":71510,"_30020":71462,"_20858":120760,"_5":14334,"_27317":120645,"_2936":120761},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3450":71511,"_30020":71462,"_20858":120763,"_5":14334,"_27317":120645,"_2936":120764},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3450":71512,"_30020":71462,"_20858":120766,"_5":14334,"_27317":120649,"_2936":120767},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3450":71513,"_30020":71462,"_20858":120769,"_5":14334,"_27317":120649,"_2936":120770},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3450":71514,"_30020":71462,"_20858":120772,"_5":14334,"_27317":120649,"_2936":120773},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3450":71515,"_30020":71515,"_5":14686,"_2936":120775,"_30373":120776,"_20858":120777,"_27317":71515},"Plataforma Lamassu IoT",[49010,117071],[],{"_3450":71516,"_30020":71515,"_20858":120779,"_5":14334,"_27317":71515,"_2936":120780},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3450":71517,"_30020":71515,"_5":30370,"_20858":120782,"_27317":120783,"_2936":120275},[],"/docs/pr-preview/pr-60/es/platform/overview#empieza-aquí",{"_3450":71518,"_30020":71515,"_5":30370,"_20858":120785,"_27317":120786,"_2936":120787},[],"/docs/pr-preview/pr-60/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3450":71519,"_30020":71515,"_5":30370,"_20858":120789,"_27317":120790,"_2936":120791},[],"/docs/pr-preview/pr-60/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3450":71520,"_30020":71515,"_5":30370,"_20858":120793,"_27317":120794,"_2936":120795},[],"/docs/pr-preview/pr-60/es/platform/overview#capacidades-principales","Capacidades principales",{"_3450":71521,"_30020":71515,"_5":30370,"_20858":120797,"_27317":120798,"_2936":120799},[],"/docs/pr-preview/pr-60/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3450":71522,"_30020":71515,"_5":30370,"_20858":120801,"_27317":120802,"_2936":120803},[],"/docs/pr-preview/pr-60/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3450":71523,"_30020":71515,"_5":30370,"_20858":120805,"_27317":120806,"_2936":120807},[],"/docs/pr-preview/pr-60/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3450":71524,"_30020":71515,"_5":30370,"_20858":120809,"_27317":120810,"_2936":120811},[],"/docs/pr-preview/pr-60/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3450":71525,"_30020":71515,"_5":30370,"_20858":120813,"_27317":120814,"_2936":120815},[],"/docs/pr-preview/pr-60/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3450":71526,"_30020":71515,"_5":30370,"_20858":120817,"_27317":120818,"_2936":120819},[],"/docs/pr-preview/pr-60/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3450":71527,"_30020":71515,"_5":30370,"_20858":120821,"_27317":120822,"_2936":120823},[],"/docs/pr-preview/pr-60/es/platform/overview#referencia-operativa","Referencia operativa",{"_3450":71528,"_30020":71515,"_20858":120825,"_5":14334,"_27317":71515,"_2936":120826},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3450":71529,"_30020":71515,"_20858":120828,"_5":14334,"_27317":120783,"_2936":120829},[],"Elige el resultado que necesitas obtener:",{"_3450":71530,"_30020":71515,"_20858":120831,"_5":14334,"_27317":120783,"_2936":120832},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3450":71531,"_30020":71515,"_20858":120834,"_5":14334,"_27317":120783,"_2936":120835},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3450":71532,"_30020":71515,"_20858":120837,"_5":14334,"_27317":120783,"_2936":120838},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3450":71533,"_30020":71515,"_20858":120840,"_5":14334,"_27317":120786,"_2936":120841},[],"Bloque",{"_3450":71534,"_30020":71515,"_20858":120843,"_5":14334,"_27317":120786,"_2936":120844},[],"Qué gestionas",{"_3450":71535,"_30020":71515,"_20858":120846,"_5":14334,"_27317":120786,"_2936":120847},[],"Punto de entrada",{"_3450":71536,"_30020":71515,"_20858":120849,"_5":14334,"_27317":120786,"_2936":54382},[],{"_3450":71537,"_30020":71515,"_20858":120851,"_5":14334,"_27317":120786,"_2936":120852},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3450":71538,"_30020":71515,"_20858":120854,"_5":14334,"_27317":120786,"_2936":120855},[],"Visión general de PKI",{"_3450":71539,"_30020":71515,"_20858":120857,"_5":14334,"_27317":120786,"_2936":54391},[],{"_3450":71540,"_30020":71515,"_20858":120859,"_5":14334,"_27317":120786,"_2936":120860},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3450":71541,"_30020":71515,"_20858":120862,"_5":14334,"_27317":120786,"_2936":120863},[],"Visión general de IoT Fleets",{"_3450":71542,"_30020":71515,"_20858":120865,"_5":14334,"_27317":120786,"_2936":120866},[],"**Administración**",{"_3450":71543,"_30020":71515,"_20858":120868,"_5":14334,"_27317":120786,"_2936":120869},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3450":71544,"_30020":71515,"_20858":120871,"_5":14334,"_27317":120786,"_2936":117069},[],{"_3450":71545,"_30020":71515,"_20858":120873,"_5":14334,"_27317":120786,"_2936":120874},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3450":71546,"_30020":71515,"_20858":120876,"_5":14334,"_27317":120790,"_2936":120877},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3450":71547,"_30020":71515,"_20858":120879,"_5":14334,"_27317":120790,"_2936":120880},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3450":71548,"_30020":71515,"_20858":120882,"_5":14334,"_27317":120790,"_2936":120883},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3450":71549,"_30020":71515,"_20858":120885,"_5":14334,"_27317":120790,"_2936":120886},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3450":71550,"_30020":71515,"_20858":120888,"_5":14334,"_27317":120790,"_2936":120889},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3450":71551,"_30020":71515,"_20858":120891,"_5":14334,"_27317":120790,"_2936":120892},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3450":71552,"_30020":71515,"_20858":120894,"_5":14334,"_27317":120798,"_2936":120895},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3450":71553,"_30020":71515,"_20858":120897,"_5":14334,"_27317":120802,"_2936":120898},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3450":71554,"_30020":71515,"_20858":120900,"_5":14334,"_27317":120806,"_2936":120901},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3450":71555,"_30020":71515,"_20858":120903,"_5":14334,"_27317":120810,"_2936":120904},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3450":71556,"_30020":71515,"_20858":120906,"_5":14334,"_27317":120814,"_2936":120907},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3450":71557,"_30020":71515,"_20858":120909,"_5":14334,"_27317":120818,"_2936":120910},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3450":71558,"_30020":71515,"_20858":120912,"_5":14334,"_27317":120822,"_2936":120368},[],{"_3450":71559,"_30020":71515,"_20858":120914,"_5":14334,"_27317":120822,"_2936":120915},[],"Qué prepara o comprueba",{"_3450":71560,"_30020":71515,"_20858":120917,"_5":14334,"_27317":120822,"_2936":120371},[],{"_3450":71561,"_30020":71515,"_20858":120919,"_5":14334,"_27317":120822,"_2936":120920},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3450":71562,"_30020":71515,"_20858":120922,"_5":14334,"_27317":120822,"_2936":120923},[],"Administrador de la flota",{"_3450":71563,"_30020":71515,"_20858":120925,"_5":14334,"_27317":120822,"_2936":120926},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3450":71564,"_30020":71515,"_20858":120928,"_5":14334,"_27317":120822,"_2936":120383},[],{"_3450":71565,"_30020":71515,"_20858":120930,"_5":14334,"_27317":120822,"_2936":120931},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3450":71566,"_30020":71515,"_20858":120933,"_5":14334,"_27317":120822,"_2936":120389},[],{"_3450":71567,"_30020":71515,"_20858":120935,"_5":14334,"_27317":120822,"_2936":120936},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3450":71568,"_30020":71515,"_20858":120938,"_5":14334,"_27317":120822,"_2936":120939},[],"Operador de infraestructura",{"_3450":71569,"_30020":71515,"_20858":120941,"_5":14334,"_27317":120822,"_2936":120942},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3450":71570,"_30020":71515,"_20858":120944,"_5":14334,"_27317":120822,"_2936":120945},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3450":71571,"_30020":71571,"_5":14686,"_2936":120947,"_30373":120948,"_20858":120950,"_27317":71571},"Jerarquía y rotación de CAs",[49010,117071,54483,120949],"Claves, autoridades y certificados",[],{"_3450":71572,"_30020":71571,"_20858":120952,"_5":14334,"_27317":71571,"_2936":120953},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3450":71573,"_30020":71571,"_5":30370,"_20858":120955,"_27317":120956,"_2936":120957},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3450":71574,"_30020":71571,"_5":30370,"_20858":120959,"_27317":120960,"_2936":120961},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3450":71575,"_30020":71571,"_5":30370,"_20858":120963,"_27317":120964,"_2936":120965},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3450":71576,"_30020":71571,"_5":30370,"_20858":120967,"_27317":120968,"_2936":120969},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3450":71577,"_30020":71571,"_5":30370,"_20858":120971,"_27317":120972,"_2936":120973},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3450":71578,"_30020":71571,"_5":30370,"_20858":120975,"_27317":120976,"_2936":120977},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3450":71579,"_30020":71571,"_5":30370,"_20858":120979,"_27317":120980,"_2936":120981},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3450":71580,"_30020":71571,"_5":30370,"_20858":120983,"_27317":120984,"_2936":120985},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3450":71581,"_30020":71571,"_5":30370,"_20858":120987,"_27317":120988,"_2936":120989},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3450":71582,"_30020":71571,"_5":30370,"_20858":120991,"_27317":120992,"_2936":120993},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3450":71583,"_30020":71571,"_5":30370,"_20858":120995,"_27317":120996,"_2936":120997},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3450":71584,"_30020":71571,"_5":30370,"_20858":120999,"_27317":121000,"_2936":121001},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3450":71585,"_30020":71571,"_20858":121003,"_5":14334,"_27317":71571,"_2936":121004},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3450":71586,"_30020":71571,"_20858":121006,"_5":14334,"_27317":71571,"_2936":121007},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3450":71587,"_30020":71571,"_20858":121009,"_5":14334,"_27317":120956,"_2936":121010},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3450":71588,"_30020":71571,"_20858":121012,"_5":14334,"_27317":120956,"_2936":121013},[],"entorno, como producción y preproducción;",{"_3450":71589,"_30020":71571,"_20858":121015,"_5":14334,"_27317":120956,"_2936":121016},[],"propietario o equipo operador;",{"_3450":71590,"_30020":71571,"_20858":121018,"_5":14334,"_27317":120956,"_2936":121019},[],"familia de dispositivos o proceso de fabricación;",{"_3450":71591,"_30020":71571,"_20858":121021,"_5":14334,"_27317":120956,"_2936":121022},[],"región o requisito regulatorio;",{"_3450":71592,"_30020":71571,"_20858":121024,"_5":14334,"_27317":120956,"_2936":121025},[],"motor criptográfico o política de clave;",{"_3450":71593,"_30020":71571,"_20858":121027,"_5":14334,"_27317":120956,"_2936":121028},[],"ventana de mantenimiento y ritmo de renovación.",{"_3450":71594,"_30020":71571,"_20858":121030,"_5":14334,"_27317":120956,"_2936":121031},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3450":71595,"_30020":71571,"_20858":121033,"_5":14334,"_27317":120956,"_2936":121034},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3450":71596,"_30020":71571,"_20858":121036,"_5":14334,"_27317":120960,"_2936":121037},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3450":71597,"_30020":71571,"_20858":121039,"_5":14334,"_27317":120960,"_2936":121040},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3450":71598,"_30020":71571,"_20858":121042,"_5":14334,"_27317":120960,"_2936":121043},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3450":71599,"_30020":71571,"_20858":121045,"_5":14334,"_27317":120960,"_2936":121046},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3450":71600,"_30020":71571,"_20858":121048,"_5":14334,"_27317":120964,"_2936":121049},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3450":71601,"_30020":71571,"_20858":121051,"_5":14334,"_27317":120964,"_2936":121052},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3450":71602,"_30020":71571,"_20858":121054,"_5":14334,"_27317":120964,"_2936":121055},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3450":71603,"_30020":71571,"_20858":121057,"_5":14334,"_27317":120964,"_2936":121058},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3450":71604,"_30020":71571,"_20858":121060,"_5":14334,"_27317":120972,"_2936":121061},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3450":71605,"_30020":71571,"_20858":121063,"_5":14334,"_27317":120976,"_2936":121064},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3450":71606,"_30020":71571,"_20858":121066,"_5":14334,"_27317":120980,"_2936":121067},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3450":71607,"_30020":71571,"_20858":121069,"_5":14334,"_27317":120984,"_2936":121070},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3450":71608,"_30020":71571,"_20858":121072,"_5":14334,"_27317":120988,"_2936":121073},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3450":71609,"_30020":71571,"_20858":121075,"_5":14334,"_27317":120992,"_2936":121076},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3450":71610,"_30020":71571,"_20858":121078,"_5":14334,"_27317":120996,"_2936":121079},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3450":71611,"_30020":71571,"_20858":121081,"_5":14334,"_27317":120996,"_2936":121082},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3450":71612,"_30020":71571,"_20858":121084,"_5":14334,"_27317":120996,"_2936":121085},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3450":71613,"_30020":71571,"_20858":121087,"_5":14334,"_27317":120996,"_2936":121088},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3450":71614,"_30020":71571,"_20858":121090,"_5":14334,"_27317":121000,"_2936":121091},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3450":71615,"_30020":71571,"_20858":121093,"_5":14334,"_27317":121000,"_2936":121094},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3450":71616,"_30020":71571,"_20858":121096,"_5":14334,"_27317":121000,"_2936":121097},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3450":71617,"_30020":71571,"_20858":121099,"_5":14334,"_27317":121000,"_2936":121100},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3450":71618,"_30020":71571,"_20858":121102,"_5":14334,"_27317":121000,"_2936":121103},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3450":71619,"_30020":71571,"_20858":121105,"_5":14334,"_27317":121000,"_2936":121106},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3450":71620,"_30020":71571,"_20858":121108,"_5":14334,"_27317":121000,"_2936":121109},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3450":71621,"_30020":71621,"_5":14686,"_2936":121111,"_30373":121112,"_20858":121113,"_27317":71621},"Autoridades de certificación",[49010,117071,54483,120949],[],{"_3450":71622,"_30020":71621,"_20858":121115,"_5":14334,"_27317":71621,"_2936":121116},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3450":71623,"_30020":71621,"_5":30370,"_20858":121118,"_27317":121119,"_2936":121120},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3450":71624,"_30020":71621,"_5":30370,"_20858":121122,"_27317":121123,"_2936":121124},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3450":71625,"_30020":71621,"_5":30370,"_20858":121126,"_27317":121127,"_2936":115649},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3450":71626,"_30020":71621,"_5":30370,"_20858":121129,"_27317":121130,"_2936":121131},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3450":71627,"_30020":71621,"_5":30370,"_20858":121133,"_27317":121134,"_2936":121135},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3450":71628,"_30020":71621,"_5":30370,"_20858":121137,"_27317":121138,"_2936":121139},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3450":71629,"_30020":71621,"_5":30370,"_20858":121141,"_27317":121142,"_2936":121143},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3450":71630,"_30020":71621,"_5":30370,"_20858":121145,"_27317":121146,"_2936":121147},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3450":71631,"_30020":71621,"_5":30370,"_20858":121149,"_27317":121150,"_2936":121151},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3450":71632,"_30020":71621,"_5":30370,"_20858":121153,"_27317":121154,"_2936":121155},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3450":71633,"_30020":71621,"_5":30370,"_20858":121157,"_27317":121158,"_2936":121159},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3450":71634,"_30020":71621,"_5":30370,"_20858":121161,"_27317":121162,"_2936":121163},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3450":71635,"_30020":71621,"_5":30370,"_20858":121165,"_27317":121166,"_2936":121167},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3450":71636,"_30020":71621,"_5":30370,"_20858":121169,"_27317":121170,"_2936":121171},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3450":71637,"_30020":71621,"_5":30370,"_20858":121173,"_27317":121174,"_2936":121175},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3450":71638,"_30020":71621,"_5":30370,"_20858":121177,"_27317":121178,"_2936":121179},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3450":71639,"_30020":71621,"_5":30370,"_20858":121181,"_27317":121182,"_2936":121183},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3450":71640,"_30020":71621,"_5":30370,"_20858":121185,"_27317":121186,"_2936":121187},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3450":71641,"_30020":71621,"_5":30370,"_20858":121189,"_27317":121190,"_2936":121191},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3450":71642,"_30020":71621,"_5":30370,"_20858":121193,"_27317":121194,"_2936":121195},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3450":71643,"_30020":71621,"_5":30370,"_20858":121197,"_27317":121198,"_2936":121199},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3450":71644,"_30020":71621,"_5":30370,"_20858":121201,"_27317":121202,"_2936":121203},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3450":71645,"_30020":71621,"_5":30370,"_20858":121205,"_27317":121206,"_2936":121207},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3450":71646,"_30020":71621,"_20858":121209,"_5":14334,"_27317":71621,"_2936":121210},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3450":71647,"_30020":71621,"_20858":121212,"_5":14334,"_27317":71621,"_2936":121213},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3450":71648,"_30020":71621,"_20858":121215,"_5":14334,"_27317":71621,"_2936":121216},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3450":71649,"_30020":71621,"_20858":121218,"_5":14334,"_27317":121119,"_2936":121219},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3450":71650,"_30020":71621,"_20858":121221,"_5":14334,"_27317":121119,"_2936":121222},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3450":71651,"_30020":71621,"_20858":121224,"_5":14334,"_27317":121119,"_2936":121225},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3450":71652,"_30020":71621,"_20858":121227,"_5":14334,"_27317":121119,"_2936":121228},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3450":71653,"_30020":71621,"_20858":121230,"_5":14334,"_27317":121119,"_2936":121231},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3450":71654,"_30020":71621,"_20858":121233,"_5":14334,"_27317":121127,"_2936":121234},[],"Decide si la CA será raíz o intermedia.",{"_3450":71655,"_30020":71621,"_20858":121236,"_5":14334,"_27317":121127,"_2936":121237},[],"Elige el motor que custodiará la clave.",{"_3450":71656,"_30020":71621,"_20858":121239,"_5":14334,"_27317":121127,"_2936":121240},[],"Define una validez superior a la de los certificados que emitirá.",{"_3450":71657,"_30020":71621,"_20858":121242,"_5":14334,"_27317":121127,"_2936":121243},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3450":71658,"_30020":71621,"_20858":121245,"_5":14334,"_27317":121130,"_2936":121246},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3450":71659,"_30020":71621,"_20858":121248,"_5":14334,"_27317":121134,"_2936":121249},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3450":71660,"_30020":71621,"_20858":121251,"_5":14334,"_27317":121134,"_2936":121252},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3450":71661,"_30020":71621,"_20858":121254,"_5":14334,"_27317":121138,"_2936":121255},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3450":71662,"_30020":71621,"_20858":121257,"_5":14334,"_27317":121142,"_2936":121258},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3450":71663,"_30020":71621,"_20858":121260,"_5":14334,"_27317":121142,"_2936":121261},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3450":71664,"_30020":71621,"_20858":121263,"_5":14334,"_27317":121142,"_2936":121264},[],"`ST`: estado o provincia.",{"_3450":71665,"_30020":71621,"_20858":121266,"_5":14334,"_27317":121142,"_2936":121267},[],"`L`: localidad.",{"_3450":71666,"_30020":71621,"_20858":121269,"_5":14334,"_27317":121142,"_2936":121270},[],"`O`: organización.",{"_3450":71667,"_30020":71621,"_20858":121272,"_5":14334,"_27317":121142,"_2936":121273},[],"`OU`: unidad organizativa.",{"_3450":71668,"_30020":71621,"_20858":121275,"_5":14334,"_27317":121142,"_2936":121276},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3450":71669,"_30020":71621,"_20858":121278,"_5":14334,"_27317":121146,"_2936":121279},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3450":71670,"_30020":71621,"_20858":121281,"_5":14334,"_27317":121146,"_2936":121282},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3450":71671,"_30020":71621,"_20858":121284,"_5":14334,"_27317":121150,"_2936":121285},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3450":71672,"_30020":71621,"_20858":121287,"_5":14334,"_27317":121150,"_2936":121288},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3450":71673,"_30020":71621,"_20858":121290,"_5":14334,"_27317":121154,"_2936":121291},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3450":71674,"_30020":71621,"_20858":121293,"_5":14334,"_27317":121154,"_2936":121294},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3450":71675,"_30020":71621,"_20858":121296,"_5":14334,"_27317":121158,"_2936":121297},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3450":71676,"_30020":71621,"_20858":121299,"_5":14334,"_27317":121158,"_2936":121300},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3450":71677,"_30020":71621,"_20858":121302,"_5":14334,"_27317":121158,"_2936":121303},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3450":71678,"_30020":71621,"_20858":121305,"_5":14334,"_27317":121162,"_2936":121306},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3450":71679,"_30020":71621,"_20858":121308,"_5":14334,"_27317":121166,"_2936":121309},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3450":71680,"_30020":71621,"_20858":121311,"_5":14334,"_27317":121170,"_2936":121312},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3450":71681,"_30020":71621,"_20858":121314,"_5":14334,"_27317":121174,"_2936":121315},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3450":71682,"_30020":71621,"_20858":121317,"_5":14334,"_27317":121174,"_2936":121318},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3450":71683,"_30020":71621,"_20858":121320,"_5":14334,"_27317":121178,"_2936":121321},[],"Abre una CA desde el inventario para consultar:",{"_3450":71684,"_30020":71621,"_20858":121323,"_5":14334,"_27317":121178,"_2936":121324},[],"Estado y periodo de validez.",{"_3450":71685,"_30020":71621,"_20858":121326,"_5":14334,"_27317":121178,"_2936":121327},[],"Certificado y cadena en formato PEM.",{"_3450":71686,"_30020":71621,"_20858":121329,"_5":14334,"_27317":121178,"_2936":121330},[],"Número de certificados activos, expirados y revocados.",{"_3450":71687,"_30020":71621,"_20858":121332,"_5":14334,"_27317":121178,"_2936":121333},[],"Certificados emitidos en **Issued Certificates**.",{"_3450":71688,"_30020":71621,"_20858":121335,"_5":14334,"_27317":121178,"_2936":121336},[],"CRL vinculada a la autoridad.",{"_3450":71689,"_30020":71621,"_20858":121338,"_5":14334,"_27317":121178,"_2936":121339},[],"Metadatos y motor criptográfico asociado.",{"_3450":71690,"_30020":71621,"_20858":121341,"_5":14334,"_27317":121178,"_2936":121342},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3450":71691,"_30020":71621,"_20858":121344,"_5":14334,"_27317":121182,"_2936":121345},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3450":71692,"_30020":71621,"_20858":121347,"_5":14334,"_27317":121182,"_2936":121348},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3450":71693,"_30020":71621,"_20858":121350,"_5":14334,"_27317":121182,"_2936":121351},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3450":71694,"_30020":71621,"_20858":121353,"_5":14334,"_27317":121182,"_2936":121354},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3450":71695,"_30020":71621,"_20858":121356,"_5":14334,"_27317":121186,"_2936":121357},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3450":71696,"_30020":71621,"_20858":121359,"_5":14334,"_27317":121190,"_2936":121360},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3450":71697,"_30020":71621,"_20858":121362,"_5":14334,"_27317":121194,"_2936":121363},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3450":71698,"_30020":71621,"_20858":121365,"_5":14334,"_27317":121198,"_2936":121366},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3450":71699,"_30020":71621,"_20858":121368,"_5":14334,"_27317":121202,"_2936":121369},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3450":71700,"_30020":71621,"_20858":121371,"_5":14334,"_27317":121206,"_2936":121372},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3450":71701,"_30020":71621,"_20858":121374,"_5":14334,"_27317":121206,"_2936":121375},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3450":71702,"_30020":71621,"_20858":121377,"_5":14334,"_27317":121206,"_2936":121378},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<legacy-ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3450":71703,"_30020":71703,"_5":14686,"_2936":121380,"_30373":121381,"_20858":121382,"_27317":71703},"Perfiles de certificado",[49010,117071,54483,120949],[],{"_3450":71704,"_30020":71703,"_20858":121384,"_5":14334,"_27317":71703,"_2936":121385},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3450":71705,"_30020":71703,"_5":30370,"_20858":121387,"_27317":121388,"_2936":121389},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3450":71706,"_30020":71703,"_5":30370,"_20858":121391,"_27317":121392,"_2936":121393},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#validez","Validez",{"_3450":71707,"_30020":71703,"_5":30370,"_20858":121395,"_27317":121396,"_2936":121397},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3450":71708,"_30020":71703,"_5":30370,"_20858":121399,"_27317":121400,"_2936":121401},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3450":71709,"_30020":71703,"_5":30370,"_20858":121403,"_27317":121404,"_2936":121405},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3450":71710,"_30020":71703,"_5":30370,"_20858":121407,"_27317":121408,"_2936":121409},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3450":71711,"_30020":71703,"_5":30370,"_20858":121411,"_27317":121412,"_2936":121413},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3450":71712,"_30020":71703,"_5":30370,"_20858":121415,"_27317":121416,"_2936":121417},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3450":71713,"_30020":71703,"_5":30370,"_20858":121419,"_27317":121420,"_2936":121421},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3450":71714,"_30020":71703,"_5":30370,"_20858":121423,"_27317":121424,"_2936":121425},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3450":71715,"_30020":71703,"_5":30370,"_20858":121427,"_27317":121428,"_2936":121429},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3450":71716,"_30020":71703,"_5":30370,"_20858":121431,"_27317":121432,"_2936":121433},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3450":71717,"_30020":71703,"_5":30370,"_20858":121435,"_27317":121436,"_2936":121437},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3450":71718,"_30020":71703,"_5":30370,"_20858":121439,"_27317":121440,"_2936":121441},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3450":71719,"_30020":71703,"_5":30370,"_20858":121443,"_27317":121444,"_2936":121445},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3450":71720,"_30020":71703,"_5":30370,"_20858":121447,"_27317":121448,"_2936":121449},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3450":71721,"_30020":71703,"_20858":121451,"_5":14334,"_27317":71703,"_2936":121452},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3450":71722,"_30020":71703,"_20858":121454,"_5":14334,"_27317":71703,"_2936":121455},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3450":71723,"_30020":71703,"_20858":121457,"_5":14334,"_27317":121392,"_2936":121458},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3450":71724,"_30020":71703,"_20858":121460,"_5":14334,"_27317":121392,"_2936":121461},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3450":71725,"_30020":71703,"_20858":121463,"_5":14334,"_27317":121396,"_2936":121464},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3450":71726,"_30020":71703,"_20858":121466,"_5":14334,"_27317":121400,"_2936":121467},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3450":71727,"_30020":71703,"_20858":121469,"_5":14334,"_27317":121400,"_2936":121470},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3450":71728,"_30020":71703,"_20858":121472,"_5":14334,"_27317":121400,"_2936":121473},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3450":71729,"_30020":71703,"_20858":121475,"_5":14334,"_27317":121404,"_2936":121476},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3450":71730,"_30020":71703,"_20858":121478,"_5":14334,"_27317":121408,"_2936":121479},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3450":71731,"_30020":71703,"_20858":121481,"_5":14334,"_27317":121408,"_2936":121482},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3450":71732,"_30020":71703,"_20858":121484,"_5":14334,"_27317":121412,"_2936":121485},[],"La aplicación criptográfica puede:",{"_3450":71733,"_30020":71703,"_20858":121487,"_5":14334,"_27317":121412,"_2936":121488},[],"permitir o bloquear claves RSA;",{"_3450":71734,"_30020":71703,"_20858":121490,"_5":14334,"_27317":121412,"_2936":121491},[],"limitar los tamaños RSA admitidos;",{"_3450":71735,"_30020":71703,"_20858":121493,"_5":14334,"_27317":121412,"_2936":121494},[],"permitir o bloquear claves ECDSA;",{"_3450":71736,"_30020":71703,"_20858":121496,"_5":14334,"_27317":121412,"_2936":121497},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3450":71737,"_30020":71703,"_20858":121499,"_5":14334,"_27317":121412,"_2936":121500},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3450":71738,"_30020":71703,"_20858":121502,"_5":14334,"_27317":121416,"_2936":121503},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3450":71739,"_30020":71703,"_20858":121505,"_5":14334,"_27317":121416,"_2936":116831},[],{"_3450":71740,"_30020":71703,"_20858":121507,"_5":14334,"_27317":121416,"_2936":121508},[],"Primera opción",{"_3450":71741,"_30020":71703,"_20858":121510,"_5":14334,"_27317":121416,"_2936":121511},[],"Segunda opción",{"_3450":71742,"_30020":71703,"_20858":121513,"_5":14334,"_27317":121416,"_2936":121514},[],"Si no hay ninguna",{"_3450":71743,"_30020":71703,"_20858":121516,"_5":14334,"_27317":121416,"_2936":121517},[],"Firma directa con una CA",{"_3450":71744,"_30020":71703,"_20858":121519,"_5":14334,"_27317":121416,"_2936":121520},[],"`issuance_profile` incluido en la solicitud",{"_3450":71745,"_30020":71703,"_20858":121522,"_5":14334,"_27317":121416,"_2936":121523},[],"`issuance_profile_id` de la solicitud",{"_3450":71746,"_30020":71703,"_20858":121525,"_5":14334,"_27317":121416,"_2936":121526},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3450":71747,"_30020":71703,"_20858":121528,"_5":14334,"_27317":121416,"_2936":121529},[],"Emisión mediante DMS",{"_3450":71748,"_30020":71703,"_20858":121531,"_5":14334,"_27317":121416,"_2936":55067},[],{"_3450":71749,"_30020":71703,"_20858":121533,"_5":14334,"_27317":121416,"_2936":121534},[],"`settings.issuance_profile` incluido en el DMS",{"_3450":71750,"_30020":71703,"_20858":121536,"_5":14334,"_27317":121416,"_2936":121537},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3450":71751,"_30020":71703,"_20858":121539,"_5":14334,"_27317":121416,"_2936":121540},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3450":71752,"_30020":71703,"_20858":121542,"_5":14334,"_27317":121416,"_2936":121543},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3450":71753,"_30020":71703,"_20858":121545,"_5":14334,"_27317":121424,"_2936":121546},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3450":71754,"_30020":71703,"_20858":121548,"_5":14334,"_27317":121428,"_2936":121549},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3450":71755,"_30020":71703,"_20858":121551,"_5":14334,"_27317":121432,"_2936":121552},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3450":71756,"_30020":71703,"_20858":121554,"_5":14334,"_27317":121436,"_2936":121555},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3450":71757,"_30020":71703,"_20858":121557,"_5":14334,"_27317":121440,"_2936":121558},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3450":71758,"_30020":71703,"_20858":121560,"_5":14334,"_27317":121440,"_2936":121561},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3450":71759,"_30020":71703,"_20858":121563,"_5":14334,"_27317":121444,"_2936":121564},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3450":71760,"_30020":71703,"_20858":121566,"_5":14334,"_27317":121444,"_2936":121567},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3450":71761,"_30020":71703,"_20858":121569,"_5":14334,"_27317":121444,"_2936":121570},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3450":71762,"_30020":71703,"_20858":121572,"_5":14334,"_27317":121444,"_2936":121573},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3450":71763,"_30020":71703,"_20858":121575,"_5":14334,"_27317":121448,"_2936":121576},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3450":71764,"_30020":71703,"_20858":121578,"_5":14334,"_27317":121448,"_2936":121579},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3450":71765,"_30020":71765,"_5":14686,"_2936":121581,"_30373":121582,"_20858":121584,"_27317":71765},"Validación de certificados",[49010,117071,54483,121583],"Validación",[],{"_3450":71766,"_30020":71765,"_20858":121586,"_5":14334,"_27317":71765,"_2936":121587},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3450":71767,"_30020":71765,"_5":30370,"_20858":121589,"_27317":121590,"_2936":121591},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3450":71768,"_30020":71765,"_5":30370,"_20858":121593,"_27317":121594,"_2936":121595},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3450":71769,"_30020":71765,"_5":30370,"_20858":121597,"_27317":121598,"_2936":121599},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3450":71770,"_30020":71765,"_20858":121601,"_5":14334,"_27317":71765,"_2936":121602},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3450":71771,"_30020":71765,"_20858":121604,"_5":14334,"_27317":121590,"_2936":121605},[],"Verifica estos criterios juntos:",{"_3450":71772,"_30020":71765,"_20858":121607,"_5":14334,"_27317":121590,"_2936":120578},[],{"_3450":71773,"_30020":71765,"_20858":121609,"_5":14334,"_27317":121590,"_2936":121610},[],"Resultado necesario",{"_3450":71774,"_30020":71765,"_20858":121612,"_5":14334,"_27317":121590,"_2936":121613},[],"Cadena y firma",{"_3450":71775,"_30020":71765,"_20858":121615,"_5":14334,"_27317":121590,"_2936":121616},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3450":71776,"_30020":71765,"_20858":121618,"_5":14334,"_27317":121590,"_2936":121619},[],"Fechas",{"_3450":71777,"_30020":71765,"_20858":121621,"_5":14334,"_27317":121590,"_2936":121622},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3450":71778,"_30020":71765,"_20858":121624,"_5":14334,"_27317":121590,"_2936":116741},[],{"_3450":71779,"_30020":71765,"_20858":121626,"_5":14334,"_27317":121590,"_2936":121627},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3450":71780,"_30020":71765,"_20858":121629,"_5":14334,"_27317":121590,"_2936":121630},[],"Uso",{"_3450":71781,"_30020":71765,"_20858":121632,"_5":14334,"_27317":121590,"_2936":121633},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3450":71782,"_30020":71765,"_20858":121635,"_5":14334,"_27317":121590,"_2936":121636},[],"Revocación",{"_3450":71783,"_30020":71765,"_20858":121638,"_5":14334,"_27317":121590,"_2936":121639},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3450":71784,"_30020":71765,"_20858":121641,"_5":14334,"_27317":121590,"_2936":121642},[],"Autorización",{"_3450":71785,"_30020":71765,"_20858":121644,"_5":14334,"_27317":121590,"_2936":121645},[],"La aplicación permite la acción a esa identidad.",{"_3450":71786,"_30020":71765,"_20858":121647,"_5":14334,"_27317":121590,"_2936":121648},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3450":71787,"_30020":71765,"_20858":121650,"_5":14334,"_27317":121594,"_2936":121651},[],"Mecanismo",{"_3450":71788,"_30020":71765,"_20858":121653,"_5":14334,"_27317":121594,"_2936":121654},[],"Cuándo utilizarlo",{"_3450":71789,"_30020":71765,"_20858":121656,"_5":14334,"_27317":121594,"_2936":121657},[],"Qué debes mantener",{"_3450":71790,"_30020":71765,"_20858":121659,"_5":14334,"_27317":121594,"_2936":55195},[],{"_3450":71791,"_30020":71765,"_20858":121661,"_5":14334,"_27317":121594,"_2936":121662},[],"Consulta del estado de un certificado concreto.",{"_3450":71792,"_30020":71765,"_20858":121664,"_5":14334,"_27317":121594,"_2936":121665},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3450":71793,"_30020":71765,"_20858":121667,"_5":14334,"_27317":121594,"_2936":55204},[],{"_3450":71794,"_30020":71765,"_20858":121669,"_5":14334,"_27317":121594,"_2936":121670},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3450":71795,"_30020":71765,"_20858":121672,"_5":14334,"_27317":121594,"_2936":121673},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3450":71796,"_30020":71765,"_20858":121675,"_5":14334,"_27317":121594,"_2936":121676},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3450":71797,"_30020":71765,"_20858":121678,"_5":14334,"_27317":121594,"_2936":121679},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3450":71798,"_30020":71765,"_20858":121681,"_5":14334,"_27317":121598,"_2936":121682},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3450":71799,"_30020":71765,"_20858":121684,"_5":14334,"_27317":121598,"_2936":121685},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3450":71800,"_30020":71765,"_20858":121687,"_5":14334,"_27317":121598,"_2936":121688},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3450":71801,"_30020":71765,"_20858":121690,"_5":14334,"_27317":121598,"_2936":121691},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3450":71802,"_30020":71765,"_20858":121693,"_5":14334,"_27317":121598,"_2936":121694},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3450":71803,"_30020":71765,"_20858":121696,"_5":14334,"_27317":121598,"_2936":121697},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3450":71804,"_30020":71765,"_20858":121699,"_5":14334,"_27317":121598,"_2936":121700},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3450":71805,"_30020":71765,"_20858":121702,"_5":14334,"_27317":121598,"_2936":121703},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3450":71806,"_30020":71765,"_20858":121705,"_5":14334,"_27317":121598,"_2936":121706},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3450":71807,"_30020":71807,"_5":14686,"_2936":121708,"_30373":121709,"_20858":121710,"_27317":71807},"Certificados",[49010,117071,54483,120949],[],{"_3450":71808,"_30020":71807,"_20858":121712,"_5":14334,"_27317":71807,"_2936":121713},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3450":71809,"_30020":71807,"_5":30370,"_20858":121715,"_27317":121716,"_2936":121717},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3450":71810,"_30020":71807,"_5":30370,"_20858":121719,"_27317":121720,"_2936":121721},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3450":71811,"_30020":71807,"_5":30370,"_20858":121723,"_27317":121724,"_2936":121725},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3450":71812,"_30020":71807,"_5":30370,"_20858":121727,"_27317":121728,"_2936":121729},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3450":71813,"_30020":71807,"_5":30370,"_20858":121731,"_27317":121732,"_2936":121733},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3450":71814,"_30020":71807,"_5":30370,"_20858":121735,"_27317":121736,"_2936":121737},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3450":71815,"_30020":71807,"_5":30370,"_20858":121739,"_27317":121740,"_2936":121741},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3450":71816,"_30020":71807,"_5":30370,"_20858":121743,"_27317":121744,"_2936":121745},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3450":71817,"_30020":71807,"_5":30370,"_20858":121747,"_27317":121748,"_2936":121749},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#continúa","Continúa",{"_3450":71818,"_30020":71807,"_20858":121751,"_5":14334,"_27317":71807,"_2936":121752},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3450":71819,"_30020":71807,"_20858":121754,"_5":14334,"_27317":121716,"_2936":121755},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3450":71820,"_30020":71807,"_20858":121757,"_5":14334,"_27317":121716,"_2936":121758},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3450":71821,"_30020":71807,"_20858":121760,"_5":14334,"_27317":121716,"_2936":121761},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3450":71822,"_30020":71807,"_20858":121763,"_5":14334,"_27317":121716,"_2936":121764},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3450":71823,"_30020":71807,"_20858":121766,"_5":14334,"_27317":121716,"_2936":121767},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3450":71824,"_30020":71807,"_20858":121769,"_5":14334,"_27317":121716,"_2936":121770},[],"Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`); las listas de certificados pueden filtrarse por `has_private_key`.",{"_3450":71825,"_30020":71807,"_20858":121772,"_5":14334,"_27317":121716,"_2936":121773},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3450":71826,"_30020":71807,"_20858":121775,"_5":14334,"_27317":121720,"_2936":121776},[],"Descarga el PEM e inspecciónalo:",{"_3450":71827,"_30020":71807,"_20858":121778,"_5":14334,"_27317":121720,"_2936":121779},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3450":71828,"_30020":71807,"_20858":121781,"_5":14334,"_27317":121724,"_2936":121782},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3450":71829,"_30020":71807,"_20858":121784,"_5":14334,"_27317":121724,"_2936":121785},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3450":71830,"_30020":71807,"_20858":121787,"_5":14334,"_27317":121724,"_2936":121788},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3450":71831,"_30020":71807,"_20858":121790,"_5":14334,"_27317":121724,"_2936":121791},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3450":71832,"_30020":71807,"_20858":121793,"_5":14334,"_27317":121724,"_2936":121794},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3450":71833,"_30020":71807,"_20858":121796,"_5":14334,"_27317":121724,"_2936":121797},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3450":71834,"_30020":71807,"_20858":121799,"_5":14334,"_27317":121724,"_2936":121800},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3450":71835,"_30020":71807,"_20858":121802,"_5":14334,"_27317":121728,"_2936":121803},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3450":71836,"_30020":71807,"_20858":121805,"_5":14334,"_27317":121732,"_2936":121806},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3450":71837,"_30020":71807,"_20858":121808,"_5":14334,"_27317":121736,"_2936":121809},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3450":71838,"_30020":71807,"_20858":121811,"_5":14334,"_27317":121740,"_2936":121812},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3450":71839,"_30020":71807,"_20858":121814,"_5":14334,"_27317":121740,"_2936":121815},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3450":71840,"_30020":71807,"_20858":121817,"_5":14334,"_27317":121740,"_2936":121818},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3450":71841,"_30020":71807,"_20858":121820,"_5":14334,"_27317":121744,"_2936":121821},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3450":71842,"_30020":71807,"_20858":121823,"_5":14334,"_27317":121744,"_2936":121824},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3450":71843,"_30020":71807,"_20858":121826,"_5":14334,"_27317":121744,"_2936":121827},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3450":71844,"_30020":71807,"_20858":121829,"_5":14334,"_27317":121748,"_2936":121830},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3450":71845,"_30020":71807,"_20858":121832,"_5":14334,"_27317":121748,"_2936":121833},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3450":71846,"_30020":71846,"_5":14686,"_2936":121835,"_30373":121836,"_20858":121838,"_27317":71846},"Ciclo de vida de un certificado",[49010,117071,54483,121837],"Conceptos",[],{"_3450":71847,"_30020":71846,"_20858":121840,"_5":14334,"_27317":71846,"_2936":121841},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3450":71848,"_30020":71846,"_5":30370,"_20858":121843,"_27317":121844,"_2936":121845},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3450":71849,"_30020":71846,"_5":30370,"_20858":121847,"_27317":121848,"_2936":121849},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3450":71850,"_30020":71846,"_5":30370,"_20858":121851,"_27317":121852,"_2936":121853},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3450":71851,"_30020":71846,"_5":30370,"_20858":121855,"_27317":121856,"_2936":121857},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3450":71852,"_30020":71846,"_5":30370,"_20858":121859,"_27317":121860,"_2936":121861},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3450":71853,"_30020":71846,"_5":30370,"_20858":121863,"_27317":121864,"_2936":121865},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3450":71854,"_30020":71846,"_5":30370,"_20858":121867,"_27317":121868,"_2936":119572},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3450":71855,"_30020":71846,"_5":30370,"_20858":121870,"_27317":121871,"_2936":121872},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3450":71856,"_30020":71846,"_5":30370,"_20858":121874,"_27317":121875,"_2936":121876},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3450":71857,"_30020":71846,"_5":30370,"_20858":121878,"_27317":121879,"_2936":121880},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3450":71858,"_30020":71846,"_20858":121882,"_5":14334,"_27317":71846,"_2936":121883},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3450":71859,"_30020":71846,"_20858":121885,"_5":14334,"_27317":121848,"_2936":121886},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3450":71860,"_30020":71846,"_20858":121888,"_5":14334,"_27317":121852,"_2936":121889},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3450":71861,"_30020":71846,"_20858":121891,"_5":14334,"_27317":121856,"_2936":121892},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3450":71862,"_30020":71846,"_20858":121894,"_5":14334,"_27317":121860,"_2936":121895},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3450":71863,"_30020":71846,"_20858":121897,"_5":14334,"_27317":121864,"_2936":121898},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3450":71864,"_30020":71846,"_20858":121900,"_5":14334,"_27317":121868,"_2936":121901},[],"Lamassu persiste cuatro estados X.509:",{"_3450":71865,"_30020":71846,"_20858":121903,"_5":14334,"_27317":121868,"_2936":121904},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3450":71866,"_30020":71846,"_20858":121906,"_5":14334,"_27317":121868,"_2936":121907},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3450":71867,"_30020":71846,"_20858":121909,"_5":14334,"_27317":121868,"_2936":121910},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3450":71868,"_30020":71846,"_20858":121912,"_5":14334,"_27317":121868,"_2936":121913},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3450":71869,"_30020":71846,"_20858":121915,"_5":14334,"_27317":121868,"_2936":121916},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3450":71870,"_30020":71846,"_20858":121918,"_5":14334,"_27317":121871,"_2936":121919},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3450":71871,"_30020":71846,"_20858":121921,"_5":14334,"_27317":121871,"_2936":121922},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3450":71872,"_30020":71846,"_20858":121924,"_5":14334,"_27317":121871,"_2936":121925},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3450":71873,"_30020":71846,"_20858":121927,"_5":14334,"_27317":121875,"_2936":121928},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3450":71874,"_30020":71846,"_20858":121930,"_5":14334,"_27317":121875,"_2936":121931},[],"Antes de confirmar:",{"_3450":71875,"_30020":71846,"_20858":121933,"_5":14334,"_27317":121875,"_2936":121934},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3450":71876,"_30020":71846,"_20858":121936,"_5":14334,"_27317":121875,"_2936":121937},[],"Distribuye la nueva cadena de confianza.",{"_3450":71877,"_30020":71846,"_20858":121939,"_5":14334,"_27317":121875,"_2936":121940},[],"Reemite las identidades necesarias.",{"_3450":71878,"_30020":71846,"_20858":121942,"_5":14334,"_27317":121875,"_2936":121943},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3450":71879,"_30020":71846,"_20858":121945,"_5":14334,"_27317":121875,"_2936":121946},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3450":71880,"_30020":71846,"_20858":121948,"_5":14334,"_27317":121875,"_2936":121949},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3450":71881,"_30020":71846,"_20858":121951,"_5":14334,"_27317":121879,"_2936":121952},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3450":71882,"_30020":71846,"_20858":121954,"_5":14334,"_27317":121879,"_2936":121955},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3450":71883,"_30020":71846,"_20858":121957,"_5":14334,"_27317":121879,"_2936":121958},[],"Cambios de estado y razones de revocación.",{"_3450":71884,"_30020":71846,"_20858":121960,"_5":14334,"_27317":121879,"_2936":121961},[],"Publicación y vigencia de OCSP y CRLs.",{"_3450":71885,"_30020":71846,"_20858":121963,"_5":14334,"_27317":121879,"_2936":121964},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3450":71886,"_30020":71846,"_20858":121966,"_5":14334,"_27317":121879,"_2936":121967},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3450":71887,"_30020":71887,"_5":14686,"_2936":121969,"_30373":121970,"_20858":121971,"_27317":71887},"Modelo de confianza",[49010,117071,54483,121837],[],{"_3450":71888,"_30020":71887,"_20858":121973,"_5":14334,"_27317":71887,"_2936":121974},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3450":71889,"_30020":71887,"_5":30370,"_20858":121976,"_27317":121977,"_2936":121978},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3450":71890,"_30020":71887,"_5":30370,"_20858":121980,"_27317":121981,"_2936":121982},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3450":71891,"_30020":71887,"_5":30370,"_20858":121984,"_27317":121985,"_2936":121986},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3450":71892,"_30020":71887,"_5":30370,"_20858":121988,"_27317":121989,"_2936":121990},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3450":71893,"_30020":71887,"_5":30370,"_20858":121992,"_27317":121993,"_2936":121994},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3450":71894,"_30020":71887,"_5":30370,"_20858":121996,"_27317":121997,"_2936":121998},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3450":71895,"_30020":71887,"_5":30370,"_20858":122000,"_27317":122001,"_2936":122002},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3450":71896,"_30020":71887,"_5":30370,"_20858":122004,"_27317":122005,"_2936":122006},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3450":71897,"_30020":71887,"_5":30370,"_20858":122008,"_27317":122009,"_2936":122010},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3450":71898,"_30020":71887,"_5":30370,"_20858":122012,"_27317":122013,"_2936":122014},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3450":71899,"_30020":71887,"_20858":122016,"_5":14334,"_27317":71887,"_2936":122017},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3450":71900,"_30020":71887,"_20858":122019,"_5":14334,"_27317":121981,"_2936":122020},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3450":71901,"_30020":71887,"_20858":122022,"_5":14334,"_27317":121985,"_2936":122023},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3450":71902,"_30020":71887,"_20858":122025,"_5":14334,"_27317":121989,"_2936":122026},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3450":71903,"_30020":71887,"_20858":122028,"_5":14334,"_27317":121993,"_2936":122029},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3450":71904,"_30020":71887,"_20858":122031,"_5":14334,"_27317":121997,"_2936":122032},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3450":71905,"_30020":71887,"_20858":122034,"_5":14334,"_27317":121997,"_2936":122035},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3450":71906,"_30020":71887,"_20858":122037,"_5":14334,"_27317":121997,"_2936":122038},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3450":71907,"_30020":71887,"_20858":122040,"_5":14334,"_27317":121997,"_2936":122041},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3450":71908,"_30020":71887,"_20858":122043,"_5":14334,"_27317":121997,"_2936":122044},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3450":71909,"_30020":71887,"_20858":122046,"_5":14334,"_27317":121997,"_2936":122047},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3450":71910,"_30020":71887,"_20858":122049,"_5":14334,"_27317":122001,"_2936":122050},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3450":71911,"_30020":71887,"_20858":122052,"_5":14334,"_27317":122001,"_2936":122053},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3450":71912,"_30020":71887,"_20858":122055,"_5":14334,"_27317":122001,"_2936":122056},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3450":71913,"_30020":71887,"_20858":122058,"_5":14334,"_27317":122001,"_2936":122059},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3450":71914,"_30020":71887,"_20858":122061,"_5":14334,"_27317":122001,"_2936":122062},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3450":71915,"_30020":71887,"_20858":122064,"_5":14334,"_27317":122005,"_2936":122065},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3450":71916,"_30020":71887,"_20858":122067,"_5":14334,"_27317":122005,"_2936":122068},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3450":71917,"_30020":71887,"_20858":122070,"_5":14334,"_27317":122005,"_2936":122071},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3450":71918,"_30020":71887,"_20858":122073,"_5":14334,"_27317":122005,"_2936":122074},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3450":71919,"_30020":71887,"_20858":122076,"_5":14334,"_27317":122005,"_2936":122077},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3450":71920,"_30020":71887,"_20858":122079,"_5":14334,"_27317":122005,"_2936":122080},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3450":71921,"_30020":71887,"_20858":122082,"_5":14334,"_27317":122005,"_2936":122083},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3450":71922,"_30020":71887,"_20858":122085,"_5":14334,"_27317":122009,"_2936":122086},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3450":71923,"_30020":71887,"_20858":122088,"_5":14334,"_27317":122013,"_2936":122089},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3450":71924,"_30020":71887,"_20858":122091,"_5":14334,"_27317":122013,"_2936":122092},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3450":71925,"_30020":71887,"_20858":122094,"_5":14334,"_27317":122013,"_2936":122095},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3450":71926,"_30020":71887,"_20858":122097,"_5":14334,"_27317":122013,"_2936":122098},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3450":71927,"_30020":71887,"_20858":122100,"_5":14334,"_27317":122013,"_2936":122101},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3450":71928,"_30020":71887,"_20858":122103,"_5":14334,"_27317":122013,"_2936":122104},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3450":71929,"_30020":71887,"_20858":122106,"_5":14334,"_27317":122013,"_2936":122107},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3450":71930,"_30020":71930,"_5":14686,"_2936":122109,"_30373":122110,"_20858":122111,"_27317":71930},"Listas de revocación (CRL)",[49010,117071,54483,121583],[],{"_3450":71931,"_30020":71930,"_20858":122113,"_5":14334,"_27317":71930,"_2936":122114},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3450":71932,"_30020":71930,"_5":30370,"_20858":122116,"_27317":122117,"_2936":122118},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3450":71933,"_30020":71930,"_5":30370,"_20858":122120,"_27317":122121,"_2936":122122},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3450":71934,"_30020":71930,"_5":30370,"_20858":122124,"_27317":122125,"_2936":122126},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3450":71935,"_30020":71930,"_5":30370,"_20858":122128,"_27317":122129,"_2936":122130},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3450":71936,"_30020":71930,"_5":30370,"_20858":122132,"_27317":122133,"_2936":122134},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3450":71937,"_30020":71930,"_5":30370,"_20858":122136,"_27317":122137,"_2936":122138},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3450":71938,"_30020":71930,"_5":30370,"_20858":122140,"_27317":122141,"_2936":122142},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3450":71939,"_30020":71930,"_5":30370,"_20858":122144,"_27317":122145,"_2936":122146},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3450":71940,"_30020":71930,"_5":30370,"_20858":122148,"_27317":122149,"_2936":122150},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#referencias","Referencias",{"_3450":71941,"_30020":71930,"_20858":122152,"_5":14334,"_27317":71930,"_2936":122153},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3450":71942,"_30020":71930,"_20858":122155,"_5":14334,"_27317":122117,"_2936":122156},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3450":71943,"_30020":71930,"_20858":122158,"_5":14334,"_27317":122117,"_2936":122159},[],"Campo",{"_3450":71944,"_30020":71930,"_20858":122161,"_5":14334,"_27317":122117,"_2936":118612},[],{"_3450":71945,"_30020":71930,"_20858":122163,"_5":14334,"_27317":122117,"_2936":55702},[],{"_3450":71946,"_30020":71930,"_20858":122165,"_5":14334,"_27317":122117,"_2936":122166},[],"ID de la CA a la que pertenecen los ajustes.",{"_3450":71947,"_30020":71930,"_20858":122168,"_5":14334,"_27317":122117,"_2936":55708},[],{"_3450":71948,"_30020":71930,"_20858":122170,"_5":14334,"_27317":122117,"_2936":122171},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3450":71949,"_30020":71930,"_20858":122173,"_5":14334,"_27317":122117,"_2936":55714},[],{"_3450":71950,"_30020":71930,"_20858":122175,"_5":14334,"_27317":122117,"_2936":122176},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3450":71951,"_30020":71930,"_20858":122178,"_5":14334,"_27317":122117,"_2936":55720},[],{"_3450":71952,"_30020":71930,"_20858":122180,"_5":14334,"_27317":122117,"_2936":122181},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3450":71953,"_30020":71930,"_20858":122183,"_5":14334,"_27317":122117,"_2936":122184},[],"Campo de `crl_options`",{"_3450":71954,"_30020":71930,"_20858":122186,"_5":14334,"_27317":122117,"_2936":118612},[],{"_3450":71955,"_30020":71930,"_20858":122188,"_5":14334,"_27317":122117,"_2936":122189},[],"Valor inicial",{"_3450":71956,"_30020":71930,"_20858":122191,"_5":14334,"_27317":122117,"_2936":55734},[],{"_3450":71957,"_30020":71930,"_20858":122193,"_5":14334,"_27317":122117,"_2936":122194},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3450":71958,"_30020":71930,"_20858":122196,"_5":14334,"_27317":122117,"_2936":122197},[],"7 días.",{"_3450":71959,"_30020":71930,"_20858":122199,"_5":14334,"_27317":122117,"_2936":55743},[],{"_3450":71960,"_30020":71930,"_20858":122201,"_5":14334,"_27317":122117,"_2936":122202},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador (consulta Regeneración periódica y automática).",{"_3450":71961,"_30020":71930,"_20858":122204,"_5":14334,"_27317":122117,"_2936":122205},[],"6 días y 23 horas.",{"_3450":71962,"_30020":71930,"_20858":122207,"_5":14334,"_27317":122117,"_2936":55752},[],{"_3450":71963,"_30020":71930,"_20858":122209,"_5":14334,"_27317":122117,"_2936":122210},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3450":71964,"_30020":71930,"_20858":122212,"_5":14334,"_27317":122117,"_2936":55758},[],{"_3450":71965,"_30020":71930,"_20858":122214,"_5":14334,"_27317":122117,"_2936":55761},[],{"_3450":71966,"_30020":71930,"_20858":122216,"_5":14334,"_27317":122117,"_2936":122217},[],"Número de serie del certificado existente que firma la CRL.",{"_3450":71967,"_30020":71930,"_20858":122219,"_5":14334,"_27317":122117,"_2936":122220},[],"Número de serie del certificado actual de la CA.",{"_3450":71968,"_30020":71930,"_20858":122222,"_5":14334,"_27317":122117,"_2936":122223},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3450":71969,"_30020":71930,"_20858":122225,"_5":14334,"_27317":122117,"_2936":122226},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen, y para retirarlo actualizas el firmante con `PUT`.",{"_3450":71970,"_30020":71930,"_20858":122228,"_5":14334,"_27317":122117,"_2936":122229},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni cambiar su firmante (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3450":71971,"_30020":71930,"_20858":122231,"_5":14334,"_27317":122117,"_2936":122232},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3450":71972,"_30020":71930,"_20858":122234,"_5":14334,"_27317":122117,"_2936":122235},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3450":71973,"_30020":71930,"_20858":122237,"_5":14334,"_27317":122117,"_2936":122238},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3450":71974,"_30020":71930,"_20858":122240,"_5":14334,"_27317":122117,"_2936":122241},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3450":71975,"_30020":71930,"_20858":122243,"_5":14334,"_27317":122117,"_2936":122244},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3450":71976,"_30020":71930,"_20858":122246,"_5":14334,"_27317":122117,"_2936":122247},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3450":71977,"_30020":71930,"_20858":122249,"_5":14334,"_27317":122117,"_2936":122250},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3450":71978,"_30020":71930,"_20858":122252,"_5":14334,"_27317":122121,"_2936":122253},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3450":71979,"_30020":71930,"_20858":122255,"_5":14334,"_27317":122121,"_2936":122256},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. La lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas.",{"_3450":71980,"_30020":71930,"_20858":122258,"_5":14334,"_27317":122121,"_2936":122259},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3450":71981,"_30020":71930,"_20858":122261,"_5":14334,"_27317":122121,"_2936":122262},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3450":71982,"_30020":71930,"_20858":122264,"_5":14334,"_27317":122125,"_2936":122265},[],"El trabajo programado de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3450":71983,"_30020":71930,"_20858":122267,"_5":14334,"_27317":122125,"_2936":122268},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3450":71984,"_30020":71930,"_20858":122270,"_5":14334,"_27317":122125,"_2936":122271},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3450":71985,"_30020":71930,"_20858":122273,"_5":14334,"_27317":122125,"_2936":122274},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`.",{"_3450":71986,"_30020":71930,"_20858":122276,"_5":14334,"_27317":122125,"_2936":122277},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3450":71987,"_30020":71930,"_20858":122279,"_5":14334,"_27317":122125,"_2936":122280},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3450":71988,"_30020":71930,"_20858":122282,"_5":14334,"_27317":122125,"_2936":122283},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3450":71989,"_30020":71930,"_20858":122285,"_5":14334,"_27317":122125,"_2936":122286},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3450":71990,"_30020":71930,"_20858":122288,"_5":14334,"_27317":122125,"_2936":122289},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3450":71991,"_30020":71930,"_20858":122291,"_5":14334,"_27317":122129,"_2936":122292},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3450":71992,"_30020":71930,"_20858":122294,"_5":14334,"_27317":122129,"_2936":122295},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3450":71993,"_30020":71930,"_20858":122297,"_5":14334,"_27317":122133,"_2936":122298},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3450":71994,"_30020":71930,"_20858":122300,"_5":14334,"_27317":122133,"_2936":122301},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3450":71995,"_30020":71930,"_20858":122303,"_5":14334,"_27317":122133,"_2936":122304},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3450":71996,"_30020":71930,"_20858":122306,"_5":14334,"_27317":122133,"_2936":122307},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3450":71997,"_30020":71930,"_20858":122309,"_5":14334,"_27317":122133,"_2936":122310},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3450":71998,"_30020":71930,"_20858":122312,"_5":14334,"_27317":122137,"_2936":122313},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3450":71999,"_30020":71930,"_20858":122315,"_5":14334,"_27317":122137,"_2936":118801},[],{"_3450":72000,"_30020":71930,"_20858":122317,"_5":14334,"_27317":122137,"_2936":122318},[],"Path relativo",{"_3450":72001,"_30020":71930,"_20858":122320,"_5":14334,"_27317":122137,"_2936":116831},[],{"_3450":72002,"_30020":71930,"_20858":122322,"_5":14334,"_27317":122137,"_2936":55870},[],{"_3450":72003,"_30020":71930,"_20858":122324,"_5":14334,"_27317":122137,"_2936":55873},[],{"_3450":72004,"_30020":71930,"_20858":122326,"_5":14334,"_27317":122137,"_2936":122327},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3450":72005,"_30020":71930,"_20858":122329,"_5":14334,"_27317":122137,"_2936":55870},[],{"_3450":72006,"_30020":71930,"_20858":122331,"_5":14334,"_27317":122137,"_2936":55881},[],{"_3450":72007,"_30020":71930,"_20858":122333,"_5":14334,"_27317":122137,"_2936":122334},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3450":72008,"_30020":71930,"_20858":122336,"_5":14334,"_27317":122137,"_2936":55887},[],{"_3450":72009,"_30020":71930,"_20858":122338,"_5":14334,"_27317":122137,"_2936":55881},[],{"_3450":72010,"_30020":71930,"_20858":122340,"_5":14334,"_27317":122137,"_2936":122341},[],"Sustituir la configuración de CRL de una CA.",{"_3450":72011,"_30020":71930,"_20858":122343,"_5":14334,"_27317":122137,"_2936":122344},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3450":72012,"_30020":71930,"_20858":122346,"_5":14334,"_27317":122137,"_2936":122347},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3450":72013,"_30020":71930,"_20858":122349,"_5":14334,"_27317":122141,"_2936":122350},[],"Síntoma",{"_3450":72014,"_30020":71930,"_20858":122352,"_5":14334,"_27317":122141,"_2936":122353},[],"Causa",{"_3450":72015,"_30020":71930,"_20858":122355,"_5":14334,"_27317":122141,"_2936":122356},[],"Acción",{"_3450":72016,"_30020":71930,"_20858":122358,"_5":14334,"_27317":122141,"_2936":122359},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3450":72017,"_30020":71930,"_20858":122361,"_5":14334,"_27317":122141,"_2936":122362},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3450":72018,"_30020":71930,"_20858":122364,"_5":14334,"_27317":122141,"_2936":122365},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3450":72019,"_30020":71930,"_20858":122367,"_5":14334,"_27317":122141,"_2936":122368},[],"`PUT` devuelve 400.",{"_3450":72020,"_30020":71930,"_20858":122370,"_5":14334,"_27317":122141,"_2936":122371},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3450":72021,"_30020":71930,"_20858":122373,"_5":14334,"_27317":122141,"_2936":122374},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3450":72022,"_30020":71930,"_20858":122376,"_5":14334,"_27317":122141,"_2936":122377},[],"`PUT` devuelve 404.",{"_3450":72023,"_30020":71930,"_20858":122379,"_5":14334,"_27317":122141,"_2936":122380},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3450":72024,"_30020":71930,"_20858":122382,"_5":14334,"_27317":122141,"_2936":122383},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3450":72025,"_30020":71930,"_20858":122385,"_5":14334,"_27317":122141,"_2936":122386},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3450":72026,"_30020":71930,"_20858":122388,"_5":14334,"_27317":122141,"_2936":122389},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3450":72027,"_30020":71930,"_20858":122391,"_5":14334,"_27317":122141,"_2936":122392},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3450":72028,"_30020":71930,"_20858":122394,"_5":14334,"_27317":122141,"_2936":122395},[],"La CRL no cambia tras revocar un certificado.",{"_3450":72029,"_30020":71930,"_20858":122397,"_5":14334,"_27317":122141,"_2936":122398},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3450":72030,"_30020":71930,"_20858":122400,"_5":14334,"_27317":122141,"_2936":122401},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3450":72031,"_30020":71930,"_20858":122403,"_5":14334,"_27317":122141,"_2936":122404},[],"Un verificador rechaza la CRL por el emisor.",{"_3450":72032,"_30020":71930,"_20858":122406,"_5":14334,"_27317":122141,"_2936":122407},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3450":72033,"_30020":71930,"_20858":122409,"_5":14334,"_27317":122141,"_2936":122410},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3450":72034,"_30020":71930,"_20858":122412,"_5":14334,"_27317":122145,"_2936":122413},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3450":72035,"_30020":71930,"_20858":122415,"_5":14334,"_27317":122149,"_2936":122416},[],"RFC 5280: perfil X.509 y CRL.",{"_3450":72036,"_30020":71930,"_20858":122418,"_5":14334,"_27317":122149,"_2936":55970},[],{"_3450":72037,"_30020":71930,"_20858":122420,"_5":14334,"_27317":122149,"_2936":55973},[],{"_3450":72038,"_30020":71930,"_20858":122422,"_5":14334,"_27317":122149,"_2936":122423},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3450":72039,"_30020":71930,"_20858":122425,"_5":14334,"_27317":122149,"_2936":122426},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3450":72040,"_30020":72040,"_5":14686,"_2936":122428,"_30373":122429,"_20858":122430,"_27317":72040},"Claves y motores criptográficos",[49010,117071,54483,120949],[],{"_3450":72041,"_30020":72040,"_20858":122432,"_5":14334,"_27317":72040,"_2936":122433},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3450":72042,"_30020":72040,"_5":30370,"_20858":122435,"_27317":122436,"_2936":122437},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3450":72043,"_30020":72040,"_5":30370,"_20858":122439,"_27317":122440,"_2936":122441},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3450":72044,"_30020":72040,"_5":30370,"_20858":122443,"_27317":122444,"_2936":55998},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#file-system",{"_3450":72045,"_30020":72040,"_5":30370,"_20858":122446,"_27317":122447,"_2936":56002},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#hashicorp-vault",{"_3450":72046,"_30020":72040,"_5":30370,"_20858":122449,"_27317":122450,"_2936":56006},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#aws-secrets-manager",{"_3450":72047,"_30020":72040,"_5":30370,"_20858":122452,"_27317":122453,"_2936":56010},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#aws-kms",{"_3450":72048,"_30020":72040,"_5":30370,"_20858":122455,"_27317":122456,"_2936":56014},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#pkcs11",{"_3450":72049,"_30020":72040,"_5":30370,"_20858":122458,"_27317":122459,"_2936":56018},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#azure-key-vault",{"_3450":72050,"_30020":72040,"_5":30370,"_20858":122461,"_27317":122462,"_2936":122463},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3450":72051,"_30020":72040,"_5":30370,"_20858":122465,"_27317":122466,"_2936":122467},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3450":72052,"_30020":72040,"_5":30370,"_20858":122469,"_27317":122470,"_2936":122471},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3450":72053,"_30020":72040,"_5":30370,"_20858":122473,"_27317":122474,"_2936":122475},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3450":72054,"_30020":72040,"_5":30370,"_20858":122477,"_27317":122478,"_2936":122479},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3450":72055,"_30020":72040,"_5":30370,"_20858":122481,"_27317":122482,"_2936":122483},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3450":72056,"_30020":72040,"_5":30370,"_20858":122485,"_27317":122486,"_2936":122487},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3450":72057,"_30020":72040,"_5":30370,"_20858":122489,"_27317":122490,"_2936":56050},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#sign",{"_3450":72058,"_30020":72040,"_5":30370,"_20858":122492,"_27317":122493,"_2936":56054},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#verify",{"_3450":72059,"_30020":72040,"_5":30370,"_20858":122495,"_27317":122496,"_2936":122497},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3450":72060,"_30020":72040,"_5":30370,"_20858":122499,"_27317":122500,"_2936":122501},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3450":72061,"_30020":72040,"_5":30370,"_20858":122503,"_27317":122504,"_2936":122505},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3450":72062,"_30020":72040,"_20858":122507,"_5":14334,"_27317":72040,"_2936":122508},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3450":72063,"_30020":72040,"_20858":122510,"_5":14334,"_27317":72040,"_2936":122511},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3450":72064,"_30020":72040,"_20858":122513,"_5":14334,"_27317":122436,"_2936":122514},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3450":72065,"_30020":72040,"_20858":122516,"_5":14334,"_27317":122436,"_2936":122517},[],"En la práctica, permite:",{"_3450":72066,"_30020":72040,"_20858":122519,"_5":14334,"_27317":122436,"_2936":122520},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3450":72067,"_30020":72040,"_20858":122522,"_5":14334,"_27317":122436,"_2936":122523},[],"Importar claves creadas externamente.",{"_3450":72068,"_30020":72040,"_20858":122525,"_5":14334,"_27317":122436,"_2936":122526},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3450":72069,"_30020":72040,"_20858":122528,"_5":14334,"_27317":122436,"_2936":122529},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3450":72070,"_30020":72040,"_20858":122531,"_5":14334,"_27317":122440,"_2936":122532},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3450":72071,"_30020":72040,"_20858":122534,"_5":14334,"_27317":122440,"_2936":122535},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3450":72072,"_30020":72040,"_20858":122537,"_5":14334,"_27317":122440,"_2936":122538},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3450":72073,"_30020":72040,"_20858":122540,"_5":14334,"_27317":122444,"_2936":122541},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3450":72074,"_30020":72040,"_20858":122543,"_5":14334,"_27317":122447,"_2936":122544},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3450":72075,"_30020":72040,"_20858":122546,"_5":14334,"_27317":122447,"_2936":122547},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3450":72076,"_30020":72040,"_20858":122549,"_5":14334,"_27317":122450,"_2936":122550},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3450":72077,"_30020":72040,"_20858":122552,"_5":14334,"_27317":122453,"_2936":122553},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3450":72078,"_30020":72040,"_20858":122555,"_5":14334,"_27317":122456,"_2936":122556},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3450":72079,"_30020":72040,"_20858":122558,"_5":14334,"_27317":122459,"_2936":122559},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3450":72080,"_30020":72040,"_20858":122561,"_5":14334,"_27317":122459,"_2936":122562},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3450":72081,"_30020":72040,"_20858":122564,"_5":14334,"_27317":122459,"_2936":122565},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3450":72082,"_30020":72040,"_20858":122567,"_5":14334,"_27317":122459,"_2936":122568},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3450":72083,"_30020":72040,"_20858":122570,"_5":14334,"_27317":122462,"_2936":122571},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3450":72084,"_30020":72040,"_20858":122573,"_5":14334,"_27317":122462,"_2936":122574},[],"La tabla incluye los siguientes campos:",{"_3450":72085,"_30020":72040,"_20858":122576,"_5":14334,"_27317":122462,"_2936":122577},[],"**Name**: nombre descriptivo de la clave.",{"_3450":72086,"_30020":72040,"_20858":122579,"_5":14334,"_27317":122462,"_2936":122580},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3450":72087,"_30020":72040,"_20858":122582,"_5":14334,"_27317":122462,"_2936":122583},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3450":72088,"_30020":72040,"_20858":122585,"_5":14334,"_27317":122462,"_2936":122586},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3450":72089,"_30020":72040,"_20858":122588,"_5":14334,"_27317":122462,"_2936":122589},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3450":72090,"_30020":72040,"_20858":122591,"_5":14334,"_27317":122462,"_2936":122592},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3450":72091,"_30020":72040,"_20858":122594,"_5":14334,"_27317":122462,"_2936":122595},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3450":72092,"_30020":72040,"_20858":122597,"_5":14334,"_27317":122462,"_2936":122598},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3450":72093,"_30020":72040,"_20858":122600,"_5":14334,"_27317":122462,"_2936":122601},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3450":72094,"_30020":72040,"_20858":122603,"_5":14334,"_27317":122462,"_2936":122604},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3450":72095,"_30020":72040,"_20858":122606,"_5":14334,"_27317":122462,"_2936":122607},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3450":72096,"_30020":72040,"_20858":122609,"_5":14334,"_27317":122462,"_2936":122610},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3450":72097,"_30020":72040,"_20858":122612,"_5":14334,"_27317":122462,"_2936":122613},[],"**Delete Key** para eliminar la clave del sistema.",{"_3450":72098,"_30020":72040,"_20858":122615,"_5":14334,"_27317":122466,"_2936":122616},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3450":72099,"_30020":72040,"_20858":122618,"_5":14334,"_27317":122470,"_2936":122619},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3450":72100,"_30020":72040,"_20858":122621,"_5":14334,"_27317":122470,"_2936":122622},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3450":72101,"_30020":72040,"_20858":122624,"_5":14334,"_27317":122470,"_2936":122625},[],"**Key Name**: nombre único y descriptivo.",{"_3450":72102,"_30020":72040,"_20858":122627,"_5":14334,"_27317":122470,"_2936":122628},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3450":72103,"_30020":72040,"_20858":122630,"_5":14334,"_27317":122470,"_2936":122631},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3450":72104,"_30020":72040,"_20858":122633,"_5":14334,"_27317":122470,"_2936":122634},[],"**Tags**: metadatos para clasificar la clave.",{"_3450":72105,"_30020":72040,"_20858":122636,"_5":14334,"_27317":122470,"_2936":122637},[],"**Metadata**: información adicional para usos avanzados.",{"_3450":72106,"_30020":72040,"_20858":122639,"_5":14334,"_27317":122474,"_2936":122640},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3450":72107,"_30020":72040,"_20858":122642,"_5":14334,"_27317":122474,"_2936":122643},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3450":72108,"_30020":72040,"_20858":122645,"_5":14334,"_27317":122474,"_2936":122646},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3450":72109,"_30020":72040,"_20858":122648,"_5":14334,"_27317":122474,"_2936":122649},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3450":72110,"_30020":72040,"_20858":122651,"_5":14334,"_27317":122474,"_2936":122652},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3450":72111,"_30020":72040,"_20858":122654,"_5":14334,"_27317":122474,"_2936":122655},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3450":72112,"_30020":72040,"_20858":122657,"_5":14334,"_27317":122474,"_2936":122658},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3450":72113,"_30020":72040,"_20858":122660,"_5":14334,"_27317":122474,"_2936":122661},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3450":72114,"_30020":72040,"_20858":122663,"_5":14334,"_27317":122474,"_2936":122664},[],"**Metadata**: información adicional opcional.",{"_3450":72115,"_30020":72040,"_20858":122666,"_5":14334,"_27317":122474,"_2936":122667},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3450":72116,"_30020":72040,"_20858":122669,"_5":14334,"_27317":122474,"_2936":122670},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3450":72117,"_30020":72040,"_20858":122672,"_5":14334,"_27317":122478,"_2936":122673},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3450":72118,"_30020":72040,"_20858":122675,"_5":14334,"_27317":122482,"_2936":122676},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3450":72119,"_30020":72040,"_20858":122678,"_5":14334,"_27317":122482,"_2936":122679},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3450":72120,"_30020":72040,"_20858":122681,"_5":14334,"_27317":122482,"_2936":122682},[],"**Key Name**: nombre descriptivo.",{"_3450":72121,"_30020":72040,"_20858":122684,"_5":14334,"_27317":122482,"_2936":122685},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3450":72122,"_30020":72040,"_20858":122687,"_5":14334,"_27317":122482,"_2936":122688},[],"**Tags**: etiquetas asociadas.",{"_3450":72123,"_30020":72040,"_20858":122690,"_5":14334,"_27317":122482,"_2936":122691},[],"**Aliases**: nombres alternativos.",{"_3450":72124,"_30020":72040,"_20858":122693,"_5":14334,"_27317":122482,"_2936":122694},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3450":72125,"_30020":72040,"_20858":122696,"_5":14334,"_27317":122482,"_2936":122697},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3450":72126,"_30020":72040,"_20858":122699,"_5":14334,"_27317":122482,"_2936":122700},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3450":72127,"_30020":72040,"_20858":122702,"_5":14334,"_27317":122482,"_2936":122703},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3450":72128,"_30020":72040,"_20858":122705,"_5":14334,"_27317":122486,"_2936":122706},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3450":72129,"_30020":72040,"_20858":122708,"_5":14334,"_27317":122486,"_2936":122709},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3450":72130,"_30020":72040,"_20858":122711,"_5":14334,"_27317":122486,"_2936":122712},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3450":72131,"_30020":72040,"_20858":122714,"_5":14334,"_27317":122490,"_2936":122715},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3450":72132,"_30020":72040,"_20858":122717,"_5":14334,"_27317":122490,"_2936":122718},[],"Campos principales:",{"_3450":72133,"_30020":72040,"_20858":122720,"_5":14334,"_27317":122490,"_2936":122721},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3450":72134,"_30020":72040,"_20858":122723,"_5":14334,"_27317":122490,"_2936":122724},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3450":72135,"_30020":72040,"_20858":122726,"_5":14334,"_27317":122490,"_2936":122727},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3450":72136,"_30020":72040,"_20858":122729,"_5":14334,"_27317":122490,"_2936":122730},[],"**Message**: contenido que se va a firmar.",{"_3450":72137,"_30020":72040,"_20858":122732,"_5":14334,"_27317":122490,"_2936":122733},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3450":72138,"_30020":72040,"_20858":122735,"_5":14334,"_27317":122493,"_2936":122736},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3450":72139,"_30020":72040,"_20858":122738,"_5":14334,"_27317":122493,"_2936":122718},[],{"_3450":72140,"_30020":72040,"_20858":122740,"_5":14334,"_27317":122493,"_2936":122741},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3450":72141,"_30020":72040,"_20858":122743,"_5":14334,"_27317":122493,"_2936":122744},[],"**Message Type**: `Raw` o `Digest`.",{"_3450":72142,"_30020":72040,"_20858":122746,"_5":14334,"_27317":122493,"_2936":122747},[],"**Payload Encoding**: codificación del mensaje.",{"_3450":72143,"_30020":72040,"_20858":122749,"_5":14334,"_27317":122493,"_2936":122750},[],"**Message**: mensaje original o hash.",{"_3450":72144,"_30020":72040,"_20858":122752,"_5":14334,"_27317":122493,"_2936":122753},[],"**Signature**: firma que se desea comprobar.",{"_3450":72145,"_30020":72040,"_20858":122755,"_5":14334,"_27317":122493,"_2936":122756},[],"**Result**: indicador del resultado de la validación.",{"_3450":72146,"_30020":72040,"_20858":122758,"_5":14334,"_27317":122496,"_2936":122759},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3450":72147,"_30020":72040,"_20858":122761,"_5":14334,"_27317":122496,"_2936":122762},[],"Este flujo es útil para:",{"_3450":72148,"_30020":72040,"_20858":122764,"_5":14334,"_27317":122496,"_2936":122765},[],"Solicitar certificados a una CA externa.",{"_3450":72149,"_30020":72040,"_20858":122767,"_5":14334,"_27317":122496,"_2936":122768},[],"Renovar una identidad manteniendo la misma clave.",{"_3450":72150,"_30020":72040,"_20858":122770,"_5":14334,"_27317":122496,"_2936":122771},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3450":72151,"_30020":72040,"_20858":122773,"_5":14334,"_27317":122496,"_2936":122774},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3450":72152,"_30020":72040,"_20858":122776,"_5":14334,"_27317":122496,"_2936":122777},[],"**Organization (O)**: organización o empresa.",{"_3450":72153,"_30020":72040,"_20858":122779,"_5":14334,"_27317":122496,"_2936":122780},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3450":72154,"_30020":72040,"_20858":122782,"_5":14334,"_27317":122496,"_2936":122783},[],"**Country (C)**: código de país de dos letras.",{"_3450":72155,"_30020":72040,"_20858":122785,"_5":14334,"_27317":122496,"_2936":122786},[],"**State / Province (ST)**: estado o provincia.",{"_3450":72156,"_30020":72040,"_20858":122788,"_5":14334,"_27317":122496,"_2936":122789},[],"**Locality (L)**: ciudad o localidad.",{"_3450":72157,"_30020":72040,"_20858":122791,"_5":14334,"_27317":122496,"_2936":122792},[],"**Email Address**: correo de contacto.",{"_3450":72158,"_30020":72040,"_20858":122794,"_5":14334,"_27317":122496,"_2936":122795},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3450":72159,"_30020":72040,"_20858":122797,"_5":14334,"_27317":122496,"_2936":122798},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3450":72160,"_30020":72040,"_20858":122800,"_5":14334,"_27317":122500,"_2936":122801},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3450":72161,"_30020":72040,"_20858":122803,"_5":14334,"_27317":122500,"_2936":122804},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3450":72162,"_30020":72040,"_20858":122806,"_5":14334,"_27317":122504,"_2936":122807},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3450":72163,"_30020":72040,"_20858":122809,"_5":14334,"_27317":122504,"_2936":122810},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3450":72164,"_30020":72164,"_5":14686,"_2936":122812,"_30373":122813,"_20858":122814,"_27317":72164},"Validación online con OCSP",[49010,117071,54483,121583],[],{"_3450":72165,"_30020":72164,"_20858":122816,"_5":14334,"_27317":72164,"_2936":122817},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3450":72166,"_30020":72164,"_5":30370,"_20858":122819,"_27317":122820,"_2936":122821},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3450":72167,"_30020":72164,"_5":30370,"_20858":122823,"_27317":122824,"_2936":122825},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3450":72168,"_30020":72164,"_5":30370,"_20858":122827,"_27317":122828,"_2936":122829},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3450":72169,"_30020":72164,"_5":30370,"_20858":122831,"_27317":122832,"_2936":122833},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3450":72170,"_30020":72164,"_5":30370,"_20858":122835,"_27317":122836,"_2936":122837},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3450":72171,"_30020":72164,"_5":30370,"_20858":122839,"_27317":122840,"_2936":122150},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#referencias",{"_3450":72172,"_30020":72164,"_20858":122842,"_5":14334,"_27317":72164,"_2936":122843},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3450":72173,"_30020":72164,"_20858":122845,"_5":14334,"_27317":122820,"_2936":122846},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3450":72174,"_30020":72164,"_20858":122848,"_5":14334,"_27317":122820,"_2936":122849},[],"Estado del registro",{"_3450":72175,"_30020":72164,"_20858":122851,"_5":14334,"_27317":122820,"_2936":122852},[],"Respuesta firmada",{"_3450":72176,"_30020":72164,"_20858":122854,"_5":14334,"_27317":122820,"_2936":53620},[],{"_3450":72177,"_30020":72164,"_20858":122856,"_5":14334,"_27317":122820,"_2936":56418},[],{"_3450":72178,"_30020":72164,"_20858":122858,"_5":14334,"_27317":122820,"_2936":53637},[],{"_3450":72179,"_30020":72164,"_20858":122860,"_5":14334,"_27317":122820,"_2936":122861},[],"`Revoked`, con razón y fecha de revocación.",{"_3450":72180,"_30020":72164,"_20858":122863,"_5":14334,"_27317":122820,"_2936":122864},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3450":72181,"_30020":72164,"_20858":122866,"_5":14334,"_27317":122820,"_2936":122867},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3450":72182,"_30020":72164,"_20858":122869,"_5":14334,"_27317":122820,"_2936":122870},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3450":72183,"_30020":72164,"_20858":122872,"_5":14334,"_27317":122820,"_2936":122873},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3450":72184,"_30020":72164,"_20858":122875,"_5":14334,"_27317":122820,"_2936":122876},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3450":72185,"_30020":72164,"_20858":122878,"_5":14334,"_27317":122824,"_2936":122879},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3450":72186,"_30020":72164,"_20858":122881,"_5":14334,"_27317":122824,"_2936":122882},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3450":72187,"_30020":72164,"_20858":122884,"_5":14334,"_27317":122828,"_2936":122885},[],"El servicio acepta:",{"_3450":72188,"_30020":72164,"_20858":122887,"_5":14334,"_27317":122828,"_2936":118801},[],{"_3450":72189,"_30020":72164,"_20858":122889,"_5":14334,"_27317":122828,"_2936":122890},[],"Ruta del servicio VA",{"_3450":72190,"_30020":72164,"_20858":122892,"_5":14334,"_27317":122828,"_2936":122893},[],"Formato",{"_3450":72191,"_30020":72164,"_20858":122895,"_5":14334,"_27317":122828,"_2936":56458},[],{"_3450":72192,"_30020":72164,"_20858":122897,"_5":14334,"_27317":122828,"_2936":56461},[],{"_3450":72193,"_30020":72164,"_20858":122899,"_5":14334,"_27317":122828,"_2936":122900},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3450":72194,"_30020":72164,"_20858":122902,"_5":14334,"_27317":122828,"_2936":55870},[],{"_3450":72195,"_30020":72164,"_20858":122904,"_5":14334,"_27317":122828,"_2936":56469},[],{"_3450":72196,"_30020":72164,"_20858":122906,"_5":14334,"_27317":122828,"_2936":122907},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3450":72197,"_30020":72164,"_20858":122909,"_5":14334,"_27317":122828,"_2936":122910},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3450":72198,"_30020":72164,"_20858":122912,"_5":14334,"_27317":122832,"_2936":122913},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3450":72199,"_30020":72164,"_20858":122915,"_5":14334,"_27317":122832,"_2936":122916},[],"Genera la solicitud:",{"_3450":72200,"_30020":72164,"_20858":122918,"_5":14334,"_27317":122832,"_2936":122919},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3450":72201,"_30020":72164,"_20858":122921,"_5":14334,"_27317":122832,"_2936":122922},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3450":72202,"_30020":72164,"_20858":122924,"_5":14334,"_27317":122832,"_2936":122925},[],"Verifica el DER recibido:",{"_3450":72203,"_30020":72164,"_20858":122927,"_5":14334,"_27317":122832,"_2936":122928},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3450":72204,"_30020":72164,"_20858":122930,"_5":14334,"_27317":122836,"_2936":122931},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3450":72205,"_30020":72164,"_20858":122933,"_5":14334,"_27317":122836,"_2936":122934},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3450":72206,"_30020":72164,"_20858":122936,"_5":14334,"_27317":122840,"_2936":56502},[],{"_3450":72207,"_30020":72164,"_20858":122938,"_5":14334,"_27317":122840,"_2936":56505},[],{"_3450":72208,"_30020":72164,"_20858":122940,"_5":14334,"_27317":122840,"_2936":122941},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3450":72209,"_30020":72164,"_20858":122943,"_5":14334,"_27317":122840,"_2936":122426},[],{"_3450":72210,"_30020":72210,"_5":14686,"_2936":54483,"_30373":122945,"_20858":122946,"_27317":72210},[49010,117071,54483],[],{"_3450":72211,"_30020":72210,"_20858":122948,"_5":14334,"_27317":72210,"_2936":122949},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3450":72212,"_30020":72210,"_5":30370,"_20858":122951,"_27317":122952,"_2936":120275},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#empieza-aquí",{"_3450":72213,"_30020":72210,"_5":30370,"_20858":122954,"_27317":122955,"_2936":122956},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3450":72214,"_30020":72210,"_5":30370,"_20858":122958,"_27317":122959,"_2936":120795},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#capacidades-principales",{"_3450":72215,"_30020":72210,"_5":30370,"_20858":122961,"_27317":122962,"_2936":120799},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3450":72216,"_30020":72210,"_5":30370,"_20858":122964,"_27317":122965,"_2936":120803},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3450":72217,"_30020":72210,"_5":30370,"_20858":122967,"_27317":122968,"_2936":120807},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#emite-y-controla-certificados",{"_3450":72218,"_30020":72210,"_5":30370,"_20858":122970,"_27317":122971,"_2936":120815},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#publica-el-estado-de-validación",{"_3450":72219,"_30020":72210,"_5":30370,"_20858":122973,"_27317":122974,"_2936":122975},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3450":72220,"_30020":72210,"_5":30370,"_20858":122977,"_27317":122978,"_2936":121749},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#continúa",{"_3450":72221,"_30020":72210,"_20858":122980,"_5":14334,"_27317":72210,"_2936":122981},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3450":72222,"_30020":72210,"_20858":122983,"_5":14334,"_27317":122952,"_2936":122984},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3450":72223,"_30020":72210,"_20858":122986,"_5":14334,"_27317":122952,"_2936":122987},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3450":72224,"_30020":72210,"_20858":122989,"_5":14334,"_27317":122955,"_2936":122990},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3450":72225,"_30020":72210,"_20858":122992,"_5":14334,"_27317":122955,"_2936":122993},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3450":72226,"_30020":72210,"_20858":122995,"_5":14334,"_27317":122955,"_2936":122996},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3450":72227,"_30020":72210,"_20858":122998,"_5":14334,"_27317":122955,"_2936":122999},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3450":72228,"_30020":72210,"_20858":123001,"_5":14334,"_27317":122955,"_2936":123002},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3450":72229,"_30020":72210,"_20858":123004,"_5":14334,"_27317":122962,"_2936":123005},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3450":72230,"_30020":72210,"_20858":123007,"_5":14334,"_27317":122965,"_2936":123008},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3450":72231,"_30020":72210,"_20858":123010,"_5":14334,"_27317":122968,"_2936":123011},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3450":72232,"_30020":72210,"_20858":123013,"_5":14334,"_27317":122971,"_2936":123014},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3450":72233,"_30020":72210,"_20858":123016,"_5":14334,"_27317":122974,"_2936":123017},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3450":72234,"_30020":72210,"_20858":123019,"_5":14334,"_27317":122974,"_2936":123020},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3450":72235,"_30020":72210,"_20858":123022,"_5":14334,"_27317":122974,"_2936":123023},[],"su clave pública corresponda a la clave privada del cliente;",{"_3450":72236,"_30020":72210,"_20858":123025,"_5":14334,"_27317":122974,"_2936":123026},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3450":72237,"_30020":72210,"_20858":123028,"_5":14334,"_27317":122974,"_2936":123029},[],"sus fechas y usos permitan la operación;",{"_3450":72238,"_30020":72210,"_20858":123031,"_5":14334,"_27317":122974,"_2936":123032},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3450":72239,"_30020":72210,"_20858":123034,"_5":14334,"_27317":122974,"_2936":123035},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3450":72240,"_30020":72210,"_20858":123037,"_5":14334,"_27317":122978,"_2936":123038},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3450":72241,"_30020":72210,"_20858":123040,"_5":14334,"_27317":122978,"_2936":123041},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3450":72242,"_30020":72210,"_20858":123043,"_5":14334,"_27317":122978,"_2936":123044},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3450":72243,"_30020":72243,"_5":14686,"_2936":123046,"_30373":123047,"_20858":123048,"_27317":72243},"Crea tu primera CA",[49010,117071,54483,120399],[],{"_3450":72244,"_30020":72243,"_20858":123050,"_5":14334,"_27317":72243,"_2936":123051},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3450":72245,"_30020":72243,"_5":30370,"_20858":123053,"_27317":123054,"_2936":115649},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3450":72246,"_30020":72243,"_5":30370,"_20858":123056,"_27317":123057,"_2936":123058},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3450":72247,"_30020":72243,"_5":30370,"_20858":123060,"_27317":123061,"_2936":123062},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3450":72248,"_30020":72243,"_5":30370,"_20858":123064,"_27317":123065,"_2936":123066},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3450":72249,"_30020":72243,"_5":30370,"_20858":123068,"_27317":123069,"_2936":123070},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3450":72250,"_30020":72243,"_5":30370,"_20858":123072,"_27317":123073,"_2936":123074},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3450":72251,"_30020":72243,"_5":30370,"_20858":123076,"_27317":123077,"_2936":123078},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3450":72252,"_30020":72243,"_5":30370,"_20858":123080,"_27317":123081,"_2936":120646},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3450":72253,"_30020":72243,"_5":30370,"_20858":123083,"_27317":123084,"_2936":115673},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3450":72254,"_30020":72243,"_20858":123086,"_5":14334,"_27317":72243,"_2936":123087},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3450":72255,"_30020":72243,"_20858":123089,"_5":14334,"_27317":123054,"_2936":123090},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3450":72256,"_30020":72243,"_20858":123092,"_5":14334,"_27317":123054,"_2936":123093},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3450":72257,"_30020":72243,"_20858":123095,"_5":14334,"_27317":123054,"_2936":123096},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3450":72258,"_30020":72243,"_20858":123098,"_5":14334,"_27317":123054,"_2936":123099},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3450":72259,"_30020":72243,"_20858":123101,"_5":14334,"_27317":123057,"_2936":123102},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3450":72260,"_30020":72243,"_20858":123104,"_5":14334,"_27317":123057,"_2936":123105},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3450":72261,"_30020":72243,"_20858":123107,"_5":14334,"_27317":123061,"_2936":123108},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3450":72262,"_30020":72243,"_20858":123110,"_5":14334,"_27317":123061,"_2936":123111},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3450":72263,"_30020":72243,"_20858":123113,"_5":14334,"_27317":123065,"_2936":123114},[],"Selecciona **Root CA** y completa:",{"_3450":72264,"_30020":72243,"_20858":123116,"_5":14334,"_27317":123065,"_2936":56684},[],{"_3450":72265,"_30020":72243,"_20858":123118,"_5":14334,"_27317":123065,"_2936":123119},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3450":72266,"_30020":72243,"_20858":123121,"_5":14334,"_27317":123065,"_2936":123122},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3450":72267,"_30020":72243,"_20858":123124,"_5":14334,"_27317":123065,"_2936":123125},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3450":72268,"_30020":72243,"_20858":123127,"_5":14334,"_27317":123065,"_2936":123128},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3450":72269,"_30020":72243,"_20858":123130,"_5":14334,"_27317":123069,"_2936":123131},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3450":72270,"_30020":72243,"_20858":123133,"_5":14334,"_27317":123073,"_2936":123134},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3450":72271,"_30020":72243,"_20858":123136,"_5":14334,"_27317":123073,"_2936":123137},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3450":72272,"_30020":72243,"_20858":123139,"_5":14334,"_27317":123077,"_2936":123140},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3450":72273,"_30020":72243,"_20858":123142,"_5":14334,"_27317":123077,"_2936":123143},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3450":72274,"_30020":72243,"_20858":123145,"_5":14334,"_27317":123077,"_2936":123146},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3450":72275,"_30020":72243,"_20858":123148,"_5":14334,"_27317":123081,"_2936":123149},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3450":72276,"_30020":72243,"_20858":123151,"_5":14334,"_27317":123081,"_2936":123152},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3450":72277,"_30020":72243,"_20858":123154,"_5":14334,"_27317":123081,"_2936":123155},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3450":72278,"_30020":72243,"_20858":123157,"_5":14334,"_27317":123081,"_2936":123158},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3450":72279,"_30020":72243,"_20858":123160,"_5":14334,"_27317":123084,"_2936":123161},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3450":72280,"_30020":72280,"_5":14686,"_2936":123163,"_30373":123164,"_20858":123165,"_27317":72280},"Emite y verifica un certificado",[49010,117071,54483,120399],[],{"_3450":72281,"_30020":72280,"_20858":123167,"_5":14334,"_27317":72280,"_2936":123168},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3450":72282,"_30020":72280,"_5":30370,"_20858":123170,"_27317":123171,"_2936":115649},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3450":72283,"_30020":72280,"_5":30370,"_20858":123173,"_27317":123174,"_2936":123175},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3450":72284,"_30020":72280,"_5":30370,"_20858":123177,"_27317":123178,"_2936":123179},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3450":72285,"_30020":72280,"_5":30370,"_20858":123181,"_27317":123182,"_2936":123183},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3450":72286,"_30020":72280,"_5":30370,"_20858":123185,"_27317":123186,"_2936":123187},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3450":72287,"_30020":72280,"_5":30370,"_20858":123189,"_27317":123190,"_2936":123191},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3450":72288,"_30020":72280,"_5":30370,"_20858":123193,"_27317":123194,"_2936":123195},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3450":72289,"_30020":72280,"_5":30370,"_20858":123197,"_27317":123198,"_2936":123199},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3450":72290,"_30020":72280,"_5":30370,"_20858":123201,"_27317":123202,"_2936":123203},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3450":72291,"_30020":72280,"_5":30370,"_20858":123205,"_27317":123206,"_2936":123207},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3450":72292,"_30020":72280,"_5":30370,"_20858":123209,"_27317":123210,"_2936":120646},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3450":72293,"_30020":72280,"_5":30370,"_20858":123212,"_27317":123213,"_2936":115673},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3450":72294,"_30020":72280,"_20858":123215,"_5":14334,"_27317":72280,"_2936":123216},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3450":72295,"_30020":72280,"_20858":123218,"_5":14334,"_27317":123171,"_2936":123219},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3450":72296,"_30020":72280,"_20858":123221,"_5":14334,"_27317":123171,"_2936":123222},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3450":72297,"_30020":72280,"_20858":123224,"_5":14334,"_27317":123171,"_2936":123225},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3450":72298,"_30020":72280,"_20858":123227,"_5":14334,"_27317":123171,"_2936":123228},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3450":72299,"_30020":72280,"_20858":123230,"_5":14334,"_27317":123171,"_2936":123231},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3450":72300,"_30020":72280,"_20858":123233,"_5":14334,"_27317":123174,"_2936":123234},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3450":72301,"_30020":72280,"_20858":123236,"_5":14334,"_27317":123178,"_2936":123237},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3450":72302,"_30020":72280,"_20858":123239,"_5":14334,"_27317":123178,"_2936":123240},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3450":72303,"_30020":72280,"_20858":123242,"_5":14334,"_27317":123182,"_2936":123243},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3450":72304,"_30020":72280,"_20858":123245,"_5":14334,"_27317":123182,"_2936":123246},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3450":72305,"_30020":72280,"_20858":123248,"_5":14334,"_27317":123186,"_2936":123249},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3450":72306,"_30020":72280,"_20858":123251,"_5":14334,"_27317":123186,"_2936":123252},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3450":72307,"_30020":72280,"_20858":123254,"_5":14334,"_27317":123190,"_2936":123255},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3450":72308,"_30020":72280,"_20858":123257,"_5":14334,"_27317":123194,"_2936":123258},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3450":72309,"_30020":72280,"_20858":123260,"_5":14334,"_27317":123198,"_2936":123261},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3450":72310,"_30020":72280,"_20858":123263,"_5":14334,"_27317":123202,"_2936":123264},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3450":72311,"_30020":72280,"_20858":123266,"_5":14334,"_27317":123202,"_2936":123267},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3450":72312,"_30020":72280,"_20858":123269,"_5":14334,"_27317":123202,"_2936":123270},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3450":72313,"_30020":72280,"_20858":123272,"_5":14334,"_27317":123206,"_2936":123273},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3450":72314,"_30020":72280,"_20858":123275,"_5":14334,"_27317":123206,"_2936":123276},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3450":72315,"_30020":72280,"_20858":123278,"_5":14334,"_27317":123206,"_2936":123279},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3450":72316,"_30020":72280,"_20858":123281,"_5":14334,"_27317":123210,"_2936":120729},[],{"_3450":72317,"_30020":72280,"_20858":123283,"_5":14334,"_27317":123210,"_2936":119250},[],{"_3450":72318,"_30020":72280,"_20858":123285,"_5":14334,"_27317":123210,"_2936":123286},[],"La CA rechaza la emisión",{"_3450":72319,"_30020":72280,"_20858":123288,"_5":14334,"_27317":123210,"_2936":123289},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3450":72320,"_30020":72280,"_20858":123291,"_5":14334,"_27317":123210,"_2936":123292},[],"Sujeto o usos diferentes",{"_3450":72321,"_30020":72280,"_20858":123294,"_5":14334,"_27317":123210,"_2936":123295},[],"Perfil aplicado y valores solicitados.",{"_3450":72322,"_30020":72280,"_20858":123297,"_5":14334,"_27317":123210,"_2936":123298},[],"No se encuentra el emisor",{"_3450":72323,"_30020":72280,"_20858":123300,"_5":14334,"_27317":123210,"_2936":123301},[],"CA descargada y cadena intermedia necesaria.",{"_3450":72324,"_30020":72280,"_20858":123303,"_5":14334,"_27317":123210,"_2936":123304},[],"Falla la vigencia",{"_3450":72325,"_30020":72280,"_20858":123306,"_5":14334,"_27317":123210,"_2936":123307},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3450":72326,"_30020":72280,"_20858":123309,"_5":14334,"_27317":123210,"_2936":123310},[],"Los resúmenes de clave difieren",{"_3450":72327,"_30020":72280,"_20858":123312,"_5":14334,"_27317":123210,"_2936":123313},[],"Archivos de certificado y clave de la misma emisión.",{"_3450":72328,"_30020":72280,"_20858":123315,"_5":14334,"_27317":123210,"_2936":123316},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3450":72329,"_30020":72280,"_20858":123318,"_5":14334,"_27317":123213,"_2936":123319},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3450":72330,"_30020":72280,"_20858":123321,"_5":14334,"_27317":123213,"_2936":123322},[],"Gestionar certificados para inspección, estado y revocación.",{"_3450":72331,"_30020":72280,"_20858":123324,"_5":14334,"_27317":123213,"_2936":123325},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3450":72332,"_30020":72280,"_20858":123327,"_5":14334,"_27317":123213,"_2936":123328},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3450":72333,"_30020":72280,"_20858":123330,"_5":14334,"_27317":123213,"_2936":123331},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3450":72334,"_30020":72334,"_5":14686,"_2936":123333,"_30373":123334,"_20858":123335,"_27317":72334},"Primeros pasos de PKI",[49010,117071,54483,120399],[],{"_3450":72335,"_30020":72334,"_20858":123337,"_5":14334,"_27317":72334,"_2936":123338},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3450":72336,"_30020":72334,"_5":30370,"_20858":123340,"_27317":123341,"_2936":115649},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3450":72337,"_30020":72334,"_5":30370,"_20858":123343,"_27317":123344,"_2936":123345},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3450":72338,"_30020":72334,"_5":30370,"_20858":123347,"_27317":123348,"_2936":120581},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3450":72339,"_30020":72334,"_5":30370,"_20858":123350,"_27317":123351,"_2936":123352},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3450":72340,"_30020":72334,"_20858":123354,"_5":14334,"_27317":72334,"_2936":123355},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3450":72341,"_30020":72334,"_20858":123357,"_5":14334,"_27317":123341,"_2936":123358},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3450":72342,"_30020":72334,"_20858":123360,"_5":14334,"_27317":123341,"_2936":123361},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3450":72343,"_30020":72334,"_20858":123363,"_5":14334,"_27317":123341,"_2936":123364},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3450":72344,"_30020":72334,"_20858":123366,"_5":14334,"_27317":123341,"_2936":123367},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3450":72345,"_30020":72334,"_20858":123369,"_5":14334,"_27317":123341,"_2936":123370},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3450":72346,"_30020":72334,"_20858":123372,"_5":14334,"_27317":123344,"_2936":123373},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3450":72347,"_30020":72334,"_20858":123375,"_5":14334,"_27317":123344,"_2936":123376},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3450":72348,"_30020":72334,"_20858":123378,"_5":14334,"_27317":123344,"_2936":123379},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3450":72349,"_30020":72334,"_20858":123381,"_5":14334,"_27317":123344,"_2936":123382},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3450":72350,"_30020":72334,"_20858":123384,"_5":14334,"_27317":123348,"_2936":123385},[],"Archivo o recurso",{"_3450":72351,"_30020":72334,"_20858":123387,"_5":14334,"_27317":123348,"_2936":120578},[],{"_3450":72352,"_30020":72334,"_20858":123389,"_5":14334,"_27317":123348,"_2936":123390},[],"CA raíz activa y `ca.pem`",{"_3450":72353,"_30020":72334,"_20858":123392,"_5":14334,"_27317":123348,"_2936":123393},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3450":72354,"_30020":72334,"_20858":123395,"_5":14334,"_27317":123348,"_2936":123396},[],"Certificado final y `device.crt`",{"_3450":72355,"_30020":72334,"_20858":123398,"_5":14334,"_27317":123348,"_2936":123399},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3450":72356,"_30020":72334,"_20858":123401,"_5":14334,"_27317":123348,"_2936":123402},[],"Clave privada `device.key`",{"_3450":72357,"_30020":72334,"_20858":123404,"_5":14334,"_27317":123348,"_2936":123405},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3450":72358,"_30020":72334,"_20858":123407,"_5":14334,"_27317":123348,"_2936":123408},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3450":72359,"_30020":72334,"_20858":123410,"_5":14334,"_27317":123351,"_2936":123411},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3450":72360,"_30020":72334,"_20858":123413,"_5":14334,"_27317":123351,"_2936":123414},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3450":72361,"_30020":72334,"_20858":123416,"_5":14334,"_27317":123351,"_2936":123417},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3450":72362,"_30020":72362,"_5":14686,"_2936":123419,"_30373":123420,"_20858":123422,"_27317":72362},"Resolución de problemas PKI",[49010,117071,54483,123421],"Resolución de problemas",[],{"_3450":72363,"_30020":72362,"_20858":123424,"_5":14334,"_27317":72362,"_2936":123425},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3450":72364,"_30020":72362,"_5":30370,"_20858":123427,"_27317":123428,"_2936":123429},[],"/docs/pr-preview/pr-60/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3450":72365,"_30020":72362,"_5":30370,"_20858":123431,"_27317":123432,"_2936":123433},[],"/docs/pr-preview/pr-60/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3450":72366,"_30020":72362,"_5":30370,"_20858":123435,"_27317":123436,"_2936":123437},[],"/docs/pr-preview/pr-60/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3450":72367,"_30020":72362,"_20858":123439,"_5":14334,"_27317":72362,"_2936":123440},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3450":72368,"_30020":72362,"_20858":123442,"_5":14334,"_27317":72362,"_2936":123443},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3450":72369,"_30020":72362,"_20858":123445,"_5":14334,"_27317":123428,"_2936":120578},[],{"_3450":72370,"_30020":72362,"_20858":123447,"_5":14334,"_27317":123428,"_2936":119250},[],{"_3450":72371,"_30020":72362,"_20858":123449,"_5":14334,"_27317":123428,"_2936":115673},[],{"_3450":72372,"_30020":72362,"_20858":123451,"_5":14334,"_27317":123428,"_2936":53325},[],{"_3450":72373,"_30020":72362,"_20858":123453,"_5":14334,"_27317":123428,"_2936":123454},[],"Existe, está activa y sus fechas son utilizables.",{"_3450":72374,"_30020":72362,"_20858":123456,"_5":14334,"_27317":123428,"_2936":123457},[],"Autoridades.",{"_3450":72375,"_30020":72362,"_20858":123459,"_5":14334,"_27317":123428,"_2936":123460},[],"Clave",{"_3450":72376,"_30020":72362,"_20858":123462,"_5":14334,"_27317":123428,"_2936":123463},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3450":72377,"_30020":72362,"_20858":123465,"_5":14334,"_27317":123428,"_2936":123466},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3450":72378,"_30020":72362,"_20858":123468,"_5":14334,"_27317":123428,"_2936":57038},[],{"_3450":72379,"_30020":72362,"_20858":123470,"_5":14334,"_27317":123428,"_2936":123471},[],"PEM correcto y firma verificable.",{"_3450":72380,"_30020":72362,"_20858":123473,"_5":14334,"_27317":123428,"_2936":57044},[],{"_3450":72381,"_30020":72362,"_20858":123475,"_5":14334,"_27317":123428,"_2936":123476},[],"Perfil",{"_3450":72382,"_30020":72362,"_20858":123478,"_5":14334,"_27317":123428,"_2936":123479},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3450":72383,"_30020":72362,"_20858":123481,"_5":14334,"_27317":123428,"_2936":123482},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3450":72384,"_30020":72362,"_20858":123484,"_5":14334,"_27317":123428,"_2936":120729},[],{"_3450":72385,"_30020":72362,"_20858":123486,"_5":14334,"_27317":123428,"_2936":123487},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3450":72386,"_30020":72362,"_20858":123489,"_5":14334,"_27317":123428,"_2936":123490},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3450":72387,"_30020":72362,"_20858":123492,"_5":14334,"_27317":123428,"_2936":123493},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3450":72388,"_30020":72362,"_20858":123495,"_5":14334,"_27317":123428,"_2936":123496},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3450":72389,"_30020":72362,"_20858":123498,"_5":14334,"_27317":123432,"_2936":123499},[],"Revisa cada frontera por separado:",{"_3450":72390,"_30020":72362,"_20858":123501,"_5":14334,"_27317":123432,"_2936":123502},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3450":72391,"_30020":72362,"_20858":123504,"_5":14334,"_27317":123432,"_2936":123505},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3450":72392,"_30020":72362,"_20858":123507,"_5":14334,"_27317":123432,"_2936":123508},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3450":72393,"_30020":72362,"_20858":123510,"_5":14334,"_27317":123432,"_2936":123511},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3450":72394,"_30020":72362,"_20858":123513,"_5":14334,"_27317":123432,"_2936":123514},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3450":72395,"_30020":72362,"_20858":123516,"_5":14334,"_27317":123432,"_2936":123517},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3450":72396,"_30020":72362,"_20858":123519,"_5":14334,"_27317":123436,"_2936":123520},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3450":72397,"_30020":72362,"_20858":123522,"_5":14334,"_27317":123436,"_2936":123523},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3450":72398,"_30020":72398,"_5":14686,"_2936":123525,"_30373":123526,"_20858":123527,"_27317":72398},"Seguridad",[49010],[],{"_3450":72399,"_30020":72398,"_20858":123529,"_5":14334,"_27317":72398,"_2936":123530},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3450":72400,"_30020":72398,"_5":30370,"_20858":123532,"_27317":123533,"_2936":123534},[],"/docs/pr-preview/pr-60/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3450":72401,"_30020":72398,"_5":30370,"_20858":123536,"_27317":123537,"_2936":123538},[],"/docs/pr-preview/pr-60/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3450":72402,"_30020":72398,"_5":30370,"_20858":123540,"_27317":123541,"_2936":123542},[],"/docs/pr-preview/pr-60/es/security#versiones-soportadas","Versiones soportadas",{"_3450":72403,"_30020":72398,"_5":30370,"_20858":123544,"_27317":123545,"_2936":123546},[],"/docs/pr-preview/pr-60/es/security#divulgación-responsable","Divulgación responsable",{"_3450":72404,"_30020":72398,"_20858":123548,"_5":14334,"_27317":72398,"_2936":123549},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3450":72405,"_30020":72398,"_20858":123551,"_5":14334,"_27317":123533,"_2936":123552},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3450":72406,"_30020":72398,"_20858":123554,"_5":14334,"_27317":123533,"_2936":123555},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3450":72407,"_30020":72398,"_20858":123557,"_5":14334,"_27317":123533,"_2936":14959},[],{"_3450":72408,"_30020":72398,"_20858":123559,"_5":14334,"_27317":123533,"_2936":14899},[],{"_3450":72409,"_30020":72398,"_20858":123561,"_5":14334,"_27317":123533,"_2936":14946},[],{"_3450":72410,"_30020":72398,"_20858":123563,"_5":14334,"_27317":123533,"_2936":123564},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3450":72411,"_30020":72398,"_20858":123566,"_5":14334,"_27317":123533,"_2936":123567},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3450":72412,"_30020":72398,"_20858":123569,"_5":14334,"_27317":123537,"_2936":123570},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3450":72413,"_30020":72398,"_20858":123572,"_5":14334,"_27317":123537,"_2936":123573},[],"No incluyas en el reporte:",{"_3450":72414,"_30020":72398,"_20858":123575,"_5":14334,"_27317":123537,"_2936":123576},[],"Credenciales, tokens o claves privadas",{"_3450":72415,"_30020":72398,"_20858":123578,"_5":14334,"_27317":123537,"_2936":123579},[],"Datos de clientes o información identificable de clientes",{"_3450":72416,"_30020":72398,"_20858":123581,"_5":14334,"_27317":123537,"_2936":123582},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3450":72417,"_30020":72398,"_20858":123584,"_5":14334,"_27317":123541,"_2936":123585},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3450":72418,"_30020":72398,"_20858":123587,"_5":14334,"_27317":123541,"_2936":123588},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3450":72419,"_30020":72398,"_20858":123590,"_5":14334,"_27317":123545,"_2936":123591},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3450":72420,"_30020":72398,"_20858":123593,"_5":14334,"_27317":123545,"_2936":123594},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3450":72421,"_30020":72398,"_20858":123596,"_5":14334,"_27317":123545,"_2936":123597},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3450":72422,"_30020":72398,"_20858":123599,"_5":14334,"_27317":123545,"_2936":123600},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3450":72423,"_30020":72398,"_20858":123602,"_5":14334,"_27317":123545,"_2936":123603},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3450":72424,"_30020":72424,"_5":14686,"_2936":123605,"_30373":123606,"_20858":123608,"_27317":72424},"3.8.0 a 4.0.0",[49010,123607],"Actualizaciones",[],{"_3450":72425,"_30020":72424,"_20858":123610,"_5":14334,"_27317":72424,"_2936":123611},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3450":72426,"_30020":72424,"_5":30370,"_20858":123613,"_27317":123614,"_2936":123615},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3450":72427,"_30020":72424,"_5":30370,"_20858":123617,"_27317":123618,"_2936":123619},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3450":72428,"_30020":72424,"_5":30370,"_20858":123621,"_27317":123622,"_2936":123623},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3450":72429,"_30020":72424,"_5":30370,"_20858":123625,"_27317":123626,"_2936":123627},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3450":72430,"_30020":72424,"_5":30370,"_20858":123629,"_27317":123630,"_2936":123631},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3450":72431,"_30020":72424,"_5":30370,"_20858":123633,"_27317":123634,"_2936":123635},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3450":72432,"_30020":72424,"_5":30370,"_20858":123637,"_27317":123638,"_2936":57210},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3450":72433,"_30020":72424,"_5":30370,"_20858":123640,"_27317":123641,"_2936":123642},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3450":72434,"_30020":72424,"_5":30370,"_20858":123644,"_27317":123645,"_2936":123646},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3450":72435,"_30020":72424,"_5":30370,"_20858":123648,"_27317":123649,"_2936":123650},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3450":72436,"_30020":72424,"_5":30370,"_20858":123652,"_27317":123653,"_2936":123654},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3450":72437,"_30020":72424,"_5":30370,"_20858":123656,"_27317":123657,"_2936":123658},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3450":72438,"_30020":72424,"_5":30370,"_20858":123660,"_27317":123661,"_2936":123662},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3450":72439,"_30020":72424,"_5":30370,"_20858":123664,"_27317":123665,"_2936":123666},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3450":72440,"_30020":72424,"_5":30370,"_20858":123668,"_27317":123669,"_2936":123670},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3450":72441,"_30020":72424,"_5":30370,"_20858":123672,"_27317":123673,"_2936":123674},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3450":72442,"_30020":72424,"_5":30370,"_20858":123676,"_27317":123677,"_2936":123678},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3450":72443,"_30020":72424,"_5":30370,"_20858":123680,"_27317":123681,"_2936":123682},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3450":72444,"_30020":72424,"_5":30370,"_20858":123684,"_27317":123685,"_2936":123686},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3450":72445,"_30020":72424,"_5":30370,"_20858":123688,"_27317":123689,"_2936":123690},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3450":72446,"_30020":72424,"_5":30370,"_20858":123692,"_27317":123693,"_2936":123694},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3450":72447,"_30020":72424,"_5":30370,"_20858":123696,"_27317":123697,"_2936":123698},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3450":72448,"_30020":72424,"_5":30370,"_20858":123700,"_27317":123701,"_2936":123702},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3450":72449,"_30020":72424,"_5":30370,"_20858":123704,"_27317":123705,"_2936":123706},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3450":72450,"_30020":72424,"_5":30370,"_20858":123708,"_27317":123709,"_2936":123710},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3450":72451,"_30020":72424,"_5":30370,"_20858":123712,"_27317":123713,"_2936":123714},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3450":72452,"_30020":72424,"_5":30370,"_20858":123716,"_27317":123717,"_2936":123718},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3450":72453,"_30020":72424,"_5":30370,"_20858":123720,"_27317":123721,"_2936":123722},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3450":72454,"_30020":72424,"_5":30370,"_20858":123724,"_27317":123725,"_2936":123726},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3450":72455,"_30020":72424,"_5":30370,"_20858":123728,"_27317":123729,"_2936":123730},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3450":72456,"_30020":72424,"_5":30370,"_20858":123732,"_27317":123733,"_2936":123734},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3450":72457,"_30020":72424,"_5":30370,"_20858":123736,"_27317":123737,"_2936":123738},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3450":72458,"_30020":72424,"_5":30370,"_20858":123740,"_27317":123741,"_2936":123742},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3450":72459,"_30020":72424,"_5":30370,"_20858":123744,"_27317":123745,"_2936":123746},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3450":72460,"_30020":72424,"_5":30370,"_20858":123748,"_27317":123749,"_2936":123750},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3450":72461,"_30020":72424,"_5":30370,"_20858":123752,"_27317":123753,"_2936":123754},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3450":72462,"_30020":72424,"_5":30370,"_20858":123756,"_27317":123757,"_2936":123758},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3450":72463,"_30020":72424,"_5":30370,"_20858":123760,"_27317":123761,"_2936":123762},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3450":72464,"_30020":72424,"_5":30370,"_20858":123764,"_27317":123765,"_2936":123766},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3450":72465,"_30020":72424,"_5":30370,"_20858":123768,"_27317":123769,"_2936":119592},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3450":72466,"_30020":72424,"_5":30370,"_20858":123771,"_27317":123772,"_2936":123773},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3450":72467,"_30020":72424,"_5":30370,"_20858":123775,"_27317":123776,"_2936":123777},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3450":72468,"_30020":72424,"_20858":123779,"_5":14334,"_27317":72424,"_2936":123780},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3450":72469,"_30020":72424,"_20858":123782,"_5":14334,"_27317":72424,"_2936":123783},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3450":72470,"_30020":72424,"_20858":123785,"_5":14334,"_27317":72424,"_2936":123786},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3450":72471,"_30020":72424,"_20858":123788,"_5":14334,"_27317":72424,"_2936":123789},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3450":72472,"_30020":72424,"_20858":123791,"_5":14334,"_27317":72424,"_2936":123792},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3450":72473,"_30020":72424,"_20858":123794,"_5":14334,"_27317":72424,"_2936":123795},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3450":72474,"_30020":72424,"_20858":123797,"_5":14334,"_27317":72424,"_2936":123798},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3450":72475,"_30020":72424,"_20858":123800,"_5":14334,"_27317":123618,"_2936":123801},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3450":72476,"_30020":72424,"_20858":123803,"_5":14334,"_27317":123618,"_2936":123804},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3450":72477,"_30020":72424,"_20858":123806,"_5":14334,"_27317":123622,"_2936":123807},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3450":72478,"_30020":72424,"_20858":123809,"_5":14334,"_27317":123622,"_2936":123810},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3450":72479,"_30020":72424,"_20858":123812,"_5":14334,"_27317":123626,"_2936":123813},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3450":72480,"_30020":72424,"_20858":123815,"_5":14334,"_27317":123630,"_2936":123816},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3450":72481,"_30020":72424,"_20858":123818,"_5":14334,"_27317":123630,"_2936":123819},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3450":72482,"_30020":72424,"_20858":123821,"_5":14334,"_27317":123630,"_2936":123822},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3450":72483,"_30020":72424,"_20858":123824,"_5":14334,"_27317":123630,"_2936":123825},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3450":72484,"_30020":72424,"_20858":123827,"_5":14334,"_27317":123630,"_2936":123828},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3450":72485,"_30020":72424,"_20858":123830,"_5":14334,"_27317":123634,"_2936":123831},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3450":72486,"_30020":72424,"_20858":123833,"_5":14334,"_27317":123634,"_2936":123834},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3450":72487,"_30020":72424,"_20858":123836,"_5":14334,"_27317":123634,"_2936":123837},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3450":72488,"_30020":72424,"_20858":123839,"_5":14334,"_27317":123634,"_2936":123840},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3450":72489,"_30020":72424,"_20858":123842,"_5":14334,"_27317":123634,"_2936":123843},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3450":72490,"_30020":72424,"_20858":123845,"_5":14334,"_27317":123638,"_2936":123846},[],"Cambio",{"_3450":72491,"_30020":72424,"_20858":123848,"_5":14334,"_27317":123638,"_2936":123849},[],"A quién afecta",{"_3450":72492,"_30020":72424,"_20858":123851,"_5":14334,"_27317":123638,"_2936":123852},[],"Gravedad",{"_3450":72493,"_30020":72424,"_20858":123854,"_5":14334,"_27317":123638,"_2936":122356},[],{"_3450":72494,"_30020":72424,"_20858":123856,"_5":14334,"_27317":123638,"_2936":123646},[],{"_3450":72495,"_30020":72424,"_20858":123858,"_5":14334,"_27317":123638,"_2936":123859},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3450":72496,"_30020":72424,"_20858":123861,"_5":14334,"_27317":123638,"_2936":123862},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3450":72497,"_30020":72424,"_20858":123864,"_5":14334,"_27317":123638,"_2936":123865},[],"Copiar los datos a los volúmenes nuevos",{"_3450":72498,"_30020":72424,"_20858":123867,"_5":14334,"_27317":123638,"_2936":123650},[],{"_3450":72499,"_30020":72424,"_20858":123869,"_5":14334,"_27317":123638,"_2936":123870},[],"Todas las releases de Helm",{"_3450":72500,"_30020":72424,"_20858":123872,"_5":14334,"_27317":123638,"_2936":123873},[],"Alta: `helm upgrade` falla",{"_3450":72501,"_30020":72424,"_20858":123875,"_5":14334,"_27317":123638,"_2936":123876},[],"Eliminar o renombrar las claves heredadas",{"_3450":72502,"_30020":72424,"_20858":123878,"_5":14334,"_27317":123638,"_2936":123654},[],{"_3450":72503,"_30020":72424,"_20858":123880,"_5":14334,"_27317":123638,"_2936":123881},[],"Todos los despliegues",{"_3450":72504,"_30020":72424,"_20858":123883,"_5":14334,"_27317":123638,"_2936":123884},[],"Alta: sin principal de bootstrap no hay administrador",{"_3450":72505,"_30020":72424,"_20858":123886,"_5":14334,"_27317":123638,"_2936":123887},[],"Configurar `services.authz`",{"_3450":72506,"_30020":72424,"_20858":123889,"_5":14334,"_27317":123638,"_2936":123658},[],{"_3450":72507,"_30020":72424,"_20858":123891,"_5":14334,"_27317":123638,"_2936":123870},[],{"_3450":72508,"_30020":72424,"_20858":123893,"_5":14334,"_27317":123638,"_2936":123894},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3450":72509,"_30020":72424,"_20858":123896,"_5":14334,"_27317":123638,"_2936":123897},[],"Mover JWKS y roles a `services.authz`",{"_3450":72510,"_30020":72424,"_20858":123899,"_5":14334,"_27317":123638,"_2936":123678},[],{"_3450":72511,"_30020":72424,"_20858":123901,"_5":14334,"_27317":123638,"_2936":123902},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3450":72512,"_30020":72424,"_20858":123904,"_5":14334,"_27317":123638,"_2936":123905},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3450":72513,"_30020":72424,"_20858":123907,"_5":14334,"_27317":123638,"_2936":123908},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3450":72514,"_30020":72424,"_20858":123910,"_5":14334,"_27317":123638,"_2936":123682},[],{"_3450":72515,"_30020":72424,"_20858":123912,"_5":14334,"_27317":123638,"_2936":123913},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3450":72516,"_30020":72424,"_20858":123915,"_5":14334,"_27317":123638,"_2936":123916},[],"Alta: el backend ya no arranca con ellos",{"_3450":72517,"_30020":72424,"_20858":123918,"_5":14334,"_27317":123638,"_2936":123919},[],"Pasar a PostgreSQL antes de actualizar",{"_3450":72518,"_30020":72424,"_20858":123921,"_5":14334,"_27317":123638,"_2936":123726},[],{"_3450":72519,"_30020":72424,"_20858":123923,"_5":14334,"_27317":123638,"_2936":123924},[],"Despliegues que gestionan roles de VA por API, y sus políticas personalizadas y suscripciones de alertas",{"_3450":72520,"_30020":72424,"_20858":123926,"_5":14334,"_27317":123638,"_2936":123927},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3450":72521,"_30020":72424,"_20858":123929,"_5":14334,"_27317":123638,"_2936":123930},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3450":72522,"_30020":72424,"_20858":123932,"_5":14334,"_27317":123638,"_2936":123933},[],"Webhooks con referencias a archivos",{"_3450":72523,"_30020":72424,"_20858":123935,"_5":14334,"_27317":123638,"_2936":123936},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3450":72524,"_30020":72424,"_20858":123938,"_5":14334,"_27317":123638,"_2936":123939},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3450":72525,"_30020":72424,"_20858":123941,"_5":14334,"_27317":123638,"_2936":123942},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3450":72526,"_30020":72424,"_20858":123944,"_5":14334,"_27317":123638,"_2936":123662},[],{"_3450":72527,"_30020":72424,"_20858":123946,"_5":14334,"_27317":123638,"_2936":123947},[],"Releases con identidades por servicio o material de claves montado",{"_3450":72528,"_30020":72424,"_20858":123949,"_5":14334,"_27317":123638,"_2936":123950},[],"Media: los servicios no pueden leer sus archivos",{"_3450":72529,"_30020":72424,"_20858":123952,"_5":14334,"_27317":123638,"_2936":123953},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3450":72530,"_30020":72424,"_20858":123955,"_5":14334,"_27317":123638,"_2936":123666},[],{"_3450":72531,"_30020":72424,"_20858":123957,"_5":14334,"_27317":123638,"_2936":123958},[],"Releases que definen `amqp.tls`",{"_3450":72532,"_30020":72424,"_20858":123960,"_5":14334,"_27317":123638,"_2936":123961},[],"Media: los clientes se conectan al puerto equivocado",{"_3450":72533,"_30020":72424,"_20858":123963,"_5":14334,"_27317":123638,"_2936":123964},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3450":72534,"_30020":72424,"_20858":123966,"_5":14334,"_27317":123638,"_2936":123686},[],{"_3450":72535,"_30020":72424,"_20858":123968,"_5":14334,"_27317":123638,"_2936":123969},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3450":72536,"_30020":72424,"_20858":123971,"_5":14334,"_27317":123638,"_2936":123972},[],"Media: las claves de CA quedan sin gestionar",{"_3450":72537,"_30020":72424,"_20858":123974,"_5":14334,"_27317":123638,"_2936":123975},[],"Ejecutar la migración de CA a KMS",{"_3450":72538,"_30020":72424,"_20858":123977,"_5":14334,"_27317":123638,"_2936":123978},[],"Verificación del certificado del receptor",{"_3450":72539,"_30020":72424,"_20858":123980,"_5":14334,"_27317":123638,"_2936":123981},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3450":72540,"_30020":72424,"_20858":123983,"_5":14334,"_27317":123638,"_2936":123984},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3450":72541,"_30020":72424,"_20858":123986,"_5":14334,"_27317":123638,"_2936":123987},[],"Poner `insecure_skip_verify` a `false`",{"_3450":72542,"_30020":72424,"_20858":123989,"_5":14334,"_27317":123638,"_2936":123702},[],{"_3450":72543,"_30020":72424,"_20858":123991,"_5":14334,"_27317":123638,"_2936":123992},[],"Scripts y consolas que editan DMS por API",{"_3450":72544,"_30020":72424,"_20858":123994,"_5":14334,"_27317":123638,"_2936":123995},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3450":72545,"_30020":72424,"_20858":123997,"_5":14334,"_27317":123638,"_2936":123998},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3450":72546,"_30020":72424,"_20858":124000,"_5":14334,"_27317":123638,"_2936":123722},[],{"_3450":72547,"_30020":72424,"_20858":124002,"_5":14334,"_27317":123638,"_2936":124003},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3450":72548,"_30020":72424,"_20858":124005,"_5":14334,"_27317":123638,"_2936":124006},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3450":72549,"_30020":72424,"_20858":124008,"_5":14334,"_27317":123638,"_2936":124009},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3450":72550,"_30020":72424,"_20858":124011,"_5":14334,"_27317":123638,"_2936":123730},[],{"_3450":72551,"_30020":72424,"_20858":124013,"_5":14334,"_27317":123638,"_2936":124014},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3450":72552,"_30020":72424,"_20858":124016,"_5":14334,"_27317":123638,"_2936":124017},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3450":72553,"_30020":72424,"_20858":124019,"_5":14334,"_27317":123638,"_2936":124020},[],"Revisar las condiciones que filtran por el payload antiguo del evento",{"_3450":72554,"_30020":72424,"_20858":124022,"_5":14334,"_27317":123638,"_2936":123718},[],{"_3450":72555,"_30020":72424,"_20858":124024,"_5":14334,"_27317":123638,"_2936":124025},[],"Consumidores que leen el campo `events` del dispositivo",{"_3450":72556,"_30020":72424,"_20858":124027,"_5":14334,"_27317":123638,"_2936":124028},[],"Media: el campo desaparece",{"_3450":72557,"_30020":72424,"_20858":124030,"_5":14334,"_27317":123638,"_2936":124031},[],"Usar los nuevos endpoints de eventos",{"_3450":72558,"_30020":72424,"_20858":124033,"_5":14334,"_27317":123638,"_2936":123670},[],{"_3450":72559,"_30020":72424,"_20858":124035,"_5":14334,"_27317":123638,"_2936":124036},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3450":72560,"_30020":72424,"_20858":124038,"_5":14334,"_27317":123638,"_2936":124039},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3450":72561,"_30020":72424,"_20858":124041,"_5":14334,"_27317":123638,"_2936":124042},[],"Actualizar el archivo de values",{"_3450":72562,"_30020":72424,"_20858":124044,"_5":14334,"_27317":123638,"_2936":123710},[],{"_3450":72563,"_30020":72424,"_20858":124046,"_5":14334,"_27317":123638,"_2936":124047},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3450":72564,"_30020":72424,"_20858":124049,"_5":14334,"_27317":123638,"_2936":124050},[],"Baja: prevalece el ID de la URL",{"_3450":72565,"_30020":72424,"_20858":124052,"_5":14334,"_27317":123638,"_2936":124053},[],"Enviar el ID en la URL",{"_3450":72566,"_30020":72424,"_20858":124055,"_5":14334,"_27317":123638,"_2936":123734},[],{"_3450":72567,"_30020":72424,"_20858":124057,"_5":14334,"_27317":123638,"_2936":124058},[],"Clientes que envían un `id` al crear o importar CAs",{"_3450":72568,"_30020":72424,"_20858":124060,"_5":14334,"_27317":123638,"_2936":124061},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3450":72569,"_30020":72424,"_20858":124063,"_5":14334,"_27317":123638,"_2936":124064},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3450":72570,"_30020":72424,"_20858":124066,"_5":14334,"_27317":123638,"_2936":123714},[],{"_3450":72571,"_30020":72424,"_20858":124068,"_5":14334,"_27317":123638,"_2936":124069},[],"Consumidores que comparan el `type` del certificado",{"_3450":72572,"_30020":72424,"_20858":124071,"_5":14334,"_27317":123638,"_2936":124072},[],"Baja: dos valores cambian de nombre",{"_3450":72573,"_30020":72424,"_20858":124074,"_5":14334,"_27317":123638,"_2936":124075},[],"Adaptar los consumidores",{"_3450":72574,"_30020":72424,"_20858":124077,"_5":14334,"_27317":123638,"_2936":123706},[],{"_3450":72575,"_30020":72424,"_20858":124079,"_5":14334,"_27317":123638,"_2936":124080},[],"Cualquier DMS",{"_3450":72576,"_30020":72424,"_20858":124082,"_5":14334,"_27317":123638,"_2936":124083},[],"Baja: solo informativo",{"_3450":72577,"_30020":72424,"_20858":124085,"_5":14334,"_27317":123638,"_2936":124086},[],"Revisar ambos bloques antes de editar",{"_3450":72578,"_30020":72424,"_20858":124088,"_5":14334,"_27317":123645,"_2936":124089},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3450":72579,"_30020":72424,"_20858":124091,"_5":14334,"_27317":123645,"_2936":124092},[],"El paso 4 de la guía de migración copia los datos.",{"_3450":72580,"_30020":72424,"_20858":124094,"_5":14334,"_27317":123649,"_2936":124095},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3450":72581,"_30020":72424,"_20858":124097,"_5":14334,"_27317":123653,"_2936":124098},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3450":72582,"_30020":72424,"_20858":124100,"_5":14334,"_27317":123657,"_2936":124101},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3450":72583,"_30020":72424,"_20858":124103,"_5":14334,"_27317":123661,"_2936":124104},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3450":72584,"_30020":72424,"_20858":124106,"_5":14334,"_27317":123661,"_2936":124107},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3450":72585,"_30020":72424,"_20858":124109,"_5":14334,"_27317":123665,"_2936":124110},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3450":72586,"_30020":72424,"_20858":124112,"_5":14334,"_27317":123669,"_2936":124113},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3450":72587,"_30020":72424,"_20858":124115,"_5":14334,"_27317":123669,"_2936":124116},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3450":72588,"_30020":72424,"_20858":124118,"_5":14334,"_27317":123669,"_2936":124119},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3450":72589,"_30020":72424,"_20858":124121,"_5":14334,"_27317":123669,"_2936":124122},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3450":72590,"_30020":72424,"_20858":124124,"_5":14334,"_27317":123669,"_2936":124125},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3450":72591,"_30020":72424,"_20858":124127,"_5":14334,"_27317":123669,"_2936":124128},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3450":72592,"_30020":72424,"_20858":124130,"_5":14334,"_27317":123677,"_2936":124131},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3450":72593,"_30020":72424,"_20858":124133,"_5":14334,"_27317":123677,"_2936":124134},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3450":72594,"_30020":72424,"_20858":124136,"_5":14334,"_27317":123677,"_2936":124137},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3450":72595,"_30020":72424,"_20858":124139,"_5":14334,"_27317":123677,"_2936":124140},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3450":72596,"_30020":72424,"_20858":124142,"_5":14334,"_27317":123677,"_2936":124143},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3450":72597,"_30020":72424,"_20858":124145,"_5":14334,"_27317":123681,"_2936":124146},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3450":72598,"_30020":72424,"_20858":124148,"_5":14334,"_27317":123685,"_2936":124149},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3450":72599,"_30020":72424,"_20858":124151,"_5":14334,"_27317":123685,"_2936":124152},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3450":72600,"_30020":72424,"_20858":124154,"_5":14334,"_27317":123685,"_2936":124155},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3450":72601,"_30020":72424,"_20858":124157,"_5":14334,"_27317":123685,"_2936":124158},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3450":72602,"_30020":72424,"_20858":124160,"_5":14334,"_27317":123685,"_2936":124161},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3450":72603,"_30020":72424,"_20858":124163,"_5":14334,"_27317":123685,"_2936":124164},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3450":72604,"_30020":72424,"_20858":124166,"_5":14334,"_27317":123685,"_2936":124167},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3450":72605,"_30020":72424,"_20858":124169,"_5":14334,"_27317":123689,"_2936":124170},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3450":72606,"_30020":72424,"_20858":124172,"_5":14334,"_27317":123697,"_2936":124173},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3450":72607,"_30020":72424,"_20858":124175,"_5":14334,"_27317":123697,"_2936":124176},[],"Campo en 3.8.0",{"_3450":72608,"_30020":72424,"_20858":124178,"_5":14334,"_27317":123697,"_2936":124179},[],"Campo en 4.0.0",{"_3450":72609,"_30020":72424,"_20858":124181,"_5":14334,"_27317":123697,"_2936":57754},[],{"_3450":72610,"_30020":72424,"_20858":124183,"_5":14334,"_27317":123697,"_2936":124184},[],"`insecure_skip_verify` (con el valor negado)",{"_3450":72611,"_30020":72424,"_20858":124186,"_5":14334,"_27317":123697,"_2936":57760},[],{"_3450":72612,"_30020":72424,"_20858":124188,"_5":14334,"_27317":123697,"_2936":57763},[],{"_3450":72613,"_30020":72424,"_20858":124190,"_5":14334,"_27317":123697,"_2936":57766},[],{"_3450":72614,"_30020":72424,"_20858":124192,"_5":14334,"_27317":123697,"_2936":57769},[],{"_3450":72615,"_30020":72424,"_20858":124194,"_5":14334,"_27317":123697,"_2936":57772},[],{"_3450":72616,"_30020":72424,"_20858":124196,"_5":14334,"_27317":123697,"_2936":57775},[],{"_3450":72617,"_30020":72424,"_20858":124198,"_5":14334,"_27317":123697,"_2936":124199},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3450":72618,"_30020":72424,"_20858":124201,"_5":14334,"_27317":123697,"_2936":124202},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3450":72619,"_30020":72424,"_20858":124204,"_5":14334,"_27317":123697,"_2936":124205},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3450":72620,"_30020":72424,"_20858":124207,"_5":14334,"_27317":123701,"_2936":124208},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3450":72621,"_30020":72424,"_20858":124210,"_5":14334,"_27317":123701,"_2936":124211},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3450":72622,"_30020":72424,"_20858":124213,"_5":14334,"_27317":123701,"_2936":124214},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3450":72623,"_30020":72424,"_20858":124216,"_5":14334,"_27317":123705,"_2936":124217},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3450":72624,"_30020":72424,"_20858":124219,"_5":14334,"_27317":123709,"_2936":124220},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3450":72625,"_30020":72424,"_20858":124222,"_5":14334,"_27317":123713,"_2936":124223},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3450":72626,"_30020":72424,"_20858":124225,"_5":14334,"_27317":123717,"_2936":124226},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3450":72627,"_30020":72424,"_20858":124228,"_5":14334,"_27317":123717,"_2936":124229},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3450":72628,"_30020":72424,"_20858":124231,"_5":14334,"_27317":123717,"_2936":124232},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3450":72629,"_30020":72424,"_20858":124234,"_5":14334,"_27317":123717,"_2936":124235},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3450":72630,"_30020":72424,"_20858":124237,"_5":14334,"_27317":123721,"_2936":124238},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3450":72631,"_30020":72424,"_20858":124240,"_5":14334,"_27317":123725,"_2936":124241},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3450":72632,"_30020":72424,"_20858":124243,"_5":14334,"_27317":123725,"_2936":124244},[],"Ruta",{"_3450":72633,"_30020":72424,"_20858":124246,"_5":14334,"_27317":123725,"_2936":116831},[],{"_3450":72634,"_30020":72424,"_20858":124248,"_5":14334,"_27317":123725,"_2936":57828},[],{"_3450":72635,"_30020":72424,"_20858":124250,"_5":14334,"_27317":123725,"_2936":124251},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3450":72636,"_30020":72424,"_20858":124253,"_5":14334,"_27317":123725,"_2936":57834},[],{"_3450":72637,"_30020":72424,"_20858":124255,"_5":14334,"_27317":123725,"_2936":124256},[],"Lee los ajustes de una CA.",{"_3450":72638,"_30020":72424,"_20858":124258,"_5":14334,"_27317":123725,"_2936":57840},[],{"_3450":72639,"_30020":72424,"_20858":124260,"_5":14334,"_27317":123725,"_2936":124261},[],"Sustituye los `crl_options`.",{"_3450":72640,"_30020":72424,"_20858":124263,"_5":14334,"_27317":123725,"_2936":124264},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3450":72641,"_30020":72424,"_20858":124266,"_5":14334,"_27317":123725,"_2936":124267},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El monitor republica cada CRL migrada bajo el ID de CA en su primera ejecución, y la lista nueva incluye ambas URLs en su *Issuing Distribution Point*.",{"_3450":72642,"_30020":72424,"_20858":124269,"_5":14334,"_27317":123725,"_2936":124270},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3450":72643,"_30020":72424,"_20858":124272,"_5":14334,"_27317":123725,"_2936":124273},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3450":72644,"_30020":72424,"_20858":124275,"_5":14334,"_27317":123725,"_2936":124276},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3450":72645,"_30020":72424,"_20858":124278,"_5":14334,"_27317":123725,"_2936":124279},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3450":72646,"_30020":72424,"_20858":124281,"_5":14334,"_27317":123725,"_2936":124282},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3450":72647,"_30020":72424,"_20858":124284,"_5":14334,"_27317":123725,"_2936":124285},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3450":72648,"_30020":72424,"_20858":124287,"_5":14334,"_27317":123725,"_2936":124288},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3450":72649,"_30020":72424,"_20858":124290,"_5":14334,"_27317":123725,"_2936":124291},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3450":72650,"_30020":72424,"_20858":124293,"_5":14334,"_27317":123725,"_2936":124294},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Deben actualizarse las políticas que referencien la entidad antigua o que filtren por el firmante con su nombre anterior, `crl_signer_certificate_serial_number`.",{"_3450":72651,"_30020":72424,"_20858":124296,"_5":14334,"_27317":123729,"_2936":124297},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa cada condición que filtre por un campo del payload antiguo. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3450":72652,"_30020":72424,"_20858":124299,"_5":14334,"_27317":123733,"_2936":124300},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3450":72653,"_30020":72424,"_20858":124302,"_5":14334,"_27317":123737,"_2936":124303},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3450":72654,"_30020":72424,"_20858":124305,"_5":14334,"_27317":123741,"_2936":124306},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3450":72655,"_30020":72424,"_20858":124308,"_5":14334,"_27317":123741,"_2936":124309},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3450":72656,"_30020":72424,"_20858":124311,"_5":14334,"_27317":123741,"_2936":124312},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3450":72657,"_30020":72424,"_20858":124314,"_5":14334,"_27317":123741,"_2936":124315},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3450":72658,"_30020":72424,"_20858":124317,"_5":14334,"_27317":123741,"_2936":124318},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3450":72659,"_30020":72424,"_20858":124320,"_5":14334,"_27317":123741,"_2936":124321},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3450":72660,"_30020":72424,"_20858":124323,"_5":14334,"_27317":123745,"_2936":124324},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3450":72661,"_30020":72424,"_20858":124326,"_5":14334,"_27317":123745,"_2936":124327},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3450":72662,"_30020":72424,"_20858":124329,"_5":14334,"_27317":123745,"_2936":124330},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3450":72663,"_30020":72424,"_20858":124332,"_5":14334,"_27317":123745,"_2936":124333},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3450":72664,"_30020":72424,"_20858":124335,"_5":14334,"_27317":123745,"_2936":124336},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3450":72665,"_30020":72424,"_20858":124338,"_5":14334,"_27317":123749,"_2936":124339},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3450":72666,"_30020":72424,"_20858":124341,"_5":14334,"_27317":123749,"_2936":124342},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3450":72667,"_30020":72424,"_20858":124344,"_5":14334,"_27317":123749,"_2936":124345},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3450":72668,"_30020":72424,"_20858":124347,"_5":14334,"_27317":123749,"_2936":124348},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3450":72669,"_30020":72424,"_20858":124350,"_5":14334,"_27317":123749,"_2936":124351},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3450":72670,"_30020":72424,"_20858":124353,"_5":14334,"_27317":123749,"_2936":124354},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3450":72671,"_30020":72424,"_20858":124356,"_5":14334,"_27317":123749,"_2936":124357},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3450":72672,"_30020":72424,"_20858":124359,"_5":14334,"_27317":123749,"_2936":124360},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3450":72673,"_30020":72424,"_20858":124362,"_5":14334,"_27317":123749,"_2936":124363},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3450":72674,"_30020":72424,"_20858":124365,"_5":14334,"_27317":123749,"_2936":124366},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3450":72675,"_30020":72424,"_20858":124368,"_5":14334,"_27317":123749,"_2936":124369},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3450":72676,"_30020":72424,"_20858":124371,"_5":14334,"_27317":123749,"_2936":124372},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3450":72677,"_30020":72424,"_20858":124374,"_5":14334,"_27317":123753,"_2936":124375},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3450":72678,"_30020":72424,"_20858":124377,"_5":14334,"_27317":123753,"_2936":124378},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3450":72679,"_30020":72424,"_20858":124380,"_5":14334,"_27317":123757,"_2936":124381},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3450":72680,"_30020":72424,"_20858":124383,"_5":14334,"_27317":123757,"_2936":124384},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3450":72681,"_30020":72424,"_20858":124386,"_5":14334,"_27317":123757,"_2936":124387},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3450":72682,"_30020":72424,"_20858":124389,"_5":14334,"_27317":123757,"_2936":124390},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3450":72683,"_30020":72424,"_20858":124392,"_5":14334,"_27317":123757,"_2936":124393},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3450":72684,"_30020":72424,"_20858":124395,"_5":14334,"_27317":123757,"_2936":124396},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3450":72685,"_30020":72424,"_20858":124398,"_5":14334,"_27317":123757,"_2936":124399},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3450":72686,"_30020":72424,"_20858":124401,"_5":14334,"_27317":123757,"_2936":124402},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3450":72687,"_30020":72424,"_20858":124404,"_5":14334,"_27317":123757,"_2936":124405},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3450":72688,"_30020":72424,"_20858":124407,"_5":14334,"_27317":123757,"_2936":124408},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3450":72689,"_30020":72424,"_20858":124410,"_5":14334,"_27317":123757,"_2936":124411},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3450":72690,"_30020":72424,"_20858":124413,"_5":14334,"_27317":123761,"_2936":124414},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3450":72691,"_30020":72424,"_20858":124416,"_5":14334,"_27317":123761,"_2936":124417},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3450":72692,"_30020":72424,"_20858":124419,"_5":14334,"_27317":123765,"_2936":124420},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3450":72693,"_30020":72424,"_20858":124422,"_5":14334,"_27317":123765,"_2936":124423},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3450":72694,"_30020":72424,"_20858":124425,"_5":14334,"_27317":123765,"_2936":124426},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3450":72695,"_30020":72424,"_20858":124428,"_5":14334,"_27317":123765,"_2936":124429},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3450":72696,"_30020":72424,"_20858":124431,"_5":14334,"_27317":123765,"_2936":124432},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3450":72697,"_30020":72424,"_20858":124434,"_5":14334,"_27317":123765,"_2936":124435},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3450":72698,"_30020":72424,"_20858":124437,"_5":14334,"_27317":123765,"_2936":124438},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3450":72699,"_30020":72424,"_20858":124440,"_5":14334,"_27317":123769,"_2936":124441},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3450":72700,"_30020":72424,"_20858":124443,"_5":14334,"_27317":123769,"_2936":124444},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3450":72701,"_30020":72424,"_20858":124446,"_5":14334,"_27317":123769,"_2936":124447},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3450":72702,"_30020":72424,"_20858":124449,"_5":14334,"_27317":123769,"_2936":124450},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3450":72703,"_30020":72424,"_20858":124452,"_5":14334,"_27317":123769,"_2936":124453},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por varios roles de VA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3450":72704,"_30020":72424,"_20858":124455,"_5":14334,"_27317":123769,"_2936":124456},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3450":72705,"_30020":72424,"_20858":124458,"_5":14334,"_27317":123769,"_2936":124459},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3450":72706,"_30020":72424,"_20858":124461,"_5":14334,"_27317":123769,"_2936":124462},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3450":72707,"_30020":72424,"_20858":124464,"_5":14334,"_27317":123769,"_2936":124465},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3450":72708,"_30020":72424,"_20858":124467,"_5":14334,"_27317":123769,"_2936":124468},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `crl_signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3450":72709,"_30020":72424,"_20858":124470,"_5":14334,"_27317":123769,"_2936":124471},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3450":72710,"_30020":72424,"_20858":124473,"_5":14334,"_27317":123772,"_2936":124474},[],"Tras la actualización, comprueba en este orden:",{"_3450":72711,"_30020":72424,"_20858":124476,"_5":14334,"_27317":123772,"_2936":124477},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3450":72712,"_30020":72424,"_20858":124479,"_5":14334,"_27317":123772,"_2936":124480},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3450":72713,"_30020":72424,"_20858":124482,"_5":14334,"_27317":123772,"_2936":124483},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3450":72714,"_30020":72424,"_20858":124485,"_5":14334,"_27317":123772,"_2936":124486},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El monitor republica cada CRL bajo el ID de CA en su primera ejecución, y se emiten CRLs nuevas.",{"_3450":72715,"_30020":72424,"_20858":124488,"_5":14334,"_27317":123772,"_2936":124489},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y sus condiciones se han revisado contra el payload nuevo (`ca_id` en lugar de `ca_ski`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3450":72716,"_30020":72424,"_20858":124491,"_5":14334,"_27317":123772,"_2936":124492},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3450":72717,"_30020":72424,"_20858":124494,"_5":14334,"_27317":123772,"_2936":124495},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3450":72718,"_30020":72424,"_20858":124497,"_5":14334,"_27317":123772,"_2936":124498},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3450":72719,"_30020":72424,"_20858":124500,"_5":14334,"_27317":123772,"_2936":124501},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3450":72720,"_30020":72424,"_20858":124503,"_5":14334,"_27317":123772,"_2936":124504},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3450":72721,"_30020":72424,"_20858":124506,"_5":14334,"_27317":123772,"_2936":124507},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3450":72722,"_30020":72424,"_20858":124509,"_5":14334,"_27317":123772,"_2936":124510},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3450":72723,"_30020":72424,"_20858":124512,"_5":14334,"_27317":123772,"_2936":124513},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3450":72724,"_30020":72424,"_20858":124515,"_5":14334,"_27317":123772,"_2936":124516},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3450":72725,"_30020":72424,"_20858":124518,"_5":14334,"_27317":123772,"_2936":124519},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3450":72726,"_30020":72424,"_20858":124521,"_5":14334,"_27317":123776,"_2936":124522},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3450":72727,"_30020":72424,"_20858":124524,"_5":14334,"_27317":123776,"_2936":124525},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3450":72728,"_30020":72424,"_20858":124527,"_5":14334,"_27317":123776,"_2936":124528},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3450":72729,"_30020":72424,"_20858":124530,"_5":14334,"_27317":123776,"_2936":124531},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3450":72730,"_30020":72424,"_20858":124533,"_5":14334,"_27317":123776,"_2936":124534},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58119":124536,"_58121":124537,"_58123":124538,"_58125":124539,"_18074":2971,"_69808":2971},"spanish",[2936,30020,5,27317],{"_2936":24910,"_30020":24910,"_5":24910,"_27317":24910},{"_2936":124540,"_30020":127459,"_5":130378,"_27317":133297},{"_4620":124541,"_58129":124542,"_5":24910},{"_14410":10435,"_14791":4587,"_14810":5933,"_29023":7619,"_14797":6519,"_19790":6149,"_14431":18209,"_14438":11266,"_28965":3938,"_29374":7447,"_29395":10751,"_28999":3031,"_34357":5527,"_29102":20270,"_29439":9836,"_34364":22766,"_34367":5791,"_34370":5207,"_34373":18088,"_29846":3332,"_34378":9356,"_34380":7541,"_29876":11570,"_14806":18417,"_34384":7468,"_34387":6549,"_34389":3935,"_29423":6749,"_29841":11297,"_29889":17010,"_34394":3080,"_34396":15943,"_34398":6750,"_29119":6256,"_34401":4711,"_34403":3793,"_34405":14610,"_34407":5154,"_34409":3329,"_29036":4844,"_34412":3284,"_34414":5028,"_29030":6990,"_29460":11059,"_34418":3574,"_34420":10747,"_34423":4392,"_29076":6914,"_34427":4372,"_28956":18095,"_34430":10073,"_29004":3932,"_34433":24460,"_34435":6307,"_34438":5286,"_14800":3225,"_34441":4683,"_34443":6255,"_34446":15782,"_30079":21845,"_34449":12954,"_34451":19584,"_34453":10323,"_19793":3319,"_34456":5695,"_34458":4036,"_28977":17939,"_29417":10947,"_34462":20503,"_34464":4037,"_34466":7552,"_29906":22700,"_34469":11567,"_34471":4038,"_34473":7315,"_30000":5949,"_29476":3313,"_34477":6898,"_34479":12061,"_29014":4743,"_34482":4354,"_34484":3334,"_34486":5227,"_29922":7602,"_29096":10853,"_28431":6460,"_34491":3210,"_34493":7533,"_34495":4962,"_29145":4593,"_34499":4523,"_29411":6108,"_34503":24998,"_34505":21349,"_34507":7814,"_34509":4591,"_34511":7321,"_34513":3191,"_29134":3381,"_29379":4144,"_34517":4120,"_34519":6553,"_34521":3493,"_34524":5977,"_34526":7460,"_34528":3043,"_34530":7158,"_34532":3103,"_34534":6880,"_34536":7100,"_34539":4820,"_34541":4709,"_34543":18150,"_34545":4586,"_34547":25940,"_34550":24507,"_34552":5958,"_34555":20996,"_34558":6439,"_34560":11268,"_34562":6277,"_34564":5819,"_34566":7866,"_34568":49000,"_34570":7596,"_34572":5904,"_34574":14870,"_29422":5824,"_34577":4673,"_34579":16819,"_34581":7451,"_34583":3790,"_34585":3618,"_34587":6151,"_34589":6871,"_34591":5443,"_34593":9972,"_34595":5905,"_34597":4597,"_34599":5826,"_34601":3962,"_34603":9469,"_34605":8113,"_34607":4913,"_34609":18535