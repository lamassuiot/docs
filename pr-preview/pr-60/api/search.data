74":58255,"_40276":58258,"_40278":58261,"_40280":58264,"_40282":58267,"_40284":58270,"_40286":58273,"_40288":58276,"_40290":58279,"_40293":58282,"_40295":58285,"_40297":58288,"_40299":58291},{"_3461":15,"_30106":15,"_5":14715,"_2946":49155,"_30459":49156,"_20907":49160,"_27392":15},"Deploy from AWS Marketplace",[49157,49158,49159],"Docs","Deployment","Other models",[],{"_3461":16,"_30106":15,"_20907":49162,"_5":14363,"_27392":15,"_2946":49163},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3461":17,"_30106":15,"_5":30456,"_20907":49165,"_27392":49166,"_2946":49167},[],"/docs/pr-preview/pr-60/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3461":18,"_30106":15,"_5":30456,"_20907":49169,"_27392":49170,"_2946":49171},[],"/docs/pr-preview/pr-60/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3461":19,"_30106":15,"_5":30456,"_20907":49173,"_27392":49174,"_2946":49175},[],"/docs/pr-preview/pr-60/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3461":20,"_30106":15,"_5":30456,"_20907":49177,"_27392":49178,"_2946":49179},[],"/docs/pr-preview/pr-60/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3461":21,"_30106":15,"_5":30456,"_20907":49181,"_27392":49182,"_2946":49183},[],"/docs/pr-preview/pr-60/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3461":22,"_30106":15,"_5":30456,"_20907":49185,"_27392":49186,"_2946":49187},[],"/docs/pr-preview/pr-60/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3461":23,"_30106":15,"_5":30456,"_20907":49189,"_27392":49190,"_2946":49191},[],"/docs/pr-preview/pr-60/deployment/aws-marketplace#next-step","Next step",{"_3461":24,"_30106":15,"_20907":49193,"_5":14363,"_27392":15,"_2946":49194},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3461":25,"_30106":15,"_20907":49196,"_5":14363,"_27392":49166,"_2946":49197},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3461":26,"_30106":15,"_20907":49199,"_5":14363,"_27392":49166,"_2946":49200},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3461":27,"_30106":15,"_20907":49202,"_5":14363,"_27392":49166,"_2946":49203},[],"A security group allowing the necessary endpoints.",{"_3461":28,"_30106":15,"_20907":49205,"_5":14363,"_27392":49170,"_2946":49206},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3461":29,"_30106":15,"_20907":49208,"_5":14363,"_27392":49170,"_2946":49209},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3461":30,"_30106":15,"_20907":49211,"_5":14363,"_27392":49170,"_2946":49212},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3461":31,"_30106":15,"_20907":49214,"_5":14363,"_27392":49174,"_2946":49215},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3461":32,"_30106":15,"_20907":49217,"_5":14363,"_27392":49178,"_2946":49218},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3461":33,"_30106":15,"_20907":49220,"_5":14363,"_27392":49182,"_2946":49221},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3461":34,"_30106":15,"_20907":49223,"_5":14363,"_27392":49186,"_2946":49224},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3461":35,"_30106":15,"_20907":49226,"_5":14363,"_27392":49190,"_2946":49227},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3461":36,"_30106":36,"_5":14715,"_2946":49229,"_30459":49230,"_20907":49231,"_27392":36},"Deploy Lamassu",[49157,49158],[],{"_3461":37,"_30106":36,"_20907":49233,"_5":14363,"_27392":36,"_2946":49234},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3461":38,"_30106":36,"_5":30456,"_20907":49236,"_27392":49237,"_2946":49238},[],"/docs/pr-preview/pr-60/deployment/overview#choose-a-model","Choose a model",{"_3461":39,"_30106":36,"_5":30456,"_20907":49240,"_27392":49241,"_2946":49242},[],"/docs/pr-preview/pr-60/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3461":40,"_30106":36,"_5":30456,"_20907":49244,"_27392":49245,"_2946":49246},[],"/docs/pr-preview/pr-60/deployment/overview#after-deployment","After deployment",{"_3461":41,"_30106":36,"_20907":49248,"_5":14363,"_27392":36,"_2946":49249},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3461":42,"_30106":36,"_20907":49251,"_5":14363,"_27392":49237,"_2946":49252},[],"Model",{"_3461":43,"_30106":36,"_20907":49254,"_5":14363,"_27392":49237,"_2946":49255},[],"Recommended for",{"_3461":44,"_30106":36,"_20907":49257,"_5":14363,"_27392":49237,"_2946":49258},[],"Who operates the infrastructure",{"_3461":45,"_30106":36,"_20907":49260,"_5":14363,"_27392":49237,"_2946":49261},[],"Starting point",{"_3461":46,"_30106":36,"_20907":49263,"_5":14363,"_27392":49237,"_2946":49264},[],"Kubernetes self-managed",{"_3461":47,"_30106":36,"_20907":49266,"_5":14363,"_27392":49237,"_2946":49267},[],"Production, regulated environments and custom deployments",{"_3461":48,"_30106":36,"_20907":49269,"_5":14363,"_27392":49237,"_2946":49270},[],"Your team",{"_3461":49,"_30106":36,"_20907":49272,"_5":14363,"_27392":49237,"_2946":49273},[],"Helm or Fastlane",{"_3461":50,"_30106":36,"_20907":49275,"_5":14363,"_27392":49237,"_2946":49276},[],"AWS Marketplace",{"_3461":51,"_30106":36,"_20907":49278,"_5":14363,"_27392":49237,"_2946":49279},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3461":52,"_30106":36,"_20907":49281,"_5":14363,"_27392":49237,"_2946":49270},[],{"_3461":53,"_30106":36,"_20907":49283,"_5":14363,"_27392":49237,"_2946":49284},[],"Preconfigured image on EC2",{"_3461":54,"_30106":36,"_20907":49286,"_5":14363,"_27392":49237,"_2946":49287},[],"SaaS",{"_3461":55,"_30106":36,"_20907":49289,"_5":14363,"_27392":49237,"_2946":49290},[],"Teams that want to use the platform without operating it",{"_3461":56,"_30106":36,"_20907":49292,"_5":14363,"_27392":49237,"_2946":49293},[],"Lamassu",{"_3461":57,"_30106":36,"_20907":49295,"_5":14363,"_27392":49237,"_2946":49296},[],"Managed subscription",{"_3461":58,"_30106":36,"_20907":49298,"_5":14363,"_27392":49237,"_2946":49299},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3461":59,"_30106":36,"_20907":49301,"_5":14363,"_27392":49237,"_2946":49302},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3461":60,"_30106":36,"_20907":49304,"_5":14363,"_27392":49237,"_2946":49305},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3461":61,"_30106":36,"_20907":49307,"_5":14363,"_27392":49241,"_2946":49308},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3461":62,"_30106":36,"_20907":49310,"_5":14363,"_27392":49245,"_2946":49311},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3461":63,"_30106":63,"_5":14715,"_2946":49313,"_30459":49314,"_20907":49315,"_27392":63},"Use Lamassu as SaaS",[49157,49158,49159],[],{"_3461":64,"_30106":63,"_20907":49317,"_5":14363,"_27392":63,"_2946":49318},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3461":65,"_30106":63,"_5":30456,"_20907":49320,"_27392":49321,"_2946":49322},[],"/docs/pr-preview/pr-60/deployment/saas#what-the-service-manages","What the service manages",{"_3461":66,"_30106":63,"_5":30456,"_20907":49324,"_27392":49325,"_2946":49326},[],"/docs/pr-preview/pr-60/deployment/saas#plans","Plans",{"_3461":67,"_30106":63,"_5":30456,"_20907":49328,"_27392":49329,"_2946":49330},[],"/docs/pr-preview/pr-60/deployment/saas#request-access","Request access",{"_3461":68,"_30106":63,"_20907":49332,"_5":14363,"_27392":63,"_2946":49333},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3461":69,"_30106":63,"_20907":49335,"_5":14363,"_27392":49321,"_2946":49336},[],"Platform availability and maintenance.",{"_3461":70,"_30106":63,"_20907":49338,"_5":14363,"_27392":49321,"_2946":49339},[],"Automatic backups.",{"_3461":71,"_30106":63,"_20907":49341,"_5":14363,"_27392":49321,"_2946":49342},[],"Version upgrades.",{"_3461":72,"_30106":63,"_20907":49344,"_5":14363,"_27392":49321,"_2946":49345},[],"Technical support and SLA according to your plan.",{"_3461":73,"_30106":63,"_20907":49347,"_5":14363,"_27392":49325,"_2946":49348},[],"Plan",{"_3461":74,"_30106":63,"_20907":49350,"_5":14363,"_27392":49325,"_2946":49351},[],"Devices",{"_3461":75,"_30106":63,"_20907":49353,"_5":14363,"_27392":49325,"_2946":49354},[],"Support",{"_3461":76,"_30106":63,"_20907":49356,"_5":14363,"_27392":49325,"_2946":49357},[],"SLA",{"_3461":77,"_30106":63,"_20907":49359,"_5":14363,"_27392":49325,"_2946":49360},[],"Starter",{"_3461":78,"_30106":63,"_20907":49362,"_5":14363,"_27392":49325,"_2946":49363},[],"Up to 1,000",{"_3461":79,"_30106":63,"_20907":49365,"_5":14363,"_27392":49325,"_2946":49366},[],"Email",{"_3461":80,"_30106":63,"_20907":49368,"_5":14363,"_27392":49325,"_2946":49369},[],"99.5 %",{"_3461":81,"_30106":63,"_20907":49371,"_5":14363,"_27392":49325,"_2946":49372},[],"Professional",{"_3461":82,"_30106":63,"_20907":49374,"_5":14363,"_27392":49325,"_2946":49375},[],"Up to 10,000",{"_3461":83,"_30106":63,"_20907":49377,"_5":14363,"_27392":49325,"_2946":49378},[],"Email and chat",{"_3461":84,"_30106":63,"_20907":49380,"_5":14363,"_27392":49325,"_2946":49381},[],"99.9 %",{"_3461":85,"_30106":63,"_20907":49383,"_5":14363,"_27392":49325,"_2946":49384},[],"Enterprise",{"_3461":86,"_30106":63,"_20907":49386,"_5":14363,"_27392":49325,"_2946":49387},[],"Unlimited",{"_3461":87,"_30106":63,"_20907":49389,"_5":14363,"_27392":49325,"_2946":49390},[],"Dedicated",{"_3461":88,"_30106":63,"_20907":49392,"_5":14363,"_27392":49325,"_2946":49393},[],"99.99 %",{"_3461":89,"_30106":63,"_20907":49395,"_5":14363,"_27392":49329,"_2946":49396},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3461":90,"_30106":63,"_20907":49398,"_5":14363,"_27392":49329,"_2946":49399},[],"When you receive your instance's credentials, continue with Get started.",{"_3461":91,"_30106":91,"_5":14715,"_2946":49401,"_30459":49402,"_20907":49403,"_27392":91},"Fastlane",[49157,49158,49264],[],{"_3461":92,"_30106":91,"_20907":49405,"_5":14363,"_27392":91,"_2946":49406},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3461":93,"_30106":91,"_5":30456,"_20907":49408,"_27392":49409,"_2946":49410},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3461":94,"_30106":91,"_5":30456,"_20907":49412,"_27392":49413,"_2946":49414},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3461":95,"_30106":91,"_5":30456,"_20907":49416,"_27392":49417,"_2946":49167},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#before-you-begin",{"_3461":96,"_30106":91,"_5":30456,"_20907":49419,"_27392":49420,"_2946":49421},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3461":97,"_30106":91,"_5":30456,"_20907":49423,"_27392":49424,"_2946":49425},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3461":98,"_30106":91,"_5":30456,"_20907":49427,"_27392":49428,"_2946":49429},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3461":99,"_30106":91,"_5":30456,"_20907":49431,"_27392":49432,"_2946":49433},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3461":100,"_30106":91,"_5":30456,"_20907":49435,"_27392":49436,"_2946":49437},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3461":101,"_30106":91,"_5":30456,"_20907":49439,"_27392":49440,"_2946":49441},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3461":102,"_30106":91,"_5":30456,"_20907":49443,"_27392":49444,"_2946":49445},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3461":103,"_30106":91,"_5":30456,"_20907":49447,"_27392":49448,"_2946":49449},[],"/docs/pr-preview/pr-60/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3461":104,"_30106":91,"_20907":49451,"_5":14363,"_27392":49409,"_2946":49452},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3461":105,"_30106":91,"_20907":49454,"_5":14363,"_27392":49409,"_2946":49455},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3461":106,"_30106":91,"_20907":49457,"_5":14363,"_27392":49413,"_2946":49458},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3461":107,"_30106":91,"_20907":49460,"_5":14363,"_27392":49413,"_2946":49461},[],"Fastlane installs or configures",{"_3461":108,"_30106":91,"_20907":49463,"_5":14363,"_27392":49413,"_2946":49464},[],"You still provide",{"_3461":109,"_30106":91,"_20907":49466,"_5":14363,"_27392":49413,"_2946":49467},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3461":110,"_30106":91,"_20907":49469,"_5":14363,"_27392":49413,"_2946":49470},[],"The Kubernetes cluster, nodes and persistent storage",{"_3461":111,"_30106":91,"_20907":49472,"_5":14363,"_27392":49413,"_2946":49473},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3461":112,"_30106":91,"_20907":49475,"_5":14363,"_27392":49413,"_2946":49476},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3461":113,"_30106":91,"_20907":49478,"_5":14363,"_27392":49413,"_2946":49479},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3461":114,"_30106":91,"_20907":49481,"_5":14363,"_27392":49413,"_2946":49482},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3461":115,"_30106":91,"_20907":49484,"_5":14363,"_27392":49413,"_2946":49485},[],"Optional observability and lab HSM components",{"_3461":116,"_30106":91,"_20907":49487,"_5":14363,"_27392":49413,"_2946":49488},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3461":117,"_30106":91,"_20907":49490,"_5":14363,"_27392":49413,"_2946":49491},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3461":118,"_30106":91,"_20907":49493,"_5":14363,"_27392":49417,"_2946":49494},[],"You need:",{"_3461":119,"_30106":91,"_20907":49496,"_5":14363,"_27392":49417,"_2946":49497},[],"an existing Kubernetes cluster",{"_3461":120,"_30106":91,"_20907":49499,"_5":14363,"_27392":49417,"_2946":49500},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3461":121,"_30106":91,"_20907":49502,"_5":14363,"_27392":49417,"_2946":49503},[],"`yq`",{"_3461":122,"_30106":91,"_20907":49505,"_5":14363,"_27392":49417,"_2946":23628},[],{"_3461":123,"_30106":91,"_20907":49507,"_5":14363,"_27392":49417,"_2946":49508},[],"`jq` only when using `--sample-data` or `--development`",{"_3461":124,"_30106":91,"_20907":49510,"_5":14363,"_27392":49417,"_2946":49511},[],"`ssh-keygen` only when using `--with-hsm`",{"_3461":125,"_30106":91,"_20907":49513,"_5":14363,"_27392":49417,"_2946":49514},[],"free external ports 80 and 443 on a single-node K3s host",{"_3461":126,"_30106":91,"_20907":49516,"_5":14363,"_27392":49417,"_2946":49517},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3461":127,"_30106":91,"_20907":49519,"_5":14363,"_27392":49417,"_2946":49520},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3461":128,"_30106":91,"_20907":49522,"_5":14363,"_27392":49420,"_2946":49523},[],"Run the script from a clone of the Helm repository:",{"_3461":129,"_30106":91,"_20907":49525,"_5":14363,"_27392":49420,"_2946":49526},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3461":130,"_30106":91,"_20907":49528,"_5":14363,"_27392":49424,"_2946":49529},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3461":131,"_30106":91,"_20907":49531,"_5":14363,"_27392":49424,"_2946":49532},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3461":132,"_30106":91,"_20907":49534,"_5":14363,"_27392":49424,"_2946":49535},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3461":133,"_30106":91,"_20907":49537,"_5":14363,"_27392":49424,"_2946":49538},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3461":134,"_30106":91,"_20907":49540,"_5":14363,"_27392":49428,"_2946":49541},[],"Option",{"_3461":135,"_30106":91,"_20907":49543,"_5":14363,"_27392":49428,"_2946":49544},[],"Default",{"_3461":136,"_30106":91,"_20907":49546,"_5":14363,"_27392":49428,"_2946":49547},[],"Purpose",{"_3461":137,"_30106":91,"_20907":49549,"_5":14363,"_27392":49428,"_2946":49550},[],"`-h`, `--help`",{"_3461":138,"_30106":91,"_20907":49552,"_5":14363,"_27392":49428,"_2946":49553},[],"—",{"_3461":139,"_30106":91,"_20907":49555,"_5":14363,"_27392":49428,"_2946":49556},[],"Show help",{"_3461":140,"_30106":91,"_20907":49558,"_5":14363,"_27392":49428,"_2946":49559},[],"`-c`, `--context`",{"_3461":141,"_30106":91,"_20907":49561,"_5":14363,"_27392":49428,"_2946":49562},[],"current context",{"_3461":142,"_30106":91,"_20907":49564,"_5":14363,"_27392":49428,"_2946":49565},[],"Select the kubeconfig context for kubectl and Helm",{"_3461":143,"_30106":91,"_20907":49567,"_5":14363,"_27392":49428,"_2946":49568},[],"`-n`, `--non-interactive`",{"_3461":144,"_30106":91,"_20907":49570,"_5":14363,"_27392":49428,"_2946":6523},[],{"_3461":145,"_30106":91,"_20907":49572,"_5":14363,"_27392":49428,"_2946":49573},[],"Skip prompts and generate dependency credentials",{"_3461":146,"_30106":91,"_20907":49575,"_5":14363,"_27392":49428,"_2946":49576},[],"`-ns`, `--namespace`",{"_3461":147,"_30106":91,"_20907":49578,"_5":14363,"_27392":49428,"_2946":49579},[],"`lamassu-dev`",{"_3461":148,"_30106":91,"_20907":49581,"_5":14363,"_27392":49428,"_2946":49582},[],"Namespace for the installation",{"_3461":149,"_30106":91,"_20907":49584,"_5":14363,"_27392":49428,"_2946":49585},[],"`-d`, `--domain`",{"_3461":150,"_30106":91,"_20907":49587,"_5":14363,"_27392":49428,"_2946":49588},[],"`dev.lamassu.io`",{"_3461":151,"_30106":91,"_20907":49590,"_5":14363,"_27392":49428,"_2946":49591},[],"Domain used by the UI, OIDC and certificate",{"_3461":152,"_30106":91,"_20907":49593,"_5":14363,"_27392":49428,"_2946":49594},[],"`-v`, `--version`",{"_3461":153,"_30106":91,"_20907":49596,"_5":14363,"_27392":49428,"_2946":15061},[],{"_3461":154,"_30106":91,"_20907":49598,"_5":14363,"_27392":49428,"_2946":49599},[],"Lamassu chart version",{"_3461":155,"_30106":91,"_20907":49601,"_5":14363,"_27392":49428,"_2946":49602},[],"`--https-port`",{"_3461":156,"_30106":91,"_20907":49604,"_5":14363,"_27392":49428,"_2946":49605},[],"`443`",{"_3461":157,"_30106":91,"_20907":49607,"_5":14363,"_27392":49428,"_2946":49608},[],"Gateway HTTPS listener port",{"_3461":158,"_30106":91,"_20907":49610,"_5":14363,"_27392":49428,"_2946":49611},[],"`--http-port`",{"_3461":159,"_30106":91,"_20907":49613,"_5":14363,"_27392":49428,"_2946":49614},[],"`80`",{"_3461":160,"_30106":91,"_20907":49616,"_5":14363,"_27392":49428,"_2946":49617},[],"Gateway HTTP listener port",{"_3461":161,"_30106":91,"_20907":49619,"_5":14363,"_27392":49428,"_2946":49620},[],"`--tls-crt`",{"_3461":162,"_30106":91,"_20907":49622,"_5":14363,"_27392":49428,"_2946":49553},[],{"_3461":163,"_30106":91,"_20907":49624,"_5":14363,"_27392":49428,"_2946":49625},[],"PEM certificate for downstream TLS",{"_3461":164,"_30106":91,"_20907":49627,"_5":14363,"_27392":49428,"_2946":49628},[],"`--tls-key`",{"_3461":165,"_30106":91,"_20907":49630,"_5":14363,"_27392":49428,"_2946":49553},[],{"_3461":166,"_30106":91,"_20907":49632,"_5":14363,"_27392":49428,"_2946":49633},[],"PEM private key for downstream TLS",{"_3461":167,"_30106":91,"_20907":49635,"_5":14363,"_27392":49428,"_2946":49636},[],"`-l`, `--local-chart-path`",{"_3461":168,"_30106":91,"_20907":49638,"_5":14363,"_27392":49428,"_2946":49639},[],"repository chart",{"_3461":169,"_30106":91,"_20907":49641,"_5":14363,"_27392":49428,"_2946":49642},[],"Use an unpacked local Lamassu chart",{"_3461":170,"_30106":91,"_20907":49644,"_5":14363,"_27392":49428,"_2946":49645},[],"`-ip`, `--gateway-ip`",{"_3461":171,"_30106":91,"_20907":49647,"_5":14363,"_27392":49428,"_2946":8724},[],{"_3461":172,"_30106":91,"_20907":49649,"_5":14363,"_27392":49428,"_2946":49650},[],"Override the address written to `gateway.addresses`",{"_3461":173,"_30106":91,"_20907":49652,"_5":14363,"_27392":49428,"_2946":49653},[],"`--otel`",{"_3461":174,"_30106":91,"_20907":49655,"_5":14363,"_27392":49428,"_2946":6523},[],{"_3461":175,"_30106":91,"_20907":49657,"_5":14363,"_27392":49428,"_2946":49658},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3461":176,"_30106":91,"_20907":49660,"_5":14363,"_27392":49428,"_2946":49661},[],"`--development`",{"_3461":177,"_30106":91,"_20907":49663,"_5":14363,"_27392":49428,"_2946":6523},[],{"_3461":178,"_30106":91,"_20907":49665,"_5":14363,"_27392":49428,"_2946":49666},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3461":179,"_30106":91,"_20907":49668,"_5":14363,"_27392":49428,"_2946":49669},[],"`--sample-data`",{"_3461":180,"_30106":91,"_20907":49671,"_5":14363,"_27392":49428,"_2946":6523},[],{"_3461":181,"_30106":91,"_20907":49673,"_5":14363,"_27392":49428,"_2946":49674},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3461":182,"_30106":91,"_20907":49676,"_5":14363,"_27392":49428,"_2946":49677},[],"`--with-hsm`",{"_3461":183,"_30106":91,"_20907":49679,"_5":14363,"_27392":49428,"_2946":6523},[],{"_3461":184,"_30106":91,"_20907":49681,"_5":14363,"_27392":49428,"_2946":49682},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3461":185,"_30106":91,"_20907":49684,"_5":14363,"_27392":49428,"_2946":49685},[],"`--softhsm-chart-path`",{"_3461":186,"_30106":91,"_20907":49687,"_5":14363,"_27392":49428,"_2946":49688},[],"`./charts/softhsm`",{"_3461":187,"_30106":91,"_20907":49690,"_5":14363,"_27392":49428,"_2946":49691},[],"Use a different local SoftHSM chart",{"_3461":188,"_30106":91,"_20907":49693,"_5":14363,"_27392":49428,"_2946":49694},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3461":189,"_30106":91,"_20907":49696,"_5":14363,"_27392":49432,"_2946":49697},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3461":190,"_30106":91,"_20907":49699,"_5":14363,"_27392":49432,"_2946":49700},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3461":191,"_30106":91,"_20907":49702,"_5":14363,"_27392":49432,"_2946":49703},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3461":192,"_30106":91,"_20907":49705,"_5":14363,"_27392":49432,"_2946":49706},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3461":193,"_30106":91,"_20907":49708,"_5":14363,"_27392":49432,"_2946":49709},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3461":194,"_30106":91,"_20907":49711,"_5":14363,"_27392":49432,"_2946":49712},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3461":195,"_30106":91,"_20907":49714,"_5":14363,"_27392":49436,"_2946":49715},[],"Fastlane:",{"_3461":196,"_30106":91,"_20907":49717,"_5":14363,"_27392":49436,"_2946":49718},[],"validates local tools and the selected cluster",{"_3461":197,"_30106":91,"_20907":49720,"_5":14363,"_27392":49436,"_2946":49721},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3461":198,"_30106":91,"_20907":49723,"_5":14363,"_27392":49436,"_2946":49724},[],"creates the namespace",{"_3461":199,"_30106":91,"_20907":49726,"_5":14363,"_27392":49436,"_2946":49727},[],"installs PostgreSQL and creates the required databases",{"_3461":200,"_30106":91,"_20907":49729,"_5":14363,"_27392":49436,"_2946":49730},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3461":201,"_30106":91,"_20907":49732,"_5":14363,"_27392":49436,"_2946":49733},[],"installs RabbitMQ",{"_3461":202,"_30106":91,"_20907":49735,"_5":14363,"_27392":49436,"_2946":49736},[],"optionally installs observability and lab HSM components",{"_3461":203,"_30106":91,"_20907":49738,"_5":14363,"_27392":49436,"_2946":49739},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3461":204,"_30106":91,"_20907":49741,"_5":14363,"_27392":49436,"_2946":49742},[],"optionally loads sample data",{"_3461":205,"_30106":91,"_20907":49744,"_5":14363,"_27392":49436,"_2946":49745},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3461":206,"_30106":91,"_20907":49747,"_5":14363,"_27392":49440,"_2946":49748},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3461":207,"_30106":91,"_20907":49750,"_5":14363,"_27392":49440,"_2946":49751},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3461":208,"_30106":91,"_20907":49753,"_5":14363,"_27392":49444,"_2946":49754},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3461":209,"_30106":91,"_20907":49756,"_5":14363,"_27392":49444,"_2946":49757},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3461":210,"_30106":91,"_20907":49759,"_5":14363,"_27392":49444,"_2946":49760},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3461":211,"_30106":91,"_20907":49762,"_5":14363,"_27392":49448,"_2946":49763},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3461":212,"_30106":212,"_5":14715,"_2946":49765,"_30459":49766,"_20907":49767,"_27392":212},"Install with Helm",[49157,49158,49264],[],{"_3461":213,"_30106":212,"_20907":49769,"_5":14363,"_27392":212,"_2946":49770},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3461":214,"_30106":212,"_5":30456,"_20907":49772,"_27392":49773,"_2946":49774},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3461":215,"_30106":212,"_5":30456,"_20907":49776,"_27392":49777,"_2946":49167},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#before-you-begin",{"_3461":216,"_30106":212,"_5":30456,"_20907":49779,"_27392":49780,"_2946":49781},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3461":217,"_30106":212,"_5":30456,"_20907":49783,"_27392":49784,"_2946":49785},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3461":218,"_30106":212,"_5":30456,"_20907":49787,"_27392":49788,"_2946":49789},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3461":219,"_30106":212,"_5":30456,"_20907":49791,"_27392":49792,"_2946":49793},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3461":220,"_30106":212,"_5":30456,"_20907":49795,"_27392":49796,"_2946":49797},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3461":221,"_30106":212,"_5":30456,"_20907":49799,"_27392":49800,"_2946":49801},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3461":222,"_30106":212,"_5":30456,"_20907":49803,"_27392":49804,"_2946":49805},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3461":223,"_30106":212,"_5":30456,"_20907":49807,"_27392":49808,"_2946":49809},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3461":224,"_30106":212,"_5":30456,"_20907":49811,"_27392":49812,"_2946":49813},[],"/docs/pr-preview/pr-60/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3461":225,"_30106":212,"_20907":49815,"_5":14363,"_27392":49773,"_2946":49816},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3461":226,"_30106":212,"_20907":49818,"_5":14363,"_27392":49777,"_2946":49819},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3461":227,"_30106":212,"_20907":49821,"_5":14363,"_27392":49777,"_2946":49822},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3461":228,"_30106":212,"_20907":49824,"_5":14363,"_27392":49777,"_2946":49825},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3461":229,"_30106":212,"_20907":49827,"_5":14363,"_27392":49777,"_2946":49828},[],"a reachable RabbitMQ broker and credentials",{"_3461":230,"_30106":212,"_20907":49830,"_5":14363,"_27392":49777,"_2946":49831},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3461":231,"_30106":212,"_20907":49833,"_5":14363,"_27392":49777,"_2946":49834},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3461":232,"_30106":212,"_20907":49836,"_5":14363,"_27392":49777,"_2946":49837},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3461":233,"_30106":212,"_20907":49839,"_5":14363,"_27392":49777,"_2946":49840},[],"a StorageClass and an external traffic design",{"_3461":234,"_30106":212,"_20907":49842,"_5":14363,"_27392":49777,"_2946":49843},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3461":235,"_30106":212,"_20907":49845,"_5":14363,"_27392":49777,"_2946":49846},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3461":236,"_30106":212,"_20907":49848,"_5":14363,"_27392":49777,"_2946":49849},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3461":237,"_30106":212,"_20907":49851,"_5":14363,"_27392":49780,"_2946":49852},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3461":238,"_30106":212,"_20907":49854,"_5":14363,"_27392":49780,"_2946":49855},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3461":239,"_30106":212,"_20907":49857,"_5":14363,"_27392":49780,"_2946":49858},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3461":240,"_30106":212,"_20907":49860,"_5":14363,"_27392":49784,"_2946":49861},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3461":241,"_30106":212,"_20907":49863,"_5":14363,"_27392":49784,"_2946":49864},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3461":242,"_30106":212,"_20907":49866,"_5":14363,"_27392":49784,"_2946":49867},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3461":243,"_30106":212,"_20907":49869,"_5":14363,"_27392":49784,"_2946":49870},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3461":244,"_30106":212,"_20907":49872,"_5":14363,"_27392":49788,"_2946":49873},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3461":245,"_30106":212,"_20907":49875,"_5":14363,"_27392":49792,"_2946":49876},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3461":246,"_30106":212,"_20907":49878,"_5":14363,"_27392":49792,"_2946":49879},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3461":247,"_30106":212,"_20907":49881,"_5":14363,"_27392":49792,"_2946":49882},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3461":248,"_30106":212,"_20907":49884,"_5":14363,"_27392":49792,"_2946":49885},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3461":249,"_30106":212,"_20907":49887,"_5":14363,"_27392":49792,"_2946":49888},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3461":250,"_30106":212,"_20907":49890,"_5":14363,"_27392":49792,"_2946":49891},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3461":251,"_30106":212,"_20907":49893,"_5":14363,"_27392":49792,"_2946":49894},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3461":252,"_30106":212,"_20907":49896,"_5":14363,"_27392":49796,"_2946":49897},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3461":253,"_30106":212,"_20907":49899,"_5":14363,"_27392":49796,"_2946":49900},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3461":254,"_30106":212,"_20907":49902,"_5":14363,"_27392":49796,"_2946":49903},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3461":255,"_30106":212,"_20907":49905,"_5":14363,"_27392":49796,"_2946":49906},[],"See Access control for the principal and policy model.",{"_3461":256,"_30106":212,"_20907":49908,"_5":14363,"_27392":49800,"_2946":49909},[],"To install a local checkout instead:",{"_3461":257,"_30106":212,"_20907":49911,"_5":14363,"_27392":49804,"_2946":49912},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3461":258,"_30106":212,"_20907":49914,"_5":14363,"_27392":49804,"_2946":49915},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3461":259,"_30106":212,"_20907":49917,"_5":14363,"_27392":49808,"_2946":49918},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3461":260,"_30106":212,"_20907":49920,"_5":14363,"_27392":49808,"_2946":49921},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3461":261,"_30106":212,"_20907":49923,"_5":14363,"_27392":49808,"_2946":49924},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3461":262,"_30106":212,"_20907":49926,"_5":14363,"_27392":49808,"_2946":49927},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3461":263,"_30106":212,"_20907":49929,"_5":14363,"_27392":49808,"_2946":49930},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3461":264,"_30106":212,"_20907":49932,"_5":14363,"_27392":49812,"_2946":49933},[],"Before going live, review:",{"_3461":265,"_30106":212,"_20907":49935,"_5":14363,"_27392":49812,"_2946":49936},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3461":266,"_30106":212,"_20907":49938,"_5":14363,"_27392":49812,"_2946":49939},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3461":267,"_30106":212,"_20907":49941,"_5":14363,"_27392":49812,"_2946":49942},[],"shared VA storage before increasing VA replicas",{"_3461":268,"_30106":212,"_20907":49944,"_5":14363,"_27392":49812,"_2946":49945},[],"managed OIDC roles and removal of evaluation credentials",{"_3461":269,"_30106":212,"_20907":49947,"_5":14363,"_27392":49812,"_2946":49948},[],"a trusted TLS issuer or externally managed certificate",{"_3461":270,"_30106":212,"_20907":49950,"_5":14363,"_27392":49812,"_2946":49951},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3461":271,"_30106":212,"_20907":49953,"_5":14363,"_27392":49812,"_2946":49954},[],"SMTP, observability and alert delivery",{"_3461":272,"_30106":212,"_20907":49956,"_5":14363,"_27392":49812,"_2946":49957},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3461":273,"_30106":212,"_20907":49959,"_5":14363,"_27392":49812,"_2946":49960},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3461":274,"_30106":274,"_5":14715,"_2946":49962,"_30459":49963,"_20907":49964,"_27392":274},"Expose the Gateway",[49157,49158,49264],[],{"_3461":275,"_30106":274,"_20907":49966,"_5":14363,"_27392":274,"_2946":49967},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3461":276,"_30106":274,"_5":30456,"_20907":49969,"_27392":49970,"_2946":49971},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3461":277,"_30106":274,"_5":30456,"_20907":49973,"_27392":49974,"_2946":49975},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3461":278,"_30106":274,"_5":30456,"_20907":49977,"_27392":49978,"_2946":49979},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3461":279,"_30106":274,"_5":30456,"_20907":49981,"_27392":49982,"_2946":49983},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#k3s","K3s",{"_3461":280,"_30106":274,"_5":30456,"_20907":49985,"_27392":49986,"_2946":49987},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3461":281,"_30106":274,"_5":30456,"_20907":49989,"_27392":49990,"_2946":49991},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3461":282,"_30106":274,"_5":30456,"_20907":49993,"_27392":49994,"_2946":49995},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3461":283,"_30106":274,"_5":30456,"_20907":49997,"_27392":49998,"_2946":49999},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3461":284,"_30106":274,"_5":30456,"_20907":50001,"_27392":50002,"_2946":50003},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3461":285,"_30106":274,"_5":30456,"_20907":50005,"_27392":50006,"_2946":50007},[],"/docs/pr-preview/pr-60/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3461":286,"_30106":274,"_20907":50009,"_5":14363,"_27392":49970,"_2946":50010},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3461":287,"_30106":274,"_20907":50012,"_5":14363,"_27392":49970,"_2946":50013},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3461":288,"_30106":274,"_20907":50015,"_5":14363,"_27392":49974,"_2946":50016},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3461":289,"_30106":274,"_20907":50018,"_5":14363,"_27392":49974,"_2946":50019},[],"Set it only when:",{"_3461":290,"_30106":274,"_20907":50021,"_5":14363,"_27392":49974,"_2946":50022},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3461":291,"_30106":274,"_20907":50024,"_5":14363,"_27392":49974,"_2946":50025},[],"that address is allocated to this Gateway",{"_3461":292,"_30106":274,"_20907":50027,"_5":14363,"_27392":49974,"_2946":50028},[],"the surrounding network already routes traffic for it to the cluster",{"_3461":293,"_30106":274,"_20907":50030,"_5":14363,"_27392":49974,"_2946":50031},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3461":294,"_30106":274,"_20907":50033,"_5":14363,"_27392":49974,"_2946":50034},[],"Keep these two settings separate:",{"_3461":295,"_30106":274,"_20907":50036,"_5":14363,"_27392":49974,"_2946":50037},[],"`gateway.addresses` requests an address for the Gateway.",{"_3461":296,"_30106":274,"_20907":50039,"_5":14363,"_27392":49974,"_2946":50040},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3461":297,"_30106":274,"_20907":50042,"_5":14363,"_27392":49974,"_2946":50043},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3461":298,"_30106":274,"_20907":50045,"_5":14363,"_27392":49978,"_2946":50046},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3461":299,"_30106":274,"_20907":50048,"_5":14363,"_27392":49978,"_2946":50049},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3461":300,"_30106":274,"_20907":50051,"_5":14363,"_27392":49982,"_2946":50052},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3461":301,"_30106":274,"_20907":50054,"_5":14363,"_27392":49982,"_2946":50055},[],"For the recommended design:",{"_3461":302,"_30106":274,"_20907":50057,"_5":14363,"_27392":49982,"_2946":50058},[],"Use only one externally exposed Lamassu Gateway.",{"_3461":303,"_30106":274,"_20907":50060,"_5":14363,"_27392":49982,"_2946":50061},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3461":304,"_30106":274,"_20907":50063,"_5":14363,"_27392":49982,"_2946":50064},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3461":305,"_30106":274,"_20907":50066,"_5":14363,"_27392":49982,"_2946":50067},[],"Point DNS at the VM's reachable address.",{"_3461":306,"_30106":274,"_20907":50069,"_5":14363,"_27392":49982,"_2946":50070},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3461":307,"_30106":274,"_20907":50072,"_5":14363,"_27392":49986,"_2946":50073},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3461":308,"_30106":274,"_20907":50075,"_5":14363,"_27392":49990,"_2946":50076},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3461":309,"_30106":274,"_20907":50078,"_5":14363,"_27392":49990,"_2946":50079},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3461":310,"_30106":274,"_20907":50081,"_5":14363,"_27392":49994,"_2946":50082},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3461":311,"_30106":274,"_20907":50084,"_5":14363,"_27392":49994,"_2946":50085},[],"Requirement",{"_3461":312,"_30106":274,"_20907":50087,"_5":14363,"_27392":49994,"_2946":50088},[],"Recommended design",{"_3461":313,"_30106":274,"_20907":50090,"_5":14363,"_27392":49994,"_2946":50091},[],"Consequence",{"_3461":314,"_30106":274,"_20907":50093,"_5":14363,"_27392":49994,"_2946":50094},[],"Several Lamassu URLs or services",{"_3461":315,"_30106":274,"_20907":50096,"_5":14363,"_27392":49994,"_2946":50097},[],"One Gateway with multiple routes",{"_3461":316,"_30106":274,"_20907":50099,"_5":14363,"_27392":49994,"_2946":50100},[],"One IP and one proxy fleet; this is the chart default",{"_3461":317,"_30106":274,"_20907":50102,"_5":14363,"_27392":49994,"_2946":50103},[],"Independent Gateways and separate external IPs",{"_3461":318,"_30106":274,"_20907":50105,"_5":14363,"_27392":49994,"_2946":50106},[],"One VIP per Gateway",{"_3461":319,"_30106":274,"_20907":50108,"_5":14363,"_27392":49994,"_2946":50109},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3461":320,"_30106":274,"_20907":50111,"_5":14363,"_27392":49994,"_2946":50112},[],"Independent Gateways on one node and one IP",{"_3461":321,"_30106":274,"_20907":50114,"_5":14363,"_27392":49994,"_2946":50115},[],"Use different external ports",{"_3461":322,"_30106":274,"_20907":50117,"_5":14363,"_27392":49994,"_2946":50118},[],"Clients must include non-standard ports",{"_3461":323,"_30106":274,"_20907":50120,"_5":14363,"_27392":49994,"_2946":50121},[],"Separate TLS/mTLS termination behind one IP",{"_3461":324,"_30106":274,"_20907":50123,"_5":14363,"_27392":49994,"_2946":50124},[],"Front-door SNI routing to internal Gateways",{"_3461":325,"_30106":274,"_20907":50126,"_5":14363,"_27392":49994,"_2946":50127},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3461":326,"_30106":274,"_20907":50129,"_5":14363,"_27392":49994,"_2946":50130},[],"Separate Gateway resources but shared proxy infrastructure",{"_3461":327,"_30106":274,"_20907":50132,"_5":14363,"_27392":49994,"_2946":50133},[],"Envoy merged-Gateway mode",{"_3461":328,"_30106":274,"_20907":50135,"_5":14363,"_27392":49994,"_2946":50136},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3461":329,"_30106":274,"_20907":50138,"_5":14363,"_27392":49994,"_2946":50139},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3461":330,"_30106":274,"_20907":50141,"_5":14363,"_27392":49994,"_2946":50142},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3461":331,"_30106":274,"_20907":50144,"_5":14363,"_27392":49994,"_2946":50145},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3461":332,"_30106":274,"_20907":50147,"_5":14363,"_27392":49994,"_2946":50148},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3461":333,"_30106":274,"_20907":50150,"_5":14363,"_27392":49998,"_2946":50151},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3461":334,"_30106":274,"_20907":50153,"_5":14363,"_27392":49998,"_2946":50154},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3461":335,"_30106":274,"_20907":50156,"_5":14363,"_27392":49998,"_2946":50157},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3461":336,"_30106":274,"_20907":50159,"_5":14363,"_27392":49998,"_2946":50160},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3461":337,"_30106":274,"_20907":50162,"_5":14363,"_27392":49998,"_2946":50163},[],"If none of those are possible, use different external ports or change the external network design.",{"_3461":338,"_30106":274,"_20907":50165,"_5":14363,"_27392":50002,"_2946":50166},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3461":339,"_30106":274,"_20907":50168,"_5":14363,"_27392":50002,"_2946":50169},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3461":340,"_30106":274,"_20907":50171,"_5":14363,"_27392":50006,"_2946":50172},[],"Check, in order:",{"_3461":341,"_30106":274,"_20907":50174,"_5":14363,"_27392":50006,"_2946":50175},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3461":342,"_30106":274,"_20907":50177,"_5":14363,"_27392":50006,"_2946":50178},[],"Its status contains the expected address.",{"_3461":343,"_30106":274,"_20907":50180,"_5":14363,"_27392":50006,"_2946":50181},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3461":344,"_30106":274,"_20907":50183,"_5":14363,"_27392":50006,"_2946":50184},[],"Port 443 reaches that address from the client network.",{"_3461":345,"_30106":274,"_20907":50186,"_5":14363,"_27392":50006,"_2946":50187},[],"DNS resolves to the externally reachable endpoint.",{"_3461":346,"_30106":274,"_20907":50189,"_5":14363,"_27392":50006,"_2946":50190},[],"The certificate contains the DNS name or IP used by the client.",{"_3461":347,"_30106":274,"_20907":50192,"_5":14363,"_27392":50006,"_2946":50193},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3461":348,"_30106":348,"_5":14715,"_2946":49264,"_30459":50195,"_20907":50196,"_27392":348},[49157,49158,49264],[],{"_3461":349,"_30106":348,"_20907":50198,"_5":14363,"_27392":348,"_2946":50199},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3461":350,"_30106":348,"_5":30456,"_20907":50201,"_27392":50202,"_2946":50203},[],"/docs/pr-preview/pr-60/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3461":351,"_30106":348,"_5":30456,"_20907":50205,"_27392":50206,"_2946":50207},[],"/docs/pr-preview/pr-60/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3461":352,"_30106":348,"_5":30456,"_20907":50209,"_27392":50210,"_2946":50211},[],"/docs/pr-preview/pr-60/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3461":353,"_30106":348,"_5":30456,"_20907":50213,"_27392":50214,"_2946":50215},[],"/docs/pr-preview/pr-60/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3461":354,"_30106":348,"_5":30456,"_20907":50217,"_27392":50218,"_2946":50219},[],"/docs/pr-preview/pr-60/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3461":355,"_30106":348,"_5":30456,"_20907":50221,"_27392":50222,"_2946":50223},[],"/docs/pr-preview/pr-60/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3461":356,"_30106":348,"_20907":50225,"_5":14363,"_27392":50202,"_2946":50226},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3461":357,"_30106":348,"_20907":50228,"_5":14363,"_27392":50206,"_2946":50229},[],"Workflow",{"_3461":358,"_30106":348,"_20907":50231,"_5":14363,"_27392":50206,"_2946":50232},[],"Use it for",{"_3461":359,"_30106":348,"_20907":50234,"_5":14363,"_27392":50206,"_2946":50235},[],"What it installs",{"_3461":360,"_30106":348,"_20907":50237,"_5":14363,"_27392":50206,"_2946":50238},[],"Helm",{"_3461":361,"_30106":348,"_20907":50240,"_5":14363,"_27392":50206,"_2946":50241},[],"Production and controlled environments",{"_3461":362,"_30106":348,"_20907":50243,"_5":14363,"_27392":50206,"_2946":50244},[],"Lamassu services and Gateway API resources",{"_3461":363,"_30106":348,"_20907":50246,"_5":14363,"_27392":50206,"_2946":49401},[],{"_3461":364,"_30106":348,"_20907":50248,"_5":14363,"_27392":50206,"_2946":50249},[],"Evaluation, demos, CI and small lab clusters",{"_3461":365,"_30106":348,"_20907":50251,"_5":14363,"_27392":50206,"_2946":50252},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3461":366,"_30106":348,"_20907":50254,"_5":14363,"_27392":50210,"_2946":50255},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3461":367,"_30106":348,"_20907":50257,"_5":14363,"_27392":50210,"_2946":50258},[],"Area",{"_3461":368,"_30106":348,"_20907":50260,"_5":14363,"_27392":50210,"_2946":50261},[],"The Lamassu chart provides",{"_3461":369,"_30106":348,"_20907":50263,"_5":14363,"_27392":50210,"_2946":50264},[],"You provide",{"_3461":370,"_30106":348,"_20907":50266,"_5":14363,"_27392":50210,"_2946":50267},[],"Lamassu applications",{"_3461":371,"_30106":348,"_20907":50269,"_5":14363,"_27392":50210,"_2946":50270},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3461":372,"_30106":348,"_20907":50272,"_5":14363,"_27392":50210,"_2946":50273},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3461":373,"_30106":348,"_20907":50275,"_5":14363,"_27392":50210,"_2946":50276},[],"PostgreSQL data",{"_3461":374,"_30106":348,"_20907":50278,"_5":14363,"_27392":50210,"_2946":50279},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3461":375,"_30106":348,"_20907":50281,"_5":14363,"_27392":50210,"_2946":50282},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3461":376,"_30106":348,"_20907":50284,"_5":14363,"_27392":50210,"_2946":50285},[],"Messaging",{"_3461":377,"_30106":348,"_20907":50287,"_5":14363,"_27392":50210,"_2946":50288},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3461":378,"_30106":348,"_20907":50290,"_5":14363,"_27392":50210,"_2946":50291},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3461":379,"_30106":348,"_20907":50293,"_5":14363,"_27392":50210,"_2946":50294},[],"Identity",{"_3461":380,"_30106":348,"_20907":50296,"_5":14363,"_27392":50210,"_2946":50297},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3461":381,"_30106":348,"_20907":50299,"_5":14363,"_27392":50210,"_2946":50300},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3461":382,"_30106":348,"_20907":50302,"_5":14363,"_27392":50210,"_2946":50303},[],"External routing",{"_3461":383,"_30106":348,"_20907":50305,"_5":14363,"_27392":50210,"_2946":50306},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3461":384,"_30106":348,"_20907":50308,"_5":14363,"_27392":50210,"_2946":50309},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3461":385,"_30106":348,"_20907":50311,"_5":14363,"_27392":50210,"_2946":50312},[],"TLS",{"_3461":386,"_30106":348,"_20907":50314,"_5":14363,"_27392":50210,"_2946":50315},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3461":387,"_30106":348,"_20907":50317,"_5":14363,"_27392":50210,"_2946":50318},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3461":388,"_30106":348,"_20907":50320,"_5":14363,"_27392":50210,"_2946":50321},[],"Persistent application data",{"_3461":389,"_30106":348,"_20907":50323,"_5":14363,"_27392":50210,"_2946":50324},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3461":390,"_30106":348,"_20907":50326,"_5":14363,"_27392":50210,"_2946":50327},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3461":391,"_30106":348,"_20907":50329,"_5":14363,"_27392":50210,"_2946":50330},[],"Optional integrations",{"_3461":392,"_30106":348,"_20907":50332,"_5":14363,"_27392":50210,"_2946":50333},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3461":393,"_30106":348,"_20907":50335,"_5":14363,"_27392":50210,"_2946":50336},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3461":394,"_30106":348,"_20907":50338,"_5":14363,"_27392":50210,"_2946":50339},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3461":395,"_30106":348,"_20907":50341,"_5":14363,"_27392":50210,"_2946":50342},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3461":396,"_30106":348,"_20907":50344,"_5":14363,"_27392":50214,"_2946":50345},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3461":397,"_30106":348,"_20907":50347,"_5":14363,"_27392":50214,"_2946":50348},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3461":398,"_30106":348,"_20907":50350,"_5":14363,"_27392":50218,"_2946":50351},[],"Kubernetes 1.24 or newer",{"_3461":399,"_30106":348,"_20907":50353,"_5":14363,"_27392":50218,"_2946":50354},[],"Helm 3.2 or newer",{"_3461":400,"_30106":348,"_20907":50356,"_5":14363,"_27392":50218,"_2946":50357},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3461":401,"_30106":348,"_20907":50359,"_5":14363,"_27392":50218,"_2946":50360},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3461":402,"_30106":348,"_20907":50362,"_5":14363,"_27392":50218,"_2946":50363},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3461":403,"_30106":348,"_20907":50365,"_5":14363,"_27392":50218,"_2946":50366},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3461":404,"_30106":348,"_20907":50368,"_5":14363,"_27392":50218,"_2946":50369},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3461":405,"_30106":348,"_20907":50371,"_5":14363,"_27392":50222,"_2946":50372},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3461":406,"_30106":348,"_20907":50374,"_5":14363,"_27392":50222,"_2946":50375},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3461":407,"_30106":348,"_20907":50377,"_5":14363,"_27392":50222,"_2946":50378},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3461":408,"_30106":348,"_20907":50380,"_5":14363,"_27392":50222,"_2946":50381},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3461":409,"_30106":409,"_5":14715,"_2946":50383,"_30459":50384,"_20907":50386,"_27392":409},"Deployment troubleshooting",[49157,49158,50385],"Operations",[],{"_3461":410,"_30106":409,"_20907":50388,"_5":14363,"_27392":409,"_2946":50389},[],"Diagnose access, service health and infrastructure dependencies.",{"_3461":411,"_30106":409,"_5":30456,"_20907":50391,"_27392":50392,"_2946":50393},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3461":412,"_30106":409,"_5":30456,"_20907":50395,"_27392":50396,"_2946":50397},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3461":413,"_30106":409,"_5":30456,"_20907":50399,"_27392":50400,"_2946":50401},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3461":414,"_30106":409,"_5":30456,"_20907":50403,"_27392":50404,"_2946":50405},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3461":415,"_30106":409,"_5":30456,"_20907":50407,"_27392":50408,"_2946":50409},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3461":416,"_30106":409,"_5":30456,"_20907":50411,"_27392":50412,"_2946":50413},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3461":417,"_30106":409,"_5":30456,"_20907":50415,"_27392":50416,"_2946":50417},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3461":418,"_30106":409,"_5":30456,"_20907":50419,"_27392":50420,"_2946":50421},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3461":419,"_30106":409,"_5":30456,"_20907":50423,"_27392":50424,"_2946":50425},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3461":420,"_30106":409,"_5":30456,"_20907":50427,"_27392":50428,"_2946":50429},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3461":421,"_30106":409,"_5":30456,"_20907":50431,"_27392":50432,"_2946":50433},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3461":422,"_30106":409,"_5":30456,"_20907":50435,"_27392":50436,"_2946":50437},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3461":423,"_30106":409,"_5":30456,"_20907":50439,"_27392":50440,"_2946":50441},[],"/docs/pr-preview/pr-60/deployment/troubleshooting#observability","Observability",{"_3461":424,"_30106":409,"_20907":50443,"_5":14363,"_27392":409,"_2946":50444},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3461":425,"_30106":409,"_20907":50446,"_5":14363,"_27392":50396,"_2946":50447},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3461":426,"_30106":409,"_20907":50449,"_5":14363,"_27392":50400,"_2946":50450},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3461":427,"_30106":409,"_20907":50452,"_5":14363,"_27392":50404,"_2946":50453},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3461":428,"_30106":409,"_20907":50455,"_5":14363,"_27392":50408,"_2946":50456},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3461":429,"_30106":409,"_20907":50458,"_5":14363,"_27392":50412,"_2946":50459},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3461":430,"_30106":409,"_20907":50461,"_5":14363,"_27392":50416,"_2946":50462},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3461":431,"_30106":409,"_20907":50464,"_5":14363,"_27392":50416,"_2946":50465},[],"Also run the chart's connectivity test:",{"_3461":432,"_30106":409,"_20907":50467,"_5":14363,"_27392":50416,"_2946":50468},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3461":433,"_30106":409,"_20907":50470,"_5":14363,"_27392":50416,"_2946":50471},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3461":434,"_30106":409,"_20907":50473,"_5":14363,"_27392":50420,"_2946":50474},[],"If you receive a 401:",{"_3461":435,"_30106":409,"_20907":50476,"_5":14363,"_27392":50420,"_2946":50477},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3461":436,"_30106":409,"_20907":50479,"_5":14363,"_27392":50420,"_2946":50480},[],"verify issuer, audience and expiration of the token;",{"_3461":437,"_30106":409,"_20907":50482,"_5":14363,"_27392":50420,"_2946":50483},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3461":438,"_30106":409,"_20907":50485,"_5":14363,"_27392":50420,"_2946":50486},[],"check that the provider's public and internal routes point to the same realm.",{"_3461":439,"_30106":409,"_20907":50488,"_5":14363,"_27392":50420,"_2946":50489},[],"If login succeeds but the APIs return 403:",{"_3461":440,"_30106":409,"_20907":50491,"_5":14363,"_27392":50420,"_2946":50492},[],"inspect the token's real claims;",{"_3461":441,"_30106":409,"_20907":50494,"_5":14363,"_27392":50420,"_2946":50495},[],"confirm they match an active principal;",{"_3461":442,"_30106":409,"_20907":50497,"_5":14363,"_27392":50420,"_2946":50498},[],"review the policies granted to that principal;",{"_3461":443,"_30106":409,"_20907":50500,"_5":14363,"_27392":50420,"_2946":50501},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3461":444,"_30106":409,"_20907":50503,"_5":14363,"_27392":50420,"_2946":50504},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3461":445,"_30106":409,"_20907":50506,"_5":14363,"_27392":50424,"_2946":50507},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3461":446,"_30106":409,"_20907":50509,"_5":14363,"_27392":50424,"_2946":50510},[],"Locate the authz pod and Service.",{"_3461":447,"_30106":409,"_20907":50512,"_5":14363,"_27392":50424,"_2946":50513},[],"Check /health, logs and its database connection.",{"_3461":448,"_30106":409,"_20907":50515,"_5":14363,"_27392":50424,"_2946":50516},[],"Verify the DNS and port configured in externalAuthorization.",{"_3461":449,"_30106":409,"_20907":50518,"_5":14363,"_27392":50424,"_2946":50519},[],"Check the check route is /v1/ext\\_authz/check.",{"_3461":450,"_30106":409,"_20907":50521,"_5":14363,"_27392":50424,"_2946":50522},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3461":451,"_30106":409,"_20907":50524,"_5":14363,"_27392":50428,"_2946":50525},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3461":452,"_30106":409,"_20907":50527,"_5":14363,"_27392":50432,"_2946":50528},[],"Review kubectl describe pod first. Common causes are:",{"_3461":453,"_30106":409,"_20907":50530,"_5":14363,"_27392":50432,"_2946":50531},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3461":454,"_30106":409,"_20907":50533,"_5":14363,"_27392":50432,"_2946":50534},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3461":455,"_30106":409,"_20907":50536,"_5":14363,"_27392":50432,"_2946":50537},[],"unbound persistent volume;",{"_3461":456,"_30106":409,"_20907":50539,"_5":14363,"_27392":50432,"_2946":50540},[],"inaccessible image or incorrect pull policy;",{"_3461":457,"_30106":409,"_20907":50542,"_5":14363,"_27392":50432,"_2946":50543},[],"invalid cryptographic engine configuration;",{"_3461":458,"_30106":409,"_20907":50545,"_5":14363,"_27392":50432,"_2946":50546},[],"CPU or memory limits set too low;",{"_3461":459,"_30106":409,"_20907":50548,"_5":14363,"_27392":50432,"_2946":50549},[],"an incomplete prior migration.",{"_3461":460,"_30106":409,"_20907":50551,"_5":14363,"_27392":50432,"_2946":50552},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3461":461,"_30106":409,"_20907":50554,"_5":14363,"_27392":50432,"_2946":50555},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3461":462,"_30106":409,"_20907":50557,"_5":14363,"_27392":50432,"_2946":50558},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3461":463,"_30106":409,"_20907":50560,"_5":14363,"_27392":50436,"_2946":50561},[],"Domain and audit events depend on the bus publisher:",{"_3461":464,"_30106":409,"_20907":50563,"_5":14363,"_27392":50436,"_2946":50564},[],"verify it is enabled in the emitting service;",{"_3461":465,"_30106":409,"_20907":50566,"_5":14363,"_27392":50436,"_2946":50567},[],"check AMQP connectivity and credentials;",{"_3461":466,"_30106":409,"_20907":50569,"_5":14363,"_27392":50436,"_2946":50570},[],"review exchange, routing key, queues and consumers;",{"_3461":467,"_30106":409,"_20907":50572,"_5":14363,"_27392":50436,"_2946":50573},[],"inspect dead-letter queues;",{"_3461":468,"_30106":409,"_20907":50575,"_5":14363,"_27392":50436,"_2946":50576},[],"alert on orphan durable queues and backlog growth.",{"_3461":469,"_30106":409,"_20907":50578,"_5":14363,"_27392":50436,"_2946":50579},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3461":470,"_30106":409,"_20907":50581,"_5":14363,"_27392":50436,"_2946":50582},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3461":471,"_30106":409,"_20907":50584,"_5":14363,"_27392":50436,"_2946":50585},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3461":472,"_30106":409,"_20907":50587,"_5":14363,"_27392":50436,"_2946":50588},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3461":473,"_30106":409,"_20907":50590,"_5":14363,"_27392":50436,"_2946":50591},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3461":474,"_30106":409,"_20907":50593,"_5":14363,"_27392":50436,"_2946":50594},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3461":475,"_30106":409,"_20907":50596,"_5":14363,"_27392":50436,"_2946":50597},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3461":476,"_30106":409,"_20907":50599,"_5":14363,"_27392":50440,"_2946":50600},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3461":477,"_30106":409,"_20907":50602,"_5":14363,"_27392":50440,"_2946":50603},[],"Before closing an incident, record:",{"_3461":478,"_30106":409,"_20907":50605,"_5":14363,"_27392":50440,"_2946":50606},[],"the confirmed cause;",{"_3461":479,"_30106":409,"_20907":50608,"_5":14363,"_27392":50440,"_2946":50609},[],"the time scope and affected resources;",{"_3461":480,"_30106":409,"_20907":50611,"_5":14363,"_27392":50440,"_2946":50612},[],"the commands or queries used;",{"_3461":481,"_30106":409,"_20907":50614,"_5":14363,"_27392":50440,"_2946":50615},[],"the applied change and how to revert it;",{"_3461":482,"_30106":409,"_20907":50617,"_5":14363,"_27392":50440,"_2946":50618},[],"validation from a consumer;",{"_3461":483,"_30106":409,"_20907":50620,"_5":14363,"_27392":50440,"_2946":50621},[],"the preventive action and its owner.",{"_3461":484,"_30106":484,"_5":14715,"_2946":50623,"_30459":50624,"_20907":50627,"_27392":484},"Access control",[49157,50625,50626],"Platform","Administration",[],{"_3461":485,"_30106":484,"_20907":50629,"_5":14363,"_27392":484,"_2946":50630},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3461":486,"_30106":484,"_5":30456,"_20907":50632,"_27392":50633,"_2946":50634},[],"/docs/pr-preview/pr-60/platform/administration/access-control#essential-concepts","Essential concepts",{"_3461":487,"_30106":484,"_5":30456,"_20907":50636,"_27392":50637,"_2946":50638},[],"/docs/pr-preview/pr-60/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3461":488,"_30106":484,"_5":30456,"_20907":50640,"_27392":50641,"_2946":50642},[],"/docs/pr-preview/pr-60/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3461":489,"_30106":484,"_5":30456,"_20907":50644,"_27392":50645,"_2946":50646},[],"/docs/pr-preview/pr-60/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3461":490,"_30106":484,"_5":30456,"_20907":50648,"_27392":50649,"_2946":50650},[],"/docs/pr-preview/pr-60/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3461":491,"_30106":484,"_5":30456,"_20907":50652,"_27392":50653,"_2946":50654},[],"/docs/pr-preview/pr-60/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3461":492,"_30106":484,"_5":30456,"_20907":50656,"_27392":50657,"_2946":50658},[],"/docs/pr-preview/pr-60/platform/administration/access-control#oidc-principals","OIDC principals",{"_3461":493,"_30106":484,"_5":30456,"_20907":50660,"_27392":50661,"_2946":50662},[],"/docs/pr-preview/pr-60/platform/administration/access-control#x509-principals","X.509 principals",{"_3461":494,"_30106":484,"_5":30456,"_20907":50664,"_27392":50665,"_2946":50666},[],"/docs/pr-preview/pr-60/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3461":495,"_30106":484,"_5":30456,"_20907":50668,"_27392":50669,"_2946":50670},[],"/docs/pr-preview/pr-60/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3461":496,"_30106":484,"_5":30456,"_20907":50672,"_27392":50673,"_2946":50674},[],"/docs/pr-preview/pr-60/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3461":497,"_30106":484,"_5":30456,"_20907":50676,"_27392":50677,"_2946":50678},[],"/docs/pr-preview/pr-60/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3461":498,"_30106":484,"_5":30456,"_20907":50680,"_27392":50681,"_2946":50682},[],"/docs/pr-preview/pr-60/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3461":499,"_30106":484,"_5":30456,"_20907":50684,"_27392":50685,"_2946":50686},[],"/docs/pr-preview/pr-60/platform/administration/access-control#http-rules","HTTP rules",{"_3461":500,"_30106":484,"_5":30456,"_20907":50688,"_27392":50689,"_2946":50690},[],"/docs/pr-preview/pr-60/platform/administration/access-control#included-policies","Included policies",{"_3461":501,"_30106":484,"_5":30456,"_20907":50692,"_27392":50693,"_2946":49797},[],"/docs/pr-preview/pr-60/platform/administration/access-control#provision-the-first-administrator",{"_3461":502,"_30106":484,"_5":30456,"_20907":50695,"_27392":50696,"_2946":50697},[],"/docs/pr-preview/pr-60/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3461":503,"_30106":484,"_5":30456,"_20907":50699,"_27392":50700,"_2946":50701},[],"/docs/pr-preview/pr-60/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3461":504,"_30106":484,"_5":30456,"_20907":50703,"_27392":50704,"_2946":50705},[],"/docs/pr-preview/pr-60/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3461":505,"_30106":484,"_5":30456,"_20907":50707,"_27392":50708,"_2946":50709},[],"/docs/pr-preview/pr-60/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3461":506,"_30106":484,"_5":30456,"_20907":50711,"_27392":50712,"_2946":50713},[],"/docs/pr-preview/pr-60/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3461":507,"_30106":484,"_5":30456,"_20907":50715,"_27392":50716,"_2946":50717},[],"/docs/pr-preview/pr-60/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3461":508,"_30106":484,"_5":30456,"_20907":50719,"_27392":50720,"_2946":50721},[],"/docs/pr-preview/pr-60/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3461":509,"_30106":484,"_5":30456,"_20907":50723,"_27392":50724,"_2946":50725},[],"/docs/pr-preview/pr-60/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3461":510,"_30106":484,"_5":30456,"_20907":50727,"_27392":50728,"_2946":50729},[],"/docs/pr-preview/pr-60/platform/administration/access-control#operational-checklist","Operational checklist",{"_3461":511,"_30106":484,"_5":30456,"_20907":50731,"_27392":50732,"_2946":50733},[],"/docs/pr-preview/pr-60/platform/administration/access-control#diagnostics","Diagnostics",{"_3461":512,"_30106":484,"_5":30456,"_20907":50735,"_27392":50736,"_2946":50737},[],"/docs/pr-preview/pr-60/platform/administration/access-control#the-response-is-401","The response is 401",{"_3461":513,"_30106":484,"_5":30456,"_20907":50739,"_27392":50740,"_2946":50741},[],"/docs/pr-preview/pr-60/platform/administration/access-control#the-response-is-403","The response is 403",{"_3461":514,"_30106":484,"_5":30456,"_20907":50743,"_27392":50744,"_2946":50745},[],"/docs/pr-preview/pr-60/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3461":515,"_30106":484,"_5":30456,"_20907":50747,"_27392":50748,"_2946":50749},[],"/docs/pr-preview/pr-60/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3461":516,"_30106":484,"_5":30456,"_20907":50751,"_27392":50752,"_2946":50753},[],"/docs/pr-preview/pr-60/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3461":517,"_30106":484,"_20907":50755,"_5":14363,"_27392":484,"_2946":50756},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3461":518,"_30106":484,"_20907":50758,"_5":14363,"_27392":484,"_2946":50759},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3461":519,"_30106":484,"_20907":50761,"_5":14363,"_27392":484,"_2946":50762},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3461":520,"_30106":484,"_20907":50764,"_5":14363,"_27392":50633,"_2946":50765},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3461":521,"_30106":484,"_20907":50767,"_5":14363,"_27392":50633,"_2946":50768},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3461":522,"_30106":484,"_20907":50770,"_5":14363,"_27392":50633,"_2946":50771},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3461":523,"_30106":484,"_20907":50773,"_5":14363,"_27392":50633,"_2946":50774},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3461":524,"_30106":484,"_20907":50776,"_5":14363,"_27392":50633,"_2946":50777},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3461":525,"_30106":484,"_20907":50779,"_5":14363,"_27392":50633,"_2946":50780},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3461":526,"_30106":484,"_20907":50782,"_5":14363,"_27392":50637,"_2946":50783},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3461":527,"_30106":484,"_20907":50785,"_5":14363,"_27392":50637,"_2946":50786},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3461":528,"_30106":484,"_20907":50788,"_5":14363,"_27392":50641,"_2946":50789},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3461":529,"_30106":484,"_20907":50791,"_5":14363,"_27392":50641,"_2946":50792},[],"The decision is made **before forwarding the request to the service**:",{"_3461":530,"_30106":484,"_20907":50794,"_5":14363,"_27392":50641,"_2946":50795},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3461":531,"_30106":484,"_20907":50797,"_5":14363,"_27392":50641,"_2946":50798},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3461":532,"_30106":484,"_20907":50800,"_5":14363,"_27392":50641,"_2946":50801},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3461":533,"_30106":484,"_20907":50803,"_5":14363,"_27392":50641,"_2946":50804},[],"It separately loads the policies granted to each principal.",{"_3461":534,"_30106":484,"_20907":50806,"_5":14363,"_27392":50641,"_2946":50807},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3461":535,"_30106":484,"_20907":50809,"_5":14363,"_27392":50641,"_2946":50810},[],"`authz` looks for an HTTP rule granting that action.",{"_3461":536,"_30106":484,"_20907":50812,"_5":14363,"_27392":50641,"_2946":50813},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3461":537,"_30106":484,"_20907":50815,"_5":14363,"_27392":50641,"_2946":50816},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3461":538,"_30106":484,"_20907":50818,"_5":14363,"_27392":50641,"_2946":50819},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3461":539,"_30106":484,"_20907":50821,"_5":14363,"_27392":50641,"_2946":50822},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3461":540,"_30106":484,"_20907":50824,"_5":14363,"_27392":50645,"_2946":50825},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3461":541,"_30106":484,"_20907":50827,"_5":14363,"_27392":50645,"_2946":50828},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3461":542,"_30106":484,"_20907":50830,"_5":14363,"_27392":50645,"_2946":50831},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3461":543,"_30106":484,"_20907":50833,"_5":14363,"_27392":50645,"_2946":50834},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3461":544,"_30106":484,"_20907":50836,"_5":14363,"_27392":50645,"_2946":50837},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3461":545,"_30106":484,"_20907":50839,"_5":14363,"_27392":50645,"_2946":50840},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3461":546,"_30106":484,"_20907":50842,"_5":14363,"_27392":50645,"_2946":50843},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3461":547,"_30106":484,"_20907":50845,"_5":14363,"_27392":50645,"_2946":50846},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3461":548,"_30106":484,"_20907":50848,"_5":14363,"_27392":50649,"_2946":50849},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3461":549,"_30106":484,"_20907":50851,"_5":14363,"_27392":50649,"_2946":50852},[],"The decision is made with the domain operation context:",{"_3461":550,"_30106":484,"_20907":50854,"_5":14363,"_27392":50649,"_2946":50855},[],"The middleware extracts the credential and resolves the matching principals.",{"_3461":551,"_30106":484,"_20907":50857,"_5":14363,"_27392":50649,"_2946":50858},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3461":552,"_30106":484,"_20907":50860,"_5":14363,"_27392":50649,"_2946":50861},[],"`authz` gathers the entity rules of the granted policies.",{"_3461":553,"_30106":484,"_20907":50863,"_5":14363,"_27392":50649,"_2946":50864},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3461":554,"_30106":484,"_20907":50866,"_5":14363,"_27392":50649,"_2946":50867},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3461":555,"_30106":484,"_20907":50869,"_5":14363,"_27392":50649,"_2946":50870},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3461":556,"_30106":484,"_20907":50872,"_5":14363,"_27392":50649,"_2946":50873},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3461":557,"_30106":484,"_20907":50875,"_5":14363,"_27392":50649,"_2946":50876},[],"Actions fall into two groups:",{"_3461":558,"_30106":484,"_20907":50878,"_5":14363,"_27392":50649,"_2946":50879},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3461":559,"_30106":484,"_20907":50881,"_5":14363,"_27392":50649,"_2946":50882},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3461":560,"_30106":484,"_20907":50884,"_5":14363,"_27392":50649,"_2946":50885},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3461":561,"_30106":484,"_20907":50887,"_5":14363,"_27392":50653,"_2946":50888},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3461":562,"_30106":484,"_20907":50890,"_5":14363,"_27392":50653,"_2946":50891},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3461":563,"_30106":484,"_20907":50893,"_5":14363,"_27392":50653,"_2946":50894},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3461":564,"_30106":484,"_20907":50896,"_5":14363,"_27392":50657,"_2946":50897},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3461":565,"_30106":484,"_20907":50899,"_5":14363,"_27392":50657,"_2946":50900},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3461":566,"_30106":484,"_20907":50902,"_5":14363,"_27392":50657,"_2946":50903},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3461":567,"_30106":484,"_20907":50905,"_5":14363,"_27392":50657,"_2946":50906},[],"The implemented operators are:",{"_3461":568,"_30106":484,"_20907":50908,"_5":14363,"_27392":50657,"_2946":50909},[],"`equals`, for exact equality;",{"_3461":569,"_30106":484,"_20907":50911,"_5":14363,"_27392":50657,"_2946":50912},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3461":570,"_30106":484,"_20907":50914,"_5":14363,"_27392":50657,"_2946":50915},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3461":571,"_30106":484,"_20907":50917,"_5":14363,"_27392":50657,"_2946":50918},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3461":572,"_30106":484,"_20907":50920,"_5":14363,"_27392":50661,"_2946":50921},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3461":573,"_30106":484,"_20907":50923,"_5":14363,"_27392":50661,"_2946":50924},[],"The available modes are:",{"_3461":574,"_30106":484,"_20907":50926,"_5":14363,"_27392":50661,"_2946":50927},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3461":575,"_30106":484,"_20907":50929,"_5":14363,"_27392":50661,"_2946":50930},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3461":576,"_30106":484,"_20907":50932,"_5":14363,"_27392":50661,"_2946":50933},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3461":577,"_30106":484,"_20907":50935,"_5":14363,"_27392":50661,"_2946":50936},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3461":578,"_30106":484,"_20907":50938,"_5":14363,"_27392":50661,"_2946":50939},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3461":579,"_30106":484,"_20907":50941,"_5":14363,"_27392":50661,"_2946":50942},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3461":580,"_30106":484,"_20907":50944,"_5":14363,"_27392":50665,"_2946":50945},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3461":581,"_30106":484,"_20907":50947,"_5":14363,"_27392":50665,"_2946":50948},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3461":582,"_30106":484,"_20907":50950,"_5":14363,"_27392":50665,"_2946":50951},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3461":583,"_30106":484,"_20907":50953,"_5":14363,"_27392":50665,"_2946":50954},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3461":584,"_30106":484,"_20907":50956,"_5":14363,"_27392":50673,"_2946":50957},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3461":585,"_30106":484,"_20907":50959,"_5":14363,"_27392":50673,"_2946":50960},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3461":586,"_30106":484,"_20907":50962,"_5":14363,"_27392":50677,"_2946":50963},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3461":587,"_30106":484,"_20907":50965,"_5":14363,"_27392":50677,"_2946":50966},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3461":588,"_30106":484,"_20907":50968,"_5":14363,"_27392":50681,"_2946":50969},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3461":589,"_30106":484,"_20907":50971,"_5":14363,"_27392":50681,"_2946":50972},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3461":590,"_30106":484,"_20907":50974,"_5":14363,"_27392":50681,"_2946":50975},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3461":591,"_30106":484,"_20907":50977,"_5":14363,"_27392":50685,"_2946":50978},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3461":592,"_30106":484,"_20907":50980,"_5":14363,"_27392":50685,"_2946":50981},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3461":593,"_30106":484,"_20907":50983,"_5":14363,"_27392":50685,"_2946":50984},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3461":594,"_30106":484,"_20907":50986,"_5":14363,"_27392":50685,"_2946":50987},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3461":595,"_30106":484,"_20907":50989,"_5":14363,"_27392":50685,"_2946":50990},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3461":596,"_30106":484,"_20907":50992,"_5":14363,"_27392":50685,"_2946":50993},[],"Note that:",{"_3461":597,"_30106":484,"_20907":50995,"_5":14363,"_27392":50685,"_2946":50996},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3461":598,"_30106":484,"_20907":50998,"_5":14363,"_27392":50685,"_2946":50999},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3461":599,"_30106":484,"_20907":51001,"_5":14363,"_27392":50685,"_2946":51002},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3461":600,"_30106":484,"_20907":51004,"_5":14363,"_27392":50689,"_2946":51005},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3461":601,"_30106":484,"_20907":51007,"_5":14363,"_27392":50689,"_2946":51008},[],"full and read-only access to certificates and authorities;",{"_3461":602,"_30106":484,"_20907":51010,"_5":14363,"_27392":50689,"_2946":51011},[],"full and read-only access to the KMS;",{"_3461":603,"_30106":484,"_20907":51013,"_5":14363,"_27392":50689,"_2946":51014},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3461":604,"_30106":484,"_20907":51016,"_5":14363,"_27392":50689,"_2946":51017},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3461":605,"_30106":484,"_20907":51019,"_5":14363,"_27392":50689,"_2946":51020},[],"console access;",{"_3461":606,"_30106":484,"_20907":51022,"_5":14363,"_27392":50689,"_2946":51023},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3461":607,"_30106":484,"_20907":51025,"_5":14363,"_27392":50689,"_2946":51026},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3461":608,"_30106":484,"_20907":51028,"_5":14363,"_27392":50689,"_2946":51029},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3461":609,"_30106":484,"_20907":51031,"_5":14363,"_27392":50693,"_2946":51032},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3461":610,"_30106":484,"_20907":51034,"_5":14363,"_27392":50693,"_2946":51035},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3461":611,"_30106":484,"_20907":51037,"_5":14363,"_27392":50693,"_2946":51038},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3461":612,"_30106":484,"_20907":51040,"_5":14363,"_27392":50696,"_2946":51041},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3461":613,"_30106":484,"_20907":51043,"_5":14363,"_27392":50700,"_2946":51044},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3461":614,"_30106":484,"_20907":51046,"_5":14363,"_27392":50700,"_2946":51047},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3461":615,"_30106":484,"_20907":51049,"_5":14363,"_27392":50704,"_2946":51050},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3461":616,"_30106":484,"_20907":51052,"_5":14363,"_27392":50708,"_2946":51053},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3461":617,"_30106":484,"_20907":51055,"_5":14363,"_27392":50712,"_2946":51056},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3461":618,"_30106":484,"_20907":51058,"_5":14363,"_27392":50716,"_2946":51059},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3461":619,"_30106":484,"_20907":51061,"_5":14363,"_27392":50716,"_2946":51062},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3461":620,"_30106":484,"_20907":51064,"_5":14363,"_27392":50720,"_2946":51065},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3461":621,"_30106":484,"_20907":51067,"_5":14363,"_27392":50720,"_2946":51068},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3461":622,"_30106":484,"_20907":51070,"_5":14363,"_27392":50720,"_2946":51071},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3461":623,"_30106":484,"_20907":51073,"_5":14363,"_27392":50720,"_2946":51074},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3461":624,"_30106":484,"_20907":51076,"_5":14363,"_27392":50720,"_2946":51077},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3461":625,"_30106":484,"_20907":51079,"_5":14363,"_27392":50720,"_2946":51080},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3461":626,"_30106":484,"_20907":51082,"_5":14363,"_27392":50720,"_2946":51083},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3461":627,"_30106":484,"_20907":51085,"_5":14363,"_27392":50720,"_2946":51086},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3461":628,"_30106":484,"_20907":51088,"_5":14363,"_27392":50724,"_2946":51089},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3461":629,"_30106":484,"_20907":51091,"_5":14363,"_27392":50724,"_2946":51092},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3461":630,"_30106":484,"_20907":51094,"_5":14363,"_27392":50724,"_2946":51095},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3461":631,"_30106":484,"_20907":51097,"_5":14363,"_27392":50728,"_2946":51098},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3461":632,"_30106":484,"_20907":51100,"_5":14363,"_27392":50728,"_2946":51101},[],"Use groups or stable roles for people and independent identities for automations.",{"_3461":633,"_30106":484,"_20907":51103,"_5":14363,"_27392":50728,"_2946":51104},[],"Keep at least two recovery administrators and test their access periodically.",{"_3461":634,"_30106":484,"_20907":51106,"_5":14363,"_27392":50728,"_2946":51107},[],"Review active principals, their matches and their grants after IdP changes.",{"_3461":635,"_30106":484,"_20907":51109,"_5":14363,"_27392":50728,"_2946":51110},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3461":636,"_30106":484,"_20907":51112,"_5":14363,"_27392":50728,"_2946":51113},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3461":637,"_30106":484,"_20907":51115,"_5":14363,"_27392":50728,"_2946":51116},[],"Always test one allowed and one denied operation for each role.",{"_3461":638,"_30106":484,"_20907":51118,"_5":14363,"_27392":50728,"_2946":51119},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3461":639,"_30106":484,"_20907":51121,"_5":14363,"_27392":50736,"_2946":51122},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3461":640,"_30106":484,"_20907":51124,"_5":14363,"_27392":50740,"_2946":51125},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3461":641,"_30106":484,"_20907":51127,"_5":14363,"_27392":50740,"_2946":51128},[],"that an active principal of the correct type exists;",{"_3461":642,"_30106":484,"_20907":51130,"_5":14363,"_27392":50740,"_2946":51131},[],"that the claim paths and values match the real token exactly;",{"_3461":643,"_30106":484,"_20907":51133,"_5":14363,"_27392":50740,"_2946":51134},[],"that all of the principal's conditions hold;",{"_3461":644,"_30106":484,"_20907":51136,"_5":14363,"_27392":50740,"_2946":51137},[],"that the principal has the expected policy granted;",{"_3461":645,"_30106":484,"_20907":51139,"_5":14363,"_27392":50740,"_2946":51140},[],"that the policy includes the action and the requested resource type or route;",{"_3461":646,"_30106":484,"_20907":51142,"_5":14363,"_27392":50740,"_2946":51143},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3461":647,"_30106":484,"_20907":51145,"_5":14363,"_27392":50740,"_2946":51146},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3461":648,"_30106":484,"_20907":51148,"_5":14363,"_27392":50744,"_2946":51149},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3461":649,"_30106":484,"_20907":51151,"_5":14363,"_27392":50748,"_2946":51152},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3461":650,"_30106":484,"_20907":51154,"_5":14363,"_27392":50752,"_2946":51155},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3461":651,"_30106":484,"_20907":51157,"_5":14363,"_27392":50752,"_2946":51158},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3461":652,"_30106":652,"_5":14715,"_2946":51160,"_30459":51161,"_20907":51162,"_27392":652},"Alerts and subscriptions",[49157,50625,50626],[],{"_3461":653,"_30106":652,"_20907":51164,"_5":14363,"_27392":652,"_2946":51165},[],"Send PKI events to people and external systems.",{"_3461":654,"_30106":652,"_5":30456,"_20907":51167,"_27392":51168,"_2946":51169},[],"/docs/pr-preview/pr-60/platform/administration/alerts#how-it-works","How it works",{"_3461":655,"_30106":652,"_5":30456,"_20907":51171,"_27392":51172,"_2946":51173},[],"/docs/pr-preview/pr-60/platform/administration/alerts#available-channels","Available channels",{"_3461":656,"_30106":652,"_5":30456,"_20907":51175,"_27392":51176,"_2946":51177},[],"/docs/pr-preview/pr-60/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3461":657,"_30106":652,"_5":30456,"_20907":51179,"_27392":51180,"_2946":51181},[],"/docs/pr-preview/pr-60/platform/administration/alerts#choose-the-event","Choose the event",{"_3461":658,"_30106":652,"_5":30456,"_20907":51183,"_27392":51184,"_2946":51185},[],"/docs/pr-preview/pr-60/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3461":659,"_30106":652,"_5":30456,"_20907":51187,"_27392":51188,"_2946":51189},[],"/docs/pr-preview/pr-60/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3461":660,"_30106":652,"_5":30456,"_20907":51191,"_27392":51192,"_2946":51193},[],"/docs/pr-preview/pr-60/platform/administration/alerts#review-and-activate","Review and activate",{"_3461":661,"_30106":652,"_5":30456,"_20907":51195,"_27392":51196,"_2946":51197},[],"/docs/pr-preview/pr-60/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3461":662,"_30106":652,"_5":30456,"_20907":51199,"_27392":51200,"_2946":51201},[],"/docs/pr-preview/pr-60/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3461":663,"_30106":652,"_5":30456,"_20907":51203,"_27392":51204,"_2946":51205},[],"/docs/pr-preview/pr-60/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3461":664,"_30106":652,"_5":30456,"_20907":51207,"_27392":51208,"_2946":51209},[],"/docs/pr-preview/pr-60/platform/administration/alerts#event-families","Event families",{"_3461":665,"_30106":652,"_20907":51211,"_5":14363,"_27392":652,"_2946":51212},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3461":666,"_30106":652,"_20907":51214,"_5":14363,"_27392":51168,"_2946":51215},[],"A service publishes a domain event.",{"_3461":667,"_30106":652,"_20907":51217,"_5":14363,"_27392":51168,"_2946":51218},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3461":668,"_30106":652,"_20907":51220,"_5":14363,"_27392":51168,"_2946":51221},[],"Each subscription's filter decides whether it should be notified.",{"_3461":669,"_30106":652,"_20907":51223,"_5":14363,"_27392":51168,"_2946":51224},[],"Lamassu delivers the event to the configured channel.",{"_3461":670,"_30106":652,"_20907":51226,"_5":14363,"_27392":51168,"_2946":51227},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3461":671,"_30106":652,"_20907":51229,"_5":14363,"_27392":51172,"_2946":51230},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3461":672,"_30106":652,"_20907":51232,"_5":14363,"_27392":51172,"_2946":51233},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3461":673,"_30106":652,"_20907":51235,"_5":14363,"_27392":51172,"_2946":51236},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3461":674,"_30106":652,"_20907":51238,"_5":14363,"_27392":51172,"_2946":51239},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3461":675,"_30106":652,"_20907":51241,"_5":14363,"_27392":51172,"_2946":51242},[],"`apikey_options` requires `header` and `key`.",{"_3461":676,"_30106":652,"_20907":51244,"_5":14363,"_27392":51172,"_2946":51245},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3461":677,"_30106":652,"_20907":51247,"_5":14363,"_27392":51172,"_2946":51248},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3461":678,"_30106":652,"_20907":51250,"_5":14363,"_27392":51172,"_2946":51251},[],"The alerts API reference documents the full `http_client` schema.",{"_3461":679,"_30106":652,"_20907":51253,"_5":14363,"_27392":51180,"_2946":51254},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3461":680,"_30106":652,"_20907":51256,"_5":14363,"_27392":51184,"_2946":51257},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3461":681,"_30106":652,"_20907":51259,"_5":14363,"_27392":51188,"_2946":51260},[],"Add a filter if you don't want to receive every instance of the event.",{"_3461":682,"_30106":652,"_20907":51262,"_5":14363,"_27392":51188,"_2946":51263},[],"**None** notifies all instances of the event.",{"_3461":683,"_30106":652,"_20907":51265,"_5":14363,"_27392":51188,"_2946":51266},[],"**JSON Path** evaluates one or more specific fields.",{"_3461":684,"_30106":652,"_20907":51268,"_5":14363,"_27392":51188,"_2946":51269},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3461":685,"_30106":652,"_20907":51271,"_5":14363,"_27392":51188,"_2946":51272},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3461":686,"_30106":652,"_20907":51274,"_5":14363,"_27392":51188,"_2946":51275},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3461":687,"_30106":652,"_20907":51277,"_5":14363,"_27392":51188,"_2946":51278},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3461":688,"_30106":652,"_20907":51280,"_5":14363,"_27392":51192,"_2946":51281},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3461":689,"_30106":652,"_20907":51283,"_5":14363,"_27392":51196,"_2946":51284},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3461":690,"_30106":652,"_20907":51286,"_5":14363,"_27392":51196,"_2946":51287},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3461":691,"_30106":652,"_20907":51289,"_5":14363,"_27392":51196,"_2946":51290},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3461":692,"_30106":652,"_20907":51292,"_5":14363,"_27392":51196,"_2946":51293},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3461":693,"_30106":652,"_20907":51295,"_5":14363,"_27392":51196,"_2946":51296},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3461":694,"_30106":652,"_20907":51298,"_5":14363,"_27392":51196,"_2946":51299},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3461":695,"_30106":652,"_20907":51301,"_5":14363,"_27392":51196,"_2946":51302},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3461":696,"_30106":652,"_20907":51304,"_5":14363,"_27392":51196,"_2946":51305},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3461":697,"_30106":652,"_20907":51307,"_5":14363,"_27392":51200,"_2946":51308},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3461":698,"_30106":652,"_20907":51310,"_5":14363,"_27392":51200,"_2946":51311},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3461":699,"_30106":652,"_20907":51313,"_5":14363,"_27392":51200,"_2946":51314},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3461":700,"_30106":652,"_20907":51316,"_5":14363,"_27392":51200,"_2946":51317},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3461":701,"_30106":652,"_20907":51319,"_5":14363,"_27392":51200,"_2946":51320},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3461":702,"_30106":652,"_20907":51322,"_5":14363,"_27392":51200,"_2946":51323},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3461":703,"_30106":652,"_20907":51325,"_5":14363,"_27392":51200,"_2946":51326},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3461":704,"_30106":652,"_20907":51328,"_5":14363,"_27392":51200,"_2946":51329},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3461":705,"_30106":652,"_20907":51331,"_5":14363,"_27392":51204,"_2946":51332},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3461":706,"_30106":652,"_20907":51334,"_5":14363,"_27392":51204,"_2946":51335},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3461":707,"_30106":652,"_20907":51337,"_5":14363,"_27392":51208,"_2946":51338},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3461":708,"_30106":652,"_20907":51340,"_5":14363,"_27392":51208,"_2946":51341},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3461":709,"_30106":652,"_20907":51343,"_5":14363,"_27392":51208,"_2946":51344},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3461":710,"_30106":652,"_20907":51346,"_5":14363,"_27392":51208,"_2946":51347},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3461":711,"_30106":652,"_20907":51349,"_5":14363,"_27392":51208,"_2946":51350},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3461":712,"_30106":652,"_20907":51352,"_5":14363,"_27392":51208,"_2946":51353},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3461":713,"_30106":652,"_20907":51355,"_5":14363,"_27392":51208,"_2946":51356},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3461":714,"_30106":652,"_20907":51358,"_5":14363,"_27392":51208,"_2946":51359},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3461":715,"_30106":652,"_20907":51361,"_5":14363,"_27392":51208,"_2946":51362},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3461":716,"_30106":716,"_5":14715,"_2946":51364,"_30459":51365,"_20907":51366,"_27392":716},"Audit logs",[49157,50625,50626],[],{"_3461":717,"_30106":716,"_20907":51368,"_5":14363,"_27392":716,"_2946":51369},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3461":718,"_30106":716,"_5":30456,"_20907":51371,"_27392":51372,"_2946":51373},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3461":719,"_30106":716,"_5":30456,"_20907":51375,"_27392":51376,"_2946":51377},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#coverage","Coverage",{"_3461":720,"_30106":716,"_5":30456,"_20907":51379,"_27392":51380,"_2946":51381},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3461":721,"_30106":716,"_5":30456,"_20907":51383,"_27392":51384,"_2946":51385},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3461":722,"_30106":716,"_5":30456,"_20907":51387,"_27392":51388,"_2946":51389},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3461":723,"_30106":716,"_5":30456,"_20907":51391,"_27392":51392,"_2946":51393},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3461":724,"_30106":716,"_5":30456,"_20907":51395,"_27392":51396,"_2946":51397},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3461":725,"_30106":716,"_5":30456,"_20907":51399,"_27392":51400,"_2946":51401},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3461":726,"_30106":716,"_5":30456,"_20907":51403,"_27392":51404,"_2946":51405},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3461":727,"_30106":716,"_5":30456,"_20907":51407,"_27392":51408,"_2946":51409},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3461":728,"_30106":716,"_5":30456,"_20907":51411,"_27392":51412,"_2946":51413},[],"/docs/pr-preview/pr-60/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3461":729,"_30106":716,"_20907":51415,"_5":14363,"_27392":716,"_2946":51416},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3461":730,"_30106":716,"_20907":51418,"_5":14363,"_27392":51372,"_2946":51419},[],"The audit body includes:",{"_3461":731,"_30106":716,"_20907":51421,"_5":14363,"_27392":51372,"_2946":51422},[],"input: data received by the operation;",{"_3461":732,"_30106":716,"_20907":51424,"_5":14363,"_27392":51372,"_2946":51425},[],"has\\_error: whether the service returned an error;",{"_3461":733,"_30106":716,"_20907":51427,"_5":14363,"_27392":51372,"_2946":51428},[],"output: produced result or error message;",{"_3461":734,"_30106":716,"_20907":51430,"_5":14363,"_27392":51372,"_2946":51431},[],"principals: identifiers of the principals that matched the request.",{"_3461":735,"_30106":716,"_20907":51433,"_5":14363,"_27392":51372,"_2946":51434},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3461":736,"_30106":716,"_20907":51436,"_5":14363,"_27392":51372,"_2946":51437},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3461":737,"_30106":716,"_20907":51439,"_5":14363,"_27392":51376,"_2946":51440},[],"The backend applies auditing to mutations of:",{"_3461":738,"_30106":716,"_20907":51442,"_5":14363,"_27392":51376,"_2946":51443},[],"authorities, certificates and issuance profiles;",{"_3461":739,"_30106":716,"_20907":51445,"_5":14363,"_27392":51376,"_2946":51446},[],"keys and KMS engines;",{"_3461":740,"_30106":716,"_20907":51448,"_5":14363,"_27392":51376,"_2946":51449},[],"devices and identities;",{"_3461":741,"_30106":716,"_20907":51451,"_5":14363,"_27392":51376,"_2946":51452},[],"DMSs and enrollment operations;",{"_3461":742,"_30106":716,"_20907":51454,"_5":14363,"_27392":51376,"_2946":51455},[],"validation functions and CRL;",{"_3461":743,"_30106":716,"_20907":51457,"_5":14363,"_27392":51376,"_2946":51458},[],"principals, policies and authorization grants.",{"_3461":744,"_30106":716,"_20907":51460,"_5":14363,"_27392":51376,"_2946":51461},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3461":745,"_30106":716,"_20907":51463,"_5":14363,"_27392":51380,"_2946":51464},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3461":746,"_30106":716,"_20907":51466,"_5":14363,"_27392":51380,"_2946":51467},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3461":747,"_30106":716,"_20907":51469,"_5":14363,"_27392":51380,"_2946":51470},[],"Design the consumer to:",{"_3461":748,"_30106":716,"_20907":51472,"_5":14363,"_27392":51380,"_2946":51473},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3461":749,"_30106":716,"_20907":51475,"_5":14363,"_27392":51380,"_2946":51476},[],"keep the complete CloudEvent unmodified;",{"_3461":750,"_30106":716,"_20907":51478,"_5":14363,"_27392":51380,"_2946":51479},[],"record the ingestion time and detect duplicates by ID;",{"_3461":751,"_30106":716,"_20907":51481,"_5":14363,"_27392":51380,"_2946":51482},[],"encrypt in transit and at rest;",{"_3461":752,"_30106":716,"_20907":51484,"_5":14363,"_27392":51380,"_2946":51485},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3461":753,"_30106":716,"_20907":51487,"_5":14363,"_27392":51380,"_2946":51488},[],"apply an explicit retention and legal hold policy;",{"_3461":754,"_30106":716,"_20907":51490,"_5":14363,"_27392":51380,"_2946":51491},[],"alert if it stops consuming or the pending queue grows.",{"_3461":755,"_30106":716,"_20907":51493,"_5":14363,"_27392":51384,"_2946":51494},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3461":756,"_30106":716,"_20907":51496,"_5":14363,"_27392":51384,"_2946":51497},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3461":757,"_30106":716,"_20907":51499,"_5":14363,"_27392":51392,"_2946":51500},[],"Start from the reported time and normalize every source to UTC.",{"_3461":758,"_30106":716,"_20907":51502,"_5":14363,"_27392":51396,"_2946":51503},[],"Filter by event type, service source and resource identifier.",{"_3461":759,"_30106":716,"_20907":51505,"_5":14363,"_27392":51400,"_2946":51506},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3461":760,"_30106":716,"_20907":51508,"_5":14363,"_27392":51404,"_2946":51509},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3461":761,"_30106":716,"_20907":51511,"_5":14363,"_27392":51408,"_2946":51512},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3461":762,"_30106":716,"_20907":51514,"_5":14363,"_27392":51412,"_2946":51515},[],"Generate a controlled mutation in a test environment and check that:",{"_3461":763,"_30106":716,"_20907":51517,"_5":14363,"_27392":51412,"_2946":51518},[],"a successful audit event appears;",{"_3461":764,"_30106":716,"_20907":51520,"_5":14363,"_27392":51412,"_2946":51521},[],"the principal matches the identity used;",{"_3461":765,"_30106":716,"_20907":51523,"_5":14363,"_27392":51412,"_2946":51524},[],"the consumer persists it exactly once;",{"_3461":766,"_30106":716,"_20907":51526,"_5":14363,"_27392":51412,"_2946":51527},[],"it can be retrieved by resource, actor and period;",{"_3461":767,"_30106":716,"_20907":51529,"_5":14363,"_27392":51412,"_2946":51530},[],"a consumer outage raises an alert.",{"_3461":768,"_30106":716,"_20907":51532,"_5":14363,"_27392":51412,"_2946":51533},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3461":769,"_30106":769,"_5":14715,"_2946":51535,"_30459":51536,"_20907":51537,"_27392":769},"Platform architecture",[49157,50625],[],{"_3461":770,"_30106":769,"_20907":51539,"_5":14363,"_27392":769,"_2946":51540},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3461":771,"_30106":769,"_5":30456,"_20907":51542,"_27392":51543,"_2946":51544},[],"/docs/pr-preview/pr-60/platform/concepts/architecture#control-plane","Control plane",{"_3461":772,"_30106":769,"_5":30456,"_20907":51546,"_27392":51547,"_2946":51548},[],"/docs/pr-preview/pr-60/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3461":773,"_30106":769,"_5":30456,"_20907":51550,"_27392":51551,"_2946":51552},[],"/docs/pr-preview/pr-60/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3461":774,"_30106":769,"_5":30456,"_20907":51554,"_27392":51555,"_2946":51556},[],"/docs/pr-preview/pr-60/platform/concepts/architecture#status-and-validation","Status and validation",{"_3461":775,"_30106":769,"_5":30456,"_20907":51558,"_27392":51559,"_2946":51560},[],"/docs/pr-preview/pr-60/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3461":776,"_30106":769,"_20907":51562,"_5":14363,"_27392":769,"_2946":51563},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3461":777,"_30106":769,"_20907":51565,"_5":14363,"_27392":769,"_2946":51566},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3461":778,"_30106":769,"_20907":51568,"_5":14363,"_27392":51543,"_2946":51569},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3461":779,"_30106":769,"_20907":51571,"_5":14363,"_27392":51547,"_2946":51572},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3461":780,"_30106":769,"_20907":51574,"_5":14363,"_27392":51551,"_2946":51575},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3461":781,"_30106":769,"_20907":51577,"_5":14363,"_27392":51555,"_2946":51578},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3461":782,"_30106":769,"_20907":51580,"_5":14363,"_27392":51559,"_2946":51581},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3461":783,"_30106":783,"_5":14715,"_2946":51583,"_30459":51584,"_20907":51585,"_27392":783},"How Lamassu works",[49157,50625],[],{"_3461":784,"_30106":783,"_20907":51587,"_5":14363,"_27392":783,"_2946":51588},[],"The mental model of trust, keys, certificates and devices.",{"_3461":785,"_30106":783,"_5":30456,"_20907":51590,"_27392":51591,"_2946":51592},[],"/docs/pr-preview/pr-60/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3461":786,"_30106":783,"_5":30456,"_20907":51594,"_27392":51595,"_2946":51596},[],"/docs/pr-preview/pr-60/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3461":787,"_30106":783,"_20907":51598,"_5":14363,"_27392":783,"_2946":51599},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3461":788,"_30106":783,"_20907":51601,"_5":14363,"_27392":51591,"_2946":51602},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3461":789,"_30106":783,"_20907":51604,"_5":14363,"_27392":51591,"_2946":51605},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3461":790,"_30106":783,"_20907":51607,"_5":14363,"_27392":51591,"_2946":51608},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3461":791,"_30106":783,"_20907":51610,"_5":14363,"_27392":51591,"_2946":51611},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3461":792,"_30106":783,"_20907":51613,"_5":14363,"_27392":51591,"_2946":51614},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3461":793,"_30106":783,"_20907":51616,"_5":14363,"_27392":51595,"_2946":51617},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3461":794,"_30106":783,"_20907":51619,"_5":14363,"_27392":51595,"_2946":51620},[],"A DMS relates that CA to an enrollment policy.",{"_3461":795,"_30106":783,"_20907":51622,"_5":14363,"_27392":51595,"_2946":51623},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3461":796,"_30106":783,"_20907":51625,"_5":14363,"_27392":51595,"_2946":51626},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3461":797,"_30106":783,"_20907":51628,"_5":14363,"_27392":51595,"_2946":51629},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3461":798,"_30106":783,"_20907":51631,"_5":14363,"_27392":51595,"_2946":51632},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3461":799,"_30106":783,"_20907":51634,"_5":14363,"_27392":51595,"_2946":51635},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3461":800,"_30106":800,"_5":14715,"_2946":51637,"_30459":51638,"_20907":51640,"_27392":800},"Devices and identities",[49157,50625,51639,51637],"IoT Fleets",[],{"_3461":801,"_30106":800,"_20907":51642,"_5":14363,"_27392":800,"_2946":51643},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3461":802,"_30106":800,"_5":30456,"_20907":51645,"_27392":51646,"_2946":51647},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#device-states","Device states",{"_3461":803,"_30106":800,"_5":30456,"_20907":51649,"_27392":51650,"_2946":51651},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3461":804,"_30106":800,"_5":30456,"_20907":51653,"_27392":51654,"_2946":51655},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3461":805,"_30106":800,"_5":30456,"_20907":51657,"_27392":51658,"_2946":51659},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3461":806,"_30106":800,"_5":30456,"_20907":51661,"_27392":51662,"_2946":51663},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3461":807,"_30106":800,"_5":30456,"_20907":51665,"_27392":51666,"_2946":51667},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3461":808,"_30106":800,"_5":30456,"_20907":51669,"_27392":51670,"_2946":51671},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3461":809,"_30106":800,"_5":30456,"_20907":51673,"_27392":51674,"_2946":51675},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3461":810,"_30106":800,"_5":30456,"_20907":51677,"_27392":51678,"_2946":51679},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3461":811,"_30106":800,"_5":30456,"_20907":51681,"_27392":51682,"_2946":51683},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3461":812,"_30106":800,"_5":30456,"_20907":51685,"_27392":51686,"_2946":51687},[],"/docs/pr-preview/pr-60/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3461":813,"_30106":800,"_20907":51689,"_5":14363,"_27392":800,"_2946":51690},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3461":814,"_30106":800,"_20907":51692,"_5":14363,"_27392":800,"_2946":51693},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3461":815,"_30106":800,"_20907":51695,"_5":14363,"_27392":51646,"_2946":51696},[],"Operational view",{"_3461":816,"_30106":800,"_20907":51698,"_5":14363,"_27392":51646,"_2946":51699},[],"Meaning",{"_3461":817,"_30106":800,"_20907":51701,"_5":14363,"_27392":51646,"_2946":51702},[],"**No Identity**",{"_3461":818,"_30106":800,"_20907":51704,"_5":14363,"_27392":51646,"_2946":51705},[],"A record exists without an associated identity.",{"_3461":819,"_30106":800,"_20907":51707,"_5":14363,"_27392":51646,"_2946":51708},[],"**Active**",{"_3461":820,"_30106":800,"_20907":51710,"_5":14363,"_27392":51646,"_2946":51711},[],"The slot is active; also check certificate dates, status and usages.",{"_3461":821,"_30106":800,"_20907":51713,"_5":14363,"_27392":51646,"_2946":51714},[],"**Renewal Pending**",{"_3461":822,"_30106":800,"_20907":51716,"_5":14363,"_27392":51646,"_2946":51717},[],"The identity is in the operational renewal window.",{"_3461":823,"_30106":800,"_20907":51719,"_5":14363,"_27392":51646,"_2946":51720},[],"**Expiring Soon**",{"_3461":824,"_30106":800,"_20907":51722,"_5":14363,"_27392":51646,"_2946":51723},[],"Expiration is approaching according to configured thresholds.",{"_3461":825,"_30106":800,"_20907":51725,"_5":14363,"_27392":51646,"_2946":51726},[],"**Expired**",{"_3461":826,"_30106":800,"_20907":51728,"_5":14363,"_27392":51646,"_2946":51729},[],"The identity has expired.",{"_3461":827,"_30106":800,"_20907":51731,"_5":14363,"_27392":51646,"_2946":51732},[],"**Revoked**",{"_3461":828,"_30106":800,"_20907":51734,"_5":14363,"_27392":51646,"_2946":51735},[],"The identity is marked revoked.",{"_3461":829,"_30106":800,"_20907":51737,"_5":14363,"_27392":51646,"_2946":51738},[],"**Decommissioned**",{"_3461":830,"_30106":800,"_20907":51740,"_5":14363,"_27392":51646,"_2946":51741},[],"The record is retired and ordinary updates do not restore operation.",{"_3461":831,"_30106":800,"_20907":51743,"_5":14363,"_27392":51646,"_2946":51744},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3461":832,"_30106":800,"_20907":51746,"_5":14363,"_27392":51650,"_2946":51747},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3461":833,"_30106":800,"_20907":51749,"_5":14363,"_27392":51650,"_2946":51750},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3461":834,"_30106":800,"_20907":51752,"_5":14363,"_27392":51650,"_2946":51753},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3461":835,"_30106":800,"_20907":51755,"_5":14363,"_27392":51650,"_2946":51756},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3461":836,"_30106":800,"_20907":51758,"_5":14363,"_27392":51654,"_2946":51759},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3461":837,"_30106":800,"_20907":51761,"_5":14363,"_27392":51658,"_2946":51762},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3461":838,"_30106":800,"_20907":51764,"_5":14363,"_27392":51662,"_2946":51765},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3461":839,"_30106":800,"_20907":51767,"_5":14363,"_27392":51666,"_2946":51768},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3461":840,"_30106":800,"_20907":51770,"_5":14363,"_27392":51670,"_2946":51771},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3461":841,"_30106":800,"_20907":51773,"_5":14363,"_27392":51670,"_2946":51774},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3461":842,"_30106":800,"_20907":51776,"_5":14363,"_27392":51674,"_2946":51777},[],"From **No Identity**, use **Assign Identity**:",{"_3461":843,"_30106":800,"_20907":51779,"_5":14363,"_27392":51674,"_2946":51780},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3461":844,"_30106":800,"_20907":51782,"_5":14363,"_27392":51674,"_2946":51783},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3461":845,"_30106":800,"_20907":51785,"_5":14363,"_27392":51674,"_2946":51786},[],"Confirm and read the serial, active version and history again.",{"_3461":846,"_30106":800,"_20907":51788,"_5":14363,"_27392":51674,"_2946":51789},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3461":847,"_30106":800,"_20907":51791,"_5":14363,"_27392":51674,"_2946":51792},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3461":848,"_30106":800,"_20907":51794,"_5":14363,"_27392":51678,"_2946":51795},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3461":849,"_30106":800,"_20907":51797,"_5":14363,"_27392":51678,"_2946":51798},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3461":850,"_30106":800,"_20907":51800,"_5":14363,"_27392":51682,"_2946":51801},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3461":851,"_30106":800,"_20907":51803,"_5":14363,"_27392":51682,"_2946":51804},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3461":852,"_30106":800,"_20907":51806,"_5":14363,"_27392":51682,"_2946":51807},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3461":853,"_30106":800,"_20907":51809,"_5":14363,"_27392":51682,"_2946":51810},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3461":854,"_30106":800,"_20907":51812,"_5":14363,"_27392":51686,"_2946":51813},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3461":855,"_30106":800,"_20907":51815,"_5":14363,"_27392":51686,"_2946":51816},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3461":856,"_30106":856,"_5":14715,"_2946":51818,"_30459":51819,"_20907":51821,"_27392":856},"Bootstrap identity and authentication",[49157,50625,51639,51637,51820],"Enrollment with PKI",[],{"_3461":857,"_30106":856,"_20907":51823,"_5":14363,"_27392":856,"_2946":51824},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3461":858,"_30106":856,"_5":30456,"_20907":51826,"_27392":51827,"_2946":51828},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3461":859,"_30106":856,"_5":30456,"_20907":51830,"_27392":51831,"_2946":51832},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3461":860,"_30106":856,"_5":30456,"_20907":51834,"_27392":51835,"_2946":51836},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3461":861,"_30106":856,"_5":30456,"_20907":51838,"_27392":51839,"_2946":51840},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3461":862,"_30106":856,"_5":30456,"_20907":51842,"_27392":51843,"_2946":51844},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3461":863,"_30106":856,"_20907":51846,"_5":14363,"_27392":856,"_2946":51847},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3461":864,"_30106":856,"_20907":51849,"_5":14363,"_27392":51827,"_2946":51850},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3461":865,"_30106":856,"_20907":51852,"_5":14363,"_27392":51827,"_2946":51853},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3461":866,"_30106":856,"_20907":51855,"_5":14363,"_27392":51831,"_2946":51856},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3461":867,"_30106":856,"_20907":51858,"_5":14363,"_27392":51831,"_2946":51859},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3461":868,"_30106":856,"_20907":51861,"_5":14363,"_27392":51831,"_2946":51862},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3461":869,"_30106":856,"_20907":51864,"_5":14363,"_27392":51835,"_2946":51865},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3461":870,"_30106":856,"_20907":51867,"_5":14363,"_27392":51835,"_2946":51868},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3461":871,"_30106":856,"_20907":51870,"_5":14363,"_27392":51839,"_2946":51871},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3461":872,"_30106":856,"_20907":51873,"_5":14363,"_27392":51839,"_2946":51874},[],"Example body:",{"_3461":873,"_30106":856,"_20907":51876,"_5":14363,"_27392":51839,"_2946":51877},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3461":874,"_30106":856,"_20907":51879,"_5":14363,"_27392":51839,"_2946":51880},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3461":875,"_30106":856,"_20907":51882,"_5":14363,"_27392":51839,"_2946":51883},[],"Continuation requires a successful HTTP response and JSON:",{"_3461":876,"_30106":856,"_20907":51885,"_5":14363,"_27392":51839,"_2946":51886},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3461":877,"_30106":856,"_20907":51888,"_5":14363,"_27392":51843,"_2946":51889},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3461":878,"_30106":856,"_20907":51891,"_5":14363,"_27392":51843,"_2946":51892},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3461":879,"_30106":879,"_5":14715,"_2946":51894,"_30459":51895,"_20907":51896,"_27392":879},"Configure and operate the DMS",[49157,50625,51639,51637,51820],[],{"_3461":880,"_30106":879,"_20907":51898,"_5":14363,"_27392":879,"_2946":51899},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3461":881,"_30106":879,"_5":30456,"_20907":51901,"_27392":51902,"_2946":49167},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3461":882,"_30106":879,"_5":30456,"_20907":51904,"_27392":51905,"_2946":51906},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3461":883,"_30106":879,"_5":30456,"_20907":51908,"_27392":51909,"_2946":51910},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3461":884,"_30106":879,"_5":30456,"_20907":51912,"_27392":51913,"_2946":51914},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3461":885,"_30106":879,"_5":30456,"_20907":51916,"_27392":51917,"_2946":51918},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3461":886,"_30106":879,"_5":30456,"_20907":51920,"_27392":51921,"_2946":51922},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3461":887,"_30106":879,"_5":30456,"_20907":51924,"_27392":51925,"_2946":51926},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3461":888,"_30106":879,"_5":30456,"_20907":51928,"_27392":51929,"_2946":51930},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3461":889,"_30106":879,"_5":30456,"_20907":51932,"_27392":51933,"_2946":51934},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3461":890,"_30106":879,"_5":30456,"_20907":51936,"_27392":51937,"_2946":51938},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3461":891,"_30106":879,"_5":30456,"_20907":51940,"_27392":51941,"_2946":51942},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3461":892,"_30106":879,"_5":30456,"_20907":51944,"_27392":51945,"_2946":51946},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3461":893,"_30106":879,"_5":30456,"_20907":51948,"_27392":51949,"_2946":51950},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3461":894,"_30106":879,"_5":30456,"_20907":51952,"_27392":51953,"_2946":51954},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3461":895,"_30106":879,"_5":30456,"_20907":51956,"_27392":51957,"_2946":51958},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3461":896,"_30106":879,"_5":30456,"_20907":51960,"_27392":51961,"_2946":51962},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3461":897,"_30106":879,"_5":30456,"_20907":51964,"_27392":51965,"_2946":51966},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3461":898,"_30106":879,"_5":30456,"_20907":51968,"_27392":51969,"_2946":51970},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3461":899,"_30106":879,"_20907":51972,"_5":14363,"_27392":879,"_2946":51973},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3461":900,"_30106":879,"_20907":51975,"_5":14363,"_27392":51902,"_2946":51976},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3461":901,"_30106":879,"_20907":51978,"_5":14363,"_27392":51902,"_2946":51979},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3461":902,"_30106":879,"_20907":51981,"_5":14363,"_27392":51909,"_2946":51982},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3461":903,"_30106":879,"_20907":51984,"_5":14363,"_27392":51913,"_2946":51985},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3461":904,"_30106":879,"_20907":51987,"_5":14363,"_27392":51917,"_2946":51988},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3461":905,"_30106":879,"_20907":51990,"_5":14363,"_27392":51921,"_2946":51991},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3461":906,"_30106":879,"_20907":51993,"_5":14363,"_27392":51925,"_2946":51994},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3461":907,"_30106":879,"_20907":51996,"_5":14363,"_27392":51933,"_2946":51997},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3461":908,"_30106":879,"_20907":51999,"_5":14363,"_27392":51933,"_2946":52000},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3461":909,"_30106":879,"_20907":52002,"_5":14363,"_27392":51937,"_2946":52003},[],"`settings.enrollment_settings` field",{"_3461":910,"_30106":879,"_20907":52005,"_5":14363,"_27392":51937,"_2946":52006},[],"Decision",{"_3461":911,"_30106":879,"_20907":52008,"_5":14363,"_27392":51937,"_2946":52009},[],"`protocol`",{"_3461":912,"_30106":879,"_20907":52011,"_5":14363,"_27392":51937,"_2946":52012},[],"`EST_RFC7030` for these operations.",{"_3461":913,"_30106":879,"_20907":52014,"_5":14363,"_27392":51937,"_2946":52015},[],"`enrollment_ca`",{"_3461":914,"_30106":879,"_20907":52017,"_5":14363,"_27392":51937,"_2946":52018},[],"ID of the signing CA.",{"_3461":915,"_30106":879,"_20907":52020,"_5":14363,"_27392":51937,"_2946":52021},[],"`verify_csr_signature`",{"_3461":916,"_30106":879,"_20907":52023,"_5":14363,"_27392":51937,"_2946":52024},[],"Keep `true` to verify CSR key possession.",{"_3461":917,"_30106":879,"_20907":52026,"_5":14363,"_27392":51937,"_2946":52027},[],"`enable_replaceable_enrollment`",{"_3461":918,"_30106":879,"_20907":52029,"_5":14363,"_27392":51937,"_2946":52030},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3461":919,"_30106":879,"_20907":52032,"_5":14363,"_27392":51937,"_2946":52033},[],"`est_rfc7030_settings.auth_mode`",{"_3461":920,"_30106":879,"_20907":52035,"_5":14363,"_27392":51937,"_2946":52036},[],"One of the four authentication modes.",{"_3461":921,"_30106":879,"_20907":52038,"_5":14363,"_27392":51937,"_2946":52039},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3461":922,"_30106":879,"_20907":52041,"_5":14363,"_27392":51941,"_2946":52042},[],"The blocks are independent:",{"_3461":923,"_30106":879,"_20907":52044,"_5":14363,"_27392":51941,"_2946":52045},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3461":924,"_30106":879,"_20907":52047,"_5":14363,"_27392":51941,"_2946":52048},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3461":925,"_30106":879,"_20907":52050,"_5":14363,"_27392":51941,"_2946":52051},[],"`auth_mode`",{"_3461":926,"_30106":879,"_20907":52053,"_5":14363,"_27392":51941,"_2946":52054},[],"Control applied in the configured operation",{"_3461":927,"_30106":879,"_20907":52056,"_5":14363,"_27392":51941,"_2946":52057},[],"`CLIENT_CERTIFICATE`",{"_3461":928,"_30106":879,"_20907":52059,"_5":14363,"_27392":51941,"_2946":52060},[],"Presented certificate validation.",{"_3461":929,"_30106":879,"_20907":52062,"_5":14363,"_27392":51941,"_2946":52063},[],"`EXTERNAL_WEBHOOK`",{"_3461":930,"_30106":879,"_20907":52065,"_5":14363,"_27392":51941,"_2946":52066},[],"Configured webhook authorization.",{"_3461":931,"_30106":879,"_20907":52068,"_5":14363,"_27392":51941,"_2946":52069},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3461":932,"_30106":879,"_20907":52071,"_5":14363,"_27392":51941,"_2946":52072},[],"Certificate validation followed by webhook approval.",{"_3461":933,"_30106":879,"_20907":52074,"_5":14363,"_27392":51941,"_2946":52075},[],"`NO_AUTH`",{"_3461":934,"_30106":879,"_20907":52077,"_5":14363,"_27392":51941,"_2946":52078},[],"No DMS requester authentication.",{"_3461":935,"_30106":879,"_20907":52080,"_5":14363,"_27392":51941,"_2946":52081},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3461":936,"_30106":879,"_20907":52083,"_5":14363,"_27392":51941,"_2946":52084},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3461":937,"_30106":879,"_20907":52086,"_5":14363,"_27392":51941,"_2946":52087},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3461":938,"_30106":879,"_20907":52089,"_5":14363,"_27392":51941,"_2946":52090},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3461":939,"_30106":879,"_20907":52092,"_5":14363,"_27392":51945,"_2946":52093},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3461":940,"_30106":879,"_20907":52095,"_5":14363,"_27392":51945,"_2946":52096},[],"`external_webhook_settings` field",{"_3461":941,"_30106":879,"_20907":52098,"_5":14363,"_27392":51945,"_2946":52006},[],{"_3461":942,"_30106":879,"_20907":52100,"_5":14363,"_27392":51945,"_2946":52101},[],"`url`",{"_3461":943,"_30106":879,"_20907":52103,"_5":14363,"_27392":51945,"_2946":52104},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3461":944,"_30106":879,"_20907":52106,"_5":14363,"_27392":51945,"_2946":52107},[],"`method`",{"_3461":945,"_30106":879,"_20907":52109,"_5":14363,"_27392":51945,"_2946":52110},[],"`POST` or `PUT`; `POST` by default.",{"_3461":946,"_30106":879,"_20907":52112,"_5":14363,"_27392":51945,"_2946":52113},[],"`name`",{"_3461":947,"_30106":879,"_20907":52115,"_5":14363,"_27392":51945,"_2946":52116},[],"Label used in service logs.",{"_3461":948,"_30106":879,"_20907":52118,"_5":14363,"_27392":51945,"_2946":52119},[],"`config.auth_mode`",{"_3461":949,"_30106":879,"_20907":52121,"_5":14363,"_27392":51945,"_2946":52122},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3461":950,"_30106":879,"_20907":52124,"_5":14363,"_27392":51945,"_2946":52125},[],"`config.log_level`",{"_3461":951,"_30106":879,"_20907":52127,"_5":14363,"_27392":51945,"_2946":52128},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3461":952,"_30106":879,"_20907":52130,"_5":14363,"_27392":51945,"_2946":52131},[],"`config.apikey_options`",{"_3461":953,"_30106":879,"_20907":52133,"_5":14363,"_27392":51945,"_2946":52134},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3461":954,"_30106":879,"_20907":52136,"_5":14363,"_27392":51945,"_2946":52137},[],"`config.jwt_options`",{"_3461":955,"_30106":879,"_20907":52139,"_5":14363,"_27392":51945,"_2946":52140},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3461":956,"_30106":879,"_20907":52142,"_5":14363,"_27392":51945,"_2946":52143},[],"`config.mtls_options`",{"_3461":957,"_30106":879,"_20907":52145,"_5":14363,"_27392":51945,"_2946":52146},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3461":958,"_30106":879,"_20907":52148,"_5":14363,"_27392":51945,"_2946":52149},[],"`config.insecure_skip_verify`",{"_3461":959,"_30106":879,"_20907":52151,"_5":14363,"_27392":51945,"_2946":52152},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3461":960,"_30106":879,"_20907":52154,"_5":14363,"_27392":51945,"_2946":52155},[],"`config.call_timeout`",{"_3461":961,"_30106":879,"_20907":52157,"_5":14363,"_27392":51945,"_2946":52158},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3461":962,"_30106":879,"_20907":52160,"_5":14363,"_27392":51945,"_2946":52161},[],"Rules for that configuration:",{"_3461":963,"_30106":879,"_20907":52163,"_5":14363,"_27392":51945,"_2946":52164},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3461":964,"_30106":879,"_20907":52166,"_5":14363,"_27392":51945,"_2946":52167},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3461":965,"_30106":879,"_20907":52169,"_5":14363,"_27392":51945,"_2946":52170},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3461":966,"_30106":879,"_20907":52172,"_5":14363,"_27392":51945,"_2946":52173},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3461":967,"_30106":879,"_20907":52175,"_5":14363,"_27392":51945,"_2946":52176},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3461":968,"_30106":879,"_20907":52178,"_5":14363,"_27392":51945,"_2946":52179},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3461":969,"_30106":879,"_20907":52181,"_5":14363,"_27392":51945,"_2946":52182},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3461":970,"_30106":879,"_20907":52184,"_5":14363,"_27392":51945,"_2946":52185},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3461":971,"_30106":879,"_20907":52187,"_5":14363,"_27392":51945,"_2946":52188},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3461":972,"_30106":879,"_20907":52190,"_5":14363,"_27392":51949,"_2946":52191},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3461":973,"_30106":879,"_20907":52193,"_5":14363,"_27392":51953,"_2946":52194},[],"`settings.reenrollment_settings` field",{"_3461":974,"_30106":879,"_20907":52196,"_5":14363,"_27392":51953,"_2946":49547},[],{"_3461":975,"_30106":879,"_20907":52198,"_5":14363,"_27392":51953,"_2946":52199},[],"`reenrollment_delta`",{"_3461":976,"_30106":879,"_20907":52201,"_5":14363,"_27392":51953,"_2946":52202},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3461":977,"_30106":879,"_20907":52204,"_5":14363,"_27392":51953,"_2946":52205},[],"`preventive_delta`",{"_3461":978,"_30106":879,"_20907":52207,"_5":14363,"_27392":51953,"_2946":52208},[],"Preventive operational monitoring threshold.",{"_3461":979,"_30106":879,"_20907":52210,"_5":14363,"_27392":51953,"_2946":52211},[],"`critical_delta`",{"_3461":980,"_30106":879,"_20907":52213,"_5":14363,"_27392":51953,"_2946":52214},[],"Critical operational monitoring threshold.",{"_3461":981,"_30106":879,"_20907":52216,"_5":14363,"_27392":51953,"_2946":52217},[],"`enable_expired_renewal`",{"_3461":982,"_30106":879,"_20907":52219,"_5":14363,"_27392":51953,"_2946":52220},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3461":983,"_30106":879,"_20907":52222,"_5":14363,"_27392":51953,"_2946":52223},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3461":984,"_30106":879,"_20907":52225,"_5":14363,"_27392":51953,"_2946":52226},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3461":985,"_30106":879,"_20907":52228,"_5":14363,"_27392":51953,"_2946":52229},[],"`revoke_on_reenrollment`",{"_3461":986,"_30106":879,"_20907":52231,"_5":14363,"_27392":51953,"_2946":52232},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3461":987,"_30106":879,"_20907":52234,"_5":14363,"_27392":51953,"_2946":52235},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3461":988,"_30106":879,"_20907":52237,"_5":14363,"_27392":51957,"_2946":52238},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3461":989,"_30106":879,"_20907":52240,"_5":14363,"_27392":51961,"_2946":49541},[],{"_3461":990,"_30106":879,"_20907":52242,"_5":14363,"_27392":51961,"_2946":52243},[],"Published material",{"_3461":991,"_30106":879,"_20907":52245,"_5":14363,"_27392":51961,"_2946":52246},[],"**Include Lamassu System CA**",{"_3461":992,"_30106":879,"_20907":52248,"_5":14363,"_27392":51961,"_2946":52249},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3461":993,"_30106":879,"_20907":52251,"_5":14363,"_27392":51961,"_2946":52252},[],"**Include Enrollment CA**",{"_3461":994,"_30106":879,"_20907":52254,"_5":14363,"_27392":51961,"_2946":52255},[],"Selected issuing CA certificate.",{"_3461":995,"_30106":879,"_20907":52257,"_5":14363,"_27392":51961,"_2946":52258},[],"**Managed CAs**",{"_3461":996,"_30106":879,"_20907":52260,"_5":14363,"_27392":51961,"_2946":52261},[],"Explicitly selected CA certificates.",{"_3461":997,"_30106":879,"_20907":52263,"_5":14363,"_27392":51961,"_2946":52264},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3461":998,"_30106":879,"_20907":52266,"_5":14363,"_27392":51965,"_2946":52267},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3461":999,"_30106":879,"_20907":52269,"_5":14363,"_27392":51965,"_2946":52270},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3461":1000,"_30106":879,"_20907":52272,"_5":14363,"_27392":51965,"_2946":52273},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3461":1001,"_30106":879,"_20907":52275,"_5":14363,"_27392":51969,"_2946":52276},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3461":1002,"_30106":1002,"_5":14715,"_2946":52278,"_30459":52279,"_20907":52280,"_27392":1002},"Integrate the EST client",[49157,50625,51639,51637,51820],[],{"_3461":1003,"_30106":1002,"_20907":52282,"_5":14363,"_27392":1002,"_2946":52283},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3461":1004,"_30106":1002,"_5":30456,"_20907":52285,"_27392":52286,"_2946":49167},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3461":1005,"_30106":1002,"_5":30456,"_20907":52288,"_27392":52289,"_2946":52290},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3461":1006,"_30106":1002,"_5":30456,"_20907":52292,"_27392":52293,"_2946":52294},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3461":1007,"_30106":1002,"_5":30456,"_20907":52296,"_27392":52297,"_2946":52298},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3461":1008,"_30106":1002,"_5":30456,"_20907":52300,"_27392":52301,"_2946":52302},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3461":1009,"_30106":1002,"_5":30456,"_20907":52304,"_27392":52305,"_2946":52306},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3461":1010,"_30106":1002,"_20907":52308,"_5":14363,"_27392":1002,"_2946":52309},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3461":1011,"_30106":1002,"_20907":52311,"_5":14363,"_27392":52286,"_2946":52312},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3461":1012,"_30106":1002,"_20907":52314,"_5":14363,"_27392":52286,"_2946":52315},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3461":1013,"_30106":1002,"_20907":52317,"_5":14363,"_27392":52286,"_2946":52318},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3461":1014,"_30106":1002,"_20907":52320,"_5":14363,"_27392":52289,"_2946":52321},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3461":1015,"_30106":1002,"_20907":52323,"_5":14363,"_27392":52289,"_2946":52324},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3461":1016,"_30106":1002,"_20907":52326,"_5":14363,"_27392":52293,"_2946":52327},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3461":1017,"_30106":1002,"_20907":52329,"_5":14363,"_27392":52293,"_2946":52330},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3461":1018,"_30106":1002,"_20907":52332,"_5":14363,"_27392":52297,"_2946":52333},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3461":1019,"_30106":1002,"_20907":52335,"_5":14363,"_27392":52297,"_2946":52336},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3461":1020,"_30106":1002,"_20907":52338,"_5":14363,"_27392":52301,"_2946":52339},[],"For a root that issues directly:",{"_3461":1021,"_30106":1002,"_20907":52341,"_5":14363,"_27392":52301,"_2946":52342},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3461":1022,"_30106":1002,"_20907":52344,"_5":14363,"_27392":52301,"_2946":52345},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3461":1023,"_30106":1002,"_20907":52347,"_5":14363,"_27392":52305,"_2946":52348},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3461":1024,"_30106":1024,"_5":14715,"_2946":52350,"_30459":52351,"_20907":52352,"_27392":1024},"EST reference",[49157,50625,51639,51637,51820],[],{"_3461":1025,"_30106":1024,"_20907":52354,"_5":14363,"_27392":1024,"_2946":52355},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3461":1026,"_30106":1024,"_5":30456,"_20907":52357,"_27392":52358,"_2946":52359},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3461":1027,"_30106":1024,"_5":30456,"_20907":52361,"_27392":52362,"_2946":22658},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3461":1028,"_30106":1024,"_5":30456,"_20907":52364,"_27392":52365,"_2946":26007},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3461":1029,"_30106":1024,"_5":30456,"_20907":52367,"_27392":52368,"_2946":26014},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3461":1030,"_30106":1024,"_5":30456,"_20907":52370,"_27392":52371,"_2946":25333},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3461":1031,"_30106":1024,"_5":30456,"_20907":52373,"_27392":52374,"_2946":52375},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3461":1032,"_30106":1024,"_5":30456,"_20907":52377,"_27392":52378,"_2946":52379},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3461":1033,"_30106":1024,"_5":30456,"_20907":52381,"_27392":52382,"_2946":52383},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3461":1034,"_30106":1024,"_20907":52385,"_5":14363,"_27392":1024,"_2946":52386},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3461":1035,"_30106":1024,"_20907":52388,"_5":14363,"_27392":52358,"_2946":52389},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3461":1036,"_30106":1024,"_20907":52391,"_5":14363,"_27392":52358,"_2946":52392},[],"Operation",{"_3461":1037,"_30106":1024,"_20907":52394,"_5":14363,"_27392":52358,"_2946":52395},[],"Method",{"_3461":1038,"_30106":1024,"_20907":52397,"_5":14363,"_27392":52358,"_2946":52398},[],"Authentication and condition",{"_3461":1039,"_30106":1024,"_20907":52400,"_5":14363,"_27392":52358,"_2946":52401},[],"`/cacerts`",{"_3461":1040,"_30106":1024,"_20907":52403,"_5":14363,"_27392":52358,"_2946":52404},[],"GET",{"_3461":1041,"_30106":1024,"_20907":52406,"_5":14363,"_27392":52358,"_2946":52407},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3461":1042,"_30106":1024,"_20907":52409,"_5":14363,"_27392":52358,"_2946":52410},[],"`/simpleenroll`",{"_3461":1043,"_30106":1024,"_20907":52412,"_5":14363,"_27392":52358,"_2946":52413},[],"POST",{"_3461":1044,"_30106":1024,"_20907":52415,"_5":14363,"_27392":52358,"_2946":52416},[],"Initial authentication and DMS registration/replacement policy.",{"_3461":1045,"_30106":1024,"_20907":52418,"_5":14363,"_27392":52358,"_2946":52419},[],"`/simplereenroll`",{"_3461":1046,"_30106":1024,"_20907":52421,"_5":14363,"_27392":52358,"_2946":52413},[],{"_3461":1047,"_30106":1024,"_20907":52423,"_5":14363,"_27392":52358,"_2946":52424},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3461":1048,"_30106":1024,"_20907":52426,"_5":14363,"_27392":52358,"_2946":52427},[],"`/serverkeygen`",{"_3461":1049,"_30106":1024,"_20907":52429,"_5":14363,"_27392":52358,"_2946":52413},[],{"_3461":1050,"_30106":1024,"_20907":52431,"_5":14363,"_27392":52358,"_2946":52432},[],"Initial authentication and admission; server generation enabled.",{"_3461":1051,"_30106":1024,"_20907":52434,"_5":14363,"_27392":52358,"_2946":52435},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3461":1052,"_30106":1024,"_20907":52437,"_5":14363,"_27392":52362,"_2946":52438},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3461":1053,"_30106":1024,"_20907":52440,"_5":14363,"_27392":52362,"_2946":52441},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3461":1054,"_30106":1024,"_20907":52443,"_5":14363,"_27392":52365,"_2946":52444},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3461":1055,"_30106":1024,"_20907":52446,"_5":14363,"_27392":52365,"_2946":52447},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3461":1056,"_30106":1024,"_20907":52449,"_5":14363,"_27392":52368,"_2946":52450},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3461":1057,"_30106":1024,"_20907":52452,"_5":14363,"_27392":52368,"_2946":52453},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3461":1058,"_30106":1024,"_20907":52455,"_5":14363,"_27392":52371,"_2946":52456},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3461":1059,"_30106":1024,"_20907":52458,"_5":14363,"_27392":52371,"_2946":52459},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3461":1060,"_30106":1024,"_20907":52461,"_5":14363,"_27392":52374,"_2946":52462},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3461":1061,"_30106":1024,"_20907":52464,"_5":14363,"_27392":52374,"_2946":52465},[],"Part",{"_3461":1062,"_30106":1024,"_20907":52467,"_5":14363,"_27392":52374,"_2946":52468},[],"Content after decoding its Base64",{"_3461":1063,"_30106":1024,"_20907":52470,"_5":14363,"_27392":52374,"_2946":52471},[],"`application/pkcs8`",{"_3461":1064,"_30106":1024,"_20907":52473,"_5":14363,"_27392":52374,"_2946":52474},[],"Unencrypted DER PKCS#8 private key.",{"_3461":1065,"_30106":1024,"_20907":52476,"_5":14363,"_27392":52374,"_2946":52477},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3461":1066,"_30106":1024,"_20907":52479,"_5":14363,"_27392":52374,"_2946":52480},[],"DER PKCS#7 containing the issued certificate.",{"_3461":1067,"_30106":1024,"_20907":52482,"_5":14363,"_27392":52374,"_2946":52483},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3461":1068,"_30106":1024,"_20907":52485,"_5":14363,"_27392":52378,"_2946":52486},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3461":1069,"_30106":1024,"_20907":52488,"_5":14363,"_27392":52378,"_2946":52489},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3461":1070,"_30106":1024,"_20907":52491,"_5":14363,"_27392":52378,"_2946":52492},[],"Convert and check the result:",{"_3461":1071,"_30106":1024,"_20907":52494,"_5":14363,"_27392":52378,"_2946":52495},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3461":1072,"_30106":1024,"_20907":52497,"_5":14363,"_27392":52382,"_2946":52498},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3461":1073,"_30106":1024,"_20907":52500,"_5":14363,"_27392":52382,"_2946":52501},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3461":1074,"_30106":1074,"_5":14715,"_2946":51820,"_30459":52503,"_20907":52504,"_27392":1074},[49157,50625,51639,51637,51820],[],{"_3461":1075,"_30106":1074,"_20907":52506,"_5":14363,"_27392":1074,"_2946":52507},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3461":1076,"_30106":1074,"_5":30456,"_20907":52509,"_27392":52510,"_2946":52511},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3461":1077,"_30106":1074,"_5":30456,"_20907":52513,"_27392":52514,"_2946":52515},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3461":1078,"_30106":1074,"_5":30456,"_20907":52517,"_27392":52518,"_2946":52519},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3461":1079,"_30106":1074,"_5":30456,"_20907":52521,"_27392":52522,"_2946":52523},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3461":1080,"_30106":1074,"_20907":52525,"_5":14363,"_27392":1074,"_2946":52526},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3461":1081,"_30106":1074,"_20907":52528,"_5":14363,"_27392":52510,"_2946":52529},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3461":1082,"_30106":1074,"_20907":52531,"_5":14363,"_27392":52510,"_2946":52532},[],"The integrator installs initial EST server trust and an admission credential.",{"_3461":1083,"_30106":1074,"_20907":52534,"_5":14363,"_27392":52510,"_2946":52535},[],"The client requests an identity for its `Device ID` through EST.",{"_3461":1084,"_30106":1074,"_20907":52537,"_5":14363,"_27392":52510,"_2946":52538},[],"Certificate, device binding and key/certificate installation are checked.",{"_3461":1085,"_30106":1074,"_20907":52540,"_5":14363,"_27392":52510,"_2946":52541},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3461":1086,"_30106":1074,"_20907":52543,"_5":14363,"_27392":52510,"_2946":52544},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3461":1087,"_30106":1074,"_20907":52546,"_5":14363,"_27392":52514,"_2946":52547},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3461":1088,"_30106":1074,"_20907":52549,"_5":14363,"_27392":52514,"_2946":52550},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":1089,"_30106":1074,"_20907":52552,"_5":14363,"_27392":52514,"_2946":52553},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3461":1090,"_30106":1074,"_20907":52555,"_5":14363,"_27392":52514,"_2946":52556},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3461":1091,"_30106":1074,"_20907":52558,"_5":14363,"_27392":52518,"_2946":52559},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3461":1092,"_30106":1074,"_20907":52561,"_5":14363,"_27392":52518,"_2946":52562},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3461":1093,"_30106":1074,"_20907":52564,"_5":14363,"_27392":52518,"_2946":52565},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3461":1094,"_30106":1074,"_20907":52567,"_5":14363,"_27392":52518,"_2946":52568},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3461":1095,"_30106":1074,"_20907":52570,"_5":14363,"_27392":52522,"_2946":52571},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3461":1096,"_30106":1074,"_20907":52573,"_5":14363,"_27392":52522,"_2946":52574},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3461":1097,"_30106":1097,"_5":14715,"_2946":52576,"_30459":52577,"_20907":52578,"_27392":1097},"Provisioning strategies",[49157,50625,51639,51637,51820],[],{"_3461":1098,"_30106":1097,"_20907":52580,"_5":14363,"_27392":1097,"_2946":52581},[],"Choose device registration, identity authorization and key generation.",{"_3461":1099,"_30106":1097,"_5":30456,"_20907":52583,"_27392":52584,"_2946":52585},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3461":1100,"_30106":1097,"_5":30456,"_20907":52587,"_27392":52588,"_2946":52589},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3461":1101,"_30106":1097,"_5":30456,"_20907":52591,"_27392":52592,"_2946":52593},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3461":1102,"_30106":1097,"_5":30456,"_20907":52595,"_27392":52596,"_2946":52597},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3461":1103,"_30106":1097,"_5":30456,"_20907":52599,"_27392":52600,"_2946":52601},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3461":1104,"_30106":1097,"_20907":52603,"_5":14363,"_27392":1097,"_2946":52604},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3461":1105,"_30106":1097,"_20907":52606,"_5":14363,"_27392":52584,"_2946":52607},[],"Path",{"_3461":1106,"_30106":1097,"_20907":52609,"_5":14363,"_27392":52584,"_2946":52610},[],"When the device exists",{"_3461":1107,"_30106":1097,"_20907":52612,"_5":14363,"_27392":52584,"_2946":52613},[],"What to check",{"_3461":1108,"_30106":1097,"_20907":52615,"_5":14363,"_27392":52584,"_2946":52616},[],"Manual assignment",{"_3461":1109,"_30106":1097,"_20907":52618,"_5":14363,"_27392":52584,"_2946":52619},[],"An operator creates it before associating a certificate.",{"_3461":1110,"_30106":1097,"_20907":52621,"_5":14363,"_27392":52584,"_2946":52622},[],"ID, owning DMS, certificate CN and bound serial.",{"_3461":1111,"_30106":1097,"_20907":52624,"_5":14363,"_27392":52584,"_2946":52625},[],"EST with `JITP`",{"_3461":1112,"_30106":1097,"_20907":52627,"_5":14363,"_27392":52584,"_2946":52628},[],"Created for an unknown CN during `/simpleenroll`.",{"_3461":1113,"_30106":1097,"_20907":52630,"_5":14363,"_27392":52584,"_2946":52631},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3461":1114,"_30106":1097,"_20907":52633,"_5":14363,"_27392":52584,"_2946":52634},[],"EST with `PRE_REGISTRATION`",{"_3461":1115,"_30106":1097,"_20907":52636,"_5":14363,"_27392":52584,"_2946":52637},[],"Must exist before `/simpleenroll`.",{"_3461":1116,"_30106":1097,"_20907":52639,"_5":14363,"_27392":52584,"_2946":52640},[],"Approved record, same DMS and replacement conditions for your version.",{"_3461":1117,"_30106":1097,"_20907":52642,"_5":14363,"_27392":52584,"_2946":52643},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3461":1118,"_30106":1097,"_20907":52645,"_5":14363,"_27392":52584,"_2946":52646},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3461":1119,"_30106":1097,"_20907":52648,"_5":14363,"_27392":52588,"_2946":52649},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3461":1120,"_30106":1097,"_20907":52651,"_5":14363,"_27392":52588,"_2946":52652},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3461":1121,"_30106":1097,"_20907":52654,"_5":14363,"_27392":52588,"_2946":52655},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3461":1122,"_30106":1097,"_20907":52657,"_5":14363,"_27392":52592,"_2946":52658},[],"Decide initial enrollment and re-enrollment separately:",{"_3461":1123,"_30106":1097,"_20907":52660,"_5":14363,"_27392":52592,"_2946":52661},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3461":1124,"_30106":1097,"_20907":52663,"_5":14363,"_27392":52592,"_2946":52664},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3461":1125,"_30106":1097,"_20907":52666,"_5":14363,"_27392":52592,"_2946":52667},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3461":1126,"_30106":1097,"_20907":52669,"_5":14363,"_27392":52592,"_2946":52670},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3461":1127,"_30106":1097,"_20907":52672,"_5":14363,"_27392":52592,"_2946":52673},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3461":1128,"_30106":1097,"_20907":52675,"_5":14363,"_27392":52596,"_2946":49541},[],{"_3461":1129,"_30106":1097,"_20907":52677,"_5":14363,"_27392":52596,"_2946":52678},[],"Material crossing EST",{"_3461":1130,"_30106":1097,"_20907":52680,"_5":14363,"_27392":52596,"_2946":52681},[],"Device-generated key",{"_3461":1131,"_30106":1097,"_20907":52683,"_5":14363,"_27392":52596,"_2946":52684},[],"Public CSR and certificate; the key stays on the client.",{"_3461":1132,"_30106":1097,"_20907":52686,"_5":14363,"_27392":52596,"_2946":52687},[],"Existing device key",{"_3461":1133,"_30106":1097,"_20907":52689,"_5":14363,"_27392":52596,"_2946":52690},[],"CSR signed with that key and a new certificate.",{"_3461":1134,"_30106":1097,"_20907":52692,"_5":14363,"_27392":52596,"_2946":51958},[],{"_3461":1135,"_30106":1097,"_20907":52694,"_5":14363,"_27392":52596,"_2946":52695},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3461":1136,"_30106":1097,"_20907":52697,"_5":14363,"_27392":52596,"_2946":52698},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3461":1137,"_30106":1097,"_20907":52700,"_5":14363,"_27392":52600,"_2946":52701},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3461":1138,"_30106":1138,"_5":14715,"_2946":52703,"_30459":52704,"_20907":52705,"_27392":1138},"Renewal and recovery",[49157,50625,51639,51637,51820],[],{"_3461":1139,"_30106":1138,"_20907":52707,"_5":14363,"_27392":1138,"_2946":52708},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3461":1140,"_30106":1138,"_5":30456,"_20907":52710,"_27392":52711,"_2946":52712},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3461":1141,"_30106":1138,"_5":30456,"_20907":52714,"_27392":52715,"_2946":52716},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3461":1142,"_30106":1138,"_5":30456,"_20907":52718,"_27392":52719,"_2946":52720},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3461":1143,"_30106":1138,"_5":30456,"_20907":52722,"_27392":52723,"_2946":52724},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3461":1144,"_30106":1138,"_5":30456,"_20907":52726,"_27392":52727,"_2946":52728},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3461":1145,"_30106":1138,"_20907":52730,"_5":14363,"_27392":1138,"_2946":52731},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3461":1146,"_30106":1138,"_20907":52733,"_5":14363,"_27392":52711,"_2946":52734},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3461":1147,"_30106":1138,"_20907":52736,"_5":14363,"_27392":52711,"_2946":52737},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3461":1148,"_30106":1138,"_20907":52739,"_5":14363,"_27392":52711,"_2946":52740},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3461":1149,"_30106":1138,"_20907":52742,"_5":14363,"_27392":52711,"_2946":52743},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3461":1150,"_30106":1138,"_20907":52745,"_5":14363,"_27392":52715,"_2946":52746},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3461":1151,"_30106":1138,"_20907":52748,"_5":14363,"_27392":52715,"_2946":52749},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3461":1152,"_30106":1138,"_20907":52751,"_5":14363,"_27392":52719,"_2946":52752},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3461":1153,"_30106":1138,"_20907":52754,"_5":14363,"_27392":52719,"_2946":52755},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3461":1154,"_30106":1138,"_20907":52757,"_5":14363,"_27392":52719,"_2946":52758},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3461":1155,"_30106":1138,"_20907":52760,"_5":14363,"_27392":52723,"_2946":52761},[],"Situation",{"_3461":1156,"_30106":1138,"_20907":52763,"_5":14363,"_27392":52723,"_2946":52764},[],"Procedure",{"_3461":1157,"_30106":1138,"_20907":52766,"_5":14363,"_27392":52723,"_2946":52767},[],"Valid certificate, outside the window",{"_3461":1158,"_30106":1138,"_20907":52769,"_5":14363,"_27392":52723,"_2946":52770},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3461":1159,"_30106":1138,"_20907":52772,"_5":14363,"_27392":52723,"_2946":52773},[],"Expired certificate, key available",{"_3461":1160,"_30106":1138,"_20907":52775,"_5":14363,"_27392":52723,"_2946":52776},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3461":1161,"_30106":1138,"_20907":52778,"_5":14363,"_27392":52723,"_2946":52779},[],"Renewal through webhook or `NO_AUTH`",{"_3461":1162,"_30106":1138,"_20907":52781,"_5":14363,"_27392":52723,"_2946":52782},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3461":1163,"_30106":1138,"_20907":52784,"_5":14363,"_27392":52723,"_2946":52785},[],"Lost or inaccessible key",{"_3461":1164,"_30106":1138,"_20907":52787,"_5":14363,"_27392":52723,"_2946":52788},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3461":1165,"_30106":1138,"_20907":52790,"_5":14363,"_27392":52723,"_2946":52791},[],"Current identity revoked",{"_3461":1166,"_30106":1138,"_20907":52793,"_5":14363,"_27392":52723,"_2946":52794},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3461":1167,"_30106":1138,"_20907":52796,"_5":14363,"_27392":52723,"_2946":52797},[],"Device without an identity",{"_3461":1168,"_30106":1138,"_20907":52799,"_5":14363,"_27392":52723,"_2946":52800},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3461":1169,"_30106":1138,"_20907":52802,"_5":14363,"_27392":52723,"_2946":52803},[],"Retired device",{"_3461":1170,"_30106":1138,"_20907":52805,"_5":14363,"_27392":52723,"_2946":52806},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3461":1171,"_30106":1138,"_20907":52808,"_5":14363,"_27392":52723,"_2946":52809},[],"Timeout, HTTP 500 or installation failure",{"_3461":1172,"_30106":1138,"_20907":52811,"_5":14363,"_27392":52723,"_2946":52812},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3461":1173,"_30106":1138,"_20907":52814,"_5":14363,"_27392":52727,"_2946":52815},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3461":1174,"_30106":1138,"_20907":52817,"_5":14363,"_27392":52727,"_2946":52818},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3461":1175,"_30106":1175,"_5":14715,"_2946":52820,"_30459":52821,"_20907":52822,"_27392":1175},"Enrollment troubleshooting",[49157,50625,51639,51637,51820],[],{"_3461":1176,"_30106":1175,"_20907":52824,"_5":14363,"_27392":1175,"_2946":52825},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3461":1177,"_30106":1175,"_5":30456,"_20907":52827,"_27392":52828,"_2946":52829},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3461":1178,"_30106":1175,"_5":30456,"_20907":52831,"_27392":52832,"_2946":52833},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3461":1179,"_30106":1175,"_5":30456,"_20907":52835,"_27392":52836,"_2946":52383},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3461":1180,"_30106":1175,"_5":30456,"_20907":52838,"_27392":52839,"_2946":52840},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3461":1181,"_30106":1175,"_20907":52842,"_5":14363,"_27392":1175,"_2946":52843},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3461":1182,"_30106":1175,"_20907":52845,"_5":14363,"_27392":52832,"_2946":52846},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3461":1183,"_30106":1175,"_20907":52848,"_5":14363,"_27392":52832,"_2946":52849},[],"Symptom or message",{"_3461":1184,"_30106":1175,"_20907":52851,"_5":14363,"_27392":52832,"_2946":52613},[],{"_3461":1185,"_30106":1175,"_20907":52853,"_5":14363,"_27392":52832,"_2946":52854},[],"curl rejects TLS, name or issuer",{"_3461":1186,"_30106":1175,"_20907":52856,"_5":14363,"_27392":52832,"_2946":52857},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3461":1187,"_30106":1175,"_20907":52859,"_5":14363,"_27392":52832,"_2946":52860},[],"404 or missing APS",{"_3461":1188,"_30106":1175,"_20907":52862,"_5":14363,"_27392":52832,"_2946":52863},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3461":1189,"_30106":1175,"_20907":52865,"_5":14363,"_27392":52832,"_2946":52866},[],"400, CSR or format error",{"_3461":1190,"_30106":1175,"_20907":52868,"_5":14363,"_27392":52832,"_2946":52869},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3461":1191,"_30106":1175,"_20907":52871,"_5":14363,"_27392":52832,"_2946":52872},[],"Missing credential or invalid certificate",{"_3461":1192,"_30106":1175,"_20907":52874,"_5":14363,"_27392":52832,"_2946":52875},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3461":1193,"_30106":1175,"_20907":52877,"_5":14363,"_27392":52832,"_2946":52878},[],"Webhook denies, times out or responds without authorization",{"_3461":1194,"_30106":1175,"_20907":52880,"_5":14363,"_27392":52832,"_2946":52881},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3461":1195,"_30106":1175,"_20907":52883,"_5":14363,"_27392":52832,"_2946":52884},[],"`unexpected status code: <n>: redirects are not followed`",{"_3461":1196,"_30106":1175,"_20907":52886,"_5":14363,"_27392":52832,"_2946":52887},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3461":1197,"_30106":1175,"_20907":52889,"_5":14363,"_27392":52832,"_2946":52890},[],"`webhook response exceeds 1048576 bytes`",{"_3461":1198,"_30106":1175,"_20907":52892,"_5":14363,"_27392":52832,"_2946":52893},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3461":1199,"_30106":1175,"_20907":52895,"_5":14363,"_27392":52832,"_2946":52896},[],"`webhook config must not reference files`",{"_3461":1200,"_30106":1175,"_20907":52898,"_5":14363,"_27392":52832,"_2946":52899},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3461":1201,"_30106":1175,"_20907":52901,"_5":14363,"_27392":52832,"_2946":52902},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3461":1202,"_30106":1175,"_20907":52904,"_5":14363,"_27392":52832,"_2946":52905},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3461":1203,"_30106":1175,"_20907":52907,"_5":14363,"_27392":52832,"_2946":52908},[],"`webhook mTLS certificate and key are invalid: …`",{"_3461":1204,"_30106":1175,"_20907":52910,"_5":14363,"_27392":52832,"_2946":52911},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3461":1205,"_30106":1175,"_20907":52913,"_5":14363,"_27392":52832,"_2946":52914},[],"400 `struct validation error` creating or updating a DMS",{"_3461":1206,"_30106":1175,"_20907":52916,"_5":14363,"_27392":52832,"_2946":52917},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3461":1207,"_30106":1175,"_20907":52919,"_5":14363,"_27392":52832,"_2946":52920},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3461":1208,"_30106":1175,"_20907":52922,"_5":14363,"_27392":52832,"_2946":52923},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3461":1209,"_30106":1175,"_20907":52925,"_5":14363,"_27392":52832,"_2946":52926},[],"`device not preregistered`",{"_3461":1210,"_30106":1175,"_20907":52928,"_5":14363,"_27392":52832,"_2946":52929},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3461":1211,"_30106":1175,"_20907":52931,"_5":14363,"_27392":52832,"_2946":52932},[],"`forbiddenNewEnrollment`",{"_3461":1212,"_30106":1175,"_20907":52934,"_5":14363,"_27392":52832,"_2946":52935},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3461":1213,"_30106":1175,"_20907":52937,"_5":14363,"_27392":52832,"_2946":52938},[],"Different owning DMS",{"_3461":1214,"_30106":1175,"_20907":52940,"_5":14363,"_27392":52832,"_2946":52941},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3461":1215,"_30106":1175,"_20907":52943,"_5":14363,"_27392":52832,"_2946":52944},[],"`invalid RawSubject bytes`",{"_3461":1216,"_30106":1175,"_20907":52946,"_5":14363,"_27392":52832,"_2946":52947},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3461":1217,"_30106":1175,"_20907":52949,"_5":14363,"_27392":52832,"_2946":52950},[],"`invalid reenroll window`",{"_3461":1218,"_30106":1175,"_20907":52952,"_5":14363,"_27392":52832,"_2946":52953},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3461":1219,"_30106":1175,"_20907":52955,"_5":14363,"_27392":52832,"_2946":52956},[],"Current certificate revoked",{"_3461":1220,"_30106":1175,"_20907":52958,"_5":14363,"_27392":52832,"_2946":52959},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3461":1221,"_30106":1175,"_20907":52961,"_5":14363,"_27392":52832,"_2946":52962},[],"CA, profile or signing error",{"_3461":1222,"_30106":1175,"_20907":52964,"_5":14363,"_27392":52832,"_2946":52965},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3461":1223,"_30106":1175,"_20907":52967,"_5":14363,"_27392":52832,"_2946":52968},[],"HTTP 200 without a device connection",{"_3461":1224,"_30106":1175,"_20907":52970,"_5":14363,"_27392":52832,"_2946":52971},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3461":1225,"_30106":1175,"_20907":52973,"_5":14363,"_27392":52832,"_2946":52974},[],"Timeout or error after issuance",{"_3461":1226,"_30106":1175,"_20907":52976,"_5":14363,"_27392":52832,"_2946":52977},[],"New certificates, current slot and previous identity's state before retrying.",{"_3461":1227,"_30106":1175,"_20907":52979,"_5":14363,"_27392":52836,"_2946":52980},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3461":1228,"_30106":1175,"_20907":52982,"_5":14363,"_27392":52836,"_2946":52983},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3461":1229,"_30106":1175,"_20907":52985,"_5":14363,"_27392":52839,"_2946":52986},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3461":1230,"_30106":1175,"_20907":52988,"_5":14363,"_27392":52839,"_2946":52989},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3461":1231,"_30106":1175,"_20907":52991,"_5":14363,"_27392":52839,"_2946":52992},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3461":1232,"_30106":1175,"_20907":52994,"_5":14363,"_27392":52839,"_2946":52995},[],"Make one request, save headers/body and query the device and certificates.",{"_3461":1233,"_30106":1175,"_20907":52997,"_5":14363,"_27392":52839,"_2946":52998},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3461":1234,"_30106":1175,"_20907":53000,"_5":14363,"_27392":52839,"_2946":53001},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3461":1235,"_30106":1175,"_20907":53003,"_5":14363,"_27392":52839,"_2946":53004},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3461":1236,"_30106":1236,"_5":14715,"_2946":53006,"_30459":53007,"_20907":53008,"_27392":1236},"Trust distribution and updates",[49157,50625,51639,51637,51820],[],{"_3461":1237,"_30106":1236,"_20907":53010,"_5":14363,"_27392":1236,"_2946":53011},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3461":1238,"_30106":1236,"_5":30456,"_20907":53013,"_27392":53014,"_2946":53015},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3461":1239,"_30106":1236,"_5":30456,"_20907":53017,"_27392":53018,"_2946":53019},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3461":1240,"_30106":1236,"_5":30456,"_20907":53021,"_27392":53022,"_2946":53023},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3461":1241,"_30106":1236,"_5":30456,"_20907":53025,"_27392":53026,"_2946":53027},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3461":1242,"_30106":1236,"_5":30456,"_20907":53029,"_27392":53030,"_2946":53031},[],"/docs/pr-preview/pr-60/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3461":1243,"_30106":1236,"_20907":53033,"_5":14363,"_27392":1236,"_2946":53034},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3461":1244,"_30106":1236,"_20907":53036,"_5":14363,"_27392":53014,"_2946":53037},[],"Relationship",{"_3461":1245,"_30106":1236,"_20907":53039,"_5":14363,"_27392":53014,"_2946":53040},[],"Material prepared by its owner",{"_3461":1246,"_30106":1236,"_20907":53042,"_5":14363,"_27392":53014,"_2946":53043},[],"Device → EST server",{"_3461":1247,"_30106":1236,"_20907":53045,"_5":14363,"_27392":53014,"_2946":53046},[],"Previously verified server root, chain or pin and TLS name.",{"_3461":1248,"_30106":1236,"_20907":53048,"_5":14363,"_27392":53014,"_2946":53049},[],"DMS → requester",{"_3461":1249,"_30106":1236,"_20907":53051,"_5":14363,"_27392":53014,"_2946":53052},[],"CAs and rules authorizing initial or renewal credentials.",{"_3461":1250,"_30106":1236,"_20907":53054,"_5":14363,"_27392":53014,"_2946":53055},[],"Consumer → device",{"_3461":1251,"_30106":1236,"_20907":53057,"_5":14363,"_27392":53014,"_2946":53058},[],"Operational identity roots, intermediates, validation and permissions.",{"_3461":1252,"_30106":1236,"_20907":53060,"_5":14363,"_27392":53014,"_2946":53061},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3461":1253,"_30106":1236,"_20907":53063,"_5":14363,"_27392":53018,"_2946":53064},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3461":1254,"_30106":1236,"_20907":53066,"_5":14363,"_27392":53018,"_2946":53067},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3461":1255,"_30106":1236,"_20907":53069,"_5":14363,"_27392":53022,"_2946":53070},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3461":1256,"_30106":1236,"_20907":53072,"_5":14363,"_27392":53022,"_2946":53073},[],"Select policy-approved roots as anchors.",{"_3461":1257,"_30106":1236,"_20907":53075,"_5":14363,"_27392":53022,"_2946":53076},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3461":1258,"_30106":1236,"_20907":53078,"_5":14363,"_27392":53022,"_2946":53079},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3461":1259,"_30106":1236,"_20907":53081,"_5":14363,"_27392":53022,"_2946":53082},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3461":1260,"_30106":1236,"_20907":53084,"_5":14363,"_27392":53022,"_2946":53085},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3461":1261,"_30106":1236,"_20907":53087,"_5":14363,"_27392":53026,"_2946":53088},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3461":1262,"_30106":1236,"_20907":53090,"_5":14363,"_27392":53026,"_2946":53091},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3461":1263,"_30106":1236,"_20907":53093,"_5":14363,"_27392":53026,"_2946":53094},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3461":1264,"_30106":1236,"_20907":53096,"_5":14363,"_27392":53030,"_2946":53097},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3461":1265,"_30106":1265,"_5":14715,"_2946":53099,"_30459":53100,"_20907":53102,"_27392":1265},"AWS IoT Core",[49157,50625,51639,51637,53101],"Integrations",[],{"_3461":1266,"_30106":1265,"_20907":53104,"_5":14363,"_27392":1265,"_2946":53105},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3461":1267,"_30106":1265,"_5":30456,"_20907":53107,"_27392":53108,"_2946":53109},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3461":1268,"_30106":1265,"_5":30456,"_20907":53111,"_27392":53112,"_2946":53113},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3461":1269,"_30106":1265,"_5":30456,"_20907":53115,"_27392":53116,"_2946":53117},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3461":1270,"_30106":1265,"_5":30456,"_20907":53119,"_27392":53120,"_2946":53121},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3461":1271,"_30106":1265,"_5":30456,"_20907":53123,"_27392":53124,"_2946":53125},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3461":1272,"_30106":1265,"_5":30456,"_20907":53127,"_27392":53128,"_2946":53129},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3461":1273,"_30106":1265,"_5":30456,"_20907":53131,"_27392":53132,"_2946":53133},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3461":1274,"_30106":1265,"_5":30456,"_20907":53135,"_27392":53136,"_2946":53137},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3461":1275,"_30106":1265,"_5":30456,"_20907":53139,"_27392":53140,"_2946":53141},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3461":1276,"_30106":1265,"_5":30456,"_20907":53143,"_27392":53144,"_2946":53145},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3461":1277,"_30106":1265,"_5":30456,"_20907":53147,"_27392":53148,"_2946":53149},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3461":1278,"_30106":1265,"_5":30456,"_20907":53151,"_27392":53152,"_2946":53153},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3461":1279,"_30106":1265,"_5":30456,"_20907":53155,"_27392":53156,"_2946":53157},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3461":1280,"_30106":1265,"_5":30456,"_20907":53159,"_27392":53160,"_2946":53161},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3461":1281,"_30106":1265,"_5":30456,"_20907":53163,"_27392":53164,"_2946":53165},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3461":1282,"_30106":1265,"_5":30456,"_20907":53167,"_27392":53168,"_2946":53169},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3461":1283,"_30106":1265,"_5":30456,"_20907":53171,"_27392":53172,"_2946":53173},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3461":1284,"_30106":1265,"_5":30456,"_20907":53175,"_27392":53176,"_2946":53177},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3461":1285,"_30106":1265,"_5":30456,"_20907":53179,"_27392":53180,"_2946":53181},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3461":1286,"_30106":1265,"_5":30456,"_20907":53183,"_27392":53184,"_2946":53185},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3461":1287,"_30106":1265,"_5":30456,"_20907":53187,"_27392":53188,"_2946":53189},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3461":1288,"_30106":1265,"_5":30456,"_20907":53191,"_27392":53192,"_2946":53193},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3461":1289,"_30106":1265,"_5":30456,"_20907":53195,"_27392":53196,"_2946":53197},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3461":1290,"_30106":1265,"_5":30456,"_20907":53199,"_27392":53200,"_2946":53201},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3461":1291,"_30106":1265,"_5":30456,"_20907":53203,"_27392":53204,"_2946":53205},[],"/docs/pr-preview/pr-60/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3461":1292,"_30106":1265,"_20907":53207,"_5":14363,"_27392":1265,"_2946":53208},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3461":1293,"_30106":1265,"_20907":53210,"_5":14363,"_27392":1265,"_2946":53211},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3461":1294,"_30106":1265,"_20907":53213,"_5":14363,"_27392":1265,"_2946":53214},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3461":1295,"_30106":1265,"_20907":53216,"_5":14363,"_27392":53108,"_2946":53217},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3461":1296,"_30106":1265,"_20907":53219,"_5":14363,"_27392":53108,"_2946":53220},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3461":1297,"_30106":1265,"_20907":53222,"_5":14363,"_27392":53108,"_2946":53223},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3461":1298,"_30106":1265,"_20907":53225,"_5":14363,"_27392":53108,"_2946":53226},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3461":1299,"_30106":1265,"_20907":53228,"_5":14363,"_27392":53112,"_2946":53229},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3461":1300,"_30106":1265,"_20907":53231,"_5":14363,"_27392":53116,"_2946":53232},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3461":1301,"_30106":1265,"_20907":53234,"_5":14363,"_27392":53116,"_2946":53235},[],"IAM action",{"_3461":1302,"_30106":1265,"_20907":53237,"_5":14363,"_27392":53116,"_2946":49547},[],{"_3461":1303,"_30106":1265,"_20907":53239,"_5":14363,"_27392":53116,"_2946":53240},[],"`iot:GetRegistrationCode`",{"_3461":1304,"_30106":1265,"_20907":53242,"_5":14363,"_27392":53116,"_2946":53243},[],"Obtain the verification code for CA registration in the Primary Account",{"_3461":1305,"_30106":1265,"_20907":53245,"_5":14363,"_27392":53116,"_2946":53246},[],"`iot:RegisterCACertificate`",{"_3461":1306,"_30106":1265,"_20907":53248,"_5":14363,"_27392":53116,"_2946":53249},[],"Register the CA in AWS IoT",{"_3461":1307,"_30106":1265,"_20907":53251,"_5":14363,"_27392":53116,"_2946":53252},[],"`iot:DescribeCACertificate`",{"_3461":1308,"_30106":1265,"_20907":53254,"_5":14363,"_27392":53116,"_2946":53255},[],"Check the CA registration status",{"_3461":1309,"_30106":1265,"_20907":53257,"_5":14363,"_27392":53116,"_2946":53258},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3461":1310,"_30106":1265,"_20907":53260,"_5":14363,"_27392":53116,"_2946":53261},[],"Create or update Things in IoT Core",{"_3461":1311,"_30106":1265,"_20907":53263,"_5":14363,"_27392":53116,"_2946":53264},[],"`iot:RegisterThing`",{"_3461":1312,"_30106":1265,"_20907":53266,"_5":14363,"_27392":53116,"_2946":53267},[],"Provision Things through a template",{"_3461":1313,"_30106":1265,"_20907":53269,"_5":14363,"_27392":53116,"_2946":53270},[],"`iot:RegisterCertificate`",{"_3461":1314,"_30106":1265,"_20907":53272,"_5":14363,"_27392":53116,"_2946":53273},[],"Register device certificates",{"_3461":1315,"_30106":1265,"_20907":53275,"_5":14363,"_27392":53116,"_2946":53276},[],"`iot:UpdateCertificate`",{"_3461":1316,"_30106":1265,"_20907":53278,"_5":14363,"_27392":53116,"_2946":53279},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3461":1317,"_30106":1265,"_20907":53281,"_5":14363,"_27392":53116,"_2946":53282},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3461":1318,"_30106":1265,"_20907":53284,"_5":14363,"_27392":53116,"_2946":53285},[],"Create and attach IoT policies",{"_3461":1319,"_30106":1265,"_20907":53287,"_5":14363,"_27392":53116,"_2946":53288},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3461":1320,"_30106":1265,"_20907":53290,"_5":14363,"_27392":53116,"_2946":53291},[],"Manage Thing groups",{"_3461":1321,"_30106":1265,"_20907":53293,"_5":14363,"_27392":53116,"_2946":53294},[],"`iot:CreateProvisioningTemplate`",{"_3461":1322,"_30106":1265,"_20907":53296,"_5":14363,"_27392":53116,"_2946":53297},[],"Create JITP templates",{"_3461":1323,"_30106":1265,"_20907":53299,"_5":14363,"_27392":53116,"_2946":53300},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3461":1324,"_30106":1265,"_20907":53302,"_5":14363,"_27392":53116,"_2946":53303},[],"Read and write the Device Shadow",{"_3461":1325,"_30106":1265,"_20907":53305,"_5":14363,"_27392":53116,"_2946":53306},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3461":1326,"_30106":1265,"_20907":53308,"_5":14363,"_27392":53120,"_2946":53309},[],"Parameter",{"_3461":1327,"_30106":1265,"_20907":53311,"_5":14363,"_27392":53120,"_2946":53312},[],"Type",{"_3461":1328,"_30106":1265,"_20907":53314,"_5":14363,"_27392":53120,"_2946":53315},[],"Required",{"_3461":1329,"_30106":1265,"_20907":53317,"_5":14363,"_27392":53120,"_2946":53318},[],"Description",{"_3461":1330,"_30106":1265,"_20907":53320,"_5":14363,"_27392":53120,"_2946":53321},[],"`connector_id`",{"_3461":1331,"_30106":1265,"_20907":53323,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1332,"_30106":1265,"_20907":53325,"_5":14363,"_27392":53120,"_2946":53326},[],"Yes",{"_3461":1333,"_30106":1265,"_20907":53328,"_5":14363,"_27392":53120,"_2946":53329},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3461":1334,"_30106":1265,"_20907":53331,"_5":14363,"_27392":53120,"_2946":53332},[],"`aws_config.region`",{"_3461":1335,"_30106":1265,"_20907":53334,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1336,"_30106":1265,"_20907":53336,"_5":14363,"_27392":53120,"_2946":53326},[],{"_3461":1337,"_30106":1265,"_20907":53338,"_5":14363,"_27392":53120,"_2946":53339},[],"AWS region where the connector operates.",{"_3461":1338,"_30106":1265,"_20907":53341,"_5":14363,"_27392":53120,"_2946":53342},[],"`aws_config.auth_method`",{"_3461":1339,"_30106":1265,"_20907":53344,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1340,"_30106":1265,"_20907":53346,"_5":14363,"_27392":53120,"_2946":53326},[],{"_3461":1341,"_30106":1265,"_20907":53348,"_5":14363,"_27392":53120,"_2946":53349},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3461":1342,"_30106":1265,"_20907":53351,"_5":14363,"_27392":53120,"_2946":53352},[],"`aws_config.access_key_id`",{"_3461":1343,"_30106":1265,"_20907":53354,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1344,"_30106":1265,"_20907":53356,"_5":14363,"_27392":53120,"_2946":53357},[],"Only with `auth_method=static`",{"_3461":1345,"_30106":1265,"_20907":53359,"_5":14363,"_27392":53120,"_2946":53360},[],"AWS access key.",{"_3461":1346,"_30106":1265,"_20907":53362,"_5":14363,"_27392":53120,"_2946":53363},[],"`aws_config.secret_access_key`",{"_3461":1347,"_30106":1265,"_20907":53365,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1348,"_30106":1265,"_20907":53367,"_5":14363,"_27392":53120,"_2946":53357},[],{"_3461":1349,"_30106":1265,"_20907":53369,"_5":14363,"_27392":53120,"_2946":53370},[],"AWS secret key.",{"_3461":1350,"_30106":1265,"_20907":53372,"_5":14363,"_27392":53120,"_2946":53373},[],"`aws_config.session_token`",{"_3461":1351,"_30106":1265,"_20907":53375,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1352,"_30106":1265,"_20907":53377,"_5":14363,"_27392":53120,"_2946":53378},[],"No",{"_3461":1353,"_30106":1265,"_20907":53380,"_5":14363,"_27392":53120,"_2946":53381},[],"Session token (with `auth_method=static`).",{"_3461":1354,"_30106":1265,"_20907":53383,"_5":14363,"_27392":53120,"_2946":53384},[],"`aws_config.role_arn`",{"_3461":1355,"_30106":1265,"_20907":53386,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1356,"_30106":1265,"_20907":53388,"_5":14363,"_27392":53120,"_2946":53389},[],"Only with `auth_method=role`",{"_3461":1357,"_30106":1265,"_20907":53391,"_5":14363,"_27392":53120,"_2946":53392},[],"ARN of the role to assume.",{"_3461":1358,"_30106":1265,"_20907":53394,"_5":14363,"_27392":53120,"_2946":53395},[],"`aws_config.endpoint_url`",{"_3461":1359,"_30106":1265,"_20907":53397,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1360,"_30106":1265,"_20907":53399,"_5":14363,"_27392":53120,"_2946":53378},[],{"_3461":1361,"_30106":1265,"_20907":53401,"_5":14363,"_27392":53120,"_2946":53402},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3461":1362,"_30106":1265,"_20907":53404,"_5":14363,"_27392":53120,"_2946":53405},[],"`subscriber_event_bus`",{"_3461":1363,"_30106":1265,"_20907":53407,"_5":14363,"_27392":53120,"_2946":17602},[],{"_3461":1364,"_30106":1265,"_20907":53409,"_5":14363,"_27392":53120,"_2946":53326},[],{"_3461":1365,"_30106":1265,"_20907":53411,"_5":14363,"_27392":53120,"_2946":53412},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3461":1366,"_30106":1265,"_20907":53414,"_5":14363,"_27392":53120,"_2946":53415},[],"`dms_manager_client`",{"_3461":1367,"_30106":1265,"_20907":53417,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1368,"_30106":1265,"_20907":53419,"_5":14363,"_27392":53120,"_2946":53326},[],{"_3461":1369,"_30106":1265,"_20907":53421,"_5":14363,"_27392":53120,"_2946":53422},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3461":1370,"_30106":1265,"_20907":53424,"_5":14363,"_27392":53120,"_2946":53425},[],"`device_manager_client`",{"_3461":1371,"_30106":1265,"_20907":53427,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1372,"_30106":1265,"_20907":53429,"_5":14363,"_27392":53120,"_2946":53326},[],{"_3461":1373,"_30106":1265,"_20907":53431,"_5":14363,"_27392":53120,"_2946":53432},[],"HTTP URL of Lamassu's Device Manager.",{"_3461":1374,"_30106":1265,"_20907":53434,"_5":14363,"_27392":53120,"_2946":53435},[],"`ca_client`",{"_3461":1375,"_30106":1265,"_20907":53437,"_5":14363,"_27392":53120,"_2946":24973},[],{"_3461":1376,"_30106":1265,"_20907":53439,"_5":14363,"_27392":53120,"_2946":53326},[],{"_3461":1377,"_30106":1265,"_20907":53441,"_5":14363,"_27392":53120,"_2946":53442},[],"HTTP URL of Lamassu's CA service.",{"_3461":1378,"_30106":1265,"_20907":53444,"_5":14363,"_27392":53124,"_2946":53445},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3461":1379,"_30106":1265,"_20907":53447,"_5":14363,"_27392":53124,"_2946":53448},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3461":1380,"_30106":1265,"_20907":53450,"_5":14363,"_27392":53124,"_2946":53451},[],"CloudEvent type",{"_3461":1381,"_30106":1265,"_20907":53453,"_5":14363,"_27392":53124,"_2946":53454},[],"Lamassu resource",{"_3461":1382,"_30106":1265,"_20907":53456,"_5":14363,"_27392":53124,"_2946":53457},[],"AWS Resource",{"_3461":1383,"_30106":1265,"_20907":53459,"_5":14363,"_27392":53124,"_2946":53460},[],"IAM actions",{"_3461":1384,"_30106":1265,"_20907":53462,"_5":14363,"_27392":53124,"_2946":53463},[],"AWS calls and effect",{"_3461":1385,"_30106":1265,"_20907":53465,"_5":14363,"_27392":53124,"_2946":53466},[],"Where in this page",{"_3461":1386,"_30106":1265,"_20907":53468,"_5":14363,"_27392":53124,"_2946":53469},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3461":1387,"_30106":1265,"_20907":53471,"_5":14363,"_27392":53124,"_2946":53472},[],"CA",{"_3461":1388,"_30106":1265,"_20907":53474,"_5":14363,"_27392":53124,"_2946":53475},[],"`IoTCore/CACertificate`",{"_3461":1389,"_30106":1265,"_20907":53477,"_5":14363,"_27392":53124,"_2946":53478},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3461":1390,"_30106":1265,"_20907":53480,"_5":14363,"_27392":53124,"_2946":53481},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3461":1391,"_30106":1265,"_20907":53483,"_5":14363,"_27392":53124,"_2946":53137},[],{"_3461":1392,"_30106":1265,"_20907":53485,"_5":14363,"_27392":53124,"_2946":53486},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3461":1393,"_30106":1265,"_20907":53488,"_5":14363,"_27392":53124,"_2946":53489},[],"DMS",{"_3461":1394,"_30106":1265,"_20907":53491,"_5":14363,"_27392":53124,"_2946":53492},[],"`IoTCore/ProvisioningTemplate`",{"_3461":1395,"_30106":1265,"_20907":53494,"_5":14363,"_27392":53124,"_2946":53495},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3461":1396,"_30106":1265,"_20907":53497,"_5":14363,"_27392":53124,"_2946":53498},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3461":1397,"_30106":1265,"_20907":53500,"_5":14363,"_27392":53124,"_2946":53165},[],{"_3461":1398,"_30106":1265,"_20907":53502,"_5":14363,"_27392":53124,"_2946":53503},[],"`EventBindDeviceIdentityKey`",{"_3461":1399,"_30106":1265,"_20907":53505,"_5":14363,"_27392":53124,"_2946":53506},[],"Device",{"_3461":1400,"_30106":1265,"_20907":53508,"_5":14363,"_27392":53124,"_2946":53509},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3461":1401,"_30106":1265,"_20907":53511,"_5":14363,"_27392":53124,"_2946":53512},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3461":1402,"_30106":1265,"_20907":53514,"_5":14363,"_27392":53124,"_2946":53515},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3461":1403,"_30106":1265,"_20907":53517,"_5":14363,"_27392":53124,"_2946":53173},[],{"_3461":1404,"_30106":1265,"_20907":53519,"_5":14363,"_27392":53124,"_2946":53520},[],"`EventUpdateCertificateStatusKey`",{"_3461":1405,"_30106":1265,"_20907":53522,"_5":14363,"_27392":53124,"_2946":53523},[],"Certificate",{"_3461":1406,"_30106":1265,"_20907":53525,"_5":14363,"_27392":53124,"_2946":53526},[],"`IoTCore/Certificate`",{"_3461":1407,"_30106":1265,"_20907":53528,"_5":14363,"_27392":53124,"_2946":53529},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3461":1408,"_30106":1265,"_20907":53531,"_5":14363,"_27392":53124,"_2946":53532},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3461":1409,"_30106":1265,"_20907":53534,"_5":14363,"_27392":53124,"_2946":53185},[],{"_3461":1410,"_30106":1265,"_20907":53536,"_5":14363,"_27392":53124,"_2946":53537},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3461":1411,"_30106":1265,"_20907":53539,"_5":14363,"_27392":53124,"_2946":53540},[],"Certificate / Device",{"_3461":1412,"_30106":1265,"_20907":53542,"_5":14363,"_27392":53124,"_2946":53543},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3461":1413,"_30106":1265,"_20907":53545,"_5":14363,"_27392":53124,"_2946":49553},[],{"_3461":1414,"_30106":1265,"_20907":53547,"_5":14363,"_27392":53124,"_2946":53548},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3461":1415,"_30106":1265,"_20907":53550,"_5":14363,"_27392":53124,"_2946":53193},[],{"_3461":1416,"_30106":1265,"_20907":53552,"_5":14363,"_27392":53128,"_2946":53553},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3461":1417,"_30106":1265,"_20907":53555,"_5":14363,"_27392":53132,"_2946":53556},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3461":1418,"_30106":1265,"_20907":53558,"_5":14363,"_27392":53132,"_2946":53559},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3461":1419,"_30106":1265,"_20907":53561,"_5":14363,"_27392":53136,"_2946":53562},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3461":1420,"_30106":1265,"_20907":53564,"_5":14363,"_27392":53136,"_2946":53565},[],"Transition",{"_3461":1421,"_30106":1265,"_20907":53567,"_5":14363,"_27392":53136,"_2946":53568},[],"AWS calls",{"_3461":1422,"_30106":1265,"_20907":53570,"_5":14363,"_27392":53136,"_2946":53571},[],"`NotRegistered` → `Requested`",{"_3461":1423,"_30106":1265,"_20907":53573,"_5":14363,"_27392":53136,"_2946":53574},[],"none (metadata write only)",{"_3461":1424,"_30106":1265,"_20907":53576,"_5":14363,"_27392":53136,"_2946":53577},[],"`Requested` → `Registering`",{"_3461":1425,"_30106":1265,"_20907":53579,"_5":14363,"_27392":53136,"_2946":53580},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3461":1426,"_30106":1265,"_20907":53582,"_5":14363,"_27392":53136,"_2946":53583},[],"`Registering` → `Succeeded`",{"_3461":1427,"_30106":1265,"_20907":53585,"_5":14363,"_27392":53136,"_2946":53586},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3461":1428,"_30106":1265,"_20907":53588,"_5":14363,"_27392":53136,"_2946":53589},[],"`Registering` → `Failed`",{"_3461":1429,"_30106":1265,"_20907":53591,"_5":14363,"_27392":53136,"_2946":53592},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3461":1430,"_30106":1265,"_20907":53594,"_5":14363,"_27392":53136,"_2946":53595},[],"`Failed` / `Succeeded` → `Requested`",{"_3461":1431,"_30106":1265,"_20907":53597,"_5":14363,"_27392":53136,"_2946":53598},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3461":1432,"_30106":1265,"_20907":53600,"_5":14363,"_27392":53140,"_2946":53601},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3461":1433,"_30106":1265,"_20907":53603,"_5":14363,"_27392":53140,"_2946":53604},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3461":1434,"_30106":1265,"_20907":53606,"_5":14363,"_27392":53140,"_2946":53607},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3461":1435,"_30106":1265,"_20907":53609,"_5":14363,"_27392":53140,"_2946":53610},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3461":1436,"_30106":1265,"_20907":53612,"_5":14363,"_27392":53140,"_2946":53613},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3461":1437,"_30106":1265,"_20907":53615,"_5":14363,"_27392":53140,"_2946":53616},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3461":1438,"_30106":1265,"_20907":53618,"_5":14363,"_27392":53144,"_2946":53619},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3461":1439,"_30106":1265,"_20907":53621,"_5":14363,"_27392":53148,"_2946":53622},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3461":1440,"_30106":1265,"_20907":53624,"_5":14363,"_27392":53148,"_2946":53625},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3461":1441,"_30106":1265,"_20907":53627,"_5":14363,"_27392":53152,"_2946":53628},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3461":1442,"_30106":1265,"_20907":53630,"_5":14363,"_27392":53156,"_2946":53631},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3461":1443,"_30106":1265,"_20907":53633,"_5":14363,"_27392":53156,"_2946":53634},[],"Creates or updates the IoT policies configured in the DMS.",{"_3461":1444,"_30106":1265,"_20907":53636,"_5":14363,"_27392":53156,"_2946":53637},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3461":1445,"_30106":1265,"_20907":53639,"_5":14363,"_27392":53156,"_2946":53640},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3461":1446,"_30106":1265,"_20907":53642,"_5":14363,"_27392":53156,"_2946":53643},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3461":1447,"_30106":1265,"_20907":53645,"_5":14363,"_27392":53156,"_2946":53646},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3461":1448,"_30106":1265,"_20907":53648,"_5":14363,"_27392":53156,"_2946":53649},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3461":1449,"_30106":1265,"_20907":53651,"_5":14363,"_27392":53160,"_2946":53652},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3461":1450,"_30106":1265,"_20907":53654,"_5":14363,"_27392":53160,"_2946":53655},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3461":1451,"_30106":1265,"_20907":53657,"_5":14363,"_27392":53160,"_2946":53658},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3461":1452,"_30106":1265,"_20907":53660,"_5":14363,"_27392":53160,"_2946":53661},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3461":1453,"_30106":1265,"_20907":53663,"_5":14363,"_27392":53160,"_2946":53664},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3461":1454,"_30106":1265,"_20907":53666,"_5":14363,"_27392":53164,"_2946":53667},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3461":1455,"_30106":1265,"_20907":53669,"_5":14363,"_27392":53164,"_2946":53565},[],{"_3461":1456,"_30106":1265,"_20907":53671,"_5":14363,"_27392":53164,"_2946":53568},[],{"_3461":1457,"_30106":1265,"_20907":53673,"_5":14363,"_27392":53164,"_2946":53674},[],"`Unconfigured` → `None` / `Auto`",{"_3461":1458,"_30106":1265,"_20907":53676,"_5":14363,"_27392":53164,"_2946":53677},[],"none (configuration only)",{"_3461":1459,"_30106":1265,"_20907":53679,"_5":14363,"_27392":53164,"_2946":53680},[],"`None` ↔ `Auto`",{"_3461":1460,"_30106":1265,"_20907":53682,"_5":14363,"_27392":53164,"_2946":53677},[],{"_3461":1461,"_30106":1265,"_20907":53684,"_5":14363,"_27392":53164,"_2946":53685},[],"Any → `Jitp`",{"_3461":1462,"_30106":1265,"_20907":53687,"_5":14363,"_27392":53164,"_2946":53688},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3461":1463,"_30106":1265,"_20907":53690,"_5":14363,"_27392":53164,"_2946":53691},[],"`Jitp` → `None` / `Auto`",{"_3461":1464,"_30106":1265,"_20907":53693,"_5":14363,"_27392":53164,"_2946":53694},[],"none (the template stays in the AWS account)",{"_3461":1465,"_30106":1265,"_20907":53696,"_5":14363,"_27392":53168,"_2946":53697},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3461":1466,"_30106":1265,"_20907":53699,"_5":14363,"_27392":53168,"_2946":53700},[],"The full flow from the device's perspective is:",{"_3461":1467,"_30106":1265,"_20907":53702,"_5":14363,"_27392":53168,"_2946":53703},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3461":1468,"_30106":1265,"_20907":53705,"_5":14363,"_27392":53172,"_2946":53706},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3461":1469,"_30106":1265,"_20907":53708,"_5":14363,"_27392":53172,"_2946":53565},[],{"_3461":1470,"_30106":1265,"_20907":53710,"_5":14363,"_27392":53172,"_2946":53568},[],{"_3461":1471,"_30106":1265,"_20907":53712,"_5":14363,"_27392":53172,"_2946":53713},[],"`Absent` → `Provisioned`",{"_3461":1472,"_30106":1265,"_20907":53715,"_5":14363,"_27392":53172,"_2946":53716},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3461":1473,"_30106":1265,"_20907":53718,"_5":14363,"_27392":53172,"_2946":53719},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3461":1474,"_30106":1265,"_20907":53721,"_5":14363,"_27392":53172,"_2946":53722},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3461":1475,"_30106":1265,"_20907":53724,"_5":14363,"_27392":53172,"_2946":53725},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3461":1476,"_30106":1265,"_20907":53727,"_5":14363,"_27392":53176,"_2946":53728},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3461":1477,"_30106":1265,"_20907":53730,"_5":14363,"_27392":53176,"_2946":53731},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3461":1478,"_30106":1265,"_20907":53733,"_5":14363,"_27392":53176,"_2946":53734},[],"For the JITP flow to work correctly:",{"_3461":1479,"_30106":1265,"_20907":53736,"_5":14363,"_27392":53176,"_2946":53737},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3461":1480,"_30106":1265,"_20907":53739,"_5":14363,"_27392":53176,"_2946":53740},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3461":1481,"_30106":1265,"_20907":53742,"_5":14363,"_27392":53176,"_2946":53743},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3461":1482,"_30106":1265,"_20907":53745,"_5":14363,"_27392":53176,"_2946":53746},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3461":1483,"_30106":1265,"_20907":53748,"_5":14363,"_27392":53180,"_2946":53749},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3461":1484,"_30106":1265,"_20907":53751,"_5":14363,"_27392":53180,"_2946":53752},[],"Status in Lamassu",{"_3461":1485,"_30106":1265,"_20907":53754,"_5":14363,"_27392":53180,"_2946":53755},[],"Revocation reason",{"_3461":1486,"_30106":1265,"_20907":53757,"_5":14363,"_27392":53180,"_2946":53758},[],"Status in AWS IoT Core",{"_3461":1487,"_30106":1265,"_20907":53760,"_5":14363,"_27392":53180,"_2946":53761},[],"`Active`",{"_3461":1488,"_30106":1265,"_20907":53763,"_5":14363,"_27392":53180,"_2946":53764},[],"None",{"_3461":1489,"_30106":1265,"_20907":53766,"_5":14363,"_27392":53180,"_2946":53767},[],"`ACTIVE`",{"_3461":1490,"_30106":1265,"_20907":53769,"_5":14363,"_27392":53180,"_2946":53770},[],"`Revoked`",{"_3461":1491,"_30106":1265,"_20907":53772,"_5":14363,"_27392":53180,"_2946":53773},[],"`certificateHold`",{"_3461":1492,"_30106":1265,"_20907":53775,"_5":14363,"_27392":53180,"_2946":53776},[],"`INACTIVE`",{"_3461":1493,"_30106":1265,"_20907":53778,"_5":14363,"_27392":53180,"_2946":53770},[],{"_3461":1494,"_30106":1265,"_20907":53780,"_5":14363,"_27392":53180,"_2946":53781},[],"Any other reason",{"_3461":1495,"_30106":1265,"_20907":53783,"_5":14363,"_27392":53180,"_2946":53784},[],"`REVOKED`",{"_3461":1496,"_30106":1265,"_20907":53786,"_5":14363,"_27392":53180,"_2946":53787},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3461":1497,"_30106":1265,"_20907":53789,"_5":14363,"_27392":53184,"_2946":53790},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3461":1498,"_30106":1265,"_20907":53792,"_5":14363,"_27392":53184,"_2946":53565},[],{"_3461":1499,"_30106":1265,"_20907":53794,"_5":14363,"_27392":53184,"_2946":53568},[],{"_3461":1500,"_30106":1265,"_20907":53796,"_5":14363,"_27392":53184,"_2946":53797},[],"`NotSynced` → `Active`",{"_3461":1501,"_30106":1265,"_20907":53799,"_5":14363,"_27392":53184,"_2946":53276},[],{"_3461":1502,"_30106":1265,"_20907":53801,"_5":14363,"_27392":53184,"_2946":53802},[],"`Active` → `Inactive`",{"_3461":1503,"_30106":1265,"_20907":53804,"_5":14363,"_27392":53184,"_2946":53805},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3461":1504,"_30106":1265,"_20907":53807,"_5":14363,"_27392":53184,"_2946":53808},[],"`Active` → `Revoked`",{"_3461":1505,"_30106":1265,"_20907":53810,"_5":14363,"_27392":53184,"_2946":53805},[],{"_3461":1506,"_30106":1265,"_20907":53812,"_5":14363,"_27392":53184,"_2946":53813},[],"`Inactive` / `Revoked` → `Active`",{"_3461":1507,"_30106":1265,"_20907":53815,"_5":14363,"_27392":53184,"_2946":53276},[],{"_3461":1508,"_30106":1265,"_20907":53817,"_5":14363,"_27392":53184,"_2946":53818},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3461":1509,"_30106":1265,"_20907":53820,"_5":14363,"_27392":53184,"_2946":53821},[],"none (these states are not synced to AWS)",{"_3461":1510,"_30106":1265,"_20907":53823,"_5":14363,"_27392":53188,"_2946":53824},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3461":1511,"_30106":1265,"_20907":53826,"_5":14363,"_27392":53188,"_2946":53827},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3461":1512,"_30106":1265,"_20907":53829,"_5":14363,"_27392":53188,"_2946":53830},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3461":1513,"_30106":1265,"_20907":53832,"_5":14363,"_27392":53192,"_2946":53833},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3461":1514,"_30106":1265,"_20907":53835,"_5":14363,"_27392":53192,"_2946":53836},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3461":1515,"_30106":1265,"_20907":53838,"_5":14363,"_27392":53196,"_2946":53839},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3461":1516,"_30106":1265,"_20907":53841,"_5":14363,"_27392":53196,"_2946":53842},[],"There are two action types:",{"_3461":1517,"_30106":1265,"_20907":53844,"_5":14363,"_27392":53196,"_2946":53845},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3461":1518,"_30106":1265,"_20907":53847,"_5":14363,"_27392":53196,"_2946":53848},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3461":1519,"_30106":1265,"_20907":53850,"_5":14363,"_27392":53196,"_2946":53851},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3461":1520,"_30106":1265,"_20907":53853,"_5":14363,"_27392":53200,"_2946":53854},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3461":1521,"_30106":1265,"_20907":53856,"_5":14363,"_27392":53200,"_2946":53857},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3461":1522,"_30106":1265,"_20907":53859,"_5":14363,"_27392":53200,"_2946":53860},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3461":1523,"_30106":1265,"_20907":53862,"_5":14363,"_27392":53204,"_2946":53863},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3461":1524,"_30106":1265,"_20907":53865,"_5":14363,"_27392":53204,"_2946":53866},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3461":1525,"_30106":1265,"_20907":53868,"_5":14363,"_27392":53204,"_2946":53869},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3461":1526,"_30106":1265,"_20907":53871,"_5":14363,"_27392":53204,"_2946":53872},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3461":1527,"_30106":1265,"_20907":53874,"_5":14363,"_27392":53204,"_2946":53875},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3461":1528,"_30106":1265,"_20907":53877,"_5":14363,"_27392":53204,"_2946":53878},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3461":1529,"_30106":1265,"_20907":53880,"_5":14363,"_27392":53204,"_2946":53881},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3461":1530,"_30106":1265,"_20907":53883,"_5":14363,"_27392":53204,"_2946":53884},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3461":1531,"_30106":1265,"_20907":53886,"_5":14363,"_27392":53204,"_2946":53887},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3461":1532,"_30106":1265,"_20907":53889,"_5":14363,"_27392":53204,"_2946":53890},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3461":1533,"_30106":1265,"_20907":53892,"_5":14363,"_27392":53204,"_2946":53893},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3461":1534,"_30106":1265,"_20907":53895,"_5":14363,"_27392":53204,"_2946":53896},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3461":1535,"_30106":1265,"_20907":53898,"_5":14363,"_27392":53204,"_2946":53899},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3461":1536,"_30106":1265,"_20907":53901,"_5":14363,"_27392":53204,"_2946":53902},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3461":1537,"_30106":1265,"_20907":53904,"_5":14363,"_27392":53204,"_2946":53905},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3461":1538,"_30106":1265,"_20907":53907,"_5":14363,"_27392":53204,"_2946":53908},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3461":1539,"_30106":1265,"_20907":53910,"_5":14363,"_27392":53204,"_2946":53911},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3461":1540,"_30106":1265,"_20907":53913,"_5":14363,"_27392":53204,"_2946":53914},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3461":1541,"_30106":1265,"_20907":53916,"_5":14363,"_27392":53204,"_2946":53917},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3461":1542,"_30106":1265,"_20907":53919,"_5":14363,"_27392":53204,"_2946":53920},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3461":1543,"_30106":1265,"_20907":53922,"_5":14363,"_27392":53204,"_2946":53923},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3461":1544,"_30106":1265,"_20907":53925,"_5":14363,"_27392":53204,"_2946":53926},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":1545,"_30106":1265,"_20907":53928,"_5":14363,"_27392":53204,"_2946":53929},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3461":1546,"_30106":1265,"_20907":53931,"_5":14363,"_27392":53204,"_2946":53932},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3461":1547,"_30106":1547,"_5":14715,"_2946":51639,"_30459":53934,"_20907":53935,"_27392":1547},[49157,50625,51639],[],{"_3461":1548,"_30106":1547,"_20907":53937,"_5":14363,"_27392":1547,"_2946":53938},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3461":1549,"_30106":1547,"_5":30456,"_20907":53940,"_27392":53941,"_2946":53942},[],"/docs/pr-preview/pr-60/platform/iot-fleets/overview#start-here","Start here",{"_3461":1550,"_30106":1547,"_5":30456,"_20907":53944,"_27392":53945,"_2946":51637},[],"/docs/pr-preview/pr-60/platform/iot-fleets/overview#devices-and-identities",{"_3461":1551,"_30106":1547,"_5":30456,"_20907":53947,"_27392":53948,"_2946":51820},[],"/docs/pr-preview/pr-60/platform/iot-fleets/overview#enrollment-with-pki",{"_3461":1552,"_30106":1547,"_5":30456,"_20907":53950,"_27392":53951,"_2946":53101},[],"/docs/pr-preview/pr-60/platform/iot-fleets/overview#integrations",{"_3461":1553,"_30106":1547,"_5":30456,"_20907":53953,"_27392":53954,"_2946":53955},[],"/docs/pr-preview/pr-60/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3461":1554,"_30106":1547,"_20907":53957,"_5":14363,"_27392":1547,"_2946":53958},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3461":1555,"_30106":1547,"_20907":53960,"_5":14363,"_27392":53941,"_2946":53961},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3461":1556,"_30106":1547,"_20907":53963,"_5":14363,"_27392":53941,"_2946":53964},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3461":1557,"_30106":1547,"_20907":53966,"_5":14363,"_27392":53945,"_2946":53967},[],"Resource",{"_3461":1558,"_30106":1547,"_20907":53969,"_5":14363,"_27392":53945,"_2946":53970},[],"What it represents",{"_3461":1559,"_30106":1547,"_20907":53972,"_5":14363,"_27392":53945,"_2946":53973},[],"**Device**",{"_3461":1560,"_30106":1547,"_20907":53975,"_5":14363,"_27392":53945,"_2946":53976},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3461":1561,"_30106":1547,"_20907":53978,"_5":14363,"_27392":53945,"_2946":53979},[],"**Identity**",{"_3461":1562,"_30106":1547,"_20907":53981,"_5":14363,"_27392":53945,"_2946":53982},[],"The device's association with its certificates: an active version and a history.",{"_3461":1563,"_30106":1547,"_20907":53984,"_5":14363,"_27392":53945,"_2946":53985},[],"**DMS**",{"_3461":1564,"_30106":1547,"_20907":53987,"_5":14363,"_27392":53945,"_2946":53988},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3461":1565,"_30106":1547,"_20907":53990,"_5":14363,"_27392":53945,"_2946":53991},[],"**Fleet**",{"_3461":1566,"_30106":1547,"_20907":53993,"_5":14363,"_27392":53945,"_2946":53994},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3461":1567,"_30106":1547,"_20907":53996,"_5":14363,"_27392":53945,"_2946":53997},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3461":1568,"_30106":1547,"_20907":53999,"_5":14363,"_27392":53945,"_2946":54000},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3461":1569,"_30106":1547,"_20907":54002,"_5":14363,"_27392":53948,"_2946":54003},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3461":1570,"_30106":1547,"_20907":54005,"_5":14363,"_27392":53948,"_2946":54006},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3461":1571,"_30106":1547,"_20907":54008,"_5":14363,"_27392":53948,"_2946":54009},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3461":1572,"_30106":1547,"_20907":54011,"_5":14363,"_27392":53948,"_2946":54012},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3461":1573,"_30106":1547,"_20907":54014,"_5":14363,"_27392":53948,"_2946":54015},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3461":1574,"_30106":1547,"_20907":54017,"_5":14363,"_27392":53948,"_2946":54018},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3461":1575,"_30106":1547,"_20907":54020,"_5":14363,"_27392":53948,"_2946":54021},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":1576,"_30106":1547,"_20907":54023,"_5":14363,"_27392":53948,"_2946":54024},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3461":1577,"_30106":1547,"_20907":54026,"_5":14363,"_27392":53951,"_2946":54027},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3461":1578,"_30106":1547,"_20907":54029,"_5":14363,"_27392":53951,"_2946":54030},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3461":1579,"_30106":1547,"_20907":54032,"_5":14363,"_27392":53954,"_2946":54033},[],"Participant",{"_3461":1580,"_30106":1547,"_20907":54035,"_5":14363,"_27392":53954,"_2946":54036},[],"Responsibility",{"_3461":1581,"_30106":1547,"_20907":54038,"_5":14363,"_27392":53954,"_2946":54039},[],"PKI administrator",{"_3461":1582,"_30106":1547,"_20907":54041,"_5":14363,"_27392":53954,"_2946":54042},[],"CA, issuance profile, chain and revocation publication.",{"_3461":1583,"_30106":1547,"_20907":54044,"_5":14363,"_27392":53954,"_2946":54045},[],"Provisioning administrator",{"_3461":1584,"_30106":1547,"_20907":54047,"_5":14363,"_27392":53954,"_2946":54048},[],"DMS, admission, authentication per operation and inventory.",{"_3461":1585,"_30106":1547,"_20907":54050,"_5":14363,"_27392":53954,"_2946":54051},[],"Device integrator",{"_3461":1586,"_30106":1547,"_20907":54053,"_5":14363,"_27392":53954,"_2946":54054},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3461":1587,"_30106":1547,"_20907":54056,"_5":14363,"_27392":53954,"_2946":54057},[],"Consumer integrator",{"_3461":1588,"_30106":1547,"_20907":54059,"_5":14363,"_27392":53954,"_2946":54060},[],"Trusted issuers, validation and device permissions in the destination.",{"_3461":1589,"_30106":1547,"_20907":54062,"_5":14363,"_27392":53954,"_2946":54063},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3461":1590,"_30106":1590,"_5":14715,"_2946":54065,"_30459":54066,"_20907":54068,"_27392":1590},"Enroll and connect your first device",[49157,50625,51639,54067],"Getting started",[],{"_3461":1591,"_30106":1590,"_20907":54070,"_5":14363,"_27392":1590,"_2946":54071},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3461":1592,"_30106":1590,"_5":30456,"_20907":54073,"_27392":54074,"_2946":49167},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3461":1593,"_30106":1590,"_5":30456,"_20907":54076,"_27392":54077,"_2946":54078},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3461":1594,"_30106":1590,"_5":30456,"_20907":54080,"_27392":54081,"_2946":54082},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3461":1595,"_30106":1590,"_5":30456,"_20907":54084,"_27392":54085,"_2946":54086},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3461":1596,"_30106":1590,"_5":30456,"_20907":54088,"_27392":54089,"_2946":54090},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3461":1597,"_30106":1590,"_5":30456,"_20907":54092,"_27392":54093,"_2946":54094},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3461":1598,"_30106":1590,"_5":30456,"_20907":54096,"_27392":54097,"_2946":54098},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3461":1599,"_30106":1590,"_5":30456,"_20907":54100,"_27392":54101,"_2946":54102},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3461":1600,"_30106":1590,"_20907":54104,"_5":14363,"_27392":1590,"_2946":54105},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3461":1601,"_30106":1590,"_20907":54107,"_5":14363,"_27392":54074,"_2946":54108},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3461":1602,"_30106":1590,"_20907":54110,"_5":14363,"_27392":54074,"_2946":54111},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3461":1603,"_30106":1590,"_20907":54113,"_5":14363,"_27392":54074,"_2946":54114},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3461":1604,"_30106":1590,"_20907":54116,"_5":14363,"_27392":54074,"_2946":54117},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3461":1605,"_30106":1590,"_20907":54119,"_5":14363,"_27392":54074,"_2946":54120},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3461":1606,"_30106":1590,"_20907":54122,"_5":14363,"_27392":54077,"_2946":54123},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3461":1607,"_30106":1590,"_20907":54125,"_5":14363,"_27392":54077,"_2946":54126},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3461":1608,"_30106":1590,"_20907":54128,"_5":14363,"_27392":54081,"_2946":54129},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3461":1609,"_30106":1590,"_20907":54131,"_5":14363,"_27392":54081,"_2946":54132},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3461":1610,"_30106":1590,"_20907":54134,"_5":14363,"_27392":54081,"_2946":54135},[],"Setting",{"_3461":1611,"_30106":1590,"_20907":54137,"_5":14363,"_27392":54081,"_2946":54138},[],"Evaluation value",{"_3461":1612,"_30106":1590,"_20907":54140,"_5":14363,"_27392":54081,"_2946":54141},[],"Enrollment CA",{"_3461":1613,"_30106":1590,"_20907":54143,"_5":14363,"_27392":54081,"_2946":54144},[],"Issuing root from `device-root.pem`.",{"_3461":1614,"_30106":1590,"_20907":54146,"_5":14363,"_27392":54081,"_2946":51950},[],{"_3461":1615,"_30106":1590,"_20907":54148,"_5":14363,"_27392":54081,"_2946":54149},[],"The 1-hour leaf profile you just prepared.",{"_3461":1616,"_30106":1590,"_20907":54151,"_5":14363,"_27392":54081,"_2946":54152},[],"Protocol / Registration Mode",{"_3461":1617,"_30106":1590,"_20907":54154,"_5":14363,"_27392":54081,"_2946":54155},[],"`EST_RFC7030` / `JITP`.",{"_3461":1618,"_30106":1590,"_20907":54157,"_5":14363,"_27392":54081,"_2946":54158},[],"Verify CSR Signature",{"_3461":1619,"_30106":1590,"_20907":54160,"_5":14363,"_27392":54081,"_2946":54161},[],"Enabled.",{"_3461":1620,"_30106":1590,"_20907":54163,"_5":14363,"_27392":54081,"_2946":54164},[],"Enable Replaceable Enrollment",{"_3461":1621,"_30106":1590,"_20907":54166,"_5":14363,"_27392":54081,"_2946":54167},[],"Disabled; the ID must be new.",{"_3461":1622,"_30106":1590,"_20907":54169,"_5":14363,"_27392":54081,"_2946":54170},[],"Initial authentication",{"_3461":1623,"_30106":1590,"_20907":54172,"_5":14363,"_27392":54081,"_2946":54173},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3461":1624,"_30106":1590,"_20907":54175,"_5":14363,"_27392":54081,"_2946":54176},[],"Renewal authentication",{"_3461":1625,"_30106":1590,"_20907":54178,"_5":14363,"_27392":54081,"_2946":54179},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3461":1626,"_30106":1590,"_20907":54181,"_5":14363,"_27392":54081,"_2946":54182},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3461":1627,"_30106":1590,"_20907":54184,"_5":14363,"_27392":54081,"_2946":54185},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3461":1628,"_30106":1590,"_20907":54187,"_5":14363,"_27392":54081,"_2946":54188},[],"Re-enrollment Delta",{"_3461":1629,"_30106":1590,"_20907":54190,"_5":14363,"_27392":54081,"_2946":54191},[],"1 hour.",{"_3461":1630,"_30106":1590,"_20907":54193,"_5":14363,"_27392":54081,"_2946":54194},[],"Preventive / Critical Delta",{"_3461":1631,"_30106":1590,"_20907":54196,"_5":14363,"_27392":54081,"_2946":54197},[],"30 minutes / 10 minutes.",{"_3461":1632,"_30106":1590,"_20907":54199,"_5":14363,"_27392":54081,"_2946":54200},[],"Revoke on Re-enrollment",{"_3461":1633,"_30106":1590,"_20907":54202,"_5":14363,"_27392":54081,"_2946":54203},[],"Disabled to test the successor before retiring the previous identity.",{"_3461":1634,"_30106":1590,"_20907":54205,"_5":14363,"_27392":54081,"_2946":51958},[],{"_3461":1635,"_30106":1590,"_20907":54207,"_5":14363,"_27392":54081,"_2946":54208},[],"Disabled; the operational key is generated in the client.",{"_3461":1636,"_30106":1590,"_20907":54210,"_5":14363,"_27392":54081,"_2946":54211},[],"CA Distribution",{"_3461":1637,"_30106":1590,"_20907":54213,"_5":14363,"_27392":54081,"_2946":54214},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3461":1638,"_30106":1590,"_20907":54216,"_5":14363,"_27392":54081,"_2946":54217},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3461":1639,"_30106":1590,"_20907":54219,"_5":14363,"_27392":54085,"_2946":54220},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3461":1640,"_30106":1590,"_20907":54222,"_5":14363,"_27392":54085,"_2946":54223},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3461":1641,"_30106":1590,"_20907":54225,"_5":14363,"_27392":54089,"_2946":54226},[],"Generate a new key and CSR with the selected identifier:",{"_3461":1642,"_30106":1590,"_20907":54228,"_5":14363,"_27392":54089,"_2946":54229},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3461":1643,"_30106":1590,"_20907":54231,"_5":14363,"_27392":54089,"_2946":54232},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3461":1644,"_30106":1590,"_20907":54234,"_5":14363,"_27392":54093,"_2946":54235},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3461":1645,"_30106":1590,"_20907":54237,"_5":14363,"_27392":54093,"_2946":54238},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3461":1646,"_30106":1590,"_20907":54240,"_5":14363,"_27392":54097,"_2946":54241},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3461":1647,"_30106":1590,"_20907":54243,"_5":14363,"_27392":54097,"_2946":54244},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3461":1648,"_30106":1590,"_20907":54246,"_5":14363,"_27392":54097,"_2946":54247},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3461":1649,"_30106":1590,"_20907":54249,"_5":14363,"_27392":54097,"_2946":54250},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3461":1650,"_30106":1590,"_20907":54252,"_5":14363,"_27392":54097,"_2946":54253},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3461":1651,"_30106":1590,"_20907":54255,"_5":14363,"_27392":54101,"_2946":54256},[],"Check",{"_3461":1652,"_30106":1590,"_20907":54258,"_5":14363,"_27392":54101,"_2946":54259},[],"Expected result",{"_3461":1653,"_30106":1590,"_20907":54261,"_5":14363,"_27392":54101,"_2946":54262},[],"Registration",{"_3461":1654,"_30106":1590,"_20907":54264,"_5":14363,"_27392":54101,"_2946":54265},[],"ID created automatically and correct DMS.",{"_3461":1655,"_30106":1590,"_20907":54267,"_5":14363,"_27392":54101,"_2946":53523},[],{"_3461":1656,"_30106":1590,"_20907":54269,"_5":14363,"_27392":54101,"_2946":54270},[],"CN, profile, serial and key verified.",{"_3461":1657,"_30106":1590,"_20907":54272,"_5":14363,"_27392":54101,"_2946":54273},[],"Inventory",{"_3461":1658,"_30106":1590,"_20907":54275,"_5":14363,"_27392":54101,"_2946":54276},[],"Received serial visible as the current identity and in history.",{"_3461":1659,"_30106":1590,"_20907":54278,"_5":14363,"_27392":54101,"_2946":54279},[],"Consumer",{"_3461":1660,"_30106":1590,"_20907":54281,"_5":14363,"_27392":54101,"_2946":54282},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3461":1661,"_30106":1590,"_20907":54284,"_5":14363,"_27392":54101,"_2946":54285},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3461":1662,"_30106":1590,"_20907":54287,"_5":14363,"_27392":54101,"_2946":54288},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3461":1663,"_30106":1663,"_5":14715,"_2946":51655,"_30459":54290,"_20907":54291,"_27392":1663},[49157,50625,51639,54067],[],{"_3461":1664,"_30106":1663,"_20907":54293,"_5":14363,"_27392":1663,"_2946":54294},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3461":1665,"_30106":1663,"_5":30456,"_20907":54296,"_27392":54297,"_2946":49167},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3461":1666,"_30106":1663,"_5":30456,"_20907":54299,"_27392":54300,"_2946":54301},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3461":1667,"_30106":1663,"_5":30456,"_20907":54303,"_27392":54304,"_2946":54305},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3461":1668,"_30106":1663,"_5":30456,"_20907":54307,"_27392":54308,"_2946":54309},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3461":1669,"_30106":1663,"_5":30456,"_20907":54311,"_27392":54312,"_2946":54313},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3461":1670,"_30106":1663,"_5":30456,"_20907":54315,"_27392":54316,"_2946":54317},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3461":1671,"_30106":1663,"_5":30456,"_20907":54319,"_27392":54320,"_2946":54259},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3461":1672,"_30106":1663,"_5":30456,"_20907":54322,"_27392":54323,"_2946":54324},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3461":1673,"_30106":1663,"_5":30456,"_20907":54326,"_27392":54327,"_2946":54328},[],"/docs/pr-preview/pr-60/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3461":1674,"_30106":1663,"_20907":54330,"_5":14363,"_27392":1663,"_2946":54331},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3461":1675,"_30106":1663,"_20907":54333,"_5":14363,"_27392":1663,"_2946":54334},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3461":1676,"_30106":1663,"_20907":54336,"_5":14363,"_27392":54297,"_2946":54337},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3461":1677,"_30106":1663,"_20907":54339,"_5":14363,"_27392":54297,"_2946":54340},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3461":1678,"_30106":1663,"_20907":54342,"_5":14363,"_27392":54297,"_2946":54343},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3461":1679,"_30106":1663,"_20907":54345,"_5":14363,"_27392":54297,"_2946":54346},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3461":1680,"_30106":1663,"_20907":54348,"_5":14363,"_27392":54300,"_2946":54349},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3461":1681,"_30106":1663,"_20907":54351,"_5":14363,"_27392":54300,"_2946":54352},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3461":1682,"_30106":1663,"_20907":54354,"_5":14363,"_27392":54300,"_2946":54355},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3461":1683,"_30106":1663,"_20907":54357,"_5":14363,"_27392":54300,"_2946":54358},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3461":1684,"_30106":1663,"_20907":54360,"_5":14363,"_27392":54300,"_2946":54361},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3461":1685,"_30106":1663,"_20907":54363,"_5":14363,"_27392":54300,"_2946":54364},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3461":1686,"_30106":1663,"_20907":54366,"_5":14363,"_27392":54300,"_2946":54367},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3461":1687,"_30106":1663,"_20907":54369,"_5":14363,"_27392":54300,"_2946":54370},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3461":1688,"_30106":1663,"_20907":54372,"_5":14363,"_27392":54304,"_2946":54373},[],"Open **Managed Devices** and the registration action. Complete:",{"_3461":1689,"_30106":1663,"_20907":54375,"_5":14363,"_27392":54304,"_2946":54376},[],"**Device ID**: `device-001`.",{"_3461":1690,"_30106":1663,"_20907":54378,"_5":14363,"_27392":54304,"_2946":54379},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3461":1691,"_30106":1663,"_20907":54381,"_5":14363,"_27392":54304,"_2946":54382},[],"**Icon** and **Tags**: optional classification.",{"_3461":1692,"_30106":1663,"_20907":54384,"_5":14363,"_27392":54304,"_2946":54385},[],"Confirm registration.",{"_3461":1693,"_30106":1663,"_20907":54387,"_5":14363,"_27392":54308,"_2946":54388},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3461":1694,"_30106":1663,"_20907":54390,"_5":14363,"_27392":54308,"_2946":54391},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3461":1695,"_30106":1663,"_20907":54393,"_5":14363,"_27392":54312,"_2946":54394},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3461":1696,"_30106":1663,"_20907":54396,"_5":14363,"_27392":54312,"_2946":54397},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3461":1697,"_30106":1663,"_20907":54399,"_5":14363,"_27392":54316,"_2946":54400},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3461":1698,"_30106":1663,"_20907":54402,"_5":14363,"_27392":54316,"_2946":54403},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3461":1699,"_30106":1663,"_20907":54405,"_5":14363,"_27392":54320,"_2946":54256},[],{"_3461":1700,"_30106":1663,"_20907":54407,"_5":14363,"_27392":54320,"_2946":54408},[],"Result",{"_3461":1701,"_30106":1663,"_20907":54410,"_5":14363,"_27392":54320,"_2946":53506},[],{"_3461":1702,"_30106":1663,"_20907":54412,"_5":14363,"_27392":54320,"_2946":54413},[],"`device-001` appears in inventory with the expected DMS.",{"_3461":1703,"_30106":1663,"_20907":54415,"_5":14363,"_27392":54320,"_2946":54416},[],"Current identity",{"_3461":1704,"_30106":1663,"_20907":54418,"_5":14363,"_27392":54320,"_2946":54419},[],"The associated certificate matches the one you verified in PKI.",{"_3461":1705,"_30106":1663,"_20907":54421,"_5":14363,"_27392":54320,"_2946":54422},[],"History",{"_3461":1706,"_30106":1663,"_20907":54424,"_5":14363,"_27392":54320,"_2946":54425},[],"The associated issuance appears with its serial number and dates.",{"_3461":1707,"_30106":1663,"_20907":54427,"_5":14363,"_27392":54320,"_2946":54428},[],"Key and certificate",{"_3461":1708,"_30106":1663,"_20907":54430,"_5":14363,"_27392":54320,"_2946":54431},[],"You have the verified pair ready to install on the device.",{"_3461":1709,"_30106":1663,"_20907":54433,"_5":14363,"_27392":54323,"_2946":54434},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3461":1710,"_30106":1663,"_20907":54436,"_5":14363,"_27392":54323,"_2946":54437},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3461":1711,"_30106":1663,"_20907":54439,"_5":14363,"_27392":54323,"_2946":54440},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3461":1712,"_30106":1663,"_20907":54442,"_5":14363,"_27392":54323,"_2946":54443},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3461":1713,"_30106":1663,"_20907":54445,"_5":14363,"_27392":54327,"_2946":54446},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3461":1714,"_30106":1663,"_20907":54448,"_5":14363,"_27392":54327,"_2946":54449},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3461":1715,"_30106":1663,"_20907":54451,"_5":14363,"_27392":54327,"_2946":54452},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3461":1716,"_30106":1716,"_5":14715,"_2946":54454,"_30459":54455,"_20907":54456,"_27392":1716},"Lamassu IoT Platform",[49157,50625],[],{"_3461":1717,"_30106":1716,"_20907":54458,"_5":14363,"_27392":1716,"_2946":54459},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3461":1718,"_30106":1716,"_5":30456,"_20907":54461,"_27392":54462,"_2946":53942},[],"/docs/pr-preview/pr-60/platform/overview#start-here",{"_3461":1719,"_30106":1716,"_5":30456,"_20907":54464,"_27392":54465,"_2946":54466},[],"/docs/pr-preview/pr-60/platform/overview#choose-your-path","Choose your path",{"_3461":1720,"_30106":1716,"_5":30456,"_20907":54468,"_27392":54469,"_2946":54470},[],"/docs/pr-preview/pr-60/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3461":1721,"_30106":1716,"_5":30456,"_20907":54472,"_27392":54473,"_2946":54474},[],"/docs/pr-preview/pr-60/platform/overview#core-capabilities","Core capabilities",{"_3461":1722,"_30106":1716,"_5":30456,"_20907":54476,"_27392":54477,"_2946":54478},[],"/docs/pr-preview/pr-60/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3461":1723,"_30106":1716,"_5":30456,"_20907":54480,"_27392":54481,"_2946":54482},[],"/docs/pr-preview/pr-60/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3461":1724,"_30106":1716,"_5":30456,"_20907":54484,"_27392":54485,"_2946":54486},[],"/docs/pr-preview/pr-60/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3461":1725,"_30106":1716,"_5":30456,"_20907":54488,"_27392":54489,"_2946":54490},[],"/docs/pr-preview/pr-60/platform/overview#automate-device-identities","Automate device identities",{"_3461":1726,"_30106":1716,"_5":30456,"_20907":54492,"_27392":54493,"_2946":54494},[],"/docs/pr-preview/pr-60/platform/overview#publish-validation-status","Publish validation status",{"_3461":1727,"_30106":1716,"_5":30456,"_20907":54496,"_27392":54497,"_2946":54498},[],"/docs/pr-preview/pr-60/platform/overview#react-to-events","React to events",{"_3461":1728,"_30106":1716,"_5":30456,"_20907":54500,"_27392":54501,"_2946":54502},[],"/docs/pr-preview/pr-60/platform/overview#operational-reference","Operational reference",{"_3461":1729,"_30106":1716,"_20907":54504,"_5":14363,"_27392":1716,"_2946":54505},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3461":1730,"_30106":1716,"_20907":54507,"_5":14363,"_27392":54462,"_2946":54508},[],"Choose the result you need:",{"_3461":1731,"_30106":1716,"_20907":54510,"_5":14363,"_27392":54462,"_2946":54511},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3461":1732,"_30106":1716,"_20907":54513,"_5":14363,"_27392":54462,"_2946":54514},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3461":1733,"_30106":1716,"_20907":54516,"_5":14363,"_27392":54462,"_2946":54517},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3461":1734,"_30106":1716,"_20907":54519,"_5":14363,"_27392":54465,"_2946":54520},[],"Section",{"_3461":1735,"_30106":1716,"_20907":54522,"_5":14363,"_27392":54465,"_2946":54523},[],"What you manage",{"_3461":1736,"_30106":1716,"_20907":54525,"_5":14363,"_27392":54465,"_2946":54526},[],"Entry point",{"_3461":1737,"_30106":1716,"_20907":54528,"_5":14363,"_27392":54465,"_2946":54529},[],"**PKI**",{"_3461":1738,"_30106":1716,"_20907":54531,"_5":14363,"_27392":54465,"_2946":54532},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3461":1739,"_30106":1716,"_20907":54534,"_5":14363,"_27392":54465,"_2946":54535},[],"PKI overview",{"_3461":1740,"_30106":1716,"_20907":54537,"_5":14363,"_27392":54465,"_2946":54538},[],"**IoT Fleets**",{"_3461":1741,"_30106":1716,"_20907":54540,"_5":14363,"_27392":54465,"_2946":54541},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3461":1742,"_30106":1716,"_20907":54543,"_5":14363,"_27392":54465,"_2946":54544},[],"IoT Fleets overview",{"_3461":1743,"_30106":1716,"_20907":54546,"_5":14363,"_27392":54465,"_2946":54547},[],"**Administration**",{"_3461":1744,"_30106":1716,"_20907":54549,"_5":14363,"_27392":54465,"_2946":54550},[],"Operator permissions, audit and event subscriptions.",{"_3461":1745,"_30106":1716,"_20907":54552,"_5":14363,"_27392":54465,"_2946":50623},[],{"_3461":1746,"_30106":1716,"_20907":54554,"_5":14363,"_27392":54465,"_2946":54555},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3461":1747,"_30106":1716,"_20907":54557,"_5":14363,"_27392":54469,"_2946":54558},[],"An identity's journey connects four responsibilities:",{"_3461":1748,"_30106":1716,"_20907":54560,"_5":14363,"_27392":54469,"_2946":54561},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3461":1749,"_30106":1716,"_20907":54563,"_5":14363,"_27392":54469,"_2946":54564},[],"The provisioning administrator configures the DMS and initial trust.",{"_3461":1750,"_30106":1716,"_20907":54566,"_5":14363,"_27392":54469,"_2946":54567},[],"The device client requests a certificate and installs it with the matching key.",{"_3461":1751,"_30106":1716,"_20907":54569,"_5":14363,"_27392":54469,"_2946":54570},[],"The consumer validates the identity and applies its access permissions.",{"_3461":1752,"_30106":1716,"_20907":54572,"_5":14363,"_27392":54469,"_2946":54573},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3461":1753,"_30106":1716,"_20907":54575,"_5":14363,"_27392":54477,"_2946":54576},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3461":1754,"_30106":1716,"_20907":54578,"_5":14363,"_27392":54481,"_2946":54579},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3461":1755,"_30106":1716,"_20907":54581,"_5":14363,"_27392":54485,"_2946":54582},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3461":1756,"_30106":1716,"_20907":54584,"_5":14363,"_27392":54489,"_2946":54585},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3461":1757,"_30106":1716,"_20907":54587,"_5":14363,"_27392":54493,"_2946":54588},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3461":1758,"_30106":1716,"_20907":54590,"_5":14363,"_27392":54497,"_2946":54591},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3461":1759,"_30106":1716,"_20907":54593,"_5":14363,"_27392":54501,"_2946":54036},[],{"_3461":1760,"_30106":1716,"_20907":54595,"_5":14363,"_27392":54501,"_2946":54596},[],"What it prepares or checks",{"_3461":1761,"_30106":1716,"_20907":54598,"_5":14363,"_27392":54501,"_2946":54039},[],{"_3461":1762,"_30106":1716,"_20907":54600,"_5":14363,"_27392":54501,"_2946":54601},[],"Key custody, CA hierarchy, profiles and validation.",{"_3461":1763,"_30106":1716,"_20907":54603,"_5":14363,"_27392":54501,"_2946":54604},[],"Fleet administrator",{"_3461":1764,"_30106":1716,"_20907":54606,"_5":14363,"_27392":54501,"_2946":54607},[],"DMS, device admission, renewal policy and inventory.",{"_3461":1765,"_30106":1716,"_20907":54609,"_5":14363,"_27392":54501,"_2946":54051},[],{"_3461":1766,"_30106":1716,"_20907":54611,"_5":14363,"_27392":54501,"_2946":54612},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3461":1767,"_30106":1716,"_20907":54614,"_5":14363,"_27392":54501,"_2946":54057},[],{"_3461":1768,"_30106":1716,"_20907":54616,"_5":14363,"_27392":54501,"_2946":54617},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3461":1769,"_30106":1716,"_20907":54619,"_5":14363,"_27392":54501,"_2946":54620},[],"Infrastructure operator",{"_3461":1770,"_30106":1716,"_20907":54622,"_5":14363,"_27392":54501,"_2946":54623},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3461":1771,"_30106":1716,"_20907":54625,"_5":14363,"_27392":54501,"_2946":54626},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3461":1772,"_30106":1772,"_5":14715,"_2946":54628,"_30459":54629,"_20907":54632,"_27392":1772},"CA hierarchy and rotation",[49157,50625,54630,54631],"PKI","Keys, authorities and certificates",[],{"_3461":1773,"_30106":1772,"_20907":54634,"_5":14363,"_27392":1772,"_2946":54635},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3461":1774,"_30106":1772,"_5":30456,"_20907":54637,"_27392":54638,"_2946":54639},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3461":1775,"_30106":1772,"_5":30456,"_20907":54641,"_27392":54642,"_2946":54643},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3461":1776,"_30106":1772,"_5":30456,"_20907":54645,"_27392":54646,"_2946":54647},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3461":1777,"_30106":1772,"_5":30456,"_20907":54649,"_27392":54650,"_2946":54651},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3461":1778,"_30106":1772,"_5":30456,"_20907":54653,"_27392":54654,"_2946":54655},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3461":1779,"_30106":1772,"_5":30456,"_20907":54657,"_27392":54658,"_2946":54659},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3461":1780,"_30106":1772,"_5":30456,"_20907":54661,"_27392":54662,"_2946":54663},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3461":1781,"_30106":1772,"_5":30456,"_20907":54665,"_27392":54666,"_2946":54667},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3461":1782,"_30106":1772,"_5":30456,"_20907":54669,"_27392":54670,"_2946":54671},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3461":1783,"_30106":1772,"_5":30456,"_20907":54673,"_27392":54674,"_2946":54675},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3461":1784,"_30106":1772,"_5":30456,"_20907":54677,"_27392":54678,"_2946":54679},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3461":1785,"_30106":1772,"_5":30456,"_20907":54681,"_27392":54682,"_2946":54683},[],"/docs/pr-preview/pr-60/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3461":1786,"_30106":1772,"_20907":54685,"_5":14363,"_27392":1772,"_2946":54686},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3461":1787,"_30106":1772,"_20907":54688,"_5":14363,"_27392":1772,"_2946":54689},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3461":1788,"_30106":1772,"_20907":54691,"_5":14363,"_27392":54638,"_2946":54692},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3461":1789,"_30106":1772,"_20907":54694,"_5":14363,"_27392":54638,"_2946":54695},[],"environment, such as production and preproduction;",{"_3461":1790,"_30106":1772,"_20907":54697,"_5":14363,"_27392":54638,"_2946":54698},[],"owner or operating team;",{"_3461":1791,"_30106":1772,"_20907":54700,"_5":14363,"_27392":54638,"_2946":54701},[],"device family or manufacturing process;",{"_3461":1792,"_30106":1772,"_20907":54703,"_5":14363,"_27392":54638,"_2946":54704},[],"region or regulatory requirement;",{"_3461":1793,"_30106":1772,"_20907":54706,"_5":14363,"_27392":54638,"_2946":54707},[],"cryptographic engine or key policy;",{"_3461":1794,"_30106":1772,"_20907":54709,"_5":14363,"_27392":54638,"_2946":54710},[],"maintenance window and renewal cadence.",{"_3461":1795,"_30106":1772,"_20907":54712,"_5":14363,"_27392":54638,"_2946":54713},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3461":1796,"_30106":1772,"_20907":54715,"_5":14363,"_27392":54638,"_2946":54716},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3461":1797,"_30106":1772,"_20907":54718,"_5":14363,"_27392":54642,"_2946":54719},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3461":1798,"_30106":1772,"_20907":54721,"_5":14363,"_27392":54642,"_2946":54722},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3461":1799,"_30106":1772,"_20907":54724,"_5":14363,"_27392":54642,"_2946":54725},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3461":1800,"_30106":1772,"_20907":54727,"_5":14363,"_27392":54642,"_2946":54728},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3461":1801,"_30106":1772,"_20907":54730,"_5":14363,"_27392":54646,"_2946":54731},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3461":1802,"_30106":1772,"_20907":54733,"_5":14363,"_27392":54646,"_2946":54734},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3461":1803,"_30106":1772,"_20907":54736,"_5":14363,"_27392":54646,"_2946":54737},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3461":1804,"_30106":1772,"_20907":54739,"_5":14363,"_27392":54646,"_2946":54740},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3461":1805,"_30106":1772,"_20907":54742,"_5":14363,"_27392":54654,"_2946":54743},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3461":1806,"_30106":1772,"_20907":54745,"_5":14363,"_27392":54658,"_2946":54746},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3461":1807,"_30106":1772,"_20907":54748,"_5":14363,"_27392":54662,"_2946":54749},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3461":1808,"_30106":1772,"_20907":54751,"_5":14363,"_27392":54666,"_2946":54752},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3461":1809,"_30106":1772,"_20907":54754,"_5":14363,"_27392":54670,"_2946":54755},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3461":1810,"_30106":1772,"_20907":54757,"_5":14363,"_27392":54674,"_2946":54758},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3461":1811,"_30106":1772,"_20907":54760,"_5":14363,"_27392":54678,"_2946":54761},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3461":1812,"_30106":1772,"_20907":54763,"_5":14363,"_27392":54678,"_2946":54764},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3461":1813,"_30106":1772,"_20907":54766,"_5":14363,"_27392":54678,"_2946":54767},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3461":1814,"_30106":1772,"_20907":54769,"_5":14363,"_27392":54678,"_2946":54770},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3461":1815,"_30106":1772,"_20907":54772,"_5":14363,"_27392":54682,"_2946":54773},[],"The new chain ends in an anchor installed by the consumer.",{"_3461":1816,"_30106":1772,"_20907":54775,"_5":14363,"_27392":54682,"_2946":54776},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3461":1817,"_30106":1772,"_20907":54778,"_5":14363,"_27392":54682,"_2946":54779},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3461":1818,"_30106":1772,"_20907":54781,"_5":14363,"_27392":54682,"_2946":54782},[],"Re-enrollment accepts the old identity during the planned period.",{"_3461":1819,"_30106":1772,"_20907":54784,"_5":14363,"_27392":54682,"_2946":54785},[],"OCSP and CRL respond for the authorities that remain active.",{"_3461":1820,"_30106":1772,"_20907":54787,"_5":14363,"_27392":54682,"_2946":54788},[],"No DMS is left accidentally issuing from the old CA.",{"_3461":1821,"_30106":1772,"_20907":54790,"_5":14363,"_27392":54682,"_2946":54791},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3461":1822,"_30106":1822,"_5":14715,"_2946":54793,"_30459":54794,"_20907":54795,"_27392":1822},"Certification authorities",[49157,50625,54630,54631],[],{"_3461":1823,"_30106":1822,"_20907":54797,"_5":14363,"_27392":1822,"_2946":54798},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3461":1824,"_30106":1822,"_5":30456,"_20907":54800,"_27392":54801,"_2946":54802},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3461":1825,"_30106":1822,"_5":30456,"_20907":54804,"_27392":54805,"_2946":54806},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3461":1826,"_30106":1822,"_5":30456,"_20907":54808,"_27392":54809,"_2946":49167},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#before-you-begin",{"_3461":1827,"_30106":1822,"_5":30456,"_20907":54811,"_27392":54812,"_2946":54813},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3461":1828,"_30106":1822,"_5":30456,"_20907":54815,"_27392":54816,"_2946":54817},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3461":1829,"_30106":1822,"_5":30456,"_20907":54819,"_27392":54820,"_2946":54821},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3461":1830,"_30106":1822,"_5":30456,"_20907":54823,"_27392":54824,"_2946":54825},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3461":1831,"_30106":1822,"_5":30456,"_20907":54827,"_27392":54828,"_2946":54829},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3461":1832,"_30106":1822,"_5":30456,"_20907":54831,"_27392":54832,"_2946":54833},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3461":1833,"_30106":1822,"_5":30456,"_20907":54835,"_27392":54836,"_2946":54837},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3461":1834,"_30106":1822,"_5":30456,"_20907":54839,"_27392":54840,"_2946":54841},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3461":1835,"_30106":1822,"_5":30456,"_20907":54843,"_27392":54844,"_2946":54845},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3461":1836,"_30106":1822,"_5":30456,"_20907":54847,"_27392":54848,"_2946":54849},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3461":1837,"_30106":1822,"_5":30456,"_20907":54851,"_27392":54852,"_2946":54853},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3461":1838,"_30106":1822,"_5":30456,"_20907":54855,"_27392":54856,"_2946":54857},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3461":1839,"_30106":1822,"_5":30456,"_20907":54859,"_27392":54860,"_2946":54861},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3461":1840,"_30106":1822,"_5":30456,"_20907":54863,"_27392":54864,"_2946":54865},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3461":1841,"_30106":1822,"_5":30456,"_20907":54867,"_27392":54868,"_2946":54869},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3461":1842,"_30106":1822,"_5":30456,"_20907":54871,"_27392":54872,"_2946":54873},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3461":1843,"_30106":1822,"_5":30456,"_20907":54875,"_27392":54876,"_2946":54877},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3461":1844,"_30106":1822,"_5":30456,"_20907":54879,"_27392":54880,"_2946":54881},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3461":1845,"_30106":1822,"_5":30456,"_20907":54883,"_27392":54884,"_2946":54885},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3461":1846,"_30106":1822,"_5":30456,"_20907":54887,"_27392":54888,"_2946":54889},[],"/docs/pr-preview/pr-60/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3461":1847,"_30106":1822,"_20907":54891,"_5":14363,"_27392":1822,"_2946":54892},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3461":1848,"_30106":1822,"_20907":54894,"_5":14363,"_27392":1822,"_2946":54895},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3461":1849,"_30106":1822,"_20907":54897,"_5":14363,"_27392":1822,"_2946":54898},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3461":1850,"_30106":1822,"_20907":54900,"_5":14363,"_27392":54801,"_2946":54901},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3461":1851,"_30106":1822,"_20907":54903,"_5":14363,"_27392":54801,"_2946":54904},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3461":1852,"_30106":1822,"_20907":54906,"_5":14363,"_27392":54801,"_2946":54907},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3461":1853,"_30106":1822,"_20907":54909,"_5":14363,"_27392":54801,"_2946":54910},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3461":1854,"_30106":1822,"_20907":54912,"_5":14363,"_27392":54801,"_2946":54913},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3461":1855,"_30106":1822,"_20907":54915,"_5":14363,"_27392":54809,"_2946":54916},[],"Decide whether the CA will be a root or an intermediate.",{"_3461":1856,"_30106":1822,"_20907":54918,"_5":14363,"_27392":54809,"_2946":54919},[],"Choose the engine that will keep the key.",{"_3461":1857,"_30106":1822,"_20907":54921,"_5":14363,"_27392":54809,"_2946":54922},[],"Define a validity longer than that of the certificates it will issue.",{"_3461":1858,"_30106":1822,"_20907":54924,"_5":14363,"_27392":54809,"_2946":54925},[],"For an intermediate CA, make sure the parent CA is active.",{"_3461":1859,"_30106":1822,"_20907":54927,"_5":14363,"_27392":54812,"_2946":54928},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3461":1860,"_30106":1822,"_20907":54930,"_5":14363,"_27392":54816,"_2946":54931},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3461":1861,"_30106":1822,"_20907":54933,"_5":14363,"_27392":54816,"_2946":54934},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3461":1862,"_30106":1822,"_20907":54936,"_5":14363,"_27392":54820,"_2946":54937},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3461":1863,"_30106":1822,"_20907":54939,"_5":14363,"_27392":54824,"_2946":54940},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3461":1864,"_30106":1822,"_20907":54942,"_5":14363,"_27392":54824,"_2946":54943},[],"`C`: two-letter ISO 3166-1 country code.",{"_3461":1865,"_30106":1822,"_20907":54945,"_5":14363,"_27392":54824,"_2946":54946},[],"`ST`: state or province.",{"_3461":1866,"_30106":1822,"_20907":54948,"_5":14363,"_27392":54824,"_2946":54949},[],"`L`: locality.",{"_3461":1867,"_30106":1822,"_20907":54951,"_5":14363,"_27392":54824,"_2946":54952},[],"`O`: organization.",{"_3461":1868,"_30106":1822,"_20907":54954,"_5":14363,"_27392":54824,"_2946":54955},[],"`OU`: organizational unit.",{"_3461":1869,"_30106":1822,"_20907":54957,"_5":14363,"_27392":54824,"_2946":54958},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3461":1870,"_30106":1822,"_20907":54960,"_5":14363,"_27392":54828,"_2946":54961},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3461":1871,"_30106":1822,"_20907":54963,"_5":14363,"_27392":54828,"_2946":54964},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3461":1872,"_30106":1822,"_20907":54966,"_5":14363,"_27392":54832,"_2946":54967},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3461":1873,"_30106":1822,"_20907":54969,"_5":14363,"_27392":54832,"_2946":54970},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3461":1874,"_30106":1822,"_20907":54972,"_5":14363,"_27392":54836,"_2946":54973},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3461":1875,"_30106":1822,"_20907":54975,"_5":14363,"_27392":54836,"_2946":54976},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3461":1876,"_30106":1822,"_20907":54978,"_5":14363,"_27392":54840,"_2946":54979},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3461":1877,"_30106":1822,"_20907":54981,"_5":14363,"_27392":54840,"_2946":54982},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3461":1878,"_30106":1822,"_20907":54984,"_5":14363,"_27392":54840,"_2946":54985},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3461":1879,"_30106":1822,"_20907":54987,"_5":14363,"_27392":54844,"_2946":54988},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3461":1880,"_30106":1822,"_20907":54990,"_5":14363,"_27392":54848,"_2946":54991},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3461":1881,"_30106":1822,"_20907":54993,"_5":14363,"_27392":54848,"_2946":54994},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3461":1882,"_30106":1822,"_20907":54996,"_5":14363,"_27392":54852,"_2946":54997},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3461":1883,"_30106":1822,"_20907":54999,"_5":14363,"_27392":54856,"_2946":55000},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3461":1884,"_30106":1822,"_20907":55002,"_5":14363,"_27392":54856,"_2946":55003},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3461":1885,"_30106":1822,"_20907":55005,"_5":14363,"_27392":54860,"_2946":55006},[],"Open a CA from the inventory to review:",{"_3461":1886,"_30106":1822,"_20907":55008,"_5":14363,"_27392":54860,"_2946":55009},[],"Status and validity period.",{"_3461":1887,"_30106":1822,"_20907":55011,"_5":14363,"_27392":54860,"_2946":55012},[],"Certificate and chain in PEM format.",{"_3461":1888,"_30106":1822,"_20907":55014,"_5":14363,"_27392":54860,"_2946":55015},[],"Number of active, expired and revoked certificates.",{"_3461":1889,"_30106":1822,"_20907":55017,"_5":14363,"_27392":54860,"_2946":55018},[],"Certificates issued in **Issued Certificates**.",{"_3461":1890,"_30106":1822,"_20907":55020,"_5":14363,"_27392":54860,"_2946":55021},[],"The CRL linked to the authority.",{"_3461":1891,"_30106":1822,"_20907":55023,"_5":14363,"_27392":54860,"_2946":55024},[],"Metadata and the associated cryptographic engine.",{"_3461":1892,"_30106":1822,"_20907":55026,"_5":14363,"_27392":54860,"_2946":55027},[],"You can filter the inventory by name, status and CA type.",{"_3461":1893,"_30106":1822,"_20907":55029,"_5":14363,"_27392":54864,"_2946":55030},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3461":1894,"_30106":1822,"_20907":55032,"_5":14363,"_27392":54864,"_2946":55033},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3461":1895,"_30106":1822,"_20907":55035,"_5":14363,"_27392":54864,"_2946":55036},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3461":1896,"_30106":1822,"_20907":55038,"_5":14363,"_27392":54864,"_2946":55039},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3461":1897,"_30106":1822,"_20907":55041,"_5":14363,"_27392":54868,"_2946":55042},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3461":1898,"_30106":1822,"_20907":55044,"_5":14363,"_27392":54872,"_2946":55045},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3461":1899,"_30106":1822,"_20907":55047,"_5":14363,"_27392":54876,"_2946":55048},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3461":1900,"_30106":1822,"_20907":55050,"_5":14363,"_27392":54880,"_2946":55051},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3461":1901,"_30106":1822,"_20907":55053,"_5":14363,"_27392":54884,"_2946":55054},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3461":1902,"_30106":1822,"_20907":55056,"_5":14363,"_27392":54888,"_2946":55057},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3461":1903,"_30106":1822,"_20907":55059,"_5":14363,"_27392":54888,"_2946":55060},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3461":1904,"_30106":1822,"_20907":55062,"_5":14363,"_27392":54888,"_2946":55063},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3461":1905,"_30106":1905,"_5":14715,"_2946":55065,"_30459":55066,"_20907":55067,"_27392":1905},"Certificate profiles",[49157,50625,54630,54631],[],{"_3461":1906,"_30106":1905,"_20907":55069,"_5":14363,"_27392":1905,"_2946":55070},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3461":1907,"_30106":1905,"_5":30456,"_20907":55072,"_27392":55073,"_2946":55074},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3461":1908,"_30106":1905,"_5":30456,"_20907":55076,"_27392":55077,"_2946":55078},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#validity","Validity",{"_3461":1909,"_30106":1905,"_5":30456,"_20907":55080,"_27392":55081,"_2946":55082},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3461":1910,"_30106":1905,"_5":30456,"_20907":55084,"_27392":55085,"_2946":55086},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3461":1911,"_30106":1905,"_5":30456,"_20907":55088,"_27392":55089,"_2946":55090},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#subject","Subject",{"_3461":1912,"_30106":1905,"_5":30456,"_20907":55092,"_27392":55093,"_2946":55094},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3461":1913,"_30106":1905,"_5":30456,"_20907":55096,"_27392":55097,"_2946":55098},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3461":1914,"_30106":1905,"_5":30456,"_20907":55100,"_27392":55101,"_2946":55102},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3461":1915,"_30106":1905,"_5":30456,"_20907":55104,"_27392":55105,"_2946":55106},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3461":1916,"_30106":1905,"_5":30456,"_20907":55108,"_27392":55109,"_2946":55110},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3461":1917,"_30106":1905,"_5":30456,"_20907":55112,"_27392":55113,"_2946":55114},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3461":1918,"_30106":1905,"_5":30456,"_20907":55116,"_27392":55117,"_2946":55118},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3461":1919,"_30106":1905,"_5":30456,"_20907":55120,"_27392":55121,"_2946":55122},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3461":1920,"_30106":1905,"_5":30456,"_20907":55124,"_27392":55125,"_2946":55126},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3461":1921,"_30106":1905,"_5":30456,"_20907":55128,"_27392":55129,"_2946":55130},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#design-examples","Design examples",{"_3461":1922,"_30106":1905,"_5":30456,"_20907":55132,"_27392":55133,"_2946":55134},[],"/docs/pr-preview/pr-60/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3461":1923,"_30106":1905,"_20907":55136,"_5":14363,"_27392":1905,"_2946":55137},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3461":1924,"_30106":1905,"_20907":55139,"_5":14363,"_27392":1905,"_2946":55140},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3461":1925,"_30106":1905,"_20907":55142,"_5":14363,"_27392":55077,"_2946":55143},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3461":1926,"_30106":1905,"_20907":55145,"_5":14363,"_27392":55077,"_2946":55146},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3461":1927,"_30106":1905,"_20907":55148,"_5":14363,"_27392":55081,"_2946":55149},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3461":1928,"_30106":1905,"_20907":55151,"_5":14363,"_27392":55085,"_2946":55152},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3461":1929,"_30106":1905,"_20907":55154,"_5":14363,"_27392":55085,"_2946":55155},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3461":1930,"_30106":1905,"_20907":55157,"_5":14363,"_27392":55085,"_2946":55158},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3461":1931,"_30106":1905,"_20907":55160,"_5":14363,"_27392":55089,"_2946":55161},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3461":1932,"_30106":1905,"_20907":55163,"_5":14363,"_27392":55093,"_2946":55164},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3461":1933,"_30106":1905,"_20907":55166,"_5":14363,"_27392":55093,"_2946":55167},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3461":1934,"_30106":1905,"_20907":55169,"_5":14363,"_27392":55097,"_2946":55170},[],"The cryptographic enforcement can:",{"_3461":1935,"_30106":1905,"_20907":55172,"_5":14363,"_27392":55097,"_2946":55173},[],"allow or block RSA keys;",{"_3461":1936,"_30106":1905,"_20907":55175,"_5":14363,"_27392":55097,"_2946":55176},[],"limit the supported RSA sizes;",{"_3461":1937,"_30106":1905,"_20907":55178,"_5":14363,"_27392":55097,"_2946":55179},[],"allow or block ECDSA keys;",{"_3461":1938,"_30106":1905,"_20907":55181,"_5":14363,"_27392":55097,"_2946":55182},[],"limit the supported ECDSA sizes or curves.",{"_3461":1939,"_30106":1905,"_20907":55184,"_5":14363,"_27392":55097,"_2946":55185},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3461":1940,"_30106":1905,"_20907":55187,"_5":14363,"_27392":55101,"_2946":55188},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3461":1941,"_30106":1905,"_20907":55190,"_5":14363,"_27392":55101,"_2946":52392},[],{"_3461":1942,"_30106":1905,"_20907":55192,"_5":14363,"_27392":55101,"_2946":55193},[],"First choice",{"_3461":1943,"_30106":1905,"_20907":55195,"_5":14363,"_27392":55101,"_2946":55196},[],"Second choice",{"_3461":1944,"_30106":1905,"_20907":55198,"_5":14363,"_27392":55101,"_2946":55199},[],"If neither is supplied",{"_3461":1945,"_30106":1905,"_20907":55201,"_5":14363,"_27392":55101,"_2946":55202},[],"Direct signing with a CA",{"_3461":1946,"_30106":1905,"_20907":55204,"_5":14363,"_27392":55101,"_2946":55205},[],"`issuance_profile` embedded in the request",{"_3461":1947,"_30106":1905,"_20907":55207,"_5":14363,"_27392":55101,"_2946":55208},[],"Request `issuance_profile_id`",{"_3461":1948,"_30106":1905,"_20907":55210,"_5":14363,"_27392":55101,"_2946":55211},[],"CA default profile (`profile_id`).",{"_3461":1949,"_30106":1905,"_20907":55213,"_5":14363,"_27392":55101,"_2946":55214},[],"Issuance through a DMS",{"_3461":1950,"_30106":1905,"_20907":55216,"_5":14363,"_27392":55101,"_2946":55217},[],"`settings.issuance_profile_id`",{"_3461":1951,"_30106":1905,"_20907":55219,"_5":14363,"_27392":55101,"_2946":55220},[],"`settings.issuance_profile` embedded in the DMS",{"_3461":1952,"_30106":1905,"_20907":55222,"_5":14363,"_27392":55101,"_2946":55223},[],"Enrollment CA default profile.",{"_3461":1953,"_30106":1905,"_20907":55225,"_5":14363,"_27392":55101,"_2946":55226},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3461":1954,"_30106":1905,"_20907":55228,"_5":14363,"_27392":55101,"_2946":55229},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3461":1955,"_30106":1905,"_20907":55231,"_5":14363,"_27392":55109,"_2946":55232},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3461":1956,"_30106":1905,"_20907":55234,"_5":14363,"_27392":55113,"_2946":55235},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3461":1957,"_30106":1905,"_20907":55237,"_5":14363,"_27392":55117,"_2946":55238},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3461":1958,"_30106":1905,"_20907":55240,"_5":14363,"_27392":55121,"_2946":55241},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3461":1959,"_30106":1905,"_20907":55243,"_5":14363,"_27392":55125,"_2946":55244},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3461":1960,"_30106":1905,"_20907":55246,"_5":14363,"_27392":55125,"_2946":55247},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3461":1961,"_30106":1905,"_20907":55249,"_5":14363,"_27392":55129,"_2946":55250},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3461":1962,"_30106":1905,"_20907":55252,"_5":14363,"_27392":55129,"_2946":55253},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3461":1963,"_30106":1905,"_20907":55255,"_5":14363,"_27392":55129,"_2946":55256},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3461":1964,"_30106":1905,"_20907":55258,"_5":14363,"_27392":55129,"_2946":55259},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3461":1965,"_30106":1905,"_20907":55261,"_5":14363,"_27392":55133,"_2946":55262},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3461":1966,"_30106":1905,"_20907":55264,"_5":14363,"_27392":55133,"_2946":55265},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3461":1967,"_30106":1967,"_5":14715,"_2946":55267,"_30459":55268,"_20907":55270,"_27392":1967},"Certificate validation",[49157,50625,54630,55269],"Validation",[],{"_3461":1968,"_30106":1967,"_20907":55272,"_5":14363,"_27392":1967,"_2946":55273},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3461":1969,"_30106":1967,"_5":30456,"_20907":55275,"_27392":55276,"_2946":55277},[],"/docs/pr-preview/pr-60/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3461":1970,"_30106":1967,"_5":30456,"_20907":55279,"_27392":55280,"_2946":55281},[],"/docs/pr-preview/pr-60/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3461":1971,"_30106":1967,"_5":30456,"_20907":55283,"_27392":55284,"_2946":55285},[],"/docs/pr-preview/pr-60/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3461":1972,"_30106":1967,"_20907":55287,"_5":14363,"_27392":1967,"_2946":55288},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3461":1973,"_30106":1967,"_20907":55290,"_5":14363,"_27392":55276,"_2946":55291},[],"Verify these criteria together:",{"_3461":1974,"_30106":1967,"_20907":55293,"_5":14363,"_27392":55276,"_2946":54256},[],{"_3461":1975,"_30106":1967,"_20907":55295,"_5":14363,"_27392":55276,"_2946":55296},[],"Required result",{"_3461":1976,"_30106":1967,"_20907":55298,"_5":14363,"_27392":55276,"_2946":55299},[],"Chain and signature",{"_3461":1977,"_30106":1967,"_20907":55301,"_5":14363,"_27392":55276,"_2946":55302},[],"Valid chain to a root deliberately installed in the consumer.",{"_3461":1978,"_30106":1967,"_20907":55304,"_5":14363,"_27392":55276,"_2946":55305},[],"Dates",{"_3461":1979,"_30106":1967,"_20907":55307,"_5":14363,"_27392":55276,"_2946":55308},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3461":1980,"_30106":1967,"_20907":55310,"_5":14363,"_27392":55276,"_2946":50294},[],{"_3461":1981,"_30106":1967,"_20907":55312,"_5":14363,"_27392":55276,"_2946":55313},[],"Name, SAN or identifier matches the expected peer.",{"_3461":1982,"_30106":1967,"_20907":55315,"_5":14363,"_27392":55276,"_2946":49547},[],{"_3461":1983,"_30106":1967,"_20907":55317,"_5":14363,"_27392":55276,"_2946":55318},[],"KU, EKU and constraints permit the specific operation.",{"_3461":1984,"_30106":1967,"_20907":55320,"_5":14363,"_27392":55276,"_2946":55321},[],"Revocation",{"_3461":1985,"_30106":1967,"_20907":55323,"_5":14363,"_27392":55276,"_2946":55324},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3461":1986,"_30106":1967,"_20907":55326,"_5":14363,"_27392":55276,"_2946":55327},[],"Authorization",{"_3461":1987,"_30106":1967,"_20907":55329,"_5":14363,"_27392":55276,"_2946":55330},[],"The application permits that identity to perform the action.",{"_3461":1988,"_30106":1967,"_20907":55332,"_5":14363,"_27392":55276,"_2946":55333},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3461":1989,"_30106":1967,"_20907":55335,"_5":14363,"_27392":55280,"_2946":55336},[],"Mechanism",{"_3461":1990,"_30106":1967,"_20907":55338,"_5":14363,"_27392":55280,"_2946":55339},[],"When to use it",{"_3461":1991,"_30106":1967,"_20907":55341,"_5":14363,"_27392":55280,"_2946":55342},[],"What you must maintain",{"_3461":1992,"_30106":1967,"_20907":55344,"_5":14363,"_27392":55280,"_2946":55345},[],"OCSP",{"_3461":1993,"_30106":1967,"_20907":55347,"_5":14363,"_27392":55280,"_2946":55348},[],"Status query for a specific certificate.",{"_3461":1994,"_30106":1967,"_20907":55350,"_5":14363,"_27392":55280,"_2946":55351},[],"Responder access, signature verification and cache/freshness policy.",{"_3461":1995,"_30106":1967,"_20907":55353,"_5":14363,"_27392":55280,"_2946":55354},[],"CRL",{"_3461":1996,"_30106":1967,"_20907":55356,"_5":14363,"_27392":55280,"_2946":55357},[],"Local checks for many certificates or offline operation.",{"_3461":1997,"_30106":1967,"_20907":55359,"_5":14363,"_27392":55280,"_2946":55360},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3461":1998,"_30106":1967,"_20907":55362,"_5":14363,"_27392":55280,"_2946":55363},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3461":1999,"_30106":1967,"_20907":55365,"_5":14363,"_27392":55280,"_2946":55366},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3461":2000,"_30106":1967,"_20907":55368,"_5":14363,"_27392":55284,"_2946":55369},[],"Accept a current, authorized certificate with a known chain.",{"_3461":2001,"_30106":1967,"_20907":55371,"_5":14363,"_27392":55284,"_2946":55372},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3461":2002,"_30106":1967,"_20907":55374,"_5":14363,"_27392":55284,"_2946":55375},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3461":2003,"_30106":1967,"_20907":55377,"_5":14363,"_27392":55284,"_2946":55378},[],"Check that a new connection with that identity is rejected.",{"_3461":2004,"_30106":1967,"_20907":55380,"_5":14363,"_27392":55284,"_2946":55381},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3461":2005,"_30106":1967,"_20907":55383,"_5":14363,"_27392":55284,"_2946":55384},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3461":2006,"_30106":1967,"_20907":55386,"_5":14363,"_27392":55284,"_2946":55387},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3461":2007,"_30106":1967,"_20907":55389,"_5":14363,"_27392":55284,"_2946":55390},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":2008,"_30106":1967,"_20907":55392,"_5":14363,"_27392":55284,"_2946":55393},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3461":2009,"_30106":2009,"_5":14715,"_2946":55395,"_30459":55396,"_20907":55397,"_27392":2009},"Certificates",[49157,50625,54630,54631],[],{"_3461":2010,"_30106":2009,"_20907":55399,"_5":14363,"_27392":2009,"_2946":55400},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3461":2011,"_30106":2009,"_5":30456,"_20907":55402,"_27392":55403,"_2946":55404},[],"/docs/pr-preview/pr-60/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3461":2012,"_30106":2009,"_5":30456,"_20907":55406,"_27392":55407,"_2946":55408},[],"/docs/pr-preview/pr-60/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3461":2013,"_30106":2009,"_5":30456,"_20907":55410,"_27392":55411,"_2946":55412},[],"/docs/pr-preview/pr-60/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3461":2014,"_30106":2009,"_5":30456,"_20907":55414,"_27392":55415,"_2946":55416},[],"/docs/pr-preview/pr-60/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3461":2015,"_30106":2009,"_5":30456,"_20907":55418,"_27392":55419,"_2946":55420},[],"/docs/pr-preview/pr-60/platform/pki/certificates#open-the-action","Open the action",{"_3461":2016,"_30106":2009,"_5":30456,"_20907":55422,"_27392":55423,"_2946":55424},[],"/docs/pr-preview/pr-60/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3461":2017,"_30106":2009,"_5":30456,"_20907":55426,"_27392":55427,"_2946":55428},[],"/docs/pr-preview/pr-60/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3461":2018,"_30106":2009,"_5":30456,"_20907":55430,"_27392":55431,"_2946":55432},[],"/docs/pr-preview/pr-60/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3461":2019,"_30106":2009,"_5":30456,"_20907":55434,"_27392":55435,"_2946":55436},[],"/docs/pr-preview/pr-60/platform/pki/certificates#continue","Continue",{"_3461":2020,"_30106":2009,"_20907":55438,"_5":14363,"_27392":2009,"_2946":55439},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3461":2021,"_30106":2009,"_20907":55441,"_5":14363,"_27392":55403,"_2946":55442},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3461":2022,"_30106":2009,"_20907":55444,"_5":14363,"_27392":55403,"_2946":55445},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3461":2023,"_30106":2009,"_20907":55447,"_5":14363,"_27392":55403,"_2946":55448},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3461":2024,"_30106":2009,"_20907":55450,"_5":14363,"_27392":55403,"_2946":55451},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3461":2025,"_30106":2009,"_20907":55453,"_5":14363,"_27392":55403,"_2946":55454},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3461":2026,"_30106":2009,"_20907":55456,"_5":14363,"_27392":55403,"_2946":55457},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3461":2027,"_30106":2009,"_20907":55459,"_5":14363,"_27392":55403,"_2946":55460},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3461":2028,"_30106":2009,"_20907":55462,"_5":14363,"_27392":55407,"_2946":55463},[],"Download the PEM and inspect it:",{"_3461":2029,"_30106":2009,"_20907":55465,"_5":14363,"_27392":55407,"_2946":55466},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3461":2030,"_30106":2009,"_20907":55468,"_5":14363,"_27392":55411,"_2946":55469},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3461":2031,"_30106":2009,"_20907":55471,"_5":14363,"_27392":55411,"_2946":55472},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3461":2032,"_30106":2009,"_20907":55474,"_5":14363,"_27392":55411,"_2946":55475},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3461":2033,"_30106":2009,"_20907":55477,"_5":14363,"_27392":55411,"_2946":55478},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3461":2034,"_30106":2009,"_20907":55480,"_5":14363,"_27392":55411,"_2946":55481},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3461":2035,"_30106":2009,"_20907":55483,"_5":14363,"_27392":55411,"_2946":55484},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3461":2036,"_30106":2009,"_20907":55486,"_5":14363,"_27392":55411,"_2946":55487},[],"For browser key generation, follow Issue your first certificate.",{"_3461":2037,"_30106":2009,"_20907":55489,"_5":14363,"_27392":55415,"_2946":55490},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3461":2038,"_30106":2009,"_20907":55492,"_5":14363,"_27392":55419,"_2946":55493},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3461":2039,"_30106":2009,"_20907":55495,"_5":14363,"_27392":55423,"_2946":55496},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3461":2040,"_30106":2009,"_20907":55498,"_5":14363,"_27392":55427,"_2946":55499},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3461":2041,"_30106":2009,"_20907":55501,"_5":14363,"_27392":55427,"_2946":55502},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3461":2042,"_30106":2009,"_20907":55504,"_5":14363,"_27392":55427,"_2946":55505},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3461":2043,"_30106":2009,"_20907":55507,"_5":14363,"_27392":55431,"_2946":55508},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3461":2044,"_30106":2009,"_20907":55510,"_5":14363,"_27392":55431,"_2946":55511},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3461":2045,"_30106":2009,"_20907":55513,"_5":14363,"_27392":55431,"_2946":55514},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3461":2046,"_30106":2009,"_20907":55516,"_5":14363,"_27392":55435,"_2946":55517},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":2047,"_30106":2009,"_20907":55519,"_5":14363,"_27392":55435,"_2946":55520},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3461":2048,"_30106":2048,"_5":14715,"_2946":55522,"_30459":55523,"_20907":55525,"_27392":2048},"Certificate lifecycle",[49157,50625,54630,55524],"Concepts",[],{"_3461":2049,"_30106":2048,"_20907":55527,"_5":14363,"_27392":2048,"_2946":55528},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3461":2050,"_30106":2048,"_5":30456,"_20907":55530,"_27392":55531,"_2946":55532},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3461":2051,"_30106":2048,"_5":30456,"_20907":55534,"_27392":55535,"_2946":55536},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3461":2052,"_30106":2048,"_5":30456,"_20907":55538,"_27392":55539,"_2946":55540},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3461":2053,"_30106":2048,"_5":30456,"_20907":55542,"_27392":55543,"_2946":55544},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3461":2054,"_30106":2048,"_5":30456,"_20907":55546,"_27392":55547,"_2946":55548},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3461":2055,"_30106":2048,"_5":30456,"_20907":55550,"_27392":55551,"_2946":55552},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3461":2056,"_30106":2048,"_5":30456,"_20907":55554,"_27392":55555,"_2946":55556},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3461":2057,"_30106":2048,"_5":30456,"_20907":55558,"_27392":55559,"_2946":55560},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3461":2058,"_30106":2048,"_5":30456,"_20907":55562,"_27392":55563,"_2946":55564},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3461":2059,"_30106":2048,"_5":30456,"_20907":55566,"_27392":55567,"_2946":55568},[],"/docs/pr-preview/pr-60/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3461":2060,"_30106":2048,"_20907":55570,"_5":14363,"_27392":2048,"_2946":55571},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3461":2061,"_30106":2048,"_20907":55573,"_5":14363,"_27392":55535,"_2946":55574},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3461":2062,"_30106":2048,"_20907":55576,"_5":14363,"_27392":55539,"_2946":55577},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3461":2063,"_30106":2048,"_20907":55579,"_5":14363,"_27392":55543,"_2946":55580},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3461":2064,"_30106":2048,"_20907":55582,"_5":14363,"_27392":55547,"_2946":55583},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3461":2065,"_30106":2048,"_20907":55585,"_5":14363,"_27392":55551,"_2946":55586},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3461":2066,"_30106":2048,"_20907":55588,"_5":14363,"_27392":55555,"_2946":55589},[],"Lamassu persists four X.509 states:",{"_3461":2067,"_30106":2048,"_20907":55591,"_5":14363,"_27392":55555,"_2946":55592},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3461":2068,"_30106":2048,"_20907":55594,"_5":14363,"_27392":55555,"_2946":55595},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3461":2069,"_30106":2048,"_20907":55597,"_5":14363,"_27392":55555,"_2946":55598},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3461":2070,"_30106":2048,"_20907":55600,"_5":14363,"_27392":55555,"_2946":55601},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3461":2071,"_30106":2048,"_20907":55603,"_5":14363,"_27392":55555,"_2946":55604},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3461":2072,"_30106":2048,"_20907":55606,"_5":14363,"_27392":55559,"_2946":55607},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3461":2073,"_30106":2048,"_20907":55609,"_5":14363,"_27392":55559,"_2946":55610},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3461":2074,"_30106":2048,"_20907":55612,"_5":14363,"_27392":55559,"_2946":55613},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3461":2075,"_30106":2048,"_20907":55615,"_5":14363,"_27392":55563,"_2946":55616},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3461":2076,"_30106":2048,"_20907":55618,"_5":14363,"_27392":55563,"_2946":55619},[],"Before confirming:",{"_3461":2077,"_30106":2048,"_20907":55621,"_5":14363,"_27392":55563,"_2946":55622},[],"Identify DMSs, devices and services that trust that chain.",{"_3461":2078,"_30106":2048,"_20907":55624,"_5":14363,"_27392":55563,"_2946":55625},[],"Distribute the new chain of trust.",{"_3461":2079,"_30106":2048,"_20907":55627,"_5":14363,"_27392":55563,"_2946":55628},[],"Reissue the necessary identities.",{"_3461":2080,"_30106":2048,"_20907":55630,"_5":14363,"_27392":55563,"_2946":55631},[],"Check OCSP and CRL from a real consumer.",{"_3461":2081,"_30106":2048,"_20907":55633,"_5":14363,"_27392":55563,"_2946":55634},[],"Revoke the old CA once no legitimate traffic remains.",{"_3461":2082,"_30106":2048,"_20907":55636,"_5":14363,"_27392":55563,"_2946":55637},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3461":2083,"_30106":2048,"_20907":55639,"_5":14363,"_27392":55567,"_2946":55640},[],"Certificates entering the preventive or critical renewal window.",{"_3461":2084,"_30106":2048,"_20907":55642,"_5":14363,"_27392":55567,"_2946":55643},[],"Repeated enrollment or re-enrollment failures.",{"_3461":2085,"_30106":2048,"_20907":55645,"_5":14363,"_27392":55567,"_2946":55646},[],"Status changes and revocation reasons.",{"_3461":2086,"_30106":2048,"_20907":55648,"_5":14363,"_27392":55567,"_2946":55649},[],"OCSP and CRL publication and validity.",{"_3461":2087,"_30106":2048,"_20907":55651,"_5":14363,"_27392":55567,"_2946":55652},[],"Dependencies still presenting a replaced certificate.",{"_3461":2088,"_30106":2048,"_20907":55654,"_5":14363,"_27392":55567,"_2946":55655},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3461":2089,"_30106":2089,"_5":14715,"_2946":55657,"_30459":55658,"_20907":55659,"_27392":2089},"Trust model",[49157,50625,54630,55524],[],{"_3461":2090,"_30106":2089,"_20907":55661,"_5":14363,"_27392":2089,"_2946":55662},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3461":2091,"_30106":2089,"_5":30456,"_20907":55664,"_27392":55665,"_2946":55666},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3461":2092,"_30106":2089,"_5":30456,"_20907":55668,"_27392":55669,"_2946":55670},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3461":2093,"_30106":2089,"_5":30456,"_20907":55672,"_27392":55673,"_2946":55674},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3461":2094,"_30106":2089,"_5":30456,"_20907":55676,"_27392":55677,"_2946":55678},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3461":2095,"_30106":2089,"_5":30456,"_20907":55680,"_27392":55681,"_2946":55682},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3461":2096,"_30106":2089,"_5":30456,"_20907":55684,"_27392":55685,"_2946":55686},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3461":2097,"_30106":2089,"_5":30456,"_20907":55688,"_27392":55689,"_2946":55690},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3461":2098,"_30106":2089,"_5":30456,"_20907":55692,"_27392":55693,"_2946":55694},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3461":2099,"_30106":2089,"_5":30456,"_20907":55696,"_27392":55697,"_2946":55698},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3461":2100,"_30106":2089,"_5":30456,"_20907":55700,"_27392":55701,"_2946":55702},[],"/docs/pr-preview/pr-60/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3461":2101,"_30106":2089,"_20907":55704,"_5":14363,"_27392":2089,"_2946":55705},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3461":2102,"_30106":2089,"_20907":55707,"_5":14363,"_27392":55669,"_2946":55708},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3461":2103,"_30106":2089,"_20907":55710,"_5":14363,"_27392":55673,"_2946":55711},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3461":2104,"_30106":2089,"_20907":55713,"_5":14363,"_27392":55677,"_2946":55714},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3461":2105,"_30106":2089,"_20907":55716,"_5":14363,"_27392":55681,"_2946":55717},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3461":2106,"_30106":2089,"_20907":55719,"_5":14363,"_27392":55685,"_2946":55720},[],"The device proves it can enroll according to the DMS policy.",{"_3461":2107,"_30106":2089,"_20907":55722,"_5":14363,"_27392":55685,"_2946":55723},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3461":2108,"_30106":2089,"_20907":55725,"_5":14363,"_27392":55685,"_2946":55726},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3461":2109,"_30106":2089,"_20907":55728,"_5":14363,"_27392":55685,"_2946":55729},[],"The device installs the certificate and the chain it needs.",{"_3461":2110,"_30106":2089,"_20907":55731,"_5":14363,"_27392":55685,"_2946":55732},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3461":2111,"_30106":2089,"_20907":55734,"_5":14363,"_27392":55685,"_2946":55735},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3461":2112,"_30106":2089,"_20907":55737,"_5":14363,"_27392":55689,"_2946":55738},[],"A DMS relates three sets that are worth designing separately:",{"_3461":2113,"_30106":2089,"_20907":55740,"_5":14363,"_27392":55689,"_2946":55741},[],"**Enrollment CA:** signs the new identities.",{"_3461":2114,"_30106":2089,"_20907":55743,"_5":14363,"_27392":55689,"_2946":55744},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3461":2115,"_30106":2089,"_20907":55746,"_5":14363,"_27392":55689,"_2946":55747},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3461":2116,"_30106":2089,"_20907":55749,"_5":14363,"_27392":55689,"_2946":55750},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3461":2117,"_30106":2089,"_20907":55752,"_5":14363,"_27392":55693,"_2946":55753},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3461":2118,"_30106":2089,"_20907":55755,"_5":14363,"_27392":55693,"_2946":55756},[],"that the current date is between `Not Before` and `Not After`;",{"_3461":2119,"_30106":2089,"_20907":55758,"_5":14363,"_27392":55693,"_2946":55759},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3461":2120,"_30106":2089,"_20907":55761,"_5":14363,"_27392":55693,"_2946":55762},[],"that names, SANs and subject match the expected identity;",{"_3461":2121,"_30106":2089,"_20907":55764,"_5":14363,"_27392":55693,"_2946":55765},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3461":2122,"_30106":2089,"_20907":55767,"_5":14363,"_27392":55693,"_2946":55768},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3461":2123,"_30106":2089,"_20907":55770,"_5":14363,"_27392":55693,"_2946":55771},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3461":2124,"_30106":2089,"_20907":55773,"_5":14363,"_27392":55697,"_2946":55774},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3461":2125,"_30106":2089,"_20907":55776,"_5":14363,"_27392":55701,"_2946":55777},[],"Keep the root out of daily operations, or with very restricted access.",{"_3461":2126,"_30106":2089,"_20907":55779,"_5":14363,"_27392":55701,"_2946":55780},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3461":2127,"_30106":2089,"_20907":55782,"_5":14363,"_27392":55701,"_2946":55783},[],"Assign explicit profiles to every use case.",{"_3461":2128,"_30106":2089,"_20907":55785,"_5":14363,"_27392":55701,"_2946":55786},[],"Distribute the new trust before starting a rotation.",{"_3461":2129,"_30106":2089,"_20907":55788,"_5":14363,"_27392":55701,"_2946":55789},[],"Keep enough overlap to renew a disconnected fleet.",{"_3461":2130,"_30106":2089,"_20907":55791,"_5":14363,"_27392":55701,"_2946":55792},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3461":2131,"_30106":2089,"_20907":55794,"_5":14363,"_27392":55701,"_2946":55795},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3461":2132,"_30106":2132,"_5":14715,"_2946":55797,"_30459":55798,"_20907":55799,"_27392":2132},"Revocation lists (CRL)",[49157,50625,54630,55269],[],{"_3461":2133,"_30106":2132,"_20907":55801,"_5":14363,"_27392":2132,"_2946":55802},[],"Generate and distribute signed lists to validate certificates offline.",{"_3461":2134,"_30106":2132,"_5":30456,"_20907":55804,"_27392":55805,"_2946":55806},[],"/docs/pr-preview/pr-60/platform/pki/crl#crl-settings","CRL settings",{"_3461":2135,"_30106":2132,"_5":30456,"_20907":55808,"_27392":55809,"_2946":55810},[],"/docs/pr-preview/pr-60/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3461":2136,"_30106":2132,"_5":30456,"_20907":55812,"_27392":55813,"_2946":55814},[],"/docs/pr-preview/pr-60/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3461":2137,"_30106":2132,"_5":30456,"_20907":55816,"_27392":55817,"_2946":55818},[],"/docs/pr-preview/pr-60/platform/pki/crl#crl-contents","CRL contents",{"_3461":2138,"_30106":2132,"_5":30456,"_20907":55820,"_27392":55821,"_2946":55822},[],"/docs/pr-preview/pr-60/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3461":2139,"_30106":2132,"_5":30456,"_20907":55824,"_27392":55825,"_2946":55826},[],"/docs/pr-preview/pr-60/platform/pki/crl#crl-settings-api","CRL settings API",{"_3461":2140,"_30106":2132,"_5":30456,"_20907":55828,"_27392":55829,"_2946":55830},[],"/docs/pr-preview/pr-60/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3461":2141,"_30106":2132,"_5":30456,"_20907":55832,"_27392":55833,"_2946":55834},[],"/docs/pr-preview/pr-60/platform/pki/crl#from-the-interface","From the interface",{"_3461":2142,"_30106":2132,"_5":30456,"_20907":55836,"_27392":55837,"_2946":55838},[],"/docs/pr-preview/pr-60/platform/pki/crl#references","References",{"_3461":2143,"_30106":2132,"_20907":55840,"_5":14363,"_27392":2132,"_2946":55841},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3461":2144,"_30106":2132,"_20907":55843,"_5":14363,"_27392":55805,"_2946":55844},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3461":2145,"_30106":2132,"_20907":55846,"_5":14363,"_27392":55805,"_2946":55847},[],"Field",{"_3461":2146,"_30106":2132,"_20907":55849,"_5":14363,"_27392":55805,"_2946":49547},[],{"_3461":2147,"_30106":2132,"_20907":55851,"_5":14363,"_27392":55805,"_2946":55852},[],"`ca_id`",{"_3461":2148,"_30106":2132,"_20907":55854,"_5":14363,"_27392":55805,"_2946":55855},[],"ID of the CA the settings belong to.",{"_3461":2149,"_30106":2132,"_20907":55857,"_5":14363,"_27392":55805,"_2946":55858},[],"`status`",{"_3461":2150,"_30106":2132,"_20907":55860,"_5":14363,"_27392":55805,"_2946":55861},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3461":2151,"_30106":2132,"_20907":55863,"_5":14363,"_27392":55805,"_2946":55864},[],"`legacy_ski`",{"_3461":2152,"_30106":2132,"_20907":55866,"_5":14363,"_27392":55805,"_2946":55867},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3461":2153,"_30106":2132,"_20907":55869,"_5":14363,"_27392":55805,"_2946":55870},[],"`latest_crl`",{"_3461":2154,"_30106":2132,"_20907":55872,"_5":14363,"_27392":55805,"_2946":55873},[],"Version, validity start and end of the last published list. Read-only.",{"_3461":2155,"_30106":2132,"_20907":55875,"_5":14363,"_27392":55805,"_2946":55876},[],"`crl_options` field",{"_3461":2156,"_30106":2132,"_20907":55878,"_5":14363,"_27392":55805,"_2946":49547},[],{"_3461":2157,"_30106":2132,"_20907":55880,"_5":14363,"_27392":55805,"_2946":55881},[],"Initial value",{"_3461":2158,"_30106":2132,"_20907":55883,"_5":14363,"_27392":55805,"_2946":55884},[],"`validity`",{"_3461":2159,"_30106":2132,"_20907":55886,"_5":14363,"_27392":55805,"_2946":55887},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3461":2160,"_30106":2132,"_20907":55889,"_5":14363,"_27392":55805,"_2946":55890},[],"7 days.",{"_3461":2161,"_30106":2132,"_20907":55892,"_5":14363,"_27392":55805,"_2946":55893},[],"`refresh_interval`",{"_3461":2162,"_30106":2132,"_20907":55895,"_5":14363,"_27392":55805,"_2946":55896},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3461":2163,"_30106":2132,"_20907":55898,"_5":14363,"_27392":55805,"_2946":55899},[],"6 days and 23 hours.",{"_3461":2164,"_30106":2132,"_20907":55901,"_5":14363,"_27392":55805,"_2946":55902},[],"`regenerate_on_revoke`",{"_3461":2165,"_30106":2132,"_20907":55904,"_5":14363,"_27392":55805,"_2946":55905},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3461":2166,"_30106":2132,"_20907":55907,"_5":14363,"_27392":55805,"_2946":55908},[],"`true`.",{"_3461":2167,"_30106":2132,"_20907":55910,"_5":14363,"_27392":55805,"_2946":55911},[],"`signer_serial_number`",{"_3461":2168,"_30106":2132,"_20907":55913,"_5":14363,"_27392":55805,"_2946":55914},[],"Serial number of the existing certificate that signs the CRL.",{"_3461":2169,"_30106":2132,"_20907":55916,"_5":14363,"_27392":55805,"_2946":55917},[],"Serial number of the CA’s current certificate.",{"_3461":2170,"_30106":2132,"_20907":55919,"_5":14363,"_27392":55805,"_2946":55920},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3461":2171,"_30106":2132,"_20907":55922,"_5":14363,"_27392":55805,"_2946":55923},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3461":2172,"_30106":2132,"_20907":55925,"_5":14363,"_27392":55805,"_2946":55926},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3461":2173,"_30106":2132,"_20907":55928,"_5":14363,"_27392":55805,"_2946":55929},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3461":2174,"_30106":2132,"_20907":55931,"_5":14363,"_27392":55805,"_2946":55932},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3461":2175,"_30106":2132,"_20907":55934,"_5":14363,"_27392":55805,"_2946":55935},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3461":2176,"_30106":2132,"_20907":55937,"_5":14363,"_27392":55805,"_2946":55938},[],"Adjust validity and signer before deleting a CA.",{"_3461":2177,"_30106":2132,"_20907":55940,"_5":14363,"_27392":55805,"_2946":55941},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3461":2178,"_30106":2132,"_20907":55943,"_5":14363,"_27392":55805,"_2946":55944},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3461":2179,"_30106":2132,"_20907":55946,"_5":14363,"_27392":55805,"_2946":55947},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3461":2180,"_30106":2132,"_20907":55949,"_5":14363,"_27392":55809,"_2946":55950},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3461":2181,"_30106":2132,"_20907":55952,"_5":14363,"_27392":55809,"_2946":55953},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3461":2182,"_30106":2132,"_20907":55955,"_5":14363,"_27392":55809,"_2946":55956},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3461":2183,"_30106":2132,"_20907":55958,"_5":14363,"_27392":55809,"_2946":55959},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3461":2184,"_30106":2132,"_20907":55961,"_5":14363,"_27392":55813,"_2946":55962},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3461":2185,"_30106":2132,"_20907":55964,"_5":14363,"_27392":55813,"_2946":55965},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3461":2186,"_30106":2132,"_20907":55967,"_5":14363,"_27392":55813,"_2946":55968},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3461":2187,"_30106":2132,"_20907":55970,"_5":14363,"_27392":55813,"_2946":55971},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3461":2188,"_30106":2132,"_20907":55973,"_5":14363,"_27392":55813,"_2946":55974},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3461":2189,"_30106":2132,"_20907":55976,"_5":14363,"_27392":55813,"_2946":55977},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3461":2190,"_30106":2132,"_20907":55979,"_5":14363,"_27392":55813,"_2946":55980},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3461":2191,"_30106":2132,"_20907":55982,"_5":14363,"_27392":55813,"_2946":55983},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3461":2192,"_30106":2132,"_20907":55985,"_5":14363,"_27392":55813,"_2946":55986},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3461":2193,"_30106":2132,"_20907":55988,"_5":14363,"_27392":55817,"_2946":55989},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3461":2194,"_30106":2132,"_20907":55991,"_5":14363,"_27392":55817,"_2946":55992},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3461":2195,"_30106":2132,"_20907":55994,"_5":14363,"_27392":55821,"_2946":55995},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3461":2196,"_30106":2132,"_20907":55997,"_5":14363,"_27392":55821,"_2946":55998},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3461":2197,"_30106":2132,"_20907":56000,"_5":14363,"_27392":55821,"_2946":56001},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3461":2198,"_30106":2132,"_20907":56003,"_5":14363,"_27392":55821,"_2946":56004},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3461":2199,"_30106":2132,"_20907":56006,"_5":14363,"_27392":55821,"_2946":56007},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3461":2200,"_30106":2132,"_20907":56009,"_5":14363,"_27392":55825,"_2946":56010},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3461":2201,"_30106":2132,"_20907":56012,"_5":14363,"_27392":55825,"_2946":52395},[],{"_3461":2202,"_30106":2132,"_20907":56014,"_5":14363,"_27392":55825,"_2946":56015},[],"Relative path",{"_3461":2203,"_30106":2132,"_20907":56017,"_5":14363,"_27392":55825,"_2946":52392},[],{"_3461":2204,"_30106":2132,"_20907":56019,"_5":14363,"_27392":55825,"_2946":56020},[],"`GET`",{"_3461":2205,"_30106":2132,"_20907":56022,"_5":14363,"_27392":55825,"_2946":56023},[],"`/v1/crl-settings`",{"_3461":2206,"_30106":2132,"_20907":56025,"_5":14363,"_27392":55825,"_2946":56026},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3461":2207,"_30106":2132,"_20907":56028,"_5":14363,"_27392":55825,"_2946":56020},[],{"_3461":2208,"_30106":2132,"_20907":56030,"_5":14363,"_27392":55825,"_2946":56031},[],"`/v1/crl-settings/{ca-id}`",{"_3461":2209,"_30106":2132,"_20907":56033,"_5":14363,"_27392":55825,"_2946":56034},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3461":2210,"_30106":2132,"_20907":56036,"_5":14363,"_27392":55825,"_2946":56037},[],"`PUT`",{"_3461":2211,"_30106":2132,"_20907":56039,"_5":14363,"_27392":55825,"_2946":56031},[],{"_3461":2212,"_30106":2132,"_20907":56041,"_5":14363,"_27392":55825,"_2946":56042},[],"Replace the CRL configuration of a CA.",{"_3461":2213,"_30106":2132,"_20907":56044,"_5":14363,"_27392":55825,"_2946":56045},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3461":2214,"_30106":2132,"_20907":56047,"_5":14363,"_27392":55825,"_2946":56048},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3461":2215,"_30106":2132,"_20907":56050,"_5":14363,"_27392":55829,"_2946":56051},[],"Symptom",{"_3461":2216,"_30106":2132,"_20907":56053,"_5":14363,"_27392":55829,"_2946":56054},[],"Cause",{"_3461":2217,"_30106":2132,"_20907":56056,"_5":14363,"_27392":55829,"_2946":56057},[],"Action",{"_3461":2218,"_30106":2132,"_20907":56059,"_5":14363,"_27392":55829,"_2946":56060},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3461":2219,"_30106":2132,"_20907":56062,"_5":14363,"_27392":55829,"_2946":56063},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3461":2220,"_30106":2132,"_20907":56065,"_5":14363,"_27392":55829,"_2946":56066},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3461":2221,"_30106":2132,"_20907":56068,"_5":14363,"_27392":55829,"_2946":56069},[],"`PUT` returns 400.",{"_3461":2222,"_30106":2132,"_20907":56071,"_5":14363,"_27392":55829,"_2946":56072},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3461":2223,"_30106":2132,"_20907":56074,"_5":14363,"_27392":55829,"_2946":56075},[],"Set the serial number of a valid certificate of that CA.",{"_3461":2224,"_30106":2132,"_20907":56077,"_5":14363,"_27392":55829,"_2946":56078},[],"`PUT` returns 404.",{"_3461":2225,"_30106":2132,"_20907":56080,"_5":14363,"_27392":55829,"_2946":56081},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3461":2226,"_30106":2132,"_20907":56083,"_5":14363,"_27392":55829,"_2946":56084},[],"Check the CA ID and the signer serial number.",{"_3461":2227,"_30106":2132,"_20907":56086,"_5":14363,"_27392":55829,"_2946":56087},[],"`PUT` returns 400 from a 3.x client.",{"_3461":2228,"_30106":2132,"_20907":56089,"_5":14363,"_27392":55829,"_2946":56090},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3461":2229,"_30106":2132,"_20907":56092,"_5":14363,"_27392":55829,"_2946":56093},[],"Update the client to send the new field.",{"_3461":2230,"_30106":2132,"_20907":56095,"_5":14363,"_27392":55829,"_2946":56096},[],"The CRL does not change after revoking a certificate.",{"_3461":2231,"_30106":2132,"_20907":56098,"_5":14363,"_27392":55829,"_2946":56099},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3461":2232,"_30106":2132,"_20907":56101,"_5":14363,"_27392":55829,"_2946":56102},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3461":2233,"_30106":2132,"_20907":56104,"_5":14363,"_27392":55829,"_2946":56105},[],"A verifier rejects the CRL because of the issuer.",{"_3461":2234,"_30106":2132,"_20907":56107,"_5":14363,"_27392":55829,"_2946":56108},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3461":2235,"_30106":2132,"_20907":56110,"_5":14363,"_27392":55829,"_2946":56111},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3461":2236,"_30106":2132,"_20907":56113,"_5":14363,"_27392":55833,"_2946":56114},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3461":2237,"_30106":2132,"_20907":56116,"_5":14363,"_27392":55837,"_2946":56117},[],"RFC 5280: X.509 and CRL profile.",{"_3461":2238,"_30106":2132,"_20907":56119,"_5":14363,"_27392":55837,"_2946":56120},[],"OpenSSL: openssl-crl.",{"_3461":2239,"_30106":2132,"_20907":56122,"_5":14363,"_27392":55837,"_2946":56123},[],"OpenSSL: openssl-verify.",{"_3461":2240,"_30106":2132,"_20907":56125,"_5":14363,"_27392":55837,"_2946":56126},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":2241,"_30106":2132,"_20907":56128,"_5":14363,"_27392":55837,"_2946":56129},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3461":2242,"_30106":2242,"_5":14715,"_2946":56131,"_30459":56132,"_20907":56133,"_27392":2242},"Keys and cryptographic engines",[49157,50625,54630,54631],[],{"_3461":2243,"_30106":2242,"_20907":56135,"_5":14363,"_27392":2242,"_2946":56136},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3461":2244,"_30106":2242,"_5":30456,"_20907":56138,"_27392":56139,"_2946":56140},[],"/docs/pr-preview/pr-60/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3461":2245,"_30106":2242,"_5":30456,"_20907":56142,"_27392":56143,"_2946":56144},[],"/docs/pr-preview/pr-60/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3461":2246,"_30106":2242,"_5":30456,"_20907":56146,"_27392":56147,"_2946":56148},[],"/docs/pr-preview/pr-60/platform/pki/key-management#file-system","File System",{"_3461":2247,"_30106":2242,"_5":30456,"_20907":56150,"_27392":56151,"_2946":56152},[],"/docs/pr-preview/pr-60/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3461":2248,"_30106":2242,"_5":30456,"_20907":56154,"_27392":56155,"_2946":56156},[],"/docs/pr-preview/pr-60/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3461":2249,"_30106":2242,"_5":30456,"_20907":56158,"_27392":56159,"_2946":56160},[],"/docs/pr-preview/pr-60/platform/pki/key-management#aws-kms","AWS KMS",{"_3461":2250,"_30106":2242,"_5":30456,"_20907":56162,"_27392":56163,"_2946":56164},[],"/docs/pr-preview/pr-60/platform/pki/key-management#pkcs11","PKCS#11",{"_3461":2251,"_30106":2242,"_5":30456,"_20907":56166,"_27392":56167,"_2946":56168},[],"/docs/pr-preview/pr-60/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3461":2252,"_30106":2242,"_5":30456,"_20907":56170,"_27392":56171,"_2946":56172},[],"/docs/pr-preview/pr-60/platform/pki/key-management#key-inventory","Key inventory",{"_3461":2253,"_30106":2242,"_5":30456,"_20907":56174,"_27392":56175,"_2946":56176},[],"/docs/pr-preview/pr-60/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3461":2254,"_30106":2242,"_5":30456,"_20907":56178,"_27392":56179,"_2946":56180},[],"/docs/pr-preview/pr-60/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3461":2255,"_30106":2242,"_5":30456,"_20907":56182,"_27392":56183,"_2946":56184},[],"/docs/pr-preview/pr-60/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3461":2256,"_30106":2242,"_5":30456,"_20907":56186,"_27392":56187,"_2946":56188},[],"/docs/pr-preview/pr-60/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3461":2257,"_30106":2242,"_5":30456,"_20907":56190,"_27392":56191,"_2946":56192},[],"/docs/pr-preview/pr-60/platform/pki/key-management#view-details","View details",{"_3461":2258,"_30106":2242,"_5":30456,"_20907":56194,"_27392":56195,"_2946":56196},[],"/docs/pr-preview/pr-60/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3461":2259,"_30106":2242,"_5":30456,"_20907":56198,"_27392":56199,"_2946":56200},[],"/docs/pr-preview/pr-60/platform/pki/key-management#sign","Sign",{"_3461":2260,"_30106":2242,"_5":30456,"_20907":56202,"_27392":56203,"_2946":56204},[],"/docs/pr-preview/pr-60/platform/pki/key-management#verify","Verify",{"_3461":2261,"_30106":2242,"_5":30456,"_20907":56206,"_27392":56207,"_2946":56208},[],"/docs/pr-preview/pr-60/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3461":2262,"_30106":2242,"_5":30456,"_20907":56210,"_27392":56211,"_2946":56212},[],"/docs/pr-preview/pr-60/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3461":2263,"_30106":2242,"_5":30456,"_20907":56214,"_27392":56215,"_2946":56216},[],"/docs/pr-preview/pr-60/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3461":2264,"_30106":2242,"_20907":56218,"_5":14363,"_27392":2242,"_2946":56219},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3461":2265,"_30106":2242,"_20907":56221,"_5":14363,"_27392":2242,"_2946":56222},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3461":2266,"_30106":2242,"_20907":56224,"_5":14363,"_27392":56139,"_2946":56225},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3461":2267,"_30106":2242,"_20907":56227,"_5":14363,"_27392":56139,"_2946":56228},[],"In practice, it lets you:",{"_3461":2268,"_30106":2242,"_20907":56230,"_5":14363,"_27392":56139,"_2946":56231},[],"Generate new key pairs from Lamassu IoT.",{"_3461":2269,"_30106":2242,"_20907":56233,"_5":14363,"_27392":56139,"_2946":56234},[],"Import keys created externally.",{"_3461":2270,"_30106":2242,"_20907":56236,"_5":14363,"_27392":56139,"_2946":56237},[],"Delegate custody and cryptographic operations to external engines.",{"_3461":2271,"_30106":2242,"_20907":56239,"_5":14363,"_27392":56139,"_2946":56240},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3461":2272,"_30106":2242,"_20907":56242,"_5":14363,"_27392":56143,"_2946":56243},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3461":2273,"_30106":2242,"_20907":56245,"_5":14363,"_27392":56143,"_2946":56246},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3461":2274,"_30106":2242,"_20907":56248,"_5":14363,"_27392":56143,"_2946":56249},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3461":2275,"_30106":2242,"_20907":56251,"_5":14363,"_27392":56147,"_2946":56252},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3461":2276,"_30106":2242,"_20907":56254,"_5":14363,"_27392":56151,"_2946":56255},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3461":2277,"_30106":2242,"_20907":56257,"_5":14363,"_27392":56151,"_2946":56258},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3461":2278,"_30106":2242,"_20907":56260,"_5":14363,"_27392":56155,"_2946":56261},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3461":2279,"_30106":2242,"_20907":56263,"_5":14363,"_27392":56159,"_2946":56264},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3461":2280,"_30106":2242,"_20907":56266,"_5":14363,"_27392":56163,"_2946":56267},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3461":2281,"_30106":2242,"_20907":56269,"_5":14363,"_27392":56167,"_2946":56270},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3461":2282,"_30106":2242,"_20907":56272,"_5":14363,"_27392":56167,"_2946":56273},[],"Lamassu shows the enabled engines in the console.",{"_3461":2283,"_30106":2242,"_20907":56275,"_5":14363,"_27392":56167,"_2946":56276},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3461":2284,"_30106":2242,"_20907":56278,"_5":14363,"_27392":56167,"_2946":56279},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3461":2285,"_30106":2242,"_20907":56281,"_5":14363,"_27392":56171,"_2946":56282},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3461":2286,"_30106":2242,"_20907":56284,"_5":14363,"_27392":56171,"_2946":56285},[],"The table includes the following fields:",{"_3461":2287,"_30106":2242,"_20907":56287,"_5":14363,"_27392":56171,"_2946":56288},[],"**Name**: descriptive name of the key.",{"_3461":2288,"_30106":2242,"_20907":56290,"_5":14363,"_27392":56171,"_2946":56291},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3461":2289,"_30106":2242,"_20907":56293,"_5":14363,"_27392":56171,"_2946":56294},[],"**Strength**: visual indicator of cryptographic strength.",{"_3461":2290,"_30106":2242,"_20907":56296,"_5":14363,"_27392":56171,"_2946":56297},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3461":2291,"_30106":2242,"_20907":56299,"_5":14363,"_27392":56171,"_2946":56300},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3461":2292,"_30106":2242,"_20907":56302,"_5":14363,"_27392":56171,"_2946":56303},[],"**Aliases**: alternative names associated with the key.",{"_3461":2293,"_30106":2242,"_20907":56305,"_5":14363,"_27392":56171,"_2946":56306},[],"**Tags**: labels for classification and search.",{"_3461":2294,"_30106":2242,"_20907":56308,"_5":14363,"_27392":56171,"_2946":56309},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3461":2295,"_30106":2242,"_20907":56311,"_5":14363,"_27392":56171,"_2946":56312},[],"From this view you also reach the most common actions:",{"_3461":2296,"_30106":2242,"_20907":56314,"_5":14363,"_27392":56171,"_2946":56315},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3461":2297,"_30106":2242,"_20907":56317,"_5":14363,"_27392":56171,"_2946":56318},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3461":2298,"_30106":2242,"_20907":56320,"_5":14363,"_27392":56171,"_2946":56321},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3461":2299,"_30106":2242,"_20907":56323,"_5":14363,"_27392":56171,"_2946":56324},[],"**Delete Key** to remove the key from the system.",{"_3461":2300,"_30106":2242,"_20907":56326,"_5":14363,"_27392":56175,"_2946":56327},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3461":2301,"_30106":2242,"_20907":56329,"_5":14363,"_27392":56179,"_2946":56330},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3461":2302,"_30106":2242,"_20907":56332,"_5":14363,"_27392":56179,"_2946":56333},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3461":2303,"_30106":2242,"_20907":56335,"_5":14363,"_27392":56179,"_2946":56336},[],"**Key Name**: unique and descriptive name.",{"_3461":2304,"_30106":2242,"_20907":56338,"_5":14363,"_27392":56179,"_2946":56339},[],"**Crypto Engine**: engine that will keep the key.",{"_3461":2305,"_30106":2242,"_20907":56341,"_5":14363,"_27392":56179,"_2946":56342},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3461":2306,"_30106":2242,"_20907":56344,"_5":14363,"_27392":56179,"_2946":56345},[],"**Tags**: metadata to classify the key.",{"_3461":2307,"_30106":2242,"_20907":56347,"_5":14363,"_27392":56179,"_2946":56348},[],"**Metadata**: additional information for advanced uses.",{"_3461":2308,"_30106":2242,"_20907":56350,"_5":14363,"_27392":56183,"_2946":56351},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3461":2309,"_30106":2242,"_20907":56353,"_5":14363,"_27392":56183,"_2946":56354},[],"When you have an exportable private key and the destination engine supports import.",{"_3461":2310,"_30106":2242,"_20907":56356,"_5":14363,"_27392":56183,"_2946":56357},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3461":2311,"_30106":2242,"_20907":56359,"_5":14363,"_27392":56183,"_2946":56360},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3461":2312,"_30106":2242,"_20907":56362,"_5":14363,"_27392":56183,"_2946":56363},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3461":2313,"_30106":2242,"_20907":56365,"_5":14363,"_27392":56183,"_2946":56366},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3461":2314,"_30106":2242,"_20907":56368,"_5":14363,"_27392":56183,"_2946":56369},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3461":2315,"_30106":2242,"_20907":56371,"_5":14363,"_27392":56183,"_2946":56372},[],"**Tags**: labels for organization and search.",{"_3461":2316,"_30106":2242,"_20907":56374,"_5":14363,"_27392":56183,"_2946":56375},[],"**Metadata**: additional optional information.",{"_3461":2317,"_30106":2242,"_20907":56377,"_5":14363,"_27392":56183,"_2946":56378},[],"**Private Key (PEM)**: private key in PEM format.",{"_3461":2318,"_30106":2242,"_20907":56380,"_5":14363,"_27392":56183,"_2946":56381},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3461":2319,"_30106":2242,"_20907":56383,"_5":14363,"_27392":56187,"_2946":56384},[],"Each registered key has a detail view and several operational actions.",{"_3461":2320,"_30106":2242,"_20907":56386,"_5":14363,"_27392":56191,"_2946":56387},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3461":2321,"_30106":2242,"_20907":56389,"_5":14363,"_27392":56191,"_2946":56390},[],"The **Overview** tab shows, among others, these fields:",{"_3461":2322,"_30106":2242,"_20907":56392,"_5":14363,"_27392":56191,"_2946":56393},[],"**Key Name**: descriptive name.",{"_3461":2323,"_30106":2242,"_20907":56395,"_5":14363,"_27392":56191,"_2946":56396},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3461":2324,"_30106":2242,"_20907":56398,"_5":14363,"_27392":56191,"_2946":56399},[],"**Tags**: associated labels.",{"_3461":2325,"_30106":2242,"_20907":56401,"_5":14363,"_27392":56191,"_2946":56402},[],"**Aliases**: alternative names.",{"_3461":2326,"_30106":2242,"_20907":56404,"_5":14363,"_27392":56191,"_2946":56405},[],"**Crypto Engine**: engine where the key resides.",{"_3461":2327,"_30106":2242,"_20907":56407,"_5":14363,"_27392":56191,"_2946":56408},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3461":2328,"_30106":2242,"_20907":56410,"_5":14363,"_27392":56191,"_2946":56411},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3461":2329,"_30106":2242,"_20907":56413,"_5":14363,"_27392":56191,"_2946":56414},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3461":2330,"_30106":2242,"_20907":56416,"_5":14363,"_27392":56195,"_2946":56417},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3461":2331,"_30106":2242,"_20907":56419,"_5":14363,"_27392":56195,"_2946":56420},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3461":2332,"_30106":2242,"_20907":56422,"_5":14363,"_27392":56195,"_2946":56423},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3461":2333,"_30106":2242,"_20907":56425,"_5":14363,"_27392":56199,"_2946":56426},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3461":2334,"_30106":2242,"_20907":56428,"_5":14363,"_27392":56199,"_2946":56429},[],"Main fields:",{"_3461":2335,"_30106":2242,"_20907":56431,"_5":14363,"_27392":56199,"_2946":56432},[],"**Algorithm**: signing algorithm available for the key type.",{"_3461":2336,"_30106":2242,"_20907":56434,"_5":14363,"_27392":56199,"_2946":56435},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3461":2337,"_30106":2242,"_20907":56437,"_5":14363,"_27392":56199,"_2946":56438},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3461":2338,"_30106":2242,"_20907":56440,"_5":14363,"_27392":56199,"_2946":56441},[],"**Message**: content to sign.",{"_3461":2339,"_30106":2242,"_20907":56443,"_5":14363,"_27392":56199,"_2946":56444},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3461":2340,"_30106":2242,"_20907":56446,"_5":14363,"_27392":56203,"_2946":56447},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3461":2341,"_30106":2242,"_20907":56449,"_5":14363,"_27392":56203,"_2946":56429},[],{"_3461":2342,"_30106":2242,"_20907":56451,"_5":14363,"_27392":56203,"_2946":56452},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3461":2343,"_30106":2242,"_20907":56454,"_5":14363,"_27392":56203,"_2946":56455},[],"**Message Type**: `Raw` or `Digest`.",{"_3461":2344,"_30106":2242,"_20907":56457,"_5":14363,"_27392":56203,"_2946":56458},[],"**Payload Encoding**: encoding of the message.",{"_3461":2345,"_30106":2242,"_20907":56460,"_5":14363,"_27392":56203,"_2946":56461},[],"**Message**: original message or hash.",{"_3461":2346,"_30106":2242,"_20907":56463,"_5":14363,"_27392":56203,"_2946":56464},[],"**Signature**: signature to check.",{"_3461":2347,"_30106":2242,"_20907":56466,"_5":14363,"_27392":56203,"_2946":56467},[],"**Result**: indicator of the validation result.",{"_3461":2348,"_30106":2242,"_20907":56469,"_5":14363,"_27392":56207,"_2946":56470},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3461":2349,"_30106":2242,"_20907":56472,"_5":14363,"_27392":56207,"_2946":56473},[],"This flow is useful for:",{"_3461":2350,"_30106":2242,"_20907":56475,"_5":14363,"_27392":56207,"_2946":56476},[],"Requesting certificates from an external CA.",{"_3461":2351,"_30106":2242,"_20907":56478,"_5":14363,"_27392":56207,"_2946":56479},[],"Renewing an identity while keeping the same key.",{"_3461":2352,"_30106":2242,"_20907":56481,"_5":14363,"_27392":56207,"_2946":56482},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3461":2353,"_30106":2242,"_20907":56484,"_5":14363,"_27392":56207,"_2946":56485},[],"**Common Name (CN)**: main name of the identity.",{"_3461":2354,"_30106":2242,"_20907":56487,"_5":14363,"_27392":56207,"_2946":56488},[],"**Organization (O)**: organization or company.",{"_3461":2355,"_30106":2242,"_20907":56490,"_5":14363,"_27392":56207,"_2946":56491},[],"**Organizational Unit (OU)**: department or unit.",{"_3461":2356,"_30106":2242,"_20907":56493,"_5":14363,"_27392":56207,"_2946":56494},[],"**Country (C)**: two-letter country code.",{"_3461":2357,"_30106":2242,"_20907":56496,"_5":14363,"_27392":56207,"_2946":56497},[],"**State / Province (ST)**: state or province.",{"_3461":2358,"_30106":2242,"_20907":56499,"_5":14363,"_27392":56207,"_2946":56500},[],"**Locality (L)**: city or locality.",{"_3461":2359,"_30106":2242,"_20907":56502,"_5":14363,"_27392":56207,"_2946":56503},[],"**Email Address**: contact email.",{"_3461":2360,"_30106":2242,"_20907":56505,"_5":14363,"_27392":56207,"_2946":56506},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3461":2361,"_30106":2242,"_20907":56508,"_5":14363,"_27392":56207,"_2946":56509},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3461":2362,"_30106":2242,"_20907":56511,"_5":14363,"_27392":56211,"_2946":56512},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3461":2363,"_30106":2242,"_20907":56514,"_5":14363,"_27392":56211,"_2946":56515},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3461":2364,"_30106":2242,"_20907":56517,"_5":14363,"_27392":56215,"_2946":56518},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3461":2365,"_30106":2242,"_20907":56520,"_5":14363,"_27392":56215,"_2946":56521},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3461":2366,"_30106":2366,"_5":14715,"_2946":56523,"_30459":56524,"_20907":56525,"_27392":2366},"Online validation with OCSP",[49157,50625,54630,55269],[],{"_3461":2367,"_30106":2366,"_20907":56527,"_5":14363,"_27392":2366,"_2946":56528},[],"Query signed status and verify the responder’s response.",{"_3461":2368,"_30106":2366,"_5":30456,"_20907":56530,"_27392":56531,"_2946":56532},[],"/docs/pr-preview/pr-60/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3461":2369,"_30106":2366,"_5":30456,"_20907":56534,"_27392":56535,"_2946":56536},[],"/docs/pr-preview/pr-60/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3461":2370,"_30106":2366,"_5":30456,"_20907":56538,"_27392":56539,"_2946":56540},[],"/docs/pr-preview/pr-60/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3461":2371,"_30106":2366,"_5":30456,"_20907":56542,"_27392":56543,"_2946":56544},[],"/docs/pr-preview/pr-60/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3461":2372,"_30106":2366,"_5":30456,"_20907":56546,"_27392":56547,"_2946":56548},[],"/docs/pr-preview/pr-60/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3461":2373,"_30106":2366,"_5":30456,"_20907":56550,"_27392":56551,"_2946":55838},[],"/docs/pr-preview/pr-60/platform/pki/ocsp#references",{"_3461":2374,"_30106":2366,"_20907":56553,"_5":14363,"_27392":2366,"_2946":56554},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3461":2375,"_30106":2366,"_20907":56556,"_5":14363,"_27392":56531,"_2946":56557},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3461":2376,"_30106":2366,"_20907":56559,"_5":14363,"_27392":56531,"_2946":56560},[],"Record status",{"_3461":2377,"_30106":2366,"_20907":56562,"_5":14363,"_27392":56531,"_2946":56563},[],"Signed response",{"_3461":2378,"_30106":2366,"_20907":56565,"_5":14363,"_27392":56531,"_2946":53767},[],{"_3461":2379,"_30106":2366,"_20907":56567,"_5":14363,"_27392":56531,"_2946":56568},[],"`Good`.",{"_3461":2380,"_30106":2366,"_20907":56570,"_5":14363,"_27392":56531,"_2946":53784},[],{"_3461":2381,"_30106":2366,"_20907":56572,"_5":14363,"_27392":56531,"_2946":56573},[],"`Revoked`, with revocation reason and timestamp.",{"_3461":2382,"_30106":2366,"_20907":56575,"_5":14363,"_27392":56531,"_2946":56576},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3461":2383,"_30106":2366,"_20907":56578,"_5":14363,"_27392":56531,"_2946":56579},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3461":2384,"_30106":2366,"_20907":56581,"_5":14363,"_27392":56531,"_2946":56582},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3461":2385,"_30106":2366,"_20907":56584,"_5":14363,"_27392":56531,"_2946":56585},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3461":2386,"_30106":2366,"_20907":56587,"_5":14363,"_27392":56531,"_2946":56588},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3461":2387,"_30106":2366,"_20907":56590,"_5":14363,"_27392":56535,"_2946":56591},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3461":2388,"_30106":2366,"_20907":56593,"_5":14363,"_27392":56535,"_2946":56594},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3461":2389,"_30106":2366,"_20907":56596,"_5":14363,"_27392":56539,"_2946":56597},[],"The service accepts:",{"_3461":2390,"_30106":2366,"_20907":56599,"_5":14363,"_27392":56539,"_2946":52395},[],{"_3461":2391,"_30106":2366,"_20907":56601,"_5":14363,"_27392":56539,"_2946":56602},[],"VA service path",{"_3461":2392,"_30106":2366,"_20907":56604,"_5":14363,"_27392":56539,"_2946":56605},[],"Format",{"_3461":2393,"_30106":2366,"_20907":56607,"_5":14363,"_27392":56539,"_2946":56608},[],"`POST`",{"_3461":2394,"_30106":2366,"_20907":56610,"_5":14363,"_27392":56539,"_2946":56611},[],"`/ocsp`",{"_3461":2395,"_30106":2366,"_20907":56613,"_5":14363,"_27392":56539,"_2946":56614},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3461":2396,"_30106":2366,"_20907":56616,"_5":14363,"_27392":56539,"_2946":56020},[],{"_3461":2397,"_30106":2366,"_20907":56618,"_5":14363,"_27392":56539,"_2946":56619},[],"`/ocsp/{ocsp_request}`",{"_3461":2398,"_30106":2366,"_20907":56621,"_5":14363,"_27392":56539,"_2946":56622},[],"DER request encoded using padded URL Base64.",{"_3461":2399,"_30106":2366,"_20907":56624,"_5":14363,"_27392":56539,"_2946":56625},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3461":2400,"_30106":2366,"_20907":56627,"_5":14363,"_27392":56543,"_2946":56628},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3461":2401,"_30106":2366,"_20907":56630,"_5":14363,"_27392":56543,"_2946":56631},[],"Generate the request:",{"_3461":2402,"_30106":2366,"_20907":56633,"_5":14363,"_27392":56543,"_2946":56634},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3461":2403,"_30106":2366,"_20907":56636,"_5":14363,"_27392":56543,"_2946":56637},[],"Replace the example URL with the inspected endpoint:",{"_3461":2404,"_30106":2366,"_20907":56639,"_5":14363,"_27392":56543,"_2946":56640},[],"Verify the returned DER:",{"_3461":2405,"_30106":2366,"_20907":56642,"_5":14363,"_27392":56543,"_2946":56643},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3461":2406,"_30106":2366,"_20907":56645,"_5":14363,"_27392":56547,"_2946":56646},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3461":2407,"_30106":2366,"_20907":56648,"_5":14363,"_27392":56547,"_2946":56649},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3461":2408,"_30106":2366,"_20907":56651,"_5":14363,"_27392":56551,"_2946":56652},[],"RFC 6960: OCSP.",{"_3461":2409,"_30106":2366,"_20907":56654,"_5":14363,"_27392":56551,"_2946":56655},[],"OpenSSL: openssl-ocsp.",{"_3461":2410,"_30106":2366,"_20907":56657,"_5":14363,"_27392":56551,"_2946":56658},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3461":2411,"_30106":2366,"_20907":56660,"_5":14363,"_27392":56551,"_2946":56129},[],{"_3461":2412,"_30106":2412,"_5":14715,"_2946":54630,"_30459":56662,"_20907":56663,"_27392":2412},[49157,50625,54630],[],{"_3461":2413,"_30106":2412,"_20907":56665,"_5":14363,"_27392":2412,"_2946":56666},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3461":2414,"_30106":2412,"_5":30456,"_20907":56668,"_27392":56669,"_2946":53942},[],"/docs/pr-preview/pr-60/platform/pki/overview#start-here",{"_3461":2415,"_30106":2412,"_5":30456,"_20907":56671,"_27392":56672,"_2946":56673},[],"/docs/pr-preview/pr-60/platform/pki/overview#what-you-need","What you need",{"_3461":2416,"_30106":2412,"_5":30456,"_20907":56675,"_27392":56676,"_2946":54474},[],"/docs/pr-preview/pr-60/platform/pki/overview#core-capabilities",{"_3461":2417,"_30106":2412,"_5":30456,"_20907":56678,"_27392":56679,"_2946":54478},[],"/docs/pr-preview/pr-60/platform/pki/overview#build-your-trust-hierarchy",{"_3461":2418,"_30106":2412,"_5":30456,"_20907":56681,"_27392":56682,"_2946":54482},[],"/docs/pr-preview/pr-60/platform/pki/overview#protect-cryptographic-keys",{"_3461":2419,"_30106":2412,"_5":30456,"_20907":56684,"_27392":56685,"_2946":54486},[],"/docs/pr-preview/pr-60/platform/pki/overview#issue-and-control-certificates",{"_3461":2420,"_30106":2412,"_5":30456,"_20907":56687,"_27392":56688,"_2946":54494},[],"/docs/pr-preview/pr-60/platform/pki/overview#publish-validation-status",{"_3461":2421,"_30106":2412,"_5":30456,"_20907":56690,"_27392":56691,"_2946":56692},[],"/docs/pr-preview/pr-60/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3461":2422,"_30106":2412,"_5":30456,"_20907":56694,"_27392":56695,"_2946":55436},[],"/docs/pr-preview/pr-60/platform/pki/overview#continue",{"_3461":2423,"_30106":2412,"_20907":56697,"_5":14363,"_27392":2412,"_2946":56698},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3461":2424,"_30106":2412,"_20907":56700,"_5":14363,"_27392":56669,"_2946":56701},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3461":2425,"_30106":2412,"_20907":56703,"_5":14363,"_27392":56669,"_2946":56704},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3461":2426,"_30106":2412,"_20907":56706,"_5":14363,"_27392":56672,"_2946":56707},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3461":2427,"_30106":2412,"_20907":56709,"_5":14363,"_27392":56672,"_2946":56710},[],"An available cryptographic engine to keep the authority's key.",{"_3461":2428,"_30106":2412,"_20907":56712,"_5":14363,"_27392":56672,"_2946":56713},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3461":2429,"_30106":2412,"_20907":56715,"_5":14363,"_27392":56672,"_2946":56716},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3461":2430,"_30106":2412,"_20907":56718,"_5":14363,"_27392":56672,"_2946":56719},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3461":2431,"_30106":2412,"_20907":56721,"_5":14363,"_27392":56679,"_2946":56722},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3461":2432,"_30106":2412,"_20907":56724,"_5":14363,"_27392":56682,"_2946":56725},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3461":2433,"_30106":2412,"_20907":56727,"_5":14363,"_27392":56685,"_2946":56728},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3461":2434,"_30106":2412,"_20907":56730,"_5":14363,"_27392":56688,"_2946":56731},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3461":2435,"_30106":2412,"_20907":56733,"_5":14363,"_27392":56691,"_2946":56734},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3461":2436,"_30106":2412,"_20907":56736,"_5":14363,"_27392":56691,"_2946":56737},[],"its subject and extensions identify the expected client;",{"_3461":2437,"_30106":2412,"_20907":56739,"_5":14363,"_27392":56691,"_2946":56740},[],"its public key matches the client's private key;",{"_3461":2438,"_30106":2412,"_20907":56742,"_5":14363,"_27392":56691,"_2946":56743},[],"its chain reaches a root trusted by the consumer;",{"_3461":2439,"_30106":2412,"_20907":56745,"_5":14363,"_27392":56691,"_2946":56746},[],"its dates and usages allow the operation;",{"_3461":2440,"_30106":2412,"_20907":56748,"_5":14363,"_27392":56691,"_2946":56749},[],"the consumer applies revocation checks and authorization.",{"_3461":2441,"_30106":2412,"_20907":56751,"_5":14363,"_27392":56691,"_2946":56752},[],"The issuance path includes the first independent checks.",{"_3461":2442,"_30106":2412,"_20907":56754,"_5":14363,"_27392":56695,"_2946":56755},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3461":2443,"_30106":2412,"_20907":56757,"_5":14363,"_27392":56695,"_2946":56758},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3461":2444,"_30106":2412,"_20907":56760,"_5":14363,"_27392":56695,"_2946":56761},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3461":2445,"_30106":2445,"_5":14715,"_2946":56763,"_30459":56764,"_20907":56765,"_27392":2445},"Create your first CA",[49157,50625,54630,54067],[],{"_3461":2446,"_30106":2445,"_20907":56767,"_5":14363,"_27392":2445,"_2946":56768},[],"Create an evaluation root and check its certificate before issuing.",{"_3461":2447,"_30106":2445,"_5":30456,"_20907":56770,"_27392":56771,"_2946":49167},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3461":2448,"_30106":2445,"_5":30456,"_20907":56773,"_27392":56774,"_2946":56775},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3461":2449,"_30106":2445,"_5":30456,"_20907":56777,"_27392":56778,"_2946":56779},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3461":2450,"_30106":2445,"_5":30456,"_20907":56781,"_27392":56782,"_2946":56783},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3461":2451,"_30106":2445,"_5":30456,"_20907":56785,"_27392":56786,"_2946":56787},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3461":2452,"_30106":2445,"_5":30456,"_20907":56789,"_27392":56790,"_2946":56791},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3461":2453,"_30106":2445,"_5":30456,"_20907":56793,"_27392":56794,"_2946":56795},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3461":2454,"_30106":2445,"_5":30456,"_20907":56797,"_27392":56798,"_2946":54324},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3461":2455,"_30106":2445,"_5":30456,"_20907":56800,"_27392":56801,"_2946":49191},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3461":2456,"_30106":2445,"_20907":56803,"_5":14363,"_27392":2445,"_2946":56804},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3461":2457,"_30106":2445,"_20907":56806,"_5":14363,"_27392":56771,"_2946":56807},[],"Console access and permission to create keys and authorities.",{"_3461":2458,"_30106":2445,"_20907":56809,"_5":14363,"_27392":56771,"_2946":56810},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3461":2459,"_30106":2445,"_20907":56812,"_5":14363,"_27392":56771,"_2946":56813},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3461":2460,"_30106":2445,"_20907":56815,"_5":14363,"_27392":56771,"_2946":56816},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3461":2461,"_30106":2445,"_20907":56818,"_5":14363,"_27392":56774,"_2946":56819},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3461":2462,"_30106":2445,"_20907":56821,"_5":14363,"_27392":56774,"_2946":56822},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3461":2463,"_30106":2445,"_20907":56824,"_5":14363,"_27392":56778,"_2946":56825},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3461":2464,"_30106":2445,"_20907":56827,"_5":14363,"_27392":56778,"_2946":56828},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3461":2465,"_30106":2445,"_20907":56830,"_5":14363,"_27392":56782,"_2946":56831},[],"Select **Root CA** and complete:",{"_3461":2466,"_30106":2445,"_20907":56833,"_5":14363,"_27392":56782,"_2946":56834},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3461":2467,"_30106":2445,"_20907":56836,"_5":14363,"_27392":56782,"_2946":56837},[],"**Subject**: organization and country details for your evaluation.",{"_3461":2468,"_30106":2445,"_20907":56839,"_5":14363,"_27392":56782,"_2946":56840},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3461":2469,"_30106":2445,"_20907":56842,"_5":14363,"_27392":56782,"_2946":56843},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3461":2470,"_30106":2445,"_20907":56845,"_5":14363,"_27392":56782,"_2946":56846},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3461":2471,"_30106":2445,"_20907":56848,"_5":14363,"_27392":56786,"_2946":56849},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3461":2472,"_30106":2445,"_20907":56851,"_5":14363,"_27392":56790,"_2946":56852},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3461":2473,"_30106":2445,"_20907":56854,"_5":14363,"_27392":56790,"_2946":56855},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3461":2474,"_30106":2445,"_20907":56857,"_5":14363,"_27392":56794,"_2946":56858},[],"Run from the directory where you saved `ca.pem`:",{"_3461":2475,"_30106":2445,"_20907":56860,"_5":14363,"_27392":56794,"_2946":56861},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3461":2476,"_30106":2445,"_20907":56863,"_5":14363,"_27392":56794,"_2946":56864},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3461":2477,"_30106":2445,"_20907":56866,"_5":14363,"_27392":56798,"_2946":56867},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3461":2478,"_30106":2445,"_20907":56869,"_5":14363,"_27392":56798,"_2946":56870},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3461":2479,"_30106":2445,"_20907":56872,"_5":14363,"_27392":56798,"_2946":56873},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3461":2480,"_30106":2445,"_20907":56875,"_5":14363,"_27392":56798,"_2946":56876},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3461":2481,"_30106":2445,"_20907":56878,"_5":14363,"_27392":56801,"_2946":56879},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3461":2482,"_30106":2482,"_5":14715,"_2946":56881,"_30459":56882,"_20907":56883,"_27392":2482},"Issue and verify a certificate",[49157,50625,54630,54067],[],{"_3461":2483,"_30106":2482,"_20907":56885,"_5":14363,"_27392":2482,"_2946":56886},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3461":2484,"_30106":2482,"_5":30456,"_20907":56888,"_27392":56889,"_2946":49167},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3461":2485,"_30106":2482,"_5":30456,"_20907":56891,"_27392":56892,"_2946":56893},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3461":2486,"_30106":2482,"_5":30456,"_20907":56895,"_27392":56896,"_2946":56897},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3461":2487,"_30106":2482,"_5":30456,"_20907":56899,"_27392":56900,"_2946":56901},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3461":2488,"_30106":2482,"_5":30456,"_20907":56903,"_27392":56904,"_2946":56905},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3461":2489,"_30106":2482,"_5":30456,"_20907":56907,"_27392":56908,"_2946":56909},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3461":2490,"_30106":2482,"_5":30456,"_20907":56911,"_27392":56912,"_2946":56913},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3461":2491,"_30106":2482,"_5":30456,"_20907":56915,"_27392":56916,"_2946":56917},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3461":2492,"_30106":2482,"_5":30456,"_20907":56919,"_27392":56920,"_2946":56921},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3461":2493,"_30106":2482,"_5":30456,"_20907":56923,"_27392":56924,"_2946":56925},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3461":2494,"_30106":2482,"_5":30456,"_20907":56927,"_27392":56928,"_2946":54324},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3461":2495,"_30106":2482,"_5":30456,"_20907":56930,"_27392":56931,"_2946":49191},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/issue-certificate#next-step",{"_3461":2496,"_30106":2482,"_20907":56933,"_5":14363,"_27392":2482,"_2946":56934},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3461":2497,"_30106":2482,"_20907":56936,"_5":14363,"_27392":56889,"_2946":56937},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3461":2498,"_30106":2482,"_20907":56939,"_5":14363,"_27392":56889,"_2946":56940},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3461":2499,"_30106":2482,"_20907":56942,"_5":14363,"_27392":56889,"_2946":56943},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3461":2500,"_30106":2482,"_20907":56945,"_5":14363,"_27392":56889,"_2946":56946},[],"A client identifier: here we use `device-001`.",{"_3461":2501,"_30106":2482,"_20907":56948,"_5":14363,"_27392":56889,"_2946":56949},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3461":2502,"_30106":2482,"_20907":56951,"_5":14363,"_27392":56892,"_2946":56952},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3461":2503,"_30106":2482,"_20907":56954,"_5":14363,"_27392":56896,"_2946":56955},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3461":2504,"_30106":2482,"_20907":56957,"_5":14363,"_27392":56896,"_2946":56958},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3461":2505,"_30106":2482,"_20907":56960,"_5":14363,"_27392":56900,"_2946":56961},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3461":2506,"_30106":2482,"_20907":56963,"_5":14363,"_27392":56900,"_2946":56964},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3461":2507,"_30106":2482,"_20907":56966,"_5":14363,"_27392":56904,"_2946":56967},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3461":2508,"_30106":2482,"_20907":56969,"_5":14363,"_27392":56904,"_2946":56970},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3461":2509,"_30106":2482,"_20907":56972,"_5":14363,"_27392":56908,"_2946":56973},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3461":2510,"_30106":2482,"_20907":56975,"_5":14363,"_27392":56912,"_2946":56976},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3461":2511,"_30106":2482,"_20907":56978,"_5":14363,"_27392":56916,"_2946":56979},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3461":2512,"_30106":2482,"_20907":56981,"_5":14363,"_27392":56920,"_2946":56982},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3461":2513,"_30106":2482,"_20907":56984,"_5":14363,"_27392":56920,"_2946":56985},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3461":2514,"_30106":2482,"_20907":56987,"_5":14363,"_27392":56920,"_2946":56988},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3461":2515,"_30106":2482,"_20907":56990,"_5":14363,"_27392":56924,"_2946":56991},[],"In Bash, compare the two public-key digests:",{"_3461":2516,"_30106":2482,"_20907":56993,"_5":14363,"_27392":56924,"_2946":56994},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3461":2517,"_30106":2482,"_20907":56996,"_5":14363,"_27392":56924,"_2946":56997},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3461":2518,"_30106":2482,"_20907":56999,"_5":14363,"_27392":56928,"_2946":54408},[],{"_3461":2519,"_30106":2482,"_20907":57001,"_5":14363,"_27392":56928,"_2946":57002},[],"What to review",{"_3461":2520,"_30106":2482,"_20907":57004,"_5":14363,"_27392":56928,"_2946":57005},[],"The CA rejects issuance",{"_3461":2521,"_30106":2482,"_20907":57007,"_5":14363,"_27392":56928,"_2946":57008},[],"Permissions, CA state and key, algorithm and profile.",{"_3461":2522,"_30106":2482,"_20907":57010,"_5":14363,"_27392":56928,"_2946":57011},[],"Different subject or usages",{"_3461":2523,"_30106":2482,"_20907":57013,"_5":14363,"_27392":56928,"_2946":57014},[],"Applied profile and requested values.",{"_3461":2524,"_30106":2482,"_20907":57016,"_5":14363,"_27392":56928,"_2946":57017},[],"Issuer cannot be found",{"_3461":2525,"_30106":2482,"_20907":57019,"_5":14363,"_27392":56928,"_2946":57020},[],"Downloaded CA and required intermediate chain.",{"_3461":2526,"_30106":2482,"_20907":57022,"_5":14363,"_27392":56928,"_2946":57023},[],"Validity fails",{"_3461":2527,"_30106":2482,"_20907":57025,"_5":14363,"_27392":56928,"_2946":57026},[],"Certificate and CA dates, and the computer's clock.",{"_3461":2528,"_30106":2482,"_20907":57028,"_5":14363,"_27392":56928,"_2946":57029},[],"Public-key digests differ",{"_3461":2529,"_30106":2482,"_20907":57031,"_5":14363,"_27392":56928,"_2946":57032},[],"Certificate and key files from the same issuance.",{"_3461":2530,"_30106":2482,"_20907":57034,"_5":14363,"_27392":56928,"_2946":57035},[],"See PKI diagnostics to narrow an issuance failure.",{"_3461":2531,"_30106":2482,"_20907":57037,"_5":14363,"_27392":56931,"_2946":57038},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3461":2532,"_30106":2482,"_20907":57040,"_5":14363,"_27392":56931,"_2946":57041},[],"Manage certificates for inspection, status and revocation.",{"_3461":2533,"_30106":2482,"_20907":57043,"_5":14363,"_27392":56931,"_2946":57044},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3461":2534,"_30106":2482,"_20907":57046,"_5":14363,"_27392":56931,"_2946":57047},[],"Prepare EST for the device to request its next identities.",{"_3461":2535,"_30106":2482,"_20907":57049,"_5":14363,"_27392":56931,"_2946":57050},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3461":2536,"_30106":2536,"_5":14715,"_2946":57052,"_30459":57053,"_20907":57054,"_27392":2536},"PKI getting started",[49157,50625,54630,54067],[],{"_3461":2537,"_30106":2536,"_20907":57056,"_5":14363,"_27392":2536,"_2946":57057},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3461":2538,"_30106":2536,"_5":30456,"_20907":57059,"_27392":57060,"_2946":49167},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/overview#before-you-begin",{"_3461":2539,"_30106":2536,"_5":30456,"_20907":57062,"_27392":57063,"_2946":57064},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3461":2540,"_30106":2536,"_5":30456,"_20907":57066,"_27392":57067,"_2946":54259},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/overview#expected-result",{"_3461":2541,"_30106":2536,"_5":30456,"_20907":57069,"_27392":57070,"_2946":57071},[],"/docs/pr-preview/pr-60/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3461":2542,"_30106":2536,"_20907":57073,"_5":14363,"_27392":2536,"_2946":57074},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3461":2543,"_30106":2536,"_20907":57076,"_5":14363,"_27392":57060,"_2946":57077},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3461":2544,"_30106":2536,"_20907":57079,"_5":14363,"_27392":57060,"_2946":57080},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3461":2545,"_30106":2536,"_20907":57082,"_5":14363,"_27392":57060,"_2946":57083},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3461":2546,"_30106":2536,"_20907":57085,"_5":14363,"_27392":57060,"_2946":57086},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3461":2547,"_30106":2536,"_20907":57088,"_5":14363,"_27392":57060,"_2946":57089},[],"A working directory with restricted access for the downloaded key.",{"_3461":2548,"_30106":2536,"_20907":57091,"_5":14363,"_27392":57063,"_2946":57092},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3461":2549,"_30106":2536,"_20907":57094,"_5":14363,"_27392":57063,"_2946":57095},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3461":2550,"_30106":2536,"_20907":57097,"_5":14363,"_27392":57063,"_2946":57098},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3461":2551,"_30106":2536,"_20907":57100,"_5":14363,"_27392":57063,"_2946":57101},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3461":2552,"_30106":2536,"_20907":57103,"_5":14363,"_27392":57067,"_2946":57104},[],"File or resource",{"_3461":2553,"_30106":2536,"_20907":57106,"_5":14363,"_27392":57067,"_2946":54256},[],{"_3461":2554,"_30106":2536,"_20907":57108,"_5":14363,"_27392":57067,"_2946":57109},[],"Active root CA and `ca.pem`",{"_3461":2555,"_30106":2536,"_20907":57111,"_5":14363,"_27392":57067,"_2946":57112},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3461":2556,"_30106":2536,"_20907":57114,"_5":14363,"_27392":57067,"_2946":57115},[],"End-entity certificate and `device.crt`",{"_3461":2557,"_30106":2536,"_20907":57117,"_5":14363,"_27392":57067,"_2946":57118},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3461":2558,"_30106":2536,"_20907":57120,"_5":14363,"_27392":57067,"_2946":57121},[],"Private key `device.key`",{"_3461":2559,"_30106":2536,"_20907":57123,"_5":14363,"_27392":57067,"_2946":57124},[],"Its public key matches the one included in `device.crt`.",{"_3461":2560,"_30106":2536,"_20907":57126,"_5":14363,"_27392":57067,"_2946":57127},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3461":2561,"_30106":2536,"_20907":57129,"_5":14363,"_27392":57070,"_2946":57130},[],"To operate certificates, continue with Certificates and Validation.",{"_3461":2562,"_30106":2536,"_20907":57132,"_5":14363,"_27392":57070,"_2946":57133},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3461":2563,"_30106":2536,"_20907":57135,"_5":14363,"_27392":57070,"_2946":57136},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3461":2564,"_30106":2564,"_5":14715,"_2946":57138,"_30459":57139,"_20907":57140,"_27392":2564},"PKI troubleshooting",[49157,50625,54630,53205],[],{"_3461":2565,"_30106":2564,"_20907":57142,"_5":14363,"_27392":2564,"_2946":57143},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3461":2566,"_30106":2564,"_5":30456,"_20907":57145,"_27392":57146,"_2946":57147},[],"/docs/pr-preview/pr-60/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3461":2567,"_30106":2564,"_5":30456,"_20907":57149,"_27392":57150,"_2946":57151},[],"/docs/pr-preview/pr-60/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3461":2568,"_30106":2564,"_5":30456,"_20907":57153,"_27392":57154,"_2946":57155},[],"/docs/pr-preview/pr-60/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3461":2569,"_30106":2564,"_20907":57157,"_5":14363,"_27392":2564,"_2946":57158},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3461":2570,"_30106":2564,"_20907":57160,"_5":14363,"_27392":2564,"_2946":57161},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3461":2571,"_30106":2564,"_20907":57163,"_5":14363,"_27392":57146,"_2946":54256},[],{"_3461":2572,"_30106":2564,"_20907":57165,"_5":14363,"_27392":57146,"_2946":57166},[],"What to inspect",{"_3461":2573,"_30106":2564,"_20907":57168,"_5":14363,"_27392":57146,"_2946":49191},[],{"_3461":2574,"_30106":2564,"_20907":57170,"_5":14363,"_27392":57146,"_2946":53472},[],{"_3461":2575,"_30106":2564,"_20907":57172,"_5":14363,"_27392":57146,"_2946":57173},[],"Exists, is active and has usable dates.",{"_3461":2576,"_30106":2564,"_20907":57175,"_5":14363,"_27392":57146,"_2946":57176},[],"Authorities.",{"_3461":2577,"_30106":2564,"_20907":57178,"_5":14363,"_27392":57146,"_2946":57179},[],"Key",{"_3461":2578,"_30106":2564,"_20907":57181,"_5":14363,"_27392":57146,"_2946":57182},[],"The record has a usable private key and the engine can sign.",{"_3461":2579,"_30106":2564,"_20907":57184,"_5":14363,"_27392":57146,"_2946":57185},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3461":2580,"_30106":2564,"_20907":57187,"_5":14363,"_27392":57146,"_2946":57188},[],"CSR",{"_3461":2581,"_30106":2564,"_20907":57190,"_5":14363,"_27392":57146,"_2946":57191},[],"Correct PEM and verifiable signature.",{"_3461":2582,"_30106":2564,"_20907":57193,"_5":14363,"_27392":57146,"_2946":57194},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3461":2583,"_30106":2564,"_20907":57196,"_5":14363,"_27392":57146,"_2946":57197},[],"Profile",{"_3461":2584,"_30106":2564,"_20907":57199,"_5":14363,"_27392":57146,"_2946":57200},[],"Selected source, existing ID, allowed algorithm and size.",{"_3461":2585,"_30106":2564,"_20907":57202,"_5":14363,"_27392":57146,"_2946":57203},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3461":2586,"_30106":2564,"_20907":57205,"_5":14363,"_27392":57146,"_2946":54408},[],{"_3461":2587,"_30106":2564,"_20907":57207,"_5":14363,"_27392":57146,"_2946":57208},[],"Appropriate subject, SAN, usages and dates.",{"_3461":2588,"_30106":2564,"_20907":57210,"_5":14363,"_27392":57146,"_2946":57211},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3461":2589,"_30106":2564,"_20907":57213,"_5":14363,"_27392":57146,"_2946":57214},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3461":2590,"_30106":2564,"_20907":57216,"_5":14363,"_27392":57146,"_2946":57217},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3461":2591,"_30106":2564,"_20907":57219,"_5":14363,"_27392":57150,"_2946":57220},[],"Check each boundary independently:",{"_3461":2592,"_30106":2564,"_20907":57222,"_5":14363,"_27392":57150,"_2946":57223},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3461":2593,"_30106":2564,"_20907":57225,"_5":14363,"_27392":57150,"_2946":57226},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3461":2594,"_30106":2564,"_20907":57228,"_5":14363,"_27392":57150,"_2946":57229},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3461":2595,"_30106":2564,"_20907":57231,"_5":14363,"_27392":57150,"_2946":57232},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3461":2596,"_30106":2564,"_20907":57234,"_5":14363,"_27392":57150,"_2946":57235},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3461":2597,"_30106":2564,"_20907":57237,"_5":14363,"_27392":57150,"_2946":57238},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3461":2598,"_30106":2564,"_20907":57240,"_5":14363,"_27392":57154,"_2946":57241},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3461":2599,"_30106":2564,"_20907":57243,"_5":14363,"_27392":57154,"_2946":57244},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3461":2600,"_30106":2600,"_5":14715,"_2946":57246,"_30459":57247,"_20907":57248,"_27392":2600},"Security",[49157],[],{"_3461":2601,"_30106":2600,"_20907":57250,"_5":14363,"_27392":2600,"_2946":57251},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3461":2602,"_30106":2600,"_5":30456,"_20907":57253,"_27392":57254,"_2946":57255},[],"/docs/pr-preview/pr-60/security#report-a-vulnerability","Report a vulnerability",{"_3461":2603,"_30106":2600,"_5":30456,"_20907":57257,"_27392":57258,"_2946":57259},[],"/docs/pr-preview/pr-60/security#what-to-include-in-a-report","What to include in a report",{"_3461":2604,"_30106":2600,"_5":30456,"_20907":57261,"_27392":57262,"_2946":57263},[],"/docs/pr-preview/pr-60/security#supported-versions","Supported versions",{"_3461":2605,"_30106":2600,"_5":30456,"_20907":57265,"_27392":57266,"_2946":57267},[],"/docs/pr-preview/pr-60/security#responsible-disclosure","Responsible disclosure",{"_3461":2606,"_30106":2600,"_20907":57269,"_5":14363,"_27392":2600,"_2946":57270},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3461":2607,"_30106":2600,"_20907":57272,"_5":14363,"_27392":57254,"_2946":57273},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3461":2608,"_30106":2600,"_20907":57275,"_5":14363,"_27392":57254,"_2946":57276},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3461":2609,"_30106":2600,"_20907":57278,"_5":14363,"_27392":57254,"_2946":14988},[],{"_3461":2610,"_30106":2600,"_20907":57280,"_5":14363,"_27392":57254,"_2946":14928},[],{"_3461":2611,"_30106":2600,"_20907":57282,"_5":14363,"_27392":57254,"_2946":14975},[],{"_3461":2612,"_30106":2600,"_20907":57284,"_5":14363,"_27392":57254,"_2946":57285},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3461":2613,"_30106":2600,"_20907":57287,"_5":14363,"_27392":57254,"_2946":57288},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3461":2614,"_30106":2600,"_20907":57290,"_5":14363,"_27392":57258,"_2946":57291},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3461":2615,"_30106":2600,"_20907":57293,"_5":14363,"_27392":57258,"_2946":57294},[],"Do not include in the report:",{"_3461":2616,"_30106":2600,"_20907":57296,"_5":14363,"_27392":57258,"_2946":57297},[],"Credentials, tokens, or private keys",{"_3461":2617,"_30106":2600,"_20907":57299,"_5":14363,"_27392":57258,"_2946":57300},[],"Customer data or customer-identifiable information",{"_3461":2618,"_30106":2600,"_20907":57302,"_5":14363,"_27392":57258,"_2946":57303},[],"Confidential architecture or internal infrastructure details",{"_3461":2619,"_30106":2600,"_20907":57305,"_5":14363,"_27392":57262,"_2946":57306},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3461":2620,"_30106":2600,"_20907":57308,"_5":14363,"_27392":57262,"_2946":57309},[],"For upgrade guidance, see Upgrades.",{"_3461":2621,"_30106":2600,"_20907":57311,"_5":14363,"_27392":57266,"_2946":57312},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3461":2622,"_30106":2600,"_20907":57314,"_5":14363,"_27392":57266,"_2946":57315},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3461":2623,"_30106":2600,"_20907":57317,"_5":14363,"_27392":57266,"_2946":57318},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3461":2624,"_30106":2600,"_20907":57320,"_5":14363,"_27392":57266,"_2946":57321},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3461":2625,"_30106":2600,"_20907":57323,"_5":14363,"_27392":57266,"_2946":57324},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3461":2626,"_30106":2626,"_5":14715,"_2946":57326,"_30459":57327,"_20907":57329,"_27392":2626},"3.8.0 to 4.0.0",[49157,57328],"Upgrades",[],{"_3461":2627,"_30106":2626,"_20907":57331,"_5":14363,"_27392":2626,"_2946":57332},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3461":2628,"_30106":2626,"_5":30456,"_20907":57334,"_27392":57335,"_2946":57336},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3461":2629,"_30106":2626,"_5":30456,"_20907":57338,"_27392":57339,"_2946":57340},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3461":2630,"_30106":2626,"_5":30456,"_20907":57342,"_27392":57343,"_2946":57344},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3461":2631,"_30106":2626,"_5":30456,"_20907":57346,"_27392":57347,"_2946":57348},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3461":2632,"_30106":2626,"_5":30456,"_20907":57350,"_27392":57351,"_2946":57352},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3461":2633,"_30106":2626,"_5":30456,"_20907":57354,"_27392":57355,"_2946":57356},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3461":2634,"_30106":2626,"_5":30456,"_20907":57358,"_27392":57359,"_2946":57360},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3461":2635,"_30106":2626,"_5":30456,"_20907":57362,"_27392":57363,"_2946":57364},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3461":2636,"_30106":2626,"_5":30456,"_20907":57366,"_27392":57367,"_2946":57368},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3461":2637,"_30106":2626,"_5":30456,"_20907":57370,"_27392":57371,"_2946":57372},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3461":2638,"_30106":2626,"_5":30456,"_20907":57374,"_27392":57375,"_2946":57376},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3461":2639,"_30106":2626,"_5":30456,"_20907":57378,"_27392":57379,"_2946":57380},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3461":2640,"_30106":2626,"_5":30456,"_20907":57382,"_27392":57383,"_2946":57384},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3461":2641,"_30106":2626,"_5":30456,"_20907":57386,"_27392":57387,"_2946":57388},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3461":2642,"_30106":2626,"_5":30456,"_20907":57390,"_27392":57391,"_2946":57392},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3461":2643,"_30106":2626,"_5":30456,"_20907":57394,"_27392":57395,"_2946":57396},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3461":2644,"_30106":2626,"_5":30456,"_20907":57398,"_27392":57399,"_2946":57400},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3461":2645,"_30106":2626,"_5":30456,"_20907":57402,"_27392":57403,"_2946":57404},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3461":2646,"_30106":2626,"_5":30456,"_20907":57406,"_27392":57407,"_2946":57408},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3461":2647,"_30106":2626,"_5":30456,"_20907":57410,"_27392":57411,"_2946":57412},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3461":2648,"_30106":2626,"_5":30456,"_20907":57414,"_27392":57415,"_2946":57416},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3461":2649,"_30106":2626,"_5":30456,"_20907":57418,"_27392":57419,"_2946":57420},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3461":2650,"_30106":2626,"_5":30456,"_20907":57422,"_27392":57423,"_2946":57424},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3461":2651,"_30106":2626,"_5":30456,"_20907":57426,"_27392":57427,"_2946":57428},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3461":2652,"_30106":2626,"_5":30456,"_20907":57430,"_27392":57431,"_2946":57432},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3461":2653,"_30106":2626,"_5":30456,"_20907":57434,"_27392":57435,"_2946":57436},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3461":2654,"_30106":2626,"_5":30456,"_20907":57438,"_27392":57439,"_2946":57440},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3461":2655,"_30106":2626,"_5":30456,"_20907":57442,"_27392":57443,"_2946":57444},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3461":2656,"_30106":2626,"_5":30456,"_20907":57446,"_27392":57447,"_2946":57448},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3461":2657,"_30106":2626,"_5":30456,"_20907":57450,"_27392":57451,"_2946":57452},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3461":2658,"_30106":2626,"_5":30456,"_20907":57454,"_27392":57455,"_2946":57456},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3461":2659,"_30106":2626,"_5":30456,"_20907":57458,"_27392":57459,"_2946":57460},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3461":2660,"_30106":2626,"_5":30456,"_20907":57462,"_27392":57463,"_2946":57464},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3461":2661,"_30106":2626,"_5":30456,"_20907":57466,"_27392":57467,"_2946":57468},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3461":2662,"_30106":2626,"_5":30456,"_20907":57470,"_27392":57471,"_2946":57472},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3461":2663,"_30106":2626,"_5":30456,"_20907":57474,"_27392":57475,"_2946":57476},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3461":2664,"_30106":2626,"_5":30456,"_20907":57478,"_27392":57479,"_2946":57480},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3461":2665,"_30106":2626,"_5":30456,"_20907":57482,"_27392":57483,"_2946":57484},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3461":2666,"_30106":2626,"_5":30456,"_20907":57486,"_27392":57487,"_2946":57488},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3461":2667,"_30106":2626,"_5":30456,"_20907":57490,"_27392":57491,"_2946":57492},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3461":2668,"_30106":2626,"_5":30456,"_20907":57494,"_27392":57495,"_2946":53205},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3461":2669,"_30106":2626,"_5":30456,"_20907":57497,"_27392":57498,"_2946":57499},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3461":2670,"_30106":2626,"_5":30456,"_20907":57501,"_27392":57502,"_2946":57503},[],"/docs/pr-preview/pr-60/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3461":2671,"_30106":2626,"_20907":57505,"_5":14363,"_27392":2626,"_2946":57506},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3461":2672,"_30106":2626,"_20907":57508,"_5":14363,"_27392":2626,"_2946":57509},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3461":2673,"_30106":2626,"_20907":57511,"_5":14363,"_27392":2626,"_2946":57512},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3461":2674,"_30106":2626,"_20907":57514,"_5":14363,"_27392":2626,"_2946":57515},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3461":2675,"_30106":2626,"_20907":57517,"_5":14363,"_27392":2626,"_2946":57518},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3461":2676,"_30106":2626,"_20907":57520,"_5":14363,"_27392":2626,"_2946":57521},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3461":2677,"_30106":2626,"_20907":57523,"_5":14363,"_27392":2626,"_2946":57524},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3461":2678,"_30106":2626,"_20907":57526,"_5":14363,"_27392":57339,"_2946":57527},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3461":2679,"_30106":2626,"_20907":57529,"_5":14363,"_27392":57339,"_2946":57530},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3461":2680,"_30106":2626,"_20907":57532,"_5":14363,"_27392":57343,"_2946":57533},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3461":2681,"_30106":2626,"_20907":57535,"_5":14363,"_27392":57343,"_2946":57536},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3461":2682,"_30106":2626,"_20907":57538,"_5":14363,"_27392":57347,"_2946":57539},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3461":2683,"_30106":2626,"_20907":57541,"_5":14363,"_27392":57351,"_2946":57542},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3461":2684,"_30106":2626,"_20907":57544,"_5":14363,"_27392":57351,"_2946":57545},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3461":2685,"_30106":2626,"_20907":57547,"_5":14363,"_27392":57351,"_2946":57548},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3461":2686,"_30106":2626,"_20907":57550,"_5":14363,"_27392":57351,"_2946":57551},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3461":2687,"_30106":2626,"_20907":57553,"_5":14363,"_27392":57351,"_2946":57554},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3461":2688,"_30106":2626,"_20907":57556,"_5":14363,"_27392":57355,"_2946":57557},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3461":2689,"_30106":2626,"_20907":57559,"_5":14363,"_27392":57355,"_2946":57560},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3461":2690,"_30106":2626,"_20907":57562,"_5":14363,"_27392":57355,"_2946":57563},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3461":2691,"_30106":2626,"_20907":57565,"_5":14363,"_27392":57355,"_2946":57566},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3461":2692,"_30106":2626,"_20907":57568,"_5":14363,"_27392":57355,"_2946":57569},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3461":2693,"_30106":2626,"_20907":57571,"_5":14363,"_27392":57355,"_2946":57572},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3461":2694,"_30106":2626,"_20907":57574,"_5":14363,"_27392":57359,"_2946":57575},[],"Change",{"_3461":2695,"_30106":2626,"_20907":57577,"_5":14363,"_27392":57359,"_2946":57578},[],"Who is affected",{"_3461":2696,"_30106":2626,"_20907":57580,"_5":14363,"_27392":57359,"_2946":57581},[],"Severity",{"_3461":2697,"_30106":2626,"_20907":57583,"_5":14363,"_27392":57359,"_2946":56057},[],{"_3461":2698,"_30106":2626,"_20907":57585,"_5":14363,"_27392":57359,"_2946":57368},[],{"_3461":2699,"_30106":2626,"_20907":57587,"_5":14363,"_27392":57359,"_2946":57588},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3461":2700,"_30106":2626,"_20907":57590,"_5":14363,"_27392":57359,"_2946":57591},[],"High: KMS and VA start on empty volumes",{"_3461":2701,"_30106":2626,"_20907":57593,"_5":14363,"_27392":57359,"_2946":57594},[],"Copy the data into the new volumes",{"_3461":2702,"_30106":2626,"_20907":57596,"_5":14363,"_27392":57359,"_2946":57372},[],{"_3461":2703,"_30106":2626,"_20907":57598,"_5":14363,"_27392":57359,"_2946":57599},[],"Every Helm release",{"_3461":2704,"_30106":2626,"_20907":57601,"_5":14363,"_27392":57359,"_2946":57602},[],"High: `helm upgrade` fails",{"_3461":2705,"_30106":2626,"_20907":57604,"_5":14363,"_27392":57359,"_2946":57605},[],"Remove or rename legacy keys",{"_3461":2706,"_30106":2626,"_20907":57607,"_5":14363,"_27392":57359,"_2946":57376},[],{"_3461":2707,"_30106":2626,"_20907":57609,"_5":14363,"_27392":57359,"_2946":57610},[],"Every deployment",{"_3461":2708,"_30106":2626,"_20907":57612,"_5":14363,"_27392":57359,"_2946":57613},[],"High: without a bootstrap principal there is no administrator",{"_3461":2709,"_30106":2626,"_20907":57615,"_5":14363,"_27392":57359,"_2946":57616},[],"Configure `services.authz`",{"_3461":2710,"_30106":2626,"_20907":57618,"_5":14363,"_27392":57359,"_2946":57380},[],{"_3461":2711,"_30106":2626,"_20907":57620,"_5":14363,"_27392":57359,"_2946":57599},[],{"_3461":2712,"_30106":2626,"_20907":57622,"_5":14363,"_27392":57359,"_2946":57623},[],"High: `helm upgrade` fails on the old keys",{"_3461":2713,"_30106":2626,"_20907":57625,"_5":14363,"_27392":57359,"_2946":57626},[],"Move JWKS and roles into `services.authz`",{"_3461":2714,"_30106":2626,"_20907":57628,"_5":14363,"_27392":57359,"_2946":57400},[],{"_3461":2715,"_30106":2626,"_20907":57630,"_5":14363,"_27392":57359,"_2946":57631},[],"3.8.0 deployments with per-service databases",{"_3461":2716,"_30106":2626,"_20907":57633,"_5":14363,"_27392":57359,"_2946":57634},[],"High: services find no data, or a migration aborts",{"_3461":2717,"_30106":2626,"_20907":57636,"_5":14363,"_27392":57359,"_2946":57637},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3461":2718,"_30106":2626,"_20907":57639,"_5":14363,"_27392":57359,"_2946":57404},[],{"_3461":2719,"_30106":2626,"_20907":57641,"_5":14363,"_27392":57359,"_2946":57642},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3461":2720,"_30106":2626,"_20907":57644,"_5":14363,"_27392":57359,"_2946":57645},[],"High: the backend no longer starts with them",{"_3461":2721,"_30106":2626,"_20907":57647,"_5":14363,"_27392":57359,"_2946":57648},[],"Move to PostgreSQL before upgrading",{"_3461":2722,"_30106":2626,"_20907":57650,"_5":14363,"_27392":57359,"_2946":57448},[],{"_3461":2723,"_30106":2626,"_20907":57652,"_5":14363,"_27392":57359,"_2946":57653},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3461":2724,"_30106":2626,"_20907":57655,"_5":14363,"_27392":57359,"_2946":57656},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3461":2725,"_30106":2626,"_20907":57658,"_5":14363,"_27392":57359,"_2946":57659},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3461":2726,"_30106":2626,"_20907":57661,"_5":14363,"_27392":57359,"_2946":57662},[],"Webhooks with file references",{"_3461":2727,"_30106":2626,"_20907":57664,"_5":14363,"_27392":57359,"_2946":57665},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3461":2728,"_30106":2626,"_20907":57667,"_5":14363,"_27392":57359,"_2946":57668},[],"High: enrollments calling the webhook fail",{"_3461":2729,"_30106":2626,"_20907":57670,"_5":14363,"_27392":57359,"_2946":57671},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3461":2730,"_30106":2626,"_20907":57673,"_5":14363,"_27392":57359,"_2946":57384},[],{"_3461":2731,"_30106":2626,"_20907":57675,"_5":14363,"_27392":57359,"_2946":57676},[],"Releases with per-service identity overrides or mounted key material",{"_3461":2732,"_30106":2626,"_20907":57678,"_5":14363,"_27392":57359,"_2946":57679},[],"Medium: services cannot read their files",{"_3461":2733,"_30106":2626,"_20907":57681,"_5":14363,"_27392":57359,"_2946":57682},[],"Remove the overrides and fix volume ownership",{"_3461":2734,"_30106":2626,"_20907":57684,"_5":14363,"_27392":57359,"_2946":57388},[],{"_3461":2735,"_30106":2626,"_20907":57686,"_5":14363,"_27392":57359,"_2946":57687},[],"Releases that set `amqp.tls`",{"_3461":2736,"_30106":2626,"_20907":57689,"_5":14363,"_27392":57359,"_2946":57690},[],"Medium: clients connect to the wrong port",{"_3461":2737,"_30106":2626,"_20907":57692,"_5":14363,"_27392":57359,"_2946":57693},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3461":2738,"_30106":2626,"_20907":57695,"_5":14363,"_27392":57359,"_2946":57408},[],{"_3461":2739,"_30106":2626,"_20907":57697,"_5":14363,"_27392":57359,"_2946":57698},[],"Installations whose CA keys predate the KMS",{"_3461":2740,"_30106":2626,"_20907":57700,"_5":14363,"_27392":57359,"_2946":57701},[],"Medium: CA keys stay unmanaged",{"_3461":2741,"_30106":2626,"_20907":57703,"_5":14363,"_27392":57359,"_2946":57704},[],"Run the CA-to-KMS migration",{"_3461":2742,"_30106":2626,"_20907":57706,"_5":14363,"_27392":57359,"_2946":57707},[],"Receiver certificate verification",{"_3461":2743,"_30106":2626,"_20907":57709,"_5":14363,"_27392":57359,"_2946":57710},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3461":2744,"_30106":2626,"_20907":57712,"_5":14363,"_27392":57359,"_2946":57713},[],"Medium: credentials go to an unverified receiver",{"_3461":2745,"_30106":2626,"_20907":57715,"_5":14363,"_27392":57359,"_2946":57716},[],"Set `insecure_skip_verify` to `false`",{"_3461":2746,"_30106":2626,"_20907":57718,"_5":14363,"_27392":57359,"_2946":57424},[],{"_3461":2747,"_30106":2626,"_20907":57720,"_5":14363,"_27392":57359,"_2946":57721},[],"Scripts and consoles that edit DMSs through the API",{"_3461":2748,"_30106":2626,"_20907":57723,"_5":14363,"_27392":57359,"_2946":57724},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3461":2749,"_30106":2626,"_20907":57726,"_5":14363,"_27392":57359,"_2946":57727},[],"Read the DMS before editing and use the new field",{"_3461":2750,"_30106":2626,"_20907":57729,"_5":14363,"_27392":57359,"_2946":57444},[],{"_3461":2751,"_30106":2626,"_20907":57731,"_5":14363,"_27392":57359,"_2946":57732},[],"Clients that create or update CRL settings through the API",{"_3461":2752,"_30106":2626,"_20907":57734,"_5":14363,"_27392":57359,"_2946":57735},[],"Medium: requests with the old field return an error",{"_3461":2753,"_30106":2626,"_20907":57737,"_5":14363,"_27392":57359,"_2946":57738},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3461":2754,"_30106":2626,"_20907":57740,"_5":14363,"_27392":57359,"_2946":57452},[],{"_3461":2755,"_30106":2626,"_20907":57742,"_5":14363,"_27392":57359,"_2946":57743},[],"Alert subscriptions and consumers of the VA events",{"_3461":2756,"_30106":2626,"_20907":57745,"_5":14363,"_27392":57359,"_2946":57746},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3461":2757,"_30106":2626,"_20907":57748,"_5":14363,"_27392":57359,"_2946":57749},[],"Review conditions filtering on the old event payload or subject",{"_3461":2758,"_30106":2626,"_20907":57751,"_5":14363,"_27392":57359,"_2946":57440},[],{"_3461":2759,"_30106":2626,"_20907":57753,"_5":14363,"_27392":57359,"_2946":57754},[],"Consumers that read the device `events` field",{"_3461":2760,"_30106":2626,"_20907":57756,"_5":14363,"_27392":57359,"_2946":57757},[],"Medium: the field disappears",{"_3461":2761,"_30106":2626,"_20907":57759,"_5":14363,"_27392":57359,"_2946":57760},[],"Use the new event endpoints",{"_3461":2762,"_30106":2626,"_20907":57762,"_5":14363,"_27392":57359,"_2946":57460},[],{"_3461":2763,"_30106":2626,"_20907":57764,"_5":14363,"_27392":57359,"_2946":57765},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3461":2764,"_30106":2626,"_20907":57767,"_5":14363,"_27392":57359,"_2946":57768},[],"Medium: the VA migration aborts",{"_3461":2765,"_30106":2626,"_20907":57770,"_5":14363,"_27392":57359,"_2946":57771},[],"Fix the affected roles before upgrading",{"_3461":2766,"_30106":2626,"_20907":57773,"_5":14363,"_27392":57359,"_2946":57392},[],{"_3461":2767,"_30106":2626,"_20907":57775,"_5":14363,"_27392":57359,"_2946":57776},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3461":2768,"_30106":2626,"_20907":57778,"_5":14363,"_27392":57359,"_2946":57779},[],"Low to medium: validation errors or changed defaults",{"_3461":2769,"_30106":2626,"_20907":57781,"_5":14363,"_27392":57359,"_2946":57782},[],"Update the values file",{"_3461":2770,"_30106":2626,"_20907":57784,"_5":14363,"_27392":57359,"_2946":57432},[],{"_3461":2771,"_30106":2626,"_20907":57786,"_5":14363,"_27392":57359,"_2946":57787},[],"Clients that send the DMS ID in the update body",{"_3461":2772,"_30106":2626,"_20907":57789,"_5":14363,"_27392":57359,"_2946":57790},[],"Low: the ID in the URL wins",{"_3461":2773,"_30106":2626,"_20907":57792,"_5":14363,"_27392":57359,"_2946":57793},[],"Send the ID in the URL",{"_3461":2774,"_30106":2626,"_20907":57795,"_5":14363,"_27392":57359,"_2946":57456},[],{"_3461":2775,"_30106":2626,"_20907":57797,"_5":14363,"_27392":57359,"_2946":57798},[],"Clients that send an `id` when creating or importing CAs",{"_3461":2776,"_30106":2626,"_20907":57800,"_5":14363,"_27392":57359,"_2946":57801},[],"Low: the ID in the body is ignored, and the field is removed",{"_3461":2777,"_30106":2626,"_20907":57803,"_5":14363,"_27392":57359,"_2946":57804},[],"Let the backend assign the ID and use the returned one",{"_3461":2778,"_30106":2626,"_20907":57806,"_5":14363,"_27392":57359,"_2946":57436},[],{"_3461":2779,"_30106":2626,"_20907":57808,"_5":14363,"_27392":57359,"_2946":57809},[],"Consumers that match on certificate `type`",{"_3461":2780,"_30106":2626,"_20907":57811,"_5":14363,"_27392":57359,"_2946":57812},[],"Low: two values are renamed",{"_3461":2781,"_30106":2626,"_20907":57814,"_5":14363,"_27392":57359,"_2946":57815},[],"Adapt consumers",{"_3461":2782,"_30106":2626,"_20907":57817,"_5":14363,"_27392":57359,"_2946":57428},[],{"_3461":2783,"_30106":2626,"_20907":57819,"_5":14363,"_27392":57359,"_2946":57820},[],"Any DMS",{"_3461":2784,"_30106":2626,"_20907":57822,"_5":14363,"_27392":57359,"_2946":57823},[],"Low: informational",{"_3461":2785,"_30106":2626,"_20907":57825,"_5":14363,"_27392":57359,"_2946":57826},[],"Read both blocks before editing",{"_3461":2786,"_30106":2626,"_20907":57828,"_5":14363,"_27392":57367,"_2946":57829},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3461":2787,"_30106":2626,"_20907":57831,"_5":14363,"_27392":57367,"_2946":57832},[],"Step 4 of the migration guide copies the data.",{"_3461":2788,"_30106":2626,"_20907":57834,"_5":14363,"_27392":57371,"_2946":57835},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3461":2789,"_30106":2626,"_20907":57837,"_5":14363,"_27392":57375,"_2946":57838},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3461":2790,"_30106":2626,"_20907":57840,"_5":14363,"_27392":57379,"_2946":57841},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3461":2791,"_30106":2626,"_20907":57843,"_5":14363,"_27392":57383,"_2946":57844},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3461":2792,"_30106":2626,"_20907":57846,"_5":14363,"_27392":57383,"_2946":57847},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3461":2793,"_30106":2626,"_20907":57849,"_5":14363,"_27392":57387,"_2946":57850},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3461":2794,"_30106":2626,"_20907":57852,"_5":14363,"_27392":57391,"_2946":57853},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3461":2795,"_30106":2626,"_20907":57855,"_5":14363,"_27392":57391,"_2946":57856},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3461":2796,"_30106":2626,"_20907":57858,"_5":14363,"_27392":57391,"_2946":57859},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3461":2797,"_30106":2626,"_20907":57861,"_5":14363,"_27392":57391,"_2946":57862},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3461":2798,"_30106":2626,"_20907":57864,"_5":14363,"_27392":57391,"_2946":57865},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3461":2799,"_30106":2626,"_20907":57867,"_5":14363,"_27392":57391,"_2946":57868},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3461":2800,"_30106":2626,"_20907":57870,"_5":14363,"_27392":57399,"_2946":57871},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3461":2801,"_30106":2626,"_20907":57873,"_5":14363,"_27392":57399,"_2946":57874},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3461":2802,"_30106":2626,"_20907":57876,"_5":14363,"_27392":57399,"_2946":57877},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3461":2803,"_30106":2626,"_20907":57879,"_5":14363,"_27392":57399,"_2946":57880},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3461":2804,"_30106":2626,"_20907":57882,"_5":14363,"_27392":57399,"_2946":57883},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3461":2805,"_30106":2626,"_20907":57885,"_5":14363,"_27392":57403,"_2946":57886},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3461":2806,"_30106":2626,"_20907":57888,"_5":14363,"_27392":57407,"_2946":57889},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3461":2807,"_30106":2626,"_20907":57891,"_5":14363,"_27392":57407,"_2946":57892},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3461":2808,"_30106":2626,"_20907":57894,"_5":14363,"_27392":57407,"_2946":57895},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3461":2809,"_30106":2626,"_20907":57897,"_5":14363,"_27392":57407,"_2946":57898},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3461":2810,"_30106":2626,"_20907":57900,"_5":14363,"_27392":57407,"_2946":57901},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3461":2811,"_30106":2626,"_20907":57903,"_5":14363,"_27392":57407,"_2946":57904},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3461":2812,"_30106":2626,"_20907":57906,"_5":14363,"_27392":57407,"_2946":57907},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3461":2813,"_30106":2626,"_20907":57909,"_5":14363,"_27392":57407,"_2946":57910},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3461":2814,"_30106":2626,"_20907":57912,"_5":14363,"_27392":57411,"_2946":57913},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3461":2815,"_30106":2626,"_20907":57915,"_5":14363,"_27392":57419,"_2946":57916},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3461":2816,"_30106":2626,"_20907":57918,"_5":14363,"_27392":57419,"_2946":57919},[],"Field in 3.8.0",{"_3461":2817,"_30106":2626,"_20907":57921,"_5":14363,"_27392":57419,"_2946":57922},[],"Field in 4.0.0",{"_3461":2818,"_30106":2626,"_20907":57924,"_5":14363,"_27392":57419,"_2946":57925},[],"`validate_server_cert`",{"_3461":2819,"_30106":2626,"_20907":57927,"_5":14363,"_27392":57419,"_2946":57928},[],"`insecure_skip_verify` (value negated)",{"_3461":2820,"_30106":2626,"_20907":57930,"_5":14363,"_27392":57419,"_2946":57931},[],"`oidc`",{"_3461":2821,"_30106":2626,"_20907":57933,"_5":14363,"_27392":57419,"_2946":57934},[],"`jwt_options`",{"_3461":2822,"_30106":2626,"_20907":57936,"_5":14363,"_27392":57419,"_2946":57937},[],"`apikey`",{"_3461":2823,"_30106":2626,"_20907":57939,"_5":14363,"_27392":57419,"_2946":57940},[],"`apikey_options`",{"_3461":2824,"_30106":2626,"_20907":57942,"_5":14363,"_27392":57419,"_2946":57943},[],"`mtls`",{"_3461":2825,"_30106":2626,"_20907":57945,"_5":14363,"_27392":57419,"_2946":57946},[],"`mtls_options`",{"_3461":2826,"_30106":2626,"_20907":57948,"_5":14363,"_27392":57419,"_2946":57949},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3461":2827,"_30106":2626,"_20907":57951,"_5":14363,"_27392":57419,"_2946":57952},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3461":2828,"_30106":2626,"_20907":57954,"_5":14363,"_27392":57419,"_2946":57955},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3461":2829,"_30106":2626,"_20907":57957,"_5":14363,"_27392":57423,"_2946":57958},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3461":2830,"_30106":2626,"_20907":57960,"_5":14363,"_27392":57423,"_2946":57961},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3461":2831,"_30106":2626,"_20907":57963,"_5":14363,"_27392":57423,"_2946":57964},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3461":2832,"_30106":2626,"_20907":57966,"_5":14363,"_27392":57427,"_2946":57967},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3461":2833,"_30106":2626,"_20907":57969,"_5":14363,"_27392":57431,"_2946":57970},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3461":2834,"_30106":2626,"_20907":57972,"_5":14363,"_27392":57435,"_2946":57973},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3461":2835,"_30106":2626,"_20907":57975,"_5":14363,"_27392":57439,"_2946":57976},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3461":2836,"_30106":2626,"_20907":57978,"_5":14363,"_27392":57439,"_2946":57979},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3461":2837,"_30106":2626,"_20907":57981,"_5":14363,"_27392":57439,"_2946":57982},[],"`POST /v1/devices/:id/events` creates an event.",{"_3461":2838,"_30106":2626,"_20907":57984,"_5":14363,"_27392":57439,"_2946":57985},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3461":2839,"_30106":2626,"_20907":57987,"_5":14363,"_27392":57443,"_2946":57988},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3461":2840,"_30106":2626,"_20907":57990,"_5":14363,"_27392":57447,"_2946":57991},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3461":2841,"_30106":2626,"_20907":57993,"_5":14363,"_27392":57447,"_2946":57994},[],"Route",{"_3461":2842,"_30106":2626,"_20907":57996,"_5":14363,"_27392":57447,"_2946":52392},[],{"_3461":2843,"_30106":2626,"_20907":57998,"_5":14363,"_27392":57447,"_2946":57999},[],"`GET /v1/crl-settings`",{"_3461":2844,"_30106":2626,"_20907":58001,"_5":14363,"_27392":57447,"_2946":58002},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3461":2845,"_30106":2626,"_20907":58004,"_5":14363,"_27392":57447,"_2946":58005},[],"`GET /v1/crl-settings/{ca-id}`",{"_3461":2846,"_30106":2626,"_20907":58007,"_5":14363,"_27392":57447,"_2946":58008},[],"Reads the settings of a CA.",{"_3461":2847,"_30106":2626,"_20907":58010,"_5":14363,"_27392":57447,"_2946":58011},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3461":2848,"_30106":2626,"_20907":58013,"_5":14363,"_27392":57447,"_2946":58014},[],"Replaces `crl_options`.",{"_3461":2849,"_30106":2626,"_20907":58016,"_5":14363,"_27392":57447,"_2946":58017},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3461":2850,"_30106":2626,"_20907":58019,"_5":14363,"_27392":57447,"_2946":58020},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3461":2851,"_30106":2626,"_20907":58022,"_5":14363,"_27392":57447,"_2946":58023},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3461":2852,"_30106":2626,"_20907":58025,"_5":14363,"_27392":57447,"_2946":58026},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3461":2853,"_30106":2626,"_20907":58028,"_5":14363,"_27392":57447,"_2946":58029},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3461":2854,"_30106":2626,"_20907":58031,"_5":14363,"_27392":57447,"_2946":58032},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3461":2855,"_30106":2626,"_20907":58034,"_5":14363,"_27392":57447,"_2946":58035},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3461":2856,"_30106":2626,"_20907":58037,"_5":14363,"_27392":57447,"_2946":58038},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3461":2857,"_30106":2626,"_20907":58040,"_5":14363,"_27392":57447,"_2946":58041},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3461":2858,"_30106":2626,"_20907":58043,"_5":14363,"_27392":57447,"_2946":58044},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3461":2859,"_30106":2626,"_20907":58046,"_5":14363,"_27392":57447,"_2946":58047},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3461":2860,"_30106":2626,"_20907":58049,"_5":14363,"_27392":57451,"_2946":58050},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3461":2861,"_30106":2626,"_20907":58052,"_5":14363,"_27392":57455,"_2946":58053},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3461":2862,"_30106":2626,"_20907":58055,"_5":14363,"_27392":57459,"_2946":58056},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3461":2863,"_30106":2626,"_20907":58058,"_5":14363,"_27392":57463,"_2946":58059},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3461":2864,"_30106":2626,"_20907":58061,"_5":14363,"_27392":57467,"_2946":58062},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3461":2865,"_30106":2626,"_20907":58064,"_5":14363,"_27392":57467,"_2946":58065},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3461":2866,"_30106":2626,"_20907":58067,"_5":14363,"_27392":57467,"_2946":58068},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3461":2867,"_30106":2626,"_20907":58070,"_5":14363,"_27392":57467,"_2946":58071},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3461":2868,"_30106":2626,"_20907":58073,"_5":14363,"_27392":57467,"_2946":58074},[],"Record the names of your local-storage PVCs:",{"_3461":2869,"_30106":2626,"_20907":58076,"_5":14363,"_27392":57467,"_2946":58077},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3461":2870,"_30106":2626,"_20907":58079,"_5":14363,"_27392":57471,"_2946":58080},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3461":2871,"_30106":2626,"_20907":58082,"_5":14363,"_27392":57471,"_2946":58083},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3461":2872,"_30106":2626,"_20907":58085,"_5":14363,"_27392":57471,"_2946":58086},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3461":2873,"_30106":2626,"_20907":58088,"_5":14363,"_27392":57471,"_2946":58089},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3461":2874,"_30106":2626,"_20907":58091,"_5":14363,"_27392":57471,"_2946":58092},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3461":2875,"_30106":2626,"_20907":58094,"_5":14363,"_27392":57475,"_2946":58095},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3461":2876,"_30106":2626,"_20907":58097,"_5":14363,"_27392":57475,"_2946":58098},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3461":2877,"_30106":2626,"_20907":58100,"_5":14363,"_27392":57475,"_2946":58101},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3461":2878,"_30106":2626,"_20907":58103,"_5":14363,"_27392":57475,"_2946":58104},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3461":2879,"_30106":2626,"_20907":58106,"_5":14363,"_27392":57475,"_2946":58107},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3461":2880,"_30106":2626,"_20907":58109,"_5":14363,"_27392":57475,"_2946":58110},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3461":2881,"_30106":2626,"_20907":58112,"_5":14363,"_27392":57475,"_2946":58113},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3461":2882,"_30106":2626,"_20907":58115,"_5":14363,"_27392":57475,"_2946":58116},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3461":2883,"_30106":2626,"_20907":58118,"_5":14363,"_27392":57475,"_2946":58119},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3461":2884,"_30106":2626,"_20907":58121,"_5":14363,"_27392":57475,"_2946":58122},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3461":2885,"_30106":2626,"_20907":58124,"_5":14363,"_27392":57475,"_2946":58125},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3461":2886,"_30106":2626,"_20907":58127,"_5":14363,"_27392":57475,"_2946":58128},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3461":2887,"_30106":2626,"_20907":58130,"_5":14363,"_27392":57479,"_2946":58131},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3461":2888,"_30106":2626,"_20907":58133,"_5":14363,"_27392":57479,"_2946":58134},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3461":2889,"_30106":2626,"_20907":58136,"_5":14363,"_27392":57483,"_2946":58137},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3461":2890,"_30106":2626,"_20907":58139,"_5":14363,"_27392":57483,"_2946":58140},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3461":2891,"_30106":2626,"_20907":58142,"_5":14363,"_27392":57483,"_2946":58143},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3461":2892,"_30106":2626,"_20907":58145,"_5":14363,"_27392":57483,"_2946":58146},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3461":2893,"_30106":2626,"_20907":58148,"_5":14363,"_27392":57483,"_2946":58149},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3461":2894,"_30106":2626,"_20907":58151,"_5":14363,"_27392":57483,"_2946":58152},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3461":2895,"_30106":2626,"_20907":58154,"_5":14363,"_27392":57483,"_2946":58155},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3461":2896,"_30106":2626,"_20907":58157,"_5":14363,"_27392":57483,"_2946":58158},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3461":2897,"_30106":2626,"_20907":58160,"_5":14363,"_27392":57483,"_2946":58161},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3461":2898,"_30106":2626,"_20907":58163,"_5":14363,"_27392":57483,"_2946":58164},[],"**Remove the helper and restore the recorded replica counts:**",{"_3461":2899,"_30106":2626,"_20907":58166,"_5":14363,"_27392":57483,"_2946":58167},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3461":2900,"_30106":2626,"_20907":58169,"_5":14363,"_27392":57487,"_2946":58170},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3461":2901,"_30106":2626,"_20907":58172,"_5":14363,"_27392":57487,"_2946":58173},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3461":2902,"_30106":2626,"_20907":58175,"_5":14363,"_27392":57491,"_2946":58176},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3461":2903,"_30106":2626,"_20907":58178,"_5":14363,"_27392":57491,"_2946":58179},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3461":2904,"_30106":2626,"_20907":58181,"_5":14363,"_27392":57491,"_2946":58182},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3461":2905,"_30106":2626,"_20907":58184,"_5":14363,"_27392":57491,"_2946":58185},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3461":2906,"_30106":2626,"_20907":58187,"_5":14363,"_27392":57491,"_2946":58188},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3461":2907,"_30106":2626,"_20907":58190,"_5":14363,"_27392":57491,"_2946":58191},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3461":2908,"_30106":2626,"_20907":58193,"_5":14363,"_27392":57491,"_2946":58194},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3461":2909,"_30106":2626,"_20907":58196,"_5":14363,"_27392":57491,"_2946":58197},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3461":2910,"_30106":2626,"_20907":58199,"_5":14363,"_27392":57495,"_2946":58200},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3461":2911,"_30106":2626,"_20907":58202,"_5":14363,"_27392":57495,"_2946":58203},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3461":2912,"_30106":2626,"_20907":58205,"_5":14363,"_27392":57495,"_2946":58206},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3461":2913,"_30106":2626,"_20907":58208,"_5":14363,"_27392":57495,"_2946":58209},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3461":2914,"_30106":2626,"_20907":58211,"_5":14363,"_27392":57495,"_2946":58212},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3461":2915,"_30106":2626,"_20907":58214,"_5":14363,"_27392":57495,"_2946":58215},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3461":2916,"_30106":2626,"_20907":58217,"_5":14363,"_27392":57495,"_2946":58218},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3461":2917,"_30106":2626,"_20907":58220,"_5":14363,"_27392":57495,"_2946":58221},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3461":2918,"_30106":2626,"_20907":58223,"_5":14363,"_27392":57495,"_2946":58224},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3461":2919,"_30106":2626,"_20907":58226,"_5":14363,"_27392":57495,"_2946":58227},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3461":2920,"_30106":2626,"_20907":58229,"_5":14363,"_27392":57495,"_2946":58230},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3461":2921,"_30106":2626,"_20907":58232,"_5":14363,"_27392":57498,"_2946":58233},[],"After the upgrade, check in this order:",{"_3461":2922,"_30106":2626,"_20907":58235,"_5":14363,"_27392":57498,"_2946":58236},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3461":2923,"_30106":2626,"_20907":58238,"_5":14363,"_27392":57498,"_2946":58239},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3461":2924,"_30106":2626,"_20907":58241,"_5":14363,"_27392":57498,"_2946":58242},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3461":2925,"_30106":2626,"_20907":58244,"_5":14363,"_27392":57498,"_2946":58245},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3461":2926,"_30106":2626,"_20907":58247,"_5":14363,"_27392":57498,"_2946":58248},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3461":2927,"_30106":2626,"_20907":58250,"_5":14363,"_27392":57498,"_2946":58251},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3461":2928,"_30106":2626,"_20907":58253,"_5":14363,"_27392":57498,"_2946":58254},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3461":2929,"_30106":2626,"_20907":58256,"_5":14363,"_27392":57498,"_2946":58257},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3461":2930,"_30106":2626,"_20907":58259,"_5":14363,"_27392":57498,"_2946":58260},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3461":2931,"_30106":2626,"_20907":58262,"_5":14363,"_27392":57498,"_2946":58263},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3461":2932,"_30106":2626,"_20907":58265,"_5":14363,"_27392":57498,"_2946":58266},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3461":2933,"_30106":2626,"_20907":58268,"_5":14363,"_27392":57498,"_2946":58269},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3461":2934,"_30106":2626,"_20907":58271,"_5":14363,"_27392":57498,"_2946":58272},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3461":2935,"_30106":2626,"_20907":58274,"_5":14363,"_27392":57498,"_2946":58275},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3461":2936,"_30106":2626,"_20907":58277,"_5":14363,"_27392":57498,"_2946":58278},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3461":2937,"_30106":2626,"_20907":58280,"_5":14363,"_27392":57502,"_2946":58281},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3461":2938,"_30106":2626,"_20907":58283,"_5":14363,"_27392":57502,"_2946":58284},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3461":2939,"_30106":2626,"_20907":58286,"_5":14363,"_27392":57502,"_2946":58287},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3461":2940,"_30106":2626,"_20907":58289,"_5":14363,"_27392":57502,"_2946":58290},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3461":2941,"_30106":2626,"_20907":58292,"_5":14363,"_27392":57502,"_2946":58293},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58296":58297,"_58298":58299,"_58300":58301,"_58302":58303,"_18124":2981,"_70025":2981},"language","english","sortableProperties",[2946,30106,5,27392],"sortablePropertiesWithTypes",{"_2946":24973,"_30106":24973,"_5":24973,"_27392":24973},"sorts",{"_2946":58304,"_30106":61235,"_5":64165,"_27392":67095},{"_4641":58305,"_58306":58307,"_5":24973},{"_14439":4179,"_14820":6978,"_14839":3201,"_29109":5141,"_14826":6957,"_19839":6460,"_14460":9362,"_14467":10962,"_29051":4617,"_29460":6992,"_29481":4076,"_29085":4706,"_34454":5953,"_29188":7493,"_29525":4932,"_34461":4783,"_34464":10475,"_34467":6981,"_34470":12429,"_29932":6078,"_34475":3998,"_34477":3250,"_29962":4571,"_14835":18138,"_34481":3427,"_34484":7528,"_34486":6187,"_29509":4578,"_29927":3921,"_29975":4982,"_34491":4763,"_34493":11585,"_34495":4745,"_29205":3046,"_34498":6615,"_34500":7541,"_34502":10449,"_34504":3651,"_34506":19433,"_29122":4403,"_34509":5840,"_34511":3524,"_29116":15966,"_29546":4700,"_34515":5552,"_34517":3405,"_34520":9171,"_29162":6955,"_34524":4033,"_29042":5432,"_34527":7018,"_29090":4009,"_34530":11281,"_34532":3450,"_34535":16723,"_14829":7538,"_34538