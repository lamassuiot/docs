4756,"_40176":124759,"_40178":124762,"_40181":124765,"_40183":124768,"_40185":124771,"_40188":124774,"_40190":124777,"_40192":124780,"_40194":124783,"_40196":124786,"_40198":124789,"_40200":124792,"_40202":124795,"_40204":124798,"_40206":124801,"_40208":124804,"_40210":124807,"_40212":124810,"_40214":124813,"_40216":124816,"_40218":124819,"_40220":124822,"_40222":124825,"_40224":124828,"_40226":124831,"_40229":124834,"_40231":124837,"_40233":124840,"_40235":124843,"_40237":124846,"_40239":124849,"_40241":124852,"_40243":124855,"_40245":124858,"_40247":124861,"_40249":124864,"_40251":124867,"_40253":124870,"_40255":124873,"_40257":124876,"_40259":124879,"_40261":124882,"_40263":124885,"_40265":124888,"_40267":124891,"_40269":124894,"_40271":124897,"_40273":124900,"_40275":124903,"_40277":124906,"_40279":124909,"_40282":124912,"_40284":124915,"_40286":124918},{"_3461":70021,"_30095":70021,"_5":14710,"_2946":115994,"_30448":115995,"_20902":115998,"_27381":70021},"Despliega desde AWS Marketplace",[49146,115996,115997],"Despliegue","Otros modelos",[],{"_3461":70022,"_30095":70021,"_20902":116000,"_5":14358,"_27381":70021,"_2946":116001},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3461":70023,"_30095":70021,"_5":30445,"_20902":116003,"_27381":116004,"_2946":116005},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3461":70024,"_30095":70021,"_5":30445,"_20902":116007,"_27381":116008,"_2946":116009},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3461":70025,"_30095":70021,"_5":30445,"_20902":116011,"_27381":116012,"_2946":116013},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3461":70026,"_30095":70021,"_5":30445,"_20902":116015,"_27381":116016,"_2946":116017},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3461":70027,"_30095":70021,"_5":30445,"_20902":116019,"_27381":116020,"_2946":116021},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3461":70028,"_30095":70021,"_5":30445,"_20902":116023,"_27381":116024,"_2946":116025},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3461":70029,"_30095":70021,"_5":30445,"_20902":116027,"_27381":116028,"_2946":116029},[],"/docs/pr-preview/pr-60/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3461":70030,"_30095":70021,"_20902":116031,"_5":14358,"_27381":70021,"_2946":116032},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3461":70031,"_30095":70021,"_20902":116034,"_5":14358,"_27381":116004,"_2946":116035},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3461":70032,"_30095":70021,"_20902":116037,"_5":14358,"_27381":116004,"_2946":116038},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3461":70033,"_30095":70021,"_20902":116040,"_5":14358,"_27381":116004,"_2946":116041},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3461":70034,"_30095":70021,"_20902":116043,"_5":14358,"_27381":116008,"_2946":116044},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3461":70035,"_30095":70021,"_20902":116046,"_5":14358,"_27381":116008,"_2946":116047},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3461":70036,"_30095":70021,"_20902":116049,"_5":14358,"_27381":116008,"_2946":116050},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3461":70037,"_30095":70021,"_20902":116052,"_5":14358,"_27381":116012,"_2946":116053},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3461":70038,"_30095":70021,"_20902":116055,"_5":14358,"_27381":116016,"_2946":116056},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3461":70039,"_30095":70021,"_20902":116058,"_5":14358,"_27381":116020,"_2946":116059},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3461":70040,"_30095":70021,"_20902":116061,"_5":14358,"_27381":116024,"_2946":116062},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3461":70041,"_30095":70021,"_20902":116064,"_5":14358,"_27381":116028,"_2946":116065},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3461":70042,"_30095":70042,"_5":14710,"_2946":116067,"_30448":116068,"_20902":116069,"_27381":70042},"Despliega Lamassu",[49146,115996],[],{"_3461":70043,"_30095":70042,"_20902":116071,"_5":14358,"_27381":70042,"_2946":116072},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3461":70044,"_30095":70042,"_5":30445,"_20902":116074,"_27381":116075,"_2946":116076},[],"/docs/pr-preview/pr-60/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3461":70045,"_30095":70042,"_5":30445,"_20902":116078,"_27381":116079,"_2946":116080},[],"/docs/pr-preview/pr-60/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3461":70046,"_30095":70042,"_5":30445,"_20902":116082,"_27381":116083,"_2946":116084},[],"/docs/pr-preview/pr-60/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3461":70047,"_30095":70042,"_20902":116086,"_5":14358,"_27381":70042,"_2946":116087},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3461":70048,"_30095":70042,"_20902":116089,"_5":14358,"_27381":116075,"_2946":116090},[],"Modelo",{"_3461":70049,"_30095":70042,"_20902":116092,"_5":14358,"_27381":116075,"_2946":116093},[],"Recomendado para",{"_3461":70050,"_30095":70042,"_20902":116095,"_5":14358,"_27381":116075,"_2946":116096},[],"Quién opera la infraestructura",{"_3461":70051,"_30095":70042,"_20902":116098,"_5":14358,"_27381":116075,"_2946":116099},[],"Punto de partida",{"_3461":70052,"_30095":70042,"_20902":116101,"_5":14358,"_27381":116075,"_2946":49253},[],{"_3461":70053,"_30095":70042,"_20902":116103,"_5":14358,"_27381":116075,"_2946":116104},[],"Producción, entornos regulados y despliegues personalizados",{"_3461":70054,"_30095":70042,"_20902":116106,"_5":14358,"_27381":116075,"_2946":116107},[],"Tu equipo",{"_3461":70055,"_30095":70042,"_20902":116109,"_5":14358,"_27381":116075,"_2946":116110},[],"Helm o Fastlane",{"_3461":70056,"_30095":70042,"_20902":116112,"_5":14358,"_27381":116075,"_2946":49265},[],{"_3461":70057,"_30095":70042,"_20902":116114,"_5":14358,"_27381":116075,"_2946":116115},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3461":70058,"_30095":70042,"_20902":116117,"_5":14358,"_27381":116075,"_2946":116107},[],{"_3461":70059,"_30095":70042,"_20902":116119,"_5":14358,"_27381":116075,"_2946":116120},[],"Imagen preconfigurada en EC2",{"_3461":70060,"_30095":70042,"_20902":116122,"_5":14358,"_27381":116075,"_2946":49276},[],{"_3461":70061,"_30095":70042,"_20902":116124,"_5":14358,"_27381":116075,"_2946":116125},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3461":70062,"_30095":70042,"_20902":116127,"_5":14358,"_27381":116075,"_2946":49282},[],{"_3461":70063,"_30095":70042,"_20902":116129,"_5":14358,"_27381":116075,"_2946":116130},[],"Suscripción gestionada",{"_3461":70064,"_30095":70042,"_20902":116132,"_5":14358,"_27381":116075,"_2946":116133},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3461":70065,"_30095":70042,"_20902":116135,"_5":14358,"_27381":116075,"_2946":116136},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3461":70066,"_30095":70042,"_20902":116138,"_5":14358,"_27381":116075,"_2946":116139},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3461":70067,"_30095":70042,"_20902":116141,"_5":14358,"_27381":116079,"_2946":116142},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3461":70068,"_30095":70042,"_20902":116144,"_5":14358,"_27381":116083,"_2946":116145},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3461":70069,"_30095":70069,"_5":14710,"_2946":116147,"_30448":116148,"_20902":116149,"_27381":70069},"Utiliza Lamassu como SaaS",[49146,115996,115997],[],{"_3461":70070,"_30095":70069,"_20902":116151,"_5":14358,"_27381":70069,"_2946":116152},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3461":70071,"_30095":70069,"_5":30445,"_20902":116154,"_27381":116155,"_2946":116156},[],"/docs/pr-preview/pr-60/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3461":70072,"_30095":70069,"_5":30445,"_20902":116158,"_27381":116159,"_2946":116160},[],"/docs/pr-preview/pr-60/es/deployment/saas#planes","Planes",{"_3461":70073,"_30095":70069,"_5":30445,"_20902":116162,"_27381":116163,"_2946":116164},[],"/docs/pr-preview/pr-60/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3461":70074,"_30095":70069,"_20902":116166,"_5":14358,"_27381":70069,"_2946":116167},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3461":70075,"_30095":70069,"_20902":116169,"_5":14358,"_27381":116155,"_2946":116170},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3461":70076,"_30095":70069,"_20902":116172,"_5":14358,"_27381":116155,"_2946":116173},[],"Copias de seguridad automáticas.",{"_3461":70077,"_30095":70069,"_20902":116175,"_5":14358,"_27381":116155,"_2946":116176},[],"Actualizaciones de versión.",{"_3461":70078,"_30095":70069,"_20902":116178,"_5":14358,"_27381":116155,"_2946":116179},[],"Soporte técnico y SLA según el plan contratado.",{"_3461":70079,"_30095":70069,"_20902":116181,"_5":14358,"_27381":116159,"_2946":49337},[],{"_3461":70080,"_30095":70069,"_20902":116183,"_5":14358,"_27381":116159,"_2946":116184},[],"Dispositivos",{"_3461":70081,"_30095":70069,"_20902":116186,"_5":14358,"_27381":116159,"_2946":116187},[],"Soporte",{"_3461":70082,"_30095":70069,"_20902":116189,"_5":14358,"_27381":116159,"_2946":49346},[],{"_3461":70083,"_30095":70069,"_20902":116191,"_5":14358,"_27381":116159,"_2946":49349},[],{"_3461":70084,"_30095":70069,"_20902":116193,"_5":14358,"_27381":116159,"_2946":116194},[],"Hasta 1.000",{"_3461":70085,"_30095":70069,"_20902":116196,"_5":14358,"_27381":116159,"_2946":49355},[],{"_3461":70086,"_30095":70069,"_20902":116198,"_5":14358,"_27381":116159,"_2946":116199},[],"99,5 %",{"_3461":70087,"_30095":70069,"_20902":116201,"_5":14358,"_27381":116159,"_2946":49361},[],{"_3461":70088,"_30095":70069,"_20902":116203,"_5":14358,"_27381":116159,"_2946":116204},[],"Hasta 10.000",{"_3461":70089,"_30095":70069,"_20902":116206,"_5":14358,"_27381":116159,"_2946":116207},[],"Email y chat",{"_3461":70090,"_30095":70069,"_20902":116209,"_5":14358,"_27381":116159,"_2946":116210},[],"99,9 %",{"_3461":70091,"_30095":70069,"_20902":116212,"_5":14358,"_27381":116159,"_2946":49373},[],{"_3461":70092,"_30095":70069,"_20902":116214,"_5":14358,"_27381":116159,"_2946":116215},[],"Ilimitados",{"_3461":70093,"_30095":70069,"_20902":116217,"_5":14358,"_27381":116159,"_2946":116218},[],"Dedicado",{"_3461":70094,"_30095":70069,"_20902":116220,"_5":14358,"_27381":116159,"_2946":116221},[],"99,99 %",{"_3461":70095,"_30095":70069,"_20902":116223,"_5":14358,"_27381":116163,"_2946":116224},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3461":70096,"_30095":70069,"_20902":116226,"_5":14358,"_27381":116163,"_2946":116227},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3461":70097,"_30095":70097,"_5":14710,"_2946":49390,"_30448":116229,"_20902":116231,"_27381":70097},[49146,115996,116230],"Kubernetes autogestionado",[],{"_3461":70098,"_30095":70097,"_20902":116233,"_5":14358,"_27381":70097,"_2946":116234},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3461":70099,"_30095":70097,"_5":30445,"_20902":116236,"_27381":116237,"_2946":116238},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3461":70100,"_30095":70097,"_5":30445,"_20902":116240,"_27381":116241,"_2946":116242},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3461":70101,"_30095":70097,"_5":30445,"_20902":116244,"_27381":116245,"_2946":116246},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3461":70102,"_30095":70097,"_5":30445,"_20902":116248,"_27381":116249,"_2946":116250},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3461":70103,"_30095":70097,"_5":30445,"_20902":116252,"_27381":116253,"_2946":116254},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3461":70104,"_30095":70097,"_5":30445,"_20902":116256,"_27381":116257,"_2946":116258},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3461":70105,"_30095":70097,"_5":30445,"_20902":116260,"_27381":116261,"_2946":116262},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3461":70106,"_30095":70097,"_5":30445,"_20902":116264,"_27381":116265,"_2946":116266},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3461":70107,"_30095":70097,"_5":30445,"_20902":116268,"_27381":116269,"_2946":116270},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3461":70108,"_30095":70097,"_5":30445,"_20902":116272,"_27381":116273,"_2946":116274},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3461":70109,"_30095":70097,"_5":30445,"_20902":116276,"_27381":116277,"_2946":116278},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3461":70110,"_30095":70097,"_20902":116280,"_5":14358,"_27381":116237,"_2946":116281},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3461":70111,"_30095":70097,"_20902":116283,"_5":14358,"_27381":116237,"_2946":116284},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3461":70112,"_30095":70097,"_20902":116286,"_5":14358,"_27381":116241,"_2946":116287},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3461":70113,"_30095":70097,"_20902":116289,"_5":14358,"_27381":116241,"_2946":116290},[],"Fastlane instala o configura",{"_3461":70114,"_30095":70097,"_20902":116292,"_5":14358,"_27381":116241,"_2946":116293},[],"Tú sigues proporcionando",{"_3461":70115,"_30095":70097,"_20902":116295,"_5":14358,"_27381":116241,"_2946":116296},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3461":70116,"_30095":70097,"_20902":116298,"_5":14358,"_27381":116241,"_2946":116299},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3461":70117,"_30095":70097,"_20902":116301,"_5":14358,"_27381":116241,"_2946":116302},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3461":70118,"_30095":70097,"_20902":116304,"_5":14358,"_27381":116241,"_2946":116305},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3461":70119,"_30095":70097,"_20902":116307,"_5":14358,"_27381":116241,"_2946":116308},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3461":70120,"_30095":70097,"_20902":116310,"_5":14358,"_27381":116241,"_2946":116311},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3461":70121,"_30095":70097,"_20902":116313,"_5":14358,"_27381":116241,"_2946":116314},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3461":70122,"_30095":70097,"_20902":116316,"_5":14358,"_27381":116241,"_2946":116317},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3461":70123,"_30095":70097,"_20902":116319,"_5":14358,"_27381":116241,"_2946":116320},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3461":70124,"_30095":70097,"_20902":116322,"_5":14358,"_27381":116245,"_2946":116323},[],"Necesitas:",{"_3461":70125,"_30095":70097,"_20902":116325,"_5":14358,"_27381":116245,"_2946":116326},[],"un clúster Kubernetes existente",{"_3461":70126,"_30095":70097,"_20902":116328,"_5":14358,"_27381":116245,"_2946":116329},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3461":70127,"_30095":70097,"_20902":116331,"_5":14358,"_27381":116245,"_2946":49492},[],{"_3461":70128,"_30095":70097,"_20902":116333,"_5":14358,"_27381":116245,"_2946":23622},[],{"_3461":70129,"_30095":70097,"_20902":116335,"_5":14358,"_27381":116245,"_2946":116336},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3461":70130,"_30095":70097,"_20902":116338,"_5":14358,"_27381":116245,"_2946":116339},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3461":70131,"_30095":70097,"_20902":116341,"_5":14358,"_27381":116245,"_2946":116342},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3461":70132,"_30095":70097,"_20902":116344,"_5":14358,"_27381":116245,"_2946":116345},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3461":70133,"_30095":70097,"_20902":116347,"_5":14358,"_27381":116245,"_2946":116348},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3461":70134,"_30095":70097,"_20902":116350,"_5":14358,"_27381":116249,"_2946":116351},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3461":70135,"_30095":70097,"_20902":116353,"_5":14358,"_27381":116249,"_2946":116354},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3461":70136,"_30095":70097,"_20902":116356,"_5":14358,"_27381":116253,"_2946":116357},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3461":70137,"_30095":70097,"_20902":116359,"_5":14358,"_27381":116253,"_2946":116360},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3461":70138,"_30095":70097,"_20902":116362,"_5":14358,"_27381":116253,"_2946":116363},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3461":70139,"_30095":70097,"_20902":116365,"_5":14358,"_27381":116253,"_2946":116366},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3461":70140,"_30095":70097,"_20902":116368,"_5":14358,"_27381":116257,"_2946":116369},[],"Opción",{"_3461":70141,"_30095":70097,"_20902":116371,"_5":14358,"_27381":116257,"_2946":116372},[],"Valor predeterminado",{"_3461":70142,"_30095":70097,"_20902":116374,"_5":14358,"_27381":116257,"_2946":116375},[],"Propósito",{"_3461":70143,"_30095":70097,"_20902":116377,"_5":14358,"_27381":116257,"_2946":49539},[],{"_3461":70144,"_30095":70097,"_20902":116379,"_5":14358,"_27381":116257,"_2946":49542},[],{"_3461":70145,"_30095":70097,"_20902":116381,"_5":14358,"_27381":116257,"_2946":116382},[],"Muestra la ayuda",{"_3461":70146,"_30095":70097,"_20902":116384,"_5":14358,"_27381":116257,"_2946":49548},[],{"_3461":70147,"_30095":70097,"_20902":116386,"_5":14358,"_27381":116257,"_2946":116387},[],"contexto actual",{"_3461":70148,"_30095":70097,"_20902":116389,"_5":14358,"_27381":116257,"_2946":116390},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3461":70149,"_30095":70097,"_20902":116392,"_5":14358,"_27381":116257,"_2946":49557},[],{"_3461":70150,"_30095":70097,"_20902":116394,"_5":14358,"_27381":116257,"_2946":6519},[],{"_3461":70151,"_30095":70097,"_20902":116396,"_5":14358,"_27381":116257,"_2946":116397},[],"Omite prompts y genera credenciales para las dependencias",{"_3461":70152,"_30095":70097,"_20902":116399,"_5":14358,"_27381":116257,"_2946":49565},[],{"_3461":70153,"_30095":70097,"_20902":116401,"_5":14358,"_27381":116257,"_2946":49568},[],{"_3461":70154,"_30095":70097,"_20902":116403,"_5":14358,"_27381":116257,"_2946":116404},[],"Namespace de la instalación",{"_3461":70155,"_30095":70097,"_20902":116406,"_5":14358,"_27381":116257,"_2946":49574},[],{"_3461":70156,"_30095":70097,"_20902":116408,"_5":14358,"_27381":116257,"_2946":49577},[],{"_3461":70157,"_30095":70097,"_20902":116410,"_5":14358,"_27381":116257,"_2946":116411},[],"Dominio usado por la UI, OIDC y el certificado",{"_3461":70158,"_30095":70097,"_20902":116413,"_5":14358,"_27381":116257,"_2946":49583},[],{"_3461":70159,"_30095":70097,"_20902":116415,"_5":14358,"_27381":116257,"_2946":15056},[],{"_3461":70160,"_30095":70097,"_20902":116417,"_5":14358,"_27381":116257,"_2946":116418},[],"Versión del chart de Lamassu",{"_3461":70161,"_30095":70097,"_20902":116420,"_5":14358,"_27381":116257,"_2946":49591},[],{"_3461":70162,"_30095":70097,"_20902":116422,"_5":14358,"_27381":116257,"_2946":49594},[],{"_3461":70163,"_30095":70097,"_20902":116424,"_5":14358,"_27381":116257,"_2946":116425},[],"Puerto del listener HTTPS",{"_3461":70164,"_30095":70097,"_20902":116427,"_5":14358,"_27381":116257,"_2946":49600},[],{"_3461":70165,"_30095":70097,"_20902":116429,"_5":14358,"_27381":116257,"_2946":49603},[],{"_3461":70166,"_30095":70097,"_20902":116431,"_5":14358,"_27381":116257,"_2946":116432},[],"Puerto del listener HTTP",{"_3461":70167,"_30095":70097,"_20902":116434,"_5":14358,"_27381":116257,"_2946":49609},[],{"_3461":70168,"_30095":70097,"_20902":116436,"_5":14358,"_27381":116257,"_2946":49542},[],{"_3461":70169,"_30095":70097,"_20902":116438,"_5":14358,"_27381":116257,"_2946":116439},[],"Certificado PEM para TLS downstream",{"_3461":70170,"_30095":70097,"_20902":116441,"_5":14358,"_27381":116257,"_2946":49617},[],{"_3461":70171,"_30095":70097,"_20902":116443,"_5":14358,"_27381":116257,"_2946":49542},[],{"_3461":70172,"_30095":70097,"_20902":116445,"_5":14358,"_27381":116257,"_2946":116446},[],"Clave privada PEM para TLS downstream",{"_3461":70173,"_30095":70097,"_20902":116448,"_5":14358,"_27381":116257,"_2946":49625},[],{"_3461":70174,"_30095":70097,"_20902":116450,"_5":14358,"_27381":116257,"_2946":116451},[],"chart del repositorio",{"_3461":70175,"_30095":70097,"_20902":116453,"_5":14358,"_27381":116257,"_2946":116454},[],"Usa un chart local de Lamassu sin empaquetar",{"_3461":70176,"_30095":70097,"_20902":116456,"_5":14358,"_27381":116257,"_2946":49634},[],{"_3461":70177,"_30095":70097,"_20902":116458,"_5":14358,"_27381":116257,"_2946":116459},[],"detección automática",{"_3461":70178,"_30095":70097,"_20902":116461,"_5":14358,"_27381":116257,"_2946":116462},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3461":70179,"_30095":70097,"_20902":116464,"_5":14358,"_27381":116257,"_2946":49642},[],{"_3461":70180,"_30095":70097,"_20902":116466,"_5":14358,"_27381":116257,"_2946":6519},[],{"_3461":70181,"_30095":70097,"_20902":116468,"_5":14358,"_27381":116257,"_2946":116469},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3461":70182,"_30095":70097,"_20902":116471,"_5":14358,"_27381":116257,"_2946":49650},[],{"_3461":70183,"_30095":70097,"_20902":116473,"_5":14358,"_27381":116257,"_2946":6519},[],{"_3461":70184,"_30095":70097,"_20902":116475,"_5":14358,"_27381":116257,"_2946":116476},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3461":70185,"_30095":70097,"_20902":116478,"_5":14358,"_27381":116257,"_2946":49658},[],{"_3461":70186,"_30095":70097,"_20902":116480,"_5":14358,"_27381":116257,"_2946":6519},[],{"_3461":70187,"_30095":70097,"_20902":116482,"_5":14358,"_27381":116257,"_2946":116483},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3461":70188,"_30095":70097,"_20902":116485,"_5":14358,"_27381":116257,"_2946":49666},[],{"_3461":70189,"_30095":70097,"_20902":116487,"_5":14358,"_27381":116257,"_2946":6519},[],{"_3461":70190,"_30095":70097,"_20902":116489,"_5":14358,"_27381":116257,"_2946":116490},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3461":70191,"_30095":70097,"_20902":116492,"_5":14358,"_27381":116257,"_2946":49674},[],{"_3461":70192,"_30095":70097,"_20902":116494,"_5":14358,"_27381":116257,"_2946":49677},[],{"_3461":70193,"_30095":70097,"_20902":116496,"_5":14358,"_27381":116257,"_2946":116497},[],"Usa otro chart local de SoftHSM",{"_3461":70194,"_30095":70097,"_20902":116499,"_5":14358,"_27381":116257,"_2946":116500},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3461":70195,"_30095":70097,"_20902":116502,"_5":14358,"_27381":116261,"_2946":116503},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3461":70196,"_30095":70097,"_20902":116505,"_5":14358,"_27381":116261,"_2946":116506},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3461":70197,"_30095":70097,"_20902":116508,"_5":14358,"_27381":116261,"_2946":116509},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3461":70198,"_30095":70097,"_20902":116511,"_5":14358,"_27381":116261,"_2946":116512},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3461":70199,"_30095":70097,"_20902":116514,"_5":14358,"_27381":116261,"_2946":116515},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3461":70200,"_30095":70097,"_20902":116517,"_5":14358,"_27381":116261,"_2946":116518},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3461":70201,"_30095":70097,"_20902":116520,"_5":14358,"_27381":116265,"_2946":49704},[],{"_3461":70202,"_30095":70097,"_20902":116522,"_5":14358,"_27381":116265,"_2946":116523},[],"valida las herramientas locales y el clúster seleccionado",{"_3461":70203,"_30095":70097,"_20902":116525,"_5":14358,"_27381":116265,"_2946":116526},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3461":70204,"_30095":70097,"_20902":116528,"_5":14358,"_27381":116265,"_2946":116529},[],"crea el namespace",{"_3461":70205,"_30095":70097,"_20902":116531,"_5":14358,"_27381":116265,"_2946":116532},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3461":70206,"_30095":70097,"_20902":116534,"_5":14358,"_27381":116265,"_2946":116535},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3461":70207,"_30095":70097,"_20902":116537,"_5":14358,"_27381":116265,"_2946":116538},[],"instala RabbitMQ",{"_3461":70208,"_30095":70097,"_20902":116540,"_5":14358,"_27381":116265,"_2946":116541},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3461":70209,"_30095":70097,"_20902":116543,"_5":14358,"_27381":116265,"_2946":116544},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3461":70210,"_30095":70097,"_20902":116546,"_5":14358,"_27381":116265,"_2946":116547},[],"carga datos de ejemplo opcionalmente",{"_3461":70211,"_30095":70097,"_20902":116549,"_5":14358,"_27381":116265,"_2946":116550},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3461":70212,"_30095":70097,"_20902":116552,"_5":14358,"_27381":116269,"_2946":116553},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3461":70213,"_30095":70097,"_20902":116555,"_5":14358,"_27381":116269,"_2946":116556},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3461":70214,"_30095":70097,"_20902":116558,"_5":14358,"_27381":116273,"_2946":116559},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3461":70215,"_30095":70097,"_20902":116561,"_5":14358,"_27381":116273,"_2946":116562},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3461":70216,"_30095":70097,"_20902":116564,"_5":14358,"_27381":116273,"_2946":116565},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3461":70217,"_30095":70097,"_20902":116567,"_5":14358,"_27381":116277,"_2946":116568},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3461":70218,"_30095":70218,"_5":14710,"_2946":116570,"_30448":116571,"_20902":116572,"_27381":70218},"Instala con Helm",[49146,115996,116230],[],{"_3461":70219,"_30095":70218,"_20902":116574,"_5":14358,"_27381":70218,"_2946":116575},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3461":70220,"_30095":70218,"_5":30445,"_20902":116577,"_27381":116578,"_2946":116579},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3461":70221,"_30095":70218,"_5":30445,"_20902":116581,"_27381":116582,"_2946":116246},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3461":70222,"_30095":70218,"_5":30445,"_20902":116584,"_27381":116585,"_2946":116586},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3461":70223,"_30095":70218,"_5":30445,"_20902":116588,"_27381":116589,"_2946":116590},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3461":70224,"_30095":70218,"_5":30445,"_20902":116592,"_27381":116593,"_2946":116594},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3461":70225,"_30095":70218,"_5":30445,"_20902":116596,"_27381":116597,"_2946":116598},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3461":70226,"_30095":70218,"_5":30445,"_20902":116600,"_27381":116601,"_2946":116602},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3461":70227,"_30095":70218,"_5":30445,"_20902":116604,"_27381":116605,"_2946":116606},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3461":70228,"_30095":70218,"_5":30445,"_20902":116608,"_27381":116609,"_2946":116610},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3461":70229,"_30095":70218,"_5":30445,"_20902":116612,"_27381":116613,"_2946":116614},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3461":70230,"_30095":70218,"_5":30445,"_20902":116616,"_27381":116617,"_2946":116618},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3461":70231,"_30095":70218,"_20902":116620,"_5":14358,"_27381":116578,"_2946":116621},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3461":70232,"_30095":70218,"_20902":116623,"_5":14358,"_27381":116582,"_2946":116624},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3461":70233,"_30095":70218,"_20902":116626,"_5":14358,"_27381":116582,"_2946":116627},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3461":70234,"_30095":70218,"_20902":116629,"_5":14358,"_27381":116582,"_2946":116630},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3461":70235,"_30095":70218,"_20902":116632,"_5":14358,"_27381":116582,"_2946":116633},[],"un broker RabbitMQ accesible y sus credenciales",{"_3461":70236,"_30095":70218,"_20902":116635,"_5":14358,"_27381":116582,"_2946":116636},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3461":70237,"_30095":70218,"_20902":116638,"_5":14358,"_27381":116582,"_2946":116639},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3461":70238,"_30095":70218,"_20902":116641,"_5":14358,"_27381":116582,"_2946":116642},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3461":70239,"_30095":70218,"_20902":116644,"_5":14358,"_27381":116582,"_2946":116645},[],"una StorageClass y un diseño de tráfico externo",{"_3461":70240,"_30095":70218,"_20902":116647,"_5":14358,"_27381":116582,"_2946":116648},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3461":70241,"_30095":70218,"_20902":116650,"_5":14358,"_27381":116582,"_2946":116651},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3461":70242,"_30095":70218,"_20902":116653,"_5":14358,"_27381":116582,"_2946":116654},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3461":70243,"_30095":70218,"_20902":116656,"_5":14358,"_27381":116585,"_2946":116657},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3461":70244,"_30095":70218,"_20902":116659,"_5":14358,"_27381":116585,"_2946":116660},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3461":70245,"_30095":70218,"_20902":116662,"_5":14358,"_27381":116585,"_2946":116663},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3461":70246,"_30095":70218,"_20902":116665,"_5":14358,"_27381":116589,"_2946":116666},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3461":70247,"_30095":70218,"_20902":116668,"_5":14358,"_27381":116589,"_2946":116669},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3461":70248,"_30095":70218,"_20902":116671,"_5":14358,"_27381":116589,"_2946":116672},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3461":70249,"_30095":70218,"_20902":116674,"_5":14358,"_27381":116589,"_2946":116675},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3461":70250,"_30095":70218,"_20902":116677,"_5":14358,"_27381":116593,"_2946":116678},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3461":70251,"_30095":70218,"_20902":116680,"_5":14358,"_27381":116597,"_2946":116681},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3461":70252,"_30095":70218,"_20902":116683,"_5":14358,"_27381":116597,"_2946":116684},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3461":70253,"_30095":70218,"_20902":116686,"_5":14358,"_27381":116597,"_2946":116687},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3461":70254,"_30095":70218,"_20902":116689,"_5":14358,"_27381":116597,"_2946":116690},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3461":70255,"_30095":70218,"_20902":116692,"_5":14358,"_27381":116597,"_2946":116693},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3461":70256,"_30095":70218,"_20902":116695,"_5":14358,"_27381":116597,"_2946":116696},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3461":70257,"_30095":70218,"_20902":116698,"_5":14358,"_27381":116597,"_2946":116699},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3461":70258,"_30095":70218,"_20902":116701,"_5":14358,"_27381":116601,"_2946":116702},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3461":70259,"_30095":70218,"_20902":116704,"_5":14358,"_27381":116601,"_2946":116705},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3461":70260,"_30095":70218,"_20902":116707,"_5":14358,"_27381":116601,"_2946":116708},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3461":70261,"_30095":70218,"_20902":116710,"_5":14358,"_27381":116601,"_2946":116711},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3461":70262,"_30095":70218,"_20902":116713,"_5":14358,"_27381":116605,"_2946":116714},[],"Para instalar un checkout local:",{"_3461":70263,"_30095":70218,"_20902":116716,"_5":14358,"_27381":116609,"_2946":116717},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3461":70264,"_30095":70218,"_20902":116719,"_5":14358,"_27381":116609,"_2946":116720},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3461":70265,"_30095":70218,"_20902":116722,"_5":14358,"_27381":116613,"_2946":116723},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3461":70266,"_30095":70218,"_20902":116725,"_5":14358,"_27381":116613,"_2946":116726},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3461":70267,"_30095":70218,"_20902":116728,"_5":14358,"_27381":116613,"_2946":116729},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3461":70268,"_30095":70218,"_20902":116731,"_5":14358,"_27381":116613,"_2946":116732},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3461":70269,"_30095":70218,"_20902":116734,"_5":14358,"_27381":116613,"_2946":116735},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3461":70270,"_30095":70218,"_20902":116737,"_5":14358,"_27381":116617,"_2946":116738},[],"Antes de pasar a producción, revisa:",{"_3461":70271,"_30095":70218,"_20902":116740,"_5":14358,"_27381":116617,"_2946":116741},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3461":70272,"_30095":70218,"_20902":116743,"_5":14358,"_27381":116617,"_2946":116744},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3461":70273,"_30095":70218,"_20902":116746,"_5":14358,"_27381":116617,"_2946":116747},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3461":70274,"_30095":70218,"_20902":116749,"_5":14358,"_27381":116617,"_2946":116750},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3461":70275,"_30095":70218,"_20902":116752,"_5":14358,"_27381":116617,"_2946":116753},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3461":70276,"_30095":70218,"_20902":116755,"_5":14358,"_27381":116617,"_2946":116756},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3461":70277,"_30095":70218,"_20902":116758,"_5":14358,"_27381":116617,"_2946":116759},[],"SMTP, observabilidad y entrega de alertas",{"_3461":70278,"_30095":70218,"_20902":116761,"_5":14358,"_27381":116617,"_2946":116762},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3461":70279,"_30095":70218,"_20902":116764,"_5":14358,"_27381":116617,"_2946":116765},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3461":70280,"_30095":70280,"_5":14710,"_2946":116767,"_30448":116768,"_20902":116769,"_27381":70280},"Expón el Gateway",[49146,115996,116230],[],{"_3461":70281,"_30095":70280,"_20902":116771,"_5":14358,"_27381":70280,"_2946":116772},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3461":70282,"_30095":70280,"_5":30445,"_20902":116774,"_27381":116775,"_2946":116776},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3461":70283,"_30095":70280,"_5":30445,"_20902":116778,"_27381":116779,"_2946":116780},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3461":70284,"_30095":70280,"_5":30445,"_20902":116782,"_27381":116783,"_2946":116784},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3461":70285,"_30095":70280,"_5":30445,"_20902":116786,"_27381":116787,"_2946":49972},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#k3s",{"_3461":70286,"_30095":70280,"_5":30445,"_20902":116789,"_27381":116790,"_2946":116791},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3461":70287,"_30095":70280,"_5":30445,"_20902":116793,"_27381":116794,"_2946":116795},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3461":70288,"_30095":70280,"_5":30445,"_20902":116797,"_27381":116798,"_2946":116799},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3461":70289,"_30095":70280,"_5":30445,"_20902":116801,"_27381":116802,"_2946":116803},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3461":70290,"_30095":70280,"_5":30445,"_20902":116805,"_27381":116806,"_2946":116807},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3461":70291,"_30095":70280,"_5":30445,"_20902":116809,"_27381":116810,"_2946":116811},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3461":70292,"_30095":70280,"_20902":116813,"_5":14358,"_27381":116775,"_2946":116814},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3461":70293,"_30095":70280,"_20902":116816,"_5":14358,"_27381":116775,"_2946":116817},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3461":70294,"_30095":70280,"_20902":116819,"_5":14358,"_27381":116779,"_2946":116820},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3461":70295,"_30095":70280,"_20902":116822,"_5":14358,"_27381":116779,"_2946":116823},[],"Defínelo únicamente cuando:",{"_3461":70296,"_30095":70280,"_20902":116825,"_5":14358,"_27381":116779,"_2946":116826},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3461":70297,"_30095":70280,"_20902":116828,"_5":14358,"_27381":116779,"_2946":116829},[],"esa dirección está asignada a este Gateway",{"_3461":70298,"_30095":70280,"_20902":116831,"_5":14358,"_27381":116779,"_2946":116832},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3461":70299,"_30095":70280,"_20902":116834,"_5":14358,"_27381":116779,"_2946":116835},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3461":70300,"_30095":70280,"_20902":116837,"_5":14358,"_27381":116779,"_2946":116838},[],"No confundas estos valores:",{"_3461":70301,"_30095":70280,"_20902":116840,"_5":14358,"_27381":116779,"_2946":116841},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3461":70302,"_30095":70280,"_20902":116843,"_5":14358,"_27381":116779,"_2946":116844},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3461":70303,"_30095":70280,"_20902":116846,"_5":14358,"_27381":116779,"_2946":116847},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3461":70304,"_30095":70280,"_20902":116849,"_5":14358,"_27381":116783,"_2946":116850},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3461":70305,"_30095":70280,"_20902":116852,"_5":14358,"_27381":116783,"_2946":116853},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3461":70306,"_30095":70280,"_20902":116855,"_5":14358,"_27381":116787,"_2946":116856},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3461":70307,"_30095":70280,"_20902":116858,"_5":14358,"_27381":116787,"_2946":116859},[],"Para el diseño recomendado:",{"_3461":70308,"_30095":70280,"_20902":116861,"_5":14358,"_27381":116787,"_2946":116862},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3461":70309,"_30095":70280,"_20902":116864,"_5":14358,"_27381":116787,"_2946":116865},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3461":70310,"_30095":70280,"_20902":116867,"_5":14358,"_27381":116787,"_2946":116868},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3461":70311,"_30095":70280,"_20902":116870,"_5":14358,"_27381":116787,"_2946":116871},[],"Apunta DNS a la dirección accesible de la VM.",{"_3461":70312,"_30095":70280,"_20902":116873,"_5":14358,"_27381":116787,"_2946":116874},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3461":70313,"_30095":70280,"_20902":116876,"_5":14358,"_27381":116790,"_2946":116877},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3461":70314,"_30095":70280,"_20902":116879,"_5":14358,"_27381":116794,"_2946":116880},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3461":70315,"_30095":70280,"_20902":116882,"_5":14358,"_27381":116794,"_2946":116883},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3461":70316,"_30095":70280,"_20902":116885,"_5":14358,"_27381":116798,"_2946":116886},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3461":70317,"_30095":70280,"_20902":116888,"_5":14358,"_27381":116798,"_2946":116889},[],"Requisito",{"_3461":70318,"_30095":70280,"_20902":116891,"_5":14358,"_27381":116798,"_2946":116892},[],"Diseño recomendado",{"_3461":70319,"_30095":70280,"_20902":116894,"_5":14358,"_27381":116798,"_2946":116895},[],"Consecuencia",{"_3461":70320,"_30095":70280,"_20902":116897,"_5":14358,"_27381":116798,"_2946":116898},[],"Varias URL o servicios de Lamassu",{"_3461":70321,"_30095":70280,"_20902":116900,"_5":14358,"_27381":116798,"_2946":116901},[],"Un Gateway con varias rutas",{"_3461":70322,"_30095":70280,"_20902":116903,"_5":14358,"_27381":116798,"_2946":116904},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3461":70323,"_30095":70280,"_20902":116906,"_5":14358,"_27381":116798,"_2946":116907},[],"Gateways independientes e IP externas distintas",{"_3461":70324,"_30095":70280,"_20902":116909,"_5":14358,"_27381":116798,"_2946":116910},[],"Una VIP por Gateway",{"_3461":70325,"_30095":70280,"_20902":116912,"_5":14358,"_27381":116798,"_2946":116913},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3461":70326,"_30095":70280,"_20902":116915,"_5":14358,"_27381":116798,"_2946":116916},[],"Gateways independientes, un nodo y una IP",{"_3461":70327,"_30095":70280,"_20902":116918,"_5":14358,"_27381":116798,"_2946":116919},[],"Puertos externos diferentes",{"_3461":70328,"_30095":70280,"_20902":116921,"_5":14358,"_27381":116798,"_2946":116922},[],"Los clientes deben indicar puertos no estándar",{"_3461":70329,"_30095":70280,"_20902":116924,"_5":14358,"_27381":116798,"_2946":116925},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3461":70330,"_30095":70280,"_20902":116927,"_5":14358,"_27381":116798,"_2946":116928},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3461":70331,"_30095":70280,"_20902":116930,"_5":14358,"_27381":116798,"_2946":116931},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3461":70332,"_30095":70280,"_20902":116933,"_5":14358,"_27381":116798,"_2946":116934},[],"Recursos Gateway separados pero proxy compartido",{"_3461":70333,"_30095":70280,"_20902":116936,"_5":14358,"_27381":116798,"_2946":116937},[],"Modo merged Gateway de Envoy",{"_3461":70334,"_30095":70280,"_20902":116939,"_5":14358,"_27381":116798,"_2946":116940},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3461":70335,"_30095":70280,"_20902":116942,"_5":14358,"_27381":116798,"_2946":116943},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3461":70336,"_30095":70280,"_20902":116945,"_5":14358,"_27381":116798,"_2946":116946},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3461":70337,"_30095":70280,"_20902":116948,"_5":14358,"_27381":116798,"_2946":116949},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3461":70338,"_30095":70280,"_20902":116951,"_5":14358,"_27381":116798,"_2946":116952},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3461":70339,"_30095":70280,"_20902":116954,"_5":14358,"_27381":116802,"_2946":116955},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3461":70340,"_30095":70280,"_20902":116957,"_5":14358,"_27381":116802,"_2946":116958},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3461":70341,"_30095":70280,"_20902":116960,"_5":14358,"_27381":116802,"_2946":116961},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3461":70342,"_30095":70280,"_20902":116963,"_5":14358,"_27381":116802,"_2946":116964},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3461":70343,"_30095":70280,"_20902":116966,"_5":14358,"_27381":116802,"_2946":116967},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3461":70344,"_30095":70280,"_20902":116969,"_5":14358,"_27381":116806,"_2946":116970},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3461":70345,"_30095":70280,"_20902":116972,"_5":14358,"_27381":116806,"_2946":116973},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3461":70346,"_30095":70280,"_20902":116975,"_5":14358,"_27381":116810,"_2946":116976},[],"Comprueba, en orden:",{"_3461":70347,"_30095":70280,"_20902":116978,"_5":14358,"_27381":116810,"_2946":116979},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3461":70348,"_30095":70280,"_20902":116981,"_5":14358,"_27381":116810,"_2946":116982},[],"Su estado contiene la dirección esperada.",{"_3461":70349,"_30095":70280,"_20902":116984,"_5":14358,"_27381":116810,"_2946":116985},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3461":70350,"_30095":70280,"_20902":116987,"_5":14358,"_27381":116810,"_2946":116988},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3461":70351,"_30095":70280,"_20902":116990,"_5":14358,"_27381":116810,"_2946":116991},[],"DNS resuelve al endpoint accesible externamente.",{"_3461":70352,"_30095":70280,"_20902":116993,"_5":14358,"_27381":116810,"_2946":116994},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3461":70353,"_30095":70280,"_20902":116996,"_5":14358,"_27381":116810,"_2946":116997},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3461":70354,"_30095":70354,"_5":14710,"_2946":49253,"_30448":116999,"_20902":117000,"_27381":70354},[49146,115996,116230],[],{"_3461":70355,"_30095":70354,"_20902":117002,"_5":14358,"_27381":70354,"_2946":117003},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3461":70356,"_30095":70354,"_5":30445,"_20902":117005,"_27381":117006,"_2946":117007},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3461":70357,"_30095":70354,"_5":30445,"_20902":117009,"_27381":117010,"_2946":117011},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3461":70358,"_30095":70354,"_5":30445,"_20902":117013,"_27381":117014,"_2946":117015},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3461":70359,"_30095":70354,"_5":30445,"_20902":117017,"_27381":117018,"_2946":117019},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3461":70360,"_30095":70354,"_5":30445,"_20902":117021,"_27381":117022,"_2946":117023},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3461":70361,"_30095":70354,"_5":30445,"_20902":117025,"_27381":117026,"_2946":117027},[],"/docs/pr-preview/pr-60/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3461":70362,"_30095":70354,"_20902":117029,"_5":14358,"_27381":117006,"_2946":117030},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3461":70363,"_30095":70354,"_20902":117032,"_5":14358,"_27381":117010,"_2946":117033},[],"Flujo",{"_3461":70364,"_30095":70354,"_20902":117035,"_5":14358,"_27381":117010,"_2946":117036},[],"Úsalo para",{"_3461":70365,"_30095":70354,"_20902":117038,"_5":14358,"_27381":117010,"_2946":117039},[],"Qué instala",{"_3461":70366,"_30095":70354,"_20902":117041,"_5":14358,"_27381":117010,"_2946":50227},[],{"_3461":70367,"_30095":70354,"_20902":117043,"_5":14358,"_27381":117010,"_2946":117044},[],"Producción y entornos controlados",{"_3461":70368,"_30095":70354,"_20902":117046,"_5":14358,"_27381":117010,"_2946":117047},[],"Servicios de Lamassu y recursos de Gateway API",{"_3461":70369,"_30095":70354,"_20902":117049,"_5":14358,"_27381":117010,"_2946":49390},[],{"_3461":70370,"_30095":70354,"_20902":117051,"_5":14358,"_27381":117010,"_2946":117052},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3461":70371,"_30095":70354,"_20902":117054,"_5":14358,"_27381":117010,"_2946":117055},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3461":70372,"_30095":70354,"_20902":117057,"_5":14358,"_27381":117014,"_2946":117058},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3461":70373,"_30095":70354,"_20902":117060,"_5":14358,"_27381":117014,"_2946":117061},[],"Área",{"_3461":70374,"_30095":70354,"_20902":117063,"_5":14358,"_27381":117014,"_2946":117064},[],"El chart de Lamassu proporciona",{"_3461":70375,"_30095":70354,"_20902":117066,"_5":14358,"_27381":117014,"_2946":117067},[],"Tú proporcionas",{"_3461":70376,"_30095":70354,"_20902":117069,"_5":14358,"_27381":117014,"_2946":117070},[],"Aplicaciones Lamassu",{"_3461":70377,"_30095":70354,"_20902":117072,"_5":14358,"_27381":117014,"_2946":117073},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3461":70378,"_30095":70354,"_20902":117075,"_5":14358,"_27381":117014,"_2946":117076},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3461":70379,"_30095":70354,"_20902":117078,"_5":14358,"_27381":117014,"_2946":117079},[],"Datos PostgreSQL",{"_3461":70380,"_30095":70354,"_20902":117081,"_5":14358,"_27381":117014,"_2946":117082},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3461":70381,"_30095":70354,"_20902":117084,"_5":14358,"_27381":117014,"_2946":117085},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3461":70382,"_30095":70354,"_20902":117087,"_5":14358,"_27381":117014,"_2946":117088},[],"Mensajería",{"_3461":70383,"_30095":70354,"_20902":117090,"_5":14358,"_27381":117014,"_2946":117091},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3461":70384,"_30095":70354,"_20902":117093,"_5":14358,"_27381":117014,"_2946":117094},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3461":70385,"_30095":70354,"_20902":117096,"_5":14358,"_27381":117014,"_2946":117097},[],"Identidad",{"_3461":70386,"_30095":70354,"_20902":117099,"_5":14358,"_27381":117014,"_2946":117100},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3461":70387,"_30095":70354,"_20902":117102,"_5":14358,"_27381":117014,"_2946":117103},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3461":70388,"_30095":70354,"_20902":117105,"_5":14358,"_27381":117014,"_2946":117106},[],"Enrutamiento externo",{"_3461":70389,"_30095":70354,"_20902":117108,"_5":14358,"_27381":117014,"_2946":117109},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3461":70390,"_30095":70354,"_20902":117111,"_5":14358,"_27381":117014,"_2946":117112},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3461":70391,"_30095":70354,"_20902":117114,"_5":14358,"_27381":117014,"_2946":50301},[],{"_3461":70392,"_30095":70354,"_20902":117116,"_5":14358,"_27381":117014,"_2946":117117},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3461":70393,"_30095":70354,"_20902":117119,"_5":14358,"_27381":117014,"_2946":117120},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3461":70394,"_30095":70354,"_20902":117122,"_5":14358,"_27381":117014,"_2946":117123},[],"Datos persistentes de la aplicación",{"_3461":70395,"_30095":70354,"_20902":117125,"_5":14358,"_27381":117014,"_2946":117126},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3461":70396,"_30095":70354,"_20902":117128,"_5":14358,"_27381":117014,"_2946":117129},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3461":70397,"_30095":70354,"_20902":117131,"_5":14358,"_27381":117014,"_2946":117132},[],"Integraciones opcionales",{"_3461":70398,"_30095":70354,"_20902":117134,"_5":14358,"_27381":117014,"_2946":117135},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3461":70399,"_30095":70354,"_20902":117137,"_5":14358,"_27381":117014,"_2946":117138},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3461":70400,"_30095":70354,"_20902":117140,"_5":14358,"_27381":117014,"_2946":117141},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3461":70401,"_30095":70354,"_20902":117143,"_5":14358,"_27381":117014,"_2946":117144},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3461":70402,"_30095":70354,"_20902":117146,"_5":14358,"_27381":117018,"_2946":117147},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3461":70403,"_30095":70354,"_20902":117149,"_5":14358,"_27381":117018,"_2946":117150},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3461":70404,"_30095":70354,"_20902":117152,"_5":14358,"_27381":117022,"_2946":117153},[],"Kubernetes 1.24 o posterior",{"_3461":70405,"_30095":70354,"_20902":117155,"_5":14358,"_27381":117022,"_2946":117156},[],"Helm 3.2 o posterior",{"_3461":70406,"_30095":70354,"_20902":117158,"_5":14358,"_27381":117022,"_2946":117159},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3461":70407,"_30095":70354,"_20902":117161,"_5":14358,"_27381":117022,"_2946":117162},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3461":70408,"_30095":70354,"_20902":117164,"_5":14358,"_27381":117022,"_2946":117165},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3461":70409,"_30095":70354,"_20902":117167,"_5":14358,"_27381":117022,"_2946":117168},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3461":70410,"_30095":70354,"_20902":117170,"_5":14358,"_27381":117022,"_2946":117171},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3461":70411,"_30095":70354,"_20902":117173,"_5":14358,"_27381":117026,"_2946":117174},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3461":70412,"_30095":70354,"_20902":117176,"_5":14358,"_27381":117026,"_2946":117177},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3461":70413,"_30095":70354,"_20902":117179,"_5":14358,"_27381":117026,"_2946":117180},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3461":70414,"_30095":70354,"_20902":117182,"_5":14358,"_27381":117026,"_2946":117183},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3461":70415,"_30095":70415,"_5":14710,"_2946":117185,"_30448":117186,"_20902":117188,"_27381":70415},"Resolución de problemas de despliegue",[49146,115996,117187],"Operación",[],{"_3461":70416,"_30095":70415,"_20902":117190,"_5":14358,"_27381":70415,"_2946":117191},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3461":70417,"_30095":70415,"_5":30445,"_20902":117193,"_27381":117194,"_2946":117195},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3461":70418,"_30095":70415,"_5":30445,"_20902":117197,"_27381":117198,"_2946":117199},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3461":70419,"_30095":70415,"_5":30445,"_20902":117201,"_27381":117202,"_2946":117203},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3461":70420,"_30095":70415,"_5":30445,"_20902":117205,"_27381":117206,"_2946":117207},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3461":70421,"_30095":70415,"_5":30445,"_20902":117209,"_27381":117210,"_2946":117211},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3461":70422,"_30095":70415,"_5":30445,"_20902":117213,"_27381":117214,"_2946":117215},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3461":70423,"_30095":70415,"_5":30445,"_20902":117217,"_27381":117218,"_2946":117219},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3461":70424,"_30095":70415,"_5":30445,"_20902":117221,"_27381":117222,"_2946":117223},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3461":70425,"_30095":70415,"_5":30445,"_20902":117225,"_27381":117226,"_2946":117227},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3461":70426,"_30095":70415,"_5":30445,"_20902":117229,"_27381":117230,"_2946":117231},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3461":70427,"_30095":70415,"_5":30445,"_20902":117233,"_27381":117234,"_2946":117235},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3461":70428,"_30095":70415,"_5":30445,"_20902":117237,"_27381":117238,"_2946":117239},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3461":70429,"_30095":70415,"_5":30445,"_20902":117241,"_27381":117242,"_2946":117243},[],"/docs/pr-preview/pr-60/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3461":70430,"_30095":70415,"_20902":117245,"_5":14358,"_27381":70415,"_2946":117246},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3461":70431,"_30095":70415,"_20902":117248,"_5":14358,"_27381":117198,"_2946":117249},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3461":70432,"_30095":70415,"_20902":117251,"_5":14358,"_27381":117202,"_2946":117252},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3461":70433,"_30095":70415,"_20902":117254,"_5":14358,"_27381":117206,"_2946":117255},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3461":70434,"_30095":70415,"_20902":117257,"_5":14358,"_27381":117210,"_2946":117258},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3461":70435,"_30095":70415,"_20902":117260,"_5":14358,"_27381":117214,"_2946":117261},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3461":70436,"_30095":70415,"_20902":117263,"_5":14358,"_27381":117218,"_2946":117264},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3461":70437,"_30095":70415,"_20902":117266,"_5":14358,"_27381":117218,"_2946":117267},[],"Ejecuta también la prueba de conectividad del chart:",{"_3461":70438,"_30095":70415,"_20902":117269,"_5":14358,"_27381":117218,"_2946":117270},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3461":70439,"_30095":70415,"_20902":117272,"_5":14358,"_27381":117218,"_2946":117273},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3461":70440,"_30095":70415,"_20902":117275,"_5":14358,"_27381":117222,"_2946":117276},[],"Si recibes un 401:",{"_3461":70441,"_30095":70415,"_20902":117278,"_5":14358,"_27381":117222,"_2946":117279},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3461":70442,"_30095":70415,"_20902":117281,"_5":14358,"_27381":117222,"_2946":117282},[],"verifica emisor, audiencia y expiración del token;",{"_3461":70443,"_30095":70415,"_20902":117284,"_5":14358,"_27381":117222,"_2946":117285},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3461":70444,"_30095":70415,"_20902":117287,"_5":14358,"_27381":117222,"_2946":117288},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3461":70445,"_30095":70415,"_20902":117290,"_5":14358,"_27381":117222,"_2946":117291},[],"Si el login termina pero las APIs devuelven 403:",{"_3461":70446,"_30095":70415,"_20902":117293,"_5":14358,"_27381":117222,"_2946":117294},[],"inspecciona los claims reales del token;",{"_3461":70447,"_30095":70415,"_20902":117296,"_5":14358,"_27381":117222,"_2946":117297},[],"confirma que coinciden con un principal activo;",{"_3461":70448,"_30095":70415,"_20902":117299,"_5":14358,"_27381":117222,"_2946":117300},[],"revisa las políticas concedidas al principal;",{"_3461":70449,"_30095":70415,"_20902":117302,"_5":14358,"_27381":117222,"_2946":117303},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3461":70450,"_30095":70415,"_20902":117305,"_5":14358,"_27381":117222,"_2946":117306},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3461":70451,"_30095":70415,"_20902":117308,"_5":14358,"_27381":117226,"_2946":117309},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3461":70452,"_30095":70415,"_20902":117311,"_5":14358,"_27381":117226,"_2946":117312},[],"Localiza el pod y Service de authz.",{"_3461":70453,"_30095":70415,"_20902":117314,"_5":14358,"_27381":117226,"_2946":117315},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3461":70454,"_30095":70415,"_20902":117317,"_5":14358,"_27381":117226,"_2946":117318},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3461":70455,"_30095":70415,"_20902":117320,"_5":14358,"_27381":117226,"_2946":117321},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3461":70456,"_30095":70415,"_20902":117323,"_5":14358,"_27381":117226,"_2946":117324},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3461":70457,"_30095":70415,"_20902":117326,"_5":14358,"_27381":117230,"_2946":117327},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3461":70458,"_30095":70415,"_20902":117329,"_5":14358,"_27381":117234,"_2946":117330},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3461":70459,"_30095":70415,"_20902":117332,"_5":14358,"_27381":117234,"_2946":117333},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3461":70460,"_30095":70415,"_20902":117335,"_5":14358,"_27381":117234,"_2946":117336},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3461":70461,"_30095":70415,"_20902":117338,"_5":14358,"_27381":117234,"_2946":117339},[],"volumen persistente sin enlazar;",{"_3461":70462,"_30095":70415,"_20902":117341,"_5":14358,"_27381":117234,"_2946":117342},[],"imagen inaccesible o política de pull incorrecta;",{"_3461":70463,"_30095":70415,"_20902":117344,"_5":14358,"_27381":117234,"_2946":117345},[],"configuración inválida del motor criptográfico;",{"_3461":70464,"_30095":70415,"_20902":117347,"_5":14358,"_27381":117234,"_2946":117348},[],"límites de CPU o memoria demasiado bajos;",{"_3461":70465,"_30095":70415,"_20902":117350,"_5":14358,"_27381":117234,"_2946":117351},[],"migración previa incompleta.",{"_3461":70466,"_30095":70415,"_20902":117353,"_5":14358,"_27381":117234,"_2946":117354},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3461":70467,"_30095":70415,"_20902":117356,"_5":14358,"_27381":117234,"_2946":117357},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3461":70468,"_30095":70415,"_20902":117359,"_5":14358,"_27381":117234,"_2946":117360},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3461":70469,"_30095":70415,"_20902":117362,"_5":14358,"_27381":117238,"_2946":117363},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3461":70470,"_30095":70415,"_20902":117365,"_5":14358,"_27381":117238,"_2946":117366},[],"verifica que esté habilitado en el servicio emisor;",{"_3461":70471,"_30095":70415,"_20902":117368,"_5":14358,"_27381":117238,"_2946":117369},[],"comprueba conectividad y credenciales AMQP;",{"_3461":70472,"_30095":70415,"_20902":117371,"_5":14358,"_27381":117238,"_2946":117372},[],"revisa exchange, routing key, colas y consumidores;",{"_3461":70473,"_30095":70415,"_20902":117374,"_5":14358,"_27381":117238,"_2946":117375},[],"inspecciona dead-letter queues;",{"_3461":70474,"_30095":70415,"_20902":117377,"_5":14358,"_27381":117238,"_2946":117378},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3461":70475,"_30095":70415,"_20902":117380,"_5":14358,"_27381":117238,"_2946":117381},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3461":70476,"_30095":70415,"_20902":117383,"_5":14358,"_27381":117238,"_2946":117384},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3461":70477,"_30095":70415,"_20902":117386,"_5":14358,"_27381":117238,"_2946":117387},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3461":70478,"_30095":70415,"_20902":117389,"_5":14358,"_27381":117238,"_2946":117390},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3461":70479,"_30095":70415,"_20902":117392,"_5":14358,"_27381":117238,"_2946":117393},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3461":70480,"_30095":70415,"_20902":117395,"_5":14358,"_27381":117238,"_2946":117396},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3461":70481,"_30095":70415,"_20902":117398,"_5":14358,"_27381":117238,"_2946":117399},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3461":70482,"_30095":70415,"_20902":117401,"_5":14358,"_27381":117242,"_2946":117402},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3461":70483,"_30095":70415,"_20902":117404,"_5":14358,"_27381":117242,"_2946":117405},[],"Antes de cerrar una incidencia, guarda:",{"_3461":70484,"_30095":70415,"_20902":117407,"_5":14358,"_27381":117242,"_2946":117408},[],"causa confirmada;",{"_3461":70485,"_30095":70415,"_20902":117410,"_5":14358,"_27381":117242,"_2946":117411},[],"alcance temporal y recursos afectados;",{"_3461":70486,"_30095":70415,"_20902":117413,"_5":14358,"_27381":117242,"_2946":117414},[],"comandos o consultas utilizados;",{"_3461":70487,"_30095":70415,"_20902":117416,"_5":14358,"_27381":117242,"_2946":117417},[],"cambio aplicado y forma de revertirlo;",{"_3461":70488,"_30095":70415,"_20902":117419,"_5":14358,"_27381":117242,"_2946":117420},[],"validación desde un consumidor;",{"_3461":70489,"_30095":70415,"_20902":117422,"_5":14358,"_27381":117242,"_2946":117423},[],"acción preventiva y propietario.",{"_3461":70490,"_30095":70490,"_5":14710,"_2946":117425,"_30448":117426,"_20902":117429,"_27381":70490},"Control de acceso",[49146,117427,117428],"Plataforma","Administración",[],{"_3461":70491,"_30095":70490,"_20902":117431,"_5":14358,"_27381":70490,"_2946":117432},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3461":70492,"_30095":70490,"_5":30445,"_20902":117434,"_27381":117435,"_2946":117436},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3461":70493,"_30095":70490,"_5":30445,"_20902":117438,"_27381":117439,"_2946":117440},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3461":70494,"_30095":70490,"_5":30445,"_20902":117442,"_27381":117443,"_2946":117444},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3461":70495,"_30095":70490,"_5":30445,"_20902":117446,"_27381":117447,"_2946":117448},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3461":70496,"_30095":70490,"_5":30445,"_20902":117450,"_27381":117451,"_2946":117452},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3461":70497,"_30095":70490,"_5":30445,"_20902":117454,"_27381":117455,"_2946":117456},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3461":70498,"_30095":70490,"_5":30445,"_20902":117458,"_27381":117459,"_2946":117460},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3461":70499,"_30095":70490,"_5":30445,"_20902":117462,"_27381":117463,"_2946":117464},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3461":70500,"_30095":70490,"_5":30445,"_20902":117466,"_27381":117467,"_2946":117468},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3461":70501,"_30095":70490,"_5":30445,"_20902":117470,"_27381":117471,"_2946":117472},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3461":70502,"_30095":70490,"_5":30445,"_20902":117474,"_27381":117475,"_2946":117476},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3461":70503,"_30095":70490,"_5":30445,"_20902":117478,"_27381":117479,"_2946":117480},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3461":70504,"_30095":70490,"_5":30445,"_20902":117482,"_27381":117483,"_2946":117484},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3461":70505,"_30095":70490,"_5":30445,"_20902":117486,"_27381":117487,"_2946":117488},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3461":70506,"_30095":70490,"_5":30445,"_20902":117490,"_27381":117491,"_2946":117492},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3461":70507,"_30095":70490,"_5":30445,"_20902":117494,"_27381":117495,"_2946":116602},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3461":70508,"_30095":70490,"_5":30445,"_20902":117497,"_27381":117498,"_2946":117499},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3461":70509,"_30095":70490,"_5":30445,"_20902":117501,"_27381":117502,"_2946":117503},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3461":70510,"_30095":70490,"_5":30445,"_20902":117505,"_27381":117506,"_2946":117507},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3461":70511,"_30095":70490,"_5":30445,"_20902":117509,"_27381":117510,"_2946":117511},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3461":70512,"_30095":70490,"_5":30445,"_20902":117513,"_27381":117514,"_2946":117515},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3461":70513,"_30095":70490,"_5":30445,"_20902":117517,"_27381":117518,"_2946":117519},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3461":70514,"_30095":70490,"_5":30445,"_20902":117521,"_27381":117522,"_2946":117523},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3461":70515,"_30095":70490,"_5":30445,"_20902":117525,"_27381":117526,"_2946":117527},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3461":70516,"_30095":70490,"_5":30445,"_20902":117529,"_27381":117530,"_2946":117531},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3461":70517,"_30095":70490,"_5":30445,"_20902":117533,"_27381":117534,"_2946":117535},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3461":70518,"_30095":70490,"_5":30445,"_20902":117537,"_27381":117538,"_2946":117539},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3461":70519,"_30095":70490,"_5":30445,"_20902":117541,"_27381":117542,"_2946":117543},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3461":70520,"_30095":70490,"_5":30445,"_20902":117545,"_27381":117546,"_2946":117547},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3461":70521,"_30095":70490,"_5":30445,"_20902":117549,"_27381":117550,"_2946":117551},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3461":70522,"_30095":70490,"_5":30445,"_20902":117553,"_27381":117554,"_2946":117555},[],"/docs/pr-preview/pr-60/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3461":70523,"_30095":70490,"_20902":117557,"_5":14358,"_27381":70490,"_2946":117558},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3461":70524,"_30095":70490,"_20902":117560,"_5":14358,"_27381":70490,"_2946":117561},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3461":70525,"_30095":70490,"_20902":117563,"_5":14358,"_27381":70490,"_2946":117564},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3461":70526,"_30095":70490,"_20902":117566,"_5":14358,"_27381":117435,"_2946":117567},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3461":70527,"_30095":70490,"_20902":117569,"_5":14358,"_27381":117435,"_2946":117570},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3461":70528,"_30095":70490,"_20902":117572,"_5":14358,"_27381":117435,"_2946":117573},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3461":70529,"_30095":70490,"_20902":117575,"_5":14358,"_27381":117435,"_2946":117576},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3461":70530,"_30095":70490,"_20902":117578,"_5":14358,"_27381":117435,"_2946":117579},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3461":70531,"_30095":70490,"_20902":117581,"_5":14358,"_27381":117435,"_2946":117582},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3461":70532,"_30095":70490,"_20902":117584,"_5":14358,"_27381":117439,"_2946":117585},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3461":70533,"_30095":70490,"_20902":117587,"_5":14358,"_27381":117439,"_2946":117588},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3461":70534,"_30095":70490,"_20902":117590,"_5":14358,"_27381":117443,"_2946":117591},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3461":70535,"_30095":70490,"_20902":117593,"_5":14358,"_27381":117443,"_2946":117594},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3461":70536,"_30095":70490,"_20902":117596,"_5":14358,"_27381":117443,"_2946":117597},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3461":70537,"_30095":70490,"_20902":117599,"_5":14358,"_27381":117443,"_2946":117600},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3461":70538,"_30095":70490,"_20902":117602,"_5":14358,"_27381":117443,"_2946":117603},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3461":70539,"_30095":70490,"_20902":117605,"_5":14358,"_27381":117443,"_2946":117606},[],"Carga por separado las políticas concedidas a cada principal.",{"_3461":70540,"_30095":70490,"_20902":117608,"_5":14358,"_27381":117443,"_2946":117609},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3461":70541,"_30095":70490,"_20902":117611,"_5":14358,"_27381":117443,"_2946":117612},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3461":70542,"_30095":70490,"_20902":117614,"_5":14358,"_27381":117443,"_2946":117615},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3461":70543,"_30095":70490,"_20902":117617,"_5":14358,"_27381":117443,"_2946":117618},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3461":70544,"_30095":70490,"_20902":117620,"_5":14358,"_27381":117443,"_2946":117621},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3461":70545,"_30095":70490,"_20902":117623,"_5":14358,"_27381":117443,"_2946":117624},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3461":70546,"_30095":70490,"_20902":117626,"_5":14358,"_27381":117447,"_2946":117627},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3461":70547,"_30095":70490,"_20902":117629,"_5":14358,"_27381":117447,"_2946":117630},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3461":70548,"_30095":70490,"_20902":117632,"_5":14358,"_27381":117447,"_2946":117633},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3461":70549,"_30095":70490,"_20902":117635,"_5":14358,"_27381":117447,"_2946":117636},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3461":70550,"_30095":70490,"_20902":117638,"_5":14358,"_27381":117447,"_2946":117639},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3461":70551,"_30095":70490,"_20902":117641,"_5":14358,"_27381":117447,"_2946":117642},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3461":70552,"_30095":70490,"_20902":117644,"_5":14358,"_27381":117447,"_2946":117645},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3461":70553,"_30095":70490,"_20902":117647,"_5":14358,"_27381":117447,"_2946":117648},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3461":70554,"_30095":70490,"_20902":117650,"_5":14358,"_27381":117451,"_2946":117651},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3461":70555,"_30095":70490,"_20902":117653,"_5":14358,"_27381":117451,"_2946":117654},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3461":70556,"_30095":70490,"_20902":117656,"_5":14358,"_27381":117451,"_2946":117657},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3461":70557,"_30095":70490,"_20902":117659,"_5":14358,"_27381":117451,"_2946":117660},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3461":70558,"_30095":70490,"_20902":117662,"_5":14358,"_27381":117451,"_2946":117663},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3461":70559,"_30095":70490,"_20902":117665,"_5":14358,"_27381":117451,"_2946":117666},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3461":70560,"_30095":70490,"_20902":117668,"_5":14358,"_27381":117451,"_2946":117669},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3461":70561,"_30095":70490,"_20902":117671,"_5":14358,"_27381":117451,"_2946":117672},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3461":70562,"_30095":70490,"_20902":117674,"_5":14358,"_27381":117451,"_2946":117675},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3461":70563,"_30095":70490,"_20902":117677,"_5":14358,"_27381":117451,"_2946":117678},[],"Las acciones se dividen en dos grupos:",{"_3461":70564,"_30095":70490,"_20902":117680,"_5":14358,"_27381":117451,"_2946":117681},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3461":70565,"_30095":70490,"_20902":117683,"_5":14358,"_27381":117451,"_2946":117684},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3461":70566,"_30095":70490,"_20902":117686,"_5":14358,"_27381":117451,"_2946":117687},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3461":70567,"_30095":70490,"_20902":117689,"_5":14358,"_27381":117455,"_2946":117690},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3461":70568,"_30095":70490,"_20902":117692,"_5":14358,"_27381":117455,"_2946":117693},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3461":70569,"_30095":70490,"_20902":117695,"_5":14358,"_27381":117455,"_2946":117696},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3461":70570,"_30095":70490,"_20902":117698,"_5":14358,"_27381":117459,"_2946":117699},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3461":70571,"_30095":70490,"_20902":117701,"_5":14358,"_27381":117459,"_2946":117702},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3461":70572,"_30095":70490,"_20902":117704,"_5":14358,"_27381":117459,"_2946":117705},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3461":70573,"_30095":70490,"_20902":117707,"_5":14358,"_27381":117459,"_2946":117708},[],"Los operadores implementados son:",{"_3461":70574,"_30095":70490,"_20902":117710,"_5":14358,"_27381":117459,"_2946":117711},[],"`equals`, para igualdad exacta;",{"_3461":70575,"_30095":70490,"_20902":117713,"_5":14358,"_27381":117459,"_2946":117714},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3461":70576,"_30095":70490,"_20902":117716,"_5":14358,"_27381":117459,"_2946":117717},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3461":70577,"_30095":70490,"_20902":117719,"_5":14358,"_27381":117459,"_2946":117720},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3461":70578,"_30095":70490,"_20902":117722,"_5":14358,"_27381":117463,"_2946":117723},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3461":70579,"_30095":70490,"_20902":117725,"_5":14358,"_27381":117463,"_2946":117726},[],"Los modos disponibles son:",{"_3461":70580,"_30095":70490,"_20902":117728,"_5":14358,"_27381":117463,"_2946":117729},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3461":70581,"_30095":70490,"_20902":117731,"_5":14358,"_27381":117463,"_2946":117732},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3461":70582,"_30095":70490,"_20902":117734,"_5":14358,"_27381":117463,"_2946":117735},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3461":70583,"_30095":70490,"_20902":117737,"_5":14358,"_27381":117463,"_2946":117738},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3461":70584,"_30095":70490,"_20902":117740,"_5":14358,"_27381":117463,"_2946":117741},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3461":70585,"_30095":70490,"_20902":117743,"_5":14358,"_27381":117463,"_2946":117744},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3461":70586,"_30095":70490,"_20902":117746,"_5":14358,"_27381":117467,"_2946":117747},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3461":70587,"_30095":70490,"_20902":117749,"_5":14358,"_27381":117467,"_2946":117750},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3461":70588,"_30095":70490,"_20902":117752,"_5":14358,"_27381":117467,"_2946":117753},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3461":70589,"_30095":70490,"_20902":117755,"_5":14358,"_27381":117467,"_2946":117756},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3461":70590,"_30095":70490,"_20902":117758,"_5":14358,"_27381":117475,"_2946":117759},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3461":70591,"_30095":70490,"_20902":117761,"_5":14358,"_27381":117475,"_2946":117762},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3461":70592,"_30095":70490,"_20902":117764,"_5":14358,"_27381":117479,"_2946":117765},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3461":70593,"_30095":70490,"_20902":117767,"_5":14358,"_27381":117479,"_2946":117768},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3461":70594,"_30095":70490,"_20902":117770,"_5":14358,"_27381":117483,"_2946":117771},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3461":70595,"_30095":70490,"_20902":117773,"_5":14358,"_27381":117483,"_2946":117774},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3461":70596,"_30095":70490,"_20902":117776,"_5":14358,"_27381":117483,"_2946":117777},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3461":70597,"_30095":70490,"_20902":117779,"_5":14358,"_27381":117487,"_2946":117780},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3461":70598,"_30095":70490,"_20902":117782,"_5":14358,"_27381":117487,"_2946":117783},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3461":70599,"_30095":70490,"_20902":117785,"_5":14358,"_27381":117487,"_2946":117786},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3461":70600,"_30095":70490,"_20902":117788,"_5":14358,"_27381":117487,"_2946":117789},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3461":70601,"_30095":70490,"_20902":117791,"_5":14358,"_27381":117487,"_2946":117792},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3461":70602,"_30095":70490,"_20902":117794,"_5":14358,"_27381":117487,"_2946":117795},[],"Ten en cuenta que:",{"_3461":70603,"_30095":70490,"_20902":117797,"_5":14358,"_27381":117487,"_2946":117798},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3461":70604,"_30095":70490,"_20902":117800,"_5":14358,"_27381":117487,"_2946":117801},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3461":70605,"_30095":70490,"_20902":117803,"_5":14358,"_27381":117487,"_2946":117804},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3461":70606,"_30095":70490,"_20902":117806,"_5":14358,"_27381":117491,"_2946":117807},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3461":70607,"_30095":70490,"_20902":117809,"_5":14358,"_27381":117491,"_2946":117810},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3461":70608,"_30095":70490,"_20902":117812,"_5":14358,"_27381":117491,"_2946":117813},[],"acceso completo y de solo lectura a KMS;",{"_3461":70609,"_30095":70490,"_20902":117815,"_5":14358,"_27381":117491,"_2946":117816},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3461":70610,"_30095":70490,"_20902":117818,"_5":14358,"_27381":117491,"_2946":117819},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3461":70611,"_30095":70490,"_20902":117821,"_5":14358,"_27381":117491,"_2946":117822},[],"acceso a la interfaz;",{"_3461":70612,"_30095":70490,"_20902":117824,"_5":14358,"_27381":117491,"_2946":117825},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3461":70613,"_30095":70490,"_20902":117827,"_5":14358,"_27381":117491,"_2946":117828},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3461":70614,"_30095":70490,"_20902":117830,"_5":14358,"_27381":117491,"_2946":117831},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3461":70615,"_30095":70490,"_20902":117833,"_5":14358,"_27381":117495,"_2946":117834},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3461":70616,"_30095":70490,"_20902":117836,"_5":14358,"_27381":117495,"_2946":117837},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3461":70617,"_30095":70490,"_20902":117839,"_5":14358,"_27381":117495,"_2946":117840},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3461":70618,"_30095":70490,"_20902":117842,"_5":14358,"_27381":117498,"_2946":117843},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3461":70619,"_30095":70490,"_20902":117845,"_5":14358,"_27381":117502,"_2946":117846},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3461":70620,"_30095":70490,"_20902":117848,"_5":14358,"_27381":117502,"_2946":117849},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3461":70621,"_30095":70490,"_20902":117851,"_5":14358,"_27381":117506,"_2946":117852},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3461":70622,"_30095":70490,"_20902":117854,"_5":14358,"_27381":117510,"_2946":117855},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3461":70623,"_30095":70490,"_20902":117857,"_5":14358,"_27381":117514,"_2946":117858},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3461":70624,"_30095":70490,"_20902":117860,"_5":14358,"_27381":117518,"_2946":117861},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3461":70625,"_30095":70490,"_20902":117863,"_5":14358,"_27381":117518,"_2946":117864},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3461":70626,"_30095":70490,"_20902":117866,"_5":14358,"_27381":117522,"_2946":117867},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3461":70627,"_30095":70490,"_20902":117869,"_5":14358,"_27381":117522,"_2946":117870},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3461":70628,"_30095":70490,"_20902":117872,"_5":14358,"_27381":117522,"_2946":117873},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3461":70629,"_30095":70490,"_20902":117875,"_5":14358,"_27381":117522,"_2946":117876},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3461":70630,"_30095":70490,"_20902":117878,"_5":14358,"_27381":117522,"_2946":117879},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3461":70631,"_30095":70490,"_20902":117881,"_5":14358,"_27381":117522,"_2946":117882},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3461":70632,"_30095":70490,"_20902":117884,"_5":14358,"_27381":117522,"_2946":117885},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3461":70633,"_30095":70490,"_20902":117887,"_5":14358,"_27381":117522,"_2946":117888},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3461":70634,"_30095":70490,"_20902":117890,"_5":14358,"_27381":117526,"_2946":117891},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3461":70635,"_30095":70490,"_20902":117893,"_5":14358,"_27381":117526,"_2946":117894},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3461":70636,"_30095":70490,"_20902":117896,"_5":14358,"_27381":117526,"_2946":117897},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3461":70637,"_30095":70490,"_20902":117899,"_5":14358,"_27381":117530,"_2946":117900},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3461":70638,"_30095":70490,"_20902":117902,"_5":14358,"_27381":117530,"_2946":117903},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3461":70639,"_30095":70490,"_20902":117905,"_5":14358,"_27381":117530,"_2946":117906},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3461":70640,"_30095":70490,"_20902":117908,"_5":14358,"_27381":117530,"_2946":117909},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3461":70641,"_30095":70490,"_20902":117911,"_5":14358,"_27381":117530,"_2946":117912},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3461":70642,"_30095":70490,"_20902":117914,"_5":14358,"_27381":117530,"_2946":117915},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3461":70643,"_30095":70490,"_20902":117917,"_5":14358,"_27381":117530,"_2946":117918},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3461":70644,"_30095":70490,"_20902":117920,"_5":14358,"_27381":117530,"_2946":117921},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3461":70645,"_30095":70490,"_20902":117923,"_5":14358,"_27381":117538,"_2946":117924},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3461":70646,"_30095":70490,"_20902":117926,"_5":14358,"_27381":117542,"_2946":117927},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3461":70647,"_30095":70490,"_20902":117929,"_5":14358,"_27381":117542,"_2946":117930},[],"que exista un principal activo del tipo correcto;",{"_3461":70648,"_30095":70490,"_20902":117932,"_5":14358,"_27381":117542,"_2946":117933},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3461":70649,"_30095":70490,"_20902":117935,"_5":14358,"_27381":117542,"_2946":117936},[],"que todas las condiciones del principal se cumplan;",{"_3461":70650,"_30095":70490,"_20902":117938,"_5":14358,"_27381":117542,"_2946":117939},[],"que el principal tenga concedida la política esperada;",{"_3461":70651,"_30095":70490,"_20902":117941,"_5":14358,"_27381":117542,"_2946":117942},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3461":70652,"_30095":70490,"_20902":117944,"_5":14358,"_27381":117542,"_2946":117945},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3461":70653,"_30095":70490,"_20902":117947,"_5":14358,"_27381":117542,"_2946":117948},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3461":70654,"_30095":70490,"_20902":117950,"_5":14358,"_27381":117546,"_2946":117951},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3461":70655,"_30095":70490,"_20902":117953,"_5":14358,"_27381":117550,"_2946":117954},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3461":70656,"_30095":70490,"_20902":117956,"_5":14358,"_27381":117554,"_2946":117957},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3461":70657,"_30095":70490,"_20902":117959,"_5":14358,"_27381":117554,"_2946":117960},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3461":70658,"_30095":70658,"_5":14710,"_2946":117962,"_30448":117963,"_20902":117964,"_27381":70658},"Alertas y suscripciones",[49146,117427,117428],[],{"_3461":70659,"_30095":70658,"_20902":117966,"_5":14358,"_27381":70658,"_2946":117967},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3461":70660,"_30095":70658,"_5":30445,"_20902":117969,"_27381":117970,"_2946":117971},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3461":70661,"_30095":70658,"_5":30445,"_20902":117973,"_27381":117974,"_2946":117975},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3461":70662,"_30095":70658,"_5":30445,"_20902":117977,"_27381":117978,"_2946":117979},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3461":70663,"_30095":70658,"_5":30445,"_20902":117981,"_27381":117982,"_2946":117983},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3461":70664,"_30095":70658,"_5":30445,"_20902":117985,"_27381":117986,"_2946":117987},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3461":70665,"_30095":70658,"_5":30445,"_20902":117989,"_27381":117990,"_2946":117991},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3461":70666,"_30095":70658,"_5":30445,"_20902":117993,"_27381":117994,"_2946":117995},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3461":70667,"_30095":70658,"_5":30445,"_20902":117997,"_27381":117998,"_2946":117999},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3461":70668,"_30095":70658,"_5":30445,"_20902":118001,"_27381":118002,"_2946":118003},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3461":70669,"_30095":70658,"_5":30445,"_20902":118005,"_27381":118006,"_2946":118007},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3461":70670,"_30095":70658,"_5":30445,"_20902":118009,"_27381":118010,"_2946":118011},[],"/docs/pr-preview/pr-60/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3461":70671,"_30095":70658,"_20902":118013,"_5":14358,"_27381":70658,"_2946":118014},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3461":70672,"_30095":70658,"_20902":118016,"_5":14358,"_27381":117970,"_2946":118017},[],"Un servicio publica un evento de dominio.",{"_3461":70673,"_30095":70658,"_20902":118019,"_5":14358,"_27381":117970,"_2946":118020},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3461":70674,"_30095":70658,"_20902":118022,"_5":14358,"_27381":117970,"_2946":118023},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3461":70675,"_30095":70658,"_20902":118025,"_5":14358,"_27381":117970,"_2946":118026},[],"Lamassu entrega el evento al canal configurado.",{"_3461":70676,"_30095":70658,"_20902":118028,"_5":14358,"_27381":117970,"_2946":118029},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3461":70677,"_30095":70658,"_20902":118031,"_5":14358,"_27381":117974,"_2946":118032},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3461":70678,"_30095":70658,"_20902":118034,"_5":14358,"_27381":117974,"_2946":118035},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3461":70679,"_30095":70658,"_20902":118037,"_5":14358,"_27381":117974,"_2946":118038},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3461":70680,"_30095":70658,"_20902":118040,"_5":14358,"_27381":117974,"_2946":118041},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3461":70681,"_30095":70658,"_20902":118043,"_5":14358,"_27381":117974,"_2946":118044},[],"`apikey_options` necesita `header` y `key`.",{"_3461":70682,"_30095":70658,"_20902":118046,"_5":14358,"_27381":117974,"_2946":118047},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3461":70683,"_30095":70658,"_20902":118049,"_5":14358,"_27381":117974,"_2946":118050},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3461":70684,"_30095":70658,"_20902":118052,"_5":14358,"_27381":117974,"_2946":118053},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3461":70685,"_30095":70658,"_20902":118055,"_5":14358,"_27381":117982,"_2946":118056},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3461":70686,"_30095":70658,"_20902":118058,"_5":14358,"_27381":117986,"_2946":118059},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3461":70687,"_30095":70658,"_20902":118061,"_5":14358,"_27381":117990,"_2946":118062},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3461":70688,"_30095":70658,"_20902":118064,"_5":14358,"_27381":117990,"_2946":118065},[],"**None** notifica todas las instancias del evento.",{"_3461":70689,"_30095":70658,"_20902":118067,"_5":14358,"_27381":117990,"_2946":118068},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3461":70690,"_30095":70658,"_20902":118070,"_5":14358,"_27381":117990,"_2946":118071},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3461":70691,"_30095":70658,"_20902":118073,"_5":14358,"_27381":117990,"_2946":118074},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3461":70692,"_30095":70658,"_20902":118076,"_5":14358,"_27381":117990,"_2946":118077},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3461":70693,"_30095":70658,"_20902":118079,"_5":14358,"_27381":117990,"_2946":118080},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3461":70694,"_30095":70658,"_20902":118082,"_5":14358,"_27381":117994,"_2946":118083},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3461":70695,"_30095":70658,"_20902":118085,"_5":14358,"_27381":117998,"_2946":118086},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3461":70696,"_30095":70658,"_20902":118088,"_5":14358,"_27381":117998,"_2946":118089},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3461":70697,"_30095":70658,"_20902":118091,"_5":14358,"_27381":117998,"_2946":118092},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3461":70698,"_30095":70658,"_20902":118094,"_5":14358,"_27381":117998,"_2946":118095},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3461":70699,"_30095":70658,"_20902":118097,"_5":14358,"_27381":117998,"_2946":118098},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3461":70700,"_30095":70658,"_20902":118100,"_5":14358,"_27381":117998,"_2946":118101},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3461":70701,"_30095":70658,"_20902":118103,"_5":14358,"_27381":117998,"_2946":118104},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3461":70702,"_30095":70658,"_20902":118106,"_5":14358,"_27381":117998,"_2946":118107},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3461":70703,"_30095":70658,"_20902":118109,"_5":14358,"_27381":118002,"_2946":118110},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3461":70704,"_30095":70658,"_20902":118112,"_5":14358,"_27381":118002,"_2946":118113},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3461":70705,"_30095":70658,"_20902":118115,"_5":14358,"_27381":118002,"_2946":118116},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3461":70706,"_30095":70658,"_20902":118118,"_5":14358,"_27381":118002,"_2946":118119},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3461":70707,"_30095":70658,"_20902":118121,"_5":14358,"_27381":118002,"_2946":118122},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3461":70708,"_30095":70658,"_20902":118124,"_5":14358,"_27381":118002,"_2946":118125},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3461":70709,"_30095":70658,"_20902":118127,"_5":14358,"_27381":118002,"_2946":118128},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3461":70710,"_30095":70658,"_20902":118130,"_5":14358,"_27381":118002,"_2946":118131},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3461":70711,"_30095":70658,"_20902":118133,"_5":14358,"_27381":118006,"_2946":118134},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3461":70712,"_30095":70658,"_20902":118136,"_5":14358,"_27381":118006,"_2946":118137},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3461":70713,"_30095":70658,"_20902":118139,"_5":14358,"_27381":118010,"_2946":118140},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3461":70714,"_30095":70658,"_20902":118142,"_5":14358,"_27381":118010,"_2946":118143},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3461":70715,"_30095":70658,"_20902":118145,"_5":14358,"_27381":118010,"_2946":118146},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3461":70716,"_30095":70658,"_20902":118148,"_5":14358,"_27381":118010,"_2946":118149},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3461":70717,"_30095":70658,"_20902":118151,"_5":14358,"_27381":118010,"_2946":118152},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3461":70718,"_30095":70658,"_20902":118154,"_5":14358,"_27381":118010,"_2946":118155},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3461":70719,"_30095":70658,"_20902":118157,"_5":14358,"_27381":118010,"_2946":118158},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3461":70720,"_30095":70658,"_20902":118160,"_5":14358,"_27381":118010,"_2946":118161},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3461":70721,"_30095":70658,"_20902":118163,"_5":14358,"_27381":118010,"_2946":118164},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa cualquier filtro que lea un campo del payload antiguo (consulta 3.8.0 a 4.0.0).",{"_3461":70722,"_30095":70722,"_5":14710,"_2946":118166,"_30448":118167,"_20902":118168,"_27381":70722},"Registros de auditoría",[49146,117427,117428],[],{"_3461":70723,"_30095":70722,"_20902":118170,"_5":14358,"_27381":70722,"_2946":118171},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3461":70724,"_30095":70722,"_5":30445,"_20902":118173,"_27381":118174,"_2946":118175},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3461":70725,"_30095":70722,"_5":30445,"_20902":118177,"_27381":118178,"_2946":118179},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3461":70726,"_30095":70722,"_5":30445,"_20902":118181,"_27381":118182,"_2946":118183},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3461":70727,"_30095":70722,"_5":30445,"_20902":118185,"_27381":118186,"_2946":118187},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3461":70728,"_30095":70722,"_5":30445,"_20902":118189,"_27381":118190,"_2946":118191},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3461":70729,"_30095":70722,"_5":30445,"_20902":118193,"_27381":118194,"_2946":118195},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3461":70730,"_30095":70722,"_5":30445,"_20902":118197,"_27381":118198,"_2946":118199},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3461":70731,"_30095":70722,"_5":30445,"_20902":118201,"_27381":118202,"_2946":118203},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3461":70732,"_30095":70722,"_5":30445,"_20902":118205,"_27381":118206,"_2946":118207},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3461":70733,"_30095":70722,"_5":30445,"_20902":118209,"_27381":118210,"_2946":118211},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3461":70734,"_30095":70722,"_5":30445,"_20902":118213,"_27381":118214,"_2946":118215},[],"/docs/pr-preview/pr-60/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3461":70735,"_30095":70722,"_20902":118217,"_5":14358,"_27381":70722,"_2946":118218},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3461":70736,"_30095":70722,"_20902":118220,"_5":14358,"_27381":118174,"_2946":118221},[],"El cuerpo de auditoría incluye:",{"_3461":70737,"_30095":70722,"_20902":118223,"_5":14358,"_27381":118174,"_2946":118224},[],"input: datos recibidos por la operación;",{"_3461":70738,"_30095":70722,"_20902":118226,"_5":14358,"_27381":118174,"_2946":118227},[],"has\\_error: indica si el servicio devolvió un error;",{"_3461":70739,"_30095":70722,"_20902":118229,"_5":14358,"_27381":118174,"_2946":118230},[],"output: resultado producido o mensaje de error;",{"_3461":70740,"_30095":70722,"_20902":118232,"_5":14358,"_27381":118174,"_2946":118233},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3461":70741,"_30095":70722,"_20902":118235,"_5":14358,"_27381":118174,"_2946":118236},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3461":70742,"_30095":70722,"_20902":118238,"_5":14358,"_27381":118174,"_2946":118239},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3461":70743,"_30095":70722,"_20902":118241,"_5":14358,"_27381":118178,"_2946":118242},[],"El backend aplica auditoría a mutaciones de:",{"_3461":70744,"_30095":70722,"_20902":118244,"_5":14358,"_27381":118178,"_2946":118245},[],"autoridades, certificados y perfiles de emisión;",{"_3461":70745,"_30095":70722,"_20902":118247,"_5":14358,"_27381":118178,"_2946":118248},[],"claves y motores KMS;",{"_3461":70746,"_30095":70722,"_20902":118250,"_5":14358,"_27381":118178,"_2946":118251},[],"dispositivos e identidades;",{"_3461":70747,"_30095":70722,"_20902":118253,"_5":14358,"_27381":118178,"_2946":118254},[],"DMS y operaciones de enrolamiento;",{"_3461":70748,"_30095":70722,"_20902":118256,"_5":14358,"_27381":118178,"_2946":118257},[],"funciones de validación y CRL;",{"_3461":70749,"_30095":70722,"_20902":118259,"_5":14358,"_27381":118178,"_2946":118260},[],"principales, políticas y concesiones de autorización.",{"_3461":70750,"_30095":70722,"_20902":118262,"_5":14358,"_27381":118178,"_2946":118263},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3461":70751,"_30095":70722,"_20902":118265,"_5":14358,"_27381":118182,"_2946":118266},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3461":70752,"_30095":70722,"_20902":118268,"_5":14358,"_27381":118182,"_2946":118269},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3461":70753,"_30095":70722,"_20902":118271,"_5":14358,"_27381":118182,"_2946":118272},[],"Diseña el consumidor para:",{"_3461":70754,"_30095":70722,"_20902":118274,"_5":14358,"_27381":118182,"_2946":118275},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3461":70755,"_30095":70722,"_20902":118277,"_5":14358,"_27381":118182,"_2946":118278},[],"conservar el CloudEvent completo sin modificar;",{"_3461":70756,"_30095":70722,"_20902":118280,"_5":14358,"_27381":118182,"_2946":118281},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3461":70757,"_30095":70722,"_20902":118283,"_5":14358,"_27381":118182,"_2946":118284},[],"cifrar en tránsito y en reposo;",{"_3461":70758,"_30095":70722,"_20902":118286,"_5":14358,"_27381":118182,"_2946":118287},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3461":70759,"_30095":70722,"_20902":118289,"_5":14358,"_27381":118182,"_2946":118290},[],"aplicar una política explícita de retención y legal hold;",{"_3461":70760,"_30095":70722,"_20902":118292,"_5":14358,"_27381":118182,"_2946":118293},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3461":70761,"_30095":70722,"_20902":118295,"_5":14358,"_27381":118186,"_2946":118296},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3461":70762,"_30095":70722,"_20902":118298,"_5":14358,"_27381":118186,"_2946":118299},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3461":70763,"_30095":70722,"_20902":118301,"_5":14358,"_27381":118194,"_2946":118302},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3461":70764,"_30095":70722,"_20902":118304,"_5":14358,"_27381":118198,"_2946":118305},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3461":70765,"_30095":70722,"_20902":118307,"_5":14358,"_27381":118202,"_2946":118308},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3461":70766,"_30095":70722,"_20902":118310,"_5":14358,"_27381":118206,"_2946":118311},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3461":70767,"_30095":70722,"_20902":118313,"_5":14358,"_27381":118210,"_2946":118314},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3461":70768,"_30095":70722,"_20902":118316,"_5":14358,"_27381":118214,"_2946":118317},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3461":70769,"_30095":70722,"_20902":118319,"_5":14358,"_27381":118214,"_2946":118320},[],"aparece un evento de auditoría correcto;",{"_3461":70770,"_30095":70722,"_20902":118322,"_5":14358,"_27381":118214,"_2946":118323},[],"el principal coincide con la identidad utilizada;",{"_3461":70771,"_30095":70722,"_20902":118325,"_5":14358,"_27381":118214,"_2946":118326},[],"el consumidor lo persiste una sola vez;",{"_3461":70772,"_30095":70722,"_20902":118328,"_5":14358,"_27381":118214,"_2946":118329},[],"puede recuperarse por recurso, actor y periodo;",{"_3461":70773,"_30095":70722,"_20902":118331,"_5":14358,"_27381":118214,"_2946":118332},[],"una interrupción del consumidor produce una alerta.",{"_3461":70774,"_30095":70722,"_20902":118334,"_5":14358,"_27381":118214,"_2946":118335},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3461":70775,"_30095":70775,"_5":14710,"_2946":118337,"_30448":118338,"_20902":118339,"_27381":70775},"Arquitectura de la plataforma",[49146,117427],[],{"_3461":70776,"_30095":70775,"_20902":118341,"_5":14358,"_27381":70775,"_2946":118342},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3461":70777,"_30095":70775,"_5":30445,"_20902":118344,"_27381":118345,"_2946":118346},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3461":70778,"_30095":70775,"_5":30445,"_20902":118348,"_27381":118349,"_2946":118350},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3461":70779,"_30095":70775,"_5":30445,"_20902":118352,"_27381":118353,"_2946":118354},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3461":70780,"_30095":70775,"_5":30445,"_20902":118356,"_27381":118357,"_2946":118358},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3461":70781,"_30095":70775,"_5":30445,"_20902":118360,"_27381":118361,"_2946":118362},[],"/docs/pr-preview/pr-60/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3461":70782,"_30095":70775,"_20902":118364,"_5":14358,"_27381":70775,"_2946":118365},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3461":70783,"_30095":70775,"_20902":118367,"_5":14358,"_27381":70775,"_2946":118368},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3461":70784,"_30095":70775,"_20902":118370,"_5":14358,"_27381":118345,"_2946":118371},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3461":70785,"_30095":70775,"_20902":118373,"_5":14358,"_27381":118349,"_2946":118374},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3461":70786,"_30095":70775,"_20902":118376,"_5":14358,"_27381":118353,"_2946":118377},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3461":70787,"_30095":70775,"_20902":118379,"_5":14358,"_27381":118357,"_2946":118380},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3461":70788,"_30095":70775,"_20902":118382,"_5":14358,"_27381":118361,"_2946":118383},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3461":70789,"_30095":70789,"_5":14710,"_2946":118385,"_30448":118386,"_20902":118387,"_27381":70789},"Cómo funciona Lamassu",[49146,117427],[],{"_3461":70790,"_30095":70789,"_20902":118389,"_5":14358,"_27381":70789,"_2946":118390},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3461":70791,"_30095":70789,"_5":30445,"_20902":118392,"_27381":118393,"_2946":118394},[],"/docs/pr-preview/pr-60/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3461":70792,"_30095":70789,"_5":30445,"_20902":118396,"_27381":118397,"_2946":118398},[],"/docs/pr-preview/pr-60/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3461":70793,"_30095":70789,"_20902":118400,"_5":14358,"_27381":70789,"_2946":118401},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3461":70794,"_30095":70789,"_20902":118403,"_5":14358,"_27381":118393,"_2946":118404},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3461":70795,"_30095":70789,"_20902":118406,"_5":14358,"_27381":118393,"_2946":118407},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3461":70796,"_30095":70789,"_20902":118409,"_5":14358,"_27381":118393,"_2946":118410},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3461":70797,"_30095":70789,"_20902":118412,"_5":14358,"_27381":118393,"_2946":118413},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3461":70798,"_30095":70789,"_20902":118415,"_5":14358,"_27381":118393,"_2946":118416},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3461":70799,"_30095":70789,"_20902":118418,"_5":14358,"_27381":118397,"_2946":118419},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3461":70800,"_30095":70789,"_20902":118421,"_5":14358,"_27381":118397,"_2946":118422},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3461":70801,"_30095":70789,"_20902":118424,"_5":14358,"_27381":118397,"_2946":118425},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3461":70802,"_30095":70789,"_20902":118427,"_5":14358,"_27381":118397,"_2946":118428},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3461":70803,"_30095":70789,"_20902":118430,"_5":14358,"_27381":118397,"_2946":118431},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3461":70804,"_30095":70789,"_20902":118433,"_5":14358,"_27381":118397,"_2946":118434},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3461":70805,"_30095":70789,"_20902":118436,"_5":14358,"_27381":118397,"_2946":118437},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3461":70806,"_30095":70806,"_5":14710,"_2946":118439,"_30448":118440,"_20902":118441,"_27381":70806},"Dispositivos e identidades",[49146,117427,51628,118439],[],{"_3461":70807,"_30095":70806,"_20902":118443,"_5":14358,"_27381":70806,"_2946":118444},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3461":70808,"_30095":70806,"_5":30445,"_20902":118446,"_27381":118447,"_2946":118448},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3461":70809,"_30095":70806,"_5":30445,"_20902":118450,"_27381":118451,"_2946":118452},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3461":70810,"_30095":70806,"_5":30445,"_20902":118454,"_27381":118455,"_2946":118456},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3461":70811,"_30095":70806,"_5":30445,"_20902":118458,"_27381":118459,"_2946":118460},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3461":70812,"_30095":70806,"_5":30445,"_20902":118462,"_27381":118463,"_2946":118464},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3461":70813,"_30095":70806,"_5":30445,"_20902":118466,"_27381":118467,"_2946":118468},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3461":70814,"_30095":70806,"_5":30445,"_20902":118470,"_27381":118471,"_2946":118472},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3461":70815,"_30095":70806,"_5":30445,"_20902":118474,"_27381":118475,"_2946":118476},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3461":70816,"_30095":70806,"_5":30445,"_20902":118478,"_27381":118479,"_2946":118480},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3461":70817,"_30095":70806,"_5":30445,"_20902":118482,"_27381":118483,"_2946":118484},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3461":70818,"_30095":70806,"_5":30445,"_20902":118486,"_27381":118487,"_2946":118488},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3461":70819,"_30095":70806,"_20902":118490,"_5":14358,"_27381":70806,"_2946":118491},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3461":70820,"_30095":70806,"_20902":118493,"_5":14358,"_27381":70806,"_2946":118494},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3461":70821,"_30095":70806,"_20902":118496,"_5":14358,"_27381":118447,"_2946":118497},[],"Vista operativa",{"_3461":70822,"_30095":70806,"_20902":118499,"_5":14358,"_27381":118447,"_2946":118500},[],"Interpretación",{"_3461":70823,"_30095":70806,"_20902":118502,"_5":14358,"_27381":118447,"_2946":51691},[],{"_3461":70824,"_30095":70806,"_20902":118504,"_5":14358,"_27381":118447,"_2946":118505},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3461":70825,"_30095":70806,"_20902":118507,"_5":14358,"_27381":118447,"_2946":51697},[],{"_3461":70826,"_30095":70806,"_20902":118509,"_5":14358,"_27381":118447,"_2946":118510},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3461":70827,"_30095":70806,"_20902":118512,"_5":14358,"_27381":118447,"_2946":51703},[],{"_3461":70828,"_30095":70806,"_20902":118514,"_5":14358,"_27381":118447,"_2946":118515},[],"La identidad está en la ventana operativa de renovación.",{"_3461":70829,"_30095":70806,"_20902":118517,"_5":14358,"_27381":118447,"_2946":51709},[],{"_3461":70830,"_30095":70806,"_20902":118519,"_5":14358,"_27381":118447,"_2946":118520},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3461":70831,"_30095":70806,"_20902":118522,"_5":14358,"_27381":118447,"_2946":51715},[],{"_3461":70832,"_30095":70806,"_20902":118524,"_5":14358,"_27381":118447,"_2946":118525},[],"La identidad ha vencido.",{"_3461":70833,"_30095":70806,"_20902":118527,"_5":14358,"_27381":118447,"_2946":51721},[],{"_3461":70834,"_30095":70806,"_20902":118529,"_5":14358,"_27381":118447,"_2946":118530},[],"La identidad está marcada como revocada.",{"_3461":70835,"_30095":70806,"_20902":118532,"_5":14358,"_27381":118447,"_2946":51727},[],{"_3461":70836,"_30095":70806,"_20902":118534,"_5":14358,"_27381":118447,"_2946":118535},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3461":70837,"_30095":70806,"_20902":118537,"_5":14358,"_27381":118447,"_2946":118538},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3461":70838,"_30095":70806,"_20902":118540,"_5":14358,"_27381":118451,"_2946":118541},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3461":70839,"_30095":70806,"_20902":118543,"_5":14358,"_27381":118451,"_2946":118544},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3461":70840,"_30095":70806,"_20902":118546,"_5":14358,"_27381":118451,"_2946":118547},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3461":70841,"_30095":70806,"_20902":118549,"_5":14358,"_27381":118451,"_2946":118550},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3461":70842,"_30095":70806,"_20902":118552,"_5":14358,"_27381":118455,"_2946":118553},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3461":70843,"_30095":70806,"_20902":118555,"_5":14358,"_27381":118459,"_2946":118556},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3461":70844,"_30095":70806,"_20902":118558,"_5":14358,"_27381":118463,"_2946":118559},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3461":70845,"_30095":70806,"_20902":118561,"_5":14358,"_27381":118467,"_2946":118562},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3461":70846,"_30095":70806,"_20902":118564,"_5":14358,"_27381":118471,"_2946":118565},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3461":70847,"_30095":70806,"_20902":118567,"_5":14358,"_27381":118471,"_2946":118568},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3461":70848,"_30095":70806,"_20902":118570,"_5":14358,"_27381":118475,"_2946":118571},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3461":70849,"_30095":70806,"_20902":118573,"_5":14358,"_27381":118475,"_2946":118574},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3461":70850,"_30095":70806,"_20902":118576,"_5":14358,"_27381":118475,"_2946":118577},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3461":70851,"_30095":70806,"_20902":118579,"_5":14358,"_27381":118475,"_2946":118580},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3461":70852,"_30095":70806,"_20902":118582,"_5":14358,"_27381":118475,"_2946":118583},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3461":70853,"_30095":70806,"_20902":118585,"_5":14358,"_27381":118475,"_2946":118586},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3461":70854,"_30095":70806,"_20902":118588,"_5":14358,"_27381":118479,"_2946":118589},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3461":70855,"_30095":70806,"_20902":118591,"_5":14358,"_27381":118479,"_2946":118592},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3461":70856,"_30095":70806,"_20902":118594,"_5":14358,"_27381":118483,"_2946":118595},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3461":70857,"_30095":70806,"_20902":118597,"_5":14358,"_27381":118483,"_2946":118598},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3461":70858,"_30095":70806,"_20902":118600,"_5":14358,"_27381":118483,"_2946":118601},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3461":70859,"_30095":70806,"_20902":118603,"_5":14358,"_27381":118483,"_2946":118604},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3461":70860,"_30095":70806,"_20902":118606,"_5":14358,"_27381":118487,"_2946":118607},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3461":70861,"_30095":70806,"_20902":118609,"_5":14358,"_27381":118487,"_2946":118610},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3461":70862,"_30095":70862,"_5":14710,"_2946":118612,"_30448":118613,"_20902":118615,"_27381":70862},"Identidad inicial y autenticación",[49146,117427,51628,118439,118614],"Enrolamiento con PKI",[],{"_3461":70863,"_30095":70862,"_20902":118617,"_5":14358,"_27381":70862,"_2946":118618},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3461":70864,"_30095":70862,"_5":30445,"_20902":118620,"_27381":118621,"_2946":118622},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3461":70865,"_30095":70862,"_5":30445,"_20902":118624,"_27381":118625,"_2946":118626},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3461":70866,"_30095":70862,"_5":30445,"_20902":118628,"_27381":118629,"_2946":118630},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3461":70867,"_30095":70862,"_5":30445,"_20902":118632,"_27381":118633,"_2946":118634},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3461":70868,"_30095":70862,"_5":30445,"_20902":118636,"_27381":118637,"_2946":118638},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3461":70869,"_30095":70862,"_20902":118640,"_5":14358,"_27381":70862,"_2946":118641},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3461":70870,"_30095":70862,"_20902":118643,"_5":14358,"_27381":118621,"_2946":118644},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3461":70871,"_30095":70862,"_20902":118646,"_5":14358,"_27381":118621,"_2946":118647},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3461":70872,"_30095":70862,"_20902":118649,"_5":14358,"_27381":118625,"_2946":118650},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3461":70873,"_30095":70862,"_20902":118652,"_5":14358,"_27381":118625,"_2946":118653},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3461":70874,"_30095":70862,"_20902":118655,"_5":14358,"_27381":118625,"_2946":118656},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3461":70875,"_30095":70862,"_20902":118658,"_5":14358,"_27381":118629,"_2946":118659},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3461":70876,"_30095":70862,"_20902":118661,"_5":14358,"_27381":118629,"_2946":118662},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3461":70877,"_30095":70862,"_20902":118664,"_5":14358,"_27381":118633,"_2946":118665},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3461":70878,"_30095":70862,"_20902":118667,"_5":14358,"_27381":118633,"_2946":118668},[],"Ejemplo de cuerpo:",{"_3461":70879,"_30095":70862,"_20902":118670,"_5":14358,"_27381":118633,"_2946":118671},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3461":70880,"_30095":70862,"_20902":118673,"_5":14358,"_27381":118633,"_2946":118674},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3461":70881,"_30095":70862,"_20902":118676,"_5":14358,"_27381":118633,"_2946":118677},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3461":70882,"_30095":70862,"_20902":118679,"_5":14358,"_27381":118633,"_2946":118680},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3461":70883,"_30095":70862,"_20902":118682,"_5":14358,"_27381":118637,"_2946":118683},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3461":70884,"_30095":70862,"_20902":118685,"_5":14358,"_27381":118637,"_2946":118686},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3461":70885,"_30095":70885,"_5":14710,"_2946":118688,"_30448":118689,"_20902":118690,"_27381":70885},"Configura y opera el DMS",[49146,117427,51628,118439,118614],[],{"_3461":70886,"_30095":70885,"_20902":118692,"_5":14358,"_27381":70885,"_2946":118693},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3461":70887,"_30095":70885,"_5":30445,"_20902":118695,"_27381":118696,"_2946":116005},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3461":70888,"_30095":70885,"_5":30445,"_20902":118698,"_27381":118699,"_2946":118700},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3461":70889,"_30095":70885,"_5":30445,"_20902":118702,"_27381":118703,"_2946":118704},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3461":70890,"_30095":70885,"_5":30445,"_20902":118706,"_27381":118707,"_2946":118708},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3461":70891,"_30095":70885,"_5":30445,"_20902":118710,"_27381":118711,"_2946":118712},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3461":70892,"_30095":70885,"_5":30445,"_20902":118714,"_27381":118715,"_2946":118716},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3461":70893,"_30095":70885,"_5":30445,"_20902":118718,"_27381":118719,"_2946":118720},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3461":70894,"_30095":70885,"_5":30445,"_20902":118722,"_27381":118723,"_2946":118724},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3461":70895,"_30095":70885,"_5":30445,"_20902":118726,"_27381":118727,"_2946":51923},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3461":70896,"_30095":70885,"_5":30445,"_20902":118729,"_27381":118730,"_2946":51927},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3461":70897,"_30095":70885,"_5":30445,"_20902":118732,"_27381":118733,"_2946":118734},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3461":70898,"_30095":70885,"_5":30445,"_20902":118736,"_27381":118737,"_2946":118738},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3461":70899,"_30095":70885,"_5":30445,"_20902":118740,"_27381":118741,"_2946":118742},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3461":70900,"_30095":70885,"_5":30445,"_20902":118744,"_27381":118745,"_2946":118746},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3461":70901,"_30095":70885,"_5":30445,"_20902":118748,"_27381":118749,"_2946":51947},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3461":70902,"_30095":70885,"_5":30445,"_20902":118751,"_27381":118752,"_2946":118753},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3461":70903,"_30095":70885,"_5":30445,"_20902":118755,"_27381":118756,"_2946":118757},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3461":70904,"_30095":70885,"_5":30445,"_20902":118759,"_27381":118760,"_2946":118761},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3461":70905,"_30095":70885,"_20902":118763,"_5":14358,"_27381":70885,"_2946":118764},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3461":70906,"_30095":70885,"_20902":118766,"_5":14358,"_27381":118696,"_2946":118767},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3461":70907,"_30095":70885,"_20902":118769,"_5":14358,"_27381":118696,"_2946":118770},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3461":70908,"_30095":70885,"_20902":118772,"_5":14358,"_27381":118703,"_2946":118773},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3461":70909,"_30095":70885,"_20902":118775,"_5":14358,"_27381":118707,"_2946":118776},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3461":70910,"_30095":70885,"_20902":118778,"_5":14358,"_27381":118711,"_2946":118779},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3461":70911,"_30095":70885,"_20902":118781,"_5":14358,"_27381":118715,"_2946":118782},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3461":70912,"_30095":70885,"_20902":118784,"_5":14358,"_27381":118719,"_2946":118785},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3461":70913,"_30095":70885,"_20902":118787,"_5":14358,"_27381":118727,"_2946":118788},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3461":70914,"_30095":70885,"_20902":118790,"_5":14358,"_27381":118727,"_2946":118791},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3461":70915,"_30095":70885,"_20902":118793,"_5":14358,"_27381":118730,"_2946":118794},[],"Campo de `settings.enrollment_settings`",{"_3461":70916,"_30095":70885,"_20902":118796,"_5":14358,"_27381":118730,"_2946":118797},[],"Decisión",{"_3461":70917,"_30095":70885,"_20902":118799,"_5":14358,"_27381":118730,"_2946":51998},[],{"_3461":70918,"_30095":70885,"_20902":118801,"_5":14358,"_27381":118730,"_2946":118802},[],"`EST_RFC7030` para estas operaciones.",{"_3461":70919,"_30095":70885,"_20902":118804,"_5":14358,"_27381":118730,"_2946":52004},[],{"_3461":70920,"_30095":70885,"_20902":118806,"_5":14358,"_27381":118730,"_2946":118807},[],"ID de la CA que firmará.",{"_3461":70921,"_30095":70885,"_20902":118809,"_5":14358,"_27381":118730,"_2946":52010},[],{"_3461":70922,"_30095":70885,"_20902":118811,"_5":14358,"_27381":118730,"_2946":118812},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3461":70923,"_30095":70885,"_20902":118814,"_5":14358,"_27381":118730,"_2946":52016},[],{"_3461":70924,"_30095":70885,"_20902":118816,"_5":14358,"_27381":118730,"_2946":118817},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3461":70925,"_30095":70885,"_20902":118819,"_5":14358,"_27381":118730,"_2946":52022},[],{"_3461":70926,"_30095":70885,"_20902":118821,"_5":14358,"_27381":118730,"_2946":118822},[],"Uno de los cuatro modos de autenticación.",{"_3461":70927,"_30095":70885,"_20902":118824,"_5":14358,"_27381":118730,"_2946":118825},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3461":70928,"_30095":70885,"_20902":118827,"_5":14358,"_27381":118733,"_2946":118828},[],"Los bloques son independientes:",{"_3461":70929,"_30095":70885,"_20902":118830,"_5":14358,"_27381":118733,"_2946":118831},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3461":70930,"_30095":70885,"_20902":118833,"_5":14358,"_27381":118733,"_2946":118834},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3461":70931,"_30095":70885,"_20902":118836,"_5":14358,"_27381":118733,"_2946":52040},[],{"_3461":70932,"_30095":70885,"_20902":118838,"_5":14358,"_27381":118733,"_2946":118839},[],"Control aplicado en la operación configurada",{"_3461":70933,"_30095":70885,"_20902":118841,"_5":14358,"_27381":118733,"_2946":52046},[],{"_3461":70934,"_30095":70885,"_20902":118843,"_5":14358,"_27381":118733,"_2946":118844},[],"Validación del certificado presentado.",{"_3461":70935,"_30095":70885,"_20902":118846,"_5":14358,"_27381":118733,"_2946":52052},[],{"_3461":70936,"_30095":70885,"_20902":118848,"_5":14358,"_27381":118733,"_2946":118849},[],"Autorización del webhook configurado.",{"_3461":70937,"_30095":70885,"_20902":118851,"_5":14358,"_27381":118733,"_2946":52058},[],{"_3461":70938,"_30095":70885,"_20902":118853,"_5":14358,"_27381":118733,"_2946":118854},[],"Validación del certificado y, después, aprobación del webhook.",{"_3461":70939,"_30095":70885,"_20902":118856,"_5":14358,"_27381":118733,"_2946":52064},[],{"_3461":70940,"_30095":70885,"_20902":118858,"_5":14358,"_27381":118733,"_2946":118859},[],"Sin autenticación del solicitante por el DMS.",{"_3461":70941,"_30095":70885,"_20902":118861,"_5":14358,"_27381":118733,"_2946":118862},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3461":70942,"_30095":70885,"_20902":118864,"_5":14358,"_27381":118733,"_2946":118865},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3461":70943,"_30095":70885,"_20902":118867,"_5":14358,"_27381":118733,"_2946":118868},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3461":70944,"_30095":70885,"_20902":118870,"_5":14358,"_27381":118733,"_2946":118871},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3461":70945,"_30095":70885,"_20902":118873,"_5":14358,"_27381":118737,"_2946":118874},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3461":70946,"_30095":70885,"_20902":118876,"_5":14358,"_27381":118737,"_2946":118877},[],"Campo de `external_webhook_settings`",{"_3461":70947,"_30095":70885,"_20902":118879,"_5":14358,"_27381":118737,"_2946":118797},[],{"_3461":70948,"_30095":70885,"_20902":118881,"_5":14358,"_27381":118737,"_2946":52090},[],{"_3461":70949,"_30095":70885,"_20902":118883,"_5":14358,"_27381":118737,"_2946":118884},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3461":70950,"_30095":70885,"_20902":118886,"_5":14358,"_27381":118737,"_2946":52096},[],{"_3461":70951,"_30095":70885,"_20902":118888,"_5":14358,"_27381":118737,"_2946":118889},[],"`POST` o `PUT`; `POST` por defecto.",{"_3461":70952,"_30095":70885,"_20902":118891,"_5":14358,"_27381":118737,"_2946":52102},[],{"_3461":70953,"_30095":70885,"_20902":118893,"_5":14358,"_27381":118737,"_2946":118894},[],"Etiqueta usada en los logs del servicio.",{"_3461":70954,"_30095":70885,"_20902":118896,"_5":14358,"_27381":118737,"_2946":52108},[],{"_3461":70955,"_30095":70885,"_20902":118898,"_5":14358,"_27381":118737,"_2946":118899},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3461":70956,"_30095":70885,"_20902":118901,"_5":14358,"_27381":118737,"_2946":52114},[],{"_3461":70957,"_30095":70885,"_20902":118903,"_5":14358,"_27381":118737,"_2946":118904},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3461":70958,"_30095":70885,"_20902":118906,"_5":14358,"_27381":118737,"_2946":52120},[],{"_3461":70959,"_30095":70885,"_20902":118908,"_5":14358,"_27381":118737,"_2946":118909},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3461":70960,"_30095":70885,"_20902":118911,"_5":14358,"_27381":118737,"_2946":52126},[],{"_3461":70961,"_30095":70885,"_20902":118913,"_5":14358,"_27381":118737,"_2946":118914},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3461":70962,"_30095":70885,"_20902":118916,"_5":14358,"_27381":118737,"_2946":52132},[],{"_3461":70963,"_30095":70885,"_20902":118918,"_5":14358,"_27381":118737,"_2946":118919},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3461":70964,"_30095":70885,"_20902":118921,"_5":14358,"_27381":118737,"_2946":52138},[],{"_3461":70965,"_30095":70885,"_20902":118923,"_5":14358,"_27381":118737,"_2946":118924},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3461":70966,"_30095":70885,"_20902":118926,"_5":14358,"_27381":118737,"_2946":52144},[],{"_3461":70967,"_30095":70885,"_20902":118928,"_5":14358,"_27381":118737,"_2946":118929},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3461":70968,"_30095":70885,"_20902":118931,"_5":14358,"_27381":118737,"_2946":118932},[],"Reglas de esa configuración:",{"_3461":70969,"_30095":70885,"_20902":118934,"_5":14358,"_27381":118737,"_2946":118935},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3461":70970,"_30095":70885,"_20902":118937,"_5":14358,"_27381":118737,"_2946":118938},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3461":70971,"_30095":70885,"_20902":118940,"_5":14358,"_27381":118737,"_2946":118941},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3461":70972,"_30095":70885,"_20902":118943,"_5":14358,"_27381":118737,"_2946":118944},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3461":70973,"_30095":70885,"_20902":118946,"_5":14358,"_27381":118737,"_2946":118947},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3461":70974,"_30095":70885,"_20902":118949,"_5":14358,"_27381":118737,"_2946":118950},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3461":70975,"_30095":70885,"_20902":118952,"_5":14358,"_27381":118737,"_2946":118953},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3461":70976,"_30095":70885,"_20902":118955,"_5":14358,"_27381":118737,"_2946":118956},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3461":70977,"_30095":70885,"_20902":118958,"_5":14358,"_27381":118737,"_2946":118959},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3461":70978,"_30095":70885,"_20902":118961,"_5":14358,"_27381":118741,"_2946":118962},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3461":70979,"_30095":70885,"_20902":118964,"_5":14358,"_27381":118745,"_2946":118965},[],"Campo de `settings.reenrollment_settings`",{"_3461":70980,"_30095":70885,"_20902":118967,"_5":14358,"_27381":118745,"_2946":118968},[],"Función",{"_3461":70981,"_30095":70885,"_20902":118970,"_5":14358,"_27381":118745,"_2946":52188},[],{"_3461":70982,"_30095":70885,"_20902":118972,"_5":14358,"_27381":118745,"_2946":118973},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3461":70983,"_30095":70885,"_20902":118975,"_5":14358,"_27381":118745,"_2946":52194},[],{"_3461":70984,"_30095":70885,"_20902":118977,"_5":14358,"_27381":118745,"_2946":118978},[],"Umbral operativo preventivo de monitorización.",{"_3461":70985,"_30095":70885,"_20902":118980,"_5":14358,"_27381":118745,"_2946":52200},[],{"_3461":70986,"_30095":70885,"_20902":118982,"_5":14358,"_27381":118745,"_2946":118983},[],"Umbral operativo crítico de monitorización.",{"_3461":70987,"_30095":70885,"_20902":118985,"_5":14358,"_27381":118745,"_2946":52206},[],{"_3461":70988,"_30095":70885,"_20902":118987,"_5":14358,"_27381":118745,"_2946":118988},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3461":70989,"_30095":70885,"_20902":118990,"_5":14358,"_27381":118745,"_2946":52212},[],{"_3461":70990,"_30095":70885,"_20902":118992,"_5":14358,"_27381":118745,"_2946":118993},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3461":70991,"_30095":70885,"_20902":118995,"_5":14358,"_27381":118745,"_2946":52218},[],{"_3461":70992,"_30095":70885,"_20902":118997,"_5":14358,"_27381":118745,"_2946":118998},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3461":70993,"_30095":70885,"_20902":119000,"_5":14358,"_27381":118745,"_2946":119001},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3461":70994,"_30095":70885,"_20902":119003,"_5":14358,"_27381":118749,"_2946":119004},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3461":70995,"_30095":70885,"_20902":119006,"_5":14358,"_27381":118752,"_2946":116369},[],{"_3461":70996,"_30095":70885,"_20902":119008,"_5":14358,"_27381":118752,"_2946":119009},[],"Qué publica",{"_3461":70997,"_30095":70885,"_20902":119011,"_5":14358,"_27381":118752,"_2946":52235},[],{"_3461":70998,"_30095":70885,"_20902":119013,"_5":14358,"_27381":118752,"_2946":119014},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3461":70999,"_30095":70885,"_20902":119016,"_5":14358,"_27381":118752,"_2946":52241},[],{"_3461":71000,"_30095":70885,"_20902":119018,"_5":14358,"_27381":118752,"_2946":119019},[],"Certificado de la CA emisora seleccionada.",{"_3461":71001,"_30095":70885,"_20902":119021,"_5":14358,"_27381":118752,"_2946":52247},[],{"_3461":71002,"_30095":70885,"_20902":119023,"_5":14358,"_27381":118752,"_2946":119024},[],"Certificados de las CAs elegidas explícitamente.",{"_3461":71003,"_30095":70885,"_20902":119026,"_5":14358,"_27381":118752,"_2946":119027},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3461":71004,"_30095":70885,"_20902":119029,"_5":14358,"_27381":118756,"_2946":119030},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3461":71005,"_30095":70885,"_20902":119032,"_5":14358,"_27381":118756,"_2946":119033},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3461":71006,"_30095":70885,"_20902":119035,"_5":14358,"_27381":118756,"_2946":119036},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3461":71007,"_30095":70885,"_20902":119038,"_5":14358,"_27381":118760,"_2946":119039},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3461":71008,"_30095":71008,"_5":14710,"_2946":119041,"_30448":119042,"_20902":119043,"_27381":71008},"Integra el cliente EST",[49146,117427,51628,118439,118614],[],{"_3461":71009,"_30095":71008,"_20902":119045,"_5":14358,"_27381":71008,"_2946":119046},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3461":71010,"_30095":71008,"_5":30445,"_20902":119048,"_27381":119049,"_2946":116005},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3461":71011,"_30095":71008,"_5":30445,"_20902":119051,"_27381":119052,"_2946":119053},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3461":71012,"_30095":71008,"_5":30445,"_20902":119055,"_27381":119056,"_2946":119057},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3461":71013,"_30095":71008,"_5":30445,"_20902":119059,"_27381":119060,"_2946":119061},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3461":71014,"_30095":71008,"_5":30445,"_20902":119063,"_27381":119064,"_2946":119065},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3461":71015,"_30095":71008,"_5":30445,"_20902":119067,"_27381":119068,"_2946":119069},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3461":71016,"_30095":71008,"_20902":119071,"_5":14358,"_27381":71008,"_2946":119072},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3461":71017,"_30095":71008,"_20902":119074,"_5":14358,"_27381":119049,"_2946":119075},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3461":71018,"_30095":71008,"_20902":119077,"_5":14358,"_27381":119049,"_2946":119078},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3461":71019,"_30095":71008,"_20902":119080,"_5":14358,"_27381":119049,"_2946":119081},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3461":71020,"_30095":71008,"_20902":119083,"_5":14358,"_27381":119052,"_2946":119084},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3461":71021,"_30095":71008,"_20902":119086,"_5":14358,"_27381":119052,"_2946":119087},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3461":71022,"_30095":71008,"_20902":119089,"_5":14358,"_27381":119056,"_2946":119090},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3461":71023,"_30095":71008,"_20902":119092,"_5":14358,"_27381":119056,"_2946":119093},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3461":71024,"_30095":71008,"_20902":119095,"_5":14358,"_27381":119060,"_2946":119096},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3461":71025,"_30095":71008,"_20902":119098,"_5":14358,"_27381":119060,"_2946":119099},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3461":71026,"_30095":71008,"_20902":119101,"_5":14358,"_27381":119064,"_2946":119102},[],"Para el caso de una raíz que emite directamente:",{"_3461":71027,"_30095":71008,"_20902":119104,"_5":14358,"_27381":119064,"_2946":119105},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3461":71028,"_30095":71008,"_20902":119107,"_5":14358,"_27381":119064,"_2946":119108},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3461":71029,"_30095":71008,"_20902":119110,"_5":14358,"_27381":119068,"_2946":119111},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3461":71030,"_30095":71030,"_5":14710,"_2946":119113,"_30448":119114,"_20902":119115,"_27381":71030},"Referencia EST",[49146,117427,51628,118439,118614],[],{"_3461":71031,"_30095":71030,"_20902":119117,"_5":14358,"_27381":71030,"_2946":119118},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3461":71032,"_30095":71030,"_5":30445,"_20902":119120,"_27381":119121,"_2946":119122},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3461":71033,"_30095":71030,"_5":30445,"_20902":119124,"_27381":119125,"_2946":22652},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3461":71034,"_30095":71030,"_5":30445,"_20902":119127,"_27381":119128,"_2946":25996},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3461":71035,"_30095":71030,"_5":30445,"_20902":119130,"_27381":119131,"_2946":26003},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3461":71036,"_30095":71030,"_5":30445,"_20902":119133,"_27381":119134,"_2946":25322},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3461":71037,"_30095":71030,"_5":30445,"_20902":119136,"_27381":119137,"_2946":119138},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3461":71038,"_30095":71030,"_5":30445,"_20902":119140,"_27381":119141,"_2946":119142},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3461":71039,"_30095":71030,"_5":30445,"_20902":119144,"_27381":119145,"_2946":119146},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3461":71040,"_30095":71030,"_20902":119148,"_5":14358,"_27381":71030,"_2946":119149},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3461":71041,"_30095":71030,"_20902":119151,"_5":14358,"_27381":119121,"_2946":119152},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3461":71042,"_30095":71030,"_20902":119154,"_5":14358,"_27381":119121,"_2946":117187},[],{"_3461":71043,"_30095":71030,"_20902":119156,"_5":14358,"_27381":119121,"_2946":119157},[],"Método",{"_3461":71044,"_30095":71030,"_20902":119159,"_5":14358,"_27381":119121,"_2946":119160},[],"Autenticación y condición",{"_3461":71045,"_30095":71030,"_20902":119162,"_5":14358,"_27381":119121,"_2946":52390},[],{"_3461":71046,"_30095":71030,"_20902":119164,"_5":14358,"_27381":119121,"_2946":52393},[],{"_3461":71047,"_30095":71030,"_20902":119166,"_5":14358,"_27381":119121,"_2946":119167},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3461":71048,"_30095":71030,"_20902":119169,"_5":14358,"_27381":119121,"_2946":52399},[],{"_3461":71049,"_30095":71030,"_20902":119171,"_5":14358,"_27381":119121,"_2946":52402},[],{"_3461":71050,"_30095":71030,"_20902":119173,"_5":14358,"_27381":119121,"_2946":119174},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3461":71051,"_30095":71030,"_20902":119176,"_5":14358,"_27381":119121,"_2946":52408},[],{"_3461":71052,"_30095":71030,"_20902":119178,"_5":14358,"_27381":119121,"_2946":52402},[],{"_3461":71053,"_30095":71030,"_20902":119180,"_5":14358,"_27381":119121,"_2946":119181},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3461":71054,"_30095":71030,"_20902":119183,"_5":14358,"_27381":119121,"_2946":52416},[],{"_3461":71055,"_30095":71030,"_20902":119185,"_5":14358,"_27381":119121,"_2946":52402},[],{"_3461":71056,"_30095":71030,"_20902":119187,"_5":14358,"_27381":119121,"_2946":119188},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3461":71057,"_30095":71030,"_20902":119190,"_5":14358,"_27381":119121,"_2946":119191},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3461":71058,"_30095":71030,"_20902":119193,"_5":14358,"_27381":119125,"_2946":119194},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3461":71059,"_30095":71030,"_20902":119196,"_5":14358,"_27381":119125,"_2946":119197},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3461":71060,"_30095":71030,"_20902":119199,"_5":14358,"_27381":119128,"_2946":119200},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3461":71061,"_30095":71030,"_20902":119202,"_5":14358,"_27381":119128,"_2946":119203},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3461":71062,"_30095":71030,"_20902":119205,"_5":14358,"_27381":119131,"_2946":119206},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3461":71063,"_30095":71030,"_20902":119208,"_5":14358,"_27381":119131,"_2946":119209},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3461":71064,"_30095":71030,"_20902":119211,"_5":14358,"_27381":119134,"_2946":119212},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3461":71065,"_30095":71030,"_20902":119214,"_5":14358,"_27381":119134,"_2946":119215},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3461":71066,"_30095":71030,"_20902":119217,"_5":14358,"_27381":119137,"_2946":119218},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3461":71067,"_30095":71030,"_20902":119220,"_5":14358,"_27381":119137,"_2946":119221},[],"Parte",{"_3461":71068,"_30095":71030,"_20902":119223,"_5":14358,"_27381":119137,"_2946":119224},[],"Contenido tras decodificar su Base64",{"_3461":71069,"_30095":71030,"_20902":119226,"_5":14358,"_27381":119137,"_2946":52460},[],{"_3461":71070,"_30095":71030,"_20902":119228,"_5":14358,"_27381":119137,"_2946":119229},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3461":71071,"_30095":71030,"_20902":119231,"_5":14358,"_27381":119137,"_2946":52466},[],{"_3461":71072,"_30095":71030,"_20902":119233,"_5":14358,"_27381":119137,"_2946":119234},[],"PKCS#7 DER con el certificado emitido.",{"_3461":71073,"_30095":71030,"_20902":119236,"_5":14358,"_27381":119137,"_2946":119237},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3461":71074,"_30095":71030,"_20902":119239,"_5":14358,"_27381":119141,"_2946":119240},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3461":71075,"_30095":71030,"_20902":119242,"_5":14358,"_27381":119141,"_2946":119243},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3461":71076,"_30095":71030,"_20902":119245,"_5":14358,"_27381":119141,"_2946":119246},[],"Convierte y comprueba el resultado:",{"_3461":71077,"_30095":71030,"_20902":119248,"_5":14358,"_27381":119141,"_2946":119249},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3461":71078,"_30095":71030,"_20902":119251,"_5":14358,"_27381":119145,"_2946":119252},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3461":71079,"_30095":71030,"_20902":119254,"_5":14358,"_27381":119145,"_2946":119255},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3461":71080,"_30095":71080,"_5":14710,"_2946":118614,"_30448":119257,"_20902":119258,"_27381":71080},[49146,117427,51628,118439,118614],[],{"_3461":71081,"_30095":71080,"_20902":119260,"_5":14358,"_27381":71080,"_2946":119261},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3461":71082,"_30095":71080,"_5":30445,"_20902":119263,"_27381":119264,"_2946":119265},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3461":71083,"_30095":71080,"_5":30445,"_20902":119267,"_27381":119268,"_2946":119269},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3461":71084,"_30095":71080,"_5":30445,"_20902":119271,"_27381":119272,"_2946":119273},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3461":71085,"_30095":71080,"_5":30445,"_20902":119275,"_27381":119276,"_2946":119277},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3461":71086,"_30095":71080,"_20902":119279,"_5":14358,"_27381":71080,"_2946":119280},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3461":71087,"_30095":71080,"_20902":119282,"_5":14358,"_27381":119264,"_2946":119283},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3461":71088,"_30095":71080,"_20902":119285,"_5":14358,"_27381":119264,"_2946":119286},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3461":71089,"_30095":71080,"_20902":119288,"_5":14358,"_27381":119264,"_2946":119289},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3461":71090,"_30095":71080,"_20902":119291,"_5":14358,"_27381":119264,"_2946":119292},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3461":71091,"_30095":71080,"_20902":119294,"_5":14358,"_27381":119264,"_2946":119295},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3461":71092,"_30095":71080,"_20902":119297,"_5":14358,"_27381":119264,"_2946":119298},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3461":71093,"_30095":71080,"_20902":119300,"_5":14358,"_27381":119268,"_2946":119301},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3461":71094,"_30095":71080,"_20902":119303,"_5":14358,"_27381":119268,"_2946":119304},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":71095,"_30095":71080,"_20902":119306,"_5":14358,"_27381":119268,"_2946":119307},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3461":71096,"_30095":71080,"_20902":119309,"_5":14358,"_27381":119268,"_2946":119310},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3461":71097,"_30095":71080,"_20902":119312,"_5":14358,"_27381":119272,"_2946":119313},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3461":71098,"_30095":71080,"_20902":119315,"_5":14358,"_27381":119272,"_2946":119316},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3461":71099,"_30095":71080,"_20902":119318,"_5":14358,"_27381":119272,"_2946":119319},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3461":71100,"_30095":71080,"_20902":119321,"_5":14358,"_27381":119272,"_2946":119322},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3461":71101,"_30095":71080,"_20902":119324,"_5":14358,"_27381":119276,"_2946":119325},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3461":71102,"_30095":71080,"_20902":119327,"_5":14358,"_27381":119276,"_2946":119328},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3461":71103,"_30095":71103,"_5":14710,"_2946":119330,"_30448":119331,"_20902":119332,"_27381":71103},"Estrategias de aprovisionamiento",[49146,117427,51628,118439,118614],[],{"_3461":71104,"_30095":71103,"_20902":119334,"_5":14358,"_27381":71103,"_2946":119335},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3461":71105,"_30095":71103,"_5":30445,"_20902":119337,"_27381":119338,"_2946":119339},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3461":71106,"_30095":71103,"_5":30445,"_20902":119341,"_27381":119342,"_2946":119343},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3461":71107,"_30095":71103,"_5":30445,"_20902":119345,"_27381":119346,"_2946":119347},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3461":71108,"_30095":71103,"_5":30445,"_20902":119349,"_27381":119350,"_2946":119351},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3461":71109,"_30095":71103,"_5":30445,"_20902":119353,"_27381":119354,"_2946":119355},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3461":71110,"_30095":71103,"_20902":119357,"_5":14358,"_27381":71103,"_2946":119358},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3461":71111,"_30095":71103,"_20902":119360,"_5":14358,"_27381":119338,"_2946":119361},[],"Recorrido",{"_3461":71112,"_30095":71103,"_20902":119363,"_5":14358,"_27381":119338,"_2946":119364},[],"Cuándo existe el dispositivo",{"_3461":71113,"_30095":71103,"_20902":119366,"_5":14358,"_27381":119338,"_2946":119367},[],"Qué compruebas",{"_3461":71114,"_30095":71103,"_20902":119369,"_5":14358,"_27381":119338,"_2946":119370},[],"Asignación manual",{"_3461":71115,"_30095":71103,"_20902":119372,"_5":14358,"_27381":119338,"_2946":119373},[],"El operador lo crea antes de asociar un certificado.",{"_3461":71116,"_30095":71103,"_20902":119375,"_5":14358,"_27381":119338,"_2946":119376},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3461":71117,"_30095":71103,"_20902":119378,"_5":14358,"_27381":119338,"_2946":119379},[],"EST con `JITP`",{"_3461":71118,"_30095":71103,"_20902":119381,"_5":14358,"_27381":119338,"_2946":119382},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3461":71119,"_30095":71103,"_20902":119384,"_5":14358,"_27381":119338,"_2946":119385},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3461":71120,"_30095":71103,"_20902":119387,"_5":14358,"_27381":119338,"_2946":119388},[],"EST con `PRE_REGISTRATION`",{"_3461":71121,"_30095":71103,"_20902":119390,"_5":14358,"_27381":119338,"_2946":119391},[],"Debe existir antes de `/simpleenroll`.",{"_3461":71122,"_30095":71103,"_20902":119393,"_5":14358,"_27381":119338,"_2946":119394},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3461":71123,"_30095":71103,"_20902":119396,"_5":14358,"_27381":119338,"_2946":119397},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3461":71124,"_30095":71103,"_20902":119399,"_5":14358,"_27381":119338,"_2946":119400},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3461":71125,"_30095":71103,"_20902":119402,"_5":14358,"_27381":119342,"_2946":119403},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3461":71126,"_30095":71103,"_20902":119405,"_5":14358,"_27381":119342,"_2946":119406},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3461":71127,"_30095":71103,"_20902":119408,"_5":14358,"_27381":119342,"_2946":119409},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3461":71128,"_30095":71103,"_20902":119411,"_5":14358,"_27381":119346,"_2946":119412},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3461":71129,"_30095":71103,"_20902":119414,"_5":14358,"_27381":119346,"_2946":119415},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3461":71130,"_30095":71103,"_20902":119417,"_5":14358,"_27381":119346,"_2946":119418},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3461":71131,"_30095":71103,"_20902":119420,"_5":14358,"_27381":119346,"_2946":119421},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3461":71132,"_30095":71103,"_20902":119423,"_5":14358,"_27381":119346,"_2946":119424},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3461":71133,"_30095":71103,"_20902":119426,"_5":14358,"_27381":119346,"_2946":119427},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3461":71134,"_30095":71103,"_20902":119429,"_5":14358,"_27381":119350,"_2946":116369},[],{"_3461":71135,"_30095":71103,"_20902":119431,"_5":14358,"_27381":119350,"_2946":119432},[],"Material que atraviesa EST",{"_3461":71136,"_30095":71103,"_20902":119434,"_5":14358,"_27381":119350,"_2946":119435},[],"Clave generada por el dispositivo",{"_3461":71137,"_30095":71103,"_20902":119437,"_5":14358,"_27381":119350,"_2946":119438},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3461":71138,"_30095":71103,"_20902":119440,"_5":14358,"_27381":119350,"_2946":119441},[],"Clave ya disponible en el dispositivo",{"_3461":71139,"_30095":71103,"_20902":119443,"_5":14358,"_27381":119350,"_2946":119444},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3461":71140,"_30095":71103,"_20902":119446,"_5":14358,"_27381":119350,"_2946":51947},[],{"_3461":71141,"_30095":71103,"_20902":119448,"_5":14358,"_27381":119350,"_2946":119449},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3461":71142,"_30095":71103,"_20902":119451,"_5":14358,"_27381":119350,"_2946":119452},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3461":71143,"_30095":71103,"_20902":119454,"_5":14358,"_27381":119354,"_2946":119455},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3461":71144,"_30095":71144,"_5":14710,"_2946":119457,"_30448":119458,"_20902":119459,"_27381":71144},"Renovación y recuperación",[49146,117427,51628,118439,118614],[],{"_3461":71145,"_30095":71144,"_20902":119461,"_5":14358,"_27381":71144,"_2946":119462},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3461":71146,"_30095":71144,"_5":30445,"_20902":119464,"_27381":119465,"_2946":119466},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3461":71147,"_30095":71144,"_5":30445,"_20902":119468,"_27381":119469,"_2946":119470},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3461":71148,"_30095":71144,"_5":30445,"_20902":119472,"_27381":119473,"_2946":119474},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3461":71149,"_30095":71144,"_5":30445,"_20902":119476,"_27381":119477,"_2946":119478},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3461":71150,"_30095":71144,"_5":30445,"_20902":119480,"_27381":119481,"_2946":119482},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3461":71151,"_30095":71144,"_20902":119484,"_5":14358,"_27381":71144,"_2946":119485},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3461":71152,"_30095":71144,"_20902":119487,"_5":14358,"_27381":119465,"_2946":119488},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3461":71153,"_30095":71144,"_20902":119490,"_5":14358,"_27381":119465,"_2946":119491},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3461":71154,"_30095":71144,"_20902":119493,"_5":14358,"_27381":119465,"_2946":119494},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3461":71155,"_30095":71144,"_20902":119496,"_5":14358,"_27381":119465,"_2946":119497},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3461":71156,"_30095":71144,"_20902":119499,"_5":14358,"_27381":119469,"_2946":119500},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3461":71157,"_30095":71144,"_20902":119502,"_5":14358,"_27381":119469,"_2946":119503},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3461":71158,"_30095":71144,"_20902":119505,"_5":14358,"_27381":119473,"_2946":119506},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3461":71159,"_30095":71144,"_20902":119508,"_5":14358,"_27381":119473,"_2946":119509},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3461":71160,"_30095":71144,"_20902":119511,"_5":14358,"_27381":119473,"_2946":119512},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3461":71161,"_30095":71144,"_20902":119514,"_5":14358,"_27381":119477,"_2946":119515},[],"Situación",{"_3461":71162,"_30095":71144,"_20902":119517,"_5":14358,"_27381":119477,"_2946":119518},[],"Procedimiento",{"_3461":71163,"_30095":71144,"_20902":119520,"_5":14358,"_27381":119477,"_2946":119521},[],"Certificado vigente, fuera de ventana",{"_3461":71164,"_30095":71144,"_20902":119523,"_5":14358,"_27381":119477,"_2946":119524},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3461":71165,"_30095":71144,"_20902":119526,"_5":14358,"_27381":119477,"_2946":119527},[],"Certificado vencido, clave disponible",{"_3461":71166,"_30095":71144,"_20902":119529,"_5":14358,"_27381":119477,"_2946":119530},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3461":71167,"_30095":71144,"_20902":119532,"_5":14358,"_27381":119477,"_2946":119533},[],"Renovación por webhook o `NO_AUTH`",{"_3461":71168,"_30095":71144,"_20902":119535,"_5":14358,"_27381":119477,"_2946":119536},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3461":71169,"_30095":71144,"_20902":119538,"_5":14358,"_27381":119477,"_2946":119539},[],"Clave perdida o inaccesible",{"_3461":71170,"_30095":71144,"_20902":119541,"_5":14358,"_27381":119477,"_2946":119542},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3461":71171,"_30095":71144,"_20902":119544,"_5":14358,"_27381":119477,"_2946":119545},[],"Identidad actual revocada",{"_3461":71172,"_30095":71144,"_20902":119547,"_5":14358,"_27381":119477,"_2946":119548},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3461":71173,"_30095":71144,"_20902":119550,"_5":14358,"_27381":119477,"_2946":119551},[],"Dispositivo sin identidad",{"_3461":71174,"_30095":71144,"_20902":119553,"_5":14358,"_27381":119477,"_2946":119554},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3461":71175,"_30095":71144,"_20902":119556,"_5":14358,"_27381":119477,"_2946":119557},[],"Dispositivo retirado",{"_3461":71176,"_30095":71144,"_20902":119559,"_5":14358,"_27381":119477,"_2946":119560},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3461":71177,"_30095":71144,"_20902":119562,"_5":14358,"_27381":119477,"_2946":119563},[],"Timeout, HTTP 500 o fallo de instalación",{"_3461":71178,"_30095":71144,"_20902":119565,"_5":14358,"_27381":119477,"_2946":119566},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3461":71179,"_30095":71144,"_20902":119568,"_5":14358,"_27381":119481,"_2946":119569},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3461":71180,"_30095":71144,"_20902":119571,"_5":14358,"_27381":119481,"_2946":119572},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3461":71181,"_30095":71181,"_5":14710,"_2946":119574,"_30448":119575,"_20902":119576,"_27381":71181},"Diagnóstico de enrolamiento",[49146,117427,51628,118439,118614],[],{"_3461":71182,"_30095":71181,"_20902":119578,"_5":14358,"_27381":71181,"_2946":119579},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3461":71183,"_30095":71181,"_5":30445,"_20902":119581,"_27381":119582,"_2946":119583},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3461":71184,"_30095":71181,"_5":30445,"_20902":119585,"_27381":119586,"_2946":119587},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3461":71185,"_30095":71181,"_5":30445,"_20902":119589,"_27381":119590,"_2946":119146},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3461":71186,"_30095":71181,"_5":30445,"_20902":119592,"_27381":119593,"_2946":119594},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3461":71187,"_30095":71181,"_20902":119596,"_5":14358,"_27381":71181,"_2946":119597},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3461":71188,"_30095":71181,"_20902":119599,"_5":14358,"_27381":119586,"_2946":119600},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3461":71189,"_30095":71181,"_20902":119602,"_5":14358,"_27381":119586,"_2946":119603},[],"Síntoma o mensaje",{"_3461":71190,"_30095":71181,"_20902":119605,"_5":14358,"_27381":119586,"_2946":119606},[],"Qué revisar",{"_3461":71191,"_30095":71181,"_20902":119608,"_5":14358,"_27381":119586,"_2946":119609},[],"curl rechaza TLS, nombre o emisor",{"_3461":71192,"_30095":71181,"_20902":119611,"_5":14358,"_27381":119586,"_2946":119612},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3461":71193,"_30095":71181,"_20902":119614,"_5":14358,"_27381":119586,"_2946":119615},[],"404 o APS ausente",{"_3461":71194,"_30095":71181,"_20902":119617,"_5":14358,"_27381":119586,"_2946":119618},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3461":71195,"_30095":71181,"_20902":119620,"_5":14358,"_27381":119586,"_2946":119621},[],"400, error de CSR o formato",{"_3461":71196,"_30095":71181,"_20902":119623,"_5":14358,"_27381":119586,"_2946":119624},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3461":71197,"_30095":71181,"_20902":119626,"_5":14358,"_27381":119586,"_2946":119627},[],"Credencial ausente o certificado no válido",{"_3461":71198,"_30095":71181,"_20902":119629,"_5":14358,"_27381":119586,"_2946":119630},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3461":71199,"_30095":71181,"_20902":119632,"_5":14358,"_27381":119586,"_2946":119633},[],"Webhook deniega, expira o responde sin autorización",{"_3461":71200,"_30095":71181,"_20902":119635,"_5":14358,"_27381":119586,"_2946":119636},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3461":71201,"_30095":71181,"_20902":119638,"_5":14358,"_27381":119586,"_2946":52873},[],{"_3461":71202,"_30095":71181,"_20902":119640,"_5":14358,"_27381":119586,"_2946":119641},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3461":71203,"_30095":71181,"_20902":119643,"_5":14358,"_27381":119586,"_2946":52879},[],{"_3461":71204,"_30095":71181,"_20902":119645,"_5":14358,"_27381":119586,"_2946":119646},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3461":71205,"_30095":71181,"_20902":119648,"_5":14358,"_27381":119586,"_2946":52885},[],{"_3461":71206,"_30095":71181,"_20902":119650,"_5":14358,"_27381":119586,"_2946":119651},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3461":71207,"_30095":71181,"_20902":119653,"_5":14358,"_27381":119586,"_2946":52891},[],{"_3461":71208,"_30095":71181,"_20902":119655,"_5":14358,"_27381":119586,"_2946":119656},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3461":71209,"_30095":71181,"_20902":119658,"_5":14358,"_27381":119586,"_2946":52897},[],{"_3461":71210,"_30095":71181,"_20902":119660,"_5":14358,"_27381":119586,"_2946":119661},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3461":71211,"_30095":71181,"_20902":119663,"_5":14358,"_27381":119586,"_2946":119664},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3461":71212,"_30095":71181,"_20902":119666,"_5":14358,"_27381":119586,"_2946":119667},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3461":71213,"_30095":71181,"_20902":119669,"_5":14358,"_27381":119586,"_2946":119670},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3461":71214,"_30095":71181,"_20902":119672,"_5":14358,"_27381":119586,"_2946":119673},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3461":71215,"_30095":71181,"_20902":119675,"_5":14358,"_27381":119586,"_2946":52915},[],{"_3461":71216,"_30095":71181,"_20902":119677,"_5":14358,"_27381":119586,"_2946":119678},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3461":71217,"_30095":71181,"_20902":119680,"_5":14358,"_27381":119586,"_2946":52921},[],{"_3461":71218,"_30095":71181,"_20902":119682,"_5":14358,"_27381":119586,"_2946":119683},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3461":71219,"_30095":71181,"_20902":119685,"_5":14358,"_27381":119586,"_2946":119686},[],"DMS propietario distinto",{"_3461":71220,"_30095":71181,"_20902":119688,"_5":14358,"_27381":119586,"_2946":119689},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3461":71221,"_30095":71181,"_20902":119691,"_5":14358,"_27381":119586,"_2946":52933},[],{"_3461":71222,"_30095":71181,"_20902":119693,"_5":14358,"_27381":119586,"_2946":119694},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3461":71223,"_30095":71181,"_20902":119696,"_5":14358,"_27381":119586,"_2946":52939},[],{"_3461":71224,"_30095":71181,"_20902":119698,"_5":14358,"_27381":119586,"_2946":119699},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3461":71225,"_30095":71181,"_20902":119701,"_5":14358,"_27381":119586,"_2946":119702},[],"Certificado actual revocado",{"_3461":71226,"_30095":71181,"_20902":119704,"_5":14358,"_27381":119586,"_2946":119705},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3461":71227,"_30095":71181,"_20902":119707,"_5":14358,"_27381":119586,"_2946":119708},[],"Error de CA, perfil o firma",{"_3461":71228,"_30095":71181,"_20902":119710,"_5":14358,"_27381":119586,"_2946":119711},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3461":71229,"_30095":71181,"_20902":119713,"_5":14358,"_27381":119586,"_2946":119714},[],"HTTP 200 sin conexión del dispositivo",{"_3461":71230,"_30095":71181,"_20902":119716,"_5":14358,"_27381":119586,"_2946":119717},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3461":71231,"_30095":71181,"_20902":119719,"_5":14358,"_27381":119586,"_2946":119720},[],"Timeout o error después de emitir",{"_3461":71232,"_30095":71181,"_20902":119722,"_5":14358,"_27381":119586,"_2946":119723},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3461":71233,"_30095":71181,"_20902":119725,"_5":14358,"_27381":119590,"_2946":119726},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3461":71234,"_30095":71181,"_20902":119728,"_5":14358,"_27381":119590,"_2946":119729},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3461":71235,"_30095":71181,"_20902":119731,"_5":14358,"_27381":119593,"_2946":119732},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3461":71236,"_30095":71181,"_20902":119734,"_5":14358,"_27381":119593,"_2946":119735},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3461":71237,"_30095":71181,"_20902":119737,"_5":14358,"_27381":119593,"_2946":119738},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3461":71238,"_30095":71181,"_20902":119740,"_5":14358,"_27381":119593,"_2946":119741},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3461":71239,"_30095":71181,"_20902":119743,"_5":14358,"_27381":119593,"_2946":119744},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3461":71240,"_30095":71181,"_20902":119746,"_5":14358,"_27381":119593,"_2946":119747},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3461":71241,"_30095":71181,"_20902":119749,"_5":14358,"_27381":119593,"_2946":119750},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3461":71242,"_30095":71242,"_5":14710,"_2946":119752,"_30448":119753,"_20902":119754,"_27381":71242},"Distribución y actualización de confianza",[49146,117427,51628,118439,118614],[],{"_3461":71243,"_30095":71242,"_20902":119756,"_5":14358,"_27381":71242,"_2946":119757},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3461":71244,"_30095":71242,"_5":30445,"_20902":119759,"_27381":119760,"_2946":119761},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3461":71245,"_30095":71242,"_5":30445,"_20902":119763,"_27381":119764,"_2946":119765},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3461":71246,"_30095":71242,"_5":30445,"_20902":119767,"_27381":119768,"_2946":119769},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3461":71247,"_30095":71242,"_5":30445,"_20902":119771,"_27381":119772,"_2946":119773},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3461":71248,"_30095":71242,"_5":30445,"_20902":119775,"_27381":119776,"_2946":119777},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3461":71249,"_30095":71242,"_20902":119779,"_5":14358,"_27381":71242,"_2946":119780},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3461":71250,"_30095":71242,"_20902":119782,"_5":14358,"_27381":119760,"_2946":119783},[],"Relación",{"_3461":71251,"_30095":71242,"_20902":119785,"_5":14358,"_27381":119760,"_2946":119786},[],"Material que prepara el responsable",{"_3461":71252,"_30095":71242,"_20902":119788,"_5":14358,"_27381":119760,"_2946":119789},[],"Dispositivo → servidor EST",{"_3461":71253,"_30095":71242,"_20902":119791,"_5":14358,"_27381":119760,"_2946":119792},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3461":71254,"_30095":71242,"_20902":119794,"_5":14358,"_27381":119760,"_2946":119795},[],"DMS → solicitante",{"_3461":71255,"_30095":71242,"_20902":119797,"_5":14358,"_27381":119760,"_2946":119798},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3461":71256,"_30095":71242,"_20902":119800,"_5":14358,"_27381":119760,"_2946":119801},[],"Consumidor → dispositivo",{"_3461":71257,"_30095":71242,"_20902":119803,"_5":14358,"_27381":119760,"_2946":119804},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3461":71258,"_30095":71242,"_20902":119806,"_5":14358,"_27381":119760,"_2946":119807},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3461":71259,"_30095":71242,"_20902":119809,"_5":14358,"_27381":119764,"_2946":119810},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3461":71260,"_30095":71242,"_20902":119812,"_5":14358,"_27381":119764,"_2946":119813},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3461":71261,"_30095":71242,"_20902":119815,"_5":14358,"_27381":119768,"_2946":119816},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3461":71262,"_30095":71242,"_20902":119818,"_5":14358,"_27381":119768,"_2946":119819},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3461":71263,"_30095":71242,"_20902":119821,"_5":14358,"_27381":119768,"_2946":119822},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3461":71264,"_30095":71242,"_20902":119824,"_5":14358,"_27381":119768,"_2946":119825},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3461":71265,"_30095":71242,"_20902":119827,"_5":14358,"_27381":119768,"_2946":119828},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3461":71266,"_30095":71242,"_20902":119830,"_5":14358,"_27381":119768,"_2946":119831},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3461":71267,"_30095":71242,"_20902":119833,"_5":14358,"_27381":119772,"_2946":119834},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3461":71268,"_30095":71242,"_20902":119836,"_5":14358,"_27381":119772,"_2946":119837},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3461":71269,"_30095":71242,"_20902":119839,"_5":14358,"_27381":119772,"_2946":119840},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3461":71270,"_30095":71242,"_20902":119842,"_5":14358,"_27381":119776,"_2946":119843},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3461":71271,"_30095":71271,"_5":14710,"_2946":53088,"_30448":119845,"_20902":119847,"_27381":71271},[49146,117427,51628,118439,119846],"Integraciones",[],{"_3461":71272,"_30095":71271,"_20902":119849,"_5":14358,"_27381":71271,"_2946":119850},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3461":71273,"_30095":71271,"_5":30445,"_20902":119852,"_27381":119853,"_2946":119854},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3461":71274,"_30095":71271,"_5":30445,"_20902":119856,"_27381":119857,"_2946":119858},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3461":71275,"_30095":71271,"_5":30445,"_20902":119860,"_27381":119861,"_2946":119862},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3461":71276,"_30095":71271,"_5":30445,"_20902":119864,"_27381":119865,"_2946":119866},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3461":71277,"_30095":71271,"_5":30445,"_20902":119868,"_27381":119869,"_2946":119870},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3461":71278,"_30095":71271,"_5":30445,"_20902":119872,"_27381":119873,"_2946":119874},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3461":71279,"_30095":71271,"_5":30445,"_20902":119876,"_27381":119877,"_2946":119878},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3461":71280,"_30095":71271,"_5":30445,"_20902":119880,"_27381":119881,"_2946":119882},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3461":71281,"_30095":71271,"_5":30445,"_20902":119884,"_27381":119885,"_2946":53130},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3461":71282,"_30095":71271,"_5":30445,"_20902":119887,"_27381":119888,"_2946":53134},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3461":71283,"_30095":71271,"_5":30445,"_20902":119890,"_27381":119891,"_2946":119892},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3461":71284,"_30095":71271,"_5":30445,"_20902":119894,"_27381":119895,"_2946":119896},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3461":71285,"_30095":71271,"_5":30445,"_20902":119898,"_27381":119899,"_2946":119900},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3461":71286,"_30095":71271,"_5":30445,"_20902":119902,"_27381":119903,"_2946":119904},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3461":71287,"_30095":71271,"_5":30445,"_20902":119906,"_27381":119907,"_2946":119908},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3461":71288,"_30095":71271,"_5":30445,"_20902":119910,"_27381":119911,"_2946":119912},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3461":71289,"_30095":71271,"_5":30445,"_20902":119914,"_27381":119915,"_2946":119916},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3461":71290,"_30095":71271,"_5":30445,"_20902":119918,"_27381":119919,"_2946":119920},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3461":71291,"_30095":71271,"_5":30445,"_20902":119922,"_27381":119923,"_2946":119924},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3461":71292,"_30095":71271,"_5":30445,"_20902":119926,"_27381":119927,"_2946":119928},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3461":71293,"_30095":71271,"_5":30445,"_20902":119930,"_27381":119931,"_2946":119932},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3461":71294,"_30095":71271,"_5":30445,"_20902":119934,"_27381":119935,"_2946":119936},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3461":71295,"_30095":71271,"_5":30445,"_20902":119938,"_27381":119939,"_2946":119940},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3461":71296,"_30095":71271,"_5":30445,"_20902":119942,"_27381":119943,"_2946":119944},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3461":71297,"_30095":71271,"_5":30445,"_20902":119946,"_27381":119947,"_2946":119948},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3461":71298,"_30095":71271,"_20902":119950,"_5":14358,"_27381":71271,"_2946":119951},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3461":71299,"_30095":71271,"_20902":119953,"_5":14358,"_27381":71271,"_2946":119954},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3461":71300,"_30095":71271,"_20902":119956,"_5":14358,"_27381":71271,"_2946":119957},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3461":71301,"_30095":71271,"_20902":119959,"_5":14358,"_27381":119853,"_2946":119960},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3461":71302,"_30095":71271,"_20902":119962,"_5":14358,"_27381":119853,"_2946":119963},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3461":71303,"_30095":71271,"_20902":119965,"_5":14358,"_27381":119853,"_2946":119966},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3461":71304,"_30095":71271,"_20902":119968,"_5":14358,"_27381":119853,"_2946":119969},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3461":71305,"_30095":71271,"_20902":119971,"_5":14358,"_27381":119857,"_2946":119972},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3461":71306,"_30095":71271,"_20902":119974,"_5":14358,"_27381":119861,"_2946":119975},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3461":71307,"_30095":71271,"_20902":119977,"_5":14358,"_27381":119861,"_2946":119978},[],"Acción IAM",{"_3461":71308,"_30095":71271,"_20902":119980,"_5":14358,"_27381":119861,"_2946":116375},[],{"_3461":71309,"_30095":71271,"_20902":119982,"_5":14358,"_27381":119861,"_2946":53229},[],{"_3461":71310,"_30095":71271,"_20902":119984,"_5":14358,"_27381":119861,"_2946":119985},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3461":71311,"_30095":71271,"_20902":119987,"_5":14358,"_27381":119861,"_2946":53235},[],{"_3461":71312,"_30095":71271,"_20902":119989,"_5":14358,"_27381":119861,"_2946":119990},[],"Registrar la CA en AWS IoT",{"_3461":71313,"_30095":71271,"_20902":119992,"_5":14358,"_27381":119861,"_2946":53241},[],{"_3461":71314,"_30095":71271,"_20902":119994,"_5":14358,"_27381":119861,"_2946":119995},[],"Consultar el estado del registro de la CA",{"_3461":71315,"_30095":71271,"_20902":119997,"_5":14358,"_27381":119861,"_2946":53247},[],{"_3461":71316,"_30095":71271,"_20902":119999,"_5":14358,"_27381":119861,"_2946":120000},[],"Crear o actualizar Things en IoT Core",{"_3461":71317,"_30095":71271,"_20902":120002,"_5":14358,"_27381":119861,"_2946":53253},[],{"_3461":71318,"_30095":71271,"_20902":120004,"_5":14358,"_27381":119861,"_2946":120005},[],"Aprovisionar Things mediante plantilla",{"_3461":71319,"_30095":71271,"_20902":120007,"_5":14358,"_27381":119861,"_2946":53259},[],{"_3461":71320,"_30095":71271,"_20902":120009,"_5":14358,"_27381":119861,"_2946":120010},[],"Registrar certificados de dispositivo",{"_3461":71321,"_30095":71271,"_20902":120012,"_5":14358,"_27381":119861,"_2946":53265},[],{"_3461":71322,"_30095":71271,"_20902":120014,"_5":14358,"_27381":119861,"_2946":120015},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3461":71323,"_30095":71271,"_20902":120017,"_5":14358,"_27381":119861,"_2946":53271},[],{"_3461":71324,"_30095":71271,"_20902":120019,"_5":14358,"_27381":119861,"_2946":120020},[],"Crear y adjuntar políticas IoT",{"_3461":71325,"_30095":71271,"_20902":120022,"_5":14358,"_27381":119861,"_2946":53277},[],{"_3461":71326,"_30095":71271,"_20902":120024,"_5":14358,"_27381":119861,"_2946":120025},[],"Gestionar grupos de Things",{"_3461":71327,"_30095":71271,"_20902":120027,"_5":14358,"_27381":119861,"_2946":53283},[],{"_3461":71328,"_30095":71271,"_20902":120029,"_5":14358,"_27381":119861,"_2946":120030},[],"Crear plantillas JITP",{"_3461":71329,"_30095":71271,"_20902":120032,"_5":14358,"_27381":119861,"_2946":53289},[],{"_3461":71330,"_30095":71271,"_20902":120034,"_5":14358,"_27381":119861,"_2946":120035},[],"Leer y escribir el Device Shadow",{"_3461":71331,"_30095":71271,"_20902":120037,"_5":14358,"_27381":119861,"_2946":120038},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3461":71332,"_30095":71271,"_20902":120040,"_5":14358,"_27381":119865,"_2946":120041},[],"Parámetro",{"_3461":71333,"_30095":71271,"_20902":120043,"_5":14358,"_27381":119865,"_2946":120044},[],"Tipo",{"_3461":71334,"_30095":71271,"_20902":120046,"_5":14358,"_27381":119865,"_2946":120047},[],"Requerido",{"_3461":71335,"_30095":71271,"_20902":120049,"_5":14358,"_27381":119865,"_2946":120050},[],"Descripción",{"_3461":71336,"_30095":71271,"_20902":120052,"_5":14358,"_27381":119865,"_2946":53310},[],{"_3461":71337,"_30095":71271,"_20902":120054,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71338,"_30095":71271,"_20902":120056,"_5":14358,"_27381":119865,"_2946":120057},[],"Sí",{"_3461":71339,"_30095":71271,"_20902":120059,"_5":14358,"_27381":119865,"_2946":120060},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3461":71340,"_30095":71271,"_20902":120062,"_5":14358,"_27381":119865,"_2946":53321},[],{"_3461":71341,"_30095":71271,"_20902":120064,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71342,"_30095":71271,"_20902":120066,"_5":14358,"_27381":119865,"_2946":120057},[],{"_3461":71343,"_30095":71271,"_20902":120068,"_5":14358,"_27381":119865,"_2946":120069},[],"Región AWS donde opera el conector.",{"_3461":71344,"_30095":71271,"_20902":120071,"_5":14358,"_27381":119865,"_2946":53331},[],{"_3461":71345,"_30095":71271,"_20902":120073,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71346,"_30095":71271,"_20902":120075,"_5":14358,"_27381":119865,"_2946":120057},[],{"_3461":71347,"_30095":71271,"_20902":120077,"_5":14358,"_27381":119865,"_2946":120078},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3461":71348,"_30095":71271,"_20902":120080,"_5":14358,"_27381":119865,"_2946":53341},[],{"_3461":71349,"_30095":71271,"_20902":120082,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71350,"_30095":71271,"_20902":120084,"_5":14358,"_27381":119865,"_2946":120085},[],"Solo con `auth_method=static`",{"_3461":71351,"_30095":71271,"_20902":120087,"_5":14358,"_27381":119865,"_2946":120088},[],"Clave de acceso AWS.",{"_3461":71352,"_30095":71271,"_20902":120090,"_5":14358,"_27381":119865,"_2946":53352},[],{"_3461":71353,"_30095":71271,"_20902":120092,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71354,"_30095":71271,"_20902":120094,"_5":14358,"_27381":119865,"_2946":120085},[],{"_3461":71355,"_30095":71271,"_20902":120096,"_5":14358,"_27381":119865,"_2946":120097},[],"Clave secreta AWS.",{"_3461":71356,"_30095":71271,"_20902":120099,"_5":14358,"_27381":119865,"_2946":53362},[],{"_3461":71357,"_30095":71271,"_20902":120101,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71358,"_30095":71271,"_20902":120103,"_5":14358,"_27381":119865,"_2946":53367},[],{"_3461":71359,"_30095":71271,"_20902":120105,"_5":14358,"_27381":119865,"_2946":120106},[],"Token de sesión (con `auth_method=static`).",{"_3461":71360,"_30095":71271,"_20902":120108,"_5":14358,"_27381":119865,"_2946":53373},[],{"_3461":71361,"_30095":71271,"_20902":120110,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71362,"_30095":71271,"_20902":120112,"_5":14358,"_27381":119865,"_2946":120113},[],"Solo con `auth_method=role`",{"_3461":71363,"_30095":71271,"_20902":120115,"_5":14358,"_27381":119865,"_2946":120116},[],"ARN del rol a asumir.",{"_3461":71364,"_30095":71271,"_20902":120118,"_5":14358,"_27381":119865,"_2946":53384},[],{"_3461":71365,"_30095":71271,"_20902":120120,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71366,"_30095":71271,"_20902":120122,"_5":14358,"_27381":119865,"_2946":53367},[],{"_3461":71367,"_30095":71271,"_20902":120124,"_5":14358,"_27381":119865,"_2946":120125},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3461":71368,"_30095":71271,"_20902":120127,"_5":14358,"_27381":119865,"_2946":53394},[],{"_3461":71369,"_30095":71271,"_20902":120129,"_5":14358,"_27381":119865,"_2946":89561},[],{"_3461":71370,"_30095":71271,"_20902":120131,"_5":14358,"_27381":119865,"_2946":120057},[],{"_3461":71371,"_30095":71271,"_20902":120133,"_5":14358,"_27381":119865,"_2946":120134},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3461":71372,"_30095":71271,"_20902":120136,"_5":14358,"_27381":119865,"_2946":53404},[],{"_3461":71373,"_30095":71271,"_20902":120138,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71374,"_30095":71271,"_20902":120140,"_5":14358,"_27381":119865,"_2946":120057},[],{"_3461":71375,"_30095":71271,"_20902":120142,"_5":14358,"_27381":119865,"_2946":120143},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3461":71376,"_30095":71271,"_20902":120145,"_5":14358,"_27381":119865,"_2946":53414},[],{"_3461":71377,"_30095":71271,"_20902":120147,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71378,"_30095":71271,"_20902":120149,"_5":14358,"_27381":119865,"_2946":120057},[],{"_3461":71379,"_30095":71271,"_20902":120151,"_5":14358,"_27381":119865,"_2946":120152},[],"URL HTTP del Device Manager de Lamassu.",{"_3461":71380,"_30095":71271,"_20902":120154,"_5":14358,"_27381":119865,"_2946":53424},[],{"_3461":71381,"_30095":71271,"_20902":120156,"_5":14358,"_27381":119865,"_2946":24962},[],{"_3461":71382,"_30095":71271,"_20902":120158,"_5":14358,"_27381":119865,"_2946":120057},[],{"_3461":71383,"_30095":71271,"_20902":120160,"_5":14358,"_27381":119865,"_2946":120161},[],"URL HTTP del servicio de CA de Lamassu.",{"_3461":71384,"_30095":71271,"_20902":120163,"_5":14358,"_27381":119869,"_2946":120164},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3461":71385,"_30095":71271,"_20902":120166,"_5":14358,"_27381":119869,"_2946":120167},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3461":71386,"_30095":71271,"_20902":120169,"_5":14358,"_27381":119869,"_2946":120170},[],"Tipo de CloudEvent",{"_3461":71387,"_30095":71271,"_20902":120172,"_5":14358,"_27381":119869,"_2946":120173},[],"Recurso en Lamassu",{"_3461":71388,"_30095":71271,"_20902":120175,"_5":14358,"_27381":119869,"_2946":120176},[],"Recurso AWS",{"_3461":71389,"_30095":71271,"_20902":120178,"_5":14358,"_27381":119869,"_2946":120179},[],"Acciones IAM",{"_3461":71390,"_30095":71271,"_20902":120181,"_5":14358,"_27381":119869,"_2946":120182},[],"Llamadas AWS y efecto",{"_3461":71391,"_30095":71271,"_20902":120184,"_5":14358,"_27381":119869,"_2946":120185},[],"Dónde en esta página",{"_3461":71392,"_30095":71271,"_20902":120187,"_5":14358,"_27381":119869,"_2946":53458},[],{"_3461":71393,"_30095":71271,"_20902":120189,"_5":14358,"_27381":119869,"_2946":53461},[],{"_3461":71394,"_30095":71271,"_20902":120191,"_5":14358,"_27381":119869,"_2946":53464},[],{"_3461":71395,"_30095":71271,"_20902":120193,"_5":14358,"_27381":119869,"_2946":53467},[],{"_3461":71396,"_30095":71271,"_20902":120195,"_5":14358,"_27381":119869,"_2946":120196},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3461":71397,"_30095":71271,"_20902":120198,"_5":14358,"_27381":119869,"_2946":119882},[],{"_3461":71398,"_30095":71271,"_20902":120200,"_5":14358,"_27381":119869,"_2946":53475},[],{"_3461":71399,"_30095":71271,"_20902":120202,"_5":14358,"_27381":119869,"_2946":53478},[],{"_3461":71400,"_30095":71271,"_20902":120204,"_5":14358,"_27381":119869,"_2946":53481},[],{"_3461":71401,"_30095":71271,"_20902":120206,"_5":14358,"_27381":119869,"_2946":53484},[],{"_3461":71402,"_30095":71271,"_20902":120208,"_5":14358,"_27381":119869,"_2946":120209},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3461":71403,"_30095":71271,"_20902":120211,"_5":14358,"_27381":119869,"_2946":119908},[],{"_3461":71404,"_30095":71271,"_20902":120213,"_5":14358,"_27381":119869,"_2946":53492},[],{"_3461":71405,"_30095":71271,"_20902":120215,"_5":14358,"_27381":119869,"_2946":120216},[],"Dispositivo",{"_3461":71406,"_30095":71271,"_20902":120218,"_5":14358,"_27381":119869,"_2946":53498},[],{"_3461":71407,"_30095":71271,"_20902":120220,"_5":14358,"_27381":119869,"_2946":53501},[],{"_3461":71408,"_30095":71271,"_20902":120222,"_5":14358,"_27381":119869,"_2946":120223},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3461":71409,"_30095":71271,"_20902":120225,"_5":14358,"_27381":119869,"_2946":119916},[],{"_3461":71410,"_30095":71271,"_20902":120227,"_5":14358,"_27381":119869,"_2946":53509},[],{"_3461":71411,"_30095":71271,"_20902":120229,"_5":14358,"_27381":119869,"_2946":120230},[],"Certificado",{"_3461":71412,"_30095":71271,"_20902":120232,"_5":14358,"_27381":119869,"_2946":53515},[],{"_3461":71413,"_30095":71271,"_20902":120234,"_5":14358,"_27381":119869,"_2946":120235},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3461":71414,"_30095":71271,"_20902":120237,"_5":14358,"_27381":119869,"_2946":120238},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3461":71415,"_30095":71271,"_20902":120240,"_5":14358,"_27381":119869,"_2946":119928},[],{"_3461":71416,"_30095":71271,"_20902":120242,"_5":14358,"_27381":119869,"_2946":53526},[],{"_3461":71417,"_30095":71271,"_20902":120244,"_5":14358,"_27381":119869,"_2946":120245},[],"Certificado / Dispositivo",{"_3461":71418,"_30095":71271,"_20902":120247,"_5":14358,"_27381":119869,"_2946":53532},[],{"_3461":71419,"_30095":71271,"_20902":120249,"_5":14358,"_27381":119869,"_2946":49542},[],{"_3461":71420,"_30095":71271,"_20902":120251,"_5":14358,"_27381":119869,"_2946":120252},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3461":71421,"_30095":71271,"_20902":120254,"_5":14358,"_27381":119869,"_2946":119936},[],{"_3461":71422,"_30095":71271,"_20902":120256,"_5":14358,"_27381":119873,"_2946":120257},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3461":71423,"_30095":71271,"_20902":120259,"_5":14358,"_27381":119877,"_2946":120260},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3461":71424,"_30095":71271,"_20902":120262,"_5":14358,"_27381":119877,"_2946":120263},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3461":71425,"_30095":71271,"_20902":120265,"_5":14358,"_27381":119881,"_2946":120266},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3461":71426,"_30095":71271,"_20902":120268,"_5":14358,"_27381":119881,"_2946":120269},[],"Transición",{"_3461":71427,"_30095":71271,"_20902":120271,"_5":14358,"_27381":119881,"_2946":120272},[],"Llamadas AWS",{"_3461":71428,"_30095":71271,"_20902":120274,"_5":14358,"_27381":119881,"_2946":120275},[],"`NoRegistrada` → `Solicitada`",{"_3461":71429,"_30095":71271,"_20902":120277,"_5":14358,"_27381":119881,"_2946":120278},[],"ninguna (solo escritura de metadatos)",{"_3461":71430,"_30095":71271,"_20902":120280,"_5":14358,"_27381":119881,"_2946":120281},[],"`Solicitada` → `Registrando`",{"_3461":71431,"_30095":71271,"_20902":120283,"_5":14358,"_27381":119881,"_2946":120284},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3461":71432,"_30095":71271,"_20902":120286,"_5":14358,"_27381":119881,"_2946":120287},[],"`Registrando` → `Completada`",{"_3461":71433,"_30095":71271,"_20902":120289,"_5":14358,"_27381":119881,"_2946":120290},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3461":71434,"_30095":71271,"_20902":120292,"_5":14358,"_27381":119881,"_2946":120293},[],"`Registrando` → `Fallida`",{"_3461":71435,"_30095":71271,"_20902":120295,"_5":14358,"_27381":119881,"_2946":120296},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3461":71436,"_30095":71271,"_20902":120298,"_5":14358,"_27381":119881,"_2946":120299},[],"`Fallida` / `Completada` → `Solicitada`",{"_3461":71437,"_30095":71271,"_20902":120301,"_5":14358,"_27381":119881,"_2946":120302},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3461":71438,"_30095":71271,"_20902":120304,"_5":14358,"_27381":119885,"_2946":120305},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3461":71439,"_30095":71271,"_20902":120307,"_5":14358,"_27381":119885,"_2946":120308},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3461":71440,"_30095":71271,"_20902":120310,"_5":14358,"_27381":119885,"_2946":120311},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3461":71441,"_30095":71271,"_20902":120313,"_5":14358,"_27381":119885,"_2946":120314},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3461":71442,"_30095":71271,"_20902":120316,"_5":14358,"_27381":119885,"_2946":120317},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3461":71443,"_30095":71271,"_20902":120319,"_5":14358,"_27381":119885,"_2946":120320},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3461":71444,"_30095":71271,"_20902":120322,"_5":14358,"_27381":119888,"_2946":120323},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3461":71445,"_30095":71271,"_20902":120325,"_5":14358,"_27381":119891,"_2946":120326},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3461":71446,"_30095":71271,"_20902":120328,"_5":14358,"_27381":119891,"_2946":120329},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3461":71447,"_30095":71271,"_20902":120331,"_5":14358,"_27381":119895,"_2946":120332},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3461":71448,"_30095":71271,"_20902":120334,"_5":14358,"_27381":119899,"_2946":120335},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3461":71449,"_30095":71271,"_20902":120337,"_5":14358,"_27381":119899,"_2946":120338},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3461":71450,"_30095":71271,"_20902":120340,"_5":14358,"_27381":119899,"_2946":120341},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3461":71451,"_30095":71271,"_20902":120343,"_5":14358,"_27381":119899,"_2946":120344},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3461":71452,"_30095":71271,"_20902":120346,"_5":14358,"_27381":119899,"_2946":120347},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3461":71453,"_30095":71271,"_20902":120349,"_5":14358,"_27381":119899,"_2946":120350},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3461":71454,"_30095":71271,"_20902":120352,"_5":14358,"_27381":119903,"_2946":120353},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3461":71455,"_30095":71271,"_20902":120355,"_5":14358,"_27381":119903,"_2946":120356},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3461":71456,"_30095":71271,"_20902":120358,"_5":14358,"_27381":119903,"_2946":120359},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3461":71457,"_30095":71271,"_20902":120361,"_5":14358,"_27381":119903,"_2946":120362},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3461":71458,"_30095":71271,"_20902":120364,"_5":14358,"_27381":119903,"_2946":120365},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3461":71459,"_30095":71271,"_20902":120367,"_5":14358,"_27381":119907,"_2946":120368},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3461":71460,"_30095":71271,"_20902":120370,"_5":14358,"_27381":119907,"_2946":120269},[],{"_3461":71461,"_30095":71271,"_20902":120372,"_5":14358,"_27381":119907,"_2946":120272},[],{"_3461":71462,"_30095":71271,"_20902":120374,"_5":14358,"_27381":119907,"_2946":120375},[],"`SinConfigurar` → `None` / `Auto`",{"_3461":71463,"_30095":71271,"_20902":120377,"_5":14358,"_27381":119907,"_2946":120378},[],"ninguna (solo configuración)",{"_3461":71464,"_30095":71271,"_20902":120380,"_5":14358,"_27381":119907,"_2946":53669},[],{"_3461":71465,"_30095":71271,"_20902":120382,"_5":14358,"_27381":119907,"_2946":120378},[],{"_3461":71466,"_30095":71271,"_20902":120384,"_5":14358,"_27381":119907,"_2946":120385},[],"Cualquiera → `Jitp`",{"_3461":71467,"_30095":71271,"_20902":120387,"_5":14358,"_27381":119907,"_2946":120388},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3461":71468,"_30095":71271,"_20902":120390,"_5":14358,"_27381":119907,"_2946":53680},[],{"_3461":71469,"_30095":71271,"_20902":120392,"_5":14358,"_27381":119907,"_2946":120393},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3461":71470,"_30095":71271,"_20902":120395,"_5":14358,"_27381":119911,"_2946":120396},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3461":71471,"_30095":71271,"_20902":120398,"_5":14358,"_27381":119911,"_2946":120399},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3461":71472,"_30095":71271,"_20902":120401,"_5":14358,"_27381":119911,"_2946":120402},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3461":71473,"_30095":71271,"_20902":120404,"_5":14358,"_27381":119915,"_2946":120405},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3461":71474,"_30095":71271,"_20902":120407,"_5":14358,"_27381":119915,"_2946":120269},[],{"_3461":71475,"_30095":71271,"_20902":120409,"_5":14358,"_27381":119915,"_2946":120272},[],{"_3461":71476,"_30095":71271,"_20902":120411,"_5":14358,"_27381":119915,"_2946":120412},[],"`Ausente` → `Aprovisionado`",{"_3461":71477,"_30095":71271,"_20902":120414,"_5":14358,"_27381":119915,"_2946":120415},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3461":71478,"_30095":71271,"_20902":120417,"_5":14358,"_27381":119915,"_2946":120418},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3461":71479,"_30095":71271,"_20902":120420,"_5":14358,"_27381":119915,"_2946":120421},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3461":71480,"_30095":71271,"_20902":120423,"_5":14358,"_27381":119915,"_2946":120424},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3461":71481,"_30095":71271,"_20902":120426,"_5":14358,"_27381":119919,"_2946":120427},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3461":71482,"_30095":71271,"_20902":120429,"_5":14358,"_27381":119919,"_2946":120430},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3461":71483,"_30095":71271,"_20902":120432,"_5":14358,"_27381":119919,"_2946":120433},[],"Para que el flujo JITP funcione correctamente:",{"_3461":71484,"_30095":71271,"_20902":120435,"_5":14358,"_27381":119919,"_2946":120436},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3461":71485,"_30095":71271,"_20902":120438,"_5":14358,"_27381":119919,"_2946":120439},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3461":71486,"_30095":71271,"_20902":120441,"_5":14358,"_27381":119919,"_2946":120442},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3461":71487,"_30095":71271,"_20902":120444,"_5":14358,"_27381":119919,"_2946":120445},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3461":71488,"_30095":71271,"_20902":120447,"_5":14358,"_27381":119923,"_2946":120448},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3461":71489,"_30095":71271,"_20902":120450,"_5":14358,"_27381":119923,"_2946":120451},[],"Estado en Lamassu",{"_3461":71490,"_30095":71271,"_20902":120453,"_5":14358,"_27381":119923,"_2946":120454},[],"Razón de revocación",{"_3461":71491,"_30095":71271,"_20902":120456,"_5":14358,"_27381":119923,"_2946":120457},[],"Estado en AWS IoT Core",{"_3461":71492,"_30095":71271,"_20902":120459,"_5":14358,"_27381":119923,"_2946":53750},[],{"_3461":71493,"_30095":71271,"_20902":120461,"_5":14358,"_27381":119923,"_2946":120462},[],"Ninguna",{"_3461":71494,"_30095":71271,"_20902":120464,"_5":14358,"_27381":119923,"_2946":53756},[],{"_3461":71495,"_30095":71271,"_20902":120466,"_5":14358,"_27381":119923,"_2946":53759},[],{"_3461":71496,"_30095":71271,"_20902":120468,"_5":14358,"_27381":119923,"_2946":53762},[],{"_3461":71497,"_30095":71271,"_20902":120470,"_5":14358,"_27381":119923,"_2946":53765},[],{"_3461":71498,"_30095":71271,"_20902":120472,"_5":14358,"_27381":119923,"_2946":53759},[],{"_3461":71499,"_30095":71271,"_20902":120474,"_5":14358,"_27381":119923,"_2946":120475},[],"Cualquier otra razón",{"_3461":71500,"_30095":71271,"_20902":120477,"_5":14358,"_27381":119923,"_2946":53773},[],{"_3461":71501,"_30095":71271,"_20902":120479,"_5":14358,"_27381":119923,"_2946":120480},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3461":71502,"_30095":71271,"_20902":120482,"_5":14358,"_27381":119927,"_2946":120483},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3461":71503,"_30095":71271,"_20902":120485,"_5":14358,"_27381":119927,"_2946":120269},[],{"_3461":71504,"_30095":71271,"_20902":120487,"_5":14358,"_27381":119927,"_2946":120272},[],{"_3461":71505,"_30095":71271,"_20902":120489,"_5":14358,"_27381":119927,"_2946":120490},[],"`NoSincronizado` → `Active`",{"_3461":71506,"_30095":71271,"_20902":120492,"_5":14358,"_27381":119927,"_2946":53265},[],{"_3461":71507,"_30095":71271,"_20902":120494,"_5":14358,"_27381":119927,"_2946":53791},[],{"_3461":71508,"_30095":71271,"_20902":120496,"_5":14358,"_27381":119927,"_2946":120497},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3461":71509,"_30095":71271,"_20902":120499,"_5":14358,"_27381":119927,"_2946":53797},[],{"_3461":71510,"_30095":71271,"_20902":120501,"_5":14358,"_27381":119927,"_2946":120497},[],{"_3461":71511,"_30095":71271,"_20902":120503,"_5":14358,"_27381":119927,"_2946":53802},[],{"_3461":71512,"_30095":71271,"_20902":120505,"_5":14358,"_27381":119927,"_2946":53265},[],{"_3461":71513,"_30095":71271,"_20902":120507,"_5":14358,"_27381":119927,"_2946":53807},[],{"_3461":71514,"_30095":71271,"_20902":120509,"_5":14358,"_27381":119927,"_2946":120510},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3461":71515,"_30095":71271,"_20902":120512,"_5":14358,"_27381":119931,"_2946":120513},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3461":71516,"_30095":71271,"_20902":120515,"_5":14358,"_27381":119931,"_2946":120516},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3461":71517,"_30095":71271,"_20902":120518,"_5":14358,"_27381":119931,"_2946":120519},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3461":71518,"_30095":71271,"_20902":120521,"_5":14358,"_27381":119935,"_2946":120522},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3461":71519,"_30095":71271,"_20902":120524,"_5":14358,"_27381":119935,"_2946":120525},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3461":71520,"_30095":71271,"_20902":120527,"_5":14358,"_27381":119939,"_2946":120528},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3461":71521,"_30095":71271,"_20902":120530,"_5":14358,"_27381":119939,"_2946":120531},[],"Existen dos tipos de acciones:",{"_3461":71522,"_30095":71271,"_20902":120533,"_5":14358,"_27381":119939,"_2946":120534},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3461":71523,"_30095":71271,"_20902":120536,"_5":14358,"_27381":119939,"_2946":120537},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3461":71524,"_30095":71271,"_20902":120539,"_5":14358,"_27381":119939,"_2946":120540},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3461":71525,"_30095":71271,"_20902":120542,"_5":14358,"_27381":119943,"_2946":120543},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3461":71526,"_30095":71271,"_20902":120545,"_5":14358,"_27381":119943,"_2946":120546},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3461":71527,"_30095":71271,"_20902":120548,"_5":14358,"_27381":119943,"_2946":120549},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3461":71528,"_30095":71271,"_20902":120551,"_5":14358,"_27381":119947,"_2946":120552},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3461":71529,"_30095":71271,"_20902":120554,"_5":14358,"_27381":119947,"_2946":120555},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3461":71530,"_30095":71271,"_20902":120557,"_5":14358,"_27381":119947,"_2946":120558},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3461":71531,"_30095":71271,"_20902":120560,"_5":14358,"_27381":119947,"_2946":120561},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3461":71532,"_30095":71271,"_20902":120563,"_5":14358,"_27381":119947,"_2946":120564},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3461":71533,"_30095":71271,"_20902":120566,"_5":14358,"_27381":119947,"_2946":120567},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3461":71534,"_30095":71271,"_20902":120569,"_5":14358,"_27381":119947,"_2946":120570},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3461":71535,"_30095":71271,"_20902":120572,"_5":14358,"_27381":119947,"_2946":120573},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3461":71536,"_30095":71271,"_20902":120575,"_5":14358,"_27381":119947,"_2946":120576},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3461":71537,"_30095":71271,"_20902":120578,"_5":14358,"_27381":119947,"_2946":120579},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3461":71538,"_30095":71271,"_20902":120581,"_5":14358,"_27381":119947,"_2946":120582},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3461":71539,"_30095":71271,"_20902":120584,"_5":14358,"_27381":119947,"_2946":120585},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3461":71540,"_30095":71271,"_20902":120587,"_5":14358,"_27381":119947,"_2946":120588},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3461":71541,"_30095":71271,"_20902":120590,"_5":14358,"_27381":119947,"_2946":120591},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3461":71542,"_30095":71271,"_20902":120593,"_5":14358,"_27381":119947,"_2946":120594},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3461":71543,"_30095":71271,"_20902":120596,"_5":14358,"_27381":119947,"_2946":120597},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3461":71544,"_30095":71271,"_20902":120599,"_5":14358,"_27381":119947,"_2946":120600},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3461":71545,"_30095":71271,"_20902":120602,"_5":14358,"_27381":119947,"_2946":120603},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3461":71546,"_30095":71271,"_20902":120605,"_5":14358,"_27381":119947,"_2946":120606},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3461":71547,"_30095":71271,"_20902":120608,"_5":14358,"_27381":119947,"_2946":120609},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3461":71548,"_30095":71271,"_20902":120611,"_5":14358,"_27381":119947,"_2946":120612},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3461":71549,"_30095":71271,"_20902":120614,"_5":14358,"_27381":119947,"_2946":120615},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":71550,"_30095":71271,"_20902":120617,"_5":14358,"_27381":119947,"_2946":120618},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3461":71551,"_30095":71271,"_20902":120620,"_5":14358,"_27381":119947,"_2946":120621},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3461":71552,"_30095":71552,"_5":14710,"_2946":51628,"_30448":120623,"_20902":120624,"_27381":71552},[49146,117427,51628],[],{"_3461":71553,"_30095":71552,"_20902":120626,"_5":14358,"_27381":71552,"_2946":120627},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3461":71554,"_30095":71552,"_5":30445,"_20902":120629,"_27381":120630,"_2946":120631},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3461":71555,"_30095":71552,"_5":30445,"_20902":120633,"_27381":120634,"_2946":118439},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3461":71556,"_30095":71552,"_5":30445,"_20902":120636,"_27381":120637,"_2946":118614},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3461":71557,"_30095":71552,"_5":30445,"_20902":120639,"_27381":120640,"_2946":119846},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#integraciones",{"_3461":71558,"_30095":71552,"_5":30445,"_20902":120642,"_27381":120643,"_2946":120644},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3461":71559,"_30095":71552,"_20902":120646,"_5":14358,"_27381":71552,"_2946":120647},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3461":71560,"_30095":71552,"_20902":120649,"_5":14358,"_27381":120630,"_2946":120650},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3461":71561,"_30095":71552,"_20902":120652,"_5":14358,"_27381":120630,"_2946":120653},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3461":71562,"_30095":71552,"_20902":120655,"_5":14358,"_27381":120634,"_2946":120656},[],"Recurso",{"_3461":71563,"_30095":71552,"_20902":120658,"_5":14358,"_27381":120634,"_2946":120659},[],"Qué representa",{"_3461":71564,"_30095":71552,"_20902":120661,"_5":14358,"_27381":120634,"_2946":120662},[],"**Dispositivo**",{"_3461":71565,"_30095":71552,"_20902":120664,"_5":14358,"_27381":120634,"_2946":120665},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3461":71566,"_30095":71552,"_20902":120667,"_5":14358,"_27381":120634,"_2946":120668},[],"**Identidad**",{"_3461":71567,"_30095":71552,"_20902":120670,"_5":14358,"_27381":120634,"_2946":120671},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3461":71568,"_30095":71552,"_20902":120673,"_5":14358,"_27381":120634,"_2946":53974},[],{"_3461":71569,"_30095":71552,"_20902":120675,"_5":14358,"_27381":120634,"_2946":120676},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3461":71570,"_30095":71552,"_20902":120678,"_5":14358,"_27381":120634,"_2946":120679},[],"**Flota**",{"_3461":71571,"_30095":71552,"_20902":120681,"_5":14358,"_27381":120634,"_2946":120682},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3461":71572,"_30095":71552,"_20902":120684,"_5":14358,"_27381":120634,"_2946":120685},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3461":71573,"_30095":71552,"_20902":120687,"_5":14358,"_27381":120634,"_2946":120688},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3461":71574,"_30095":71552,"_20902":120690,"_5":14358,"_27381":120637,"_2946":120691},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3461":71575,"_30095":71552,"_20902":120693,"_5":14358,"_27381":120637,"_2946":120694},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3461":71576,"_30095":71552,"_20902":120696,"_5":14358,"_27381":120637,"_2946":120697},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3461":71577,"_30095":71552,"_20902":120699,"_5":14358,"_27381":120637,"_2946":120700},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3461":71578,"_30095":71552,"_20902":120702,"_5":14358,"_27381":120637,"_2946":120703},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3461":71579,"_30095":71552,"_20902":120705,"_5":14358,"_27381":120637,"_2946":120706},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3461":71580,"_30095":71552,"_20902":120708,"_5":14358,"_27381":120637,"_2946":120709},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3461":71581,"_30095":71552,"_20902":120711,"_5":14358,"_27381":120637,"_2946":120712},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3461":71582,"_30095":71552,"_20902":120714,"_5":14358,"_27381":120640,"_2946":120715},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3461":71583,"_30095":71552,"_20902":120717,"_5":14358,"_27381":120640,"_2946":120718},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3461":71584,"_30095":71552,"_20902":120720,"_5":14358,"_27381":120643,"_2946":120721},[],"Participante",{"_3461":71585,"_30095":71552,"_20902":120723,"_5":14358,"_27381":120643,"_2946":120724},[],"Responsabilidad",{"_3461":71586,"_30095":71552,"_20902":120726,"_5":14358,"_27381":120643,"_2946":120727},[],"Administrador PKI",{"_3461":71587,"_30095":71552,"_20902":120729,"_5":14358,"_27381":120643,"_2946":120730},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3461":71588,"_30095":71552,"_20902":120732,"_5":14358,"_27381":120643,"_2946":120733},[],"Administrador del aprovisionamiento",{"_3461":71589,"_30095":71552,"_20902":120735,"_5":14358,"_27381":120643,"_2946":120736},[],"DMS, admisión, autenticación por operación e inventario.",{"_3461":71590,"_30095":71552,"_20902":120738,"_5":14358,"_27381":120643,"_2946":120739},[],"Integrador del dispositivo",{"_3461":71591,"_30095":71552,"_20902":120741,"_5":14358,"_27381":120643,"_2946":120742},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3461":71592,"_30095":71552,"_20902":120744,"_5":14358,"_27381":120643,"_2946":120745},[],"Integrador del consumidor",{"_3461":71593,"_30095":71552,"_20902":120747,"_5":14358,"_27381":120643,"_2946":120748},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3461":71594,"_30095":71552,"_20902":120750,"_5":14358,"_27381":120643,"_2946":120751},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3461":71595,"_30095":71595,"_5":14710,"_2946":120753,"_30448":120754,"_20902":120756,"_27381":71595},"Enrola y conecta tu primer dispositivo",[49146,117427,51628,120755],"Primeros pasos",[],{"_3461":71596,"_30095":71595,"_20902":120758,"_5":14358,"_27381":71595,"_2946":120759},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3461":71597,"_30095":71595,"_5":30445,"_20902":120761,"_27381":120762,"_2946":116005},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3461":71598,"_30095":71595,"_5":30445,"_20902":120764,"_27381":120765,"_2946":120766},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3461":71599,"_30095":71595,"_5":30445,"_20902":120768,"_27381":120769,"_2946":120770},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3461":71600,"_30095":71595,"_5":30445,"_20902":120772,"_27381":120773,"_2946":120774},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3461":71601,"_30095":71595,"_5":30445,"_20902":120776,"_27381":120777,"_2946":120778},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3461":71602,"_30095":71595,"_5":30445,"_20902":120780,"_27381":120781,"_2946":120782},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3461":71603,"_30095":71595,"_5":30445,"_20902":120784,"_27381":120785,"_2946":120786},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3461":71604,"_30095":71595,"_5":30445,"_20902":120788,"_27381":120789,"_2946":120790},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3461":71605,"_30095":71595,"_20902":120792,"_5":14358,"_27381":71595,"_2946":120793},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3461":71606,"_30095":71595,"_20902":120795,"_5":14358,"_27381":120762,"_2946":120796},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3461":71607,"_30095":71595,"_20902":120798,"_5":14358,"_27381":120762,"_2946":120799},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3461":71608,"_30095":71595,"_20902":120801,"_5":14358,"_27381":120762,"_2946":120802},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3461":71609,"_30095":71595,"_20902":120804,"_5":14358,"_27381":120762,"_2946":120805},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3461":71610,"_30095":71595,"_20902":120807,"_5":14358,"_27381":120762,"_2946":120808},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3461":71611,"_30095":71595,"_20902":120810,"_5":14358,"_27381":120765,"_2946":120811},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3461":71612,"_30095":71595,"_20902":120813,"_5":14358,"_27381":120765,"_2946":120814},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3461":71613,"_30095":71595,"_20902":120816,"_5":14358,"_27381":120769,"_2946":120817},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3461":71614,"_30095":71595,"_20902":120819,"_5":14358,"_27381":120769,"_2946":120820},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3461":71615,"_30095":71595,"_20902":120822,"_5":14358,"_27381":120769,"_2946":120823},[],"Ajuste",{"_3461":71616,"_30095":71595,"_20902":120825,"_5":14358,"_27381":120769,"_2946":120826},[],"Valor de evaluación",{"_3461":71617,"_30095":71595,"_20902":120828,"_5":14358,"_27381":120769,"_2946":54130},[],{"_3461":71618,"_30095":71595,"_20902":120830,"_5":14358,"_27381":120769,"_2946":120831},[],"Raíz emisora de `device-root.pem`.",{"_3461":71619,"_30095":71595,"_20902":120833,"_5":14358,"_27381":120769,"_2946":118742},[],{"_3461":71620,"_30095":71595,"_20902":120835,"_5":14358,"_27381":120769,"_2946":120836},[],"Perfil final de 1 hora que acabas de preparar.",{"_3461":71621,"_30095":71595,"_20902":120838,"_5":14358,"_27381":120769,"_2946":54141},[],{"_3461":71622,"_30095":71595,"_20902":120840,"_5":14358,"_27381":120769,"_2946":54144},[],{"_3461":71623,"_30095":71595,"_20902":120842,"_5":14358,"_27381":120769,"_2946":54147},[],{"_3461":71624,"_30095":71595,"_20902":120844,"_5":14358,"_27381":120769,"_2946":120845},[],"Habilitado.",{"_3461":71625,"_30095":71595,"_20902":120847,"_5":14358,"_27381":120769,"_2946":54153},[],{"_3461":71626,"_30095":71595,"_20902":120849,"_5":14358,"_27381":120769,"_2946":120850},[],"Deshabilitado; el ID debe ser nuevo.",{"_3461":71627,"_30095":71595,"_20902":120852,"_5":14358,"_27381":120769,"_2946":120853},[],"Autenticación inicial",{"_3461":71628,"_30095":71595,"_20902":120855,"_5":14358,"_27381":120769,"_2946":120856},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3461":71629,"_30095":71595,"_20902":120858,"_5":14358,"_27381":120769,"_2946":120859},[],"Autenticación de renovación",{"_3461":71630,"_30095":71595,"_20902":120861,"_5":14358,"_27381":120769,"_2946":120862},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3461":71631,"_30095":71595,"_20902":120864,"_5":14358,"_27381":120769,"_2946":54171},[],{"_3461":71632,"_30095":71595,"_20902":120866,"_5":14358,"_27381":120769,"_2946":120867},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3461":71633,"_30095":71595,"_20902":120869,"_5":14358,"_27381":120769,"_2946":54177},[],{"_3461":71634,"_30095":71595,"_20902":120871,"_5":14358,"_27381":120769,"_2946":120872},[],"1 hora.",{"_3461":71635,"_30095":71595,"_20902":120874,"_5":14358,"_27381":120769,"_2946":54183},[],{"_3461":71636,"_30095":71595,"_20902":120876,"_5":14358,"_27381":120769,"_2946":120877},[],"30 minutos / 10 minutos.",{"_3461":71637,"_30095":71595,"_20902":120879,"_5":14358,"_27381":120769,"_2946":54189},[],{"_3461":71638,"_30095":71595,"_20902":120881,"_5":14358,"_27381":120769,"_2946":120882},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3461":71639,"_30095":71595,"_20902":120884,"_5":14358,"_27381":120769,"_2946":51947},[],{"_3461":71640,"_30095":71595,"_20902":120886,"_5":14358,"_27381":120769,"_2946":120887},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3461":71641,"_30095":71595,"_20902":120889,"_5":14358,"_27381":120769,"_2946":54200},[],{"_3461":71642,"_30095":71595,"_20902":120891,"_5":14358,"_27381":120769,"_2946":120892},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3461":71643,"_30095":71595,"_20902":120894,"_5":14358,"_27381":120769,"_2946":120895},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3461":71644,"_30095":71595,"_20902":120897,"_5":14358,"_27381":120773,"_2946":120898},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3461":71645,"_30095":71595,"_20902":120900,"_5":14358,"_27381":120773,"_2946":120901},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3461":71646,"_30095":71595,"_20902":120903,"_5":14358,"_27381":120777,"_2946":120904},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3461":71647,"_30095":71595,"_20902":120906,"_5":14358,"_27381":120777,"_2946":120907},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3461":71648,"_30095":71595,"_20902":120909,"_5":14358,"_27381":120777,"_2946":120910},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3461":71649,"_30095":71595,"_20902":120912,"_5":14358,"_27381":120781,"_2946":120913},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3461":71650,"_30095":71595,"_20902":120915,"_5":14358,"_27381":120781,"_2946":120916},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3461":71651,"_30095":71595,"_20902":120918,"_5":14358,"_27381":120785,"_2946":120919},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3461":71652,"_30095":71595,"_20902":120921,"_5":14358,"_27381":120785,"_2946":120922},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3461":71653,"_30095":71595,"_20902":120924,"_5":14358,"_27381":120785,"_2946":120925},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3461":71654,"_30095":71595,"_20902":120927,"_5":14358,"_27381":120785,"_2946":120928},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3461":71655,"_30095":71595,"_20902":120930,"_5":14358,"_27381":120785,"_2946":120931},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3461":71656,"_30095":71595,"_20902":120933,"_5":14358,"_27381":120789,"_2946":120934},[],"Comprobación",{"_3461":71657,"_30095":71595,"_20902":120936,"_5":14358,"_27381":120789,"_2946":120937},[],"Resultado esperado",{"_3461":71658,"_30095":71595,"_20902":120939,"_5":14358,"_27381":120789,"_2946":120940},[],"Registro",{"_3461":71659,"_30095":71595,"_20902":120942,"_5":14358,"_27381":120789,"_2946":120943},[],"ID creado automáticamente y DMS correcto.",{"_3461":71660,"_30095":71595,"_20902":120945,"_5":14358,"_27381":120789,"_2946":120230},[],{"_3461":71661,"_30095":71595,"_20902":120947,"_5":14358,"_27381":120789,"_2946":120948},[],"CN, perfil, serie y clave verificados.",{"_3461":71662,"_30095":71595,"_20902":120950,"_5":14358,"_27381":120789,"_2946":120951},[],"Inventario",{"_3461":71663,"_30095":71595,"_20902":120953,"_5":14358,"_27381":120789,"_2946":120954},[],"Serie recibida visible como identidad actual y en el historial.",{"_3461":71664,"_30095":71595,"_20902":120956,"_5":14358,"_27381":120789,"_2946":120957},[],"Consumidor",{"_3461":71665,"_30095":71595,"_20902":120959,"_5":14358,"_27381":120789,"_2946":120960},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3461":71666,"_30095":71595,"_20902":120962,"_5":14358,"_27381":120789,"_2946":120963},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3461":71667,"_30095":71595,"_20902":120965,"_5":14358,"_27381":120789,"_2946":120966},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3461":71668,"_30095":71668,"_5":14710,"_2946":118456,"_30448":120968,"_20902":120969,"_27381":71668},[49146,117427,51628,120755],[],{"_3461":71669,"_30095":71668,"_20902":120971,"_5":14358,"_27381":71668,"_2946":120972},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3461":71670,"_30095":71668,"_5":30445,"_20902":120974,"_27381":120975,"_2946":116005},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3461":71671,"_30095":71668,"_5":30445,"_20902":120977,"_27381":120978,"_2946":120979},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3461":71672,"_30095":71668,"_5":30445,"_20902":120981,"_27381":120982,"_2946":120983},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3461":71673,"_30095":71668,"_5":30445,"_20902":120985,"_27381":120986,"_2946":120987},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3461":71674,"_30095":71668,"_5":30445,"_20902":120989,"_27381":120990,"_2946":120991},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3461":71675,"_30095":71668,"_5":30445,"_20902":120993,"_27381":120994,"_2946":120995},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3461":71676,"_30095":71668,"_5":30445,"_20902":120997,"_27381":120998,"_2946":120937},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3461":71677,"_30095":71668,"_5":30445,"_20902":121000,"_27381":121001,"_2946":121002},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3461":71678,"_30095":71668,"_5":30445,"_20902":121004,"_27381":121005,"_2946":121006},[],"/docs/pr-preview/pr-60/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3461":71679,"_30095":71668,"_20902":121008,"_5":14358,"_27381":71668,"_2946":121009},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3461":71680,"_30095":71668,"_20902":121011,"_5":14358,"_27381":71668,"_2946":121012},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3461":71681,"_30095":71668,"_20902":121014,"_5":14358,"_27381":120975,"_2946":121015},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3461":71682,"_30095":71668,"_20902":121017,"_5":14358,"_27381":120975,"_2946":121018},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3461":71683,"_30095":71668,"_20902":121020,"_5":14358,"_27381":120975,"_2946":121021},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3461":71684,"_30095":71668,"_20902":121023,"_5":14358,"_27381":120975,"_2946":121024},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3461":71685,"_30095":71668,"_20902":121026,"_5":14358,"_27381":120978,"_2946":121027},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3461":71686,"_30095":71668,"_20902":121029,"_5":14358,"_27381":120978,"_2946":121030},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3461":71687,"_30095":71668,"_20902":121032,"_5":14358,"_27381":120978,"_2946":121033},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3461":71688,"_30095":71668,"_20902":121035,"_5":14358,"_27381":120978,"_2946":121036},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3461":71689,"_30095":71668,"_20902":121038,"_5":14358,"_27381":120978,"_2946":121039},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3461":71690,"_30095":71668,"_20902":121041,"_5":14358,"_27381":120978,"_2946":121042},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3461":71691,"_30095":71668,"_20902":121044,"_5":14358,"_27381":120978,"_2946":121045},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3461":71692,"_30095":71668,"_20902":121047,"_5":14358,"_27381":120978,"_2946":121048},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3461":71693,"_30095":71668,"_20902":121050,"_5":14358,"_27381":120982,"_2946":121051},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3461":71694,"_30095":71668,"_20902":121053,"_5":14358,"_27381":120982,"_2946":54365},[],{"_3461":71695,"_30095":71668,"_20902":121055,"_5":14358,"_27381":120982,"_2946":121056},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3461":71696,"_30095":71668,"_20902":121058,"_5":14358,"_27381":120982,"_2946":121059},[],"**Icon** y **Tags**: clasificación opcional.",{"_3461":71697,"_30095":71668,"_20902":121061,"_5":14358,"_27381":120982,"_2946":121062},[],"Confirma el registro.",{"_3461":71698,"_30095":71668,"_20902":121064,"_5":14358,"_27381":120986,"_2946":121065},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3461":71699,"_30095":71668,"_20902":121067,"_5":14358,"_27381":120986,"_2946":121068},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3461":71700,"_30095":71668,"_20902":121070,"_5":14358,"_27381":120990,"_2946":121071},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3461":71701,"_30095":71668,"_20902":121073,"_5":14358,"_27381":120990,"_2946":121074},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3461":71702,"_30095":71668,"_20902":121076,"_5":14358,"_27381":120994,"_2946":121077},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3461":71703,"_30095":71668,"_20902":121079,"_5":14358,"_27381":120994,"_2946":121080},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3461":71704,"_30095":71668,"_20902":121082,"_5":14358,"_27381":120998,"_2946":120934},[],{"_3461":71705,"_30095":71668,"_20902":121084,"_5":14358,"_27381":120998,"_2946":121085},[],"Resultado",{"_3461":71706,"_30095":71668,"_20902":121087,"_5":14358,"_27381":120998,"_2946":120216},[],{"_3461":71707,"_30095":71668,"_20902":121089,"_5":14358,"_27381":120998,"_2946":121090},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3461":71708,"_30095":71668,"_20902":121092,"_5":14358,"_27381":120998,"_2946":121093},[],"Identidad actual",{"_3461":71709,"_30095":71668,"_20902":121095,"_5":14358,"_27381":120998,"_2946":121096},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3461":71710,"_30095":71668,"_20902":121098,"_5":14358,"_27381":120998,"_2946":121099},[],"Historial",{"_3461":71711,"_30095":71668,"_20902":121101,"_5":14358,"_27381":120998,"_2946":121102},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3461":71712,"_30095":71668,"_20902":121104,"_5":14358,"_27381":120998,"_2946":121105},[],"Clave y certificado",{"_3461":71713,"_30095":71668,"_20902":121107,"_5":14358,"_27381":120998,"_2946":121108},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3461":71714,"_30095":71668,"_20902":121110,"_5":14358,"_27381":121001,"_2946":121111},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3461":71715,"_30095":71668,"_20902":121113,"_5":14358,"_27381":121001,"_2946":121114},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3461":71716,"_30095":71668,"_20902":121116,"_5":14358,"_27381":121001,"_2946":121117},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3461":71717,"_30095":71668,"_20902":121119,"_5":14358,"_27381":121001,"_2946":121120},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3461":71718,"_30095":71668,"_20902":121122,"_5":14358,"_27381":121005,"_2946":121123},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3461":71719,"_30095":71668,"_20902":121125,"_5":14358,"_27381":121005,"_2946":121126},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3461":71720,"_30095":71668,"_20902":121128,"_5":14358,"_27381":121005,"_2946":121129},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3461":71721,"_30095":71721,"_5":14710,"_2946":121131,"_30448":121132,"_20902":121133,"_27381":71721},"Plataforma Lamassu IoT",[49146,117427],[],{"_3461":71722,"_30095":71721,"_20902":121135,"_5":14358,"_27381":71721,"_2946":121136},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3461":71723,"_30095":71721,"_5":30445,"_20902":121138,"_27381":121139,"_2946":120631},[],"/docs/pr-preview/pr-60/es/platform/overview#empieza-aquí",{"_3461":71724,"_30095":71721,"_5":30445,"_20902":121141,"_27381":121142,"_2946":121143},[],"/docs/pr-preview/pr-60/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3461":71725,"_30095":71721,"_5":30445,"_20902":121145,"_27381":121146,"_2946":121147},[],"/docs/pr-preview/pr-60/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3461":71726,"_30095":71721,"_5":30445,"_20902":121149,"_27381":121150,"_2946":121151},[],"/docs/pr-preview/pr-60/es/platform/overview#capacidades-principales","Capacidades principales",{"_3461":71727,"_30095":71721,"_5":30445,"_20902":121153,"_27381":121154,"_2946":121155},[],"/docs/pr-preview/pr-60/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3461":71728,"_30095":71721,"_5":30445,"_20902":121157,"_27381":121158,"_2946":121159},[],"/docs/pr-preview/pr-60/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3461":71729,"_30095":71721,"_5":30445,"_20902":121161,"_27381":121162,"_2946":121163},[],"/docs/pr-preview/pr-60/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3461":71730,"_30095":71721,"_5":30445,"_20902":121165,"_27381":121166,"_2946":121167},[],"/docs/pr-preview/pr-60/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3461":71731,"_30095":71721,"_5":30445,"_20902":121169,"_27381":121170,"_2946":121171},[],"/docs/pr-preview/pr-60/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3461":71732,"_30095":71721,"_5":30445,"_20902":121173,"_27381":121174,"_2946":121175},[],"/docs/pr-preview/pr-60/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3461":71733,"_30095":71721,"_5":30445,"_20902":121177,"_27381":121178,"_2946":121179},[],"/docs/pr-preview/pr-60/es/platform/overview#referencia-operativa","Referencia operativa",{"_3461":71734,"_30095":71721,"_20902":121181,"_5":14358,"_27381":71721,"_2946":121182},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3461":71735,"_30095":71721,"_20902":121184,"_5":14358,"_27381":121139,"_2946":121185},[],"Elige el resultado que necesitas obtener:",{"_3461":71736,"_30095":71721,"_20902":121187,"_5":14358,"_27381":121139,"_2946":121188},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3461":71737,"_30095":71721,"_20902":121190,"_5":14358,"_27381":121139,"_2946":121191},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3461":71738,"_30095":71721,"_20902":121193,"_5":14358,"_27381":121139,"_2946":121194},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3461":71739,"_30095":71721,"_20902":121196,"_5":14358,"_27381":121142,"_2946":121197},[],"Bloque",{"_3461":71740,"_30095":71721,"_20902":121199,"_5":14358,"_27381":121142,"_2946":121200},[],"Qué gestionas",{"_3461":71741,"_30095":71721,"_20902":121202,"_5":14358,"_27381":121142,"_2946":121203},[],"Punto de entrada",{"_3461":71742,"_30095":71721,"_20902":121205,"_5":14358,"_27381":121142,"_2946":54518},[],{"_3461":71743,"_30095":71721,"_20902":121207,"_5":14358,"_27381":121142,"_2946":121208},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3461":71744,"_30095":71721,"_20902":121210,"_5":14358,"_27381":121142,"_2946":121211},[],"Visión general de PKI",{"_3461":71745,"_30095":71721,"_20902":121213,"_5":14358,"_27381":121142,"_2946":54527},[],{"_3461":71746,"_30095":71721,"_20902":121215,"_5":14358,"_27381":121142,"_2946":121216},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3461":71747,"_30095":71721,"_20902":121218,"_5":14358,"_27381":121142,"_2946":121219},[],"Visión general de IoT Fleets",{"_3461":71748,"_30095":71721,"_20902":121221,"_5":14358,"_27381":121142,"_2946":121222},[],"**Administración**",{"_3461":71749,"_30095":71721,"_20902":121224,"_5":14358,"_27381":121142,"_2946":121225},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3461":71750,"_30095":71721,"_20902":121227,"_5":14358,"_27381":121142,"_2946":117425},[],{"_3461":71751,"_30095":71721,"_20902":121229,"_5":14358,"_27381":121142,"_2946":121230},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3461":71752,"_30095":71721,"_20902":121232,"_5":14358,"_27381":121146,"_2946":121233},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3461":71753,"_30095":71721,"_20902":121235,"_5":14358,"_27381":121146,"_2946":121236},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3461":71754,"_30095":71721,"_20902":121238,"_5":14358,"_27381":121146,"_2946":121239},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3461":71755,"_30095":71721,"_20902":121241,"_5":14358,"_27381":121146,"_2946":121242},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3461":71756,"_30095":71721,"_20902":121244,"_5":14358,"_27381":121146,"_2946":121245},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3461":71757,"_30095":71721,"_20902":121247,"_5":14358,"_27381":121146,"_2946":121248},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3461":71758,"_30095":71721,"_20902":121250,"_5":14358,"_27381":121154,"_2946":121251},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3461":71759,"_30095":71721,"_20902":121253,"_5":14358,"_27381":121158,"_2946":121254},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3461":71760,"_30095":71721,"_20902":121256,"_5":14358,"_27381":121162,"_2946":121257},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3461":71761,"_30095":71721,"_20902":121259,"_5":14358,"_27381":121166,"_2946":121260},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3461":71762,"_30095":71721,"_20902":121262,"_5":14358,"_27381":121170,"_2946":121263},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3461":71763,"_30095":71721,"_20902":121265,"_5":14358,"_27381":121174,"_2946":121266},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3461":71764,"_30095":71721,"_20902":121268,"_5":14358,"_27381":121178,"_2946":120724},[],{"_3461":71765,"_30095":71721,"_20902":121270,"_5":14358,"_27381":121178,"_2946":121271},[],"Qué prepara o comprueba",{"_3461":71766,"_30095":71721,"_20902":121273,"_5":14358,"_27381":121178,"_2946":120727},[],{"_3461":71767,"_30095":71721,"_20902":121275,"_5":14358,"_27381":121178,"_2946":121276},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3461":71768,"_30095":71721,"_20902":121278,"_5":14358,"_27381":121178,"_2946":121279},[],"Administrador de la flota",{"_3461":71769,"_30095":71721,"_20902":121281,"_5":14358,"_27381":121178,"_2946":121282},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3461":71770,"_30095":71721,"_20902":121284,"_5":14358,"_27381":121178,"_2946":120739},[],{"_3461":71771,"_30095":71721,"_20902":121286,"_5":14358,"_27381":121178,"_2946":121287},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3461":71772,"_30095":71721,"_20902":121289,"_5":14358,"_27381":121178,"_2946":120745},[],{"_3461":71773,"_30095":71721,"_20902":121291,"_5":14358,"_27381":121178,"_2946":121292},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3461":71774,"_30095":71721,"_20902":121294,"_5":14358,"_27381":121178,"_2946":121295},[],"Operador de infraestructura",{"_3461":71775,"_30095":71721,"_20902":121297,"_5":14358,"_27381":121178,"_2946":121298},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3461":71776,"_30095":71721,"_20902":121300,"_5":14358,"_27381":121178,"_2946":121301},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3461":71777,"_30095":71777,"_5":14710,"_2946":121303,"_30448":121304,"_20902":121306,"_27381":71777},"Jerarquía y rotación de CAs",[49146,117427,54619,121305],"Claves, autoridades y certificados",[],{"_3461":71778,"_30095":71777,"_20902":121308,"_5":14358,"_27381":71777,"_2946":121309},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3461":71779,"_30095":71777,"_5":30445,"_20902":121311,"_27381":121312,"_2946":121313},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3461":71780,"_30095":71777,"_5":30445,"_20902":121315,"_27381":121316,"_2946":121317},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3461":71781,"_30095":71777,"_5":30445,"_20902":121319,"_27381":121320,"_2946":121321},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3461":71782,"_30095":71777,"_5":30445,"_20902":121323,"_27381":121324,"_2946":121325},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3461":71783,"_30095":71777,"_5":30445,"_20902":121327,"_27381":121328,"_2946":121329},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3461":71784,"_30095":71777,"_5":30445,"_20902":121331,"_27381":121332,"_2946":121333},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3461":71785,"_30095":71777,"_5":30445,"_20902":121335,"_27381":121336,"_2946":121337},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3461":71786,"_30095":71777,"_5":30445,"_20902":121339,"_27381":121340,"_2946":121341},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3461":71787,"_30095":71777,"_5":30445,"_20902":121343,"_27381":121344,"_2946":121345},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3461":71788,"_30095":71777,"_5":30445,"_20902":121347,"_27381":121348,"_2946":121349},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3461":71789,"_30095":71777,"_5":30445,"_20902":121351,"_27381":121352,"_2946":121353},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3461":71790,"_30095":71777,"_5":30445,"_20902":121355,"_27381":121356,"_2946":121357},[],"/docs/pr-preview/pr-60/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3461":71791,"_30095":71777,"_20902":121359,"_5":14358,"_27381":71777,"_2946":121360},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3461":71792,"_30095":71777,"_20902":121362,"_5":14358,"_27381":71777,"_2946":121363},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3461":71793,"_30095":71777,"_20902":121365,"_5":14358,"_27381":121312,"_2946":121366},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3461":71794,"_30095":71777,"_20902":121368,"_5":14358,"_27381":121312,"_2946":121369},[],"entorno, como producción y preproducción;",{"_3461":71795,"_30095":71777,"_20902":121371,"_5":14358,"_27381":121312,"_2946":121372},[],"propietario o equipo operador;",{"_3461":71796,"_30095":71777,"_20902":121374,"_5":14358,"_27381":121312,"_2946":121375},[],"familia de dispositivos o proceso de fabricación;",{"_3461":71797,"_30095":71777,"_20902":121377,"_5":14358,"_27381":121312,"_2946":121378},[],"región o requisito regulatorio;",{"_3461":71798,"_30095":71777,"_20902":121380,"_5":14358,"_27381":121312,"_2946":121381},[],"motor criptográfico o política de clave;",{"_3461":71799,"_30095":71777,"_20902":121383,"_5":14358,"_27381":121312,"_2946":121384},[],"ventana de mantenimiento y ritmo de renovación.",{"_3461":71800,"_30095":71777,"_20902":121386,"_5":14358,"_27381":121312,"_2946":121387},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3461":71801,"_30095":71777,"_20902":121389,"_5":14358,"_27381":121312,"_2946":121390},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3461":71802,"_30095":71777,"_20902":121392,"_5":14358,"_27381":121316,"_2946":121393},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3461":71803,"_30095":71777,"_20902":121395,"_5":14358,"_27381":121316,"_2946":121396},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3461":71804,"_30095":71777,"_20902":121398,"_5":14358,"_27381":121316,"_2946":121399},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3461":71805,"_30095":71777,"_20902":121401,"_5":14358,"_27381":121316,"_2946":121402},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3461":71806,"_30095":71777,"_20902":121404,"_5":14358,"_27381":121320,"_2946":121405},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3461":71807,"_30095":71777,"_20902":121407,"_5":14358,"_27381":121320,"_2946":121408},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3461":71808,"_30095":71777,"_20902":121410,"_5":14358,"_27381":121320,"_2946":121411},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3461":71809,"_30095":71777,"_20902":121413,"_5":14358,"_27381":121320,"_2946":121414},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3461":71810,"_30095":71777,"_20902":121416,"_5":14358,"_27381":121328,"_2946":121417},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3461":71811,"_30095":71777,"_20902":121419,"_5":14358,"_27381":121332,"_2946":121420},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3461":71812,"_30095":71777,"_20902":121422,"_5":14358,"_27381":121336,"_2946":121423},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3461":71813,"_30095":71777,"_20902":121425,"_5":14358,"_27381":121340,"_2946":121426},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3461":71814,"_30095":71777,"_20902":121428,"_5":14358,"_27381":121344,"_2946":121429},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3461":71815,"_30095":71777,"_20902":121431,"_5":14358,"_27381":121348,"_2946":121432},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3461":71816,"_30095":71777,"_20902":121434,"_5":14358,"_27381":121352,"_2946":121435},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3461":71817,"_30095":71777,"_20902":121437,"_5":14358,"_27381":121352,"_2946":121438},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3461":71818,"_30095":71777,"_20902":121440,"_5":14358,"_27381":121352,"_2946":121441},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3461":71819,"_30095":71777,"_20902":121443,"_5":14358,"_27381":121352,"_2946":121444},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3461":71820,"_30095":71777,"_20902":121446,"_5":14358,"_27381":121356,"_2946":121447},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3461":71821,"_30095":71777,"_20902":121449,"_5":14358,"_27381":121356,"_2946":121450},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3461":71822,"_30095":71777,"_20902":121452,"_5":14358,"_27381":121356,"_2946":121453},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3461":71823,"_30095":71777,"_20902":121455,"_5":14358,"_27381":121356,"_2946":121456},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3461":71824,"_30095":71777,"_20902":121458,"_5":14358,"_27381":121356,"_2946":121459},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3461":71825,"_30095":71777,"_20902":121461,"_5":14358,"_27381":121356,"_2946":121462},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3461":71826,"_30095":71777,"_20902":121464,"_5":14358,"_27381":121356,"_2946":121465},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3461":71827,"_30095":71827,"_5":14710,"_2946":121467,"_30448":121468,"_20902":121469,"_27381":71827},"Autoridades de certificación",[49146,117427,54619,121305],[],{"_3461":71828,"_30095":71827,"_20902":121471,"_5":14358,"_27381":71827,"_2946":121472},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3461":71829,"_30095":71827,"_5":30445,"_20902":121474,"_27381":121475,"_2946":121476},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3461":71830,"_30095":71827,"_5":30445,"_20902":121478,"_27381":121479,"_2946":121480},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3461":71831,"_30095":71827,"_5":30445,"_20902":121482,"_27381":121483,"_2946":116005},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3461":71832,"_30095":71827,"_5":30445,"_20902":121485,"_27381":121486,"_2946":121487},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3461":71833,"_30095":71827,"_5":30445,"_20902":121489,"_27381":121490,"_2946":121491},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3461":71834,"_30095":71827,"_5":30445,"_20902":121493,"_27381":121494,"_2946":121495},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3461":71835,"_30095":71827,"_5":30445,"_20902":121497,"_27381":121498,"_2946":121499},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3461":71836,"_30095":71827,"_5":30445,"_20902":121501,"_27381":121502,"_2946":121503},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3461":71837,"_30095":71827,"_5":30445,"_20902":121505,"_27381":121506,"_2946":121507},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3461":71838,"_30095":71827,"_5":30445,"_20902":121509,"_27381":121510,"_2946":121511},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3461":71839,"_30095":71827,"_5":30445,"_20902":121513,"_27381":121514,"_2946":121515},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3461":71840,"_30095":71827,"_5":30445,"_20902":121517,"_27381":121518,"_2946":121519},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3461":71841,"_30095":71827,"_5":30445,"_20902":121521,"_27381":121522,"_2946":121523},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3461":71842,"_30095":71827,"_5":30445,"_20902":121525,"_27381":121526,"_2946":121527},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3461":71843,"_30095":71827,"_5":30445,"_20902":121529,"_27381":121530,"_2946":121531},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3461":71844,"_30095":71827,"_5":30445,"_20902":121533,"_27381":121534,"_2946":121535},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3461":71845,"_30095":71827,"_5":30445,"_20902":121537,"_27381":121538,"_2946":121539},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3461":71846,"_30095":71827,"_5":30445,"_20902":121541,"_27381":121542,"_2946":121543},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3461":71847,"_30095":71827,"_5":30445,"_20902":121545,"_27381":121546,"_2946":121547},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3461":71848,"_30095":71827,"_5":30445,"_20902":121549,"_27381":121550,"_2946":121551},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3461":71849,"_30095":71827,"_5":30445,"_20902":121553,"_27381":121554,"_2946":121555},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3461":71850,"_30095":71827,"_5":30445,"_20902":121557,"_27381":121558,"_2946":121559},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3461":71851,"_30095":71827,"_5":30445,"_20902":121561,"_27381":121562,"_2946":121563},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3461":71852,"_30095":71827,"_20902":121565,"_5":14358,"_27381":71827,"_2946":121566},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3461":71853,"_30095":71827,"_20902":121568,"_5":14358,"_27381":71827,"_2946":121569},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3461":71854,"_30095":71827,"_20902":121571,"_5":14358,"_27381":71827,"_2946":121572},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3461":71855,"_30095":71827,"_20902":121574,"_5":14358,"_27381":121475,"_2946":121575},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3461":71856,"_30095":71827,"_20902":121577,"_5":14358,"_27381":121475,"_2946":121578},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3461":71857,"_30095":71827,"_20902":121580,"_5":14358,"_27381":121475,"_2946":121581},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3461":71858,"_30095":71827,"_20902":121583,"_5":14358,"_27381":121475,"_2946":121584},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3461":71859,"_30095":71827,"_20902":121586,"_5":14358,"_27381":121475,"_2946":121587},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3461":71860,"_30095":71827,"_20902":121589,"_5":14358,"_27381":121483,"_2946":121590},[],"Decide si la CA será raíz o intermedia.",{"_3461":71861,"_30095":71827,"_20902":121592,"_5":14358,"_27381":121483,"_2946":121593},[],"Elige el motor que custodiará la clave.",{"_3461":71862,"_30095":71827,"_20902":121595,"_5":14358,"_27381":121483,"_2946":121596},[],"Define una validez superior a la de los certificados que emitirá.",{"_3461":71863,"_30095":71827,"_20902":121598,"_5":14358,"_27381":121483,"_2946":121599},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3461":71864,"_30095":71827,"_20902":121601,"_5":14358,"_27381":121486,"_2946":121602},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3461":71865,"_30095":71827,"_20902":121604,"_5":14358,"_27381":121490,"_2946":121605},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3461":71866,"_30095":71827,"_20902":121607,"_5":14358,"_27381":121490,"_2946":121608},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3461":71867,"_30095":71827,"_20902":121610,"_5":14358,"_27381":121494,"_2946":121611},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3461":71868,"_30095":71827,"_20902":121613,"_5":14358,"_27381":121498,"_2946":121614},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3461":71869,"_30095":71827,"_20902":121616,"_5":14358,"_27381":121498,"_2946":121617},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3461":71870,"_30095":71827,"_20902":121619,"_5":14358,"_27381":121498,"_2946":121620},[],"`ST`: estado o provincia.",{"_3461":71871,"_30095":71827,"_20902":121622,"_5":14358,"_27381":121498,"_2946":121623},[],"`L`: localidad.",{"_3461":71872,"_30095":71827,"_20902":121625,"_5":14358,"_27381":121498,"_2946":121626},[],"`O`: organización.",{"_3461":71873,"_30095":71827,"_20902":121628,"_5":14358,"_27381":121498,"_2946":121629},[],"`OU`: unidad organizativa.",{"_3461":71874,"_30095":71827,"_20902":121631,"_5":14358,"_27381":121498,"_2946":121632},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3461":71875,"_30095":71827,"_20902":121634,"_5":14358,"_27381":121502,"_2946":121635},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3461":71876,"_30095":71827,"_20902":121637,"_5":14358,"_27381":121502,"_2946":121638},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3461":71877,"_30095":71827,"_20902":121640,"_5":14358,"_27381":121506,"_2946":121641},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3461":71878,"_30095":71827,"_20902":121643,"_5":14358,"_27381":121506,"_2946":121644},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3461":71879,"_30095":71827,"_20902":121646,"_5":14358,"_27381":121510,"_2946":121647},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3461":71880,"_30095":71827,"_20902":121649,"_5":14358,"_27381":121510,"_2946":121650},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3461":71881,"_30095":71827,"_20902":121652,"_5":14358,"_27381":121514,"_2946":121653},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3461":71882,"_30095":71827,"_20902":121655,"_5":14358,"_27381":121514,"_2946":121656},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3461":71883,"_30095":71827,"_20902":121658,"_5":14358,"_27381":121514,"_2946":121659},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3461":71884,"_30095":71827,"_20902":121661,"_5":14358,"_27381":121518,"_2946":121662},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3461":71885,"_30095":71827,"_20902":121664,"_5":14358,"_27381":121522,"_2946":121665},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3461":71886,"_30095":71827,"_20902":121667,"_5":14358,"_27381":121522,"_2946":121668},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3461":71887,"_30095":71827,"_20902":121670,"_5":14358,"_27381":121526,"_2946":121671},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3461":71888,"_30095":71827,"_20902":121673,"_5":14358,"_27381":121530,"_2946":121674},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3461":71889,"_30095":71827,"_20902":121676,"_5":14358,"_27381":121530,"_2946":121677},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3461":71890,"_30095":71827,"_20902":121679,"_5":14358,"_27381":121534,"_2946":121680},[],"Abre una CA desde el inventario para consultar:",{"_3461":71891,"_30095":71827,"_20902":121682,"_5":14358,"_27381":121534,"_2946":121683},[],"Estado y periodo de validez.",{"_3461":71892,"_30095":71827,"_20902":121685,"_5":14358,"_27381":121534,"_2946":121686},[],"Certificado y cadena en formato PEM.",{"_3461":71893,"_30095":71827,"_20902":121688,"_5":14358,"_27381":121534,"_2946":121689},[],"Número de certificados activos, expirados y revocados.",{"_3461":71894,"_30095":71827,"_20902":121691,"_5":14358,"_27381":121534,"_2946":121692},[],"Certificados emitidos en **Issued Certificates**.",{"_3461":71895,"_30095":71827,"_20902":121694,"_5":14358,"_27381":121534,"_2946":121695},[],"CRL vinculada a la autoridad.",{"_3461":71896,"_30095":71827,"_20902":121697,"_5":14358,"_27381":121534,"_2946":121698},[],"Metadatos y motor criptográfico asociado.",{"_3461":71897,"_30095":71827,"_20902":121700,"_5":14358,"_27381":121534,"_2946":121701},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3461":71898,"_30095":71827,"_20902":121703,"_5":14358,"_27381":121538,"_2946":121704},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3461":71899,"_30095":71827,"_20902":121706,"_5":14358,"_27381":121538,"_2946":121707},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3461":71900,"_30095":71827,"_20902":121709,"_5":14358,"_27381":121538,"_2946":121710},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3461":71901,"_30095":71827,"_20902":121712,"_5":14358,"_27381":121538,"_2946":121713},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3461":71902,"_30095":71827,"_20902":121715,"_5":14358,"_27381":121542,"_2946":121716},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3461":71903,"_30095":71827,"_20902":121718,"_5":14358,"_27381":121546,"_2946":121719},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3461":71904,"_30095":71827,"_20902":121721,"_5":14358,"_27381":121550,"_2946":121722},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3461":71905,"_30095":71827,"_20902":121724,"_5":14358,"_27381":121554,"_2946":121725},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3461":71906,"_30095":71827,"_20902":121727,"_5":14358,"_27381":121558,"_2946":121728},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3461":71907,"_30095":71827,"_20902":121730,"_5":14358,"_27381":121562,"_2946":121731},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3461":71908,"_30095":71827,"_20902":121733,"_5":14358,"_27381":121562,"_2946":121734},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3461":71909,"_30095":71827,"_20902":121736,"_5":14358,"_27381":121562,"_2946":121737},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<legacy-ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3461":71910,"_30095":71910,"_5":14710,"_2946":121739,"_30448":121740,"_20902":121741,"_27381":71910},"Perfiles de certificado",[49146,117427,54619,121305],[],{"_3461":71911,"_30095":71910,"_20902":121743,"_5":14358,"_27381":71910,"_2946":121744},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3461":71912,"_30095":71910,"_5":30445,"_20902":121746,"_27381":121747,"_2946":121748},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3461":71913,"_30095":71910,"_5":30445,"_20902":121750,"_27381":121751,"_2946":121752},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#validez","Validez",{"_3461":71914,"_30095":71910,"_5":30445,"_20902":121754,"_27381":121755,"_2946":121756},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3461":71915,"_30095":71910,"_5":30445,"_20902":121758,"_27381":121759,"_2946":121760},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3461":71916,"_30095":71910,"_5":30445,"_20902":121762,"_27381":121763,"_2946":121764},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3461":71917,"_30095":71910,"_5":30445,"_20902":121766,"_27381":121767,"_2946":121768},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3461":71918,"_30095":71910,"_5":30445,"_20902":121770,"_27381":121771,"_2946":121772},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3461":71919,"_30095":71910,"_5":30445,"_20902":121774,"_27381":121775,"_2946":121776},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3461":71920,"_30095":71910,"_5":30445,"_20902":121778,"_27381":121779,"_2946":121780},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3461":71921,"_30095":71910,"_5":30445,"_20902":121782,"_27381":121783,"_2946":121784},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3461":71922,"_30095":71910,"_5":30445,"_20902":121786,"_27381":121787,"_2946":121788},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3461":71923,"_30095":71910,"_5":30445,"_20902":121790,"_27381":121791,"_2946":121792},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3461":71924,"_30095":71910,"_5":30445,"_20902":121794,"_27381":121795,"_2946":121796},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3461":71925,"_30095":71910,"_5":30445,"_20902":121798,"_27381":121799,"_2946":121800},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3461":71926,"_30095":71910,"_5":30445,"_20902":121802,"_27381":121803,"_2946":121804},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3461":71927,"_30095":71910,"_5":30445,"_20902":121806,"_27381":121807,"_2946":121808},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3461":71928,"_30095":71910,"_20902":121810,"_5":14358,"_27381":71910,"_2946":121811},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3461":71929,"_30095":71910,"_20902":121813,"_5":14358,"_27381":71910,"_2946":121814},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3461":71930,"_30095":71910,"_20902":121816,"_5":14358,"_27381":121751,"_2946":121817},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3461":71931,"_30095":71910,"_20902":121819,"_5":14358,"_27381":121751,"_2946":121820},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3461":71932,"_30095":71910,"_20902":121822,"_5":14358,"_27381":121755,"_2946":121823},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3461":71933,"_30095":71910,"_20902":121825,"_5":14358,"_27381":121759,"_2946":121826},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3461":71934,"_30095":71910,"_20902":121828,"_5":14358,"_27381":121759,"_2946":121829},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3461":71935,"_30095":71910,"_20902":121831,"_5":14358,"_27381":121759,"_2946":121832},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3461":71936,"_30095":71910,"_20902":121834,"_5":14358,"_27381":121763,"_2946":121835},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3461":71937,"_30095":71910,"_20902":121837,"_5":14358,"_27381":121767,"_2946":121838},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3461":71938,"_30095":71910,"_20902":121840,"_5":14358,"_27381":121767,"_2946":121841},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3461":71939,"_30095":71910,"_20902":121843,"_5":14358,"_27381":121771,"_2946":121844},[],"La aplicación criptográfica puede:",{"_3461":71940,"_30095":71910,"_20902":121846,"_5":14358,"_27381":121771,"_2946":121847},[],"permitir o bloquear claves RSA;",{"_3461":71941,"_30095":71910,"_20902":121849,"_5":14358,"_27381":121771,"_2946":121850},[],"limitar los tamaños RSA admitidos;",{"_3461":71942,"_30095":71910,"_20902":121852,"_5":14358,"_27381":121771,"_2946":121853},[],"permitir o bloquear claves ECDSA;",{"_3461":71943,"_30095":71910,"_20902":121855,"_5":14358,"_27381":121771,"_2946":121856},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3461":71944,"_30095":71910,"_20902":121858,"_5":14358,"_27381":121771,"_2946":121859},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3461":71945,"_30095":71910,"_20902":121861,"_5":14358,"_27381":121775,"_2946":121862},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3461":71946,"_30095":71910,"_20902":121864,"_5":14358,"_27381":121775,"_2946":117187},[],{"_3461":71947,"_30095":71910,"_20902":121866,"_5":14358,"_27381":121775,"_2946":121867},[],"Primera opción",{"_3461":71948,"_30095":71910,"_20902":121869,"_5":14358,"_27381":121775,"_2946":121870},[],"Segunda opción",{"_3461":71949,"_30095":71910,"_20902":121872,"_5":14358,"_27381":121775,"_2946":121873},[],"Si no hay ninguna",{"_3461":71950,"_30095":71910,"_20902":121875,"_5":14358,"_27381":121775,"_2946":121876},[],"Firma directa con una CA",{"_3461":71951,"_30095":71910,"_20902":121878,"_5":14358,"_27381":121775,"_2946":121879},[],"`issuance_profile` incluido en la solicitud",{"_3461":71952,"_30095":71910,"_20902":121881,"_5":14358,"_27381":121775,"_2946":121882},[],"`issuance_profile_id` de la solicitud",{"_3461":71953,"_30095":71910,"_20902":121884,"_5":14358,"_27381":121775,"_2946":121885},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3461":71954,"_30095":71910,"_20902":121887,"_5":14358,"_27381":121775,"_2946":121888},[],"Emisión mediante DMS",{"_3461":71955,"_30095":71910,"_20902":121890,"_5":14358,"_27381":121775,"_2946":55206},[],{"_3461":71956,"_30095":71910,"_20902":121892,"_5":14358,"_27381":121775,"_2946":121893},[],"`settings.issuance_profile` incluido en el DMS",{"_3461":71957,"_30095":71910,"_20902":121895,"_5":14358,"_27381":121775,"_2946":121896},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3461":71958,"_30095":71910,"_20902":121898,"_5":14358,"_27381":121775,"_2946":121899},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3461":71959,"_30095":71910,"_20902":121901,"_5":14358,"_27381":121775,"_2946":121902},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3461":71960,"_30095":71910,"_20902":121904,"_5":14358,"_27381":121783,"_2946":121905},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3461":71961,"_30095":71910,"_20902":121907,"_5":14358,"_27381":121787,"_2946":121908},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3461":71962,"_30095":71910,"_20902":121910,"_5":14358,"_27381":121791,"_2946":121911},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3461":71963,"_30095":71910,"_20902":121913,"_5":14358,"_27381":121795,"_2946":121914},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3461":71964,"_30095":71910,"_20902":121916,"_5":14358,"_27381":121799,"_2946":121917},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3461":71965,"_30095":71910,"_20902":121919,"_5":14358,"_27381":121799,"_2946":121920},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3461":71966,"_30095":71910,"_20902":121922,"_5":14358,"_27381":121803,"_2946":121923},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3461":71967,"_30095":71910,"_20902":121925,"_5":14358,"_27381":121803,"_2946":121926},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3461":71968,"_30095":71910,"_20902":121928,"_5":14358,"_27381":121803,"_2946":121929},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3461":71969,"_30095":71910,"_20902":121931,"_5":14358,"_27381":121803,"_2946":121932},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3461":71970,"_30095":71910,"_20902":121934,"_5":14358,"_27381":121807,"_2946":121935},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3461":71971,"_30095":71910,"_20902":121937,"_5":14358,"_27381":121807,"_2946":121938},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3461":71972,"_30095":71972,"_5":14710,"_2946":121940,"_30448":121941,"_20902":121943,"_27381":71972},"Validación de certificados",[49146,117427,54619,121942],"Validación",[],{"_3461":71973,"_30095":71972,"_20902":121945,"_5":14358,"_27381":71972,"_2946":121946},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3461":71974,"_30095":71972,"_5":30445,"_20902":121948,"_27381":121949,"_2946":121950},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3461":71975,"_30095":71972,"_5":30445,"_20902":121952,"_27381":121953,"_2946":121954},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3461":71976,"_30095":71972,"_5":30445,"_20902":121956,"_27381":121957,"_2946":121958},[],"/docs/pr-preview/pr-60/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3461":71977,"_30095":71972,"_20902":121960,"_5":14358,"_27381":71972,"_2946":121961},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3461":71978,"_30095":71972,"_20902":121963,"_5":14358,"_27381":121949,"_2946":121964},[],"Verifica estos criterios juntos:",{"_3461":71979,"_30095":71972,"_20902":121966,"_5":14358,"_27381":121949,"_2946":120934},[],{"_3461":71980,"_30095":71972,"_20902":121968,"_5":14358,"_27381":121949,"_2946":121969},[],"Resultado necesario",{"_3461":71981,"_30095":71972,"_20902":121971,"_5":14358,"_27381":121949,"_2946":121972},[],"Cadena y firma",{"_3461":71982,"_30095":71972,"_20902":121974,"_5":14358,"_27381":121949,"_2946":121975},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3461":71983,"_30095":71972,"_20902":121977,"_5":14358,"_27381":121949,"_2946":121978},[],"Fechas",{"_3461":71984,"_30095":71972,"_20902":121980,"_5":14358,"_27381":121949,"_2946":121981},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3461":71985,"_30095":71972,"_20902":121983,"_5":14358,"_27381":121949,"_2946":117097},[],{"_3461":71986,"_30095":71972,"_20902":121985,"_5":14358,"_27381":121949,"_2946":121986},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3461":71987,"_30095":71972,"_20902":121988,"_5":14358,"_27381":121949,"_2946":121989},[],"Uso",{"_3461":71988,"_30095":71972,"_20902":121991,"_5":14358,"_27381":121949,"_2946":121992},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3461":71989,"_30095":71972,"_20902":121994,"_5":14358,"_27381":121949,"_2946":121995},[],"Revocación",{"_3461":71990,"_30095":71972,"_20902":121997,"_5":14358,"_27381":121949,"_2946":121998},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3461":71991,"_30095":71972,"_20902":122000,"_5":14358,"_27381":121949,"_2946":122001},[],"Autorización",{"_3461":71992,"_30095":71972,"_20902":122003,"_5":14358,"_27381":121949,"_2946":122004},[],"La aplicación permite la acción a esa identidad.",{"_3461":71993,"_30095":71972,"_20902":122006,"_5":14358,"_27381":121949,"_2946":122007},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3461":71994,"_30095":71972,"_20902":122009,"_5":14358,"_27381":121953,"_2946":122010},[],"Mecanismo",{"_3461":71995,"_30095":71972,"_20902":122012,"_5":14358,"_27381":121953,"_2946":122013},[],"Cuándo utilizarlo",{"_3461":71996,"_30095":71972,"_20902":122015,"_5":14358,"_27381":121953,"_2946":122016},[],"Qué debes mantener",{"_3461":71997,"_30095":71972,"_20902":122018,"_5":14358,"_27381":121953,"_2946":55334},[],{"_3461":71998,"_30095":71972,"_20902":122020,"_5":14358,"_27381":121953,"_2946":122021},[],"Consulta del estado de un certificado concreto.",{"_3461":71999,"_30095":71972,"_20902":122023,"_5":14358,"_27381":121953,"_2946":122024},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3461":72000,"_30095":71972,"_20902":122026,"_5":14358,"_27381":121953,"_2946":55343},[],{"_3461":72001,"_30095":71972,"_20902":122028,"_5":14358,"_27381":121953,"_2946":122029},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3461":72002,"_30095":71972,"_20902":122031,"_5":14358,"_27381":121953,"_2946":122032},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3461":72003,"_30095":71972,"_20902":122034,"_5":14358,"_27381":121953,"_2946":122035},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3461":72004,"_30095":71972,"_20902":122037,"_5":14358,"_27381":121953,"_2946":122038},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3461":72005,"_30095":71972,"_20902":122040,"_5":14358,"_27381":121957,"_2946":122041},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3461":72006,"_30095":71972,"_20902":122043,"_5":14358,"_27381":121957,"_2946":122044},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3461":72007,"_30095":71972,"_20902":122046,"_5":14358,"_27381":121957,"_2946":122047},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3461":72008,"_30095":71972,"_20902":122049,"_5":14358,"_27381":121957,"_2946":122050},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3461":72009,"_30095":71972,"_20902":122052,"_5":14358,"_27381":121957,"_2946":122053},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3461":72010,"_30095":71972,"_20902":122055,"_5":14358,"_27381":121957,"_2946":122056},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3461":72011,"_30095":71972,"_20902":122058,"_5":14358,"_27381":121957,"_2946":122059},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3461":72012,"_30095":71972,"_20902":122061,"_5":14358,"_27381":121957,"_2946":122062},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":72013,"_30095":71972,"_20902":122064,"_5":14358,"_27381":121957,"_2946":122065},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3461":72014,"_30095":72014,"_5":14710,"_2946":122067,"_30448":122068,"_20902":122069,"_27381":72014},"Certificados",[49146,117427,54619,121305],[],{"_3461":72015,"_30095":72014,"_20902":122071,"_5":14358,"_27381":72014,"_2946":122072},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3461":72016,"_30095":72014,"_5":30445,"_20902":122074,"_27381":122075,"_2946":122076},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3461":72017,"_30095":72014,"_5":30445,"_20902":122078,"_27381":122079,"_2946":122080},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3461":72018,"_30095":72014,"_5":30445,"_20902":122082,"_27381":122083,"_2946":122084},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3461":72019,"_30095":72014,"_5":30445,"_20902":122086,"_27381":122087,"_2946":122088},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3461":72020,"_30095":72014,"_5":30445,"_20902":122090,"_27381":122091,"_2946":122092},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3461":72021,"_30095":72014,"_5":30445,"_20902":122094,"_27381":122095,"_2946":122096},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3461":72022,"_30095":72014,"_5":30445,"_20902":122098,"_27381":122099,"_2946":122100},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3461":72023,"_30095":72014,"_5":30445,"_20902":122102,"_27381":122103,"_2946":122104},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3461":72024,"_30095":72014,"_5":30445,"_20902":122106,"_27381":122107,"_2946":122108},[],"/docs/pr-preview/pr-60/es/platform/pki/certificates#continúa","Continúa",{"_3461":72025,"_30095":72014,"_20902":122110,"_5":14358,"_27381":72014,"_2946":122111},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3461":72026,"_30095":72014,"_20902":122113,"_5":14358,"_27381":122075,"_2946":122114},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3461":72027,"_30095":72014,"_20902":122116,"_5":14358,"_27381":122075,"_2946":122117},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3461":72028,"_30095":72014,"_20902":122119,"_5":14358,"_27381":122075,"_2946":122120},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3461":72029,"_30095":72014,"_20902":122122,"_5":14358,"_27381":122075,"_2946":122123},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3461":72030,"_30095":72014,"_20902":122125,"_5":14358,"_27381":122075,"_2946":122126},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3461":72031,"_30095":72014,"_20902":122128,"_5":14358,"_27381":122075,"_2946":122129},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3461":72032,"_30095":72014,"_20902":122131,"_5":14358,"_27381":122075,"_2946":122132},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3461":72033,"_30095":72014,"_20902":122134,"_5":14358,"_27381":122079,"_2946":122135},[],"Descarga el PEM e inspecciónalo:",{"_3461":72034,"_30095":72014,"_20902":122137,"_5":14358,"_27381":122079,"_2946":122138},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3461":72035,"_30095":72014,"_20902":122140,"_5":14358,"_27381":122083,"_2946":122141},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3461":72036,"_30095":72014,"_20902":122143,"_5":14358,"_27381":122083,"_2946":122144},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3461":72037,"_30095":72014,"_20902":122146,"_5":14358,"_27381":122083,"_2946":122147},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3461":72038,"_30095":72014,"_20902":122149,"_5":14358,"_27381":122083,"_2946":122150},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3461":72039,"_30095":72014,"_20902":122152,"_5":14358,"_27381":122083,"_2946":122153},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3461":72040,"_30095":72014,"_20902":122155,"_5":14358,"_27381":122083,"_2946":122156},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3461":72041,"_30095":72014,"_20902":122158,"_5":14358,"_27381":122083,"_2946":122159},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3461":72042,"_30095":72014,"_20902":122161,"_5":14358,"_27381":122087,"_2946":122162},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3461":72043,"_30095":72014,"_20902":122164,"_5":14358,"_27381":122091,"_2946":122165},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3461":72044,"_30095":72014,"_20902":122167,"_5":14358,"_27381":122095,"_2946":122168},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3461":72045,"_30095":72014,"_20902":122170,"_5":14358,"_27381":122099,"_2946":122171},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3461":72046,"_30095":72014,"_20902":122173,"_5":14358,"_27381":122099,"_2946":122174},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3461":72047,"_30095":72014,"_20902":122176,"_5":14358,"_27381":122099,"_2946":122177},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3461":72048,"_30095":72014,"_20902":122179,"_5":14358,"_27381":122103,"_2946":122180},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3461":72049,"_30095":72014,"_20902":122182,"_5":14358,"_27381":122103,"_2946":122183},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3461":72050,"_30095":72014,"_20902":122185,"_5":14358,"_27381":122103,"_2946":122186},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3461":72051,"_30095":72014,"_20902":122188,"_5":14358,"_27381":122107,"_2946":122189},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":72052,"_30095":72014,"_20902":122191,"_5":14358,"_27381":122107,"_2946":122192},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3461":72053,"_30095":72053,"_5":14710,"_2946":122194,"_30448":122195,"_20902":122197,"_27381":72053},"Ciclo de vida de un certificado",[49146,117427,54619,122196],"Conceptos",[],{"_3461":72054,"_30095":72053,"_20902":122199,"_5":14358,"_27381":72053,"_2946":122200},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3461":72055,"_30095":72053,"_5":30445,"_20902":122202,"_27381":122203,"_2946":122204},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3461":72056,"_30095":72053,"_5":30445,"_20902":122206,"_27381":122207,"_2946":122208},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3461":72057,"_30095":72053,"_5":30445,"_20902":122210,"_27381":122211,"_2946":122212},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3461":72058,"_30095":72053,"_5":30445,"_20902":122214,"_27381":122215,"_2946":122216},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3461":72059,"_30095":72053,"_5":30445,"_20902":122218,"_27381":122219,"_2946":122220},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3461":72060,"_30095":72053,"_5":30445,"_20902":122222,"_27381":122223,"_2946":122224},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3461":72061,"_30095":72053,"_5":30445,"_20902":122226,"_27381":122227,"_2946":119928},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3461":72062,"_30095":72053,"_5":30445,"_20902":122229,"_27381":122230,"_2946":122231},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3461":72063,"_30095":72053,"_5":30445,"_20902":122233,"_27381":122234,"_2946":122235},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3461":72064,"_30095":72053,"_5":30445,"_20902":122237,"_27381":122238,"_2946":122239},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3461":72065,"_30095":72053,"_20902":122241,"_5":14358,"_27381":72053,"_2946":122242},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3461":72066,"_30095":72053,"_20902":122244,"_5":14358,"_27381":122207,"_2946":122245},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3461":72067,"_30095":72053,"_20902":122247,"_5":14358,"_27381":122211,"_2946":122248},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3461":72068,"_30095":72053,"_20902":122250,"_5":14358,"_27381":122215,"_2946":122251},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3461":72069,"_30095":72053,"_20902":122253,"_5":14358,"_27381":122219,"_2946":122254},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3461":72070,"_30095":72053,"_20902":122256,"_5":14358,"_27381":122223,"_2946":122257},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3461":72071,"_30095":72053,"_20902":122259,"_5":14358,"_27381":122227,"_2946":122260},[],"Lamassu persiste cuatro estados X.509:",{"_3461":72072,"_30095":72053,"_20902":122262,"_5":14358,"_27381":122227,"_2946":122263},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3461":72073,"_30095":72053,"_20902":122265,"_5":14358,"_27381":122227,"_2946":122266},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3461":72074,"_30095":72053,"_20902":122268,"_5":14358,"_27381":122227,"_2946":122269},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3461":72075,"_30095":72053,"_20902":122271,"_5":14358,"_27381":122227,"_2946":122272},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3461":72076,"_30095":72053,"_20902":122274,"_5":14358,"_27381":122227,"_2946":122275},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3461":72077,"_30095":72053,"_20902":122277,"_5":14358,"_27381":122230,"_2946":122278},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3461":72078,"_30095":72053,"_20902":122280,"_5":14358,"_27381":122230,"_2946":122281},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3461":72079,"_30095":72053,"_20902":122283,"_5":14358,"_27381":122230,"_2946":122284},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3461":72080,"_30095":72053,"_20902":122286,"_5":14358,"_27381":122234,"_2946":122287},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3461":72081,"_30095":72053,"_20902":122289,"_5":14358,"_27381":122234,"_2946":122290},[],"Antes de confirmar:",{"_3461":72082,"_30095":72053,"_20902":122292,"_5":14358,"_27381":122234,"_2946":122293},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3461":72083,"_30095":72053,"_20902":122295,"_5":14358,"_27381":122234,"_2946":122296},[],"Distribuye la nueva cadena de confianza.",{"_3461":72084,"_30095":72053,"_20902":122298,"_5":14358,"_27381":122234,"_2946":122299},[],"Reemite las identidades necesarias.",{"_3461":72085,"_30095":72053,"_20902":122301,"_5":14358,"_27381":122234,"_2946":122302},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3461":72086,"_30095":72053,"_20902":122304,"_5":14358,"_27381":122234,"_2946":122305},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3461":72087,"_30095":72053,"_20902":122307,"_5":14358,"_27381":122234,"_2946":122308},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3461":72088,"_30095":72053,"_20902":122310,"_5":14358,"_27381":122238,"_2946":122311},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3461":72089,"_30095":72053,"_20902":122313,"_5":14358,"_27381":122238,"_2946":122314},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3461":72090,"_30095":72053,"_20902":122316,"_5":14358,"_27381":122238,"_2946":122317},[],"Cambios de estado y razones de revocación.",{"_3461":72091,"_30095":72053,"_20902":122319,"_5":14358,"_27381":122238,"_2946":122320},[],"Publicación y vigencia de OCSP y CRLs.",{"_3461":72092,"_30095":72053,"_20902":122322,"_5":14358,"_27381":122238,"_2946":122323},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3461":72093,"_30095":72053,"_20902":122325,"_5":14358,"_27381":122238,"_2946":122326},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3461":72094,"_30095":72094,"_5":14710,"_2946":122328,"_30448":122329,"_20902":122330,"_27381":72094},"Modelo de confianza",[49146,117427,54619,122196],[],{"_3461":72095,"_30095":72094,"_20902":122332,"_5":14358,"_27381":72094,"_2946":122333},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3461":72096,"_30095":72094,"_5":30445,"_20902":122335,"_27381":122336,"_2946":122337},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3461":72097,"_30095":72094,"_5":30445,"_20902":122339,"_27381":122340,"_2946":122341},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3461":72098,"_30095":72094,"_5":30445,"_20902":122343,"_27381":122344,"_2946":122345},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3461":72099,"_30095":72094,"_5":30445,"_20902":122347,"_27381":122348,"_2946":122349},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3461":72100,"_30095":72094,"_5":30445,"_20902":122351,"_27381":122352,"_2946":122353},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3461":72101,"_30095":72094,"_5":30445,"_20902":122355,"_27381":122356,"_2946":122357},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3461":72102,"_30095":72094,"_5":30445,"_20902":122359,"_27381":122360,"_2946":122361},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3461":72103,"_30095":72094,"_5":30445,"_20902":122363,"_27381":122364,"_2946":122365},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3461":72104,"_30095":72094,"_5":30445,"_20902":122367,"_27381":122368,"_2946":122369},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3461":72105,"_30095":72094,"_5":30445,"_20902":122371,"_27381":122372,"_2946":122373},[],"/docs/pr-preview/pr-60/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3461":72106,"_30095":72094,"_20902":122375,"_5":14358,"_27381":72094,"_2946":122376},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3461":72107,"_30095":72094,"_20902":122378,"_5":14358,"_27381":122340,"_2946":122379},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3461":72108,"_30095":72094,"_20902":122381,"_5":14358,"_27381":122344,"_2946":122382},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3461":72109,"_30095":72094,"_20902":122384,"_5":14358,"_27381":122348,"_2946":122385},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3461":72110,"_30095":72094,"_20902":122387,"_5":14358,"_27381":122352,"_2946":122388},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3461":72111,"_30095":72094,"_20902":122390,"_5":14358,"_27381":122356,"_2946":122391},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3461":72112,"_30095":72094,"_20902":122393,"_5":14358,"_27381":122356,"_2946":122394},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3461":72113,"_30095":72094,"_20902":122396,"_5":14358,"_27381":122356,"_2946":122397},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3461":72114,"_30095":72094,"_20902":122399,"_5":14358,"_27381":122356,"_2946":122400},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3461":72115,"_30095":72094,"_20902":122402,"_5":14358,"_27381":122356,"_2946":122403},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3461":72116,"_30095":72094,"_20902":122405,"_5":14358,"_27381":122356,"_2946":122406},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3461":72117,"_30095":72094,"_20902":122408,"_5":14358,"_27381":122360,"_2946":122409},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3461":72118,"_30095":72094,"_20902":122411,"_5":14358,"_27381":122360,"_2946":122412},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3461":72119,"_30095":72094,"_20902":122414,"_5":14358,"_27381":122360,"_2946":122415},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3461":72120,"_30095":72094,"_20902":122417,"_5":14358,"_27381":122360,"_2946":122418},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3461":72121,"_30095":72094,"_20902":122420,"_5":14358,"_27381":122360,"_2946":122421},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3461":72122,"_30095":72094,"_20902":122423,"_5":14358,"_27381":122364,"_2946":122424},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3461":72123,"_30095":72094,"_20902":122426,"_5":14358,"_27381":122364,"_2946":122427},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3461":72124,"_30095":72094,"_20902":122429,"_5":14358,"_27381":122364,"_2946":122430},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3461":72125,"_30095":72094,"_20902":122432,"_5":14358,"_27381":122364,"_2946":122433},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3461":72126,"_30095":72094,"_20902":122435,"_5":14358,"_27381":122364,"_2946":122436},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3461":72127,"_30095":72094,"_20902":122438,"_5":14358,"_27381":122364,"_2946":122439},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3461":72128,"_30095":72094,"_20902":122441,"_5":14358,"_27381":122364,"_2946":122442},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3461":72129,"_30095":72094,"_20902":122444,"_5":14358,"_27381":122368,"_2946":122445},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3461":72130,"_30095":72094,"_20902":122447,"_5":14358,"_27381":122372,"_2946":122448},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3461":72131,"_30095":72094,"_20902":122450,"_5":14358,"_27381":122372,"_2946":122451},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3461":72132,"_30095":72094,"_20902":122453,"_5":14358,"_27381":122372,"_2946":122454},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3461":72133,"_30095":72094,"_20902":122456,"_5":14358,"_27381":122372,"_2946":122457},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3461":72134,"_30095":72094,"_20902":122459,"_5":14358,"_27381":122372,"_2946":122460},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3461":72135,"_30095":72094,"_20902":122462,"_5":14358,"_27381":122372,"_2946":122463},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3461":72136,"_30095":72094,"_20902":122465,"_5":14358,"_27381":122372,"_2946":122466},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3461":72137,"_30095":72137,"_5":14710,"_2946":122468,"_30448":122469,"_20902":122470,"_27381":72137},"Listas de revocación (CRL)",[49146,117427,54619,121942],[],{"_3461":72138,"_30095":72137,"_20902":122472,"_5":14358,"_27381":72137,"_2946":122473},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3461":72139,"_30095":72137,"_5":30445,"_20902":122475,"_27381":122476,"_2946":122477},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3461":72140,"_30095":72137,"_5":30445,"_20902":122479,"_27381":122480,"_2946":122481},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3461":72141,"_30095":72137,"_5":30445,"_20902":122483,"_27381":122484,"_2946":122485},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3461":72142,"_30095":72137,"_5":30445,"_20902":122487,"_27381":122488,"_2946":122489},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3461":72143,"_30095":72137,"_5":30445,"_20902":122491,"_27381":122492,"_2946":122493},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3461":72144,"_30095":72137,"_5":30445,"_20902":122495,"_27381":122496,"_2946":122497},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3461":72145,"_30095":72137,"_5":30445,"_20902":122499,"_27381":122500,"_2946":122501},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3461":72146,"_30095":72137,"_5":30445,"_20902":122503,"_27381":122504,"_2946":122505},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3461":72147,"_30095":72137,"_5":30445,"_20902":122507,"_27381":122508,"_2946":122509},[],"/docs/pr-preview/pr-60/es/platform/pki/crl#referencias","Referencias",{"_3461":72148,"_30095":72137,"_20902":122511,"_5":14358,"_27381":72137,"_2946":122512},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3461":72149,"_30095":72137,"_20902":122514,"_5":14358,"_27381":122476,"_2946":122515},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3461":72150,"_30095":72137,"_20902":122517,"_5":14358,"_27381":122476,"_2946":122518},[],"Campo",{"_3461":72151,"_30095":72137,"_20902":122520,"_5":14358,"_27381":122476,"_2946":118968},[],{"_3461":72152,"_30095":72137,"_20902":122522,"_5":14358,"_27381":122476,"_2946":55841},[],{"_3461":72153,"_30095":72137,"_20902":122524,"_5":14358,"_27381":122476,"_2946":122525},[],"ID de la CA a la que pertenecen los ajustes.",{"_3461":72154,"_30095":72137,"_20902":122527,"_5":14358,"_27381":122476,"_2946":55847},[],{"_3461":72155,"_30095":72137,"_20902":122529,"_5":14358,"_27381":122476,"_2946":122530},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3461":72156,"_30095":72137,"_20902":122532,"_5":14358,"_27381":122476,"_2946":55853},[],{"_3461":72157,"_30095":72137,"_20902":122534,"_5":14358,"_27381":122476,"_2946":122535},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3461":72158,"_30095":72137,"_20902":122537,"_5":14358,"_27381":122476,"_2946":55859},[],{"_3461":72159,"_30095":72137,"_20902":122539,"_5":14358,"_27381":122476,"_2946":122540},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3461":72160,"_30095":72137,"_20902":122542,"_5":14358,"_27381":122476,"_2946":122543},[],"Campo de `crl_options`",{"_3461":72161,"_30095":72137,"_20902":122545,"_5":14358,"_27381":122476,"_2946":118968},[],{"_3461":72162,"_30095":72137,"_20902":122547,"_5":14358,"_27381":122476,"_2946":122548},[],"Valor inicial",{"_3461":72163,"_30095":72137,"_20902":122550,"_5":14358,"_27381":122476,"_2946":55873},[],{"_3461":72164,"_30095":72137,"_20902":122552,"_5":14358,"_27381":122476,"_2946":122553},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3461":72165,"_30095":72137,"_20902":122555,"_5":14358,"_27381":122476,"_2946":122556},[],"7 días.",{"_3461":72166,"_30095":72137,"_20902":122558,"_5":14358,"_27381":122476,"_2946":55882},[],{"_3461":72167,"_30095":72137,"_20902":122560,"_5":14358,"_27381":122476,"_2946":122561},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3461":72168,"_30095":72137,"_20902":122563,"_5":14358,"_27381":122476,"_2946":122564},[],"6 días y 23 horas.",{"_3461":72169,"_30095":72137,"_20902":122566,"_5":14358,"_27381":122476,"_2946":55891},[],{"_3461":72170,"_30095":72137,"_20902":122568,"_5":14358,"_27381":122476,"_2946":122569},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3461":72171,"_30095":72137,"_20902":122571,"_5":14358,"_27381":122476,"_2946":55897},[],{"_3461":72172,"_30095":72137,"_20902":122573,"_5":14358,"_27381":122476,"_2946":55900},[],{"_3461":72173,"_30095":72137,"_20902":122575,"_5":14358,"_27381":122476,"_2946":122576},[],"Número de serie del certificado existente que firma la CRL.",{"_3461":72174,"_30095":72137,"_20902":122578,"_5":14358,"_27381":122476,"_2946":122579},[],"Número de serie del certificado actual de la CA.",{"_3461":72175,"_30095":72137,"_20902":122581,"_5":14358,"_27381":122476,"_2946":122582},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3461":72176,"_30095":72137,"_20902":122584,"_5":14358,"_27381":122476,"_2946":122585},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3461":72177,"_30095":72137,"_20902":122587,"_5":14358,"_27381":122476,"_2946":122588},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3461":72178,"_30095":72137,"_20902":122590,"_5":14358,"_27381":122476,"_2946":122591},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3461":72179,"_30095":72137,"_20902":122593,"_5":14358,"_27381":122476,"_2946":122594},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3461":72180,"_30095":72137,"_20902":122596,"_5":14358,"_27381":122476,"_2946":122597},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3461":72181,"_30095":72137,"_20902":122599,"_5":14358,"_27381":122476,"_2946":122600},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3461":72182,"_30095":72137,"_20902":122602,"_5":14358,"_27381":122476,"_2946":122603},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3461":72183,"_30095":72137,"_20902":122605,"_5":14358,"_27381":122476,"_2946":122606},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3461":72184,"_30095":72137,"_20902":122608,"_5":14358,"_27381":122476,"_2946":122609},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3461":72185,"_30095":72137,"_20902":122611,"_5":14358,"_27381":122480,"_2946":122612},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3461":72186,"_30095":72137,"_20902":122614,"_5":14358,"_27381":122480,"_2946":122615},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. La lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas.",{"_3461":72187,"_30095":72137,"_20902":122617,"_5":14358,"_27381":122480,"_2946":122618},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3461":72188,"_30095":72137,"_20902":122620,"_5":14358,"_27381":122480,"_2946":122621},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3461":72189,"_30095":72137,"_20902":122623,"_5":14358,"_27381":122484,"_2946":122624},[],"El trabajo programado de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3461":72190,"_30095":72137,"_20902":122626,"_5":14358,"_27381":122484,"_2946":122627},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3461":72191,"_30095":72137,"_20902":122629,"_5":14358,"_27381":122484,"_2946":122630},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3461":72192,"_30095":72137,"_20902":122632,"_5":14358,"_27381":122484,"_2946":122633},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3461":72193,"_30095":72137,"_20902":122635,"_5":14358,"_27381":122484,"_2946":122636},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3461":72194,"_30095":72137,"_20902":122638,"_5":14358,"_27381":122484,"_2946":122639},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3461":72195,"_30095":72137,"_20902":122641,"_5":14358,"_27381":122484,"_2946":122642},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3461":72196,"_30095":72137,"_20902":122644,"_5":14358,"_27381":122484,"_2946":122645},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3461":72197,"_30095":72137,"_20902":122647,"_5":14358,"_27381":122484,"_2946":122648},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3461":72198,"_30095":72137,"_20902":122650,"_5":14358,"_27381":122488,"_2946":122651},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3461":72199,"_30095":72137,"_20902":122653,"_5":14358,"_27381":122488,"_2946":122654},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3461":72200,"_30095":72137,"_20902":122656,"_5":14358,"_27381":122492,"_2946":122657},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3461":72201,"_30095":72137,"_20902":122659,"_5":14358,"_27381":122492,"_2946":122660},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3461":72202,"_30095":72137,"_20902":122662,"_5":14358,"_27381":122492,"_2946":122663},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3461":72203,"_30095":72137,"_20902":122665,"_5":14358,"_27381":122492,"_2946":122666},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3461":72204,"_30095":72137,"_20902":122668,"_5":14358,"_27381":122492,"_2946":122669},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3461":72205,"_30095":72137,"_20902":122671,"_5":14358,"_27381":122496,"_2946":122672},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3461":72206,"_30095":72137,"_20902":122674,"_5":14358,"_27381":122496,"_2946":119157},[],{"_3461":72207,"_30095":72137,"_20902":122676,"_5":14358,"_27381":122496,"_2946":122677},[],"Path relativo",{"_3461":72208,"_30095":72137,"_20902":122679,"_5":14358,"_27381":122496,"_2946":117187},[],{"_3461":72209,"_30095":72137,"_20902":122681,"_5":14358,"_27381":122496,"_2946":56009},[],{"_3461":72210,"_30095":72137,"_20902":122683,"_5":14358,"_27381":122496,"_2946":56012},[],{"_3461":72211,"_30095":72137,"_20902":122685,"_5":14358,"_27381":122496,"_2946":122686},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3461":72212,"_30095":72137,"_20902":122688,"_5":14358,"_27381":122496,"_2946":56009},[],{"_3461":72213,"_30095":72137,"_20902":122690,"_5":14358,"_27381":122496,"_2946":56020},[],{"_3461":72214,"_30095":72137,"_20902":122692,"_5":14358,"_27381":122496,"_2946":122693},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3461":72215,"_30095":72137,"_20902":122695,"_5":14358,"_27381":122496,"_2946":56026},[],{"_3461":72216,"_30095":72137,"_20902":122697,"_5":14358,"_27381":122496,"_2946":56020},[],{"_3461":72217,"_30095":72137,"_20902":122699,"_5":14358,"_27381":122496,"_2946":122700},[],"Sustituir la configuración de CRL de una CA.",{"_3461":72218,"_30095":72137,"_20902":122702,"_5":14358,"_27381":122496,"_2946":122703},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3461":72219,"_30095":72137,"_20902":122705,"_5":14358,"_27381":122496,"_2946":122706},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3461":72220,"_30095":72137,"_20902":122708,"_5":14358,"_27381":122500,"_2946":122709},[],"Síntoma",{"_3461":72221,"_30095":72137,"_20902":122711,"_5":14358,"_27381":122500,"_2946":122712},[],"Causa",{"_3461":72222,"_30095":72137,"_20902":122714,"_5":14358,"_27381":122500,"_2946":122715},[],"Acción",{"_3461":72223,"_30095":72137,"_20902":122717,"_5":14358,"_27381":122500,"_2946":122718},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3461":72224,"_30095":72137,"_20902":122720,"_5":14358,"_27381":122500,"_2946":122721},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3461":72225,"_30095":72137,"_20902":122723,"_5":14358,"_27381":122500,"_2946":122724},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3461":72226,"_30095":72137,"_20902":122726,"_5":14358,"_27381":122500,"_2946":122727},[],"`PUT` devuelve 400.",{"_3461":72227,"_30095":72137,"_20902":122729,"_5":14358,"_27381":122500,"_2946":122730},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3461":72228,"_30095":72137,"_20902":122732,"_5":14358,"_27381":122500,"_2946":122733},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3461":72229,"_30095":72137,"_20902":122735,"_5":14358,"_27381":122500,"_2946":122736},[],"`PUT` devuelve 404.",{"_3461":72230,"_30095":72137,"_20902":122738,"_5":14358,"_27381":122500,"_2946":122739},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3461":72231,"_30095":72137,"_20902":122741,"_5":14358,"_27381":122500,"_2946":122742},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3461":72232,"_30095":72137,"_20902":122744,"_5":14358,"_27381":122500,"_2946":122745},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3461":72233,"_30095":72137,"_20902":122747,"_5":14358,"_27381":122500,"_2946":122748},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3461":72234,"_30095":72137,"_20902":122750,"_5":14358,"_27381":122500,"_2946":122751},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3461":72235,"_30095":72137,"_20902":122753,"_5":14358,"_27381":122500,"_2946":122754},[],"La CRL no cambia tras revocar un certificado.",{"_3461":72236,"_30095":72137,"_20902":122756,"_5":14358,"_27381":122500,"_2946":122757},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3461":72237,"_30095":72137,"_20902":122759,"_5":14358,"_27381":122500,"_2946":122760},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3461":72238,"_30095":72137,"_20902":122762,"_5":14358,"_27381":122500,"_2946":122763},[],"Un verificador rechaza la CRL por el emisor.",{"_3461":72239,"_30095":72137,"_20902":122765,"_5":14358,"_27381":122500,"_2946":122766},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3461":72240,"_30095":72137,"_20902":122768,"_5":14358,"_27381":122500,"_2946":122769},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3461":72241,"_30095":72137,"_20902":122771,"_5":14358,"_27381":122504,"_2946":122772},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3461":72242,"_30095":72137,"_20902":122774,"_5":14358,"_27381":122508,"_2946":122775},[],"RFC 5280: perfil X.509 y CRL.",{"_3461":72243,"_30095":72137,"_20902":122777,"_5":14358,"_27381":122508,"_2946":56109},[],{"_3461":72244,"_30095":72137,"_20902":122779,"_5":14358,"_27381":122508,"_2946":56112},[],{"_3461":72245,"_30095":72137,"_20902":122781,"_5":14358,"_27381":122508,"_2946":122782},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3461":72246,"_30095":72137,"_20902":122784,"_5":14358,"_27381":122508,"_2946":122785},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3461":72247,"_30095":72247,"_5":14710,"_2946":122787,"_30448":122788,"_20902":122789,"_27381":72247},"Claves y motores criptográficos",[49146,117427,54619,121305],[],{"_3461":72248,"_30095":72247,"_20902":122791,"_5":14358,"_27381":72247,"_2946":122792},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3461":72249,"_30095":72247,"_5":30445,"_20902":122794,"_27381":122795,"_2946":122796},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3461":72250,"_30095":72247,"_5":30445,"_20902":122798,"_27381":122799,"_2946":122800},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3461":72251,"_30095":72247,"_5":30445,"_20902":122802,"_27381":122803,"_2946":56137},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#file-system",{"_3461":72252,"_30095":72247,"_5":30445,"_20902":122805,"_27381":122806,"_2946":56141},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#hashicorp-vault",{"_3461":72253,"_30095":72247,"_5":30445,"_20902":122808,"_27381":122809,"_2946":56145},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#aws-secrets-manager",{"_3461":72254,"_30095":72247,"_5":30445,"_20902":122811,"_27381":122812,"_2946":56149},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#aws-kms",{"_3461":72255,"_30095":72247,"_5":30445,"_20902":122814,"_27381":122815,"_2946":56153},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#pkcs11",{"_3461":72256,"_30095":72247,"_5":30445,"_20902":122817,"_27381":122818,"_2946":56157},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#azure-key-vault",{"_3461":72257,"_30095":72247,"_5":30445,"_20902":122820,"_27381":122821,"_2946":122822},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3461":72258,"_30095":72247,"_5":30445,"_20902":122824,"_27381":122825,"_2946":122826},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3461":72259,"_30095":72247,"_5":30445,"_20902":122828,"_27381":122829,"_2946":122830},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3461":72260,"_30095":72247,"_5":30445,"_20902":122832,"_27381":122833,"_2946":122834},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3461":72261,"_30095":72247,"_5":30445,"_20902":122836,"_27381":122837,"_2946":122838},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3461":72262,"_30095":72247,"_5":30445,"_20902":122840,"_27381":122841,"_2946":122842},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3461":72263,"_30095":72247,"_5":30445,"_20902":122844,"_27381":122845,"_2946":122846},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3461":72264,"_30095":72247,"_5":30445,"_20902":122848,"_27381":122849,"_2946":56189},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#sign",{"_3461":72265,"_30095":72247,"_5":30445,"_20902":122851,"_27381":122852,"_2946":56193},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#verify",{"_3461":72266,"_30095":72247,"_5":30445,"_20902":122854,"_27381":122855,"_2946":122856},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3461":72267,"_30095":72247,"_5":30445,"_20902":122858,"_27381":122859,"_2946":122860},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3461":72268,"_30095":72247,"_5":30445,"_20902":122862,"_27381":122863,"_2946":122864},[],"/docs/pr-preview/pr-60/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3461":72269,"_30095":72247,"_20902":122866,"_5":14358,"_27381":72247,"_2946":122867},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3461":72270,"_30095":72247,"_20902":122869,"_5":14358,"_27381":72247,"_2946":122870},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3461":72271,"_30095":72247,"_20902":122872,"_5":14358,"_27381":122795,"_2946":122873},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3461":72272,"_30095":72247,"_20902":122875,"_5":14358,"_27381":122795,"_2946":122876},[],"En la práctica, permite:",{"_3461":72273,"_30095":72247,"_20902":122878,"_5":14358,"_27381":122795,"_2946":122879},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3461":72274,"_30095":72247,"_20902":122881,"_5":14358,"_27381":122795,"_2946":122882},[],"Importar claves creadas externamente.",{"_3461":72275,"_30095":72247,"_20902":122884,"_5":14358,"_27381":122795,"_2946":122885},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3461":72276,"_30095":72247,"_20902":122887,"_5":14358,"_27381":122795,"_2946":122888},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3461":72277,"_30095":72247,"_20902":122890,"_5":14358,"_27381":122799,"_2946":122891},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3461":72278,"_30095":72247,"_20902":122893,"_5":14358,"_27381":122799,"_2946":122894},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3461":72279,"_30095":72247,"_20902":122896,"_5":14358,"_27381":122799,"_2946":122897},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3461":72280,"_30095":72247,"_20902":122899,"_5":14358,"_27381":122803,"_2946":122900},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3461":72281,"_30095":72247,"_20902":122902,"_5":14358,"_27381":122806,"_2946":122903},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3461":72282,"_30095":72247,"_20902":122905,"_5":14358,"_27381":122806,"_2946":122906},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3461":72283,"_30095":72247,"_20902":122908,"_5":14358,"_27381":122809,"_2946":122909},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3461":72284,"_30095":72247,"_20902":122911,"_5":14358,"_27381":122812,"_2946":122912},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3461":72285,"_30095":72247,"_20902":122914,"_5":14358,"_27381":122815,"_2946":122915},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3461":72286,"_30095":72247,"_20902":122917,"_5":14358,"_27381":122818,"_2946":122918},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3461":72287,"_30095":72247,"_20902":122920,"_5":14358,"_27381":122818,"_2946":122921},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3461":72288,"_30095":72247,"_20902":122923,"_5":14358,"_27381":122818,"_2946":122924},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3461":72289,"_30095":72247,"_20902":122926,"_5":14358,"_27381":122818,"_2946":122927},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3461":72290,"_30095":72247,"_20902":122929,"_5":14358,"_27381":122821,"_2946":122930},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3461":72291,"_30095":72247,"_20902":122932,"_5":14358,"_27381":122821,"_2946":122933},[],"La tabla incluye los siguientes campos:",{"_3461":72292,"_30095":72247,"_20902":122935,"_5":14358,"_27381":122821,"_2946":122936},[],"**Name**: nombre descriptivo de la clave.",{"_3461":72293,"_30095":72247,"_20902":122938,"_5":14358,"_27381":122821,"_2946":122939},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3461":72294,"_30095":72247,"_20902":122941,"_5":14358,"_27381":122821,"_2946":122942},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3461":72295,"_30095":72247,"_20902":122944,"_5":14358,"_27381":122821,"_2946":122945},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3461":72296,"_30095":72247,"_20902":122947,"_5":14358,"_27381":122821,"_2946":122948},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3461":72297,"_30095":72247,"_20902":122950,"_5":14358,"_27381":122821,"_2946":122951},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3461":72298,"_30095":72247,"_20902":122953,"_5":14358,"_27381":122821,"_2946":122954},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3461":72299,"_30095":72247,"_20902":122956,"_5":14358,"_27381":122821,"_2946":122957},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3461":72300,"_30095":72247,"_20902":122959,"_5":14358,"_27381":122821,"_2946":122960},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3461":72301,"_30095":72247,"_20902":122962,"_5":14358,"_27381":122821,"_2946":122963},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3461":72302,"_30095":72247,"_20902":122965,"_5":14358,"_27381":122821,"_2946":122966},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3461":72303,"_30095":72247,"_20902":122968,"_5":14358,"_27381":122821,"_2946":122969},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3461":72304,"_30095":72247,"_20902":122971,"_5":14358,"_27381":122821,"_2946":122972},[],"**Delete Key** para eliminar la clave del sistema.",{"_3461":72305,"_30095":72247,"_20902":122974,"_5":14358,"_27381":122825,"_2946":122975},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3461":72306,"_30095":72247,"_20902":122977,"_5":14358,"_27381":122829,"_2946":122978},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3461":72307,"_30095":72247,"_20902":122980,"_5":14358,"_27381":122829,"_2946":122981},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3461":72308,"_30095":72247,"_20902":122983,"_5":14358,"_27381":122829,"_2946":122984},[],"**Key Name**: nombre único y descriptivo.",{"_3461":72309,"_30095":72247,"_20902":122986,"_5":14358,"_27381":122829,"_2946":122987},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3461":72310,"_30095":72247,"_20902":122989,"_5":14358,"_27381":122829,"_2946":122990},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3461":72311,"_30095":72247,"_20902":122992,"_5":14358,"_27381":122829,"_2946":122993},[],"**Tags**: metadatos para clasificar la clave.",{"_3461":72312,"_30095":72247,"_20902":122995,"_5":14358,"_27381":122829,"_2946":122996},[],"**Metadata**: información adicional para usos avanzados.",{"_3461":72313,"_30095":72247,"_20902":122998,"_5":14358,"_27381":122833,"_2946":122999},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3461":72314,"_30095":72247,"_20902":123001,"_5":14358,"_27381":122833,"_2946":123002},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3461":72315,"_30095":72247,"_20902":123004,"_5":14358,"_27381":122833,"_2946":123005},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3461":72316,"_30095":72247,"_20902":123007,"_5":14358,"_27381":122833,"_2946":123008},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3461":72317,"_30095":72247,"_20902":123010,"_5":14358,"_27381":122833,"_2946":123011},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3461":72318,"_30095":72247,"_20902":123013,"_5":14358,"_27381":122833,"_2946":123014},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3461":72319,"_30095":72247,"_20902":123016,"_5":14358,"_27381":122833,"_2946":123017},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3461":72320,"_30095":72247,"_20902":123019,"_5":14358,"_27381":122833,"_2946":123020},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3461":72321,"_30095":72247,"_20902":123022,"_5":14358,"_27381":122833,"_2946":123023},[],"**Metadata**: información adicional opcional.",{"_3461":72322,"_30095":72247,"_20902":123025,"_5":14358,"_27381":122833,"_2946":123026},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3461":72323,"_30095":72247,"_20902":123028,"_5":14358,"_27381":122833,"_2946":123029},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3461":72324,"_30095":72247,"_20902":123031,"_5":14358,"_27381":122837,"_2946":123032},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3461":72325,"_30095":72247,"_20902":123034,"_5":14358,"_27381":122841,"_2946":123035},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3461":72326,"_30095":72247,"_20902":123037,"_5":14358,"_27381":122841,"_2946":123038},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3461":72327,"_30095":72247,"_20902":123040,"_5":14358,"_27381":122841,"_2946":123041},[],"**Key Name**: nombre descriptivo.",{"_3461":72328,"_30095":72247,"_20902":123043,"_5":14358,"_27381":122841,"_2946":123044},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3461":72329,"_30095":72247,"_20902":123046,"_5":14358,"_27381":122841,"_2946":123047},[],"**Tags**: etiquetas asociadas.",{"_3461":72330,"_30095":72247,"_20902":123049,"_5":14358,"_27381":122841,"_2946":123050},[],"**Aliases**: nombres alternativos.",{"_3461":72331,"_30095":72247,"_20902":123052,"_5":14358,"_27381":122841,"_2946":123053},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3461":72332,"_30095":72247,"_20902":123055,"_5":14358,"_27381":122841,"_2946":123056},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3461":72333,"_30095":72247,"_20902":123058,"_5":14358,"_27381":122841,"_2946":123059},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3461":72334,"_30095":72247,"_20902":123061,"_5":14358,"_27381":122841,"_2946":123062},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3461":72335,"_30095":72247,"_20902":123064,"_5":14358,"_27381":122845,"_2946":123065},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3461":72336,"_30095":72247,"_20902":123067,"_5":14358,"_27381":122845,"_2946":123068},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3461":72337,"_30095":72247,"_20902":123070,"_5":14358,"_27381":122845,"_2946":123071},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3461":72338,"_30095":72247,"_20902":123073,"_5":14358,"_27381":122849,"_2946":123074},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3461":72339,"_30095":72247,"_20902":123076,"_5":14358,"_27381":122849,"_2946":123077},[],"Campos principales:",{"_3461":72340,"_30095":72247,"_20902":123079,"_5":14358,"_27381":122849,"_2946":123080},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3461":72341,"_30095":72247,"_20902":123082,"_5":14358,"_27381":122849,"_2946":123083},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3461":72342,"_30095":72247,"_20902":123085,"_5":14358,"_27381":122849,"_2946":123086},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3461":72343,"_30095":72247,"_20902":123088,"_5":14358,"_27381":122849,"_2946":123089},[],"**Message**: contenido que se va a firmar.",{"_3461":72344,"_30095":72247,"_20902":123091,"_5":14358,"_27381":122849,"_2946":123092},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3461":72345,"_30095":72247,"_20902":123094,"_5":14358,"_27381":122852,"_2946":123095},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3461":72346,"_30095":72247,"_20902":123097,"_5":14358,"_27381":122852,"_2946":123077},[],{"_3461":72347,"_30095":72247,"_20902":123099,"_5":14358,"_27381":122852,"_2946":123100},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3461":72348,"_30095":72247,"_20902":123102,"_5":14358,"_27381":122852,"_2946":123103},[],"**Message Type**: `Raw` o `Digest`.",{"_3461":72349,"_30095":72247,"_20902":123105,"_5":14358,"_27381":122852,"_2946":123106},[],"**Payload Encoding**: codificación del mensaje.",{"_3461":72350,"_30095":72247,"_20902":123108,"_5":14358,"_27381":122852,"_2946":123109},[],"**Message**: mensaje original o hash.",{"_3461":72351,"_30095":72247,"_20902":123111,"_5":14358,"_27381":122852,"_2946":123112},[],"**Signature**: firma que se desea comprobar.",{"_3461":72352,"_30095":72247,"_20902":123114,"_5":14358,"_27381":122852,"_2946":123115},[],"**Result**: indicador del resultado de la validación.",{"_3461":72353,"_30095":72247,"_20902":123117,"_5":14358,"_27381":122855,"_2946":123118},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3461":72354,"_30095":72247,"_20902":123120,"_5":14358,"_27381":122855,"_2946":123121},[],"Este flujo es útil para:",{"_3461":72355,"_30095":72247,"_20902":123123,"_5":14358,"_27381":122855,"_2946":123124},[],"Solicitar certificados a una CA externa.",{"_3461":72356,"_30095":72247,"_20902":123126,"_5":14358,"_27381":122855,"_2946":123127},[],"Renovar una identidad manteniendo la misma clave.",{"_3461":72357,"_30095":72247,"_20902":123129,"_5":14358,"_27381":122855,"_2946":123130},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3461":72358,"_30095":72247,"_20902":123132,"_5":14358,"_27381":122855,"_2946":123133},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3461":72359,"_30095":72247,"_20902":123135,"_5":14358,"_27381":122855,"_2946":123136},[],"**Organization (O)**: organización o empresa.",{"_3461":72360,"_30095":72247,"_20902":123138,"_5":14358,"_27381":122855,"_2946":123139},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3461":72361,"_30095":72247,"_20902":123141,"_5":14358,"_27381":122855,"_2946":123142},[],"**Country (C)**: código de país de dos letras.",{"_3461":72362,"_30095":72247,"_20902":123144,"_5":14358,"_27381":122855,"_2946":123145},[],"**State / Province (ST)**: estado o provincia.",{"_3461":72363,"_30095":72247,"_20902":123147,"_5":14358,"_27381":122855,"_2946":123148},[],"**Locality (L)**: ciudad o localidad.",{"_3461":72364,"_30095":72247,"_20902":123150,"_5":14358,"_27381":122855,"_2946":123151},[],"**Email Address**: correo de contacto.",{"_3461":72365,"_30095":72247,"_20902":123153,"_5":14358,"_27381":122855,"_2946":123154},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3461":72366,"_30095":72247,"_20902":123156,"_5":14358,"_27381":122855,"_2946":123157},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3461":72367,"_30095":72247,"_20902":123159,"_5":14358,"_27381":122859,"_2946":123160},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3461":72368,"_30095":72247,"_20902":123162,"_5":14358,"_27381":122859,"_2946":123163},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3461":72369,"_30095":72247,"_20902":123165,"_5":14358,"_27381":122863,"_2946":123166},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3461":72370,"_30095":72247,"_20902":123168,"_5":14358,"_27381":122863,"_2946":123169},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3461":72371,"_30095":72371,"_5":14710,"_2946":123171,"_30448":123172,"_20902":123173,"_27381":72371},"Validación online con OCSP",[49146,117427,54619,121942],[],{"_3461":72372,"_30095":72371,"_20902":123175,"_5":14358,"_27381":72371,"_2946":123176},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3461":72373,"_30095":72371,"_5":30445,"_20902":123178,"_27381":123179,"_2946":123180},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3461":72374,"_30095":72371,"_5":30445,"_20902":123182,"_27381":123183,"_2946":123184},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3461":72375,"_30095":72371,"_5":30445,"_20902":123186,"_27381":123187,"_2946":123188},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3461":72376,"_30095":72371,"_5":30445,"_20902":123190,"_27381":123191,"_2946":123192},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3461":72377,"_30095":72371,"_5":30445,"_20902":123194,"_27381":123195,"_2946":123196},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3461":72378,"_30095":72371,"_5":30445,"_20902":123198,"_27381":123199,"_2946":122509},[],"/docs/pr-preview/pr-60/es/platform/pki/ocsp#referencias",{"_3461":72379,"_30095":72371,"_20902":123201,"_5":14358,"_27381":72371,"_2946":123202},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3461":72380,"_30095":72371,"_20902":123204,"_5":14358,"_27381":123179,"_2946":123205},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3461":72381,"_30095":72371,"_20902":123207,"_5":14358,"_27381":123179,"_2946":123208},[],"Estado del registro",{"_3461":72382,"_30095":72371,"_20902":123210,"_5":14358,"_27381":123179,"_2946":123211},[],"Respuesta firmada",{"_3461":72383,"_30095":72371,"_20902":123213,"_5":14358,"_27381":123179,"_2946":53756},[],{"_3461":72384,"_30095":72371,"_20902":123215,"_5":14358,"_27381":123179,"_2946":56557},[],{"_3461":72385,"_30095":72371,"_20902":123217,"_5":14358,"_27381":123179,"_2946":53773},[],{"_3461":72386,"_30095":72371,"_20902":123219,"_5":14358,"_27381":123179,"_2946":123220},[],"`Revoked`, con razón y fecha de revocación.",{"_3461":72387,"_30095":72371,"_20902":123222,"_5":14358,"_27381":123179,"_2946":123223},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3461":72388,"_30095":72371,"_20902":123225,"_5":14358,"_27381":123179,"_2946":123226},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3461":72389,"_30095":72371,"_20902":123228,"_5":14358,"_27381":123179,"_2946":123229},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3461":72390,"_30095":72371,"_20902":123231,"_5":14358,"_27381":123179,"_2946":123232},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3461":72391,"_30095":72371,"_20902":123234,"_5":14358,"_27381":123179,"_2946":123235},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3461":72392,"_30095":72371,"_20902":123237,"_5":14358,"_27381":123183,"_2946":123238},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3461":72393,"_30095":72371,"_20902":123240,"_5":14358,"_27381":123183,"_2946":123241},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3461":72394,"_30095":72371,"_20902":123243,"_5":14358,"_27381":123187,"_2946":123244},[],"El servicio acepta:",{"_3461":72395,"_30095":72371,"_20902":123246,"_5":14358,"_27381":123187,"_2946":119157},[],{"_3461":72396,"_30095":72371,"_20902":123248,"_5":14358,"_27381":123187,"_2946":123249},[],"Ruta del servicio VA",{"_3461":72397,"_30095":72371,"_20902":123251,"_5":14358,"_27381":123187,"_2946":123252},[],"Formato",{"_3461":72398,"_30095":72371,"_20902":123254,"_5":14358,"_27381":123187,"_2946":56597},[],{"_3461":72399,"_30095":72371,"_20902":123256,"_5":14358,"_27381":123187,"_2946":56600},[],{"_3461":72400,"_30095":72371,"_20902":123258,"_5":14358,"_27381":123187,"_2946":123259},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3461":72401,"_30095":72371,"_20902":123261,"_5":14358,"_27381":123187,"_2946":56009},[],{"_3461":72402,"_30095":72371,"_20902":123263,"_5":14358,"_27381":123187,"_2946":56608},[],{"_3461":72403,"_30095":72371,"_20902":123265,"_5":14358,"_27381":123187,"_2946":123266},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3461":72404,"_30095":72371,"_20902":123268,"_5":14358,"_27381":123187,"_2946":123269},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3461":72405,"_30095":72371,"_20902":123271,"_5":14358,"_27381":123191,"_2946":123272},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3461":72406,"_30095":72371,"_20902":123274,"_5":14358,"_27381":123191,"_2946":123275},[],"Genera la solicitud:",{"_3461":72407,"_30095":72371,"_20902":123277,"_5":14358,"_27381":123191,"_2946":123278},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3461":72408,"_30095":72371,"_20902":123280,"_5":14358,"_27381":123191,"_2946":123281},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3461":72409,"_30095":72371,"_20902":123283,"_5":14358,"_27381":123191,"_2946":123284},[],"Verifica el DER recibido:",{"_3461":72410,"_30095":72371,"_20902":123286,"_5":14358,"_27381":123191,"_2946":123287},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3461":72411,"_30095":72371,"_20902":123289,"_5":14358,"_27381":123195,"_2946":123290},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3461":72412,"_30095":72371,"_20902":123292,"_5":14358,"_27381":123195,"_2946":123293},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3461":72413,"_30095":72371,"_20902":123295,"_5":14358,"_27381":123199,"_2946":56641},[],{"_3461":72414,"_30095":72371,"_20902":123297,"_5":14358,"_27381":123199,"_2946":56644},[],{"_3461":72415,"_30095":72371,"_20902":123299,"_5":14358,"_27381":123199,"_2946":123300},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3461":72416,"_30095":72371,"_20902":123302,"_5":14358,"_27381":123199,"_2946":122785},[],{"_3461":72417,"_30095":72417,"_5":14710,"_2946":54619,"_30448":123304,"_20902":123305,"_27381":72417},[49146,117427,54619],[],{"_3461":72418,"_30095":72417,"_20902":123307,"_5":14358,"_27381":72417,"_2946":123308},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3461":72419,"_30095":72417,"_5":30445,"_20902":123310,"_27381":123311,"_2946":120631},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#empieza-aquí",{"_3461":72420,"_30095":72417,"_5":30445,"_20902":123313,"_27381":123314,"_2946":123315},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3461":72421,"_30095":72417,"_5":30445,"_20902":123317,"_27381":123318,"_2946":121151},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#capacidades-principales",{"_3461":72422,"_30095":72417,"_5":30445,"_20902":123320,"_27381":123321,"_2946":121155},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3461":72423,"_30095":72417,"_5":30445,"_20902":123323,"_27381":123324,"_2946":121159},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3461":72424,"_30095":72417,"_5":30445,"_20902":123326,"_27381":123327,"_2946":121163},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#emite-y-controla-certificados",{"_3461":72425,"_30095":72417,"_5":30445,"_20902":123329,"_27381":123330,"_2946":121171},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#publica-el-estado-de-validación",{"_3461":72426,"_30095":72417,"_5":30445,"_20902":123332,"_27381":123333,"_2946":123334},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3461":72427,"_30095":72417,"_5":30445,"_20902":123336,"_27381":123337,"_2946":122108},[],"/docs/pr-preview/pr-60/es/platform/pki/overview#continúa",{"_3461":72428,"_30095":72417,"_20902":123339,"_5":14358,"_27381":72417,"_2946":123340},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3461":72429,"_30095":72417,"_20902":123342,"_5":14358,"_27381":123311,"_2946":123343},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3461":72430,"_30095":72417,"_20902":123345,"_5":14358,"_27381":123311,"_2946":123346},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3461":72431,"_30095":72417,"_20902":123348,"_5":14358,"_27381":123314,"_2946":123349},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3461":72432,"_30095":72417,"_20902":123351,"_5":14358,"_27381":123314,"_2946":123352},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3461":72433,"_30095":72417,"_20902":123354,"_5":14358,"_27381":123314,"_2946":123355},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3461":72434,"_30095":72417,"_20902":123357,"_5":14358,"_27381":123314,"_2946":123358},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3461":72435,"_30095":72417,"_20902":123360,"_5":14358,"_27381":123314,"_2946":123361},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3461":72436,"_30095":72417,"_20902":123363,"_5":14358,"_27381":123321,"_2946":123364},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3461":72437,"_30095":72417,"_20902":123366,"_5":14358,"_27381":123324,"_2946":123367},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3461":72438,"_30095":72417,"_20902":123369,"_5":14358,"_27381":123327,"_2946":123370},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3461":72439,"_30095":72417,"_20902":123372,"_5":14358,"_27381":123330,"_2946":123373},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3461":72440,"_30095":72417,"_20902":123375,"_5":14358,"_27381":123333,"_2946":123376},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3461":72441,"_30095":72417,"_20902":123378,"_5":14358,"_27381":123333,"_2946":123379},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3461":72442,"_30095":72417,"_20902":123381,"_5":14358,"_27381":123333,"_2946":123382},[],"su clave pública corresponda a la clave privada del cliente;",{"_3461":72443,"_30095":72417,"_20902":123384,"_5":14358,"_27381":123333,"_2946":123385},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3461":72444,"_30095":72417,"_20902":123387,"_5":14358,"_27381":123333,"_2946":123388},[],"sus fechas y usos permitan la operación;",{"_3461":72445,"_30095":72417,"_20902":123390,"_5":14358,"_27381":123333,"_2946":123391},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3461":72446,"_30095":72417,"_20902":123393,"_5":14358,"_27381":123333,"_2946":123394},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3461":72447,"_30095":72417,"_20902":123396,"_5":14358,"_27381":123337,"_2946":123397},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3461":72448,"_30095":72417,"_20902":123399,"_5":14358,"_27381":123337,"_2946":123400},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3461":72449,"_30095":72417,"_20902":123402,"_5":14358,"_27381":123337,"_2946":123403},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3461":72450,"_30095":72450,"_5":14710,"_2946":123405,"_30448":123406,"_20902":123407,"_27381":72450},"Crea tu primera CA",[49146,117427,54619,120755],[],{"_3461":72451,"_30095":72450,"_20902":123409,"_5":14358,"_27381":72450,"_2946":123410},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3461":72452,"_30095":72450,"_5":30445,"_20902":123412,"_27381":123413,"_2946":116005},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3461":72453,"_30095":72450,"_5":30445,"_20902":123415,"_27381":123416,"_2946":123417},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3461":72454,"_30095":72450,"_5":30445,"_20902":123419,"_27381":123420,"_2946":123421},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3461":72455,"_30095":72450,"_5":30445,"_20902":123423,"_27381":123424,"_2946":123425},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3461":72456,"_30095":72450,"_5":30445,"_20902":123427,"_27381":123428,"_2946":123429},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3461":72457,"_30095":72450,"_5":30445,"_20902":123431,"_27381":123432,"_2946":123433},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3461":72458,"_30095":72450,"_5":30445,"_20902":123435,"_27381":123436,"_2946":123437},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3461":72459,"_30095":72450,"_5":30445,"_20902":123439,"_27381":123440,"_2946":121002},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3461":72460,"_30095":72450,"_5":30445,"_20902":123442,"_27381":123443,"_2946":116029},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3461":72461,"_30095":72450,"_20902":123445,"_5":14358,"_27381":72450,"_2946":123446},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3461":72462,"_30095":72450,"_20902":123448,"_5":14358,"_27381":123413,"_2946":123449},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3461":72463,"_30095":72450,"_20902":123451,"_5":14358,"_27381":123413,"_2946":123452},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3461":72464,"_30095":72450,"_20902":123454,"_5":14358,"_27381":123413,"_2946":123455},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3461":72465,"_30095":72450,"_20902":123457,"_5":14358,"_27381":123413,"_2946":123458},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3461":72466,"_30095":72450,"_20902":123460,"_5":14358,"_27381":123416,"_2946":123461},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3461":72467,"_30095":72450,"_20902":123463,"_5":14358,"_27381":123416,"_2946":123464},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3461":72468,"_30095":72450,"_20902":123466,"_5":14358,"_27381":123420,"_2946":123467},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3461":72469,"_30095":72450,"_20902":123469,"_5":14358,"_27381":123420,"_2946":123470},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3461":72470,"_30095":72450,"_20902":123472,"_5":14358,"_27381":123424,"_2946":123473},[],"Selecciona **Root CA** y completa:",{"_3461":72471,"_30095":72450,"_20902":123475,"_5":14358,"_27381":123424,"_2946":56823},[],{"_3461":72472,"_30095":72450,"_20902":123477,"_5":14358,"_27381":123424,"_2946":123478},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3461":72473,"_30095":72450,"_20902":123480,"_5":14358,"_27381":123424,"_2946":123481},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3461":72474,"_30095":72450,"_20902":123483,"_5":14358,"_27381":123424,"_2946":123484},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3461":72475,"_30095":72450,"_20902":123486,"_5":14358,"_27381":123424,"_2946":123487},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3461":72476,"_30095":72450,"_20902":123489,"_5":14358,"_27381":123428,"_2946":123490},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3461":72477,"_30095":72450,"_20902":123492,"_5":14358,"_27381":123432,"_2946":123493},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3461":72478,"_30095":72450,"_20902":123495,"_5":14358,"_27381":123432,"_2946":123496},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3461":72479,"_30095":72450,"_20902":123498,"_5":14358,"_27381":123436,"_2946":123499},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3461":72480,"_30095":72450,"_20902":123501,"_5":14358,"_27381":123436,"_2946":123502},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3461":72481,"_30095":72450,"_20902":123504,"_5":14358,"_27381":123436,"_2946":123505},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3461":72482,"_30095":72450,"_20902":123507,"_5":14358,"_27381":123440,"_2946":123508},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3461":72483,"_30095":72450,"_20902":123510,"_5":14358,"_27381":123440,"_2946":123511},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3461":72484,"_30095":72450,"_20902":123513,"_5":14358,"_27381":123440,"_2946":123514},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3461":72485,"_30095":72450,"_20902":123516,"_5":14358,"_27381":123440,"_2946":123517},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3461":72486,"_30095":72450,"_20902":123519,"_5":14358,"_27381":123443,"_2946":123520},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3461":72487,"_30095":72487,"_5":14710,"_2946":123522,"_30448":123523,"_20902":123524,"_27381":72487},"Emite y verifica un certificado",[49146,117427,54619,120755],[],{"_3461":72488,"_30095":72487,"_20902":123526,"_5":14358,"_27381":72487,"_2946":123527},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3461":72489,"_30095":72487,"_5":30445,"_20902":123529,"_27381":123530,"_2946":116005},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3461":72490,"_30095":72487,"_5":30445,"_20902":123532,"_27381":123533,"_2946":123534},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3461":72491,"_30095":72487,"_5":30445,"_20902":123536,"_27381":123537,"_2946":123538},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3461":72492,"_30095":72487,"_5":30445,"_20902":123540,"_27381":123541,"_2946":123542},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3461":72493,"_30095":72487,"_5":30445,"_20902":123544,"_27381":123545,"_2946":123546},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3461":72494,"_30095":72487,"_5":30445,"_20902":123548,"_27381":123549,"_2946":123550},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3461":72495,"_30095":72487,"_5":30445,"_20902":123552,"_27381":123553,"_2946":123554},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3461":72496,"_30095":72487,"_5":30445,"_20902":123556,"_27381":123557,"_2946":123558},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3461":72497,"_30095":72487,"_5":30445,"_20902":123560,"_27381":123561,"_2946":123562},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3461":72498,"_30095":72487,"_5":30445,"_20902":123564,"_27381":123565,"_2946":123566},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3461":72499,"_30095":72487,"_5":30445,"_20902":123568,"_27381":123569,"_2946":121002},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3461":72500,"_30095":72487,"_5":30445,"_20902":123571,"_27381":123572,"_2946":116029},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3461":72501,"_30095":72487,"_20902":123574,"_5":14358,"_27381":72487,"_2946":123575},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3461":72502,"_30095":72487,"_20902":123577,"_5":14358,"_27381":123530,"_2946":123578},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3461":72503,"_30095":72487,"_20902":123580,"_5":14358,"_27381":123530,"_2946":123581},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3461":72504,"_30095":72487,"_20902":123583,"_5":14358,"_27381":123530,"_2946":123584},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3461":72505,"_30095":72487,"_20902":123586,"_5":14358,"_27381":123530,"_2946":123587},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3461":72506,"_30095":72487,"_20902":123589,"_5":14358,"_27381":123530,"_2946":123590},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3461":72507,"_30095":72487,"_20902":123592,"_5":14358,"_27381":123533,"_2946":123593},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3461":72508,"_30095":72487,"_20902":123595,"_5":14358,"_27381":123537,"_2946":123596},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3461":72509,"_30095":72487,"_20902":123598,"_5":14358,"_27381":123537,"_2946":123599},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3461":72510,"_30095":72487,"_20902":123601,"_5":14358,"_27381":123541,"_2946":123602},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3461":72511,"_30095":72487,"_20902":123604,"_5":14358,"_27381":123541,"_2946":123605},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3461":72512,"_30095":72487,"_20902":123607,"_5":14358,"_27381":123545,"_2946":123608},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3461":72513,"_30095":72487,"_20902":123610,"_5":14358,"_27381":123545,"_2946":123611},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3461":72514,"_30095":72487,"_20902":123613,"_5":14358,"_27381":123549,"_2946":123614},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3461":72515,"_30095":72487,"_20902":123616,"_5":14358,"_27381":123553,"_2946":123617},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3461":72516,"_30095":72487,"_20902":123619,"_5":14358,"_27381":123557,"_2946":123620},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3461":72517,"_30095":72487,"_20902":123622,"_5":14358,"_27381":123561,"_2946":123623},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3461":72518,"_30095":72487,"_20902":123625,"_5":14358,"_27381":123561,"_2946":123626},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3461":72519,"_30095":72487,"_20902":123628,"_5":14358,"_27381":123561,"_2946":123629},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3461":72520,"_30095":72487,"_20902":123631,"_5":14358,"_27381":123565,"_2946":123632},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3461":72521,"_30095":72487,"_20902":123634,"_5":14358,"_27381":123565,"_2946":123635},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3461":72522,"_30095":72487,"_20902":123637,"_5":14358,"_27381":123565,"_2946":123638},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3461":72523,"_30095":72487,"_20902":123640,"_5":14358,"_27381":123569,"_2946":121085},[],{"_3461":72524,"_30095":72487,"_20902":123642,"_5":14358,"_27381":123569,"_2946":119606},[],{"_3461":72525,"_30095":72487,"_20902":123644,"_5":14358,"_27381":123569,"_2946":123645},[],"La CA rechaza la emisión",{"_3461":72526,"_30095":72487,"_20902":123647,"_5":14358,"_27381":123569,"_2946":123648},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3461":72527,"_30095":72487,"_20902":123650,"_5":14358,"_27381":123569,"_2946":123651},[],"Sujeto o usos diferentes",{"_3461":72528,"_30095":72487,"_20902":123653,"_5":14358,"_27381":123569,"_2946":123654},[],"Perfil aplicado y valores solicitados.",{"_3461":72529,"_30095":72487,"_20902":123656,"_5":14358,"_27381":123569,"_2946":123657},[],"No se encuentra el emisor",{"_3461":72530,"_30095":72487,"_20902":123659,"_5":14358,"_27381":123569,"_2946":123660},[],"CA descargada y cadena intermedia necesaria.",{"_3461":72531,"_30095":72487,"_20902":123662,"_5":14358,"_27381":123569,"_2946":123663},[],"Falla la vigencia",{"_3461":72532,"_30095":72487,"_20902":123665,"_5":14358,"_27381":123569,"_2946":123666},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3461":72533,"_30095":72487,"_20902":123668,"_5":14358,"_27381":123569,"_2946":123669},[],"Los resúmenes de clave difieren",{"_3461":72534,"_30095":72487,"_20902":123671,"_5":14358,"_27381":123569,"_2946":123672},[],"Archivos de certificado y clave de la misma emisión.",{"_3461":72535,"_30095":72487,"_20902":123674,"_5":14358,"_27381":123569,"_2946":123675},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3461":72536,"_30095":72487,"_20902":123677,"_5":14358,"_27381":123572,"_2946":123678},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3461":72537,"_30095":72487,"_20902":123680,"_5":14358,"_27381":123572,"_2946":123681},[],"Gestionar certificados para inspección, estado y revocación.",{"_3461":72538,"_30095":72487,"_20902":123683,"_5":14358,"_27381":123572,"_2946":123684},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3461":72539,"_30095":72487,"_20902":123686,"_5":14358,"_27381":123572,"_2946":123687},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3461":72540,"_30095":72487,"_20902":123689,"_5":14358,"_27381":123572,"_2946":123690},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3461":72541,"_30095":72541,"_5":14710,"_2946":123692,"_30448":123693,"_20902":123694,"_27381":72541},"Primeros pasos de PKI",[49146,117427,54619,120755],[],{"_3461":72542,"_30095":72541,"_20902":123696,"_5":14358,"_27381":72541,"_2946":123697},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3461":72543,"_30095":72541,"_5":30445,"_20902":123699,"_27381":123700,"_2946":116005},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3461":72544,"_30095":72541,"_5":30445,"_20902":123702,"_27381":123703,"_2946":123704},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3461":72545,"_30095":72541,"_5":30445,"_20902":123706,"_27381":123707,"_2946":120937},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3461":72546,"_30095":72541,"_5":30445,"_20902":123709,"_27381":123710,"_2946":123711},[],"/docs/pr-preview/pr-60/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3461":72547,"_30095":72541,"_20902":123713,"_5":14358,"_27381":72541,"_2946":123714},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3461":72548,"_30095":72541,"_20902":123716,"_5":14358,"_27381":123700,"_2946":123717},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3461":72549,"_30095":72541,"_20902":123719,"_5":14358,"_27381":123700,"_2946":123720},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3461":72550,"_30095":72541,"_20902":123722,"_5":14358,"_27381":123700,"_2946":123723},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3461":72551,"_30095":72541,"_20902":123725,"_5":14358,"_27381":123700,"_2946":123726},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3461":72552,"_30095":72541,"_20902":123728,"_5":14358,"_27381":123700,"_2946":123729},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3461":72553,"_30095":72541,"_20902":123731,"_5":14358,"_27381":123703,"_2946":123732},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3461":72554,"_30095":72541,"_20902":123734,"_5":14358,"_27381":123703,"_2946":123735},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3461":72555,"_30095":72541,"_20902":123737,"_5":14358,"_27381":123703,"_2946":123738},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3461":72556,"_30095":72541,"_20902":123740,"_5":14358,"_27381":123703,"_2946":123741},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3461":72557,"_30095":72541,"_20902":123743,"_5":14358,"_27381":123707,"_2946":123744},[],"Archivo o recurso",{"_3461":72558,"_30095":72541,"_20902":123746,"_5":14358,"_27381":123707,"_2946":120934},[],{"_3461":72559,"_30095":72541,"_20902":123748,"_5":14358,"_27381":123707,"_2946":123749},[],"CA raíz activa y `ca.pem`",{"_3461":72560,"_30095":72541,"_20902":123751,"_5":14358,"_27381":123707,"_2946":123752},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3461":72561,"_30095":72541,"_20902":123754,"_5":14358,"_27381":123707,"_2946":123755},[],"Certificado final y `device.crt`",{"_3461":72562,"_30095":72541,"_20902":123757,"_5":14358,"_27381":123707,"_2946":123758},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3461":72563,"_30095":72541,"_20902":123760,"_5":14358,"_27381":123707,"_2946":123761},[],"Clave privada `device.key`",{"_3461":72564,"_30095":72541,"_20902":123763,"_5":14358,"_27381":123707,"_2946":123764},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3461":72565,"_30095":72541,"_20902":123766,"_5":14358,"_27381":123707,"_2946":123767},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3461":72566,"_30095":72541,"_20902":123769,"_5":14358,"_27381":123710,"_2946":123770},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3461":72567,"_30095":72541,"_20902":123772,"_5":14358,"_27381":123710,"_2946":123773},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3461":72568,"_30095":72541,"_20902":123775,"_5":14358,"_27381":123710,"_2946":123776},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3461":72569,"_30095":72569,"_5":14710,"_2946":123778,"_30448":123779,"_20902":123781,"_27381":72569},"Resolución de problemas PKI",[49146,117427,54619,123780],"Resolución de problemas",[],{"_3461":72570,"_30095":72569,"_20902":123783,"_5":14358,"_27381":72569,"_2946":123784},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3461":72571,"_30095":72569,"_5":30445,"_20902":123786,"_27381":123787,"_2946":123788},[],"/docs/pr-preview/pr-60/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3461":72572,"_30095":72569,"_5":30445,"_20902":123790,"_27381":123791,"_2946":123792},[],"/docs/pr-preview/pr-60/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3461":72573,"_30095":72569,"_5":30445,"_20902":123794,"_27381":123795,"_2946":123796},[],"/docs/pr-preview/pr-60/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3461":72574,"_30095":72569,"_20902":123798,"_5":14358,"_27381":72569,"_2946":123799},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3461":72575,"_30095":72569,"_20902":123801,"_5":14358,"_27381":72569,"_2946":123802},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3461":72576,"_30095":72569,"_20902":123804,"_5":14358,"_27381":123787,"_2946":120934},[],{"_3461":72577,"_30095":72569,"_20902":123806,"_5":14358,"_27381":123787,"_2946":119606},[],{"_3461":72578,"_30095":72569,"_20902":123808,"_5":14358,"_27381":123787,"_2946":116029},[],{"_3461":72579,"_30095":72569,"_20902":123810,"_5":14358,"_27381":123787,"_2946":53461},[],{"_3461":72580,"_30095":72569,"_20902":123812,"_5":14358,"_27381":123787,"_2946":123813},[],"Existe, está activa y sus fechas son utilizables.",{"_3461":72581,"_30095":72569,"_20902":123815,"_5":14358,"_27381":123787,"_2946":123816},[],"Autoridades.",{"_3461":72582,"_30095":72569,"_20902":123818,"_5":14358,"_27381":123787,"_2946":123819},[],"Clave",{"_3461":72583,"_30095":72569,"_20902":123821,"_5":14358,"_27381":123787,"_2946":123822},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3461":72584,"_30095":72569,"_20902":123824,"_5":14358,"_27381":123787,"_2946":123825},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3461":72585,"_30095":72569,"_20902":123827,"_5":14358,"_27381":123787,"_2946":57177},[],{"_3461":72586,"_30095":72569,"_20902":123829,"_5":14358,"_27381":123787,"_2946":123830},[],"PEM correcto y firma verificable.",{"_3461":72587,"_30095":72569,"_20902":123832,"_5":14358,"_27381":123787,"_2946":57183},[],{"_3461":72588,"_30095":72569,"_20902":123834,"_5":14358,"_27381":123787,"_2946":123835},[],"Perfil",{"_3461":72589,"_30095":72569,"_20902":123837,"_5":14358,"_27381":123787,"_2946":123838},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3461":72590,"_30095":72569,"_20902":123840,"_5":14358,"_27381":123787,"_2946":123841},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3461":72591,"_30095":72569,"_20902":123843,"_5":14358,"_27381":123787,"_2946":121085},[],{"_3461":72592,"_30095":72569,"_20902":123845,"_5":14358,"_27381":123787,"_2946":123846},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3461":72593,"_30095":72569,"_20902":123848,"_5":14358,"_27381":123787,"_2946":123849},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3461":72594,"_30095":72569,"_20902":123851,"_5":14358,"_27381":123787,"_2946":123852},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3461":72595,"_30095":72569,"_20902":123854,"_5":14358,"_27381":123787,"_2946":123855},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3461":72596,"_30095":72569,"_20902":123857,"_5":14358,"_27381":123791,"_2946":123858},[],"Revisa cada frontera por separado:",{"_3461":72597,"_30095":72569,"_20902":123860,"_5":14358,"_27381":123791,"_2946":123861},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3461":72598,"_30095":72569,"_20902":123863,"_5":14358,"_27381":123791,"_2946":123864},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3461":72599,"_30095":72569,"_20902":123866,"_5":14358,"_27381":123791,"_2946":123867},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3461":72600,"_30095":72569,"_20902":123869,"_5":14358,"_27381":123791,"_2946":123870},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3461":72601,"_30095":72569,"_20902":123872,"_5":14358,"_27381":123791,"_2946":123873},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3461":72602,"_30095":72569,"_20902":123875,"_5":14358,"_27381":123791,"_2946":123876},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3461":72603,"_30095":72569,"_20902":123878,"_5":14358,"_27381":123795,"_2946":123879},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3461":72604,"_30095":72569,"_20902":123881,"_5":14358,"_27381":123795,"_2946":123882},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3461":72605,"_30095":72605,"_5":14710,"_2946":123884,"_30448":123885,"_20902":123886,"_27381":72605},"Seguridad",[49146],[],{"_3461":72606,"_30095":72605,"_20902":123888,"_5":14358,"_27381":72605,"_2946":123889},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3461":72607,"_30095":72605,"_5":30445,"_20902":123891,"_27381":123892,"_2946":123893},[],"/docs/pr-preview/pr-60/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3461":72608,"_30095":72605,"_5":30445,"_20902":123895,"_27381":123896,"_2946":123897},[],"/docs/pr-preview/pr-60/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3461":72609,"_30095":72605,"_5":30445,"_20902":123899,"_27381":123900,"_2946":123901},[],"/docs/pr-preview/pr-60/es/security#versiones-soportadas","Versiones soportadas",{"_3461":72610,"_30095":72605,"_5":30445,"_20902":123903,"_27381":123904,"_2946":123905},[],"/docs/pr-preview/pr-60/es/security#divulgación-responsable","Divulgación responsable",{"_3461":72611,"_30095":72605,"_20902":123907,"_5":14358,"_27381":72605,"_2946":123908},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3461":72612,"_30095":72605,"_20902":123910,"_5":14358,"_27381":123892,"_2946":123911},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3461":72613,"_30095":72605,"_20902":123913,"_5":14358,"_27381":123892,"_2946":123914},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3461":72614,"_30095":72605,"_20902":123916,"_5":14358,"_27381":123892,"_2946":14983},[],{"_3461":72615,"_30095":72605,"_20902":123918,"_5":14358,"_27381":123892,"_2946":14923},[],{"_3461":72616,"_30095":72605,"_20902":123920,"_5":14358,"_27381":123892,"_2946":14970},[],{"_3461":72617,"_30095":72605,"_20902":123922,"_5":14358,"_27381":123892,"_2946":123923},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3461":72618,"_30095":72605,"_20902":123925,"_5":14358,"_27381":123892,"_2946":123926},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3461":72619,"_30095":72605,"_20902":123928,"_5":14358,"_27381":123896,"_2946":123929},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3461":72620,"_30095":72605,"_20902":123931,"_5":14358,"_27381":123896,"_2946":123932},[],"No incluyas en el reporte:",{"_3461":72621,"_30095":72605,"_20902":123934,"_5":14358,"_27381":123896,"_2946":123935},[],"Credenciales, tokens o claves privadas",{"_3461":72622,"_30095":72605,"_20902":123937,"_5":14358,"_27381":123896,"_2946":123938},[],"Datos de clientes o información identificable de clientes",{"_3461":72623,"_30095":72605,"_20902":123940,"_5":14358,"_27381":123896,"_2946":123941},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3461":72624,"_30095":72605,"_20902":123943,"_5":14358,"_27381":123900,"_2946":123944},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3461":72625,"_30095":72605,"_20902":123946,"_5":14358,"_27381":123900,"_2946":123947},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3461":72626,"_30095":72605,"_20902":123949,"_5":14358,"_27381":123904,"_2946":123950},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3461":72627,"_30095":72605,"_20902":123952,"_5":14358,"_27381":123904,"_2946":123953},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3461":72628,"_30095":72605,"_20902":123955,"_5":14358,"_27381":123904,"_2946":123956},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3461":72629,"_30095":72605,"_20902":123958,"_5":14358,"_27381":123904,"_2946":123959},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3461":72630,"_30095":72605,"_20902":123961,"_5":14358,"_27381":123904,"_2946":123962},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3461":72631,"_30095":72631,"_5":14710,"_2946":123964,"_30448":123965,"_20902":123967,"_27381":72631},"3.8.0 a 4.0.0",[49146,123966],"Actualizaciones",[],{"_3461":72632,"_30095":72631,"_20902":123969,"_5":14358,"_27381":72631,"_2946":123970},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3461":72633,"_30095":72631,"_5":30445,"_20902":123972,"_27381":123973,"_2946":123974},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3461":72634,"_30095":72631,"_5":30445,"_20902":123976,"_27381":123977,"_2946":123978},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3461":72635,"_30095":72631,"_5":30445,"_20902":123980,"_27381":123981,"_2946":123982},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3461":72636,"_30095":72631,"_5":30445,"_20902":123984,"_27381":123985,"_2946":123986},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3461":72637,"_30095":72631,"_5":30445,"_20902":123988,"_27381":123989,"_2946":123990},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3461":72638,"_30095":72631,"_5":30445,"_20902":123992,"_27381":123993,"_2946":123994},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3461":72639,"_30095":72631,"_5":30445,"_20902":123996,"_27381":123997,"_2946":57349},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3461":72640,"_30095":72631,"_5":30445,"_20902":123999,"_27381":124000,"_2946":124001},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3461":72641,"_30095":72631,"_5":30445,"_20902":124003,"_27381":124004,"_2946":124005},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3461":72642,"_30095":72631,"_5":30445,"_20902":124007,"_27381":124008,"_2946":124009},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3461":72643,"_30095":72631,"_5":30445,"_20902":124011,"_27381":124012,"_2946":124013},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3461":72644,"_30095":72631,"_5":30445,"_20902":124015,"_27381":124016,"_2946":124017},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3461":72645,"_30095":72631,"_5":30445,"_20902":124019,"_27381":124020,"_2946":124021},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3461":72646,"_30095":72631,"_5":30445,"_20902":124023,"_27381":124024,"_2946":124025},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3461":72647,"_30095":72631,"_5":30445,"_20902":124027,"_27381":124028,"_2946":124029},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3461":72648,"_30095":72631,"_5":30445,"_20902":124031,"_27381":124032,"_2946":124033},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3461":72649,"_30095":72631,"_5":30445,"_20902":124035,"_27381":124036,"_2946":124037},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3461":72650,"_30095":72631,"_5":30445,"_20902":124039,"_27381":124040,"_2946":124041},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3461":72651,"_30095":72631,"_5":30445,"_20902":124043,"_27381":124044,"_2946":124045},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3461":72652,"_30095":72631,"_5":30445,"_20902":124047,"_27381":124048,"_2946":124049},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3461":72653,"_30095":72631,"_5":30445,"_20902":124051,"_27381":124052,"_2946":124053},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3461":72654,"_30095":72631,"_5":30445,"_20902":124055,"_27381":124056,"_2946":124057},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3461":72655,"_30095":72631,"_5":30445,"_20902":124059,"_27381":124060,"_2946":124061},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3461":72656,"_30095":72631,"_5":30445,"_20902":124063,"_27381":124064,"_2946":124065},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3461":72657,"_30095":72631,"_5":30445,"_20902":124067,"_27381":124068,"_2946":124069},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3461":72658,"_30095":72631,"_5":30445,"_20902":124071,"_27381":124072,"_2946":124073},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3461":72659,"_30095":72631,"_5":30445,"_20902":124075,"_27381":124076,"_2946":124077},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3461":72660,"_30095":72631,"_5":30445,"_20902":124079,"_27381":124080,"_2946":124081},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3461":72661,"_30095":72631,"_5":30445,"_20902":124083,"_27381":124084,"_2946":124085},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3461":72662,"_30095":72631,"_5":30445,"_20902":124087,"_27381":124088,"_2946":124089},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3461":72663,"_30095":72631,"_5":30445,"_20902":124091,"_27381":124092,"_2946":124093},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3461":72664,"_30095":72631,"_5":30445,"_20902":124095,"_27381":124096,"_2946":124097},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3461":72665,"_30095":72631,"_5":30445,"_20902":124099,"_27381":124100,"_2946":124101},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3461":72666,"_30095":72631,"_5":30445,"_20902":124103,"_27381":124104,"_2946":124105},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3461":72667,"_30095":72631,"_5":30445,"_20902":124107,"_27381":124108,"_2946":124109},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3461":72668,"_30095":72631,"_5":30445,"_20902":124111,"_27381":124112,"_2946":124113},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3461":72669,"_30095":72631,"_5":30445,"_20902":124115,"_27381":124116,"_2946":124117},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3461":72670,"_30095":72631,"_5":30445,"_20902":124119,"_27381":124120,"_2946":124121},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3461":72671,"_30095":72631,"_5":30445,"_20902":124123,"_27381":124124,"_2946":124125},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3461":72672,"_30095":72631,"_5":30445,"_20902":124127,"_27381":124128,"_2946":124129},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3461":72673,"_30095":72631,"_5":30445,"_20902":124131,"_27381":124132,"_2946":119948},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3461":72674,"_30095":72631,"_5":30445,"_20902":124134,"_27381":124135,"_2946":124136},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3461":72675,"_30095":72631,"_5":30445,"_20902":124138,"_27381":124139,"_2946":124140},[],"/docs/pr-preview/pr-60/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3461":72676,"_30095":72631,"_20902":124142,"_5":14358,"_27381":72631,"_2946":124143},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3461":72677,"_30095":72631,"_20902":124145,"_5":14358,"_27381":72631,"_2946":124146},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3461":72678,"_30095":72631,"_20902":124148,"_5":14358,"_27381":72631,"_2946":124149},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3461":72679,"_30095":72631,"_20902":124151,"_5":14358,"_27381":72631,"_2946":124152},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3461":72680,"_30095":72631,"_20902":124154,"_5":14358,"_27381":72631,"_2946":124155},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3461":72681,"_30095":72631,"_20902":124157,"_5":14358,"_27381":72631,"_2946":124158},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3461":72682,"_30095":72631,"_20902":124160,"_5":14358,"_27381":72631,"_2946":124161},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3461":72683,"_30095":72631,"_20902":124163,"_5":14358,"_27381":123977,"_2946":124164},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3461":72684,"_30095":72631,"_20902":124166,"_5":14358,"_27381":123977,"_2946":124167},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3461":72685,"_30095":72631,"_20902":124169,"_5":14358,"_27381":123981,"_2946":124170},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3461":72686,"_30095":72631,"_20902":124172,"_5":14358,"_27381":123981,"_2946":124173},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3461":72687,"_30095":72631,"_20902":124175,"_5":14358,"_27381":123985,"_2946":124176},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3461":72688,"_30095":72631,"_20902":124178,"_5":14358,"_27381":123989,"_2946":124179},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3461":72689,"_30095":72631,"_20902":124181,"_5":14358,"_27381":123989,"_2946":124182},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3461":72690,"_30095":72631,"_20902":124184,"_5":14358,"_27381":123989,"_2946":124185},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3461":72691,"_30095":72631,"_20902":124187,"_5":14358,"_27381":123989,"_2946":124188},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3461":72692,"_30095":72631,"_20902":124190,"_5":14358,"_27381":123989,"_2946":124191},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3461":72693,"_30095":72631,"_20902":124193,"_5":14358,"_27381":123993,"_2946":124194},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3461":72694,"_30095":72631,"_20902":124196,"_5":14358,"_27381":123993,"_2946":124197},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3461":72695,"_30095":72631,"_20902":124199,"_5":14358,"_27381":123993,"_2946":124200},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3461":72696,"_30095":72631,"_20902":124202,"_5":14358,"_27381":123993,"_2946":124203},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3461":72697,"_30095":72631,"_20902":124205,"_5":14358,"_27381":123993,"_2946":124206},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3461":72698,"_30095":72631,"_20902":124208,"_5":14358,"_27381":123993,"_2946":124209},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3461":72699,"_30095":72631,"_20902":124211,"_5":14358,"_27381":123997,"_2946":124212},[],"Cambio",{"_3461":72700,"_30095":72631,"_20902":124214,"_5":14358,"_27381":123997,"_2946":124215},[],"A quién afecta",{"_3461":72701,"_30095":72631,"_20902":124217,"_5":14358,"_27381":123997,"_2946":124218},[],"Gravedad",{"_3461":72702,"_30095":72631,"_20902":124220,"_5":14358,"_27381":123997,"_2946":122715},[],{"_3461":72703,"_30095":72631,"_20902":124222,"_5":14358,"_27381":123997,"_2946":124005},[],{"_3461":72704,"_30095":72631,"_20902":124224,"_5":14358,"_27381":123997,"_2946":124225},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3461":72705,"_30095":72631,"_20902":124227,"_5":14358,"_27381":123997,"_2946":124228},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3461":72706,"_30095":72631,"_20902":124230,"_5":14358,"_27381":123997,"_2946":124231},[],"Copiar los datos a los volúmenes nuevos",{"_3461":72707,"_30095":72631,"_20902":124233,"_5":14358,"_27381":123997,"_2946":124009},[],{"_3461":72708,"_30095":72631,"_20902":124235,"_5":14358,"_27381":123997,"_2946":124236},[],"Todas las releases de Helm",{"_3461":72709,"_30095":72631,"_20902":124238,"_5":14358,"_27381":123997,"_2946":124239},[],"Alta: `helm upgrade` falla",{"_3461":72710,"_30095":72631,"_20902":124241,"_5":14358,"_27381":123997,"_2946":124242},[],"Eliminar o renombrar las claves heredadas",{"_3461":72711,"_30095":72631,"_20902":124244,"_5":14358,"_27381":123997,"_2946":124013},[],{"_3461":72712,"_30095":72631,"_20902":124246,"_5":14358,"_27381":123997,"_2946":124247},[],"Todos los despliegues",{"_3461":72713,"_30095":72631,"_20902":124249,"_5":14358,"_27381":123997,"_2946":124250},[],"Alta: sin principal de bootstrap no hay administrador",{"_3461":72714,"_30095":72631,"_20902":124252,"_5":14358,"_27381":123997,"_2946":124253},[],"Configurar `services.authz`",{"_3461":72715,"_30095":72631,"_20902":124255,"_5":14358,"_27381":123997,"_2946":124017},[],{"_3461":72716,"_30095":72631,"_20902":124257,"_5":14358,"_27381":123997,"_2946":124236},[],{"_3461":72717,"_30095":72631,"_20902":124259,"_5":14358,"_27381":123997,"_2946":124260},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3461":72718,"_30095":72631,"_20902":124262,"_5":14358,"_27381":123997,"_2946":124263},[],"Mover JWKS y roles a `services.authz`",{"_3461":72719,"_30095":72631,"_20902":124265,"_5":14358,"_27381":123997,"_2946":124037},[],{"_3461":72720,"_30095":72631,"_20902":124267,"_5":14358,"_27381":123997,"_2946":124268},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3461":72721,"_30095":72631,"_20902":124270,"_5":14358,"_27381":123997,"_2946":124271},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3461":72722,"_30095":72631,"_20902":124273,"_5":14358,"_27381":123997,"_2946":124274},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3461":72723,"_30095":72631,"_20902":124276,"_5":14358,"_27381":123997,"_2946":124041},[],{"_3461":72724,"_30095":72631,"_20902":124278,"_5":14358,"_27381":123997,"_2946":124279},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3461":72725,"_30095":72631,"_20902":124281,"_5":14358,"_27381":123997,"_2946":124282},[],"Alta: el backend ya no arranca con ellos",{"_3461":72726,"_30095":72631,"_20902":124284,"_5":14358,"_27381":123997,"_2946":124285},[],"Pasar a PostgreSQL antes de actualizar",{"_3461":72727,"_30095":72631,"_20902":124287,"_5":14358,"_27381":123997,"_2946":124085},[],{"_3461":72728,"_30095":72631,"_20902":124289,"_5":14358,"_27381":123997,"_2946":124290},[],"Despliegues que gestionan roles de VA por API, y sus políticas personalizadas y suscripciones de alertas",{"_3461":72729,"_30095":72631,"_20902":124292,"_5":14358,"_27381":123997,"_2946":124293},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3461":72730,"_30095":72631,"_20902":124295,"_5":14358,"_27381":123997,"_2946":124296},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3461":72731,"_30095":72631,"_20902":124298,"_5":14358,"_27381":123997,"_2946":124299},[],"Webhooks con referencias a archivos",{"_3461":72732,"_30095":72631,"_20902":124301,"_5":14358,"_27381":123997,"_2946":124302},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3461":72733,"_30095":72631,"_20902":124304,"_5":14358,"_27381":123997,"_2946":124305},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3461":72734,"_30095":72631,"_20902":124307,"_5":14358,"_27381":123997,"_2946":124308},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3461":72735,"_30095":72631,"_20902":124310,"_5":14358,"_27381":123997,"_2946":124021},[],{"_3461":72736,"_30095":72631,"_20902":124312,"_5":14358,"_27381":123997,"_2946":124313},[],"Releases con identidades por servicio o material de claves montado",{"_3461":72737,"_30095":72631,"_20902":124315,"_5":14358,"_27381":123997,"_2946":124316},[],"Media: los servicios no pueden leer sus archivos",{"_3461":72738,"_30095":72631,"_20902":124318,"_5":14358,"_27381":123997,"_2946":124319},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3461":72739,"_30095":72631,"_20902":124321,"_5":14358,"_27381":123997,"_2946":124025},[],{"_3461":72740,"_30095":72631,"_20902":124323,"_5":14358,"_27381":123997,"_2946":124324},[],"Releases que definen `amqp.tls`",{"_3461":72741,"_30095":72631,"_20902":124326,"_5":14358,"_27381":123997,"_2946":124327},[],"Media: los clientes se conectan al puerto equivocado",{"_3461":72742,"_30095":72631,"_20902":124329,"_5":14358,"_27381":123997,"_2946":124330},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3461":72743,"_30095":72631,"_20902":124332,"_5":14358,"_27381":123997,"_2946":124045},[],{"_3461":72744,"_30095":72631,"_20902":124334,"_5":14358,"_27381":123997,"_2946":124335},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3461":72745,"_30095":72631,"_20902":124337,"_5":14358,"_27381":123997,"_2946":124338},[],"Media: las claves de CA quedan sin gestionar",{"_3461":72746,"_30095":72631,"_20902":124340,"_5":14358,"_27381":123997,"_2946":124341},[],"Ejecutar la migración de CA a KMS",{"_3461":72747,"_30095":72631,"_20902":124343,"_5":14358,"_27381":123997,"_2946":124344},[],"Verificación del certificado del receptor",{"_3461":72748,"_30095":72631,"_20902":124346,"_5":14358,"_27381":123997,"_2946":124347},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3461":72749,"_30095":72631,"_20902":124349,"_5":14358,"_27381":123997,"_2946":124350},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3461":72750,"_30095":72631,"_20902":124352,"_5":14358,"_27381":123997,"_2946":124353},[],"Poner `insecure_skip_verify` a `false`",{"_3461":72751,"_30095":72631,"_20902":124355,"_5":14358,"_27381":123997,"_2946":124061},[],{"_3461":72752,"_30095":72631,"_20902":124357,"_5":14358,"_27381":123997,"_2946":124358},[],"Scripts y consolas que editan DMS por API",{"_3461":72753,"_30095":72631,"_20902":124360,"_5":14358,"_27381":123997,"_2946":124361},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3461":72754,"_30095":72631,"_20902":124363,"_5":14358,"_27381":123997,"_2946":124364},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3461":72755,"_30095":72631,"_20902":124366,"_5":14358,"_27381":123997,"_2946":124081},[],{"_3461":72756,"_30095":72631,"_20902":124368,"_5":14358,"_27381":123997,"_2946":124369},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3461":72757,"_30095":72631,"_20902":124371,"_5":14358,"_27381":123997,"_2946":124372},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3461":72758,"_30095":72631,"_20902":124374,"_5":14358,"_27381":123997,"_2946":124375},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3461":72759,"_30095":72631,"_20902":124377,"_5":14358,"_27381":123997,"_2946":124089},[],{"_3461":72760,"_30095":72631,"_20902":124379,"_5":14358,"_27381":123997,"_2946":124380},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3461":72761,"_30095":72631,"_20902":124382,"_5":14358,"_27381":123997,"_2946":124383},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3461":72762,"_30095":72631,"_20902":124385,"_5":14358,"_27381":123997,"_2946":124386},[],"Revisar las condiciones que filtran por el payload antiguo del evento",{"_3461":72763,"_30095":72631,"_20902":124388,"_5":14358,"_27381":123997,"_2946":124077},[],{"_3461":72764,"_30095":72631,"_20902":124390,"_5":14358,"_27381":123997,"_2946":124391},[],"Consumidores que leen el campo `events` del dispositivo",{"_3461":72765,"_30095":72631,"_20902":124393,"_5":14358,"_27381":123997,"_2946":124394},[],"Media: el campo desaparece",{"_3461":72766,"_30095":72631,"_20902":124396,"_5":14358,"_27381":123997,"_2946":124397},[],"Usar los nuevos endpoints de eventos",{"_3461":72767,"_30095":72631,"_20902":124399,"_5":14358,"_27381":123997,"_2946":124097},[],{"_3461":72768,"_30095":72631,"_20902":124401,"_5":14358,"_27381":123997,"_2946":124402},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3461":72769,"_30095":72631,"_20902":124404,"_5":14358,"_27381":123997,"_2946":124405},[],"Media: la migración de la VA aborta",{"_3461":72770,"_30095":72631,"_20902":124407,"_5":14358,"_27381":123997,"_2946":124408},[],"Corregir los roles afectados antes de actualizar",{"_3461":72771,"_30095":72631,"_20902":124410,"_5":14358,"_27381":123997,"_2946":124029},[],{"_3461":72772,"_30095":72631,"_20902":124412,"_5":14358,"_27381":123997,"_2946":124413},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3461":72773,"_30095":72631,"_20902":124415,"_5":14358,"_27381":123997,"_2946":124416},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3461":72774,"_30095":72631,"_20902":124418,"_5":14358,"_27381":123997,"_2946":124419},[],"Actualizar el archivo de values",{"_3461":72775,"_30095":72631,"_20902":124421,"_5":14358,"_27381":123997,"_2946":124069},[],{"_3461":72776,"_30095":72631,"_20902":124423,"_5":14358,"_27381":123997,"_2946":124424},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3461":72777,"_30095":72631,"_20902":124426,"_5":14358,"_27381":123997,"_2946":124427},[],"Baja: prevalece el ID de la URL",{"_3461":72778,"_30095":72631,"_20902":124429,"_5":14358,"_27381":123997,"_2946":124430},[],"Enviar el ID en la URL",{"_3461":72779,"_30095":72631,"_20902":124432,"_5":14358,"_27381":123997,"_2946":124093},[],{"_3461":72780,"_30095":72631,"_20902":124434,"_5":14358,"_27381":123997,"_2946":124435},[],"Clientes que envían un `id` al crear o importar CAs",{"_3461":72781,"_30095":72631,"_20902":124437,"_5":14358,"_27381":123997,"_2946":124438},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3461":72782,"_30095":72631,"_20902":124440,"_5":14358,"_27381":123997,"_2946":124441},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3461":72783,"_30095":72631,"_20902":124443,"_5":14358,"_27381":123997,"_2946":124073},[],{"_3461":72784,"_30095":72631,"_20902":124445,"_5":14358,"_27381":123997,"_2946":124446},[],"Consumidores que comparan el `type` del certificado",{"_3461":72785,"_30095":72631,"_20902":124448,"_5":14358,"_27381":123997,"_2946":124449},[],"Baja: dos valores cambian de nombre",{"_3461":72786,"_30095":72631,"_20902":124451,"_5":14358,"_27381":123997,"_2946":124452},[],"Adaptar los consumidores",{"_3461":72787,"_30095":72631,"_20902":124454,"_5":14358,"_27381":123997,"_2946":124065},[],{"_3461":72788,"_30095":72631,"_20902":124456,"_5":14358,"_27381":123997,"_2946":124457},[],"Cualquier DMS",{"_3461":72789,"_30095":72631,"_20902":124459,"_5":14358,"_27381":123997,"_2946":124460},[],"Baja: solo informativo",{"_3461":72790,"_30095":72631,"_20902":124462,"_5":14358,"_27381":123997,"_2946":124463},[],"Revisar ambos bloques antes de editar",{"_3461":72791,"_30095":72631,"_20902":124465,"_5":14358,"_27381":124004,"_2946":124466},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3461":72792,"_30095":72631,"_20902":124468,"_5":14358,"_27381":124004,"_2946":124469},[],"El paso 4 de la guía de migración copia los datos.",{"_3461":72793,"_30095":72631,"_20902":124471,"_5":14358,"_27381":124008,"_2946":124472},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3461":72794,"_30095":72631,"_20902":124474,"_5":14358,"_27381":124012,"_2946":124475},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3461":72795,"_30095":72631,"_20902":124477,"_5":14358,"_27381":124016,"_2946":124478},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3461":72796,"_30095":72631,"_20902":124480,"_5":14358,"_27381":124020,"_2946":124481},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3461":72797,"_30095":72631,"_20902":124483,"_5":14358,"_27381":124020,"_2946":124484},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3461":72798,"_30095":72631,"_20902":124486,"_5":14358,"_27381":124024,"_2946":124487},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3461":72799,"_30095":72631,"_20902":124489,"_5":14358,"_27381":124028,"_2946":124490},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3461":72800,"_30095":72631,"_20902":124492,"_5":14358,"_27381":124028,"_2946":124493},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3461":72801,"_30095":72631,"_20902":124495,"_5":14358,"_27381":124028,"_2946":124496},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3461":72802,"_30095":72631,"_20902":124498,"_5":14358,"_27381":124028,"_2946":124499},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3461":72803,"_30095":72631,"_20902":124501,"_5":14358,"_27381":124028,"_2946":124502},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3461":72804,"_30095":72631,"_20902":124504,"_5":14358,"_27381":124028,"_2946":124505},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3461":72805,"_30095":72631,"_20902":124507,"_5":14358,"_27381":124036,"_2946":124508},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3461":72806,"_30095":72631,"_20902":124510,"_5":14358,"_27381":124036,"_2946":124511},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3461":72807,"_30095":72631,"_20902":124513,"_5":14358,"_27381":124036,"_2946":124514},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3461":72808,"_30095":72631,"_20902":124516,"_5":14358,"_27381":124036,"_2946":124517},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3461":72809,"_30095":72631,"_20902":124519,"_5":14358,"_27381":124036,"_2946":124520},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3461":72810,"_30095":72631,"_20902":124522,"_5":14358,"_27381":124040,"_2946":124523},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3461":72811,"_30095":72631,"_20902":124525,"_5":14358,"_27381":124044,"_2946":124526},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3461":72812,"_30095":72631,"_20902":124528,"_5":14358,"_27381":124044,"_2946":124529},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3461":72813,"_30095":72631,"_20902":124531,"_5":14358,"_27381":124044,"_2946":124532},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3461":72814,"_30095":72631,"_20902":124534,"_5":14358,"_27381":124044,"_2946":124535},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3461":72815,"_30095":72631,"_20902":124537,"_5":14358,"_27381":124044,"_2946":124538},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3461":72816,"_30095":72631,"_20902":124540,"_5":14358,"_27381":124044,"_2946":124541},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3461":72817,"_30095":72631,"_20902":124543,"_5":14358,"_27381":124044,"_2946":124544},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3461":72818,"_30095":72631,"_20902":124546,"_5":14358,"_27381":124044,"_2946":124547},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3461":72819,"_30095":72631,"_20902":124549,"_5":14358,"_27381":124048,"_2946":124550},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3461":72820,"_30095":72631,"_20902":124552,"_5":14358,"_27381":124056,"_2946":124553},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3461":72821,"_30095":72631,"_20902":124555,"_5":14358,"_27381":124056,"_2946":124556},[],"Campo en 3.8.0",{"_3461":72822,"_30095":72631,"_20902":124558,"_5":14358,"_27381":124056,"_2946":124559},[],"Campo en 4.0.0",{"_3461":72823,"_30095":72631,"_20902":124561,"_5":14358,"_27381":124056,"_2946":57914},[],{"_3461":72824,"_30095":72631,"_20902":124563,"_5":14358,"_27381":124056,"_2946":124564},[],"`insecure_skip_verify` (con el valor negado)",{"_3461":72825,"_30095":72631,"_20902":124566,"_5":14358,"_27381":124056,"_2946":57920},[],{"_3461":72826,"_30095":72631,"_20902":124568,"_5":14358,"_27381":124056,"_2946":57923},[],{"_3461":72827,"_30095":72631,"_20902":124570,"_5":14358,"_27381":124056,"_2946":57926},[],{"_3461":72828,"_30095":72631,"_20902":124572,"_5":14358,"_27381":124056,"_2946":57929},[],{"_3461":72829,"_30095":72631,"_20902":124574,"_5":14358,"_27381":124056,"_2946":57932},[],{"_3461":72830,"_30095":72631,"_20902":124576,"_5":14358,"_27381":124056,"_2946":57935},[],{"_3461":72831,"_30095":72631,"_20902":124578,"_5":14358,"_27381":124056,"_2946":124579},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3461":72832,"_30095":72631,"_20902":124581,"_5":14358,"_27381":124056,"_2946":124582},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3461":72833,"_30095":72631,"_20902":124584,"_5":14358,"_27381":124056,"_2946":124585},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3461":72834,"_30095":72631,"_20902":124587,"_5":14358,"_27381":124060,"_2946":124588},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3461":72835,"_30095":72631,"_20902":124590,"_5":14358,"_27381":124060,"_2946":124591},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3461":72836,"_30095":72631,"_20902":124593,"_5":14358,"_27381":124060,"_2946":124594},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3461":72837,"_30095":72631,"_20902":124596,"_5":14358,"_27381":124064,"_2946":124597},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3461":72838,"_30095":72631,"_20902":124599,"_5":14358,"_27381":124068,"_2946":124600},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3461":72839,"_30095":72631,"_20902":124602,"_5":14358,"_27381":124072,"_2946":124603},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3461":72840,"_30095":72631,"_20902":124605,"_5":14358,"_27381":124076,"_2946":124606},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3461":72841,"_30095":72631,"_20902":124608,"_5":14358,"_27381":124076,"_2946":124609},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3461":72842,"_30095":72631,"_20902":124611,"_5":14358,"_27381":124076,"_2946":124612},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3461":72843,"_30095":72631,"_20902":124614,"_5":14358,"_27381":124076,"_2946":124615},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3461":72844,"_30095":72631,"_20902":124617,"_5":14358,"_27381":124080,"_2946":124618},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3461":72845,"_30095":72631,"_20902":124620,"_5":14358,"_27381":124084,"_2946":124621},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3461":72846,"_30095":72631,"_20902":124623,"_5":14358,"_27381":124084,"_2946":124624},[],"Ruta",{"_3461":72847,"_30095":72631,"_20902":124626,"_5":14358,"_27381":124084,"_2946":117187},[],{"_3461":72848,"_30095":72631,"_20902":124628,"_5":14358,"_27381":124084,"_2946":57988},[],{"_3461":72849,"_30095":72631,"_20902":124630,"_5":14358,"_27381":124084,"_2946":124631},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3461":72850,"_30095":72631,"_20902":124633,"_5":14358,"_27381":124084,"_2946":57994},[],{"_3461":72851,"_30095":72631,"_20902":124635,"_5":14358,"_27381":124084,"_2946":124636},[],"Lee los ajustes de una CA.",{"_3461":72852,"_30095":72631,"_20902":124638,"_5":14358,"_27381":124084,"_2946":58000},[],{"_3461":72853,"_30095":72631,"_20902":124640,"_5":14358,"_27381":124084,"_2946":124641},[],"Sustituye los `crl_options`.",{"_3461":72854,"_30095":72631,"_20902":124643,"_5":14358,"_27381":124084,"_2946":124644},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3461":72855,"_30095":72631,"_20902":124646,"_5":14358,"_27381":124084,"_2946":124647},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El monitor republica cada CRL migrada bajo el ID de CA en su primera ejecución, y la lista nueva incluye ambas URLs en su *Issuing Distribution Point*.",{"_3461":72856,"_30095":72631,"_20902":124649,"_5":14358,"_27381":124084,"_2946":124650},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3461":72857,"_30095":72631,"_20902":124652,"_5":14358,"_27381":124084,"_2946":124653},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3461":72858,"_30095":72631,"_20902":124655,"_5":14358,"_27381":124084,"_2946":124656},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3461":72859,"_30095":72631,"_20902":124658,"_5":14358,"_27381":124084,"_2946":124659},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3461":72860,"_30095":72631,"_20902":124661,"_5":14358,"_27381":124084,"_2946":124662},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3461":72861,"_30095":72631,"_20902":124664,"_5":14358,"_27381":124084,"_2946":124665},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3461":72862,"_30095":72631,"_20902":124667,"_5":14358,"_27381":124084,"_2946":124668},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3461":72863,"_30095":72631,"_20902":124670,"_5":14358,"_27381":124084,"_2946":124671},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3461":72864,"_30095":72631,"_20902":124673,"_5":14358,"_27381":124084,"_2946":124674},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3461":72865,"_30095":72631,"_20902":124676,"_5":14358,"_27381":124088,"_2946":124677},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa cada condición que filtre por un campo del payload antiguo. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3461":72866,"_30095":72631,"_20902":124679,"_5":14358,"_27381":124092,"_2946":124680},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3461":72867,"_30095":72631,"_20902":124682,"_5":14358,"_27381":124096,"_2946":124683},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3461":72868,"_30095":72631,"_20902":124685,"_5":14358,"_27381":124100,"_2946":124686},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3461":72869,"_30095":72631,"_20902":124688,"_5":14358,"_27381":124104,"_2946":124689},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3461":72870,"_30095":72631,"_20902":124691,"_5":14358,"_27381":124104,"_2946":124692},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3461":72871,"_30095":72631,"_20902":124694,"_5":14358,"_27381":124104,"_2946":124695},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3461":72872,"_30095":72631,"_20902":124697,"_5":14358,"_27381":124104,"_2946":124698},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3461":72873,"_30095":72631,"_20902":124700,"_5":14358,"_27381":124104,"_2946":124701},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3461":72874,"_30095":72631,"_20902":124703,"_5":14358,"_27381":124104,"_2946":124704},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3461":72875,"_30095":72631,"_20902":124706,"_5":14358,"_27381":124108,"_2946":124707},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3461":72876,"_30095":72631,"_20902":124709,"_5":14358,"_27381":124108,"_2946":124710},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3461":72877,"_30095":72631,"_20902":124712,"_5":14358,"_27381":124108,"_2946":124713},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3461":72878,"_30095":72631,"_20902":124715,"_5":14358,"_27381":124108,"_2946":124716},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3461":72879,"_30095":72631,"_20902":124718,"_5":14358,"_27381":124108,"_2946":124719},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3461":72880,"_30095":72631,"_20902":124721,"_5":14358,"_27381":124112,"_2946":124722},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3461":72881,"_30095":72631,"_20902":124724,"_5":14358,"_27381":124112,"_2946":124725},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3461":72882,"_30095":72631,"_20902":124727,"_5":14358,"_27381":124112,"_2946":124728},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3461":72883,"_30095":72631,"_20902":124730,"_5":14358,"_27381":124112,"_2946":124731},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3461":72884,"_30095":72631,"_20902":124733,"_5":14358,"_27381":124112,"_2946":124734},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3461":72885,"_30095":72631,"_20902":124736,"_5":14358,"_27381":124112,"_2946":124737},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3461":72886,"_30095":72631,"_20902":124739,"_5":14358,"_27381":124112,"_2946":124740},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3461":72887,"_30095":72631,"_20902":124742,"_5":14358,"_27381":124112,"_2946":124743},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3461":72888,"_30095":72631,"_20902":124745,"_5":14358,"_27381":124112,"_2946":124746},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3461":72889,"_30095":72631,"_20902":124748,"_5":14358,"_27381":124112,"_2946":124749},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3461":72890,"_30095":72631,"_20902":124751,"_5":14358,"_27381":124112,"_2946":124752},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3461":72891,"_30095":72631,"_20902":124754,"_5":14358,"_27381":124112,"_2946":124755},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3461":72892,"_30095":72631,"_20902":124757,"_5":14358,"_27381":124116,"_2946":124758},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3461":72893,"_30095":72631,"_20902":124760,"_5":14358,"_27381":124116,"_2946":124761},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3461":72894,"_30095":72631,"_20902":124763,"_5":14358,"_27381":124120,"_2946":124764},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3461":72895,"_30095":72631,"_20902":124766,"_5":14358,"_27381":124120,"_2946":124767},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3461":72896,"_30095":72631,"_20902":124769,"_5":14358,"_27381":124120,"_2946":124770},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3461":72897,"_30095":72631,"_20902":124772,"_5":14358,"_27381":124120,"_2946":124773},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3461":72898,"_30095":72631,"_20902":124775,"_5":14358,"_27381":124120,"_2946":124776},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3461":72899,"_30095":72631,"_20902":124778,"_5":14358,"_27381":124120,"_2946":124779},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3461":72900,"_30095":72631,"_20902":124781,"_5":14358,"_27381":124120,"_2946":124782},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3461":72901,"_30095":72631,"_20902":124784,"_5":14358,"_27381":124120,"_2946":124785},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3461":72902,"_30095":72631,"_20902":124787,"_5":14358,"_27381":124120,"_2946":124788},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3461":72903,"_30095":72631,"_20902":124790,"_5":14358,"_27381":124120,"_2946":124791},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3461":72904,"_30095":72631,"_20902":124793,"_5":14358,"_27381":124120,"_2946":124794},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3461":72905,"_30095":72631,"_20902":124796,"_5":14358,"_27381":124124,"_2946":124797},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3461":72906,"_30095":72631,"_20902":124799,"_5":14358,"_27381":124124,"_2946":124800},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3461":72907,"_30095":72631,"_20902":124802,"_5":14358,"_27381":124128,"_2946":124803},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3461":72908,"_30095":72631,"_20902":124805,"_5":14358,"_27381":124128,"_2946":124806},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3461":72909,"_30095":72631,"_20902":124808,"_5":14358,"_27381":124128,"_2946":124809},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3461":72910,"_30095":72631,"_20902":124811,"_5":14358,"_27381":124128,"_2946":124812},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3461":72911,"_30095":72631,"_20902":124814,"_5":14358,"_27381":124128,"_2946":124815},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3461":72912,"_30095":72631,"_20902":124817,"_5":14358,"_27381":124128,"_2946":124818},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3461":72913,"_30095":72631,"_20902":124820,"_5":14358,"_27381":124128,"_2946":124821},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3461":72914,"_30095":72631,"_20902":124823,"_5":14358,"_27381":124128,"_2946":124824},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3461":72915,"_30095":72631,"_20902":124826,"_5":14358,"_27381":124132,"_2946":124827},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3461":72916,"_30095":72631,"_20902":124829,"_5":14358,"_27381":124132,"_2946":124830},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3461":72917,"_30095":72631,"_20902":124832,"_5":14358,"_27381":124132,"_2946":124833},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3461":72918,"_30095":72631,"_20902":124835,"_5":14358,"_27381":124132,"_2946":124836},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3461":72919,"_30095":72631,"_20902":124838,"_5":14358,"_27381":124132,"_2946":124839},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por varios roles de VA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3461":72920,"_30095":72631,"_20902":124841,"_5":14358,"_27381":124132,"_2946":124842},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3461":72921,"_30095":72631,"_20902":124844,"_5":14358,"_27381":124132,"_2946":124845},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3461":72922,"_30095":72631,"_20902":124847,"_5":14358,"_27381":124132,"_2946":124848},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3461":72923,"_30095":72631,"_20902":124850,"_5":14358,"_27381":124132,"_2946":124851},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3461":72924,"_30095":72631,"_20902":124853,"_5":14358,"_27381":124132,"_2946":124854},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3461":72925,"_30095":72631,"_20902":124856,"_5":14358,"_27381":124132,"_2946":124857},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3461":72926,"_30095":72631,"_20902":124859,"_5":14358,"_27381":124135,"_2946":124860},[],"Tras la actualización, comprueba en este orden:",{"_3461":72927,"_30095":72631,"_20902":124862,"_5":14358,"_27381":124135,"_2946":124863},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3461":72928,"_30095":72631,"_20902":124865,"_5":14358,"_27381":124135,"_2946":124866},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3461":72929,"_30095":72631,"_20902":124868,"_5":14358,"_27381":124135,"_2946":124869},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3461":72930,"_30095":72631,"_20902":124871,"_5":14358,"_27381":124135,"_2946":124872},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El monitor republica cada CRL bajo el ID de CA en su primera ejecución, y se emiten CRLs nuevas.",{"_3461":72931,"_30095":72631,"_20902":124874,"_5":14358,"_27381":124135,"_2946":124875},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y sus condiciones se han revisado contra el payload nuevo (`ca_id` en lugar de `ca_ski`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3461":72932,"_30095":72631,"_20902":124877,"_5":14358,"_27381":124135,"_2946":124878},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3461":72933,"_30095":72631,"_20902":124880,"_5":14358,"_27381":124135,"_2946":124881},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3461":72934,"_30095":72631,"_20902":124883,"_5":14358,"_27381":124135,"_2946":124884},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3461":72935,"_30095":72631,"_20902":124886,"_5":14358,"_27381":124135,"_2946":124887},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3461":72936,"_30095":72631,"_20902":124889,"_5":14358,"_27381":124135,"_2946":124890},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3461":72937,"_30095":72631,"_20902":124892,"_5":14358,"_27381":124135,"_2946":124893},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3461":72938,"_30095":72631,"_20902":124895,"_5":14358,"_27381":124135,"_2946":124896},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3461":72939,"_30095":72631,"_20902":124898,"_5":14358,"_27381":124135,"_2946":124899},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3461":72940,"_30095":72631,"_20902":124901,"_5":14358,"_27381":124135,"_2946":124902},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3461":72941,"_30095":72631,"_20902":124904,"_5":14358,"_27381":124135,"_2946":124905},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3461":72942,"_30095":72631,"_20902":124907,"_5":14358,"_27381":124139,"_2946":124908},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3461":72943,"_30095":72631,"_20902":124910,"_5":14358,"_27381":124139,"_2946":124911},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3461":72944,"_30095":72631,"_20902":124913,"_5":14358,"_27381":124139,"_2946":124914},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3461":72945,"_30095":72631,"_20902":124916,"_5":14358,"_27381":124139,"_2946":124917},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3461":72946,"_30095":72631,"_20902":124919,"_5":14358,"_27381":124139,"_2946":124920},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58285":124922,"_58287":124923,"_58289":124924,"_58291":124925,"_18119":2981,"_70014":2981},"spanish",[2946,30095,5,27381],{"_2946":24962,"_30095":24962,"_5":24962,"_27381":24962},{"_2946":124926,"_30095":127855,"_5":130784,"_27381":133713},{"_4634":124927,"_58295":124928,"_5":24962},{"_14434":7558,"_14815":7276,"_14834":5953,"_29098":3649,"_14821":6536,"_19834":6168,"_14455":3159,"_14462":4071,"_29040":3038,"_29449":4379,"_29470":6356,"_29074":7013,"_34443":12248,"_29177":20314,"_29514":9844,"_34450":22810,"_34453":5805,"_34456":14401,"_34459":18133,"_29921":14315,"_34464":9364,"_34466":