ets/enrollment/est-reference.mdx","Referencia EST","Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.","/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/est-reference",{"_73":294},"platform/iot-fleets/enrollment/est-reference.mdx",{"_48":296,"_55":66,"_50":297,"_60":298,"_69":-7,"_12":299,"_71":300},"es:platform/iot-fleets/enrollment/troubleshooting.mdx","Diagnóstico de enrolamiento","Localiza fallos de transporte, autenticación, registro, emisión e instalación.","/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/troubleshooting",{"_73":301},"platform/iot-fleets/enrollment/troubleshooting.mdx","es:platform/iot-fleets/enrollment",{"_205":304},"platform/iot-fleets/enrollment/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network shrink-0\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg>",{"_48":307,"_55":66,"_50":244,"_60":308,"_69":-7,"_12":309,"_71":310},"es:platform/iot-fleets/enrollment/overview.mdx","Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.","/docs/pr-preview/pr-60/es/platform/iot-fleets/enrollment/overview",{"_73":311},"platform/iot-fleets/enrollment/overview.mdx",{"_55":56,"_50":313,"_57":-7,"_59":-7,"_60":-7,"_62":-7,"_52":314,"_48":322,"_71":323,"_69":325},"Integraciones",[315],{"_48":316,"_55":66,"_50":317,"_60":318,"_69":-7,"_12":319,"_71":320},"es:platform/iot-fleets/integrations/aws-iot-core.mdx","AWS IoT Core","El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el re