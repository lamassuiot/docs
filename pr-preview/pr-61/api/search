nfiguration:"},"1599":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-19","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Setting"},"1600":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-20","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Evaluation value"},"1601":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-21","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Enrollment CA"},"1602":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-22","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Issuing root from `device-root.pem`."},"1603":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-23","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Issuance profile"},"1604":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-24","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"The 1-hour leaf profile you 