ickstarts/enroll-device-36","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado."},"1616":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-37","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Re-enrollment Delta"},"1617":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-38","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"1 hora."},"1618":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-39","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Preventive / Critical Delta"},"1619":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-40","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"30 minutos / 10 minutos."},"1620":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-41","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Revoke on Re-enrollment"},"1621":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-42","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Deshabilitado para probar el sucesor antes de retirar el anterior."},"1622":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-43","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"ServerKeyGen"},"1623":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-44","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Deshabilitado; la clave operativa se genera en el cliente."},"1624":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-45","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"CA Distribution"},"1625":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-46","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado."},"1626":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-47","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS."},"1627":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-48","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","content":"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:"},"1628":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-49","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","content":"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir."},"1629":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-50","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"El recorrido muestra el enrolamiento completo desde ambos lados: el dashboard de Lamassu a la izquierda, donde se revisa el DMS y se localiza el dispositivo nuevo, y la terminal del dispositivo a la derecha, donde se crean la clave y la CSR y se envía la petición EST. Se ejecuta en un entorno desechable con datos sintéticos, un DMS llamado `est-showcase` y un dispositivo llamado `sensor-0421`."},"1630":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-51","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"El DMS de la demo tiene la autenticación inicial desactivada y se accede a él por HTTP, así que sus comandos `curl` no llevan `--cert` ni `--key`. No copies esa configuración: los comandos siguientes usan la credencial de bootstrap y HTTPS, tal como los preparó este quickstart."},"1631":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-52","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Genera una clave nueva y una CSR con el identificador elegido:"},"1632":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-53","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:"},"1633":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-54","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida."},"1634":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-55","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","content":"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora."},"1635":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-56","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","content":"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active."},"1636":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-57","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:"},"1637":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-58","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:"},"1638":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-59","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL."},"1639":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-60","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:"},"1640":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-61","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server."},"1641":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-62","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Comprobación"},"1642":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-63","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Resultado esperado"},"1643":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-64","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Registro"},"1644":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-65","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"ID creado automáticamente y DMS correcto."},"1645":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-66","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Certificado"},"1646":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-67","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"CN, perfil, serie y clave verificados."},"1647":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-68","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Inventario"},"1648":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-69","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Serie recibida visible como identidad actual y en el historial."},"1649":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-70","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Consumidor"},"1650":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-71","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"mTLS responde 200 con la identidad y rechaza falta de certificado."},"1651":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-72","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente."},"1652":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device-73","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible."},"1653":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device","type":"page","content":"Registra un dispositivo manualmente","breadcrumbs":["Docs","Plataforma","IoT Fleets","Primeros pasos"],"tags":[],"url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device"},"1654":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device-0","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device","content":"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad."},"1655":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device-1","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Antes de empezar"},"1656":{"id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device-2","page_id":"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device","type":"headi