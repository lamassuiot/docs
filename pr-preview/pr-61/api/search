starts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled."},"1617":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-37","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Re-enrollment Delta"},"1618":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-38","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"1 hour."},"1619":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-39","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Preventive / Critical Delta"},"1620":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-40","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"30 minutes / 10 minutes."},"1621":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-41","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Revoke on Re-enrollment"},"1622":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enr