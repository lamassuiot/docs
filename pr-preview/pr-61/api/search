t/self-hosted/overview-14","page_id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-an-installation-workflow","content":"Fastlane"},"352":{"id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview-15","page_id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-an-installation-workflow","content":"Evaluation, demos, CI and small lab clusters"},"353":{"id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview-16","page_id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-an-installation-workflow","content":"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu"},"354":{"id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview-17","page_id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist."},"355":{"id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview-18","page_id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Area"},"356":{"id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview-19","page_id":"/docs/pr-preview/pr-61/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The Lamassu chart provides"},"357":{"id":"/docs/pr-preview/pr-61/deployment/self-host