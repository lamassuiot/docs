enrollment-settings","content":"Enrollment Settings"},"879":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-11","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Authentication per operation"},"880":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-12","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"External webhook settings"},"881":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-13","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#issuance-profile","content":"Issuance profile"},"882":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-14","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Re-enrollment configuration"},"883":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-15","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#serverkeygen","content":"ServerKeyGen"},"884":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-16","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Trust distribution"},"885":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-17","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"Operate the DMS inventory"},"886":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-18","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Integrate the devices"},"887":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-19","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","content":"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator."},"888":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-20","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#before-you-begin","content":"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement."},"889":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-21","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#before-you-begin","content":"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication."},"890":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-22","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-a-dms","content":"Follow the interactive walkthrough to configure a DMS for EST. The example sets **Name** to `DMS Showcase`, which derives the `dms-showcase` identifier used in the EST URLs, and selects two CAs prepared in advance: **DMS Enrollment CA** signs the device identities and **DMS Bootstrap CA** validates the initial credential. The values are for this example; use names and CAs appropriate for your fleet."},"891":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-23","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#identify-the-fleet","content":"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS."},"892":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-24","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","content":"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity."},"893":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-25","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-est","content":"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key."},"894":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-26","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#distribute-trust","content":"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation."},"895":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-27","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#verify-the-endpoints","content":"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance."},"896":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-28","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration."},"897":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-29","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode."},"898":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-30","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`settings.enrollment_settings` field"},"899":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-31","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Decision"},"900":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-32","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`protocol`"},"901":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-33","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`EST_RFC7030` for these operations."},"902":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-34","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enrollment_ca`"},"903":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-35","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"ID of the signing CA."},"904":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-36","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`verify_csr_signature`"},"905":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-37","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Keep `true` to verify CSR key possession."},"906":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-38","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enable_replaceable_enrollment`"},"907":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-39","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic."},"908":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-40","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`est_rfc7030_settings.auth_mode`"},"909":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-41","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"One of the four authentication modes."},"910":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-42","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes."},"911":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-43","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"The blocks are independent:"},"912":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-44","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`."},"913":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-45","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`."},"914":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-46","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`auth_mode`"},"915":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-47","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Control applied in the configured operation"},"916":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-48","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE`"},"917":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-49","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Presented certificate validation."},"918":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-50","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`EXTERNAL_WEBHOOK`"},"919":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-51","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Configured webhook authorization."},"920":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-52","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"921":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-53","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Certificate validation followed by webhook approval."},"922":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-54","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`NO_AUTH`"},"923":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-55","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"No DMS requester authentication."},"924":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-56","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails."},"925":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-57","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path."},"926":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-58","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`."},"927":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-59","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID."},"928":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-60","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:"},"929":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-61","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`external_webhook_settings` field"},"930":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-62","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Decision"},"931":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-63","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`url`"},"932":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-64","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed."},"933":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-65","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`method`"},"934":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-66","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`POST` or `PUT`; `POST` by default."},"935":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-67","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`name`"},"936":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-68","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Label used in service logs."},"937":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-69","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.auth_mode`"},"938":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-70","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`."},"939":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-71","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.log_level`"},"940":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-72","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default."},"941":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-73","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.apikey_options`"},"942":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-74","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `apikey`: `header` and `key`. Reserved header names are rejected."},"943":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-75","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.jwt_options`"},"944":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-76","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`."},"945":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-77","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.mtls_options`"},"946":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-78","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted."},"947":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-79","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.insecure_skip_verify`"},"948":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-80","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here."},"949":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-81","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.call_timeout`"},"950":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-82","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Maximum duration of the authorization call (for example `10s`); 10 seconds by default."},"951":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-83","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Rules for that configuration:"},"952":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-84","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM."},"953":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-85","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected."},"954":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-86","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`."},"955":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-87","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped."},"956":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-88","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The authorization response must be JSON of at most 1 MiB; a larger body fails the call."},"957":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-89","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises."},"958":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-90","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it)."},"959":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-91","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist."},"960":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-92","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`."},"961":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-93","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#issuance-profile","content":"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust."},"962":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-94","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`settings.reenrollment_settings` field"},"963":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-95","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Purpose"},"964":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-96","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`reenrollment_delta`"},"965":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-97","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Opens the window at the active certificate’s `NotAfter` minus this delta."},"966":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-98","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`preventive_delta`"},"967":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-99","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Preventive operational monitoring threshold."},"968":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-100","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`critical_delta`"},"969":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-101","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Critical operational monitoring threshold."},"970":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-102","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`enable_expired_renewal`"},"971":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-103","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself."},"972":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-104","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`est_rfc7030_settings.client_certificate_settings.validation_cas`"},"973":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-105","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew."},"974":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-106","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`revoke_on_reenrollment`"},"975":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-107","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor."},"976":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-108","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures."},"977":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-109","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#serverkeygen","content":"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference."},"978":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-110","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Option"},"979":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-111","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Published material"},"980":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-112","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Lamassu System CA**"},"981":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-113","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Available downstream TLS certificate; it can be a leaf, not an issuing CA."},"982":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-114","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Enrollment CA**"},"983":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-115","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Selected issuing CA certificate."},"984":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-116","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Managed CAs**"},"985":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-117","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Explicitly selected CA certificates."},"986":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-118","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","content":"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust."},"987":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-119","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events."},"988":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-120","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs."},"989":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-121","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement."},"990":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms-122","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures."},"991":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","type":"page","content":"Integrate the EST client","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client"},"992":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-0","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","content":"Prepare trust, send a CSR and check the identity you receive."},"993":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-1","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Before you begin"},"994":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-2","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Download and inspect cacerts"},"995":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-3","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"Prepare the CSR"},"996":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-4","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Request the identity"},"997":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-5","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Check and install the result"},"998":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-6","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#next-steps","content":"Next steps"},"999":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-7","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","content":"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device."},"1000":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-8","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools."},"1001":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-9","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity."},"1002":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-10","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name."},"1003":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-11","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file."},"1004":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-12","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works."},"1005":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-13","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject."},"1006":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-14","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles."},"1007":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-15","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:"},"1008":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-16","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance."},"1009":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-17","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"For a root that issues directly:"},"1010":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-18","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation."},"1011":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-19","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete."},"1012":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client-20","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#next-steps","content":"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures."},"1013":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","type":"page","content":"EST reference","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference"},"1014":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-0","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","content":"Look up Lamassu routes, formats, authentication and multipart responses."},"1015":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-1","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Endpoint reference"},"1016":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-2","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#cacerts","content":"cacerts"},"1017":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-3","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"simpleenroll"},"1018":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-4","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"simplereenroll"},"1019":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-5","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"serverkeygen"},"1020":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-6","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","content":"Response format"},"1021":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-7","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Request and extraction"},"1022":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-8","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Compatibility notes"},"1023":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-9","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","content":"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy."},"1024":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-10","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route."},"1025":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-11","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Operation"},"1026":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-12","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Method"},"1027":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-13","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Authentication and condition"},"1028":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-14","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/cacerts`"},"1029":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-15","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"GET"},"1030":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-16","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply."},"1031":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-17","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simpleenroll`"},"1032":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-18","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"1033":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-19","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and DMS registration/replacement policy."},"1034":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-20","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simplereenroll`"},"1035":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-21","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"1036":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-22","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Renewal authentication, existing identity, subject, revocation and window."},"1037":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-23","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/serverkeygen`"},"1038":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-24","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"1039":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-25","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and admission; server generation enabled."},"1040":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-26","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract."},"1041":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-27","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#cacerts","content":"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor."},"1042":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-28","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#cacerts","content":"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots."},"1043":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-29","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy."},"1044":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-30","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR."},"1045":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-31","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate."},"1046":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-32","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery."},"1047":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-33","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM."},"1048":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-34","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement."},"1049":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-35","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","content":"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:"},"1050":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-36","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","content":"Part"},"1051":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-37","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","content":"Content after decoding its Base64"},"1052":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-38","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs8`"},"1053":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-39","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","content":"Unencrypted DER PKCS#8 private key."},"1054":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-40","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs7-mime; smime-type=certs-only`"},"1055":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-41","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","content":"DER PKCS#7 containing the issued certificate."},"1056":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-42","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","content":"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers."},"1057":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-43","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key."},"1058":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-44","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:"},"1059":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-45","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Convert and check the result:"},"1060":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-46","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser."},"1061":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-47","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting."},"1062":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference-48","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client."},"1063":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","type":"page","content":"Enrollment with PKI","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview"},"1064":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-0","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","content":"Choose admission policy and connect DMS, initial trust and the EST client."},"1065":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-1","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","content":"The journey"},"1066":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-2","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"For the administrator"},"1067":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-3","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"For the integrator"},"1068":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-4","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#contract-version","content":"Contract version"},"1069":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-5","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","content":"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer."},"1070":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-6","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","content":"The administrator prepares the CA, issuance profile and DMS."},"1071":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-7","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","content":"The integrator installs initial EST server trust and an admission credential."},"1072":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-8","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","content":"The client requests an identity for its `Device ID` through EST."},"1073":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-9","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","content":"Certificate, device binding and key/certificate installation are checked."},"1074":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-10","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","content":"The consumer validates and authorizes the identity; the client schedules renewal and recovery."},"1075":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-11","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","content":"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test."},"1076":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-12","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />"},"1077":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-13","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1078":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-14","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />"},"1079":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-15","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />"},"1080":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-16","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1081":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-17","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"1082":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview-18","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"