nroll-device#enroll-the-device","content":"Enroll the device"},"1586":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-6","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","content":"Verify the obtained identity"},"1587":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-7","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","content":"Demonstrate an mTLS connection"},"1588":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-8","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","content":"Result and continuity"},"1589":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-9","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","content":"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs."},"1590":{"id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device-10","page_id":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#before-you-begin","content":"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates."}