":124917,"_40233":124920,"_40235":124923,"_40238":124926,"_40240":124929,"_40242":124932,"_40244":124935,"_40246":124938,"_40248":124941,"_40250":124944,"_40252":124947,"_40254":124950,"_40256":124953,"_40258":124956,"_40260":124959,"_40262":124962,"_40264":124965,"_40266":124968,"_40268":124971,"_40270":124974,"_40272":124977,"_40274":124980,"_40276":124983,"_40279":124986,"_40281":124989,"_40283":124992,"_40285":124995,"_40287":124998,"_40289":125001,"_40291":125004,"_40293":125007,"_40295":125010,"_40297":125013,"_40299":125016,"_40301":125019,"_40303":125022,"_40305":125025,"_40307":125028,"_40309":125031,"_40311":125034,"_40313":125037,"_40315":125040,"_40317":125043,"_40319":125046,"_40321":125049,"_40323":125052,"_40325":125055,"_40327":125058,"_40329":125061,"_40332":125064,"_40334":125067,"_40336":125070},{"_3464":70092,"_30135":70092,"_5":14718,"_2948":116139,"_30488":116140,"_20936":116143,"_27421":70092},"Despliega desde AWS Marketplace",[49202,116141,116142],"Despliegue","Otros modelos",[],{"_3464":70093,"_30135":70092,"_20936":116145,"_5":14366,"_27421":70092,"_2948":116146},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3464":70094,"_30135":70092,"_5":30485,"_20936":116148,"_27421":116149,"_2948":116150},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3464":70095,"_30135":70092,"_5":30485,"_20936":116152,"_27421":116153,"_2948":116154},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3464":70096,"_30135":70092,"_5":30485,"_20936":116156,"_27421":116157,"_2948":116158},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3464":70097,"_30135":70092,"_5":30485,"_20936":116160,"_27421":116161,"_2948":116162},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3464":70098,"_30135":70092,"_5":30485,"_20936":116164,"_27421":116165,"_2948":116166},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3464":70099,"_30135":70092,"_5":30485,"_20936":116168,"_27421":116169,"_2948":116170},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3464":70100,"_30135":70092,"_5":30485,"_20936":116172,"_27421":116173,"_2948":116174},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3464":70101,"_30135":70092,"_20936":116176,"_5":14366,"_27421":70092,"_2948":116177},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3464":70102,"_30135":70092,"_20936":116179,"_5":14366,"_27421":116149,"_2948":116180},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3464":70103,"_30135":70092,"_20936":116182,"_5":14366,"_27421":116149,"_2948":116183},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3464":70104,"_30135":70092,"_20936":116185,"_5":14366,"_27421":116149,"_2948":116186},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3464":70105,"_30135":70092,"_20936":116188,"_5":14366,"_27421":116153,"_2948":116189},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3464":70106,"_30135":70092,"_20936":116191,"_5":14366,"_27421":116153,"_2948":116192},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3464":70107,"_30135":70092,"_20936":116194,"_5":14366,"_27421":116153,"_2948":116195},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3464":70108,"_30135":70092,"_20936":116197,"_5":14366,"_27421":116157,"_2948":116198},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3464":70109,"_30135":70092,"_20936":116200,"_5":14366,"_27421":116161,"_2948":116201},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3464":70110,"_30135":70092,"_20936":116203,"_5":14366,"_27421":116165,"_2948":116204},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3464":70111,"_30135":70092,"_20936":116206,"_5":14366,"_27421":116169,"_2948":116207},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3464":70112,"_30135":70092,"_20936":116209,"_5":14366,"_27421":116173,"_2948":116210},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3464":70113,"_30135":70113,"_5":14718,"_2948":116212,"_30488":116213,"_20936":116214,"_27421":70113},"Despliega Lamassu",[49202,116141],[],{"_3464":70114,"_30135":70113,"_20936":116216,"_5":14366,"_27421":70113,"_2948":116217},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3464":70115,"_30135":70113,"_5":30485,"_20936":116219,"_27421":116220,"_2948":116221},[],"/docs/pr-preview/pr-61/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3464":70116,"_30135":70113,"_5":30485,"_20936":116223,"_27421":116224,"_2948":116225},[],"/docs/pr-preview/pr-61/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3464":70117,"_30135":70113,"_5":30485,"_20936":116227,"_27421":116228,"_2948":116229},[],"/docs/pr-preview/pr-61/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3464":70118,"_30135":70113,"_20936":116231,"_5":14366,"_27421":70113,"_2948":116232},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3464":70119,"_30135":70113,"_20936":116234,"_5":14366,"_27421":116220,"_2948":116235},[],"Modelo",{"_3464":70120,"_30135":70113,"_20936":116237,"_5":14366,"_27421":116220,"_2948":116238},[],"Recomendado para",{"_3464":70121,"_30135":70113,"_20936":116240,"_5":14366,"_27421":116220,"_2948":116241},[],"Quién opera la infraestructura",{"_3464":70122,"_30135":70113,"_20936":116243,"_5":14366,"_27421":116220,"_2948":116244},[],"Punto de partida",{"_3464":70123,"_30135":70113,"_20936":116246,"_5":14366,"_27421":116220,"_2948":49309},[],{"_3464":70124,"_30135":70113,"_20936":116248,"_5":14366,"_27421":116220,"_2948":116249},[],"Producción, entornos regulados y despliegues personalizados",{"_3464":70125,"_30135":70113,"_20936":116251,"_5":14366,"_27421":116220,"_2948":116252},[],"Tu equipo",{"_3464":70126,"_30135":70113,"_20936":116254,"_5":14366,"_27421":116220,"_2948":116255},[],"Helm o Fastlane",{"_3464":70127,"_30135":70113,"_20936":116257,"_5":14366,"_27421":116220,"_2948":49321},[],{"_3464":70128,"_30135":70113,"_20936":116259,"_5":14366,"_27421":116220,"_2948":116260},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3464":70129,"_30135":70113,"_20936":116262,"_5":14366,"_27421":116220,"_2948":116252},[],{"_3464":70130,"_30135":70113,"_20936":116264,"_5":14366,"_27421":116220,"_2948":116265},[],"Imagen preconfigurada en EC2",{"_3464":70131,"_30135":70113,"_20936":116267,"_5":14366,"_27421":116220,"_2948":49332},[],{"_3464":70132,"_30135":70113,"_20936":116269,"_5":14366,"_27421":116220,"_2948":116270},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3464":70133,"_30135":70113,"_20936":116272,"_5":14366,"_27421":116220,"_2948":49338},[],{"_3464":70134,"_30135":70113,"_20936":116274,"_5":14366,"_27421":116220,"_2948":116275},[],"Suscripción gestionada",{"_3464":70135,"_30135":70113,"_20936":116277,"_5":14366,"_27421":116220,"_2948":116278},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3464":70136,"_30135":70113,"_20936":116280,"_5":14366,"_27421":116220,"_2948":116281},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3464":70137,"_30135":70113,"_20936":116283,"_5":14366,"_27421":116220,"_2948":116284},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3464":70138,"_30135":70113,"_20936":116286,"_5":14366,"_27421":116224,"_2948":116287},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3464":70139,"_30135":70113,"_20936":116289,"_5":14366,"_27421":116228,"_2948":116290},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3464":70140,"_30135":70140,"_5":14718,"_2948":116292,"_30488":116293,"_20936":116294,"_27421":70140},"Utiliza Lamassu como SaaS",[49202,116141,116142],[],{"_3464":70141,"_30135":70140,"_20936":116296,"_5":14366,"_27421":70140,"_2948":116297},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3464":70142,"_30135":70140,"_5":30485,"_20936":116299,"_27421":116300,"_2948":116301},[],"/docs/pr-preview/pr-61/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3464":70143,"_30135":70140,"_5":30485,"_20936":116303,"_27421":116304,"_2948":116305},[],"/docs/pr-preview/pr-61/es/deployment/saas#planes","Planes",{"_3464":70144,"_30135":70140,"_5":30485,"_20936":116307,"_27421":116308,"_2948":116309},[],"/docs/pr-preview/pr-61/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3464":70145,"_30135":70140,"_20936":116311,"_5":14366,"_27421":70140,"_2948":116312},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3464":70146,"_30135":70140,"_20936":116314,"_5":14366,"_27421":116300,"_2948":116315},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3464":70147,"_30135":70140,"_20936":116317,"_5":14366,"_27421":116300,"_2948":116318},[],"Copias de seguridad automáticas.",{"_3464":70148,"_30135":70140,"_20936":116320,"_5":14366,"_27421":116300,"_2948":116321},[],"Actualizaciones de versión.",{"_3464":70149,"_30135":70140,"_20936":116323,"_5":14366,"_27421":116300,"_2948":116324},[],"Soporte técnico y SLA según el plan contratado.",{"_3464":70150,"_30135":70140,"_20936":116326,"_5":14366,"_27421":116304,"_2948":49393},[],{"_3464":70151,"_30135":70140,"_20936":116328,"_5":14366,"_27421":116304,"_2948":116329},[],"Dispositivos",{"_3464":70152,"_30135":70140,"_20936":116331,"_5":14366,"_27421":116304,"_2948":116332},[],"Soporte",{"_3464":70153,"_30135":70140,"_20936":116334,"_5":14366,"_27421":116304,"_2948":49402},[],{"_3464":70154,"_30135":70140,"_20936":116336,"_5":14366,"_27421":116304,"_2948":49405},[],{"_3464":70155,"_30135":70140,"_20936":116338,"_5":14366,"_27421":116304,"_2948":116339},[],"Hasta 1.000",{"_3464":70156,"_30135":70140,"_20936":116341,"_5":14366,"_27421":116304,"_2948":49411},[],{"_3464":70157,"_30135":70140,"_20936":116343,"_5":14366,"_27421":116304,"_2948":116344},[],"99,5 %",{"_3464":70158,"_30135":70140,"_20936":116346,"_5":14366,"_27421":116304,"_2948":49417},[],{"_3464":70159,"_30135":70140,"_20936":116348,"_5":14366,"_27421":116304,"_2948":116349},[],"Hasta 10.000",{"_3464":70160,"_30135":70140,"_20936":116351,"_5":14366,"_27421":116304,"_2948":116352},[],"Email y chat",{"_3464":70161,"_30135":70140,"_20936":116354,"_5":14366,"_27421":116304,"_2948":116355},[],"99,9 %",{"_3464":70162,"_30135":70140,"_20936":116357,"_5":14366,"_27421":116304,"_2948":49429},[],{"_3464":70163,"_30135":70140,"_20936":116359,"_5":14366,"_27421":116304,"_2948":116360},[],"Ilimitados",{"_3464":70164,"_30135":70140,"_20936":116362,"_5":14366,"_27421":116304,"_2948":116363},[],"Dedicado",{"_3464":70165,"_30135":70140,"_20936":116365,"_5":14366,"_27421":116304,"_2948":116366},[],"99,99 %",{"_3464":70166,"_30135":70140,"_20936":116368,"_5":14366,"_27421":116308,"_2948":116369},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3464":70167,"_30135":70140,"_20936":116371,"_5":14366,"_27421":116308,"_2948":116372},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3464":70168,"_30135":70168,"_5":14718,"_2948":49446,"_30488":116374,"_20936":116376,"_27421":70168},[49202,116141,116375],"Kubernetes autogestionado",[],{"_3464":70169,"_30135":70168,"_20936":116378,"_5":14366,"_27421":70168,"_2948":116379},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3464":70170,"_30135":70168,"_5":30485,"_20936":116381,"_27421":116382,"_2948":116383},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3464":70171,"_30135":70168,"_5":30485,"_20936":116385,"_27421":116386,"_2948":116387},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3464":70172,"_30135":70168,"_5":30485,"_20936":116389,"_27421":116390,"_2948":116391},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3464":70173,"_30135":70168,"_5":30485,"_20936":116393,"_27421":116394,"_2948":116395},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3464":70174,"_30135":70168,"_5":30485,"_20936":116397,"_27421":116398,"_2948":116399},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3464":70175,"_30135":70168,"_5":30485,"_20936":116401,"_27421":116402,"_2948":116403},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3464":70176,"_30135":70168,"_5":30485,"_20936":116405,"_27421":116406,"_2948":116407},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3464":70177,"_30135":70168,"_5":30485,"_20936":116409,"_27421":116410,"_2948":116411},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3464":70178,"_30135":70168,"_5":30485,"_20936":116413,"_27421":116414,"_2948":116415},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3464":70179,"_30135":70168,"_5":30485,"_20936":116417,"_27421":116418,"_2948":116419},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3464":70180,"_30135":70168,"_5":30485,"_20936":116421,"_27421":116422,"_2948":116423},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3464":70181,"_30135":70168,"_20936":116425,"_5":14366,"_27421":116382,"_2948":116426},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3464":70182,"_30135":70168,"_20936":116428,"_5":14366,"_27421":116382,"_2948":116429},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3464":70183,"_30135":70168,"_20936":116431,"_5":14366,"_27421":116386,"_2948":116432},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3464":70184,"_30135":70168,"_20936":116434,"_5":14366,"_27421":116386,"_2948":116435},[],"Fastlane instala o configura",{"_3464":70185,"_30135":70168,"_20936":116437,"_5":14366,"_27421":116386,"_2948":116438},[],"Tú sigues proporcionando",{"_3464":70186,"_30135":70168,"_20936":116440,"_5":14366,"_27421":116386,"_2948":116441},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3464":70187,"_30135":70168,"_20936":116443,"_5":14366,"_27421":116386,"_2948":116444},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3464":70188,"_30135":70168,"_20936":116446,"_5":14366,"_27421":116386,"_2948":116447},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3464":70189,"_30135":70168,"_20936":116449,"_5":14366,"_27421":116386,"_2948":116450},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3464":70190,"_30135":70168,"_20936":116452,"_5":14366,"_27421":116386,"_2948":116453},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3464":70191,"_30135":70168,"_20936":116455,"_5":14366,"_27421":116386,"_2948":116456},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3464":70192,"_30135":70168,"_20936":116458,"_5":14366,"_27421":116386,"_2948":116459},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3464":70193,"_30135":70168,"_20936":116461,"_5":14366,"_27421":116386,"_2948":116462},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3464":70194,"_30135":70168,"_20936":116464,"_5":14366,"_27421":116386,"_2948":116465},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3464":70195,"_30135":70168,"_20936":116467,"_5":14366,"_27421":116390,"_2948":116468},[],"Necesitas:",{"_3464":70196,"_30135":70168,"_20936":116470,"_5":14366,"_27421":116390,"_2948":116471},[],"un clúster Kubernetes existente",{"_3464":70197,"_30135":70168,"_20936":116473,"_5":14366,"_27421":116390,"_2948":116474},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3464":70198,"_30135":70168,"_20936":116476,"_5":14366,"_27421":116390,"_2948":49548},[],{"_3464":70199,"_30135":70168,"_20936":116478,"_5":14366,"_27421":116390,"_2948":23657},[],{"_3464":70200,"_30135":70168,"_20936":116480,"_5":14366,"_27421":116390,"_2948":116481},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3464":70201,"_30135":70168,"_20936":116483,"_5":14366,"_27421":116390,"_2948":116484},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3464":70202,"_30135":70168,"_20936":116486,"_5":14366,"_27421":116390,"_2948":116487},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3464":70203,"_30135":70168,"_20936":116489,"_5":14366,"_27421":116390,"_2948":116490},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3464":70204,"_30135":70168,"_20936":116492,"_5":14366,"_27421":116390,"_2948":116493},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3464":70205,"_30135":70168,"_20936":116495,"_5":14366,"_27421":116394,"_2948":116496},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3464":70206,"_30135":70168,"_20936":116498,"_5":14366,"_27421":116394,"_2948":116499},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3464":70207,"_30135":70168,"_20936":116501,"_5":14366,"_27421":116398,"_2948":116502},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3464":70208,"_30135":70168,"_20936":116504,"_5":14366,"_27421":116398,"_2948":116505},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3464":70209,"_30135":70168,"_20936":116507,"_5":14366,"_27421":116398,"_2948":116508},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3464":70210,"_30135":70168,"_20936":116510,"_5":14366,"_27421":116398,"_2948":116511},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3464":70211,"_30135":70168,"_20936":116513,"_5":14366,"_27421":116402,"_2948":116514},[],"Opción",{"_3464":70212,"_30135":70168,"_20936":116516,"_5":14366,"_27421":116402,"_2948":116517},[],"Valor predeterminado",{"_3464":70213,"_30135":70168,"_20936":116519,"_5":14366,"_27421":116402,"_2948":116520},[],"Propósito",{"_3464":70214,"_30135":70168,"_20936":116522,"_5":14366,"_27421":116402,"_2948":49595},[],{"_3464":70215,"_30135":70168,"_20936":116524,"_5":14366,"_27421":116402,"_2948":49598},[],{"_3464":70216,"_30135":70168,"_20936":116526,"_5":14366,"_27421":116402,"_2948":116527},[],"Muestra la ayuda",{"_3464":70217,"_30135":70168,"_20936":116529,"_5":14366,"_27421":116402,"_2948":49604},[],{"_3464":70218,"_30135":70168,"_20936":116531,"_5":14366,"_27421":116402,"_2948":116532},[],"contexto actual",{"_3464":70219,"_30135":70168,"_20936":116534,"_5":14366,"_27421":116402,"_2948":116535},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3464":70220,"_30135":70168,"_20936":116537,"_5":14366,"_27421":116402,"_2948":49613},[],{"_3464":70221,"_30135":70168,"_20936":116539,"_5":14366,"_27421":116402,"_2948":6526},[],{"_3464":70222,"_30135":70168,"_20936":116541,"_5":14366,"_27421":116402,"_2948":116542},[],"Omite prompts y genera credenciales para las dependencias",{"_3464":70223,"_30135":70168,"_20936":116544,"_5":14366,"_27421":116402,"_2948":49621},[],{"_3464":70224,"_30135":70168,"_20936":116546,"_5":14366,"_27421":116402,"_2948":49624},[],{"_3464":70225,"_30135":70168,"_20936":116548,"_5":14366,"_27421":116402,"_2948":116549},[],"Namespace de la instalación",{"_3464":70226,"_30135":70168,"_20936":116551,"_5":14366,"_27421":116402,"_2948":49630},[],{"_3464":70227,"_30135":70168,"_20936":116553,"_5":14366,"_27421":116402,"_2948":49633},[],{"_3464":70228,"_30135":70168,"_20936":116555,"_5":14366,"_27421":116402,"_2948":116556},[],"Dominio usado por la UI, OIDC y el certificado",{"_3464":70229,"_30135":70168,"_20936":116558,"_5":14366,"_27421":116402,"_2948":49639},[],{"_3464":70230,"_30135":70168,"_20936":116560,"_5":14366,"_27421":116402,"_2948":15064},[],{"_3464":70231,"_30135":70168,"_20936":116562,"_5":14366,"_27421":116402,"_2948":116563},[],"Versión del chart de Lamassu",{"_3464":70232,"_30135":70168,"_20936":116565,"_5":14366,"_27421":116402,"_2948":49647},[],{"_3464":70233,"_30135":70168,"_20936":116567,"_5":14366,"_27421":116402,"_2948":49650},[],{"_3464":70234,"_30135":70168,"_20936":116569,"_5":14366,"_27421":116402,"_2948":116570},[],"Puerto del listener HTTPS",{"_3464":70235,"_30135":70168,"_20936":116572,"_5":14366,"_27421":116402,"_2948":49656},[],{"_3464":70236,"_30135":70168,"_20936":116574,"_5":14366,"_27421":116402,"_2948":49659},[],{"_3464":70237,"_30135":70168,"_20936":116576,"_5":14366,"_27421":116402,"_2948":116577},[],"Puerto del listener HTTP",{"_3464":70238,"_30135":70168,"_20936":116579,"_5":14366,"_27421":116402,"_2948":49665},[],{"_3464":70239,"_30135":70168,"_20936":116581,"_5":14366,"_27421":116402,"_2948":49598},[],{"_3464":70240,"_30135":70168,"_20936":116583,"_5":14366,"_27421":116402,"_2948":116584},[],"Certificado PEM para TLS downstream",{"_3464":70241,"_30135":70168,"_20936":116586,"_5":14366,"_27421":116402,"_2948":49673},[],{"_3464":70242,"_30135":70168,"_20936":116588,"_5":14366,"_27421":116402,"_2948":49598},[],{"_3464":70243,"_30135":70168,"_20936":116590,"_5":14366,"_27421":116402,"_2948":116591},[],"Clave privada PEM para TLS downstream",{"_3464":70244,"_30135":70168,"_20936":116593,"_5":14366,"_27421":116402,"_2948":49681},[],{"_3464":70245,"_30135":70168,"_20936":116595,"_5":14366,"_27421":116402,"_2948":116596},[],"chart del repositorio",{"_3464":70246,"_30135":70168,"_20936":116598,"_5":14366,"_27421":116402,"_2948":116599},[],"Usa un chart local de Lamassu sin empaquetar",{"_3464":70247,"_30135":70168,"_20936":116601,"_5":14366,"_27421":116402,"_2948":49690},[],{"_3464":70248,"_30135":70168,"_20936":116603,"_5":14366,"_27421":116402,"_2948":116604},[],"detección automática",{"_3464":70249,"_30135":70168,"_20936":116606,"_5":14366,"_27421":116402,"_2948":116607},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3464":70250,"_30135":70168,"_20936":116609,"_5":14366,"_27421":116402,"_2948":49698},[],{"_3464":70251,"_30135":70168,"_20936":116611,"_5":14366,"_27421":116402,"_2948":6526},[],{"_3464":70252,"_30135":70168,"_20936":116613,"_5":14366,"_27421":116402,"_2948":116614},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3464":70253,"_30135":70168,"_20936":116616,"_5":14366,"_27421":116402,"_2948":49706},[],{"_3464":70254,"_30135":70168,"_20936":116618,"_5":14366,"_27421":116402,"_2948":6526},[],{"_3464":70255,"_30135":70168,"_20936":116620,"_5":14366,"_27421":116402,"_2948":116621},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3464":70256,"_30135":70168,"_20936":116623,"_5":14366,"_27421":116402,"_2948":49714},[],{"_3464":70257,"_30135":70168,"_20936":116625,"_5":14366,"_27421":116402,"_2948":6526},[],{"_3464":70258,"_30135":70168,"_20936":116627,"_5":14366,"_27421":116402,"_2948":116628},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3464":70259,"_30135":70168,"_20936":116630,"_5":14366,"_27421":116402,"_2948":49722},[],{"_3464":70260,"_30135":70168,"_20936":116632,"_5":14366,"_27421":116402,"_2948":6526},[],{"_3464":70261,"_30135":70168,"_20936":116634,"_5":14366,"_27421":116402,"_2948":116635},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3464":70262,"_30135":70168,"_20936":116637,"_5":14366,"_27421":116402,"_2948":49730},[],{"_3464":70263,"_30135":70168,"_20936":116639,"_5":14366,"_27421":116402,"_2948":49733},[],{"_3464":70264,"_30135":70168,"_20936":116641,"_5":14366,"_27421":116402,"_2948":116642},[],"Usa otro chart local de SoftHSM",{"_3464":70265,"_30135":70168,"_20936":116644,"_5":14366,"_27421":116402,"_2948":116645},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3464":70266,"_30135":70168,"_20936":116647,"_5":14366,"_27421":116406,"_2948":116648},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3464":70267,"_30135":70168,"_20936":116650,"_5":14366,"_27421":116406,"_2948":116651},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3464":70268,"_30135":70168,"_20936":116653,"_5":14366,"_27421":116406,"_2948":116654},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3464":70269,"_30135":70168,"_20936":116656,"_5":14366,"_27421":116406,"_2948":116657},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3464":70270,"_30135":70168,"_20936":116659,"_5":14366,"_27421":116406,"_2948":116660},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3464":70271,"_30135":70168,"_20936":116662,"_5":14366,"_27421":116406,"_2948":116663},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3464":70272,"_30135":70168,"_20936":116665,"_5":14366,"_27421":116410,"_2948":49760},[],{"_3464":70273,"_30135":70168,"_20936":116667,"_5":14366,"_27421":116410,"_2948":116668},[],"valida las herramientas locales y el clúster seleccionado",{"_3464":70274,"_30135":70168,"_20936":116670,"_5":14366,"_27421":116410,"_2948":116671},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3464":70275,"_30135":70168,"_20936":116673,"_5":14366,"_27421":116410,"_2948":116674},[],"crea el namespace",{"_3464":70276,"_30135":70168,"_20936":116676,"_5":14366,"_27421":116410,"_2948":116677},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3464":70277,"_30135":70168,"_20936":116679,"_5":14366,"_27421":116410,"_2948":116680},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3464":70278,"_30135":70168,"_20936":116682,"_5":14366,"_27421":116410,"_2948":116683},[],"instala RabbitMQ",{"_3464":70279,"_30135":70168,"_20936":116685,"_5":14366,"_27421":116410,"_2948":116686},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3464":70280,"_30135":70168,"_20936":116688,"_5":14366,"_27421":116410,"_2948":116689},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3464":70281,"_30135":70168,"_20936":116691,"_5":14366,"_27421":116410,"_2948":116692},[],"carga datos de ejemplo opcionalmente",{"_3464":70282,"_30135":70168,"_20936":116694,"_5":14366,"_27421":116410,"_2948":116695},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3464":70283,"_30135":70168,"_20936":116697,"_5":14366,"_27421":116414,"_2948":116698},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3464":70284,"_30135":70168,"_20936":116700,"_5":14366,"_27421":116414,"_2948":116701},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3464":70285,"_30135":70168,"_20936":116703,"_5":14366,"_27421":116418,"_2948":116704},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3464":70286,"_30135":70168,"_20936":116706,"_5":14366,"_27421":116418,"_2948":116707},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3464":70287,"_30135":70168,"_20936":116709,"_5":14366,"_27421":116418,"_2948":116710},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3464":70288,"_30135":70168,"_20936":116712,"_5":14366,"_27421":116422,"_2948":116713},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3464":70289,"_30135":70289,"_5":14718,"_2948":116715,"_30488":116716,"_20936":116717,"_27421":70289},"Instala con Helm",[49202,116141,116375],[],{"_3464":70290,"_30135":70289,"_20936":116719,"_5":14366,"_27421":70289,"_2948":116720},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3464":70291,"_30135":70289,"_5":30485,"_20936":116722,"_27421":116723,"_2948":116724},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3464":70292,"_30135":70289,"_5":30485,"_20936":116726,"_27421":116727,"_2948":116391},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3464":70293,"_30135":70289,"_5":30485,"_20936":116729,"_27421":116730,"_2948":116731},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3464":70294,"_30135":70289,"_5":30485,"_20936":116733,"_27421":116734,"_2948":116735},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3464":70295,"_30135":70289,"_5":30485,"_20936":116737,"_27421":116738,"_2948":116739},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3464":70296,"_30135":70289,"_5":30485,"_20936":116741,"_27421":116742,"_2948":116743},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3464":70297,"_30135":70289,"_5":30485,"_20936":116745,"_27421":116746,"_2948":116747},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3464":70298,"_30135":70289,"_5":30485,"_20936":116749,"_27421":116750,"_2948":116751},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3464":70299,"_30135":70289,"_5":30485,"_20936":116753,"_27421":116754,"_2948":116755},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3464":70300,"_30135":70289,"_5":30485,"_20936":116757,"_27421":116758,"_2948":116759},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3464":70301,"_30135":70289,"_5":30485,"_20936":116761,"_27421":116762,"_2948":116763},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3464":70302,"_30135":70289,"_20936":116765,"_5":14366,"_27421":116723,"_2948":116766},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3464":70303,"_30135":70289,"_20936":116768,"_5":14366,"_27421":116727,"_2948":116769},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3464":70304,"_30135":70289,"_20936":116771,"_5":14366,"_27421":116727,"_2948":116772},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3464":70305,"_30135":70289,"_20936":116774,"_5":14366,"_27421":116727,"_2948":116775},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3464":70306,"_30135":70289,"_20936":116777,"_5":14366,"_27421":116727,"_2948":116778},[],"un broker RabbitMQ accesible y sus credenciales",{"_3464":70307,"_30135":70289,"_20936":116780,"_5":14366,"_27421":116727,"_2948":116781},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3464":70308,"_30135":70289,"_20936":116783,"_5":14366,"_27421":116727,"_2948":116784},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3464":70309,"_30135":70289,"_20936":116786,"_5":14366,"_27421":116727,"_2948":116787},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3464":70310,"_30135":70289,"_20936":116789,"_5":14366,"_27421":116727,"_2948":116790},[],"una StorageClass y un diseño de tráfico externo",{"_3464":70311,"_30135":70289,"_20936":116792,"_5":14366,"_27421":116727,"_2948":116793},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3464":70312,"_30135":70289,"_20936":116795,"_5":14366,"_27421":116727,"_2948":116796},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3464":70313,"_30135":70289,"_20936":116798,"_5":14366,"_27421":116727,"_2948":116799},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3464":70314,"_30135":70289,"_20936":116801,"_5":14366,"_27421":116730,"_2948":116802},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3464":70315,"_30135":70289,"_20936":116804,"_5":14366,"_27421":116730,"_2948":116805},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3464":70316,"_30135":70289,"_20936":116807,"_5":14366,"_27421":116730,"_2948":116808},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3464":70317,"_30135":70289,"_20936":116810,"_5":14366,"_27421":116734,"_2948":116811},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3464":70318,"_30135":70289,"_20936":116813,"_5":14366,"_27421":116734,"_2948":116814},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3464":70319,"_30135":70289,"_20936":116816,"_5":14366,"_27421":116734,"_2948":116817},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3464":70320,"_30135":70289,"_20936":116819,"_5":14366,"_27421":116734,"_2948":116820},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3464":70321,"_30135":70289,"_20936":116822,"_5":14366,"_27421":116738,"_2948":116823},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3464":70322,"_30135":70289,"_20936":116825,"_5":14366,"_27421":116742,"_2948":116826},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3464":70323,"_30135":70289,"_20936":116828,"_5":14366,"_27421":116742,"_2948":116829},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3464":70324,"_30135":70289,"_20936":116831,"_5":14366,"_27421":116742,"_2948":116832},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3464":70325,"_30135":70289,"_20936":116834,"_5":14366,"_27421":116742,"_2948":116835},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3464":70326,"_30135":70289,"_20936":116837,"_5":14366,"_27421":116742,"_2948":116838},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3464":70327,"_30135":70289,"_20936":116840,"_5":14366,"_27421":116742,"_2948":116841},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3464":70328,"_30135":70289,"_20936":116843,"_5":14366,"_27421":116742,"_2948":116844},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3464":70329,"_30135":70289,"_20936":116846,"_5":14366,"_27421":116746,"_2948":116847},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3464":70330,"_30135":70289,"_20936":116849,"_5":14366,"_27421":116746,"_2948":116850},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3464":70331,"_30135":70289,"_20936":116852,"_5":14366,"_27421":116746,"_2948":116853},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3464":70332,"_30135":70289,"_20936":116855,"_5":14366,"_27421":116746,"_2948":116856},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3464":70333,"_30135":70289,"_20936":116858,"_5":14366,"_27421":116750,"_2948":116859},[],"Para instalar un checkout local:",{"_3464":70334,"_30135":70289,"_20936":116861,"_5":14366,"_27421":116754,"_2948":116862},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3464":70335,"_30135":70289,"_20936":116864,"_5":14366,"_27421":116754,"_2948":116865},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3464":70336,"_30135":70289,"_20936":116867,"_5":14366,"_27421":116758,"_2948":116868},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3464":70337,"_30135":70289,"_20936":116870,"_5":14366,"_27421":116758,"_2948":116871},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3464":70338,"_30135":70289,"_20936":116873,"_5":14366,"_27421":116758,"_2948":116874},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3464":70339,"_30135":70289,"_20936":116876,"_5":14366,"_27421":116758,"_2948":116877},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3464":70340,"_30135":70289,"_20936":116879,"_5":14366,"_27421":116758,"_2948":116880},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3464":70341,"_30135":70289,"_20936":116882,"_5":14366,"_27421":116762,"_2948":116883},[],"Antes de pasar a producción, revisa:",{"_3464":70342,"_30135":70289,"_20936":116885,"_5":14366,"_27421":116762,"_2948":116886},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3464":70343,"_30135":70289,"_20936":116888,"_5":14366,"_27421":116762,"_2948":116889},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3464":70344,"_30135":70289,"_20936":116891,"_5":14366,"_27421":116762,"_2948":116892},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3464":70345,"_30135":70289,"_20936":116894,"_5":14366,"_27421":116762,"_2948":116895},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3464":70346,"_30135":70289,"_20936":116897,"_5":14366,"_27421":116762,"_2948":116898},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3464":70347,"_30135":70289,"_20936":116900,"_5":14366,"_27421":116762,"_2948":116901},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3464":70348,"_30135":70289,"_20936":116903,"_5":14366,"_27421":116762,"_2948":116904},[],"SMTP, observabilidad y entrega de alertas",{"_3464":70349,"_30135":70289,"_20936":116906,"_5":14366,"_27421":116762,"_2948":116907},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3464":70350,"_30135":70289,"_20936":116909,"_5":14366,"_27421":116762,"_2948":116910},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3464":70351,"_30135":70351,"_5":14718,"_2948":116912,"_30488":116913,"_20936":116914,"_27421":70351},"Expón el Gateway",[49202,116141,116375],[],{"_3464":70352,"_30135":70351,"_20936":116916,"_5":14366,"_27421":70351,"_2948":116917},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3464":70353,"_30135":70351,"_5":30485,"_20936":116919,"_27421":116920,"_2948":116921},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3464":70354,"_30135":70351,"_5":30485,"_20936":116923,"_27421":116924,"_2948":116925},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3464":70355,"_30135":70351,"_5":30485,"_20936":116927,"_27421":116928,"_2948":116929},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3464":70356,"_30135":70351,"_5":30485,"_20936":116931,"_27421":116932,"_2948":50028},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#k3s",{"_3464":70357,"_30135":70351,"_5":30485,"_20936":116934,"_27421":116935,"_2948":116936},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3464":70358,"_30135":70351,"_5":30485,"_20936":116938,"_27421":116939,"_2948":116940},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3464":70359,"_30135":70351,"_5":30485,"_20936":116942,"_27421":116943,"_2948":116944},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3464":70360,"_30135":70351,"_5":30485,"_20936":116946,"_27421":116947,"_2948":116948},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3464":70361,"_30135":70351,"_5":30485,"_20936":116950,"_27421":116951,"_2948":116952},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3464":70362,"_30135":70351,"_5":30485,"_20936":116954,"_27421":116955,"_2948":116956},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3464":70363,"_30135":70351,"_20936":116958,"_5":14366,"_27421":116920,"_2948":116959},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3464":70364,"_30135":70351,"_20936":116961,"_5":14366,"_27421":116920,"_2948":116962},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3464":70365,"_30135":70351,"_20936":116964,"_5":14366,"_27421":116924,"_2948":116965},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3464":70366,"_30135":70351,"_20936":116967,"_5":14366,"_27421":116924,"_2948":116968},[],"Defínelo únicamente cuando:",{"_3464":70367,"_30135":70351,"_20936":116970,"_5":14366,"_27421":116924,"_2948":116971},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3464":70368,"_30135":70351,"_20936":116973,"_5":14366,"_27421":116924,"_2948":116974},[],"esa dirección está asignada a este Gateway",{"_3464":70369,"_30135":70351,"_20936":116976,"_5":14366,"_27421":116924,"_2948":116977},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3464":70370,"_30135":70351,"_20936":116979,"_5":14366,"_27421":116924,"_2948":116980},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3464":70371,"_30135":70351,"_20936":116982,"_5":14366,"_27421":116924,"_2948":116983},[],"No confundas estos valores:",{"_3464":70372,"_30135":70351,"_20936":116985,"_5":14366,"_27421":116924,"_2948":116986},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3464":70373,"_30135":70351,"_20936":116988,"_5":14366,"_27421":116924,"_2948":116989},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3464":70374,"_30135":70351,"_20936":116991,"_5":14366,"_27421":116924,"_2948":116992},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3464":70375,"_30135":70351,"_20936":116994,"_5":14366,"_27421":116928,"_2948":116995},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3464":70376,"_30135":70351,"_20936":116997,"_5":14366,"_27421":116928,"_2948":116998},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3464":70377,"_30135":70351,"_20936":117000,"_5":14366,"_27421":116932,"_2948":117001},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3464":70378,"_30135":70351,"_20936":117003,"_5":14366,"_27421":116932,"_2948":117004},[],"Para el diseño recomendado:",{"_3464":70379,"_30135":70351,"_20936":117006,"_5":14366,"_27421":116932,"_2948":117007},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3464":70380,"_30135":70351,"_20936":117009,"_5":14366,"_27421":116932,"_2948":117010},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3464":70381,"_30135":70351,"_20936":117012,"_5":14366,"_27421":116932,"_2948":117013},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3464":70382,"_30135":70351,"_20936":117015,"_5":14366,"_27421":116932,"_2948":117016},[],"Apunta DNS a la dirección accesible de la VM.",{"_3464":70383,"_30135":70351,"_20936":117018,"_5":14366,"_27421":116932,"_2948":117019},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3464":70384,"_30135":70351,"_20936":117021,"_5":14366,"_27421":116935,"_2948":117022},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3464":70385,"_30135":70351,"_20936":117024,"_5":14366,"_27421":116939,"_2948":117025},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3464":70386,"_30135":70351,"_20936":117027,"_5":14366,"_27421":116939,"_2948":117028},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3464":70387,"_30135":70351,"_20936":117030,"_5":14366,"_27421":116943,"_2948":117031},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3464":70388,"_30135":70351,"_20936":117033,"_5":14366,"_27421":116943,"_2948":117034},[],"Requisito",{"_3464":70389,"_30135":70351,"_20936":117036,"_5":14366,"_27421":116943,"_2948":117037},[],"Diseño recomendado",{"_3464":70390,"_30135":70351,"_20936":117039,"_5":14366,"_27421":116943,"_2948":117040},[],"Consecuencia",{"_3464":70391,"_30135":70351,"_20936":117042,"_5":14366,"_27421":116943,"_2948":117043},[],"Varias URL o servicios de Lamassu",{"_3464":70392,"_30135":70351,"_20936":117045,"_5":14366,"_27421":116943,"_2948":117046},[],"Un Gateway con varias rutas",{"_3464":70393,"_30135":70351,"_20936":117048,"_5":14366,"_27421":116943,"_2948":117049},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3464":70394,"_30135":70351,"_20936":117051,"_5":14366,"_27421":116943,"_2948":117052},[],"Gateways independientes e IP externas distintas",{"_3464":70395,"_30135":70351,"_20936":117054,"_5":14366,"_27421":116943,"_2948":117055},[],"Una VIP por Gateway",{"_3464":70396,"_30135":70351,"_20936":117057,"_5":14366,"_27421":116943,"_2948":117058},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3464":70397,"_30135":70351,"_20936":117060,"_5":14366,"_27421":116943,"_2948":117061},[],"Gateways independientes, un nodo y una IP",{"_3464":70398,"_30135":70351,"_20936":117063,"_5":14366,"_27421":116943,"_2948":117064},[],"Puertos externos diferentes",{"_3464":70399,"_30135":70351,"_20936":117066,"_5":14366,"_27421":116943,"_2948":117067},[],"Los clientes deben indicar puertos no estándar",{"_3464":70400,"_30135":70351,"_20936":117069,"_5":14366,"_27421":116943,"_2948":117070},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3464":70401,"_30135":70351,"_20936":117072,"_5":14366,"_27421":116943,"_2948":117073},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3464":70402,"_30135":70351,"_20936":117075,"_5":14366,"_27421":116943,"_2948":117076},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3464":70403,"_30135":70351,"_20936":117078,"_5":14366,"_27421":116943,"_2948":117079},[],"Recursos Gateway separados pero proxy compartido",{"_3464":70404,"_30135":70351,"_20936":117081,"_5":14366,"_27421":116943,"_2948":117082},[],"Modo merged Gateway de Envoy",{"_3464":70405,"_30135":70351,"_20936":117084,"_5":14366,"_27421":116943,"_2948":117085},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3464":70406,"_30135":70351,"_20936":117087,"_5":14366,"_27421":116943,"_2948":117088},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3464":70407,"_30135":70351,"_20936":117090,"_5":14366,"_27421":116943,"_2948":117091},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3464":70408,"_30135":70351,"_20936":117093,"_5":14366,"_27421":116943,"_2948":117094},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3464":70409,"_30135":70351,"_20936":117096,"_5":14366,"_27421":116943,"_2948":117097},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3464":70410,"_30135":70351,"_20936":117099,"_5":14366,"_27421":116947,"_2948":117100},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3464":70411,"_30135":70351,"_20936":117102,"_5":14366,"_27421":116947,"_2948":117103},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3464":70412,"_30135":70351,"_20936":117105,"_5":14366,"_27421":116947,"_2948":117106},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3464":70413,"_30135":70351,"_20936":117108,"_5":14366,"_27421":116947,"_2948":117109},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3464":70414,"_30135":70351,"_20936":117111,"_5":14366,"_27421":116947,"_2948":117112},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3464":70415,"_30135":70351,"_20936":117114,"_5":14366,"_27421":116951,"_2948":117115},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3464":70416,"_30135":70351,"_20936":117117,"_5":14366,"_27421":116951,"_2948":117118},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3464":70417,"_30135":70351,"_20936":117120,"_5":14366,"_27421":116955,"_2948":117121},[],"Comprueba, en orden:",{"_3464":70418,"_30135":70351,"_20936":117123,"_5":14366,"_27421":116955,"_2948":117124},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3464":70419,"_30135":70351,"_20936":117126,"_5":14366,"_27421":116955,"_2948":117127},[],"Su estado contiene la dirección esperada.",{"_3464":70420,"_30135":70351,"_20936":117129,"_5":14366,"_27421":116955,"_2948":117130},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3464":70421,"_30135":70351,"_20936":117132,"_5":14366,"_27421":116955,"_2948":117133},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3464":70422,"_30135":70351,"_20936":117135,"_5":14366,"_27421":116955,"_2948":117136},[],"DNS resuelve al endpoint accesible externamente.",{"_3464":70423,"_30135":70351,"_20936":117138,"_5":14366,"_27421":116955,"_2948":117139},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3464":70424,"_30135":70351,"_20936":117141,"_5":14366,"_27421":116955,"_2948":117142},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3464":70425,"_30135":70425,"_5":14718,"_2948":49309,"_30488":117144,"_20936":117145,"_27421":70425},[49202,116141,116375],[],{"_3464":70426,"_30135":70425,"_20936":117147,"_5":14366,"_27421":70425,"_2948":117148},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3464":70427,"_30135":70425,"_5":30485,"_20936":117150,"_27421":117151,"_2948":117152},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3464":70428,"_30135":70425,"_5":30485,"_20936":117154,"_27421":117155,"_2948":117156},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3464":70429,"_30135":70425,"_5":30485,"_20936":117158,"_27421":117159,"_2948":117160},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3464":70430,"_30135":70425,"_5":30485,"_20936":117162,"_27421":117163,"_2948":117164},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3464":70431,"_30135":70425,"_5":30485,"_20936":117166,"_27421":117167,"_2948":117168},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3464":70432,"_30135":70425,"_5":30485,"_20936":117170,"_27421":117171,"_2948":117172},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3464":70433,"_30135":70425,"_20936":117174,"_5":14366,"_27421":117151,"_2948":117175},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3464":70434,"_30135":70425,"_20936":117177,"_5":14366,"_27421":117155,"_2948":117178},[],"Flujo",{"_3464":70435,"_30135":70425,"_20936":117180,"_5":14366,"_27421":117155,"_2948":117181},[],"Úsalo para",{"_3464":70436,"_30135":70425,"_20936":117183,"_5":14366,"_27421":117155,"_2948":117184},[],"Qué instala",{"_3464":70437,"_30135":70425,"_20936":117186,"_5":14366,"_27421":117155,"_2948":50283},[],{"_3464":70438,"_30135":70425,"_20936":117188,"_5":14366,"_27421":117155,"_2948":117189},[],"Producción y entornos controlados",{"_3464":70439,"_30135":70425,"_20936":117191,"_5":14366,"_27421":117155,"_2948":117192},[],"Servicios de Lamassu y recursos de Gateway API",{"_3464":70440,"_30135":70425,"_20936":117194,"_5":14366,"_27421":117155,"_2948":49446},[],{"_3464":70441,"_30135":70425,"_20936":117196,"_5":14366,"_27421":117155,"_2948":117197},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3464":70442,"_30135":70425,"_20936":117199,"_5":14366,"_27421":117155,"_2948":117200},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3464":70443,"_30135":70425,"_20936":117202,"_5":14366,"_27421":117159,"_2948":117203},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3464":70444,"_30135":70425,"_20936":117205,"_5":14366,"_27421":117159,"_2948":117206},[],"Área",{"_3464":70445,"_30135":70425,"_20936":117208,"_5":14366,"_27421":117159,"_2948":117209},[],"El chart de Lamassu proporciona",{"_3464":70446,"_30135":70425,"_20936":117211,"_5":14366,"_27421":117159,"_2948":117212},[],"Tú proporcionas",{"_3464":70447,"_30135":70425,"_20936":117214,"_5":14366,"_27421":117159,"_2948":117215},[],"Aplicaciones Lamassu",{"_3464":70448,"_30135":70425,"_20936":117217,"_5":14366,"_27421":117159,"_2948":117218},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3464":70449,"_30135":70425,"_20936":117220,"_5":14366,"_27421":117159,"_2948":117221},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3464":70450,"_30135":70425,"_20936":117223,"_5":14366,"_27421":117159,"_2948":117224},[],"Datos PostgreSQL",{"_3464":70451,"_30135":70425,"_20936":117226,"_5":14366,"_27421":117159,"_2948":117227},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3464":70452,"_30135":70425,"_20936":117229,"_5":14366,"_27421":117159,"_2948":117230},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3464":70453,"_30135":70425,"_20936":117232,"_5":14366,"_27421":117159,"_2948":117233},[],"Mensajería",{"_3464":70454,"_30135":70425,"_20936":117235,"_5":14366,"_27421":117159,"_2948":117236},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3464":70455,"_30135":70425,"_20936":117238,"_5":14366,"_27421":117159,"_2948":117239},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3464":70456,"_30135":70425,"_20936":117241,"_5":14366,"_27421":117159,"_2948":117242},[],"Identidad",{"_3464":70457,"_30135":70425,"_20936":117244,"_5":14366,"_27421":117159,"_2948":117245},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3464":70458,"_30135":70425,"_20936":117247,"_5":14366,"_27421":117159,"_2948":117248},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3464":70459,"_30135":70425,"_20936":117250,"_5":14366,"_27421":117159,"_2948":117251},[],"Enrutamiento externo",{"_3464":70460,"_30135":70425,"_20936":117253,"_5":14366,"_27421":117159,"_2948":117254},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3464":70461,"_30135":70425,"_20936":117256,"_5":14366,"_27421":117159,"_2948":117257},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3464":70462,"_30135":70425,"_20936":117259,"_5":14366,"_27421":117159,"_2948":50357},[],{"_3464":70463,"_30135":70425,"_20936":117261,"_5":14366,"_27421":117159,"_2948":117262},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3464":70464,"_30135":70425,"_20936":117264,"_5":14366,"_27421":117159,"_2948":117265},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3464":70465,"_30135":70425,"_20936":117267,"_5":14366,"_27421":117159,"_2948":117268},[],"Datos persistentes de la aplicación",{"_3464":70466,"_30135":70425,"_20936":117270,"_5":14366,"_27421":117159,"_2948":117271},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3464":70467,"_30135":70425,"_20936":117273,"_5":14366,"_27421":117159,"_2948":117274},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3464":70468,"_30135":70425,"_20936":117276,"_5":14366,"_27421":117159,"_2948":117277},[],"Integraciones opcionales",{"_3464":70469,"_30135":70425,"_20936":117279,"_5":14366,"_27421":117159,"_2948":117280},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3464":70470,"_30135":70425,"_20936":117282,"_5":14366,"_27421":117159,"_2948":117283},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3464":70471,"_30135":70425,"_20936":117285,"_5":14366,"_27421":117159,"_2948":117286},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3464":70472,"_30135":70425,"_20936":117288,"_5":14366,"_27421":117159,"_2948":117289},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3464":70473,"_30135":70425,"_20936":117291,"_5":14366,"_27421":117163,"_2948":117292},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3464":70474,"_30135":70425,"_20936":117294,"_5":14366,"_27421":117163,"_2948":117295},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3464":70475,"_30135":70425,"_20936":117297,"_5":14366,"_27421":117167,"_2948":117298},[],"Kubernetes 1.24 o posterior",{"_3464":70476,"_30135":70425,"_20936":117300,"_5":14366,"_27421":117167,"_2948":117301},[],"Helm 3.2 o posterior",{"_3464":70477,"_30135":70425,"_20936":117303,"_5":14366,"_27421":117167,"_2948":117304},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3464":70478,"_30135":70425,"_20936":117306,"_5":14366,"_27421":117167,"_2948":117307},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3464":70479,"_30135":70425,"_20936":117309,"_5":14366,"_27421":117167,"_2948":117310},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3464":70480,"_30135":70425,"_20936":117312,"_5":14366,"_27421":117167,"_2948":117313},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3464":70481,"_30135":70425,"_20936":117315,"_5":14366,"_27421":117167,"_2948":117316},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3464":70482,"_30135":70425,"_20936":117318,"_5":14366,"_27421":117171,"_2948":117319},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3464":70483,"_30135":70425,"_20936":117321,"_5":14366,"_27421":117171,"_2948":117322},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3464":70484,"_30135":70425,"_20936":117324,"_5":14366,"_27421":117171,"_2948":117325},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3464":70485,"_30135":70425,"_20936":117327,"_5":14366,"_27421":117171,"_2948":117328},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3464":70486,"_30135":70486,"_5":14718,"_2948":117330,"_30488":117331,"_20936":117333,"_27421":70486},"Resolución de problemas de despliegue",[49202,116141,117332],"Operación",[],{"_3464":70487,"_30135":70486,"_20936":117335,"_5":14366,"_27421":70486,"_2948":117336},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3464":70488,"_30135":70486,"_5":30485,"_20936":117338,"_27421":117339,"_2948":117340},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3464":70489,"_30135":70486,"_5":30485,"_20936":117342,"_27421":117343,"_2948":117344},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3464":70490,"_30135":70486,"_5":30485,"_20936":117346,"_27421":117347,"_2948":117348},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3464":70491,"_30135":70486,"_5":30485,"_20936":117350,"_27421":117351,"_2948":117352},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3464":70492,"_30135":70486,"_5":30485,"_20936":117354,"_27421":117355,"_2948":117356},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3464":70493,"_30135":70486,"_5":30485,"_20936":117358,"_27421":117359,"_2948":117360},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3464":70494,"_30135":70486,"_5":30485,"_20936":117362,"_27421":117363,"_2948":117364},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3464":70495,"_30135":70486,"_5":30485,"_20936":117366,"_27421":117367,"_2948":117368},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3464":70496,"_30135":70486,"_5":30485,"_20936":117370,"_27421":117371,"_2948":117372},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3464":70497,"_30135":70486,"_5":30485,"_20936":117374,"_27421":117375,"_2948":117376},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3464":70498,"_30135":70486,"_5":30485,"_20936":117378,"_27421":117379,"_2948":117380},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3464":70499,"_30135":70486,"_5":30485,"_20936":117382,"_27421":117383,"_2948":117384},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3464":70500,"_30135":70486,"_5":30485,"_20936":117386,"_27421":117387,"_2948":117388},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3464":70501,"_30135":70486,"_20936":117390,"_5":14366,"_27421":70486,"_2948":117391},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3464":70502,"_30135":70486,"_20936":117393,"_5":14366,"_27421":117343,"_2948":117394},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3464":70503,"_30135":70486,"_20936":117396,"_5":14366,"_27421":117347,"_2948":117397},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3464":70504,"_30135":70486,"_20936":117399,"_5":14366,"_27421":117351,"_2948":117400},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3464":70505,"_30135":70486,"_20936":117402,"_5":14366,"_27421":117355,"_2948":117403},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3464":70506,"_30135":70486,"_20936":117405,"_5":14366,"_27421":117359,"_2948":117406},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3464":70507,"_30135":70486,"_20936":117408,"_5":14366,"_27421":117363,"_2948":117409},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3464":70508,"_30135":70486,"_20936":117411,"_5":14366,"_27421":117363,"_2948":117412},[],"Ejecuta también la prueba de conectividad del chart:",{"_3464":70509,"_30135":70486,"_20936":117414,"_5":14366,"_27421":117363,"_2948":117415},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3464":70510,"_30135":70486,"_20936":117417,"_5":14366,"_27421":117363,"_2948":117418},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3464":70511,"_30135":70486,"_20936":117420,"_5":14366,"_27421":117367,"_2948":117421},[],"Si recibes un 401:",{"_3464":70512,"_30135":70486,"_20936":117423,"_5":14366,"_27421":117367,"_2948":117424},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3464":70513,"_30135":70486,"_20936":117426,"_5":14366,"_27421":117367,"_2948":117427},[],"verifica emisor, audiencia y expiración del token;",{"_3464":70514,"_30135":70486,"_20936":117429,"_5":14366,"_27421":117367,"_2948":117430},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3464":70515,"_30135":70486,"_20936":117432,"_5":14366,"_27421":117367,"_2948":117433},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3464":70516,"_30135":70486,"_20936":117435,"_5":14366,"_27421":117367,"_2948":117436},[],"Si el login termina pero las APIs devuelven 403:",{"_3464":70517,"_30135":70486,"_20936":117438,"_5":14366,"_27421":117367,"_2948":117439},[],"inspecciona los claims reales del token;",{"_3464":70518,"_30135":70486,"_20936":117441,"_5":14366,"_27421":117367,"_2948":117442},[],"confirma que coinciden con un principal activo;",{"_3464":70519,"_30135":70486,"_20936":117444,"_5":14366,"_27421":117367,"_2948":117445},[],"revisa las políticas concedidas al principal;",{"_3464":70520,"_30135":70486,"_20936":117447,"_5":14366,"_27421":117367,"_2948":117448},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3464":70521,"_30135":70486,"_20936":117450,"_5":14366,"_27421":117367,"_2948":117451},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3464":70522,"_30135":70486,"_20936":117453,"_5":14366,"_27421":117371,"_2948":117454},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3464":70523,"_30135":70486,"_20936":117456,"_5":14366,"_27421":117371,"_2948":117457},[],"Localiza el pod y Service de authz.",{"_3464":70524,"_30135":70486,"_20936":117459,"_5":14366,"_27421":117371,"_2948":117460},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3464":70525,"_30135":70486,"_20936":117462,"_5":14366,"_27421":117371,"_2948":117463},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3464":70526,"_30135":70486,"_20936":117465,"_5":14366,"_27421":117371,"_2948":117466},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3464":70527,"_30135":70486,"_20936":117468,"_5":14366,"_27421":117371,"_2948":117469},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3464":70528,"_30135":70486,"_20936":117471,"_5":14366,"_27421":117375,"_2948":117472},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3464":70529,"_30135":70486,"_20936":117474,"_5":14366,"_27421":117379,"_2948":117475},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3464":70530,"_30135":70486,"_20936":117477,"_5":14366,"_27421":117379,"_2948":117478},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3464":70531,"_30135":70486,"_20936":117480,"_5":14366,"_27421":117379,"_2948":117481},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3464":70532,"_30135":70486,"_20936":117483,"_5":14366,"_27421":117379,"_2948":117484},[],"volumen persistente sin enlazar;",{"_3464":70533,"_30135":70486,"_20936":117486,"_5":14366,"_27421":117379,"_2948":117487},[],"imagen inaccesible o política de pull incorrecta;",{"_3464":70534,"_30135":70486,"_20936":117489,"_5":14366,"_27421":117379,"_2948":117490},[],"configuración inválida del motor criptográfico;",{"_3464":70535,"_30135":70486,"_20936":117492,"_5":14366,"_27421":117379,"_2948":117493},[],"límites de CPU o memoria demasiado bajos;",{"_3464":70536,"_30135":70486,"_20936":117495,"_5":14366,"_27421":117379,"_2948":117496},[],"migración previa incompleta.",{"_3464":70537,"_30135":70486,"_20936":117498,"_5":14366,"_27421":117379,"_2948":117499},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3464":70538,"_30135":70486,"_20936":117501,"_5":14366,"_27421":117379,"_2948":117502},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3464":70539,"_30135":70486,"_20936":117504,"_5":14366,"_27421":117379,"_2948":117505},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3464":70540,"_30135":70486,"_20936":117507,"_5":14366,"_27421":117383,"_2948":117508},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3464":70541,"_30135":70486,"_20936":117510,"_5":14366,"_27421":117383,"_2948":117511},[],"verifica que esté habilitado en el servicio emisor;",{"_3464":70542,"_30135":70486,"_20936":117513,"_5":14366,"_27421":117383,"_2948":117514},[],"comprueba conectividad y credenciales AMQP;",{"_3464":70543,"_30135":70486,"_20936":117516,"_5":14366,"_27421":117383,"_2948":117517},[],"revisa exchange, routing key, colas y consumidores;",{"_3464":70544,"_30135":70486,"_20936":117519,"_5":14366,"_27421":117383,"_2948":117520},[],"inspecciona dead-letter queues;",{"_3464":70545,"_30135":70486,"_20936":117522,"_5":14366,"_27421":117383,"_2948":117523},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3464":70546,"_30135":70486,"_20936":117525,"_5":14366,"_27421":117383,"_2948":117526},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3464":70547,"_30135":70486,"_20936":117528,"_5":14366,"_27421":117383,"_2948":117529},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3464":70548,"_30135":70486,"_20936":117531,"_5":14366,"_27421":117383,"_2948":117532},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3464":70549,"_30135":70486,"_20936":117534,"_5":14366,"_27421":117383,"_2948":117535},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3464":70550,"_30135":70486,"_20936":117537,"_5":14366,"_27421":117383,"_2948":117538},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3464":70551,"_30135":70486,"_20936":117540,"_5":14366,"_27421":117383,"_2948":117541},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3464":70552,"_30135":70486,"_20936":117543,"_5":14366,"_27421":117383,"_2948":117544},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3464":70553,"_30135":70486,"_20936":117546,"_5":14366,"_27421":117387,"_2948":117547},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3464":70554,"_30135":70486,"_20936":117549,"_5":14366,"_27421":117387,"_2948":117550},[],"Antes de cerrar una incidencia, guarda:",{"_3464":70555,"_30135":70486,"_20936":117552,"_5":14366,"_27421":117387,"_2948":117553},[],"causa confirmada;",{"_3464":70556,"_30135":70486,"_20936":117555,"_5":14366,"_27421":117387,"_2948":117556},[],"alcance temporal y recursos afectados;",{"_3464":70557,"_30135":70486,"_20936":117558,"_5":14366,"_27421":117387,"_2948":117559},[],"comandos o consultas utilizados;",{"_3464":70558,"_30135":70486,"_20936":117561,"_5":14366,"_27421":117387,"_2948":117562},[],"cambio aplicado y forma de revertirlo;",{"_3464":70559,"_30135":70486,"_20936":117564,"_5":14366,"_27421":117387,"_2948":117565},[],"validación desde un consumidor;",{"_3464":70560,"_30135":70486,"_20936":117567,"_5":14366,"_27421":117387,"_2948":117568},[],"acción preventiva y propietario.",{"_3464":70561,"_30135":70561,"_5":14718,"_2948":117570,"_30488":117571,"_20936":117574,"_27421":70561},"Control de acceso",[49202,117572,117573],"Plataforma","Administración",[],{"_3464":70562,"_30135":70561,"_20936":117576,"_5":14366,"_27421":70561,"_2948":117577},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3464":70563,"_30135":70561,"_5":30485,"_20936":117579,"_27421":117580,"_2948":117581},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3464":70564,"_30135":70561,"_5":30485,"_20936":117583,"_27421":117584,"_2948":117585},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3464":70565,"_30135":70561,"_5":30485,"_20936":117587,"_27421":117588,"_2948":117589},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3464":70566,"_30135":70561,"_5":30485,"_20936":117591,"_27421":117592,"_2948":117593},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3464":70567,"_30135":70561,"_5":30485,"_20936":117595,"_27421":117596,"_2948":117597},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3464":70568,"_30135":70561,"_5":30485,"_20936":117599,"_27421":117600,"_2948":117601},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3464":70569,"_30135":70561,"_5":30485,"_20936":117603,"_27421":117604,"_2948":117605},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3464":70570,"_30135":70561,"_5":30485,"_20936":117607,"_27421":117608,"_2948":117609},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3464":70571,"_30135":70561,"_5":30485,"_20936":117611,"_27421":117612,"_2948":117613},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3464":70572,"_30135":70561,"_5":30485,"_20936":117615,"_27421":117616,"_2948":117617},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3464":70573,"_30135":70561,"_5":30485,"_20936":117619,"_27421":117620,"_2948":117621},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3464":70574,"_30135":70561,"_5":30485,"_20936":117623,"_27421":117624,"_2948":117625},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3464":70575,"_30135":70561,"_5":30485,"_20936":117627,"_27421":117628,"_2948":117629},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3464":70576,"_30135":70561,"_5":30485,"_20936":117631,"_27421":117632,"_2948":117633},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3464":70577,"_30135":70561,"_5":30485,"_20936":117635,"_27421":117636,"_2948":117637},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3464":70578,"_30135":70561,"_5":30485,"_20936":117639,"_27421":117640,"_2948":116747},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3464":70579,"_30135":70561,"_5":30485,"_20936":117642,"_27421":117643,"_2948":117644},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3464":70580,"_30135":70561,"_5":30485,"_20936":117646,"_27421":117647,"_2948":117648},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3464":70581,"_30135":70561,"_5":30485,"_20936":117650,"_27421":117651,"_2948":117652},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3464":70582,"_30135":70561,"_5":30485,"_20936":117654,"_27421":117655,"_2948":117656},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3464":70583,"_30135":70561,"_5":30485,"_20936":117658,"_27421":117659,"_2948":117660},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3464":70584,"_30135":70561,"_5":30485,"_20936":117662,"_27421":117663,"_2948":117664},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3464":70585,"_30135":70561,"_5":30485,"_20936":117666,"_27421":117667,"_2948":117668},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3464":70586,"_30135":70561,"_5":30485,"_20936":117670,"_27421":117671,"_2948":117672},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3464":70587,"_30135":70561,"_5":30485,"_20936":117674,"_27421":117675,"_2948":117676},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3464":70588,"_30135":70561,"_5":30485,"_20936":117678,"_27421":117679,"_2948":117680},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3464":70589,"_30135":70561,"_5":30485,"_20936":117682,"_27421":117683,"_2948":117684},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3464":70590,"_30135":70561,"_5":30485,"_20936":117686,"_27421":117687,"_2948":117688},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3464":70591,"_30135":70561,"_5":30485,"_20936":117690,"_27421":117691,"_2948":117692},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3464":70592,"_30135":70561,"_5":30485,"_20936":117694,"_27421":117695,"_2948":117696},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3464":70593,"_30135":70561,"_5":30485,"_20936":117698,"_27421":117699,"_2948":117700},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3464":70594,"_30135":70561,"_20936":117702,"_5":14366,"_27421":70561,"_2948":117703},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3464":70595,"_30135":70561,"_20936":117705,"_5":14366,"_27421":70561,"_2948":117706},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3464":70596,"_30135":70561,"_20936":117708,"_5":14366,"_27421":70561,"_2948":117709},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3464":70597,"_30135":70561,"_20936":117711,"_5":14366,"_27421":117580,"_2948":117712},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3464":70598,"_30135":70561,"_20936":117714,"_5":14366,"_27421":117580,"_2948":117715},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3464":70599,"_30135":70561,"_20936":117717,"_5":14366,"_27421":117580,"_2948":117718},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3464":70600,"_30135":70561,"_20936":117720,"_5":14366,"_27421":117580,"_2948":117721},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3464":70601,"_30135":70561,"_20936":117723,"_5":14366,"_27421":117580,"_2948":117724},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3464":70602,"_30135":70561,"_20936":117726,"_5":14366,"_27421":117580,"_2948":117727},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3464":70603,"_30135":70561,"_20936":117729,"_5":14366,"_27421":117584,"_2948":117730},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3464":70604,"_30135":70561,"_20936":117732,"_5":14366,"_27421":117584,"_2948":117733},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3464":70605,"_30135":70561,"_20936":117735,"_5":14366,"_27421":117588,"_2948":117736},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3464":70606,"_30135":70561,"_20936":117738,"_5":14366,"_27421":117588,"_2948":117739},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3464":70607,"_30135":70561,"_20936":117741,"_5":14366,"_27421":117588,"_2948":117742},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3464":70608,"_30135":70561,"_20936":117744,"_5":14366,"_27421":117588,"_2948":117745},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3464":70609,"_30135":70561,"_20936":117747,"_5":14366,"_27421":117588,"_2948":117748},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3464":70610,"_30135":70561,"_20936":117750,"_5":14366,"_27421":117588,"_2948":117751},[],"Carga por separado las políticas concedidas a cada principal.",{"_3464":70611,"_30135":70561,"_20936":117753,"_5":14366,"_27421":117588,"_2948":117754},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3464":70612,"_30135":70561,"_20936":117756,"_5":14366,"_27421":117588,"_2948":117757},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3464":70613,"_30135":70561,"_20936":117759,"_5":14366,"_27421":117588,"_2948":117760},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3464":70614,"_30135":70561,"_20936":117762,"_5":14366,"_27421":117588,"_2948":117763},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3464":70615,"_30135":70561,"_20936":117765,"_5":14366,"_27421":117588,"_2948":117766},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3464":70616,"_30135":70561,"_20936":117768,"_5":14366,"_27421":117588,"_2948":117769},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3464":70617,"_30135":70561,"_20936":117771,"_5":14366,"_27421":117592,"_2948":117772},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3464":70618,"_30135":70561,"_20936":117774,"_5":14366,"_27421":117592,"_2948":117775},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3464":70619,"_30135":70561,"_20936":117777,"_5":14366,"_27421":117592,"_2948":117778},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3464":70620,"_30135":70561,"_20936":117780,"_5":14366,"_27421":117592,"_2948":117781},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3464":70621,"_30135":70561,"_20936":117783,"_5":14366,"_27421":117592,"_2948":117784},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3464":70622,"_30135":70561,"_20936":117786,"_5":14366,"_27421":117592,"_2948":117787},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3464":70623,"_30135":70561,"_20936":117789,"_5":14366,"_27421":117592,"_2948":117790},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3464":70624,"_30135":70561,"_20936":117792,"_5":14366,"_27421":117592,"_2948":117793},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3464":70625,"_30135":70561,"_20936":117795,"_5":14366,"_27421":117596,"_2948":117796},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3464":70626,"_30135":70561,"_20936":117798,"_5":14366,"_27421":117596,"_2948":117799},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3464":70627,"_30135":70561,"_20936":117801,"_5":14366,"_27421":117596,"_2948":117802},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3464":70628,"_30135":70561,"_20936":117804,"_5":14366,"_27421":117596,"_2948":117805},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3464":70629,"_30135":70561,"_20936":117807,"_5":14366,"_27421":117596,"_2948":117808},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3464":70630,"_30135":70561,"_20936":117810,"_5":14366,"_27421":117596,"_2948":117811},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3464":70631,"_30135":70561,"_20936":117813,"_5":14366,"_27421":117596,"_2948":117814},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3464":70632,"_30135":70561,"_20936":117816,"_5":14366,"_27421":117596,"_2948":117817},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3464":70633,"_30135":70561,"_20936":117819,"_5":14366,"_27421":117596,"_2948":117820},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3464":70634,"_30135":70561,"_20936":117822,"_5":14366,"_27421":117596,"_2948":117823},[],"Las acciones se dividen en dos grupos:",{"_3464":70635,"_30135":70561,"_20936":117825,"_5":14366,"_27421":117596,"_2948":117826},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3464":70636,"_30135":70561,"_20936":117828,"_5":14366,"_27421":117596,"_2948":117829},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3464":70637,"_30135":70561,"_20936":117831,"_5":14366,"_27421":117596,"_2948":117832},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3464":70638,"_30135":70561,"_20936":117834,"_5":14366,"_27421":117600,"_2948":117835},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3464":70639,"_30135":70561,"_20936":117837,"_5":14366,"_27421":117600,"_2948":117838},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3464":70640,"_30135":70561,"_20936":117840,"_5":14366,"_27421":117600,"_2948":117841},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3464":70641,"_30135":70561,"_20936":117843,"_5":14366,"_27421":117604,"_2948":117844},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3464":70642,"_30135":70561,"_20936":117846,"_5":14366,"_27421":117604,"_2948":117847},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3464":70643,"_30135":70561,"_20936":117849,"_5":14366,"_27421":117604,"_2948":117850},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3464":70644,"_30135":70561,"_20936":117852,"_5":14366,"_27421":117604,"_2948":117853},[],"Los operadores implementados son:",{"_3464":70645,"_30135":70561,"_20936":117855,"_5":14366,"_27421":117604,"_2948":117856},[],"`equals`, para igualdad exacta;",{"_3464":70646,"_30135":70561,"_20936":117858,"_5":14366,"_27421":117604,"_2948":117859},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3464":70647,"_30135":70561,"_20936":117861,"_5":14366,"_27421":117604,"_2948":117862},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3464":70648,"_30135":70561,"_20936":117864,"_5":14366,"_27421":117604,"_2948":117865},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3464":70649,"_30135":70561,"_20936":117867,"_5":14366,"_27421":117608,"_2948":117868},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3464":70650,"_30135":70561,"_20936":117870,"_5":14366,"_27421":117608,"_2948":117871},[],"Los modos disponibles son:",{"_3464":70651,"_30135":70561,"_20936":117873,"_5":14366,"_27421":117608,"_2948":117874},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3464":70652,"_30135":70561,"_20936":117876,"_5":14366,"_27421":117608,"_2948":117877},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3464":70653,"_30135":70561,"_20936":117879,"_5":14366,"_27421":117608,"_2948":117880},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3464":70654,"_30135":70561,"_20936":117882,"_5":14366,"_27421":117608,"_2948":117883},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3464":70655,"_30135":70561,"_20936":117885,"_5":14366,"_27421":117608,"_2948":117886},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3464":70656,"_30135":70561,"_20936":117888,"_5":14366,"_27421":117608,"_2948":117889},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3464":70657,"_30135":70561,"_20936":117891,"_5":14366,"_27421":117612,"_2948":117892},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3464":70658,"_30135":70561,"_20936":117894,"_5":14366,"_27421":117612,"_2948":117895},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3464":70659,"_30135":70561,"_20936":117897,"_5":14366,"_27421":117612,"_2948":117898},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3464":70660,"_30135":70561,"_20936":117900,"_5":14366,"_27421":117612,"_2948":117901},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3464":70661,"_30135":70561,"_20936":117903,"_5":14366,"_27421":117620,"_2948":117904},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3464":70662,"_30135":70561,"_20936":117906,"_5":14366,"_27421":117620,"_2948":117907},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3464":70663,"_30135":70561,"_20936":117909,"_5":14366,"_27421":117624,"_2948":117910},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3464":70664,"_30135":70561,"_20936":117912,"_5":14366,"_27421":117624,"_2948":117913},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3464":70665,"_30135":70561,"_20936":117915,"_5":14366,"_27421":117628,"_2948":117916},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3464":70666,"_30135":70561,"_20936":117918,"_5":14366,"_27421":117628,"_2948":117919},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3464":70667,"_30135":70561,"_20936":117921,"_5":14366,"_27421":117628,"_2948":117922},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3464":70668,"_30135":70561,"_20936":117924,"_5":14366,"_27421":117632,"_2948":117925},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3464":70669,"_30135":70561,"_20936":117927,"_5":14366,"_27421":117632,"_2948":117928},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3464":70670,"_30135":70561,"_20936":117930,"_5":14366,"_27421":117632,"_2948":117931},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3464":70671,"_30135":70561,"_20936":117933,"_5":14366,"_27421":117632,"_2948":117934},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3464":70672,"_30135":70561,"_20936":117936,"_5":14366,"_27421":117632,"_2948":117937},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3464":70673,"_30135":70561,"_20936":117939,"_5":14366,"_27421":117632,"_2948":117940},[],"Ten en cuenta que:",{"_3464":70674,"_30135":70561,"_20936":117942,"_5":14366,"_27421":117632,"_2948":117943},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3464":70675,"_30135":70561,"_20936":117945,"_5":14366,"_27421":117632,"_2948":117946},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3464":70676,"_30135":70561,"_20936":117948,"_5":14366,"_27421":117632,"_2948":117949},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3464":70677,"_30135":70561,"_20936":117951,"_5":14366,"_27421":117636,"_2948":117952},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3464":70678,"_30135":70561,"_20936":117954,"_5":14366,"_27421":117636,"_2948":117955},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3464":70679,"_30135":70561,"_20936":117957,"_5":14366,"_27421":117636,"_2948":117958},[],"acceso completo y de solo lectura a KMS;",{"_3464":70680,"_30135":70561,"_20936":117960,"_5":14366,"_27421":117636,"_2948":117961},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3464":70681,"_30135":70561,"_20936":117963,"_5":14366,"_27421":117636,"_2948":117964},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3464":70682,"_30135":70561,"_20936":117966,"_5":14366,"_27421":117636,"_2948":117967},[],"acceso a la interfaz;",{"_3464":70683,"_30135":70561,"_20936":117969,"_5":14366,"_27421":117636,"_2948":117970},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3464":70684,"_30135":70561,"_20936":117972,"_5":14366,"_27421":117636,"_2948":117973},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3464":70685,"_30135":70561,"_20936":117975,"_5":14366,"_27421":117636,"_2948":117976},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3464":70686,"_30135":70561,"_20936":117978,"_5":14366,"_27421":117640,"_2948":117979},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3464":70687,"_30135":70561,"_20936":117981,"_5":14366,"_27421":117640,"_2948":117982},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3464":70688,"_30135":70561,"_20936":117984,"_5":14366,"_27421":117640,"_2948":117985},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3464":70689,"_30135":70561,"_20936":117987,"_5":14366,"_27421":117643,"_2948":117988},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3464":70690,"_30135":70561,"_20936":117990,"_5":14366,"_27421":117647,"_2948":117991},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3464":70691,"_30135":70561,"_20936":117993,"_5":14366,"_27421":117647,"_2948":117994},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3464":70692,"_30135":70561,"_20936":117996,"_5":14366,"_27421":117651,"_2948":117997},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3464":70693,"_30135":70561,"_20936":117999,"_5":14366,"_27421":117655,"_2948":118000},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3464":70694,"_30135":70561,"_20936":118002,"_5":14366,"_27421":117659,"_2948":118003},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3464":70695,"_30135":70561,"_20936":118005,"_5":14366,"_27421":117663,"_2948":118006},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3464":70696,"_30135":70561,"_20936":118008,"_5":14366,"_27421":117663,"_2948":118009},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3464":70697,"_30135":70561,"_20936":118011,"_5":14366,"_27421":117667,"_2948":118012},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3464":70698,"_30135":70561,"_20936":118014,"_5":14366,"_27421":117667,"_2948":118015},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3464":70699,"_30135":70561,"_20936":118017,"_5":14366,"_27421":117667,"_2948":118018},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3464":70700,"_30135":70561,"_20936":118020,"_5":14366,"_27421":117667,"_2948":118021},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3464":70701,"_30135":70561,"_20936":118023,"_5":14366,"_27421":117667,"_2948":118024},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3464":70702,"_30135":70561,"_20936":118026,"_5":14366,"_27421":117667,"_2948":118027},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3464":70703,"_30135":70561,"_20936":118029,"_5":14366,"_27421":117667,"_2948":118030},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3464":70704,"_30135":70561,"_20936":118032,"_5":14366,"_27421":117667,"_2948":118033},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3464":70705,"_30135":70561,"_20936":118035,"_5":14366,"_27421":117671,"_2948":118036},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3464":70706,"_30135":70561,"_20936":118038,"_5":14366,"_27421":117671,"_2948":118039},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3464":70707,"_30135":70561,"_20936":118041,"_5":14366,"_27421":117671,"_2948":118042},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3464":70708,"_30135":70561,"_20936":118044,"_5":14366,"_27421":117675,"_2948":118045},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3464":70709,"_30135":70561,"_20936":118047,"_5":14366,"_27421":117675,"_2948":118048},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3464":70710,"_30135":70561,"_20936":118050,"_5":14366,"_27421":117675,"_2948":118051},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3464":70711,"_30135":70561,"_20936":118053,"_5":14366,"_27421":117675,"_2948":118054},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3464":70712,"_30135":70561,"_20936":118056,"_5":14366,"_27421":117675,"_2948":118057},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3464":70713,"_30135":70561,"_20936":118059,"_5":14366,"_27421":117675,"_2948":118060},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3464":70714,"_30135":70561,"_20936":118062,"_5":14366,"_27421":117675,"_2948":118063},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3464":70715,"_30135":70561,"_20936":118065,"_5":14366,"_27421":117675,"_2948":118066},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3464":70716,"_30135":70561,"_20936":118068,"_5":14366,"_27421":117683,"_2948":118069},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3464":70717,"_30135":70561,"_20936":118071,"_5":14366,"_27421":117687,"_2948":118072},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3464":70718,"_30135":70561,"_20936":118074,"_5":14366,"_27421":117687,"_2948":118075},[],"que exista un principal activo del tipo correcto;",{"_3464":70719,"_30135":70561,"_20936":118077,"_5":14366,"_27421":117687,"_2948":118078},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3464":70720,"_30135":70561,"_20936":118080,"_5":14366,"_27421":117687,"_2948":118081},[],"que todas las condiciones del principal se cumplan;",{"_3464":70721,"_30135":70561,"_20936":118083,"_5":14366,"_27421":117687,"_2948":118084},[],"que el principal tenga concedida la política esperada;",{"_3464":70722,"_30135":70561,"_20936":118086,"_5":14366,"_27421":117687,"_2948":118087},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3464":70723,"_30135":70561,"_20936":118089,"_5":14366,"_27421":117687,"_2948":118090},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3464":70724,"_30135":70561,"_20936":118092,"_5":14366,"_27421":117687,"_2948":118093},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3464":70725,"_30135":70561,"_20936":118095,"_5":14366,"_27421":117691,"_2948":118096},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3464":70726,"_30135":70561,"_20936":118098,"_5":14366,"_27421":117695,"_2948":118099},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3464":70727,"_30135":70561,"_20936":118101,"_5":14366,"_27421":117699,"_2948":118102},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3464":70728,"_30135":70561,"_20936":118104,"_5":14366,"_27421":117699,"_2948":118105},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3464":70729,"_30135":70729,"_5":14718,"_2948":118107,"_30488":118108,"_20936":118109,"_27421":70729},"Alertas y suscripciones",[49202,117572,117573],[],{"_3464":70730,"_30135":70729,"_20936":118111,"_5":14366,"_27421":70729,"_2948":118112},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3464":70731,"_30135":70729,"_5":30485,"_20936":118114,"_27421":118115,"_2948":118116},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3464":70732,"_30135":70729,"_5":30485,"_20936":118118,"_27421":118119,"_2948":118120},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3464":70733,"_30135":70729,"_5":30485,"_20936":118122,"_27421":118123,"_2948":118124},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3464":70734,"_30135":70729,"_5":30485,"_20936":118126,"_27421":118127,"_2948":118128},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3464":70735,"_30135":70729,"_5":30485,"_20936":118130,"_27421":118131,"_2948":118132},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3464":70736,"_30135":70729,"_5":30485,"_20936":118134,"_27421":118135,"_2948":118136},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3464":70737,"_30135":70729,"_5":30485,"_20936":118138,"_27421":118139,"_2948":118140},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3464":70738,"_30135":70729,"_5":30485,"_20936":118142,"_27421":118143,"_2948":118144},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3464":70739,"_30135":70729,"_5":30485,"_20936":118146,"_27421":118147,"_2948":118148},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3464":70740,"_30135":70729,"_5":30485,"_20936":118150,"_27421":118151,"_2948":118152},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3464":70741,"_30135":70729,"_5":30485,"_20936":118154,"_27421":118155,"_2948":118156},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3464":70742,"_30135":70729,"_20936":118158,"_5":14366,"_27421":70729,"_2948":118159},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3464":70743,"_30135":70729,"_20936":118161,"_5":14366,"_27421":118115,"_2948":118162},[],"Un servicio publica un evento de dominio.",{"_3464":70744,"_30135":70729,"_20936":118164,"_5":14366,"_27421":118115,"_2948":118165},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3464":70745,"_30135":70729,"_20936":118167,"_5":14366,"_27421":118115,"_2948":118168},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3464":70746,"_30135":70729,"_20936":118170,"_5":14366,"_27421":118115,"_2948":118171},[],"Lamassu entrega el evento al canal configurado.",{"_3464":70747,"_30135":70729,"_20936":118173,"_5":14366,"_27421":118115,"_2948":118174},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3464":70748,"_30135":70729,"_20936":118176,"_5":14366,"_27421":118119,"_2948":118177},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3464":70749,"_30135":70729,"_20936":118179,"_5":14366,"_27421":118119,"_2948":118180},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3464":70750,"_30135":70729,"_20936":118182,"_5":14366,"_27421":118119,"_2948":118183},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3464":70751,"_30135":70729,"_20936":118185,"_5":14366,"_27421":118119,"_2948":118186},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3464":70752,"_30135":70729,"_20936":118188,"_5":14366,"_27421":118119,"_2948":118189},[],"`apikey_options` necesita `header` y `key`.",{"_3464":70753,"_30135":70729,"_20936":118191,"_5":14366,"_27421":118119,"_2948":118192},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3464":70754,"_30135":70729,"_20936":118194,"_5":14366,"_27421":118119,"_2948":118195},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3464":70755,"_30135":70729,"_20936":118197,"_5":14366,"_27421":118119,"_2948":118198},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3464":70756,"_30135":70729,"_20936":118200,"_5":14366,"_27421":118127,"_2948":118201},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3464":70757,"_30135":70729,"_20936":118203,"_5":14366,"_27421":118131,"_2948":118204},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3464":70758,"_30135":70729,"_20936":118206,"_5":14366,"_27421":118135,"_2948":118207},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3464":70759,"_30135":70729,"_20936":118209,"_5":14366,"_27421":118135,"_2948":118210},[],"**None** notifica todas las instancias del evento.",{"_3464":70760,"_30135":70729,"_20936":118212,"_5":14366,"_27421":118135,"_2948":118213},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3464":70761,"_30135":70729,"_20936":118215,"_5":14366,"_27421":118135,"_2948":118216},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3464":70762,"_30135":70729,"_20936":118218,"_5":14366,"_27421":118135,"_2948":118219},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3464":70763,"_30135":70729,"_20936":118221,"_5":14366,"_27421":118135,"_2948":118222},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3464":70764,"_30135":70729,"_20936":118224,"_5":14366,"_27421":118135,"_2948":118225},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3464":70765,"_30135":70729,"_20936":118227,"_5":14366,"_27421":118139,"_2948":118228},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3464":70766,"_30135":70729,"_20936":118230,"_5":14366,"_27421":118143,"_2948":118231},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3464":70767,"_30135":70729,"_20936":118233,"_5":14366,"_27421":118143,"_2948":118234},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3464":70768,"_30135":70729,"_20936":118236,"_5":14366,"_27421":118143,"_2948":118237},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3464":70769,"_30135":70729,"_20936":118239,"_5":14366,"_27421":118143,"_2948":118240},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3464":70770,"_30135":70729,"_20936":118242,"_5":14366,"_27421":118143,"_2948":118243},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3464":70771,"_30135":70729,"_20936":118245,"_5":14366,"_27421":118143,"_2948":118246},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3464":70772,"_30135":70729,"_20936":118248,"_5":14366,"_27421":118143,"_2948":118249},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3464":70773,"_30135":70729,"_20936":118251,"_5":14366,"_27421":118143,"_2948":118252},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3464":70774,"_30135":70729,"_20936":118254,"_5":14366,"_27421":118147,"_2948":118255},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3464":70775,"_30135":70729,"_20936":118257,"_5":14366,"_27421":118147,"_2948":118258},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3464":70776,"_30135":70729,"_20936":118260,"_5":14366,"_27421":118147,"_2948":118261},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3464":70777,"_30135":70729,"_20936":118263,"_5":14366,"_27421":118147,"_2948":118264},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3464":70778,"_30135":70729,"_20936":118266,"_5":14366,"_27421":118147,"_2948":118267},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3464":70779,"_30135":70729,"_20936":118269,"_5":14366,"_27421":118147,"_2948":118270},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3464":70780,"_30135":70729,"_20936":118272,"_5":14366,"_27421":118147,"_2948":118273},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3464":70781,"_30135":70729,"_20936":118275,"_5":14366,"_27421":118147,"_2948":118276},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3464":70782,"_30135":70729,"_20936":118278,"_5":14366,"_27421":118151,"_2948":118279},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3464":70783,"_30135":70729,"_20936":118281,"_5":14366,"_27421":118151,"_2948":118282},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3464":70784,"_30135":70729,"_20936":118284,"_5":14366,"_27421":118155,"_2948":118285},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3464":70785,"_30135":70729,"_20936":118287,"_5":14366,"_27421":118155,"_2948":118288},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3464":70786,"_30135":70729,"_20936":118290,"_5":14366,"_27421":118155,"_2948":118291},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3464":70787,"_30135":70729,"_20936":118293,"_5":14366,"_27421":118155,"_2948":118294},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3464":70788,"_30135":70729,"_20936":118296,"_5":14366,"_27421":118155,"_2948":118297},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3464":70789,"_30135":70729,"_20936":118299,"_5":14366,"_27421":118155,"_2948":118300},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3464":70790,"_30135":70729,"_20936":118302,"_5":14366,"_27421":118155,"_2948":118303},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3464":70791,"_30135":70729,"_20936":118305,"_5":14366,"_27421":118155,"_2948":118306},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3464":70792,"_30135":70729,"_20936":118308,"_5":14366,"_27421":118155,"_2948":118309},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3464":70793,"_30135":70793,"_5":14718,"_2948":118311,"_30488":118312,"_20936":118313,"_27421":70793},"Registros de auditoría",[49202,117572,117573],[],{"_3464":70794,"_30135":70793,"_20936":118315,"_5":14366,"_27421":70793,"_2948":118316},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3464":70795,"_30135":70793,"_5":30485,"_20936":118318,"_27421":118319,"_2948":118320},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3464":70796,"_30135":70793,"_5":30485,"_20936":118322,"_27421":118323,"_2948":118324},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3464":70797,"_30135":70793,"_5":30485,"_20936":118326,"_27421":118327,"_2948":118328},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3464":70798,"_30135":70793,"_5":30485,"_20936":118330,"_27421":118331,"_2948":118332},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3464":70799,"_30135":70793,"_5":30485,"_20936":118334,"_27421":118335,"_2948":118336},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3464":70800,"_30135":70793,"_5":30485,"_20936":118338,"_27421":118339,"_2948":118340},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3464":70801,"_30135":70793,"_5":30485,"_20936":118342,"_27421":118343,"_2948":118344},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3464":70802,"_30135":70793,"_5":30485,"_20936":118346,"_27421":118347,"_2948":118348},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3464":70803,"_30135":70793,"_5":30485,"_20936":118350,"_27421":118351,"_2948":118352},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3464":70804,"_30135":70793,"_5":30485,"_20936":118354,"_27421":118355,"_2948":118356},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3464":70805,"_30135":70793,"_5":30485,"_20936":118358,"_27421":118359,"_2948":118360},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3464":70806,"_30135":70793,"_20936":118362,"_5":14366,"_27421":70793,"_2948":118363},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3464":70807,"_30135":70793,"_20936":118365,"_5":14366,"_27421":118319,"_2948":118366},[],"El cuerpo de auditoría incluye:",{"_3464":70808,"_30135":70793,"_20936":118368,"_5":14366,"_27421":118319,"_2948":118369},[],"input: datos recibidos por la operación;",{"_3464":70809,"_30135":70793,"_20936":118371,"_5":14366,"_27421":118319,"_2948":118372},[],"has\\_error: indica si el servicio devolvió un error;",{"_3464":70810,"_30135":70793,"_20936":118374,"_5":14366,"_27421":118319,"_2948":118375},[],"output: resultado producido o mensaje de error;",{"_3464":70811,"_30135":70793,"_20936":118377,"_5":14366,"_27421":118319,"_2948":118378},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3464":70812,"_30135":70793,"_20936":118380,"_5":14366,"_27421":118319,"_2948":118381},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3464":70813,"_30135":70793,"_20936":118383,"_5":14366,"_27421":118319,"_2948":118384},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3464":70814,"_30135":70793,"_20936":118386,"_5":14366,"_27421":118323,"_2948":118387},[],"El backend aplica auditoría a mutaciones de:",{"_3464":70815,"_30135":70793,"_20936":118389,"_5":14366,"_27421":118323,"_2948":118390},[],"autoridades, certificados y perfiles de emisión;",{"_3464":70816,"_30135":70793,"_20936":118392,"_5":14366,"_27421":118323,"_2948":118393},[],"claves y motores KMS;",{"_3464":70817,"_30135":70793,"_20936":118395,"_5":14366,"_27421":118323,"_2948":118396},[],"dispositivos e identidades;",{"_3464":70818,"_30135":70793,"_20936":118398,"_5":14366,"_27421":118323,"_2948":118399},[],"DMS y operaciones de enrolamiento;",{"_3464":70819,"_30135":70793,"_20936":118401,"_5":14366,"_27421":118323,"_2948":118402},[],"funciones de validación y CRL;",{"_3464":70820,"_30135":70793,"_20936":118404,"_5":14366,"_27421":118323,"_2948":118405},[],"principales, políticas y concesiones de autorización.",{"_3464":70821,"_30135":70793,"_20936":118407,"_5":14366,"_27421":118323,"_2948":118408},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3464":70822,"_30135":70793,"_20936":118410,"_5":14366,"_27421":118327,"_2948":118411},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3464":70823,"_30135":70793,"_20936":118413,"_5":14366,"_27421":118327,"_2948":118414},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3464":70824,"_30135":70793,"_20936":118416,"_5":14366,"_27421":118327,"_2948":118417},[],"Diseña el consumidor para:",{"_3464":70825,"_30135":70793,"_20936":118419,"_5":14366,"_27421":118327,"_2948":118420},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3464":70826,"_30135":70793,"_20936":118422,"_5":14366,"_27421":118327,"_2948":118423},[],"conservar el CloudEvent completo sin modificar;",{"_3464":70827,"_30135":70793,"_20936":118425,"_5":14366,"_27421":118327,"_2948":118426},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3464":70828,"_30135":70793,"_20936":118428,"_5":14366,"_27421":118327,"_2948":118429},[],"cifrar en tránsito y en reposo;",{"_3464":70829,"_30135":70793,"_20936":118431,"_5":14366,"_27421":118327,"_2948":118432},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3464":70830,"_30135":70793,"_20936":118434,"_5":14366,"_27421":118327,"_2948":118435},[],"aplicar una política explícita de retención y legal hold;",{"_3464":70831,"_30135":70793,"_20936":118437,"_5":14366,"_27421":118327,"_2948":118438},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3464":70832,"_30135":70793,"_20936":118440,"_5":14366,"_27421":118331,"_2948":118441},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3464":70833,"_30135":70793,"_20936":118443,"_5":14366,"_27421":118331,"_2948":118444},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3464":70834,"_30135":70793,"_20936":118446,"_5":14366,"_27421":118339,"_2948":118447},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3464":70835,"_30135":70793,"_20936":118449,"_5":14366,"_27421":118343,"_2948":118450},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3464":70836,"_30135":70793,"_20936":118452,"_5":14366,"_27421":118347,"_2948":118453},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3464":70837,"_30135":70793,"_20936":118455,"_5":14366,"_27421":118351,"_2948":118456},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3464":70838,"_30135":70793,"_20936":118458,"_5":14366,"_27421":118355,"_2948":118459},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3464":70839,"_30135":70793,"_20936":118461,"_5":14366,"_27421":118359,"_2948":118462},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3464":70840,"_30135":70793,"_20936":118464,"_5":14366,"_27421":118359,"_2948":118465},[],"aparece un evento de auditoría correcto;",{"_3464":70841,"_30135":70793,"_20936":118467,"_5":14366,"_27421":118359,"_2948":118468},[],"el principal coincide con la identidad utilizada;",{"_3464":70842,"_30135":70793,"_20936":118470,"_5":14366,"_27421":118359,"_2948":118471},[],"el consumidor lo persiste una sola vez;",{"_3464":70843,"_30135":70793,"_20936":118473,"_5":14366,"_27421":118359,"_2948":118474},[],"puede recuperarse por recurso, actor y periodo;",{"_3464":70844,"_30135":70793,"_20936":118476,"_5":14366,"_27421":118359,"_2948":118477},[],"una interrupción del consumidor produce una alerta.",{"_3464":70845,"_30135":70793,"_20936":118479,"_5":14366,"_27421":118359,"_2948":118480},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3464":70846,"_30135":70846,"_5":14718,"_2948":118482,"_30488":118483,"_20936":118484,"_27421":70846},"Arquitectura de la plataforma",[49202,117572],[],{"_3464":70847,"_30135":70846,"_20936":118486,"_5":14366,"_27421":70846,"_2948":118487},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3464":70848,"_30135":70846,"_5":30485,"_20936":118489,"_27421":118490,"_2948":118491},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3464":70849,"_30135":70846,"_5":30485,"_20936":118493,"_27421":118494,"_2948":118495},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3464":70850,"_30135":70846,"_5":30485,"_20936":118497,"_27421":118498,"_2948":118499},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3464":70851,"_30135":70846,"_5":30485,"_20936":118501,"_27421":118502,"_2948":118503},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3464":70852,"_30135":70846,"_5":30485,"_20936":118505,"_27421":118506,"_2948":118507},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3464":70853,"_30135":70846,"_20936":118509,"_5":14366,"_27421":70846,"_2948":118510},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3464":70854,"_30135":70846,"_20936":118512,"_5":14366,"_27421":70846,"_2948":118513},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3464":70855,"_30135":70846,"_20936":118515,"_5":14366,"_27421":118490,"_2948":118516},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3464":70856,"_30135":70846,"_20936":118518,"_5":14366,"_27421":118494,"_2948":118519},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3464":70857,"_30135":70846,"_20936":118521,"_5":14366,"_27421":118498,"_2948":118522},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3464":70858,"_30135":70846,"_20936":118524,"_5":14366,"_27421":118502,"_2948":118525},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3464":70859,"_30135":70846,"_20936":118527,"_5":14366,"_27421":118506,"_2948":118528},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3464":70860,"_30135":70860,"_5":14718,"_2948":118530,"_30488":118531,"_20936":118532,"_27421":70860},"Cómo funciona Lamassu",[49202,117572],[],{"_3464":70861,"_30135":70860,"_20936":118534,"_5":14366,"_27421":70860,"_2948":118535},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3464":70862,"_30135":70860,"_5":30485,"_20936":118537,"_27421":118538,"_2948":118539},[],"/docs/pr-preview/pr-61/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3464":70863,"_30135":70860,"_5":30485,"_20936":118541,"_27421":118542,"_2948":118543},[],"/docs/pr-preview/pr-61/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3464":70864,"_30135":70860,"_20936":118545,"_5":14366,"_27421":70860,"_2948":118546},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3464":70865,"_30135":70860,"_20936":118548,"_5":14366,"_27421":118538,"_2948":118549},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3464":70866,"_30135":70860,"_20936":118551,"_5":14366,"_27421":118538,"_2948":118552},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3464":70867,"_30135":70860,"_20936":118554,"_5":14366,"_27421":118538,"_2948":118555},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3464":70868,"_30135":70860,"_20936":118557,"_5":14366,"_27421":118538,"_2948":118558},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3464":70869,"_30135":70860,"_20936":118560,"_5":14366,"_27421":118538,"_2948":118561},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3464":70870,"_30135":70860,"_20936":118563,"_5":14366,"_27421":118542,"_2948":118564},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3464":70871,"_30135":70860,"_20936":118566,"_5":14366,"_27421":118542,"_2948":118567},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3464":70872,"_30135":70860,"_20936":118569,"_5":14366,"_27421":118542,"_2948":118570},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3464":70873,"_30135":70860,"_20936":118572,"_5":14366,"_27421":118542,"_2948":118573},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3464":70874,"_30135":70860,"_20936":118575,"_5":14366,"_27421":118542,"_2948":118576},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3464":70875,"_30135":70860,"_20936":118578,"_5":14366,"_27421":118542,"_2948":118579},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3464":70876,"_30135":70860,"_20936":118581,"_5":14366,"_27421":118542,"_2948":118582},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3464":70877,"_30135":70877,"_5":14718,"_2948":118584,"_30488":118585,"_20936":118586,"_27421":70877},"Dispositivos e identidades",[49202,117572,51684,118584],[],{"_3464":70878,"_30135":70877,"_20936":118588,"_5":14366,"_27421":70877,"_2948":118589},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3464":70879,"_30135":70877,"_5":30485,"_20936":118591,"_27421":118592,"_2948":118593},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3464":70880,"_30135":70877,"_5":30485,"_20936":118595,"_27421":118596,"_2948":118597},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3464":70881,"_30135":70877,"_5":30485,"_20936":118599,"_27421":118600,"_2948":118601},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3464":70882,"_30135":70877,"_5":30485,"_20936":118603,"_27421":118604,"_2948":118605},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3464":70883,"_30135":70877,"_5":30485,"_20936":118607,"_27421":118608,"_2948":118609},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3464":70884,"_30135":70877,"_5":30485,"_20936":118611,"_27421":118612,"_2948":118613},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3464":70885,"_30135":70877,"_5":30485,"_20936":118615,"_27421":118616,"_2948":118617},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3464":70886,"_30135":70877,"_5":30485,"_20936":118619,"_27421":118620,"_2948":118621},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3464":70887,"_30135":70877,"_5":30485,"_20936":118623,"_27421":118624,"_2948":118625},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3464":70888,"_30135":70877,"_5":30485,"_20936":118627,"_27421":118628,"_2948":118629},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3464":70889,"_30135":70877,"_5":30485,"_20936":118631,"_27421":118632,"_2948":118633},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3464":70890,"_30135":70877,"_20936":118635,"_5":14366,"_27421":70877,"_2948":118636},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3464":70891,"_30135":70877,"_20936":118638,"_5":14366,"_27421":70877,"_2948":118639},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3464":70892,"_30135":70877,"_20936":118641,"_5":14366,"_27421":118592,"_2948":118642},[],"Vista operativa",{"_3464":70893,"_30135":70877,"_20936":118644,"_5":14366,"_27421":118592,"_2948":118645},[],"Interpretación",{"_3464":70894,"_30135":70877,"_20936":118647,"_5":14366,"_27421":118592,"_2948":51747},[],{"_3464":70895,"_30135":70877,"_20936":118649,"_5":14366,"_27421":118592,"_2948":118650},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3464":70896,"_30135":70877,"_20936":118652,"_5":14366,"_27421":118592,"_2948":51753},[],{"_3464":70897,"_30135":70877,"_20936":118654,"_5":14366,"_27421":118592,"_2948":118655},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3464":70898,"_30135":70877,"_20936":118657,"_5":14366,"_27421":118592,"_2948":51759},[],{"_3464":70899,"_30135":70877,"_20936":118659,"_5":14366,"_27421":118592,"_2948":118660},[],"La identidad está en la ventana operativa de renovación.",{"_3464":70900,"_30135":70877,"_20936":118662,"_5":14366,"_27421":118592,"_2948":51765},[],{"_3464":70901,"_30135":70877,"_20936":118664,"_5":14366,"_27421":118592,"_2948":118665},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3464":70902,"_30135":70877,"_20936":118667,"_5":14366,"_27421":118592,"_2948":51771},[],{"_3464":70903,"_30135":70877,"_20936":118669,"_5":14366,"_27421":118592,"_2948":118670},[],"La identidad ha vencido.",{"_3464":70904,"_30135":70877,"_20936":118672,"_5":14366,"_27421":118592,"_2948":51777},[],{"_3464":70905,"_30135":70877,"_20936":118674,"_5":14366,"_27421":118592,"_2948":118675},[],"La identidad está marcada como revocada.",{"_3464":70906,"_30135":70877,"_20936":118677,"_5":14366,"_27421":118592,"_2948":51783},[],{"_3464":70907,"_30135":70877,"_20936":118679,"_5":14366,"_27421":118592,"_2948":118680},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3464":70908,"_30135":70877,"_20936":118682,"_5":14366,"_27421":118592,"_2948":118683},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3464":70909,"_30135":70877,"_20936":118685,"_5":14366,"_27421":118596,"_2948":118686},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3464":70910,"_30135":70877,"_20936":118688,"_5":14366,"_27421":118596,"_2948":118689},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3464":70911,"_30135":70877,"_20936":118691,"_5":14366,"_27421":118596,"_2948":118692},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3464":70912,"_30135":70877,"_20936":118694,"_5":14366,"_27421":118596,"_2948":118695},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3464":70913,"_30135":70877,"_20936":118697,"_5":14366,"_27421":118600,"_2948":118698},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3464":70914,"_30135":70877,"_20936":118700,"_5":14366,"_27421":118604,"_2948":118701},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3464":70915,"_30135":70877,"_20936":118703,"_5":14366,"_27421":118608,"_2948":118704},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3464":70916,"_30135":70877,"_20936":118706,"_5":14366,"_27421":118612,"_2948":118707},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3464":70917,"_30135":70877,"_20936":118709,"_5":14366,"_27421":118616,"_2948":118710},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3464":70918,"_30135":70877,"_20936":118712,"_5":14366,"_27421":118616,"_2948":118713},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3464":70919,"_30135":70877,"_20936":118715,"_5":14366,"_27421":118620,"_2948":118716},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3464":70920,"_30135":70877,"_20936":118718,"_5":14366,"_27421":118620,"_2948":118719},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3464":70921,"_30135":70877,"_20936":118721,"_5":14366,"_27421":118620,"_2948":118722},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3464":70922,"_30135":70877,"_20936":118724,"_5":14366,"_27421":118620,"_2948":118725},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3464":70923,"_30135":70877,"_20936":118727,"_5":14366,"_27421":118620,"_2948":118728},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3464":70924,"_30135":70877,"_20936":118730,"_5":14366,"_27421":118620,"_2948":118731},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3464":70925,"_30135":70877,"_20936":118733,"_5":14366,"_27421":118624,"_2948":118734},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3464":70926,"_30135":70877,"_20936":118736,"_5":14366,"_27421":118624,"_2948":118737},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3464":70927,"_30135":70877,"_20936":118739,"_5":14366,"_27421":118628,"_2948":118740},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3464":70928,"_30135":70877,"_20936":118742,"_5":14366,"_27421":118628,"_2948":118743},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3464":70929,"_30135":70877,"_20936":118745,"_5":14366,"_27421":118628,"_2948":118746},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3464":70930,"_30135":70877,"_20936":118748,"_5":14366,"_27421":118628,"_2948":118749},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3464":70931,"_30135":70877,"_20936":118751,"_5":14366,"_27421":118632,"_2948":118752},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3464":70932,"_30135":70877,"_20936":118754,"_5":14366,"_27421":118632,"_2948":118755},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3464":70933,"_30135":70933,"_5":14718,"_2948":118757,"_30488":118758,"_20936":118760,"_27421":70933},"Identidad inicial y autenticación",[49202,117572,51684,118584,118759],"Enrolamiento con PKI",[],{"_3464":70934,"_30135":70933,"_20936":118762,"_5":14366,"_27421":70933,"_2948":118763},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3464":70935,"_30135":70933,"_5":30485,"_20936":118765,"_27421":118766,"_2948":118767},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3464":70936,"_30135":70933,"_5":30485,"_20936":118769,"_27421":118770,"_2948":118771},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3464":70937,"_30135":70933,"_5":30485,"_20936":118773,"_27421":118774,"_2948":118775},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3464":70938,"_30135":70933,"_5":30485,"_20936":118777,"_27421":118778,"_2948":118779},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3464":70939,"_30135":70933,"_5":30485,"_20936":118781,"_27421":118782,"_2948":118783},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3464":70940,"_30135":70933,"_20936":118785,"_5":14366,"_27421":70933,"_2948":118786},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3464":70941,"_30135":70933,"_20936":118788,"_5":14366,"_27421":118766,"_2948":118789},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3464":70942,"_30135":70933,"_20936":118791,"_5":14366,"_27421":118766,"_2948":118792},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3464":70943,"_30135":70933,"_20936":118794,"_5":14366,"_27421":118770,"_2948":118795},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3464":70944,"_30135":70933,"_20936":118797,"_5":14366,"_27421":118770,"_2948":118798},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3464":70945,"_30135":70933,"_20936":118800,"_5":14366,"_27421":118770,"_2948":118801},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3464":70946,"_30135":70933,"_20936":118803,"_5":14366,"_27421":118774,"_2948":118804},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3464":70947,"_30135":70933,"_20936":118806,"_5":14366,"_27421":118774,"_2948":118807},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3464":70948,"_30135":70933,"_20936":118809,"_5":14366,"_27421":118778,"_2948":118810},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3464":70949,"_30135":70933,"_20936":118812,"_5":14366,"_27421":118778,"_2948":118813},[],"Ejemplo de cuerpo:",{"_3464":70950,"_30135":70933,"_20936":118815,"_5":14366,"_27421":118778,"_2948":118816},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3464":70951,"_30135":70933,"_20936":118818,"_5":14366,"_27421":118778,"_2948":118819},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3464":70952,"_30135":70933,"_20936":118821,"_5":14366,"_27421":118778,"_2948":118822},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3464":70953,"_30135":70933,"_20936":118824,"_5":14366,"_27421":118778,"_2948":118825},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3464":70954,"_30135":70933,"_20936":118827,"_5":14366,"_27421":118782,"_2948":118828},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3464":70955,"_30135":70933,"_20936":118830,"_5":14366,"_27421":118782,"_2948":118831},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3464":70956,"_30135":70956,"_5":14718,"_2948":118833,"_30488":118834,"_20936":118835,"_27421":70956},"Configura y opera el DMS",[49202,117572,51684,118584,118759],[],{"_3464":70957,"_30135":70956,"_20936":118837,"_5":14366,"_27421":70956,"_2948":118838},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3464":70958,"_30135":70956,"_5":30485,"_20936":118840,"_27421":118841,"_2948":116150},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3464":70959,"_30135":70956,"_5":30485,"_20936":118843,"_27421":118844,"_2948":118845},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3464":70960,"_30135":70956,"_5":30485,"_20936":118847,"_27421":118848,"_2948":118849},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3464":70961,"_30135":70956,"_5":30485,"_20936":118851,"_27421":118852,"_2948":118853},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3464":70962,"_30135":70956,"_5":30485,"_20936":118855,"_27421":118856,"_2948":118857},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3464":70963,"_30135":70956,"_5":30485,"_20936":118859,"_27421":118860,"_2948":118861},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3464":70964,"_30135":70956,"_5":30485,"_20936":118863,"_27421":118864,"_2948":118865},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3464":70965,"_30135":70956,"_5":30485,"_20936":118867,"_27421":118868,"_2948":118869},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3464":70966,"_30135":70956,"_5":30485,"_20936":118871,"_27421":118872,"_2948":51979},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3464":70967,"_30135":70956,"_5":30485,"_20936":118874,"_27421":118875,"_2948":51983},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3464":70968,"_30135":70956,"_5":30485,"_20936":118877,"_27421":118878,"_2948":118879},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3464":70969,"_30135":70956,"_5":30485,"_20936":118881,"_27421":118882,"_2948":118883},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3464":70970,"_30135":70956,"_5":30485,"_20936":118885,"_27421":118886,"_2948":118887},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3464":70971,"_30135":70956,"_5":30485,"_20936":118889,"_27421":118890,"_2948":118891},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3464":70972,"_30135":70956,"_5":30485,"_20936":118893,"_27421":118894,"_2948":52003},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3464":70973,"_30135":70956,"_5":30485,"_20936":118896,"_27421":118897,"_2948":118898},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3464":70974,"_30135":70956,"_5":30485,"_20936":118900,"_27421":118901,"_2948":118902},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3464":70975,"_30135":70956,"_5":30485,"_20936":118904,"_27421":118905,"_2948":118906},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3464":70976,"_30135":70956,"_20936":118908,"_5":14366,"_27421":70956,"_2948":118909},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3464":70977,"_30135":70956,"_20936":118911,"_5":14366,"_27421":118841,"_2948":118912},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3464":70978,"_30135":70956,"_20936":118914,"_5":14366,"_27421":118841,"_2948":118915},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3464":70979,"_30135":70956,"_20936":118917,"_5":14366,"_27421":118848,"_2948":118918},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3464":70980,"_30135":70956,"_20936":118920,"_5":14366,"_27421":118852,"_2948":118921},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3464":70981,"_30135":70956,"_20936":118923,"_5":14366,"_27421":118856,"_2948":118924},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3464":70982,"_30135":70956,"_20936":118926,"_5":14366,"_27421":118860,"_2948":118927},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3464":70983,"_30135":70956,"_20936":118929,"_5":14366,"_27421":118864,"_2948":118930},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3464":70984,"_30135":70956,"_20936":118932,"_5":14366,"_27421":118872,"_2948":118933},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3464":70985,"_30135":70956,"_20936":118935,"_5":14366,"_27421":118872,"_2948":118936},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3464":70986,"_30135":70956,"_20936":118938,"_5":14366,"_27421":118875,"_2948":118939},[],"Campo de `settings.enrollment_settings`",{"_3464":70987,"_30135":70956,"_20936":118941,"_5":14366,"_27421":118875,"_2948":118942},[],"Decisión",{"_3464":70988,"_30135":70956,"_20936":118944,"_5":14366,"_27421":118875,"_2948":52054},[],{"_3464":70989,"_30135":70956,"_20936":118946,"_5":14366,"_27421":118875,"_2948":118947},[],"`EST_RFC7030` para estas operaciones.",{"_3464":70990,"_30135":70956,"_20936":118949,"_5":14366,"_27421":118875,"_2948":52060},[],{"_3464":70991,"_30135":70956,"_20936":118951,"_5":14366,"_27421":118875,"_2948":118952},[],"ID de la CA que firmará.",{"_3464":70992,"_30135":70956,"_20936":118954,"_5":14366,"_27421":118875,"_2948":52066},[],{"_3464":70993,"_30135":70956,"_20936":118956,"_5":14366,"_27421":118875,"_2948":118957},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3464":70994,"_30135":70956,"_20936":118959,"_5":14366,"_27421":118875,"_2948":52072},[],{"_3464":70995,"_30135":70956,"_20936":118961,"_5":14366,"_27421":118875,"_2948":118962},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3464":70996,"_30135":70956,"_20936":118964,"_5":14366,"_27421":118875,"_2948":52078},[],{"_3464":70997,"_30135":70956,"_20936":118966,"_5":14366,"_27421":118875,"_2948":118967},[],"Uno de los cuatro modos de autenticación.",{"_3464":70998,"_30135":70956,"_20936":118969,"_5":14366,"_27421":118875,"_2948":118970},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3464":70999,"_30135":70956,"_20936":118972,"_5":14366,"_27421":118878,"_2948":118973},[],"Los bloques son independientes:",{"_3464":71000,"_30135":70956,"_20936":118975,"_5":14366,"_27421":118878,"_2948":118976},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3464":71001,"_30135":70956,"_20936":118978,"_5":14366,"_27421":118878,"_2948":118979},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3464":71002,"_30135":70956,"_20936":118981,"_5":14366,"_27421":118878,"_2948":52096},[],{"_3464":71003,"_30135":70956,"_20936":118983,"_5":14366,"_27421":118878,"_2948":118984},[],"Control aplicado en la operación configurada",{"_3464":71004,"_30135":70956,"_20936":118986,"_5":14366,"_27421":118878,"_2948":52102},[],{"_3464":71005,"_30135":70956,"_20936":118988,"_5":14366,"_27421":118878,"_2948":118989},[],"Validación del certificado presentado.",{"_3464":71006,"_30135":70956,"_20936":118991,"_5":14366,"_27421":118878,"_2948":52108},[],{"_3464":71007,"_30135":70956,"_20936":118993,"_5":14366,"_27421":118878,"_2948":118994},[],"Autorización del webhook configurado.",{"_3464":71008,"_30135":70956,"_20936":118996,"_5":14366,"_27421":118878,"_2948":52114},[],{"_3464":71009,"_30135":70956,"_20936":118998,"_5":14366,"_27421":118878,"_2948":118999},[],"Validación del certificado y, después, aprobación del webhook.",{"_3464":71010,"_30135":70956,"_20936":119001,"_5":14366,"_27421":118878,"_2948":52120},[],{"_3464":71011,"_30135":70956,"_20936":119003,"_5":14366,"_27421":118878,"_2948":119004},[],"Sin autenticación del solicitante por el DMS.",{"_3464":71012,"_30135":70956,"_20936":119006,"_5":14366,"_27421":118878,"_2948":119007},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3464":71013,"_30135":70956,"_20936":119009,"_5":14366,"_27421":118878,"_2948":119010},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3464":71014,"_30135":70956,"_20936":119012,"_5":14366,"_27421":118878,"_2948":119013},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3464":71015,"_30135":70956,"_20936":119015,"_5":14366,"_27421":118878,"_2948":119016},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3464":71016,"_30135":70956,"_20936":119018,"_5":14366,"_27421":118882,"_2948":119019},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3464":71017,"_30135":70956,"_20936":119021,"_5":14366,"_27421":118882,"_2948":119022},[],"Campo de `external_webhook_settings`",{"_3464":71018,"_30135":70956,"_20936":119024,"_5":14366,"_27421":118882,"_2948":118942},[],{"_3464":71019,"_30135":70956,"_20936":119026,"_5":14366,"_27421":118882,"_2948":52146},[],{"_3464":71020,"_30135":70956,"_20936":119028,"_5":14366,"_27421":118882,"_2948":119029},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3464":71021,"_30135":70956,"_20936":119031,"_5":14366,"_27421":118882,"_2948":52152},[],{"_3464":71022,"_30135":70956,"_20936":119033,"_5":14366,"_27421":118882,"_2948":119034},[],"`POST` o `PUT`; `POST` por defecto.",{"_3464":71023,"_30135":70956,"_20936":119036,"_5":14366,"_27421":118882,"_2948":52158},[],{"_3464":71024,"_30135":70956,"_20936":119038,"_5":14366,"_27421":118882,"_2948":119039},[],"Etiqueta usada en los logs del servicio.",{"_3464":71025,"_30135":70956,"_20936":119041,"_5":14366,"_27421":118882,"_2948":52164},[],{"_3464":71026,"_30135":70956,"_20936":119043,"_5":14366,"_27421":118882,"_2948":119044},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3464":71027,"_30135":70956,"_20936":119046,"_5":14366,"_27421":118882,"_2948":52170},[],{"_3464":71028,"_30135":70956,"_20936":119048,"_5":14366,"_27421":118882,"_2948":119049},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3464":71029,"_30135":70956,"_20936":119051,"_5":14366,"_27421":118882,"_2948":52176},[],{"_3464":71030,"_30135":70956,"_20936":119053,"_5":14366,"_27421":118882,"_2948":119054},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3464":71031,"_30135":70956,"_20936":119056,"_5":14366,"_27421":118882,"_2948":52182},[],{"_3464":71032,"_30135":70956,"_20936":119058,"_5":14366,"_27421":118882,"_2948":119059},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3464":71033,"_30135":70956,"_20936":119061,"_5":14366,"_27421":118882,"_2948":52188},[],{"_3464":71034,"_30135":70956,"_20936":119063,"_5":14366,"_27421":118882,"_2948":119064},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3464":71035,"_30135":70956,"_20936":119066,"_5":14366,"_27421":118882,"_2948":52194},[],{"_3464":71036,"_30135":70956,"_20936":119068,"_5":14366,"_27421":118882,"_2948":119069},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3464":71037,"_30135":70956,"_20936":119071,"_5":14366,"_27421":118882,"_2948":52200},[],{"_3464":71038,"_30135":70956,"_20936":119073,"_5":14366,"_27421":118882,"_2948":119074},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3464":71039,"_30135":70956,"_20936":119076,"_5":14366,"_27421":118882,"_2948":119077},[],"Reglas de esa configuración:",{"_3464":71040,"_30135":70956,"_20936":119079,"_5":14366,"_27421":118882,"_2948":119080},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3464":71041,"_30135":70956,"_20936":119082,"_5":14366,"_27421":118882,"_2948":119083},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3464":71042,"_30135":70956,"_20936":119085,"_5":14366,"_27421":118882,"_2948":119086},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3464":71043,"_30135":70956,"_20936":119088,"_5":14366,"_27421":118882,"_2948":119089},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3464":71044,"_30135":70956,"_20936":119091,"_5":14366,"_27421":118882,"_2948":119092},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3464":71045,"_30135":70956,"_20936":119094,"_5":14366,"_27421":118882,"_2948":119095},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3464":71046,"_30135":70956,"_20936":119097,"_5":14366,"_27421":118882,"_2948":119098},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3464":71047,"_30135":70956,"_20936":119100,"_5":14366,"_27421":118882,"_2948":119101},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3464":71048,"_30135":70956,"_20936":119103,"_5":14366,"_27421":118882,"_2948":119104},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3464":71049,"_30135":70956,"_20936":119106,"_5":14366,"_27421":118886,"_2948":119107},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3464":71050,"_30135":70956,"_20936":119109,"_5":14366,"_27421":118890,"_2948":119110},[],"Campo de `settings.reenrollment_settings`",{"_3464":71051,"_30135":70956,"_20936":119112,"_5":14366,"_27421":118890,"_2948":119113},[],"Función",{"_3464":71052,"_30135":70956,"_20936":119115,"_5":14366,"_27421":118890,"_2948":52244},[],{"_3464":71053,"_30135":70956,"_20936":119117,"_5":14366,"_27421":118890,"_2948":119118},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3464":71054,"_30135":70956,"_20936":119120,"_5":14366,"_27421":118890,"_2948":52250},[],{"_3464":71055,"_30135":70956,"_20936":119122,"_5":14366,"_27421":118890,"_2948":119123},[],"Umbral operativo preventivo de monitorización.",{"_3464":71056,"_30135":70956,"_20936":119125,"_5":14366,"_27421":118890,"_2948":52256},[],{"_3464":71057,"_30135":70956,"_20936":119127,"_5":14366,"_27421":118890,"_2948":119128},[],"Umbral operativo crítico de monitorización.",{"_3464":71058,"_30135":70956,"_20936":119130,"_5":14366,"_27421":118890,"_2948":52262},[],{"_3464":71059,"_30135":70956,"_20936":119132,"_5":14366,"_27421":118890,"_2948":119133},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3464":71060,"_30135":70956,"_20936":119135,"_5":14366,"_27421":118890,"_2948":52268},[],{"_3464":71061,"_30135":70956,"_20936":119137,"_5":14366,"_27421":118890,"_2948":119138},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3464":71062,"_30135":70956,"_20936":119140,"_5":14366,"_27421":118890,"_2948":52274},[],{"_3464":71063,"_30135":70956,"_20936":119142,"_5":14366,"_27421":118890,"_2948":119143},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3464":71064,"_30135":70956,"_20936":119145,"_5":14366,"_27421":118890,"_2948":119146},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3464":71065,"_30135":70956,"_20936":119148,"_5":14366,"_27421":118894,"_2948":119149},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3464":71066,"_30135":70956,"_20936":119151,"_5":14366,"_27421":118897,"_2948":116514},[],{"_3464":71067,"_30135":70956,"_20936":119153,"_5":14366,"_27421":118897,"_2948":119154},[],"Qué publica",{"_3464":71068,"_30135":70956,"_20936":119156,"_5":14366,"_27421":118897,"_2948":52291},[],{"_3464":71069,"_30135":70956,"_20936":119158,"_5":14366,"_27421":118897,"_2948":119159},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3464":71070,"_30135":70956,"_20936":119161,"_5":14366,"_27421":118897,"_2948":52297},[],{"_3464":71071,"_30135":70956,"_20936":119163,"_5":14366,"_27421":118897,"_2948":119164},[],"Certificado de la CA emisora seleccionada.",{"_3464":71072,"_30135":70956,"_20936":119166,"_5":14366,"_27421":118897,"_2948":52303},[],{"_3464":71073,"_30135":70956,"_20936":119168,"_5":14366,"_27421":118897,"_2948":119169},[],"Certificados de las CAs elegidas explícitamente.",{"_3464":71074,"_30135":70956,"_20936":119171,"_5":14366,"_27421":118897,"_2948":119172},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3464":71075,"_30135":70956,"_20936":119174,"_5":14366,"_27421":118901,"_2948":119175},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3464":71076,"_30135":70956,"_20936":119177,"_5":14366,"_27421":118901,"_2948":119178},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3464":71077,"_30135":70956,"_20936":119180,"_5":14366,"_27421":118901,"_2948":119181},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3464":71078,"_30135":70956,"_20936":119183,"_5":14366,"_27421":118905,"_2948":119184},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3464":71079,"_30135":71079,"_5":14718,"_2948":119186,"_30488":119187,"_20936":119188,"_27421":71079},"Integra el cliente EST",[49202,117572,51684,118584,118759],[],{"_3464":71080,"_30135":71079,"_20936":119190,"_5":14366,"_27421":71079,"_2948":119191},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3464":71081,"_30135":71079,"_5":30485,"_20936":119193,"_27421":119194,"_2948":116150},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3464":71082,"_30135":71079,"_5":30485,"_20936":119196,"_27421":119197,"_2948":119198},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3464":71083,"_30135":71079,"_5":30485,"_20936":119200,"_27421":119201,"_2948":119202},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3464":71084,"_30135":71079,"_5":30485,"_20936":119204,"_27421":119205,"_2948":119206},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3464":71085,"_30135":71079,"_5":30485,"_20936":119208,"_27421":119209,"_2948":119210},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3464":71086,"_30135":71079,"_5":30485,"_20936":119212,"_27421":119213,"_2948":119214},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3464":71087,"_30135":71079,"_20936":119216,"_5":14366,"_27421":71079,"_2948":119217},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3464":71088,"_30135":71079,"_20936":119219,"_5":14366,"_27421":119194,"_2948":119220},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3464":71089,"_30135":71079,"_20936":119222,"_5":14366,"_27421":119194,"_2948":119223},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3464":71090,"_30135":71079,"_20936":119225,"_5":14366,"_27421":119194,"_2948":119226},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3464":71091,"_30135":71079,"_20936":119228,"_5":14366,"_27421":119197,"_2948":119229},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3464":71092,"_30135":71079,"_20936":119231,"_5":14366,"_27421":119197,"_2948":119232},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3464":71093,"_30135":71079,"_20936":119234,"_5":14366,"_27421":119201,"_2948":119235},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3464":71094,"_30135":71079,"_20936":119237,"_5":14366,"_27421":119201,"_2948":119238},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3464":71095,"_30135":71079,"_20936":119240,"_5":14366,"_27421":119205,"_2948":119241},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3464":71096,"_30135":71079,"_20936":119243,"_5":14366,"_27421":119205,"_2948":119244},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3464":71097,"_30135":71079,"_20936":119246,"_5":14366,"_27421":119209,"_2948":119247},[],"Para el caso de una raíz que emite directamente:",{"_3464":71098,"_30135":71079,"_20936":119249,"_5":14366,"_27421":119209,"_2948":119250},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3464":71099,"_30135":71079,"_20936":119252,"_5":14366,"_27421":119209,"_2948":119253},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3464":71100,"_30135":71079,"_20936":119255,"_5":14366,"_27421":119213,"_2948":119256},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3464":71101,"_30135":71101,"_5":14718,"_2948":119258,"_30488":119259,"_20936":119260,"_27421":71101},"Referencia EST",[49202,117572,51684,118584,118759],[],{"_3464":71102,"_30135":71101,"_20936":119262,"_5":14366,"_27421":71101,"_2948":119263},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3464":71103,"_30135":71101,"_5":30485,"_20936":119265,"_27421":119266,"_2948":119267},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3464":71104,"_30135":71101,"_5":30485,"_20936":119269,"_27421":119270,"_2948":22687},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3464":71105,"_30135":71101,"_5":30485,"_20936":119272,"_27421":119273,"_2948":26036},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3464":71106,"_30135":71101,"_5":30485,"_20936":119275,"_27421":119276,"_2948":26043},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3464":71107,"_30135":71101,"_5":30485,"_20936":119278,"_27421":119279,"_2948":25362},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3464":71108,"_30135":71101,"_5":30485,"_20936":119281,"_27421":119282,"_2948":119283},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3464":71109,"_30135":71101,"_5":30485,"_20936":119285,"_27421":119286,"_2948":119287},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3464":71110,"_30135":71101,"_5":30485,"_20936":119289,"_27421":119290,"_2948":119291},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3464":71111,"_30135":71101,"_20936":119293,"_5":14366,"_27421":71101,"_2948":119294},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3464":71112,"_30135":71101,"_20936":119296,"_5":14366,"_27421":119266,"_2948":119297},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3464":71113,"_30135":71101,"_20936":119299,"_5":14366,"_27421":119266,"_2948":117332},[],{"_3464":71114,"_30135":71101,"_20936":119301,"_5":14366,"_27421":119266,"_2948":119302},[],"Método",{"_3464":71115,"_30135":71101,"_20936":119304,"_5":14366,"_27421":119266,"_2948":119305},[],"Autenticación y condición",{"_3464":71116,"_30135":71101,"_20936":119307,"_5":14366,"_27421":119266,"_2948":52446},[],{"_3464":71117,"_30135":71101,"_20936":119309,"_5":14366,"_27421":119266,"_2948":52449},[],{"_3464":71118,"_30135":71101,"_20936":119311,"_5":14366,"_27421":119266,"_2948":119312},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3464":71119,"_30135":71101,"_20936":119314,"_5":14366,"_27421":119266,"_2948":52455},[],{"_3464":71120,"_30135":71101,"_20936":119316,"_5":14366,"_27421":119266,"_2948":52458},[],{"_3464":71121,"_30135":71101,"_20936":119318,"_5":14366,"_27421":119266,"_2948":119319},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3464":71122,"_30135":71101,"_20936":119321,"_5":14366,"_27421":119266,"_2948":52464},[],{"_3464":71123,"_30135":71101,"_20936":119323,"_5":14366,"_27421":119266,"_2948":52458},[],{"_3464":71124,"_30135":71101,"_20936":119325,"_5":14366,"_27421":119266,"_2948":119326},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3464":71125,"_30135":71101,"_20936":119328,"_5":14366,"_27421":119266,"_2948":52472},[],{"_3464":71126,"_30135":71101,"_20936":119330,"_5":14366,"_27421":119266,"_2948":52458},[],{"_3464":71127,"_30135":71101,"_20936":119332,"_5":14366,"_27421":119266,"_2948":119333},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3464":71128,"_30135":71101,"_20936":119335,"_5":14366,"_27421":119266,"_2948":119336},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3464":71129,"_30135":71101,"_20936":119338,"_5":14366,"_27421":119270,"_2948":119339},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3464":71130,"_30135":71101,"_20936":119341,"_5":14366,"_27421":119270,"_2948":119342},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3464":71131,"_30135":71101,"_20936":119344,"_5":14366,"_27421":119273,"_2948":119345},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3464":71132,"_30135":71101,"_20936":119347,"_5":14366,"_27421":119273,"_2948":119348},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3464":71133,"_30135":71101,"_20936":119350,"_5":14366,"_27421":119276,"_2948":119351},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3464":71134,"_30135":71101,"_20936":119353,"_5":14366,"_27421":119276,"_2948":119354},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3464":71135,"_30135":71101,"_20936":119356,"_5":14366,"_27421":119279,"_2948":119357},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3464":71136,"_30135":71101,"_20936":119359,"_5":14366,"_27421":119279,"_2948":119360},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3464":71137,"_30135":71101,"_20936":119362,"_5":14366,"_27421":119282,"_2948":119363},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3464":71138,"_30135":71101,"_20936":119365,"_5":14366,"_27421":119282,"_2948":119366},[],"Parte",{"_3464":71139,"_30135":71101,"_20936":119368,"_5":14366,"_27421":119282,"_2948":119369},[],"Contenido tras decodificar su Base64",{"_3464":71140,"_30135":71101,"_20936":119371,"_5":14366,"_27421":119282,"_2948":52516},[],{"_3464":71141,"_30135":71101,"_20936":119373,"_5":14366,"_27421":119282,"_2948":119374},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3464":71142,"_30135":71101,"_20936":119376,"_5":14366,"_27421":119282,"_2948":52522},[],{"_3464":71143,"_30135":71101,"_20936":119378,"_5":14366,"_27421":119282,"_2948":119379},[],"PKCS#7 DER con el certificado emitido.",{"_3464":71144,"_30135":71101,"_20936":119381,"_5":14366,"_27421":119282,"_2948":119382},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3464":71145,"_30135":71101,"_20936":119384,"_5":14366,"_27421":119286,"_2948":119385},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3464":71146,"_30135":71101,"_20936":119387,"_5":14366,"_27421":119286,"_2948":119388},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3464":71147,"_30135":71101,"_20936":119390,"_5":14366,"_27421":119286,"_2948":119391},[],"Convierte y comprueba el resultado:",{"_3464":71148,"_30135":71101,"_20936":119393,"_5":14366,"_27421":119286,"_2948":119394},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3464":71149,"_30135":71101,"_20936":119396,"_5":14366,"_27421":119290,"_2948":119397},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3464":71150,"_30135":71101,"_20936":119399,"_5":14366,"_27421":119290,"_2948":119400},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3464":71151,"_30135":71151,"_5":14718,"_2948":118759,"_30488":119402,"_20936":119403,"_27421":71151},[49202,117572,51684,118584,118759],[],{"_3464":71152,"_30135":71151,"_20936":119405,"_5":14366,"_27421":71151,"_2948":119406},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3464":71153,"_30135":71151,"_5":30485,"_20936":119408,"_27421":119409,"_2948":119410},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3464":71154,"_30135":71151,"_5":30485,"_20936":119412,"_27421":119413,"_2948":119414},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3464":71155,"_30135":71151,"_5":30485,"_20936":119416,"_27421":119417,"_2948":119418},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3464":71156,"_30135":71151,"_5":30485,"_20936":119420,"_27421":119421,"_2948":119422},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3464":71157,"_30135":71151,"_20936":119424,"_5":14366,"_27421":71151,"_2948":119425},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3464":71158,"_30135":71151,"_20936":119427,"_5":14366,"_27421":119409,"_2948":119428},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3464":71159,"_30135":71151,"_20936":119430,"_5":14366,"_27421":119409,"_2948":119431},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3464":71160,"_30135":71151,"_20936":119433,"_5":14366,"_27421":119409,"_2948":119434},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3464":71161,"_30135":71151,"_20936":119436,"_5":14366,"_27421":119409,"_2948":119437},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3464":71162,"_30135":71151,"_20936":119439,"_5":14366,"_27421":119409,"_2948":119440},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3464":71163,"_30135":71151,"_20936":119442,"_5":14366,"_27421":119409,"_2948":119443},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3464":71164,"_30135":71151,"_20936":119445,"_5":14366,"_27421":119413,"_2948":119446},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3464":71165,"_30135":71151,"_20936":119448,"_5":14366,"_27421":119413,"_2948":119449},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":71166,"_30135":71151,"_20936":119451,"_5":14366,"_27421":119413,"_2948":119452},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3464":71167,"_30135":71151,"_20936":119454,"_5":14366,"_27421":119413,"_2948":119455},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3464":71168,"_30135":71151,"_20936":119457,"_5":14366,"_27421":119417,"_2948":119458},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3464":71169,"_30135":71151,"_20936":119460,"_5":14366,"_27421":119417,"_2948":119461},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3464":71170,"_30135":71151,"_20936":119463,"_5":14366,"_27421":119417,"_2948":119464},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3464":71171,"_30135":71151,"_20936":119466,"_5":14366,"_27421":119417,"_2948":119467},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3464":71172,"_30135":71151,"_20936":119469,"_5":14366,"_27421":119421,"_2948":119470},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3464":71173,"_30135":71151,"_20936":119472,"_5":14366,"_27421":119421,"_2948":119473},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3464":71174,"_30135":71174,"_5":14718,"_2948":119475,"_30488":119476,"_20936":119477,"_27421":71174},"Estrategias de aprovisionamiento",[49202,117572,51684,118584,118759],[],{"_3464":71175,"_30135":71174,"_20936":119479,"_5":14366,"_27421":71174,"_2948":119480},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3464":71176,"_30135":71174,"_5":30485,"_20936":119482,"_27421":119483,"_2948":119484},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3464":71177,"_30135":71174,"_5":30485,"_20936":119486,"_27421":119487,"_2948":119488},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3464":71178,"_30135":71174,"_5":30485,"_20936":119490,"_27421":119491,"_2948":119492},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3464":71179,"_30135":71174,"_5":30485,"_20936":119494,"_27421":119495,"_2948":119496},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3464":71180,"_30135":71174,"_5":30485,"_20936":119498,"_27421":119499,"_2948":119500},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3464":71181,"_30135":71174,"_20936":119502,"_5":14366,"_27421":71174,"_2948":119503},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3464":71182,"_30135":71174,"_20936":119505,"_5":14366,"_27421":119483,"_2948":119506},[],"Recorrido",{"_3464":71183,"_30135":71174,"_20936":119508,"_5":14366,"_27421":119483,"_2948":119509},[],"Cuándo existe el dispositivo",{"_3464":71184,"_30135":71174,"_20936":119511,"_5":14366,"_27421":119483,"_2948":119512},[],"Qué compruebas",{"_3464":71185,"_30135":71174,"_20936":119514,"_5":14366,"_27421":119483,"_2948":119515},[],"Asignación manual",{"_3464":71186,"_30135":71174,"_20936":119517,"_5":14366,"_27421":119483,"_2948":119518},[],"El operador lo crea antes de asociar un certificado.",{"_3464":71187,"_30135":71174,"_20936":119520,"_5":14366,"_27421":119483,"_2948":119521},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3464":71188,"_30135":71174,"_20936":119523,"_5":14366,"_27421":119483,"_2948":119524},[],"EST con `JITP`",{"_3464":71189,"_30135":71174,"_20936":119526,"_5":14366,"_27421":119483,"_2948":119527},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3464":71190,"_30135":71174,"_20936":119529,"_5":14366,"_27421":119483,"_2948":119530},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3464":71191,"_30135":71174,"_20936":119532,"_5":14366,"_27421":119483,"_2948":119533},[],"EST con `PRE_REGISTRATION`",{"_3464":71192,"_30135":71174,"_20936":119535,"_5":14366,"_27421":119483,"_2948":119536},[],"Debe existir antes de `/simpleenroll`.",{"_3464":71193,"_30135":71174,"_20936":119538,"_5":14366,"_27421":119483,"_2948":119539},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3464":71194,"_30135":71174,"_20936":119541,"_5":14366,"_27421":119483,"_2948":119542},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3464":71195,"_30135":71174,"_20936":119544,"_5":14366,"_27421":119483,"_2948":119545},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3464":71196,"_30135":71174,"_20936":119547,"_5":14366,"_27421":119487,"_2948":119548},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3464":71197,"_30135":71174,"_20936":119550,"_5":14366,"_27421":119487,"_2948":119551},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3464":71198,"_30135":71174,"_20936":119553,"_5":14366,"_27421":119487,"_2948":119554},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3464":71199,"_30135":71174,"_20936":119556,"_5":14366,"_27421":119491,"_2948":119557},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3464":71200,"_30135":71174,"_20936":119559,"_5":14366,"_27421":119491,"_2948":119560},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3464":71201,"_30135":71174,"_20936":119562,"_5":14366,"_27421":119491,"_2948":119563},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3464":71202,"_30135":71174,"_20936":119565,"_5":14366,"_27421":119491,"_2948":119566},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3464":71203,"_30135":71174,"_20936":119568,"_5":14366,"_27421":119491,"_2948":119569},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3464":71204,"_30135":71174,"_20936":119571,"_5":14366,"_27421":119491,"_2948":119572},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3464":71205,"_30135":71174,"_20936":119574,"_5":14366,"_27421":119495,"_2948":116514},[],{"_3464":71206,"_30135":71174,"_20936":119576,"_5":14366,"_27421":119495,"_2948":119577},[],"Material que atraviesa EST",{"_3464":71207,"_30135":71174,"_20936":119579,"_5":14366,"_27421":119495,"_2948":119580},[],"Clave generada por el dispositivo",{"_3464":71208,"_30135":71174,"_20936":119582,"_5":14366,"_27421":119495,"_2948":119583},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3464":71209,"_30135":71174,"_20936":119585,"_5":14366,"_27421":119495,"_2948":119586},[],"Clave ya disponible en el dispositivo",{"_3464":71210,"_30135":71174,"_20936":119588,"_5":14366,"_27421":119495,"_2948":119589},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3464":71211,"_30135":71174,"_20936":119591,"_5":14366,"_27421":119495,"_2948":52003},[],{"_3464":71212,"_30135":71174,"_20936":119593,"_5":14366,"_27421":119495,"_2948":119594},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3464":71213,"_30135":71174,"_20936":119596,"_5":14366,"_27421":119495,"_2948":119597},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3464":71214,"_30135":71174,"_20936":119599,"_5":14366,"_27421":119499,"_2948":119600},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3464":71215,"_30135":71215,"_5":14718,"_2948":119602,"_30488":119603,"_20936":119604,"_27421":71215},"Renovación y recuperación",[49202,117572,51684,118584,118759],[],{"_3464":71216,"_30135":71215,"_20936":119606,"_5":14366,"_27421":71215,"_2948":119607},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3464":71217,"_30135":71215,"_5":30485,"_20936":119609,"_27421":119610,"_2948":119611},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3464":71218,"_30135":71215,"_5":30485,"_20936":119613,"_27421":119614,"_2948":119615},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3464":71219,"_30135":71215,"_5":30485,"_20936":119617,"_27421":119618,"_2948":119619},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3464":71220,"_30135":71215,"_5":30485,"_20936":119621,"_27421":119622,"_2948":119623},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3464":71221,"_30135":71215,"_5":30485,"_20936":119625,"_27421":119626,"_2948":119627},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3464":71222,"_30135":71215,"_20936":119629,"_5":14366,"_27421":71215,"_2948":119630},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3464":71223,"_30135":71215,"_20936":119632,"_5":14366,"_27421":119610,"_2948":119633},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3464":71224,"_30135":71215,"_20936":119635,"_5":14366,"_27421":119610,"_2948":119636},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3464":71225,"_30135":71215,"_20936":119638,"_5":14366,"_27421":119610,"_2948":119639},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3464":71226,"_30135":71215,"_20936":119641,"_5":14366,"_27421":119610,"_2948":119642},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3464":71227,"_30135":71215,"_20936":119644,"_5":14366,"_27421":119614,"_2948":119645},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3464":71228,"_30135":71215,"_20936":119647,"_5":14366,"_27421":119614,"_2948":119648},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3464":71229,"_30135":71215,"_20936":119650,"_5":14366,"_27421":119618,"_2948":119651},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3464":71230,"_30135":71215,"_20936":119653,"_5":14366,"_27421":119618,"_2948":119654},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3464":71231,"_30135":71215,"_20936":119656,"_5":14366,"_27421":119618,"_2948":119657},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3464":71232,"_30135":71215,"_20936":119659,"_5":14366,"_27421":119622,"_2948":119660},[],"Situación",{"_3464":71233,"_30135":71215,"_20936":119662,"_5":14366,"_27421":119622,"_2948":119663},[],"Procedimiento",{"_3464":71234,"_30135":71215,"_20936":119665,"_5":14366,"_27421":119622,"_2948":119666},[],"Certificado vigente, fuera de ventana",{"_3464":71235,"_30135":71215,"_20936":119668,"_5":14366,"_27421":119622,"_2948":119669},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3464":71236,"_30135":71215,"_20936":119671,"_5":14366,"_27421":119622,"_2948":119672},[],"Certificado vencido, clave disponible",{"_3464":71237,"_30135":71215,"_20936":119674,"_5":14366,"_27421":119622,"_2948":119675},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3464":71238,"_30135":71215,"_20936":119677,"_5":14366,"_27421":119622,"_2948":119678},[],"Renovación por webhook o `NO_AUTH`",{"_3464":71239,"_30135":71215,"_20936":119680,"_5":14366,"_27421":119622,"_2948":119681},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3464":71240,"_30135":71215,"_20936":119683,"_5":14366,"_27421":119622,"_2948":119684},[],"Clave perdida o inaccesible",{"_3464":71241,"_30135":71215,"_20936":119686,"_5":14366,"_27421":119622,"_2948":119687},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3464":71242,"_30135":71215,"_20936":119689,"_5":14366,"_27421":119622,"_2948":119690},[],"Identidad actual revocada",{"_3464":71243,"_30135":71215,"_20936":119692,"_5":14366,"_27421":119622,"_2948":119693},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3464":71244,"_30135":71215,"_20936":119695,"_5":14366,"_27421":119622,"_2948":119696},[],"Dispositivo sin identidad",{"_3464":71245,"_30135":71215,"_20936":119698,"_5":14366,"_27421":119622,"_2948":119699},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3464":71246,"_30135":71215,"_20936":119701,"_5":14366,"_27421":119622,"_2948":119702},[],"Dispositivo retirado",{"_3464":71247,"_30135":71215,"_20936":119704,"_5":14366,"_27421":119622,"_2948":119705},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3464":71248,"_30135":71215,"_20936":119707,"_5":14366,"_27421":119622,"_2948":119708},[],"Timeout, HTTP 500 o fallo de instalación",{"_3464":71249,"_30135":71215,"_20936":119710,"_5":14366,"_27421":119622,"_2948":119711},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3464":71250,"_30135":71215,"_20936":119713,"_5":14366,"_27421":119626,"_2948":119714},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3464":71251,"_30135":71215,"_20936":119716,"_5":14366,"_27421":119626,"_2948":119717},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3464":71252,"_30135":71252,"_5":14718,"_2948":119719,"_30488":119720,"_20936":119721,"_27421":71252},"Diagnóstico de enrolamiento",[49202,117572,51684,118584,118759],[],{"_3464":71253,"_30135":71252,"_20936":119723,"_5":14366,"_27421":71252,"_2948":119724},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3464":71254,"_30135":71252,"_5":30485,"_20936":119726,"_27421":119727,"_2948":119728},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3464":71255,"_30135":71252,"_5":30485,"_20936":119730,"_27421":119731,"_2948":119732},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3464":71256,"_30135":71252,"_5":30485,"_20936":119734,"_27421":119735,"_2948":119291},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3464":71257,"_30135":71252,"_5":30485,"_20936":119737,"_27421":119738,"_2948":119739},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3464":71258,"_30135":71252,"_20936":119741,"_5":14366,"_27421":71252,"_2948":119742},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3464":71259,"_30135":71252,"_20936":119744,"_5":14366,"_27421":119731,"_2948":119745},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3464":71260,"_30135":71252,"_20936":119747,"_5":14366,"_27421":119731,"_2948":119748},[],"Síntoma o mensaje",{"_3464":71261,"_30135":71252,"_20936":119750,"_5":14366,"_27421":119731,"_2948":119751},[],"Qué revisar",{"_3464":71262,"_30135":71252,"_20936":119753,"_5":14366,"_27421":119731,"_2948":119754},[],"curl rechaza TLS, nombre o emisor",{"_3464":71263,"_30135":71252,"_20936":119756,"_5":14366,"_27421":119731,"_2948":119757},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3464":71264,"_30135":71252,"_20936":119759,"_5":14366,"_27421":119731,"_2948":119760},[],"404 o APS ausente",{"_3464":71265,"_30135":71252,"_20936":119762,"_5":14366,"_27421":119731,"_2948":119763},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3464":71266,"_30135":71252,"_20936":119765,"_5":14366,"_27421":119731,"_2948":119766},[],"400, error de CSR o formato",{"_3464":71267,"_30135":71252,"_20936":119768,"_5":14366,"_27421":119731,"_2948":119769},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3464":71268,"_30135":71252,"_20936":119771,"_5":14366,"_27421":119731,"_2948":119772},[],"Credencial ausente o certificado no válido",{"_3464":71269,"_30135":71252,"_20936":119774,"_5":14366,"_27421":119731,"_2948":119775},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3464":71270,"_30135":71252,"_20936":119777,"_5":14366,"_27421":119731,"_2948":119778},[],"Webhook deniega, expira o responde sin autorización",{"_3464":71271,"_30135":71252,"_20936":119780,"_5":14366,"_27421":119731,"_2948":119781},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3464":71272,"_30135":71252,"_20936":119783,"_5":14366,"_27421":119731,"_2948":52929},[],{"_3464":71273,"_30135":71252,"_20936":119785,"_5":14366,"_27421":119731,"_2948":119786},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3464":71274,"_30135":71252,"_20936":119788,"_5":14366,"_27421":119731,"_2948":52935},[],{"_3464":71275,"_30135":71252,"_20936":119790,"_5":14366,"_27421":119731,"_2948":119791},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3464":71276,"_30135":71252,"_20936":119793,"_5":14366,"_27421":119731,"_2948":52941},[],{"_3464":71277,"_30135":71252,"_20936":119795,"_5":14366,"_27421":119731,"_2948":119796},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3464":71278,"_30135":71252,"_20936":119798,"_5":14366,"_27421":119731,"_2948":52947},[],{"_3464":71279,"_30135":71252,"_20936":119800,"_5":14366,"_27421":119731,"_2948":119801},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3464":71280,"_30135":71252,"_20936":119803,"_5":14366,"_27421":119731,"_2948":52953},[],{"_3464":71281,"_30135":71252,"_20936":119805,"_5":14366,"_27421":119731,"_2948":119806},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3464":71282,"_30135":71252,"_20936":119808,"_5":14366,"_27421":119731,"_2948":119809},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3464":71283,"_30135":71252,"_20936":119811,"_5":14366,"_27421":119731,"_2948":119812},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3464":71284,"_30135":71252,"_20936":119814,"_5":14366,"_27421":119731,"_2948":119815},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3464":71285,"_30135":71252,"_20936":119817,"_5":14366,"_27421":119731,"_2948":119818},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3464":71286,"_30135":71252,"_20936":119820,"_5":14366,"_27421":119731,"_2948":52971},[],{"_3464":71287,"_30135":71252,"_20936":119822,"_5":14366,"_27421":119731,"_2948":119823},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3464":71288,"_30135":71252,"_20936":119825,"_5":14366,"_27421":119731,"_2948":52977},[],{"_3464":71289,"_30135":71252,"_20936":119827,"_5":14366,"_27421":119731,"_2948":119828},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3464":71290,"_30135":71252,"_20936":119830,"_5":14366,"_27421":119731,"_2948":119831},[],"DMS propietario distinto",{"_3464":71291,"_30135":71252,"_20936":119833,"_5":14366,"_27421":119731,"_2948":119834},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3464":71292,"_30135":71252,"_20936":119836,"_5":14366,"_27421":119731,"_2948":52989},[],{"_3464":71293,"_30135":71252,"_20936":119838,"_5":14366,"_27421":119731,"_2948":119839},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3464":71294,"_30135":71252,"_20936":119841,"_5":14366,"_27421":119731,"_2948":52995},[],{"_3464":71295,"_30135":71252,"_20936":119843,"_5":14366,"_27421":119731,"_2948":119844},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3464":71296,"_30135":71252,"_20936":119846,"_5":14366,"_27421":119731,"_2948":119847},[],"Certificado actual revocado",{"_3464":71297,"_30135":71252,"_20936":119849,"_5":14366,"_27421":119731,"_2948":119850},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3464":71298,"_30135":71252,"_20936":119852,"_5":14366,"_27421":119731,"_2948":119853},[],"Error de CA, perfil o firma",{"_3464":71299,"_30135":71252,"_20936":119855,"_5":14366,"_27421":119731,"_2948":119856},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3464":71300,"_30135":71252,"_20936":119858,"_5":14366,"_27421":119731,"_2948":119859},[],"HTTP 200 sin conexión del dispositivo",{"_3464":71301,"_30135":71252,"_20936":119861,"_5":14366,"_27421":119731,"_2948":119862},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3464":71302,"_30135":71252,"_20936":119864,"_5":14366,"_27421":119731,"_2948":119865},[],"Timeout o error después de emitir",{"_3464":71303,"_30135":71252,"_20936":119867,"_5":14366,"_27421":119731,"_2948":119868},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3464":71304,"_30135":71252,"_20936":119870,"_5":14366,"_27421":119735,"_2948":119871},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3464":71305,"_30135":71252,"_20936":119873,"_5":14366,"_27421":119735,"_2948":119874},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3464":71306,"_30135":71252,"_20936":119876,"_5":14366,"_27421":119738,"_2948":119877},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3464":71307,"_30135":71252,"_20936":119879,"_5":14366,"_27421":119738,"_2948":119880},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3464":71308,"_30135":71252,"_20936":119882,"_5":14366,"_27421":119738,"_2948":119883},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3464":71309,"_30135":71252,"_20936":119885,"_5":14366,"_27421":119738,"_2948":119886},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3464":71310,"_30135":71252,"_20936":119888,"_5":14366,"_27421":119738,"_2948":119889},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3464":71311,"_30135":71252,"_20936":119891,"_5":14366,"_27421":119738,"_2948":119892},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3464":71312,"_30135":71252,"_20936":119894,"_5":14366,"_27421":119738,"_2948":119895},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3464":71313,"_30135":71313,"_5":14718,"_2948":119897,"_30488":119898,"_20936":119899,"_27421":71313},"Distribución y actualización de confianza",[49202,117572,51684,118584,118759],[],{"_3464":71314,"_30135":71313,"_20936":119901,"_5":14366,"_27421":71313,"_2948":119902},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3464":71315,"_30135":71313,"_5":30485,"_20936":119904,"_27421":119905,"_2948":119906},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3464":71316,"_30135":71313,"_5":30485,"_20936":119908,"_27421":119909,"_2948":119910},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3464":71317,"_30135":71313,"_5":30485,"_20936":119912,"_27421":119913,"_2948":119914},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3464":71318,"_30135":71313,"_5":30485,"_20936":119916,"_27421":119917,"_2948":119918},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3464":71319,"_30135":71313,"_5":30485,"_20936":119920,"_27421":119921,"_2948":119922},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3464":71320,"_30135":71313,"_20936":119924,"_5":14366,"_27421":71313,"_2948":119925},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3464":71321,"_30135":71313,"_20936":119927,"_5":14366,"_27421":119905,"_2948":119928},[],"Relación",{"_3464":71322,"_30135":71313,"_20936":119930,"_5":14366,"_27421":119905,"_2948":119931},[],"Material que prepara el responsable",{"_3464":71323,"_30135":71313,"_20936":119933,"_5":14366,"_27421":119905,"_2948":119934},[],"Dispositivo → servidor EST",{"_3464":71324,"_30135":71313,"_20936":119936,"_5":14366,"_27421":119905,"_2948":119937},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3464":71325,"_30135":71313,"_20936":119939,"_5":14366,"_27421":119905,"_2948":119940},[],"DMS → solicitante",{"_3464":71326,"_30135":71313,"_20936":119942,"_5":14366,"_27421":119905,"_2948":119943},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3464":71327,"_30135":71313,"_20936":119945,"_5":14366,"_27421":119905,"_2948":119946},[],"Consumidor → dispositivo",{"_3464":71328,"_30135":71313,"_20936":119948,"_5":14366,"_27421":119905,"_2948":119949},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3464":71329,"_30135":71313,"_20936":119951,"_5":14366,"_27421":119905,"_2948":119952},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3464":71330,"_30135":71313,"_20936":119954,"_5":14366,"_27421":119909,"_2948":119955},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3464":71331,"_30135":71313,"_20936":119957,"_5":14366,"_27421":119909,"_2948":119958},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3464":71332,"_30135":71313,"_20936":119960,"_5":14366,"_27421":119913,"_2948":119961},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3464":71333,"_30135":71313,"_20936":119963,"_5":14366,"_27421":119913,"_2948":119964},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3464":71334,"_30135":71313,"_20936":119966,"_5":14366,"_27421":119913,"_2948":119967},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3464":71335,"_30135":71313,"_20936":119969,"_5":14366,"_27421":119913,"_2948":119970},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3464":71336,"_30135":71313,"_20936":119972,"_5":14366,"_27421":119913,"_2948":119973},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3464":71337,"_30135":71313,"_20936":119975,"_5":14366,"_27421":119913,"_2948":119976},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3464":71338,"_30135":71313,"_20936":119978,"_5":14366,"_27421":119917,"_2948":119979},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3464":71339,"_30135":71313,"_20936":119981,"_5":14366,"_27421":119917,"_2948":119982},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3464":71340,"_30135":71313,"_20936":119984,"_5":14366,"_27421":119917,"_2948":119985},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3464":71341,"_30135":71313,"_20936":119987,"_5":14366,"_27421":119921,"_2948":119988},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3464":71342,"_30135":71342,"_5":14718,"_2948":53144,"_30488":119990,"_20936":119992,"_27421":71342},[49202,117572,51684,118584,119991],"Integraciones",[],{"_3464":71343,"_30135":71342,"_20936":119994,"_5":14366,"_27421":71342,"_2948":119995},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3464":71344,"_30135":71342,"_5":30485,"_20936":119997,"_27421":119998,"_2948":119999},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3464":71345,"_30135":71342,"_5":30485,"_20936":120001,"_27421":120002,"_2948":120003},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3464":71346,"_30135":71342,"_5":30485,"_20936":120005,"_27421":120006,"_2948":120007},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3464":71347,"_30135":71342,"_5":30485,"_20936":120009,"_27421":120010,"_2948":120011},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3464":71348,"_30135":71342,"_5":30485,"_20936":120013,"_27421":120014,"_2948":120015},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3464":71349,"_30135":71342,"_5":30485,"_20936":120017,"_27421":120018,"_2948":120019},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3464":71350,"_30135":71342,"_5":30485,"_20936":120021,"_27421":120022,"_2948":120023},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3464":71351,"_30135":71342,"_5":30485,"_20936":120025,"_27421":120026,"_2948":120027},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3464":71352,"_30135":71342,"_5":30485,"_20936":120029,"_27421":120030,"_2948":53186},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3464":71353,"_30135":71342,"_5":30485,"_20936":120032,"_27421":120033,"_2948":53190},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3464":71354,"_30135":71342,"_5":30485,"_20936":120035,"_27421":120036,"_2948":120037},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3464":71355,"_30135":71342,"_5":30485,"_20936":120039,"_27421":120040,"_2948":120041},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3464":71356,"_30135":71342,"_5":30485,"_20936":120043,"_27421":120044,"_2948":120045},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3464":71357,"_30135":71342,"_5":30485,"_20936":120047,"_27421":120048,"_2948":120049},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3464":71358,"_30135":71342,"_5":30485,"_20936":120051,"_27421":120052,"_2948":120053},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3464":71359,"_30135":71342,"_5":30485,"_20936":120055,"_27421":120056,"_2948":120057},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3464":71360,"_30135":71342,"_5":30485,"_20936":120059,"_27421":120060,"_2948":120061},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3464":71361,"_30135":71342,"_5":30485,"_20936":120063,"_27421":120064,"_2948":120065},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3464":71362,"_30135":71342,"_5":30485,"_20936":120067,"_27421":120068,"_2948":120069},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3464":71363,"_30135":71342,"_5":30485,"_20936":120071,"_27421":120072,"_2948":120073},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3464":71364,"_30135":71342,"_5":30485,"_20936":120075,"_27421":120076,"_2948":120077},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3464":71365,"_30135":71342,"_5":30485,"_20936":120079,"_27421":120080,"_2948":120081},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3464":71366,"_30135":71342,"_5":30485,"_20936":120083,"_27421":120084,"_2948":120085},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3464":71367,"_30135":71342,"_5":30485,"_20936":120087,"_27421":120088,"_2948":120089},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3464":71368,"_30135":71342,"_5":30485,"_20936":120091,"_27421":120092,"_2948":120093},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3464":71369,"_30135":71342,"_20936":120095,"_5":14366,"_27421":71342,"_2948":120096},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3464":71370,"_30135":71342,"_20936":120098,"_5":14366,"_27421":71342,"_2948":120099},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3464":71371,"_30135":71342,"_20936":120101,"_5":14366,"_27421":71342,"_2948":120102},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3464":71372,"_30135":71342,"_20936":120104,"_5":14366,"_27421":119998,"_2948":120105},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3464":71373,"_30135":71342,"_20936":120107,"_5":14366,"_27421":119998,"_2948":120108},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3464":71374,"_30135":71342,"_20936":120110,"_5":14366,"_27421":119998,"_2948":120111},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3464":71375,"_30135":71342,"_20936":120113,"_5":14366,"_27421":119998,"_2948":120114},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3464":71376,"_30135":71342,"_20936":120116,"_5":14366,"_27421":120002,"_2948":120117},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3464":71377,"_30135":71342,"_20936":120119,"_5":14366,"_27421":120006,"_2948":120120},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3464":71378,"_30135":71342,"_20936":120122,"_5":14366,"_27421":120006,"_2948":120123},[],"Acción IAM",{"_3464":71379,"_30135":71342,"_20936":120125,"_5":14366,"_27421":120006,"_2948":116520},[],{"_3464":71380,"_30135":71342,"_20936":120127,"_5":14366,"_27421":120006,"_2948":53285},[],{"_3464":71381,"_30135":71342,"_20936":120129,"_5":14366,"_27421":120006,"_2948":120130},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3464":71382,"_30135":71342,"_20936":120132,"_5":14366,"_27421":120006,"_2948":53291},[],{"_3464":71383,"_30135":71342,"_20936":120134,"_5":14366,"_27421":120006,"_2948":120135},[],"Registrar la CA en AWS IoT",{"_3464":71384,"_30135":71342,"_20936":120137,"_5":14366,"_27421":120006,"_2948":53297},[],{"_3464":71385,"_30135":71342,"_20936":120139,"_5":14366,"_27421":120006,"_2948":120140},[],"Consultar el estado del registro de la CA",{"_3464":71386,"_30135":71342,"_20936":120142,"_5":14366,"_27421":120006,"_2948":53303},[],{"_3464":71387,"_30135":71342,"_20936":120144,"_5":14366,"_27421":120006,"_2948":120145},[],"Crear o actualizar Things en IoT Core",{"_3464":71388,"_30135":71342,"_20936":120147,"_5":14366,"_27421":120006,"_2948":53309},[],{"_3464":71389,"_30135":71342,"_20936":120149,"_5":14366,"_27421":120006,"_2948":120150},[],"Aprovisionar Things mediante plantilla",{"_3464":71390,"_30135":71342,"_20936":120152,"_5":14366,"_27421":120006,"_2948":53315},[],{"_3464":71391,"_30135":71342,"_20936":120154,"_5":14366,"_27421":120006,"_2948":120155},[],"Registrar certificados de dispositivo",{"_3464":71392,"_30135":71342,"_20936":120157,"_5":14366,"_27421":120006,"_2948":53321},[],{"_3464":71393,"_30135":71342,"_20936":120159,"_5":14366,"_27421":120006,"_2948":120160},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3464":71394,"_30135":71342,"_20936":120162,"_5":14366,"_27421":120006,"_2948":53327},[],{"_3464":71395,"_30135":71342,"_20936":120164,"_5":14366,"_27421":120006,"_2948":120165},[],"Crear y adjuntar políticas IoT",{"_3464":71396,"_30135":71342,"_20936":120167,"_5":14366,"_27421":120006,"_2948":53333},[],{"_3464":71397,"_30135":71342,"_20936":120169,"_5":14366,"_27421":120006,"_2948":120170},[],"Gestionar grupos de Things",{"_3464":71398,"_30135":71342,"_20936":120172,"_5":14366,"_27421":120006,"_2948":53339},[],{"_3464":71399,"_30135":71342,"_20936":120174,"_5":14366,"_27421":120006,"_2948":120175},[],"Crear plantillas JITP",{"_3464":71400,"_30135":71342,"_20936":120177,"_5":14366,"_27421":120006,"_2948":53345},[],{"_3464":71401,"_30135":71342,"_20936":120179,"_5":14366,"_27421":120006,"_2948":120180},[],"Leer y escribir el Device Shadow",{"_3464":71402,"_30135":71342,"_20936":120182,"_5":14366,"_27421":120006,"_2948":120183},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3464":71403,"_30135":71342,"_20936":120185,"_5":14366,"_27421":120010,"_2948":120186},[],"Parámetro",{"_3464":71404,"_30135":71342,"_20936":120188,"_5":14366,"_27421":120010,"_2948":120189},[],"Tipo",{"_3464":71405,"_30135":71342,"_20936":120191,"_5":14366,"_27421":120010,"_2948":120192},[],"Requerido",{"_3464":71406,"_30135":71342,"_20936":120194,"_5":14366,"_27421":120010,"_2948":120195},[],"Descripción",{"_3464":71407,"_30135":71342,"_20936":120197,"_5":14366,"_27421":120010,"_2948":53366},[],{"_3464":71408,"_30135":71342,"_20936":120199,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71409,"_30135":71342,"_20936":120201,"_5":14366,"_27421":120010,"_2948":120202},[],"Sí",{"_3464":71410,"_30135":71342,"_20936":120204,"_5":14366,"_27421":120010,"_2948":120205},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3464":71411,"_30135":71342,"_20936":120207,"_5":14366,"_27421":120010,"_2948":53377},[],{"_3464":71412,"_30135":71342,"_20936":120209,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71413,"_30135":71342,"_20936":120211,"_5":14366,"_27421":120010,"_2948":120202},[],{"_3464":71414,"_30135":71342,"_20936":120213,"_5":14366,"_27421":120010,"_2948":120214},[],"Región AWS donde opera el conector.",{"_3464":71415,"_30135":71342,"_20936":120216,"_5":14366,"_27421":120010,"_2948":53387},[],{"_3464":71416,"_30135":71342,"_20936":120218,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71417,"_30135":71342,"_20936":120220,"_5":14366,"_27421":120010,"_2948":120202},[],{"_3464":71418,"_30135":71342,"_20936":120222,"_5":14366,"_27421":120010,"_2948":120223},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3464":71419,"_30135":71342,"_20936":120225,"_5":14366,"_27421":120010,"_2948":53397},[],{"_3464":71420,"_30135":71342,"_20936":120227,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71421,"_30135":71342,"_20936":120229,"_5":14366,"_27421":120010,"_2948":120230},[],"Solo con `auth_method=static`",{"_3464":71422,"_30135":71342,"_20936":120232,"_5":14366,"_27421":120010,"_2948":120233},[],"Clave de acceso AWS.",{"_3464":71423,"_30135":71342,"_20936":120235,"_5":14366,"_27421":120010,"_2948":53408},[],{"_3464":71424,"_30135":71342,"_20936":120237,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71425,"_30135":71342,"_20936":120239,"_5":14366,"_27421":120010,"_2948":120230},[],{"_3464":71426,"_30135":71342,"_20936":120241,"_5":14366,"_27421":120010,"_2948":120242},[],"Clave secreta AWS.",{"_3464":71427,"_30135":71342,"_20936":120244,"_5":14366,"_27421":120010,"_2948":53418},[],{"_3464":71428,"_30135":71342,"_20936":120246,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71429,"_30135":71342,"_20936":120248,"_5":14366,"_27421":120010,"_2948":53423},[],{"_3464":71430,"_30135":71342,"_20936":120250,"_5":14366,"_27421":120010,"_2948":120251},[],"Token de sesión (con `auth_method=static`).",{"_3464":71431,"_30135":71342,"_20936":120253,"_5":14366,"_27421":120010,"_2948":53429},[],{"_3464":71432,"_30135":71342,"_20936":120255,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71433,"_30135":71342,"_20936":120257,"_5":14366,"_27421":120010,"_2948":120258},[],"Solo con `auth_method=role`",{"_3464":71434,"_30135":71342,"_20936":120260,"_5":14366,"_27421":120010,"_2948":120261},[],"ARN del rol a asumir.",{"_3464":71435,"_30135":71342,"_20936":120263,"_5":14366,"_27421":120010,"_2948":53440},[],{"_3464":71436,"_30135":71342,"_20936":120265,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71437,"_30135":71342,"_20936":120267,"_5":14366,"_27421":120010,"_2948":53423},[],{"_3464":71438,"_30135":71342,"_20936":120269,"_5":14366,"_27421":120010,"_2948":120270},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3464":71439,"_30135":71342,"_20936":120272,"_5":14366,"_27421":120010,"_2948":53450},[],{"_3464":71440,"_30135":71342,"_20936":120274,"_5":14366,"_27421":120010,"_2948":89662},[],{"_3464":71441,"_30135":71342,"_20936":120276,"_5":14366,"_27421":120010,"_2948":120202},[],{"_3464":71442,"_30135":71342,"_20936":120278,"_5":14366,"_27421":120010,"_2948":120279},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3464":71443,"_30135":71342,"_20936":120281,"_5":14366,"_27421":120010,"_2948":53460},[],{"_3464":71444,"_30135":71342,"_20936":120283,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71445,"_30135":71342,"_20936":120285,"_5":14366,"_27421":120010,"_2948":120202},[],{"_3464":71446,"_30135":71342,"_20936":120287,"_5":14366,"_27421":120010,"_2948":120288},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3464":71447,"_30135":71342,"_20936":120290,"_5":14366,"_27421":120010,"_2948":53470},[],{"_3464":71448,"_30135":71342,"_20936":120292,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71449,"_30135":71342,"_20936":120294,"_5":14366,"_27421":120010,"_2948":120202},[],{"_3464":71450,"_30135":71342,"_20936":120296,"_5":14366,"_27421":120010,"_2948":120297},[],"URL HTTP del Device Manager de Lamassu.",{"_3464":71451,"_30135":71342,"_20936":120299,"_5":14366,"_27421":120010,"_2948":53480},[],{"_3464":71452,"_30135":71342,"_20936":120301,"_5":14366,"_27421":120010,"_2948":25002},[],{"_3464":71453,"_30135":71342,"_20936":120303,"_5":14366,"_27421":120010,"_2948":120202},[],{"_3464":71454,"_30135":71342,"_20936":120305,"_5":14366,"_27421":120010,"_2948":120306},[],"URL HTTP del servicio de CA de Lamassu.",{"_3464":71455,"_30135":71342,"_20936":120308,"_5":14366,"_27421":120014,"_2948":120309},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3464":71456,"_30135":71342,"_20936":120311,"_5":14366,"_27421":120014,"_2948":120312},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3464":71457,"_30135":71342,"_20936":120314,"_5":14366,"_27421":120014,"_2948":120315},[],"Tipo de CloudEvent",{"_3464":71458,"_30135":71342,"_20936":120317,"_5":14366,"_27421":120014,"_2948":120318},[],"Recurso en Lamassu",{"_3464":71459,"_30135":71342,"_20936":120320,"_5":14366,"_27421":120014,"_2948":120321},[],"Recurso AWS",{"_3464":71460,"_30135":71342,"_20936":120323,"_5":14366,"_27421":120014,"_2948":120324},[],"Acciones IAM",{"_3464":71461,"_30135":71342,"_20936":120326,"_5":14366,"_27421":120014,"_2948":120327},[],"Llamadas AWS y efecto",{"_3464":71462,"_30135":71342,"_20936":120329,"_5":14366,"_27421":120014,"_2948":120330},[],"Dónde en esta página",{"_3464":71463,"_30135":71342,"_20936":120332,"_5":14366,"_27421":120014,"_2948":53514},[],{"_3464":71464,"_30135":71342,"_20936":120334,"_5":14366,"_27421":120014,"_2948":53517},[],{"_3464":71465,"_30135":71342,"_20936":120336,"_5":14366,"_27421":120014,"_2948":53520},[],{"_3464":71466,"_30135":71342,"_20936":120338,"_5":14366,"_27421":120014,"_2948":53523},[],{"_3464":71467,"_30135":71342,"_20936":120340,"_5":14366,"_27421":120014,"_2948":120341},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3464":71468,"_30135":71342,"_20936":120343,"_5":14366,"_27421":120014,"_2948":120027},[],{"_3464":71469,"_30135":71342,"_20936":120345,"_5":14366,"_27421":120014,"_2948":53531},[],{"_3464":71470,"_30135":71342,"_20936":120347,"_5":14366,"_27421":120014,"_2948":53534},[],{"_3464":71471,"_30135":71342,"_20936":120349,"_5":14366,"_27421":120014,"_2948":53537},[],{"_3464":71472,"_30135":71342,"_20936":120351,"_5":14366,"_27421":120014,"_2948":53540},[],{"_3464":71473,"_30135":71342,"_20936":120353,"_5":14366,"_27421":120014,"_2948":120354},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3464":71474,"_30135":71342,"_20936":120356,"_5":14366,"_27421":120014,"_2948":120053},[],{"_3464":71475,"_30135":71342,"_20936":120358,"_5":14366,"_27421":120014,"_2948":53548},[],{"_3464":71476,"_30135":71342,"_20936":120360,"_5":14366,"_27421":120014,"_2948":120361},[],"Dispositivo",{"_3464":71477,"_30135":71342,"_20936":120363,"_5":14366,"_27421":120014,"_2948":53554},[],{"_3464":71478,"_30135":71342,"_20936":120365,"_5":14366,"_27421":120014,"_2948":53557},[],{"_3464":71479,"_30135":71342,"_20936":120367,"_5":14366,"_27421":120014,"_2948":120368},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3464":71480,"_30135":71342,"_20936":120370,"_5":14366,"_27421":120014,"_2948":120061},[],{"_3464":71481,"_30135":71342,"_20936":120372,"_5":14366,"_27421":120014,"_2948":53565},[],{"_3464":71482,"_30135":71342,"_20936":120374,"_5":14366,"_27421":120014,"_2948":120375},[],"Certificado",{"_3464":71483,"_30135":71342,"_20936":120377,"_5":14366,"_27421":120014,"_2948":53571},[],{"_3464":71484,"_30135":71342,"_20936":120379,"_5":14366,"_27421":120014,"_2948":120380},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3464":71485,"_30135":71342,"_20936":120382,"_5":14366,"_27421":120014,"_2948":120383},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3464":71486,"_30135":71342,"_20936":120385,"_5":14366,"_27421":120014,"_2948":120073},[],{"_3464":71487,"_30135":71342,"_20936":120387,"_5":14366,"_27421":120014,"_2948":53582},[],{"_3464":71488,"_30135":71342,"_20936":120389,"_5":14366,"_27421":120014,"_2948":120390},[],"Certificado / Dispositivo",{"_3464":71489,"_30135":71342,"_20936":120392,"_5":14366,"_27421":120014,"_2948":53588},[],{"_3464":71490,"_30135":71342,"_20936":120394,"_5":14366,"_27421":120014,"_2948":49598},[],{"_3464":71491,"_30135":71342,"_20936":120396,"_5":14366,"_27421":120014,"_2948":120397},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3464":71492,"_30135":71342,"_20936":120399,"_5":14366,"_27421":120014,"_2948":120081},[],{"_3464":71493,"_30135":71342,"_20936":120401,"_5":14366,"_27421":120018,"_2948":120402},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3464":71494,"_30135":71342,"_20936":120404,"_5":14366,"_27421":120022,"_2948":120405},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3464":71495,"_30135":71342,"_20936":120407,"_5":14366,"_27421":120022,"_2948":120408},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3464":71496,"_30135":71342,"_20936":120410,"_5":14366,"_27421":120026,"_2948":120411},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3464":71497,"_30135":71342,"_20936":120413,"_5":14366,"_27421":120026,"_2948":120414},[],"Transición",{"_3464":71498,"_30135":71342,"_20936":120416,"_5":14366,"_27421":120026,"_2948":120417},[],"Llamadas AWS",{"_3464":71499,"_30135":71342,"_20936":120419,"_5":14366,"_27421":120026,"_2948":120420},[],"`NoRegistrada` → `Solicitada`",{"_3464":71500,"_30135":71342,"_20936":120422,"_5":14366,"_27421":120026,"_2948":120423},[],"ninguna (solo escritura de metadatos)",{"_3464":71501,"_30135":71342,"_20936":120425,"_5":14366,"_27421":120026,"_2948":120426},[],"`Solicitada` → `Registrando`",{"_3464":71502,"_30135":71342,"_20936":120428,"_5":14366,"_27421":120026,"_2948":120429},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3464":71503,"_30135":71342,"_20936":120431,"_5":14366,"_27421":120026,"_2948":120432},[],"`Registrando` → `Completada`",{"_3464":71504,"_30135":71342,"_20936":120434,"_5":14366,"_27421":120026,"_2948":120435},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3464":71505,"_30135":71342,"_20936":120437,"_5":14366,"_27421":120026,"_2948":120438},[],"`Registrando` → `Fallida`",{"_3464":71506,"_30135":71342,"_20936":120440,"_5":14366,"_27421":120026,"_2948":120441},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3464":71507,"_30135":71342,"_20936":120443,"_5":14366,"_27421":120026,"_2948":120444},[],"`Fallida` / `Completada` → `Solicitada`",{"_3464":71508,"_30135":71342,"_20936":120446,"_5":14366,"_27421":120026,"_2948":120447},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3464":71509,"_30135":71342,"_20936":120449,"_5":14366,"_27421":120030,"_2948":120450},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3464":71510,"_30135":71342,"_20936":120452,"_5":14366,"_27421":120030,"_2948":120453},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3464":71511,"_30135":71342,"_20936":120455,"_5":14366,"_27421":120030,"_2948":120456},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3464":71512,"_30135":71342,"_20936":120458,"_5":14366,"_27421":120030,"_2948":120459},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3464":71513,"_30135":71342,"_20936":120461,"_5":14366,"_27421":120030,"_2948":120462},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3464":71514,"_30135":71342,"_20936":120464,"_5":14366,"_27421":120030,"_2948":120465},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3464":71515,"_30135":71342,"_20936":120467,"_5":14366,"_27421":120033,"_2948":120468},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3464":71516,"_30135":71342,"_20936":120470,"_5":14366,"_27421":120036,"_2948":120471},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3464":71517,"_30135":71342,"_20936":120473,"_5":14366,"_27421":120036,"_2948":120474},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3464":71518,"_30135":71342,"_20936":120476,"_5":14366,"_27421":120040,"_2948":120477},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3464":71519,"_30135":71342,"_20936":120479,"_5":14366,"_27421":120044,"_2948":120480},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3464":71520,"_30135":71342,"_20936":120482,"_5":14366,"_27421":120044,"_2948":120483},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3464":71521,"_30135":71342,"_20936":120485,"_5":14366,"_27421":120044,"_2948":120486},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3464":71522,"_30135":71342,"_20936":120488,"_5":14366,"_27421":120044,"_2948":120489},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3464":71523,"_30135":71342,"_20936":120491,"_5":14366,"_27421":120044,"_2948":120492},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3464":71524,"_30135":71342,"_20936":120494,"_5":14366,"_27421":120044,"_2948":120495},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3464":71525,"_30135":71342,"_20936":120497,"_5":14366,"_27421":120048,"_2948":120498},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3464":71526,"_30135":71342,"_20936":120500,"_5":14366,"_27421":120048,"_2948":120501},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3464":71527,"_30135":71342,"_20936":120503,"_5":14366,"_27421":120048,"_2948":120504},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3464":71528,"_30135":71342,"_20936":120506,"_5":14366,"_27421":120048,"_2948":120507},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3464":71529,"_30135":71342,"_20936":120509,"_5":14366,"_27421":120048,"_2948":120510},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3464":71530,"_30135":71342,"_20936":120512,"_5":14366,"_27421":120052,"_2948":120513},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3464":71531,"_30135":71342,"_20936":120515,"_5":14366,"_27421":120052,"_2948":120414},[],{"_3464":71532,"_30135":71342,"_20936":120517,"_5":14366,"_27421":120052,"_2948":120417},[],{"_3464":71533,"_30135":71342,"_20936":120519,"_5":14366,"_27421":120052,"_2948":120520},[],"`SinConfigurar` → `None` / `Auto`",{"_3464":71534,"_30135":71342,"_20936":120522,"_5":14366,"_27421":120052,"_2948":120523},[],"ninguna (solo configuración)",{"_3464":71535,"_30135":71342,"_20936":120525,"_5":14366,"_27421":120052,"_2948":53725},[],{"_3464":71536,"_30135":71342,"_20936":120527,"_5":14366,"_27421":120052,"_2948":120523},[],{"_3464":71537,"_30135":71342,"_20936":120529,"_5":14366,"_27421":120052,"_2948":120530},[],"Cualquiera → `Jitp`",{"_3464":71538,"_30135":71342,"_20936":120532,"_5":14366,"_27421":120052,"_2948":120533},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3464":71539,"_30135":71342,"_20936":120535,"_5":14366,"_27421":120052,"_2948":53736},[],{"_3464":71540,"_30135":71342,"_20936":120537,"_5":14366,"_27421":120052,"_2948":120538},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3464":71541,"_30135":71342,"_20936":120540,"_5":14366,"_27421":120056,"_2948":120541},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3464":71542,"_30135":71342,"_20936":120543,"_5":14366,"_27421":120056,"_2948":120544},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3464":71543,"_30135":71342,"_20936":120546,"_5":14366,"_27421":120056,"_2948":120547},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3464":71544,"_30135":71342,"_20936":120549,"_5":14366,"_27421":120060,"_2948":120550},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3464":71545,"_30135":71342,"_20936":120552,"_5":14366,"_27421":120060,"_2948":120414},[],{"_3464":71546,"_30135":71342,"_20936":120554,"_5":14366,"_27421":120060,"_2948":120417},[],{"_3464":71547,"_30135":71342,"_20936":120556,"_5":14366,"_27421":120060,"_2948":120557},[],"`Ausente` → `Aprovisionado`",{"_3464":71548,"_30135":71342,"_20936":120559,"_5":14366,"_27421":120060,"_2948":120560},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3464":71549,"_30135":71342,"_20936":120562,"_5":14366,"_27421":120060,"_2948":120563},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3464":71550,"_30135":71342,"_20936":120565,"_5":14366,"_27421":120060,"_2948":120566},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3464":71551,"_30135":71342,"_20936":120568,"_5":14366,"_27421":120060,"_2948":120569},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3464":71552,"_30135":71342,"_20936":120571,"_5":14366,"_27421":120064,"_2948":120572},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3464":71553,"_30135":71342,"_20936":120574,"_5":14366,"_27421":120064,"_2948":120575},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3464":71554,"_30135":71342,"_20936":120577,"_5":14366,"_27421":120064,"_2948":120578},[],"Para que el flujo JITP funcione correctamente:",{"_3464":71555,"_30135":71342,"_20936":120580,"_5":14366,"_27421":120064,"_2948":120581},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3464":71556,"_30135":71342,"_20936":120583,"_5":14366,"_27421":120064,"_2948":120584},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3464":71557,"_30135":71342,"_20936":120586,"_5":14366,"_27421":120064,"_2948":120587},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3464":71558,"_30135":71342,"_20936":120589,"_5":14366,"_27421":120064,"_2948":120590},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3464":71559,"_30135":71342,"_20936":120592,"_5":14366,"_27421":120068,"_2948":120593},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3464":71560,"_30135":71342,"_20936":120595,"_5":14366,"_27421":120068,"_2948":120596},[],"Estado en Lamassu",{"_3464":71561,"_30135":71342,"_20936":120598,"_5":14366,"_27421":120068,"_2948":120599},[],"Razón de revocación",{"_3464":71562,"_30135":71342,"_20936":120601,"_5":14366,"_27421":120068,"_2948":120602},[],"Estado en AWS IoT Core",{"_3464":71563,"_30135":71342,"_20936":120604,"_5":14366,"_27421":120068,"_2948":53806},[],{"_3464":71564,"_30135":71342,"_20936":120606,"_5":14366,"_27421":120068,"_2948":120607},[],"Ninguna",{"_3464":71565,"_30135":71342,"_20936":120609,"_5":14366,"_27421":120068,"_2948":53812},[],{"_3464":71566,"_30135":71342,"_20936":120611,"_5":14366,"_27421":120068,"_2948":53815},[],{"_3464":71567,"_30135":71342,"_20936":120613,"_5":14366,"_27421":120068,"_2948":53818},[],{"_3464":71568,"_30135":71342,"_20936":120615,"_5":14366,"_27421":120068,"_2948":53821},[],{"_3464":71569,"_30135":71342,"_20936":120617,"_5":14366,"_27421":120068,"_2948":53815},[],{"_3464":71570,"_30135":71342,"_20936":120619,"_5":14366,"_27421":120068,"_2948":120620},[],"Cualquier otra razón",{"_3464":71571,"_30135":71342,"_20936":120622,"_5":14366,"_27421":120068,"_2948":53829},[],{"_3464":71572,"_30135":71342,"_20936":120624,"_5":14366,"_27421":120068,"_2948":120625},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3464":71573,"_30135":71342,"_20936":120627,"_5":14366,"_27421":120072,"_2948":120628},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3464":71574,"_30135":71342,"_20936":120630,"_5":14366,"_27421":120072,"_2948":120414},[],{"_3464":71575,"_30135":71342,"_20936":120632,"_5":14366,"_27421":120072,"_2948":120417},[],{"_3464":71576,"_30135":71342,"_20936":120634,"_5":14366,"_27421":120072,"_2948":120635},[],"`NoSincronizado` → `Active`",{"_3464":71577,"_30135":71342,"_20936":120637,"_5":14366,"_27421":120072,"_2948":53321},[],{"_3464":71578,"_30135":71342,"_20936":120639,"_5":14366,"_27421":120072,"_2948":53847},[],{"_3464":71579,"_30135":71342,"_20936":120641,"_5":14366,"_27421":120072,"_2948":120642},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3464":71580,"_30135":71342,"_20936":120644,"_5":14366,"_27421":120072,"_2948":53853},[],{"_3464":71581,"_30135":71342,"_20936":120646,"_5":14366,"_27421":120072,"_2948":120642},[],{"_3464":71582,"_30135":71342,"_20936":120648,"_5":14366,"_27421":120072,"_2948":53858},[],{"_3464":71583,"_30135":71342,"_20936":120650,"_5":14366,"_27421":120072,"_2948":53321},[],{"_3464":71584,"_30135":71342,"_20936":120652,"_5":14366,"_27421":120072,"_2948":53863},[],{"_3464":71585,"_30135":71342,"_20936":120654,"_5":14366,"_27421":120072,"_2948":120655},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3464":71586,"_30135":71342,"_20936":120657,"_5":14366,"_27421":120076,"_2948":120658},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3464":71587,"_30135":71342,"_20936":120660,"_5":14366,"_27421":120076,"_2948":120661},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3464":71588,"_30135":71342,"_20936":120663,"_5":14366,"_27421":120076,"_2948":120664},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3464":71589,"_30135":71342,"_20936":120666,"_5":14366,"_27421":120080,"_2948":120667},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3464":71590,"_30135":71342,"_20936":120669,"_5":14366,"_27421":120080,"_2948":120670},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3464":71591,"_30135":71342,"_20936":120672,"_5":14366,"_27421":120084,"_2948":120673},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3464":71592,"_30135":71342,"_20936":120675,"_5":14366,"_27421":120084,"_2948":120676},[],"Existen dos tipos de acciones:",{"_3464":71593,"_30135":71342,"_20936":120678,"_5":14366,"_27421":120084,"_2948":120679},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3464":71594,"_30135":71342,"_20936":120681,"_5":14366,"_27421":120084,"_2948":120682},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3464":71595,"_30135":71342,"_20936":120684,"_5":14366,"_27421":120084,"_2948":120685},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3464":71596,"_30135":71342,"_20936":120687,"_5":14366,"_27421":120088,"_2948":120688},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3464":71597,"_30135":71342,"_20936":120690,"_5":14366,"_27421":120088,"_2948":120691},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3464":71598,"_30135":71342,"_20936":120693,"_5":14366,"_27421":120088,"_2948":120694},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3464":71599,"_30135":71342,"_20936":120696,"_5":14366,"_27421":120092,"_2948":120697},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3464":71600,"_30135":71342,"_20936":120699,"_5":14366,"_27421":120092,"_2948":120700},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3464":71601,"_30135":71342,"_20936":120702,"_5":14366,"_27421":120092,"_2948":120703},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3464":71602,"_30135":71342,"_20936":120705,"_5":14366,"_27421":120092,"_2948":120706},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3464":71603,"_30135":71342,"_20936":120708,"_5":14366,"_27421":120092,"_2948":120709},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3464":71604,"_30135":71342,"_20936":120711,"_5":14366,"_27421":120092,"_2948":120712},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3464":71605,"_30135":71342,"_20936":120714,"_5":14366,"_27421":120092,"_2948":120715},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3464":71606,"_30135":71342,"_20936":120717,"_5":14366,"_27421":120092,"_2948":120718},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3464":71607,"_30135":71342,"_20936":120720,"_5":14366,"_27421":120092,"_2948":120721},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3464":71608,"_30135":71342,"_20936":120723,"_5":14366,"_27421":120092,"_2948":120724},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3464":71609,"_30135":71342,"_20936":120726,"_5":14366,"_27421":120092,"_2948":120727},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3464":71610,"_30135":71342,"_20936":120729,"_5":14366,"_27421":120092,"_2948":120730},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3464":71611,"_30135":71342,"_20936":120732,"_5":14366,"_27421":120092,"_2948":120733},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3464":71612,"_30135":71342,"_20936":120735,"_5":14366,"_27421":120092,"_2948":120736},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3464":71613,"_30135":71342,"_20936":120738,"_5":14366,"_27421":120092,"_2948":120739},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3464":71614,"_30135":71342,"_20936":120741,"_5":14366,"_27421":120092,"_2948":120742},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3464":71615,"_30135":71342,"_20936":120744,"_5":14366,"_27421":120092,"_2948":120745},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3464":71616,"_30135":71342,"_20936":120747,"_5":14366,"_27421":120092,"_2948":120748},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3464":71617,"_30135":71342,"_20936":120750,"_5":14366,"_27421":120092,"_2948":120751},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3464":71618,"_30135":71342,"_20936":120753,"_5":14366,"_27421":120092,"_2948":120754},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3464":71619,"_30135":71342,"_20936":120756,"_5":14366,"_27421":120092,"_2948":120757},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3464":71620,"_30135":71342,"_20936":120759,"_5":14366,"_27421":120092,"_2948":120760},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":71621,"_30135":71342,"_20936":120762,"_5":14366,"_27421":120092,"_2948":120763},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3464":71622,"_30135":71342,"_20936":120765,"_5":14366,"_27421":120092,"_2948":120766},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3464":71623,"_30135":71623,"_5":14718,"_2948":51684,"_30488":120768,"_20936":120769,"_27421":71623},[49202,117572,51684],[],{"_3464":71624,"_30135":71623,"_20936":120771,"_5":14366,"_27421":71623,"_2948":120772},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3464":71625,"_30135":71623,"_5":30485,"_20936":120774,"_27421":120775,"_2948":120776},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3464":71626,"_30135":71623,"_5":30485,"_20936":120778,"_27421":120779,"_2948":118584},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3464":71627,"_30135":71623,"_5":30485,"_20936":120781,"_27421":120782,"_2948":118759},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3464":71628,"_30135":71623,"_5":30485,"_20936":120784,"_27421":120785,"_2948":119991},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#integraciones",{"_3464":71629,"_30135":71623,"_5":30485,"_20936":120787,"_27421":120788,"_2948":120789},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3464":71630,"_30135":71623,"_20936":120791,"_5":14366,"_27421":71623,"_2948":120792},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3464":71631,"_30135":71623,"_20936":120794,"_5":14366,"_27421":120775,"_2948":120795},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3464":71632,"_30135":71623,"_20936":120797,"_5":14366,"_27421":120775,"_2948":120798},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3464":71633,"_30135":71623,"_20936":120800,"_5":14366,"_27421":120779,"_2948":120801},[],"Recurso",{"_3464":71634,"_30135":71623,"_20936":120803,"_5":14366,"_27421":120779,"_2948":120804},[],"Qué representa",{"_3464":71635,"_30135":71623,"_20936":120806,"_5":14366,"_27421":120779,"_2948":120807},[],"**Dispositivo**",{"_3464":71636,"_30135":71623,"_20936":120809,"_5":14366,"_27421":120779,"_2948":120810},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3464":71637,"_30135":71623,"_20936":120812,"_5":14366,"_27421":120779,"_2948":120813},[],"**Identidad**",{"_3464":71638,"_30135":71623,"_20936":120815,"_5":14366,"_27421":120779,"_2948":120816},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3464":71639,"_30135":71623,"_20936":120818,"_5":14366,"_27421":120779,"_2948":54030},[],{"_3464":71640,"_30135":71623,"_20936":120820,"_5":14366,"_27421":120779,"_2948":120821},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3464":71641,"_30135":71623,"_20936":120823,"_5":14366,"_27421":120779,"_2948":120824},[],"**Flota**",{"_3464":71642,"_30135":71623,"_20936":120826,"_5":14366,"_27421":120779,"_2948":120827},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3464":71643,"_30135":71623,"_20936":120829,"_5":14366,"_27421":120779,"_2948":120830},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3464":71644,"_30135":71623,"_20936":120832,"_5":14366,"_27421":120779,"_2948":120833},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3464":71645,"_30135":71623,"_20936":120835,"_5":14366,"_27421":120782,"_2948":120836},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3464":71646,"_30135":71623,"_20936":120838,"_5":14366,"_27421":120782,"_2948":120839},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3464":71647,"_30135":71623,"_20936":120841,"_5":14366,"_27421":120782,"_2948":120842},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3464":71648,"_30135":71623,"_20936":120844,"_5":14366,"_27421":120782,"_2948":120845},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3464":71649,"_30135":71623,"_20936":120847,"_5":14366,"_27421":120782,"_2948":120848},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3464":71650,"_30135":71623,"_20936":120850,"_5":14366,"_27421":120782,"_2948":120851},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3464":71651,"_30135":71623,"_20936":120853,"_5":14366,"_27421":120782,"_2948":120854},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":71652,"_30135":71623,"_20936":120856,"_5":14366,"_27421":120782,"_2948":120857},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3464":71653,"_30135":71623,"_20936":120859,"_5":14366,"_27421":120785,"_2948":120860},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3464":71654,"_30135":71623,"_20936":120862,"_5":14366,"_27421":120785,"_2948":120863},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3464":71655,"_30135":71623,"_20936":120865,"_5":14366,"_27421":120788,"_2948":120866},[],"Participante",{"_3464":71656,"_30135":71623,"_20936":120868,"_5":14366,"_27421":120788,"_2948":120869},[],"Responsabilidad",{"_3464":71657,"_30135":71623,"_20936":120871,"_5":14366,"_27421":120788,"_2948":120872},[],"Administrador PKI",{"_3464":71658,"_30135":71623,"_20936":120874,"_5":14366,"_27421":120788,"_2948":120875},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3464":71659,"_30135":71623,"_20936":120877,"_5":14366,"_27421":120788,"_2948":120878},[],"Administrador del aprovisionamiento",{"_3464":71660,"_30135":71623,"_20936":120880,"_5":14366,"_27421":120788,"_2948":120881},[],"DMS, admisión, autenticación por operación e inventario.",{"_3464":71661,"_30135":71623,"_20936":120883,"_5":14366,"_27421":120788,"_2948":120884},[],"Integrador del dispositivo",{"_3464":71662,"_30135":71623,"_20936":120886,"_5":14366,"_27421":120788,"_2948":120887},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3464":71663,"_30135":71623,"_20936":120889,"_5":14366,"_27421":120788,"_2948":120890},[],"Integrador del consumidor",{"_3464":71664,"_30135":71623,"_20936":120892,"_5":14366,"_27421":120788,"_2948":120893},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3464":71665,"_30135":71623,"_20936":120895,"_5":14366,"_27421":120788,"_2948":120896},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3464":71666,"_30135":71666,"_5":14718,"_2948":120898,"_30488":120899,"_20936":120901,"_27421":71666},"Enrola y conecta tu primer dispositivo",[49202,117572,51684,120900],"Primeros pasos",[],{"_3464":71667,"_30135":71666,"_20936":120903,"_5":14366,"_27421":71666,"_2948":120904},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3464":71668,"_30135":71666,"_5":30485,"_20936":120906,"_27421":120907,"_2948":116150},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3464":71669,"_30135":71666,"_5":30485,"_20936":120909,"_27421":120910,"_2948":120911},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3464":71670,"_30135":71666,"_5":30485,"_20936":120913,"_27421":120914,"_2948":120915},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3464":71671,"_30135":71666,"_5":30485,"_20936":120917,"_27421":120918,"_2948":120919},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3464":71672,"_30135":71666,"_5":30485,"_20936":120921,"_27421":120922,"_2948":120923},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3464":71673,"_30135":71666,"_5":30485,"_20936":120925,"_27421":120926,"_2948":120927},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3464":71674,"_30135":71666,"_5":30485,"_20936":120929,"_27421":120930,"_2948":120931},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3464":71675,"_30135":71666,"_5":30485,"_20936":120933,"_27421":120934,"_2948":120935},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3464":71676,"_30135":71666,"_20936":120937,"_5":14366,"_27421":71666,"_2948":120938},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3464":71677,"_30135":71666,"_20936":120940,"_5":14366,"_27421":120907,"_2948":120941},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3464":71678,"_30135":71666,"_20936":120943,"_5":14366,"_27421":120907,"_2948":120944},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3464":71679,"_30135":71666,"_20936":120946,"_5":14366,"_27421":120907,"_2948":120947},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3464":71680,"_30135":71666,"_20936":120949,"_5":14366,"_27421":120907,"_2948":120950},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3464":71681,"_30135":71666,"_20936":120952,"_5":14366,"_27421":120907,"_2948":120953},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3464":71682,"_30135":71666,"_20936":120955,"_5":14366,"_27421":120910,"_2948":120956},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3464":71683,"_30135":71666,"_20936":120958,"_5":14366,"_27421":120910,"_2948":120959},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3464":71684,"_30135":71666,"_20936":120961,"_5":14366,"_27421":120914,"_2948":120962},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3464":71685,"_30135":71666,"_20936":120964,"_5":14366,"_27421":120914,"_2948":120965},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3464":71686,"_30135":71666,"_20936":120967,"_5":14366,"_27421":120914,"_2948":120968},[],"Ajuste",{"_3464":71687,"_30135":71666,"_20936":120970,"_5":14366,"_27421":120914,"_2948":120971},[],"Valor de evaluación",{"_3464":71688,"_30135":71666,"_20936":120973,"_5":14366,"_27421":120914,"_2948":54186},[],{"_3464":71689,"_30135":71666,"_20936":120975,"_5":14366,"_27421":120914,"_2948":120976},[],"Raíz emisora de `device-root.pem`.",{"_3464":71690,"_30135":71666,"_20936":120978,"_5":14366,"_27421":120914,"_2948":118887},[],{"_3464":71691,"_30135":71666,"_20936":120980,"_5":14366,"_27421":120914,"_2948":120981},[],"Perfil final de 1 hora que acabas de preparar.",{"_3464":71692,"_30135":71666,"_20936":120983,"_5":14366,"_27421":120914,"_2948":54197},[],{"_3464":71693,"_30135":71666,"_20936":120985,"_5":14366,"_27421":120914,"_2948":54200},[],{"_3464":71694,"_30135":71666,"_20936":120987,"_5":14366,"_27421":120914,"_2948":54203},[],{"_3464":71695,"_30135":71666,"_20936":120989,"_5":14366,"_27421":120914,"_2948":120990},[],"Habilitado.",{"_3464":71696,"_30135":71666,"_20936":120992,"_5":14366,"_27421":120914,"_2948":54209},[],{"_3464":71697,"_30135":71666,"_20936":120994,"_5":14366,"_27421":120914,"_2948":120995},[],"Deshabilitado; el ID debe ser nuevo.",{"_3464":71698,"_30135":71666,"_20936":120997,"_5":14366,"_27421":120914,"_2948":120998},[],"Autenticación inicial",{"_3464":71699,"_30135":71666,"_20936":121000,"_5":14366,"_27421":120914,"_2948":121001},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3464":71700,"_30135":71666,"_20936":121003,"_5":14366,"_27421":120914,"_2948":121004},[],"Autenticación de renovación",{"_3464":71701,"_30135":71666,"_20936":121006,"_5":14366,"_27421":120914,"_2948":121007},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3464":71702,"_30135":71666,"_20936":121009,"_5":14366,"_27421":120914,"_2948":54227},[],{"_3464":71703,"_30135":71666,"_20936":121011,"_5":14366,"_27421":120914,"_2948":121012},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3464":71704,"_30135":71666,"_20936":121014,"_5":14366,"_27421":120914,"_2948":54233},[],{"_3464":71705,"_30135":71666,"_20936":121016,"_5":14366,"_27421":120914,"_2948":121017},[],"1 hora.",{"_3464":71706,"_30135":71666,"_20936":121019,"_5":14366,"_27421":120914,"_2948":54239},[],{"_3464":71707,"_30135":71666,"_20936":121021,"_5":14366,"_27421":120914,"_2948":121022},[],"30 minutos / 10 minutos.",{"_3464":71708,"_30135":71666,"_20936":121024,"_5":14366,"_27421":120914,"_2948":54245},[],{"_3464":71709,"_30135":71666,"_20936":121026,"_5":14366,"_27421":120914,"_2948":121027},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3464":71710,"_30135":71666,"_20936":121029,"_5":14366,"_27421":120914,"_2948":52003},[],{"_3464":71711,"_30135":71666,"_20936":121031,"_5":14366,"_27421":120914,"_2948":121032},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3464":71712,"_30135":71666,"_20936":121034,"_5":14366,"_27421":120914,"_2948":54256},[],{"_3464":71713,"_30135":71666,"_20936":121036,"_5":14366,"_27421":120914,"_2948":121037},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3464":71714,"_30135":71666,"_20936":121039,"_5":14366,"_27421":120914,"_2948":121040},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3464":71715,"_30135":71666,"_20936":121042,"_5":14366,"_27421":120918,"_2948":121043},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3464":71716,"_30135":71666,"_20936":121045,"_5":14366,"_27421":120918,"_2948":121046},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3464":71717,"_30135":71666,"_20936":121048,"_5":14366,"_27421":120922,"_2948":121049},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3464":71718,"_30135":71666,"_20936":121051,"_5":14366,"_27421":120922,"_2948":121052},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3464":71719,"_30135":71666,"_20936":121054,"_5":14366,"_27421":120922,"_2948":121055},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3464":71720,"_30135":71666,"_20936":121057,"_5":14366,"_27421":120926,"_2948":121058},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3464":71721,"_30135":71666,"_20936":121060,"_5":14366,"_27421":120926,"_2948":121061},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3464":71722,"_30135":71666,"_20936":121063,"_5":14366,"_27421":120930,"_2948":121064},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3464":71723,"_30135":71666,"_20936":121066,"_5":14366,"_27421":120930,"_2948":121067},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3464":71724,"_30135":71666,"_20936":121069,"_5":14366,"_27421":120930,"_2948":121070},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3464":71725,"_30135":71666,"_20936":121072,"_5":14366,"_27421":120930,"_2948":121073},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3464":71726,"_30135":71666,"_20936":121075,"_5":14366,"_27421":120930,"_2948":121076},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3464":71727,"_30135":71666,"_20936":121078,"_5":14366,"_27421":120934,"_2948":121079},[],"Comprobación",{"_3464":71728,"_30135":71666,"_20936":121081,"_5":14366,"_27421":120934,"_2948":121082},[],"Resultado esperado",{"_3464":71729,"_30135":71666,"_20936":121084,"_5":14366,"_27421":120934,"_2948":121085},[],"Registro",{"_3464":71730,"_30135":71666,"_20936":121087,"_5":14366,"_27421":120934,"_2948":121088},[],"ID creado automáticamente y DMS correcto.",{"_3464":71731,"_30135":71666,"_20936":121090,"_5":14366,"_27421":120934,"_2948":120375},[],{"_3464":71732,"_30135":71666,"_20936":121092,"_5":14366,"_27421":120934,"_2948":121093},[],"CN, perfil, serie y clave verificados.",{"_3464":71733,"_30135":71666,"_20936":121095,"_5":14366,"_27421":120934,"_2948":121096},[],"Inventario",{"_3464":71734,"_30135":71666,"_20936":121098,"_5":14366,"_27421":120934,"_2948":121099},[],"Serie recibida visible como identidad actual y en el historial.",{"_3464":71735,"_30135":71666,"_20936":121101,"_5":14366,"_27421":120934,"_2948":121102},[],"Consumidor",{"_3464":71736,"_30135":71666,"_20936":121104,"_5":14366,"_27421":120934,"_2948":121105},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3464":71737,"_30135":71666,"_20936":121107,"_5":14366,"_27421":120934,"_2948":121108},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3464":71738,"_30135":71666,"_20936":121110,"_5":14366,"_27421":120934,"_2948":121111},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3464":71739,"_30135":71739,"_5":14718,"_2948":118601,"_30488":121113,"_20936":121114,"_27421":71739},[49202,117572,51684,120900],[],{"_3464":71740,"_30135":71739,"_20936":121116,"_5":14366,"_27421":71739,"_2948":121117},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3464":71741,"_30135":71739,"_5":30485,"_20936":121119,"_27421":121120,"_2948":116150},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3464":71742,"_30135":71739,"_5":30485,"_20936":121122,"_27421":121123,"_2948":121124},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3464":71743,"_30135":71739,"_5":30485,"_20936":121126,"_27421":121127,"_2948":121128},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3464":71744,"_30135":71739,"_5":30485,"_20936":121130,"_27421":121131,"_2948":121132},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3464":71745,"_30135":71739,"_5":30485,"_20936":121134,"_27421":121135,"_2948":121136},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3464":71746,"_30135":71739,"_5":30485,"_20936":121138,"_27421":121139,"_2948":121140},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3464":71747,"_30135":71739,"_5":30485,"_20936":121142,"_27421":121143,"_2948":121082},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3464":71748,"_30135":71739,"_5":30485,"_20936":121145,"_27421":121146,"_2948":121147},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3464":71749,"_30135":71739,"_5":30485,"_20936":121149,"_27421":121150,"_2948":121151},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3464":71750,"_30135":71739,"_20936":121153,"_5":14366,"_27421":71739,"_2948":121154},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3464":71751,"_30135":71739,"_20936":121156,"_5":14366,"_27421":71739,"_2948":121157},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3464":71752,"_30135":71739,"_20936":121159,"_5":14366,"_27421":121120,"_2948":121160},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3464":71753,"_30135":71739,"_20936":121162,"_5":14366,"_27421":121120,"_2948":121163},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3464":71754,"_30135":71739,"_20936":121165,"_5":14366,"_27421":121120,"_2948":121166},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3464":71755,"_30135":71739,"_20936":121168,"_5":14366,"_27421":121120,"_2948":121169},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3464":71756,"_30135":71739,"_20936":121171,"_5":14366,"_27421":121123,"_2948":121172},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3464":71757,"_30135":71739,"_20936":121174,"_5":14366,"_27421":121123,"_2948":121175},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3464":71758,"_30135":71739,"_20936":121177,"_5":14366,"_27421":121123,"_2948":121178},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3464":71759,"_30135":71739,"_20936":121180,"_5":14366,"_27421":121123,"_2948":121181},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3464":71760,"_30135":71739,"_20936":121183,"_5":14366,"_27421":121123,"_2948":121184},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3464":71761,"_30135":71739,"_20936":121186,"_5":14366,"_27421":121123,"_2948":121187},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3464":71762,"_30135":71739,"_20936":121189,"_5":14366,"_27421":121123,"_2948":121190},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3464":71763,"_30135":71739,"_20936":121192,"_5":14366,"_27421":121123,"_2948":121193},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3464":71764,"_30135":71739,"_20936":121195,"_5":14366,"_27421":121127,"_2948":121196},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3464":71765,"_30135":71739,"_20936":121198,"_5":14366,"_27421":121127,"_2948":54421},[],{"_3464":71766,"_30135":71739,"_20936":121200,"_5":14366,"_27421":121127,"_2948":121201},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3464":71767,"_30135":71739,"_20936":121203,"_5":14366,"_27421":121127,"_2948":121204},[],"**Icon** y **Tags**: clasificación opcional.",{"_3464":71768,"_30135":71739,"_20936":121206,"_5":14366,"_27421":121127,"_2948":121207},[],"Confirma el registro.",{"_3464":71769,"_30135":71739,"_20936":121209,"_5":14366,"_27421":121131,"_2948":121210},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3464":71770,"_30135":71739,"_20936":121212,"_5":14366,"_27421":121131,"_2948":121213},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3464":71771,"_30135":71739,"_20936":121215,"_5":14366,"_27421":121135,"_2948":121216},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3464":71772,"_30135":71739,"_20936":121218,"_5":14366,"_27421":121135,"_2948":121219},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3464":71773,"_30135":71739,"_20936":121221,"_5":14366,"_27421":121139,"_2948":121222},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3464":71774,"_30135":71739,"_20936":121224,"_5":14366,"_27421":121139,"_2948":121225},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3464":71775,"_30135":71739,"_20936":121227,"_5":14366,"_27421":121143,"_2948":121079},[],{"_3464":71776,"_30135":71739,"_20936":121229,"_5":14366,"_27421":121143,"_2948":121230},[],"Resultado",{"_3464":71777,"_30135":71739,"_20936":121232,"_5":14366,"_27421":121143,"_2948":120361},[],{"_3464":71778,"_30135":71739,"_20936":121234,"_5":14366,"_27421":121143,"_2948":121235},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3464":71779,"_30135":71739,"_20936":121237,"_5":14366,"_27421":121143,"_2948":121238},[],"Identidad actual",{"_3464":71780,"_30135":71739,"_20936":121240,"_5":14366,"_27421":121143,"_2948":121241},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3464":71781,"_30135":71739,"_20936":121243,"_5":14366,"_27421":121143,"_2948":121244},[],"Historial",{"_3464":71782,"_30135":71739,"_20936":121246,"_5":14366,"_27421":121143,"_2948":121247},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3464":71783,"_30135":71739,"_20936":121249,"_5":14366,"_27421":121143,"_2948":121250},[],"Clave y certificado",{"_3464":71784,"_30135":71739,"_20936":121252,"_5":14366,"_27421":121143,"_2948":121253},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3464":71785,"_30135":71739,"_20936":121255,"_5":14366,"_27421":121146,"_2948":121256},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3464":71786,"_30135":71739,"_20936":121258,"_5":14366,"_27421":121146,"_2948":121259},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3464":71787,"_30135":71739,"_20936":121261,"_5":14366,"_27421":121146,"_2948":121262},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3464":71788,"_30135":71739,"_20936":121264,"_5":14366,"_27421":121146,"_2948":121265},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3464":71789,"_30135":71739,"_20936":121267,"_5":14366,"_27421":121150,"_2948":121268},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3464":71790,"_30135":71739,"_20936":121270,"_5":14366,"_27421":121150,"_2948":121271},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3464":71791,"_30135":71739,"_20936":121273,"_5":14366,"_27421":121150,"_2948":121274},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3464":71792,"_30135":71792,"_5":14718,"_2948":121276,"_30488":121277,"_20936":121278,"_27421":71792},"Plataforma Lamassu IoT",[49202,117572],[],{"_3464":71793,"_30135":71792,"_20936":121280,"_5":14366,"_27421":71792,"_2948":121281},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3464":71794,"_30135":71792,"_5":30485,"_20936":121283,"_27421":121284,"_2948":121285},[],"/docs/pr-preview/pr-61/es/platform/overview#explora-la-consola","Explora la consola",{"_3464":71795,"_30135":71792,"_5":30485,"_20936":121287,"_27421":121288,"_2948":120776},[],"/docs/pr-preview/pr-61/es/platform/overview#empieza-aquí",{"_3464":71796,"_30135":71792,"_5":30485,"_20936":121290,"_27421":121291,"_2948":121292},[],"/docs/pr-preview/pr-61/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3464":71797,"_30135":71792,"_5":30485,"_20936":121294,"_27421":121295,"_2948":121296},[],"/docs/pr-preview/pr-61/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3464":71798,"_30135":71792,"_5":30485,"_20936":121298,"_27421":121299,"_2948":121300},[],"/docs/pr-preview/pr-61/es/platform/overview#capacidades-principales","Capacidades principales",{"_3464":71799,"_30135":71792,"_5":30485,"_20936":121302,"_27421":121303,"_2948":121304},[],"/docs/pr-preview/pr-61/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3464":71800,"_30135":71792,"_5":30485,"_20936":121306,"_27421":121307,"_2948":121308},[],"/docs/pr-preview/pr-61/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3464":71801,"_30135":71792,"_5":30485,"_20936":121310,"_27421":121311,"_2948":121312},[],"/docs/pr-preview/pr-61/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3464":71802,"_30135":71792,"_5":30485,"_20936":121314,"_27421":121315,"_2948":121316},[],"/docs/pr-preview/pr-61/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3464":71803,"_30135":71792,"_5":30485,"_20936":121318,"_27421":121319,"_2948":121320},[],"/docs/pr-preview/pr-61/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3464":71804,"_30135":71792,"_5":30485,"_20936":121322,"_27421":121323,"_2948":121324},[],"/docs/pr-preview/pr-61/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3464":71805,"_30135":71792,"_5":30485,"_20936":121326,"_27421":121327,"_2948":121328},[],"/docs/pr-preview/pr-61/es/platform/overview#referencia-operativa","Referencia operativa",{"_3464":71806,"_30135":71792,"_20936":121330,"_5":14366,"_27421":71792,"_2948":121331},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3464":71807,"_30135":71792,"_20936":121333,"_5":14366,"_27421":121284,"_2948":121334},[],"Recorre de forma interactiva los certificados, las autoridades de certificación y los dispositivos.",{"_3464":71808,"_30135":71792,"_20936":121336,"_5":14366,"_27421":121288,"_2948":121337},[],"Elige el resultado que necesitas obtener:",{"_3464":71809,"_30135":71792,"_20936":121339,"_5":14366,"_27421":121288,"_2948":121340},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3464":71810,"_30135":71792,"_20936":121342,"_5":14366,"_27421":121288,"_2948":121343},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3464":71811,"_30135":71792,"_20936":121345,"_5":14366,"_27421":121288,"_2948":121346},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3464":71812,"_30135":71792,"_20936":121348,"_5":14366,"_27421":121291,"_2948":121349},[],"Bloque",{"_3464":71813,"_30135":71792,"_20936":121351,"_5":14366,"_27421":121291,"_2948":121352},[],"Qué gestionas",{"_3464":71814,"_30135":71792,"_20936":121354,"_5":14366,"_27421":121291,"_2948":121355},[],"Punto de entrada",{"_3464":71815,"_30135":71792,"_20936":121357,"_5":14366,"_27421":121291,"_2948":54581},[],{"_3464":71816,"_30135":71792,"_20936":121359,"_5":14366,"_27421":121291,"_2948":121360},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3464":71817,"_30135":71792,"_20936":121362,"_5":14366,"_27421":121291,"_2948":121363},[],"Visión general de PKI",{"_3464":71818,"_30135":71792,"_20936":121365,"_5":14366,"_27421":121291,"_2948":54590},[],{"_3464":71819,"_30135":71792,"_20936":121367,"_5":14366,"_27421":121291,"_2948":121368},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3464":71820,"_30135":71792,"_20936":121370,"_5":14366,"_27421":121291,"_2948":121371},[],"Visión general de IoT Fleets",{"_3464":71821,"_30135":71792,"_20936":121373,"_5":14366,"_27421":121291,"_2948":121374},[],"**Administración**",{"_3464":71822,"_30135":71792,"_20936":121376,"_5":14366,"_27421":121291,"_2948":121377},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3464":71823,"_30135":71792,"_20936":121379,"_5":14366,"_27421":121291,"_2948":117570},[],{"_3464":71824,"_30135":71792,"_20936":121381,"_5":14366,"_27421":121291,"_2948":121382},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3464":71825,"_30135":71792,"_20936":121384,"_5":14366,"_27421":121295,"_2948":121385},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3464":71826,"_30135":71792,"_20936":121387,"_5":14366,"_27421":121295,"_2948":121388},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3464":71827,"_30135":71792,"_20936":121390,"_5":14366,"_27421":121295,"_2948":121391},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3464":71828,"_30135":71792,"_20936":121393,"_5":14366,"_27421":121295,"_2948":121394},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3464":71829,"_30135":71792,"_20936":121396,"_5":14366,"_27421":121295,"_2948":121397},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3464":71830,"_30135":71792,"_20936":121399,"_5":14366,"_27421":121295,"_2948":121400},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3464":71831,"_30135":71792,"_20936":121402,"_5":14366,"_27421":121303,"_2948":121403},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3464":71832,"_30135":71792,"_20936":121405,"_5":14366,"_27421":121307,"_2948":121406},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3464":71833,"_30135":71792,"_20936":121408,"_5":14366,"_27421":121311,"_2948":121409},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3464":71834,"_30135":71792,"_20936":121411,"_5":14366,"_27421":121315,"_2948":121412},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3464":71835,"_30135":71792,"_20936":121414,"_5":14366,"_27421":121319,"_2948":121415},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3464":71836,"_30135":71792,"_20936":121417,"_5":14366,"_27421":121323,"_2948":121418},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3464":71837,"_30135":71792,"_20936":121420,"_5":14366,"_27421":121327,"_2948":120869},[],{"_3464":71838,"_30135":71792,"_20936":121422,"_5":14366,"_27421":121327,"_2948":121423},[],"Qué prepara o comprueba",{"_3464":71839,"_30135":71792,"_20936":121425,"_5":14366,"_27421":121327,"_2948":120872},[],{"_3464":71840,"_30135":71792,"_20936":121427,"_5":14366,"_27421":121327,"_2948":121428},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3464":71841,"_30135":71792,"_20936":121430,"_5":14366,"_27421":121327,"_2948":121431},[],"Administrador de la flota",{"_3464":71842,"_30135":71792,"_20936":121433,"_5":14366,"_27421":121327,"_2948":121434},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3464":71843,"_30135":71792,"_20936":121436,"_5":14366,"_27421":121327,"_2948":120884},[],{"_3464":71844,"_30135":71792,"_20936":121438,"_5":14366,"_27421":121327,"_2948":121439},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3464":71845,"_30135":71792,"_20936":121441,"_5":14366,"_27421":121327,"_2948":120890},[],{"_3464":71846,"_30135":71792,"_20936":121443,"_5":14366,"_27421":121327,"_2948":121444},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3464":71847,"_30135":71792,"_20936":121446,"_5":14366,"_27421":121327,"_2948":121447},[],"Operador de infraestructura",{"_3464":71848,"_30135":71792,"_20936":121449,"_5":14366,"_27421":121327,"_2948":121450},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3464":71849,"_30135":71792,"_20936":121452,"_5":14366,"_27421":121327,"_2948":121453},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3464":71850,"_30135":71850,"_5":14718,"_2948":121455,"_30488":121456,"_20936":121458,"_27421":71850},"Jerarquía y rotación de CAs",[49202,117572,54682,121457],"Claves, autoridades y certificados",[],{"_3464":71851,"_30135":71850,"_20936":121460,"_5":14366,"_27421":71850,"_2948":121461},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3464":71852,"_30135":71850,"_5":30485,"_20936":121463,"_27421":121464,"_2948":121465},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3464":71853,"_30135":71850,"_5":30485,"_20936":121467,"_27421":121468,"_2948":121469},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3464":71854,"_30135":71850,"_5":30485,"_20936":121471,"_27421":121472,"_2948":121473},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3464":71855,"_30135":71850,"_5":30485,"_20936":121475,"_27421":121476,"_2948":121477},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3464":71856,"_30135":71850,"_5":30485,"_20936":121479,"_27421":121480,"_2948":121481},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3464":71857,"_30135":71850,"_5":30485,"_20936":121483,"_27421":121484,"_2948":121485},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3464":71858,"_30135":71850,"_5":30485,"_20936":121487,"_27421":121488,"_2948":121489},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3464":71859,"_30135":71850,"_5":30485,"_20936":121491,"_27421":121492,"_2948":121493},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3464":71860,"_30135":71850,"_5":30485,"_20936":121495,"_27421":121496,"_2948":121497},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3464":71861,"_30135":71850,"_5":30485,"_20936":121499,"_27421":121500,"_2948":121501},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3464":71862,"_30135":71850,"_5":30485,"_20936":121503,"_27421":121504,"_2948":121505},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3464":71863,"_30135":71850,"_5":30485,"_20936":121507,"_27421":121508,"_2948":121509},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3464":71864,"_30135":71850,"_20936":121511,"_5":14366,"_27421":71850,"_2948":121512},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3464":71865,"_30135":71850,"_20936":121514,"_5":14366,"_27421":71850,"_2948":121515},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3464":71866,"_30135":71850,"_20936":121517,"_5":14366,"_27421":121464,"_2948":121518},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3464":71867,"_30135":71850,"_20936":121520,"_5":14366,"_27421":121464,"_2948":121521},[],"entorno, como producción y preproducción;",{"_3464":71868,"_30135":71850,"_20936":121523,"_5":14366,"_27421":121464,"_2948":121524},[],"propietario o equipo operador;",{"_3464":71869,"_30135":71850,"_20936":121526,"_5":14366,"_27421":121464,"_2948":121527},[],"familia de dispositivos o proceso de fabricación;",{"_3464":71870,"_30135":71850,"_20936":121529,"_5":14366,"_27421":121464,"_2948":121530},[],"región o requisito regulatorio;",{"_3464":71871,"_30135":71850,"_20936":121532,"_5":14366,"_27421":121464,"_2948":121533},[],"motor criptográfico o política de clave;",{"_3464":71872,"_30135":71850,"_20936":121535,"_5":14366,"_27421":121464,"_2948":121536},[],"ventana de mantenimiento y ritmo de renovación.",{"_3464":71873,"_30135":71850,"_20936":121538,"_5":14366,"_27421":121464,"_2948":121539},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3464":71874,"_30135":71850,"_20936":121541,"_5":14366,"_27421":121464,"_2948":121542},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3464":71875,"_30135":71850,"_20936":121544,"_5":14366,"_27421":121468,"_2948":121545},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3464":71876,"_30135":71850,"_20936":121547,"_5":14366,"_27421":121468,"_2948":121548},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3464":71877,"_30135":71850,"_20936":121550,"_5":14366,"_27421":121468,"_2948":121551},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3464":71878,"_30135":71850,"_20936":121553,"_5":14366,"_27421":121468,"_2948":121554},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3464":71879,"_30135":71850,"_20936":121556,"_5":14366,"_27421":121472,"_2948":121557},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3464":71880,"_30135":71850,"_20936":121559,"_5":14366,"_27421":121472,"_2948":121560},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3464":71881,"_30135":71850,"_20936":121562,"_5":14366,"_27421":121472,"_2948":121563},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3464":71882,"_30135":71850,"_20936":121565,"_5":14366,"_27421":121472,"_2948":121566},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3464":71883,"_30135":71850,"_20936":121568,"_5":14366,"_27421":121480,"_2948":121569},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3464":71884,"_30135":71850,"_20936":121571,"_5":14366,"_27421":121484,"_2948":121572},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3464":71885,"_30135":71850,"_20936":121574,"_5":14366,"_27421":121488,"_2948":121575},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3464":71886,"_30135":71850,"_20936":121577,"_5":14366,"_27421":121492,"_2948":121578},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3464":71887,"_30135":71850,"_20936":121580,"_5":14366,"_27421":121496,"_2948":121581},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3464":71888,"_30135":71850,"_20936":121583,"_5":14366,"_27421":121500,"_2948":121584},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3464":71889,"_30135":71850,"_20936":121586,"_5":14366,"_27421":121504,"_2948":121587},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3464":71890,"_30135":71850,"_20936":121589,"_5":14366,"_27421":121504,"_2948":121590},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3464":71891,"_30135":71850,"_20936":121592,"_5":14366,"_27421":121504,"_2948":121593},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3464":71892,"_30135":71850,"_20936":121595,"_5":14366,"_27421":121504,"_2948":121596},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3464":71893,"_30135":71850,"_20936":121598,"_5":14366,"_27421":121508,"_2948":121599},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3464":71894,"_30135":71850,"_20936":121601,"_5":14366,"_27421":121508,"_2948":121602},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3464":71895,"_30135":71850,"_20936":121604,"_5":14366,"_27421":121508,"_2948":121605},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3464":71896,"_30135":71850,"_20936":121607,"_5":14366,"_27421":121508,"_2948":121608},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3464":71897,"_30135":71850,"_20936":121610,"_5":14366,"_27421":121508,"_2948":121611},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3464":71898,"_30135":71850,"_20936":121613,"_5":14366,"_27421":121508,"_2948":121614},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3464":71899,"_30135":71850,"_20936":121616,"_5":14366,"_27421":121508,"_2948":121617},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3464":71900,"_30135":71900,"_5":14718,"_2948":121619,"_30488":121620,"_20936":121621,"_27421":71900},"Autoridades de certificación",[49202,117572,54682,121457],[],{"_3464":71901,"_30135":71900,"_20936":121623,"_5":14366,"_27421":71900,"_2948":121624},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3464":71902,"_30135":71900,"_5":30485,"_20936":121626,"_27421":121627,"_2948":121628},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3464":71903,"_30135":71900,"_5":30485,"_20936":121630,"_27421":121631,"_2948":121632},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3464":71904,"_30135":71900,"_5":30485,"_20936":121634,"_27421":121635,"_2948":116150},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3464":71905,"_30135":71900,"_5":30485,"_20936":121637,"_27421":121638,"_2948":121639},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3464":71906,"_30135":71900,"_5":30485,"_20936":121641,"_27421":121642,"_2948":121643},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3464":71907,"_30135":71900,"_5":30485,"_20936":121645,"_27421":121646,"_2948":121647},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3464":71908,"_30135":71900,"_5":30485,"_20936":121649,"_27421":121650,"_2948":121651},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3464":71909,"_30135":71900,"_5":30485,"_20936":121653,"_27421":121654,"_2948":121655},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3464":71910,"_30135":71900,"_5":30485,"_20936":121657,"_27421":121658,"_2948":121659},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3464":71911,"_30135":71900,"_5":30485,"_20936":121661,"_27421":121662,"_2948":121663},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3464":71912,"_30135":71900,"_5":30485,"_20936":121665,"_27421":121666,"_2948":121667},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3464":71913,"_30135":71900,"_5":30485,"_20936":121669,"_27421":121670,"_2948":121671},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3464":71914,"_30135":71900,"_5":30485,"_20936":121673,"_27421":121674,"_2948":121675},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3464":71915,"_30135":71900,"_5":30485,"_20936":121677,"_27421":121678,"_2948":121679},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3464":71916,"_30135":71900,"_5":30485,"_20936":121681,"_27421":121682,"_2948":121683},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3464":71917,"_30135":71900,"_5":30485,"_20936":121685,"_27421":121686,"_2948":121687},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3464":71918,"_30135":71900,"_5":30485,"_20936":121689,"_27421":121690,"_2948":121691},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3464":71919,"_30135":71900,"_5":30485,"_20936":121693,"_27421":121694,"_2948":121695},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3464":71920,"_30135":71900,"_5":30485,"_20936":121697,"_27421":121698,"_2948":121699},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3464":71921,"_30135":71900,"_5":30485,"_20936":121701,"_27421":121702,"_2948":121703},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3464":71922,"_30135":71900,"_5":30485,"_20936":121705,"_27421":121706,"_2948":121707},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3464":71923,"_30135":71900,"_5":30485,"_20936":121709,"_27421":121710,"_2948":121711},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3464":71924,"_30135":71900,"_5":30485,"_20936":121713,"_27421":121714,"_2948":121715},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3464":71925,"_30135":71900,"_20936":121717,"_5":14366,"_27421":71900,"_2948":121718},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3464":71926,"_30135":71900,"_20936":121720,"_5":14366,"_27421":71900,"_2948":121721},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3464":71927,"_30135":71900,"_20936":121723,"_5":14366,"_27421":71900,"_2948":121724},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3464":71928,"_30135":71900,"_20936":121726,"_5":14366,"_27421":121627,"_2948":121727},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3464":71929,"_30135":71900,"_20936":121729,"_5":14366,"_27421":121627,"_2948":121730},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3464":71930,"_30135":71900,"_20936":121732,"_5":14366,"_27421":121627,"_2948":121733},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3464":71931,"_30135":71900,"_20936":121735,"_5":14366,"_27421":121627,"_2948":121736},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3464":71932,"_30135":71900,"_20936":121738,"_5":14366,"_27421":121627,"_2948":121739},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3464":71933,"_30135":71900,"_20936":121741,"_5":14366,"_27421":121635,"_2948":121742},[],"Decide si la CA será raíz o intermedia.",{"_3464":71934,"_30135":71900,"_20936":121744,"_5":14366,"_27421":121635,"_2948":121745},[],"Elige el motor que custodiará la clave.",{"_3464":71935,"_30135":71900,"_20936":121747,"_5":14366,"_27421":121635,"_2948":121748},[],"Define una validez superior a la de los certificados que emitirá.",{"_3464":71936,"_30135":71900,"_20936":121750,"_5":14366,"_27421":121635,"_2948":121751},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3464":71937,"_30135":71900,"_20936":121753,"_5":14366,"_27421":121638,"_2948":121754},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3464":71938,"_30135":71900,"_20936":121756,"_5":14366,"_27421":121642,"_2948":121757},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3464":71939,"_30135":71900,"_20936":121759,"_5":14366,"_27421":121642,"_2948":121760},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3464":71940,"_30135":71900,"_20936":121762,"_5":14366,"_27421":121646,"_2948":121763},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3464":71941,"_30135":71900,"_20936":121765,"_5":14366,"_27421":121650,"_2948":121766},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3464":71942,"_30135":71900,"_20936":121768,"_5":14366,"_27421":121650,"_2948":121769},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3464":71943,"_30135":71900,"_20936":121771,"_5":14366,"_27421":121650,"_2948":121772},[],"`ST`: estado o provincia.",{"_3464":71944,"_30135":71900,"_20936":121774,"_5":14366,"_27421":121650,"_2948":121775},[],"`L`: localidad.",{"_3464":71945,"_30135":71900,"_20936":121777,"_5":14366,"_27421":121650,"_2948":121778},[],"`O`: organización.",{"_3464":71946,"_30135":71900,"_20936":121780,"_5":14366,"_27421":121650,"_2948":121781},[],"`OU`: unidad organizativa.",{"_3464":71947,"_30135":71900,"_20936":121783,"_5":14366,"_27421":121650,"_2948":121784},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3464":71948,"_30135":71900,"_20936":121786,"_5":14366,"_27421":121654,"_2948":121787},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3464":71949,"_30135":71900,"_20936":121789,"_5":14366,"_27421":121654,"_2948":121790},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3464":71950,"_30135":71900,"_20936":121792,"_5":14366,"_27421":121658,"_2948":121793},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3464":71951,"_30135":71900,"_20936":121795,"_5":14366,"_27421":121658,"_2948":121796},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3464":71952,"_30135":71900,"_20936":121798,"_5":14366,"_27421":121662,"_2948":121799},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3464":71953,"_30135":71900,"_20936":121801,"_5":14366,"_27421":121662,"_2948":121802},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3464":71954,"_30135":71900,"_20936":121804,"_5":14366,"_27421":121666,"_2948":121805},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3464":71955,"_30135":71900,"_20936":121807,"_5":14366,"_27421":121666,"_2948":121808},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3464":71956,"_30135":71900,"_20936":121810,"_5":14366,"_27421":121666,"_2948":121811},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3464":71957,"_30135":71900,"_20936":121813,"_5":14366,"_27421":121670,"_2948":121814},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3464":71958,"_30135":71900,"_20936":121816,"_5":14366,"_27421":121674,"_2948":121817},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3464":71959,"_30135":71900,"_20936":121819,"_5":14366,"_27421":121674,"_2948":121820},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3464":71960,"_30135":71900,"_20936":121822,"_5":14366,"_27421":121678,"_2948":121823},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3464":71961,"_30135":71900,"_20936":121825,"_5":14366,"_27421":121682,"_2948":121826},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3464":71962,"_30135":71900,"_20936":121828,"_5":14366,"_27421":121682,"_2948":121829},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3464":71963,"_30135":71900,"_20936":121831,"_5":14366,"_27421":121686,"_2948":121832},[],"Abre una CA desde el inventario para consultar:",{"_3464":71964,"_30135":71900,"_20936":121834,"_5":14366,"_27421":121686,"_2948":121835},[],"Estado y periodo de validez.",{"_3464":71965,"_30135":71900,"_20936":121837,"_5":14366,"_27421":121686,"_2948":121838},[],"Certificado y cadena en formato PEM.",{"_3464":71966,"_30135":71900,"_20936":121840,"_5":14366,"_27421":121686,"_2948":121841},[],"Número de certificados activos, expirados y revocados.",{"_3464":71967,"_30135":71900,"_20936":121843,"_5":14366,"_27421":121686,"_2948":121844},[],"Certificados emitidos en **Issued Certificates**.",{"_3464":71968,"_30135":71900,"_20936":121846,"_5":14366,"_27421":121686,"_2948":121847},[],"CRL vinculada a la autoridad.",{"_3464":71969,"_30135":71900,"_20936":121849,"_5":14366,"_27421":121686,"_2948":121850},[],"Metadatos y motor criptográfico asociado.",{"_3464":71970,"_30135":71900,"_20936":121852,"_5":14366,"_27421":121686,"_2948":121853},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3464":71971,"_30135":71900,"_20936":121855,"_5":14366,"_27421":121690,"_2948":121856},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3464":71972,"_30135":71900,"_20936":121858,"_5":14366,"_27421":121690,"_2948":121859},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3464":71973,"_30135":71900,"_20936":121861,"_5":14366,"_27421":121690,"_2948":121862},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3464":71974,"_30135":71900,"_20936":121864,"_5":14366,"_27421":121690,"_2948":121865},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3464":71975,"_30135":71900,"_20936":121867,"_5":14366,"_27421":121694,"_2948":121868},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3464":71976,"_30135":71900,"_20936":121870,"_5":14366,"_27421":121698,"_2948":121871},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3464":71977,"_30135":71900,"_20936":121873,"_5":14366,"_27421":121702,"_2948":121874},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3464":71978,"_30135":71900,"_20936":121876,"_5":14366,"_27421":121706,"_2948":121877},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3464":71979,"_30135":71900,"_20936":121879,"_5":14366,"_27421":121710,"_2948":121880},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3464":71980,"_30135":71900,"_20936":121882,"_5":14366,"_27421":121714,"_2948":121883},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3464":71981,"_30135":71900,"_20936":121885,"_5":14366,"_27421":121714,"_2948":121886},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3464":71982,"_30135":71900,"_20936":121888,"_5":14366,"_27421":121714,"_2948":121889},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3464":71983,"_30135":71983,"_5":14718,"_2948":121891,"_30488":121892,"_20936":121893,"_27421":71983},"Perfiles de certificado",[49202,117572,54682,121457],[],{"_3464":71984,"_30135":71983,"_20936":121895,"_5":14366,"_27421":71983,"_2948":121896},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3464":71985,"_30135":71983,"_5":30485,"_20936":121898,"_27421":121899,"_2948":121900},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3464":71986,"_30135":71983,"_5":30485,"_20936":121902,"_27421":121903,"_2948":121904},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#validez","Validez",{"_3464":71987,"_30135":71983,"_5":30485,"_20936":121906,"_27421":121907,"_2948":121908},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3464":71988,"_30135":71983,"_5":30485,"_20936":121910,"_27421":121911,"_2948":121912},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3464":71989,"_30135":71983,"_5":30485,"_20936":121914,"_27421":121915,"_2948":121916},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3464":71990,"_30135":71983,"_5":30485,"_20936":121918,"_27421":121919,"_2948":121920},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3464":71991,"_30135":71983,"_5":30485,"_20936":121922,"_27421":121923,"_2948":121924},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3464":71992,"_30135":71983,"_5":30485,"_20936":121926,"_27421":121927,"_2948":121928},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3464":71993,"_30135":71983,"_5":30485,"_20936":121930,"_27421":121931,"_2948":121932},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3464":71994,"_30135":71983,"_5":30485,"_20936":121934,"_27421":121935,"_2948":121936},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3464":71995,"_30135":71983,"_5":30485,"_20936":121938,"_27421":121939,"_2948":121940},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3464":71996,"_30135":71983,"_5":30485,"_20936":121942,"_27421":121943,"_2948":121944},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3464":71997,"_30135":71983,"_5":30485,"_20936":121946,"_27421":121947,"_2948":121948},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3464":71998,"_30135":71983,"_5":30485,"_20936":121950,"_27421":121951,"_2948":121952},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3464":71999,"_30135":71983,"_5":30485,"_20936":121954,"_27421":121955,"_2948":121956},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3464":72000,"_30135":71983,"_5":30485,"_20936":121958,"_27421":121959,"_2948":121960},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3464":72001,"_30135":71983,"_20936":121962,"_5":14366,"_27421":71983,"_2948":121963},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3464":72002,"_30135":71983,"_20936":121965,"_5":14366,"_27421":71983,"_2948":121966},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3464":72003,"_30135":71983,"_20936":121968,"_5":14366,"_27421":121903,"_2948":121969},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3464":72004,"_30135":71983,"_20936":121971,"_5":14366,"_27421":121903,"_2948":121972},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3464":72005,"_30135":71983,"_20936":121974,"_5":14366,"_27421":121907,"_2948":121975},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3464":72006,"_30135":71983,"_20936":121977,"_5":14366,"_27421":121911,"_2948":121978},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3464":72007,"_30135":71983,"_20936":121980,"_5":14366,"_27421":121911,"_2948":121981},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3464":72008,"_30135":71983,"_20936":121983,"_5":14366,"_27421":121911,"_2948":121984},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3464":72009,"_30135":71983,"_20936":121986,"_5":14366,"_27421":121915,"_2948":121987},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3464":72010,"_30135":71983,"_20936":121989,"_5":14366,"_27421":121919,"_2948":121990},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3464":72011,"_30135":71983,"_20936":121992,"_5":14366,"_27421":121919,"_2948":121993},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3464":72012,"_30135":71983,"_20936":121995,"_5":14366,"_27421":121923,"_2948":121996},[],"La aplicación criptográfica puede:",{"_3464":72013,"_30135":71983,"_20936":121998,"_5":14366,"_27421":121923,"_2948":121999},[],"permitir o bloquear claves RSA;",{"_3464":72014,"_30135":71983,"_20936":122001,"_5":14366,"_27421":121923,"_2948":122002},[],"limitar los tamaños RSA admitidos;",{"_3464":72015,"_30135":71983,"_20936":122004,"_5":14366,"_27421":121923,"_2948":122005},[],"permitir o bloquear claves ECDSA;",{"_3464":72016,"_30135":71983,"_20936":122007,"_5":14366,"_27421":121923,"_2948":122008},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3464":72017,"_30135":71983,"_20936":122010,"_5":14366,"_27421":121923,"_2948":122011},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3464":72018,"_30135":71983,"_20936":122013,"_5":14366,"_27421":121927,"_2948":122014},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3464":72019,"_30135":71983,"_20936":122016,"_5":14366,"_27421":121927,"_2948":117332},[],{"_3464":72020,"_30135":71983,"_20936":122018,"_5":14366,"_27421":121927,"_2948":122019},[],"Primera opción",{"_3464":72021,"_30135":71983,"_20936":122021,"_5":14366,"_27421":121927,"_2948":122022},[],"Segunda opción",{"_3464":72022,"_30135":71983,"_20936":122024,"_5":14366,"_27421":121927,"_2948":122025},[],"Si no hay ninguna",{"_3464":72023,"_30135":71983,"_20936":122027,"_5":14366,"_27421":121927,"_2948":122028},[],"Firma directa con una CA",{"_3464":72024,"_30135":71983,"_20936":122030,"_5":14366,"_27421":121927,"_2948":122031},[],"`issuance_profile` incluido en la solicitud",{"_3464":72025,"_30135":71983,"_20936":122033,"_5":14366,"_27421":121927,"_2948":122034},[],"`issuance_profile_id` de la solicitud",{"_3464":72026,"_30135":71983,"_20936":122036,"_5":14366,"_27421":121927,"_2948":122037},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3464":72027,"_30135":71983,"_20936":122039,"_5":14366,"_27421":121927,"_2948":122040},[],"Emisión mediante DMS",{"_3464":72028,"_30135":71983,"_20936":122042,"_5":14366,"_27421":121927,"_2948":55269},[],{"_3464":72029,"_30135":71983,"_20936":122044,"_5":14366,"_27421":121927,"_2948":122045},[],"`settings.issuance_profile` incluido en el DMS",{"_3464":72030,"_30135":71983,"_20936":122047,"_5":14366,"_27421":121927,"_2948":122048},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3464":72031,"_30135":71983,"_20936":122050,"_5":14366,"_27421":121927,"_2948":122051},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3464":72032,"_30135":71983,"_20936":122053,"_5":14366,"_27421":121927,"_2948":122054},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3464":72033,"_30135":71983,"_20936":122056,"_5":14366,"_27421":121935,"_2948":122057},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3464":72034,"_30135":71983,"_20936":122059,"_5":14366,"_27421":121939,"_2948":122060},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3464":72035,"_30135":71983,"_20936":122062,"_5":14366,"_27421":121943,"_2948":122063},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3464":72036,"_30135":71983,"_20936":122065,"_5":14366,"_27421":121947,"_2948":122066},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3464":72037,"_30135":71983,"_20936":122068,"_5":14366,"_27421":121951,"_2948":122069},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3464":72038,"_30135":71983,"_20936":122071,"_5":14366,"_27421":121951,"_2948":122072},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3464":72039,"_30135":71983,"_20936":122074,"_5":14366,"_27421":121955,"_2948":122075},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3464":72040,"_30135":71983,"_20936":122077,"_5":14366,"_27421":121955,"_2948":122078},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3464":72041,"_30135":71983,"_20936":122080,"_5":14366,"_27421":121955,"_2948":122081},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3464":72042,"_30135":71983,"_20936":122083,"_5":14366,"_27421":121955,"_2948":122084},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3464":72043,"_30135":71983,"_20936":122086,"_5":14366,"_27421":121959,"_2948":122087},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3464":72044,"_30135":71983,"_20936":122089,"_5":14366,"_27421":121959,"_2948":122090},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3464":72045,"_30135":72045,"_5":14718,"_2948":122092,"_30488":122093,"_20936":122095,"_27421":72045},"Validación de certificados",[49202,117572,54682,122094],"Validación",[],{"_3464":72046,"_30135":72045,"_20936":122097,"_5":14366,"_27421":72045,"_2948":122098},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3464":72047,"_30135":72045,"_5":30485,"_20936":122100,"_27421":122101,"_2948":122102},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3464":72048,"_30135":72045,"_5":30485,"_20936":122104,"_27421":122105,"_2948":122106},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3464":72049,"_30135":72045,"_5":30485,"_20936":122108,"_27421":122109,"_2948":122110},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3464":72050,"_30135":72045,"_20936":122112,"_5":14366,"_27421":72045,"_2948":122113},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3464":72051,"_30135":72045,"_20936":122115,"_5":14366,"_27421":122101,"_2948":122116},[],"Verifica estos criterios juntos:",{"_3464":72052,"_30135":72045,"_20936":122118,"_5":14366,"_27421":122101,"_2948":121079},[],{"_3464":72053,"_30135":72045,"_20936":122120,"_5":14366,"_27421":122101,"_2948":122121},[],"Resultado necesario",{"_3464":72054,"_30135":72045,"_20936":122123,"_5":14366,"_27421":122101,"_2948":122124},[],"Cadena y firma",{"_3464":72055,"_30135":72045,"_20936":122126,"_5":14366,"_27421":122101,"_2948":122127},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3464":72056,"_30135":72045,"_20936":122129,"_5":14366,"_27421":122101,"_2948":122130},[],"Fechas",{"_3464":72057,"_30135":72045,"_20936":122132,"_5":14366,"_27421":122101,"_2948":122133},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3464":72058,"_30135":72045,"_20936":122135,"_5":14366,"_27421":122101,"_2948":117242},[],{"_3464":72059,"_30135":72045,"_20936":122137,"_5":14366,"_27421":122101,"_2948":122138},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3464":72060,"_30135":72045,"_20936":122140,"_5":14366,"_27421":122101,"_2948":122141},[],"Uso",{"_3464":72061,"_30135":72045,"_20936":122143,"_5":14366,"_27421":122101,"_2948":122144},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3464":72062,"_30135":72045,"_20936":122146,"_5":14366,"_27421":122101,"_2948":122147},[],"Revocación",{"_3464":72063,"_30135":72045,"_20936":122149,"_5":14366,"_27421":122101,"_2948":122150},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3464":72064,"_30135":72045,"_20936":122152,"_5":14366,"_27421":122101,"_2948":122153},[],"Autorización",{"_3464":72065,"_30135":72045,"_20936":122155,"_5":14366,"_27421":122101,"_2948":122156},[],"La aplicación permite la acción a esa identidad.",{"_3464":72066,"_30135":72045,"_20936":122158,"_5":14366,"_27421":122101,"_2948":122159},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3464":72067,"_30135":72045,"_20936":122161,"_5":14366,"_27421":122105,"_2948":122162},[],"Mecanismo",{"_3464":72068,"_30135":72045,"_20936":122164,"_5":14366,"_27421":122105,"_2948":122165},[],"Cuándo utilizarlo",{"_3464":72069,"_30135":72045,"_20936":122167,"_5":14366,"_27421":122105,"_2948":122168},[],"Qué debes mantener",{"_3464":72070,"_30135":72045,"_20936":122170,"_5":14366,"_27421":122105,"_2948":55397},[],{"_3464":72071,"_30135":72045,"_20936":122172,"_5":14366,"_27421":122105,"_2948":122173},[],"Consulta del estado de un certificado concreto.",{"_3464":72072,"_30135":72045,"_20936":122175,"_5":14366,"_27421":122105,"_2948":122176},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3464":72073,"_30135":72045,"_20936":122178,"_5":14366,"_27421":122105,"_2948":55406},[],{"_3464":72074,"_30135":72045,"_20936":122180,"_5":14366,"_27421":122105,"_2948":122181},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3464":72075,"_30135":72045,"_20936":122183,"_5":14366,"_27421":122105,"_2948":122184},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3464":72076,"_30135":72045,"_20936":122186,"_5":14366,"_27421":122105,"_2948":122187},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3464":72077,"_30135":72045,"_20936":122189,"_5":14366,"_27421":122105,"_2948":122190},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3464":72078,"_30135":72045,"_20936":122192,"_5":14366,"_27421":122109,"_2948":122193},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3464":72079,"_30135":72045,"_20936":122195,"_5":14366,"_27421":122109,"_2948":122196},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3464":72080,"_30135":72045,"_20936":122198,"_5":14366,"_27421":122109,"_2948":122199},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3464":72081,"_30135":72045,"_20936":122201,"_5":14366,"_27421":122109,"_2948":122202},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3464":72082,"_30135":72045,"_20936":122204,"_5":14366,"_27421":122109,"_2948":122205},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3464":72083,"_30135":72045,"_20936":122207,"_5":14366,"_27421":122109,"_2948":122208},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3464":72084,"_30135":72045,"_20936":122210,"_5":14366,"_27421":122109,"_2948":122211},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3464":72085,"_30135":72045,"_20936":122213,"_5":14366,"_27421":122109,"_2948":122214},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":72086,"_30135":72045,"_20936":122216,"_5":14366,"_27421":122109,"_2948":122217},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3464":72087,"_30135":72087,"_5":14718,"_2948":122219,"_30488":122220,"_20936":122221,"_27421":72087},"Certificados",[49202,117572,54682,121457],[],{"_3464":72088,"_30135":72087,"_20936":122223,"_5":14366,"_27421":72087,"_2948":122224},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3464":72089,"_30135":72087,"_5":30485,"_20936":122226,"_27421":122227,"_2948":122228},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3464":72090,"_30135":72087,"_5":30485,"_20936":122230,"_27421":122231,"_2948":122232},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3464":72091,"_30135":72087,"_5":30485,"_20936":122234,"_27421":122235,"_2948":122236},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3464":72092,"_30135":72087,"_5":30485,"_20936":122238,"_27421":122239,"_2948":122240},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3464":72093,"_30135":72087,"_5":30485,"_20936":122242,"_27421":122243,"_2948":122244},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3464":72094,"_30135":72087,"_5":30485,"_20936":122246,"_27421":122247,"_2948":122248},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3464":72095,"_30135":72087,"_5":30485,"_20936":122250,"_27421":122251,"_2948":122252},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3464":72096,"_30135":72087,"_5":30485,"_20936":122254,"_27421":122255,"_2948":122256},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3464":72097,"_30135":72087,"_5":30485,"_20936":122258,"_27421":122259,"_2948":122260},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#continúa","Continúa",{"_3464":72098,"_30135":72087,"_20936":122262,"_5":14366,"_27421":72087,"_2948":122263},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3464":72099,"_30135":72087,"_20936":122265,"_5":14366,"_27421":122227,"_2948":122266},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3464":72100,"_30135":72087,"_20936":122268,"_5":14366,"_27421":122227,"_2948":122269},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3464":72101,"_30135":72087,"_20936":122271,"_5":14366,"_27421":122227,"_2948":122272},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3464":72102,"_30135":72087,"_20936":122274,"_5":14366,"_27421":122227,"_2948":122275},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3464":72103,"_30135":72087,"_20936":122277,"_5":14366,"_27421":122227,"_2948":122278},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3464":72104,"_30135":72087,"_20936":122280,"_5":14366,"_27421":122227,"_2948":122281},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3464":72105,"_30135":72087,"_20936":122283,"_5":14366,"_27421":122227,"_2948":122284},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3464":72106,"_30135":72087,"_20936":122286,"_5":14366,"_27421":122231,"_2948":122287},[],"Descarga el PEM e inspecciónalo:",{"_3464":72107,"_30135":72087,"_20936":122289,"_5":14366,"_27421":122231,"_2948":122290},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3464":72108,"_30135":72087,"_20936":122292,"_5":14366,"_27421":122235,"_2948":122293},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3464":72109,"_30135":72087,"_20936":122295,"_5":14366,"_27421":122235,"_2948":122296},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3464":72110,"_30135":72087,"_20936":122298,"_5":14366,"_27421":122235,"_2948":122299},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3464":72111,"_30135":72087,"_20936":122301,"_5":14366,"_27421":122235,"_2948":122302},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3464":72112,"_30135":72087,"_20936":122304,"_5":14366,"_27421":122235,"_2948":122305},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3464":72113,"_30135":72087,"_20936":122307,"_5":14366,"_27421":122235,"_2948":122308},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3464":72114,"_30135":72087,"_20936":122310,"_5":14366,"_27421":122235,"_2948":122311},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3464":72115,"_30135":72087,"_20936":122313,"_5":14366,"_27421":122239,"_2948":122314},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3464":72116,"_30135":72087,"_20936":122316,"_5":14366,"_27421":122243,"_2948":122317},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3464":72117,"_30135":72087,"_20936":122319,"_5":14366,"_27421":122247,"_2948":122320},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3464":72118,"_30135":72087,"_20936":122322,"_5":14366,"_27421":122251,"_2948":122323},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3464":72119,"_30135":72087,"_20936":122325,"_5":14366,"_27421":122251,"_2948":122326},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3464":72120,"_30135":72087,"_20936":122328,"_5":14366,"_27421":122251,"_2948":122329},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3464":72121,"_30135":72087,"_20936":122331,"_5":14366,"_27421":122255,"_2948":122332},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3464":72122,"_30135":72087,"_20936":122334,"_5":14366,"_27421":122255,"_2948":122335},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3464":72123,"_30135":72087,"_20936":122337,"_5":14366,"_27421":122255,"_2948":122338},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3464":72124,"_30135":72087,"_20936":122340,"_5":14366,"_27421":122259,"_2948":122341},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":72125,"_30135":72087,"_20936":122343,"_5":14366,"_27421":122259,"_2948":122344},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3464":72126,"_30135":72126,"_5":14718,"_2948":122346,"_30488":122347,"_20936":122349,"_27421":72126},"Ciclo de vida de un certificado",[49202,117572,54682,122348],"Conceptos",[],{"_3464":72127,"_30135":72126,"_20936":122351,"_5":14366,"_27421":72126,"_2948":122352},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3464":72128,"_30135":72126,"_5":30485,"_20936":122354,"_27421":122355,"_2948":122356},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3464":72129,"_30135":72126,"_5":30485,"_20936":122358,"_27421":122359,"_2948":122360},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3464":72130,"_30135":72126,"_5":30485,"_20936":122362,"_27421":122363,"_2948":122364},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3464":72131,"_30135":72126,"_5":30485,"_20936":122366,"_27421":122367,"_2948":122368},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3464":72132,"_30135":72126,"_5":30485,"_20936":122370,"_27421":122371,"_2948":122372},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3464":72133,"_30135":72126,"_5":30485,"_20936":122374,"_27421":122375,"_2948":122376},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3464":72134,"_30135":72126,"_5":30485,"_20936":122378,"_27421":122379,"_2948":120073},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3464":72135,"_30135":72126,"_5":30485,"_20936":122381,"_27421":122382,"_2948":122383},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3464":72136,"_30135":72126,"_5":30485,"_20936":122385,"_27421":122386,"_2948":122387},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3464":72137,"_30135":72126,"_5":30485,"_20936":122389,"_27421":122390,"_2948":122391},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3464":72138,"_30135":72126,"_20936":122393,"_5":14366,"_27421":72126,"_2948":122394},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3464":72139,"_30135":72126,"_20936":122396,"_5":14366,"_27421":122359,"_2948":122397},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3464":72140,"_30135":72126,"_20936":122399,"_5":14366,"_27421":122363,"_2948":122400},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3464":72141,"_30135":72126,"_20936":122402,"_5":14366,"_27421":122367,"_2948":122403},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3464":72142,"_30135":72126,"_20936":122405,"_5":14366,"_27421":122371,"_2948":122406},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3464":72143,"_30135":72126,"_20936":122408,"_5":14366,"_27421":122375,"_2948":122409},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3464":72144,"_30135":72126,"_20936":122411,"_5":14366,"_27421":122379,"_2948":122412},[],"Lamassu persiste cuatro estados X.509:",{"_3464":72145,"_30135":72126,"_20936":122414,"_5":14366,"_27421":122379,"_2948":122415},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3464":72146,"_30135":72126,"_20936":122417,"_5":14366,"_27421":122379,"_2948":122418},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3464":72147,"_30135":72126,"_20936":122420,"_5":14366,"_27421":122379,"_2948":122421},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3464":72148,"_30135":72126,"_20936":122423,"_5":14366,"_27421":122379,"_2948":122424},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3464":72149,"_30135":72126,"_20936":122426,"_5":14366,"_27421":122379,"_2948":122427},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3464":72150,"_30135":72126,"_20936":122429,"_5":14366,"_27421":122382,"_2948":122430},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3464":72151,"_30135":72126,"_20936":122432,"_5":14366,"_27421":122382,"_2948":122433},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3464":72152,"_30135":72126,"_20936":122435,"_5":14366,"_27421":122382,"_2948":122436},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3464":72153,"_30135":72126,"_20936":122438,"_5":14366,"_27421":122386,"_2948":122439},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3464":72154,"_30135":72126,"_20936":122441,"_5":14366,"_27421":122386,"_2948":122442},[],"Antes de confirmar:",{"_3464":72155,"_30135":72126,"_20936":122444,"_5":14366,"_27421":122386,"_2948":122445},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3464":72156,"_30135":72126,"_20936":122447,"_5":14366,"_27421":122386,"_2948":122448},[],"Distribuye la nueva cadena de confianza.",{"_3464":72157,"_30135":72126,"_20936":122450,"_5":14366,"_27421":122386,"_2948":122451},[],"Reemite las identidades necesarias.",{"_3464":72158,"_30135":72126,"_20936":122453,"_5":14366,"_27421":122386,"_2948":122454},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3464":72159,"_30135":72126,"_20936":122456,"_5":14366,"_27421":122386,"_2948":122457},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3464":72160,"_30135":72126,"_20936":122459,"_5":14366,"_27421":122386,"_2948":122460},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3464":72161,"_30135":72126,"_20936":122462,"_5":14366,"_27421":122390,"_2948":122463},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3464":72162,"_30135":72126,"_20936":122465,"_5":14366,"_27421":122390,"_2948":122466},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3464":72163,"_30135":72126,"_20936":122468,"_5":14366,"_27421":122390,"_2948":122469},[],"Cambios de estado y razones de revocación.",{"_3464":72164,"_30135":72126,"_20936":122471,"_5":14366,"_27421":122390,"_2948":122472},[],"Publicación y vigencia de OCSP y CRLs.",{"_3464":72165,"_30135":72126,"_20936":122474,"_5":14366,"_27421":122390,"_2948":122475},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3464":72166,"_30135":72126,"_20936":122477,"_5":14366,"_27421":122390,"_2948":122478},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3464":72167,"_30135":72167,"_5":14718,"_2948":122480,"_30488":122481,"_20936":122482,"_27421":72167},"Modelo de confianza",[49202,117572,54682,122348],[],{"_3464":72168,"_30135":72167,"_20936":122484,"_5":14366,"_27421":72167,"_2948":122485},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3464":72169,"_30135":72167,"_5":30485,"_20936":122487,"_27421":122488,"_2948":122489},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3464":72170,"_30135":72167,"_5":30485,"_20936":122491,"_27421":122492,"_2948":122493},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3464":72171,"_30135":72167,"_5":30485,"_20936":122495,"_27421":122496,"_2948":122497},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3464":72172,"_30135":72167,"_5":30485,"_20936":122499,"_27421":122500,"_2948":122501},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3464":72173,"_30135":72167,"_5":30485,"_20936":122503,"_27421":122504,"_2948":122505},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3464":72174,"_30135":72167,"_5":30485,"_20936":122507,"_27421":122508,"_2948":122509},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3464":72175,"_30135":72167,"_5":30485,"_20936":122511,"_27421":122512,"_2948":122513},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3464":72176,"_30135":72167,"_5":30485,"_20936":122515,"_27421":122516,"_2948":122517},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3464":72177,"_30135":72167,"_5":30485,"_20936":122519,"_27421":122520,"_2948":122521},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3464":72178,"_30135":72167,"_5":30485,"_20936":122523,"_27421":122524,"_2948":122525},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3464":72179,"_30135":72167,"_20936":122527,"_5":14366,"_27421":72167,"_2948":122528},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3464":72180,"_30135":72167,"_20936":122530,"_5":14366,"_27421":122492,"_2948":122531},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3464":72181,"_30135":72167,"_20936":122533,"_5":14366,"_27421":122496,"_2948":122534},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3464":72182,"_30135":72167,"_20936":122536,"_5":14366,"_27421":122500,"_2948":122537},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3464":72183,"_30135":72167,"_20936":122539,"_5":14366,"_27421":122504,"_2948":122540},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3464":72184,"_30135":72167,"_20936":122542,"_5":14366,"_27421":122508,"_2948":122543},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3464":72185,"_30135":72167,"_20936":122545,"_5":14366,"_27421":122508,"_2948":122546},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3464":72186,"_30135":72167,"_20936":122548,"_5":14366,"_27421":122508,"_2948":122549},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3464":72187,"_30135":72167,"_20936":122551,"_5":14366,"_27421":122508,"_2948":122552},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3464":72188,"_30135":72167,"_20936":122554,"_5":14366,"_27421":122508,"_2948":122555},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3464":72189,"_30135":72167,"_20936":122557,"_5":14366,"_27421":122508,"_2948":122558},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3464":72190,"_30135":72167,"_20936":122560,"_5":14366,"_27421":122512,"_2948":122561},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3464":72191,"_30135":72167,"_20936":122563,"_5":14366,"_27421":122512,"_2948":122564},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3464":72192,"_30135":72167,"_20936":122566,"_5":14366,"_27421":122512,"_2948":122567},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3464":72193,"_30135":72167,"_20936":122569,"_5":14366,"_27421":122512,"_2948":122570},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3464":72194,"_30135":72167,"_20936":122572,"_5":14366,"_27421":122512,"_2948":122573},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3464":72195,"_30135":72167,"_20936":122575,"_5":14366,"_27421":122516,"_2948":122576},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3464":72196,"_30135":72167,"_20936":122578,"_5":14366,"_27421":122516,"_2948":122579},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3464":72197,"_30135":72167,"_20936":122581,"_5":14366,"_27421":122516,"_2948":122582},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3464":72198,"_30135":72167,"_20936":122584,"_5":14366,"_27421":122516,"_2948":122585},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3464":72199,"_30135":72167,"_20936":122587,"_5":14366,"_27421":122516,"_2948":122588},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3464":72200,"_30135":72167,"_20936":122590,"_5":14366,"_27421":122516,"_2948":122591},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3464":72201,"_30135":72167,"_20936":122593,"_5":14366,"_27421":122516,"_2948":122594},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3464":72202,"_30135":72167,"_20936":122596,"_5":14366,"_27421":122520,"_2948":122597},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3464":72203,"_30135":72167,"_20936":122599,"_5":14366,"_27421":122524,"_2948":122600},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3464":72204,"_30135":72167,"_20936":122602,"_5":14366,"_27421":122524,"_2948":122603},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3464":72205,"_30135":72167,"_20936":122605,"_5":14366,"_27421":122524,"_2948":122606},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3464":72206,"_30135":72167,"_20936":122608,"_5":14366,"_27421":122524,"_2948":122609},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3464":72207,"_30135":72167,"_20936":122611,"_5":14366,"_27421":122524,"_2948":122612},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3464":72208,"_30135":72167,"_20936":122614,"_5":14366,"_27421":122524,"_2948":122615},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3464":72209,"_30135":72167,"_20936":122617,"_5":14366,"_27421":122524,"_2948":122618},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3464":72210,"_30135":72210,"_5":14718,"_2948":122620,"_30488":122621,"_20936":122622,"_27421":72210},"Listas de revocación (CRL)",[49202,117572,54682,122094],[],{"_3464":72211,"_30135":72210,"_20936":122624,"_5":14366,"_27421":72210,"_2948":122625},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3464":72212,"_30135":72210,"_5":30485,"_20936":122627,"_27421":122628,"_2948":122629},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3464":72213,"_30135":72210,"_5":30485,"_20936":122631,"_27421":122632,"_2948":122633},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3464":72214,"_30135":72210,"_5":30485,"_20936":122635,"_27421":122636,"_2948":122637},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3464":72215,"_30135":72210,"_5":30485,"_20936":122639,"_27421":122640,"_2948":122641},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3464":72216,"_30135":72210,"_5":30485,"_20936":122643,"_27421":122644,"_2948":122645},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3464":72217,"_30135":72210,"_5":30485,"_20936":122647,"_27421":122648,"_2948":122649},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3464":72218,"_30135":72210,"_5":30485,"_20936":122651,"_27421":122652,"_2948":122653},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3464":72219,"_30135":72210,"_5":30485,"_20936":122655,"_27421":122656,"_2948":122657},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3464":72220,"_30135":72210,"_5":30485,"_20936":122659,"_27421":122660,"_2948":122661},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#referencias","Referencias",{"_3464":72221,"_30135":72210,"_20936":122663,"_5":14366,"_27421":72210,"_2948":122664},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3464":72222,"_30135":72210,"_20936":122666,"_5":14366,"_27421":122628,"_2948":122667},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3464":72223,"_30135":72210,"_20936":122669,"_5":14366,"_27421":122628,"_2948":122670},[],"Campo",{"_3464":72224,"_30135":72210,"_20936":122672,"_5":14366,"_27421":122628,"_2948":119113},[],{"_3464":72225,"_30135":72210,"_20936":122674,"_5":14366,"_27421":122628,"_2948":55904},[],{"_3464":72226,"_30135":72210,"_20936":122676,"_5":14366,"_27421":122628,"_2948":122677},[],"ID de la CA a la que pertenecen los ajustes.",{"_3464":72227,"_30135":72210,"_20936":122679,"_5":14366,"_27421":122628,"_2948":55910},[],{"_3464":72228,"_30135":72210,"_20936":122681,"_5":14366,"_27421":122628,"_2948":122682},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3464":72229,"_30135":72210,"_20936":122684,"_5":14366,"_27421":122628,"_2948":55916},[],{"_3464":72230,"_30135":72210,"_20936":122686,"_5":14366,"_27421":122628,"_2948":122687},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3464":72231,"_30135":72210,"_20936":122689,"_5":14366,"_27421":122628,"_2948":55922},[],{"_3464":72232,"_30135":72210,"_20936":122691,"_5":14366,"_27421":122628,"_2948":122692},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3464":72233,"_30135":72210,"_20936":122694,"_5":14366,"_27421":122628,"_2948":122695},[],"Campo de `crl_options`",{"_3464":72234,"_30135":72210,"_20936":122697,"_5":14366,"_27421":122628,"_2948":119113},[],{"_3464":72235,"_30135":72210,"_20936":122699,"_5":14366,"_27421":122628,"_2948":122700},[],"Valor inicial",{"_3464":72236,"_30135":72210,"_20936":122702,"_5":14366,"_27421":122628,"_2948":55936},[],{"_3464":72237,"_30135":72210,"_20936":122704,"_5":14366,"_27421":122628,"_2948":122705},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3464":72238,"_30135":72210,"_20936":122707,"_5":14366,"_27421":122628,"_2948":122708},[],"7 días.",{"_3464":72239,"_30135":72210,"_20936":122710,"_5":14366,"_27421":122628,"_2948":55945},[],{"_3464":72240,"_30135":72210,"_20936":122712,"_5":14366,"_27421":122628,"_2948":122713},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3464":72241,"_30135":72210,"_20936":122715,"_5":14366,"_27421":122628,"_2948":122716},[],"6 días y 23 horas.",{"_3464":72242,"_30135":72210,"_20936":122718,"_5":14366,"_27421":122628,"_2948":55954},[],{"_3464":72243,"_30135":72210,"_20936":122720,"_5":14366,"_27421":122628,"_2948":122721},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3464":72244,"_30135":72210,"_20936":122723,"_5":14366,"_27421":122628,"_2948":55960},[],{"_3464":72245,"_30135":72210,"_20936":122725,"_5":14366,"_27421":122628,"_2948":55963},[],{"_3464":72246,"_30135":72210,"_20936":122727,"_5":14366,"_27421":122628,"_2948":122728},[],"Número de serie del certificado existente que firma la CRL.",{"_3464":72247,"_30135":72210,"_20936":122730,"_5":14366,"_27421":122628,"_2948":122731},[],"Número de serie del certificado actual de la CA.",{"_3464":72248,"_30135":72210,"_20936":122733,"_5":14366,"_27421":122628,"_2948":122734},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3464":72249,"_30135":72210,"_20936":122736,"_5":14366,"_27421":122628,"_2948":122737},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3464":72250,"_30135":72210,"_20936":122739,"_5":14366,"_27421":122628,"_2948":122740},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3464":72251,"_30135":72210,"_20936":122742,"_5":14366,"_27421":122628,"_2948":122743},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3464":72252,"_30135":72210,"_20936":122745,"_5":14366,"_27421":122628,"_2948":122746},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3464":72253,"_30135":72210,"_20936":122748,"_5":14366,"_27421":122628,"_2948":122749},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3464":72254,"_30135":72210,"_20936":122751,"_5":14366,"_27421":122628,"_2948":122752},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3464":72255,"_30135":72210,"_20936":122754,"_5":14366,"_27421":122628,"_2948":122755},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3464":72256,"_30135":72210,"_20936":122757,"_5":14366,"_27421":122628,"_2948":122758},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3464":72257,"_30135":72210,"_20936":122760,"_5":14366,"_27421":122628,"_2948":122761},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3464":72258,"_30135":72210,"_20936":122763,"_5":14366,"_27421":122632,"_2948":122764},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3464":72259,"_30135":72210,"_20936":122766,"_5":14366,"_27421":122632,"_2948":122767},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3464":72260,"_30135":72210,"_20936":122769,"_5":14366,"_27421":122632,"_2948":122770},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3464":72261,"_30135":72210,"_20936":122772,"_5":14366,"_27421":122632,"_2948":122773},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3464":72262,"_30135":72210,"_20936":122775,"_5":14366,"_27421":122636,"_2948":122776},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3464":72263,"_30135":72210,"_20936":122778,"_5":14366,"_27421":122636,"_2948":122779},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3464":72264,"_30135":72210,"_20936":122781,"_5":14366,"_27421":122636,"_2948":122782},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3464":72265,"_30135":72210,"_20936":122784,"_5":14366,"_27421":122636,"_2948":122785},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3464":72266,"_30135":72210,"_20936":122787,"_5":14366,"_27421":122636,"_2948":122788},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3464":72267,"_30135":72210,"_20936":122790,"_5":14366,"_27421":122636,"_2948":122791},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3464":72268,"_30135":72210,"_20936":122793,"_5":14366,"_27421":122636,"_2948":122794},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3464":72269,"_30135":72210,"_20936":122796,"_5":14366,"_27421":122636,"_2948":122797},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3464":72270,"_30135":72210,"_20936":122799,"_5":14366,"_27421":122636,"_2948":122800},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3464":72271,"_30135":72210,"_20936":122802,"_5":14366,"_27421":122640,"_2948":122803},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3464":72272,"_30135":72210,"_20936":122805,"_5":14366,"_27421":122640,"_2948":122806},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3464":72273,"_30135":72210,"_20936":122808,"_5":14366,"_27421":122644,"_2948":122809},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3464":72274,"_30135":72210,"_20936":122811,"_5":14366,"_27421":122644,"_2948":122812},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3464":72275,"_30135":72210,"_20936":122814,"_5":14366,"_27421":122644,"_2948":122815},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3464":72276,"_30135":72210,"_20936":122817,"_5":14366,"_27421":122644,"_2948":122818},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3464":72277,"_30135":72210,"_20936":122820,"_5":14366,"_27421":122644,"_2948":122821},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3464":72278,"_30135":72210,"_20936":122823,"_5":14366,"_27421":122648,"_2948":122824},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3464":72279,"_30135":72210,"_20936":122826,"_5":14366,"_27421":122648,"_2948":119302},[],{"_3464":72280,"_30135":72210,"_20936":122828,"_5":14366,"_27421":122648,"_2948":122829},[],"Path relativo",{"_3464":72281,"_30135":72210,"_20936":122831,"_5":14366,"_27421":122648,"_2948":117332},[],{"_3464":72282,"_30135":72210,"_20936":122833,"_5":14366,"_27421":122648,"_2948":56072},[],{"_3464":72283,"_30135":72210,"_20936":122835,"_5":14366,"_27421":122648,"_2948":56075},[],{"_3464":72284,"_30135":72210,"_20936":122837,"_5":14366,"_27421":122648,"_2948":122838},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3464":72285,"_30135":72210,"_20936":122840,"_5":14366,"_27421":122648,"_2948":56072},[],{"_3464":72286,"_30135":72210,"_20936":122842,"_5":14366,"_27421":122648,"_2948":56083},[],{"_3464":72287,"_30135":72210,"_20936":122844,"_5":14366,"_27421":122648,"_2948":122845},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3464":72288,"_30135":72210,"_20936":122847,"_5":14366,"_27421":122648,"_2948":56089},[],{"_3464":72289,"_30135":72210,"_20936":122849,"_5":14366,"_27421":122648,"_2948":56083},[],{"_3464":72290,"_30135":72210,"_20936":122851,"_5":14366,"_27421":122648,"_2948":122852},[],"Sustituir la configuración de CRL de una CA.",{"_3464":72291,"_30135":72210,"_20936":122854,"_5":14366,"_27421":122648,"_2948":122855},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3464":72292,"_30135":72210,"_20936":122857,"_5":14366,"_27421":122648,"_2948":122858},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3464":72293,"_30135":72210,"_20936":122860,"_5":14366,"_27421":122652,"_2948":122861},[],"Síntoma",{"_3464":72294,"_30135":72210,"_20936":122863,"_5":14366,"_27421":122652,"_2948":122864},[],"Causa",{"_3464":72295,"_30135":72210,"_20936":122866,"_5":14366,"_27421":122652,"_2948":122867},[],"Acción",{"_3464":72296,"_30135":72210,"_20936":122869,"_5":14366,"_27421":122652,"_2948":122870},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3464":72297,"_30135":72210,"_20936":122872,"_5":14366,"_27421":122652,"_2948":122873},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3464":72298,"_30135":72210,"_20936":122875,"_5":14366,"_27421":122652,"_2948":122876},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3464":72299,"_30135":72210,"_20936":122878,"_5":14366,"_27421":122652,"_2948":122879},[],"`PUT` devuelve 400.",{"_3464":72300,"_30135":72210,"_20936":122881,"_5":14366,"_27421":122652,"_2948":122882},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3464":72301,"_30135":72210,"_20936":122884,"_5":14366,"_27421":122652,"_2948":122885},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3464":72302,"_30135":72210,"_20936":122887,"_5":14366,"_27421":122652,"_2948":122888},[],"`PUT` devuelve 404.",{"_3464":72303,"_30135":72210,"_20936":122890,"_5":14366,"_27421":122652,"_2948":122891},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3464":72304,"_30135":72210,"_20936":122893,"_5":14366,"_27421":122652,"_2948":122894},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3464":72305,"_30135":72210,"_20936":122896,"_5":14366,"_27421":122652,"_2948":122897},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3464":72306,"_30135":72210,"_20936":122899,"_5":14366,"_27421":122652,"_2948":122900},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3464":72307,"_30135":72210,"_20936":122902,"_5":14366,"_27421":122652,"_2948":122903},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3464":72308,"_30135":72210,"_20936":122905,"_5":14366,"_27421":122652,"_2948":122906},[],"La CRL no cambia tras revocar un certificado.",{"_3464":72309,"_30135":72210,"_20936":122908,"_5":14366,"_27421":122652,"_2948":122909},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3464":72310,"_30135":72210,"_20936":122911,"_5":14366,"_27421":122652,"_2948":122912},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3464":72311,"_30135":72210,"_20936":122914,"_5":14366,"_27421":122652,"_2948":122915},[],"Un verificador rechaza la CRL por el emisor.",{"_3464":72312,"_30135":72210,"_20936":122917,"_5":14366,"_27421":122652,"_2948":122918},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3464":72313,"_30135":72210,"_20936":122920,"_5":14366,"_27421":122652,"_2948":122921},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3464":72314,"_30135":72210,"_20936":122923,"_5":14366,"_27421":122656,"_2948":122924},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3464":72315,"_30135":72210,"_20936":122926,"_5":14366,"_27421":122660,"_2948":122927},[],"RFC 5280: perfil X.509 y CRL.",{"_3464":72316,"_30135":72210,"_20936":122929,"_5":14366,"_27421":122660,"_2948":56172},[],{"_3464":72317,"_30135":72210,"_20936":122931,"_5":14366,"_27421":122660,"_2948":56175},[],{"_3464":72318,"_30135":72210,"_20936":122933,"_5":14366,"_27421":122660,"_2948":122934},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":72319,"_30135":72210,"_20936":122936,"_5":14366,"_27421":122660,"_2948":122937},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3464":72320,"_30135":72320,"_5":14718,"_2948":122939,"_30488":122940,"_20936":122941,"_27421":72320},"Claves y motores criptográficos",[49202,117572,54682,121457],[],{"_3464":72321,"_30135":72320,"_20936":122943,"_5":14366,"_27421":72320,"_2948":122944},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3464":72322,"_30135":72320,"_5":30485,"_20936":122946,"_27421":122947,"_2948":122948},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3464":72323,"_30135":72320,"_5":30485,"_20936":122950,"_27421":122951,"_2948":122952},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3464":72324,"_30135":72320,"_5":30485,"_20936":122954,"_27421":122955,"_2948":56200},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#file-system",{"_3464":72325,"_30135":72320,"_5":30485,"_20936":122957,"_27421":122958,"_2948":56204},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#hashicorp-vault",{"_3464":72326,"_30135":72320,"_5":30485,"_20936":122960,"_27421":122961,"_2948":56208},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#aws-secrets-manager",{"_3464":72327,"_30135":72320,"_5":30485,"_20936":122963,"_27421":122964,"_2948":56212},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#aws-kms",{"_3464":72328,"_30135":72320,"_5":30485,"_20936":122966,"_27421":122967,"_2948":56216},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#pkcs11",{"_3464":72329,"_30135":72320,"_5":30485,"_20936":122969,"_27421":122970,"_2948":56220},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#azure-key-vault",{"_3464":72330,"_30135":72320,"_5":30485,"_20936":122972,"_27421":122973,"_2948":122974},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3464":72331,"_30135":72320,"_5":30485,"_20936":122976,"_27421":122977,"_2948":122978},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3464":72332,"_30135":72320,"_5":30485,"_20936":122980,"_27421":122981,"_2948":122982},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3464":72333,"_30135":72320,"_5":30485,"_20936":122984,"_27421":122985,"_2948":122986},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3464":72334,"_30135":72320,"_5":30485,"_20936":122988,"_27421":122989,"_2948":122990},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3464":72335,"_30135":72320,"_5":30485,"_20936":122992,"_27421":122993,"_2948":122994},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3464":72336,"_30135":72320,"_5":30485,"_20936":122996,"_27421":122997,"_2948":122998},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3464":72337,"_30135":72320,"_5":30485,"_20936":123000,"_27421":123001,"_2948":56252},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#sign",{"_3464":72338,"_30135":72320,"_5":30485,"_20936":123003,"_27421":123004,"_2948":56256},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#verify",{"_3464":72339,"_30135":72320,"_5":30485,"_20936":123006,"_27421":123007,"_2948":123008},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3464":72340,"_30135":72320,"_5":30485,"_20936":123010,"_27421":123011,"_2948":123012},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3464":72341,"_30135":72320,"_5":30485,"_20936":123014,"_27421":123015,"_2948":123016},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3464":72342,"_30135":72320,"_20936":123018,"_5":14366,"_27421":72320,"_2948":123019},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3464":72343,"_30135":72320,"_20936":123021,"_5":14366,"_27421":72320,"_2948":123022},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3464":72344,"_30135":72320,"_20936":123024,"_5":14366,"_27421":122947,"_2948":123025},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3464":72345,"_30135":72320,"_20936":123027,"_5":14366,"_27421":122947,"_2948":123028},[],"En la práctica, permite:",{"_3464":72346,"_30135":72320,"_20936":123030,"_5":14366,"_27421":122947,"_2948":123031},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3464":72347,"_30135":72320,"_20936":123033,"_5":14366,"_27421":122947,"_2948":123034},[],"Importar claves creadas externamente.",{"_3464":72348,"_30135":72320,"_20936":123036,"_5":14366,"_27421":122947,"_2948":123037},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3464":72349,"_30135":72320,"_20936":123039,"_5":14366,"_27421":122947,"_2948":123040},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3464":72350,"_30135":72320,"_20936":123042,"_5":14366,"_27421":122951,"_2948":123043},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3464":72351,"_30135":72320,"_20936":123045,"_5":14366,"_27421":122951,"_2948":123046},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3464":72352,"_30135":72320,"_20936":123048,"_5":14366,"_27421":122951,"_2948":123049},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3464":72353,"_30135":72320,"_20936":123051,"_5":14366,"_27421":122955,"_2948":123052},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3464":72354,"_30135":72320,"_20936":123054,"_5":14366,"_27421":122958,"_2948":123055},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3464":72355,"_30135":72320,"_20936":123057,"_5":14366,"_27421":122958,"_2948":123058},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3464":72356,"_30135":72320,"_20936":123060,"_5":14366,"_27421":122961,"_2948":123061},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3464":72357,"_30135":72320,"_20936":123063,"_5":14366,"_27421":122964,"_2948":123064},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3464":72358,"_30135":72320,"_20936":123066,"_5":14366,"_27421":122967,"_2948":123067},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3464":72359,"_30135":72320,"_20936":123069,"_5":14366,"_27421":122970,"_2948":123070},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3464":72360,"_30135":72320,"_20936":123072,"_5":14366,"_27421":122970,"_2948":123073},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3464":72361,"_30135":72320,"_20936":123075,"_5":14366,"_27421":122970,"_2948":123076},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3464":72362,"_30135":72320,"_20936":123078,"_5":14366,"_27421":122970,"_2948":123079},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3464":72363,"_30135":72320,"_20936":123081,"_5":14366,"_27421":122973,"_2948":123082},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3464":72364,"_30135":72320,"_20936":123084,"_5":14366,"_27421":122973,"_2948":123085},[],"La tabla incluye los siguientes campos:",{"_3464":72365,"_30135":72320,"_20936":123087,"_5":14366,"_27421":122973,"_2948":123088},[],"**Name**: nombre descriptivo de la clave.",{"_3464":72366,"_30135":72320,"_20936":123090,"_5":14366,"_27421":122973,"_2948":123091},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3464":72367,"_30135":72320,"_20936":123093,"_5":14366,"_27421":122973,"_2948":123094},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3464":72368,"_30135":72320,"_20936":123096,"_5":14366,"_27421":122973,"_2948":123097},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3464":72369,"_30135":72320,"_20936":123099,"_5":14366,"_27421":122973,"_2948":123100},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3464":72370,"_30135":72320,"_20936":123102,"_5":14366,"_27421":122973,"_2948":123103},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3464":72371,"_30135":72320,"_20936":123105,"_5":14366,"_27421":122973,"_2948":123106},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3464":72372,"_30135":72320,"_20936":123108,"_5":14366,"_27421":122973,"_2948":123109},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3464":72373,"_30135":72320,"_20936":123111,"_5":14366,"_27421":122973,"_2948":123112},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3464":72374,"_30135":72320,"_20936":123114,"_5":14366,"_27421":122973,"_2948":123115},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3464":72375,"_30135":72320,"_20936":123117,"_5":14366,"_27421":122973,"_2948":123118},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3464":72376,"_30135":72320,"_20936":123120,"_5":14366,"_27421":122973,"_2948":123121},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3464":72377,"_30135":72320,"_20936":123123,"_5":14366,"_27421":122973,"_2948":123124},[],"**Delete Key** para eliminar la clave del sistema.",{"_3464":72378,"_30135":72320,"_20936":123126,"_5":14366,"_27421":122977,"_2948":123127},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3464":72379,"_30135":72320,"_20936":123129,"_5":14366,"_27421":122981,"_2948":123130},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3464":72380,"_30135":72320,"_20936":123132,"_5":14366,"_27421":122981,"_2948":123133},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3464":72381,"_30135":72320,"_20936":123135,"_5":14366,"_27421":122981,"_2948":123136},[],"**Key Name**: nombre único y descriptivo.",{"_3464":72382,"_30135":72320,"_20936":123138,"_5":14366,"_27421":122981,"_2948":123139},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3464":72383,"_30135":72320,"_20936":123141,"_5":14366,"_27421":122981,"_2948":123142},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3464":72384,"_30135":72320,"_20936":123144,"_5":14366,"_27421":122981,"_2948":123145},[],"**Tags**: metadatos para clasificar la clave.",{"_3464":72385,"_30135":72320,"_20936":123147,"_5":14366,"_27421":122981,"_2948":123148},[],"**Metadata**: información adicional para usos avanzados.",{"_3464":72386,"_30135":72320,"_20936":123150,"_5":14366,"_27421":122985,"_2948":123151},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3464":72387,"_30135":72320,"_20936":123153,"_5":14366,"_27421":122985,"_2948":123154},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3464":72388,"_30135":72320,"_20936":123156,"_5":14366,"_27421":122985,"_2948":123157},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3464":72389,"_30135":72320,"_20936":123159,"_5":14366,"_27421":122985,"_2948":123160},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3464":72390,"_30135":72320,"_20936":123162,"_5":14366,"_27421":122985,"_2948":123163},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3464":72391,"_30135":72320,"_20936":123165,"_5":14366,"_27421":122985,"_2948":123166},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3464":72392,"_30135":72320,"_20936":123168,"_5":14366,"_27421":122985,"_2948":123169},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3464":72393,"_30135":72320,"_20936":123171,"_5":14366,"_27421":122985,"_2948":123172},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3464":72394,"_30135":72320,"_20936":123174,"_5":14366,"_27421":122985,"_2948":123175},[],"**Metadata**: información adicional opcional.",{"_3464":72395,"_30135":72320,"_20936":123177,"_5":14366,"_27421":122985,"_2948":123178},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3464":72396,"_30135":72320,"_20936":123180,"_5":14366,"_27421":122985,"_2948":123181},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3464":72397,"_30135":72320,"_20936":123183,"_5":14366,"_27421":122989,"_2948":123184},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3464":72398,"_30135":72320,"_20936":123186,"_5":14366,"_27421":122993,"_2948":123187},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3464":72399,"_30135":72320,"_20936":123189,"_5":14366,"_27421":122993,"_2948":123190},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3464":72400,"_30135":72320,"_20936":123192,"_5":14366,"_27421":122993,"_2948":123193},[],"**Key Name**: nombre descriptivo.",{"_3464":72401,"_30135":72320,"_20936":123195,"_5":14366,"_27421":122993,"_2948":123196},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3464":72402,"_30135":72320,"_20936":123198,"_5":14366,"_27421":122993,"_2948":123199},[],"**Tags**: etiquetas asociadas.",{"_3464":72403,"_30135":72320,"_20936":123201,"_5":14366,"_27421":122993,"_2948":123202},[],"**Aliases**: nombres alternativos.",{"_3464":72404,"_30135":72320,"_20936":123204,"_5":14366,"_27421":122993,"_2948":123205},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3464":72405,"_30135":72320,"_20936":123207,"_5":14366,"_27421":122993,"_2948":123208},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3464":72406,"_30135":72320,"_20936":123210,"_5":14366,"_27421":122993,"_2948":123211},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3464":72407,"_30135":72320,"_20936":123213,"_5":14366,"_27421":122993,"_2948":123214},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3464":72408,"_30135":72320,"_20936":123216,"_5":14366,"_27421":122997,"_2948":123217},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3464":72409,"_30135":72320,"_20936":123219,"_5":14366,"_27421":122997,"_2948":123220},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3464":72410,"_30135":72320,"_20936":123222,"_5":14366,"_27421":122997,"_2948":123223},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3464":72411,"_30135":72320,"_20936":123225,"_5":14366,"_27421":123001,"_2948":123226},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3464":72412,"_30135":72320,"_20936":123228,"_5":14366,"_27421":123001,"_2948":123229},[],"Campos principales:",{"_3464":72413,"_30135":72320,"_20936":123231,"_5":14366,"_27421":123001,"_2948":123232},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3464":72414,"_30135":72320,"_20936":123234,"_5":14366,"_27421":123001,"_2948":123235},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3464":72415,"_30135":72320,"_20936":123237,"_5":14366,"_27421":123001,"_2948":123238},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3464":72416,"_30135":72320,"_20936":123240,"_5":14366,"_27421":123001,"_2948":123241},[],"**Message**: contenido que se va a firmar.",{"_3464":72417,"_30135":72320,"_20936":123243,"_5":14366,"_27421":123001,"_2948":123244},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3464":72418,"_30135":72320,"_20936":123246,"_5":14366,"_27421":123004,"_2948":123247},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3464":72419,"_30135":72320,"_20936":123249,"_5":14366,"_27421":123004,"_2948":123229},[],{"_3464":72420,"_30135":72320,"_20936":123251,"_5":14366,"_27421":123004,"_2948":123252},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3464":72421,"_30135":72320,"_20936":123254,"_5":14366,"_27421":123004,"_2948":123255},[],"**Message Type**: `Raw` o `Digest`.",{"_3464":72422,"_30135":72320,"_20936":123257,"_5":14366,"_27421":123004,"_2948":123258},[],"**Payload Encoding**: codificación del mensaje.",{"_3464":72423,"_30135":72320,"_20936":123260,"_5":14366,"_27421":123004,"_2948":123261},[],"**Message**: mensaje original o hash.",{"_3464":72424,"_30135":72320,"_20936":123263,"_5":14366,"_27421":123004,"_2948":123264},[],"**Signature**: firma que se desea comprobar.",{"_3464":72425,"_30135":72320,"_20936":123266,"_5":14366,"_27421":123004,"_2948":123267},[],"**Result**: indicador del resultado de la validación.",{"_3464":72426,"_30135":72320,"_20936":123269,"_5":14366,"_27421":123007,"_2948":123270},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3464":72427,"_30135":72320,"_20936":123272,"_5":14366,"_27421":123007,"_2948":123273},[],"Este flujo es útil para:",{"_3464":72428,"_30135":72320,"_20936":123275,"_5":14366,"_27421":123007,"_2948":123276},[],"Solicitar certificados a una CA externa.",{"_3464":72429,"_30135":72320,"_20936":123278,"_5":14366,"_27421":123007,"_2948":123279},[],"Renovar una identidad manteniendo la misma clave.",{"_3464":72430,"_30135":72320,"_20936":123281,"_5":14366,"_27421":123007,"_2948":123282},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3464":72431,"_30135":72320,"_20936":123284,"_5":14366,"_27421":123007,"_2948":123285},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3464":72432,"_30135":72320,"_20936":123287,"_5":14366,"_27421":123007,"_2948":123288},[],"**Organization (O)**: organización o empresa.",{"_3464":72433,"_30135":72320,"_20936":123290,"_5":14366,"_27421":123007,"_2948":123291},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3464":72434,"_30135":72320,"_20936":123293,"_5":14366,"_27421":123007,"_2948":123294},[],"**Country (C)**: código de país de dos letras.",{"_3464":72435,"_30135":72320,"_20936":123296,"_5":14366,"_27421":123007,"_2948":123297},[],"**State / Province (ST)**: estado o provincia.",{"_3464":72436,"_30135":72320,"_20936":123299,"_5":14366,"_27421":123007,"_2948":123300},[],"**Locality (L)**: ciudad o localidad.",{"_3464":72437,"_30135":72320,"_20936":123302,"_5":14366,"_27421":123007,"_2948":123303},[],"**Email Address**: correo de contacto.",{"_3464":72438,"_30135":72320,"_20936":123305,"_5":14366,"_27421":123007,"_2948":123306},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3464":72439,"_30135":72320,"_20936":123308,"_5":14366,"_27421":123007,"_2948":123309},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3464":72440,"_30135":72320,"_20936":123311,"_5":14366,"_27421":123011,"_2948":123312},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3464":72441,"_30135":72320,"_20936":123314,"_5":14366,"_27421":123011,"_2948":123315},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3464":72442,"_30135":72320,"_20936":123317,"_5":14366,"_27421":123015,"_2948":123318},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3464":72443,"_30135":72320,"_20936":123320,"_5":14366,"_27421":123015,"_2948":123321},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3464":72444,"_30135":72444,"_5":14718,"_2948":123323,"_30488":123324,"_20936":123325,"_27421":72444},"Validación online con OCSP",[49202,117572,54682,122094],[],{"_3464":72445,"_30135":72444,"_20936":123327,"_5":14366,"_27421":72444,"_2948":123328},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3464":72446,"_30135":72444,"_5":30485,"_20936":123330,"_27421":123331,"_2948":123332},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3464":72447,"_30135":72444,"_5":30485,"_20936":123334,"_27421":123335,"_2948":123336},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3464":72448,"_30135":72444,"_5":30485,"_20936":123338,"_27421":123339,"_2948":123340},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3464":72449,"_30135":72444,"_5":30485,"_20936":123342,"_27421":123343,"_2948":123344},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3464":72450,"_30135":72444,"_5":30485,"_20936":123346,"_27421":123347,"_2948":123348},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3464":72451,"_30135":72444,"_5":30485,"_20936":123350,"_27421":123351,"_2948":122661},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#referencias",{"_3464":72452,"_30135":72444,"_20936":123353,"_5":14366,"_27421":72444,"_2948":123354},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3464":72453,"_30135":72444,"_20936":123356,"_5":14366,"_27421":123331,"_2948":123357},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3464":72454,"_30135":72444,"_20936":123359,"_5":14366,"_27421":123331,"_2948":123360},[],"Estado del registro",{"_3464":72455,"_30135":72444,"_20936":123362,"_5":14366,"_27421":123331,"_2948":123363},[],"Respuesta firmada",{"_3464":72456,"_30135":72444,"_20936":123365,"_5":14366,"_27421":123331,"_2948":53812},[],{"_3464":72457,"_30135":72444,"_20936":123367,"_5":14366,"_27421":123331,"_2948":56620},[],{"_3464":72458,"_30135":72444,"_20936":123369,"_5":14366,"_27421":123331,"_2948":53829},[],{"_3464":72459,"_30135":72444,"_20936":123371,"_5":14366,"_27421":123331,"_2948":123372},[],"`Revoked`, con razón y fecha de revocación.",{"_3464":72460,"_30135":72444,"_20936":123374,"_5":14366,"_27421":123331,"_2948":123375},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3464":72461,"_30135":72444,"_20936":123377,"_5":14366,"_27421":123331,"_2948":123378},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3464":72462,"_30135":72444,"_20936":123380,"_5":14366,"_27421":123331,"_2948":123381},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3464":72463,"_30135":72444,"_20936":123383,"_5":14366,"_27421":123331,"_2948":123384},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3464":72464,"_30135":72444,"_20936":123386,"_5":14366,"_27421":123331,"_2948":123387},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3464":72465,"_30135":72444,"_20936":123389,"_5":14366,"_27421":123335,"_2948":123390},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3464":72466,"_30135":72444,"_20936":123392,"_5":14366,"_27421":123335,"_2948":123393},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3464":72467,"_30135":72444,"_20936":123395,"_5":14366,"_27421":123339,"_2948":123396},[],"El servicio acepta:",{"_3464":72468,"_30135":72444,"_20936":123398,"_5":14366,"_27421":123339,"_2948":119302},[],{"_3464":72469,"_30135":72444,"_20936":123400,"_5":14366,"_27421":123339,"_2948":123401},[],"Ruta del servicio VA",{"_3464":72470,"_30135":72444,"_20936":123403,"_5":14366,"_27421":123339,"_2948":123404},[],"Formato",{"_3464":72471,"_30135":72444,"_20936":123406,"_5":14366,"_27421":123339,"_2948":56660},[],{"_3464":72472,"_30135":72444,"_20936":123408,"_5":14366,"_27421":123339,"_2948":56663},[],{"_3464":72473,"_30135":72444,"_20936":123410,"_5":14366,"_27421":123339,"_2948":123411},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3464":72474,"_30135":72444,"_20936":123413,"_5":14366,"_27421":123339,"_2948":56072},[],{"_3464":72475,"_30135":72444,"_20936":123415,"_5":14366,"_27421":123339,"_2948":56671},[],{"_3464":72476,"_30135":72444,"_20936":123417,"_5":14366,"_27421":123339,"_2948":123418},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3464":72477,"_30135":72444,"_20936":123420,"_5":14366,"_27421":123339,"_2948":123421},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3464":72478,"_30135":72444,"_20936":123423,"_5":14366,"_27421":123343,"_2948":123424},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3464":72479,"_30135":72444,"_20936":123426,"_5":14366,"_27421":123343,"_2948":123427},[],"Genera la solicitud:",{"_3464":72480,"_30135":72444,"_20936":123429,"_5":14366,"_27421":123343,"_2948":123430},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3464":72481,"_30135":72444,"_20936":123432,"_5":14366,"_27421":123343,"_2948":123433},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3464":72482,"_30135":72444,"_20936":123435,"_5":14366,"_27421":123343,"_2948":123436},[],"Verifica el DER recibido:",{"_3464":72483,"_30135":72444,"_20936":123438,"_5":14366,"_27421":123343,"_2948":123439},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3464":72484,"_30135":72444,"_20936":123441,"_5":14366,"_27421":123347,"_2948":123442},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3464":72485,"_30135":72444,"_20936":123444,"_5":14366,"_27421":123347,"_2948":123445},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3464":72486,"_30135":72444,"_20936":123447,"_5":14366,"_27421":123351,"_2948":56704},[],{"_3464":72487,"_30135":72444,"_20936":123449,"_5":14366,"_27421":123351,"_2948":56707},[],{"_3464":72488,"_30135":72444,"_20936":123451,"_5":14366,"_27421":123351,"_2948":123452},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3464":72489,"_30135":72444,"_20936":123454,"_5":14366,"_27421":123351,"_2948":122937},[],{"_3464":72490,"_30135":72490,"_5":14718,"_2948":54682,"_30488":123456,"_20936":123457,"_27421":72490},[49202,117572,54682],[],{"_3464":72491,"_30135":72490,"_20936":123459,"_5":14366,"_27421":72490,"_2948":123460},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3464":72492,"_30135":72490,"_5":30485,"_20936":123462,"_27421":123463,"_2948":120776},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#empieza-aquí",{"_3464":72493,"_30135":72490,"_5":30485,"_20936":123465,"_27421":123466,"_2948":123467},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3464":72494,"_30135":72490,"_5":30485,"_20936":123469,"_27421":123470,"_2948":121300},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#capacidades-principales",{"_3464":72495,"_30135":72490,"_5":30485,"_20936":123472,"_27421":123473,"_2948":121304},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3464":72496,"_30135":72490,"_5":30485,"_20936":123475,"_27421":123476,"_2948":121308},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3464":72497,"_30135":72490,"_5":30485,"_20936":123478,"_27421":123479,"_2948":121312},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#emite-y-controla-certificados",{"_3464":72498,"_30135":72490,"_5":30485,"_20936":123481,"_27421":123482,"_2948":121320},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#publica-el-estado-de-validación",{"_3464":72499,"_30135":72490,"_5":30485,"_20936":123484,"_27421":123485,"_2948":123486},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3464":72500,"_30135":72490,"_5":30485,"_20936":123488,"_27421":123489,"_2948":122260},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#continúa",{"_3464":72501,"_30135":72490,"_20936":123491,"_5":14366,"_27421":72490,"_2948":123492},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3464":72502,"_30135":72490,"_20936":123494,"_5":14366,"_27421":123463,"_2948":123495},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3464":72503,"_30135":72490,"_20936":123497,"_5":14366,"_27421":123463,"_2948":123498},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3464":72504,"_30135":72490,"_20936":123500,"_5":14366,"_27421":123466,"_2948":123501},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3464":72505,"_30135":72490,"_20936":123503,"_5":14366,"_27421":123466,"_2948":123504},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3464":72506,"_30135":72490,"_20936":123506,"_5":14366,"_27421":123466,"_2948":123507},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3464":72507,"_30135":72490,"_20936":123509,"_5":14366,"_27421":123466,"_2948":123510},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3464":72508,"_30135":72490,"_20936":123512,"_5":14366,"_27421":123466,"_2948":123513},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3464":72509,"_30135":72490,"_20936":123515,"_5":14366,"_27421":123473,"_2948":123516},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3464":72510,"_30135":72490,"_20936":123518,"_5":14366,"_27421":123476,"_2948":123519},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3464":72511,"_30135":72490,"_20936":123521,"_5":14366,"_27421":123479,"_2948":123522},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3464":72512,"_30135":72490,"_20936":123524,"_5":14366,"_27421":123482,"_2948":123525},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3464":72513,"_30135":72490,"_20936":123527,"_5":14366,"_27421":123485,"_2948":123528},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3464":72514,"_30135":72490,"_20936":123530,"_5":14366,"_27421":123485,"_2948":123531},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3464":72515,"_30135":72490,"_20936":123533,"_5":14366,"_27421":123485,"_2948":123534},[],"su clave pública corresponda a la clave privada del cliente;",{"_3464":72516,"_30135":72490,"_20936":123536,"_5":14366,"_27421":123485,"_2948":123537},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3464":72517,"_30135":72490,"_20936":123539,"_5":14366,"_27421":123485,"_2948":123540},[],"sus fechas y usos permitan la operación;",{"_3464":72518,"_30135":72490,"_20936":123542,"_5":14366,"_27421":123485,"_2948":123543},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3464":72519,"_30135":72490,"_20936":123545,"_5":14366,"_27421":123485,"_2948":123546},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3464":72520,"_30135":72490,"_20936":123548,"_5":14366,"_27421":123489,"_2948":123549},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3464":72521,"_30135":72490,"_20936":123551,"_5":14366,"_27421":123489,"_2948":123552},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3464":72522,"_30135":72490,"_20936":123554,"_5":14366,"_27421":123489,"_2948":123555},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3464":72523,"_30135":72523,"_5":14718,"_2948":123557,"_30488":123558,"_20936":123559,"_27421":72523},"Crea tu primera CA",[49202,117572,54682,120900],[],{"_3464":72524,"_30135":72523,"_20936":123561,"_5":14366,"_27421":72523,"_2948":123562},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3464":72525,"_30135":72523,"_5":30485,"_20936":123564,"_27421":123565,"_2948":116150},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3464":72526,"_30135":72523,"_5":30485,"_20936":123567,"_27421":123568,"_2948":123569},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3464":72527,"_30135":72523,"_5":30485,"_20936":123571,"_27421":123572,"_2948":123573},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3464":72528,"_30135":72523,"_5":30485,"_20936":123575,"_27421":123576,"_2948":123577},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3464":72529,"_30135":72523,"_5":30485,"_20936":123579,"_27421":123580,"_2948":123581},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3464":72530,"_30135":72523,"_5":30485,"_20936":123583,"_27421":123584,"_2948":123585},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3464":72531,"_30135":72523,"_5":30485,"_20936":123587,"_27421":123588,"_2948":123589},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3464":72532,"_30135":72523,"_5":30485,"_20936":123591,"_27421":123592,"_2948":121147},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3464":72533,"_30135":72523,"_5":30485,"_20936":123594,"_27421":123595,"_2948":116174},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3464":72534,"_30135":72523,"_20936":123597,"_5":14366,"_27421":72523,"_2948":123598},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3464":72535,"_30135":72523,"_20936":123600,"_5":14366,"_27421":123565,"_2948":123601},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3464":72536,"_30135":72523,"_20936":123603,"_5":14366,"_27421":123565,"_2948":123604},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3464":72537,"_30135":72523,"_20936":123606,"_5":14366,"_27421":123565,"_2948":123607},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3464":72538,"_30135":72523,"_20936":123609,"_5":14366,"_27421":123565,"_2948":123610},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3464":72539,"_30135":72523,"_20936":123612,"_5":14366,"_27421":123568,"_2948":123613},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3464":72540,"_30135":72523,"_20936":123615,"_5":14366,"_27421":123568,"_2948":123616},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3464":72541,"_30135":72523,"_20936":123618,"_5":14366,"_27421":123572,"_2948":123619},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3464":72542,"_30135":72523,"_20936":123621,"_5":14366,"_27421":123572,"_2948":123622},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3464":72543,"_30135":72523,"_20936":123624,"_5":14366,"_27421":123576,"_2948":123625},[],"Selecciona **Root CA** y completa:",{"_3464":72544,"_30135":72523,"_20936":123627,"_5":14366,"_27421":123576,"_2948":56886},[],{"_3464":72545,"_30135":72523,"_20936":123629,"_5":14366,"_27421":123576,"_2948":123630},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3464":72546,"_30135":72523,"_20936":123632,"_5":14366,"_27421":123576,"_2948":123633},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3464":72547,"_30135":72523,"_20936":123635,"_5":14366,"_27421":123576,"_2948":123636},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3464":72548,"_30135":72523,"_20936":123638,"_5":14366,"_27421":123576,"_2948":123639},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3464":72549,"_30135":72523,"_20936":123641,"_5":14366,"_27421":123580,"_2948":123642},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3464":72550,"_30135":72523,"_20936":123644,"_5":14366,"_27421":123584,"_2948":123645},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3464":72551,"_30135":72523,"_20936":123647,"_5":14366,"_27421":123584,"_2948":123648},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3464":72552,"_30135":72523,"_20936":123650,"_5":14366,"_27421":123588,"_2948":123651},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3464":72553,"_30135":72523,"_20936":123653,"_5":14366,"_27421":123588,"_2948":123654},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3464":72554,"_30135":72523,"_20936":123656,"_5":14366,"_27421":123588,"_2948":123657},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3464":72555,"_30135":72523,"_20936":123659,"_5":14366,"_27421":123592,"_2948":123660},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3464":72556,"_30135":72523,"_20936":123662,"_5":14366,"_27421":123592,"_2948":123663},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3464":72557,"_30135":72523,"_20936":123665,"_5":14366,"_27421":123592,"_2948":123666},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3464":72558,"_30135":72523,"_20936":123668,"_5":14366,"_27421":123592,"_2948":123669},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3464":72559,"_30135":72523,"_20936":123671,"_5":14366,"_27421":123595,"_2948":123672},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3464":72560,"_30135":72560,"_5":14718,"_2948":123674,"_30488":123675,"_20936":123676,"_27421":72560},"Emite y verifica un certificado",[49202,117572,54682,120900],[],{"_3464":72561,"_30135":72560,"_20936":123678,"_5":14366,"_27421":72560,"_2948":123679},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3464":72562,"_30135":72560,"_5":30485,"_20936":123681,"_27421":123682,"_2948":116150},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3464":72563,"_30135":72560,"_5":30485,"_20936":123684,"_27421":123685,"_2948":123686},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3464":72564,"_30135":72560,"_5":30485,"_20936":123688,"_27421":123689,"_2948":123690},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3464":72565,"_30135":72560,"_5":30485,"_20936":123692,"_27421":123693,"_2948":123694},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3464":72566,"_30135":72560,"_5":30485,"_20936":123696,"_27421":123697,"_2948":123698},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3464":72567,"_30135":72560,"_5":30485,"_20936":123700,"_27421":123701,"_2948":123702},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3464":72568,"_30135":72560,"_5":30485,"_20936":123704,"_27421":123705,"_2948":123706},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3464":72569,"_30135":72560,"_5":30485,"_20936":123708,"_27421":123709,"_2948":123710},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3464":72570,"_30135":72560,"_5":30485,"_20936":123712,"_27421":123713,"_2948":123714},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3464":72571,"_30135":72560,"_5":30485,"_20936":123716,"_27421":123717,"_2948":123718},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3464":72572,"_30135":72560,"_5":30485,"_20936":123720,"_27421":123721,"_2948":121147},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3464":72573,"_30135":72560,"_5":30485,"_20936":123723,"_27421":123724,"_2948":116174},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3464":72574,"_30135":72560,"_20936":123726,"_5":14366,"_27421":72560,"_2948":123727},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3464":72575,"_30135":72560,"_20936":123729,"_5":14366,"_27421":123682,"_2948":123730},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3464":72576,"_30135":72560,"_20936":123732,"_5":14366,"_27421":123682,"_2948":123733},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3464":72577,"_30135":72560,"_20936":123735,"_5":14366,"_27421":123682,"_2948":123736},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3464":72578,"_30135":72560,"_20936":123738,"_5":14366,"_27421":123682,"_2948":123739},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3464":72579,"_30135":72560,"_20936":123741,"_5":14366,"_27421":123682,"_2948":123742},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3464":72580,"_30135":72560,"_20936":123744,"_5":14366,"_27421":123685,"_2948":123745},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3464":72581,"_30135":72560,"_20936":123747,"_5":14366,"_27421":123689,"_2948":123748},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3464":72582,"_30135":72560,"_20936":123750,"_5":14366,"_27421":123689,"_2948":123751},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3464":72583,"_30135":72560,"_20936":123753,"_5":14366,"_27421":123693,"_2948":123754},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3464":72584,"_30135":72560,"_20936":123756,"_5":14366,"_27421":123693,"_2948":123757},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3464":72585,"_30135":72560,"_20936":123759,"_5":14366,"_27421":123697,"_2948":123760},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3464":72586,"_30135":72560,"_20936":123762,"_5":14366,"_27421":123697,"_2948":123763},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3464":72587,"_30135":72560,"_20936":123765,"_5":14366,"_27421":123701,"_2948":123766},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3464":72588,"_30135":72560,"_20936":123768,"_5":14366,"_27421":123705,"_2948":123769},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3464":72589,"_30135":72560,"_20936":123771,"_5":14366,"_27421":123709,"_2948":123772},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3464":72590,"_30135":72560,"_20936":123774,"_5":14366,"_27421":123713,"_2948":123775},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3464":72591,"_30135":72560,"_20936":123777,"_5":14366,"_27421":123713,"_2948":123778},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3464":72592,"_30135":72560,"_20936":123780,"_5":14366,"_27421":123713,"_2948":123781},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3464":72593,"_30135":72560,"_20936":123783,"_5":14366,"_27421":123717,"_2948":123784},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3464":72594,"_30135":72560,"_20936":123786,"_5":14366,"_27421":123717,"_2948":123787},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3464":72595,"_30135":72560,"_20936":123789,"_5":14366,"_27421":123717,"_2948":123790},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3464":72596,"_30135":72560,"_20936":123792,"_5":14366,"_27421":123721,"_2948":121230},[],{"_3464":72597,"_30135":72560,"_20936":123794,"_5":14366,"_27421":123721,"_2948":119751},[],{"_3464":72598,"_30135":72560,"_20936":123796,"_5":14366,"_27421":123721,"_2948":123797},[],"La CA rechaza la emisión",{"_3464":72599,"_30135":72560,"_20936":123799,"_5":14366,"_27421":123721,"_2948":123800},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3464":72600,"_30135":72560,"_20936":123802,"_5":14366,"_27421":123721,"_2948":123803},[],"Sujeto o usos diferentes",{"_3464":72601,"_30135":72560,"_20936":123805,"_5":14366,"_27421":123721,"_2948":123806},[],"Perfil aplicado y valores solicitados.",{"_3464":72602,"_30135":72560,"_20936":123808,"_5":14366,"_27421":123721,"_2948":123809},[],"No se encuentra el emisor",{"_3464":72603,"_30135":72560,"_20936":123811,"_5":14366,"_27421":123721,"_2948":123812},[],"CA descargada y cadena intermedia necesaria.",{"_3464":72604,"_30135":72560,"_20936":123814,"_5":14366,"_27421":123721,"_2948":123815},[],"Falla la vigencia",{"_3464":72605,"_30135":72560,"_20936":123817,"_5":14366,"_27421":123721,"_2948":123818},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3464":72606,"_30135":72560,"_20936":123820,"_5":14366,"_27421":123721,"_2948":123821},[],"Los resúmenes de clave difieren",{"_3464":72607,"_30135":72560,"_20936":123823,"_5":14366,"_27421":123721,"_2948":123824},[],"Archivos de certificado y clave de la misma emisión.",{"_3464":72608,"_30135":72560,"_20936":123826,"_5":14366,"_27421":123721,"_2948":123827},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3464":72609,"_30135":72560,"_20936":123829,"_5":14366,"_27421":123724,"_2948":123830},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3464":72610,"_30135":72560,"_20936":123832,"_5":14366,"_27421":123724,"_2948":123833},[],"Gestionar certificados para inspección, estado y revocación.",{"_3464":72611,"_30135":72560,"_20936":123835,"_5":14366,"_27421":123724,"_2948":123836},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3464":72612,"_30135":72560,"_20936":123838,"_5":14366,"_27421":123724,"_2948":123839},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3464":72613,"_30135":72560,"_20936":123841,"_5":14366,"_27421":123724,"_2948":123842},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3464":72614,"_30135":72614,"_5":14718,"_2948":123844,"_30488":123845,"_20936":123846,"_27421":72614},"Primeros pasos de PKI",[49202,117572,54682,120900],[],{"_3464":72615,"_30135":72614,"_20936":123848,"_5":14366,"_27421":72614,"_2948":123849},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3464":72616,"_30135":72614,"_5":30485,"_20936":123851,"_27421":123852,"_2948":116150},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3464":72617,"_30135":72614,"_5":30485,"_20936":123854,"_27421":123855,"_2948":123856},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3464":72618,"_30135":72614,"_5":30485,"_20936":123858,"_27421":123859,"_2948":121082},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3464":72619,"_30135":72614,"_5":30485,"_20936":123861,"_27421":123862,"_2948":123863},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3464":72620,"_30135":72614,"_20936":123865,"_5":14366,"_27421":72614,"_2948":123866},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3464":72621,"_30135":72614,"_20936":123868,"_5":14366,"_27421":123852,"_2948":123869},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3464":72622,"_30135":72614,"_20936":123871,"_5":14366,"_27421":123852,"_2948":123872},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3464":72623,"_30135":72614,"_20936":123874,"_5":14366,"_27421":123852,"_2948":123875},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3464":72624,"_30135":72614,"_20936":123877,"_5":14366,"_27421":123852,"_2948":123878},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3464":72625,"_30135":72614,"_20936":123880,"_5":14366,"_27421":123852,"_2948":123881},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3464":72626,"_30135":72614,"_20936":123883,"_5":14366,"_27421":123855,"_2948":123884},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3464":72627,"_30135":72614,"_20936":123886,"_5":14366,"_27421":123855,"_2948":123887},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3464":72628,"_30135":72614,"_20936":123889,"_5":14366,"_27421":123855,"_2948":123890},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3464":72629,"_30135":72614,"_20936":123892,"_5":14366,"_27421":123855,"_2948":123893},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3464":72630,"_30135":72614,"_20936":123895,"_5":14366,"_27421":123859,"_2948":123896},[],"Archivo o recurso",{"_3464":72631,"_30135":72614,"_20936":123898,"_5":14366,"_27421":123859,"_2948":121079},[],{"_3464":72632,"_30135":72614,"_20936":123900,"_5":14366,"_27421":123859,"_2948":123901},[],"CA raíz activa y `ca.pem`",{"_3464":72633,"_30135":72614,"_20936":123903,"_5":14366,"_27421":123859,"_2948":123904},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3464":72634,"_30135":72614,"_20936":123906,"_5":14366,"_27421":123859,"_2948":123907},[],"Certificado final y `device.crt`",{"_3464":72635,"_30135":72614,"_20936":123909,"_5":14366,"_27421":123859,"_2948":123910},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3464":72636,"_30135":72614,"_20936":123912,"_5":14366,"_27421":123859,"_2948":123913},[],"Clave privada `device.key`",{"_3464":72637,"_30135":72614,"_20936":123915,"_5":14366,"_27421":123859,"_2948":123916},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3464":72638,"_30135":72614,"_20936":123918,"_5":14366,"_27421":123859,"_2948":123919},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3464":72639,"_30135":72614,"_20936":123921,"_5":14366,"_27421":123862,"_2948":123922},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3464":72640,"_30135":72614,"_20936":123924,"_5":14366,"_27421":123862,"_2948":123925},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3464":72641,"_30135":72614,"_20936":123927,"_5":14366,"_27421":123862,"_2948":123928},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3464":72642,"_30135":72642,"_5":14718,"_2948":123930,"_30488":123931,"_20936":123933,"_27421":72642},"Resolución de problemas PKI",[49202,117572,54682,123932],"Resolución de problemas",[],{"_3464":72643,"_30135":72642,"_20936":123935,"_5":14366,"_27421":72642,"_2948":123936},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3464":72644,"_30135":72642,"_5":30485,"_20936":123938,"_27421":123939,"_2948":123940},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3464":72645,"_30135":72642,"_5":30485,"_20936":123942,"_27421":123943,"_2948":123944},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3464":72646,"_30135":72642,"_5":30485,"_20936":123946,"_27421":123947,"_2948":123948},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3464":72647,"_30135":72642,"_20936":123950,"_5":14366,"_27421":72642,"_2948":123951},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3464":72648,"_30135":72642,"_20936":123953,"_5":14366,"_27421":72642,"_2948":123954},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3464":72649,"_30135":72642,"_20936":123956,"_5":14366,"_27421":123939,"_2948":121079},[],{"_3464":72650,"_30135":72642,"_20936":123958,"_5":14366,"_27421":123939,"_2948":119751},[],{"_3464":72651,"_30135":72642,"_20936":123960,"_5":14366,"_27421":123939,"_2948":116174},[],{"_3464":72652,"_30135":72642,"_20936":123962,"_5":14366,"_27421":123939,"_2948":53517},[],{"_3464":72653,"_30135":72642,"_20936":123964,"_5":14366,"_27421":123939,"_2948":123965},[],"Existe, está activa y sus fechas son utilizables.",{"_3464":72654,"_30135":72642,"_20936":123967,"_5":14366,"_27421":123939,"_2948":123968},[],"Autoridades.",{"_3464":72655,"_30135":72642,"_20936":123970,"_5":14366,"_27421":123939,"_2948":123971},[],"Clave",{"_3464":72656,"_30135":72642,"_20936":123973,"_5":14366,"_27421":123939,"_2948":123974},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3464":72657,"_30135":72642,"_20936":123976,"_5":14366,"_27421":123939,"_2948":123977},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3464":72658,"_30135":72642,"_20936":123979,"_5":14366,"_27421":123939,"_2948":57240},[],{"_3464":72659,"_30135":72642,"_20936":123981,"_5":14366,"_27421":123939,"_2948":123982},[],"PEM correcto y firma verificable.",{"_3464":72660,"_30135":72642,"_20936":123984,"_5":14366,"_27421":123939,"_2948":57246},[],{"_3464":72661,"_30135":72642,"_20936":123986,"_5":14366,"_27421":123939,"_2948":123987},[],"Perfil",{"_3464":72662,"_30135":72642,"_20936":123989,"_5":14366,"_27421":123939,"_2948":123990},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3464":72663,"_30135":72642,"_20936":123992,"_5":14366,"_27421":123939,"_2948":123993},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3464":72664,"_30135":72642,"_20936":123995,"_5":14366,"_27421":123939,"_2948":121230},[],{"_3464":72665,"_30135":72642,"_20936":123997,"_5":14366,"_27421":123939,"_2948":123998},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3464":72666,"_30135":72642,"_20936":124000,"_5":14366,"_27421":123939,"_2948":124001},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3464":72667,"_30135":72642,"_20936":124003,"_5":14366,"_27421":123939,"_2948":124004},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3464":72668,"_30135":72642,"_20936":124006,"_5":14366,"_27421":123939,"_2948":124007},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3464":72669,"_30135":72642,"_20936":124009,"_5":14366,"_27421":123943,"_2948":124010},[],"Revisa cada frontera por separado:",{"_3464":72670,"_30135":72642,"_20936":124012,"_5":14366,"_27421":123943,"_2948":124013},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3464":72671,"_30135":72642,"_20936":124015,"_5":14366,"_27421":123943,"_2948":124016},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3464":72672,"_30135":72642,"_20936":124018,"_5":14366,"_27421":123943,"_2948":124019},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3464":72673,"_30135":72642,"_20936":124021,"_5":14366,"_27421":123943,"_2948":124022},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3464":72674,"_30135":72642,"_20936":124024,"_5":14366,"_27421":123943,"_2948":124025},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3464":72675,"_30135":72642,"_20936":124027,"_5":14366,"_27421":123943,"_2948":124028},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3464":72676,"_30135":72642,"_20936":124030,"_5":14366,"_27421":123947,"_2948":124031},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3464":72677,"_30135":72642,"_20936":124033,"_5":14366,"_27421":123947,"_2948":124034},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3464":72678,"_30135":72678,"_5":14718,"_2948":124036,"_30488":124037,"_20936":124038,"_27421":72678},"Seguridad",[49202],[],{"_3464":72679,"_30135":72678,"_20936":124040,"_5":14366,"_27421":72678,"_2948":124041},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3464":72680,"_30135":72678,"_5":30485,"_20936":124043,"_27421":124044,"_2948":124045},[],"/docs/pr-preview/pr-61/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3464":72681,"_30135":72678,"_5":30485,"_20936":124047,"_27421":124048,"_2948":124049},[],"/docs/pr-preview/pr-61/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3464":72682,"_30135":72678,"_5":30485,"_20936":124051,"_27421":124052,"_2948":124053},[],"/docs/pr-preview/pr-61/es/security#versiones-soportadas","Versiones soportadas",{"_3464":72683,"_30135":72678,"_5":30485,"_20936":124055,"_27421":124056,"_2948":124057},[],"/docs/pr-preview/pr-61/es/security#divulgación-responsable","Divulgación responsable",{"_3464":72684,"_30135":72678,"_20936":124059,"_5":14366,"_27421":72678,"_2948":124060},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3464":72685,"_30135":72678,"_20936":124062,"_5":14366,"_27421":124044,"_2948":124063},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3464":72686,"_30135":72678,"_20936":124065,"_5":14366,"_27421":124044,"_2948":124066},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3464":72687,"_30135":72678,"_20936":124068,"_5":14366,"_27421":124044,"_2948":14991},[],{"_3464":72688,"_30135":72678,"_20936":124070,"_5":14366,"_27421":124044,"_2948":14931},[],{"_3464":72689,"_30135":72678,"_20936":124072,"_5":14366,"_27421":124044,"_2948":14978},[],{"_3464":72690,"_30135":72678,"_20936":124074,"_5":14366,"_27421":124044,"_2948":124075},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3464":72691,"_30135":72678,"_20936":124077,"_5":14366,"_27421":124044,"_2948":124078},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3464":72692,"_30135":72678,"_20936":124080,"_5":14366,"_27421":124048,"_2948":124081},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3464":72693,"_30135":72678,"_20936":124083,"_5":14366,"_27421":124048,"_2948":124084},[],"No incluyas en el reporte:",{"_3464":72694,"_30135":72678,"_20936":124086,"_5":14366,"_27421":124048,"_2948":124087},[],"Credenciales, tokens o claves privadas",{"_3464":72695,"_30135":72678,"_20936":124089,"_5":14366,"_27421":124048,"_2948":124090},[],"Datos de clientes o información identificable de clientes",{"_3464":72696,"_30135":72678,"_20936":124092,"_5":14366,"_27421":124048,"_2948":124093},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3464":72697,"_30135":72678,"_20936":124095,"_5":14366,"_27421":124052,"_2948":124096},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3464":72698,"_30135":72678,"_20936":124098,"_5":14366,"_27421":124052,"_2948":124099},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3464":72699,"_30135":72678,"_20936":124101,"_5":14366,"_27421":124056,"_2948":124102},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3464":72700,"_30135":72678,"_20936":124104,"_5":14366,"_27421":124056,"_2948":124105},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3464":72701,"_30135":72678,"_20936":124107,"_5":14366,"_27421":124056,"_2948":124108},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3464":72702,"_30135":72678,"_20936":124110,"_5":14366,"_27421":124056,"_2948":124111},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3464":72703,"_30135":72678,"_20936":124113,"_5":14366,"_27421":124056,"_2948":124114},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3464":72704,"_30135":72704,"_5":14718,"_2948":124116,"_30488":124117,"_20936":124119,"_27421":72704},"3.8.0 a 4.0.0",[49202,124118],"Actualizaciones",[],{"_3464":72705,"_30135":72704,"_20936":124121,"_5":14366,"_27421":72704,"_2948":124122},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3464":72706,"_30135":72704,"_5":30485,"_20936":124124,"_27421":124125,"_2948":124126},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3464":72707,"_30135":72704,"_5":30485,"_20936":124128,"_27421":124129,"_2948":124130},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3464":72708,"_30135":72704,"_5":30485,"_20936":124132,"_27421":124133,"_2948":124134},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3464":72709,"_30135":72704,"_5":30485,"_20936":124136,"_27421":124137,"_2948":124138},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3464":72710,"_30135":72704,"_5":30485,"_20936":124140,"_27421":124141,"_2948":124142},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3464":72711,"_30135":72704,"_5":30485,"_20936":124144,"_27421":124145,"_2948":124146},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3464":72712,"_30135":72704,"_5":30485,"_20936":124148,"_27421":124149,"_2948":57412},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3464":72713,"_30135":72704,"_5":30485,"_20936":124151,"_27421":124152,"_2948":124153},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3464":72714,"_30135":72704,"_5":30485,"_20936":124155,"_27421":124156,"_2948":124157},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3464":72715,"_30135":72704,"_5":30485,"_20936":124159,"_27421":124160,"_2948":124161},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3464":72716,"_30135":72704,"_5":30485,"_20936":124163,"_27421":124164,"_2948":124165},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3464":72717,"_30135":72704,"_5":30485,"_20936":124167,"_27421":124168,"_2948":124169},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3464":72718,"_30135":72704,"_5":30485,"_20936":124171,"_27421":124172,"_2948":124173},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3464":72719,"_30135":72704,"_5":30485,"_20936":124175,"_27421":124176,"_2948":124177},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3464":72720,"_30135":72704,"_5":30485,"_20936":124179,"_27421":124180,"_2948":124181},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3464":72721,"_30135":72704,"_5":30485,"_20936":124183,"_27421":124184,"_2948":124185},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3464":72722,"_30135":72704,"_5":30485,"_20936":124187,"_27421":124188,"_2948":124189},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3464":72723,"_30135":72704,"_5":30485,"_20936":124191,"_27421":124192,"_2948":124193},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3464":72724,"_30135":72704,"_5":30485,"_20936":124195,"_27421":124196,"_2948":124197},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3464":72725,"_30135":72704,"_5":30485,"_20936":124199,"_27421":124200,"_2948":124201},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3464":72726,"_30135":72704,"_5":30485,"_20936":124203,"_27421":124204,"_2948":124205},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3464":72727,"_30135":72704,"_5":30485,"_20936":124207,"_27421":124208,"_2948":124209},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3464":72728,"_30135":72704,"_5":30485,"_20936":124211,"_27421":124212,"_2948":124213},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3464":72729,"_30135":72704,"_5":30485,"_20936":124215,"_27421":124216,"_2948":124217},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3464":72730,"_30135":72704,"_5":30485,"_20936":124219,"_27421":124220,"_2948":124221},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3464":72731,"_30135":72704,"_5":30485,"_20936":124223,"_27421":124224,"_2948":124225},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3464":72732,"_30135":72704,"_5":30485,"_20936":124227,"_27421":124228,"_2948":124229},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3464":72733,"_30135":72704,"_5":30485,"_20936":124231,"_27421":124232,"_2948":124233},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3464":72734,"_30135":72704,"_5":30485,"_20936":124235,"_27421":124236,"_2948":124237},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3464":72735,"_30135":72704,"_5":30485,"_20936":124239,"_27421":124240,"_2948":124241},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3464":72736,"_30135":72704,"_5":30485,"_20936":124243,"_27421":124244,"_2948":124245},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3464":72737,"_30135":72704,"_5":30485,"_20936":124247,"_27421":124248,"_2948":124249},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3464":72738,"_30135":72704,"_5":30485,"_20936":124251,"_27421":124252,"_2948":124253},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3464":72739,"_30135":72704,"_5":30485,"_20936":124255,"_27421":124256,"_2948":124257},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3464":72740,"_30135":72704,"_5":30485,"_20936":124259,"_27421":124260,"_2948":124261},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3464":72741,"_30135":72704,"_5":30485,"_20936":124263,"_27421":124264,"_2948":124265},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3464":72742,"_30135":72704,"_5":30485,"_20936":124267,"_27421":124268,"_2948":124269},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3464":72743,"_30135":72704,"_5":30485,"_20936":124271,"_27421":124272,"_2948":124273},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3464":72744,"_30135":72704,"_5":30485,"_20936":124275,"_27421":124276,"_2948":124277},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3464":72745,"_30135":72704,"_5":30485,"_20936":124279,"_27421":124280,"_2948":124281},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3464":72746,"_30135":72704,"_5":30485,"_20936":124283,"_27421":124284,"_2948":120093},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3464":72747,"_30135":72704,"_5":30485,"_20936":124286,"_27421":124287,"_2948":124288},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3464":72748,"_30135":72704,"_5":30485,"_20936":124290,"_27421":124291,"_2948":124292},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3464":72749,"_30135":72704,"_20936":124294,"_5":14366,"_27421":72704,"_2948":124295},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3464":72750,"_30135":72704,"_20936":124297,"_5":14366,"_27421":72704,"_2948":124298},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3464":72751,"_30135":72704,"_20936":124300,"_5":14366,"_27421":72704,"_2948":124301},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3464":72752,"_30135":72704,"_20936":124303,"_5":14366,"_27421":72704,"_2948":124304},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3464":72753,"_30135":72704,"_20936":124306,"_5":14366,"_27421":72704,"_2948":124307},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3464":72754,"_30135":72704,"_20936":124309,"_5":14366,"_27421":72704,"_2948":124310},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3464":72755,"_30135":72704,"_20936":124312,"_5":14366,"_27421":72704,"_2948":124313},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3464":72756,"_30135":72704,"_20936":124315,"_5":14366,"_27421":124129,"_2948":124316},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3464":72757,"_30135":72704,"_20936":124318,"_5":14366,"_27421":124129,"_2948":124319},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3464":72758,"_30135":72704,"_20936":124321,"_5":14366,"_27421":124133,"_2948":124322},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3464":72759,"_30135":72704,"_20936":124324,"_5":14366,"_27421":124133,"_2948":124325},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3464":72760,"_30135":72704,"_20936":124327,"_5":14366,"_27421":124137,"_2948":124328},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3464":72761,"_30135":72704,"_20936":124330,"_5":14366,"_27421":124141,"_2948":124331},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3464":72762,"_30135":72704,"_20936":124333,"_5":14366,"_27421":124141,"_2948":124334},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3464":72763,"_30135":72704,"_20936":124336,"_5":14366,"_27421":124141,"_2948":124337},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3464":72764,"_30135":72704,"_20936":124339,"_5":14366,"_27421":124141,"_2948":124340},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3464":72765,"_30135":72704,"_20936":124342,"_5":14366,"_27421":124141,"_2948":124343},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3464":72766,"_30135":72704,"_20936":124345,"_5":14366,"_27421":124145,"_2948":124346},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3464":72767,"_30135":72704,"_20936":124348,"_5":14366,"_27421":124145,"_2948":124349},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3464":72768,"_30135":72704,"_20936":124351,"_5":14366,"_27421":124145,"_2948":124352},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3464":72769,"_30135":72704,"_20936":124354,"_5":14366,"_27421":124145,"_2948":124355},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3464":72770,"_30135":72704,"_20936":124357,"_5":14366,"_27421":124145,"_2948":124358},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3464":72771,"_30135":72704,"_20936":124360,"_5":14366,"_27421":124145,"_2948":124361},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3464":72772,"_30135":72704,"_20936":124363,"_5":14366,"_27421":124149,"_2948":124364},[],"Cambio",{"_3464":72773,"_30135":72704,"_20936":124366,"_5":14366,"_27421":124149,"_2948":124367},[],"A quién afecta",{"_3464":72774,"_30135":72704,"_20936":124369,"_5":14366,"_27421":124149,"_2948":124370},[],"Gravedad",{"_3464":72775,"_30135":72704,"_20936":124372,"_5":14366,"_27421":124149,"_2948":122867},[],{"_3464":72776,"_30135":72704,"_20936":124374,"_5":14366,"_27421":124149,"_2948":124157},[],{"_3464":72777,"_30135":72704,"_20936":124376,"_5":14366,"_27421":124149,"_2948":124377},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3464":72778,"_30135":72704,"_20936":124379,"_5":14366,"_27421":124149,"_2948":124380},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3464":72779,"_30135":72704,"_20936":124382,"_5":14366,"_27421":124149,"_2948":124383},[],"Copiar los datos a los volúmenes nuevos",{"_3464":72780,"_30135":72704,"_20936":124385,"_5":14366,"_27421":124149,"_2948":124161},[],{"_3464":72781,"_30135":72704,"_20936":124387,"_5":14366,"_27421":124149,"_2948":124388},[],"Todas las releases de Helm",{"_3464":72782,"_30135":72704,"_20936":124390,"_5":14366,"_27421":124149,"_2948":124391},[],"Alta: `helm upgrade` falla",{"_3464":72783,"_30135":72704,"_20936":124393,"_5":14366,"_27421":124149,"_2948":124394},[],"Eliminar o renombrar las claves heredadas",{"_3464":72784,"_30135":72704,"_20936":124396,"_5":14366,"_27421":124149,"_2948":124165},[],{"_3464":72785,"_30135":72704,"_20936":124398,"_5":14366,"_27421":124149,"_2948":124399},[],"Todos los despliegues",{"_3464":72786,"_30135":72704,"_20936":124401,"_5":14366,"_27421":124149,"_2948":124402},[],"Alta: sin principal de bootstrap no hay administrador",{"_3464":72787,"_30135":72704,"_20936":124404,"_5":14366,"_27421":124149,"_2948":124405},[],"Configurar `services.authz`",{"_3464":72788,"_30135":72704,"_20936":124407,"_5":14366,"_27421":124149,"_2948":124169},[],{"_3464":72789,"_30135":72704,"_20936":124409,"_5":14366,"_27421":124149,"_2948":124388},[],{"_3464":72790,"_30135":72704,"_20936":124411,"_5":14366,"_27421":124149,"_2948":124412},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3464":72791,"_30135":72704,"_20936":124414,"_5":14366,"_27421":124149,"_2948":124415},[],"Mover JWKS y roles a `services.authz`",{"_3464":72792,"_30135":72704,"_20936":124417,"_5":14366,"_27421":124149,"_2948":124189},[],{"_3464":72793,"_30135":72704,"_20936":124419,"_5":14366,"_27421":124149,"_2948":124420},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3464":72794,"_30135":72704,"_20936":124422,"_5":14366,"_27421":124149,"_2948":124423},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3464":72795,"_30135":72704,"_20936":124425,"_5":14366,"_27421":124149,"_2948":124426},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3464":72796,"_30135":72704,"_20936":124428,"_5":14366,"_27421":124149,"_2948":124193},[],{"_3464":72797,"_30135":72704,"_20936":124430,"_5":14366,"_27421":124149,"_2948":124431},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3464":72798,"_30135":72704,"_20936":124433,"_5":14366,"_27421":124149,"_2948":124434},[],"Alta: el backend ya no arranca con ellos",{"_3464":72799,"_30135":72704,"_20936":124436,"_5":14366,"_27421":124149,"_2948":124437},[],"Pasar a PostgreSQL antes de actualizar",{"_3464":72800,"_30135":72704,"_20936":124439,"_5":14366,"_27421":124149,"_2948":124237},[],{"_3464":72801,"_30135":72704,"_20936":124441,"_5":14366,"_27421":124149,"_2948":124442},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3464":72802,"_30135":72704,"_20936":124444,"_5":14366,"_27421":124149,"_2948":124445},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3464":72803,"_30135":72704,"_20936":124447,"_5":14366,"_27421":124149,"_2948":124448},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3464":72804,"_30135":72704,"_20936":124450,"_5":14366,"_27421":124149,"_2948":124451},[],"Webhooks con referencias a archivos",{"_3464":72805,"_30135":72704,"_20936":124453,"_5":14366,"_27421":124149,"_2948":124454},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3464":72806,"_30135":72704,"_20936":124456,"_5":14366,"_27421":124149,"_2948":124457},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3464":72807,"_30135":72704,"_20936":124459,"_5":14366,"_27421":124149,"_2948":124460},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3464":72808,"_30135":72704,"_20936":124462,"_5":14366,"_27421":124149,"_2948":124173},[],{"_3464":72809,"_30135":72704,"_20936":124464,"_5":14366,"_27421":124149,"_2948":124465},[],"Releases con identidades por servicio o material de claves montado",{"_3464":72810,"_30135":72704,"_20936":124467,"_5":14366,"_27421":124149,"_2948":124468},[],"Media: los servicios no pueden leer sus archivos",{"_3464":72811,"_30135":72704,"_20936":124470,"_5":14366,"_27421":124149,"_2948":124471},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3464":72812,"_30135":72704,"_20936":124473,"_5":14366,"_27421":124149,"_2948":124177},[],{"_3464":72813,"_30135":72704,"_20936":124475,"_5":14366,"_27421":124149,"_2948":124476},[],"Releases que definen `amqp.tls`",{"_3464":72814,"_30135":72704,"_20936":124478,"_5":14366,"_27421":124149,"_2948":124479},[],"Media: los clientes se conectan al puerto equivocado",{"_3464":72815,"_30135":72704,"_20936":124481,"_5":14366,"_27421":124149,"_2948":124482},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3464":72816,"_30135":72704,"_20936":124484,"_5":14366,"_27421":124149,"_2948":124197},[],{"_3464":72817,"_30135":72704,"_20936":124486,"_5":14366,"_27421":124149,"_2948":124487},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3464":72818,"_30135":72704,"_20936":124489,"_5":14366,"_27421":124149,"_2948":124490},[],"Media: las claves de CA quedan sin gestionar",{"_3464":72819,"_30135":72704,"_20936":124492,"_5":14366,"_27421":124149,"_2948":124493},[],"Ejecutar la migración de CA a KMS",{"_3464":72820,"_30135":72704,"_20936":124495,"_5":14366,"_27421":124149,"_2948":124496},[],"Verificación del certificado del receptor",{"_3464":72821,"_30135":72704,"_20936":124498,"_5":14366,"_27421":124149,"_2948":124499},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3464":72822,"_30135":72704,"_20936":124501,"_5":14366,"_27421":124149,"_2948":124502},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3464":72823,"_30135":72704,"_20936":124504,"_5":14366,"_27421":124149,"_2948":124505},[],"Poner `insecure_skip_verify` a `false`",{"_3464":72824,"_30135":72704,"_20936":124507,"_5":14366,"_27421":124149,"_2948":124213},[],{"_3464":72825,"_30135":72704,"_20936":124509,"_5":14366,"_27421":124149,"_2948":124510},[],"Scripts y consolas que editan DMS por API",{"_3464":72826,"_30135":72704,"_20936":124512,"_5":14366,"_27421":124149,"_2948":124513},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3464":72827,"_30135":72704,"_20936":124515,"_5":14366,"_27421":124149,"_2948":124516},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3464":72828,"_30135":72704,"_20936":124518,"_5":14366,"_27421":124149,"_2948":124233},[],{"_3464":72829,"_30135":72704,"_20936":124520,"_5":14366,"_27421":124149,"_2948":124521},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3464":72830,"_30135":72704,"_20936":124523,"_5":14366,"_27421":124149,"_2948":124524},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3464":72831,"_30135":72704,"_20936":124526,"_5":14366,"_27421":124149,"_2948":124527},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3464":72832,"_30135":72704,"_20936":124529,"_5":14366,"_27421":124149,"_2948":124241},[],{"_3464":72833,"_30135":72704,"_20936":124531,"_5":14366,"_27421":124149,"_2948":124532},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3464":72834,"_30135":72704,"_20936":124534,"_5":14366,"_27421":124149,"_2948":124535},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3464":72835,"_30135":72704,"_20936":124537,"_5":14366,"_27421":124149,"_2948":124538},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3464":72836,"_30135":72704,"_20936":124540,"_5":14366,"_27421":124149,"_2948":124229},[],{"_3464":72837,"_30135":72704,"_20936":124542,"_5":14366,"_27421":124149,"_2948":124543},[],"Consumidores que leen el campo `events` del dispositivo",{"_3464":72838,"_30135":72704,"_20936":124545,"_5":14366,"_27421":124149,"_2948":124546},[],"Media: el campo desaparece",{"_3464":72839,"_30135":72704,"_20936":124548,"_5":14366,"_27421":124149,"_2948":124549},[],"Usar los nuevos endpoints de eventos",{"_3464":72840,"_30135":72704,"_20936":124551,"_5":14366,"_27421":124149,"_2948":124249},[],{"_3464":72841,"_30135":72704,"_20936":124553,"_5":14366,"_27421":124149,"_2948":124554},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3464":72842,"_30135":72704,"_20936":124556,"_5":14366,"_27421":124149,"_2948":124557},[],"Media: la migración de la VA aborta",{"_3464":72843,"_30135":72704,"_20936":124559,"_5":14366,"_27421":124149,"_2948":124560},[],"Corregir los roles afectados antes de actualizar",{"_3464":72844,"_30135":72704,"_20936":124562,"_5":14366,"_27421":124149,"_2948":124181},[],{"_3464":72845,"_30135":72704,"_20936":124564,"_5":14366,"_27421":124149,"_2948":124565},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3464":72846,"_30135":72704,"_20936":124567,"_5":14366,"_27421":124149,"_2948":124568},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3464":72847,"_30135":72704,"_20936":124570,"_5":14366,"_27421":124149,"_2948":124571},[],"Actualizar el archivo de values",{"_3464":72848,"_30135":72704,"_20936":124573,"_5":14366,"_27421":124149,"_2948":124221},[],{"_3464":72849,"_30135":72704,"_20936":124575,"_5":14366,"_27421":124149,"_2948":124576},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3464":72850,"_30135":72704,"_20936":124578,"_5":14366,"_27421":124149,"_2948":124579},[],"Baja: prevalece el ID de la URL",{"_3464":72851,"_30135":72704,"_20936":124581,"_5":14366,"_27421":124149,"_2948":124582},[],"Enviar el ID en la URL",{"_3464":72852,"_30135":72704,"_20936":124584,"_5":14366,"_27421":124149,"_2948":124245},[],{"_3464":72853,"_30135":72704,"_20936":124586,"_5":14366,"_27421":124149,"_2948":124587},[],"Clientes que envían un `id` al crear o importar CAs",{"_3464":72854,"_30135":72704,"_20936":124589,"_5":14366,"_27421":124149,"_2948":124590},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3464":72855,"_30135":72704,"_20936":124592,"_5":14366,"_27421":124149,"_2948":124593},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3464":72856,"_30135":72704,"_20936":124595,"_5":14366,"_27421":124149,"_2948":124225},[],{"_3464":72857,"_30135":72704,"_20936":124597,"_5":14366,"_27421":124149,"_2948":124598},[],"Consumidores que comparan el `type` del certificado",{"_3464":72858,"_30135":72704,"_20936":124600,"_5":14366,"_27421":124149,"_2948":124601},[],"Baja: dos valores cambian de nombre",{"_3464":72859,"_30135":72704,"_20936":124603,"_5":14366,"_27421":124149,"_2948":124604},[],"Adaptar los consumidores",{"_3464":72860,"_30135":72704,"_20936":124606,"_5":14366,"_27421":124149,"_2948":124217},[],{"_3464":72861,"_30135":72704,"_20936":124608,"_5":14366,"_27421":124149,"_2948":124609},[],"Cualquier DMS",{"_3464":72862,"_30135":72704,"_20936":124611,"_5":14366,"_27421":124149,"_2948":124612},[],"Baja: solo informativo",{"_3464":72863,"_30135":72704,"_20936":124614,"_5":14366,"_27421":124149,"_2948":124615},[],"Revisar ambos bloques antes de editar",{"_3464":72864,"_30135":72704,"_20936":124617,"_5":14366,"_27421":124156,"_2948":124618},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3464":72865,"_30135":72704,"_20936":124620,"_5":14366,"_27421":124156,"_2948":124621},[],"El paso 4 de la guía de migración copia los datos.",{"_3464":72866,"_30135":72704,"_20936":124623,"_5":14366,"_27421":124160,"_2948":124624},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3464":72867,"_30135":72704,"_20936":124626,"_5":14366,"_27421":124164,"_2948":124627},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3464":72868,"_30135":72704,"_20936":124629,"_5":14366,"_27421":124168,"_2948":124630},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3464":72869,"_30135":72704,"_20936":124632,"_5":14366,"_27421":124172,"_2948":124633},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3464":72870,"_30135":72704,"_20936":124635,"_5":14366,"_27421":124172,"_2948":124636},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3464":72871,"_30135":72704,"_20936":124638,"_5":14366,"_27421":124176,"_2948":124639},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3464":72872,"_30135":72704,"_20936":124641,"_5":14366,"_27421":124180,"_2948":124642},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3464":72873,"_30135":72704,"_20936":124644,"_5":14366,"_27421":124180,"_2948":124645},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3464":72874,"_30135":72704,"_20936":124647,"_5":14366,"_27421":124180,"_2948":124648},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3464":72875,"_30135":72704,"_20936":124650,"_5":14366,"_27421":124180,"_2948":124651},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3464":72876,"_30135":72704,"_20936":124653,"_5":14366,"_27421":124180,"_2948":124654},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3464":72877,"_30135":72704,"_20936":124656,"_5":14366,"_27421":124180,"_2948":124657},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3464":72878,"_30135":72704,"_20936":124659,"_5":14366,"_27421":124188,"_2948":124660},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3464":72879,"_30135":72704,"_20936":124662,"_5":14366,"_27421":124188,"_2948":124663},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3464":72880,"_30135":72704,"_20936":124665,"_5":14366,"_27421":124188,"_2948":124666},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3464":72881,"_30135":72704,"_20936":124668,"_5":14366,"_27421":124188,"_2948":124669},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3464":72882,"_30135":72704,"_20936":124671,"_5":14366,"_27421":124188,"_2948":124672},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3464":72883,"_30135":72704,"_20936":124674,"_5":14366,"_27421":124192,"_2948":124675},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3464":72884,"_30135":72704,"_20936":124677,"_5":14366,"_27421":124196,"_2948":124678},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3464":72885,"_30135":72704,"_20936":124680,"_5":14366,"_27421":124196,"_2948":124681},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3464":72886,"_30135":72704,"_20936":124683,"_5":14366,"_27421":124196,"_2948":124684},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3464":72887,"_30135":72704,"_20936":124686,"_5":14366,"_27421":124196,"_2948":124687},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3464":72888,"_30135":72704,"_20936":124689,"_5":14366,"_27421":124196,"_2948":124690},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3464":72889,"_30135":72704,"_20936":124692,"_5":14366,"_27421":124196,"_2948":124693},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3464":72890,"_30135":72704,"_20936":124695,"_5":14366,"_27421":124196,"_2948":124696},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3464":72891,"_30135":72704,"_20936":124698,"_5":14366,"_27421":124196,"_2948":124699},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3464":72892,"_30135":72704,"_20936":124701,"_5":14366,"_27421":124200,"_2948":124702},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3464":72893,"_30135":72704,"_20936":124704,"_5":14366,"_27421":124208,"_2948":124705},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3464":72894,"_30135":72704,"_20936":124707,"_5":14366,"_27421":124208,"_2948":124708},[],"Campo en 3.8.0",{"_3464":72895,"_30135":72704,"_20936":124710,"_5":14366,"_27421":124208,"_2948":124711},[],"Campo en 4.0.0",{"_3464":72896,"_30135":72704,"_20936":124713,"_5":14366,"_27421":124208,"_2948":57977},[],{"_3464":72897,"_30135":72704,"_20936":124715,"_5":14366,"_27421":124208,"_2948":124716},[],"`insecure_skip_verify` (con el valor negado)",{"_3464":72898,"_30135":72704,"_20936":124718,"_5":14366,"_27421":124208,"_2948":57983},[],{"_3464":72899,"_30135":72704,"_20936":124720,"_5":14366,"_27421":124208,"_2948":57986},[],{"_3464":72900,"_30135":72704,"_20936":124722,"_5":14366,"_27421":124208,"_2948":57989},[],{"_3464":72901,"_30135":72704,"_20936":124724,"_5":14366,"_27421":124208,"_2948":57992},[],{"_3464":72902,"_30135":72704,"_20936":124726,"_5":14366,"_27421":124208,"_2948":57995},[],{"_3464":72903,"_30135":72704,"_20936":124728,"_5":14366,"_27421":124208,"_2948":57998},[],{"_3464":72904,"_30135":72704,"_20936":124730,"_5":14366,"_27421":124208,"_2948":124731},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3464":72905,"_30135":72704,"_20936":124733,"_5":14366,"_27421":124208,"_2948":124734},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3464":72906,"_30135":72704,"_20936":124736,"_5":14366,"_27421":124208,"_2948":124737},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3464":72907,"_30135":72704,"_20936":124739,"_5":14366,"_27421":124212,"_2948":124740},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3464":72908,"_30135":72704,"_20936":124742,"_5":14366,"_27421":124212,"_2948":124743},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3464":72909,"_30135":72704,"_20936":124745,"_5":14366,"_27421":124212,"_2948":124746},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3464":72910,"_30135":72704,"_20936":124748,"_5":14366,"_27421":124216,"_2948":124749},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3464":72911,"_30135":72704,"_20936":124751,"_5":14366,"_27421":124220,"_2948":124752},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3464":72912,"_30135":72704,"_20936":124754,"_5":14366,"_27421":124224,"_2948":124755},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3464":72913,"_30135":72704,"_20936":124757,"_5":14366,"_27421":124228,"_2948":124758},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3464":72914,"_30135":72704,"_20936":124760,"_5":14366,"_27421":124228,"_2948":124761},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3464":72915,"_30135":72704,"_20936":124763,"_5":14366,"_27421":124228,"_2948":124764},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3464":72916,"_30135":72704,"_20936":124766,"_5":14366,"_27421":124228,"_2948":124767},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3464":72917,"_30135":72704,"_20936":124769,"_5":14366,"_27421":124232,"_2948":124770},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3464":72918,"_30135":72704,"_20936":124772,"_5":14366,"_27421":124236,"_2948":124773},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3464":72919,"_30135":72704,"_20936":124775,"_5":14366,"_27421":124236,"_2948":124776},[],"Ruta",{"_3464":72920,"_30135":72704,"_20936":124778,"_5":14366,"_27421":124236,"_2948":117332},[],{"_3464":72921,"_30135":72704,"_20936":124780,"_5":14366,"_27421":124236,"_2948":58051},[],{"_3464":72922,"_30135":72704,"_20936":124782,"_5":14366,"_27421":124236,"_2948":124783},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3464":72923,"_30135":72704,"_20936":124785,"_5":14366,"_27421":124236,"_2948":58057},[],{"_3464":72924,"_30135":72704,"_20936":124787,"_5":14366,"_27421":124236,"_2948":124788},[],"Lee los ajustes de una CA.",{"_3464":72925,"_30135":72704,"_20936":124790,"_5":14366,"_27421":124236,"_2948":58063},[],{"_3464":72926,"_30135":72704,"_20936":124792,"_5":14366,"_27421":124236,"_2948":124793},[],"Sustituye los `crl_options`.",{"_3464":72927,"_30135":72704,"_20936":124795,"_5":14366,"_27421":124236,"_2948":124796},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3464":72928,"_30135":72704,"_20936":124798,"_5":14366,"_27421":124236,"_2948":124799},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3464":72929,"_30135":72704,"_20936":124801,"_5":14366,"_27421":124236,"_2948":124802},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3464":72930,"_30135":72704,"_20936":124804,"_5":14366,"_27421":124236,"_2948":124805},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3464":72931,"_30135":72704,"_20936":124807,"_5":14366,"_27421":124236,"_2948":124808},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3464":72932,"_30135":72704,"_20936":124810,"_5":14366,"_27421":124236,"_2948":124811},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3464":72933,"_30135":72704,"_20936":124813,"_5":14366,"_27421":124236,"_2948":124814},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3464":72934,"_30135":72704,"_20936":124816,"_5":14366,"_27421":124236,"_2948":124817},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3464":72935,"_30135":72704,"_20936":124819,"_5":14366,"_27421":124236,"_2948":124820},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3464":72936,"_30135":72704,"_20936":124822,"_5":14366,"_27421":124236,"_2948":124823},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3464":72937,"_30135":72704,"_20936":124825,"_5":14366,"_27421":124236,"_2948":124826},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3464":72938,"_30135":72704,"_20936":124828,"_5":14366,"_27421":124240,"_2948":124829},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3464":72939,"_30135":72704,"_20936":124831,"_5":14366,"_27421":124244,"_2948":124832},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3464":72940,"_30135":72704,"_20936":124834,"_5":14366,"_27421":124248,"_2948":124835},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3464":72941,"_30135":72704,"_20936":124837,"_5":14366,"_27421":124252,"_2948":124838},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3464":72942,"_30135":72704,"_20936":124840,"_5":14366,"_27421":124256,"_2948":124841},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3464":72943,"_30135":72704,"_20936":124843,"_5":14366,"_27421":124256,"_2948":124844},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3464":72944,"_30135":72704,"_20936":124846,"_5":14366,"_27421":124256,"_2948":124847},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3464":72945,"_30135":72704,"_20936":124849,"_5":14366,"_27421":124256,"_2948":124850},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3464":72946,"_30135":72704,"_20936":124852,"_5":14366,"_27421":124256,"_2948":124853},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3464":72947,"_30135":72704,"_20936":124855,"_5":14366,"_27421":124256,"_2948":124856},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3464":72948,"_30135":72704,"_20936":124858,"_5":14366,"_27421":124260,"_2948":124859},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3464":72949,"_30135":72704,"_20936":124861,"_5":14366,"_27421":124260,"_2948":124862},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3464":72950,"_30135":72704,"_20936":124864,"_5":14366,"_27421":124260,"_2948":124865},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3464":72951,"_30135":72704,"_20936":124867,"_5":14366,"_27421":124260,"_2948":124868},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3464":72952,"_30135":72704,"_20936":124870,"_5":14366,"_27421":124260,"_2948":124871},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3464":72953,"_30135":72704,"_20936":124873,"_5":14366,"_27421":124264,"_2948":124874},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3464":72954,"_30135":72704,"_20936":124876,"_5":14366,"_27421":124264,"_2948":124877},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3464":72955,"_30135":72704,"_20936":124879,"_5":14366,"_27421":124264,"_2948":124880},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3464":72956,"_30135":72704,"_20936":124882,"_5":14366,"_27421":124264,"_2948":124883},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3464":72957,"_30135":72704,"_20936":124885,"_5":14366,"_27421":124264,"_2948":124886},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3464":72958,"_30135":72704,"_20936":124888,"_5":14366,"_27421":124264,"_2948":124889},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3464":72959,"_30135":72704,"_20936":124891,"_5":14366,"_27421":124264,"_2948":124892},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3464":72960,"_30135":72704,"_20936":124894,"_5":14366,"_27421":124264,"_2948":124895},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3464":72961,"_30135":72704,"_20936":124897,"_5":14366,"_27421":124264,"_2948":124898},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3464":72962,"_30135":72704,"_20936":124900,"_5":14366,"_27421":124264,"_2948":124901},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3464":72963,"_30135":72704,"_20936":124903,"_5":14366,"_27421":124264,"_2948":124904},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3464":72964,"_30135":72704,"_20936":124906,"_5":14366,"_27421":124264,"_2948":124907},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3464":72965,"_30135":72704,"_20936":124909,"_5":14366,"_27421":124268,"_2948":124910},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3464":72966,"_30135":72704,"_20936":124912,"_5":14366,"_27421":124268,"_2948":124913},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3464":72967,"_30135":72704,"_20936":124915,"_5":14366,"_27421":124272,"_2948":124916},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3464":72968,"_30135":72704,"_20936":124918,"_5":14366,"_27421":124272,"_2948":124919},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3464":72969,"_30135":72704,"_20936":124921,"_5":14366,"_27421":124272,"_2948":124922},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3464":72970,"_30135":72704,"_20936":124924,"_5":14366,"_27421":124272,"_2948":124925},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3464":72971,"_30135":72704,"_20936":124927,"_5":14366,"_27421":124272,"_2948":124928},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3464":72972,"_30135":72704,"_20936":124930,"_5":14366,"_27421":124272,"_2948":124931},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3464":72973,"_30135":72704,"_20936":124933,"_5":14366,"_27421":124272,"_2948":124934},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3464":72974,"_30135":72704,"_20936":124936,"_5":14366,"_27421":124272,"_2948":124937},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3464":72975,"_30135":72704,"_20936":124939,"_5":14366,"_27421":124272,"_2948":124940},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3464":72976,"_30135":72704,"_20936":124942,"_5":14366,"_27421":124272,"_2948":124943},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3464":72977,"_30135":72704,"_20936":124945,"_5":14366,"_27421":124272,"_2948":124946},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3464":72978,"_30135":72704,"_20936":124948,"_5":14366,"_27421":124276,"_2948":124949},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3464":72979,"_30135":72704,"_20936":124951,"_5":14366,"_27421":124276,"_2948":124952},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3464":72980,"_30135":72704,"_20936":124954,"_5":14366,"_27421":124280,"_2948":124955},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3464":72981,"_30135":72704,"_20936":124957,"_5":14366,"_27421":124280,"_2948":124958},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3464":72982,"_30135":72704,"_20936":124960,"_5":14366,"_27421":124280,"_2948":124961},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3464":72983,"_30135":72704,"_20936":124963,"_5":14366,"_27421":124280,"_2948":124964},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3464":72984,"_30135":72704,"_20936":124966,"_5":14366,"_27421":124280,"_2948":124967},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3464":72985,"_30135":72704,"_20936":124969,"_5":14366,"_27421":124280,"_2948":124970},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3464":72986,"_30135":72704,"_20936":124972,"_5":14366,"_27421":124280,"_2948":124973},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3464":72987,"_30135":72704,"_20936":124975,"_5":14366,"_27421":124280,"_2948":124976},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3464":72988,"_30135":72704,"_20936":124978,"_5":14366,"_27421":124284,"_2948":124979},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3464":72989,"_30135":72704,"_20936":124981,"_5":14366,"_27421":124284,"_2948":124982},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3464":72990,"_30135":72704,"_20936":124984,"_5":14366,"_27421":124284,"_2948":124985},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3464":72991,"_30135":72704,"_20936":124987,"_5":14366,"_27421":124284,"_2948":124988},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3464":72992,"_30135":72704,"_20936":124990,"_5":14366,"_27421":124284,"_2948":124991},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3464":72993,"_30135":72704,"_20936":124993,"_5":14366,"_27421":124284,"_2948":124994},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3464":72994,"_30135":72704,"_20936":124996,"_5":14366,"_27421":124284,"_2948":124997},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3464":72995,"_30135":72704,"_20936":124999,"_5":14366,"_27421":124284,"_2948":125000},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3464":72996,"_30135":72704,"_20936":125002,"_5":14366,"_27421":124284,"_2948":125003},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3464":72997,"_30135":72704,"_20936":125005,"_5":14366,"_27421":124284,"_2948":125006},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3464":72998,"_30135":72704,"_20936":125008,"_5":14366,"_27421":124284,"_2948":125009},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3464":72999,"_30135":72704,"_20936":125011,"_5":14366,"_27421":124287,"_2948":125012},[],"Tras la actualización, comprueba en este orden:",{"_3464":73000,"_30135":72704,"_20936":125014,"_5":14366,"_27421":124287,"_2948":125015},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3464":73001,"_30135":72704,"_20936":125017,"_5":14366,"_27421":124287,"_2948":125018},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3464":73002,"_30135":72704,"_20936":125020,"_5":14366,"_27421":124287,"_2948":125021},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3464":73003,"_30135":72704,"_20936":125023,"_5":14366,"_27421":124287,"_2948":125024},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3464":73004,"_30135":72704,"_20936":125026,"_5":14366,"_27421":124287,"_2948":125027},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3464":73005,"_30135":72704,"_20936":125029,"_5":14366,"_27421":124287,"_2948":125030},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3464":73006,"_30135":72704,"_20936":125032,"_5":14366,"_27421":124287,"_2948":125033},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3464":73007,"_30135":72704,"_20936":125035,"_5":14366,"_27421":124287,"_2948":125036},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3464":73008,"_30135":72704,"_20936":125038,"_5":14366,"_27421":124287,"_2948":125039},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3464":73009,"_30135":72704,"_20936":125041,"_5":14366,"_27421":124287,"_2948":125042},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3464":73010,"_30135":72704,"_20936":125044,"_5":14366,"_27421":124287,"_2948":125045},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3464":73011,"_30135":72704,"_20936":125047,"_5":14366,"_27421":124287,"_2948":125048},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3464":73012,"_30135":72704,"_20936":125050,"_5":14366,"_27421":124287,"_2948":125051},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3464":73013,"_30135":72704,"_20936":125053,"_5":14366,"_27421":124287,"_2948":125054},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3464":73014,"_30135":72704,"_20936":125056,"_5":14366,"_27421":124287,"_2948":125057},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3464":73015,"_30135":72704,"_20936":125059,"_5":14366,"_27421":124291,"_2948":125060},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3464":73016,"_30135":72704,"_20936":125062,"_5":14366,"_27421":124291,"_2948":125063},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3464":73017,"_30135":72704,"_20936":125065,"_5":14366,"_27421":124291,"_2948":125066},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3464":73018,"_30135":72704,"_20936":125068,"_5":14366,"_27421":124291,"_2948":125069},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3464":73019,"_30135":72704,"_20936":125071,"_5":14366,"_27421":124291,"_2948":125072},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58348":125074,"_58350":125075,"_58352":125076,"_58354":125077,"_18137":2983,"_70085":2983},"spanish",[2948,30135,5,27421],{"_2948":25002,"_30135":25002,"_5":25002,"_27421":25002},{"_2948":125078,"_30135":128009,"_5":130940,"_27421":133871},{"_4644":125079,"_58358":125080,"_5":25002},{"_14442":7566,"_14823":11309,"_14842":5961,"_29138":3443,"_14829":6543,"_19859":6176,"_14463":15136,"_14470":4403,"_29080":20344,"_29489":16857,"_29510":4764,"_29114":7020,"_34489":12256,"_29217":20339,"_29554":9852,"_34496":22845,"_34499":5813,"_34502":7003,"_34505":18151,"_29961":14323,"_34510":9372,"_34512":7283,"_29991":5132,"_14838":15800,"_34516":7493,"_34519":5822,"_34521":11190,"_29538":10869,"_29956":4218,"_30004":5843,"_34526":6484,"_34528":7596,"_34530":3947,"_29234":6364,"_34533":3337,"_34535":3807,"_34537":7817,"_34539":7129,"_34541":5051,"_29151":4687,"_34544":4616,"_34546":4385,"_29145":8801,"_29575":11075,"_34550":3588,"_34552":10763,"_34555":5253,"_29191":14404,"_34559":4965,"_29071":18158,"_34562":7479,"_29119":7632,"_34565":11747,"_34567":5997,"_34570":3421,"_14832":3238,"_34573":4707,"_34575":4388,"_34578":4649,"_34580":6574,"_30194":22803,"_34583":7659,"_34585":4955,"_19862":3335,"_34588":7046,"_345