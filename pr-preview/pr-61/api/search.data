":49068,"_27386":49069,"_2933":49070},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3450":20,"_30100":15,"_5":30450,"_20891":49072,"_27386":49073,"_2933":49074},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3450":21,"_30100":15,"_5":30450,"_20891":49076,"_27386":49077,"_2933":49078},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3450":22,"_30100":15,"_5":30450,"_20891":49080,"_27386":49081,"_2933":49082},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3450":23,"_30100":15,"_5":30450,"_20891":49084,"_27386":49085,"_2933":49086},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#next-step","Next step",{"_3450":24,"_30100":15,"_20891":49088,"_5":14349,"_27386":15,"_2933":49089},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3450":25,"_30100":15,"_20891":49091,"_5":14349,"_27386":49061,"_2933":49092},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3450":26,"_30100":15,"_20891":49094,"_5":14349,"_27386":49061,"_2933":49095},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3450":27,"_30100":15,"_20891":49097,"_5":14349,"_27386":49061,"_2933":49098},[],"A security group allowing the necessary endpoints.",{"_3450":28,"_30100":15,"_20891":49100,"_5":14349,"_27386":49065,"_2933":49101},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3450":29,"_30100":15,"_20891":49103,"_5":14349,"_27386":49065,"_2933":49104},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3450":30,"_30100":15,"_20891":49106,"_5":14349,"_27386":49065,"_2933":49107},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3450":31,"_30100":15,"_20891":49109,"_5":14349,"_27386":49069,"_2933":49110},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3450":32,"_30100":15,"_20891":49112,"_5":14349,"_27386":49073,"_2933":49113},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3450":33,"_30100":15,"_20891":49115,"_5":14349,"_27386":49077,"_2933":49116},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3450":34,"_30100":15,"_20891":49118,"_5":14349,"_27386":49081,"_2933":49119},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3450":35,"_30100":15,"_20891":49121,"_5":14349,"_27386":49085,"_2933":49122},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3450":36,"_30100":36,"_5":14701,"_2933":49124,"_30453":49125,"_20891":49126,"_27386":36},"Deploy Lamassu",[49052,49053],[],{"_3450":37,"_30100":36,"_20891":49128,"_5":14349,"_27386":36,"_2933":49129},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3450":38,"_30100":36,"_5":30450,"_20891":49131,"_27386":49132,"_2933":49133},[],"/docs/pr-preview/pr-61/deployment/overview#choose-a-model","Choose a model",{"_3450":39,"_30100":36,"_5":30450,"_20891":49135,"_27386":49136,"_2933":49137},[],"/docs/pr-preview/pr-61/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3450":40,"_30100":36,"_5":30450,"_20891":49139,"_27386":49140,"_2933":49141},[],"/docs/pr-preview/pr-61/deployment/overview#after-deployment","After deployment",{"_3450":41,"_30100":36,"_20891":49143,"_5":14349,"_27386":36,"_2933":49144},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3450":42,"_30100":36,"_20891":49146,"_5":14349,"_27386":49132,"_2933":49147},[],"Model",{"_3450":43,"_30100":36,"_20891":49149,"_5":14349,"_27386":49132,"_2933":49150},[],"Recommended for",{"_3450":44,"_30100":36,"_20891":49152,"_5":14349,"_27386":49132,"_2933":49153},[],"Who operates the infrastructure",{"_3450":45,"_30100":36,"_20891":49155,"_5":14349,"_27386":49132,"_2933":49156},[],"Starting point",{"_3450":46,"_30100":36,"_20891":49158,"_5":14349,"_27386":49132,"_2933":49159},[],"Kubernetes self-managed",{"_3450":47,"_30100":36,"_20891":49161,"_5":14349,"_27386":49132,"_2933":49162},[],"Production, regulated environments and custom deployments",{"_3450":48,"_30100":36,"_20891":49164,"_5":14349,"_27386":49132,"_2933":49165},[],"Your team",{"_3450":49,"_30100":36,"_20891":49167,"_5":14349,"_27386":49132,"_2933":49168},[],"Helm or Fastlane",{"_3450":50,"_30100":36,"_20891":49170,"_5":14349,"_27386":49132,"_2933":49171},[],"AWS Marketplace",{"_3450":51,"_30100":36,"_20891":49173,"_5":14349,"_27386":49132,"_2933":49174},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3450":52,"_30100":36,"_20891":49176,"_5":14349,"_27386":49132,"_2933":49165},[],{"_3450":53,"_30100":36,"_20891":49178,"_5":14349,"_27386":49132,"_2933":49179},[],"Preconfigured image on EC2",{"_3450":54,"_30100":36,"_20891":49181,"_5":14349,"_27386":49132,"_2933":49182},[],"SaaS",{"_3450":55,"_30100":36,"_20891":49184,"_5":14349,"_27386":49132,"_2933":49185},[],"Teams that want to use the platform without operating it",{"_3450":56,"_30100":36,"_20891":49187,"_5":14349,"_27386":49132,"_2933":49188},[],"Lamassu",{"_3450":57,"_30100":36,"_20891":49190,"_5":14349,"_27386":49132,"_2933":49191},[],"Managed subscription",{"_3450":58,"_30100":36,"_20891":49193,"_5":14349,"_27386":49132,"_2933":49194},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3450":59,"_30100":36,"_20891":49196,"_5":14349,"_27386":49132,"_2933":49197},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3450":60,"_30100":36,"_20891":49199,"_5":14349,"_27386":49132,"_2933":49200},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3450":61,"_30100":36,"_20891":49202,"_5":14349,"_27386":49136,"_2933":49203},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3450":62,"_30100":36,"_20891":49205,"_5":14349,"_27386":49140,"_2933":49206},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3450":63,"_30100":63,"_5":14701,"_2933":49208,"_30453":49209,"_20891":49210,"_27386":63},"Use Lamassu as SaaS",[49052,49053,49054],[],{"_3450":64,"_30100":63,"_20891":49212,"_5":14349,"_27386":63,"_2933":49213},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3450":65,"_30100":63,"_5":30450,"_20891":49215,"_27386":49216,"_2933":49217},[],"/docs/pr-preview/pr-61/deployment/saas#what-the-service-manages","What the service manages",{"_3450":66,"_30100":63,"_5":30450,"_20891":49219,"_27386":49220,"_2933":49221},[],"/docs/pr-preview/pr-61/deployment/saas#plans","Plans",{"_3450":67,"_30100":63,"_5":30450,"_20891":49223,"_27386":49224,"_2933":49225},[],"/docs/pr-preview/pr-61/deployment/saas#request-access","Request access",{"_3450":68,"_30100":63,"_20891":49227,"_5":14349,"_27386":63,"_2933":49228},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3450":69,"_30100":63,"_20891":49230,"_5":14349,"_27386":49216,"_2933":49231},[],"Platform availability and maintenance.",{"_3450":70,"_30100":63,"_20891":49233,"_5":14349,"_27386":49216,"_2933":49234},[],"Automatic backups.",{"_3450":71,"_30100":63,"_20891":49236,"_5":14349,"_27386":49216,"_2933":49237},[],"Version upgrades.",{"_3450":72,"_30100":63,"_20891":49239,"_5":14349,"_27386":49216,"_2933":49240},[],"Technical support and SLA according to your plan.",{"_3450":73,"_30100":63,"_20891":49242,"_5":14349,"_27386":49220,"_2933":49243},[],"Plan",{"_3450":74,"_30100":63,"_20891":49245,"_5":14349,"_27386":49220,"_2933":49246},[],"Devices",{"_3450":75,"_30100":63,"_20891":49248,"_5":14349,"_27386":49220,"_2933":49249},[],"Support",{"_3450":76,"_30100":63,"_20891":49251,"_5":14349,"_27386":49220,"_2933":49252},[],"SLA",{"_3450":77,"_30100":63,"_20891":49254,"_5":14349,"_27386":49220,"_2933":49255},[],"Starter",{"_3450":78,"_30100":63,"_20891":49257,"_5":14349,"_27386":49220,"_2933":49258},[],"Up to 1,000",{"_3450":79,"_30100":63,"_20891":49260,"_5":14349,"_27386":49220,"_2933":49261},[],"Email",{"_3450":80,"_30100":63,"_20891":49263,"_5":14349,"_27386":49220,"_2933":49264},[],"99.5 %",{"_3450":81,"_30100":63,"_20891":49266,"_5":14349,"_27386":49220,"_2933":49267},[],"Professional",{"_3450":82,"_30100":63,"_20891":49269,"_5":14349,"_27386":49220,"_2933":49270},[],"Up to 10,000",{"_3450":83,"_30100":63,"_20891":49272,"_5":14349,"_27386":49220,"_2933":49273},[],"Email and chat",{"_3450":84,"_30100":63,"_20891":49275,"_5":14349,"_27386":49220,"_2933":49276},[],"99.9 %",{"_3450":85,"_30100":63,"_20891":49278,"_5":14349,"_27386":49220,"_2933":49279},[],"Enterprise",{"_3450":86,"_30100":63,"_20891":49281,"_5":14349,"_27386":49220,"_2933":49282},[],"Unlimited",{"_3450":87,"_30100":63,"_20891":49284,"_5":14349,"_27386":49220,"_2933":49285},[],"Dedicated",{"_3450":88,"_30100":63,"_20891":49287,"_5":14349,"_27386":49220,"_2933":49288},[],"99.99 %",{"_3450":89,"_30100":63,"_20891":49290,"_5":14349,"_27386":49224,"_2933":49291},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3450":90,"_30100":63,"_20891":49293,"_5":14349,"_27386":49224,"_2933":49294},[],"When you receive your instance's credentials, continue with Get started.",{"_3450":91,"_30100":91,"_5":14701,"_2933":49296,"_30453":49297,"_20891":49298,"_27386":91},"Fastlane",[49052,49053,49159],[],{"_3450":92,"_30100":91,"_20891":49300,"_5":14349,"_27386":91,"_2933":49301},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3450":93,"_30100":91,"_5":30450,"_20891":49303,"_27386":49304,"_2933":49305},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3450":94,"_30100":91,"_5":30450,"_20891":49307,"_27386":49308,"_2933":49309},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3450":95,"_30100":91,"_5":30450,"_20891":49311,"_27386":49312,"_2933":49062},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#before-you-begin",{"_3450":96,"_30100":91,"_5":30450,"_20891":49314,"_27386":49315,"_2933":49316},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3450":97,"_30100":91,"_5":30450,"_20891":49318,"_27386":49319,"_2933":49320},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3450":98,"_30100":91,"_5":30450,"_20891":49322,"_27386":49323,"_2933":49324},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3450":99,"_30100":91,"_5":30450,"_20891":49326,"_27386":49327,"_2933":49328},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3450":100,"_30100":91,"_5":30450,"_20891":49330,"_27386":49331,"_2933":49332},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3450":101,"_30100":91,"_5":30450,"_20891":49334,"_27386":49335,"_2933":49336},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3450":102,"_30100":91,"_5":30450,"_20891":49338,"_27386":49339,"_2933":49340},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3450":103,"_30100":91,"_5":30450,"_20891":49342,"_27386":49343,"_2933":49344},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3450":104,"_30100":91,"_20891":49346,"_5":14349,"_27386":49304,"_2933":49347},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3450":105,"_30100":91,"_20891":49349,"_5":14349,"_27386":49304,"_2933":49350},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3450":106,"_30100":91,"_20891":49352,"_5":14349,"_27386":49308,"_2933":49353},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3450":107,"_30100":91,"_20891":49355,"_5":14349,"_27386":49308,"_2933":49356},[],"Fastlane installs or configures",{"_3450":108,"_30100":91,"_20891":49358,"_5":14349,"_27386":49308,"_2933":49359},[],"You still provide",{"_3450":109,"_30100":91,"_20891":49361,"_5":14349,"_27386":49308,"_2933":49362},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3450":110,"_30100":91,"_20891":49364,"_5":14349,"_27386":49308,"_2933":49365},[],"The Kubernetes cluster, nodes and persistent storage",{"_3450":111,"_30100":91,"_20891":49367,"_5":14349,"_27386":49308,"_2933":49368},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3450":112,"_30100":91,"_20891":49370,"_5":14349,"_27386":49308,"_2933":49371},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3450":113,"_30100":91,"_20891":49373,"_5":14349,"_27386":49308,"_2933":49374},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3450":114,"_30100":91,"_20891":49376,"_5":14349,"_27386":49308,"_2933":49377},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3450":115,"_30100":91,"_20891":49379,"_5":14349,"_27386":49308,"_2933":49380},[],"Optional observability and lab HSM components",{"_3450":116,"_30100":91,"_20891":49382,"_5":14349,"_27386":49308,"_2933":49383},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3450":117,"_30100":91,"_20891":49385,"_5":14349,"_27386":49308,"_2933":49386},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3450":118,"_30100":91,"_20891":49388,"_5":14349,"_27386":49312,"_2933":49389},[],"You need:",{"_3450":119,"_30100":91,"_20891":49391,"_5":14349,"_27386":49312,"_2933":49392},[],"an existing Kubernetes cluster",{"_3450":120,"_30100":91,"_20891":49394,"_5":14349,"_27386":49312,"_2933":49395},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3450":121,"_30100":91,"_20891":49397,"_5":14349,"_27386":49312,"_2933":49398},[],"`yq`",{"_3450":122,"_30100":91,"_20891":49400,"_5":14349,"_27386":49312,"_2933":23617},[],{"_3450":123,"_30100":91,"_20891":49402,"_5":14349,"_27386":49312,"_2933":49403},[],"`jq` only when using `--sample-data` or `--development`",{"_3450":124,"_30100":91,"_20891":49405,"_5":14349,"_27386":49312,"_2933":49406},[],"`ssh-keygen` only when using `--with-hsm`",{"_3450":125,"_30100":91,"_20891":49408,"_5":14349,"_27386":49312,"_2933":49409},[],"free external ports 80 and 443 on a single-node K3s host",{"_3450":126,"_30100":91,"_20891":49411,"_5":14349,"_27386":49312,"_2933":49412},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3450":127,"_30100":91,"_20891":49414,"_5":14349,"_27386":49312,"_2933":49415},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3450":128,"_30100":91,"_20891":49417,"_5":14349,"_27386":49315,"_2933":49418},[],"Run the script from a clone of the Helm repository:",{"_3450":129,"_30100":91,"_20891":49420,"_5":14349,"_27386":49315,"_2933":49421},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3450":130,"_30100":91,"_20891":49423,"_5":14349,"_27386":49319,"_2933":49424},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3450":131,"_30100":91,"_20891":49426,"_5":14349,"_27386":49319,"_2933":49427},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3450":132,"_30100":91,"_20891":49429,"_5":14349,"_27386":49319,"_2933":49430},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3450":133,"_30100":91,"_20891":49432,"_5":14349,"_27386":49319,"_2933":49433},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3450":134,"_30100":91,"_20891":49435,"_5":14349,"_27386":49323,"_2933":49436},[],"Option",{"_3450":135,"_30100":91,"_20891":49438,"_5":14349,"_27386":49323,"_2933":49439},[],"Default",{"_3450":136,"_30100":91,"_20891":49441,"_5":14349,"_27386":49323,"_2933":49442},[],"Purpose",{"_3450":137,"_30100":91,"_20891":49444,"_5":14349,"_27386":49323,"_2933":49445},[],"`-h`, `--help`",{"_3450":138,"_30100":91,"_20891":49447,"_5":14349,"_27386":49323,"_2933":49448},[],"—",{"_3450":139,"_30100":91,"_20891":49450,"_5":14349,"_27386":49323,"_2933":49451},[],"Show help",{"_3450":140,"_30100":91,"_20891":49453,"_5":14349,"_27386":49323,"_2933":49454},[],"`-c`, `--context`",{"_3450":141,"_30100":91,"_20891":49456,"_5":14349,"_27386":49323,"_2933":49457},[],"current context",{"_3450":142,"_30100":91,"_20891":49459,"_5":14349,"_27386":49323,"_2933":49460},[],"Select the kubeconfig context for kubectl and Helm",{"_3450":143,"_30100":91,"_20891":49462,"_5":14349,"_27386":49323,"_2933":49463},[],"`-n`, `--non-interactive`",{"_3450":144,"_30100":91,"_20891":49465,"_5":14349,"_27386":49323,"_2933":6512},[],{"_3450":145,"_30100":91,"_20891":49467,"_5":14349,"_27386":49323,"_2933":49468},[],"Skip prompts and generate dependency credentials",{"_3450":146,"_30100":91,"_20891":49470,"_5":14349,"_27386":49323,"_2933":49471},[],"`-ns`, `--namespace`",{"_3450":147,"_30100":91,"_20891":49473,"_5":14349,"_27386":49323,"_2933":49474},[],"`lamassu-dev`",{"_3450":148,"_30100":91,"_20891":49476,"_5":14349,"_27386":49323,"_2933":49477},[],"Namespace for the installation",{"_3450":149,"_30100":91,"_20891":49479,"_5":14349,"_27386":49323,"_2933":49480},[],"`-d`, `--domain`",{"_3450":150,"_30100":91,"_20891":49482,"_5":14349,"_27386":49323,"_2933":49483},[],"`dev.lamassu.io`",{"_3450":151,"_30100":91,"_20891":49485,"_5":14349,"_27386":49323,"_2933":49486},[],"Domain used by the UI, OIDC and certificate",{"_3450":152,"_30100":91,"_20891":49488,"_5":14349,"_27386":49323,"_2933":49489},[],"`-v`, `--version`",{"_3450":153,"_30100":91,"_20891":49491,"_5":14349,"_27386":49323,"_2933":15047},[],{"_3450":154,"_30100":91,"_20891":49493,"_5":14349,"_27386":49323,"_2933":49494},[],"Lamassu chart version",{"_3450":155,"_30100":91,"_20891":49496,"_5":14349,"_27386":49323,"_2933":49497},[],"`--https-port`",{"_3450":156,"_30100":91,"_20891":49499,"_5":14349,"_27386":49323,"_2933":49500},[],"`443`",{"_3450":157,"_30100":91,"_20891":49502,"_5":14349,"_27386":49323,"_2933":49503},[],"Gateway HTTPS listener port",{"_3450":158,"_30100":91,"_20891":49505,"_5":14349,"_27386":49323,"_2933":49506},[],"`--http-port`",{"_3450":159,"_30100":91,"_20891":49508,"_5":14349,"_27386":49323,"_2933":49509},[],"`80`",{"_3450":160,"_30100":91,"_20891":49511,"_5":14349,"_27386":49323,"_2933":49512},[],"Gateway HTTP listener port",{"_3450":161,"_30100":91,"_20891":49514,"_5":14349,"_27386":49323,"_2933":49515},[],"`--tls-crt`",{"_3450":162,"_30100":91,"_20891":49517,"_5":14349,"_27386":49323,"_2933":49448},[],{"_3450":163,"_30100":91,"_20891":49519,"_5":14349,"_27386":49323,"_2933":49520},[],"PEM certificate for downstream TLS",{"_3450":164,"_30100":91,"_20891":49522,"_5":14349,"_27386":49323,"_2933":49523},[],"`--tls-key`",{"_3450":165,"_30100":91,"_20891":49525,"_5":14349,"_27386":49323,"_2933":49448},[],{"_3450":166,"_30100":91,"_20891":49527,"_5":14349,"_27386":49323,"_2933":49528},[],"PEM private key for downstream TLS",{"_3450":167,"_30100":91,"_20891":49530,"_5":14349,"_27386":49323,"_2933":49531},[],"`-l`, `--local-chart-path`",{"_3450":168,"_30100":91,"_20891":49533,"_5":14349,"_27386":49323,"_2933":49534},[],"repository chart",{"_3450":169,"_30100":91,"_20891":49536,"_5":14349,"_27386":49323,"_2933":49537},[],"Use an unpacked local Lamassu chart",{"_3450":170,"_30100":91,"_20891":49539,"_5":14349,"_27386":49323,"_2933":49540},[],"`-ip`, `--gateway-ip`",{"_3450":171,"_30100":91,"_20891":49542,"_5":14349,"_27386":49323,"_2933":8711},[],{"_3450":172,"_30100":91,"_20891":49544,"_5":14349,"_27386":49323,"_2933":49545},[],"Override the address written to `gateway.addresses`",{"_3450":173,"_30100":91,"_20891":49547,"_5":14349,"_27386":49323,"_2933":49548},[],"`--otel`",{"_3450":174,"_30100":91,"_20891":49550,"_5":14349,"_27386":49323,"_2933":6512},[],{"_3450":175,"_30100":91,"_20891":49552,"_5":14349,"_27386":49323,"_2933":49553},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3450":176,"_30100":91,"_20891":49555,"_5":14349,"_27386":49323,"_2933":49556},[],"`--development`",{"_3450":177,"_30100":91,"_20891":49558,"_5":14349,"_27386":49323,"_2933":6512},[],{"_3450":178,"_30100":91,"_20891":49560,"_5":14349,"_27386":49323,"_2933":49561},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3450":179,"_30100":91,"_20891":49563,"_5":14349,"_27386":49323,"_2933":49564},[],"`--sample-data`",{"_3450":180,"_30100":91,"_20891":49566,"_5":14349,"_27386":49323,"_2933":6512},[],{"_3450":181,"_30100":91,"_20891":49568,"_5":14349,"_27386":49323,"_2933":49569},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3450":182,"_30100":91,"_20891":49571,"_5":14349,"_27386":49323,"_2933":49572},[],"`--with-hsm`",{"_3450":183,"_30100":91,"_20891":49574,"_5":14349,"_27386":49323,"_2933":6512},[],{"_3450":184,"_30100":91,"_20891":49576,"_5":14349,"_27386":49323,"_2933":49577},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3450":185,"_30100":91,"_20891":49579,"_5":14349,"_27386":49323,"_2933":49580},[],"`--softhsm-chart-path`",{"_3450":186,"_30100":91,"_20891":49582,"_5":14349,"_27386":49323,"_2933":49583},[],"`./charts/softhsm`",{"_3450":187,"_30100":91,"_20891":49585,"_5":14349,"_27386":49323,"_2933":49586},[],"Use a different local SoftHSM chart",{"_3450":188,"_30100":91,"_20891":49588,"_5":14349,"_27386":49323,"_2933":49589},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3450":189,"_30100":91,"_20891":49591,"_5":14349,"_27386":49327,"_2933":49592},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3450":190,"_30100":91,"_20891":49594,"_5":14349,"_27386":49327,"_2933":49595},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3450":191,"_30100":91,"_20891":49597,"_5":14349,"_27386":49327,"_2933":49598},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3450":192,"_30100":91,"_20891":49600,"_5":14349,"_27386":49327,"_2933":49601},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3450":193,"_30100":91,"_20891":49603,"_5":14349,"_27386":49327,"_2933":49604},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3450":194,"_30100":91,"_20891":49606,"_5":14349,"_27386":49327,"_2933":49607},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3450":195,"_30100":91,"_20891":49609,"_5":14349,"_27386":49331,"_2933":49610},[],"Fastlane:",{"_3450":196,"_30100":91,"_20891":49612,"_5":14349,"_27386":49331,"_2933":49613},[],"validates local tools and the selected cluster",{"_3450":197,"_30100":91,"_20891":49615,"_5":14349,"_27386":49331,"_2933":49616},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3450":198,"_30100":91,"_20891":49618,"_5":14349,"_27386":49331,"_2933":49619},[],"creates the namespace",{"_3450":199,"_30100":91,"_20891":49621,"_5":14349,"_27386":49331,"_2933":49622},[],"installs PostgreSQL and creates the required databases",{"_3450":200,"_30100":91,"_20891":49624,"_5":14349,"_27386":49331,"_2933":49625},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3450":201,"_30100":91,"_20891":49627,"_5":14349,"_27386":49331,"_2933":49628},[],"installs RabbitMQ",{"_3450":202,"_30100":91,"_20891":49630,"_5":14349,"_27386":49331,"_2933":49631},[],"optionally installs observability and lab HSM components",{"_3450":203,"_30100":91,"_20891":49633,"_5":14349,"_27386":49331,"_2933":49634},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3450":204,"_30100":91,"_20891":49636,"_5":14349,"_27386":49331,"_2933":49637},[],"optionally loads sample data",{"_3450":205,"_30100":91,"_20891":49639,"_5":14349,"_27386":49331,"_2933":49640},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3450":206,"_30100":91,"_20891":49642,"_5":14349,"_27386":49335,"_2933":49643},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3450":207,"_30100":91,"_20891":49645,"_5":14349,"_27386":49335,"_2933":49646},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3450":208,"_30100":91,"_20891":49648,"_5":14349,"_27386":49339,"_2933":49649},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3450":209,"_30100":91,"_20891":49651,"_5":14349,"_27386":49339,"_2933":49652},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3450":210,"_30100":91,"_20891":49654,"_5":14349,"_27386":49339,"_2933":49655},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3450":211,"_30100":91,"_20891":49657,"_5":14349,"_27386":49343,"_2933":49658},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3450":212,"_30100":212,"_5":14701,"_2933":49660,"_30453":49661,"_20891":49662,"_27386":212},"Install with Helm",[49052,49053,49159],[],{"_3450":213,"_30100":212,"_20891":49664,"_5":14349,"_27386":212,"_2933":49665},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3450":214,"_30100":212,"_5":30450,"_20891":49667,"_27386":49668,"_2933":49669},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3450":215,"_30100":212,"_5":30450,"_20891":49671,"_27386":49672,"_2933":49062},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#before-you-begin",{"_3450":216,"_30100":212,"_5":30450,"_20891":49674,"_27386":49675,"_2933":49676},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3450":217,"_30100":212,"_5":30450,"_20891":49678,"_27386":49679,"_2933":49680},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3450":218,"_30100":212,"_5":30450,"_20891":49682,"_27386":49683,"_2933":49684},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3450":219,"_30100":212,"_5":30450,"_20891":49686,"_27386":49687,"_2933":49688},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3450":220,"_30100":212,"_5":30450,"_20891":49690,"_27386":49691,"_2933":49692},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3450":221,"_30100":212,"_5":30450,"_20891":49694,"_27386":49695,"_2933":49696},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3450":222,"_30100":212,"_5":30450,"_20891":49698,"_27386":49699,"_2933":49700},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3450":223,"_30100":212,"_5":30450,"_20891":49702,"_27386":49703,"_2933":49704},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3450":224,"_30100":212,"_5":30450,"_20891":49706,"_27386":49707,"_2933":49708},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3450":225,"_30100":212,"_20891":49710,"_5":14349,"_27386":49668,"_2933":49711},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3450":226,"_30100":212,"_20891":49713,"_5":14349,"_27386":49672,"_2933":49714},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3450":227,"_30100":212,"_20891":49716,"_5":14349,"_27386":49672,"_2933":49717},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3450":228,"_30100":212,"_20891":49719,"_5":14349,"_27386":49672,"_2933":49720},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3450":229,"_30100":212,"_20891":49722,"_5":14349,"_27386":49672,"_2933":49723},[],"a reachable RabbitMQ broker and credentials",{"_3450":230,"_30100":212,"_20891":49725,"_5":14349,"_27386":49672,"_2933":49726},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3450":231,"_30100":212,"_20891":49728,"_5":14349,"_27386":49672,"_2933":49729},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3450":232,"_30100":212,"_20891":49731,"_5":14349,"_27386":49672,"_2933":49732},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3450":233,"_30100":212,"_20891":49734,"_5":14349,"_27386":49672,"_2933":49735},[],"a StorageClass and an external traffic design",{"_3450":234,"_30100":212,"_20891":49737,"_5":14349,"_27386":49672,"_2933":49738},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3450":235,"_30100":212,"_20891":49740,"_5":14349,"_27386":49672,"_2933":49741},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3450":236,"_30100":212,"_20891":49743,"_5":14349,"_27386":49672,"_2933":49744},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3450":237,"_30100":212,"_20891":49746,"_5":14349,"_27386":49675,"_2933":49747},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3450":238,"_30100":212,"_20891":49749,"_5":14349,"_27386":49675,"_2933":49750},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3450":239,"_30100":212,"_20891":49752,"_5":14349,"_27386":49675,"_2933":49753},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3450":240,"_30100":212,"_20891":49755,"_5":14349,"_27386":49679,"_2933":49756},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3450":241,"_30100":212,"_20891":49758,"_5":14349,"_27386":49679,"_2933":49759},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3450":242,"_30100":212,"_20891":49761,"_5":14349,"_27386":49679,"_2933":49762},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3450":243,"_30100":212,"_20891":49764,"_5":14349,"_27386":49679,"_2933":49765},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3450":244,"_30100":212,"_20891":49767,"_5":14349,"_27386":49683,"_2933":49768},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3450":245,"_30100":212,"_20891":49770,"_5":14349,"_27386":49687,"_2933":49771},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3450":246,"_30100":212,"_20891":49773,"_5":14349,"_27386":49687,"_2933":49774},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3450":247,"_30100":212,"_20891":49776,"_5":14349,"_27386":49687,"_2933":49777},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3450":248,"_30100":212,"_20891":49779,"_5":14349,"_27386":49687,"_2933":49780},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3450":249,"_30100":212,"_20891":49782,"_5":14349,"_27386":49687,"_2933":49783},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3450":250,"_30100":212,"_20891":49785,"_5":14349,"_27386":49687,"_2933":49786},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3450":251,"_30100":212,"_20891":49788,"_5":14349,"_27386":49687,"_2933":49789},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3450":252,"_30100":212,"_20891":49791,"_5":14349,"_27386":49691,"_2933":49792},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3450":253,"_30100":212,"_20891":49794,"_5":14349,"_27386":49691,"_2933":49795},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3450":254,"_30100":212,"_20891":49797,"_5":14349,"_27386":49691,"_2933":49798},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3450":255,"_30100":212,"_20891":49800,"_5":14349,"_27386":49691,"_2933":49801},[],"See Access control for the principal and policy model.",{"_3450":256,"_30100":212,"_20891":49803,"_5":14349,"_27386":49695,"_2933":49804},[],"To install a local checkout instead:",{"_3450":257,"_30100":212,"_20891":49806,"_5":14349,"_27386":49699,"_2933":49807},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3450":258,"_30100":212,"_20891":49809,"_5":14349,"_27386":49699,"_2933":49810},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3450":259,"_30100":212,"_20891":49812,"_5":14349,"_27386":49703,"_2933":49813},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3450":260,"_30100":212,"_20891":49815,"_5":14349,"_27386":49703,"_2933":49816},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3450":261,"_30100":212,"_20891":49818,"_5":14349,"_27386":49703,"_2933":49819},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3450":262,"_30100":212,"_20891":49821,"_5":14349,"_27386":49703,"_2933":49822},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3450":263,"_30100":212,"_20891":49824,"_5":14349,"_27386":49703,"_2933":49825},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3450":264,"_30100":212,"_20891":49827,"_5":14349,"_27386":49707,"_2933":49828},[],"Before going live, review:",{"_3450":265,"_30100":212,"_20891":49830,"_5":14349,"_27386":49707,"_2933":49831},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3450":266,"_30100":212,"_20891":49833,"_5":14349,"_27386":49707,"_2933":49834},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3450":267,"_30100":212,"_20891":49836,"_5":14349,"_27386":49707,"_2933":49837},[],"shared VA storage before increasing VA replicas",{"_3450":268,"_30100":212,"_20891":49839,"_5":14349,"_27386":49707,"_2933":49840},[],"managed OIDC roles and removal of evaluation credentials",{"_3450":269,"_30100":212,"_20891":49842,"_5":14349,"_27386":49707,"_2933":49843},[],"a trusted TLS issuer or externally managed certificate",{"_3450":270,"_30100":212,"_20891":49845,"_5":14349,"_27386":49707,"_2933":49846},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3450":271,"_30100":212,"_20891":49848,"_5":14349,"_27386":49707,"_2933":49849},[],"SMTP, observability and alert delivery",{"_3450":272,"_30100":212,"_20891":49851,"_5":14349,"_27386":49707,"_2933":49852},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3450":273,"_30100":212,"_20891":49854,"_5":14349,"_27386":49707,"_2933":49855},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3450":274,"_30100":274,"_5":14701,"_2933":49857,"_30453":49858,"_20891":49859,"_27386":274},"Expose the Gateway",[49052,49053,49159],[],{"_3450":275,"_30100":274,"_20891":49861,"_5":14349,"_27386":274,"_2933":49862},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3450":276,"_30100":274,"_5":30450,"_20891":49864,"_27386":49865,"_2933":49866},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3450":277,"_30100":274,"_5":30450,"_20891":49868,"_27386":49869,"_2933":49870},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3450":278,"_30100":274,"_5":30450,"_20891":49872,"_27386":49873,"_2933":49874},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3450":279,"_30100":274,"_5":30450,"_20891":49876,"_27386":49877,"_2933":49878},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#k3s","K3s",{"_3450":280,"_30100":274,"_5":30450,"_20891":49880,"_27386":49881,"_2933":49882},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3450":281,"_30100":274,"_5":30450,"_20891":49884,"_27386":49885,"_2933":49886},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3450":282,"_30100":274,"_5":30450,"_20891":49888,"_27386":49889,"_2933":49890},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3450":283,"_30100":274,"_5":30450,"_20891":49892,"_27386":49893,"_2933":49894},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3450":284,"_30100":274,"_5":30450,"_20891":49896,"_27386":49897,"_2933":49898},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3450":285,"_30100":274,"_5":30450,"_20891":49900,"_27386":49901,"_2933":49902},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3450":286,"_30100":274,"_20891":49904,"_5":14349,"_27386":49865,"_2933":49905},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3450":287,"_30100":274,"_20891":49907,"_5":14349,"_27386":49865,"_2933":49908},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3450":288,"_30100":274,"_20891":49910,"_5":14349,"_27386":49869,"_2933":49911},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3450":289,"_30100":274,"_20891":49913,"_5":14349,"_27386":49869,"_2933":49914},[],"Set it only when:",{"_3450":290,"_30100":274,"_20891":49916,"_5":14349,"_27386":49869,"_2933":49917},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3450":291,"_30100":274,"_20891":49919,"_5":14349,"_27386":49869,"_2933":49920},[],"that address is allocated to this Gateway",{"_3450":292,"_30100":274,"_20891":49922,"_5":14349,"_27386":49869,"_2933":49923},[],"the surrounding network already routes traffic for it to the cluster",{"_3450":293,"_30100":274,"_20891":49925,"_5":14349,"_27386":49869,"_2933":49926},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3450":294,"_30100":274,"_20891":49928,"_5":14349,"_27386":49869,"_2933":49929},[],"Keep these two settings separate:",{"_3450":295,"_30100":274,"_20891":49931,"_5":14349,"_27386":49869,"_2933":49932},[],"`gateway.addresses` requests an address for the Gateway.",{"_3450":296,"_30100":274,"_20891":49934,"_5":14349,"_27386":49869,"_2933":49935},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3450":297,"_30100":274,"_20891":49937,"_5":14349,"_27386":49869,"_2933":49938},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3450":298,"_30100":274,"_20891":49940,"_5":14349,"_27386":49873,"_2933":49941},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3450":299,"_30100":274,"_20891":49943,"_5":14349,"_27386":49873,"_2933":49944},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3450":300,"_30100":274,"_20891":49946,"_5":14349,"_27386":49877,"_2933":49947},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3450":301,"_30100":274,"_20891":49949,"_5":14349,"_27386":49877,"_2933":49950},[],"For the recommended design:",{"_3450":302,"_30100":274,"_20891":49952,"_5":14349,"_27386":49877,"_2933":49953},[],"Use only one externally exposed Lamassu Gateway.",{"_3450":303,"_30100":274,"_20891":49955,"_5":14349,"_27386":49877,"_2933":49956},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3450":304,"_30100":274,"_20891":49958,"_5":14349,"_27386":49877,"_2933":49959},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3450":305,"_30100":274,"_20891":49961,"_5":14349,"_27386":49877,"_2933":49962},[],"Point DNS at the VM's reachable address.",{"_3450":306,"_30100":274,"_20891":49964,"_5":14349,"_27386":49877,"_2933":49965},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3450":307,"_30100":274,"_20891":49967,"_5":14349,"_27386":49881,"_2933":49968},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3450":308,"_30100":274,"_20891":49970,"_5":14349,"_27386":49885,"_2933":49971},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3450":309,"_30100":274,"_20891":49973,"_5":14349,"_27386":49885,"_2933":49974},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3450":310,"_30100":274,"_20891":49976,"_5":14349,"_27386":49889,"_2933":49977},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3450":311,"_30100":274,"_20891":49979,"_5":14349,"_27386":49889,"_2933":49980},[],"Requirement",{"_3450":312,"_30100":274,"_20891":49982,"_5":14349,"_27386":49889,"_2933":49983},[],"Recommended design",{"_3450":313,"_30100":274,"_20891":49985,"_5":14349,"_27386":49889,"_2933":49986},[],"Consequence",{"_3450":314,"_30100":274,"_20891":49988,"_5":14349,"_27386":49889,"_2933":49989},[],"Several Lamassu URLs or services",{"_3450":315,"_30100":274,"_20891":49991,"_5":14349,"_27386":49889,"_2933":49992},[],"One Gateway with multiple routes",{"_3450":316,"_30100":274,"_20891":49994,"_5":14349,"_27386":49889,"_2933":49995},[],"One IP and one proxy fleet; this is the chart default",{"_3450":317,"_30100":274,"_20891":49997,"_5":14349,"_27386":49889,"_2933":49998},[],"Independent Gateways and separate external IPs",{"_3450":318,"_30100":274,"_20891":50000,"_5":14349,"_27386":49889,"_2933":50001},[],"One VIP per Gateway",{"_3450":319,"_30100":274,"_20891":50003,"_5":14349,"_27386":49889,"_2933":50004},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3450":320,"_30100":274,"_20891":50006,"_5":14349,"_27386":49889,"_2933":50007},[],"Independent Gateways on one node and one IP",{"_3450":321,"_30100":274,"_20891":50009,"_5":14349,"_27386":49889,"_2933":50010},[],"Use different external ports",{"_3450":322,"_30100":274,"_20891":50012,"_5":14349,"_27386":49889,"_2933":50013},[],"Clients must include non-standard ports",{"_3450":323,"_30100":274,"_20891":50015,"_5":14349,"_27386":49889,"_2933":50016},[],"Separate TLS/mTLS termination behind one IP",{"_3450":324,"_30100":274,"_20891":50018,"_5":14349,"_27386":49889,"_2933":50019},[],"Front-door SNI routing to internal Gateways",{"_3450":325,"_30100":274,"_20891":50021,"_5":14349,"_27386":49889,"_2933":50022},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3450":326,"_30100":274,"_20891":50024,"_5":14349,"_27386":49889,"_2933":50025},[],"Separate Gateway resources but shared proxy infrastructure",{"_3450":327,"_30100":274,"_20891":50027,"_5":14349,"_27386":49889,"_2933":50028},[],"Envoy merged-Gateway mode",{"_3450":328,"_30100":274,"_20891":50030,"_5":14349,"_27386":49889,"_2933":50031},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3450":329,"_30100":274,"_20891":50033,"_5":14349,"_27386":49889,"_2933":50034},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3450":330,"_30100":274,"_20891":50036,"_5":14349,"_27386":49889,"_2933":50037},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3450":331,"_30100":274,"_20891":50039,"_5":14349,"_27386":49889,"_2933":50040},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3450":332,"_30100":274,"_20891":50042,"_5":14349,"_27386":49889,"_2933":50043},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3450":333,"_30100":274,"_20891":50045,"_5":14349,"_27386":49893,"_2933":50046},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3450":334,"_30100":274,"_20891":50048,"_5":14349,"_27386":49893,"_2933":50049},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3450":335,"_30100":274,"_20891":50051,"_5":14349,"_27386":49893,"_2933":50052},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3450":336,"_30100":274,"_20891":50054,"_5":14349,"_27386":49893,"_2933":50055},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3450":337,"_30100":274,"_20891":50057,"_5":14349,"_27386":49893,"_2933":50058},[],"If none of those are possible, use different external ports or change the external network design.",{"_3450":338,"_30100":274,"_20891":50060,"_5":14349,"_27386":49897,"_2933":50061},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3450":339,"_30100":274,"_20891":50063,"_5":14349,"_27386":49897,"_2933":50064},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3450":340,"_30100":274,"_20891":50066,"_5":14349,"_27386":49901,"_2933":50067},[],"Check, in order:",{"_3450":341,"_30100":274,"_20891":50069,"_5":14349,"_27386":49901,"_2933":50070},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3450":342,"_30100":274,"_20891":50072,"_5":14349,"_27386":49901,"_2933":50073},[],"Its status contains the expected address.",{"_3450":343,"_30100":274,"_20891":50075,"_5":14349,"_27386":49901,"_2933":50076},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3450":344,"_30100":274,"_20891":50078,"_5":14349,"_27386":49901,"_2933":50079},[],"Port 443 reaches that address from the client network.",{"_3450":345,"_30100":274,"_20891":50081,"_5":14349,"_27386":49901,"_2933":50082},[],"DNS resolves to the externally reachable endpoint.",{"_3450":346,"_30100":274,"_20891":50084,"_5":14349,"_27386":49901,"_2933":50085},[],"The certificate contains the DNS name or IP used by the client.",{"_3450":347,"_30100":274,"_20891":50087,"_5":14349,"_27386":49901,"_2933":50088},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3450":348,"_30100":348,"_5":14701,"_2933":49159,"_30453":50090,"_20891":50091,"_27386":348},[49052,49053,49159],[],{"_3450":349,"_30100":348,"_20891":50093,"_5":14349,"_27386":348,"_2933":50094},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3450":350,"_30100":348,"_5":30450,"_20891":50096,"_27386":50097,"_2933":50098},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3450":351,"_30100":348,"_5":30450,"_20891":50100,"_27386":50101,"_2933":50102},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3450":352,"_30100":348,"_5":30450,"_20891":50104,"_27386":50105,"_2933":50106},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3450":353,"_30100":348,"_5":30450,"_20891":50108,"_27386":50109,"_2933":50110},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3450":354,"_30100":348,"_5":30450,"_20891":50112,"_27386":50113,"_2933":50114},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3450":355,"_30100":348,"_5":30450,"_20891":50116,"_27386":50117,"_2933":50118},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3450":356,"_30100":348,"_20891":50120,"_5":14349,"_27386":50097,"_2933":50121},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3450":357,"_30100":348,"_20891":50123,"_5":14349,"_27386":50101,"_2933":50124},[],"Workflow",{"_3450":358,"_30100":348,"_20891":50126,"_5":14349,"_27386":50101,"_2933":50127},[],"Use it for",{"_3450":359,"_30100":348,"_20891":50129,"_5":14349,"_27386":50101,"_2933":50130},[],"What it installs",{"_3450":360,"_30100":348,"_20891":50132,"_5":14349,"_27386":50101,"_2933":50133},[],"Helm",{"_3450":361,"_30100":348,"_20891":50135,"_5":14349,"_27386":50101,"_2933":50136},[],"Production and controlled environments",{"_3450":362,"_30100":348,"_20891":50138,"_5":14349,"_27386":50101,"_2933":50139},[],"Lamassu services and Gateway API resources",{"_3450":363,"_30100":348,"_20891":50141,"_5":14349,"_27386":50101,"_2933":49296},[],{"_3450":364,"_30100":348,"_20891":50143,"_5":14349,"_27386":50101,"_2933":50144},[],"Evaluation, demos, CI and small lab clusters",{"_3450":365,"_30100":348,"_20891":50146,"_5":14349,"_27386":50101,"_2933":50147},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3450":366,"_30100":348,"_20891":50149,"_5":14349,"_27386":50105,"_2933":50150},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3450":367,"_30100":348,"_20891":50152,"_5":14349,"_27386":50105,"_2933":50153},[],"Area",{"_3450":368,"_30100":348,"_20891":50155,"_5":14349,"_27386":50105,"_2933":50156},[],"The Lamassu chart provides",{"_3450":369,"_30100":348,"_20891":50158,"_5":14349,"_27386":50105,"_2933":50159},[],"You provide",{"_3450":370,"_30100":348,"_20891":50161,"_5":14349,"_27386":50105,"_2933":50162},[],"Lamassu applications",{"_3450":371,"_30100":348,"_20891":50164,"_5":14349,"_27386":50105,"_2933":50165},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3450":372,"_30100":348,"_20891":50167,"_5":14349,"_27386":50105,"_2933":50168},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3450":373,"_30100":348,"_20891":50170,"_5":14349,"_27386":50105,"_2933":50171},[],"PostgreSQL data",{"_3450":374,"_30100":348,"_20891":50173,"_5":14349,"_27386":50105,"_2933":50174},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3450":375,"_30100":348,"_20891":50176,"_5":14349,"_27386":50105,"_2933":50177},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3450":376,"_30100":348,"_20891":50179,"_5":14349,"_27386":50105,"_2933":50180},[],"Messaging",{"_3450":377,"_30100":348,"_20891":50182,"_5":14349,"_27386":50105,"_2933":50183},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3450":378,"_30100":348,"_20891":50185,"_5":14349,"_27386":50105,"_2933":50186},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3450":379,"_30100":348,"_20891":50188,"_5":14349,"_27386":50105,"_2933":50189},[],"Identity",{"_3450":380,"_30100":348,"_20891":50191,"_5":14349,"_27386":50105,"_2933":50192},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3450":381,"_30100":348,"_20891":50194,"_5":14349,"_27386":50105,"_2933":50195},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3450":382,"_30100":348,"_20891":50197,"_5":14349,"_27386":50105,"_2933":50198},[],"External routing",{"_3450":383,"_30100":348,"_20891":50200,"_5":14349,"_27386":50105,"_2933":50201},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3450":384,"_30100":348,"_20891":50203,"_5":14349,"_27386":50105,"_2933":50204},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3450":385,"_30100":348,"_20891":50206,"_5":14349,"_27386":50105,"_2933":50207},[],"TLS",{"_3450":386,"_30100":348,"_20891":50209,"_5":14349,"_27386":50105,"_2933":50210},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3450":387,"_30100":348,"_20891":50212,"_5":14349,"_27386":50105,"_2933":50213},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3450":388,"_30100":348,"_20891":50215,"_5":14349,"_27386":50105,"_2933":50216},[],"Persistent application data",{"_3450":389,"_30100":348,"_20891":50218,"_5":14349,"_27386":50105,"_2933":50219},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3450":390,"_30100":348,"_20891":50221,"_5":14349,"_27386":50105,"_2933":50222},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3450":391,"_30100":348,"_20891":50224,"_5":14349,"_27386":50105,"_2933":50225},[],"Optional integrations",{"_3450":392,"_30100":348,"_20891":50227,"_5":14349,"_27386":50105,"_2933":50228},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3450":393,"_30100":348,"_20891":50230,"_5":14349,"_27386":50105,"_2933":50231},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3450":394,"_30100":348,"_20891":50233,"_5":14349,"_27386":50105,"_2933":50234},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3450":395,"_30100":348,"_20891":50236,"_5":14349,"_27386":50105,"_2933":50237},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3450":396,"_30100":348,"_20891":50239,"_5":14349,"_27386":50109,"_2933":50240},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3450":397,"_30100":348,"_20891":50242,"_5":14349,"_27386":50109,"_2933":50243},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3450":398,"_30100":348,"_20891":50245,"_5":14349,"_27386":50113,"_2933":50246},[],"Kubernetes 1.24 or newer",{"_3450":399,"_30100":348,"_20891":50248,"_5":14349,"_27386":50113,"_2933":50249},[],"Helm 3.2 or newer",{"_3450":400,"_30100":348,"_20891":50251,"_5":14349,"_27386":50113,"_2933":50252},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3450":401,"_30100":348,"_20891":50254,"_5":14349,"_27386":50113,"_2933":50255},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3450":402,"_30100":348,"_20891":50257,"_5":14349,"_27386":50113,"_2933":50258},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3450":403,"_30100":348,"_20891":50260,"_5":14349,"_27386":50113,"_2933":50261},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3450":404,"_30100":348,"_20891":50263,"_5":14349,"_27386":50113,"_2933":50264},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3450":405,"_30100":348,"_20891":50266,"_5":14349,"_27386":50117,"_2933":50267},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3450":406,"_30100":348,"_20891":50269,"_5":14349,"_27386":50117,"_2933":50270},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3450":407,"_30100":348,"_20891":50272,"_5":14349,"_27386":50117,"_2933":50273},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3450":408,"_30100":348,"_20891":50275,"_5":14349,"_27386":50117,"_2933":50276},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3450":409,"_30100":409,"_5":14701,"_2933":50278,"_30453":50279,"_20891":50281,"_27386":409},"Deployment troubleshooting",[49052,49053,50280],"Operations",[],{"_3450":410,"_30100":409,"_20891":50283,"_5":14349,"_27386":409,"_2933":50284},[],"Diagnose access, service health and infrastructure dependencies.",{"_3450":411,"_30100":409,"_5":30450,"_20891":50286,"_27386":50287,"_2933":50288},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3450":412,"_30100":409,"_5":30450,"_20891":50290,"_27386":50291,"_2933":50292},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3450":413,"_30100":409,"_5":30450,"_20891":50294,"_27386":50295,"_2933":50296},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3450":414,"_30100":409,"_5":30450,"_20891":50298,"_27386":50299,"_2933":50300},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3450":415,"_30100":409,"_5":30450,"_20891":50302,"_27386":50303,"_2933":50304},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3450":416,"_30100":409,"_5":30450,"_20891":50306,"_27386":50307,"_2933":50308},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3450":417,"_30100":409,"_5":30450,"_20891":50310,"_27386":50311,"_2933":50312},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3450":418,"_30100":409,"_5":30450,"_20891":50314,"_27386":50315,"_2933":50316},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3450":419,"_30100":409,"_5":30450,"_20891":50318,"_27386":50319,"_2933":50320},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3450":420,"_30100":409,"_5":30450,"_20891":50322,"_27386":50323,"_2933":50324},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3450":421,"_30100":409,"_5":30450,"_20891":50326,"_27386":50327,"_2933":50328},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3450":422,"_30100":409,"_5":30450,"_20891":50330,"_27386":50331,"_2933":50332},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3450":423,"_30100":409,"_5":30450,"_20891":50334,"_27386":50335,"_2933":50336},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#observability","Observability",{"_3450":424,"_30100":409,"_20891":50338,"_5":14349,"_27386":409,"_2933":50339},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3450":425,"_30100":409,"_20891":50341,"_5":14349,"_27386":50291,"_2933":50342},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3450":426,"_30100":409,"_20891":50344,"_5":14349,"_27386":50295,"_2933":50345},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3450":427,"_30100":409,"_20891":50347,"_5":14349,"_27386":50299,"_2933":50348},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3450":428,"_30100":409,"_20891":50350,"_5":14349,"_27386":50303,"_2933":50351},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3450":429,"_30100":409,"_20891":50353,"_5":14349,"_27386":50307,"_2933":50354},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3450":430,"_30100":409,"_20891":50356,"_5":14349,"_27386":50311,"_2933":50357},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3450":431,"_30100":409,"_20891":50359,"_5":14349,"_27386":50311,"_2933":50360},[],"Also run the chart's connectivity test:",{"_3450":432,"_30100":409,"_20891":50362,"_5":14349,"_27386":50311,"_2933":50363},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3450":433,"_30100":409,"_20891":50365,"_5":14349,"_27386":50311,"_2933":50366},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3450":434,"_30100":409,"_20891":50368,"_5":14349,"_27386":50315,"_2933":50369},[],"If you receive a 401:",{"_3450":435,"_30100":409,"_20891":50371,"_5":14349,"_27386":50315,"_2933":50372},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3450":436,"_30100":409,"_20891":50374,"_5":14349,"_27386":50315,"_2933":50375},[],"verify issuer, audience and expiration of the token;",{"_3450":437,"_30100":409,"_20891":50377,"_5":14349,"_27386":50315,"_2933":50378},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3450":438,"_30100":409,"_20891":50380,"_5":14349,"_27386":50315,"_2933":50381},[],"check that the provider's public and internal routes point to the same realm.",{"_3450":439,"_30100":409,"_20891":50383,"_5":14349,"_27386":50315,"_2933":50384},[],"If login succeeds but the APIs return 403:",{"_3450":440,"_30100":409,"_20891":50386,"_5":14349,"_27386":50315,"_2933":50387},[],"inspect the token's real claims;",{"_3450":441,"_30100":409,"_20891":50389,"_5":14349,"_27386":50315,"_2933":50390},[],"confirm they match an active principal;",{"_3450":442,"_30100":409,"_20891":50392,"_5":14349,"_27386":50315,"_2933":50393},[],"review the policies granted to that principal;",{"_3450":443,"_30100":409,"_20891":50395,"_5":14349,"_27386":50315,"_2933":50396},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3450":444,"_30100":409,"_20891":50398,"_5":14349,"_27386":50315,"_2933":50399},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3450":445,"_30100":409,"_20891":50401,"_5":14349,"_27386":50319,"_2933":50402},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3450":446,"_30100":409,"_20891":50404,"_5":14349,"_27386":50319,"_2933":50405},[],"Locate the authz pod and Service.",{"_3450":447,"_30100":409,"_20891":50407,"_5":14349,"_27386":50319,"_2933":50408},[],"Check /health, logs and its database connection.",{"_3450":448,"_30100":409,"_20891":50410,"_5":14349,"_27386":50319,"_2933":50411},[],"Verify the DNS and port configured in externalAuthorization.",{"_3450":449,"_30100":409,"_20891":50413,"_5":14349,"_27386":50319,"_2933":50414},[],"Check the check route is /v1/ext\\_authz/check.",{"_3450":450,"_30100":409,"_20891":50416,"_5":14349,"_27386":50319,"_2933":50417},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3450":451,"_30100":409,"_20891":50419,"_5":14349,"_27386":50323,"_2933":50420},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3450":452,"_30100":409,"_20891":50422,"_5":14349,"_27386":50327,"_2933":50423},[],"Review kubectl describe pod first. Common causes are:",{"_3450":453,"_30100":409,"_20891":50425,"_5":14349,"_27386":50327,"_2933":50426},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3450":454,"_30100":409,"_20891":50428,"_5":14349,"_27386":50327,"_2933":50429},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3450":455,"_30100":409,"_20891":50431,"_5":14349,"_27386":50327,"_2933":50432},[],"unbound persistent volume;",{"_3450":456,"_30100":409,"_20891":50434,"_5":14349,"_27386":50327,"_2933":50435},[],"inaccessible image or incorrect pull policy;",{"_3450":457,"_30100":409,"_20891":50437,"_5":14349,"_27386":50327,"_2933":50438},[],"invalid cryptographic engine configuration;",{"_3450":458,"_30100":409,"_20891":50440,"_5":14349,"_27386":50327,"_2933":50441},[],"CPU or memory limits set too low;",{"_3450":459,"_30100":409,"_20891":50443,"_5":14349,"_27386":50327,"_2933":50444},[],"an incomplete prior migration.",{"_3450":460,"_30100":409,"_20891":50446,"_5":14349,"_27386":50327,"_2933":50447},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3450":461,"_30100":409,"_20891":50449,"_5":14349,"_27386":50327,"_2933":50450},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3450":462,"_30100":409,"_20891":50452,"_5":14349,"_27386":50327,"_2933":50453},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3450":463,"_30100":409,"_20891":50455,"_5":14349,"_27386":50331,"_2933":50456},[],"Domain and audit events depend on the bus publisher:",{"_3450":464,"_30100":409,"_20891":50458,"_5":14349,"_27386":50331,"_2933":50459},[],"verify it is enabled in the emitting service;",{"_3450":465,"_30100":409,"_20891":50461,"_5":14349,"_27386":50331,"_2933":50462},[],"check AMQP connectivity and credentials;",{"_3450":466,"_30100":409,"_20891":50464,"_5":14349,"_27386":50331,"_2933":50465},[],"review exchange, routing key, queues and consumers;",{"_3450":467,"_30100":409,"_20891":50467,"_5":14349,"_27386":50331,"_2933":50468},[],"inspect dead-letter queues;",{"_3450":468,"_30100":409,"_20891":50470,"_5":14349,"_27386":50331,"_2933":50471},[],"alert on orphan durable queues and backlog growth.",{"_3450":469,"_30100":409,"_20891":50473,"_5":14349,"_27386":50331,"_2933":50474},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3450":470,"_30100":409,"_20891":50476,"_5":14349,"_27386":50331,"_2933":50477},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3450":471,"_30100":409,"_20891":50479,"_5":14349,"_27386":50331,"_2933":50480},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3450":472,"_30100":409,"_20891":50482,"_5":14349,"_27386":50331,"_2933":50483},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3450":473,"_30100":409,"_20891":50485,"_5":14349,"_27386":50331,"_2933":50486},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3450":474,"_30100":409,"_20891":50488,"_5":14349,"_27386":50331,"_2933":50489},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3450":475,"_30100":409,"_20891":50491,"_5":14349,"_27386":50331,"_2933":50492},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3450":476,"_30100":409,"_20891":50494,"_5":14349,"_27386":50335,"_2933":50495},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3450":477,"_30100":409,"_20891":50497,"_5":14349,"_27386":50335,"_2933":50498},[],"Before closing an incident, record:",{"_3450":478,"_30100":409,"_20891":50500,"_5":14349,"_27386":50335,"_2933":50501},[],"the confirmed cause;",{"_3450":479,"_30100":409,"_20891":50503,"_5":14349,"_27386":50335,"_2933":50504},[],"the time scope and affected resources;",{"_3450":480,"_30100":409,"_20891":50506,"_5":14349,"_27386":50335,"_2933":50507},[],"the commands or queries used;",{"_3450":481,"_30100":409,"_20891":50509,"_5":14349,"_27386":50335,"_2933":50510},[],"the applied change and how to revert it;",{"_3450":482,"_30100":409,"_20891":50512,"_5":14349,"_27386":50335,"_2933":50513},[],"validation from a consumer;",{"_3450":483,"_30100":409,"_20891":50515,"_5":14349,"_27386":50335,"_2933":50516},[],"the preventive action and its owner.",{"_3450":484,"_30100":484,"_5":14701,"_2933":50518,"_30453":50519,"_20891":50522,"_27386":484},"Access control",[49052,50520,50521],"Platform","Administration",[],{"_3450":485,"_30100":484,"_20891":50524,"_5":14349,"_27386":484,"_2933":50525},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3450":486,"_30100":484,"_5":30450,"_20891":50527,"_27386":50528,"_2933":50529},[],"/docs/pr-preview/pr-61/platform/administration/access-control#essential-concepts","Essential concepts",{"_3450":487,"_30100":484,"_5":30450,"_20891":50531,"_27386":50532,"_2933":50533},[],"/docs/pr-preview/pr-61/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3450":488,"_30100":484,"_5":30450,"_20891":50535,"_27386":50536,"_2933":50537},[],"/docs/pr-preview/pr-61/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3450":489,"_30100":484,"_5":30450,"_20891":50539,"_27386":50540,"_2933":50541},[],"/docs/pr-preview/pr-61/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3450":490,"_30100":484,"_5":30450,"_20891":50543,"_27386":50544,"_2933":50545},[],"/docs/pr-preview/pr-61/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3450":491,"_30100":484,"_5":30450,"_20891":50547,"_27386":50548,"_2933":50549},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3450":492,"_30100":484,"_5":30450,"_20891":50551,"_27386":50552,"_2933":50553},[],"/docs/pr-preview/pr-61/platform/administration/access-control#oidc-principals","OIDC principals",{"_3450":493,"_30100":484,"_5":30450,"_20891":50555,"_27386":50556,"_2933":50557},[],"/docs/pr-preview/pr-61/platform/administration/access-control#x509-principals","X.509 principals",{"_3450":494,"_30100":484,"_5":30450,"_20891":50559,"_27386":50560,"_2933":50561},[],"/docs/pr-preview/pr-61/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3450":495,"_30100":484,"_5":30450,"_20891":50563,"_27386":50564,"_2933":50565},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3450":496,"_30100":484,"_5":30450,"_20891":50567,"_27386":50568,"_2933":50569},[],"/docs/pr-preview/pr-61/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3450":497,"_30100":484,"_5":30450,"_20891":50571,"_27386":50572,"_2933":50573},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3450":498,"_30100":484,"_5":30450,"_20891":50575,"_27386":50576,"_2933":50577},[],"/docs/pr-preview/pr-61/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3450":499,"_30100":484,"_5":30450,"_20891":50579,"_27386":50580,"_2933":50581},[],"/docs/pr-preview/pr-61/platform/administration/access-control#http-rules","HTTP rules",{"_3450":500,"_30100":484,"_5":30450,"_20891":50583,"_27386":50584,"_2933":50585},[],"/docs/pr-preview/pr-61/platform/administration/access-control#included-policies","Included policies",{"_3450":501,"_30100":484,"_5":30450,"_20891":50587,"_27386":50588,"_2933":49692},[],"/docs/pr-preview/pr-61/platform/administration/access-control#provision-the-first-administrator",{"_3450":502,"_30100":484,"_5":30450,"_20891":50590,"_27386":50591,"_2933":50592},[],"/docs/pr-preview/pr-61/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3450":503,"_30100":484,"_5":30450,"_20891":50594,"_27386":50595,"_2933":50596},[],"/docs/pr-preview/pr-61/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3450":504,"_30100":484,"_5":30450,"_20891":50598,"_27386":50599,"_2933":50600},[],"/docs/pr-preview/pr-61/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3450":505,"_30100":484,"_5":30450,"_20891":50602,"_27386":50603,"_2933":50604},[],"/docs/pr-preview/pr-61/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3450":506,"_30100":484,"_5":30450,"_20891":50606,"_27386":50607,"_2933":50608},[],"/docs/pr-preview/pr-61/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3450":507,"_30100":484,"_5":30450,"_20891":50610,"_27386":50611,"_2933":50612},[],"/docs/pr-preview/pr-61/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3450":508,"_30100":484,"_5":30450,"_20891":50614,"_27386":50615,"_2933":50616},[],"/docs/pr-preview/pr-61/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3450":509,"_30100":484,"_5":30450,"_20891":50618,"_27386":50619,"_2933":50620},[],"/docs/pr-preview/pr-61/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3450":510,"_30100":484,"_5":30450,"_20891":50622,"_27386":50623,"_2933":50624},[],"/docs/pr-preview/pr-61/platform/administration/access-control#operational-checklist","Operational checklist",{"_3450":511,"_30100":484,"_5":30450,"_20891":50626,"_27386":50627,"_2933":50628},[],"/docs/pr-preview/pr-61/platform/administration/access-control#diagnostics","Diagnostics",{"_3450":512,"_30100":484,"_5":30450,"_20891":50630,"_27386":50631,"_2933":50632},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-401","The response is 401",{"_3450":513,"_30100":484,"_5":30450,"_20891":50634,"_27386":50635,"_2933":50636},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-403","The response is 403",{"_3450":514,"_30100":484,"_5":30450,"_20891":50638,"_27386":50639,"_2933":50640},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3450":515,"_30100":484,"_5":30450,"_20891":50642,"_27386":50643,"_2933":50644},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3450":516,"_30100":484,"_5":30450,"_20891":50646,"_27386":50647,"_2933":50648},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3450":517,"_30100":484,"_20891":50650,"_5":14349,"_27386":484,"_2933":50651},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3450":518,"_30100":484,"_20891":50653,"_5":14349,"_27386":484,"_2933":50654},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3450":519,"_30100":484,"_20891":50656,"_5":14349,"_27386":484,"_2933":50657},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3450":520,"_30100":484,"_20891":50659,"_5":14349,"_27386":50528,"_2933":50660},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3450":521,"_30100":484,"_20891":50662,"_5":14349,"_27386":50528,"_2933":50663},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3450":522,"_30100":484,"_20891":50665,"_5":14349,"_27386":50528,"_2933":50666},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3450":523,"_30100":484,"_20891":50668,"_5":14349,"_27386":50528,"_2933":50669},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3450":524,"_30100":484,"_20891":50671,"_5":14349,"_27386":50528,"_2933":50672},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3450":525,"_30100":484,"_20891":50674,"_5":14349,"_27386":50528,"_2933":50675},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3450":526,"_30100":484,"_20891":50677,"_5":14349,"_27386":50532,"_2933":50678},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3450":527,"_30100":484,"_20891":50680,"_5":14349,"_27386":50532,"_2933":50681},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3450":528,"_30100":484,"_20891":50683,"_5":14349,"_27386":50536,"_2933":50684},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3450":529,"_30100":484,"_20891":50686,"_5":14349,"_27386":50536,"_2933":50687},[],"The decision is made **before forwarding the request to the service**:",{"_3450":530,"_30100":484,"_20891":50689,"_5":14349,"_27386":50536,"_2933":50690},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3450":531,"_30100":484,"_20891":50692,"_5":14349,"_27386":50536,"_2933":50693},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3450":532,"_30100":484,"_20891":50695,"_5":14349,"_27386":50536,"_2933":50696},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3450":533,"_30100":484,"_20891":50698,"_5":14349,"_27386":50536,"_2933":50699},[],"It separately loads the policies granted to each principal.",{"_3450":534,"_30100":484,"_20891":50701,"_5":14349,"_27386":50536,"_2933":50702},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3450":535,"_30100":484,"_20891":50704,"_5":14349,"_27386":50536,"_2933":50705},[],"`authz` looks for an HTTP rule granting that action.",{"_3450":536,"_30100":484,"_20891":50707,"_5":14349,"_27386":50536,"_2933":50708},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3450":537,"_30100":484,"_20891":50710,"_5":14349,"_27386":50536,"_2933":50711},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3450":538,"_30100":484,"_20891":50713,"_5":14349,"_27386":50536,"_2933":50714},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3450":539,"_30100":484,"_20891":50716,"_5":14349,"_27386":50536,"_2933":50717},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3450":540,"_30100":484,"_20891":50719,"_5":14349,"_27386":50540,"_2933":50720},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3450":541,"_30100":484,"_20891":50722,"_5":14349,"_27386":50540,"_2933":50723},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3450":542,"_30100":484,"_20891":50725,"_5":14349,"_27386":50540,"_2933":50726},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3450":543,"_30100":484,"_20891":50728,"_5":14349,"_27386":50540,"_2933":50729},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3450":544,"_30100":484,"_20891":50731,"_5":14349,"_27386":50540,"_2933":50732},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3450":545,"_30100":484,"_20891":50734,"_5":14349,"_27386":50540,"_2933":50735},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3450":546,"_30100":484,"_20891":50737,"_5":14349,"_27386":50540,"_2933":50738},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3450":547,"_30100":484,"_20891":50740,"_5":14349,"_27386":50540,"_2933":50741},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3450":548,"_30100":484,"_20891":50743,"_5":14349,"_27386":50544,"_2933":50744},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3450":549,"_30100":484,"_20891":50746,"_5":14349,"_27386":50544,"_2933":50747},[],"The decision is made with the domain operation context:",{"_3450":550,"_30100":484,"_20891":50749,"_5":14349,"_27386":50544,"_2933":50750},[],"The middleware extracts the credential and resolves the matching principals.",{"_3450":551,"_30100":484,"_20891":50752,"_5":14349,"_27386":50544,"_2933":50753},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3450":552,"_30100":484,"_20891":50755,"_5":14349,"_27386":50544,"_2933":50756},[],"`authz` gathers the entity rules of the granted policies.",{"_3450":553,"_30100":484,"_20891":50758,"_5":14349,"_27386":50544,"_2933":50759},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3450":554,"_30100":484,"_20891":50761,"_5":14349,"_27386":50544,"_2933":50762},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3450":555,"_30100":484,"_20891":50764,"_5":14349,"_27386":50544,"_2933":50765},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3450":556,"_30100":484,"_20891":50767,"_5":14349,"_27386":50544,"_2933":50768},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3450":557,"_30100":484,"_20891":50770,"_5":14349,"_27386":50544,"_2933":50771},[],"Actions fall into two groups:",{"_3450":558,"_30100":484,"_20891":50773,"_5":14349,"_27386":50544,"_2933":50774},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3450":559,"_30100":484,"_20891":50776,"_5":14349,"_27386":50544,"_2933":50777},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3450":560,"_30100":484,"_20891":50779,"_5":14349,"_27386":50544,"_2933":50780},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3450":561,"_30100":484,"_20891":50782,"_5":14349,"_27386":50548,"_2933":50783},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3450":562,"_30100":484,"_20891":50785,"_5":14349,"_27386":50548,"_2933":50786},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3450":563,"_30100":484,"_20891":50788,"_5":14349,"_27386":50548,"_2933":50789},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3450":564,"_30100":484,"_20891":50791,"_5":14349,"_27386":50552,"_2933":50792},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3450":565,"_30100":484,"_20891":50794,"_5":14349,"_27386":50552,"_2933":50795},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3450":566,"_30100":484,"_20891":50797,"_5":14349,"_27386":50552,"_2933":50798},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3450":567,"_30100":484,"_20891":50800,"_5":14349,"_27386":50552,"_2933":50801},[],"The implemented operators are:",{"_3450":568,"_30100":484,"_20891":50803,"_5":14349,"_27386":50552,"_2933":50804},[],"`equals`, for exact equality;",{"_3450":569,"_30100":484,"_20891":50806,"_5":14349,"_27386":50552,"_2933":50807},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3450":570,"_30100":484,"_20891":50809,"_5":14349,"_27386":50552,"_2933":50810},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3450":571,"_30100":484,"_20891":50812,"_5":14349,"_27386":50552,"_2933":50813},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3450":572,"_30100":484,"_20891":50815,"_5":14349,"_27386":50556,"_2933":50816},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3450":573,"_30100":484,"_20891":50818,"_5":14349,"_27386":50556,"_2933":50819},[],"The available modes are:",{"_3450":574,"_30100":484,"_20891":50821,"_5":14349,"_27386":50556,"_2933":50822},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3450":575,"_30100":484,"_20891":50824,"_5":14349,"_27386":50556,"_2933":50825},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3450":576,"_30100":484,"_20891":50827,"_5":14349,"_27386":50556,"_2933":50828},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3450":577,"_30100":484,"_20891":50830,"_5":14349,"_27386":50556,"_2933":50831},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3450":578,"_30100":484,"_20891":50833,"_5":14349,"_27386":50556,"_2933":50834},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3450":579,"_30100":484,"_20891":50836,"_5":14349,"_27386":50556,"_2933":50837},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3450":580,"_30100":484,"_20891":50839,"_5":14349,"_27386":50560,"_2933":50840},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3450":581,"_30100":484,"_20891":50842,"_5":14349,"_27386":50560,"_2933":50843},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3450":582,"_30100":484,"_20891":50845,"_5":14349,"_27386":50560,"_2933":50846},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3450":583,"_30100":484,"_20891":50848,"_5":14349,"_27386":50560,"_2933":50849},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3450":584,"_30100":484,"_20891":50851,"_5":14349,"_27386":50568,"_2933":50852},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3450":585,"_30100":484,"_20891":50854,"_5":14349,"_27386":50568,"_2933":50855},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3450":586,"_30100":484,"_20891":50857,"_5":14349,"_27386":50572,"_2933":50858},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3450":587,"_30100":484,"_20891":50860,"_5":14349,"_27386":50572,"_2933":50861},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3450":588,"_30100":484,"_20891":50863,"_5":14349,"_27386":50576,"_2933":50864},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3450":589,"_30100":484,"_20891":50866,"_5":14349,"_27386":50576,"_2933":50867},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3450":590,"_30100":484,"_20891":50869,"_5":14349,"_27386":50576,"_2933":50870},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3450":591,"_30100":484,"_20891":50872,"_5":14349,"_27386":50580,"_2933":50873},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3450":592,"_30100":484,"_20891":50875,"_5":14349,"_27386":50580,"_2933":50876},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3450":593,"_30100":484,"_20891":50878,"_5":14349,"_27386":50580,"_2933":50879},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3450":594,"_30100":484,"_20891":50881,"_5":14349,"_27386":50580,"_2933":50882},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3450":595,"_30100":484,"_20891":50884,"_5":14349,"_27386":50580,"_2933":50885},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3450":596,"_30100":484,"_20891":50887,"_5":14349,"_27386":50580,"_2933":50888},[],"Note that:",{"_3450":597,"_30100":484,"_20891":50890,"_5":14349,"_27386":50580,"_2933":50891},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3450":598,"_30100":484,"_20891":50893,"_5":14349,"_27386":50580,"_2933":50894},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3450":599,"_30100":484,"_20891":50896,"_5":14349,"_27386":50580,"_2933":50897},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3450":600,"_30100":484,"_20891":50899,"_5":14349,"_27386":50584,"_2933":50900},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3450":601,"_30100":484,"_20891":50902,"_5":14349,"_27386":50584,"_2933":50903},[],"full and read-only access to certificates and authorities;",{"_3450":602,"_30100":484,"_20891":50905,"_5":14349,"_27386":50584,"_2933":50906},[],"full and read-only access to the KMS;",{"_3450":603,"_30100":484,"_20891":50908,"_5":14349,"_27386":50584,"_2933":50909},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3450":604,"_30100":484,"_20891":50911,"_5":14349,"_27386":50584,"_2933":50912},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3450":605,"_30100":484,"_20891":50914,"_5":14349,"_27386":50584,"_2933":50915},[],"console access;",{"_3450":606,"_30100":484,"_20891":50917,"_5":14349,"_27386":50584,"_2933":50918},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3450":607,"_30100":484,"_20891":50920,"_5":14349,"_27386":50584,"_2933":50921},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3450":608,"_30100":484,"_20891":50923,"_5":14349,"_27386":50584,"_2933":50924},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3450":609,"_30100":484,"_20891":50926,"_5":14349,"_27386":50588,"_2933":50927},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3450":610,"_30100":484,"_20891":50929,"_5":14349,"_27386":50588,"_2933":50930},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3450":611,"_30100":484,"_20891":50932,"_5":14349,"_27386":50588,"_2933":50933},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3450":612,"_30100":484,"_20891":50935,"_5":14349,"_27386":50591,"_2933":50936},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3450":613,"_30100":484,"_20891":50938,"_5":14349,"_27386":50595,"_2933":50939},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3450":614,"_30100":484,"_20891":50941,"_5":14349,"_27386":50595,"_2933":50942},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3450":615,"_30100":484,"_20891":50944,"_5":14349,"_27386":50599,"_2933":50945},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3450":616,"_30100":484,"_20891":50947,"_5":14349,"_27386":50603,"_2933":50948},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3450":617,"_30100":484,"_20891":50950,"_5":14349,"_27386":50607,"_2933":50951},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3450":618,"_30100":484,"_20891":50953,"_5":14349,"_27386":50611,"_2933":50954},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3450":619,"_30100":484,"_20891":50956,"_5":14349,"_27386":50611,"_2933":50957},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3450":620,"_30100":484,"_20891":50959,"_5":14349,"_27386":50615,"_2933":50960},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3450":621,"_30100":484,"_20891":50962,"_5":14349,"_27386":50615,"_2933":50963},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3450":622,"_30100":484,"_20891":50965,"_5":14349,"_27386":50615,"_2933":50966},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3450":623,"_30100":484,"_20891":50968,"_5":14349,"_27386":50615,"_2933":50969},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3450":624,"_30100":484,"_20891":50971,"_5":14349,"_27386":50615,"_2933":50972},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3450":625,"_30100":484,"_20891":50974,"_5":14349,"_27386":50615,"_2933":50975},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3450":626,"_30100":484,"_20891":50977,"_5":14349,"_27386":50615,"_2933":50978},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3450":627,"_30100":484,"_20891":50980,"_5":14349,"_27386":50615,"_2933":50981},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3450":628,"_30100":484,"_20891":50983,"_5":14349,"_27386":50619,"_2933":50984},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3450":629,"_30100":484,"_20891":50986,"_5":14349,"_27386":50619,"_2933":50987},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3450":630,"_30100":484,"_20891":50989,"_5":14349,"_27386":50619,"_2933":50990},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3450":631,"_30100":484,"_20891":50992,"_5":14349,"_27386":50623,"_2933":50993},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3450":632,"_30100":484,"_20891":50995,"_5":14349,"_27386":50623,"_2933":50996},[],"Use groups or stable roles for people and independent identities for automations.",{"_3450":633,"_30100":484,"_20891":50998,"_5":14349,"_27386":50623,"_2933":50999},[],"Keep at least two recovery administrators and test their access periodically.",{"_3450":634,"_30100":484,"_20891":51001,"_5":14349,"_27386":50623,"_2933":51002},[],"Review active principals, their matches and their grants after IdP changes.",{"_3450":635,"_30100":484,"_20891":51004,"_5":14349,"_27386":50623,"_2933":51005},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3450":636,"_30100":484,"_20891":51007,"_5":14349,"_27386":50623,"_2933":51008},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3450":637,"_30100":484,"_20891":51010,"_5":14349,"_27386":50623,"_2933":51011},[],"Always test one allowed and one denied operation for each role.",{"_3450":638,"_30100":484,"_20891":51013,"_5":14349,"_27386":50623,"_2933":51014},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3450":639,"_30100":484,"_20891":51016,"_5":14349,"_27386":50631,"_2933":51017},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3450":640,"_30100":484,"_20891":51019,"_5":14349,"_27386":50635,"_2933":51020},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3450":641,"_30100":484,"_20891":51022,"_5":14349,"_27386":50635,"_2933":51023},[],"that an active principal of the correct type exists;",{"_3450":642,"_30100":484,"_20891":51025,"_5":14349,"_27386":50635,"_2933":51026},[],"that the claim paths and values match the real token exactly;",{"_3450":643,"_30100":484,"_20891":51028,"_5":14349,"_27386":50635,"_2933":51029},[],"that all of the principal's conditions hold;",{"_3450":644,"_30100":484,"_20891":51031,"_5":14349,"_27386":50635,"_2933":51032},[],"that the principal has the expected policy granted;",{"_3450":645,"_30100":484,"_20891":51034,"_5":14349,"_27386":50635,"_2933":51035},[],"that the policy includes the action and the requested resource type or route;",{"_3450":646,"_30100":484,"_20891":51037,"_5":14349,"_27386":50635,"_2933":51038},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3450":647,"_30100":484,"_20891":51040,"_5":14349,"_27386":50635,"_2933":51041},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3450":648,"_30100":484,"_20891":51043,"_5":14349,"_27386":50639,"_2933":51044},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3450":649,"_30100":484,"_20891":51046,"_5":14349,"_27386":50643,"_2933":51047},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3450":650,"_30100":484,"_20891":51049,"_5":14349,"_27386":50647,"_2933":51050},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3450":651,"_30100":484,"_20891":51052,"_5":14349,"_27386":50647,"_2933":51053},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3450":652,"_30100":652,"_5":14701,"_2933":51055,"_30453":51056,"_20891":51057,"_27386":652},"Alerts and subscriptions",[49052,50520,50521],[],{"_3450":653,"_30100":652,"_20891":51059,"_5":14349,"_27386":652,"_2933":51060},[],"Send PKI events to people and external systems.",{"_3450":654,"_30100":652,"_5":30450,"_20891":51062,"_27386":51063,"_2933":51064},[],"/docs/pr-preview/pr-61/platform/administration/alerts#how-it-works","How it works",{"_3450":655,"_30100":652,"_5":30450,"_20891":51066,"_27386":51067,"_2933":51068},[],"/docs/pr-preview/pr-61/platform/administration/alerts#available-channels","Available channels",{"_3450":656,"_30100":652,"_5":30450,"_20891":51070,"_27386":51071,"_2933":51072},[],"/docs/pr-preview/pr-61/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3450":657,"_30100":652,"_5":30450,"_20891":51074,"_27386":51075,"_2933":51076},[],"/docs/pr-preview/pr-61/platform/administration/alerts#choose-the-event","Choose the event",{"_3450":658,"_30100":652,"_5":30450,"_20891":51078,"_27386":51079,"_2933":51080},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3450":659,"_30100":652,"_5":30450,"_20891":51082,"_27386":51083,"_2933":51084},[],"/docs/pr-preview/pr-61/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3450":660,"_30100":652,"_5":30450,"_20891":51086,"_27386":51087,"_2933":51088},[],"/docs/pr-preview/pr-61/platform/administration/alerts#review-and-activate","Review and activate",{"_3450":661,"_30100":652,"_5":30450,"_20891":51090,"_27386":51091,"_2933":51092},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3450":662,"_30100":652,"_5":30450,"_20891":51094,"_27386":51095,"_2933":51096},[],"/docs/pr-preview/pr-61/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3450":663,"_30100":652,"_5":30450,"_20891":51098,"_27386":51099,"_2933":51100},[],"/docs/pr-preview/pr-61/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3450":664,"_30100":652,"_5":30450,"_20891":51102,"_27386":51103,"_2933":51104},[],"/docs/pr-preview/pr-61/platform/administration/alerts#event-families","Event families",{"_3450":665,"_30100":652,"_20891":51106,"_5":14349,"_27386":652,"_2933":51107},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3450":666,"_30100":652,"_20891":51109,"_5":14349,"_27386":51063,"_2933":51110},[],"A service publishes a domain event.",{"_3450":667,"_30100":652,"_20891":51112,"_5":14349,"_27386":51063,"_2933":51113},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3450":668,"_30100":652,"_20891":51115,"_5":14349,"_27386":51063,"_2933":51116},[],"Each subscription's filter decides whether it should be notified.",{"_3450":669,"_30100":652,"_20891":51118,"_5":14349,"_27386":51063,"_2933":51119},[],"Lamassu delivers the event to the configured channel.",{"_3450":670,"_30100":652,"_20891":51121,"_5":14349,"_27386":51063,"_2933":51122},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3450":671,"_30100":652,"_20891":51124,"_5":14349,"_27386":51067,"_2933":51125},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3450":672,"_30100":652,"_20891":51127,"_5":14349,"_27386":51067,"_2933":51128},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3450":673,"_30100":652,"_20891":51130,"_5":14349,"_27386":51067,"_2933":51131},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3450":674,"_30100":652,"_20891":51133,"_5":14349,"_27386":51067,"_2933":51134},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3450":675,"_30100":652,"_20891":51136,"_5":14349,"_27386":51067,"_2933":51137},[],"`apikey_options` requires `header` and `key`.",{"_3450":676,"_30100":652,"_20891":51139,"_5":14349,"_27386":51067,"_2933":51140},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3450":677,"_30100":652,"_20891":51142,"_5":14349,"_27386":51067,"_2933":51143},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3450":678,"_30100":652,"_20891":51145,"_5":14349,"_27386":51067,"_2933":51146},[],"The alerts API reference documents the full `http_client` schema.",{"_3450":679,"_30100":652,"_20891":51148,"_5":14349,"_27386":51075,"_2933":51149},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3450":680,"_30100":652,"_20891":51151,"_5":14349,"_27386":51079,"_2933":51152},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3450":681,"_30100":652,"_20891":51154,"_5":14349,"_27386":51083,"_2933":51155},[],"Add a filter if you don't want to receive every instance of the event.",{"_3450":682,"_30100":652,"_20891":51157,"_5":14349,"_27386":51083,"_2933":51158},[],"**None** notifies all instances of the event.",{"_3450":683,"_30100":652,"_20891":51160,"_5":14349,"_27386":51083,"_2933":51161},[],"**JSON Path** evaluates one or more specific fields.",{"_3450":684,"_30100":652,"_20891":51163,"_5":14349,"_27386":51083,"_2933":51164},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3450":685,"_30100":652,"_20891":51166,"_5":14349,"_27386":51083,"_2933":51167},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3450":686,"_30100":652,"_20891":51169,"_5":14349,"_27386":51083,"_2933":51170},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3450":687,"_30100":652,"_20891":51172,"_5":14349,"_27386":51083,"_2933":51173},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3450":688,"_30100":652,"_20891":51175,"_5":14349,"_27386":51087,"_2933":51176},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3450":689,"_30100":652,"_20891":51178,"_5":14349,"_27386":51091,"_2933":51179},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3450":690,"_30100":652,"_20891":51181,"_5":14349,"_27386":51091,"_2933":51182},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3450":691,"_30100":652,"_20891":51184,"_5":14349,"_27386":51091,"_2933":51185},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3450":692,"_30100":652,"_20891":51187,"_5":14349,"_27386":51091,"_2933":51188},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3450":693,"_30100":652,"_20891":51190,"_5":14349,"_27386":51091,"_2933":51191},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3450":694,"_30100":652,"_20891":51193,"_5":14349,"_27386":51091,"_2933":51194},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3450":695,"_30100":652,"_20891":51196,"_5":14349,"_27386":51091,"_2933":51197},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3450":696,"_30100":652,"_20891":51199,"_5":14349,"_27386":51091,"_2933":51200},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3450":697,"_30100":652,"_20891":51202,"_5":14349,"_27386":51095,"_2933":51203},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3450":698,"_30100":652,"_20891":51205,"_5":14349,"_27386":51095,"_2933":51206},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3450":699,"_30100":652,"_20891":51208,"_5":14349,"_27386":51095,"_2933":51209},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3450":700,"_30100":652,"_20891":51211,"_5":14349,"_27386":51095,"_2933":51212},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3450":701,"_30100":652,"_20891":51214,"_5":14349,"_27386":51095,"_2933":51215},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3450":702,"_30100":652,"_20891":51217,"_5":14349,"_27386":51095,"_2933":51218},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3450":703,"_30100":652,"_20891":51220,"_5":14349,"_27386":51095,"_2933":51221},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3450":704,"_30100":652,"_20891":51223,"_5":14349,"_27386":51095,"_2933":51224},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3450":705,"_30100":652,"_20891":51226,"_5":14349,"_27386":51099,"_2933":51227},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3450":706,"_30100":652,"_20891":51229,"_5":14349,"_27386":51099,"_2933":51230},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3450":707,"_30100":652,"_20891":51232,"_5":14349,"_27386":51103,"_2933":51233},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3450":708,"_30100":652,"_20891":51235,"_5":14349,"_27386":51103,"_2933":51236},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3450":709,"_30100":652,"_20891":51238,"_5":14349,"_27386":51103,"_2933":51239},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3450":710,"_30100":652,"_20891":51241,"_5":14349,"_27386":51103,"_2933":51242},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3450":711,"_30100":652,"_20891":51244,"_5":14349,"_27386":51103,"_2933":51245},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3450":712,"_30100":652,"_20891":51247,"_5":14349,"_27386":51103,"_2933":51248},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3450":713,"_30100":652,"_20891":51250,"_5":14349,"_27386":51103,"_2933":51251},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3450":714,"_30100":652,"_20891":51253,"_5":14349,"_27386":51103,"_2933":51254},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3450":715,"_30100":652,"_20891":51256,"_5":14349,"_27386":51103,"_2933":51257},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3450":716,"_30100":716,"_5":14701,"_2933":51259,"_30453":51260,"_20891":51261,"_27386":716},"Audit logs",[49052,50520,50521],[],{"_3450":717,"_30100":716,"_20891":51263,"_5":14349,"_27386":716,"_2933":51264},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3450":718,"_30100":716,"_5":30450,"_20891":51266,"_27386":51267,"_2933":51268},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3450":719,"_30100":716,"_5":30450,"_20891":51270,"_27386":51271,"_2933":51272},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#coverage","Coverage",{"_3450":720,"_30100":716,"_5":30450,"_20891":51274,"_27386":51275,"_2933":51276},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3450":721,"_30100":716,"_5":30450,"_20891":51278,"_27386":51279,"_2933":51280},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3450":722,"_30100":716,"_5":30450,"_20891":51282,"_27386":51283,"_2933":51284},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3450":723,"_30100":716,"_5":30450,"_20891":51286,"_27386":51287,"_2933":51288},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3450":724,"_30100":716,"_5":30450,"_20891":51290,"_27386":51291,"_2933":51292},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3450":725,"_30100":716,"_5":30450,"_20891":51294,"_27386":51295,"_2933":51296},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3450":726,"_30100":716,"_5":30450,"_20891":51298,"_27386":51299,"_2933":51300},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3450":727,"_30100":716,"_5":30450,"_20891":51302,"_27386":51303,"_2933":51304},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3450":728,"_30100":716,"_5":30450,"_20891":51306,"_27386":51307,"_2933":51308},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3450":729,"_30100":716,"_20891":51310,"_5":14349,"_27386":716,"_2933":51311},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3450":730,"_30100":716,"_20891":51313,"_5":14349,"_27386":51267,"_2933":51314},[],"The audit body includes:",{"_3450":731,"_30100":716,"_20891":51316,"_5":14349,"_27386":51267,"_2933":51317},[],"input: data received by the operation;",{"_3450":732,"_30100":716,"_20891":51319,"_5":14349,"_27386":51267,"_2933":51320},[],"has\\_error: whether the service returned an error;",{"_3450":733,"_30100":716,"_20891":51322,"_5":14349,"_27386":51267,"_2933":51323},[],"output: produced result or error message;",{"_3450":734,"_30100":716,"_20891":51325,"_5":14349,"_27386":51267,"_2933":51326},[],"principals: identifiers of the principals that matched the request.",{"_3450":735,"_30100":716,"_20891":51328,"_5":14349,"_27386":51267,"_2933":51329},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3450":736,"_30100":716,"_20891":51331,"_5":14349,"_27386":51267,"_2933":51332},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3450":737,"_30100":716,"_20891":51334,"_5":14349,"_27386":51271,"_2933":51335},[],"The backend applies auditing to mutations of:",{"_3450":738,"_30100":716,"_20891":51337,"_5":14349,"_27386":51271,"_2933":51338},[],"authorities, certificates and issuance profiles;",{"_3450":739,"_30100":716,"_20891":51340,"_5":14349,"_27386":51271,"_2933":51341},[],"keys and KMS engines;",{"_3450":740,"_30100":716,"_20891":51343,"_5":14349,"_27386":51271,"_2933":51344},[],"devices and identities;",{"_3450":741,"_30100":716,"_20891":51346,"_5":14349,"_27386":51271,"_2933":51347},[],"DMSs and enrollment operations;",{"_3450":742,"_30100":716,"_20891":51349,"_5":14349,"_27386":51271,"_2933":51350},[],"validation functions and CRL;",{"_3450":743,"_30100":716,"_20891":51352,"_5":14349,"_27386":51271,"_2933":51353},[],"principals, policies and authorization grants.",{"_3450":744,"_30100":716,"_20891":51355,"_5":14349,"_27386":51271,"_2933":51356},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3450":745,"_30100":716,"_20891":51358,"_5":14349,"_27386":51275,"_2933":51359},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3450":746,"_30100":716,"_20891":51361,"_5":14349,"_27386":51275,"_2933":51362},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3450":747,"_30100":716,"_20891":51364,"_5":14349,"_27386":51275,"_2933":51365},[],"Design the consumer to:",{"_3450":748,"_30100":716,"_20891":51367,"_5":14349,"_27386":51275,"_2933":51368},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3450":749,"_30100":716,"_20891":51370,"_5":14349,"_27386":51275,"_2933":51371},[],"keep the complete CloudEvent unmodified;",{"_3450":750,"_30100":716,"_20891":51373,"_5":14349,"_27386":51275,"_2933":51374},[],"record the ingestion time and detect duplicates by ID;",{"_3450":751,"_30100":716,"_20891":51376,"_5":14349,"_27386":51275,"_2933":51377},[],"encrypt in transit and at rest;",{"_3450":752,"_30100":716,"_20891":51379,"_5":14349,"_27386":51275,"_2933":51380},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3450":753,"_30100":716,"_20891":51382,"_5":14349,"_27386":51275,"_2933":51383},[],"apply an explicit retention and legal hold policy;",{"_3450":754,"_30100":716,"_20891":51385,"_5":14349,"_27386":51275,"_2933":51386},[],"alert if it stops consuming or the pending queue grows.",{"_3450":755,"_30100":716,"_20891":51388,"_5":14349,"_27386":51279,"_2933":51389},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3450":756,"_30100":716,"_20891":51391,"_5":14349,"_27386":51279,"_2933":51392},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3450":757,"_30100":716,"_20891":51394,"_5":14349,"_27386":51287,"_2933":51395},[],"Start from the reported time and normalize every source to UTC.",{"_3450":758,"_30100":716,"_20891":51397,"_5":14349,"_27386":51291,"_2933":51398},[],"Filter by event type, service source and resource identifier.",{"_3450":759,"_30100":716,"_20891":51400,"_5":14349,"_27386":51295,"_2933":51401},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3450":760,"_30100":716,"_20891":51403,"_5":14349,"_27386":51299,"_2933":51404},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3450":761,"_30100":716,"_20891":51406,"_5":14349,"_27386":51303,"_2933":51407},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3450":762,"_30100":716,"_20891":51409,"_5":14349,"_27386":51307,"_2933":51410},[],"Generate a controlled mutation in a test environment and check that:",{"_3450":763,"_30100":716,"_20891":51412,"_5":14349,"_27386":51307,"_2933":51413},[],"a successful audit event appears;",{"_3450":764,"_30100":716,"_20891":51415,"_5":14349,"_27386":51307,"_2933":51416},[],"the principal matches the identity used;",{"_3450":765,"_30100":716,"_20891":51418,"_5":14349,"_27386":51307,"_2933":51419},[],"the consumer persists it exactly once;",{"_3450":766,"_30100":716,"_20891":51421,"_5":14349,"_27386":51307,"_2933":51422},[],"it can be retrieved by resource, actor and period;",{"_3450":767,"_30100":716,"_20891":51424,"_5":14349,"_27386":51307,"_2933":51425},[],"a consumer outage raises an alert.",{"_3450":768,"_30100":716,"_20891":51427,"_5":14349,"_27386":51307,"_2933":51428},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3450":769,"_30100":769,"_5":14701,"_2933":51430,"_30453":51431,"_20891":51432,"_27386":769},"Platform architecture",[49052,50520],[],{"_3450":770,"_30100":769,"_20891":51434,"_5":14349,"_27386":769,"_2933":51435},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3450":771,"_30100":769,"_5":30450,"_20891":51437,"_27386":51438,"_2933":51439},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#control-plane","Control plane",{"_3450":772,"_30100":769,"_5":30450,"_20891":51441,"_27386":51442,"_2933":51443},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3450":773,"_30100":769,"_5":30450,"_20891":51445,"_27386":51446,"_2933":51447},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3450":774,"_30100":769,"_5":30450,"_20891":51449,"_27386":51450,"_2933":51451},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#status-and-validation","Status and validation",{"_3450":775,"_30100":769,"_5":30450,"_20891":51453,"_27386":51454,"_2933":51455},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3450":776,"_30100":769,"_20891":51457,"_5":14349,"_27386":769,"_2933":51458},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3450":777,"_30100":769,"_20891":51460,"_5":14349,"_27386":769,"_2933":51461},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3450":778,"_30100":769,"_20891":51463,"_5":14349,"_27386":51438,"_2933":51464},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3450":779,"_30100":769,"_20891":51466,"_5":14349,"_27386":51442,"_2933":51467},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3450":780,"_30100":769,"_20891":51469,"_5":14349,"_27386":51446,"_2933":51470},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3450":781,"_30100":769,"_20891":51472,"_5":14349,"_27386":51450,"_2933":51473},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3450":782,"_30100":769,"_20891":51475,"_5":14349,"_27386":51454,"_2933":51476},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3450":783,"_30100":783,"_5":14701,"_2933":51478,"_30453":51479,"_20891":51480,"_27386":783},"How Lamassu works",[49052,50520],[],{"_3450":784,"_30100":783,"_20891":51482,"_5":14349,"_27386":783,"_2933":51483},[],"The mental model of trust, keys, certificates and devices.",{"_3450":785,"_30100":783,"_5":30450,"_20891":51485,"_27386":51486,"_2933":51487},[],"/docs/pr-preview/pr-61/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3450":786,"_30100":783,"_5":30450,"_20891":51489,"_27386":51490,"_2933":51491},[],"/docs/pr-preview/pr-61/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3450":787,"_30100":783,"_20891":51493,"_5":14349,"_27386":783,"_2933":51494},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3450":788,"_30100":783,"_20891":51496,"_5":14349,"_27386":51486,"_2933":51497},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3450":789,"_30100":783,"_20891":51499,"_5":14349,"_27386":51486,"_2933":51500},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3450":790,"_30100":783,"_20891":51502,"_5":14349,"_27386":51486,"_2933":51503},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3450":791,"_30100":783,"_20891":51505,"_5":14349,"_27386":51486,"_2933":51506},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3450":792,"_30100":783,"_20891":51508,"_5":14349,"_27386":51486,"_2933":51509},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3450":793,"_30100":783,"_20891":51511,"_5":14349,"_27386":51490,"_2933":51512},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3450":794,"_30100":783,"_20891":51514,"_5":14349,"_27386":51490,"_2933":51515},[],"A DMS relates that CA to an enrollment policy.",{"_3450":795,"_30100":783,"_20891":51517,"_5":14349,"_27386":51490,"_2933":51518},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3450":796,"_30100":783,"_20891":51520,"_5":14349,"_27386":51490,"_2933":51521},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3450":797,"_30100":783,"_20891":51523,"_5":14349,"_27386":51490,"_2933":51524},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3450":798,"_30100":783,"_20891":51526,"_5":14349,"_27386":51490,"_2933":51527},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3450":799,"_30100":783,"_20891":51529,"_5":14349,"_27386":51490,"_2933":51530},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3450":800,"_30100":800,"_5":14701,"_2933":51532,"_30453":51533,"_20891":51535,"_27386":800},"Devices and identities",[49052,50520,51534,51532],"IoT Fleets",[],{"_3450":801,"_30100":800,"_20891":51537,"_5":14349,"_27386":800,"_2933":51538},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3450":802,"_30100":800,"_5":30450,"_20891":51540,"_27386":51541,"_2933":51542},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#device-states","Device states",{"_3450":803,"_30100":800,"_5":30450,"_20891":51544,"_27386":51545,"_2933":51546},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3450":804,"_30100":800,"_5":30450,"_20891":51548,"_27386":51549,"_2933":51550},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3450":805,"_30100":800,"_5":30450,"_20891":51552,"_27386":51553,"_2933":51554},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3450":806,"_30100":800,"_5":30450,"_20891":51556,"_27386":51557,"_2933":51558},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3450":807,"_30100":800,"_5":30450,"_20891":51560,"_27386":51561,"_2933":51562},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3450":808,"_30100":800,"_5":30450,"_20891":51564,"_27386":51565,"_2933":51566},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3450":809,"_30100":800,"_5":30450,"_20891":51568,"_27386":51569,"_2933":51570},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3450":810,"_30100":800,"_5":30450,"_20891":51572,"_27386":51573,"_2933":51574},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3450":811,"_30100":800,"_5":30450,"_20891":51576,"_27386":51577,"_2933":51578},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3450":812,"_30100":800,"_5":30450,"_20891":51580,"_27386":51581,"_2933":51582},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3450":813,"_30100":800,"_20891":51584,"_5":14349,"_27386":800,"_2933":51585},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3450":814,"_30100":800,"_20891":51587,"_5":14349,"_27386":800,"_2933":51588},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3450":815,"_30100":800,"_20891":51590,"_5":14349,"_27386":51541,"_2933":51591},[],"Operational view",{"_3450":816,"_30100":800,"_20891":51593,"_5":14349,"_27386":51541,"_2933":51594},[],"Meaning",{"_3450":817,"_30100":800,"_20891":51596,"_5":14349,"_27386":51541,"_2933":51597},[],"**No Identity**",{"_3450":818,"_30100":800,"_20891":51599,"_5":14349,"_27386":51541,"_2933":51600},[],"A record exists without an associated identity.",{"_3450":819,"_30100":800,"_20891":51602,"_5":14349,"_27386":51541,"_2933":51603},[],"**Active**",{"_3450":820,"_30100":800,"_20891":51605,"_5":14349,"_27386":51541,"_2933":51606},[],"The slot is active; also check certificate dates, status and usages.",{"_3450":821,"_30100":800,"_20891":51608,"_5":14349,"_27386":51541,"_2933":51609},[],"**Renewal Pending**",{"_3450":822,"_30100":800,"_20891":51611,"_5":14349,"_27386":51541,"_2933":51612},[],"The identity is in the operational renewal window.",{"_3450":823,"_30100":800,"_20891":51614,"_5":14349,"_27386":51541,"_2933":51615},[],"**Expiring Soon**",{"_3450":824,"_30100":800,"_20891":51617,"_5":14349,"_27386":51541,"_2933":51618},[],"Expiration is approaching according to configured thresholds.",{"_3450":825,"_30100":800,"_20891":51620,"_5":14349,"_27386":51541,"_2933":51621},[],"**Expired**",{"_3450":826,"_30100":800,"_20891":51623,"_5":14349,"_27386":51541,"_2933":51624},[],"The identity has expired.",{"_3450":827,"_30100":800,"_20891":51626,"_5":14349,"_27386":51541,"_2933":51627},[],"**Revoked**",{"_3450":828,"_30100":800,"_20891":51629,"_5":14349,"_27386":51541,"_2933":51630},[],"The identity is marked revoked.",{"_3450":829,"_30100":800,"_20891":51632,"_5":14349,"_27386":51541,"_2933":51633},[],"**Decommissioned**",{"_3450":830,"_30100":800,"_20891":51635,"_5":14349,"_27386":51541,"_2933":51636},[],"The record is retired and ordinary updates do not restore operation.",{"_3450":831,"_30100":800,"_20891":51638,"_5":14349,"_27386":51541,"_2933":51639},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3450":832,"_30100":800,"_20891":51641,"_5":14349,"_27386":51545,"_2933":51642},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3450":833,"_30100":800,"_20891":51644,"_5":14349,"_27386":51545,"_2933":51645},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3450":834,"_30100":800,"_20891":51647,"_5":14349,"_27386":51545,"_2933":51648},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3450":835,"_30100":800,"_20891":51650,"_5":14349,"_27386":51545,"_2933":51651},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3450":836,"_30100":800,"_20891":51653,"_5":14349,"_27386":51549,"_2933":51654},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3450":837,"_30100":800,"_20891":51656,"_5":14349,"_27386":51553,"_2933":51657},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3450":838,"_30100":800,"_20891":51659,"_5":14349,"_27386":51557,"_2933":51660},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3450":839,"_30100":800,"_20891":51662,"_5":14349,"_27386":51561,"_2933":51663},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3450":840,"_30100":800,"_20891":51665,"_5":14349,"_27386":51565,"_2933":51666},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3450":841,"_30100":800,"_20891":51668,"_5":14349,"_27386":51565,"_2933":51669},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3450":842,"_30100":800,"_20891":51671,"_5":14349,"_27386":51569,"_2933":51672},[],"From **No Identity**, use **Assign Identity**:",{"_3450":843,"_30100":800,"_20891":51674,"_5":14349,"_27386":51569,"_2933":51675},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3450":844,"_30100":800,"_20891":51677,"_5":14349,"_27386":51569,"_2933":51678},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3450":845,"_30100":800,"_20891":51680,"_5":14349,"_27386":51569,"_2933":51681},[],"Confirm and read the serial, active version and history again.",{"_3450":846,"_30100":800,"_20891":51683,"_5":14349,"_27386":51569,"_2933":51684},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3450":847,"_30100":800,"_20891":51686,"_5":14349,"_27386":51569,"_2933":51687},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3450":848,"_30100":800,"_20891":51689,"_5":14349,"_27386":51573,"_2933":51690},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3450":849,"_30100":800,"_20891":51692,"_5":14349,"_27386":51573,"_2933":51693},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3450":850,"_30100":800,"_20891":51695,"_5":14349,"_27386":51577,"_2933":51696},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3450":851,"_30100":800,"_20891":51698,"_5":14349,"_27386":51577,"_2933":51699},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3450":852,"_30100":800,"_20891":51701,"_5":14349,"_27386":51577,"_2933":51702},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3450":853,"_30100":800,"_20891":51704,"_5":14349,"_27386":51577,"_2933":51705},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3450":854,"_30100":800,"_20891":51707,"_5":14349,"_27386":51581,"_2933":51708},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3450":855,"_30100":800,"_20891":51710,"_5":14349,"_27386":51581,"_2933":51711},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3450":856,"_30100":856,"_5":14701,"_2933":51713,"_30453":51714,"_20891":51716,"_27386":856},"Bootstrap identity and authentication",[49052,50520,51534,51532,51715],"Enrollment with PKI",[],{"_3450":857,"_30100":856,"_20891":51718,"_5":14349,"_27386":856,"_2933":51719},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3450":858,"_30100":856,"_5":30450,"_20891":51721,"_27386":51722,"_2933":51723},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3450":859,"_30100":856,"_5":30450,"_20891":51725,"_27386":51726,"_2933":51727},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3450":860,"_30100":856,"_5":30450,"_20891":51729,"_27386":51730,"_2933":51731},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3450":861,"_30100":856,"_5":30450,"_20891":51733,"_27386":51734,"_2933":51735},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3450":862,"_30100":856,"_5":30450,"_20891":51737,"_27386":51738,"_2933":51739},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3450":863,"_30100":856,"_20891":51741,"_5":14349,"_27386":856,"_2933":51742},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3450":864,"_30100":856,"_20891":51744,"_5":14349,"_27386":51722,"_2933":51745},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3450":865,"_30100":856,"_20891":51747,"_5":14349,"_27386":51722,"_2933":51748},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3450":866,"_30100":856,"_20891":51750,"_5":14349,"_27386":51726,"_2933":51751},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3450":867,"_30100":856,"_20891":51753,"_5":14349,"_27386":51726,"_2933":51754},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3450":868,"_30100":856,"_20891":51756,"_5":14349,"_27386":51726,"_2933":51757},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3450":869,"_30100":856,"_20891":51759,"_5":14349,"_27386":51730,"_2933":51760},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3450":870,"_30100":856,"_20891":51762,"_5":14349,"_27386":51730,"_2933":51763},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3450":871,"_30100":856,"_20891":51765,"_5":14349,"_27386":51734,"_2933":51766},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3450":872,"_30100":856,"_20891":51768,"_5":14349,"_27386":51734,"_2933":51769},[],"Example body:",{"_3450":873,"_30100":856,"_20891":51771,"_5":14349,"_27386":51734,"_2933":51772},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3450":874,"_30100":856,"_20891":51774,"_5":14349,"_27386":51734,"_2933":51775},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3450":875,"_30100":856,"_20891":51777,"_5":14349,"_27386":51734,"_2933":51778},[],"Continuation requires a successful HTTP response and JSON:",{"_3450":876,"_30100":856,"_20891":51780,"_5":14349,"_27386":51734,"_2933":51781},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3450":877,"_30100":856,"_20891":51783,"_5":14349,"_27386":51738,"_2933":51784},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3450":878,"_30100":856,"_20891":51786,"_5":14349,"_27386":51738,"_2933":51787},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3450":879,"_30100":879,"_5":14701,"_2933":51789,"_30453":51790,"_20891":51791,"_27386":879},"Configure and operate the DMS",[49052,50520,51534,51532,51715],[],{"_3450":880,"_30100":879,"_20891":51793,"_5":14349,"_27386":879,"_2933":51794},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3450":881,"_30100":879,"_5":30450,"_20891":51796,"_27386":51797,"_2933":49062},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3450":882,"_30100":879,"_5":30450,"_20891":51799,"_27386":51800,"_2933":51801},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3450":883,"_30100":879,"_5":30450,"_20891":51803,"_27386":51804,"_2933":51805},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3450":884,"_30100":879,"_5":30450,"_20891":51807,"_27386":51808,"_2933":51809},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3450":885,"_30100":879,"_5":30450,"_20891":51811,"_27386":51812,"_2933":51813},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3450":886,"_30100":879,"_5":30450,"_20891":51815,"_27386":51816,"_2933":51817},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3450":887,"_30100":879,"_5":30450,"_20891":51819,"_27386":51820,"_2933":51821},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3450":888,"_30100":879,"_5":30450,"_20891":51823,"_27386":51824,"_2933":51825},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3450":889,"_30100":879,"_5":30450,"_20891":51827,"_27386":51828,"_2933":51829},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3450":890,"_30100":879,"_5":30450,"_20891":51831,"_27386":51832,"_2933":51833},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3450":891,"_30100":879,"_5":30450,"_20891":51835,"_27386":51836,"_2933":51837},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3450":892,"_30100":879,"_5":30450,"_20891":51839,"_27386":51840,"_2933":51841},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3450":893,"_30100":879,"_5":30450,"_20891":51843,"_27386":51844,"_2933":51845},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3450":894,"_30100":879,"_5":30450,"_20891":51847,"_27386":51848,"_2933":51849},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3450":895,"_30100":879,"_5":30450,"_20891":51851,"_27386":51852,"_2933":51853},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3450":896,"_30100":879,"_5":30450,"_20891":51855,"_27386":51856,"_2933":51857},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3450":897,"_30100":879,"_5":30450,"_20891":51859,"_27386":51860,"_2933":51861},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3450":898,"_30100":879,"_5":30450,"_20891":51863,"_27386":51864,"_2933":51865},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3450":899,"_30100":879,"_20891":51867,"_5":14349,"_27386":879,"_2933":51868},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3450":900,"_30100":879,"_20891":51870,"_5":14349,"_27386":51797,"_2933":51871},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3450":901,"_30100":879,"_20891":51873,"_5":14349,"_27386":51797,"_2933":51874},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3450":902,"_30100":879,"_20891":51876,"_5":14349,"_27386":51800,"_2933":51877},[],"Follow the interactive walkthrough to configure a DMS for EST. The example sets **Name** to `DMS Showcase`, which derives the `dms-showcase` identifier used in the EST URLs, and selects two CAs prepared in advance: **DMS Enrollment CA** signs the device identities and **DMS Bootstrap CA** validates the initial credential. The values are for this example; use names and CAs appropriate for your fleet.",{"_3450":903,"_30100":879,"_20891":51879,"_5":14349,"_27386":51804,"_2933":51880},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3450":904,"_30100":879,"_20891":51882,"_5":14349,"_27386":51808,"_2933":51883},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3450":905,"_30100":879,"_20891":51885,"_5":14349,"_27386":51812,"_2933":51886},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3450":906,"_30100":879,"_20891":51888,"_5":14349,"_27386":51816,"_2933":51889},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3450":907,"_30100":879,"_20891":51891,"_5":14349,"_27386":51820,"_2933":51892},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3450":908,"_30100":879,"_20891":51894,"_5":14349,"_27386":51828,"_2933":51895},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3450":909,"_30100":879,"_20891":51897,"_5":14349,"_27386":51828,"_2933":51898},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3450":910,"_30100":879,"_20891":51900,"_5":14349,"_27386":51832,"_2933":51901},[],"`settings.enrollment_settings` field",{"_3450":911,"_30100":879,"_20891":51903,"_5":14349,"_27386":51832,"_2933":51904},[],"Decision",{"_3450":912,"_30100":879,"_20891":51906,"_5":14349,"_27386":51832,"_2933":51907},[],"`protocol`",{"_3450":913,"_30100":879,"_20891":51909,"_5":14349,"_27386":51832,"_2933":51910},[],"`EST_RFC7030` for these operations.",{"_3450":914,"_30100":879,"_20891":51912,"_5":14349,"_27386":51832,"_2933":51913},[],"`enrollment_ca`",{"_3450":915,"_30100":879,"_20891":51915,"_5":14349,"_27386":51832,"_2933":51916},[],"ID of the signing CA.",{"_3450":916,"_30100":879,"_20891":51918,"_5":14349,"_27386":51832,"_2933":51919},[],"`verify_csr_signature`",{"_3450":917,"_30100":879,"_20891":51921,"_5":14349,"_27386":51832,"_2933":51922},[],"Keep `true` to verify CSR key possession.",{"_3450":918,"_30100":879,"_20891":51924,"_5":14349,"_27386":51832,"_2933":51925},[],"`enable_replaceable_enrollment`",{"_3450":919,"_30100":879,"_20891":51927,"_5":14349,"_27386":51832,"_2933":51928},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3450":920,"_30100":879,"_20891":51930,"_5":14349,"_27386":51832,"_2933":51931},[],"`est_rfc7030_settings.auth_mode`",{"_3450":921,"_30100":879,"_20891":51933,"_5":14349,"_27386":51832,"_2933":51934},[],"One of the four authentication modes.",{"_3450":922,"_30100":879,"_20891":51936,"_5":14349,"_27386":51832,"_2933":51937},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3450":923,"_30100":879,"_20891":51939,"_5":14349,"_27386":51836,"_2933":51940},[],"The blocks are independent:",{"_3450":924,"_30100":879,"_20891":51942,"_5":14349,"_27386":51836,"_2933":51943},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3450":925,"_30100":879,"_20891":51945,"_5":14349,"_27386":51836,"_2933":51946},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3450":926,"_30100":879,"_20891":51948,"_5":14349,"_27386":51836,"_2933":51949},[],"`auth_mode`",{"_3450":927,"_30100":879,"_20891":51951,"_5":14349,"_27386":51836,"_2933":51952},[],"Control applied in the configured operation",{"_3450":928,"_30100":879,"_20891":51954,"_5":14349,"_27386":51836,"_2933":51955},[],"`CLIENT_CERTIFICATE`",{"_3450":929,"_30100":879,"_20891":51957,"_5":14349,"_27386":51836,"_2933":51958},[],"Presented certificate validation.",{"_3450":930,"_30100":879,"_20891":51960,"_5":14349,"_27386":51836,"_2933":51961},[],"`EXTERNAL_WEBHOOK`",{"_3450":931,"_30100":879,"_20891":51963,"_5":14349,"_27386":51836,"_2933":51964},[],"Configured webhook authorization.",{"_3450":932,"_30100":879,"_20891":51966,"_5":14349,"_27386":51836,"_2933":51967},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3450":933,"_30100":879,"_20891":51969,"_5":14349,"_27386":51836,"_2933":51970},[],"Certificate validation followed by webhook approval.",{"_3450":934,"_30100":879,"_20891":51972,"_5":14349,"_27386":51836,"_2933":51973},[],"`NO_AUTH`",{"_3450":935,"_30100":879,"_20891":51975,"_5":14349,"_27386":51836,"_2933":51976},[],"No DMS requester authentication.",{"_3450":936,"_30100":879,"_20891":51978,"_5":14349,"_27386":51836,"_2933":51979},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3450":937,"_30100":879,"_20891":51981,"_5":14349,"_27386":51836,"_2933":51982},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3450":938,"_30100":879,"_20891":51984,"_5":14349,"_27386":51836,"_2933":51985},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3450":939,"_30100":879,"_20891":51987,"_5":14349,"_27386":51836,"_2933":51988},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3450":940,"_30100":879,"_20891":51990,"_5":14349,"_27386":51840,"_2933":51991},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3450":941,"_30100":879,"_20891":51993,"_5":14349,"_27386":51840,"_2933":51994},[],"`external_webhook_settings` field",{"_3450":942,"_30100":879,"_20891":51996,"_5":14349,"_27386":51840,"_2933":51904},[],{"_3450":943,"_30100":879,"_20891":51998,"_5":14349,"_27386":51840,"_2933":51999},[],"`url`",{"_3450":944,"_30100":879,"_20891":52001,"_5":14349,"_27386":51840,"_2933":52002},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3450":945,"_30100":879,"_20891":52004,"_5":14349,"_27386":51840,"_2933":52005},[],"`method`",{"_3450":946,"_30100":879,"_20891":52007,"_5":14349,"_27386":51840,"_2933":52008},[],"`POST` or `PUT`; `POST` by default.",{"_3450":947,"_30100":879,"_20891":52010,"_5":14349,"_27386":51840,"_2933":52011},[],"`name`",{"_3450":948,"_30100":879,"_20891":52013,"_5":14349,"_27386":51840,"_2933":52014},[],"Label used in service logs.",{"_3450":949,"_30100":879,"_20891":52016,"_5":14349,"_27386":51840,"_2933":52017},[],"`config.auth_mode`",{"_3450":950,"_30100":879,"_20891":52019,"_5":14349,"_27386":51840,"_2933":52020},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3450":951,"_30100":879,"_20891":52022,"_5":14349,"_27386":51840,"_2933":52023},[],"`config.log_level`",{"_3450":952,"_30100":879,"_20891":52025,"_5":14349,"_27386":51840,"_2933":52026},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3450":953,"_30100":879,"_20891":52028,"_5":14349,"_27386":51840,"_2933":52029},[],"`config.apikey_options`",{"_3450":954,"_30100":879,"_20891":52031,"_5":14349,"_27386":51840,"_2933":52032},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3450":955,"_30100":879,"_20891":52034,"_5":14349,"_27386":51840,"_2933":52035},[],"`config.jwt_options`",{"_3450":956,"_30100":879,"_20891":52037,"_5":14349,"_27386":51840,"_2933":52038},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3450":957,"_30100":879,"_20891":52040,"_5":14349,"_27386":51840,"_2933":52041},[],"`config.mtls_options`",{"_3450":958,"_30100":879,"_20891":52043,"_5":14349,"_27386":51840,"_2933":52044},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3450":959,"_30100":879,"_20891":52046,"_5":14349,"_27386":51840,"_2933":52047},[],"`config.insecure_skip_verify`",{"_3450":960,"_30100":879,"_20891":52049,"_5":14349,"_27386":51840,"_2933":52050},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3450":961,"_30100":879,"_20891":52052,"_5":14349,"_27386":51840,"_2933":52053},[],"`config.call_timeout`",{"_3450":962,"_30100":879,"_20891":52055,"_5":14349,"_27386":51840,"_2933":52056},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3450":963,"_30100":879,"_20891":52058,"_5":14349,"_27386":51840,"_2933":52059},[],"Rules for that configuration:",{"_3450":964,"_30100":879,"_20891":52061,"_5":14349,"_27386":51840,"_2933":52062},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3450":965,"_30100":879,"_20891":52064,"_5":14349,"_27386":51840,"_2933":52065},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3450":966,"_30100":879,"_20891":52067,"_5":14349,"_27386":51840,"_2933":52068},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3450":967,"_30100":879,"_20891":52070,"_5":14349,"_27386":51840,"_2933":52071},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3450":968,"_30100":879,"_20891":52073,"_5":14349,"_27386":51840,"_2933":52074},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3450":969,"_30100":879,"_20891":52076,"_5":14349,"_27386":51840,"_2933":52077},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3450":970,"_30100":879,"_20891":52079,"_5":14349,"_27386":51840,"_2933":52080},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3450":971,"_30100":879,"_20891":52082,"_5":14349,"_27386":51840,"_2933":52083},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3450":972,"_30100":879,"_20891":52085,"_5":14349,"_27386":51840,"_2933":52086},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3450":973,"_30100":879,"_20891":52088,"_5":14349,"_27386":51844,"_2933":52089},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3450":974,"_30100":879,"_20891":52091,"_5":14349,"_27386":51848,"_2933":52092},[],"`settings.reenrollment_settings` field",{"_3450":975,"_30100":879,"_20891":52094,"_5":14349,"_27386":51848,"_2933":49442},[],{"_3450":976,"_30100":879,"_20891":52096,"_5":14349,"_27386":51848,"_2933":52097},[],"`reenrollment_delta`",{"_3450":977,"_30100":879,"_20891":52099,"_5":14349,"_27386":51848,"_2933":52100},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3450":978,"_30100":879,"_20891":52102,"_5":14349,"_27386":51848,"_2933":52103},[],"`preventive_delta`",{"_3450":979,"_30100":879,"_20891":52105,"_5":14349,"_27386":51848,"_2933":52106},[],"Preventive operational monitoring threshold.",{"_3450":980,"_30100":879,"_20891":52108,"_5":14349,"_27386":51848,"_2933":52109},[],"`critical_delta`",{"_3450":981,"_30100":879,"_20891":52111,"_5":14349,"_27386":51848,"_2933":52112},[],"Critical operational monitoring threshold.",{"_3450":982,"_30100":879,"_20891":52114,"_5":14349,"_27386":51848,"_2933":52115},[],"`enable_expired_renewal`",{"_3450":983,"_30100":879,"_20891":52117,"_5":14349,"_27386":51848,"_2933":52118},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3450":984,"_30100":879,"_20891":52120,"_5":14349,"_27386":51848,"_2933":52121},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3450":985,"_30100":879,"_20891":52123,"_5":14349,"_27386":51848,"_2933":52124},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3450":986,"_30100":879,"_20891":52126,"_5":14349,"_27386":51848,"_2933":52127},[],"`revoke_on_reenrollment`",{"_3450":987,"_30100":879,"_20891":52129,"_5":14349,"_27386":51848,"_2933":52130},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3450":988,"_30100":879,"_20891":52132,"_5":14349,"_27386":51848,"_2933":52133},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3450":989,"_30100":879,"_20891":52135,"_5":14349,"_27386":51852,"_2933":52136},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3450":990,"_30100":879,"_20891":52138,"_5":14349,"_27386":51856,"_2933":49436},[],{"_3450":991,"_30100":879,"_20891":52140,"_5":14349,"_27386":51856,"_2933":52141},[],"Published material",{"_3450":992,"_30100":879,"_20891":52143,"_5":14349,"_27386":51856,"_2933":52144},[],"**Include Lamassu System CA**",{"_3450":993,"_30100":879,"_20891":52146,"_5":14349,"_27386":51856,"_2933":52147},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3450":994,"_30100":879,"_20891":52149,"_5":14349,"_27386":51856,"_2933":52150},[],"**Include Enrollment CA**",{"_3450":995,"_30100":879,"_20891":52152,"_5":14349,"_27386":51856,"_2933":52153},[],"Selected issuing CA certificate.",{"_3450":996,"_30100":879,"_20891":52155,"_5":14349,"_27386":51856,"_2933":52156},[],"**Managed CAs**",{"_3450":997,"_30100":879,"_20891":52158,"_5":14349,"_27386":51856,"_2933":52159},[],"Explicitly selected CA certificates.",{"_3450":998,"_30100":879,"_20891":52161,"_5":14349,"_27386":51856,"_2933":52162},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3450":999,"_30100":879,"_20891":52164,"_5":14349,"_27386":51860,"_2933":52165},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3450":1000,"_30100":879,"_20891":52167,"_5":14349,"_27386":51860,"_2933":52168},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3450":1001,"_30100":879,"_20891":52170,"_5":14349,"_27386":51860,"_2933":52171},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3450":1002,"_30100":879,"_20891":52173,"_5":14349,"_27386":51864,"_2933":52174},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3450":1003,"_30100":1003,"_5":14701,"_2933":52176,"_30453":52177,"_20891":52178,"_27386":1003},"Integrate the EST client",[49052,50520,51534,51532,51715],[],{"_3450":1004,"_30100":1003,"_20891":52180,"_5":14349,"_27386":1003,"_2933":52181},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3450":1005,"_30100":1003,"_5":30450,"_20891":52183,"_27386":52184,"_2933":49062},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3450":1006,"_30100":1003,"_5":30450,"_20891":52186,"_27386":52187,"_2933":52188},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3450":1007,"_30100":1003,"_5":30450,"_20891":52190,"_27386":52191,"_2933":52192},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3450":1008,"_30100":1003,"_5":30450,"_20891":52194,"_27386":52195,"_2933":52196},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3450":1009,"_30100":1003,"_5":30450,"_20891":52198,"_27386":52199,"_2933":52200},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3450":1010,"_30100":1003,"_5":30450,"_20891":52202,"_27386":52203,"_2933":52204},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3450":1011,"_30100":1003,"_20891":52206,"_5":14349,"_27386":1003,"_2933":52207},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3450":1012,"_30100":1003,"_20891":52209,"_5":14349,"_27386":52184,"_2933":52210},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3450":1013,"_30100":1003,"_20891":52212,"_5":14349,"_27386":52184,"_2933":52213},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3450":1014,"_30100":1003,"_20891":52215,"_5":14349,"_27386":52184,"_2933":52216},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3450":1015,"_30100":1003,"_20891":52218,"_5":14349,"_27386":52187,"_2933":52219},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3450":1016,"_30100":1003,"_20891":52221,"_5":14349,"_27386":52187,"_2933":52222},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3450":1017,"_30100":1003,"_20891":52224,"_5":14349,"_27386":52191,"_2933":52225},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3450":1018,"_30100":1003,"_20891":52227,"_5":14349,"_27386":52191,"_2933":52228},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3450":1019,"_30100":1003,"_20891":52230,"_5":14349,"_27386":52195,"_2933":52231},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3450":1020,"_30100":1003,"_20891":52233,"_5":14349,"_27386":52195,"_2933":52234},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3450":1021,"_30100":1003,"_20891":52236,"_5":14349,"_27386":52199,"_2933":52237},[],"For a root that issues directly:",{"_3450":1022,"_30100":1003,"_20891":52239,"_5":14349,"_27386":52199,"_2933":52240},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3450":1023,"_30100":1003,"_20891":52242,"_5":14349,"_27386":52199,"_2933":52243},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3450":1024,"_30100":1003,"_20891":52245,"_5":14349,"_27386":52203,"_2933":52246},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3450":1025,"_30100":1025,"_5":14701,"_2933":52248,"_30453":52249,"_20891":52250,"_27386":1025},"EST reference",[49052,50520,51534,51532,51715],[],{"_3450":1026,"_30100":1025,"_20891":52252,"_5":14349,"_27386":1025,"_2933":52253},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3450":1027,"_30100":1025,"_5":30450,"_20891":52255,"_27386":52256,"_2933":52257},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3450":1028,"_30100":1025,"_5":30450,"_20891":52259,"_27386":52260,"_2933":22642},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3450":1029,"_30100":1025,"_5":30450,"_20891":52262,"_27386":52263,"_2933":25996},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3450":1030,"_30100":1025,"_5":30450,"_20891":52265,"_27386":52266,"_2933":26003},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3450":1031,"_30100":1025,"_5":30450,"_20891":52268,"_27386":52269,"_2933":25322},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3450":1032,"_30100":1025,"_5":30450,"_20891":52271,"_27386":52272,"_2933":52273},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3450":1033,"_30100":1025,"_5":30450,"_20891":52275,"_27386":52276,"_2933":52277},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3450":1034,"_30100":1025,"_5":30450,"_20891":52279,"_27386":52280,"_2933":52281},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3450":1035,"_30100":1025,"_20891":52283,"_5":14349,"_27386":1025,"_2933":52284},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3450":1036,"_30100":1025,"_20891":52286,"_5":14349,"_27386":52256,"_2933":52287},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3450":1037,"_30100":1025,"_20891":52289,"_5":14349,"_27386":52256,"_2933":52290},[],"Operation",{"_3450":1038,"_30100":1025,"_20891":52292,"_5":14349,"_27386":52256,"_2933":52293},[],"Method",{"_3450":1039,"_30100":1025,"_20891":52295,"_5":14349,"_27386":52256,"_2933":52296},[],"Authentication and condition",{"_3450":1040,"_30100":1025,"_20891":52298,"_5":14349,"_27386":52256,"_2933":52299},[],"`/cacerts`",{"_3450":1041,"_30100":1025,"_20891":52301,"_5":14349,"_27386":52256,"_2933":52302},[],"GET",{"_3450":1042,"_30100":1025,"_20891":52304,"_5":14349,"_27386":52256,"_2933":52305},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3450":1043,"_30100":1025,"_20891":52307,"_5":14349,"_27386":52256,"_2933":52308},[],"`/simpleenroll`",{"_3450":1044,"_30100":1025,"_20891":52310,"_5":14349,"_27386":52256,"_2933":52311},[],"POST",{"_3450":1045,"_30100":1025,"_20891":52313,"_5":14349,"_27386":52256,"_2933":52314},[],"Initial authentication and DMS registration/replacement policy.",{"_3450":1046,"_30100":1025,"_20891":52316,"_5":14349,"_27386":52256,"_2933":52317},[],"`/simplereenroll`",{"_3450":1047,"_30100":1025,"_20891":52319,"_5":14349,"_27386":52256,"_2933":52311},[],{"_3450":1048,"_30100":1025,"_20891":52321,"_5":14349,"_27386":52256,"_2933":52322},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3450":1049,"_30100":1025,"_20891":52324,"_5":14349,"_27386":52256,"_2933":52325},[],"`/serverkeygen`",{"_3450":1050,"_30100":1025,"_20891":52327,"_5":14349,"_27386":52256,"_2933":52311},[],{"_3450":1051,"_30100":1025,"_20891":52329,"_5":14349,"_27386":52256,"_2933":52330},[],"Initial authentication and admission; server generation enabled.",{"_3450":1052,"_30100":1025,"_20891":52332,"_5":14349,"_27386":52256,"_2933":52333},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3450":1053,"_30100":1025,"_20891":52335,"_5":14349,"_27386":52260,"_2933":52336},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3450":1054,"_30100":1025,"_20891":52338,"_5":14349,"_27386":52260,"_2933":52339},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3450":1055,"_30100":1025,"_20891":52341,"_5":14349,"_27386":52263,"_2933":52342},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3450":1056,"_30100":1025,"_20891":52344,"_5":14349,"_27386":52263,"_2933":52345},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3450":1057,"_30100":1025,"_20891":52347,"_5":14349,"_27386":52266,"_2933":52348},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3450":1058,"_30100":1025,"_20891":52350,"_5":14349,"_27386":52266,"_2933":52351},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3450":1059,"_30100":1025,"_20891":52353,"_5":14349,"_27386":52269,"_2933":52354},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3450":1060,"_30100":1025,"_20891":52356,"_5":14349,"_27386":52269,"_2933":52357},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3450":1061,"_30100":1025,"_20891":52359,"_5":14349,"_27386":52272,"_2933":52360},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3450":1062,"_30100":1025,"_20891":52362,"_5":14349,"_27386":52272,"_2933":52363},[],"Part",{"_3450":1063,"_30100":1025,"_20891":52365,"_5":14349,"_27386":52272,"_2933":52366},[],"Content after decoding its Base64",{"_3450":1064,"_30100":1025,"_20891":52368,"_5":14349,"_27386":52272,"_2933":52369},[],"`application/pkcs8`",{"_3450":1065,"_30100":1025,"_20891":52371,"_5":14349,"_27386":52272,"_2933":52372},[],"Unencrypted DER PKCS#8 private key.",{"_3450":1066,"_30100":1025,"_20891":52374,"_5":14349,"_27386":52272,"_2933":52375},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3450":1067,"_30100":1025,"_20891":52377,"_5":14349,"_27386":52272,"_2933":52378},[],"DER PKCS#7 containing the issued certificate.",{"_3450":1068,"_30100":1025,"_20891":52380,"_5":14349,"_27386":52272,"_2933":52381},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3450":1069,"_30100":1025,"_20891":52383,"_5":14349,"_27386":52276,"_2933":52384},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3450":1070,"_30100":1025,"_20891":52386,"_5":14349,"_27386":52276,"_2933":52387},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3450":1071,"_30100":1025,"_20891":52389,"_5":14349,"_27386":52276,"_2933":52390},[],"Convert and check the result:",{"_3450":1072,"_30100":1025,"_20891":52392,"_5":14349,"_27386":52276,"_2933":52393},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3450":1073,"_30100":1025,"_20891":52395,"_5":14349,"_27386":52280,"_2933":52396},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3450":1074,"_30100":1025,"_20891":52398,"_5":14349,"_27386":52280,"_2933":52399},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3450":1075,"_30100":1075,"_5":14701,"_2933":51715,"_30453":52401,"_20891":52402,"_27386":1075},[49052,50520,51534,51532,51715],[],{"_3450":1076,"_30100":1075,"_20891":52404,"_5":14349,"_27386":1075,"_2933":52405},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3450":1077,"_30100":1075,"_5":30450,"_20891":52407,"_27386":52408,"_2933":52409},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3450":1078,"_30100":1075,"_5":30450,"_20891":52411,"_27386":52412,"_2933":52413},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3450":1079,"_30100":1075,"_5":30450,"_20891":52415,"_27386":52416,"_2933":52417},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3450":1080,"_30100":1075,"_5":30450,"_20891":52419,"_27386":52420,"_2933":52421},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3450":1081,"_30100":1075,"_20891":52423,"_5":14349,"_27386":1075,"_2933":52424},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3450":1082,"_30100":1075,"_20891":52426,"_5":14349,"_27386":52408,"_2933":52427},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3450":1083,"_30100":1075,"_20891":52429,"_5":14349,"_27386":52408,"_2933":52430},[],"The integrator installs initial EST server trust and an admission credential.",{"_3450":1084,"_30100":1075,"_20891":52432,"_5":14349,"_27386":52408,"_2933":52433},[],"The client requests an identity for its `Device ID` through EST.",{"_3450":1085,"_30100":1075,"_20891":52435,"_5":14349,"_27386":52408,"_2933":52436},[],"Certificate, device binding and key/certificate installation are checked.",{"_3450":1086,"_30100":1075,"_20891":52438,"_5":14349,"_27386":52408,"_2933":52439},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3450":1087,"_30100":1075,"_20891":52441,"_5":14349,"_27386":52408,"_2933":52442},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3450":1088,"_30100":1075,"_20891":52444,"_5":14349,"_27386":52412,"_2933":52445},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3450":1089,"_30100":1075,"_20891":52447,"_5":14349,"_27386":52412,"_2933":52448},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3450":1090,"_30100":1075,"_20891":52450,"_5":14349,"_27386":52412,"_2933":52451},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3450":1091,"_30100":1075,"_20891":52453,"_5":14349,"_27386":52412,"_2933":52454},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3450":1092,"_30100":1075,"_20891":52456,"_5":14349,"_27386":52416,"_2933":52457},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3450":1093,"_30100":1075,"_20891":52459,"_5":14349,"_27386":52416,"_2933":52460},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3450":1094,"_30100":1075,"_20891":52462,"_5":14349,"_27386":52416,"_2933":52463},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3450":1095,"_30100":1075,"_20891":52465,"_5":14349,"_27386":52416,"_2933":52466},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3450":1096,"_30100":1075,"_20891":52468,"_5":14349,"_27386":52420,"_2933":52469},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3450":1097,"_30100":1075,"_20891":52471,"_5":14349,"_27386":52420,"_2933":52472},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3450":1098,"_30100":1098,"_5":14701,"_2933":52474,"_30453":52475,"_20891":52476,"_27386":1098},"Provisioning strategies",[49052,50520,51534,51532,51715],[],{"_3450":1099,"_30100":1098,"_20891":52478,"_5":14349,"_27386":1098,"_2933":52479},[],"Choose device registration, identity authorization and key generation.",{"_3450":1100,"_30100":1098,"_5":30450,"_20891":52481,"_27386":52482,"_2933":52483},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3450":1101,"_30100":1098,"_5":30450,"_20891":52485,"_27386":52486,"_2933":52487},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3450":1102,"_30100":1098,"_5":30450,"_20891":52489,"_27386":52490,"_2933":52491},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3450":1103,"_30100":1098,"_5":30450,"_20891":52493,"_27386":52494,"_2933":52495},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3450":1104,"_30100":1098,"_5":30450,"_20891":52497,"_27386":52498,"_2933":52499},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3450":1105,"_30100":1098,"_20891":52501,"_5":14349,"_27386":1098,"_2933":52502},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3450":1106,"_30100":1098,"_20891":52504,"_5":14349,"_27386":52482,"_2933":52505},[],"Path",{"_3450":1107,"_30100":1098,"_20891":52507,"_5":14349,"_27386":52482,"_2933":52508},[],"When the device exists",{"_3450":1108,"_30100":1098,"_20891":52510,"_5":14349,"_27386":52482,"_2933":52511},[],"What to check",{"_3450":1109,"_30100":1098,"_20891":52513,"_5":14349,"_27386":52482,"_2933":52514},[],"Manual assignment",{"_3450":1110,"_30100":1098,"_20891":52516,"_5":14349,"_27386":52482,"_2933":52517},[],"An operator creates it before associating a certificate.",{"_3450":1111,"_30100":1098,"_20891":52519,"_5":14349,"_27386":52482,"_2933":52520},[],"ID, owning DMS, certificate CN and bound serial.",{"_3450":1112,"_30100":1098,"_20891":52522,"_5":14349,"_27386":52482,"_2933":52523},[],"EST with `JITP`",{"_3450":1113,"_30100":1098,"_20891":52525,"_5":14349,"_27386":52482,"_2933":52526},[],"Created for an unknown CN during `/simpleenroll`.",{"_3450":1114,"_30100":1098,"_20891":52528,"_5":14349,"_27386":52482,"_2933":52529},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3450":1115,"_30100":1098,"_20891":52531,"_5":14349,"_27386":52482,"_2933":52532},[],"EST with `PRE_REGISTRATION`",{"_3450":1116,"_30100":1098,"_20891":52534,"_5":14349,"_27386":52482,"_2933":52535},[],"Must exist before `/simpleenroll`.",{"_3450":1117,"_30100":1098,"_20891":52537,"_5":14349,"_27386":52482,"_2933":52538},[],"Approved record, same DMS and replacement conditions for your version.",{"_3450":1118,"_30100":1098,"_20891":52540,"_5":14349,"_27386":52482,"_2933":52541},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3450":1119,"_30100":1098,"_20891":52543,"_5":14349,"_27386":52482,"_2933":52544},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3450":1120,"_30100":1098,"_20891":52546,"_5":14349,"_27386":52486,"_2933":52547},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3450":1121,"_30100":1098,"_20891":52549,"_5":14349,"_27386":52486,"_2933":52550},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3450":1122,"_30100":1098,"_20891":52552,"_5":14349,"_27386":52486,"_2933":52553},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3450":1123,"_30100":1098,"_20891":52555,"_5":14349,"_27386":52490,"_2933":52556},[],"Decide initial enrollment and re-enrollment separately:",{"_3450":1124,"_30100":1098,"_20891":52558,"_5":14349,"_27386":52490,"_2933":52559},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3450":1125,"_30100":1098,"_20891":52561,"_5":14349,"_27386":52490,"_2933":52562},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3450":1126,"_30100":1098,"_20891":52564,"_5":14349,"_27386":52490,"_2933":52565},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3450":1127,"_30100":1098,"_20891":52567,"_5":14349,"_27386":52490,"_2933":52568},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3450":1128,"_30100":1098,"_20891":52570,"_5":14349,"_27386":52490,"_2933":52571},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3450":1129,"_30100":1098,"_20891":52573,"_5":14349,"_27386":52494,"_2933":49436},[],{"_3450":1130,"_30100":1098,"_20891":52575,"_5":14349,"_27386":52494,"_2933":52576},[],"Material crossing EST",{"_3450":1131,"_30100":1098,"_20891":52578,"_5":14349,"_27386":52494,"_2933":52579},[],"Device-generated key",{"_3450":1132,"_30100":1098,"_20891":52581,"_5":14349,"_27386":52494,"_2933":52582},[],"Public CSR and certificate; the key stays on the client.",{"_3450":1133,"_30100":1098,"_20891":52584,"_5":14349,"_27386":52494,"_2933":52585},[],"Existing device key",{"_3450":1134,"_30100":1098,"_20891":52587,"_5":14349,"_27386":52494,"_2933":52588},[],"CSR signed with that key and a new certificate.",{"_3450":1135,"_30100":1098,"_20891":52590,"_5":14349,"_27386":52494,"_2933":51853},[],{"_3450":1136,"_30100":1098,"_20891":52592,"_5":14349,"_27386":52494,"_2933":52593},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3450":1137,"_30100":1098,"_20891":52595,"_5":14349,"_27386":52494,"_2933":52596},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3450":1138,"_30100":1098,"_20891":52598,"_5":14349,"_27386":52498,"_2933":52599},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3450":1139,"_30100":1139,"_5":14701,"_2933":52601,"_30453":52602,"_20891":52603,"_27386":1139},"Renewal and recovery",[49052,50520,51534,51532,51715],[],{"_3450":1140,"_30100":1139,"_20891":52605,"_5":14349,"_27386":1139,"_2933":52606},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3450":1141,"_30100":1139,"_5":30450,"_20891":52608,"_27386":52609,"_2933":52610},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3450":1142,"_30100":1139,"_5":30450,"_20891":52612,"_27386":52613,"_2933":52614},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3450":1143,"_30100":1139,"_5":30450,"_20891":52616,"_27386":52617,"_2933":52618},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3450":1144,"_30100":1139,"_5":30450,"_20891":52620,"_27386":52621,"_2933":52622},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3450":1145,"_30100":1139,"_5":30450,"_20891":52624,"_27386":52625,"_2933":52626},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3450":1146,"_30100":1139,"_20891":52628,"_5":14349,"_27386":1139,"_2933":52629},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3450":1147,"_30100":1139,"_20891":52631,"_5":14349,"_27386":52609,"_2933":52632},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3450":1148,"_30100":1139,"_20891":52634,"_5":14349,"_27386":52609,"_2933":52635},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3450":1149,"_30100":1139,"_20891":52637,"_5":14349,"_27386":52609,"_2933":52638},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3450":1150,"_30100":1139,"_20891":52640,"_5":14349,"_27386":52609,"_2933":52641},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3450":1151,"_30100":1139,"_20891":52643,"_5":14349,"_27386":52613,"_2933":52644},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3450":1152,"_30100":1139,"_20891":52646,"_5":14349,"_27386":52613,"_2933":52647},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3450":1153,"_30100":1139,"_20891":52649,"_5":14349,"_27386":52617,"_2933":52650},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3450":1154,"_30100":1139,"_20891":52652,"_5":14349,"_27386":52617,"_2933":52653},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3450":1155,"_30100":1139,"_20891":52655,"_5":14349,"_27386":52617,"_2933":52656},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3450":1156,"_30100":1139,"_20891":52658,"_5":14349,"_27386":52621,"_2933":52659},[],"Situation",{"_3450":1157,"_30100":1139,"_20891":52661,"_5":14349,"_27386":52621,"_2933":52662},[],"Procedure",{"_3450":1158,"_30100":1139,"_20891":52664,"_5":14349,"_27386":52621,"_2933":52665},[],"Valid certificate, outside the window",{"_3450":1159,"_30100":1139,"_20891":52667,"_5":14349,"_27386":52621,"_2933":52668},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3450":1160,"_30100":1139,"_20891":52670,"_5":14349,"_27386":52621,"_2933":52671},[],"Expired certificate, key available",{"_3450":1161,"_30100":1139,"_20891":52673,"_5":14349,"_27386":52621,"_2933":52674},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3450":1162,"_30100":1139,"_20891":52676,"_5":14349,"_27386":52621,"_2933":52677},[],"Renewal through webhook or `NO_AUTH`",{"_3450":1163,"_30100":1139,"_20891":52679,"_5":14349,"_27386":52621,"_2933":52680},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3450":1164,"_30100":1139,"_20891":52682,"_5":14349,"_27386":52621,"_2933":52683},[],"Lost or inaccessible key",{"_3450":1165,"_30100":1139,"_20891":52685,"_5":14349,"_27386":52621,"_2933":52686},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3450":1166,"_30100":1139,"_20891":52688,"_5":14349,"_27386":52621,"_2933":52689},[],"Current identity revoked",{"_3450":1167,"_30100":1139,"_20891":52691,"_5":14349,"_27386":52621,"_2933":52692},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3450":1168,"_30100":1139,"_20891":52694,"_5":14349,"_27386":52621,"_2933":52695},[],"Device without an identity",{"_3450":1169,"_30100":1139,"_20891":52697,"_5":14349,"_27386":52621,"_2933":52698},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3450":1170,"_30100":1139,"_20891":52700,"_5":14349,"_27386":52621,"_2933":52701},[],"Retired device",{"_3450":1171,"_30100":1139,"_20891":52703,"_5":14349,"_27386":52621,"_2933":52704},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3450":1172,"_30100":1139,"_20891":52706,"_5":14349,"_27386":52621,"_2933":52707},[],"Timeout, HTTP 500 or installation failure",{"_3450":1173,"_30100":1139,"_20891":52709,"_5":14349,"_27386":52621,"_2933":52710},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3450":1174,"_30100":1139,"_20891":52712,"_5":14349,"_27386":52625,"_2933":52713},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3450":1175,"_30100":1139,"_20891":52715,"_5":14349,"_27386":52625,"_2933":52716},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3450":1176,"_30100":1176,"_5":14701,"_2933":52718,"_30453":52719,"_20891":52720,"_27386":1176},"Enrollment troubleshooting",[49052,50520,51534,51532,51715],[],{"_3450":1177,"_30100":1176,"_20891":52722,"_5":14349,"_27386":1176,"_2933":52723},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3450":1178,"_30100":1176,"_5":30450,"_20891":52725,"_27386":52726,"_2933":52727},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3450":1179,"_30100":1176,"_5":30450,"_20891":52729,"_27386":52730,"_2933":52731},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3450":1180,"_30100":1176,"_5":30450,"_20891":52733,"_27386":52734,"_2933":52281},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3450":1181,"_30100":1176,"_5":30450,"_20891":52736,"_27386":52737,"_2933":52738},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3450":1182,"_30100":1176,"_20891":52740,"_5":14349,"_27386":1176,"_2933":52741},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3450":1183,"_30100":1176,"_20891":52743,"_5":14349,"_27386":52730,"_2933":52744},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3450":1184,"_30100":1176,"_20891":52746,"_5":14349,"_27386":52730,"_2933":52747},[],"Symptom or message",{"_3450":1185,"_30100":1176,"_20891":52749,"_5":14349,"_27386":52730,"_2933":52511},[],{"_3450":1186,"_30100":1176,"_20891":52751,"_5":14349,"_27386":52730,"_2933":52752},[],"curl rejects TLS, name or issuer",{"_3450":1187,"_30100":1176,"_20891":52754,"_5":14349,"_27386":52730,"_2933":52755},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3450":1188,"_30100":1176,"_20891":52757,"_5":14349,"_27386":52730,"_2933":52758},[],"404 or missing APS",{"_3450":1189,"_30100":1176,"_20891":52760,"_5":14349,"_27386":52730,"_2933":52761},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3450":1190,"_30100":1176,"_20891":52763,"_5":14349,"_27386":52730,"_2933":52764},[],"400, CSR or format error",{"_3450":1191,"_30100":1176,"_20891":52766,"_5":14349,"_27386":52730,"_2933":52767},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3450":1192,"_30100":1176,"_20891":52769,"_5":14349,"_27386":52730,"_2933":52770},[],"Missing credential or invalid certificate",{"_3450":1193,"_30100":1176,"_20891":52772,"_5":14349,"_27386":52730,"_2933":52773},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3450":1194,"_30100":1176,"_20891":52775,"_5":14349,"_27386":52730,"_2933":52776},[],"Webhook denies, times out or responds without authorization",{"_3450":1195,"_30100":1176,"_20891":52778,"_5":14349,"_27386":52730,"_2933":52779},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3450":1196,"_30100":1176,"_20891":52781,"_5":14349,"_27386":52730,"_2933":52782},[],"`unexpected status code: <n>: redirects are not followed`",{"_3450":1197,"_30100":1176,"_20891":52784,"_5":14349,"_27386":52730,"_2933":52785},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3450":1198,"_30100":1176,"_20891":52787,"_5":14349,"_27386":52730,"_2933":52788},[],"`webhook response exceeds 1048576 bytes`",{"_3450":1199,"_30100":1176,"_20891":52790,"_5":14349,"_27386":52730,"_2933":52791},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3450":1200,"_30100":1176,"_20891":52793,"_5":14349,"_27386":52730,"_2933":52794},[],"`webhook config must not reference files`",{"_3450":1201,"_30100":1176,"_20891":52796,"_5":14349,"_27386":52730,"_2933":52797},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3450":1202,"_30100":1176,"_20891":52799,"_5":14349,"_27386":52730,"_2933":52800},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3450":1203,"_30100":1176,"_20891":52802,"_5":14349,"_27386":52730,"_2933":52803},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3450":1204,"_30100":1176,"_20891":52805,"_5":14349,"_27386":52730,"_2933":52806},[],"`webhook mTLS certificate and key are invalid: …`",{"_3450":1205,"_30100":1176,"_20891":52808,"_5":14349,"_27386":52730,"_2933":52809},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3450":1206,"_30100":1176,"_20891":52811,"_5":14349,"_27386":52730,"_2933":52812},[],"400 `struct validation error` creating or updating a DMS",{"_3450":1207,"_30100":1176,"_20891":52814,"_5":14349,"_27386":52730,"_2933":52815},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3450":1208,"_30100":1176,"_20891":52817,"_5":14349,"_27386":52730,"_2933":52818},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3450":1209,"_30100":1176,"_20891":52820,"_5":14349,"_27386":52730,"_2933":52821},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3450":1210,"_30100":1176,"_20891":52823,"_5":14349,"_27386":52730,"_2933":52824},[],"`device not preregistered`",{"_3450":1211,"_30100":1176,"_20891":52826,"_5":14349,"_27386":52730,"_2933":52827},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3450":1212,"_30100":1176,"_20891":52829,"_5":14349,"_27386":52730,"_2933":52830},[],"`forbiddenNewEnrollment`",{"_3450":1213,"_30100":1176,"_20891":52832,"_5":14349,"_27386":52730,"_2933":52833},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3450":1214,"_30100":1176,"_20891":52835,"_5":14349,"_27386":52730,"_2933":52836},[],"Different owning DMS",{"_3450":1215,"_30100":1176,"_20891":52838,"_5":14349,"_27386":52730,"_2933":52839},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3450":1216,"_30100":1176,"_20891":52841,"_5":14349,"_27386":52730,"_2933":52842},[],"`invalid RawSubject bytes`",{"_3450":1217,"_30100":1176,"_20891":52844,"_5":14349,"_27386":52730,"_2933":52845},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3450":1218,"_30100":1176,"_20891":52847,"_5":14349,"_27386":52730,"_2933":52848},[],"`invalid reenroll window`",{"_3450":1219,"_30100":1176,"_20891":52850,"_5":14349,"_27386":52730,"_2933":52851},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3450":1220,"_30100":1176,"_20891":52853,"_5":14349,"_27386":52730,"_2933":52854},[],"Current certificate revoked",{"_3450":1221,"_30100":1176,"_20891":52856,"_5":14349,"_27386":52730,"_2933":52857},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3450":1222,"_30100":1176,"_20891":52859,"_5":14349,"_27386":52730,"_2933":52860},[],"CA, profile or signing error",{"_3450":1223,"_30100":1176,"_20891":52862,"_5":14349,"_27386":52730,"_2933":52863},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3450":1224,"_30100":1176,"_20891":52865,"_5":14349,"_27386":52730,"_2933":52866},[],"HTTP 200 without a device connection",{"_3450":1225,"_30100":1176,"_20891":52868,"_5":14349,"_27386":52730,"_2933":52869},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3450":1226,"_30100":1176,"_20891":52871,"_5":14349,"_27386":52730,"_2933":52872},[],"Timeout or error after issuance",{"_3450":1227,"_30100":1176,"_20891":52874,"_5":14349,"_27386":52730,"_2933":52875},[],"New certificates, current slot and previous identity's state before retrying.",{"_3450":1228,"_30100":1176,"_20891":52877,"_5":14349,"_27386":52734,"_2933":52878},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3450":1229,"_30100":1176,"_20891":52880,"_5":14349,"_27386":52734,"_2933":52881},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3450":1230,"_30100":1176,"_20891":52883,"_5":14349,"_27386":52737,"_2933":52884},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3450":1231,"_30100":1176,"_20891":52886,"_5":14349,"_27386":52737,"_2933":52887},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3450":1232,"_30100":1176,"_20891":52889,"_5":14349,"_27386":52737,"_2933":52890},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3450":1233,"_30100":1176,"_20891":52892,"_5":14349,"_27386":52737,"_2933":52893},[],"Make one request, save headers/body and query the device and certificates.",{"_3450":1234,"_30100":1176,"_20891":52895,"_5":14349,"_27386":52737,"_2933":52896},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3450":1235,"_30100":1176,"_20891":52898,"_5":14349,"_27386":52737,"_2933":52899},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3450":1236,"_30100":1176,"_20891":52901,"_5":14349,"_27386":52737,"_2933":52902},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3450":1237,"_30100":1237,"_5":14701,"_2933":52904,"_30453":52905,"_20891":52906,"_27386":1237},"Trust distribution and updates",[49052,50520,51534,51532,51715],[],{"_3450":1238,"_30100":1237,"_20891":52908,"_5":14349,"_27386":1237,"_2933":52909},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3450":1239,"_30100":1237,"_5":30450,"_20891":52911,"_27386":52912,"_2933":52913},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3450":1240,"_30100":1237,"_5":30450,"_20891":52915,"_27386":52916,"_2933":52917},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3450":1241,"_30100":1237,"_5":30450,"_20891":52919,"_27386":52920,"_2933":52921},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3450":1242,"_30100":1237,"_5":30450,"_20891":52923,"_27386":52924,"_2933":52925},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3450":1243,"_30100":1237,"_5":30450,"_20891":52927,"_27386":52928,"_2933":52929},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3450":1244,"_30100":1237,"_20891":52931,"_5":14349,"_27386":1237,"_2933":52932},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3450":1245,"_30100":1237,"_20891":52934,"_5":14349,"_27386":52912,"_2933":52935},[],"Relationship",{"_3450":1246,"_30100":1237,"_20891":52937,"_5":14349,"_27386":52912,"_2933":52938},[],"Material prepared by its owner",{"_3450":1247,"_30100":1237,"_20891":52940,"_5":14349,"_27386":52912,"_2933":52941},[],"Device → EST server",{"_3450":1248,"_30100":1237,"_20891":52943,"_5":14349,"_27386":52912,"_2933":52944},[],"Previously verified server root, chain or pin and TLS name.",{"_3450":1249,"_30100":1237,"_20891":52946,"_5":14349,"_27386":52912,"_2933":52947},[],"DMS → requester",{"_3450":1250,"_30100":1237,"_20891":52949,"_5":14349,"_27386":52912,"_2933":52950},[],"CAs and rules authorizing initial or renewal credentials.",{"_3450":1251,"_30100":1237,"_20891":52952,"_5":14349,"_27386":52912,"_2933":52953},[],"Consumer → device",{"_3450":1252,"_30100":1237,"_20891":52955,"_5":14349,"_27386":52912,"_2933":52956},[],"Operational identity roots, intermediates, validation and permissions.",{"_3450":1253,"_30100":1237,"_20891":52958,"_5":14349,"_27386":52912,"_2933":52959},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3450":1254,"_30100":1237,"_20891":52961,"_5":14349,"_27386":52916,"_2933":52962},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3450":1255,"_30100":1237,"_20891":52964,"_5":14349,"_27386":52916,"_2933":52965},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3450":1256,"_30100":1237,"_20891":52967,"_5":14349,"_27386":52920,"_2933":52968},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3450":1257,"_30100":1237,"_20891":52970,"_5":14349,"_27386":52920,"_2933":52971},[],"Select policy-approved roots as anchors.",{"_3450":1258,"_30100":1237,"_20891":52973,"_5":14349,"_27386":52920,"_2933":52974},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3450":1259,"_30100":1237,"_20891":52976,"_5":14349,"_27386":52920,"_2933":52977},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3450":1260,"_30100":1237,"_20891":52979,"_5":14349,"_27386":52920,"_2933":52980},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3450":1261,"_30100":1237,"_20891":52982,"_5":14349,"_27386":52920,"_2933":52983},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3450":1262,"_30100":1237,"_20891":52985,"_5":14349,"_27386":52924,"_2933":52986},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3450":1263,"_30100":1237,"_20891":52988,"_5":14349,"_27386":52924,"_2933":52989},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3450":1264,"_30100":1237,"_20891":52991,"_5":14349,"_27386":52924,"_2933":52992},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3450":1265,"_30100":1237,"_20891":52994,"_5":14349,"_27386":52928,"_2933":52995},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3450":1266,"_30100":1266,"_5":14701,"_2933":52997,"_30453":52998,"_20891":53000,"_27386":1266},"AWS IoT Core",[49052,50520,51534,51532,52999],"Integrations",[],{"_3450":1267,"_30100":1266,"_20891":53002,"_5":14349,"_27386":1266,"_2933":53003},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3450":1268,"_30100":1266,"_5":30450,"_20891":53005,"_27386":53006,"_2933":53007},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3450":1269,"_30100":1266,"_5":30450,"_20891":53009,"_27386":53010,"_2933":53011},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3450":1270,"_30100":1266,"_5":30450,"_20891":53013,"_27386":53014,"_2933":53015},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3450":1271,"_30100":1266,"_5":30450,"_20891":53017,"_27386":53018,"_2933":53019},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3450":1272,"_30100":1266,"_5":30450,"_20891":53021,"_27386":53022,"_2933":53023},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3450":1273,"_30100":1266,"_5":30450,"_20891":53025,"_27386":53026,"_2933":53027},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3450":1274,"_30100":1266,"_5":30450,"_20891":53029,"_27386":53030,"_2933":53031},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3450":1275,"_30100":1266,"_5":30450,"_20891":53033,"_27386":53034,"_2933":53035},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3450":1276,"_30100":1266,"_5":30450,"_20891":53037,"_27386":53038,"_2933":53039},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3450":1277,"_30100":1266,"_5":30450,"_20891":53041,"_27386":53042,"_2933":53043},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3450":1278,"_30100":1266,"_5":30450,"_20891":53045,"_27386":53046,"_2933":53047},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3450":1279,"_30100":1266,"_5":30450,"_20891":53049,"_27386":53050,"_2933":53051},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3450":1280,"_30100":1266,"_5":30450,"_20891":53053,"_27386":53054,"_2933":53055},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3450":1281,"_30100":1266,"_5":30450,"_20891":53057,"_27386":53058,"_2933":53059},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3450":1282,"_30100":1266,"_5":30450,"_20891":53061,"_27386":53062,"_2933":53063},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3450":1283,"_30100":1266,"_5":30450,"_20891":53065,"_27386":53066,"_2933":53067},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3450":1284,"_30100":1266,"_5":30450,"_20891":53069,"_27386":53070,"_2933":53071},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3450":1285,"_30100":1266,"_5":30450,"_20891":53073,"_27386":53074,"_2933":53075},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3450":1286,"_30100":1266,"_5":30450,"_20891":53077,"_27386":53078,"_2933":53079},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3450":1287,"_30100":1266,"_5":30450,"_20891":53081,"_27386":53082,"_2933":53083},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3450":1288,"_30100":1266,"_5":30450,"_20891":53085,"_27386":53086,"_2933":53087},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3450":1289,"_30100":1266,"_5":30450,"_20891":53089,"_27386":53090,"_2933":53091},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3450":1290,"_30100":1266,"_5":30450,"_20891":53093,"_27386":53094,"_2933":53095},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3450":1291,"_30100":1266,"_5":30450,"_20891":53097,"_27386":53098,"_2933":53099},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3450":1292,"_30100":1266,"_5":30450,"_20891":53101,"_27386":53102,"_2933":53103},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3450":1293,"_30100":1266,"_20891":53105,"_5":14349,"_27386":1266,"_2933":53106},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3450":1294,"_30100":1266,"_20891":53108,"_5":14349,"_27386":1266,"_2933":53109},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3450":1295,"_30100":1266,"_20891":53111,"_5":14349,"_27386":1266,"_2933":53112},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3450":1296,"_30100":1266,"_20891":53114,"_5":14349,"_27386":53006,"_2933":53115},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3450":1297,"_30100":1266,"_20891":53117,"_5":14349,"_27386":53006,"_2933":53118},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3450":1298,"_30100":1266,"_20891":53120,"_5":14349,"_27386":53006,"_2933":53121},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3450":1299,"_30100":1266,"_20891":53123,"_5":14349,"_27386":53006,"_2933":53124},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3450":1300,"_30100":1266,"_20891":53126,"_5":14349,"_27386":53010,"_2933":53127},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3450":1301,"_30100":1266,"_20891":53129,"_5":14349,"_27386":53014,"_2933":53130},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3450":1302,"_30100":1266,"_20891":53132,"_5":14349,"_27386":53014,"_2933":53133},[],"IAM action",{"_3450":1303,"_30100":1266,"_20891":53135,"_5":14349,"_27386":53014,"_2933":49442},[],{"_3450":1304,"_30100":1266,"_20891":53137,"_5":14349,"_27386":53014,"_2933":53138},[],"`iot:GetRegistrationCode`",{"_3450":1305,"_30100":1266,"_20891":53140,"_5":14349,"_27386":53014,"_2933":53141},[],"Obtain the verification code for CA registration in the Primary Account",{"_3450":1306,"_30100":1266,"_20891":53143,"_5":14349,"_27386":53014,"_2933":53144},[],"`iot:RegisterCACertificate`",{"_3450":1307,"_30100":1266,"_20891":53146,"_5":14349,"_27386":53014,"_2933":53147},[],"Register the CA in AWS IoT",{"_3450":1308,"_30100":1266,"_20891":53149,"_5":14349,"_27386":53014,"_2933":53150},[],"`iot:DescribeCACertificate`",{"_3450":1309,"_30100":1266,"_20891":53152,"_5":14349,"_27386":53014,"_2933":53153},[],"Check the CA registration status",{"_3450":1310,"_30100":1266,"_20891":53155,"_5":14349,"_27386":53014,"_2933":53156},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3450":1311,"_30100":1266,"_20891":53158,"_5":14349,"_27386":53014,"_2933":53159},[],"Create or update Things in IoT Core",{"_3450":1312,"_30100":1266,"_20891":53161,"_5":14349,"_27386":53014,"_2933":53162},[],"`iot:RegisterThing`",{"_3450":1313,"_30100":1266,"_20891":53164,"_5":14349,"_27386":53014,"_2933":53165},[],"Provision Things through a template",{"_3450":1314,"_30100":1266,"_20891":53167,"_5":14349,"_27386":53014,"_2933":53168},[],"`iot:RegisterCertificate`",{"_3450":1315,"_30100":1266,"_20891":53170,"_5":14349,"_27386":53014,"_2933":53171},[],"Register device certificates",{"_3450":1316,"_30100":1266,"_20891":53173,"_5":14349,"_27386":53014,"_2933":53174},[],"`iot:UpdateCertificate`",{"_3450":1317,"_30100":1266,"_20891":53176,"_5":14349,"_27386":53014,"_2933":53177},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3450":1318,"_30100":1266,"_20891":53179,"_5":14349,"_27386":53014,"_2933":53180},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3450":1319,"_30100":1266,"_20891":53182,"_5":14349,"_27386":53014,"_2933":53183},[],"Create and attach IoT policies",{"_3450":1320,"_30100":1266,"_20891":53185,"_5":14349,"_27386":53014,"_2933":53186},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3450":1321,"_30100":1266,"_20891":53188,"_5":14349,"_27386":53014,"_2933":53189},[],"Manage Thing groups",{"_3450":1322,"_30100":1266,"_20891":53191,"_5":14349,"_27386":53014,"_2933":53192},[],"`iot:CreateProvisioningTemplate`",{"_3450":1323,"_30100":1266,"_20891":53194,"_5":14349,"_27386":53014,"_2933":53195},[],"Create JITP templates",{"_3450":1324,"_30100":1266,"_20891":53197,"_5":14349,"_27386":53014,"_2933":53198},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3450":1325,"_30100":1266,"_20891":53200,"_5":14349,"_27386":53014,"_2933":53201},[],"Read and write the Device Shadow",{"_3450":1326,"_30100":1266,"_20891":53203,"_5":14349,"_27386":53014,"_2933":53204},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3450":1327,"_30100":1266,"_20891":53206,"_5":14349,"_27386":53018,"_2933":53207},[],"Parameter",{"_3450":1328,"_30100":1266,"_20891":53209,"_5":14349,"_27386":53018,"_2933":53210},[],"Type",{"_3450":1329,"_30100":1266,"_20891":53212,"_5":14349,"_27386":53018,"_2933":53213},[],"Required",{"_3450":1330,"_30100":1266,"_20891":53215,"_5":14349,"_27386":53018,"_2933":53216},[],"Description",{"_3450":1331,"_30100":1266,"_20891":53218,"_5":14349,"_27386":53018,"_2933":53219},[],"`connector_id`",{"_3450":1332,"_30100":1266,"_20891":53221,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1333,"_30100":1266,"_20891":53223,"_5":14349,"_27386":53018,"_2933":53224},[],"Yes",{"_3450":1334,"_30100":1266,"_20891":53226,"_5":14349,"_27386":53018,"_2933":53227},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3450":1335,"_30100":1266,"_20891":53229,"_5":14349,"_27386":53018,"_2933":53230},[],"`aws_config.region`",{"_3450":1336,"_30100":1266,"_20891":53232,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1337,"_30100":1266,"_20891":53234,"_5":14349,"_27386":53018,"_2933":53224},[],{"_3450":1338,"_30100":1266,"_20891":53236,"_5":14349,"_27386":53018,"_2933":53237},[],"AWS region where the connector operates.",{"_3450":1339,"_30100":1266,"_20891":53239,"_5":14349,"_27386":53018,"_2933":53240},[],"`aws_config.auth_method`",{"_3450":1340,"_30100":1266,"_20891":53242,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1341,"_30100":1266,"_20891":53244,"_5":14349,"_27386":53018,"_2933":53224},[],{"_3450":1342,"_30100":1266,"_20891":53246,"_5":14349,"_27386":53018,"_2933":53247},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3450":1343,"_30100":1266,"_20891":53249,"_5":14349,"_27386":53018,"_2933":53250},[],"`aws_config.access_key_id`",{"_3450":1344,"_30100":1266,"_20891":53252,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1345,"_30100":1266,"_20891":53254,"_5":14349,"_27386":53018,"_2933":53255},[],"Only with `auth_method=static`",{"_3450":1346,"_30100":1266,"_20891":53257,"_5":14349,"_27386":53018,"_2933":53258},[],"AWS access key.",{"_3450":1347,"_30100":1266,"_20891":53260,"_5":14349,"_27386":53018,"_2933":53261},[],"`aws_config.secret_access_key`",{"_3450":1348,"_30100":1266,"_20891":53263,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1349,"_30100":1266,"_20891":53265,"_5":14349,"_27386":53018,"_2933":53255},[],{"_3450":1350,"_30100":1266,"_20891":53267,"_5":14349,"_27386":53018,"_2933":53268},[],"AWS secret key.",{"_3450":1351,"_30100":1266,"_20891":53270,"_5":14349,"_27386":53018,"_2933":53271},[],"`aws_config.session_token`",{"_3450":1352,"_30100":1266,"_20891":53273,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1353,"_30100":1266,"_20891":53275,"_5":14349,"_27386":53018,"_2933":53276},[],"No",{"_3450":1354,"_30100":1266,"_20891":53278,"_5":14349,"_27386":53018,"_2933":53279},[],"Session token (with `auth_method=static`).",{"_3450":1355,"_30100":1266,"_20891":53281,"_5":14349,"_27386":53018,"_2933":53282},[],"`aws_config.role_arn`",{"_3450":1356,"_30100":1266,"_20891":53284,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1357,"_30100":1266,"_20891":53286,"_5":14349,"_27386":53018,"_2933":53287},[],"Only with `auth_method=role`",{"_3450":1358,"_30100":1266,"_20891":53289,"_5":14349,"_27386":53018,"_2933":53290},[],"ARN of the role to assume.",{"_3450":1359,"_30100":1266,"_20891":53292,"_5":14349,"_27386":53018,"_2933":53293},[],"`aws_config.endpoint_url`",{"_3450":1360,"_30100":1266,"_20891":53295,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1361,"_30100":1266,"_20891":53297,"_5":14349,"_27386":53018,"_2933":53276},[],{"_3450":1362,"_30100":1266,"_20891":53299,"_5":14349,"_27386":53018,"_2933":53300},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3450":1363,"_30100":1266,"_20891":53302,"_5":14349,"_27386":53018,"_2933":53303},[],"`subscriber_event_bus`",{"_3450":1364,"_30100":1266,"_20891":53305,"_5":14349,"_27386":53018,"_2933":17597},[],{"_3450":1365,"_30100":1266,"_20891":53307,"_5":14349,"_27386":53018,"_2933":53224},[],{"_3450":1366,"_30100":1266,"_20891":53309,"_5":14349,"_27386":53018,"_2933":53310},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3450":1367,"_30100":1266,"_20891":53312,"_5":14349,"_27386":53018,"_2933":53313},[],"`dms_manager_client`",{"_3450":1368,"_30100":1266,"_20891":53315,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1369,"_30100":1266,"_20891":53317,"_5":14349,"_27386":53018,"_2933":53224},[],{"_3450":1370,"_30100":1266,"_20891":53319,"_5":14349,"_27386":53018,"_2933":53320},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3450":1371,"_30100":1266,"_20891":53322,"_5":14349,"_27386":53018,"_2933":53323},[],"`device_manager_client`",{"_3450":1372,"_30100":1266,"_20891":53325,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1373,"_30100":1266,"_20891":53327,"_5":14349,"_27386":53018,"_2933":53224},[],{"_3450":1374,"_30100":1266,"_20891":53329,"_5":14349,"_27386":53018,"_2933":53330},[],"HTTP URL of Lamassu's Device Manager.",{"_3450":1375,"_30100":1266,"_20891":53332,"_5":14349,"_27386":53018,"_2933":53333},[],"`ca_client`",{"_3450":1376,"_30100":1266,"_20891":53335,"_5":14349,"_27386":53018,"_2933":24962},[],{"_3450":1377,"_30100":1266,"_20891":53337,"_5":14349,"_27386":53018,"_2933":53224},[],{"_3450":1378,"_30100":1266,"_20891":53339,"_5":14349,"_27386":53018,"_2933":53340},[],"HTTP URL of Lamassu's CA service.",{"_3450":1379,"_30100":1266,"_20891":53342,"_5":14349,"_27386":53022,"_2933":53343},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3450":1380,"_30100":1266,"_20891":53345,"_5":14349,"_27386":53022,"_2933":53346},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3450":1381,"_30100":1266,"_20891":53348,"_5":14349,"_27386":53022,"_2933":53349},[],"CloudEvent type",{"_3450":1382,"_30100":1266,"_20891":53351,"_5":14349,"_27386":53022,"_2933":53352},[],"Lamassu resource",{"_3450":1383,"_30100":1266,"_20891":53354,"_5":14349,"_27386":53022,"_2933":53355},[],"AWS Resource",{"_3450":1384,"_30100":1266,"_20891":53357,"_5":14349,"_27386":53022,"_2933":53358},[],"IAM actions",{"_3450":1385,"_30100":1266,"_20891":53360,"_5":14349,"_27386":53022,"_2933":53361},[],"AWS calls and effect",{"_3450":1386,"_30100":1266,"_20891":53363,"_5":14349,"_27386":53022,"_2933":53364},[],"Where in this page",{"_3450":1387,"_30100":1266,"_20891":53366,"_5":14349,"_27386":53022,"_2933":53367},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3450":1388,"_30100":1266,"_20891":53369,"_5":14349,"_27386":53022,"_2933":53370},[],"CA",{"_3450":1389,"_30100":1266,"_20891":53372,"_5":14349,"_27386":53022,"_2933":53373},[],"`IoTCore/CACertificate`",{"_3450":1390,"_30100":1266,"_20891":53375,"_5":14349,"_27386":53022,"_2933":53376},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3450":1391,"_30100":1266,"_20891":53378,"_5":14349,"_27386":53022,"_2933":53379},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3450":1392,"_30100":1266,"_20891":53381,"_5":14349,"_27386":53022,"_2933":53035},[],{"_3450":1393,"_30100":1266,"_20891":53383,"_5":14349,"_27386":53022,"_2933":53384},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3450":1394,"_30100":1266,"_20891":53386,"_5":14349,"_27386":53022,"_2933":53387},[],"DMS",{"_3450":1395,"_30100":1266,"_20891":53389,"_5":14349,"_27386":53022,"_2933":53390},[],"`IoTCore/ProvisioningTemplate`",{"_3450":1396,"_30100":1266,"_20891":53392,"_5":14349,"_27386":53022,"_2933":53393},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3450":1397,"_30100":1266,"_20891":53395,"_5":14349,"_27386":53022,"_2933":53396},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3450":1398,"_30100":1266,"_20891":53398,"_5":14349,"_27386":53022,"_2933":53063},[],{"_3450":1399,"_30100":1266,"_20891":53400,"_5":14349,"_27386":53022,"_2933":53401},[],"`EventBindDeviceIdentityKey`",{"_3450":1400,"_30100":1266,"_20891":53403,"_5":14349,"_27386":53022,"_2933":53404},[],"Device",{"_3450":1401,"_30100":1266,"_20891":53406,"_5":14349,"_27386":53022,"_2933":53407},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3450":1402,"_30100":1266,"_20891":53409,"_5":14349,"_27386":53022,"_2933":53410},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3450":1403,"_30100":1266,"_20891":53412,"_5":14349,"_27386":53022,"_2933":53413},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3450":1404,"_30100":1266,"_20891":53415,"_5":14349,"_27386":53022,"_2933":53071},[],{"_3450":1405,"_30100":1266,"_20891":53417,"_5":14349,"_27386":53022,"_2933":53418},[],"`EventUpdateCertificateStatusKey`",{"_3450":1406,"_30100":1266,"_20891":53420,"_5":14349,"_27386":53022,"_2933":53421},[],"Certificate",{"_3450":1407,"_30100":1266,"_20891":53423,"_5":14349,"_27386":53022,"_2933":53424},[],"`IoTCore/Certificate`",{"_3450":1408,"_30100":1266,"_20891":53426,"_5":14349,"_27386":53022,"_2933":53427},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3450":1409,"_30100":1266,"_20891":53429,"_5":14349,"_27386":53022,"_2933":53430},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3450":1410,"_30100":1266,"_20891":53432,"_5":14349,"_27386":53022,"_2933":53083},[],{"_3450":1411,"_30100":1266,"_20891":53434,"_5":14349,"_27386":53022,"_2933":53435},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3450":1412,"_30100":1266,"_20891":53437,"_5":14349,"_27386":53022,"_2933":53438},[],"Certificate / Device",{"_3450":1413,"_30100":1266,"_20891":53440,"_5":14349,"_27386":53022,"_2933":53441},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3450":1414,"_30100":1266,"_20891":53443,"_5":14349,"_27386":53022,"_2933":49448},[],{"_3450":1415,"_30100":1266,"_20891":53445,"_5":14349,"_27386":53022,"_2933":53446},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3450":1416,"_30100":1266,"_20891":53448,"_5":14349,"_27386":53022,"_2933":53091},[],{"_3450":1417,"_30100":1266,"_20891":53450,"_5":14349,"_27386":53026,"_2933":53451},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3450":1418,"_30100":1266,"_20891":53453,"_5":14349,"_27386":53030,"_2933":53454},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3450":1419,"_30100":1266,"_20891":53456,"_5":14349,"_27386":53030,"_2933":53457},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3450":1420,"_30100":1266,"_20891":53459,"_5":14349,"_27386":53034,"_2933":53460},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3450":1421,"_30100":1266,"_20891":53462,"_5":14349,"_27386":53034,"_2933":53463},[],"Transition",{"_3450":1422,"_30100":1266,"_20891":53465,"_5":14349,"_27386":53034,"_2933":53466},[],"AWS calls",{"_3450":1423,"_30100":1266,"_20891":53468,"_5":14349,"_27386":53034,"_2933":53469},[],"`NotRegistered` → `Requested`",{"_3450":1424,"_30100":1266,"_20891":53471,"_5":14349,"_27386":53034,"_2933":53472},[],"none (metadata write only)",{"_3450":1425,"_30100":1266,"_20891":53474,"_5":14349,"_27386":53034,"_2933":53475},[],"`Requested` → `Registering`",{"_3450":1426,"_30100":1266,"_20891":53477,"_5":14349,"_27386":53034,"_2933":53478},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3450":1427,"_30100":1266,"_20891":53480,"_5":14349,"_27386":53034,"_2933":53481},[],"`Registering` → `Succeeded`",{"_3450":1428,"_30100":1266,"_20891":53483,"_5":14349,"_27386":53034,"_2933":53484},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3450":1429,"_30100":1266,"_20891":53486,"_5":14349,"_27386":53034,"_2933":53487},[],"`Registering` → `Failed`",{"_3450":1430,"_30100":1266,"_20891":53489,"_5":14349,"_27386":53034,"_2933":53490},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3450":1431,"_30100":1266,"_20891":53492,"_5":14349,"_27386":53034,"_2933":53493},[],"`Failed` / `Succeeded` → `Requested`",{"_3450":1432,"_30100":1266,"_20891":53495,"_5":14349,"_27386":53034,"_2933":53496},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3450":1433,"_30100":1266,"_20891":53498,"_5":14349,"_27386":53038,"_2933":53499},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3450":1434,"_30100":1266,"_20891":53501,"_5":14349,"_27386":53038,"_2933":53502},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3450":1435,"_30100":1266,"_20891":53504,"_5":14349,"_27386":53038,"_2933":53505},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3450":1436,"_30100":1266,"_20891":53507,"_5":14349,"_27386":53038,"_2933":53508},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3450":1437,"_30100":1266,"_20891":53510,"_5":14349,"_27386":53038,"_2933":53511},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3450":1438,"_30100":1266,"_20891":53513,"_5":14349,"_27386":53038,"_2933":53514},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3450":1439,"_30100":1266,"_20891":53516,"_5":14349,"_27386":53042,"_2933":53517},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3450":1440,"_30100":1266,"_20891":53519,"_5":14349,"_27386":53046,"_2933":53520},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3450":1441,"_30100":1266,"_20891":53522,"_5":14349,"_27386":53046,"_2933":53523},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3450":1442,"_30100":1266,"_20891":53525,"_5":14349,"_27386":53050,"_2933":53526},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3450":1443,"_30100":1266,"_20891":53528,"_5":14349,"_27386":53054,"_2933":53529},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3450":1444,"_30100":1266,"_20891":53531,"_5":14349,"_27386":53054,"_2933":53532},[],"Creates or updates the IoT policies configured in the DMS.",{"_3450":1445,"_30100":1266,"_20891":53534,"_5":14349,"_27386":53054,"_2933":53535},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3450":1446,"_30100":1266,"_20891":53537,"_5":14349,"_27386":53054,"_2933":53538},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3450":1447,"_30100":1266,"_20891":53540,"_5":14349,"_27386":53054,"_2933":53541},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3450":1448,"_30100":1266,"_20891":53543,"_5":14349,"_27386":53054,"_2933":53544},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3450":1449,"_30100":1266,"_20891":53546,"_5":14349,"_27386":53054,"_2933":53547},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3450":1450,"_30100":1266,"_20891":53549,"_5":14349,"_27386":53058,"_2933":53550},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3450":1451,"_30100":1266,"_20891":53552,"_5":14349,"_27386":53058,"_2933":53553},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3450":1452,"_30100":1266,"_20891":53555,"_5":14349,"_27386":53058,"_2933":53556},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3450":1453,"_30100":1266,"_20891":53558,"_5":14349,"_27386":53058,"_2933":53559},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3450":1454,"_30100":1266,"_20891":53561,"_5":14349,"_27386":53058,"_2933":53562},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3450":1455,"_30100":1266,"_20891":53564,"_5":14349,"_27386":53062,"_2933":53565},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3450":1456,"_30100":1266,"_20891":53567,"_5":14349,"_27386":53062,"_2933":53463},[],{"_3450":1457,"_30100":1266,"_20891":53569,"_5":14349,"_27386":53062,"_2933":53466},[],{"_3450":1458,"_30100":1266,"_20891":53571,"_5":14349,"_27386":53062,"_2933":53572},[],"`Unconfigured` → `None` / `Auto`",{"_3450":1459,"_30100":1266,"_20891":53574,"_5":14349,"_27386":53062,"_2933":53575},[],"none (configuration only)",{"_3450":1460,"_30100":1266,"_20891":53577,"_5":14349,"_27386":53062,"_2933":53578},[],"`None` ↔ `Auto`",{"_3450":1461,"_30100":1266,"_20891":53580,"_5":14349,"_27386":53062,"_2933":53575},[],{"_3450":1462,"_30100":1266,"_20891":53582,"_5":14349,"_27386":53062,"_2933":53583},[],"Any → `Jitp`",{"_3450":1463,"_30100":1266,"_20891":53585,"_5":14349,"_27386":53062,"_2933":53586},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3450":1464,"_30100":1266,"_20891":53588,"_5":14349,"_27386":53062,"_2933":53589},[],"`Jitp` → `None` / `Auto`",{"_3450":1465,"_30100":1266,"_20891":53591,"_5":14349,"_27386":53062,"_2933":53592},[],"none (the template stays in the AWS account)",{"_3450":1466,"_30100":1266,"_20891":53594,"_5":14349,"_27386":53066,"_2933":53595},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3450":1467,"_30100":1266,"_20891":53597,"_5":14349,"_27386":53066,"_2933":53598},[],"The full flow from the device's perspective is:",{"_3450":1468,"_30100":1266,"_20891":53600,"_5":14349,"_27386":53066,"_2933":53601},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3450":1469,"_30100":1266,"_20891":53603,"_5":14349,"_27386":53070,"_2933":53604},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3450":1470,"_30100":1266,"_20891":53606,"_5":14349,"_27386":53070,"_2933":53463},[],{"_3450":1471,"_30100":1266,"_20891":53608,"_5":14349,"_27386":53070,"_2933":53466},[],{"_3450":1472,"_30100":1266,"_20891":53610,"_5":14349,"_27386":53070,"_2933":53611},[],"`Absent` → `Provisioned`",{"_3450":1473,"_30100":1266,"_20891":53613,"_5":14349,"_27386":53070,"_2933":53614},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3450":1474,"_30100":1266,"_20891":53616,"_5":14349,"_27386":53070,"_2933":53617},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3450":1475,"_30100":1266,"_20891":53619,"_5":14349,"_27386":53070,"_2933":53620},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3450":1476,"_30100":1266,"_20891":53622,"_5":14349,"_27386":53070,"_2933":53623},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3450":1477,"_30100":1266,"_20891":53625,"_5":14349,"_27386":53074,"_2933":53626},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3450":1478,"_30100":1266,"_20891":53628,"_5":14349,"_27386":53074,"_2933":53629},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3450":1479,"_30100":1266,"_20891":53631,"_5":14349,"_27386":53074,"_2933":53632},[],"For the JITP flow to work correctly:",{"_3450":1480,"_30100":1266,"_20891":53634,"_5":14349,"_27386":53074,"_2933":53635},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3450":1481,"_30100":1266,"_20891":53637,"_5":14349,"_27386":53074,"_2933":53638},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3450":1482,"_30100":1266,"_20891":53640,"_5":14349,"_27386":53074,"_2933":53641},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3450":1483,"_30100":1266,"_20891":53643,"_5":14349,"_27386":53074,"_2933":53644},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3450":1484,"_30100":1266,"_20891":53646,"_5":14349,"_27386":53078,"_2933":53647},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3450":1485,"_30100":1266,"_20891":53649,"_5":14349,"_27386":53078,"_2933":53650},[],"Status in Lamassu",{"_3450":1486,"_30100":1266,"_20891":53652,"_5":14349,"_27386":53078,"_2933":53653},[],"Revocation reason",{"_3450":1487,"_30100":1266,"_20891":53655,"_5":14349,"_27386":53078,"_2933":53656},[],"Status in AWS IoT Core",{"_3450":1488,"_30100":1266,"_20891":53658,"_5":14349,"_27386":53078,"_2933":53659},[],"`Active`",{"_3450":1489,"_30100":1266,"_20891":53661,"_5":14349,"_27386":53078,"_2933":53662},[],"None",{"_3450":1490,"_30100":1266,"_20891":53664,"_5":14349,"_27386":53078,"_2933":53665},[],"`ACTIVE`",{"_3450":1491,"_30100":1266,"_20891":53667,"_5":14349,"_27386":53078,"_2933":53668},[],"`Revoked`",{"_3450":1492,"_30100":1266,"_20891":53670,"_5":14349,"_27386":53078,"_2933":53671},[],"`certificateHold`",{"_3450":1493,"_30100":1266,"_20891":53673,"_5":14349,"_27386":53078,"_2933":53674},[],"`INACTIVE`",{"_3450":1494,"_30100":1266,"_20891":53676,"_5":14349,"_27386":53078,"_2933":53668},[],{"_3450":1495,"_30100":1266,"_20891":53678,"_5":14349,"_27386":53078,"_2933":53679},[],"Any other reason",{"_3450":1496,"_30100":1266,"_20891":53681,"_5":14349,"_27386":53078,"_2933":53682},[],"`REVOKED`",{"_3450":1497,"_30100":1266,"_20891":53684,"_5":14349,"_27386":53078,"_2933":53685},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3450":1498,"_30100":1266,"_20891":53687,"_5":14349,"_27386":53082,"_2933":53688},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3450":1499,"_30100":1266,"_20891":53690,"_5":14349,"_27386":53082,"_2933":53463},[],{"_3450":1500,"_30100":1266,"_20891":53692,"_5":14349,"_27386":53082,"_2933":53466},[],{"_3450":1501,"_30100":1266,"_20891":53694,"_5":14349,"_27386":53082,"_2933":53695},[],"`NotSynced` → `Active`",{"_3450":1502,"_30100":1266,"_20891":53697,"_5":14349,"_27386":53082,"_2933":53174},[],{"_3450":1503,"_30100":1266,"_20891":53699,"_5":14349,"_27386":53082,"_2933":53700},[],"`Active` → `Inactive`",{"_3450":1504,"_30100":1266,"_20891":53702,"_5":14349,"_27386":53082,"_2933":53703},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3450":1505,"_30100":1266,"_20891":53705,"_5":14349,"_27386":53082,"_2933":53706},[],"`Active` → `Revoked`",{"_3450":1506,"_30100":1266,"_20891":53708,"_5":14349,"_27386":53082,"_2933":53703},[],{"_3450":1507,"_30100":1266,"_20891":53710,"_5":14349,"_27386":53082,"_2933":53711},[],"`Inactive` / `Revoked` → `Active`",{"_3450":1508,"_30100":1266,"_20891":53713,"_5":14349,"_27386":53082,"_2933":53174},[],{"_3450":1509,"_30100":1266,"_20891":53715,"_5":14349,"_27386":53082,"_2933":53716},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3450":1510,"_30100":1266,"_20891":53718,"_5":14349,"_27386":53082,"_2933":53719},[],"none (these states are not synced to AWS)",{"_3450":1511,"_30100":1266,"_20891":53721,"_5":14349,"_27386":53086,"_2933":53722},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3450":1512,"_30100":1266,"_20891":53724,"_5":14349,"_27386":53086,"_2933":53725},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3450":1513,"_30100":1266,"_20891":53727,"_5":14349,"_27386":53086,"_2933":53728},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3450":1514,"_30100":1266,"_20891":53730,"_5":14349,"_27386":53090,"_2933":53731},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3450":1515,"_30100":1266,"_20891":53733,"_5":14349,"_27386":53090,"_2933":53734},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3450":1516,"_30100":1266,"_20891":53736,"_5":14349,"_27386":53094,"_2933":53737},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3450":1517,"_30100":1266,"_20891":53739,"_5":14349,"_27386":53094,"_2933":53740},[],"There are two action types:",{"_3450":1518,"_30100":1266,"_20891":53742,"_5":14349,"_27386":53094,"_2933":53743},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3450":1519,"_30100":1266,"_20891":53745,"_5":14349,"_27386":53094,"_2933":53746},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3450":1520,"_30100":1266,"_20891":53748,"_5":14349,"_27386":53094,"_2933":53749},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3450":1521,"_30100":1266,"_20891":53751,"_5":14349,"_27386":53098,"_2933":53752},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3450":1522,"_30100":1266,"_20891":53754,"_5":14349,"_27386":53098,"_2933":53755},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3450":1523,"_30100":1266,"_20891":53757,"_5":14349,"_27386":53098,"_2933":53758},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3450":1524,"_30100":1266,"_20891":53760,"_5":14349,"_27386":53102,"_2933":53761},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3450":1525,"_30100":1266,"_20891":53763,"_5":14349,"_27386":53102,"_2933":53764},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3450":1526,"_30100":1266,"_20891":53766,"_5":14349,"_27386":53102,"_2933":53767},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3450":1527,"_30100":1266,"_20891":53769,"_5":14349,"_27386":53102,"_2933":53770},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3450":1528,"_30100":1266,"_20891":53772,"_5":14349,"_27386":53102,"_2933":53773},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3450":1529,"_30100":1266,"_20891":53775,"_5":14349,"_27386":53102,"_2933":53776},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3450":1530,"_30100":1266,"_20891":53778,"_5":14349,"_27386":53102,"_2933":53779},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3450":1531,"_30100":1266,"_20891":53781,"_5":14349,"_27386":53102,"_2933":53782},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3450":1532,"_30100":1266,"_20891":53784,"_5":14349,"_27386":53102,"_2933":53785},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3450":1533,"_30100":1266,"_20891":53787,"_5":14349,"_27386":53102,"_2933":53788},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3450":1534,"_30100":1266,"_20891":53790,"_5":14349,"_27386":53102,"_2933":53791},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3450":1535,"_30100":1266,"_20891":53793,"_5":14349,"_27386":53102,"_2933":53794},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3450":1536,"_30100":1266,"_20891":53796,"_5":14349,"_27386":53102,"_2933":53797},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3450":1537,"_30100":1266,"_20891":53799,"_5":14349,"_27386":53102,"_2933":53800},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3450":1538,"_30100":1266,"_20891":53802,"_5":14349,"_27386":53102,"_2933":53803},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3450":1539,"_30100":1266,"_20891":53805,"_5":14349,"_27386":53102,"_2933":53806},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3450":1540,"_30100":1266,"_20891":53808,"_5":14349,"_27386":53102,"_2933":53809},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3450":1541,"_30100":1266,"_20891":53811,"_5":14349,"_27386":53102,"_2933":53812},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3450":1542,"_30100":1266,"_20891":53814,"_5":14349,"_27386":53102,"_2933":53815},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3450":1543,"_30100":1266,"_20891":53817,"_5":14349,"_27386":53102,"_2933":53818},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3450":1544,"_30100":1266,"_20891":53820,"_5":14349,"_27386":53102,"_2933":53821},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3450":1545,"_30100":1266,"_20891":53823,"_5":14349,"_27386":53102,"_2933":53824},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3450":1546,"_30100":1266,"_20891":53826,"_5":14349,"_27386":53102,"_2933":53827},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3450":1547,"_30100":1266,"_20891":53829,"_5":14349,"_27386":53102,"_2933":53830},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3450":1548,"_30100":1548,"_5":14701,"_2933":51534,"_30453":53832,"_20891":53833,"_27386":1548},[49052,50520,51534],[],{"_3450":1549,"_30100":1548,"_20891":53835,"_5":14349,"_27386":1548,"_2933":53836},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3450":1550,"_30100":1548,"_5":30450,"_20891":53838,"_27386":53839,"_2933":53840},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#start-here","Start here",{"_3450":1551,"_30100":1548,"_5":30450,"_20891":53842,"_27386":53843,"_2933":51532},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#devices-and-identities",{"_3450":1552,"_30100":1548,"_5":30450,"_20891":53845,"_27386":53846,"_2933":51715},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#enrollment-with-pki",{"_3450":1553,"_30100":1548,"_5":30450,"_20891":53848,"_27386":53849,"_2933":52999},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#integrations",{"_3450":1554,"_30100":1548,"_5":30450,"_20891":53851,"_27386":53852,"_2933":53853},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3450":1555,"_30100":1548,"_20891":53855,"_5":14349,"_27386":1548,"_2933":53856},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3450":1556,"_30100":1548,"_20891":53858,"_5":14349,"_27386":53839,"_2933":53859},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3450":1557,"_30100":1548,"_20891":53861,"_5":14349,"_27386":53839,"_2933":53862},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3450":1558,"_30100":1548,"_20891":53864,"_5":14349,"_27386":53843,"_2933":53865},[],"Resource",{"_3450":1559,"_30100":1548,"_20891":53867,"_5":14349,"_27386":53843,"_2933":53868},[],"What it represents",{"_3450":1560,"_30100":1548,"_20891":53870,"_5":14349,"_27386":53843,"_2933":53871},[],"**Device**",{"_3450":1561,"_30100":1548,"_20891":53873,"_5":14349,"_27386":53843,"_2933":53874},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3450":1562,"_30100":1548,"_20891":53876,"_5":14349,"_27386":53843,"_2933":53877},[],"**Identity**",{"_3450":1563,"_30100":1548,"_20891":53879,"_5":14349,"_27386":53843,"_2933":53880},[],"The device's association with its certificates: an active version and a history.",{"_3450":1564,"_30100":1548,"_20891":53882,"_5":14349,"_27386":53843,"_2933":53883},[],"**DMS**",{"_3450":1565,"_30100":1548,"_20891":53885,"_5":14349,"_27386":53843,"_2933":53886},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3450":1566,"_30100":1548,"_20891":53888,"_5":14349,"_27386":53843,"_2933":53889},[],"**Fleet**",{"_3450":1567,"_30100":1548,"_20891":53891,"_5":14349,"_27386":53843,"_2933":53892},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3450":1568,"_30100":1548,"_20891":53894,"_5":14349,"_27386":53843,"_2933":53895},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3450":1569,"_30100":1548,"_20891":53897,"_5":14349,"_27386":53843,"_2933":53898},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3450":1570,"_30100":1548,"_20891":53900,"_5":14349,"_27386":53846,"_2933":53901},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3450":1571,"_30100":1548,"_20891":53903,"_5":14349,"_27386":53846,"_2933":53904},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3450":1572,"_30100":1548,"_20891":53906,"_5":14349,"_27386":53846,"_2933":53907},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3450":1573,"_30100":1548,"_20891":53909,"_5":14349,"_27386":53846,"_2933":53910},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3450":1574,"_30100":1548,"_20891":53912,"_5":14349,"_27386":53846,"_2933":53913},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3450":1575,"_30100":1548,"_20891":53915,"_5":14349,"_27386":53846,"_2933":53916},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3450":1576,"_30100":1548,"_20891":53918,"_5":14349,"_27386":53846,"_2933":53919},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3450":1577,"_30100":1548,"_20891":53921,"_5":14349,"_27386":53846,"_2933":53922},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3450":1578,"_30100":1548,"_20891":53924,"_5":14349,"_27386":53849,"_2933":53925},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3450":1579,"_30100":1548,"_20891":53927,"_5":14349,"_27386":53849,"_2933":53928},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3450":1580,"_30100":1548,"_20891":53930,"_5":14349,"_27386":53852,"_2933":53931},[],"Participant",{"_3450":1581,"_30100":1548,"_20891":53933,"_5":14349,"_27386":53852,"_2933":53934},[],"Responsibility",{"_3450":1582,"_30100":1548,"_20891":53936,"_5":14349,"_27386":53852,"_2933":53937},[],"PKI administrator",{"_3450":1583,"_30100":1548,"_20891":53939,"_5":14349,"_27386":53852,"_2933":53940},[],"CA, issuance profile, chain and revocation publication.",{"_3450":1584,"_30100":1548,"_20891":53942,"_5":14349,"_27386":53852,"_2933":53943},[],"Provisioning administrator",{"_3450":1585,"_30100":1548,"_20891":53945,"_5":14349,"_27386":53852,"_2933":53946},[],"DMS, admission, authentication per operation and inventory.",{"_3450":1586,"_30100":1548,"_20891":53948,"_5":14349,"_27386":53852,"_2933":53949},[],"Device integrator",{"_3450":1587,"_30100":1548,"_20891":53951,"_5":14349,"_27386":53852,"_2933":53952},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3450":1588,"_30100":1548,"_20891":53954,"_5":14349,"_27386":53852,"_2933":53955},[],"Consumer integrator",{"_3450":1589,"_30100":1548,"_20891":53957,"_5":14349,"_27386":53852,"_2933":53958},[],"Trusted issuers, validation and device permissions in the destination.",{"_3450":1590,"_30100":1548,"_20891":53960,"_5":14349,"_27386":53852,"_2933":53961},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3450":1591,"_30100":1591,"_5":14701,"_2933":53963,"_30453":53964,"_20891":53966,"_27386":1591},"Enroll and connect your first device",[49052,50520,51534,53965],"Getting started",[],{"_3450":1592,"_30100":1591,"_20891":53968,"_5":14349,"_27386":1591,"_2933":53969},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3450":1593,"_30100":1591,"_5":30450,"_20891":53971,"_27386":53972,"_2933":49062},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3450":1594,"_30100":1591,"_5":30450,"_20891":53974,"_27386":53975,"_2933":53976},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3450":1595,"_30100":1591,"_5":30450,"_20891":53978,"_27386":53979,"_2933":53980},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3450":1596,"_30100":1591,"_5":30450,"_20891":53982,"_27386":53983,"_2933":53984},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3450":1597,"_30100":1591,"_5":30450,"_20891":53986,"_27386":53987,"_2933":53988},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3450":1598,"_30100":1591,"_5":30450,"_20891":53990,"_27386":53991,"_2933":53992},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3450":1599,"_30100":1591,"_5":30450,"_20891":53994,"_27386":53995,"_2933":53996},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3450":1600,"_30100":1591,"_5":30450,"_20891":53998,"_27386":53999,"_2933":54000},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3450":1601,"_30100":1591,"_20891":54002,"_5":14349,"_27386":1591,"_2933":54003},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3450":1602,"_30100":1591,"_20891":54005,"_5":14349,"_27386":53972,"_2933":54006},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3450":1603,"_30100":1591,"_20891":54008,"_5":14349,"_27386":53972,"_2933":54009},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3450":1604,"_30100":1591,"_20891":54011,"_5":14349,"_27386":53972,"_2933":54012},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3450":1605,"_30100":1591,"_20891":54014,"_5":14349,"_27386":53972,"_2933":54015},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3450":1606,"_30100":1591,"_20891":54017,"_5":14349,"_27386":53972,"_2933":54018},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3450":1607,"_30100":1591,"_20891":54020,"_5":14349,"_27386":53975,"_2933":54021},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3450":1608,"_30100":1591,"_20891":54023,"_5":14349,"_27386":53975,"_2933":54024},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3450":1609,"_30100":1591,"_20891":54026,"_5":14349,"_27386":53979,"_2933":54027},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3450":1610,"_30100":1591,"_20891":54029,"_5":14349,"_27386":53979,"_2933":54030},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3450":1611,"_30100":1591,"_20891":54032,"_5":14349,"_27386":53979,"_2933":54033},[],"Setting",{"_3450":1612,"_30100":1591,"_20891":54035,"_5":14349,"_27386":53979,"_2933":54036},[],"Evaluation value",{"_3450":1613,"_30100":1591,"_20891":54038,"_5":14349,"_27386":53979,"_2933":54039},[],"Enrollment CA",{"_3450":1614,"_30100":1591,"_20891":54041,"_5":14349,"_27386":53979,"_2933":54042},[],"Issuing root from `device-root.pem`.",{"_3450":1615,"_30100":1591,"_20891":54044,"_5":14349,"_27386":53979,"_2933":51845},[],{"_3450":1616,"_30100":1591,"_20891":54046,"_5":14349,"_27386":53979,"_2933":54047},[],"The 1-hour leaf profile you just prepared.",{"_3450":1617,"_30100":1591,"_20891":54049,"_5":14349,"_27386":53979,"_2933":54050},[],"Protocol / Registration Mode",{"_3450":1618,"_30100":1591,"_20891":54052,"_5":14349,"_27386":53979,"_2933":54053},[],"`EST_RFC7030` / `JITP`.",{"_3450":1619,"_30100":1591,"_20891":54055,"_5":14349,"_27386":53979,"_2933":54056},[],"Verify CSR Signature",{"_3450":1620,"_30100":1591,"_20891":54058,"_5":14349,"_27386":53979,"_2933":54059},[],"Enabled.",{"_3450":1621,"_30100":1591,"_20891":54061,"_5":14349,"_27386":53979,"_2933":54062},[],"Enable Replaceable Enrollment",{"_3450":1622,"_30100":1591,"_20891":54064,"_5":14349,"_27386":53979,"_2933":54065},[],"Disabled; the ID must be new.",{"_3450":1623,"_30100":1591,"_20891":54067,"_5":14349,"_27386":53979,"_2933":54068},[],"Initial authentication",{"_3450":1624,"_30100":1591,"_20891":54070,"_5":14349,"_27386":53979,"_2933":54071},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3450":1625,"_30100":1591,"_20891":54073,"_5":14349,"_27386":53979,"_2933":54074},[],"Renewal authentication",{"_3450":1626,"_30100":1591,"_20891":54076,"_5":14349,"_27386":53979,"_2933":54077},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3450":1627,"_30100":1591,"_20891":54079,"_5":14349,"_27386":53979,"_2933":54080},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3450":1628,"_30100":1591,"_20891":54082,"_5":14349,"_27386":53979,"_2933":54083},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3450":1629,"_30100":1591,"_20891":54085,"_5":14349,"_27386":53979,"_2933":54086},[],"Re-enrollment Delta",{"_3450":1630,"_30100":1591,"_20891":54088,"_5":14349,"_27386":53979,"_2933":54089},[],"1 hour.",{"_3450":1631,"_30100":1591,"_20891":54091,"_5":14349,"_27386":53979,"_2933":54092},[],"Preventive / Critical Delta",{"_3450":1632,"_30100":1591,"_20891":54094,"_5":14349,"_27386":53979,"_2933":54095},[],"30 minutes / 10 minutes.",{"_3450":1633,"_30100":1591,"_20891":54097,"_5":14349,"_27386":53979,"_2933":54098},[],"Revoke on Re-enrollment",{"_3450":1634,"_30100":1591,"_20891":54100,"_5":14349,"_27386":53979,"_2933":54101},[],"Disabled to test the successor before retiring the previous identity.",{"_3450":1635,"_30100":1591,"_20891":54103,"_5":14349,"_27386":53979,"_2933":51853},[],{"_3450":1636,"_30100":1591,"_20891":54105,"_5":14349,"_27386":53979,"_2933":54106},[],"Disabled; the operational key is generated in the client.",{"_3450":1637,"_30100":1591,"_20891":54108,"_5":14349,"_27386":53979,"_2933":54109},[],"CA Distribution",{"_3450":1638,"_30100":1591,"_20891":54111,"_5":14349,"_27386":53979,"_2933":54112},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3450":1639,"_30100":1591,"_20891":54114,"_5":14349,"_27386":53979,"_2933":54115},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3450":1640,"_30100":1591,"_20891":54117,"_5":14349,"_27386":53983,"_2933":54118},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3450":1641,"_30100":1591,"_20891":54120,"_5":14349,"_27386":53983,"_2933":54121},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3450":1642,"_30100":1591,"_20891":54123,"_5":14349,"_27386":53987,"_2933":54124},[],"Generate a new key and CSR with the selected identifier:",{"_3450":1643,"_30100":1591,"_20891":54126,"_5":14349,"_27386":53987,"_2933":54127},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3450":1644,"_30100":1591,"_20891":54129,"_5":14349,"_27386":53987,"_2933":54130},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3450":1645,"_30100":1591,"_20891":54132,"_5":14349,"_27386":53991,"_2933":54133},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3450":1646,"_30100":1591,"_20891":54135,"_5":14349,"_27386":53991,"_2933":54136},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3450":1647,"_30100":1591,"_20891":54138,"_5":14349,"_27386":53995,"_2933":54139},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3450":1648,"_30100":1591,"_20891":54141,"_5":14349,"_27386":53995,"_2933":54142},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3450":1649,"_30100":1591,"_20891":54144,"_5":14349,"_27386":53995,"_2933":54145},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3450":1650,"_30100":1591,"_20891":54147,"_5":14349,"_27386":53995,"_2933":54148},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3450":1651,"_30100":1591,"_20891":54150,"_5":14349,"_27386":53995,"_2933":54151},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3450":1652,"_30100":1591,"_20891":54153,"_5":14349,"_27386":53999,"_2933":54154},[],"Check",{"_3450":1653,"_30100":1591,"_20891":54156,"_5":14349,"_27386":53999,"_2933":54157},[],"Expected result",{"_3450":1654,"_30100":1591,"_20891":54159,"_5":14349,"_27386":53999,"_2933":54160},[],"Registration",{"_3450":1655,"_30100":1591,"_20891":54162,"_5":14349,"_27386":53999,"_2933":54163},[],"ID created automatically and correct DMS.",{"_3450":1656,"_30100":1591,"_20891":54165,"_5":14349,"_27386":53999,"_2933":53421},[],{"_3450":1657,"_30100":1591,"_20891":54167,"_5":14349,"_27386":53999,"_2933":54168},[],"CN, profile, serial and key verified.",{"_3450":1658,"_30100":1591,"_20891":54170,"_5":14349,"_27386":53999,"_2933":54171},[],"Inventory",{"_3450":1659,"_30100":1591,"_20891":54173,"_5":14349,"_27386":53999,"_2933":54174},[],"Received serial visible as the current identity and in history.",{"_3450":1660,"_30100":1591,"_20891":54176,"_5":14349,"_27386":53999,"_2933":54177},[],"Consumer",{"_3450":1661,"_30100":1591,"_20891":54179,"_5":14349,"_27386":53999,"_2933":54180},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3450":1662,"_30100":1591,"_20891":54182,"_5":14349,"_27386":53999,"_2933":54183},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3450":1663,"_30100":1591,"_20891":54185,"_5":14349,"_27386":53999,"_2933":54186},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3450":1664,"_30100":1664,"_5":14701,"_2933":51550,"_30453":54188,"_20891":54189,"_27386":1664},[49052,50520,51534,53965],[],{"_3450":1665,"_30100":1664,"_20891":54191,"_5":14349,"_27386":1664,"_2933":54192},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3450":1666,"_30100":1664,"_5":30450,"_20891":54194,"_27386":54195,"_2933":49062},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3450":1667,"_30100":1664,"_5":30450,"_20891":54197,"_27386":54198,"_2933":54199},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3450":1668,"_30100":1664,"_5":30450,"_20891":54201,"_27386":54202,"_2933":54203},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3450":1669,"_30100":1664,"_5":30450,"_20891":54205,"_27386":54206,"_2933":54207},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3450":1670,"_30100":1664,"_5":30450,"_20891":54209,"_27386":54210,"_2933":54211},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3450":1671,"_30100":1664,"_5":30450,"_20891":54213,"_27386":54214,"_2933":54215},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3450":1672,"_30100":1664,"_5":30450,"_20891":54217,"_27386":54218,"_2933":54157},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3450":1673,"_30100":1664,"_5":30450,"_20891":54220,"_27386":54221,"_2933":54222},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3450":1674,"_30100":1664,"_5":30450,"_20891":54224,"_27386":54225,"_2933":54226},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3450":1675,"_30100":1664,"_20891":54228,"_5":14349,"_27386":1664,"_2933":54229},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3450":1676,"_30100":1664,"_20891":54231,"_5":14349,"_27386":1664,"_2933":54232},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3450":1677,"_30100":1664,"_20891":54234,"_5":14349,"_27386":54195,"_2933":54235},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3450":1678,"_30100":1664,"_20891":54237,"_5":14349,"_27386":54195,"_2933":54238},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3450":1679,"_30100":1664,"_20891":54240,"_5":14349,"_27386":54195,"_2933":54241},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3450":1680,"_30100":1664,"_20891":54243,"_5":14349,"_27386":54195,"_2933":54244},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3450":1681,"_30100":1664,"_20891":54246,"_5":14349,"_27386":54198,"_2933":54247},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3450":1682,"_30100":1664,"_20891":54249,"_5":14349,"_27386":54198,"_2933":54250},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3450":1683,"_30100":1664,"_20891":54252,"_5":14349,"_27386":54198,"_2933":54253},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3450":1684,"_30100":1664,"_20891":54255,"_5":14349,"_27386":54198,"_2933":54256},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3450":1685,"_30100":1664,"_20891":54258,"_5":14349,"_27386":54198,"_2933":54259},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3450":1686,"_30100":1664,"_20891":54261,"_5":14349,"_27386":54198,"_2933":54262},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3450":1687,"_30100":1664,"_20891":54264,"_5":14349,"_27386":54198,"_2933":54265},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3450":1688,"_30100":1664,"_20891":54267,"_5":14349,"_27386":54198,"_2933":54268},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3450":1689,"_30100":1664,"_20891":54270,"_5":14349,"_27386":54202,"_2933":54271},[],"Open **Managed Devices** and the registration action. Complete:",{"_3450":1690,"_30100":1664,"_20891":54273,"_5":14349,"_27386":54202,"_2933":54274},[],"**Device ID**: `device-001`.",{"_3450":1691,"_30100":1664,"_20891":54276,"_5":14349,"_27386":54202,"_2933":54277},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3450":1692,"_30100":1664,"_20891":54279,"_5":14349,"_27386":54202,"_2933":54280},[],"**Icon** and **Tags**: optional classification.",{"_3450":1693,"_30100":1664,"_20891":54282,"_5":14349,"_27386":54202,"_2933":54283},[],"Confirm registration.",{"_3450":1694,"_30100":1664,"_20891":54285,"_5":14349,"_27386":54206,"_2933":54286},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3450":1695,"_30100":1664,"_20891":54288,"_5":14349,"_27386":54206,"_2933":54289},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3450":1696,"_30100":1664,"_20891":54291,"_5":14349,"_27386":54210,"_2933":54292},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3450":1697,"_30100":1664,"_20891":54294,"_5":14349,"_27386":54210,"_2933":54295},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3450":1698,"_30100":1664,"_20891":54297,"_5":14349,"_27386":54214,"_2933":54298},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3450":1699,"_30100":1664,"_20891":54300,"_5":14349,"_27386":54214,"_2933":54301},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3450":1700,"_30100":1664,"_20891":54303,"_5":14349,"_27386":54218,"_2933":54154},[],{"_3450":1701,"_30100":1664,"_20891":54305,"_5":14349,"_27386":54218,"_2933":54306},[],"Result",{"_3450":1702,"_30100":1664,"_20891":54308,"_5":14349,"_27386":54218,"_2933":53404},[],{"_3450":1703,"_30100":1664,"_20891":54310,"_5":14349,"_27386":54218,"_2933":54311},[],"`device-001` appears in inventory with the expected DMS.",{"_3450":1704,"_30100":1664,"_20891":54313,"_5":14349,"_27386":54218,"_2933":54314},[],"Current identity",{"_3450":1705,"_30100":1664,"_20891":54316,"_5":14349,"_27386":54218,"_2933":54317},[],"The associated certificate matches the one you verified in PKI.",{"_3450":1706,"_30100":1664,"_20891":54319,"_5":14349,"_27386":54218,"_2933":54320},[],"History",{"_3450":1707,"_30100":1664,"_20891":54322,"_5":14349,"_27386":54218,"_2933":54323},[],"The associated issuance appears with its serial number and dates.",{"_3450":1708,"_30100":1664,"_20891":54325,"_5":14349,"_27386":54218,"_2933":54326},[],"Key and certificate",{"_3450":1709,"_30100":1664,"_20891":54328,"_5":14349,"_27386":54218,"_2933":54329},[],"You have the verified pair ready to install on the device.",{"_3450":1710,"_30100":1664,"_20891":54331,"_5":14349,"_27386":54221,"_2933":54332},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3450":1711,"_30100":1664,"_20891":54334,"_5":14349,"_27386":54221,"_2933":54335},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3450":1712,"_30100":1664,"_20891":54337,"_5":14349,"_27386":54221,"_2933":54338},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3450":1713,"_30100":1664,"_20891":54340,"_5":14349,"_27386":54221,"_2933":54341},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3450":1714,"_30100":1664,"_20891":54343,"_5":14349,"_27386":54225,"_2933":54344},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3450":1715,"_30100":1664,"_20891":54346,"_5":14349,"_27386":54225,"_2933":54347},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3450":1716,"_30100":1664,"_20891":54349,"_5":14349,"_27386":54225,"_2933":54350},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3450":1717,"_30100":1717,"_5":14701,"_2933":54352,"_30453":54353,"_20891":54354,"_27386":1717},"Lamassu IoT Platform",[49052,50520],[],{"_3450":1718,"_30100":1717,"_20891":54356,"_5":14349,"_27386":1717,"_2933":54357},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3450":1719,"_30100":1717,"_5":30450,"_20891":54359,"_27386":54360,"_2933":53840},[],"/docs/pr-preview/pr-61/platform/overview#start-here",{"_3450":1720,"_30100":1717,"_5":30450,"_20891":54362,"_27386":54363,"_2933":54364},[],"/docs/pr-preview/pr-61/platform/overview#choose-your-path","Choose your path",{"_3450":1721,"_30100":1717,"_5":30450,"_20891":54366,"_27386":54367,"_2933":54368},[],"/docs/pr-preview/pr-61/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3450":1722,"_30100":1717,"_5":30450,"_20891":54370,"_27386":54371,"_2933":54372},[],"/docs/pr-preview/pr-61/platform/overview#core-capabilities","Core capabilities",{"_3450":1723,"_30100":1717,"_5":30450,"_20891":54374,"_27386":54375,"_2933":54376},[],"/docs/pr-preview/pr-61/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3450":1724,"_30100":1717,"_5":30450,"_20891":54378,"_27386":54379,"_2933":54380},[],"/docs/pr-preview/pr-61/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3450":1725,"_30100":1717,"_5":30450,"_20891":54382,"_27386":54383,"_2933":54384},[],"/docs/pr-preview/pr-61/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3450":1726,"_30100":1717,"_5":30450,"_20891":54386,"_27386":54387,"_2933":54388},[],"/docs/pr-preview/pr-61/platform/overview#automate-device-identities","Automate device identities",{"_3450":1727,"_30100":1717,"_5":30450,"_20891":54390,"_27386":54391,"_2933":54392},[],"/docs/pr-preview/pr-61/platform/overview#publish-validation-status","Publish validation status",{"_3450":1728,"_30100":1717,"_5":30450,"_20891":54394,"_27386":54395,"_2933":54396},[],"/docs/pr-preview/pr-61/platform/overview#react-to-events","React to events",{"_3450":1729,"_30100":1717,"_5":30450,"_20891":54398,"_27386":54399,"_2933":54400},[],"/docs/pr-preview/pr-61/platform/overview#operational-reference","Operational reference",{"_3450":1730,"_30100":1717,"_20891":54402,"_5":14349,"_27386":1717,"_2933":54403},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3450":1731,"_30100":1717,"_20891":54405,"_5":14349,"_27386":54360,"_2933":54406},[],"Choose the result you need:",{"_3450":1732,"_30100":1717,"_20891":54408,"_5":14349,"_27386":54360,"_2933":54409},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3450":1733,"_30100":1717,"_20891":54411,"_5":14349,"_27386":54360,"_2933":54412},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3450":1734,"_30100":1717,"_20891":54414,"_5":14349,"_27386":54360,"_2933":54415},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3450":1735,"_30100":1717,"_20891":54417,"_5":14349,"_27386":54363,"_2933":54418},[],"Section",{"_3450":1736,"_30100":1717,"_20891":54420,"_5":14349,"_27386":54363,"_2933":54421},[],"What you manage",{"_3450":1737,"_30100":1717,"_20891":54423,"_5":14349,"_27386":54363,"_2933":54424},[],"Entry point",{"_3450":1738,"_30100":1717,"_20891":54426,"_5":14349,"_27386":54363,"_2933":54427},[],"**PKI**",{"_3450":1739,"_30100":1717,"_20891":54429,"_5":14349,"_27386":54363,"_2933":54430},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3450":1740,"_30100":1717,"_20891":54432,"_5":14349,"_27386":54363,"_2933":54433},[],"PKI overview",{"_3450":1741,"_30100":1717,"_20891":54435,"_5":14349,"_27386":54363,"_2933":54436},[],"**IoT Fleets**",{"_3450":1742,"_30100":1717,"_20891":54438,"_5":14349,"_27386":54363,"_2933":54439},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3450":1743,"_30100":1717,"_20891":54441,"_5":14349,"_27386":54363,"_2933":54442},[],"IoT Fleets overview",{"_3450":1744,"_30100":1717,"_20891":54444,"_5":14349,"_27386":54363,"_2933":54445},[],"**Administration**",{"_3450":1745,"_30100":1717,"_20891":54447,"_5":14349,"_27386":54363,"_2933":54448},[],"Operator permissions, audit and event subscriptions.",{"_3450":1746,"_30100":1717,"_20891":54450,"_5":14349,"_27386":54363,"_2933":50518},[],{"_3450":1747,"_30100":1717,"_20891":54452,"_5":14349,"_27386":54363,"_2933":54453},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3450":1748,"_30100":1717,"_20891":54455,"_5":14349,"_27386":54367,"_2933":54456},[],"An identity's journey connects four responsibilities:",{"_3450":1749,"_30100":1717,"_20891":54458,"_5":14349,"_27386":54367,"_2933":54459},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3450":1750,"_30100":1717,"_20891":54461,"_5":14349,"_27386":54367,"_2933":54462},[],"The provisioning administrator configures the DMS and initial trust.",{"_3450":1751,"_30100":1717,"_20891":54464,"_5":14349,"_27386":54367,"_2933":54465},[],"The device client requests a certificate and installs it with the matching key.",{"_3450":1752,"_30100":1717,"_20891":54467,"_5":14349,"_27386":54367,"_2933":54468},[],"The consumer validates the identity and applies its access permissions.",{"_3450":1753,"_30100":1717,"_20891":54470,"_5":14349,"_27386":54367,"_2933":54471},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3450":1754,"_30100":1717,"_20891":54473,"_5":14349,"_27386":54375,"_2933":54474},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3450":1755,"_30100":1717,"_20891":54476,"_5":14349,"_27386":54379,"_2933":54477},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3450":1756,"_30100":1717,"_20891":54479,"_5":14349,"_27386":54383,"_2933":54480},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3450":1757,"_30100":1717,"_20891":54482,"_5":14349,"_27386":54387,"_2933":54483},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3450":1758,"_30100":1717,"_20891":54485,"_5":14349,"_27386":54391,"_2933":54486},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3450":1759,"_30100":1717,"_20891":54488,"_5":14349,"_27386":54395,"_2933":54489},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3450":1760,"_30100":1717,"_20891":54491,"_5":14349,"_27386":54399,"_2933":53934},[],{"_3450":1761,"_30100":1717,"_20891":54493,"_5":14349,"_27386":54399,"_2933":54494},[],"What it prepares or checks",{"_3450":1762,"_30100":1717,"_20891":54496,"_5":14349,"_27386":54399,"_2933":53937},[],{"_3450":1763,"_30100":1717,"_20891":54498,"_5":14349,"_27386":54399,"_2933":54499},[],"Key custody, CA hierarchy, profiles and validation.",{"_3450":1764,"_30100":1717,"_20891":54501,"_5":14349,"_27386":54399,"_2933":54502},[],"Fleet administrator",{"_3450":1765,"_30100":1717,"_20891":54504,"_5":14349,"_27386":54399,"_2933":54505},[],"DMS, device admission, renewal policy and inventory.",{"_3450":1766,"_30100":1717,"_20891":54507,"_5":14349,"_27386":54399,"_2933":53949},[],{"_3450":1767,"_30100":1717,"_20891":54509,"_5":14349,"_27386":54399,"_2933":54510},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3450":1768,"_30100":1717,"_20891":54512,"_5":14349,"_27386":54399,"_2933":53955},[],{"_3450":1769,"_30100":1717,"_20891":54514,"_5":14349,"_27386":54399,"_2933":54515},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3450":1770,"_30100":1717,"_20891":54517,"_5":14349,"_27386":54399,"_2933":54518},[],"Infrastructure operator",{"_3450":1771,"_30100":1717,"_20891":54520,"_5":14349,"_27386":54399,"_2933":54521},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3450":1772,"_30100":1717,"_20891":54523,"_5":14349,"_27386":54399,"_2933":54524},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3450":1773,"_30100":1773,"_5":14701,"_2933":54526,"_30453":54527,"_20891":54530,"_27386":1773},"CA hierarchy and rotation",[49052,50520,54528,54529],"PKI","Keys, authorities and certificates",[],{"_3450":1774,"_30100":1773,"_20891":54532,"_5":14349,"_27386":1773,"_2933":54533},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3450":1775,"_30100":1773,"_5":30450,"_20891":54535,"_27386":54536,"_2933":54537},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3450":1776,"_30100":1773,"_5":30450,"_20891":54539,"_27386":54540,"_2933":54541},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3450":1777,"_30100":1773,"_5":30450,"_20891":54543,"_27386":54544,"_2933":54545},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3450":1778,"_30100":1773,"_5":30450,"_20891":54547,"_27386":54548,"_2933":54549},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3450":1779,"_30100":1773,"_5":30450,"_20891":54551,"_27386":54552,"_2933":54553},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3450":1780,"_30100":1773,"_5":30450,"_20891":54555,"_27386":54556,"_2933":54557},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3450":1781,"_30100":1773,"_5":30450,"_20891":54559,"_27386":54560,"_2933":54561},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3450":1782,"_30100":1773,"_5":30450,"_20891":54563,"_27386":54564,"_2933":54565},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3450":1783,"_30100":1773,"_5":30450,"_20891":54567,"_27386":54568,"_2933":54569},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3450":1784,"_30100":1773,"_5":30450,"_20891":54571,"_27386":54572,"_2933":54573},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3450":1785,"_30100":1773,"_5":30450,"_20891":54575,"_27386":54576,"_2933":54577},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3450":1786,"_30100":1773,"_5":30450,"_20891":54579,"_27386":54580,"_2933":54581},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3450":1787,"_30100":1773,"_20891":54583,"_5":14349,"_27386":1773,"_2933":54584},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3450":1788,"_30100":1773,"_20891":54586,"_5":14349,"_27386":1773,"_2933":54587},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3450":1789,"_30100":1773,"_20891":54589,"_5":14349,"_27386":54536,"_2933":54590},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3450":1790,"_30100":1773,"_20891":54592,"_5":14349,"_27386":54536,"_2933":54593},[],"environment, such as production and preproduction;",{"_3450":1791,"_30100":1773,"_20891":54595,"_5":14349,"_27386":54536,"_2933":54596},[],"owner or operating team;",{"_3450":1792,"_30100":1773,"_20891":54598,"_5":14349,"_27386":54536,"_2933":54599},[],"device family or manufacturing process;",{"_3450":1793,"_30100":1773,"_20891":54601,"_5":14349,"_27386":54536,"_2933":54602},[],"region or regulatory requirement;",{"_3450":1794,"_30100":1773,"_20891":54604,"_5":14349,"_27386":54536,"_2933":54605},[],"cryptographic engine or key policy;",{"_3450":1795,"_30100":1773,"_20891":54607,"_5":14349,"_27386":54536,"_2933":54608},[],"maintenance window and renewal cadence.",{"_3450":1796,"_30100":1773,"_20891":54610,"_5":14349,"_27386":54536,"_2933":54611},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3450":1797,"_30100":1773,"_20891":54613,"_5":14349,"_27386":54536,"_2933":54614},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3450":1798,"_30100":1773,"_20891":54616,"_5":14349,"_27386":54540,"_2933":54617},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3450":1799,"_30100":1773,"_20891":54619,"_5":14349,"_27386":54540,"_2933":54620},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3450":1800,"_30100":1773,"_20891":54622,"_5":14349,"_27386":54540,"_2933":54623},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3450":1801,"_30100":1773,"_20891":54625,"_5":14349,"_27386":54540,"_2933":54626},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3450":1802,"_30100":1773,"_20891":54628,"_5":14349,"_27386":54544,"_2933":54629},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3450":1803,"_30100":1773,"_20891":54631,"_5":14349,"_27386":54544,"_2933":54632},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3450":1804,"_30100":1773,"_20891":54634,"_5":14349,"_27386":54544,"_2933":54635},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3450":1805,"_30100":1773,"_20891":54637,"_5":14349,"_27386":54544,"_2933":54638},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3450":1806,"_30100":1773,"_20891":54640,"_5":14349,"_27386":54552,"_2933":54641},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3450":1807,"_30100":1773,"_20891":54643,"_5":14349,"_27386":54556,"_2933":54644},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3450":1808,"_30100":1773,"_20891":54646,"_5":14349,"_27386":54560,"_2933":54647},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3450":1809,"_30100":1773,"_20891":54649,"_5":14349,"_27386":54564,"_2933":54650},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3450":1810,"_30100":1773,"_20891":54652,"_5":14349,"_27386":54568,"_2933":54653},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3450":1811,"_30100":1773,"_20891":54655,"_5":14349,"_27386":54572,"_2933":54656},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3450":1812,"_30100":1773,"_20891":54658,"_5":14349,"_27386":54576,"_2933":54659},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3450":1813,"_30100":1773,"_20891":54661,"_5":14349,"_27386":54576,"_2933":54662},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3450":1814,"_30100":1773,"_20891":54664,"_5":14349,"_27386":54576,"_2933":54665},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3450":1815,"_30100":1773,"_20891":54667,"_5":14349,"_27386":54576,"_2933":54668},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3450":1816,"_30100":1773,"_20891":54670,"_5":14349,"_27386":54580,"_2933":54671},[],"The new chain ends in an anchor installed by the consumer.",{"_3450":1817,"_30100":1773,"_20891":54673,"_5":14349,"_27386":54580,"_2933":54674},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3450":1818,"_30100":1773,"_20891":54676,"_5":14349,"_27386":54580,"_2933":54677},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3450":1819,"_30100":1773,"_20891":54679,"_5":14349,"_27386":54580,"_2933":54680},[],"Re-enrollment accepts the old identity during the planned period.",{"_3450":1820,"_30100":1773,"_20891":54682,"_5":14349,"_27386":54580,"_2933":54683},[],"OCSP and CRL respond for the authorities that remain active.",{"_3450":1821,"_30100":1773,"_20891":54685,"_5":14349,"_27386":54580,"_2933":54686},[],"No DMS is left accidentally issuing from the old CA.",{"_3450":1822,"_30100":1773,"_20891":54688,"_5":14349,"_27386":54580,"_2933":54689},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3450":1823,"_30100":1823,"_5":14701,"_2933":54691,"_30453":54692,"_20891":54693,"_27386":1823},"Certification authorities",[49052,50520,54528,54529],[],{"_3450":1824,"_30100":1823,"_20891":54695,"_5":14349,"_27386":1823,"_2933":54696},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3450":1825,"_30100":1823,"_5":30450,"_20891":54698,"_27386":54699,"_2933":54700},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3450":1826,"_30100":1823,"_5":30450,"_20891":54702,"_27386":54703,"_2933":54704},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3450":1827,"_30100":1823,"_5":30450,"_20891":54706,"_27386":54707,"_2933":49062},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#before-you-begin",{"_3450":1828,"_30100":1823,"_5":30450,"_20891":54709,"_27386":54710,"_2933":54711},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3450":1829,"_30100":1823,"_5":30450,"_20891":54713,"_27386":54714,"_2933":54715},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3450":1830,"_30100":1823,"_5":30450,"_20891":54717,"_27386":54718,"_2933":54719},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3450":1831,"_30100":1823,"_5":30450,"_20891":54721,"_27386":54722,"_2933":54723},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3450":1832,"_30100":1823,"_5":30450,"_20891":54725,"_27386":54726,"_2933":54727},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3450":1833,"_30100":1823,"_5":30450,"_20891":54729,"_27386":54730,"_2933":54731},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3450":1834,"_30100":1823,"_5":30450,"_20891":54733,"_27386":54734,"_2933":54735},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3450":1835,"_30100":1823,"_5":30450,"_20891":54737,"_27386":54738,"_2933":54739},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3450":1836,"_30100":1823,"_5":30450,"_20891":54741,"_27386":54742,"_2933":54743},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3450":1837,"_30100":1823,"_5":30450,"_20891":54745,"_27386":54746,"_2933":54747},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3450":1838,"_30100":1823,"_5":30450,"_20891":54749,"_27386":54750,"_2933":54751},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3450":1839,"_30100":1823,"_5":30450,"_20891":54753,"_27386":54754,"_2933":54755},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3450":1840,"_30100":1823,"_5":30450,"_20891":54757,"_27386":54758,"_2933":54759},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3450":1841,"_30100":1823,"_5":30450,"_20891":54761,"_27386":54762,"_2933":54763},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3450":1842,"_30100":1823,"_5":30450,"_20891":54765,"_27386":54766,"_2933":54767},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3450":1843,"_30100":1823,"_5":30450,"_20891":54769,"_27386":54770,"_2933":54771},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3450":1844,"_30100":1823,"_5":30450,"_20891":54773,"_27386":54774,"_2933":54775},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3450":1845,"_30100":1823,"_5":30450,"_20891":54777,"_27386":54778,"_2933":54779},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3450":1846,"_30100":1823,"_5":30450,"_20891":54781,"_27386":54782,"_2933":54783},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3450":1847,"_30100":1823,"_5":30450,"_20891":54785,"_27386":54786,"_2933":54787},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3450":1848,"_30100":1823,"_20891":54789,"_5":14349,"_27386":1823,"_2933":54790},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3450":1849,"_30100":1823,"_20891":54792,"_5":14349,"_27386":1823,"_2933":54793},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3450":1850,"_30100":1823,"_20891":54795,"_5":14349,"_27386":1823,"_2933":54796},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3450":1851,"_30100":1823,"_20891":54798,"_5":14349,"_27386":54699,"_2933":54799},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3450":1852,"_30100":1823,"_20891":54801,"_5":14349,"_27386":54699,"_2933":54802},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3450":1853,"_30100":1823,"_20891":54804,"_5":14349,"_27386":54699,"_2933":54805},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3450":1854,"_30100":1823,"_20891":54807,"_5":14349,"_27386":54699,"_2933":54808},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3450":1855,"_30100":1823,"_20891":54810,"_5":14349,"_27386":54699,"_2933":54811},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3450":1856,"_30100":1823,"_20891":54813,"_5":14349,"_27386":54707,"_2933":54814},[],"Decide whether the CA will be a root or an intermediate.",{"_3450":1857,"_30100":1823,"_20891":54816,"_5":14349,"_27386":54707,"_2933":54817},[],"Choose the engine that will keep the key.",{"_3450":1858,"_30100":1823,"_20891":54819,"_5":14349,"_27386":54707,"_2933":54820},[],"Define a validity longer than that of the certificates it will issue.",{"_3450":1859,"_30100":1823,"_20891":54822,"_5":14349,"_27386":54707,"_2933":54823},[],"For an intermediate CA, make sure the parent CA is active.",{"_3450":1860,"_30100":1823,"_20891":54825,"_5":14349,"_27386":54710,"_2933":54826},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3450":1861,"_30100":1823,"_20891":54828,"_5":14349,"_27386":54714,"_2933":54829},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3450":1862,"_30100":1823,"_20891":54831,"_5":14349,"_27386":54714,"_2933":54832},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3450":1863,"_30100":1823,"_20891":54834,"_5":14349,"_27386":54718,"_2933":54835},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3450":1864,"_30100":1823,"_20891":54837,"_5":14349,"_27386":54722,"_2933":54838},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3450":1865,"_30100":1823,"_20891":54840,"_5":14349,"_27386":54722,"_2933":54841},[],"`C`: two-letter ISO 3166-1 country code.",{"_3450":1866,"_30100":1823,"_20891":54843,"_5":14349,"_27386":54722,"_2933":54844},[],"`ST`: state or province.",{"_3450":1867,"_30100":1823,"_20891":54846,"_5":14349,"_27386":54722,"_2933":54847},[],"`L`: locality.",{"_3450":1868,"_30100":1823,"_20891":54849,"_5":14349,"_27386":54722,"_2933":54850},[],"`O`: organization.",{"_3450":1869,"_30100":1823,"_20891":54852,"_5":14349,"_27386":54722,"_2933":54853},[],"`OU`: organizational unit.",{"_3450":1870,"_30100":1823,"_20891":54855,"_5":14349,"_27386":54722,"_2933":54856},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3450":1871,"_30100":1823,"_20891":54858,"_5":14349,"_27386":54726,"_2933":54859},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3450":1872,"_30100":1823,"_20891":54861,"_5":14349,"_27386":54726,"_2933":54862},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3450":1873,"_30100":1823,"_20891":54864,"_5":14349,"_27386":54730,"_2933":54865},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3450":1874,"_30100":1823,"_20891":54867,"_5":14349,"_27386":54730,"_2933":54868},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3450":1875,"_30100":1823,"_20891":54870,"_5":14349,"_27386":54734,"_2933":54871},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3450":1876,"_30100":1823,"_20891":54873,"_5":14349,"_27386":54734,"_2933":54874},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3450":1877,"_30100":1823,"_20891":54876,"_5":14349,"_27386":54738,"_2933":54877},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3450":1878,"_30100":1823,"_20891":54879,"_5":14349,"_27386":54738,"_2933":54880},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3450":1879,"_30100":1823,"_20891":54882,"_5":14349,"_27386":54738,"_2933":54883},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3450":1880,"_30100":1823,"_20891":54885,"_5":14349,"_27386":54742,"_2933":54886},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3450":1881,"_30100":1823,"_20891":54888,"_5":14349,"_27386":54746,"_2933":54889},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3450":1882,"_30100":1823,"_20891":54891,"_5":14349,"_27386":54746,"_2933":54892},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3450":1883,"_30100":1823,"_20891":54894,"_5":14349,"_27386":54750,"_2933":54895},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3450":1884,"_30100":1823,"_20891":54897,"_5":14349,"_27386":54754,"_2933":54898},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3450":1885,"_30100":1823,"_20891":54900,"_5":14349,"_27386":54754,"_2933":54901},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3450":1886,"_30100":1823,"_20891":54903,"_5":14349,"_27386":54758,"_2933":54904},[],"Open a CA from the inventory to review:",{"_3450":1887,"_30100":1823,"_20891":54906,"_5":14349,"_27386":54758,"_2933":54907},[],"Status and validity period.",{"_3450":1888,"_30100":1823,"_20891":54909,"_5":14349,"_27386":54758,"_2933":54910},[],"Certificate and chain in PEM format.",{"_3450":1889,"_30100":1823,"_20891":54912,"_5":14349,"_27386":54758,"_2933":54913},[],"Number of active, expired and revoked certificates.",{"_3450":1890,"_30100":1823,"_20891":54915,"_5":14349,"_27386":54758,"_2933":54916},[],"Certificates issued in **Issued Certificates**.",{"_3450":1891,"_30100":1823,"_20891":54918,"_5":14349,"_27386":54758,"_2933":54919},[],"The CRL linked to the authority.",{"_3450":1892,"_30100":1823,"_20891":54921,"_5":14349,"_27386":54758,"_2933":54922},[],"Metadata and the associated cryptographic engine.",{"_3450":1893,"_30100":1823,"_20891":54924,"_5":14349,"_27386":54758,"_2933":54925},[],"You can filter the inventory by name, status and CA type.",{"_3450":1894,"_30100":1823,"_20891":54927,"_5":14349,"_27386":54762,"_2933":54928},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3450":1895,"_30100":1823,"_20891":54930,"_5":14349,"_27386":54762,"_2933":54931},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3450":1896,"_30100":1823,"_20891":54933,"_5":14349,"_27386":54762,"_2933":54934},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3450":1897,"_30100":1823,"_20891":54936,"_5":14349,"_27386":54762,"_2933":54937},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3450":1898,"_30100":1823,"_20891":54939,"_5":14349,"_27386":54766,"_2933":54940},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3450":1899,"_30100":1823,"_20891":54942,"_5":14349,"_27386":54770,"_2933":54943},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3450":1900,"_30100":1823,"_20891":54945,"_5":14349,"_27386":54774,"_2933":54946},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3450":1901,"_30100":1823,"_20891":54948,"_5":14349,"_27386":54778,"_2933":54949},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3450":1902,"_30100":1823,"_20891":54951,"_5":14349,"_27386":54782,"_2933":54952},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3450":1903,"_30100":1823,"_20891":54954,"_5":14349,"_27386":54786,"_2933":54955},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3450":1904,"_30100":1823,"_20891":54957,"_5":14349,"_27386":54786,"_2933":54958},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3450":1905,"_30100":1823,"_20891":54960,"_5":14349,"_27386":54786,"_2933":54961},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3450":1906,"_30100":1906,"_5":14701,"_2933":54963,"_30453":54964,"_20891":54965,"_27386":1906},"Certificate profiles",[49052,50520,54528,54529],[],{"_3450":1907,"_30100":1906,"_20891":54967,"_5":14349,"_27386":1906,"_2933":54968},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3450":1908,"_30100":1906,"_5":30450,"_20891":54970,"_27386":54971,"_2933":54972},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3450":1909,"_30100":1906,"_5":30450,"_20891":54974,"_27386":54975,"_2933":54976},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#validity","Validity",{"_3450":1910,"_30100":1906,"_5":30450,"_20891":54978,"_27386":54979,"_2933":54980},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3450":1911,"_30100":1906,"_5":30450,"_20891":54982,"_27386":54983,"_2933":54984},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3450":1912,"_30100":1906,"_5":30450,"_20891":54986,"_27386":54987,"_2933":54988},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#subject","Subject",{"_3450":1913,"_30100":1906,"_5":30450,"_20891":54990,"_27386":54991,"_2933":54992},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3450":1914,"_30100":1906,"_5":30450,"_20891":54994,"_27386":54995,"_2933":54996},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3450":1915,"_30100":1906,"_5":30450,"_20891":54998,"_27386":54999,"_2933":55000},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3450":1916,"_30100":1906,"_5":30450,"_20891":55002,"_27386":55003,"_2933":55004},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3450":1917,"_30100":1906,"_5":30450,"_20891":55006,"_27386":55007,"_2933":55008},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3450":1918,"_30100":1906,"_5":30450,"_20891":55010,"_27386":55011,"_2933":55012},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3450":1919,"_30100":1906,"_5":30450,"_20891":55014,"_27386":55015,"_2933":55016},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3450":1920,"_30100":1906,"_5":30450,"_20891":55018,"_27386":55019,"_2933":55020},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3450":1921,"_30100":1906,"_5":30450,"_20891":55022,"_27386":55023,"_2933":55024},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3450":1922,"_30100":1906,"_5":30450,"_20891":55026,"_27386":55027,"_2933":55028},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#design-examples","Design examples",{"_3450":1923,"_30100":1906,"_5":30450,"_20891":55030,"_27386":55031,"_2933":55032},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3450":1924,"_30100":1906,"_20891":55034,"_5":14349,"_27386":1906,"_2933":55035},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3450":1925,"_30100":1906,"_20891":55037,"_5":14349,"_27386":1906,"_2933":55038},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3450":1926,"_30100":1906,"_20891":55040,"_5":14349,"_27386":54975,"_2933":55041},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3450":1927,"_30100":1906,"_20891":55043,"_5":14349,"_27386":54975,"_2933":55044},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3450":1928,"_30100":1906,"_20891":55046,"_5":14349,"_27386":54979,"_2933":55047},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3450":1929,"_30100":1906,"_20891":55049,"_5":14349,"_27386":54983,"_2933":55050},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3450":1930,"_30100":1906,"_20891":55052,"_5":14349,"_27386":54983,"_2933":55053},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3450":1931,"_30100":1906,"_20891":55055,"_5":14349,"_27386":54983,"_2933":55056},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3450":1932,"_30100":1906,"_20891":55058,"_5":14349,"_27386":54987,"_2933":55059},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3450":1933,"_30100":1906,"_20891":55061,"_5":14349,"_27386":54991,"_2933":55062},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3450":1934,"_30100":1906,"_20891":55064,"_5":14349,"_27386":54991,"_2933":55065},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3450":1935,"_30100":1906,"_20891":55067,"_5":14349,"_27386":54995,"_2933":55068},[],"The cryptographic enforcement can:",{"_3450":1936,"_30100":1906,"_20891":55070,"_5":14349,"_27386":54995,"_2933":55071},[],"allow or block RSA keys;",{"_3450":1937,"_30100":1906,"_20891":55073,"_5":14349,"_27386":54995,"_2933":55074},[],"limit the supported RSA sizes;",{"_3450":1938,"_30100":1906,"_20891":55076,"_5":14349,"_27386":54995,"_2933":55077},[],"allow or block ECDSA keys;",{"_3450":1939,"_30100":1906,"_20891":55079,"_5":14349,"_27386":54995,"_2933":55080},[],"limit the supported ECDSA sizes or curves.",{"_3450":1940,"_30100":1906,"_20891":55082,"_5":14349,"_27386":54995,"_2933":55083},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3450":1941,"_30100":1906,"_20891":55085,"_5":14349,"_27386":54999,"_2933":55086},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3450":1942,"_30100":1906,"_20891":55088,"_5":14349,"_27386":54999,"_2933":52290},[],{"_3450":1943,"_30100":1906,"_20891":55090,"_5":14349,"_27386":54999,"_2933":55091},[],"First choice",{"_3450":1944,"_30100":1906,"_20891":55093,"_5":14349,"_27386":54999,"_2933":55094},[],"Second choice",{"_3450":1945,"_30100":1906,"_20891":55096,"_5":14349,"_27386":54999,"_2933":55097},[],"If neither is supplied",{"_3450":1946,"_30100":1906,"_20891":55099,"_5":14349,"_27386":54999,"_2933":55100},[],"Direct signing with a CA",{"_3450":1947,"_30100":1906,"_20891":55102,"_5":14349,"_27386":54999,"_2933":55103},[],"`issuance_profile` embedded in the request",{"_3450":1948,"_30100":1906,"_20891":55105,"_5":14349,"_27386":54999,"_2933":55106},[],"Request `issuance_profile_id`",{"_3450":1949,"_30100":1906,"_20891":55108,"_5":14349,"_27386":54999,"_2933":55109},[],"CA default profile (`profile_id`).",{"_3450":1950,"_30100":1906,"_20891":55111,"_5":14349,"_27386":54999,"_2933":55112},[],"Issuance through a DMS",{"_3450":1951,"_30100":1906,"_20891":55114,"_5":14349,"_27386":54999,"_2933":55115},[],"`settings.issuance_profile_id`",{"_3450":1952,"_30100":1906,"_20891":55117,"_5":14349,"_27386":54999,"_2933":55118},[],"`settings.issuance_profile` embedded in the DMS",{"_3450":1953,"_30100":1906,"_20891":55120,"_5":14349,"_27386":54999,"_2933":55121},[],"Enrollment CA default profile.",{"_3450":1954,"_30100":1906,"_20891":55123,"_5":14349,"_27386":54999,"_2933":55124},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3450":1955,"_30100":1906,"_20891":55126,"_5":14349,"_27386":54999,"_2933":55127},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3450":1956,"_30100":1906,"_20891":55129,"_5":14349,"_27386":55007,"_2933":55130},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3450":1957,"_30100":1906,"_20891":55132,"_5":14349,"_27386":55011,"_2933":55133},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3450":1958,"_30100":1906,"_20891":55135,"_5":14349,"_27386":55015,"_2933":55136},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3450":1959,"_30100":1906,"_20891":55138,"_5":14349,"_27386":55019,"_2933":55139},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3450":1960,"_30100":1906,"_20891":55141,"_5":14349,"_27386":55023,"_2933":55142},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3450":1961,"_30100":1906,"_20891":55144,"_5":14349,"_27386":55023,"_2933":55145},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3450":1962,"_30100":1906,"_20891":55147,"_5":14349,"_27386":55027,"_2933":55148},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3450":1963,"_30100":1906,"_20891":55150,"_5":14349,"_27386":55027,"_2933":55151},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3450":1964,"_30100":1906,"_20891":55153,"_5":14349,"_27386":55027,"_2933":55154},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3450":1965,"_30100":1906,"_20891":55156,"_5":14349,"_27386":55027,"_2933":55157},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3450":1966,"_30100":1906,"_20891":55159,"_5":14349,"_27386":55031,"_2933":55160},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3450":1967,"_30100":1906,"_20891":55162,"_5":14349,"_27386":55031,"_2933":55163},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3450":1968,"_30100":1968,"_5":14701,"_2933":55165,"_30453":55166,"_20891":55168,"_27386":1968},"Certificate validation",[49052,50520,54528,55167],"Validation",[],{"_3450":1969,"_30100":1968,"_20891":55170,"_5":14349,"_27386":1968,"_2933":55171},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3450":1970,"_30100":1968,"_5":30450,"_20891":55173,"_27386":55174,"_2933":55175},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3450":1971,"_30100":1968,"_5":30450,"_20891":55177,"_27386":55178,"_2933":55179},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3450":1972,"_30100":1968,"_5":30450,"_20891":55181,"_27386":55182,"_2933":55183},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3450":1973,"_30100":1968,"_20891":55185,"_5":14349,"_27386":1968,"_2933":55186},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3450":1974,"_30100":1968,"_20891":55188,"_5":14349,"_27386":55174,"_2933":55189},[],"Verify these criteria together:",{"_3450":1975,"_30100":1968,"_20891":55191,"_5":14349,"_27386":55174,"_2933":54154},[],{"_3450":1976,"_30100":1968,"_20891":55193,"_5":14349,"_27386":55174,"_2933":55194},[],"Required result",{"_3450":1977,"_30100":1968,"_20891":55196,"_5":14349,"_27386":55174,"_2933":55197},[],"Chain and signature",{"_3450":1978,"_30100":1968,"_20891":55199,"_5":14349,"_27386":55174,"_2933":55200},[],"Valid chain to a root deliberately installed in the consumer.",{"_3450":1979,"_30100":1968,"_20891":55202,"_5":14349,"_27386":55174,"_2933":55203},[],"Dates",{"_3450":1980,"_30100":1968,"_20891":55205,"_5":14349,"_27386":55174,"_2933":55206},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3450":1981,"_30100":1968,"_20891":55208,"_5":14349,"_27386":55174,"_2933":50189},[],{"_3450":1982,"_30100":1968,"_20891":55210,"_5":14349,"_27386":55174,"_2933":55211},[],"Name, SAN or identifier matches the expected peer.",{"_3450":1983,"_30100":1968,"_20891":55213,"_5":14349,"_27386":55174,"_2933":49442},[],{"_3450":1984,"_30100":1968,"_20891":55215,"_5":14349,"_27386":55174,"_2933":55216},[],"KU, EKU and constraints permit the specific operation.",{"_3450":1985,"_30100":1968,"_20891":55218,"_5":14349,"_27386":55174,"_2933":55219},[],"Revocation",{"_3450":1986,"_30100":1968,"_20891":55221,"_5":14349,"_27386":55174,"_2933":55222},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3450":1987,"_30100":1968,"_20891":55224,"_5":14349,"_27386":55174,"_2933":55225},[],"Authorization",{"_3450":1988,"_30100":1968,"_20891":55227,"_5":14349,"_27386":55174,"_2933":55228},[],"The application permits that identity to perform the action.",{"_3450":1989,"_30100":1968,"_20891":55230,"_5":14349,"_27386":55174,"_2933":55231},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3450":1990,"_30100":1968,"_20891":55233,"_5":14349,"_27386":55178,"_2933":55234},[],"Mechanism",{"_3450":1991,"_30100":1968,"_20891":55236,"_5":14349,"_27386":55178,"_2933":55237},[],"When to use it",{"_3450":1992,"_30100":1968,"_20891":55239,"_5":14349,"_27386":55178,"_2933":55240},[],"What you must maintain",{"_3450":1993,"_30100":1968,"_20891":55242,"_5":14349,"_27386":55178,"_2933":55243},[],"OCSP",{"_3450":1994,"_30100":1968,"_20891":55245,"_5":14349,"_27386":55178,"_2933":55246},[],"Status query for a specific certificate.",{"_3450":1995,"_30100":1968,"_20891":55248,"_5":14349,"_27386":55178,"_2933":55249},[],"Responder access, signature verification and cache/freshness policy.",{"_3450":1996,"_30100":1968,"_20891":55251,"_5":14349,"_27386":55178,"_2933":55252},[],"CRL",{"_3450":1997,"_30100":1968,"_20891":55254,"_5":14349,"_27386":55178,"_2933":55255},[],"Local checks for many certificates or offline operation.",{"_3450":1998,"_30100":1968,"_20891":55257,"_5":14349,"_27386":55178,"_2933":55258},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3450":1999,"_30100":1968,"_20891":55260,"_5":14349,"_27386":55178,"_2933":55261},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3450":2000,"_30100":1968,"_20891":55263,"_5":14349,"_27386":55178,"_2933":55264},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3450":2001,"_30100":1968,"_20891":55266,"_5":14349,"_27386":55182,"_2933":55267},[],"Accept a current, authorized certificate with a known chain.",{"_3450":2002,"_30100":1968,"_20891":55269,"_5":14349,"_27386":55182,"_2933":55270},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3450":2003,"_30100":1968,"_20891":55272,"_5":14349,"_27386":55182,"_2933":55273},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3450":2004,"_30100":1968,"_20891":55275,"_5":14349,"_27386":55182,"_2933":55276},[],"Check that a new connection with that identity is rejected.",{"_3450":2005,"_30100":1968,"_20891":55278,"_5":14349,"_27386":55182,"_2933":55279},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3450":2006,"_30100":1968,"_20891":55281,"_5":14349,"_27386":55182,"_2933":55282},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3450":2007,"_30100":1968,"_20891":55284,"_5":14349,"_27386":55182,"_2933":55285},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3450":2008,"_30100":1968,"_20891":55287,"_5":14349,"_27386":55182,"_2933":55288},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3450":2009,"_30100":1968,"_20891":55290,"_5":14349,"_27386":55182,"_2933":55291},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3450":2010,"_30100":2010,"_5":14701,"_2933":55293,"_30453":55294,"_20891":55295,"_27386":2010},"Certificates",[49052,50520,54528,54529],[],{"_3450":2011,"_30100":2010,"_20891":55297,"_5":14349,"_27386":2010,"_2933":55298},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3450":2012,"_30100":2010,"_5":30450,"_20891":55300,"_27386":55301,"_2933":55302},[],"/docs/pr-preview/pr-61/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3450":2013,"_30100":2010,"_5":30450,"_20891":55304,"_27386":55305,"_2933":55306},[],"/docs/pr-preview/pr-61/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3450":2014,"_30100":2010,"_5":30450,"_20891":55308,"_27386":55309,"_2933":55310},[],"/docs/pr-preview/pr-61/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3450":2015,"_30100":2010,"_5":30450,"_20891":55312,"_27386":55313,"_2933":55314},[],"/docs/pr-preview/pr-61/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3450":2016,"_30100":2010,"_5":30450,"_20891":55316,"_27386":55317,"_2933":55318},[],"/docs/pr-preview/pr-61/platform/pki/certificates#open-the-action","Open the action",{"_3450":2017,"_30100":2010,"_5":30450,"_20891":55320,"_27386":55321,"_2933":55322},[],"/docs/pr-preview/pr-61/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3450":2018,"_30100":2010,"_5":30450,"_20891":55324,"_27386":55325,"_2933":55326},[],"/docs/pr-preview/pr-61/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3450":2019,"_30100":2010,"_5":30450,"_20891":55328,"_27386":55329,"_2933":55330},[],"/docs/pr-preview/pr-61/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3450":2020,"_30100":2010,"_5":30450,"_20891":55332,"_27386":55333,"_2933":55334},[],"/docs/pr-preview/pr-61/platform/pki/certificates#continue","Continue",{"_3450":2021,"_30100":2010,"_20891":55336,"_5":14349,"_27386":2010,"_2933":55337},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3450":2022,"_30100":2010,"_20891":55339,"_5":14349,"_27386":55301,"_2933":55340},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3450":2023,"_30100":2010,"_20891":55342,"_5":14349,"_27386":55301,"_2933":55343},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3450":2024,"_30100":2010,"_20891":55345,"_5":14349,"_27386":55301,"_2933":55346},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3450":2025,"_30100":2010,"_20891":55348,"_5":14349,"_27386":55301,"_2933":55349},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3450":2026,"_30100":2010,"_20891":55351,"_5":14349,"_27386":55301,"_2933":55352},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3450":2027,"_30100":2010,"_20891":55354,"_5":14349,"_27386":55301,"_2933":55355},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3450":2028,"_30100":2010,"_20891":55357,"_5":14349,"_27386":55301,"_2933":55358},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3450":2029,"_30100":2010,"_20891":55360,"_5":14349,"_27386":55305,"_2933":55361},[],"Download the PEM and inspect it:",{"_3450":2030,"_30100":2010,"_20891":55363,"_5":14349,"_27386":55305,"_2933":55364},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3450":2031,"_30100":2010,"_20891":55366,"_5":14349,"_27386":55309,"_2933":55367},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3450":2032,"_30100":2010,"_20891":55369,"_5":14349,"_27386":55309,"_2933":55370},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3450":2033,"_30100":2010,"_20891":55372,"_5":14349,"_27386":55309,"_2933":55373},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3450":2034,"_30100":2010,"_20891":55375,"_5":14349,"_27386":55309,"_2933":55376},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3450":2035,"_30100":2010,"_20891":55378,"_5":14349,"_27386":55309,"_2933":55379},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3450":2036,"_30100":2010,"_20891":55381,"_5":14349,"_27386":55309,"_2933":55382},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3450":2037,"_30100":2010,"_20891":55384,"_5":14349,"_27386":55309,"_2933":55385},[],"For browser key generation, follow Issue your first certificate.",{"_3450":2038,"_30100":2010,"_20891":55387,"_5":14349,"_27386":55313,"_2933":55388},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3450":2039,"_30100":2010,"_20891":55390,"_5":14349,"_27386":55317,"_2933":55391},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3450":2040,"_30100":2010,"_20891":55393,"_5":14349,"_27386":55321,"_2933":55394},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3450":2041,"_30100":2010,"_20891":55396,"_5":14349,"_27386":55325,"_2933":55397},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3450":2042,"_30100":2010,"_20891":55399,"_5":14349,"_27386":55325,"_2933":55400},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3450":2043,"_30100":2010,"_20891":55402,"_5":14349,"_27386":55325,"_2933":55403},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3450":2044,"_30100":2010,"_20891":55405,"_5":14349,"_27386":55329,"_2933":55406},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3450":2045,"_30100":2010,"_20891":55408,"_5":14349,"_27386":55329,"_2933":55409},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3450":2046,"_30100":2010,"_20891":55411,"_5":14349,"_27386":55329,"_2933":55412},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3450":2047,"_30100":2010,"_20891":55414,"_5":14349,"_27386":55333,"_2933":55415},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3450":2048,"_30100":2010,"_20891":55417,"_5":14349,"_27386":55333,"_2933":55418},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3450":2049,"_30100":2049,"_5":14701,"_2933":55420,"_30453":55421,"_20891":55423,"_27386":2049},"Certificate lifecycle",[49052,50520,54528,55422],"Concepts",[],{"_3450":2050,"_30100":2049,"_20891":55425,"_5":14349,"_27386":2049,"_2933":55426},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3450":2051,"_30100":2049,"_5":30450,"_20891":55428,"_27386":55429,"_2933":55430},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3450":2052,"_30100":2049,"_5":30450,"_20891":55432,"_27386":55433,"_2933":55434},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3450":2053,"_30100":2049,"_5":30450,"_20891":55436,"_27386":55437,"_2933":55438},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3450":2054,"_30100":2049,"_5":30450,"_20891":55440,"_27386":55441,"_2933":55442},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3450":2055,"_30100":2049,"_5":30450,"_20891":55444,"_27386":55445,"_2933":55446},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3450":2056,"_30100":2049,"_5":30450,"_20891":55448,"_27386":55449,"_2933":55450},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3450":2057,"_30100":2049,"_5":30450,"_20891":55452,"_27386":55453,"_2933":55454},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3450":2058,"_30100":2049,"_5":30450,"_20891":55456,"_27386":55457,"_2933":55458},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3450":2059,"_30100":2049,"_5":30450,"_20891":55460,"_27386":55461,"_2933":55462},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3450":2060,"_30100":2049,"_5":30450,"_20891":55464,"_27386":55465,"_2933":55466},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3450":2061,"_30100":2049,"_20891":55468,"_5":14349,"_27386":2049,"_2933":55469},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3450":2062,"_30100":2049,"_20891":55471,"_5":14349,"_27386":55433,"_2933":55472},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3450":2063,"_30100":2049,"_20891":55474,"_5":14349,"_27386":55437,"_2933":55475},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3450":2064,"_30100":2049,"_20891":55477,"_5":14349,"_27386":55441,"_2933":55478},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3450":2065,"_30100":2049,"_20891":55480,"_5":14349,"_27386":55445,"_2933":55481},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3450":2066,"_30100":2049,"_20891":55483,"_5":14349,"_27386":55449,"_2933":55484},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3450":2067,"_30100":2049,"_20891":55486,"_5":14349,"_27386":55453,"_2933":55487},[],"Lamassu persists four X.509 states:",{"_3450":2068,"_30100":2049,"_20891":55489,"_5":14349,"_27386":55453,"_2933":55490},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3450":2069,"_30100":2049,"_20891":55492,"_5":14349,"_27386":55453,"_2933":55493},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3450":2070,"_30100":2049,"_20891":55495,"_5":14349,"_27386":55453,"_2933":55496},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3450":2071,"_30100":2049,"_20891":55498,"_5":14349,"_27386":55453,"_2933":55499},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3450":2072,"_30100":2049,"_20891":55501,"_5":14349,"_27386":55453,"_2933":55502},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3450":2073,"_30100":2049,"_20891":55504,"_5":14349,"_27386":55457,"_2933":55505},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3450":2074,"_30100":2049,"_20891":55507,"_5":14349,"_27386":55457,"_2933":55508},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3450":2075,"_30100":2049,"_20891":55510,"_5":14349,"_27386":55457,"_2933":55511},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3450":2076,"_30100":2049,"_20891":55513,"_5":14349,"_27386":55461,"_2933":55514},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3450":2077,"_30100":2049,"_20891":55516,"_5":14349,"_27386":55461,"_2933":55517},[],"Before confirming:",{"_3450":2078,"_30100":2049,"_20891":55519,"_5":14349,"_27386":55461,"_2933":55520},[],"Identify DMSs, devices and services that trust that chain.",{"_3450":2079,"_30100":2049,"_20891":55522,"_5":14349,"_27386":55461,"_2933":55523},[],"Distribute the new chain of trust.",{"_3450":2080,"_30100":2049,"_20891":55525,"_5":14349,"_27386":55461,"_2933":55526},[],"Reissue the necessary identities.",{"_3450":2081,"_30100":2049,"_20891":55528,"_5":14349,"_27386":55461,"_2933":55529},[],"Check OCSP and CRL from a real consumer.",{"_3450":2082,"_30100":2049,"_20891":55531,"_5":14349,"_27386":55461,"_2933":55532},[],"Revoke the old CA once no legitimate traffic remains.",{"_3450":2083,"_30100":2049,"_20891":55534,"_5":14349,"_27386":55461,"_2933":55535},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3450":2084,"_30100":2049,"_20891":55537,"_5":14349,"_27386":55465,"_2933":55538},[],"Certificates entering the preventive or critical renewal window.",{"_3450":2085,"_30100":2049,"_20891":55540,"_5":14349,"_27386":55465,"_2933":55541},[],"Repeated enrollment or re-enrollment failures.",{"_3450":2086,"_30100":2049,"_20891":55543,"_5":14349,"_27386":55465,"_2933":55544},[],"Status changes and revocation reasons.",{"_3450":2087,"_30100":2049,"_20891":55546,"_5":14349,"_27386":55465,"_2933":55547},[],"OCSP and CRL publication and validity.",{"_3450":2088,"_30100":2049,"_20891":55549,"_5":14349,"_27386":55465,"_2933":55550},[],"Dependencies still presenting a replaced certificate.",{"_3450":2089,"_30100":2049,"_20891":55552,"_5":14349,"_27386":55465,"_2933":55553},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3450":2090,"_30100":2090,"_5":14701,"_2933":55555,"_30453":55556,"_20891":55557,"_27386":2090},"Trust model",[49052,50520,54528,55422],[],{"_3450":2091,"_30100":2090,"_20891":55559,"_5":14349,"_27386":2090,"_2933":55560},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3450":2092,"_30100":2090,"_5":30450,"_20891":55562,"_27386":55563,"_2933":55564},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3450":2093,"_30100":2090,"_5":30450,"_20891":55566,"_27386":55567,"_2933":55568},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3450":2094,"_30100":2090,"_5":30450,"_20891":55570,"_27386":55571,"_2933":55572},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3450":2095,"_30100":2090,"_5":30450,"_20891":55574,"_27386":55575,"_2933":55576},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3450":2096,"_30100":2090,"_5":30450,"_20891":55578,"_27386":55579,"_2933":55580},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3450":2097,"_30100":2090,"_5":30450,"_20891":55582,"_27386":55583,"_2933":55584},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3450":2098,"_30100":2090,"_5":30450,"_20891":55586,"_27386":55587,"_2933":55588},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3450":2099,"_30100":2090,"_5":30450,"_20891":55590,"_27386":55591,"_2933":55592},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3450":2100,"_30100":2090,"_5":30450,"_20891":55594,"_27386":55595,"_2933":55596},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3450":2101,"_30100":2090,"_5":30450,"_20891":55598,"_27386":55599,"_2933":55600},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3450":2102,"_30100":2090,"_20891":55602,"_5":14349,"_27386":2090,"_2933":55603},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3450":2103,"_30100":2090,"_20891":55605,"_5":14349,"_27386":55567,"_2933":55606},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3450":2104,"_30100":2090,"_20891":55608,"_5":14349,"_27386":55571,"_2933":55609},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3450":2105,"_30100":2090,"_20891":55611,"_5":14349,"_27386":55575,"_2933":55612},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3450":2106,"_30100":2090,"_20891":55614,"_5":14349,"_27386":55579,"_2933":55615},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3450":2107,"_30100":2090,"_20891":55617,"_5":14349,"_27386":55583,"_2933":55618},[],"The device proves it can enroll according to the DMS policy.",{"_3450":2108,"_30100":2090,"_20891":55620,"_5":14349,"_27386":55583,"_2933":55621},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3450":2109,"_30100":2090,"_20891":55623,"_5":14349,"_27386":55583,"_2933":55624},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3450":2110,"_30100":2090,"_20891":55626,"_5":14349,"_27386":55583,"_2933":55627},[],"The device installs the certificate and the chain it needs.",{"_3450":2111,"_30100":2090,"_20891":55629,"_5":14349,"_27386":55583,"_2933":55630},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3450":2112,"_30100":2090,"_20891":55632,"_5":14349,"_27386":55583,"_2933":55633},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3450":2113,"_30100":2090,"_20891":55635,"_5":14349,"_27386":55587,"_2933":55636},[],"A DMS relates three sets that are worth designing separately:",{"_3450":2114,"_30100":2090,"_20891":55638,"_5":14349,"_27386":55587,"_2933":55639},[],"**Enrollment CA:** signs the new identities.",{"_3450":2115,"_30100":2090,"_20891":55641,"_5":14349,"_27386":55587,"_2933":55642},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3450":2116,"_30100":2090,"_20891":55644,"_5":14349,"_27386":55587,"_2933":55645},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3450":2117,"_30100":2090,"_20891":55647,"_5":14349,"_27386":55587,"_2933":55648},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3450":2118,"_30100":2090,"_20891":55650,"_5":14349,"_27386":55591,"_2933":55651},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3450":2119,"_30100":2090,"_20891":55653,"_5":14349,"_27386":55591,"_2933":55654},[],"that the current date is between `Not Before` and `Not After`;",{"_3450":2120,"_30100":2090,"_20891":55656,"_5":14349,"_27386":55591,"_2933":55657},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3450":2121,"_30100":2090,"_20891":55659,"_5":14349,"_27386":55591,"_2933":55660},[],"that names, SANs and subject match the expected identity;",{"_3450":2122,"_30100":2090,"_20891":55662,"_5":14349,"_27386":55591,"_2933":55663},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3450":2123,"_30100":2090,"_20891":55665,"_5":14349,"_27386":55591,"_2933":55666},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3450":2124,"_30100":2090,"_20891":55668,"_5":14349,"_27386":55591,"_2933":55669},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3450":2125,"_30100":2090,"_20891":55671,"_5":14349,"_27386":55595,"_2933":55672},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3450":2126,"_30100":2090,"_20891":55674,"_5":14349,"_27386":55599,"_2933":55675},[],"Keep the root out of daily operations, or with very restricted access.",{"_3450":2127,"_30100":2090,"_20891":55677,"_5":14349,"_27386":55599,"_2933":55678},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3450":2128,"_30100":2090,"_20891":55680,"_5":14349,"_27386":55599,"_2933":55681},[],"Assign explicit profiles to every use case.",{"_3450":2129,"_30100":2090,"_20891":55683,"_5":14349,"_27386":55599,"_2933":55684},[],"Distribute the new trust before starting a rotation.",{"_3450":2130,"_30100":2090,"_20891":55686,"_5":14349,"_27386":55599,"_2933":55687},[],"Keep enough overlap to renew a disconnected fleet.",{"_3450":2131,"_30100":2090,"_20891":55689,"_5":14349,"_27386":55599,"_2933":55690},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3450":2132,"_30100":2090,"_20891":55692,"_5":14349,"_27386":55599,"_2933":55693},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3450":2133,"_30100":2133,"_5":14701,"_2933":55695,"_30453":55696,"_20891":55697,"_27386":2133},"Revocation lists (CRL)",[49052,50520,54528,55167],[],{"_3450":2134,"_30100":2133,"_20891":55699,"_5":14349,"_27386":2133,"_2933":55700},[],"Generate and distribute signed lists to validate certificates offline.",{"_3450":2135,"_30100":2133,"_5":30450,"_20891":55702,"_27386":55703,"_2933":55704},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings","CRL settings",{"_3450":2136,"_30100":2133,"_5":30450,"_20891":55706,"_27386":55707,"_2933":55708},[],"/docs/pr-preview/pr-61/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3450":2137,"_30100":2133,"_5":30450,"_20891":55710,"_27386":55711,"_2933":55712},[],"/docs/pr-preview/pr-61/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3450":2138,"_30100":2133,"_5":30450,"_20891":55714,"_27386":55715,"_2933":55716},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-contents","CRL contents",{"_3450":2139,"_30100":2133,"_5":30450,"_20891":55718,"_27386":55719,"_2933":55720},[],"/docs/pr-preview/pr-61/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3450":2140,"_30100":2133,"_5":30450,"_20891":55722,"_27386":55723,"_2933":55724},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings-api","CRL settings API",{"_3450":2141,"_30100":2133,"_5":30450,"_20891":55726,"_27386":55727,"_2933":55728},[],"/docs/pr-preview/pr-61/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3450":2142,"_30100":2133,"_5":30450,"_20891":55730,"_27386":55731,"_2933":55732},[],"/docs/pr-preview/pr-61/platform/pki/crl#from-the-interface","From the interface",{"_3450":2143,"_30100":2133,"_5":30450,"_20891":55734,"_27386":55735,"_2933":55736},[],"/docs/pr-preview/pr-61/platform/pki/crl#references","References",{"_3450":2144,"_30100":2133,"_20891":55738,"_5":14349,"_27386":2133,"_2933":55739},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3450":2145,"_30100":2133,"_20891":55741,"_5":14349,"_27386":55703,"_2933":55742},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3450":2146,"_30100":2133,"_20891":55744,"_5":14349,"_27386":55703,"_2933":55745},[],"Field",{"_3450":2147,"_30100":2133,"_20891":55747,"_5":14349,"_27386":55703,"_2933":49442},[],{"_3450":2148,"_30100":2133,"_20891":55749,"_5":14349,"_27386":55703,"_2933":55750},[],"`ca_id`",{"_3450":2149,"_30100":2133,"_20891":55752,"_5":14349,"_27386":55703,"_2933":55753},[],"ID of the CA the settings belong to.",{"_3450":2150,"_30100":2133,"_20891":55755,"_5":14349,"_27386":55703,"_2933":55756},[],"`status`",{"_3450":2151,"_30100":2133,"_20891":55758,"_5":14349,"_27386":55703,"_2933":55759},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3450":2152,"_30100":2133,"_20891":55761,"_5":14349,"_27386":55703,"_2933":55762},[],"`legacy_ski`",{"_3450":2153,"_30100":2133,"_20891":55764,"_5":14349,"_27386":55703,"_2933":55765},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3450":2154,"_30100":2133,"_20891":55767,"_5":14349,"_27386":55703,"_2933":55768},[],"`latest_crl`",{"_3450":2155,"_30100":2133,"_20891":55770,"_5":14349,"_27386":55703,"_2933":55771},[],"Version, validity start and end of the last published list. Read-only.",{"_3450":2156,"_30100":2133,"_20891":55773,"_5":14349,"_27386":55703,"_2933":55774},[],"`crl_options` field",{"_3450":2157,"_30100":2133,"_20891":55776,"_5":14349,"_27386":55703,"_2933":49442},[],{"_3450":2158,"_30100":2133,"_20891":55778,"_5":14349,"_27386":55703,"_2933":55779},[],"Initial value",{"_3450":2159,"_30100":2133,"_20891":55781,"_5":14349,"_27386":55703,"_2933":55782},[],"`validity`",{"_3450":2160,"_30100":2133,"_20891":55784,"_5":14349,"_27386":55703,"_2933":55785},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3450":2161,"_30100":2133,"_20891":55787,"_5":14349,"_27386":55703,"_2933":55788},[],"7 days.",{"_3450":2162,"_30100":2133,"_20891":55790,"_5":14349,"_27386":55703,"_2933":55791},[],"`refresh_interval`",{"_3450":2163,"_30100":2133,"_20891":55793,"_5":14349,"_27386":55703,"_2933":55794},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3450":2164,"_30100":2133,"_20891":55796,"_5":14349,"_27386":55703,"_2933":55797},[],"6 days and 23 hours.",{"_3450":2165,"_30100":2133,"_20891":55799,"_5":14349,"_27386":55703,"_2933":55800},[],"`regenerate_on_revoke`",{"_3450":2166,"_30100":2133,"_20891":55802,"_5":14349,"_27386":55703,"_2933":55803},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3450":2167,"_30100":2133,"_20891":55805,"_5":14349,"_27386":55703,"_2933":55806},[],"`true`.",{"_3450":2168,"_30100":2133,"_20891":55808,"_5":14349,"_27386":55703,"_2933":55809},[],"`signer_serial_number`",{"_3450":2169,"_30100":2133,"_20891":55811,"_5":14349,"_27386":55703,"_2933":55812},[],"Serial number of the existing certificate that signs the CRL.",{"_3450":2170,"_30100":2133,"_20891":55814,"_5":14349,"_27386":55703,"_2933":55815},[],"Serial number of the CA’s current certificate.",{"_3450":2171,"_30100":2133,"_20891":55817,"_5":14349,"_27386":55703,"_2933":55818},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3450":2172,"_30100":2133,"_20891":55820,"_5":14349,"_27386":55703,"_2933":55821},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3450":2173,"_30100":2133,"_20891":55823,"_5":14349,"_27386":55703,"_2933":55824},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3450":2174,"_30100":2133,"_20891":55826,"_5":14349,"_27386":55703,"_2933":55827},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3450":2175,"_30100":2133,"_20891":55829,"_5":14349,"_27386":55703,"_2933":55830},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3450":2176,"_30100":2133,"_20891":55832,"_5":14349,"_27386":55703,"_2933":55833},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3450":2177,"_30100":2133,"_20891":55835,"_5":14349,"_27386":55703,"_2933":55836},[],"Adjust validity and signer before deleting a CA.",{"_3450":2178,"_30100":2133,"_20891":55838,"_5":14349,"_27386":55703,"_2933":55839},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3450":2179,"_30100":2133,"_20891":55841,"_5":14349,"_27386":55703,"_2933":55842},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3450":2180,"_30100":2133,"_20891":55844,"_5":14349,"_27386":55703,"_2933":55845},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3450":2181,"_30100":2133,"_20891":55847,"_5":14349,"_27386":55707,"_2933":55848},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3450":2182,"_30100":2133,"_20891":55850,"_5":14349,"_27386":55707,"_2933":55851},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3450":2183,"_30100":2133,"_20891":55853,"_5":14349,"_27386":55707,"_2933":55854},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3450":2184,"_30100":2133,"_20891":55856,"_5":14349,"_27386":55707,"_2933":55857},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3450":2185,"_30100":2133,"_20891":55859,"_5":14349,"_27386":55711,"_2933":55860},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3450":2186,"_30100":2133,"_20891":55862,"_5":14349,"_27386":55711,"_2933":55863},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3450":2187,"_30100":2133,"_20891":55865,"_5":14349,"_27386":55711,"_2933":55866},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3450":2188,"_30100":2133,"_20891":55868,"_5":14349,"_27386":55711,"_2933":55869},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3450":2189,"_30100":2133,"_20891":55871,"_5":14349,"_27386":55711,"_2933":55872},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3450":2190,"_30100":2133,"_20891":55874,"_5":14349,"_27386":55711,"_2933":55875},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3450":2191,"_30100":2133,"_20891":55877,"_5":14349,"_27386":55711,"_2933":55878},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3450":2192,"_30100":2133,"_20891":55880,"_5":14349,"_27386":55711,"_2933":55881},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3450":2193,"_30100":2133,"_20891":55883,"_5":14349,"_27386":55711,"_2933":55884},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3450":2194,"_30100":2133,"_20891":55886,"_5":14349,"_27386":55715,"_2933":55887},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3450":2195,"_30100":2133,"_20891":55889,"_5":14349,"_27386":55715,"_2933":55890},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3450":2196,"_30100":2133,"_20891":55892,"_5":14349,"_27386":55719,"_2933":55893},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3450":2197,"_30100":2133,"_20891":55895,"_5":14349,"_27386":55719,"_2933":55896},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3450":2198,"_30100":2133,"_20891":55898,"_5":14349,"_27386":55719,"_2933":55899},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3450":2199,"_30100":2133,"_20891":55901,"_5":14349,"_27386":55719,"_2933":55902},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3450":2200,"_30100":2133,"_20891":55904,"_5":14349,"_27386":55719,"_2933":55905},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3450":2201,"_30100":2133,"_20891":55907,"_5":14349,"_27386":55723,"_2933":55908},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3450":2202,"_30100":2133,"_20891":55910,"_5":14349,"_27386":55723,"_2933":52293},[],{"_3450":2203,"_30100":2133,"_20891":55912,"_5":14349,"_27386":55723,"_2933":55913},[],"Relative path",{"_3450":2204,"_30100":2133,"_20891":55915,"_5":14349,"_27386":55723,"_2933":52290},[],{"_3450":2205,"_30100":2133,"_20891":55917,"_5":14349,"_27386":55723,"_2933":55918},[],"`GET`",{"_3450":2206,"_30100":2133,"_20891":55920,"_5":14349,"_27386":55723,"_2933":55921},[],"`/v1/crl-settings`",{"_3450":2207,"_30100":2133,"_20891":55923,"_5":14349,"_27386":55723,"_2933":55924},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3450":2208,"_30100":2133,"_20891":55926,"_5":14349,"_27386":55723,"_2933":55918},[],{"_3450":2209,"_30100":2133,"_20891":55928,"_5":14349,"_27386":55723,"_2933":55929},[],"`/v1/crl-settings/{ca-id}`",{"_3450":2210,"_30100":2133,"_20891":55931,"_5":14349,"_27386":55723,"_2933":55932},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3450":2211,"_30100":2133,"_20891":55934,"_5":14349,"_27386":55723,"_2933":55935},[],"`PUT`",{"_3450":2212,"_30100":2133,"_20891":55937,"_5":14349,"_27386":55723,"_2933":55929},[],{"_3450":2213,"_30100":2133,"_20891":55939,"_5":14349,"_27386":55723,"_2933":55940},[],"Replace the CRL configuration of a CA.",{"_3450":2214,"_30100":2133,"_20891":55942,"_5":14349,"_27386":55723,"_2933":55943},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3450":2215,"_30100":2133,"_20891":55945,"_5":14349,"_27386":55723,"_2933":55946},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3450":2216,"_30100":2133,"_20891":55948,"_5":14349,"_27386":55727,"_2933":55949},[],"Symptom",{"_3450":2217,"_30100":2133,"_20891":55951,"_5":14349,"_27386":55727,"_2933":55952},[],"Cause",{"_3450":2218,"_30100":2133,"_20891":55954,"_5":14349,"_27386":55727,"_2933":55955},[],"Action",{"_3450":2219,"_30100":2133,"_20891":55957,"_5":14349,"_27386":55727,"_2933":55958},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3450":2220,"_30100":2133,"_20891":55960,"_5":14349,"_27386":55727,"_2933":55961},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3450":2221,"_30100":2133,"_20891":55963,"_5":14349,"_27386":55727,"_2933":55964},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3450":2222,"_30100":2133,"_20891":55966,"_5":14349,"_27386":55727,"_2933":55967},[],"`PUT` returns 400.",{"_3450":2223,"_30100":2133,"_20891":55969,"_5":14349,"_27386":55727,"_2933":55970},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3450":2224,"_30100":2133,"_20891":55972,"_5":14349,"_27386":55727,"_2933":55973},[],"Set the serial number of a valid certificate of that CA.",{"_3450":2225,"_30100":2133,"_20891":55975,"_5":14349,"_27386":55727,"_2933":55976},[],"`PUT` returns 404.",{"_3450":2226,"_30100":2133,"_20891":55978,"_5":14349,"_27386":55727,"_2933":55979},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3450":2227,"_30100":2133,"_20891":55981,"_5":14349,"_27386":55727,"_2933":55982},[],"Check the CA ID and the signer serial number.",{"_3450":2228,"_30100":2133,"_20891":55984,"_5":14349,"_27386":55727,"_2933":55985},[],"`PUT` returns 400 from a 3.x client.",{"_3450":2229,"_30100":2133,"_20891":55987,"_5":14349,"_27386":55727,"_2933":55988},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3450":2230,"_30100":2133,"_20891":55990,"_5":14349,"_27386":55727,"_2933":55991},[],"Update the client to send the new field.",{"_3450":2231,"_30100":2133,"_20891":55993,"_5":14349,"_27386":55727,"_2933":55994},[],"The CRL does not change after revoking a certificate.",{"_3450":2232,"_30100":2133,"_20891":55996,"_5":14349,"_27386":55727,"_2933":55997},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3450":2233,"_30100":2133,"_20891":55999,"_5":14349,"_27386":55727,"_2933":56000},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3450":2234,"_30100":2133,"_20891":56002,"_5":14349,"_27386":55727,"_2933":56003},[],"A verifier rejects the CRL because of the issuer.",{"_3450":2235,"_30100":2133,"_20891":56005,"_5":14349,"_27386":55727,"_2933":56006},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3450":2236,"_30100":2133,"_20891":56008,"_5":14349,"_27386":55727,"_2933":56009},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3450":2237,"_30100":2133,"_20891":56011,"_5":14349,"_27386":55731,"_2933":56012},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3450":2238,"_30100":2133,"_20891":56014,"_5":14349,"_27386":55735,"_2933":56015},[],"RFC 5280: X.509 and CRL profile.",{"_3450":2239,"_30100":2133,"_20891":56017,"_5":14349,"_27386":55735,"_2933":56018},[],"OpenSSL: openssl-crl.",{"_3450":2240,"_30100":2133,"_20891":56020,"_5":14349,"_27386":55735,"_2933":56021},[],"OpenSSL: openssl-verify.",{"_3450":2241,"_30100":2133,"_20891":56023,"_5":14349,"_27386":55735,"_2933":56024},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3450":2242,"_30100":2133,"_20891":56026,"_5":14349,"_27386":55735,"_2933":56027},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3450":2243,"_30100":2243,"_5":14701,"_2933":56029,"_30453":56030,"_20891":56031,"_27386":2243},"Keys and cryptographic engines",[49052,50520,54528,54529],[],{"_3450":2244,"_30100":2243,"_20891":56033,"_5":14349,"_27386":2243,"_2933":56034},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3450":2245,"_30100":2243,"_5":30450,"_20891":56036,"_27386":56037,"_2933":56038},[],"/docs/pr-preview/pr-61/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3450":2246,"_30100":2243,"_5":30450,"_20891":56040,"_27386":56041,"_2933":56042},[],"/docs/pr-preview/pr-61/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3450":2247,"_30100":2243,"_5":30450,"_20891":56044,"_27386":56045,"_2933":56046},[],"/docs/pr-preview/pr-61/platform/pki/key-management#file-system","File System",{"_3450":2248,"_30100":2243,"_5":30450,"_20891":56048,"_27386":56049,"_2933":56050},[],"/docs/pr-preview/pr-61/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3450":2249,"_30100":2243,"_5":30450,"_20891":56052,"_27386":56053,"_2933":56054},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3450":2250,"_30100":2243,"_5":30450,"_20891":56056,"_27386":56057,"_2933":56058},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-kms","AWS KMS",{"_3450":2251,"_30100":2243,"_5":30450,"_20891":56060,"_27386":56061,"_2933":56062},[],"/docs/pr-preview/pr-61/platform/pki/key-management#pkcs11","PKCS#11",{"_3450":2252,"_30100":2243,"_5":30450,"_20891":56064,"_27386":56065,"_2933":56066},[],"/docs/pr-preview/pr-61/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3450":2253,"_30100":2243,"_5":30450,"_20891":56068,"_27386":56069,"_2933":56070},[],"/docs/pr-preview/pr-61/platform/pki/key-management#key-inventory","Key inventory",{"_3450":2254,"_30100":2243,"_5":30450,"_20891":56072,"_27386":56073,"_2933":56074},[],"/docs/pr-preview/pr-61/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3450":2255,"_30100":2243,"_5":30450,"_20891":56076,"_27386":56077,"_2933":56078},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3450":2256,"_30100":2243,"_5":30450,"_20891":56080,"_27386":56081,"_2933":56082},[],"/docs/pr-preview/pr-61/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3450":2257,"_30100":2243,"_5":30450,"_20891":56084,"_27386":56085,"_2933":56086},[],"/docs/pr-preview/pr-61/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3450":2258,"_30100":2243,"_5":30450,"_20891":56088,"_27386":56089,"_2933":56090},[],"/docs/pr-preview/pr-61/platform/pki/key-management#view-details","View details",{"_3450":2259,"_30100":2243,"_5":30450,"_20891":56092,"_27386":56093,"_2933":56094},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3450":2260,"_30100":2243,"_5":30450,"_20891":56096,"_27386":56097,"_2933":56098},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign","Sign",{"_3450":2261,"_30100":2243,"_5":30450,"_20891":56100,"_27386":56101,"_2933":56102},[],"/docs/pr-preview/pr-61/platform/pki/key-management#verify","Verify",{"_3450":2262,"_30100":2243,"_5":30450,"_20891":56104,"_27386":56105,"_2933":56106},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3450":2263,"_30100":2243,"_5":30450,"_20891":56108,"_27386":56109,"_2933":56110},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3450":2264,"_30100":2243,"_5":30450,"_20891":56112,"_27386":56113,"_2933":56114},[],"/docs/pr-preview/pr-61/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3450":2265,"_30100":2243,"_20891":56116,"_5":14349,"_27386":2243,"_2933":56117},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3450":2266,"_30100":2243,"_20891":56119,"_5":14349,"_27386":2243,"_2933":56120},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3450":2267,"_30100":2243,"_20891":56122,"_5":14349,"_27386":56037,"_2933":56123},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3450":2268,"_30100":2243,"_20891":56125,"_5":14349,"_27386":56037,"_2933":56126},[],"In practice, it lets you:",{"_3450":2269,"_30100":2243,"_20891":56128,"_5":14349,"_27386":56037,"_2933":56129},[],"Generate new key pairs from Lamassu IoT.",{"_3450":2270,"_30100":2243,"_20891":56131,"_5":14349,"_27386":56037,"_2933":56132},[],"Import keys created externally.",{"_3450":2271,"_30100":2243,"_20891":56134,"_5":14349,"_27386":56037,"_2933":56135},[],"Delegate custody and cryptographic operations to external engines.",{"_3450":2272,"_30100":2243,"_20891":56137,"_5":14349,"_27386":56037,"_2933":56138},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3450":2273,"_30100":2243,"_20891":56140,"_5":14349,"_27386":56041,"_2933":56141},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3450":2274,"_30100":2243,"_20891":56143,"_5":14349,"_27386":56041,"_2933":56144},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3450":2275,"_30100":2243,"_20891":56146,"_5":14349,"_27386":56041,"_2933":56147},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3450":2276,"_30100":2243,"_20891":56149,"_5":14349,"_27386":56045,"_2933":56150},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3450":2277,"_30100":2243,"_20891":56152,"_5":14349,"_27386":56049,"_2933":56153},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3450":2278,"_30100":2243,"_20891":56155,"_5":14349,"_27386":56049,"_2933":56156},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3450":2279,"_30100":2243,"_20891":56158,"_5":14349,"_27386":56053,"_2933":56159},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3450":2280,"_30100":2243,"_20891":56161,"_5":14349,"_27386":56057,"_2933":56162},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3450":2281,"_30100":2243,"_20891":56164,"_5":14349,"_27386":56061,"_2933":56165},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3450":2282,"_30100":2243,"_20891":56167,"_5":14349,"_27386":56065,"_2933":56168},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3450":2283,"_30100":2243,"_20891":56170,"_5":14349,"_27386":56065,"_2933":56171},[],"Lamassu shows the enabled engines in the console.",{"_3450":2284,"_30100":2243,"_20891":56173,"_5":14349,"_27386":56065,"_2933":56174},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3450":2285,"_30100":2243,"_20891":56176,"_5":14349,"_27386":56065,"_2933":56177},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3450":2286,"_30100":2243,"_20891":56179,"_5":14349,"_27386":56069,"_2933":56180},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3450":2287,"_30100":2243,"_20891":56182,"_5":14349,"_27386":56069,"_2933":56183},[],"The table includes the following fields:",{"_3450":2288,"_30100":2243,"_20891":56185,"_5":14349,"_27386":56069,"_2933":56186},[],"**Name**: descriptive name of the key.",{"_3450":2289,"_30100":2243,"_20891":56188,"_5":14349,"_27386":56069,"_2933":56189},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3450":2290,"_30100":2243,"_20891":56191,"_5":14349,"_27386":56069,"_2933":56192},[],"**Strength**: visual indicator of cryptographic strength.",{"_3450":2291,"_30100":2243,"_20891":56194,"_5":14349,"_27386":56069,"_2933":56195},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3450":2292,"_30100":2243,"_20891":56197,"_5":14349,"_27386":56069,"_2933":56198},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3450":2293,"_30100":2243,"_20891":56200,"_5":14349,"_27386":56069,"_2933":56201},[],"**Aliases**: alternative names associated with the key.",{"_3450":2294,"_30100":2243,"_20891":56203,"_5":14349,"_27386":56069,"_2933":56204},[],"**Tags**: labels for classification and search.",{"_3450":2295,"_30100":2243,"_20891":56206,"_5":14349,"_27386":56069,"_2933":56207},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3450":2296,"_30100":2243,"_20891":56209,"_5":14349,"_27386":56069,"_2933":56210},[],"From this view you also reach the most common actions:",{"_3450":2297,"_30100":2243,"_20891":56212,"_5":14349,"_27386":56069,"_2933":56213},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3450":2298,"_30100":2243,"_20891":56215,"_5":14349,"_27386":56069,"_2933":56216},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3450":2299,"_30100":2243,"_20891":56218,"_5":14349,"_27386":56069,"_2933":56219},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3450":2300,"_30100":2243,"_20891":56221,"_5":14349,"_27386":56069,"_2933":56222},[],"**Delete Key** to remove the key from the system.",{"_3450":2301,"_30100":2243,"_20891":56224,"_5":14349,"_27386":56073,"_2933":56225},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3450":2302,"_30100":2243,"_20891":56227,"_5":14349,"_27386":56077,"_2933":56228},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3450":2303,"_30100":2243,"_20891":56230,"_5":14349,"_27386":56077,"_2933":56231},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3450":2304,"_30100":2243,"_20891":56233,"_5":14349,"_27386":56077,"_2933":56234},[],"**Key Name**: unique and descriptive name.",{"_3450":2305,"_30100":2243,"_20891":56236,"_5":14349,"_27386":56077,"_2933":56237},[],"**Crypto Engine**: engine that will keep the key.",{"_3450":2306,"_30100":2243,"_20891":56239,"_5":14349,"_27386":56077,"_2933":56240},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3450":2307,"_30100":2243,"_20891":56242,"_5":14349,"_27386":56077,"_2933":56243},[],"**Tags**: metadata to classify the key.",{"_3450":2308,"_30100":2243,"_20891":56245,"_5":14349,"_27386":56077,"_2933":56246},[],"**Metadata**: additional information for advanced uses.",{"_3450":2309,"_30100":2243,"_20891":56248,"_5":14349,"_27386":56081,"_2933":56249},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3450":2310,"_30100":2243,"_20891":56251,"_5":14349,"_27386":56081,"_2933":56252},[],"When you have an exportable private key and the destination engine supports import.",{"_3450":2311,"_30100":2243,"_20891":56254,"_5":14349,"_27386":56081,"_2933":56255},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3450":2312,"_30100":2243,"_20891":56257,"_5":14349,"_27386":56081,"_2933":56258},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3450":2313,"_30100":2243,"_20891":56260,"_5":14349,"_27386":56081,"_2933":56261},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3450":2314,"_30100":2243,"_20891":56263,"_5":14349,"_27386":56081,"_2933":56264},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3450":2315,"_30100":2243,"_20891":56266,"_5":14349,"_27386":56081,"_2933":56267},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3450":2316,"_30100":2243,"_20891":56269,"_5":14349,"_27386":56081,"_2933":56270},[],"**Tags**: labels for organization and search.",{"_3450":2317,"_30100":2243,"_20891":56272,"_5":14349,"_27386":56081,"_2933":56273},[],"**Metadata**: additional optional information.",{"_3450":2318,"_30100":2243,"_20891":56275,"_5":14349,"_27386":56081,"_2933":56276},[],"**Private Key (PEM)**: private key in PEM format.",{"_3450":2319,"_30100":2243,"_20891":56278,"_5":14349,"_27386":56081,"_2933":56279},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3450":2320,"_30100":2243,"_20891":56281,"_5":14349,"_27386":56085,"_2933":56282},[],"Each registered key has a detail view and several operational actions.",{"_3450":2321,"_30100":2243,"_20891":56284,"_5":14349,"_27386":56089,"_2933":56285},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3450":2322,"_30100":2243,"_20891":56287,"_5":14349,"_27386":56089,"_2933":56288},[],"The **Overview** tab shows, among others, these fields:",{"_3450":2323,"_30100":2243,"_20891":56290,"_5":14349,"_27386":56089,"_2933":56291},[],"**Key Name**: descriptive name.",{"_3450":2324,"_30100":2243,"_20891":56293,"_5":14349,"_27386":56089,"_2933":56294},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3450":2325,"_30100":2243,"_20891":56296,"_5":14349,"_27386":56089,"_2933":56297},[],"**Tags**: associated labels.",{"_3450":2326,"_30100":2243,"_20891":56299,"_5":14349,"_27386":56089,"_2933":56300},[],"**Aliases**: alternative names.",{"_3450":2327,"_30100":2243,"_20891":56302,"_5":14349,"_27386":56089,"_2933":56303},[],"**Crypto Engine**: engine where the key resides.",{"_3450":2328,"_30100":2243,"_20891":56305,"_5":14349,"_27386":56089,"_2933":56306},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3450":2329,"_30100":2243,"_20891":56308,"_5":14349,"_27386":56089,"_2933":56309},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3450":2330,"_30100":2243,"_20891":56311,"_5":14349,"_27386":56089,"_2933":56312},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3450":2331,"_30100":2243,"_20891":56314,"_5":14349,"_27386":56093,"_2933":56315},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3450":2332,"_30100":2243,"_20891":56317,"_5":14349,"_27386":56093,"_2933":56318},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3450":2333,"_30100":2243,"_20891":56320,"_5":14349,"_27386":56093,"_2933":56321},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3450":2334,"_30100":2243,"_20891":56323,"_5":14349,"_27386":56097,"_2933":56324},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3450":2335,"_30100":2243,"_20891":56326,"_5":14349,"_27386":56097,"_2933":56327},[],"Main fields:",{"_3450":2336,"_30100":2243,"_20891":56329,"_5":14349,"_27386":56097,"_2933":56330},[],"**Algorithm**: signing algorithm available for the key type.",{"_3450":2337,"_30100":2243,"_20891":56332,"_5":14349,"_27386":56097,"_2933":56333},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3450":2338,"_30100":2243,"_20891":56335,"_5":14349,"_27386":56097,"_2933":56336},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3450":2339,"_30100":2243,"_20891":56338,"_5":14349,"_27386":56097,"_2933":56339},[],"**Message**: content to sign.",{"_3450":2340,"_30100":2243,"_20891":56341,"_5":14349,"_27386":56097,"_2933":56342},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3450":2341,"_30100":2243,"_20891":56344,"_5":14349,"_27386":56101,"_2933":56345},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3450":2342,"_30100":2243,"_20891":56347,"_5":14349,"_27386":56101,"_2933":56327},[],{"_3450":2343,"_30100":2243,"_20891":56349,"_5":14349,"_27386":56101,"_2933":56350},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3450":2344,"_30100":2243,"_20891":56352,"_5":14349,"_27386":56101,"_2933":56353},[],"**Message Type**: `Raw` or `Digest`.",{"_3450":2345,"_30100":2243,"_20891":56355,"_5":14349,"_27386":56101,"_2933":56356},[],"**Payload Encoding**: encoding of the message.",{"_3450":2346,"_30100":2243,"_20891":56358,"_5":14349,"_27386":56101,"_2933":56359},[],"**Message**: original message or hash.",{"_3450":2347,"_30100":2243,"_20891":56361,"_5":14349,"_27386":56101,"_2933":56362},[],"**Signature**: signature to check.",{"_3450":2348,"_30100":2243,"_20891":56364,"_5":14349,"_27386":56101,"_2933":56365},[],"**Result**: indicator of the validation result.",{"_3450":2349,"_30100":2243,"_20891":56367,"_5":14349,"_27386":56105,"_2933":56368},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3450":2350,"_30100":2243,"_20891":56370,"_5":14349,"_27386":56105,"_2933":56371},[],"This flow is useful for:",{"_3450":2351,"_30100":2243,"_20891":56373,"_5":14349,"_27386":56105,"_2933":56374},[],"Requesting certificates from an external CA.",{"_3450":2352,"_30100":2243,"_20891":56376,"_5":14349,"_27386":56105,"_2933":56377},[],"Renewing an identity while keeping the same key.",{"_3450":2353,"_30100":2243,"_20891":56379,"_5":14349,"_27386":56105,"_2933":56380},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3450":2354,"_30100":2243,"_20891":56382,"_5":14349,"_27386":56105,"_2933":56383},[],"**Common Name (CN)**: main name of the identity.",{"_3450":2355,"_30100":2243,"_20891":56385,"_5":14349,"_27386":56105,"_2933":56386},[],"**Organization (O)**: organization or company.",{"_3450":2356,"_30100":2243,"_20891":56388,"_5":14349,"_27386":56105,"_2933":56389},[],"**Organizational Unit (OU)**: department or unit.",{"_3450":2357,"_30100":2243,"_20891":56391,"_5":14349,"_27386":56105,"_2933":56392},[],"**Country (C)**: two-letter country code.",{"_3450":2358,"_30100":2243,"_20891":56394,"_5":14349,"_27386":56105,"_2933":56395},[],"**State / Province (ST)**: state or province.",{"_3450":2359,"_30100":2243,"_20891":56397,"_5":14349,"_27386":56105,"_2933":56398},[],"**Locality (L)**: city or locality.",{"_3450":2360,"_30100":2243,"_20891":56400,"_5":14349,"_27386":56105,"_2933":56401},[],"**Email Address**: contact email.",{"_3450":2361,"_30100":2243,"_20891":56403,"_5":14349,"_27386":56105,"_2933":56404},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3450":2362,"_30100":2243,"_20891":56406,"_5":14349,"_27386":56105,"_2933":56407},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3450":2363,"_30100":2243,"_20891":56409,"_5":14349,"_27386":56109,"_2933":56410},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3450":2364,"_30100":2243,"_20891":56412,"_5":14349,"_27386":56109,"_2933":56413},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3450":2365,"_30100":2243,"_20891":56415,"_5":14349,"_27386":56113,"_2933":56416},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3450":2366,"_30100":2243,"_20891":56418,"_5":14349,"_27386":56113,"_2933":56419},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3450":2367,"_30100":2367,"_5":14701,"_2933":56421,"_30453":56422,"_20891":56423,"_27386":2367},"Online validation with OCSP",[49052,50520,54528,55167],[],{"_3450":2368,"_30100":2367,"_20891":56425,"_5":14349,"_27386":2367,"_2933":56426},[],"Query signed status and verify the responder’s response.",{"_3450":2369,"_30100":2367,"_5":30450,"_20891":56428,"_27386":56429,"_2933":56430},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3450":2370,"_30100":2367,"_5":30450,"_20891":56432,"_27386":56433,"_2933":56434},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3450":2371,"_30100":2367,"_5":30450,"_20891":56436,"_27386":56437,"_2933":56438},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3450":2372,"_30100":2367,"_5":30450,"_20891":56440,"_27386":56441,"_2933":56442},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3450":2373,"_30100":2367,"_5":30450,"_20891":56444,"_27386":56445,"_2933":56446},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3450":2374,"_30100":2367,"_5":30450,"_20891":56448,"_27386":56449,"_2933":55736},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#references",{"_3450":2375,"_30100":2367,"_20891":56451,"_5":14349,"_27386":2367,"_2933":56452},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3450":2376,"_30100":2367,"_20891":56454,"_5":14349,"_27386":56429,"_2933":56455},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3450":2377,"_30100":2367,"_20891":56457,"_5":14349,"_27386":56429,"_2933":56458},[],"Record status",{"_3450":2378,"_30100":2367,"_20891":56460,"_5":14349,"_27386":56429,"_2933":56461},[],"Signed response",{"_3450":2379,"_30100":2367,"_20891":56463,"_5":14349,"_27386":56429,"_2933":53665},[],{"_3450":2380,"_30100":2367,"_20891":56465,"_5":14349,"_27386":56429,"_2933":56466},[],"`Good`.",{"_3450":2381,"_30100":2367,"_20891":56468,"_5":14349,"_27386":56429,"_2933":53682},[],{"_3450":2382,"_30100":2367,"_20891":56470,"_5":14349,"_27386":56429,"_2933":56471},[],"`Revoked`, with revocation reason and timestamp.",{"_3450":2383,"_30100":2367,"_20891":56473,"_5":14349,"_27386":56429,"_2933":56474},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3450":2384,"_30100":2367,"_20891":56476,"_5":14349,"_27386":56429,"_2933":56477},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3450":2385,"_30100":2367,"_20891":56479,"_5":14349,"_27386":56429,"_2933":56480},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3450":2386,"_30100":2367,"_20891":56482,"_5":14349,"_27386":56429,"_2933":56483},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3450":2387,"_30100":2367,"_20891":56485,"_5":14349,"_27386":56429,"_2933":56486},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3450":2388,"_30100":2367,"_20891":56488,"_5":14349,"_27386":56433,"_2933":56489},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3450":2389,"_30100":2367,"_20891":56491,"_5":14349,"_27386":56433,"_2933":56492},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3450":2390,"_30100":2367,"_20891":56494,"_5":14349,"_27386":56437,"_2933":56495},[],"The service accepts:",{"_3450":2391,"_30100":2367,"_20891":56497,"_5":14349,"_27386":56437,"_2933":52293},[],{"_3450":2392,"_30100":2367,"_20891":56499,"_5":14349,"_27386":56437,"_2933":56500},[],"VA service path",{"_3450":2393,"_30100":2367,"_20891":56502,"_5":14349,"_27386":56437,"_2933":56503},[],"Format",{"_3450":2394,"_30100":2367,"_20891":56505,"_5":14349,"_27386":56437,"_2933":56506},[],"`POST`",{"_3450":2395,"_30100":2367,"_20891":56508,"_5":14349,"_27386":56437,"_2933":56509},[],"`/ocsp`",{"_3450":2396,"_30100":2367,"_20891":56511,"_5":14349,"_27386":56437,"_2933":56512},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3450":2397,"_30100":2367,"_20891":56514,"_5":14349,"_27386":56437,"_2933":55918},[],{"_3450":2398,"_30100":2367,"_20891":56516,"_5":14349,"_27386":56437,"_2933":56517},[],"`/ocsp/{ocsp_request}`",{"_3450":2399,"_30100":2367,"_20891":56519,"_5":14349,"_27386":56437,"_2933":56520},[],"DER request encoded using padded URL Base64.",{"_3450":2400,"_30100":2367,"_20891":56522,"_5":14349,"_27386":56437,"_2933":56523},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3450":2401,"_30100":2367,"_20891":56525,"_5":14349,"_27386":56441,"_2933":56526},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3450":2402,"_30100":2367,"_20891":56528,"_5":14349,"_27386":56441,"_2933":56529},[],"Generate the request:",{"_3450":2403,"_30100":2367,"_20891":56531,"_5":14349,"_27386":56441,"_2933":56532},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3450":2404,"_30100":2367,"_20891":56534,"_5":14349,"_27386":56441,"_2933":56535},[],"Replace the example URL with the inspected endpoint:",{"_3450":2405,"_30100":2367,"_20891":56537,"_5":14349,"_27386":56441,"_2933":56538},[],"Verify the returned DER:",{"_3450":2406,"_30100":2367,"_20891":56540,"_5":14349,"_27386":56441,"_2933":56541},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3450":2407,"_30100":2367,"_20891":56543,"_5":14349,"_27386":56445,"_2933":56544},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3450":2408,"_30100":2367,"_20891":56546,"_5":14349,"_27386":56445,"_2933":56547},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3450":2409,"_30100":2367,"_20891":56549,"_5":14349,"_27386":56449,"_2933":56550},[],"RFC 6960: OCSP.",{"_3450":2410,"_30100":2367,"_20891":56552,"_5":14349,"_27386":56449,"_2933":56553},[],"OpenSSL: openssl-ocsp.",{"_3450":2411,"_30100":2367,"_20891":56555,"_5":14349,"_27386":56449,"_2933":56556},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3450":2412,"_30100":2367,"_20891":56558,"_5":14349,"_27386":56449,"_2933":56027},[],{"_3450":2413,"_30100":2413,"_5":14701,"_2933":54528,"_30453":56560,"_20891":56561,"_27386":2413},[49052,50520,54528],[],{"_3450":2414,"_30100":2413,"_20891":56563,"_5":14349,"_27386":2413,"_2933":56564},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3450":2415,"_30100":2413,"_5":30450,"_20891":56566,"_27386":56567,"_2933":53840},[],"/docs/pr-preview/pr-61/platform/pki/overview#start-here",{"_3450":2416,"_30100":2413,"_5":30450,"_20891":56569,"_27386":56570,"_2933":56571},[],"/docs/pr-preview/pr-61/platform/pki/overview#what-you-need","What you need",{"_3450":2417,"_30100":2413,"_5":30450,"_20891":56573,"_27386":56574,"_2933":54372},[],"/docs/pr-preview/pr-61/platform/pki/overview#core-capabilities",{"_3450":2418,"_30100":2413,"_5":30450,"_20891":56576,"_27386":56577,"_2933":54376},[],"/docs/pr-preview/pr-61/platform/pki/overview#build-your-trust-hierarchy",{"_3450":2419,"_30100":2413,"_5":30450,"_20891":56579,"_27386":56580,"_2933":54380},[],"/docs/pr-preview/pr-61/platform/pki/overview#protect-cryptographic-keys",{"_3450":2420,"_30100":2413,"_5":30450,"_20891":56582,"_27386":56583,"_2933":54384},[],"/docs/pr-preview/pr-61/platform/pki/overview#issue-and-control-certificates",{"_3450":2421,"_30100":2413,"_5":30450,"_20891":56585,"_27386":56586,"_2933":54392},[],"/docs/pr-preview/pr-61/platform/pki/overview#publish-validation-status",{"_3450":2422,"_30100":2413,"_5":30450,"_20891":56588,"_27386":56589,"_2933":56590},[],"/docs/pr-preview/pr-61/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3450":2423,"_30100":2413,"_5":30450,"_20891":56592,"_27386":56593,"_2933":55334},[],"/docs/pr-preview/pr-61/platform/pki/overview#continue",{"_3450":2424,"_30100":2413,"_20891":56595,"_5":14349,"_27386":2413,"_2933":56596},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3450":2425,"_30100":2413,"_20891":56598,"_5":14349,"_27386":56567,"_2933":56599},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3450":2426,"_30100":2413,"_20891":56601,"_5":14349,"_27386":56567,"_2933":56602},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3450":2427,"_30100":2413,"_20891":56604,"_5":14349,"_27386":56570,"_2933":56605},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3450":2428,"_30100":2413,"_20891":56607,"_5":14349,"_27386":56570,"_2933":56608},[],"An available cryptographic engine to keep the authority's key.",{"_3450":2429,"_30100":2413,"_20891":56610,"_5":14349,"_27386":56570,"_2933":56611},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3450":2430,"_30100":2413,"_20891":56613,"_5":14349,"_27386":56570,"_2933":56614},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3450":2431,"_30100":2413,"_20891":56616,"_5":14349,"_27386":56570,"_2933":56617},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3450":2432,"_30100":2413,"_20891":56619,"_5":14349,"_27386":56577,"_2933":56620},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3450":2433,"_30100":2413,"_20891":56622,"_5":14349,"_27386":56580,"_2933":56623},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3450":2434,"_30100":2413,"_20891":56625,"_5":14349,"_27386":56583,"_2933":56626},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3450":2435,"_30100":2413,"_20891":56628,"_5":14349,"_27386":56586,"_2933":56629},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3450":2436,"_30100":2413,"_20891":56631,"_5":14349,"_27386":56589,"_2933":56632},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3450":2437,"_30100":2413,"_20891":56634,"_5":14349,"_27386":56589,"_2933":56635},[],"its subject and extensions identify the expected client;",{"_3450":2438,"_30100":2413,"_20891":56637,"_5":14349,"_27386":56589,"_2933":56638},[],"its public key matches the client's private key;",{"_3450":2439,"_30100":2413,"_20891":56640,"_5":14349,"_27386":56589,"_2933":56641},[],"its chain reaches a root trusted by the consumer;",{"_3450":2440,"_30100":2413,"_20891":56643,"_5":14349,"_27386":56589,"_2933":56644},[],"its dates and usages allow the operation;",{"_3450":2441,"_30100":2413,"_20891":56646,"_5":14349,"_27386":56589,"_2933":56647},[],"the consumer applies revocation checks and authorization.",{"_3450":2442,"_30100":2413,"_20891":56649,"_5":14349,"_27386":56589,"_2933":56650},[],"The issuance path includes the first independent checks.",{"_3450":2443,"_30100":2413,"_20891":56652,"_5":14349,"_27386":56593,"_2933":56653},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3450":2444,"_30100":2413,"_20891":56655,"_5":14349,"_27386":56593,"_2933":56656},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3450":2445,"_30100":2413,"_20891":56658,"_5":14349,"_27386":56593,"_2933":56659},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3450":2446,"_30100":2446,"_5":14701,"_2933":56661,"_30453":56662,"_20891":56663,"_27386":2446},"Create your first CA",[49052,50520,54528,53965],[],{"_3450":2447,"_30100":2446,"_20891":56665,"_5":14349,"_27386":2446,"_2933":56666},[],"Create an evaluation root and check its certificate before issuing.",{"_3450":2448,"_30100":2446,"_5":30450,"_20891":56668,"_27386":56669,"_2933":49062},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3450":2449,"_30100":2446,"_5":30450,"_20891":56671,"_27386":56672,"_2933":56673},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#create-the-authority","Create the authority",{"_3450":2450,"_30100":2446,"_5":30450,"_20891":56675,"_27386":56676,"_2933":56677},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3450":2451,"_30100":2446,"_5":30450,"_20891":56679,"_27386":56680,"_2933":54222},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3450":2452,"_30100":2446,"_5":30450,"_20891":56682,"_27386":56683,"_2933":49086},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3450":2453,"_30100":2446,"_20891":56685,"_5":14349,"_27386":2446,"_2933":56686},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3450":2454,"_30100":2446,"_20891":56688,"_5":14349,"_27386":56669,"_2933":56689},[],"Console access and permission to create keys and authorities.",{"_3450":2455,"_30100":2446,"_20891":56691,"_5":14349,"_27386":56669,"_2933":56692},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3450":2456,"_30100":2446,"_20891":56694,"_5":14349,"_27386":56669,"_2933":56695},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3450":2457,"_30100":2446,"_20891":56697,"_5":14349,"_27386":56669,"_2933":56698},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3450":2458,"_30100":2446,"_20891":56700,"_5":14349,"_27386":56672,"_2933":56701},[],"Follow the interactive walkthrough to create a root CA with a new ECDSA P-384 key, an example subject and a client-certificate issuance profile. The availability and lifetime of profiles depend on your environment; choose values appropriate for your CA.",{"_3450":2459,"_30100":2446,"_20891":56703,"_5":14349,"_27386":56672,"_2933":56704},[],"The example sets **CA Name** to `Acme Showcase Root CA`, which becomes the subject Common Name (CN). It also sets the optional subject fields &#x2A;*Country (C)** to `ES` and &#x2A;*Organization (O)** to `Acme`; use values appropriate for your authority.",{"_3450":2460,"_30100":2446,"_20891":56706,"_5":14349,"_27386":56672,"_2933":56707},[],"Open the new CA and select **Certificate PEM**. Download or copy its public certificate to `ca.pem`, including the complete `BEGIN CERTIFICATE` and `END CERTIFICATE` block. The private key remains in the configured engine. To reuse an existing key instead, see the authorities guide.",{"_3450":2461,"_30100":2446,"_20891":56709,"_5":14349,"_27386":56676,"_2933":56710},[],"Run from the directory where you saved `ca.pem`:",{"_3450":2462,"_30100":2446,"_20891":56712,"_5":14349,"_27386":56676,"_2933":56713},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3450":2463,"_30100":2446,"_20891":56715,"_5":14349,"_27386":56676,"_2933":56716},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3450":2464,"_30100":2446,"_20891":56718,"_5":14349,"_27386":56680,"_2933":56719},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3450":2465,"_30100":2446,"_20891":56721,"_5":14349,"_27386":56680,"_2933":56722},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3450":2466,"_30100":2446,"_20891":56724,"_5":14349,"_27386":56680,"_2933":56725},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3450":2467,"_30100":2446,"_20891":56727,"_5":14349,"_27386":56680,"_2933":56728},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3450":2468,"_30100":2446,"_20891":56730,"_5":14349,"_27386":56683,"_2933":56731},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3450":2469,"_30100":2469,"_5":14701,"_2933":56733,"_30453":56734,"_20891":56735,"_27386":2469},"Issue and verify a certificate",[49052,50520,54528,53965],[],{"_3450":2470,"_30100":2469,"_20891":56737,"_5":14349,"_27386":2469,"_2933":56738},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3450":2471,"_30100":2469,"_5":30450,"_20891":56740,"_27386":56741,"_2933":49062},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3450":2472,"_30100":2469,"_5":30450,"_20891":56743,"_27386":56744,"_2933":56745},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3450":2473,"_30100":2469,"_5":30450,"_20891":56747,"_27386":56748,"_2933":56749},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3450":2474,"_30100":2469,"_5":30450,"_20891":56751,"_27386":56752,"_2933":56753},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3450":2475,"_30100":2469,"_5":30450,"_20891":56755,"_27386":56756,"_2933":56757},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3450":2476,"_30100":2469,"_5":30450,"_20891":56759,"_27386":56760,"_2933":56761},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3450":2477,"_30100":2469,"_5":30450,"_20891":56763,"_27386":56764,"_2933":56765},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3450":2478,"_30100":2469,"_5":30450,"_20891":56767,"_27386":56768,"_2933":56769},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3450":2479,"_30100":2469,"_5":30450,"_20891":56771,"_27386":56772,"_2933":56773},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3450":2480,"_30100":2469,"_5":30450,"_20891":56775,"_27386":56776,"_2933":56777},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3450":2481,"_30100":2469,"_5":30450,"_20891":56779,"_27386":56780,"_2933":54222},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3450":2482,"_30100":2469,"_5":30450,"_20891":56782,"_27386":56783,"_2933":49086},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#next-step",{"_3450":2483,"_30100":2469,"_20891":56785,"_5":14349,"_27386":2469,"_2933":56786},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3450":2484,"_30100":2469,"_20891":56788,"_5":14349,"_27386":56741,"_2933":56789},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3450":2485,"_30100":2469,"_20891":56791,"_5":14349,"_27386":56741,"_2933":56792},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3450":2486,"_30100":2469,"_20891":56794,"_5":14349,"_27386":56741,"_2933":56795},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3450":2487,"_30100":2469,"_20891":56797,"_5":14349,"_27386":56741,"_2933":56798},[],"A client identifier: here we use `device-001`.",{"_3450":2488,"_30100":2469,"_20891":56800,"_5":14349,"_27386":56741,"_2933":56801},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3450":2489,"_30100":2469,"_20891":56803,"_5":14349,"_27386":56744,"_2933":56804},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3450":2490,"_30100":2469,"_20891":56806,"_5":14349,"_27386":56748,"_2933":56807},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3450":2491,"_30100":2469,"_20891":56809,"_5":14349,"_27386":56748,"_2933":56810},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3450":2492,"_30100":2469,"_20891":56812,"_5":14349,"_27386":56752,"_2933":56813},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3450":2493,"_30100":2469,"_20891":56815,"_5":14349,"_27386":56752,"_2933":56816},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3450":2494,"_30100":2469,"_20891":56818,"_5":14349,"_27386":56756,"_2933":56819},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3450":2495,"_30100":2469,"_20891":56821,"_5":14349,"_27386":56756,"_2933":56822},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3450":2496,"_30100":2469,"_20891":56824,"_5":14349,"_27386":56760,"_2933":56825},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3450":2497,"_30100":2469,"_20891":56827,"_5":14349,"_27386":56764,"_2933":56828},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3450":2498,"_30100":2469,"_20891":56830,"_5":14349,"_27386":56768,"_2933":56831},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3450":2499,"_30100":2469,"_20891":56833,"_5":14349,"_27386":56772,"_2933":56834},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3450":2500,"_30100":2469,"_20891":56836,"_5":14349,"_27386":56772,"_2933":56837},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3450":2501,"_30100":2469,"_20891":56839,"_5":14349,"_27386":56772,"_2933":56840},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3450":2502,"_30100":2469,"_20891":56842,"_5":14349,"_27386":56776,"_2933":56843},[],"In Bash, compare the two public-key digests:",{"_3450":2503,"_30100":2469,"_20891":56845,"_5":14349,"_27386":56776,"_2933":56846},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3450":2504,"_30100":2469,"_20891":56848,"_5":14349,"_27386":56776,"_2933":56849},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3450":2505,"_30100":2469,"_20891":56851,"_5":14349,"_27386":56780,"_2933":54306},[],{"_3450":2506,"_30100":2469,"_20891":56853,"_5":14349,"_27386":56780,"_2933":56854},[],"What to review",{"_3450":2507,"_30100":2469,"_20891":56856,"_5":14349,"_27386":56780,"_2933":56857},[],"The CA rejects issuance",{"_3450":2508,"_30100":2469,"_20891":56859,"_5":14349,"_27386":56780,"_2933":56860},[],"Permissions, CA state and key, algorithm and profile.",{"_3450":2509,"_30100":2469,"_20891":56862,"_5":14349,"_27386":56780,"_2933":56863},[],"Different subject or usages",{"_3450":2510,"_30100":2469,"_20891":56865,"_5":14349,"_27386":56780,"_2933":56866},[],"Applied profile and requested values.",{"_3450":2511,"_30100":2469,"_20891":56868,"_5":14349,"_27386":56780,"_2933":56869},[],"Issuer cannot be found",{"_3450":2512,"_30100":2469,"_20891":56871,"_5":14349,"_27386":56780,"_2933":56872},[],"Downloaded CA and required intermediate chain.",{"_3450":2513,"_30100":2469,"_20891":56874,"_5":14349,"_27386":56780,"_2933":56875},[],"Validity fails",{"_3450":2514,"_30100":2469,"_20891":56877,"_5":14349,"_27386":56780,"_2933":56878},[],"Certificate and CA dates, and the computer's clock.",{"_3450":2515,"_30100":2469,"_20891":56880,"_5":14349,"_27386":56780,"_2933":56881},[],"Public-key digests differ",{"_3450":2516,"_30100":2469,"_20891":56883,"_5":14349,"_27386":56780,"_2933":56884},[],"Certificate and key files from the same issuance.",{"_3450":2517,"_30100":2469,"_20891":56886,"_5":14349,"_27386":56780,"_2933":56887},[],"See PKI diagnostics to narrow an issuance failure.",{"_3450":2518,"_30100":2469,"_20891":56889,"_5":14349,"_27386":56783,"_2933":56890},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3450":2519,"_30100":2469,"_20891":56892,"_5":14349,"_27386":56783,"_2933":56893},[],"Manage certificates for inspection, status and revocation.",{"_3450":2520,"_30100":2469,"_20891":56895,"_5":14349,"_27386":56783,"_2933":56896},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3450":2521,"_30100":2469,"_20891":56898,"_5":14349,"_27386":56783,"_2933":56899},[],"Prepare EST for the device to request its next identities.",{"_3450":2522,"_30100":2469,"_20891":56901,"_5":14349,"_27386":56783,"_2933":56902},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3450":2523,"_30100":2523,"_5":14701,"_2933":56904,"_30453":56905,"_20891":56906,"_27386":2523},"PKI getting started",[49052,50520,54528,53965],[],{"_3450":2524,"_30100":2523,"_20891":56908,"_5":14349,"_27386":2523,"_2933":56909},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3450":2525,"_30100":2523,"_5":30450,"_20891":56911,"_27386":56912,"_2933":49062},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#before-you-begin",{"_3450":2526,"_30100":2523,"_5":30450,"_20891":56914,"_27386":56915,"_2933":56916},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3450":2527,"_30100":2523,"_5":30450,"_20891":56918,"_27386":56919,"_2933":54157},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#expected-result",{"_3450":2528,"_30100":2523,"_5":30450,"_20891":56921,"_27386":56922,"_2933":56923},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3450":2529,"_30100":2523,"_20891":56925,"_5":14349,"_27386":2523,"_2933":56926},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3450":2530,"_30100":2523,"_20891":56928,"_5":14349,"_27386":56912,"_2933":56929},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3450":2531,"_30100":2523,"_20891":56931,"_5":14349,"_27386":56912,"_2933":56932},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3450":2532,"_30100":2523,"_20891":56934,"_5":14349,"_27386":56912,"_2933":56935},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3450":2533,"_30100":2523,"_20891":56937,"_5":14349,"_27386":56912,"_2933":56938},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3450":2534,"_30100":2523,"_20891":56940,"_5":14349,"_27386":56912,"_2933":56941},[],"A working directory with restricted access for the downloaded key.",{"_3450":2535,"_30100":2523,"_20891":56943,"_5":14349,"_27386":56915,"_2933":56944},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3450":2536,"_30100":2523,"_20891":56946,"_5":14349,"_27386":56915,"_2933":56947},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3450":2537,"_30100":2523,"_20891":56949,"_5":14349,"_27386":56915,"_2933":56950},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3450":2538,"_30100":2523,"_20891":56952,"_5":14349,"_27386":56915,"_2933":56953},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3450":2539,"_30100":2523,"_20891":56955,"_5":14349,"_27386":56919,"_2933":56956},[],"File or resource",{"_3450":2540,"_30100":2523,"_20891":56958,"_5":14349,"_27386":56919,"_2933":54154},[],{"_3450":2541,"_30100":2523,"_20891":56960,"_5":14349,"_27386":56919,"_2933":56961},[],"Active root CA and `ca.pem`",{"_3450":2542,"_30100":2523,"_20891":56963,"_5":14349,"_27386":56919,"_2933":56964},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3450":2543,"_30100":2523,"_20891":56966,"_5":14349,"_27386":56919,"_2933":56967},[],"End-entity certificate and `device.crt`",{"_3450":2544,"_30100":2523,"_20891":56969,"_5":14349,"_27386":56919,"_2933":56970},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3450":2545,"_30100":2523,"_20891":56972,"_5":14349,"_27386":56919,"_2933":56973},[],"Private key `device.key`",{"_3450":2546,"_30100":2523,"_20891":56975,"_5":14349,"_27386":56919,"_2933":56976},[],"Its public key matches the one included in `device.crt`.",{"_3450":2547,"_30100":2523,"_20891":56978,"_5":14349,"_27386":56919,"_2933":56979},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3450":2548,"_30100":2523,"_20891":56981,"_5":14349,"_27386":56922,"_2933":56982},[],"To operate certificates, continue with Certificates and Validation.",{"_3450":2549,"_30100":2523,"_20891":56984,"_5":14349,"_27386":56922,"_2933":56985},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3450":2550,"_30100":2523,"_20891":56987,"_5":14349,"_27386":56922,"_2933":56988},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3450":2551,"_30100":2551,"_5":14701,"_2933":56990,"_30453":56991,"_20891":56992,"_27386":2551},"PKI troubleshooting",[49052,50520,54528,53103],[],{"_3450":2552,"_30100":2551,"_20891":56994,"_5":14349,"_27386":2551,"_2933":56995},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3450":2553,"_30100":2551,"_5":30450,"_20891":56997,"_27386":56998,"_2933":56999},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3450":2554,"_30100":2551,"_5":30450,"_20891":57001,"_27386":57002,"_2933":57003},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3450":2555,"_30100":2551,"_5":30450,"_20891":57005,"_27386":57006,"_2933":57007},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3450":2556,"_30100":2551,"_20891":57009,"_5":14349,"_27386":2551,"_2933":57010},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3450":2557,"_30100":2551,"_20891":57012,"_5":14349,"_27386":2551,"_2933":57013},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3450":2558,"_30100":2551,"_20891":57015,"_5":14349,"_27386":56998,"_2933":54154},[],{"_3450":2559,"_30100":2551,"_20891":57017,"_5":14349,"_27386":56998,"_2933":57018},[],"What to inspect",{"_3450":2560,"_30100":2551,"_20891":57020,"_5":14349,"_27386":56998,"_2933":49086},[],{"_3450":2561,"_30100":2551,"_20891":57022,"_5":14349,"_27386":56998,"_2933":53370},[],{"_3450":2562,"_30100":2551,"_20891":57024,"_5":14349,"_27386":56998,"_2933":57025},[],"Exists, is active and has usable dates.",{"_3450":2563,"_30100":2551,"_20891":57027,"_5":14349,"_27386":56998,"_2933":57028},[],"Authorities.",{"_3450":2564,"_30100":2551,"_20891":57030,"_5":14349,"_27386":56998,"_2933":57031},[],"Key",{"_3450":2565,"_30100":2551,"_20891":57033,"_5":14349,"_27386":56998,"_2933":57034},[],"The record has a usable private key and the engine can sign.",{"_3450":2566,"_30100":2551,"_20891":57036,"_5":14349,"_27386":56998,"_2933":57037},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3450":2567,"_30100":2551,"_20891":57039,"_5":14349,"_27386":56998,"_2933":57040},[],"CSR",{"_3450":2568,"_30100":2551,"_20891":57042,"_5":14349,"_27386":56998,"_2933":57043},[],"Correct PEM and verifiable signature.",{"_3450":2569,"_30100":2551,"_20891":57045,"_5":14349,"_27386":56998,"_2933":57046},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3450":2570,"_30100":2551,"_20891":57048,"_5":14349,"_27386":56998,"_2933":57049},[],"Profile",{"_3450":2571,"_30100":2551,"_20891":57051,"_5":14349,"_27386":56998,"_2933":57052},[],"Selected source, existing ID, allowed algorithm and size.",{"_3450":2572,"_30100":2551,"_20891":57054,"_5":14349,"_27386":56998,"_2933":57055},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3450":2573,"_30100":2551,"_20891":57057,"_5":14349,"_27386":56998,"_2933":54306},[],{"_3450":2574,"_30100":2551,"_20891":57059,"_5":14349,"_27386":56998,"_2933":57060},[],"Appropriate subject, SAN, usages and dates.",{"_3450":2575,"_30100":2551,"_20891":57062,"_5":14349,"_27386":56998,"_2933":57063},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3450":2576,"_30100":2551,"_20891":57065,"_5":14349,"_27386":56998,"_2933":57066},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3450":2577,"_30100":2551,"_20891":57068,"_5":14349,"_27386":56998,"_2933":57069},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3450":2578,"_30100":2551,"_20891":57071,"_5":14349,"_27386":57002,"_2933":57072},[],"Check each boundary independently:",{"_3450":2579,"_30100":2551,"_20891":57074,"_5":14349,"_27386":57002,"_2933":57075},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3450":2580,"_30100":2551,"_20891":57077,"_5":14349,"_27386":57002,"_2933":57078},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3450":2581,"_30100":2551,"_20891":57080,"_5":14349,"_27386":57002,"_2933":57081},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3450":2582,"_30100":2551,"_20891":57083,"_5":14349,"_27386":57002,"_2933":57084},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3450":2583,"_30100":2551,"_20891":57086,"_5":14349,"_27386":57002,"_2933":57087},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3450":2584,"_30100":2551,"_20891":57089,"_5":14349,"_27386":57002,"_2933":57090},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3450":2585,"_30100":2551,"_20891":57092,"_5":14349,"_27386":57006,"_2933":57093},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3450":2586,"_30100":2551,"_20891":57095,"_5":14349,"_27386":57006,"_2933":57096},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3450":2587,"_30100":2587,"_5":14701,"_2933":57098,"_30453":57099,"_20891":57100,"_27386":2587},"Security",[49052],[],{"_3450":2588,"_30100":2587,"_20891":57102,"_5":14349,"_27386":2587,"_2933":57103},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3450":2589,"_30100":2587,"_5":30450,"_20891":57105,"_27386":57106,"_2933":57107},[],"/docs/pr-preview/pr-61/security#report-a-vulnerability","Report a vulnerability",{"_3450":2590,"_30100":2587,"_5":30450,"_20891":57109,"_27386":57110,"_2933":57111},[],"/docs/pr-preview/pr-61/security#what-to-include-in-a-report","What to include in a report",{"_3450":2591,"_30100":2587,"_5":30450,"_20891":57113,"_27386":57114,"_2933":57115},[],"/docs/pr-preview/pr-61/security#supported-versions","Supported versions",{"_3450":2592,"_30100":2587,"_5":30450,"_20891":57117,"_27386":57118,"_2933":57119},[],"/docs/pr-preview/pr-61/security#responsible-disclosure","Responsible disclosure",{"_3450":2593,"_30100":2587,"_20891":57121,"_5":14349,"_27386":2587,"_2933":57122},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3450":2594,"_30100":2587,"_20891":57124,"_5":14349,"_27386":57106,"_2933":57125},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3450":2595,"_30100":2587,"_20891":57127,"_5":14349,"_27386":57106,"_2933":57128},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3450":2596,"_30100":2587,"_20891":57130,"_5":14349,"_27386":57106,"_2933":14974},[],{"_3450":2597,"_30100":2587,"_20891":57132,"_5":14349,"_27386":57106,"_2933":14914},[],{"_3450":2598,"_30100":2587,"_20891":57134,"_5":14349,"_27386":57106,"_2933":14961},[],{"_3450":2599,"_30100":2587,"_20891":57136,"_5":14349,"_27386":57106,"_2933":57137},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3450":2600,"_30100":2587,"_20891":57139,"_5":14349,"_27386":57106,"_2933":57140},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3450":2601,"_30100":2587,"_20891":57142,"_5":14349,"_27386":57110,"_2933":57143},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3450":2602,"_30100":2587,"_20891":57145,"_5":14349,"_27386":57110,"_2933":57146},[],"Do not include in the report:",{"_3450":2603,"_30100":2587,"_20891":57148,"_5":14349,"_27386":57110,"_2933":57149},[],"Credentials, tokens, or private keys",{"_3450":2604,"_30100":2587,"_20891":57151,"_5":14349,"_27386":57110,"_2933":57152},[],"Customer data or customer-identifiable information",{"_3450":2605,"_30100":2587,"_20891":57154,"_5":14349,"_27386":57110,"_2933":57155},[],"Confidential architecture or internal infrastructure details",{"_3450":2606,"_30100":2587,"_20891":57157,"_5":14349,"_27386":57114,"_2933":57158},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3450":2607,"_30100":2587,"_20891":57160,"_5":14349,"_27386":57114,"_2933":57161},[],"For upgrade guidance, see Upgrades.",{"_3450":2608,"_30100":2587,"_20891":57163,"_5":14349,"_27386":57118,"_2933":57164},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3450":2609,"_30100":2587,"_20891":57166,"_5":14349,"_27386":57118,"_2933":57167},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3450":2610,"_30100":2587,"_20891":57169,"_5":14349,"_27386":57118,"_2933":57170},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3450":2611,"_30100":2587,"_20891":57172,"_5":14349,"_27386":57118,"_2933":57173},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3450":2612,"_30100":2587,"_20891":57175,"_5":14349,"_27386":57118,"_2933":57176},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3450":2613,"_30100":2613,"_5":14701,"_2933":57178,"_30453":57179,"_20891":57181,"_27386":2613},"3.8.0 to 4.0.0",[49052,57180],"Upgrades",[],{"_3450":2614,"_30100":2613,"_20891":57183,"_5":14349,"_27386":2613,"_2933":57184},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3450":2615,"_30100":2613,"_5":30450,"_20891":57186,"_27386":57187,"_2933":57188},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3450":2616,"_30100":2613,"_5":30450,"_20891":57190,"_27386":57191,"_2933":57192},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3450":2617,"_30100":2613,"_5":30450,"_20891":57194,"_27386":57195,"_2933":57196},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3450":2618,"_30100":2613,"_5":30450,"_20891":57198,"_27386":57199,"_2933":57200},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3450":2619,"_30100":2613,"_5":30450,"_20891":57202,"_27386":57203,"_2933":57204},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3450":2620,"_30100":2613,"_5":30450,"_20891":57206,"_27386":57207,"_2933":57208},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3450":2621,"_30100":2613,"_5":30450,"_20891":57210,"_27386":57211,"_2933":57212},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3450":2622,"_30100":2613,"_5":30450,"_20891":57214,"_27386":57215,"_2933":57216},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3450":2623,"_30100":2613,"_5":30450,"_20891":57218,"_27386":57219,"_2933":57220},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3450":2624,"_30100":2613,"_5":30450,"_20891":57222,"_27386":57223,"_2933":57224},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3450":2625,"_30100":2613,"_5":30450,"_20891":57226,"_27386":57227,"_2933":57228},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3450":2626,"_30100":2613,"_5":30450,"_20891":57230,"_27386":57231,"_2933":57232},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3450":2627,"_30100":2613,"_5":30450,"_20891":57234,"_27386":57235,"_2933":57236},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3450":2628,"_30100":2613,"_5":30450,"_20891":57238,"_27386":57239,"_2933":57240},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3450":2629,"_30100":2613,"_5":30450,"_20891":57242,"_27386":57243,"_2933":57244},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3450":2630,"_30100":2613,"_5":30450,"_20891":57246,"_27386":57247,"_2933":57248},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3450":2631,"_30100":2613,"_5":30450,"_20891":57250,"_27386":57251,"_2933":57252},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3450":2632,"_30100":2613,"_5":30450,"_20891":57254,"_27386":57255,"_2933":57256},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3450":2633,"_30100":2613,"_5":30450,"_20891":57258,"_27386":57259,"_2933":57260},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3450":2634,"_30100":2613,"_5":30450,"_20891":57262,"_27386":57263,"_2933":57264},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3450":2635,"_30100":2613,"_5":30450,"_20891":57266,"_27386":57267,"_2933":57268},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3450":2636,"_30100":2613,"_5":30450,"_20891":57270,"_27386":57271,"_2933":57272},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3450":2637,"_30100":2613,"_5":30450,"_20891":57274,"_27386":57275,"_2933":57276},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3450":2638,"_30100":2613,"_5":30450,"_20891":57278,"_27386":57279,"_2933":57280},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3450":2639,"_30100":2613,"_5":30450,"_20891":57282,"_27386":57283,"_2933":57284},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3450":2640,"_30100":2613,"_5":30450,"_20891":57286,"_27386":57287,"_2933":57288},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3450":2641,"_30100":2613,"_5":30450,"_20891":57290,"_27386":57291,"_2933":57292},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3450":2642,"_30100":2613,"_5":30450,"_20891":57294,"_27386":57295,"_2933":57296},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3450":2643,"_30100":2613,"_5":30450,"_20891":57298,"_27386":57299,"_2933":57300},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3450":2644,"_30100":2613,"_5":30450,"_20891":57302,"_27386":57303,"_2933":57304},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3450":2645,"_30100":2613,"_5":30450,"_20891":57306,"_27386":57307,"_2933":57308},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3450":2646,"_30100":2613,"_5":30450,"_20891":57310,"_27386":57311,"_2933":57312},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3450":2647,"_30100":2613,"_5":30450,"_20891":57314,"_27386":57315,"_2933":57316},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3450":2648,"_30100":2613,"_5":30450,"_20891":57318,"_27386":57319,"_2933":57320},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3450":2649,"_30100":2613,"_5":30450,"_20891":57322,"_27386":57323,"_2933":57324},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3450":2650,"_30100":2613,"_5":30450,"_20891":57326,"_27386":57327,"_2933":57328},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3450":2651,"_30100":2613,"_5":30450,"_20891":57330,"_27386":57331,"_2933":57332},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3450":2652,"_30100":2613,"_5":30450,"_20891":57334,"_27386":57335,"_2933":57336},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3450":2653,"_30100":2613,"_5":30450,"_20891":57338,"_27386":57339,"_2933":57340},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3450":2654,"_30100":2613,"_5":30450,"_20891":57342,"_27386":57343,"_2933":57344},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3450":2655,"_30100":2613,"_5":30450,"_20891":57346,"_27386":57347,"_2933":53103},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3450":2656,"_30100":2613,"_5":30450,"_20891":57349,"_27386":57350,"_2933":57351},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3450":2657,"_30100":2613,"_5":30450,"_20891":57353,"_27386":57354,"_2933":57355},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3450":2658,"_30100":2613,"_20891":57357,"_5":14349,"_27386":2613,"_2933":57358},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3450":2659,"_30100":2613,"_20891":57360,"_5":14349,"_27386":2613,"_2933":57361},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3450":2660,"_30100":2613,"_20891":57363,"_5":14349,"_27386":2613,"_2933":57364},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3450":2661,"_30100":2613,"_20891":57366,"_5":14349,"_27386":2613,"_2933":57367},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3450":2662,"_30100":2613,"_20891":57369,"_5":14349,"_27386":2613,"_2933":57370},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3450":2663,"_30100":2613,"_20891":57372,"_5":14349,"_27386":2613,"_2933":57373},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3450":2664,"_30100":2613,"_20891":57375,"_5":14349,"_27386":2613,"_2933":57376},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3450":2665,"_30100":2613,"_20891":57378,"_5":14349,"_27386":57191,"_2933":57379},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3450":2666,"_30100":2613,"_20891":57381,"_5":14349,"_27386":57191,"_2933":57382},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3450":2667,"_30100":2613,"_20891":57384,"_5":14349,"_27386":57195,"_2933":57385},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3450":2668,"_30100":2613,"_20891":57387,"_5":14349,"_27386":57195,"_2933":57388},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3450":2669,"_30100":2613,"_20891":57390,"_5":14349,"_27386":57199,"_2933":57391},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3450":2670,"_30100":2613,"_20891":57393,"_5":14349,"_27386":57203,"_2933":57394},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3450":2671,"_30100":2613,"_20891":57396,"_5":14349,"_27386":57203,"_2933":57397},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3450":2672,"_30100":2613,"_20891":57399,"_5":14349,"_27386":57203,"_2933":57400},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3450":2673,"_30100":2613,"_20891":57402,"_5":14349,"_27386":57203,"_2933":57403},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3450":2674,"_30100":2613,"_20891":57405,"_5":14349,"_27386":57203,"_2933":57406},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3450":2675,"_30100":2613,"_20891":57408,"_5":14349,"_27386":57207,"_2933":57409},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3450":2676,"_30100":2613,"_20891":57411,"_5":14349,"_27386":57207,"_2933":57412},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3450":2677,"_30100":2613,"_20891":57414,"_5":14349,"_27386":57207,"_2933":57415},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3450":2678,"_30100":2613,"_20891":57417,"_5":14349,"_27386":57207,"_2933":57418},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3450":2679,"_30100":2613,"_20891":57420,"_5":14349,"_27386":57207,"_2933":57421},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3450":2680,"_30100":2613,"_20891":57423,"_5":14349,"_27386":57207,"_2933":57424},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3450":2681,"_30100":2613,"_20891":57426,"_5":14349,"_27386":57211,"_2933":57427},[],"Change",{"_3450":2682,"_30100":2613,"_20891":57429,"_5":14349,"_27386":57211,"_2933":57430},[],"Who is affected",{"_3450":2683,"_30100":2613,"_20891":57432,"_5":14349,"_27386":57211,"_2933":57433},[],"Severity",{"_3450":2684,"_30100":2613,"_20891":57435,"_5":14349,"_27386":57211,"_2933":55955},[],{"_3450":2685,"_30100":2613,"_20891":57437,"_5":14349,"_27386":57211,"_2933":57220},[],{"_3450":2686,"_30100":2613,"_20891":57439,"_5":14349,"_27386":57211,"_2933":57440},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3450":2687,"_30100":2613,"_20891":57442,"_5":14349,"_27386":57211,"_2933":57443},[],"High: KMS and VA start on empty volumes",{"_3450":2688,"_30100":2613,"_20891":57445,"_5":14349,"_27386":57211,"_2933":57446},[],"Copy the data into the new volumes",{"_3450":2689,"_30100":2613,"_20891":57448,"_5":14349,"_27386":57211,"_2933":57224},[],{"_3450":2690,"_30100":2613,"_20891":57450,"_5":14349,"_27386":57211,"_2933":57451},[],"Every Helm release",{"_3450":2691,"_30100":2613,"_20891":57453,"_5":14349,"_27386":57211,"_2933":57454},[],"High: `helm upgrade` fails",{"_3450":2692,"_30100":2613,"_20891":57456,"_5":14349,"_27386":57211,"_2933":57457},[],"Remove or rename legacy keys",{"_3450":2693,"_30100":2613,"_20891":57459,"_5":14349,"_27386":57211,"_2933":57228},[],{"_3450":2694,"_30100":2613,"_20891":57461,"_5":14349,"_27386":57211,"_2933":57462},[],"Every deployment",{"_3450":2695,"_30100":2613,"_20891":57464,"_5":14349,"_27386":57211,"_2933":57465},[],"High: without a bootstrap principal there is no administrator",{"_3450":2696,"_30100":2613,"_20891":57467,"_5":14349,"_27386":57211,"_2933":57468},[],"Configure `services.authz`",{"_3450":2697,"_30100":2613,"_20891":57470,"_5":14349,"_27386":57211,"_2933":57232},[],{"_3450":2698,"_30100":2613,"_20891":57472,"_5":14349,"_27386":57211,"_2933":57451},[],{"_3450":2699,"_30100":2613,"_20891":57474,"_5":14349,"_27386":57211,"_2933":57475},[],"High: `helm upgrade` fails on the old keys",{"_3450":2700,"_30100":2613,"_20891":57477,"_5":14349,"_27386":57211,"_2933":57478},[],"Move JWKS and roles into `services.authz`",{"_3450":2701,"_30100":2613,"_20891":57480,"_5":14349,"_27386":57211,"_2933":57252},[],{"_3450":2702,"_30100":2613,"_20891":57482,"_5":14349,"_27386":57211,"_2933":57483},[],"3.8.0 deployments with per-service databases",{"_3450":2703,"_30100":2613,"_20891":57485,"_5":14349,"_27386":57211,"_2933":57486},[],"High: services find no data, or a migration aborts",{"_3450":2704,"_30100":2613,"_20891":57488,"_5":14349,"_27386":57211,"_2933":57489},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3450":2705,"_30100":2613,"_20891":57491,"_5":14349,"_27386":57211,"_2933":57256},[],{"_3450":2706,"_30100":2613,"_20891":57493,"_5":14349,"_27386":57211,"_2933":57494},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3450":2707,"_30100":2613,"_20891":57496,"_5":14349,"_27386":57211,"_2933":57497},[],"High: the backend no longer starts with them",{"_3450":2708,"_30100":2613,"_20891":57499,"_5":14349,"_27386":57211,"_2933":57500},[],"Move to PostgreSQL before upgrading",{"_3450":2709,"_30100":2613,"_20891":57502,"_5":14349,"_27386":57211,"_2933":57300},[],{"_3450":2710,"_30100":2613,"_20891":57504,"_5":14349,"_27386":57211,"_2933":57505},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3450":2711,"_30100":2613,"_20891":57507,"_5":14349,"_27386":57211,"_2933":57508},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3450":2712,"_30100":2613,"_20891":57510,"_5":14349,"_27386":57211,"_2933":57511},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3450":2713,"_30100":2613,"_20891":57513,"_5":14349,"_27386":57211,"_2933":57514},[],"Webhooks with file references",{"_3450":2714,"_30100":2613,"_20891":57516,"_5":14349,"_27386":57211,"_2933":57517},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3450":2715,"_30100":2613,"_20891":57519,"_5":14349,"_27386":57211,"_2933":57520},[],"High: enrollments calling the webhook fail",{"_3450":2716,"_30100":2613,"_20891":57522,"_5":14349,"_27386":57211,"_2933":57523},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3450":2717,"_30100":2613,"_20891":57525,"_5":14349,"_27386":57211,"_2933":57236},[],{"_3450":2718,"_30100":2613,"_20891":57527,"_5":14349,"_27386":57211,"_2933":57528},[],"Releases with per-service identity overrides or mounted key material",{"_3450":2719,"_30100":2613,"_20891":57530,"_5":14349,"_27386":57211,"_2933":57531},[],"Medium: services cannot read their files",{"_3450":2720,"_30100":2613,"_20891":57533,"_5":14349,"_27386":57211,"_2933":57534},[],"Remove the overrides and fix volume ownership",{"_3450":2721,"_30100":2613,"_20891":57536,"_5":14349,"_27386":57211,"_2933":57240},[],{"_3450":2722,"_30100":2613,"_20891":57538,"_5":14349,"_27386":57211,"_2933":57539},[],"Releases that set `amqp.tls`",{"_3450":2723,"_30100":2613,"_20891":57541,"_5":14349,"_27386":57211,"_2933":57542},[],"Medium: clients connect to the wrong port",{"_3450":2724,"_30100":2613,"_20891":57544,"_5":14349,"_27386":57211,"_2933":57545},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3450":2725,"_30100":2613,"_20891":57547,"_5":14349,"_27386":57211,"_2933":57260},[],{"_3450":2726,"_30100":2613,"_20891":57549,"_5":14349,"_27386":57211,"_2933":57550},[],"Installations whose CA keys predate the KMS",{"_3450":2727,"_30100":2613,"_20891":57552,"_5":14349,"_27386":57211,"_2933":57553},[],"Medium: CA keys stay unmanaged",{"_3450":2728,"_30100":2613,"_20891":57555,"_5":14349,"_27386":57211,"_2933":57556},[],"Run the CA-to-KMS migration",{"_3450":2729,"_30100":2613,"_20891":57558,"_5":14349,"_27386":57211,"_2933":57559},[],"Receiver certificate verification",{"_3450":2730,"_30100":2613,"_20891":57561,"_5":14349,"_27386":57211,"_2933":57562},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3450":2731,"_30100":2613,"_20891":57564,"_5":14349,"_27386":57211,"_2933":57565},[],"Medium: credentials go to an unverified receiver",{"_3450":2732,"_30100":2613,"_20891":57567,"_5":14349,"_27386":57211,"_2933":57568},[],"Set `insecure_skip_verify` to `false`",{"_3450":2733,"_30100":2613,"_20891":57570,"_5":14349,"_27386":57211,"_2933":57276},[],{"_3450":2734,"_30100":2613,"_20891":57572,"_5":14349,"_27386":57211,"_2933":57573},[],"Scripts and consoles that edit DMSs through the API",{"_3450":2735,"_30100":2613,"_20891":57575,"_5":14349,"_27386":57211,"_2933":57576},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3450":2736,"_30100":2613,"_20891":57578,"_5":14349,"_27386":57211,"_2933":57579},[],"Read the DMS before editing and use the new field",{"_3450":2737,"_30100":2613,"_20891":57581,"_5":14349,"_27386":57211,"_2933":57296},[],{"_3450":2738,"_30100":2613,"_20891":57583,"_5":14349,"_27386":57211,"_2933":57584},[],"Clients that create or update CRL settings through the API",{"_3450":2739,"_30100":2613,"_20891":57586,"_5":14349,"_27386":57211,"_2933":57587},[],"Medium: requests with the old field return an error",{"_3450":2740,"_30100":2613,"_20891":57589,"_5":14349,"_27386":57211,"_2933":57590},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3450":2741,"_30100":2613,"_20891":57592,"_5":14349,"_27386":57211,"_2933":57304},[],{"_3450":2742,"_30100":2613,"_20891":57594,"_5":14349,"_27386":57211,"_2933":57595},[],"Alert subscriptions and consumers of the VA events",{"_3450":2743,"_30100":2613,"_20891":57597,"_5":14349,"_27386":57211,"_2933":57598},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3450":2744,"_30100":2613,"_20891":57600,"_5":14349,"_27386":57211,"_2933":57601},[],"Review conditions filtering on the old event payload or subject",{"_3450":2745,"_30100":2613,"_20891":57603,"_5":14349,"_27386":57211,"_2933":57292},[],{"_3450":2746,"_30100":2613,"_20891":57605,"_5":14349,"_27386":57211,"_2933":57606},[],"Consumers that read the device `events` field",{"_3450":2747,"_30100":2613,"_20891":57608,"_5":14349,"_27386":57211,"_2933":57609},[],"Medium: the field disappears",{"_3450":2748,"_30100":2613,"_20891":57611,"_5":14349,"_27386":57211,"_2933":57612},[],"Use the new event endpoints",{"_3450":2749,"_30100":2613,"_20891":57614,"_5":14349,"_27386":57211,"_2933":57312},[],{"_3450":2750,"_30100":2613,"_20891":57616,"_5":14349,"_27386":57211,"_2933":57617},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3450":2751,"_30100":2613,"_20891":57619,"_5":14349,"_27386":57211,"_2933":57620},[],"Medium: the VA migration aborts",{"_3450":2752,"_30100":2613,"_20891":57622,"_5":14349,"_27386":57211,"_2933":57623},[],"Fix the affected roles before upgrading",{"_3450":2753,"_30100":2613,"_20891":57625,"_5":14349,"_27386":57211,"_2933":57244},[],{"_3450":2754,"_30100":2613,"_20891":57627,"_5":14349,"_27386":57211,"_2933":57628},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3450":2755,"_30100":2613,"_20891":57630,"_5":14349,"_27386":57211,"_2933":57631},[],"Low to medium: validation errors or changed defaults",{"_3450":2756,"_30100":2613,"_20891":57633,"_5":14349,"_27386":57211,"_2933":57634},[],"Update the values file",{"_3450":2757,"_30100":2613,"_20891":57636,"_5":14349,"_27386":57211,"_2933":57284},[],{"_3450":2758,"_30100":2613,"_20891":57638,"_5":14349,"_27386":57211,"_2933":57639},[],"Clients that send the DMS ID in the update body",{"_3450":2759,"_30100":2613,"_20891":57641,"_5":14349,"_27386":57211,"_2933":57642},[],"Low: the ID in the URL wins",{"_3450":2760,"_30100":2613,"_20891":57644,"_5":14349,"_27386":57211,"_2933":57645},[],"Send the ID in the URL",{"_3450":2761,"_30100":2613,"_20891":57647,"_5":14349,"_27386":57211,"_2933":57308},[],{"_3450":2762,"_30100":2613,"_20891":57649,"_5":14349,"_27386":57211,"_2933":57650},[],"Clients that send an `id` when creating or importing CAs",{"_3450":2763,"_30100":2613,"_20891":57652,"_5":14349,"_27386":57211,"_2933":57653},[],"Low: the ID in the body is ignored, and the field is removed",{"_3450":2764,"_30100":2613,"_20891":57655,"_5":14349,"_27386":57211,"_2933":57656},[],"Let the backend assign the ID and use the returned one",{"_3450":2765,"_30100":2613,"_20891":57658,"_5":14349,"_27386":57211,"_2933":57288},[],{"_3450":2766,"_30100":2613,"_20891":57660,"_5":14349,"_27386":57211,"_2933":57661},[],"Consumers that match on certificate `type`",{"_3450":2767,"_30100":2613,"_20891":57663,"_5":14349,"_27386":57211,"_2933":57664},[],"Low: two values are renamed",{"_3450":2768,"_30100":2613,"_20891":57666,"_5":14349,"_27386":57211,"_2933":57667},[],"Adapt consumers",{"_3450":2769,"_30100":2613,"_20891":57669,"_5":14349,"_27386":57211,"_2933":57280},[],{"_3450":2770,"_30100":2613,"_20891":57671,"_5":14349,"_27386":57211,"_2933":57672},[],"Any DMS",{"_3450":2771,"_30100":2613,"_20891":57674,"_5":14349,"_27386":57211,"_2933":57675},[],"Low: informational",{"_3450":2772,"_30100":2613,"_20891":57677,"_5":14349,"_27386":57211,"_2933":57678},[],"Read both blocks before editing",{"_3450":2773,"_30100":2613,"_20891":57680,"_5":14349,"_27386":57219,"_2933":57681},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3450":2774,"_30100":2613,"_20891":57683,"_5":14349,"_27386":57219,"_2933":57684},[],"Step 4 of the migration guide copies the data.",{"_3450":2775,"_30100":2613,"_20891":57686,"_5":14349,"_27386":57223,"_2933":57687},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3450":2776,"_30100":2613,"_20891":57689,"_5":14349,"_27386":57227,"_2933":57690},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3450":2777,"_30100":2613,"_20891":57692,"_5":14349,"_27386":57231,"_2933":57693},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3450":2778,"_30100":2613,"_20891":57695,"_5":14349,"_27386":57235,"_2933":57696},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3450":2779,"_30100":2613,"_20891":57698,"_5":14349,"_27386":57235,"_2933":57699},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3450":2780,"_30100":2613,"_20891":57701,"_5":14349,"_27386":57239,"_2933":57702},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3450":2781,"_30100":2613,"_20891":57704,"_5":14349,"_27386":57243,"_2933":57705},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3450":2782,"_30100":2613,"_20891":57707,"_5":14349,"_27386":57243,"_2933":57708},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3450":2783,"_30100":2613,"_20891":57710,"_5":14349,"_27386":57243,"_2933":57711},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3450":2784,"_30100":2613,"_20891":57713,"_5":14349,"_27386":57243,"_2933":57714},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3450":2785,"_30100":2613,"_20891":57716,"_5":14349,"_27386":57243,"_2933":57717},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3450":2786,"_30100":2613,"_20891":57719,"_5":14349,"_27386":57243,"_2933":57720},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3450":2787,"_30100":2613,"_20891":57722,"_5":14349,"_27386":57251,"_2933":57723},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3450":2788,"_30100":2613,"_20891":57725,"_5":14349,"_27386":57251,"_2933":57726},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3450":2789,"_30100":2613,"_20891":57728,"_5":14349,"_27386":57251,"_2933":57729},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3450":2790,"_30100":2613,"_20891":57731,"_5":14349,"_27386":57251,"_2933":57732},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3450":2791,"_30100":2613,"_20891":57734,"_5":14349,"_27386":57251,"_2933":57735},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3450":2792,"_30100":2613,"_20891":57737,"_5":14349,"_27386":57255,"_2933":57738},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3450":2793,"_30100":2613,"_20891":57740,"_5":14349,"_27386":57259,"_2933":57741},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3450":2794,"_30100":2613,"_20891":57743,"_5":14349,"_27386":57259,"_2933":57744},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3450":2795,"_30100":2613,"_20891":57746,"_5":14349,"_27386":57259,"_2933":57747},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3450":2796,"_30100":2613,"_20891":57749,"_5":14349,"_27386":57259,"_2933":57750},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3450":2797,"_30100":2613,"_20891":57752,"_5":14349,"_27386":57259,"_2933":57753},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3450":2798,"_30100":2613,"_20891":57755,"_5":14349,"_27386":57259,"_2933":57756},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3450":2799,"_30100":2613,"_20891":57758,"_5":14349,"_27386":57259,"_2933":57759},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3450":2800,"_30100":2613,"_20891":57761,"_5":14349,"_27386":57259,"_2933":57762},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3450":2801,"_30100":2613,"_20891":57764,"_5":14349,"_27386":57263,"_2933":57765},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3450":2802,"_30100":2613,"_20891":57767,"_5":14349,"_27386":57271,"_2933":57768},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3450":2803,"_30100":2613,"_20891":57770,"_5":14349,"_27386":57271,"_2933":57771},[],"Field in 3.8.0",{"_3450":2804,"_30100":2613,"_20891":57773,"_5":14349,"_27386":57271,"_2933":57774},[],"Field in 4.0.0",{"_3450":2805,"_30100":2613,"_20891":57776,"_5":14349,"_27386":57271,"_2933":57777},[],"`validate_server_cert`",{"_3450":2806,"_30100":2613,"_20891":57779,"_5":14349,"_27386":57271,"_2933":57780},[],"`insecure_skip_verify` (value negated)",{"_3450":2807,"_30100":2613,"_20891":57782,"_5":14349,"_27386":57271,"_2933":57783},[],"`oidc`",{"_3450":2808,"_30100":2613,"_20891":57785,"_5":14349,"_27386":57271,"_2933":57786},[],"`jwt_options`",{"_3450":2809,"_30100":2613,"_20891":57788,"_5":14349,"_27386":57271,"_2933":57789},[],"`apikey`",{"_3450":2810,"_30100":2613,"_20891":57791,"_5":14349,"_27386":57271,"_2933":57792},[],"`apikey_options`",{"_3450":2811,"_30100":2613,"_20891":57794,"_5":14349,"_27386":57271,"_2933":57795},[],"`mtls`",{"_3450":2812,"_30100":2613,"_20891":57797,"_5":14349,"_27386":57271,"_2933":57798},[],"`mtls_options`",{"_3450":2813,"_30100":2613,"_20891":57800,"_5":14349,"_27386":57271,"_2933":57801},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3450":2814,"_30100":2613,"_20891":57803,"_5":14349,"_27386":57271,"_2933":57804},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3450":2815,"_30100":2613,"_20891":57806,"_5":14349,"_27386":57271,"_2933":57807},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3450":2816,"_30100":2613,"_20891":57809,"_5":14349,"_27386":57275,"_2933":57810},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3450":2817,"_30100":2613,"_20891":57812,"_5":14349,"_27386":57275,"_2933":57813},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3450":2818,"_30100":2613,"_20891":57815,"_5":14349,"_27386":57275,"_2933":57816},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3450":2819,"_30100":2613,"_20891":57818,"_5":14349,"_27386":57279,"_2933":57819},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3450":2820,"_30100":2613,"_20891":57821,"_5":14349,"_27386":57283,"_2933":57822},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3450":2821,"_30100":2613,"_20891":57824,"_5":14349,"_27386":57287,"_2933":57825},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3450":2822,"_30100":2613,"_20891":57827,"_5":14349,"_27386":57291,"_2933":57828},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3450":2823,"_30100":2613,"_20891":57830,"_5":14349,"_27386":57291,"_2933":57831},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3450":2824,"_30100":2613,"_20891":57833,"_5":14349,"_27386":57291,"_2933":57834},[],"`POST /v1/devices/:id/events` creates an event.",{"_3450":2825,"_30100":2613,"_20891":57836,"_5":14349,"_27386":57291,"_2933":57837},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3450":2826,"_30100":2613,"_20891":57839,"_5":14349,"_27386":57295,"_2933":57840},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3450":2827,"_30100":2613,"_20891":57842,"_5":14349,"_27386":57299,"_2933":57843},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3450":2828,"_30100":2613,"_20891":57845,"_5":14349,"_27386":57299,"_2933":57846},[],"Route",{"_3450":2829,"_30100":2613,"_20891":57848,"_5":14349,"_27386":57299,"_2933":52290},[],{"_3450":2830,"_30100":2613,"_20891":57850,"_5":14349,"_27386":57299,"_2933":57851},[],"`GET /v1/crl-settings`",{"_3450":2831,"_30100":2613,"_20891":57853,"_5":14349,"_27386":57299,"_2933":57854},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3450":2832,"_30100":2613,"_20891":57856,"_5":14349,"_27386":57299,"_2933":57857},[],"`GET /v1/crl-settings/{ca-id}`",{"_3450":2833,"_30100":2613,"_20891":57859,"_5":14349,"_27386":57299,"_2933":57860},[],"Reads the settings of a CA.",{"_3450":2834,"_30100":2613,"_20891":57862,"_5":14349,"_27386":57299,"_2933":57863},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3450":2835,"_30100":2613,"_20891":57865,"_5":14349,"_27386":57299,"_2933":57866},[],"Replaces `crl_options`.",{"_3450":2836,"_30100":2613,"_20891":57868,"_5":14349,"_27386":57299,"_2933":57869},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3450":2837,"_30100":2613,"_20891":57871,"_5":14349,"_27386":57299,"_2933":57872},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3450":2838,"_30100":2613,"_20891":57874,"_5":14349,"_27386":57299,"_2933":57875},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3450":2839,"_30100":2613,"_20891":57877,"_5":14349,"_27386":57299,"_2933":57878},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3450":2840,"_30100":2613,"_20891":57880,"_5":14349,"_27386":57299,"_2933":57881},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3450":2841,"_30100":2613,"_20891":57883,"_5":14349,"_27386":57299,"_2933":57884},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3450":2842,"_30100":2613,"_20891":57886,"_5":14349,"_27386":57299,"_2933":57887},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3450":2843,"_30100":2613,"_20891":57889,"_5":14349,"_27386":57299,"_2933":57890},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3450":2844,"_30100":2613,"_20891":57892,"_5":14349,"_27386":57299,"_2933":57893},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3450":2845,"_30100":2613,"_20891":57895,"_5":14349,"_27386":57299,"_2933":57896},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3450":2846,"_30100":2613,"_20891":57898,"_5":14349,"_27386":57299,"_2933":57899},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3450":2847,"_30100":2613,"_20891":57901,"_5":14349,"_27386":57303,"_2933":57902},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3450":2848,"_30100":2613,"_20891":57904,"_5":14349,"_27386":57307,"_2933":57905},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3450":2849,"_30100":2613,"_20891":57907,"_5":14349,"_27386":57311,"_2933":57908},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3450":2850,"_30100":2613,"_20891":57910,"_5":14349,"_27386":57315,"_2933":57911},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3450":2851,"_30100":2613,"_20891":57913,"_5":14349,"_27386":57319,"_2933":57914},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3450":2852,"_30100":2613,"_20891":57916,"_5":14349,"_27386":57319,"_2933":57917},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3450":2853,"_30100":2613,"_20891":57919,"_5":14349,"_27386":57319,"_2933":57920},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3450":2854,"_30100":2613,"_20891":57922,"_5":14349,"_27386":57319,"_2933":57923},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3450":2855,"_30100":2613,"_20891":57925,"_5":14349,"_27386":57319,"_2933":57926},[],"Record the names of your local-storage PVCs:",{"_3450":2856,"_30100":2613,"_20891":57928,"_5":14349,"_27386":57319,"_2933":57929},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3450":2857,"_30100":2613,"_20891":57931,"_5":14349,"_27386":57323,"_2933":57932},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3450":2858,"_30100":2613,"_20891":57934,"_5":14349,"_27386":57323,"_2933":57935},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3450":2859,"_30100":2613,"_20891":57937,"_5":14349,"_27386":57323,"_2933":57938},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3450":2860,"_30100":2613,"_20891":57940,"_5":14349,"_27386":57323,"_2933":57941},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3450":2861,"_30100":2613,"_20891":57943,"_5":14349,"_27386":57323,"_2933":57944},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3450":2862,"_30100":2613,"_20891":57946,"_5":14349,"_27386":57327,"_2933":57947},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3450":2863,"_30100":2613,"_20891":57949,"_5":14349,"_27386":57327,"_2933":57950},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3450":2864,"_30100":2613,"_20891":57952,"_5":14349,"_27386":57327,"_2933":57953},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3450":2865,"_30100":2613,"_20891":57955,"_5":14349,"_27386":57327,"_2933":57956},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3450":2866,"_30100":2613,"_20891":57958,"_5":14349,"_27386":57327,"_2933":57959},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3450":2867,"_30100":2613,"_20891":57961,"_5":14349,"_27386":57327,"_2933":57962},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3450":2868,"_30100":2613,"_20891":57964,"_5":14349,"_27386":57327,"_2933":57965},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3450":2869,"_30100":2613,"_20891":57967,"_5":14349,"_27386":57327,"_2933":57968},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3450":2870,"_30100":2613,"_20891":57970,"_5":14349,"_27386":57327,"_2933":57971},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3450":2871,"_30100":2613,"_20891":57973,"_5":14349,"_27386":57327,"_2933":57974},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3450":2872,"_30100":2613,"_20891":57976,"_5":14349,"_27386":57327,"_2933":57977},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3450":2873,"_30100":2613,"_20891":57979,"_5":14349,"_27386":57327,"_2933":57980},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3450":2874,"_30100":2613,"_20891":57982,"_5":14349,"_27386":57331,"_2933":57983},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3450":2875,"_30100":2613,"_20891":57985,"_5":14349,"_27386":57331,"_2933":57986},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3450":2876,"_30100":2613,"_20891":57988,"_5":14349,"_27386":57335,"_2933":57989},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3450":2877,"_30100":2613,"_20891":57991,"_5":14349,"_27386":57335,"_2933":57992},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3450":2878,"_30100":2613,"_20891":57994,"_5":14349,"_27386":57335,"_2933":57995},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3450":2879,"_30100":2613,"_20891":57997,"_5":14349,"_27386":57335,"_2933":57998},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3450":2880,"_30100":2613,"_20891":58000,"_5":14349,"_27386":57335,"_2933":58001},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3450":2881,"_30100":2613,"_20891":58003,"_5":14349,"_27386":57335,"_2933":58004},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3450":2882,"_30100":2613,"_20891":58006,"_5":14349,"_27386":57335,"_2933":58007},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3450":2883,"_30100":2613,"_20891":58009,"_5":14349,"_27386":57335,"_2933":58010},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3450":2884,"_30100":2613,"_20891":58012,"_5":14349,"_27386":57335,"_2933":58013},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3450":2885,"_30100":2613,"_20891":58015,"_5":14349,"_27386":57335,"_2933":58016},[],"**Remove the helper and restore the recorded replica counts:**",{"_3450":2886,"_30100":2613,"_20891":58018,"_5":14349,"_27386":57335,"_2933":58019},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3450":2887,"_30100":2613,"_20891":58021,"_5":14349,"_27386":57339,"_2933":58022},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3450":2888,"_30100":2613,"_20891":58024,"_5":14349,"_27386":57339,"_2933":58025},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3450":2889,"_30100":2613,"_20891":58027,"_5":14349,"_27386":57343,"_2933":58028},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3450":2890,"_30100":2613,"_20891":58030,"_5":14349,"_27386":57343,"_2933":58031},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3450":2891,"_30100":2613,"_20891":58033,"_5":14349,"_27386":57343,"_2933":58034},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3450":2892,"_30100":2613,"_20891":58036,"_5":14349,"_27386":57343,"_2933":58037},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3450":2893,"_30100":2613,"_20891":58039,"_5":14349,"_27386":57343,"_2933":58040},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3450":2894,"_30100":2613,"_20891":58042,"_5":14349,"_27386":57343,"_2933":58043},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3450":2895,"_30100":2613,"_20891":58045,"_5":14349,"_27386":57343,"_2933":58046},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3450":2896,"_30100":2613,"_20891":58048,"_5":14349,"_27386":57343,"_2933":58049},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3450":2897,"_30100":2613,"_20891":58051,"_5":14349,"_27386":57347,"_2933":58052},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3450":2898,"_30100":2613,"_20891":58054,"_5":14349,"_27386":57347,"_2933":58055},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3450":2899,"_30100":2613,"_20891":58057,"_5":14349,"_27386":57347,"_2933":58058},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3450":2900,"_30100":2613,"_20891":58060,"_5":14349,"_27386":57347,"_2933":58061},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3450":2901,"_30100":2613,"_20891":58063,"_5":14349,"_27386":57347,"_2933":58064},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3450":2902,"_30100":2613,"_20891":58066,"_5":14349,"_27386":57347,"_2933":58067},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3450":2903,"_30100":2613,"_20891":58069,"_5":14349,"_27386":57347,"_2933":58070},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3450":2904,"_30100":2613,"_20891":58072,"_5":14349,"_27386":57347,"_2933":58073},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3450":2905,"_30100":2613,"_20891":58075,"_5":14349,"_27386":57347,"_2933":58076},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3450":2906,"_30100":2613,"_20891":58078,"_5":14349,"_27386":57347,"_2933":58079},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3450":2907,"_30100":2613,"_20891":58081,"_5":14349,"_27386":57347,"_2933":58082},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3450":2908,"_30100":2613,"_20891":58084,"_5":14349,"_27386":57350,"_2933":58085},[],"After the upgrade, check in this order:",{"_3450":2909,"_30100":2613,"_20891":58087,"_5":14349,"_27386":57350,"_2933":58088},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3450":2910,"_30100":2613,"_20891":58090,"_5":14349,"_27386":57350,"_2933":58091},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3450":2911,"_30100":2613,"_20891":58093,"_5":14349,"_27386":57350,"_2933":58094},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3450":2912,"_30100":2613,"_20891":58096,"_5":14349,"_27386":57350,"_2933":58097},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3450":2913,"_30100":2613,"_20891":58099,"_5":14349,"_27386":57350,"_2933":58100},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3450":2914,"_30100":2613,"_20891":58102,"_5":14349,"_27386":57350,"_2933":58103},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3450":2915,"_30100":2613,"_20891":58105,"_5":14349,"_27386":57350,"_2933":58106},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3450":2916,"_30100":2613,"_20891":58108,"_5":14349,"_27386":57350,"_2933":58109},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3450":2917,"_30100":2613,"_20891":58111,"_5":14349,"_27386":57350,"_2933":58112},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3450":2918,"_30100":2613,"_20891":58114,"_5":14349,"_27386":57350,"_2933":58115},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3450":2919,"_30100":2613,"_20891":58117,"_5":14349,"_27386":57350,"_2933":58118},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3450":2920,"_30100":2613,"_20891":58120,"_5":14349,"_27386":57350,"_2933":58121},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3450":2921,"_30100":2613,"_20891":58123,"_5":14349,"_27386":57350,"_2933":58124},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3450":2922,"_30100":2613,"_20891":58126,"_5":14349,"_27386":57350,"_2933":58127},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3450":2923,"_30100":2613,"_20891":58129,"_5":14349,"_27386":57350,"_2933":58130},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3450":2924,"_30100":2613,"_20891":58132,"_5":14349,"_27386":57354,"_2933":58133},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3450":2925,"_30100":2613,"_20891":58135,"_5":14349,"_27386":57354,"_2933":58136},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3450":2926,"_30100":2613,"_20891":58138,"_5":14349,"_27386":57354,"_2933":58139},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3450":2927,"_30100":2613,"_20891":58141,"_5":14349,"_27386":57354,"_2933":58142},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3450":2928,"_30100":2613,"_20891":58144,"_5":14349,"_27386":57354,"_2933":58145},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58148":58149,"_58150":58151,"_58152":58153,"_58154":58155,"_18119":2968,"_69825":2968},"language","english","sortableProperties",[2933,30100,5,27386],"sortablePropertiesWithTypes",{"_2933":24962,"_30100":24962,"_5":24962,"_27386":24962},"sorts",{"_2933":58156,"_30100":61074,"_5":63991,"_27386":66908},{"_4627":58157,"_58158":58159,"_5":24962},{"_14425":9971,"_14806":17204,"_14825":3057,"_29103":3301,"_14812":6677,"_19834":5692,"_14446":12143,"_14453":13419,"_29045":6634,"_29454":7624,"_29475":4062,"_29079":6901,"_34414":4474,"_29182":7166,"_29519":12554,"_34421":5915,"_34424":3409,"_34427":6968,"_34430":5961,"_29926":6468,"_34435":10434,"_34437":5101,"_29956":13027,"_14821":13442,"_34441":23551,"_34444":7319,"_34446":6176,"_29503":5976,"_29921":12063,"_29969":4967,"_34451":3106,"_34453":5133,"_34455":4826,"_29199":3033,"_34458":10463,"_34460":6467,"_34462":7019,"_34464":3640,"_34466":7593,"_29116":14281,"_34469":3902,"_34471":3418,"_29110":7576,"_29540":10747,"_34475":13683,"_34477":6894,"_34480":6351,"_29156":14220,"_34484":6271,"_29036":9569,"_34487":7005,"_29084":3147,"_34490":4413,"_34492":3331,"_34495":6202,"_14815":7522,"_34498":17614,"_34500":6003,"_34503":8023,"_34505":17658,"_30159":9442,"_34508":6974,"_34510":6058,"_19837":12441,"_34513":4707,"_34515":3973,"_29057":6950,"_29497":5161,"_34519":3251,"_34521":4038,"_34523":5108,"_29986":6521,"_34526":3687,"_34528":3396,"_34530":3406,"_30080":12024,"_29556":11610,"_34534":6915,"_34536":3796,"_29094":3432,"_34539":3102,"_34541":4734,"_34543":5113,"_30002":3980,"_29176":6927,"_28511":22505,"_34548":8525,"_34550":4705,"_34552":4356,"_29225":15758,"_34556":3472,"_29491":11568,"_34560":11617,"_34562":4301,"_34564":3347,"_34566":4611,"_34568":7557,"_34570":11290,"_29214":20192,"_29459":4557,"_34574":11265,"_34576":5986,"_34578":11623,"_34581":3385,"_34583":4654,"_34585":3968,