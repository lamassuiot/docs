2":58489,"_40384":58492,"_40386":58495,"_40389":58498,"_40391":58501,"_40393":58504,"_40395":58507,"_40397":58510,"_40399":58513,"_40401":58516,"_40403":58519,"_40405":58522,"_40407":58525,"_40409":58528,"_40411":58531,"_40413":58534,"_40415":58537,"_40417":58540,"_40419":58543,"_40421":58546,"_40423":58549,"_40425":58552,"_40427":58555,"_40429":58558,"_40431":58561,"_40433":58564,"_40435":58567,"_40437":58570,"_40439":58573,"_40441":58576,"_40443":58579,"_40445":58582,"_40447":58585,"_40449":58588,"_40452":58591,"_40454":58594,"_40456":58597,"_40458":58600,"_40460":58603,"_40462":58606,"_40464":58609,"_40466":58612,"_40468":58615,"_40470":58618,"_40472":58621,"_40474":58624,"_40476":58627,"_40478":58630,"_40480":58633,"_40482":58636,"_40484":58639,"_40486":58642,"_40488":58645,"_40490":58648,"_40493":58651,"_40495":58654,"_40497":58657,"_40499":58660,"_40501":58663,"_40503":58666,"_40505":58669,"_40507":58672,"_40509":58675,"_40511":58678,"_40513":58681,"_40515":58684,"_40517":58687,"_40519":58690,"_40521":58693,"_40523":58696,"_40525":58699,"_40527":58702,"_40529":58705,"_40531":58708,"_40533":58711,"_40535":58714,"_40537":58717,"_40539":58720,"_40541":58723,"_40543":58726,"_40546":58729,"_40548":58732,"_40550":58735,"_40552":58738},{"_3496":15,"_30262":15,"_5":14825,"_2978":49505,"_30620":49506,"_21040":49510,"_27550":15},"Deploy from AWS Marketplace",[49507,49508,49509],"Docs","Deployment","Other models",[],{"_3496":16,"_30262":15,"_21040":49512,"_5":14474,"_27550":15,"_2978":49513},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3496":17,"_30262":15,"_5":30617,"_21040":49515,"_27550":49516,"_2978":49517},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3496":18,"_30262":15,"_5":30617,"_21040":49519,"_27550":49520,"_2978":49521},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3496":19,"_30262":15,"_5":30617,"_21040":49523,"_27550":49524,"_2978":49525},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3496":20,"_30262":15,"_5":30617,"_21040":49527,"_27550":49528,"_2978":49529},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3496":21,"_30262":15,"_5":30617,"_21040":49531,"_27550":49532,"_2978":49533},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3496":22,"_30262":15,"_5":30617,"_21040":49535,"_27550":49536,"_2978":49537},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3496":23,"_30262":15,"_5":30617,"_21040":49539,"_27550":49540,"_2978":49541},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#next-step","Next step",{"_3496":24,"_30262":15,"_21040":49543,"_5":14474,"_27550":15,"_2978":49544},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3496":25,"_30262":15,"_21040":49546,"_5":14474,"_27550":49516,"_2978":49547},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3496":26,"_30262":15,"_21040":49549,"_5":14474,"_27550":49516,"_2978":49550},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3496":27,"_30262":15,"_21040":49552,"_5":14474,"_27550":49516,"_2978":49553},[],"A security group allowing the necessary endpoints.",{"_3496":28,"_30262":15,"_21040":49555,"_5":14474,"_27550":49520,"_2978":49556},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3496":29,"_30262":15,"_21040":49558,"_5":14474,"_27550":49520,"_2978":49559},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3496":30,"_30262":15,"_21040":49561,"_5":14474,"_27550":49520,"_2978":49562},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3496":31,"_30262":15,"_21040":49564,"_5":14474,"_27550":49524,"_2978":49565},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3496":32,"_30262":15,"_21040":49567,"_5":14474,"_27550":49528,"_2978":49568},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3496":33,"_30262":15,"_21040":49570,"_5":14474,"_27550":49532,"_2978":49571},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3496":34,"_30262":15,"_21040":49573,"_5":14474,"_27550":49536,"_2978":49574},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3496":35,"_30262":15,"_21040":49576,"_5":14474,"_27550":49540,"_2978":49577},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3496":36,"_30262":36,"_5":14825,"_2978":49579,"_30620":49580,"_21040":49581,"_27550":36},"Deploy Lamassu",[49507,49508],[],{"_3496":37,"_30262":36,"_21040":49583,"_5":14474,"_27550":36,"_2978":49584},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3496":38,"_30262":36,"_5":30617,"_21040":49586,"_27550":49587,"_2978":49588},[],"/docs/pr-preview/pr-61/deployment/overview#choose-a-model","Choose a model",{"_3496":39,"_30262":36,"_5":30617,"_21040":49590,"_27550":49591,"_2978":49592},[],"/docs/pr-preview/pr-61/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3496":40,"_30262":36,"_5":30617,"_21040":49594,"_27550":49595,"_2978":49596},[],"/docs/pr-preview/pr-61/deployment/overview#after-deployment","After deployment",{"_3496":41,"_30262":36,"_21040":49598,"_5":14474,"_27550":36,"_2978":49599},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3496":42,"_30262":36,"_21040":49601,"_5":14474,"_27550":49587,"_2978":49602},[],"Model",{"_3496":43,"_30262":36,"_21040":49604,"_5":14474,"_27550":49587,"_2978":49605},[],"Recommended for",{"_3496":44,"_30262":36,"_21040":49607,"_5":14474,"_27550":49587,"_2978":49608},[],"Who operates the infrastructure",{"_3496":45,"_30262":36,"_21040":49610,"_5":14474,"_27550":49587,"_2978":49611},[],"Starting point",{"_3496":46,"_30262":36,"_21040":49613,"_5":14474,"_27550":49587,"_2978":49614},[],"Kubernetes self-managed",{"_3496":47,"_30262":36,"_21040":49616,"_5":14474,"_27550":49587,"_2978":49617},[],"Production, regulated environments and custom deployments",{"_3496":48,"_30262":36,"_21040":49619,"_5":14474,"_27550":49587,"_2978":49620},[],"Your team",{"_3496":49,"_30262":36,"_21040":49622,"_5":14474,"_27550":49587,"_2978":49623},[],"Helm or Fastlane",{"_3496":50,"_30262":36,"_21040":49625,"_5":14474,"_27550":49587,"_2978":49626},[],"AWS Marketplace",{"_3496":51,"_30262":36,"_21040":49628,"_5":14474,"_27550":49587,"_2978":49629},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3496":52,"_30262":36,"_21040":49631,"_5":14474,"_27550":49587,"_2978":49620},[],{"_3496":53,"_30262":36,"_21040":49633,"_5":14474,"_27550":49587,"_2978":49634},[],"Preconfigured image on EC2",{"_3496":54,"_30262":36,"_21040":49636,"_5":14474,"_27550":49587,"_2978":49637},[],"SaaS",{"_3496":55,"_30262":36,"_21040":49639,"_5":14474,"_27550":49587,"_2978":49640},[],"Teams that want to use the platform without operating it",{"_3496":56,"_30262":36,"_21040":49642,"_5":14474,"_27550":49587,"_2978":49643},[],"Lamassu",{"_3496":57,"_30262":36,"_21040":49645,"_5":14474,"_27550":49587,"_2978":49646},[],"Managed subscription",{"_3496":58,"_30262":36,"_21040":49648,"_5":14474,"_27550":49587,"_2978":49649},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3496":59,"_30262":36,"_21040":49651,"_5":14474,"_27550":49587,"_2978":49652},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3496":60,"_30262":36,"_21040":49654,"_5":14474,"_27550":49587,"_2978":49655},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3496":61,"_30262":36,"_21040":49657,"_5":14474,"_27550":49591,"_2978":49658},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3496":62,"_30262":36,"_21040":49660,"_5":14474,"_27550":49595,"_2978":49661},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3496":63,"_30262":63,"_5":14825,"_2978":49663,"_30620":49664,"_21040":49665,"_27550":63},"Use Lamassu as SaaS",[49507,49508,49509],[],{"_3496":64,"_30262":63,"_21040":49667,"_5":14474,"_27550":63,"_2978":49668},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3496":65,"_30262":63,"_5":30617,"_21040":49670,"_27550":49671,"_2978":49672},[],"/docs/pr-preview/pr-61/deployment/saas#what-the-service-manages","What the service manages",{"_3496":66,"_30262":63,"_5":30617,"_21040":49674,"_27550":49675,"_2978":49676},[],"/docs/pr-preview/pr-61/deployment/saas#plans","Plans",{"_3496":67,"_30262":63,"_5":30617,"_21040":49678,"_27550":49679,"_2978":49680},[],"/docs/pr-preview/pr-61/deployment/saas#request-access","Request access",{"_3496":68,"_30262":63,"_21040":49682,"_5":14474,"_27550":63,"_2978":49683},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3496":69,"_30262":63,"_21040":49685,"_5":14474,"_27550":49671,"_2978":49686},[],"Platform availability and maintenance.",{"_3496":70,"_30262":63,"_21040":49688,"_5":14474,"_27550":49671,"_2978":49689},[],"Automatic backups.",{"_3496":71,"_30262":63,"_21040":49691,"_5":14474,"_27550":49671,"_2978":49692},[],"Version upgrades.",{"_3496":72,"_30262":63,"_21040":49694,"_5":14474,"_27550":49671,"_2978":49695},[],"Technical support and SLA according to your plan.",{"_3496":73,"_30262":63,"_21040":49697,"_5":14474,"_27550":49675,"_2978":49698},[],"Plan",{"_3496":74,"_30262":63,"_21040":49700,"_5":14474,"_27550":49675,"_2978":49701},[],"Devices",{"_3496":75,"_30262":63,"_21040":49703,"_5":14474,"_27550":49675,"_2978":49704},[],"Support",{"_3496":76,"_30262":63,"_21040":49706,"_5":14474,"_27550":49675,"_2978":49707},[],"SLA",{"_3496":77,"_30262":63,"_21040":49709,"_5":14474,"_27550":49675,"_2978":49710},[],"Starter",{"_3496":78,"_30262":63,"_21040":49712,"_5":14474,"_27550":49675,"_2978":49713},[],"Up to 1,000",{"_3496":79,"_30262":63,"_21040":49715,"_5":14474,"_27550":49675,"_2978":49716},[],"Email",{"_3496":80,"_30262":63,"_21040":49718,"_5":14474,"_27550":49675,"_2978":49719},[],"99.5 %",{"_3496":81,"_30262":63,"_21040":49721,"_5":14474,"_27550":49675,"_2978":49722},[],"Professional",{"_3496":82,"_30262":63,"_21040":49724,"_5":14474,"_27550":49675,"_2978":49725},[],"Up to 10,000",{"_3496":83,"_30262":63,"_21040":49727,"_5":14474,"_27550":49675,"_2978":49728},[],"Email and chat",{"_3496":84,"_30262":63,"_21040":49730,"_5":14474,"_27550":49675,"_2978":49731},[],"99.9 %",{"_3496":85,"_30262":63,"_21040":49733,"_5":14474,"_27550":49675,"_2978":49734},[],"Enterprise",{"_3496":86,"_30262":63,"_21040":49736,"_5":14474,"_27550":49675,"_2978":49737},[],"Unlimited",{"_3496":87,"_30262":63,"_21040":49739,"_5":14474,"_27550":49675,"_2978":49740},[],"Dedicated",{"_3496":88,"_30262":63,"_21040":49742,"_5":14474,"_27550":49675,"_2978":49743},[],"99.99 %",{"_3496":89,"_30262":63,"_21040":49745,"_5":14474,"_27550":49679,"_2978":49746},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3496":90,"_30262":63,"_21040":49748,"_5":14474,"_27550":49679,"_2978":49749},[],"When you receive your instance's credentials, continue with Get started.",{"_3496":91,"_30262":91,"_5":14825,"_2978":49751,"_30620":49752,"_21040":49753,"_27550":91},"Fastlane",[49507,49508,49614],[],{"_3496":92,"_30262":91,"_21040":49755,"_5":14474,"_27550":91,"_2978":49756},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3496":93,"_30262":91,"_5":30617,"_21040":49758,"_27550":49759,"_2978":49760},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3496":94,"_30262":91,"_5":30617,"_21040":49762,"_27550":49763,"_2978":49764},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3496":95,"_30262":91,"_5":30617,"_21040":49766,"_27550":49767,"_2978":49517},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#before-you-begin",{"_3496":96,"_30262":91,"_5":30617,"_21040":49769,"_27550":49770,"_2978":49771},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3496":97,"_30262":91,"_5":30617,"_21040":49773,"_27550":49774,"_2978":49775},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3496":98,"_30262":91,"_5":30617,"_21040":49777,"_27550":49778,"_2978":49779},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3496":99,"_30262":91,"_5":30617,"_21040":49781,"_27550":49782,"_2978":49783},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3496":100,"_30262":91,"_5":30617,"_21040":49785,"_27550":49786,"_2978":49787},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3496":101,"_30262":91,"_5":30617,"_21040":49789,"_27550":49790,"_2978":49791},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3496":102,"_30262":91,"_5":30617,"_21040":49793,"_27550":49794,"_2978":49795},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3496":103,"_30262":91,"_5":30617,"_21040":49797,"_27550":49798,"_2978":49799},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3496":104,"_30262":91,"_21040":49801,"_5":14474,"_27550":49759,"_2978":49802},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3496":105,"_30262":91,"_21040":49804,"_5":14474,"_27550":49759,"_2978":49805},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3496":106,"_30262":91,"_21040":49807,"_5":14474,"_27550":49763,"_2978":49808},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3496":107,"_30262":91,"_21040":49810,"_5":14474,"_27550":49763,"_2978":49811},[],"Fastlane installs or configures",{"_3496":108,"_30262":91,"_21040":49813,"_5":14474,"_27550":49763,"_2978":49814},[],"You still provide",{"_3496":109,"_30262":91,"_21040":49816,"_5":14474,"_27550":49763,"_2978":49817},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3496":110,"_30262":91,"_21040":49819,"_5":14474,"_27550":49763,"_2978":49820},[],"The Kubernetes cluster, nodes and persistent storage",{"_3496":111,"_30262":91,"_21040":49822,"_5":14474,"_27550":49763,"_2978":49823},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3496":112,"_30262":91,"_21040":49825,"_5":14474,"_27550":49763,"_2978":49826},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3496":113,"_30262":91,"_21040":49828,"_5":14474,"_27550":49763,"_2978":49829},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3496":114,"_30262":91,"_21040":49831,"_5":14474,"_27550":49763,"_2978":49832},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3496":115,"_30262":91,"_21040":49834,"_5":14474,"_27550":49763,"_2978":49835},[],"Optional observability and lab HSM components",{"_3496":116,"_30262":91,"_21040":49837,"_5":14474,"_27550":49763,"_2978":49838},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3496":117,"_30262":91,"_21040":49840,"_5":14474,"_27550":49763,"_2978":49841},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3496":118,"_30262":91,"_21040":49843,"_5":14474,"_27550":49767,"_2978":49844},[],"You need:",{"_3496":119,"_30262":91,"_21040":49846,"_5":14474,"_27550":49767,"_2978":49847},[],"an existing Kubernetes cluster",{"_3496":120,"_30262":91,"_21040":49849,"_5":14474,"_27550":49767,"_2978":49850},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3496":121,"_30262":91,"_21040":49852,"_5":14474,"_27550":49767,"_2978":49853},[],"`yq`",{"_3496":122,"_30262":91,"_21040":49855,"_5":14474,"_27550":49767,"_2978":23776},[],{"_3496":123,"_30262":91,"_21040":49857,"_5":14474,"_27550":49767,"_2978":49858},[],"`jq` only when using `--sample-data` or `--development`",{"_3496":124,"_30262":91,"_21040":49860,"_5":14474,"_27550":49767,"_2978":49861},[],"`ssh-keygen` only when using `--with-hsm`",{"_3496":125,"_30262":91,"_21040":49863,"_5":14474,"_27550":49767,"_2978":49864},[],"free external ports 80 and 443 on a single-node K3s host",{"_3496":126,"_30262":91,"_21040":49866,"_5":14474,"_27550":49767,"_2978":49867},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3496":127,"_30262":91,"_21040":49869,"_5":14474,"_27550":49767,"_2978":49870},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3496":128,"_30262":91,"_21040":49872,"_5":14474,"_27550":49770,"_2978":49873},[],"Run the script from a clone of the Helm repository:",{"_3496":129,"_30262":91,"_21040":49875,"_5":14474,"_27550":49770,"_2978":49876},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3496":130,"_30262":91,"_21040":49878,"_5":14474,"_27550":49774,"_2978":49879},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3496":131,"_30262":91,"_21040":49881,"_5":14474,"_27550":49774,"_2978":49882},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3496":132,"_30262":91,"_21040":49884,"_5":14474,"_27550":49774,"_2978":49885},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3496":133,"_30262":91,"_21040":49887,"_5":14474,"_27550":49774,"_2978":49888},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3496":134,"_30262":91,"_21040":49890,"_5":14474,"_27550":49778,"_2978":49891},[],"Option",{"_3496":135,"_30262":91,"_21040":49893,"_5":14474,"_27550":49778,"_2978":49894},[],"Default",{"_3496":136,"_30262":91,"_21040":49896,"_5":14474,"_27550":49778,"_2978":49897},[],"Purpose",{"_3496":137,"_30262":91,"_21040":49899,"_5":14474,"_27550":49778,"_2978":49900},[],"`-h`, `--help`",{"_3496":138,"_30262":91,"_21040":49902,"_5":14474,"_27550":49778,"_2978":49903},[],"—",{"_3496":139,"_30262":91,"_21040":49905,"_5":14474,"_27550":49778,"_2978":49906},[],"Show help",{"_3496":140,"_30262":91,"_21040":49908,"_5":14474,"_27550":49778,"_2978":49909},[],"`-c`, `--context`",{"_3496":141,"_30262":91,"_21040":49911,"_5":14474,"_27550":49778,"_2978":49912},[],"current context",{"_3496":142,"_30262":91,"_21040":49914,"_5":14474,"_27550":49778,"_2978":49915},[],"Select the kubeconfig context for kubectl and Helm",{"_3496":143,"_30262":91,"_21040":49917,"_5":14474,"_27550":49778,"_2978":49918},[],"`-n`, `--non-interactive`",{"_3496":144,"_30262":91,"_21040":49920,"_5":14474,"_27550":49778,"_2978":6608},[],{"_3496":145,"_30262":91,"_21040":49922,"_5":14474,"_27550":49778,"_2978":49923},[],"Skip prompts and generate dependency credentials",{"_3496":146,"_30262":91,"_21040":49925,"_5":14474,"_27550":49778,"_2978":49926},[],"`-ns`, `--namespace`",{"_3496":147,"_30262":91,"_21040":49928,"_5":14474,"_27550":49778,"_2978":49929},[],"`lamassu-dev`",{"_3496":148,"_30262":91,"_21040":49931,"_5":14474,"_27550":49778,"_2978":49932},[],"Namespace for the installation",{"_3496":149,"_30262":91,"_21040":49934,"_5":14474,"_27550":49778,"_2978":49935},[],"`-d`, `--domain`",{"_3496":150,"_30262":91,"_21040":49937,"_5":14474,"_27550":49778,"_2978":49938},[],"`dev.lamassu.io`",{"_3496":151,"_30262":91,"_21040":49940,"_5":14474,"_27550":49778,"_2978":49941},[],"Domain used by the UI, OIDC and certificate",{"_3496":152,"_30262":91,"_21040":49943,"_5":14474,"_27550":49778,"_2978":49944},[],"`-v`, `--version`",{"_3496":153,"_30262":91,"_21040":49946,"_5":14474,"_27550":49778,"_2978":15171},[],{"_3496":154,"_30262":91,"_21040":49948,"_5":14474,"_27550":49778,"_2978":49949},[],"Lamassu chart version",{"_3496":155,"_30262":91,"_21040":49951,"_5":14474,"_27550":49778,"_2978":49952},[],"`--https-port`",{"_3496":156,"_30262":91,"_21040":49954,"_5":14474,"_27550":49778,"_2978":49955},[],"`443`",{"_3496":157,"_30262":91,"_21040":49957,"_5":14474,"_27550":49778,"_2978":49958},[],"Gateway HTTPS listener port",{"_3496":158,"_30262":91,"_21040":49960,"_5":14474,"_27550":49778,"_2978":49961},[],"`--http-port`",{"_3496":159,"_30262":91,"_21040":49963,"_5":14474,"_27550":49778,"_2978":49964},[],"`80`",{"_3496":160,"_30262":91,"_21040":49966,"_5":14474,"_27550":49778,"_2978":49967},[],"Gateway HTTP listener port",{"_3496":161,"_30262":91,"_21040":49969,"_5":14474,"_27550":49778,"_2978":49970},[],"`--tls-crt`",{"_3496":162,"_30262":91,"_21040":49972,"_5":14474,"_27550":49778,"_2978":49903},[],{"_3496":163,"_30262":91,"_21040":49974,"_5":14474,"_27550":49778,"_2978":49975},[],"PEM certificate for downstream TLS",{"_3496":164,"_30262":91,"_21040":49977,"_5":14474,"_27550":49778,"_2978":49978},[],"`--tls-key`",{"_3496":165,"_30262":91,"_21040":49980,"_5":14474,"_27550":49778,"_2978":49903},[],{"_3496":166,"_30262":91,"_21040":49982,"_5":14474,"_27550":49778,"_2978":49983},[],"PEM private key for downstream TLS",{"_3496":167,"_30262":91,"_21040":49985,"_5":14474,"_27550":49778,"_2978":49986},[],"`-l`, `--local-chart-path`",{"_3496":168,"_30262":91,"_21040":49988,"_5":14474,"_27550":49778,"_2978":49989},[],"repository chart",{"_3496":169,"_30262":91,"_21040":49991,"_5":14474,"_27550":49778,"_2978":49992},[],"Use an unpacked local Lamassu chart",{"_3496":170,"_30262":91,"_21040":49994,"_5":14474,"_27550":49778,"_2978":49995},[],"`-ip`, `--gateway-ip`",{"_3496":171,"_30262":91,"_21040":49997,"_5":14474,"_27550":49778,"_2978":8814},[],{"_3496":172,"_30262":91,"_21040":49999,"_5":14474,"_27550":49778,"_2978":50000},[],"Override the address written to `gateway.addresses`",{"_3496":173,"_30262":91,"_21040":50002,"_5":14474,"_27550":49778,"_2978":50003},[],"`--otel`",{"_3496":174,"_30262":91,"_21040":50005,"_5":14474,"_27550":49778,"_2978":6608},[],{"_3496":175,"_30262":91,"_21040":50007,"_5":14474,"_27550":49778,"_2978":50008},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3496":176,"_30262":91,"_21040":50010,"_5":14474,"_27550":49778,"_2978":50011},[],"`--development`",{"_3496":177,"_30262":91,"_21040":50013,"_5":14474,"_27550":49778,"_2978":6608},[],{"_3496":178,"_30262":91,"_21040":50015,"_5":14474,"_27550":49778,"_2978":50016},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3496":179,"_30262":91,"_21040":50018,"_5":14474,"_27550":49778,"_2978":50019},[],"`--sample-data`",{"_3496":180,"_30262":91,"_21040":50021,"_5":14474,"_27550":49778,"_2978":6608},[],{"_3496":181,"_30262":91,"_21040":50023,"_5":14474,"_27550":49778,"_2978":50024},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3496":182,"_30262":91,"_21040":50026,"_5":14474,"_27550":49778,"_2978":50027},[],"`--with-hsm`",{"_3496":183,"_30262":91,"_21040":50029,"_5":14474,"_27550":49778,"_2978":6608},[],{"_3496":184,"_30262":91,"_21040":50031,"_5":14474,"_27550":49778,"_2978":50032},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3496":185,"_30262":91,"_21040":50034,"_5":14474,"_27550":49778,"_2978":50035},[],"`--softhsm-chart-path`",{"_3496":186,"_30262":91,"_21040":50037,"_5":14474,"_27550":49778,"_2978":50038},[],"`./charts/softhsm`",{"_3496":187,"_30262":91,"_21040":50040,"_5":14474,"_27550":49778,"_2978":50041},[],"Use a different local SoftHSM chart",{"_3496":188,"_30262":91,"_21040":50043,"_5":14474,"_27550":49778,"_2978":50044},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3496":189,"_30262":91,"_21040":50046,"_5":14474,"_27550":49782,"_2978":50047},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3496":190,"_30262":91,"_21040":50049,"_5":14474,"_27550":49782,"_2978":50050},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3496":191,"_30262":91,"_21040":50052,"_5":14474,"_27550":49782,"_2978":50053},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3496":192,"_30262":91,"_21040":50055,"_5":14474,"_27550":49782,"_2978":50056},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3496":193,"_30262":91,"_21040":50058,"_5":14474,"_27550":49782,"_2978":50059},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3496":194,"_30262":91,"_21040":50061,"_5":14474,"_27550":49782,"_2978":50062},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3496":195,"_30262":91,"_21040":50064,"_5":14474,"_27550":49786,"_2978":50065},[],"Fastlane:",{"_3496":196,"_30262":91,"_21040":50067,"_5":14474,"_27550":49786,"_2978":50068},[],"validates local tools and the selected cluster",{"_3496":197,"_30262":91,"_21040":50070,"_5":14474,"_27550":49786,"_2978":50071},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3496":198,"_30262":91,"_21040":50073,"_5":14474,"_27550":49786,"_2978":50074},[],"creates the namespace",{"_3496":199,"_30262":91,"_21040":50076,"_5":14474,"_27550":49786,"_2978":50077},[],"installs PostgreSQL and creates the required databases",{"_3496":200,"_30262":91,"_21040":50079,"_5":14474,"_27550":49786,"_2978":50080},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3496":201,"_30262":91,"_21040":50082,"_5":14474,"_27550":49786,"_2978":50083},[],"installs RabbitMQ",{"_3496":202,"_30262":91,"_21040":50085,"_5":14474,"_27550":49786,"_2978":50086},[],"optionally installs observability and lab HSM components",{"_3496":203,"_30262":91,"_21040":50088,"_5":14474,"_27550":49786,"_2978":50089},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3496":204,"_30262":91,"_21040":50091,"_5":14474,"_27550":49786,"_2978":50092},[],"optionally loads sample data",{"_3496":205,"_30262":91,"_21040":50094,"_5":14474,"_27550":49786,"_2978":50095},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3496":206,"_30262":91,"_21040":50097,"_5":14474,"_27550":49790,"_2978":50098},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3496":207,"_30262":91,"_21040":50100,"_5":14474,"_27550":49790,"_2978":50101},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3496":208,"_30262":91,"_21040":50103,"_5":14474,"_27550":49794,"_2978":50104},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3496":209,"_30262":91,"_21040":50106,"_5":14474,"_27550":49794,"_2978":50107},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3496":210,"_30262":91,"_21040":50109,"_5":14474,"_27550":49794,"_2978":50110},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3496":211,"_30262":91,"_21040":50112,"_5":14474,"_27550":49798,"_2978":50113},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3496":212,"_30262":212,"_5":14825,"_2978":50115,"_30620":50116,"_21040":50117,"_27550":212},"Install with Helm",[49507,49508,49614],[],{"_3496":213,"_30262":212,"_21040":50119,"_5":14474,"_27550":212,"_2978":50120},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3496":214,"_30262":212,"_5":30617,"_21040":50122,"_27550":50123,"_2978":50124},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3496":215,"_30262":212,"_5":30617,"_21040":50126,"_27550":50127,"_2978":49517},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#before-you-begin",{"_3496":216,"_30262":212,"_5":30617,"_21040":50129,"_27550":50130,"_2978":50131},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3496":217,"_30262":212,"_5":30617,"_21040":50133,"_27550":50134,"_2978":50135},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3496":218,"_30262":212,"_5":30617,"_21040":50137,"_27550":50138,"_2978":50139},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3496":219,"_30262":212,"_5":30617,"_21040":50141,"_27550":50142,"_2978":50143},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3496":220,"_30262":212,"_5":30617,"_21040":50145,"_27550":50146,"_2978":50147},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3496":221,"_30262":212,"_5":30617,"_21040":50149,"_27550":50150,"_2978":50151},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3496":222,"_30262":212,"_5":30617,"_21040":50153,"_27550":50154,"_2978":50155},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3496":223,"_30262":212,"_5":30617,"_21040":50157,"_27550":50158,"_2978":50159},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3496":224,"_30262":212,"_5":30617,"_21040":50161,"_27550":50162,"_2978":50163},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3496":225,"_30262":212,"_21040":50165,"_5":14474,"_27550":50123,"_2978":50166},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3496":226,"_30262":212,"_21040":50168,"_5":14474,"_27550":50127,"_2978":50169},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3496":227,"_30262":212,"_21040":50171,"_5":14474,"_27550":50127,"_2978":50172},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3496":228,"_30262":212,"_21040":50174,"_5":14474,"_27550":50127,"_2978":50175},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3496":229,"_30262":212,"_21040":50177,"_5":14474,"_27550":50127,"_2978":50178},[],"a reachable RabbitMQ broker and credentials",{"_3496":230,"_30262":212,"_21040":50180,"_5":14474,"_27550":50127,"_2978":50181},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3496":231,"_30262":212,"_21040":50183,"_5":14474,"_27550":50127,"_2978":50184},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3496":232,"_30262":212,"_21040":50186,"_5":14474,"_27550":50127,"_2978":50187},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3496":233,"_30262":212,"_21040":50189,"_5":14474,"_27550":50127,"_2978":50190},[],"a StorageClass and an external traffic design",{"_3496":234,"_30262":212,"_21040":50192,"_5":14474,"_27550":50127,"_2978":50193},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3496":235,"_30262":212,"_21040":50195,"_5":14474,"_27550":50127,"_2978":50196},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3496":236,"_30262":212,"_21040":50198,"_5":14474,"_27550":50127,"_2978":50199},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3496":237,"_30262":212,"_21040":50201,"_5":14474,"_27550":50130,"_2978":50202},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3496":238,"_30262":212,"_21040":50204,"_5":14474,"_27550":50130,"_2978":50205},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3496":239,"_30262":212,"_21040":50207,"_5":14474,"_27550":50130,"_2978":50208},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3496":240,"_30262":212,"_21040":50210,"_5":14474,"_27550":50134,"_2978":50211},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3496":241,"_30262":212,"_21040":50213,"_5":14474,"_27550":50134,"_2978":50214},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3496":242,"_30262":212,"_21040":50216,"_5":14474,"_27550":50134,"_2978":50217},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3496":243,"_30262":212,"_21040":50219,"_5":14474,"_27550":50134,"_2978":50220},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3496":244,"_30262":212,"_21040":50222,"_5":14474,"_27550":50138,"_2978":50223},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3496":245,"_30262":212,"_21040":50225,"_5":14474,"_27550":50142,"_2978":50226},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3496":246,"_30262":212,"_21040":50228,"_5":14474,"_27550":50142,"_2978":50229},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3496":247,"_30262":212,"_21040":50231,"_5":14474,"_27550":50142,"_2978":50232},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3496":248,"_30262":212,"_21040":50234,"_5":14474,"_27550":50142,"_2978":50235},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3496":249,"_30262":212,"_21040":50237,"_5":14474,"_27550":50142,"_2978":50238},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3496":250,"_30262":212,"_21040":50240,"_5":14474,"_27550":50142,"_2978":50241},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3496":251,"_30262":212,"_21040":50243,"_5":14474,"_27550":50142,"_2978":50244},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3496":252,"_30262":212,"_21040":50246,"_5":14474,"_27550":50146,"_2978":50247},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3496":253,"_30262":212,"_21040":50249,"_5":14474,"_27550":50146,"_2978":50250},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3496":254,"_30262":212,"_21040":50252,"_5":14474,"_27550":50146,"_2978":50253},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3496":255,"_30262":212,"_21040":50255,"_5":14474,"_27550":50146,"_2978":50256},[],"See Access control for the principal and policy model.",{"_3496":256,"_30262":212,"_21040":50258,"_5":14474,"_27550":50150,"_2978":50259},[],"To install a local checkout instead:",{"_3496":257,"_30262":212,"_21040":50261,"_5":14474,"_27550":50154,"_2978":50262},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3496":258,"_30262":212,"_21040":50264,"_5":14474,"_27550":50154,"_2978":50265},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3496":259,"_30262":212,"_21040":50267,"_5":14474,"_27550":50158,"_2978":50268},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3496":260,"_30262":212,"_21040":50270,"_5":14474,"_27550":50158,"_2978":50271},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3496":261,"_30262":212,"_21040":50273,"_5":14474,"_27550":50158,"_2978":50274},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3496":262,"_30262":212,"_21040":50276,"_5":14474,"_27550":50158,"_2978":50277},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3496":263,"_30262":212,"_21040":50279,"_5":14474,"_27550":50158,"_2978":50280},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3496":264,"_30262":212,"_21040":50282,"_5":14474,"_27550":50162,"_2978":50283},[],"Before going live, review:",{"_3496":265,"_30262":212,"_21040":50285,"_5":14474,"_27550":50162,"_2978":50286},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3496":266,"_30262":212,"_21040":50288,"_5":14474,"_27550":50162,"_2978":50289},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3496":267,"_30262":212,"_21040":50291,"_5":14474,"_27550":50162,"_2978":50292},[],"shared VA storage before increasing VA replicas",{"_3496":268,"_30262":212,"_21040":50294,"_5":14474,"_27550":50162,"_2978":50295},[],"managed OIDC roles and removal of evaluation credentials",{"_3496":269,"_30262":212,"_21040":50297,"_5":14474,"_27550":50162,"_2978":50298},[],"a trusted TLS issuer or externally managed certificate",{"_3496":270,"_30262":212,"_21040":50300,"_5":14474,"_27550":50162,"_2978":50301},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3496":271,"_30262":212,"_21040":50303,"_5":14474,"_27550":50162,"_2978":50304},[],"SMTP, observability and alert delivery",{"_3496":272,"_30262":212,"_21040":50306,"_5":14474,"_27550":50162,"_2978":50307},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3496":273,"_30262":212,"_21040":50309,"_5":14474,"_27550":50162,"_2978":50310},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3496":274,"_30262":274,"_5":14825,"_2978":50312,"_30620":50313,"_21040":50314,"_27550":274},"Expose the Gateway",[49507,49508,49614],[],{"_3496":275,"_30262":274,"_21040":50316,"_5":14474,"_27550":274,"_2978":50317},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3496":276,"_30262":274,"_5":30617,"_21040":50319,"_27550":50320,"_2978":50321},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3496":277,"_30262":274,"_5":30617,"_21040":50323,"_27550":50324,"_2978":50325},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3496":278,"_30262":274,"_5":30617,"_21040":50327,"_27550":50328,"_2978":50329},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3496":279,"_30262":274,"_5":30617,"_21040":50331,"_27550":50332,"_2978":50333},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#k3s","K3s",{"_3496":280,"_30262":274,"_5":30617,"_21040":50335,"_27550":50336,"_2978":50337},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3496":281,"_30262":274,"_5":30617,"_21040":50339,"_27550":50340,"_2978":50341},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3496":282,"_30262":274,"_5":30617,"_21040":50343,"_27550":50344,"_2978":50345},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3496":283,"_30262":274,"_5":30617,"_21040":50347,"_27550":50348,"_2978":50349},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3496":284,"_30262":274,"_5":30617,"_21040":50351,"_27550":50352,"_2978":50353},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3496":285,"_30262":274,"_5":30617,"_21040":50355,"_27550":50356,"_2978":50357},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3496":286,"_30262":274,"_21040":50359,"_5":14474,"_27550":50320,"_2978":50360},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3496":287,"_30262":274,"_21040":50362,"_5":14474,"_27550":50320,"_2978":50363},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3496":288,"_30262":274,"_21040":50365,"_5":14474,"_27550":50324,"_2978":50366},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3496":289,"_30262":274,"_21040":50368,"_5":14474,"_27550":50324,"_2978":50369},[],"Set it only when:",{"_3496":290,"_30262":274,"_21040":50371,"_5":14474,"_27550":50324,"_2978":50372},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3496":291,"_30262":274,"_21040":50374,"_5":14474,"_27550":50324,"_2978":50375},[],"that address is allocated to this Gateway",{"_3496":292,"_30262":274,"_21040":50377,"_5":14474,"_27550":50324,"_2978":50378},[],"the surrounding network already routes traffic for it to the cluster",{"_3496":293,"_30262":274,"_21040":50380,"_5":14474,"_27550":50324,"_2978":50381},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3496":294,"_30262":274,"_21040":50383,"_5":14474,"_27550":50324,"_2978":50384},[],"Keep these two settings separate:",{"_3496":295,"_30262":274,"_21040":50386,"_5":14474,"_27550":50324,"_2978":50387},[],"`gateway.addresses` requests an address for the Gateway.",{"_3496":296,"_30262":274,"_21040":50389,"_5":14474,"_27550":50324,"_2978":50390},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3496":297,"_30262":274,"_21040":50392,"_5":14474,"_27550":50324,"_2978":50393},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3496":298,"_30262":274,"_21040":50395,"_5":14474,"_27550":50328,"_2978":50396},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3496":299,"_30262":274,"_21040":50398,"_5":14474,"_27550":50328,"_2978":50399},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3496":300,"_30262":274,"_21040":50401,"_5":14474,"_27550":50332,"_2978":50402},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3496":301,"_30262":274,"_21040":50404,"_5":14474,"_27550":50332,"_2978":50405},[],"For the recommended design:",{"_3496":302,"_30262":274,"_21040":50407,"_5":14474,"_27550":50332,"_2978":50408},[],"Use only one externally exposed Lamassu Gateway.",{"_3496":303,"_30262":274,"_21040":50410,"_5":14474,"_27550":50332,"_2978":50411},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3496":304,"_30262":274,"_21040":50413,"_5":14474,"_27550":50332,"_2978":50414},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3496":305,"_30262":274,"_21040":50416,"_5":14474,"_27550":50332,"_2978":50417},[],"Point DNS at the VM's reachable address.",{"_3496":306,"_30262":274,"_21040":50419,"_5":14474,"_27550":50332,"_2978":50420},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3496":307,"_30262":274,"_21040":50422,"_5":14474,"_27550":50336,"_2978":50423},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3496":308,"_30262":274,"_21040":50425,"_5":14474,"_27550":50340,"_2978":50426},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3496":309,"_30262":274,"_21040":50428,"_5":14474,"_27550":50340,"_2978":50429},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3496":310,"_30262":274,"_21040":50431,"_5":14474,"_27550":50344,"_2978":50432},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3496":311,"_30262":274,"_21040":50434,"_5":14474,"_27550":50344,"_2978":50435},[],"Requirement",{"_3496":312,"_30262":274,"_21040":50437,"_5":14474,"_27550":50344,"_2978":50438},[],"Recommended design",{"_3496":313,"_30262":274,"_21040":50440,"_5":14474,"_27550":50344,"_2978":50441},[],"Consequence",{"_3496":314,"_30262":274,"_21040":50443,"_5":14474,"_27550":50344,"_2978":50444},[],"Several Lamassu URLs or services",{"_3496":315,"_30262":274,"_21040":50446,"_5":14474,"_27550":50344,"_2978":50447},[],"One Gateway with multiple routes",{"_3496":316,"_30262":274,"_21040":50449,"_5":14474,"_27550":50344,"_2978":50450},[],"One IP and one proxy fleet; this is the chart default",{"_3496":317,"_30262":274,"_21040":50452,"_5":14474,"_27550":50344,"_2978":50453},[],"Independent Gateways and separate external IPs",{"_3496":318,"_30262":274,"_21040":50455,"_5":14474,"_27550":50344,"_2978":50456},[],"One VIP per Gateway",{"_3496":319,"_30262":274,"_21040":50458,"_5":14474,"_27550":50344,"_2978":50459},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3496":320,"_30262":274,"_21040":50461,"_5":14474,"_27550":50344,"_2978":50462},[],"Independent Gateways on one node and one IP",{"_3496":321,"_30262":274,"_21040":50464,"_5":14474,"_27550":50344,"_2978":50465},[],"Use different external ports",{"_3496":322,"_30262":274,"_21040":50467,"_5":14474,"_27550":50344,"_2978":50468},[],"Clients must include non-standard ports",{"_3496":323,"_30262":274,"_21040":50470,"_5":14474,"_27550":50344,"_2978":50471},[],"Separate TLS/mTLS termination behind one IP",{"_3496":324,"_30262":274,"_21040":50473,"_5":14474,"_27550":50344,"_2978":50474},[],"Front-door SNI routing to internal Gateways",{"_3496":325,"_30262":274,"_21040":50476,"_5":14474,"_27550":50344,"_2978":50477},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3496":326,"_30262":274,"_21040":50479,"_5":14474,"_27550":50344,"_2978":50480},[],"Separate Gateway resources but shared proxy infrastructure",{"_3496":327,"_30262":274,"_21040":50482,"_5":14474,"_27550":50344,"_2978":50483},[],"Envoy merged-Gateway mode",{"_3496":328,"_30262":274,"_21040":50485,"_5":14474,"_27550":50344,"_2978":50486},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3496":329,"_30262":274,"_21040":50488,"_5":14474,"_27550":50344,"_2978":50489},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3496":330,"_30262":274,"_21040":50491,"_5":14474,"_27550":50344,"_2978":50492},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3496":331,"_30262":274,"_21040":50494,"_5":14474,"_27550":50344,"_2978":50495},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3496":332,"_30262":274,"_21040":50497,"_5":14474,"_27550":50344,"_2978":50498},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3496":333,"_30262":274,"_21040":50500,"_5":14474,"_27550":50348,"_2978":50501},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3496":334,"_30262":274,"_21040":50503,"_5":14474,"_27550":50348,"_2978":50504},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3496":335,"_30262":274,"_21040":50506,"_5":14474,"_27550":50348,"_2978":50507},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3496":336,"_30262":274,"_21040":50509,"_5":14474,"_27550":50348,"_2978":50510},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3496":337,"_30262":274,"_21040":50512,"_5":14474,"_27550":50348,"_2978":50513},[],"If none of those are possible, use different external ports or change the external network design.",{"_3496":338,"_30262":274,"_21040":50515,"_5":14474,"_27550":50352,"_2978":50516},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3496":339,"_30262":274,"_21040":50518,"_5":14474,"_27550":50352,"_2978":50519},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3496":340,"_30262":274,"_21040":50521,"_5":14474,"_27550":50356,"_2978":50522},[],"Check, in order:",{"_3496":341,"_30262":274,"_21040":50524,"_5":14474,"_27550":50356,"_2978":50525},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3496":342,"_30262":274,"_21040":50527,"_5":14474,"_27550":50356,"_2978":50528},[],"Its status contains the expected address.",{"_3496":343,"_30262":274,"_21040":50530,"_5":14474,"_27550":50356,"_2978":50531},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3496":344,"_30262":274,"_21040":50533,"_5":14474,"_27550":50356,"_2978":50534},[],"Port 443 reaches that address from the client network.",{"_3496":345,"_30262":274,"_21040":50536,"_5":14474,"_27550":50356,"_2978":50537},[],"DNS resolves to the externally reachable endpoint.",{"_3496":346,"_30262":274,"_21040":50539,"_5":14474,"_27550":50356,"_2978":50540},[],"The certificate contains the DNS name or IP used by the client.",{"_3496":347,"_30262":274,"_21040":50542,"_5":14474,"_27550":50356,"_2978":50543},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3496":348,"_30262":348,"_5":14825,"_2978":49614,"_30620":50545,"_21040":50546,"_27550":348},[49507,49508,49614],[],{"_3496":349,"_30262":348,"_21040":50548,"_5":14474,"_27550":348,"_2978":50549},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3496":350,"_30262":348,"_5":30617,"_21040":50551,"_27550":50552,"_2978":50553},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3496":351,"_30262":348,"_5":30617,"_21040":50555,"_27550":50556,"_2978":50557},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3496":352,"_30262":348,"_5":30617,"_21040":50559,"_27550":50560,"_2978":50561},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3496":353,"_30262":348,"_5":30617,"_21040":50563,"_27550":50564,"_2978":50565},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3496":354,"_30262":348,"_5":30617,"_21040":50567,"_27550":50568,"_2978":50569},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3496":355,"_30262":348,"_5":30617,"_21040":50571,"_27550":50572,"_2978":50573},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3496":356,"_30262":348,"_21040":50575,"_5":14474,"_27550":50552,"_2978":50576},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3496":357,"_30262":348,"_21040":50578,"_5":14474,"_27550":50556,"_2978":50579},[],"Workflow",{"_3496":358,"_30262":348,"_21040":50581,"_5":14474,"_27550":50556,"_2978":50582},[],"Use it for",{"_3496":359,"_30262":348,"_21040":50584,"_5":14474,"_27550":50556,"_2978":50585},[],"What it installs",{"_3496":360,"_30262":348,"_21040":50587,"_5":14474,"_27550":50556,"_2978":50588},[],"Helm",{"_3496":361,"_30262":348,"_21040":50590,"_5":14474,"_27550":50556,"_2978":50591},[],"Production and controlled environments",{"_3496":362,"_30262":348,"_21040":50593,"_5":14474,"_27550":50556,"_2978":50594},[],"Lamassu services and Gateway API resources",{"_3496":363,"_30262":348,"_21040":50596,"_5":14474,"_27550":50556,"_2978":49751},[],{"_3496":364,"_30262":348,"_21040":50598,"_5":14474,"_27550":50556,"_2978":50599},[],"Evaluation, demos, CI and small lab clusters",{"_3496":365,"_30262":348,"_21040":50601,"_5":14474,"_27550":50556,"_2978":50602},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3496":366,"_30262":348,"_21040":50604,"_5":14474,"_27550":50560,"_2978":50605},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3496":367,"_30262":348,"_21040":50607,"_5":14474,"_27550":50560,"_2978":50608},[],"Area",{"_3496":368,"_30262":348,"_21040":50610,"_5":14474,"_27550":50560,"_2978":50611},[],"The Lamassu chart provides",{"_3496":369,"_30262":348,"_21040":50613,"_5":14474,"_27550":50560,"_2978":50614},[],"You provide",{"_3496":370,"_30262":348,"_21040":50616,"_5":14474,"_27550":50560,"_2978":50617},[],"Lamassu applications",{"_3496":371,"_30262":348,"_21040":50619,"_5":14474,"_27550":50560,"_2978":50620},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3496":372,"_30262":348,"_21040":50622,"_5":14474,"_27550":50560,"_2978":50623},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3496":373,"_30262":348,"_21040":50625,"_5":14474,"_27550":50560,"_2978":50626},[],"PostgreSQL data",{"_3496":374,"_30262":348,"_21040":50628,"_5":14474,"_27550":50560,"_2978":50629},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3496":375,"_30262":348,"_21040":50631,"_5":14474,"_27550":50560,"_2978":50632},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3496":376,"_30262":348,"_21040":50634,"_5":14474,"_27550":50560,"_2978":50635},[],"Messaging",{"_3496":377,"_30262":348,"_21040":50637,"_5":14474,"_27550":50560,"_2978":50638},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3496":378,"_30262":348,"_21040":50640,"_5":14474,"_27550":50560,"_2978":50641},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3496":379,"_30262":348,"_21040":50643,"_5":14474,"_27550":50560,"_2978":50644},[],"Identity",{"_3496":380,"_30262":348,"_21040":50646,"_5":14474,"_27550":50560,"_2978":50647},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3496":381,"_30262":348,"_21040":50649,"_5":14474,"_27550":50560,"_2978":50650},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3496":382,"_30262":348,"_21040":50652,"_5":14474,"_27550":50560,"_2978":50653},[],"External routing",{"_3496":383,"_30262":348,"_21040":50655,"_5":14474,"_27550":50560,"_2978":50656},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3496":384,"_30262":348,"_21040":50658,"_5":14474,"_27550":50560,"_2978":50659},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3496":385,"_30262":348,"_21040":50661,"_5":14474,"_27550":50560,"_2978":50662},[],"TLS",{"_3496":386,"_30262":348,"_21040":50664,"_5":14474,"_27550":50560,"_2978":50665},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3496":387,"_30262":348,"_21040":50667,"_5":14474,"_27550":50560,"_2978":50668},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3496":388,"_30262":348,"_21040":50670,"_5":14474,"_27550":50560,"_2978":50671},[],"Persistent application data",{"_3496":389,"_30262":348,"_21040":50673,"_5":14474,"_27550":50560,"_2978":50674},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3496":390,"_30262":348,"_21040":50676,"_5":14474,"_27550":50560,"_2978":50677},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3496":391,"_30262":348,"_21040":50679,"_5":14474,"_27550":50560,"_2978":50680},[],"Optional integrations",{"_3496":392,"_30262":348,"_21040":50682,"_5":14474,"_27550":50560,"_2978":50683},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3496":393,"_30262":348,"_21040":50685,"_5":14474,"_27550":50560,"_2978":50686},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3496":394,"_30262":348,"_21040":50688,"_5":14474,"_27550":50560,"_2978":50689},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3496":395,"_30262":348,"_21040":50691,"_5":14474,"_27550":50560,"_2978":50692},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3496":396,"_30262":348,"_21040":50694,"_5":14474,"_27550":50564,"_2978":50695},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3496":397,"_30262":348,"_21040":50697,"_5":14474,"_27550":50564,"_2978":50698},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3496":398,"_30262":348,"_21040":50700,"_5":14474,"_27550":50568,"_2978":50701},[],"Kubernetes 1.24 or newer",{"_3496":399,"_30262":348,"_21040":50703,"_5":14474,"_27550":50568,"_2978":50704},[],"Helm 3.2 or newer",{"_3496":400,"_30262":348,"_21040":50706,"_5":14474,"_27550":50568,"_2978":50707},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3496":401,"_30262":348,"_21040":50709,"_5":14474,"_27550":50568,"_2978":50710},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3496":402,"_30262":348,"_21040":50712,"_5":14474,"_27550":50568,"_2978":50713},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3496":403,"_30262":348,"_21040":50715,"_5":14474,"_27550":50568,"_2978":50716},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3496":404,"_30262":348,"_21040":50718,"_5":14474,"_27550":50568,"_2978":50719},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3496":405,"_30262":348,"_21040":50721,"_5":14474,"_27550":50572,"_2978":50722},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3496":406,"_30262":348,"_21040":50724,"_5":14474,"_27550":50572,"_2978":50725},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3496":407,"_30262":348,"_21040":50727,"_5":14474,"_27550":50572,"_2978":50728},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3496":408,"_30262":348,"_21040":50730,"_5":14474,"_27550":50572,"_2978":50731},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3496":409,"_30262":409,"_5":14825,"_2978":50733,"_30620":50734,"_21040":50736,"_27550":409},"Deployment troubleshooting",[49507,49508,50735],"Operations",[],{"_3496":410,"_30262":409,"_21040":50738,"_5":14474,"_27550":409,"_2978":50739},[],"Diagnose access, service health and infrastructure dependencies.",{"_3496":411,"_30262":409,"_5":30617,"_21040":50741,"_27550":50742,"_2978":50743},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3496":412,"_30262":409,"_5":30617,"_21040":50745,"_27550":50746,"_2978":50747},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3496":413,"_30262":409,"_5":30617,"_21040":50749,"_27550":50750,"_2978":50751},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3496":414,"_30262":409,"_5":30617,"_21040":50753,"_27550":50754,"_2978":50755},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3496":415,"_30262":409,"_5":30617,"_21040":50757,"_27550":50758,"_2978":50759},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3496":416,"_30262":409,"_5":30617,"_21040":50761,"_27550":50762,"_2978":50763},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3496":417,"_30262":409,"_5":30617,"_21040":50765,"_27550":50766,"_2978":50767},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3496":418,"_30262":409,"_5":30617,"_21040":50769,"_27550":50770,"_2978":50771},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3496":419,"_30262":409,"_5":30617,"_21040":50773,"_27550":50774,"_2978":50775},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3496":420,"_30262":409,"_5":30617,"_21040":50777,"_27550":50778,"_2978":50779},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3496":421,"_30262":409,"_5":30617,"_21040":50781,"_27550":50782,"_2978":50783},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3496":422,"_30262":409,"_5":30617,"_21040":50785,"_27550":50786,"_2978":50787},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3496":423,"_30262":409,"_5":30617,"_21040":50789,"_27550":50790,"_2978":50791},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#observability","Observability",{"_3496":424,"_30262":409,"_21040":50793,"_5":14474,"_27550":409,"_2978":50794},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3496":425,"_30262":409,"_21040":50796,"_5":14474,"_27550":50746,"_2978":50797},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3496":426,"_30262":409,"_21040":50799,"_5":14474,"_27550":50750,"_2978":50800},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3496":427,"_30262":409,"_21040":50802,"_5":14474,"_27550":50754,"_2978":50803},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3496":428,"_30262":409,"_21040":50805,"_5":14474,"_27550":50758,"_2978":50806},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3496":429,"_30262":409,"_21040":50808,"_5":14474,"_27550":50762,"_2978":50809},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3496":430,"_30262":409,"_21040":50811,"_5":14474,"_27550":50766,"_2978":50812},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3496":431,"_30262":409,"_21040":50814,"_5":14474,"_27550":50766,"_2978":50815},[],"Also run the chart's connectivity test:",{"_3496":432,"_30262":409,"_21040":50817,"_5":14474,"_27550":50766,"_2978":50818},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3496":433,"_30262":409,"_21040":50820,"_5":14474,"_27550":50766,"_2978":50821},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3496":434,"_30262":409,"_21040":50823,"_5":14474,"_27550":50770,"_2978":50824},[],"If you receive a 401:",{"_3496":435,"_30262":409,"_21040":50826,"_5":14474,"_27550":50770,"_2978":50827},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3496":436,"_30262":409,"_21040":50829,"_5":14474,"_27550":50770,"_2978":50830},[],"verify issuer, audience and expiration of the token;",{"_3496":437,"_30262":409,"_21040":50832,"_5":14474,"_27550":50770,"_2978":50833},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3496":438,"_30262":409,"_21040":50835,"_5":14474,"_27550":50770,"_2978":50836},[],"check that the provider's public and internal routes point to the same realm.",{"_3496":439,"_30262":409,"_21040":50838,"_5":14474,"_27550":50770,"_2978":50839},[],"If login succeeds but the APIs return 403:",{"_3496":440,"_30262":409,"_21040":50841,"_5":14474,"_27550":50770,"_2978":50842},[],"inspect the token's real claims;",{"_3496":441,"_30262":409,"_21040":50844,"_5":14474,"_27550":50770,"_2978":50845},[],"confirm they match an active principal;",{"_3496":442,"_30262":409,"_21040":50847,"_5":14474,"_27550":50770,"_2978":50848},[],"review the policies granted to that principal;",{"_3496":443,"_30262":409,"_21040":50850,"_5":14474,"_27550":50770,"_2978":50851},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3496":444,"_30262":409,"_21040":50853,"_5":14474,"_27550":50770,"_2978":50854},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3496":445,"_30262":409,"_21040":50856,"_5":14474,"_27550":50774,"_2978":50857},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3496":446,"_30262":409,"_21040":50859,"_5":14474,"_27550":50774,"_2978":50860},[],"Locate the authz pod and Service.",{"_3496":447,"_30262":409,"_21040":50862,"_5":14474,"_27550":50774,"_2978":50863},[],"Check /health, logs and its database connection.",{"_3496":448,"_30262":409,"_21040":50865,"_5":14474,"_27550":50774,"_2978":50866},[],"Verify the DNS and port configured in externalAuthorization.",{"_3496":449,"_30262":409,"_21040":50868,"_5":14474,"_27550":50774,"_2978":50869},[],"Check the check route is /v1/ext\\_authz/check.",{"_3496":450,"_30262":409,"_21040":50871,"_5":14474,"_27550":50774,"_2978":50872},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3496":451,"_30262":409,"_21040":50874,"_5":14474,"_27550":50778,"_2978":50875},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3496":452,"_30262":409,"_21040":50877,"_5":14474,"_27550":50782,"_2978":50878},[],"Review kubectl describe pod first. Common causes are:",{"_3496":453,"_30262":409,"_21040":50880,"_5":14474,"_27550":50782,"_2978":50881},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3496":454,"_30262":409,"_21040":50883,"_5":14474,"_27550":50782,"_2978":50884},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3496":455,"_30262":409,"_21040":50886,"_5":14474,"_27550":50782,"_2978":50887},[],"unbound persistent volume;",{"_3496":456,"_30262":409,"_21040":50889,"_5":14474,"_27550":50782,"_2978":50890},[],"inaccessible image or incorrect pull policy;",{"_3496":457,"_30262":409,"_21040":50892,"_5":14474,"_27550":50782,"_2978":50893},[],"invalid cryptographic engine configuration;",{"_3496":458,"_30262":409,"_21040":50895,"_5":14474,"_27550":50782,"_2978":50896},[],"CPU or memory limits set too low;",{"_3496":459,"_30262":409,"_21040":50898,"_5":14474,"_27550":50782,"_2978":50899},[],"an incomplete prior migration.",{"_3496":460,"_30262":409,"_21040":50901,"_5":14474,"_27550":50782,"_2978":50902},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3496":461,"_30262":409,"_21040":50904,"_5":14474,"_27550":50782,"_2978":50905},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3496":462,"_30262":409,"_21040":50907,"_5":14474,"_27550":50782,"_2978":50908},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3496":463,"_30262":409,"_21040":50910,"_5":14474,"_27550":50786,"_2978":50911},[],"Domain and audit events depend on the bus publisher:",{"_3496":464,"_30262":409,"_21040":50913,"_5":14474,"_27550":50786,"_2978":50914},[],"verify it is enabled in the emitting service;",{"_3496":465,"_30262":409,"_21040":50916,"_5":14474,"_27550":50786,"_2978":50917},[],"check AMQP connectivity and credentials;",{"_3496":466,"_30262":409,"_21040":50919,"_5":14474,"_27550":50786,"_2978":50920},[],"review exchange, routing key, queues and consumers;",{"_3496":467,"_30262":409,"_21040":50922,"_5":14474,"_27550":50786,"_2978":50923},[],"inspect dead-letter queues;",{"_3496":468,"_30262":409,"_21040":50925,"_5":14474,"_27550":50786,"_2978":50926},[],"alert on orphan durable queues and backlog growth.",{"_3496":469,"_30262":409,"_21040":50928,"_5":14474,"_27550":50786,"_2978":50929},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3496":470,"_30262":409,"_21040":50931,"_5":14474,"_27550":50786,"_2978":50932},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3496":471,"_30262":409,"_21040":50934,"_5":14474,"_27550":50786,"_2978":50935},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3496":472,"_30262":409,"_21040":50937,"_5":14474,"_27550":50786,"_2978":50938},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3496":473,"_30262":409,"_21040":50940,"_5":14474,"_27550":50786,"_2978":50941},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3496":474,"_30262":409,"_21040":50943,"_5":14474,"_27550":50786,"_2978":50944},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3496":475,"_30262":409,"_21040":50946,"_5":14474,"_27550":50786,"_2978":50947},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3496":476,"_30262":409,"_21040":50949,"_5":14474,"_27550":50790,"_2978":50950},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3496":477,"_30262":409,"_21040":50952,"_5":14474,"_27550":50790,"_2978":50953},[],"Before closing an incident, record:",{"_3496":478,"_30262":409,"_21040":50955,"_5":14474,"_27550":50790,"_2978":50956},[],"the confirmed cause;",{"_3496":479,"_30262":409,"_21040":50958,"_5":14474,"_27550":50790,"_2978":50959},[],"the time scope and affected resources;",{"_3496":480,"_30262":409,"_21040":50961,"_5":14474,"_27550":50790,"_2978":50962},[],"the commands or queries used;",{"_3496":481,"_30262":409,"_21040":50964,"_5":14474,"_27550":50790,"_2978":50965},[],"the applied change and how to revert it;",{"_3496":482,"_30262":409,"_21040":50967,"_5":14474,"_27550":50790,"_2978":50968},[],"validation from a consumer;",{"_3496":483,"_30262":409,"_21040":50970,"_5":14474,"_27550":50790,"_2978":50971},[],"the preventive action and its owner.",{"_3496":484,"_30262":484,"_5":14825,"_2978":50973,"_30620":50974,"_21040":50977,"_27550":484},"Access control",[49507,50975,50976],"Platform","Administration",[],{"_3496":485,"_30262":484,"_21040":50979,"_5":14474,"_27550":484,"_2978":50980},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3496":486,"_30262":484,"_5":30617,"_21040":50982,"_27550":50983,"_2978":50984},[],"/docs/pr-preview/pr-61/platform/administration/access-control#essential-concepts","Essential concepts",{"_3496":487,"_30262":484,"_5":30617,"_21040":50986,"_27550":50987,"_2978":50988},[],"/docs/pr-preview/pr-61/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3496":488,"_30262":484,"_5":30617,"_21040":50990,"_27550":50991,"_2978":50992},[],"/docs/pr-preview/pr-61/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3496":489,"_30262":484,"_5":30617,"_21040":50994,"_27550":50995,"_2978":50996},[],"/docs/pr-preview/pr-61/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3496":490,"_30262":484,"_5":30617,"_21040":50998,"_27550":50999,"_2978":51000},[],"/docs/pr-preview/pr-61/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3496":491,"_30262":484,"_5":30617,"_21040":51002,"_27550":51003,"_2978":51004},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3496":492,"_30262":484,"_5":30617,"_21040":51006,"_27550":51007,"_2978":51008},[],"/docs/pr-preview/pr-61/platform/administration/access-control#oidc-principals","OIDC principals",{"_3496":493,"_30262":484,"_5":30617,"_21040":51010,"_27550":51011,"_2978":51012},[],"/docs/pr-preview/pr-61/platform/administration/access-control#x509-principals","X.509 principals",{"_3496":494,"_30262":484,"_5":30617,"_21040":51014,"_27550":51015,"_2978":51016},[],"/docs/pr-preview/pr-61/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3496":495,"_30262":484,"_5":30617,"_21040":51018,"_27550":51019,"_2978":51020},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3496":496,"_30262":484,"_5":30617,"_21040":51022,"_27550":51023,"_2978":51024},[],"/docs/pr-preview/pr-61/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3496":497,"_30262":484,"_5":30617,"_21040":51026,"_27550":51027,"_2978":51028},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3496":498,"_30262":484,"_5":30617,"_21040":51030,"_27550":51031,"_2978":51032},[],"/docs/pr-preview/pr-61/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3496":499,"_30262":484,"_5":30617,"_21040":51034,"_27550":51035,"_2978":51036},[],"/docs/pr-preview/pr-61/platform/administration/access-control#http-rules","HTTP rules",{"_3496":500,"_30262":484,"_5":30617,"_21040":51038,"_27550":51039,"_2978":51040},[],"/docs/pr-preview/pr-61/platform/administration/access-control#included-policies","Included policies",{"_3496":501,"_30262":484,"_5":30617,"_21040":51042,"_27550":51043,"_2978":50147},[],"/docs/pr-preview/pr-61/platform/administration/access-control#provision-the-first-administrator",{"_3496":502,"_30262":484,"_5":30617,"_21040":51045,"_27550":51046,"_2978":51047},[],"/docs/pr-preview/pr-61/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3496":503,"_30262":484,"_5":30617,"_21040":51049,"_27550":51050,"_2978":51051},[],"/docs/pr-preview/pr-61/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3496":504,"_30262":484,"_5":30617,"_21040":51053,"_27550":51054,"_2978":51055},[],"/docs/pr-preview/pr-61/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3496":505,"_30262":484,"_5":30617,"_21040":51057,"_27550":51058,"_2978":51059},[],"/docs/pr-preview/pr-61/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3496":506,"_30262":484,"_5":30617,"_21040":51061,"_27550":51062,"_2978":51063},[],"/docs/pr-preview/pr-61/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3496":507,"_30262":484,"_5":30617,"_21040":51065,"_27550":51066,"_2978":51067},[],"/docs/pr-preview/pr-61/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3496":508,"_30262":484,"_5":30617,"_21040":51069,"_27550":51070,"_2978":51071},[],"/docs/pr-preview/pr-61/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3496":509,"_30262":484,"_5":30617,"_21040":51073,"_27550":51074,"_2978":51075},[],"/docs/pr-preview/pr-61/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3496":510,"_30262":484,"_5":30617,"_21040":51077,"_27550":51078,"_2978":51079},[],"/docs/pr-preview/pr-61/platform/administration/access-control#operational-checklist","Operational checklist",{"_3496":511,"_30262":484,"_5":30617,"_21040":51081,"_27550":51082,"_2978":51083},[],"/docs/pr-preview/pr-61/platform/administration/access-control#diagnostics","Diagnostics",{"_3496":512,"_30262":484,"_5":30617,"_21040":51085,"_27550":51086,"_2978":51087},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-401","The response is 401",{"_3496":513,"_30262":484,"_5":30617,"_21040":51089,"_27550":51090,"_2978":51091},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-403","The response is 403",{"_3496":514,"_30262":484,"_5":30617,"_21040":51093,"_27550":51094,"_2978":51095},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3496":515,"_30262":484,"_5":30617,"_21040":51097,"_27550":51098,"_2978":51099},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3496":516,"_30262":484,"_5":30617,"_21040":51101,"_27550":51102,"_2978":51103},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3496":517,"_30262":484,"_21040":51105,"_5":14474,"_27550":484,"_2978":51106},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3496":518,"_30262":484,"_21040":51108,"_5":14474,"_27550":484,"_2978":51109},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3496":519,"_30262":484,"_21040":51111,"_5":14474,"_27550":484,"_2978":51112},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3496":520,"_30262":484,"_21040":51114,"_5":14474,"_27550":50983,"_2978":51115},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3496":521,"_30262":484,"_21040":51117,"_5":14474,"_27550":50983,"_2978":51118},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3496":522,"_30262":484,"_21040":51120,"_5":14474,"_27550":50983,"_2978":51121},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3496":523,"_30262":484,"_21040":51123,"_5":14474,"_27550":50983,"_2978":51124},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3496":524,"_30262":484,"_21040":51126,"_5":14474,"_27550":50983,"_2978":51127},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3496":525,"_30262":484,"_21040":51129,"_5":14474,"_27550":50983,"_2978":51130},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3496":526,"_30262":484,"_21040":51132,"_5":14474,"_27550":50987,"_2978":51133},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3496":527,"_30262":484,"_21040":51135,"_5":14474,"_27550":50987,"_2978":51136},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3496":528,"_30262":484,"_21040":51138,"_5":14474,"_27550":50991,"_2978":51139},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3496":529,"_30262":484,"_21040":51141,"_5":14474,"_27550":50991,"_2978":51142},[],"The decision is made **before forwarding the request to the service**:",{"_3496":530,"_30262":484,"_21040":51144,"_5":14474,"_27550":50991,"_2978":51145},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3496":531,"_30262":484,"_21040":51147,"_5":14474,"_27550":50991,"_2978":51148},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3496":532,"_30262":484,"_21040":51150,"_5":14474,"_27550":50991,"_2978":51151},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3496":533,"_30262":484,"_21040":51153,"_5":14474,"_27550":50991,"_2978":51154},[],"It separately loads the policies granted to each principal.",{"_3496":534,"_30262":484,"_21040":51156,"_5":14474,"_27550":50991,"_2978":51157},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3496":535,"_30262":484,"_21040":51159,"_5":14474,"_27550":50991,"_2978":51160},[],"`authz` looks for an HTTP rule granting that action.",{"_3496":536,"_30262":484,"_21040":51162,"_5":14474,"_27550":50991,"_2978":51163},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3496":537,"_30262":484,"_21040":51165,"_5":14474,"_27550":50991,"_2978":51166},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3496":538,"_30262":484,"_21040":51168,"_5":14474,"_27550":50991,"_2978":51169},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3496":539,"_30262":484,"_21040":51171,"_5":14474,"_27550":50991,"_2978":51172},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3496":540,"_30262":484,"_21040":51174,"_5":14474,"_27550":50995,"_2978":51175},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3496":541,"_30262":484,"_21040":51177,"_5":14474,"_27550":50995,"_2978":51178},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3496":542,"_30262":484,"_21040":51180,"_5":14474,"_27550":50995,"_2978":51181},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3496":543,"_30262":484,"_21040":51183,"_5":14474,"_27550":50995,"_2978":51184},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3496":544,"_30262":484,"_21040":51186,"_5":14474,"_27550":50995,"_2978":51187},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3496":545,"_30262":484,"_21040":51189,"_5":14474,"_27550":50995,"_2978":51190},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3496":546,"_30262":484,"_21040":51192,"_5":14474,"_27550":50995,"_2978":51193},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3496":547,"_30262":484,"_21040":51195,"_5":14474,"_27550":50995,"_2978":51196},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3496":548,"_30262":484,"_21040":51198,"_5":14474,"_27550":50999,"_2978":51199},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3496":549,"_30262":484,"_21040":51201,"_5":14474,"_27550":50999,"_2978":51202},[],"The decision is made with the domain operation context:",{"_3496":550,"_30262":484,"_21040":51204,"_5":14474,"_27550":50999,"_2978":51205},[],"The middleware extracts the credential and resolves the matching principals.",{"_3496":551,"_30262":484,"_21040":51207,"_5":14474,"_27550":50999,"_2978":51208},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3496":552,"_30262":484,"_21040":51210,"_5":14474,"_27550":50999,"_2978":51211},[],"`authz` gathers the entity rules of the granted policies.",{"_3496":553,"_30262":484,"_21040":51213,"_5":14474,"_27550":50999,"_2978":51214},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3496":554,"_30262":484,"_21040":51216,"_5":14474,"_27550":50999,"_2978":51217},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3496":555,"_30262":484,"_21040":51219,"_5":14474,"_27550":50999,"_2978":51220},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3496":556,"_30262":484,"_21040":51222,"_5":14474,"_27550":50999,"_2978":51223},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3496":557,"_30262":484,"_21040":51225,"_5":14474,"_27550":50999,"_2978":51226},[],"Actions fall into two groups:",{"_3496":558,"_30262":484,"_21040":51228,"_5":14474,"_27550":50999,"_2978":51229},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3496":559,"_30262":484,"_21040":51231,"_5":14474,"_27550":50999,"_2978":51232},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3496":560,"_30262":484,"_21040":51234,"_5":14474,"_27550":50999,"_2978":51235},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3496":561,"_30262":484,"_21040":51237,"_5":14474,"_27550":51003,"_2978":51238},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3496":562,"_30262":484,"_21040":51240,"_5":14474,"_27550":51003,"_2978":51241},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3496":563,"_30262":484,"_21040":51243,"_5":14474,"_27550":51003,"_2978":51244},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3496":564,"_30262":484,"_21040":51246,"_5":14474,"_27550":51007,"_2978":51247},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3496":565,"_30262":484,"_21040":51249,"_5":14474,"_27550":51007,"_2978":51250},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3496":566,"_30262":484,"_21040":51252,"_5":14474,"_27550":51007,"_2978":51253},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3496":567,"_30262":484,"_21040":51255,"_5":14474,"_27550":51007,"_2978":51256},[],"The implemented operators are:",{"_3496":568,"_30262":484,"_21040":51258,"_5":14474,"_27550":51007,"_2978":51259},[],"`equals`, for exact equality;",{"_3496":569,"_30262":484,"_21040":51261,"_5":14474,"_27550":51007,"_2978":51262},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3496":570,"_30262":484,"_21040":51264,"_5":14474,"_27550":51007,"_2978":51265},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3496":571,"_30262":484,"_21040":51267,"_5":14474,"_27550":51007,"_2978":51268},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3496":572,"_30262":484,"_21040":51270,"_5":14474,"_27550":51011,"_2978":51271},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3496":573,"_30262":484,"_21040":51273,"_5":14474,"_27550":51011,"_2978":51274},[],"The available modes are:",{"_3496":574,"_30262":484,"_21040":51276,"_5":14474,"_27550":51011,"_2978":51277},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3496":575,"_30262":484,"_21040":51279,"_5":14474,"_27550":51011,"_2978":51280},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3496":576,"_30262":484,"_21040":51282,"_5":14474,"_27550":51011,"_2978":51283},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3496":577,"_30262":484,"_21040":51285,"_5":14474,"_27550":51011,"_2978":51286},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3496":578,"_30262":484,"_21040":51288,"_5":14474,"_27550":51011,"_2978":51289},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3496":579,"_30262":484,"_21040":51291,"_5":14474,"_27550":51011,"_2978":51292},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3496":580,"_30262":484,"_21040":51294,"_5":14474,"_27550":51015,"_2978":51295},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3496":581,"_30262":484,"_21040":51297,"_5":14474,"_27550":51015,"_2978":51298},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3496":582,"_30262":484,"_21040":51300,"_5":14474,"_27550":51015,"_2978":51301},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3496":583,"_30262":484,"_21040":51303,"_5":14474,"_27550":51015,"_2978":51304},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3496":584,"_30262":484,"_21040":51306,"_5":14474,"_27550":51023,"_2978":51307},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3496":585,"_30262":484,"_21040":51309,"_5":14474,"_27550":51023,"_2978":51310},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3496":586,"_30262":484,"_21040":51312,"_5":14474,"_27550":51027,"_2978":51313},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3496":587,"_30262":484,"_21040":51315,"_5":14474,"_27550":51027,"_2978":51316},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3496":588,"_30262":484,"_21040":51318,"_5":14474,"_27550":51031,"_2978":51319},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3496":589,"_30262":484,"_21040":51321,"_5":14474,"_27550":51031,"_2978":51322},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3496":590,"_30262":484,"_21040":51324,"_5":14474,"_27550":51031,"_2978":51325},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3496":591,"_30262":484,"_21040":51327,"_5":14474,"_27550":51035,"_2978":51328},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3496":592,"_30262":484,"_21040":51330,"_5":14474,"_27550":51035,"_2978":51331},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3496":593,"_30262":484,"_21040":51333,"_5":14474,"_27550":51035,"_2978":51334},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3496":594,"_30262":484,"_21040":51336,"_5":14474,"_27550":51035,"_2978":51337},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3496":595,"_30262":484,"_21040":51339,"_5":14474,"_27550":51035,"_2978":51340},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3496":596,"_30262":484,"_21040":51342,"_5":14474,"_27550":51035,"_2978":51343},[],"Note that:",{"_3496":597,"_30262":484,"_21040":51345,"_5":14474,"_27550":51035,"_2978":51346},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3496":598,"_30262":484,"_21040":51348,"_5":14474,"_27550":51035,"_2978":51349},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3496":599,"_30262":484,"_21040":51351,"_5":14474,"_27550":51035,"_2978":51352},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3496":600,"_30262":484,"_21040":51354,"_5":14474,"_27550":51039,"_2978":51355},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3496":601,"_30262":484,"_21040":51357,"_5":14474,"_27550":51039,"_2978":51358},[],"full and read-only access to certificates and authorities;",{"_3496":602,"_30262":484,"_21040":51360,"_5":14474,"_27550":51039,"_2978":51361},[],"full and read-only access to the KMS;",{"_3496":603,"_30262":484,"_21040":51363,"_5":14474,"_27550":51039,"_2978":51364},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3496":604,"_30262":484,"_21040":51366,"_5":14474,"_27550":51039,"_2978":51367},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3496":605,"_30262":484,"_21040":51369,"_5":14474,"_27550":51039,"_2978":51370},[],"console access;",{"_3496":606,"_30262":484,"_21040":51372,"_5":14474,"_27550":51039,"_2978":51373},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3496":607,"_30262":484,"_21040":51375,"_5":14474,"_27550":51039,"_2978":51376},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3496":608,"_30262":484,"_21040":51378,"_5":14474,"_27550":51039,"_2978":51379},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3496":609,"_30262":484,"_21040":51381,"_5":14474,"_27550":51043,"_2978":51382},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3496":610,"_30262":484,"_21040":51384,"_5":14474,"_27550":51043,"_2978":51385},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3496":611,"_30262":484,"_21040":51387,"_5":14474,"_27550":51043,"_2978":51388},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3496":612,"_30262":484,"_21040":51390,"_5":14474,"_27550":51046,"_2978":51391},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3496":613,"_30262":484,"_21040":51393,"_5":14474,"_27550":51050,"_2978":51394},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3496":614,"_30262":484,"_21040":51396,"_5":14474,"_27550":51050,"_2978":51397},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3496":615,"_30262":484,"_21040":51399,"_5":14474,"_27550":51054,"_2978":51400},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3496":616,"_30262":484,"_21040":51402,"_5":14474,"_27550":51058,"_2978":51403},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3496":617,"_30262":484,"_21040":51405,"_5":14474,"_27550":51062,"_2978":51406},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3496":618,"_30262":484,"_21040":51408,"_5":14474,"_27550":51066,"_2978":51409},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3496":619,"_30262":484,"_21040":51411,"_5":14474,"_27550":51066,"_2978":51412},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3496":620,"_30262":484,"_21040":51414,"_5":14474,"_27550":51070,"_2978":51415},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3496":621,"_30262":484,"_21040":51417,"_5":14474,"_27550":51070,"_2978":51418},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3496":622,"_30262":484,"_21040":51420,"_5":14474,"_27550":51070,"_2978":51421},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3496":623,"_30262":484,"_21040":51423,"_5":14474,"_27550":51070,"_2978":51424},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3496":624,"_30262":484,"_21040":51426,"_5":14474,"_27550":51070,"_2978":51427},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3496":625,"_30262":484,"_21040":51429,"_5":14474,"_27550":51070,"_2978":51430},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3496":626,"_30262":484,"_21040":51432,"_5":14474,"_27550":51070,"_2978":51433},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3496":627,"_30262":484,"_21040":51435,"_5":14474,"_27550":51070,"_2978":51436},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3496":628,"_30262":484,"_21040":51438,"_5":14474,"_27550":51074,"_2978":51439},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3496":629,"_30262":484,"_21040":51441,"_5":14474,"_27550":51074,"_2978":51442},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3496":630,"_30262":484,"_21040":51444,"_5":14474,"_27550":51074,"_2978":51445},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3496":631,"_30262":484,"_21040":51447,"_5":14474,"_27550":51078,"_2978":51448},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3496":632,"_30262":484,"_21040":51450,"_5":14474,"_27550":51078,"_2978":51451},[],"Use groups or stable roles for people and independent identities for automations.",{"_3496":633,"_30262":484,"_21040":51453,"_5":14474,"_27550":51078,"_2978":51454},[],"Keep at least two recovery administrators and test their access periodically.",{"_3496":634,"_30262":484,"_21040":51456,"_5":14474,"_27550":51078,"_2978":51457},[],"Review active principals, their matches and their grants after IdP changes.",{"_3496":635,"_30262":484,"_21040":51459,"_5":14474,"_27550":51078,"_2978":51460},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3496":636,"_30262":484,"_21040":51462,"_5":14474,"_27550":51078,"_2978":51463},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3496":637,"_30262":484,"_21040":51465,"_5":14474,"_27550":51078,"_2978":51466},[],"Always test one allowed and one denied operation for each role.",{"_3496":638,"_30262":484,"_21040":51468,"_5":14474,"_27550":51078,"_2978":51469},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3496":639,"_30262":484,"_21040":51471,"_5":14474,"_27550":51086,"_2978":51472},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3496":640,"_30262":484,"_21040":51474,"_5":14474,"_27550":51090,"_2978":51475},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3496":641,"_30262":484,"_21040":51477,"_5":14474,"_27550":51090,"_2978":51478},[],"that an active principal of the correct type exists;",{"_3496":642,"_30262":484,"_21040":51480,"_5":14474,"_27550":51090,"_2978":51481},[],"that the claim paths and values match the real token exactly;",{"_3496":643,"_30262":484,"_21040":51483,"_5":14474,"_27550":51090,"_2978":51484},[],"that all of the principal's conditions hold;",{"_3496":644,"_30262":484,"_21040":51486,"_5":14474,"_27550":51090,"_2978":51487},[],"that the principal has the expected policy granted;",{"_3496":645,"_30262":484,"_21040":51489,"_5":14474,"_27550":51090,"_2978":51490},[],"that the policy includes the action and the requested resource type or route;",{"_3496":646,"_30262":484,"_21040":51492,"_5":14474,"_27550":51090,"_2978":51493},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3496":647,"_30262":484,"_21040":51495,"_5":14474,"_27550":51090,"_2978":51496},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3496":648,"_30262":484,"_21040":51498,"_5":14474,"_27550":51094,"_2978":51499},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3496":649,"_30262":484,"_21040":51501,"_5":14474,"_27550":51098,"_2978":51502},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3496":650,"_30262":484,"_21040":51504,"_5":14474,"_27550":51102,"_2978":51505},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3496":651,"_30262":484,"_21040":51507,"_5":14474,"_27550":51102,"_2978":51508},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3496":652,"_30262":652,"_5":14825,"_2978":51510,"_30620":51511,"_21040":51512,"_27550":652},"Alerts and subscriptions",[49507,50975,50976],[],{"_3496":653,"_30262":652,"_21040":51514,"_5":14474,"_27550":652,"_2978":51515},[],"Send PKI events to people and external systems.",{"_3496":654,"_30262":652,"_5":30617,"_21040":51517,"_27550":51518,"_2978":51519},[],"/docs/pr-preview/pr-61/platform/administration/alerts#how-it-works","How it works",{"_3496":655,"_30262":652,"_5":30617,"_21040":51521,"_27550":51522,"_2978":51523},[],"/docs/pr-preview/pr-61/platform/administration/alerts#available-channels","Available channels",{"_3496":656,"_30262":652,"_5":30617,"_21040":51525,"_27550":51526,"_2978":51527},[],"/docs/pr-preview/pr-61/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3496":657,"_30262":652,"_5":30617,"_21040":51529,"_27550":51530,"_2978":51531},[],"/docs/pr-preview/pr-61/platform/administration/alerts#choose-the-event","Choose the event",{"_3496":658,"_30262":652,"_5":30617,"_21040":51533,"_27550":51534,"_2978":51535},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3496":659,"_30262":652,"_5":30617,"_21040":51537,"_27550":51538,"_2978":51539},[],"/docs/pr-preview/pr-61/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3496":660,"_30262":652,"_5":30617,"_21040":51541,"_27550":51542,"_2978":51543},[],"/docs/pr-preview/pr-61/platform/administration/alerts#review-and-activate","Review and activate",{"_3496":661,"_30262":652,"_5":30617,"_21040":51545,"_27550":51546,"_2978":51547},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3496":662,"_30262":652,"_5":30617,"_21040":51549,"_27550":51550,"_2978":51551},[],"/docs/pr-preview/pr-61/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3496":663,"_30262":652,"_5":30617,"_21040":51553,"_27550":51554,"_2978":51555},[],"/docs/pr-preview/pr-61/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3496":664,"_30262":652,"_5":30617,"_21040":51557,"_27550":51558,"_2978":51559},[],"/docs/pr-preview/pr-61/platform/administration/alerts#event-families","Event families",{"_3496":665,"_30262":652,"_21040":51561,"_5":14474,"_27550":652,"_2978":51562},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3496":666,"_30262":652,"_21040":51564,"_5":14474,"_27550":51518,"_2978":51565},[],"A service publishes a domain event.",{"_3496":667,"_30262":652,"_21040":51567,"_5":14474,"_27550":51518,"_2978":51568},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3496":668,"_30262":652,"_21040":51570,"_5":14474,"_27550":51518,"_2978":51571},[],"Each subscription's filter decides whether it should be notified.",{"_3496":669,"_30262":652,"_21040":51573,"_5":14474,"_27550":51518,"_2978":51574},[],"Lamassu delivers the event to the configured channel.",{"_3496":670,"_30262":652,"_21040":51576,"_5":14474,"_27550":51518,"_2978":51577},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3496":671,"_30262":652,"_21040":51579,"_5":14474,"_27550":51522,"_2978":51580},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3496":672,"_30262":652,"_21040":51582,"_5":14474,"_27550":51522,"_2978":51583},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3496":673,"_30262":652,"_21040":51585,"_5":14474,"_27550":51522,"_2978":51586},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3496":674,"_30262":652,"_21040":51588,"_5":14474,"_27550":51522,"_2978":51589},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3496":675,"_30262":652,"_21040":51591,"_5":14474,"_27550":51522,"_2978":51592},[],"`apikey_options` requires `header` and `key`.",{"_3496":676,"_30262":652,"_21040":51594,"_5":14474,"_27550":51522,"_2978":51595},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3496":677,"_30262":652,"_21040":51597,"_5":14474,"_27550":51522,"_2978":51598},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3496":678,"_30262":652,"_21040":51600,"_5":14474,"_27550":51522,"_2978":51601},[],"The alerts API reference documents the full `http_client` schema.",{"_3496":679,"_30262":652,"_21040":51603,"_5":14474,"_27550":51530,"_2978":51604},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3496":680,"_30262":652,"_21040":51606,"_5":14474,"_27550":51534,"_2978":51607},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3496":681,"_30262":652,"_21040":51609,"_5":14474,"_27550":51538,"_2978":51610},[],"Add a filter if you don't want to receive every instance of the event.",{"_3496":682,"_30262":652,"_21040":51612,"_5":14474,"_27550":51538,"_2978":51613},[],"**None** notifies all instances of the event.",{"_3496":683,"_30262":652,"_21040":51615,"_5":14474,"_27550":51538,"_2978":51616},[],"**JSON Path** evaluates one or more specific fields.",{"_3496":684,"_30262":652,"_21040":51618,"_5":14474,"_27550":51538,"_2978":51619},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3496":685,"_30262":652,"_21040":51621,"_5":14474,"_27550":51538,"_2978":51622},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3496":686,"_30262":652,"_21040":51624,"_5":14474,"_27550":51538,"_2978":51625},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3496":687,"_30262":652,"_21040":51627,"_5":14474,"_27550":51538,"_2978":51628},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3496":688,"_30262":652,"_21040":51630,"_5":14474,"_27550":51542,"_2978":51631},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3496":689,"_30262":652,"_21040":51633,"_5":14474,"_27550":51546,"_2978":51634},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3496":690,"_30262":652,"_21040":51636,"_5":14474,"_27550":51546,"_2978":51637},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3496":691,"_30262":652,"_21040":51639,"_5":14474,"_27550":51546,"_2978":51640},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3496":692,"_30262":652,"_21040":51642,"_5":14474,"_27550":51546,"_2978":51643},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3496":693,"_30262":652,"_21040":51645,"_5":14474,"_27550":51546,"_2978":51646},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3496":694,"_30262":652,"_21040":51648,"_5":14474,"_27550":51546,"_2978":51649},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3496":695,"_30262":652,"_21040":51651,"_5":14474,"_27550":51546,"_2978":51652},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3496":696,"_30262":652,"_21040":51654,"_5":14474,"_27550":51546,"_2978":51655},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3496":697,"_30262":652,"_21040":51657,"_5":14474,"_27550":51550,"_2978":51658},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3496":698,"_30262":652,"_21040":51660,"_5":14474,"_27550":51550,"_2978":51661},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3496":699,"_30262":652,"_21040":51663,"_5":14474,"_27550":51550,"_2978":51664},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3496":700,"_30262":652,"_21040":51666,"_5":14474,"_27550":51550,"_2978":51667},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3496":701,"_30262":652,"_21040":51669,"_5":14474,"_27550":51550,"_2978":51670},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3496":702,"_30262":652,"_21040":51672,"_5":14474,"_27550":51550,"_2978":51673},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3496":703,"_30262":652,"_21040":51675,"_5":14474,"_27550":51550,"_2978":51676},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3496":704,"_30262":652,"_21040":51678,"_5":14474,"_27550":51550,"_2978":51679},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3496":705,"_30262":652,"_21040":51681,"_5":14474,"_27550":51554,"_2978":51682},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3496":706,"_30262":652,"_21040":51684,"_5":14474,"_27550":51554,"_2978":51685},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3496":707,"_30262":652,"_21040":51687,"_5":14474,"_27550":51558,"_2978":51688},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3496":708,"_30262":652,"_21040":51690,"_5":14474,"_27550":51558,"_2978":51691},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3496":709,"_30262":652,"_21040":51693,"_5":14474,"_27550":51558,"_2978":51694},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3496":710,"_30262":652,"_21040":51696,"_5":14474,"_27550":51558,"_2978":51697},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3496":711,"_30262":652,"_21040":51699,"_5":14474,"_27550":51558,"_2978":51700},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3496":712,"_30262":652,"_21040":51702,"_5":14474,"_27550":51558,"_2978":51703},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3496":713,"_30262":652,"_21040":51705,"_5":14474,"_27550":51558,"_2978":51706},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3496":714,"_30262":652,"_21040":51708,"_5":14474,"_27550":51558,"_2978":51709},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3496":715,"_30262":652,"_21040":51711,"_5":14474,"_27550":51558,"_2978":51712},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3496":716,"_30262":716,"_5":14825,"_2978":51714,"_30620":51715,"_21040":51716,"_27550":716},"Audit logs",[49507,50975,50976],[],{"_3496":717,"_30262":716,"_21040":51718,"_5":14474,"_27550":716,"_2978":51719},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3496":718,"_30262":716,"_5":30617,"_21040":51721,"_27550":51722,"_2978":51723},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3496":719,"_30262":716,"_5":30617,"_21040":51725,"_27550":51726,"_2978":51727},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#coverage","Coverage",{"_3496":720,"_30262":716,"_5":30617,"_21040":51729,"_27550":51730,"_2978":51731},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3496":721,"_30262":716,"_5":30617,"_21040":51733,"_27550":51734,"_2978":51735},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3496":722,"_30262":716,"_5":30617,"_21040":51737,"_27550":51738,"_2978":51739},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3496":723,"_30262":716,"_5":30617,"_21040":51741,"_27550":51742,"_2978":51743},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3496":724,"_30262":716,"_5":30617,"_21040":51745,"_27550":51746,"_2978":51747},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3496":725,"_30262":716,"_5":30617,"_21040":51749,"_27550":51750,"_2978":51751},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3496":726,"_30262":716,"_5":30617,"_21040":51753,"_27550":51754,"_2978":51755},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3496":727,"_30262":716,"_5":30617,"_21040":51757,"_27550":51758,"_2978":51759},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3496":728,"_30262":716,"_5":30617,"_21040":51761,"_27550":51762,"_2978":51763},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3496":729,"_30262":716,"_21040":51765,"_5":14474,"_27550":716,"_2978":51766},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3496":730,"_30262":716,"_21040":51768,"_5":14474,"_27550":51722,"_2978":51769},[],"The audit body includes:",{"_3496":731,"_30262":716,"_21040":51771,"_5":14474,"_27550":51722,"_2978":51772},[],"input: data received by the operation;",{"_3496":732,"_30262":716,"_21040":51774,"_5":14474,"_27550":51722,"_2978":51775},[],"has\\_error: whether the service returned an error;",{"_3496":733,"_30262":716,"_21040":51777,"_5":14474,"_27550":51722,"_2978":51778},[],"output: produced result or error message;",{"_3496":734,"_30262":716,"_21040":51780,"_5":14474,"_27550":51722,"_2978":51781},[],"principals: identifiers of the principals that matched the request.",{"_3496":735,"_30262":716,"_21040":51783,"_5":14474,"_27550":51722,"_2978":51784},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3496":736,"_30262":716,"_21040":51786,"_5":14474,"_27550":51722,"_2978":51787},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3496":737,"_30262":716,"_21040":51789,"_5":14474,"_27550":51726,"_2978":51790},[],"The backend applies auditing to mutations of:",{"_3496":738,"_30262":716,"_21040":51792,"_5":14474,"_27550":51726,"_2978":51793},[],"authorities, certificates and issuance profiles;",{"_3496":739,"_30262":716,"_21040":51795,"_5":14474,"_27550":51726,"_2978":51796},[],"keys and KMS engines;",{"_3496":740,"_30262":716,"_21040":51798,"_5":14474,"_27550":51726,"_2978":51799},[],"devices and identities;",{"_3496":741,"_30262":716,"_21040":51801,"_5":14474,"_27550":51726,"_2978":51802},[],"DMSs and enrollment operations;",{"_3496":742,"_30262":716,"_21040":51804,"_5":14474,"_27550":51726,"_2978":51805},[],"validation functions and CRL;",{"_3496":743,"_30262":716,"_21040":51807,"_5":14474,"_27550":51726,"_2978":51808},[],"principals, policies and authorization grants.",{"_3496":744,"_30262":716,"_21040":51810,"_5":14474,"_27550":51726,"_2978":51811},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3496":745,"_30262":716,"_21040":51813,"_5":14474,"_27550":51730,"_2978":51814},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3496":746,"_30262":716,"_21040":51816,"_5":14474,"_27550":51730,"_2978":51817},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3496":747,"_30262":716,"_21040":51819,"_5":14474,"_27550":51730,"_2978":51820},[],"Design the consumer to:",{"_3496":748,"_30262":716,"_21040":51822,"_5":14474,"_27550":51730,"_2978":51823},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3496":749,"_30262":716,"_21040":51825,"_5":14474,"_27550":51730,"_2978":51826},[],"keep the complete CloudEvent unmodified;",{"_3496":750,"_30262":716,"_21040":51828,"_5":14474,"_27550":51730,"_2978":51829},[],"record the ingestion time and detect duplicates by ID;",{"_3496":751,"_30262":716,"_21040":51831,"_5":14474,"_27550":51730,"_2978":51832},[],"encrypt in transit and at rest;",{"_3496":752,"_30262":716,"_21040":51834,"_5":14474,"_27550":51730,"_2978":51835},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3496":753,"_30262":716,"_21040":51837,"_5":14474,"_27550":51730,"_2978":51838},[],"apply an explicit retention and legal hold policy;",{"_3496":754,"_30262":716,"_21040":51840,"_5":14474,"_27550":51730,"_2978":51841},[],"alert if it stops consuming or the pending queue grows.",{"_3496":755,"_30262":716,"_21040":51843,"_5":14474,"_27550":51734,"_2978":51844},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3496":756,"_30262":716,"_21040":51846,"_5":14474,"_27550":51734,"_2978":51847},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3496":757,"_30262":716,"_21040":51849,"_5":14474,"_27550":51742,"_2978":51850},[],"Start from the reported time and normalize every source to UTC.",{"_3496":758,"_30262":716,"_21040":51852,"_5":14474,"_27550":51746,"_2978":51853},[],"Filter by event type, service source and resource identifier.",{"_3496":759,"_30262":716,"_21040":51855,"_5":14474,"_27550":51750,"_2978":51856},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3496":760,"_30262":716,"_21040":51858,"_5":14474,"_27550":51754,"_2978":51859},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3496":761,"_30262":716,"_21040":51861,"_5":14474,"_27550":51758,"_2978":51862},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3496":762,"_30262":716,"_21040":51864,"_5":14474,"_27550":51762,"_2978":51865},[],"Generate a controlled mutation in a test environment and check that:",{"_3496":763,"_30262":716,"_21040":51867,"_5":14474,"_27550":51762,"_2978":51868},[],"a successful audit event appears;",{"_3496":764,"_30262":716,"_21040":51870,"_5":14474,"_27550":51762,"_2978":51871},[],"the principal matches the identity used;",{"_3496":765,"_30262":716,"_21040":51873,"_5":14474,"_27550":51762,"_2978":51874},[],"the consumer persists it exactly once;",{"_3496":766,"_30262":716,"_21040":51876,"_5":14474,"_27550":51762,"_2978":51877},[],"it can be retrieved by resource, actor and period;",{"_3496":767,"_30262":716,"_21040":51879,"_5":14474,"_27550":51762,"_2978":51880},[],"a consumer outage raises an alert.",{"_3496":768,"_30262":716,"_21040":51882,"_5":14474,"_27550":51762,"_2978":51883},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3496":769,"_30262":769,"_5":14825,"_2978":51885,"_30620":51886,"_21040":51887,"_27550":769},"Platform architecture",[49507,50975],[],{"_3496":770,"_30262":769,"_21040":51889,"_5":14474,"_27550":769,"_2978":51890},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3496":771,"_30262":769,"_5":30617,"_21040":51892,"_27550":51893,"_2978":51894},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#control-plane","Control plane",{"_3496":772,"_30262":769,"_5":30617,"_21040":51896,"_27550":51897,"_2978":51898},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3496":773,"_30262":769,"_5":30617,"_21040":51900,"_27550":51901,"_2978":51902},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3496":774,"_30262":769,"_5":30617,"_21040":51904,"_27550":51905,"_2978":51906},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#status-and-validation","Status and validation",{"_3496":775,"_30262":769,"_5":30617,"_21040":51908,"_27550":51909,"_2978":51910},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3496":776,"_30262":769,"_21040":51912,"_5":14474,"_27550":769,"_2978":51913},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3496":777,"_30262":769,"_21040":51915,"_5":14474,"_27550":769,"_2978":51916},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3496":778,"_30262":769,"_21040":51918,"_5":14474,"_27550":51893,"_2978":51919},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3496":779,"_30262":769,"_21040":51921,"_5":14474,"_27550":51897,"_2978":51922},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3496":780,"_30262":769,"_21040":51924,"_5":14474,"_27550":51901,"_2978":51925},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3496":781,"_30262":769,"_21040":51927,"_5":14474,"_27550":51905,"_2978":51928},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3496":782,"_30262":769,"_21040":51930,"_5":14474,"_27550":51909,"_2978":51931},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3496":783,"_30262":783,"_5":14825,"_2978":51933,"_30620":51934,"_21040":51935,"_27550":783},"How Lamassu works",[49507,50975],[],{"_3496":784,"_30262":783,"_21040":51937,"_5":14474,"_27550":783,"_2978":51938},[],"The mental model of trust, keys, certificates and devices.",{"_3496":785,"_30262":783,"_5":30617,"_21040":51940,"_27550":51941,"_2978":51942},[],"/docs/pr-preview/pr-61/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3496":786,"_30262":783,"_5":30617,"_21040":51944,"_27550":51945,"_2978":51946},[],"/docs/pr-preview/pr-61/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3496":787,"_30262":783,"_21040":51948,"_5":14474,"_27550":783,"_2978":51949},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3496":788,"_30262":783,"_21040":51951,"_5":14474,"_27550":51941,"_2978":51952},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3496":789,"_30262":783,"_21040":51954,"_5":14474,"_27550":51941,"_2978":51955},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3496":790,"_30262":783,"_21040":51957,"_5":14474,"_27550":51941,"_2978":51958},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3496":791,"_30262":783,"_21040":51960,"_5":14474,"_27550":51941,"_2978":51961},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3496":792,"_30262":783,"_21040":51963,"_5":14474,"_27550":51941,"_2978":51964},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3496":793,"_30262":783,"_21040":51966,"_5":14474,"_27550":51945,"_2978":51967},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3496":794,"_30262":783,"_21040":51969,"_5":14474,"_27550":51945,"_2978":51970},[],"A DMS relates that CA to an enrollment policy.",{"_3496":795,"_30262":783,"_21040":51972,"_5":14474,"_27550":51945,"_2978":51973},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3496":796,"_30262":783,"_21040":51975,"_5":14474,"_27550":51945,"_2978":51976},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3496":797,"_30262":783,"_21040":51978,"_5":14474,"_27550":51945,"_2978":51979},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3496":798,"_30262":783,"_21040":51981,"_5":14474,"_27550":51945,"_2978":51982},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3496":799,"_30262":783,"_21040":51984,"_5":14474,"_27550":51945,"_2978":51985},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3496":800,"_30262":800,"_5":14825,"_2978":51987,"_30620":51988,"_21040":51990,"_27550":800},"Devices and identities",[49507,50975,51989,51987],"IoT Fleets",[],{"_3496":801,"_30262":800,"_21040":51992,"_5":14474,"_27550":800,"_2978":51993},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3496":802,"_30262":800,"_5":30617,"_21040":51995,"_27550":51996,"_2978":51997},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#device-states","Device states",{"_3496":803,"_30262":800,"_5":30617,"_21040":51999,"_27550":52000,"_2978":52001},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3496":804,"_30262":800,"_5":30617,"_21040":52003,"_27550":52004,"_2978":52005},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3496":805,"_30262":800,"_5":30617,"_21040":52007,"_27550":52008,"_2978":52009},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3496":806,"_30262":800,"_5":30617,"_21040":52011,"_27550":52012,"_2978":52013},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3496":807,"_30262":800,"_5":30617,"_21040":52015,"_27550":52016,"_2978":52017},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3496":808,"_30262":800,"_5":30617,"_21040":52019,"_27550":52020,"_2978":52021},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3496":809,"_30262":800,"_5":30617,"_21040":52023,"_27550":52024,"_2978":52025},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3496":810,"_30262":800,"_5":30617,"_21040":52027,"_27550":52028,"_2978":52029},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3496":811,"_30262":800,"_5":30617,"_21040":52031,"_27550":52032,"_2978":52033},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3496":812,"_30262":800,"_5":30617,"_21040":52035,"_27550":52036,"_2978":52037},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3496":813,"_30262":800,"_21040":52039,"_5":14474,"_27550":800,"_2978":52040},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3496":814,"_30262":800,"_21040":52042,"_5":14474,"_27550":800,"_2978":52043},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3496":815,"_30262":800,"_21040":52045,"_5":14474,"_27550":51996,"_2978":52046},[],"Operational view",{"_3496":816,"_30262":800,"_21040":52048,"_5":14474,"_27550":51996,"_2978":52049},[],"Meaning",{"_3496":817,"_30262":800,"_21040":52051,"_5":14474,"_27550":51996,"_2978":52052},[],"**No Identity**",{"_3496":818,"_30262":800,"_21040":52054,"_5":14474,"_27550":51996,"_2978":52055},[],"A record exists without an associated identity.",{"_3496":819,"_30262":800,"_21040":52057,"_5":14474,"_27550":51996,"_2978":52058},[],"**Active**",{"_3496":820,"_30262":800,"_21040":52060,"_5":14474,"_27550":51996,"_2978":52061},[],"The slot is active; also check certificate dates, status and usages.",{"_3496":821,"_30262":800,"_21040":52063,"_5":14474,"_27550":51996,"_2978":52064},[],"**Renewal Pending**",{"_3496":822,"_30262":800,"_21040":52066,"_5":14474,"_27550":51996,"_2978":52067},[],"The identity is in the operational renewal window.",{"_3496":823,"_30262":800,"_21040":52069,"_5":14474,"_27550":51996,"_2978":52070},[],"**Expiring Soon**",{"_3496":824,"_30262":800,"_21040":52072,"_5":14474,"_27550":51996,"_2978":52073},[],"Expiration is approaching according to configured thresholds.",{"_3496":825,"_30262":800,"_21040":52075,"_5":14474,"_27550":51996,"_2978":52076},[],"**Expired**",{"_3496":826,"_30262":800,"_21040":52078,"_5":14474,"_27550":51996,"_2978":52079},[],"The identity has expired.",{"_3496":827,"_30262":800,"_21040":52081,"_5":14474,"_27550":51996,"_2978":52082},[],"**Revoked**",{"_3496":828,"_30262":800,"_21040":52084,"_5":14474,"_27550":51996,"_2978":52085},[],"The identity is marked revoked.",{"_3496":829,"_30262":800,"_21040":52087,"_5":14474,"_27550":51996,"_2978":52088},[],"**Decommissioned**",{"_3496":830,"_30262":800,"_21040":52090,"_5":14474,"_27550":51996,"_2978":52091},[],"The record is retired and ordinary updates do not restore operation.",{"_3496":831,"_30262":800,"_21040":52093,"_5":14474,"_27550":51996,"_2978":52094},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3496":832,"_30262":800,"_21040":52096,"_5":14474,"_27550":52000,"_2978":52097},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3496":833,"_30262":800,"_21040":52099,"_5":14474,"_27550":52000,"_2978":52100},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3496":834,"_30262":800,"_21040":52102,"_5":14474,"_27550":52000,"_2978":52103},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3496":835,"_30262":800,"_21040":52105,"_5":14474,"_27550":52000,"_2978":52106},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3496":836,"_30262":800,"_21040":52108,"_5":14474,"_27550":52004,"_2978":52109},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3496":837,"_30262":800,"_21040":52111,"_5":14474,"_27550":52008,"_2978":52112},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3496":838,"_30262":800,"_21040":52114,"_5":14474,"_27550":52012,"_2978":52115},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3496":839,"_30262":800,"_21040":52117,"_5":14474,"_27550":52016,"_2978":52118},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3496":840,"_30262":800,"_21040":52120,"_5":14474,"_27550":52020,"_2978":52121},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3496":841,"_30262":800,"_21040":52123,"_5":14474,"_27550":52020,"_2978":52124},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3496":842,"_30262":800,"_21040":52126,"_5":14474,"_27550":52024,"_2978":52127},[],"From **No Identity**, use **Assign Identity**:",{"_3496":843,"_30262":800,"_21040":52129,"_5":14474,"_27550":52024,"_2978":52130},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3496":844,"_30262":800,"_21040":52132,"_5":14474,"_27550":52024,"_2978":52133},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3496":845,"_30262":800,"_21040":52135,"_5":14474,"_27550":52024,"_2978":52136},[],"Confirm and read the serial, active version and history again.",{"_3496":846,"_30262":800,"_21040":52138,"_5":14474,"_27550":52024,"_2978":52139},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3496":847,"_30262":800,"_21040":52141,"_5":14474,"_27550":52024,"_2978":52142},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3496":848,"_30262":800,"_21040":52144,"_5":14474,"_27550":52028,"_2978":52145},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3496":849,"_30262":800,"_21040":52147,"_5":14474,"_27550":52028,"_2978":52148},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3496":850,"_30262":800,"_21040":52150,"_5":14474,"_27550":52032,"_2978":52151},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3496":851,"_30262":800,"_21040":52153,"_5":14474,"_27550":52032,"_2978":52154},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3496":852,"_30262":800,"_21040":52156,"_5":14474,"_27550":52032,"_2978":52157},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3496":853,"_30262":800,"_21040":52159,"_5":14474,"_27550":52032,"_2978":52160},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3496":854,"_30262":800,"_21040":52162,"_5":14474,"_27550":52036,"_2978":52163},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3496":855,"_30262":800,"_21040":52165,"_5":14474,"_27550":52036,"_2978":52166},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3496":856,"_30262":856,"_5":14825,"_2978":52168,"_30620":52169,"_21040":52171,"_27550":856},"Bootstrap identity and authentication",[49507,50975,51989,51987,52170],"Enrollment with PKI",[],{"_3496":857,"_30262":856,"_21040":52173,"_5":14474,"_27550":856,"_2978":52174},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3496":858,"_30262":856,"_5":30617,"_21040":52176,"_27550":52177,"_2978":52178},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3496":859,"_30262":856,"_5":30617,"_21040":52180,"_27550":52181,"_2978":52182},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3496":860,"_30262":856,"_5":30617,"_21040":52184,"_27550":52185,"_2978":52186},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3496":861,"_30262":856,"_5":30617,"_21040":52188,"_27550":52189,"_2978":52190},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3496":862,"_30262":856,"_5":30617,"_21040":52192,"_27550":52193,"_2978":52194},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3496":863,"_30262":856,"_21040":52196,"_5":14474,"_27550":856,"_2978":52197},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3496":864,"_30262":856,"_21040":52199,"_5":14474,"_27550":52177,"_2978":52200},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3496":865,"_30262":856,"_21040":52202,"_5":14474,"_27550":52177,"_2978":52203},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3496":866,"_30262":856,"_21040":52205,"_5":14474,"_27550":52181,"_2978":52206},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3496":867,"_30262":856,"_21040":52208,"_5":14474,"_27550":52181,"_2978":52209},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3496":868,"_30262":856,"_21040":52211,"_5":14474,"_27550":52181,"_2978":52212},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3496":869,"_30262":856,"_21040":52214,"_5":14474,"_27550":52185,"_2978":52215},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3496":870,"_30262":856,"_21040":52217,"_5":14474,"_27550":52185,"_2978":52218},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3496":871,"_30262":856,"_21040":52220,"_5":14474,"_27550":52189,"_2978":52221},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3496":872,"_30262":856,"_21040":52223,"_5":14474,"_27550":52189,"_2978":52224},[],"Example body:",{"_3496":873,"_30262":856,"_21040":52226,"_5":14474,"_27550":52189,"_2978":52227},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3496":874,"_30262":856,"_21040":52229,"_5":14474,"_27550":52189,"_2978":52230},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3496":875,"_30262":856,"_21040":52232,"_5":14474,"_27550":52189,"_2978":52233},[],"Continuation requires a successful HTTP response and JSON:",{"_3496":876,"_30262":856,"_21040":52235,"_5":14474,"_27550":52189,"_2978":52236},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3496":877,"_30262":856,"_21040":52238,"_5":14474,"_27550":52193,"_2978":52239},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3496":878,"_30262":856,"_21040":52241,"_5":14474,"_27550":52193,"_2978":52242},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3496":879,"_30262":879,"_5":14825,"_2978":52244,"_30620":52245,"_21040":52246,"_27550":879},"Configure and operate the DMS",[49507,50975,51989,51987,52170],[],{"_3496":880,"_30262":879,"_21040":52248,"_5":14474,"_27550":879,"_2978":52249},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3496":881,"_30262":879,"_5":30617,"_21040":52251,"_27550":52252,"_2978":49517},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3496":882,"_30262":879,"_5":30617,"_21040":52254,"_27550":52255,"_2978":52256},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3496":883,"_30262":879,"_5":30617,"_21040":52258,"_27550":52259,"_2978":52260},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3496":884,"_30262":879,"_5":30617,"_21040":52262,"_27550":52263,"_2978":52264},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3496":885,"_30262":879,"_5":30617,"_21040":52266,"_27550":52267,"_2978":52268},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3496":886,"_30262":879,"_5":30617,"_21040":52270,"_27550":52271,"_2978":52272},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3496":887,"_30262":879,"_5":30617,"_21040":52274,"_27550":52275,"_2978":52276},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3496":888,"_30262":879,"_5":30617,"_21040":52278,"_27550":52279,"_2978":52280},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3496":889,"_30262":879,"_5":30617,"_21040":52282,"_27550":52283,"_2978":52284},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3496":890,"_30262":879,"_5":30617,"_21040":52286,"_27550":52287,"_2978":52288},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3496":891,"_30262":879,"_5":30617,"_21040":52290,"_27550":52291,"_2978":52292},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3496":892,"_30262":879,"_5":30617,"_21040":52294,"_27550":52295,"_2978":52296},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3496":893,"_30262":879,"_5":30617,"_21040":52298,"_27550":52299,"_2978":52300},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3496":894,"_30262":879,"_5":30617,"_21040":52302,"_27550":52303,"_2978":52304},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3496":895,"_30262":879,"_5":30617,"_21040":52306,"_27550":52307,"_2978":52308},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3496":896,"_30262":879,"_5":30617,"_21040":52310,"_27550":52311,"_2978":52312},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3496":897,"_30262":879,"_5":30617,"_21040":52314,"_27550":52315,"_2978":52316},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3496":898,"_30262":879,"_5":30617,"_21040":52318,"_27550":52319,"_2978":52320},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3496":899,"_30262":879,"_21040":52322,"_5":14474,"_27550":879,"_2978":52323},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3496":900,"_30262":879,"_21040":52325,"_5":14474,"_27550":52252,"_2978":52326},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3496":901,"_30262":879,"_21040":52328,"_5":14474,"_27550":52252,"_2978":52329},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3496":902,"_30262":879,"_21040":52331,"_5":14474,"_27550":52255,"_2978":52332},[],"Follow the interactive walkthrough to configure a DMS for EST. The example sets **Name** to `DMS Showcase`, which derives the `dms-showcase` identifier used in the EST URLs, and selects two CAs prepared in advance: **DMS Enrollment CA** signs the device identities and **DMS Bootstrap CA** validates the initial credential. The values are for this example; use names and CAs appropriate for your fleet.",{"_3496":903,"_30262":879,"_21040":52334,"_5":14474,"_27550":52259,"_2978":52335},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3496":904,"_30262":879,"_21040":52337,"_5":14474,"_27550":52263,"_2978":52338},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3496":905,"_30262":879,"_21040":52340,"_5":14474,"_27550":52267,"_2978":52341},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3496":906,"_30262":879,"_21040":52343,"_5":14474,"_27550":52271,"_2978":52344},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3496":907,"_30262":879,"_21040":52346,"_5":14474,"_27550":52275,"_2978":52347},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3496":908,"_30262":879,"_21040":52349,"_5":14474,"_27550":52283,"_2978":52350},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3496":909,"_30262":879,"_21040":52352,"_5":14474,"_27550":52283,"_2978":52353},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3496":910,"_30262":879,"_21040":52355,"_5":14474,"_27550":52287,"_2978":52356},[],"`settings.enrollment_settings` field",{"_3496":911,"_30262":879,"_21040":52358,"_5":14474,"_27550":52287,"_2978":52359},[],"Decision",{"_3496":912,"_30262":879,"_21040":52361,"_5":14474,"_27550":52287,"_2978":52362},[],"`protocol`",{"_3496":913,"_30262":879,"_21040":52364,"_5":14474,"_27550":52287,"_2978":52365},[],"`EST_RFC7030` for these operations.",{"_3496":914,"_30262":879,"_21040":52367,"_5":14474,"_27550":52287,"_2978":52368},[],"`enrollment_ca`",{"_3496":915,"_30262":879,"_21040":52370,"_5":14474,"_27550":52287,"_2978":52371},[],"ID of the signing CA.",{"_3496":916,"_30262":879,"_21040":52373,"_5":14474,"_27550":52287,"_2978":52374},[],"`verify_csr_signature`",{"_3496":917,"_30262":879,"_21040":52376,"_5":14474,"_27550":52287,"_2978":52377},[],"Keep `true` to verify CSR key possession.",{"_3496":918,"_30262":879,"_21040":52379,"_5":14474,"_27550":52287,"_2978":52380},[],"`enable_replaceable_enrollment`",{"_3496":919,"_30262":879,"_21040":52382,"_5":14474,"_27550":52287,"_2978":52383},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3496":920,"_30262":879,"_21040":52385,"_5":14474,"_27550":52287,"_2978":52386},[],"`est_rfc7030_settings.auth_mode`",{"_3496":921,"_30262":879,"_21040":52388,"_5":14474,"_27550":52287,"_2978":52389},[],"One of the four authentication modes.",{"_3496":922,"_30262":879,"_21040":52391,"_5":14474,"_27550":52287,"_2978":52392},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3496":923,"_30262":879,"_21040":52394,"_5":14474,"_27550":52291,"_2978":52395},[],"The blocks are independent:",{"_3496":924,"_30262":879,"_21040":52397,"_5":14474,"_27550":52291,"_2978":52398},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3496":925,"_30262":879,"_21040":52400,"_5":14474,"_27550":52291,"_2978":52401},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3496":926,"_30262":879,"_21040":52403,"_5":14474,"_27550":52291,"_2978":52404},[],"`auth_mode`",{"_3496":927,"_30262":879,"_21040":52406,"_5":14474,"_27550":52291,"_2978":52407},[],"Control applied in the configured operation",{"_3496":928,"_30262":879,"_21040":52409,"_5":14474,"_27550":52291,"_2978":52410},[],"`CLIENT_CERTIFICATE`",{"_3496":929,"_30262":879,"_21040":52412,"_5":14474,"_27550":52291,"_2978":52413},[],"Presented certificate validation.",{"_3496":930,"_30262":879,"_21040":52415,"_5":14474,"_27550":52291,"_2978":52416},[],"`EXTERNAL_WEBHOOK`",{"_3496":931,"_30262":879,"_21040":52418,"_5":14474,"_27550":52291,"_2978":52419},[],"Configured webhook authorization.",{"_3496":932,"_30262":879,"_21040":52421,"_5":14474,"_27550":52291,"_2978":52422},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3496":933,"_30262":879,"_21040":52424,"_5":14474,"_27550":52291,"_2978":52425},[],"Certificate validation followed by webhook approval.",{"_3496":934,"_30262":879,"_21040":52427,"_5":14474,"_27550":52291,"_2978":52428},[],"`NO_AUTH`",{"_3496":935,"_30262":879,"_21040":52430,"_5":14474,"_27550":52291,"_2978":52431},[],"No DMS requester authentication.",{"_3496":936,"_30262":879,"_21040":52433,"_5":14474,"_27550":52291,"_2978":52434},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3496":937,"_30262":879,"_21040":52436,"_5":14474,"_27550":52291,"_2978":52437},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3496":938,"_30262":879,"_21040":52439,"_5":14474,"_27550":52291,"_2978":52440},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3496":939,"_30262":879,"_21040":52442,"_5":14474,"_27550":52291,"_2978":52443},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3496":940,"_30262":879,"_21040":52445,"_5":14474,"_27550":52295,"_2978":52446},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3496":941,"_30262":879,"_21040":52448,"_5":14474,"_27550":52295,"_2978":52449},[],"`external_webhook_settings` field",{"_3496":942,"_30262":879,"_21040":52451,"_5":14474,"_27550":52295,"_2978":52359},[],{"_3496":943,"_30262":879,"_21040":52453,"_5":14474,"_27550":52295,"_2978":52454},[],"`url`",{"_3496":944,"_30262":879,"_21040":52456,"_5":14474,"_27550":52295,"_2978":52457},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3496":945,"_30262":879,"_21040":52459,"_5":14474,"_27550":52295,"_2978":52460},[],"`method`",{"_3496":946,"_30262":879,"_21040":52462,"_5":14474,"_27550":52295,"_2978":52463},[],"`POST` or `PUT`; `POST` by default.",{"_3496":947,"_30262":879,"_21040":52465,"_5":14474,"_27550":52295,"_2978":52466},[],"`name`",{"_3496":948,"_30262":879,"_21040":52468,"_5":14474,"_27550":52295,"_2978":52469},[],"Label used in service logs.",{"_3496":949,"_30262":879,"_21040":52471,"_5":14474,"_27550":52295,"_2978":52472},[],"`config.auth_mode`",{"_3496":950,"_30262":879,"_21040":52474,"_5":14474,"_27550":52295,"_2978":52475},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3496":951,"_30262":879,"_21040":52477,"_5":14474,"_27550":52295,"_2978":52478},[],"`config.log_level`",{"_3496":952,"_30262":879,"_21040":52480,"_5":14474,"_27550":52295,"_2978":52481},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3496":953,"_30262":879,"_21040":52483,"_5":14474,"_27550":52295,"_2978":52484},[],"`config.apikey_options`",{"_3496":954,"_30262":879,"_21040":52486,"_5":14474,"_27550":52295,"_2978":52487},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3496":955,"_30262":879,"_21040":52489,"_5":14474,"_27550":52295,"_2978":52490},[],"`config.jwt_options`",{"_3496":956,"_30262":879,"_21040":52492,"_5":14474,"_27550":52295,"_2978":52493},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3496":957,"_30262":879,"_21040":52495,"_5":14474,"_27550":52295,"_2978":52496},[],"`config.mtls_options`",{"_3496":958,"_30262":879,"_21040":52498,"_5":14474,"_27550":52295,"_2978":52499},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3496":959,"_30262":879,"_21040":52501,"_5":14474,"_27550":52295,"_2978":52502},[],"`config.insecure_skip_verify`",{"_3496":960,"_30262":879,"_21040":52504,"_5":14474,"_27550":52295,"_2978":52505},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3496":961,"_30262":879,"_21040":52507,"_5":14474,"_27550":52295,"_2978":52508},[],"`config.call_timeout`",{"_3496":962,"_30262":879,"_21040":52510,"_5":14474,"_27550":52295,"_2978":52511},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3496":963,"_30262":879,"_21040":52513,"_5":14474,"_27550":52295,"_2978":52514},[],"Rules for that configuration:",{"_3496":964,"_30262":879,"_21040":52516,"_5":14474,"_27550":52295,"_2978":52517},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3496":965,"_30262":879,"_21040":52519,"_5":14474,"_27550":52295,"_2978":52520},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3496":966,"_30262":879,"_21040":52522,"_5":14474,"_27550":52295,"_2978":52523},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3496":967,"_30262":879,"_21040":52525,"_5":14474,"_27550":52295,"_2978":52526},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3496":968,"_30262":879,"_21040":52528,"_5":14474,"_27550":52295,"_2978":52529},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3496":969,"_30262":879,"_21040":52531,"_5":14474,"_27550":52295,"_2978":52532},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3496":970,"_30262":879,"_21040":52534,"_5":14474,"_27550":52295,"_2978":52535},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3496":971,"_30262":879,"_21040":52537,"_5":14474,"_27550":52295,"_2978":52538},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3496":972,"_30262":879,"_21040":52540,"_5":14474,"_27550":52295,"_2978":52541},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3496":973,"_30262":879,"_21040":52543,"_5":14474,"_27550":52299,"_2978":52544},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3496":974,"_30262":879,"_21040":52546,"_5":14474,"_27550":52303,"_2978":52547},[],"`settings.reenrollment_settings` field",{"_3496":975,"_30262":879,"_21040":52549,"_5":14474,"_27550":52303,"_2978":49897},[],{"_3496":976,"_30262":879,"_21040":52551,"_5":14474,"_27550":52303,"_2978":52552},[],"`reenrollment_delta`",{"_3496":977,"_30262":879,"_21040":52554,"_5":14474,"_27550":52303,"_2978":52555},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3496":978,"_30262":879,"_21040":52557,"_5":14474,"_27550":52303,"_2978":52558},[],"`preventive_delta`",{"_3496":979,"_30262":879,"_21040":52560,"_5":14474,"_27550":52303,"_2978":52561},[],"Preventive operational monitoring threshold.",{"_3496":980,"_30262":879,"_21040":52563,"_5":14474,"_27550":52303,"_2978":52564},[],"`critical_delta`",{"_3496":981,"_30262":879,"_21040":52566,"_5":14474,"_27550":52303,"_2978":52567},[],"Critical operational monitoring threshold.",{"_3496":982,"_30262":879,"_21040":52569,"_5":14474,"_27550":52303,"_2978":52570},[],"`enable_expired_renewal`",{"_3496":983,"_30262":879,"_21040":52572,"_5":14474,"_27550":52303,"_2978":52573},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3496":984,"_30262":879,"_21040":52575,"_5":14474,"_27550":52303,"_2978":52576},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3496":985,"_30262":879,"_21040":52578,"_5":14474,"_27550":52303,"_2978":52579},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3496":986,"_30262":879,"_21040":52581,"_5":14474,"_27550":52303,"_2978":52582},[],"`revoke_on_reenrollment`",{"_3496":987,"_30262":879,"_21040":52584,"_5":14474,"_27550":52303,"_2978":52585},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3496":988,"_30262":879,"_21040":52587,"_5":14474,"_27550":52303,"_2978":52588},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3496":989,"_30262":879,"_21040":52590,"_5":14474,"_27550":52307,"_2978":52591},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3496":990,"_30262":879,"_21040":52593,"_5":14474,"_27550":52311,"_2978":49891},[],{"_3496":991,"_30262":879,"_21040":52595,"_5":14474,"_27550":52311,"_2978":52596},[],"Published material",{"_3496":992,"_30262":879,"_21040":52598,"_5":14474,"_27550":52311,"_2978":52599},[],"**Include Lamassu System CA**",{"_3496":993,"_30262":879,"_21040":52601,"_5":14474,"_27550":52311,"_2978":52602},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3496":994,"_30262":879,"_21040":52604,"_5":14474,"_27550":52311,"_2978":52605},[],"**Include Enrollment CA**",{"_3496":995,"_30262":879,"_21040":52607,"_5":14474,"_27550":52311,"_2978":52608},[],"Selected issuing CA certificate.",{"_3496":996,"_30262":879,"_21040":52610,"_5":14474,"_27550":52311,"_2978":52611},[],"**Managed CAs**",{"_3496":997,"_30262":879,"_21040":52613,"_5":14474,"_27550":52311,"_2978":52614},[],"Explicitly selected CA certificates.",{"_3496":998,"_30262":879,"_21040":52616,"_5":14474,"_27550":52311,"_2978":52617},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3496":999,"_30262":879,"_21040":52619,"_5":14474,"_27550":52315,"_2978":52620},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3496":1000,"_30262":879,"_21040":52622,"_5":14474,"_27550":52315,"_2978":52623},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3496":1001,"_30262":879,"_21040":52625,"_5":14474,"_27550":52315,"_2978":52626},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3496":1002,"_30262":879,"_21040":52628,"_5":14474,"_27550":52319,"_2978":52629},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3496":1003,"_30262":1003,"_5":14825,"_2978":52631,"_30620":52632,"_21040":52633,"_27550":1003},"Integrate the EST client",[49507,50975,51989,51987,52170],[],{"_3496":1004,"_30262":1003,"_21040":52635,"_5":14474,"_27550":1003,"_2978":52636},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3496":1005,"_30262":1003,"_5":30617,"_21040":52638,"_27550":52639,"_2978":49517},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3496":1006,"_30262":1003,"_5":30617,"_21040":52641,"_27550":52642,"_2978":52643},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3496":1007,"_30262":1003,"_5":30617,"_21040":52645,"_27550":52646,"_2978":52647},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3496":1008,"_30262":1003,"_5":30617,"_21040":52649,"_27550":52650,"_2978":52651},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3496":1009,"_30262":1003,"_5":30617,"_21040":52653,"_27550":52654,"_2978":52655},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3496":1010,"_30262":1003,"_5":30617,"_21040":52657,"_27550":52658,"_2978":52659},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3496":1011,"_30262":1003,"_21040":52661,"_5":14474,"_27550":1003,"_2978":52662},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3496":1012,"_30262":1003,"_21040":52664,"_5":14474,"_27550":52639,"_2978":52665},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3496":1013,"_30262":1003,"_21040":52667,"_5":14474,"_27550":52639,"_2978":52668},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3496":1014,"_30262":1003,"_21040":52670,"_5":14474,"_27550":52639,"_2978":52671},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3496":1015,"_30262":1003,"_21040":52673,"_5":14474,"_27550":52642,"_2978":52674},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3496":1016,"_30262":1003,"_21040":52676,"_5":14474,"_27550":52642,"_2978":52677},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3496":1017,"_30262":1003,"_21040":52679,"_5":14474,"_27550":52646,"_2978":52680},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3496":1018,"_30262":1003,"_21040":52682,"_5":14474,"_27550":52646,"_2978":52683},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3496":1019,"_30262":1003,"_21040":52685,"_5":14474,"_27550":52650,"_2978":52686},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3496":1020,"_30262":1003,"_21040":52688,"_5":14474,"_27550":52650,"_2978":52689},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3496":1021,"_30262":1003,"_21040":52691,"_5":14474,"_27550":52654,"_2978":52692},[],"For a root that issues directly:",{"_3496":1022,"_30262":1003,"_21040":52694,"_5":14474,"_27550":52654,"_2978":52695},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3496":1023,"_30262":1003,"_21040":52697,"_5":14474,"_27550":52654,"_2978":52698},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3496":1024,"_30262":1003,"_21040":52700,"_5":14474,"_27550":52658,"_2978":52701},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3496":1025,"_30262":1025,"_5":14825,"_2978":52703,"_30620":52704,"_21040":52705,"_27550":1025},"EST reference",[49507,50975,51989,51987,52170],[],{"_3496":1026,"_30262":1025,"_21040":52707,"_5":14474,"_27550":1025,"_2978":52708},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3496":1027,"_30262":1025,"_5":30617,"_21040":52710,"_27550":52711,"_2978":52712},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3496":1028,"_30262":1025,"_5":30617,"_21040":52714,"_27550":52715,"_2978":22801},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3496":1029,"_30262":1025,"_5":30617,"_21040":52717,"_27550":52718,"_2978":26155},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3496":1030,"_30262":1025,"_5":30617,"_21040":52720,"_27550":52721,"_2978":26162},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3496":1031,"_30262":1025,"_5":30617,"_21040":52723,"_27550":52724,"_2978":25481},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3496":1032,"_30262":1025,"_5":30617,"_21040":52726,"_27550":52727,"_2978":52728},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3496":1033,"_30262":1025,"_5":30617,"_21040":52730,"_27550":52731,"_2978":52732},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3496":1034,"_30262":1025,"_5":30617,"_21040":52734,"_27550":52735,"_2978":52736},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3496":1035,"_30262":1025,"_21040":52738,"_5":14474,"_27550":1025,"_2978":52739},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3496":1036,"_30262":1025,"_21040":52741,"_5":14474,"_27550":52711,"_2978":52742},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3496":1037,"_30262":1025,"_21040":52744,"_5":14474,"_27550":52711,"_2978":52745},[],"Operation",{"_3496":1038,"_30262":1025,"_21040":52747,"_5":14474,"_27550":52711,"_2978":52748},[],"Method",{"_3496":1039,"_30262":1025,"_21040":52750,"_5":14474,"_27550":52711,"_2978":52751},[],"Authentication and condition",{"_3496":1040,"_30262":1025,"_21040":52753,"_5":14474,"_27550":52711,"_2978":52754},[],"`/cacerts`",{"_3496":1041,"_30262":1025,"_21040":52756,"_5":14474,"_27550":52711,"_2978":52757},[],"GET",{"_3496":1042,"_30262":1025,"_21040":52759,"_5":14474,"_27550":52711,"_2978":52760},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3496":1043,"_30262":1025,"_21040":52762,"_5":14474,"_27550":52711,"_2978":52763},[],"`/simpleenroll`",{"_3496":1044,"_30262":1025,"_21040":52765,"_5":14474,"_27550":52711,"_2978":52766},[],"POST",{"_3496":1045,"_30262":1025,"_21040":52768,"_5":14474,"_27550":52711,"_2978":52769},[],"Initial authentication and DMS registration/replacement policy.",{"_3496":1046,"_30262":1025,"_21040":52771,"_5":14474,"_27550":52711,"_2978":52772},[],"`/simplereenroll`",{"_3496":1047,"_30262":1025,"_21040":52774,"_5":14474,"_27550":52711,"_2978":52766},[],{"_3496":1048,"_30262":1025,"_21040":52776,"_5":14474,"_27550":52711,"_2978":52777},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3496":1049,"_30262":1025,"_21040":52779,"_5":14474,"_27550":52711,"_2978":52780},[],"`/serverkeygen`",{"_3496":1050,"_30262":1025,"_21040":52782,"_5":14474,"_27550":52711,"_2978":52766},[],{"_3496":1051,"_30262":1025,"_21040":52784,"_5":14474,"_27550":52711,"_2978":52785},[],"Initial authentication and admission; server generation enabled.",{"_3496":1052,"_30262":1025,"_21040":52787,"_5":14474,"_27550":52711,"_2978":52788},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3496":1053,"_30262":1025,"_21040":52790,"_5":14474,"_27550":52715,"_2978":52791},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3496":1054,"_30262":1025,"_21040":52793,"_5":14474,"_27550":52715,"_2978":52794},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3496":1055,"_30262":1025,"_21040":52796,"_5":14474,"_27550":52718,"_2978":52797},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3496":1056,"_30262":1025,"_21040":52799,"_5":14474,"_27550":52718,"_2978":52800},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3496":1057,"_30262":1025,"_21040":52802,"_5":14474,"_27550":52721,"_2978":52803},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3496":1058,"_30262":1025,"_21040":52805,"_5":14474,"_27550":52721,"_2978":52806},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3496":1059,"_30262":1025,"_21040":52808,"_5":14474,"_27550":52724,"_2978":52809},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3496":1060,"_30262":1025,"_21040":52811,"_5":14474,"_27550":52724,"_2978":52812},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3496":1061,"_30262":1025,"_21040":52814,"_5":14474,"_27550":52727,"_2978":52815},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3496":1062,"_30262":1025,"_21040":52817,"_5":14474,"_27550":52727,"_2978":52818},[],"Part",{"_3496":1063,"_30262":1025,"_21040":52820,"_5":14474,"_27550":52727,"_2978":52821},[],"Content after decoding its Base64",{"_3496":1064,"_30262":1025,"_21040":52823,"_5":14474,"_27550":52727,"_2978":52824},[],"`application/pkcs8`",{"_3496":1065,"_30262":1025,"_21040":52826,"_5":14474,"_27550":52727,"_2978":52827},[],"Unencrypted DER PKCS#8 private key.",{"_3496":1066,"_30262":1025,"_21040":52829,"_5":14474,"_27550":52727,"_2978":52830},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3496":1067,"_30262":1025,"_21040":52832,"_5":14474,"_27550":52727,"_2978":52833},[],"DER PKCS#7 containing the issued certificate.",{"_3496":1068,"_30262":1025,"_21040":52835,"_5":14474,"_27550":52727,"_2978":52836},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3496":1069,"_30262":1025,"_21040":52838,"_5":14474,"_27550":52731,"_2978":52839},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3496":1070,"_30262":1025,"_21040":52841,"_5":14474,"_27550":52731,"_2978":52842},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3496":1071,"_30262":1025,"_21040":52844,"_5":14474,"_27550":52731,"_2978":52845},[],"Convert and check the result:",{"_3496":1072,"_30262":1025,"_21040":52847,"_5":14474,"_27550":52731,"_2978":52848},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3496":1073,"_30262":1025,"_21040":52850,"_5":14474,"_27550":52735,"_2978":52851},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3496":1074,"_30262":1025,"_21040":52853,"_5":14474,"_27550":52735,"_2978":52854},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3496":1075,"_30262":1075,"_5":14825,"_2978":52170,"_30620":52856,"_21040":52857,"_27550":1075},[49507,50975,51989,51987,52170],[],{"_3496":1076,"_30262":1075,"_21040":52859,"_5":14474,"_27550":1075,"_2978":52860},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3496":1077,"_30262":1075,"_5":30617,"_21040":52862,"_27550":52863,"_2978":52864},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3496":1078,"_30262":1075,"_5":30617,"_21040":52866,"_27550":52867,"_2978":52868},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3496":1079,"_30262":1075,"_5":30617,"_21040":52870,"_27550":52871,"_2978":52872},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3496":1080,"_30262":1075,"_5":30617,"_21040":52874,"_27550":52875,"_2978":52876},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3496":1081,"_30262":1075,"_21040":52878,"_5":14474,"_27550":1075,"_2978":52879},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3496":1082,"_30262":1075,"_21040":52881,"_5":14474,"_27550":52863,"_2978":52882},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3496":1083,"_30262":1075,"_21040":52884,"_5":14474,"_27550":52863,"_2978":52885},[],"The integrator installs initial EST server trust and an admission credential.",{"_3496":1084,"_30262":1075,"_21040":52887,"_5":14474,"_27550":52863,"_2978":52888},[],"The client requests an identity for its `Device ID` through EST.",{"_3496":1085,"_30262":1075,"_21040":52890,"_5":14474,"_27550":52863,"_2978":52891},[],"Certificate, device binding and key/certificate installation are checked.",{"_3496":1086,"_30262":1075,"_21040":52893,"_5":14474,"_27550":52863,"_2978":52894},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3496":1087,"_30262":1075,"_21040":52896,"_5":14474,"_27550":52863,"_2978":52897},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3496":1088,"_30262":1075,"_21040":52899,"_5":14474,"_27550":52867,"_2978":52900},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3496":1089,"_30262":1075,"_21040":52902,"_5":14474,"_27550":52867,"_2978":52903},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3496":1090,"_30262":1075,"_21040":52905,"_5":14474,"_27550":52867,"_2978":52906},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3496":1091,"_30262":1075,"_21040":52908,"_5":14474,"_27550":52867,"_2978":52909},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3496":1092,"_30262":1075,"_21040":52911,"_5":14474,"_27550":52871,"_2978":52912},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3496":1093,"_30262":1075,"_21040":52914,"_5":14474,"_27550":52871,"_2978":52915},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3496":1094,"_30262":1075,"_21040":52917,"_5":14474,"_27550":52871,"_2978":52918},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3496":1095,"_30262":1075,"_21040":52920,"_5":14474,"_27550":52871,"_2978":52921},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3496":1096,"_30262":1075,"_21040":52923,"_5":14474,"_27550":52875,"_2978":52924},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3496":1097,"_30262":1075,"_21040":52926,"_5":14474,"_27550":52875,"_2978":52927},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3496":1098,"_30262":1098,"_5":14825,"_2978":52929,"_30620":52930,"_21040":52931,"_27550":1098},"Provisioning strategies",[49507,50975,51989,51987,52170],[],{"_3496":1099,"_30262":1098,"_21040":52933,"_5":14474,"_27550":1098,"_2978":52934},[],"Choose device registration, identity authorization and key generation.",{"_3496":1100,"_30262":1098,"_5":30617,"_21040":52936,"_27550":52937,"_2978":52938},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3496":1101,"_30262":1098,"_5":30617,"_21040":52940,"_27550":52941,"_2978":52942},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3496":1102,"_30262":1098,"_5":30617,"_21040":52944,"_27550":52945,"_2978":52946},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3496":1103,"_30262":1098,"_5":30617,"_21040":52948,"_27550":52949,"_2978":52950},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3496":1104,"_30262":1098,"_5":30617,"_21040":52952,"_27550":52953,"_2978":52954},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3496":1105,"_30262":1098,"_21040":52956,"_5":14474,"_27550":1098,"_2978":52957},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3496":1106,"_30262":1098,"_21040":52959,"_5":14474,"_27550":52937,"_2978":52960},[],"Path",{"_3496":1107,"_30262":1098,"_21040":52962,"_5":14474,"_27550":52937,"_2978":52963},[],"When the device exists",{"_3496":1108,"_30262":1098,"_21040":52965,"_5":14474,"_27550":52937,"_2978":52966},[],"What to check",{"_3496":1109,"_30262":1098,"_21040":52968,"_5":14474,"_27550":52937,"_2978":52969},[],"Manual assignment",{"_3496":1110,"_30262":1098,"_21040":52971,"_5":14474,"_27550":52937,"_2978":52972},[],"An operator creates it before associating a certificate.",{"_3496":1111,"_30262":1098,"_21040":52974,"_5":14474,"_27550":52937,"_2978":52975},[],"ID, owning DMS, certificate CN and bound serial.",{"_3496":1112,"_30262":1098,"_21040":52977,"_5":14474,"_27550":52937,"_2978":52978},[],"EST with `JITP`",{"_3496":1113,"_30262":1098,"_21040":52980,"_5":14474,"_27550":52937,"_2978":52981},[],"Created for an unknown CN during `/simpleenroll`.",{"_3496":1114,"_30262":1098,"_21040":52983,"_5":14474,"_27550":52937,"_2978":52984},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3496":1115,"_30262":1098,"_21040":52986,"_5":14474,"_27550":52937,"_2978":52987},[],"EST with `PRE_REGISTRATION`",{"_3496":1116,"_30262":1098,"_21040":52989,"_5":14474,"_27550":52937,"_2978":52990},[],"Must exist before `/simpleenroll`.",{"_3496":1117,"_30262":1098,"_21040":52992,"_5":14474,"_27550":52937,"_2978":52993},[],"Approved record, same DMS and replacement conditions for your version.",{"_3496":1118,"_30262":1098,"_21040":52995,"_5":14474,"_27550":52937,"_2978":52996},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3496":1119,"_30262":1098,"_21040":52998,"_5":14474,"_27550":52937,"_2978":52999},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3496":1120,"_30262":1098,"_21040":53001,"_5":14474,"_27550":52941,"_2978":53002},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3496":1121,"_30262":1098,"_21040":53004,"_5":14474,"_27550":52941,"_2978":53005},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3496":1122,"_30262":1098,"_21040":53007,"_5":14474,"_27550":52941,"_2978":53008},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3496":1123,"_30262":1098,"_21040":53010,"_5":14474,"_27550":52945,"_2978":53011},[],"Decide initial enrollment and re-enrollment separately:",{"_3496":1124,"_30262":1098,"_21040":53013,"_5":14474,"_27550":52945,"_2978":53014},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3496":1125,"_30262":1098,"_21040":53016,"_5":14474,"_27550":52945,"_2978":53017},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3496":1126,"_30262":1098,"_21040":53019,"_5":14474,"_27550":52945,"_2978":53020},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3496":1127,"_30262":1098,"_21040":53022,"_5":14474,"_27550":52945,"_2978":53023},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3496":1128,"_30262":1098,"_21040":53025,"_5":14474,"_27550":52945,"_2978":53026},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3496":1129,"_30262":1098,"_21040":53028,"_5":14474,"_27550":52949,"_2978":49891},[],{"_3496":1130,"_30262":1098,"_21040":53030,"_5":14474,"_27550":52949,"_2978":53031},[],"Material crossing EST",{"_3496":1131,"_30262":1098,"_21040":53033,"_5":14474,"_27550":52949,"_2978":53034},[],"Device-generated key",{"_3496":1132,"_30262":1098,"_21040":53036,"_5":14474,"_27550":52949,"_2978":53037},[],"Public CSR and certificate; the key stays on the client.",{"_3496":1133,"_30262":1098,"_21040":53039,"_5":14474,"_27550":52949,"_2978":53040},[],"Existing device key",{"_3496":1134,"_30262":1098,"_21040":53042,"_5":14474,"_27550":52949,"_2978":53043},[],"CSR signed with that key and a new certificate.",{"_3496":1135,"_30262":1098,"_21040":53045,"_5":14474,"_27550":52949,"_2978":52308},[],{"_3496":1136,"_30262":1098,"_21040":53047,"_5":14474,"_27550":52949,"_2978":53048},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3496":1137,"_30262":1098,"_21040":53050,"_5":14474,"_27550":52949,"_2978":53051},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3496":1138,"_30262":1098,"_21040":53053,"_5":14474,"_27550":52953,"_2978":53054},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3496":1139,"_30262":1139,"_5":14825,"_2978":53056,"_30620":53057,"_21040":53058,"_27550":1139},"Renewal and recovery",[49507,50975,51989,51987,52170],[],{"_3496":1140,"_30262":1139,"_21040":53060,"_5":14474,"_27550":1139,"_2978":53061},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3496":1141,"_30262":1139,"_5":30617,"_21040":53063,"_27550":53064,"_2978":53065},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3496":1142,"_30262":1139,"_5":30617,"_21040":53067,"_27550":53068,"_2978":53069},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3496":1143,"_30262":1139,"_5":30617,"_21040":53071,"_27550":53072,"_2978":53073},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3496":1144,"_30262":1139,"_5":30617,"_21040":53075,"_27550":53076,"_2978":53077},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3496":1145,"_30262":1139,"_5":30617,"_21040":53079,"_27550":53080,"_2978":53081},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3496":1146,"_30262":1139,"_21040":53083,"_5":14474,"_27550":1139,"_2978":53084},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3496":1147,"_30262":1139,"_21040":53086,"_5":14474,"_27550":53064,"_2978":53087},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3496":1148,"_30262":1139,"_21040":53089,"_5":14474,"_27550":53064,"_2978":53090},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3496":1149,"_30262":1139,"_21040":53092,"_5":14474,"_27550":53064,"_2978":53093},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3496":1150,"_30262":1139,"_21040":53095,"_5":14474,"_27550":53064,"_2978":53096},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3496":1151,"_30262":1139,"_21040":53098,"_5":14474,"_27550":53068,"_2978":53099},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3496":1152,"_30262":1139,"_21040":53101,"_5":14474,"_27550":53068,"_2978":53102},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3496":1153,"_30262":1139,"_21040":53104,"_5":14474,"_27550":53072,"_2978":53105},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3496":1154,"_30262":1139,"_21040":53107,"_5":14474,"_27550":53072,"_2978":53108},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3496":1155,"_30262":1139,"_21040":53110,"_5":14474,"_27550":53072,"_2978":53111},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3496":1156,"_30262":1139,"_21040":53113,"_5":14474,"_27550":53076,"_2978":53114},[],"Situation",{"_3496":1157,"_30262":1139,"_21040":53116,"_5":14474,"_27550":53076,"_2978":53117},[],"Procedure",{"_3496":1158,"_30262":1139,"_21040":53119,"_5":14474,"_27550":53076,"_2978":53120},[],"Valid certificate, outside the window",{"_3496":1159,"_30262":1139,"_21040":53122,"_5":14474,"_27550":53076,"_2978":53123},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3496":1160,"_30262":1139,"_21040":53125,"_5":14474,"_27550":53076,"_2978":53126},[],"Expired certificate, key available",{"_3496":1161,"_30262":1139,"_21040":53128,"_5":14474,"_27550":53076,"_2978":53129},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3496":1162,"_30262":1139,"_21040":53131,"_5":14474,"_27550":53076,"_2978":53132},[],"Renewal through webhook or `NO_AUTH`",{"_3496":1163,"_30262":1139,"_21040":53134,"_5":14474,"_27550":53076,"_2978":53135},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3496":1164,"_30262":1139,"_21040":53137,"_5":14474,"_27550":53076,"_2978":53138},[],"Lost or inaccessible key",{"_3496":1165,"_30262":1139,"_21040":53140,"_5":14474,"_27550":53076,"_2978":53141},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3496":1166,"_30262":1139,"_21040":53143,"_5":14474,"_27550":53076,"_2978":53144},[],"Current identity revoked",{"_3496":1167,"_30262":1139,"_21040":53146,"_5":14474,"_27550":53076,"_2978":53147},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3496":1168,"_30262":1139,"_21040":53149,"_5":14474,"_27550":53076,"_2978":53150},[],"Device without an identity",{"_3496":1169,"_30262":1139,"_21040":53152,"_5":14474,"_27550":53076,"_2978":53153},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3496":1170,"_30262":1139,"_21040":53155,"_5":14474,"_27550":53076,"_2978":53156},[],"Retired device",{"_3496":1171,"_30262":1139,"_21040":53158,"_5":14474,"_27550":53076,"_2978":53159},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3496":1172,"_30262":1139,"_21040":53161,"_5":14474,"_27550":53076,"_2978":53162},[],"Timeout, HTTP 500 or installation failure",{"_3496":1173,"_30262":1139,"_21040":53164,"_5":14474,"_27550":53076,"_2978":53165},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3496":1174,"_30262":1139,"_21040":53167,"_5":14474,"_27550":53080,"_2978":53168},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3496":1175,"_30262":1139,"_21040":53170,"_5":14474,"_27550":53080,"_2978":53171},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3496":1176,"_30262":1176,"_5":14825,"_2978":53173,"_30620":53174,"_21040":53175,"_27550":1176},"Enrollment troubleshooting",[49507,50975,51989,51987,52170],[],{"_3496":1177,"_30262":1176,"_21040":53177,"_5":14474,"_27550":1176,"_2978":53178},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3496":1178,"_30262":1176,"_5":30617,"_21040":53180,"_27550":53181,"_2978":53182},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3496":1179,"_30262":1176,"_5":30617,"_21040":53184,"_27550":53185,"_2978":53186},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3496":1180,"_30262":1176,"_5":30617,"_21040":53188,"_27550":53189,"_2978":52736},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3496":1181,"_30262":1176,"_5":30617,"_21040":53191,"_27550":53192,"_2978":53193},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3496":1182,"_30262":1176,"_21040":53195,"_5":14474,"_27550":1176,"_2978":53196},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3496":1183,"_30262":1176,"_21040":53198,"_5":14474,"_27550":53185,"_2978":53199},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3496":1184,"_30262":1176,"_21040":53201,"_5":14474,"_27550":53185,"_2978":53202},[],"Symptom or message",{"_3496":1185,"_30262":1176,"_21040":53204,"_5":14474,"_27550":53185,"_2978":52966},[],{"_3496":1186,"_30262":1176,"_21040":53206,"_5":14474,"_27550":53185,"_2978":53207},[],"curl rejects TLS, name or issuer",{"_3496":1187,"_30262":1176,"_21040":53209,"_5":14474,"_27550":53185,"_2978":53210},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3496":1188,"_30262":1176,"_21040":53212,"_5":14474,"_27550":53185,"_2978":53213},[],"404 or missing APS",{"_3496":1189,"_30262":1176,"_21040":53215,"_5":14474,"_27550":53185,"_2978":53216},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3496":1190,"_30262":1176,"_21040":53218,"_5":14474,"_27550":53185,"_2978":53219},[],"400, CSR or format error",{"_3496":1191,"_30262":1176,"_21040":53221,"_5":14474,"_27550":53185,"_2978":53222},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3496":1192,"_30262":1176,"_21040":53224,"_5":14474,"_27550":53185,"_2978":53225},[],"Missing credential or invalid certificate",{"_3496":1193,"_30262":1176,"_21040":53227,"_5":14474,"_27550":53185,"_2978":53228},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3496":1194,"_30262":1176,"_21040":53230,"_5":14474,"_27550":53185,"_2978":53231},[],"Webhook denies, times out or responds without authorization",{"_3496":1195,"_30262":1176,"_21040":53233,"_5":14474,"_27550":53185,"_2978":53234},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3496":1196,"_30262":1176,"_21040":53236,"_5":14474,"_27550":53185,"_2978":53237},[],"`unexpected status code: <n>: redirects are not followed`",{"_3496":1197,"_30262":1176,"_21040":53239,"_5":14474,"_27550":53185,"_2978":53240},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3496":1198,"_30262":1176,"_21040":53242,"_5":14474,"_27550":53185,"_2978":53243},[],"`webhook response exceeds 1048576 bytes`",{"_3496":1199,"_30262":1176,"_21040":53245,"_5":14474,"_27550":53185,"_2978":53246},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3496":1200,"_30262":1176,"_21040":53248,"_5":14474,"_27550":53185,"_2978":53249},[],"`webhook config must not reference files`",{"_3496":1201,"_30262":1176,"_21040":53251,"_5":14474,"_27550":53185,"_2978":53252},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3496":1202,"_30262":1176,"_21040":53254,"_5":14474,"_27550":53185,"_2978":53255},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3496":1203,"_30262":1176,"_21040":53257,"_5":14474,"_27550":53185,"_2978":53258},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3496":1204,"_30262":1176,"_21040":53260,"_5":14474,"_27550":53185,"_2978":53261},[],"`webhook mTLS certificate and key are invalid: …`",{"_3496":1205,"_30262":1176,"_21040":53263,"_5":14474,"_27550":53185,"_2978":53264},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3496":1206,"_30262":1176,"_21040":53266,"_5":14474,"_27550":53185,"_2978":53267},[],"400 `struct validation error` creating or updating a DMS",{"_3496":1207,"_30262":1176,"_21040":53269,"_5":14474,"_27550":53185,"_2978":53270},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3496":1208,"_30262":1176,"_21040":53272,"_5":14474,"_27550":53185,"_2978":53273},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3496":1209,"_30262":1176,"_21040":53275,"_5":14474,"_27550":53185,"_2978":53276},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3496":1210,"_30262":1176,"_21040":53278,"_5":14474,"_27550":53185,"_2978":53279},[],"`device not preregistered`",{"_3496":1211,"_30262":1176,"_21040":53281,"_5":14474,"_27550":53185,"_2978":53282},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3496":1212,"_30262":1176,"_21040":53284,"_5":14474,"_27550":53185,"_2978":53285},[],"`forbiddenNewEnrollment`",{"_3496":1213,"_30262":1176,"_21040":53287,"_5":14474,"_27550":53185,"_2978":53288},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3496":1214,"_30262":1176,"_21040":53290,"_5":14474,"_27550":53185,"_2978":53291},[],"Different owning DMS",{"_3496":1215,"_30262":1176,"_21040":53293,"_5":14474,"_27550":53185,"_2978":53294},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3496":1216,"_30262":1176,"_21040":53296,"_5":14474,"_27550":53185,"_2978":53297},[],"`invalid RawSubject bytes`",{"_3496":1217,"_30262":1176,"_21040":53299,"_5":14474,"_27550":53185,"_2978":53300},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3496":1218,"_30262":1176,"_21040":53302,"_5":14474,"_27550":53185,"_2978":53303},[],"`invalid reenroll window`",{"_3496":1219,"_30262":1176,"_21040":53305,"_5":14474,"_27550":53185,"_2978":53306},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3496":1220,"_30262":1176,"_21040":53308,"_5":14474,"_27550":53185,"_2978":53309},[],"Current certificate revoked",{"_3496":1221,"_30262":1176,"_21040":53311,"_5":14474,"_27550":53185,"_2978":53312},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3496":1222,"_30262":1176,"_21040":53314,"_5":14474,"_27550":53185,"_2978":53315},[],"CA, profile or signing error",{"_3496":1223,"_30262":1176,"_21040":53317,"_5":14474,"_27550":53185,"_2978":53318},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3496":1224,"_30262":1176,"_21040":53320,"_5":14474,"_27550":53185,"_2978":53321},[],"HTTP 200 without a device connection",{"_3496":1225,"_30262":1176,"_21040":53323,"_5":14474,"_27550":53185,"_2978":53324},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3496":1226,"_30262":1176,"_21040":53326,"_5":14474,"_27550":53185,"_2978":53327},[],"Timeout or error after issuance",{"_3496":1227,"_30262":1176,"_21040":53329,"_5":14474,"_27550":53185,"_2978":53330},[],"New certificates, current slot and previous identity's state before retrying.",{"_3496":1228,"_30262":1176,"_21040":53332,"_5":14474,"_27550":53189,"_2978":53333},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3496":1229,"_30262":1176,"_21040":53335,"_5":14474,"_27550":53189,"_2978":53336},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3496":1230,"_30262":1176,"_21040":53338,"_5":14474,"_27550":53192,"_2978":53339},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3496":1231,"_30262":1176,"_21040":53341,"_5":14474,"_27550":53192,"_2978":53342},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3496":1232,"_30262":1176,"_21040":53344,"_5":14474,"_27550":53192,"_2978":53345},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3496":1233,"_30262":1176,"_21040":53347,"_5":14474,"_27550":53192,"_2978":53348},[],"Make one request, save headers/body and query the device and certificates.",{"_3496":1234,"_30262":1176,"_21040":53350,"_5":14474,"_27550":53192,"_2978":53351},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3496":1235,"_30262":1176,"_21040":53353,"_5":14474,"_27550":53192,"_2978":53354},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3496":1236,"_30262":1176,"_21040":53356,"_5":14474,"_27550":53192,"_2978":53357},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3496":1237,"_30262":1237,"_5":14825,"_2978":53359,"_30620":53360,"_21040":53361,"_27550":1237},"Trust distribution and updates",[49507,50975,51989,51987,52170],[],{"_3496":1238,"_30262":1237,"_21040":53363,"_5":14474,"_27550":1237,"_2978":53364},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3496":1239,"_30262":1237,"_5":30617,"_21040":53366,"_27550":53367,"_2978":53368},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3496":1240,"_30262":1237,"_5":30617,"_21040":53370,"_27550":53371,"_2978":53372},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3496":1241,"_30262":1237,"_5":30617,"_21040":53374,"_27550":53375,"_2978":53376},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3496":1242,"_30262":1237,"_5":30617,"_21040":53378,"_27550":53379,"_2978":53380},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3496":1243,"_30262":1237,"_5":30617,"_21040":53382,"_27550":53383,"_2978":53384},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3496":1244,"_30262":1237,"_21040":53386,"_5":14474,"_27550":1237,"_2978":53387},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3496":1245,"_30262":1237,"_21040":53389,"_5":14474,"_27550":53367,"_2978":53390},[],"Relationship",{"_3496":1246,"_30262":1237,"_21040":53392,"_5":14474,"_27550":53367,"_2978":53393},[],"Material prepared by its owner",{"_3496":1247,"_30262":1237,"_21040":53395,"_5":14474,"_27550":53367,"_2978":53396},[],"Device → EST server",{"_3496":1248,"_30262":1237,"_21040":53398,"_5":14474,"_27550":53367,"_2978":53399},[],"Previously verified server root, chain or pin and TLS name.",{"_3496":1249,"_30262":1237,"_21040":53401,"_5":14474,"_27550":53367,"_2978":53402},[],"DMS → requester",{"_3496":1250,"_30262":1237,"_21040":53404,"_5":14474,"_27550":53367,"_2978":53405},[],"CAs and rules authorizing initial or renewal credentials.",{"_3496":1251,"_30262":1237,"_21040":53407,"_5":14474,"_27550":53367,"_2978":53408},[],"Consumer → device",{"_3496":1252,"_30262":1237,"_21040":53410,"_5":14474,"_27550":53367,"_2978":53411},[],"Operational identity roots, intermediates, validation and permissions.",{"_3496":1253,"_30262":1237,"_21040":53413,"_5":14474,"_27550":53367,"_2978":53414},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3496":1254,"_30262":1237,"_21040":53416,"_5":14474,"_27550":53371,"_2978":53417},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3496":1255,"_30262":1237,"_21040":53419,"_5":14474,"_27550":53371,"_2978":53420},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3496":1256,"_30262":1237,"_21040":53422,"_5":14474,"_27550":53375,"_2978":53423},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3496":1257,"_30262":1237,"_21040":53425,"_5":14474,"_27550":53375,"_2978":53426},[],"Select policy-approved roots as anchors.",{"_3496":1258,"_30262":1237,"_21040":53428,"_5":14474,"_27550":53375,"_2978":53429},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3496":1259,"_30262":1237,"_21040":53431,"_5":14474,"_27550":53375,"_2978":53432},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3496":1260,"_30262":1237,"_21040":53434,"_5":14474,"_27550":53375,"_2978":53435},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3496":1261,"_30262":1237,"_21040":53437,"_5":14474,"_27550":53375,"_2978":53438},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3496":1262,"_30262":1237,"_21040":53440,"_5":14474,"_27550":53379,"_2978":53441},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3496":1263,"_30262":1237,"_21040":53443,"_5":14474,"_27550":53379,"_2978":53444},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3496":1264,"_30262":1237,"_21040":53446,"_5":14474,"_27550":53379,"_2978":53447},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3496":1265,"_30262":1237,"_21040":53449,"_5":14474,"_27550":53383,"_2978":53450},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3496":1266,"_30262":1266,"_5":14825,"_2978":53452,"_30620":53453,"_21040":53455,"_27550":1266},"AWS IoT Core",[49507,50975,51989,51987,53454],"Integrations",[],{"_3496":1267,"_30262":1266,"_21040":53457,"_5":14474,"_27550":1266,"_2978":53458},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3496":1268,"_30262":1266,"_5":30617,"_21040":53460,"_27550":53461,"_2978":53462},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3496":1269,"_30262":1266,"_5":30617,"_21040":53464,"_27550":53465,"_2978":53466},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3496":1270,"_30262":1266,"_5":30617,"_21040":53468,"_27550":53469,"_2978":53470},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3496":1271,"_30262":1266,"_5":30617,"_21040":53472,"_27550":53473,"_2978":53474},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3496":1272,"_30262":1266,"_5":30617,"_21040":53476,"_27550":53477,"_2978":53478},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3496":1273,"_30262":1266,"_5":30617,"_21040":53480,"_27550":53481,"_2978":53482},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3496":1274,"_30262":1266,"_5":30617,"_21040":53484,"_27550":53485,"_2978":53486},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3496":1275,"_30262":1266,"_5":30617,"_21040":53488,"_27550":53489,"_2978":53490},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3496":1276,"_30262":1266,"_5":30617,"_21040":53492,"_27550":53493,"_2978":53494},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3496":1277,"_30262":1266,"_5":30617,"_21040":53496,"_27550":53497,"_2978":53498},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3496":1278,"_30262":1266,"_5":30617,"_21040":53500,"_27550":53501,"_2978":53502},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3496":1279,"_30262":1266,"_5":30617,"_21040":53504,"_27550":53505,"_2978":53506},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3496":1280,"_30262":1266,"_5":30617,"_21040":53508,"_27550":53509,"_2978":53510},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3496":1281,"_30262":1266,"_5":30617,"_21040":53512,"_27550":53513,"_2978":53514},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3496":1282,"_30262":1266,"_5":30617,"_21040":53516,"_27550":53517,"_2978":53518},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3496":1283,"_30262":1266,"_5":30617,"_21040":53520,"_27550":53521,"_2978":53522},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3496":1284,"_30262":1266,"_5":30617,"_21040":53524,"_27550":53525,"_2978":53526},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3496":1285,"_30262":1266,"_5":30617,"_21040":53528,"_27550":53529,"_2978":53530},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3496":1286,"_30262":1266,"_5":30617,"_21040":53532,"_27550":53533,"_2978":53534},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3496":1287,"_30262":1266,"_5":30617,"_21040":53536,"_27550":53537,"_2978":53538},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3496":1288,"_30262":1266,"_5":30617,"_21040":53540,"_27550":53541,"_2978":53542},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3496":1289,"_30262":1266,"_5":30617,"_21040":53544,"_27550":53545,"_2978":53546},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3496":1290,"_30262":1266,"_5":30617,"_21040":53548,"_27550":53549,"_2978":53550},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3496":1291,"_30262":1266,"_5":30617,"_21040":53552,"_27550":53553,"_2978":53554},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3496":1292,"_30262":1266,"_5":30617,"_21040":53556,"_27550":53557,"_2978":53558},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3496":1293,"_30262":1266,"_21040":53560,"_5":14474,"_27550":1266,"_2978":53561},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3496":1294,"_30262":1266,"_21040":53563,"_5":14474,"_27550":1266,"_2978":53564},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3496":1295,"_30262":1266,"_21040":53566,"_5":14474,"_27550":1266,"_2978":53567},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3496":1296,"_30262":1266,"_21040":53569,"_5":14474,"_27550":53461,"_2978":53570},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3496":1297,"_30262":1266,"_21040":53572,"_5":14474,"_27550":53461,"_2978":53573},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3496":1298,"_30262":1266,"_21040":53575,"_5":14474,"_27550":53461,"_2978":53576},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3496":1299,"_30262":1266,"_21040":53578,"_5":14474,"_27550":53461,"_2978":53579},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3496":1300,"_30262":1266,"_21040":53581,"_5":14474,"_27550":53465,"_2978":53582},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3496":1301,"_30262":1266,"_21040":53584,"_5":14474,"_27550":53469,"_2978":53585},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3496":1302,"_30262":1266,"_21040":53587,"_5":14474,"_27550":53469,"_2978":53588},[],"IAM action",{"_3496":1303,"_30262":1266,"_21040":53590,"_5":14474,"_27550":53469,"_2978":49897},[],{"_3496":1304,"_30262":1266,"_21040":53592,"_5":14474,"_27550":53469,"_2978":53593},[],"`iot:GetRegistrationCode`",{"_3496":1305,"_30262":1266,"_21040":53595,"_5":14474,"_27550":53469,"_2978":53596},[],"Obtain the verification code for CA registration in the Primary Account",{"_3496":1306,"_30262":1266,"_21040":53598,"_5":14474,"_27550":53469,"_2978":53599},[],"`iot:RegisterCACertificate`",{"_3496":1307,"_30262":1266,"_21040":53601,"_5":14474,"_27550":53469,"_2978":53602},[],"Register the CA in AWS IoT",{"_3496":1308,"_30262":1266,"_21040":53604,"_5":14474,"_27550":53469,"_2978":53605},[],"`iot:DescribeCACertificate`",{"_3496":1309,"_30262":1266,"_21040":53607,"_5":14474,"_27550":53469,"_2978":53608},[],"Check the CA registration status",{"_3496":1310,"_30262":1266,"_21040":53610,"_5":14474,"_27550":53469,"_2978":53611},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3496":1311,"_30262":1266,"_21040":53613,"_5":14474,"_27550":53469,"_2978":53614},[],"Create or update Things in IoT Core",{"_3496":1312,"_30262":1266,"_21040":53616,"_5":14474,"_27550":53469,"_2978":53617},[],"`iot:RegisterThing`",{"_3496":1313,"_30262":1266,"_21040":53619,"_5":14474,"_27550":53469,"_2978":53620},[],"Provision Things through a template",{"_3496":1314,"_30262":1266,"_21040":53622,"_5":14474,"_27550":53469,"_2978":53623},[],"`iot:RegisterCertificate`",{"_3496":1315,"_30262":1266,"_21040":53625,"_5":14474,"_27550":53469,"_2978":53626},[],"Register device certificates",{"_3496":1316,"_30262":1266,"_21040":53628,"_5":14474,"_27550":53469,"_2978":53629},[],"`iot:UpdateCertificate`",{"_3496":1317,"_30262":1266,"_21040":53631,"_5":14474,"_27550":53469,"_2978":53632},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3496":1318,"_30262":1266,"_21040":53634,"_5":14474,"_27550":53469,"_2978":53635},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3496":1319,"_30262":1266,"_21040":53637,"_5":14474,"_27550":53469,"_2978":53638},[],"Create and attach IoT policies",{"_3496":1320,"_30262":1266,"_21040":53640,"_5":14474,"_27550":53469,"_2978":53641},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3496":1321,"_30262":1266,"_21040":53643,"_5":14474,"_27550":53469,"_2978":53644},[],"Manage Thing groups",{"_3496":1322,"_30262":1266,"_21040":53646,"_5":14474,"_27550":53469,"_2978":53647},[],"`iot:CreateProvisioningTemplate`",{"_3496":1323,"_30262":1266,"_21040":53649,"_5":14474,"_27550":53469,"_2978":53650},[],"Create JITP templates",{"_3496":1324,"_30262":1266,"_21040":53652,"_5":14474,"_27550":53469,"_2978":53653},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3496":1325,"_30262":1266,"_21040":53655,"_5":14474,"_27550":53469,"_2978":53656},[],"Read and write the Device Shadow",{"_3496":1326,"_30262":1266,"_21040":53658,"_5":14474,"_27550":53469,"_2978":53659},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3496":1327,"_30262":1266,"_21040":53661,"_5":14474,"_27550":53473,"_2978":53662},[],"Parameter",{"_3496":1328,"_30262":1266,"_21040":53664,"_5":14474,"_27550":53473,"_2978":53665},[],"Type",{"_3496":1329,"_30262":1266,"_21040":53667,"_5":14474,"_27550":53473,"_2978":53668},[],"Required",{"_3496":1330,"_30262":1266,"_21040":53670,"_5":14474,"_27550":53473,"_2978":53671},[],"Description",{"_3496":1331,"_30262":1266,"_21040":53673,"_5":14474,"_27550":53473,"_2978":53674},[],"`connector_id`",{"_3496":1332,"_30262":1266,"_21040":53676,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1333,"_30262":1266,"_21040":53678,"_5":14474,"_27550":53473,"_2978":53679},[],"Yes",{"_3496":1334,"_30262":1266,"_21040":53681,"_5":14474,"_27550":53473,"_2978":53682},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3496":1335,"_30262":1266,"_21040":53684,"_5":14474,"_27550":53473,"_2978":53685},[],"`aws_config.region`",{"_3496":1336,"_30262":1266,"_21040":53687,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1337,"_30262":1266,"_21040":53689,"_5":14474,"_27550":53473,"_2978":53679},[],{"_3496":1338,"_30262":1266,"_21040":53691,"_5":14474,"_27550":53473,"_2978":53692},[],"AWS region where the connector operates.",{"_3496":1339,"_30262":1266,"_21040":53694,"_5":14474,"_27550":53473,"_2978":53695},[],"`aws_config.auth_method`",{"_3496":1340,"_30262":1266,"_21040":53697,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1341,"_30262":1266,"_21040":53699,"_5":14474,"_27550":53473,"_2978":53679},[],{"_3496":1342,"_30262":1266,"_21040":53701,"_5":14474,"_27550":53473,"_2978":53702},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3496":1343,"_30262":1266,"_21040":53704,"_5":14474,"_27550":53473,"_2978":53705},[],"`aws_config.access_key_id`",{"_3496":1344,"_30262":1266,"_21040":53707,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1345,"_30262":1266,"_21040":53709,"_5":14474,"_27550":53473,"_2978":53710},[],"Only with `auth_method=static`",{"_3496":1346,"_30262":1266,"_21040":53712,"_5":14474,"_27550":53473,"_2978":53713},[],"AWS access key.",{"_3496":1347,"_30262":1266,"_21040":53715,"_5":14474,"_27550":53473,"_2978":53716},[],"`aws_config.secret_access_key`",{"_3496":1348,"_30262":1266,"_21040":53718,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1349,"_30262":1266,"_21040":53720,"_5":14474,"_27550":53473,"_2978":53710},[],{"_3496":1350,"_30262":1266,"_21040":53722,"_5":14474,"_27550":53473,"_2978":53723},[],"AWS secret key.",{"_3496":1351,"_30262":1266,"_21040":53725,"_5":14474,"_27550":53473,"_2978":53726},[],"`aws_config.session_token`",{"_3496":1352,"_30262":1266,"_21040":53728,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1353,"_30262":1266,"_21040":53730,"_5":14474,"_27550":53473,"_2978":53731},[],"No",{"_3496":1354,"_30262":1266,"_21040":53733,"_5":14474,"_27550":53473,"_2978":53734},[],"Session token (with `auth_method=static`).",{"_3496":1355,"_30262":1266,"_21040":53736,"_5":14474,"_27550":53473,"_2978":53737},[],"`aws_config.role_arn`",{"_3496":1356,"_30262":1266,"_21040":53739,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1357,"_30262":1266,"_21040":53741,"_5":14474,"_27550":53473,"_2978":53742},[],"Only with `auth_method=role`",{"_3496":1358,"_30262":1266,"_21040":53744,"_5":14474,"_27550":53473,"_2978":53745},[],"ARN of the role to assume.",{"_3496":1359,"_30262":1266,"_21040":53747,"_5":14474,"_27550":53473,"_2978":53748},[],"`aws_config.endpoint_url`",{"_3496":1360,"_30262":1266,"_21040":53750,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1361,"_30262":1266,"_21040":53752,"_5":14474,"_27550":53473,"_2978":53731},[],{"_3496":1362,"_30262":1266,"_21040":53754,"_5":14474,"_27550":53473,"_2978":53755},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3496":1363,"_30262":1266,"_21040":53757,"_5":14474,"_27550":53473,"_2978":53758},[],"`subscriber_event_bus`",{"_3496":1364,"_30262":1266,"_21040":53760,"_5":14474,"_27550":53473,"_2978":17729},[],{"_3496":1365,"_30262":1266,"_21040":53762,"_5":14474,"_27550":53473,"_2978":53679},[],{"_3496":1366,"_30262":1266,"_21040":53764,"_5":14474,"_27550":53473,"_2978":53765},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3496":1367,"_30262":1266,"_21040":53767,"_5":14474,"_27550":53473,"_2978":53768},[],"`dms_manager_client`",{"_3496":1368,"_30262":1266,"_21040":53770,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1369,"_30262":1266,"_21040":53772,"_5":14474,"_27550":53473,"_2978":53679},[],{"_3496":1370,"_30262":1266,"_21040":53774,"_5":14474,"_27550":53473,"_2978":53775},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3496":1371,"_30262":1266,"_21040":53777,"_5":14474,"_27550":53473,"_2978":53778},[],"`device_manager_client`",{"_3496":1372,"_30262":1266,"_21040":53780,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1373,"_30262":1266,"_21040":53782,"_5":14474,"_27550":53473,"_2978":53679},[],{"_3496":1374,"_30262":1266,"_21040":53784,"_5":14474,"_27550":53473,"_2978":53785},[],"HTTP URL of Lamassu's Device Manager.",{"_3496":1375,"_30262":1266,"_21040":53787,"_5":14474,"_27550":53473,"_2978":53788},[],"`ca_client`",{"_3496":1376,"_30262":1266,"_21040":53790,"_5":14474,"_27550":53473,"_2978":25121},[],{"_3496":1377,"_30262":1266,"_21040":53792,"_5":14474,"_27550":53473,"_2978":53679},[],{"_3496":1378,"_30262":1266,"_21040":53794,"_5":14474,"_27550":53473,"_2978":53795},[],"HTTP URL of Lamassu's CA service.",{"_3496":1379,"_30262":1266,"_21040":53797,"_5":14474,"_27550":53477,"_2978":53798},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3496":1380,"_30262":1266,"_21040":53800,"_5":14474,"_27550":53477,"_2978":53801},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3496":1381,"_30262":1266,"_21040":53803,"_5":14474,"_27550":53477,"_2978":53804},[],"CloudEvent type",{"_3496":1382,"_30262":1266,"_21040":53806,"_5":14474,"_27550":53477,"_2978":53807},[],"Lamassu resource",{"_3496":1383,"_30262":1266,"_21040":53809,"_5":14474,"_27550":53477,"_2978":53810},[],"AWS Resource",{"_3496":1384,"_30262":1266,"_21040":53812,"_5":14474,"_27550":53477,"_2978":53813},[],"IAM actions",{"_3496":1385,"_30262":1266,"_21040":53815,"_5":14474,"_27550":53477,"_2978":53816},[],"AWS calls and effect",{"_3496":1386,"_30262":1266,"_21040":53818,"_5":14474,"_27550":53477,"_2978":53819},[],"Where in this page",{"_3496":1387,"_30262":1266,"_21040":53821,"_5":14474,"_27550":53477,"_2978":53822},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3496":1388,"_30262":1266,"_21040":53824,"_5":14474,"_27550":53477,"_2978":53825},[],"CA",{"_3496":1389,"_30262":1266,"_21040":53827,"_5":14474,"_27550":53477,"_2978":53828},[],"`IoTCore/CACertificate`",{"_3496":1390,"_30262":1266,"_21040":53830,"_5":14474,"_27550":53477,"_2978":53831},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3496":1391,"_30262":1266,"_21040":53833,"_5":14474,"_27550":53477,"_2978":53834},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3496":1392,"_30262":1266,"_21040":53836,"_5":14474,"_27550":53477,"_2978":53490},[],{"_3496":1393,"_30262":1266,"_21040":53838,"_5":14474,"_27550":53477,"_2978":53839},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3496":1394,"_30262":1266,"_21040":53841,"_5":14474,"_27550":53477,"_2978":53842},[],"DMS",{"_3496":1395,"_30262":1266,"_21040":53844,"_5":14474,"_27550":53477,"_2978":53845},[],"`IoTCore/ProvisioningTemplate`",{"_3496":1396,"_30262":1266,"_21040":53847,"_5":14474,"_27550":53477,"_2978":53848},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3496":1397,"_30262":1266,"_21040":53850,"_5":14474,"_27550":53477,"_2978":53851},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3496":1398,"_30262":1266,"_21040":53853,"_5":14474,"_27550":53477,"_2978":53518},[],{"_3496":1399,"_30262":1266,"_21040":53855,"_5":14474,"_27550":53477,"_2978":53856},[],"`EventBindDeviceIdentityKey`",{"_3496":1400,"_30262":1266,"_21040":53858,"_5":14474,"_27550":53477,"_2978":53859},[],"Device",{"_3496":1401,"_30262":1266,"_21040":53861,"_5":14474,"_27550":53477,"_2978":53862},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3496":1402,"_30262":1266,"_21040":53864,"_5":14474,"_27550":53477,"_2978":53865},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3496":1403,"_30262":1266,"_21040":53867,"_5":14474,"_27550":53477,"_2978":53868},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3496":1404,"_30262":1266,"_21040":53870,"_5":14474,"_27550":53477,"_2978":53526},[],{"_3496":1405,"_30262":1266,"_21040":53872,"_5":14474,"_27550":53477,"_2978":53873},[],"`EventUpdateCertificateStatusKey`",{"_3496":1406,"_30262":1266,"_21040":53875,"_5":14474,"_27550":53477,"_2978":53876},[],"Certificate",{"_3496":1407,"_30262":1266,"_21040":53878,"_5":14474,"_27550":53477,"_2978":53879},[],"`IoTCore/Certificate`",{"_3496":1408,"_30262":1266,"_21040":53881,"_5":14474,"_27550":53477,"_2978":53882},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3496":1409,"_30262":1266,"_21040":53884,"_5":14474,"_27550":53477,"_2978":53885},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3496":1410,"_30262":1266,"_21040":53887,"_5":14474,"_27550":53477,"_2978":53538},[],{"_3496":1411,"_30262":1266,"_21040":53889,"_5":14474,"_27550":53477,"_2978":53890},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3496":1412,"_30262":1266,"_21040":53892,"_5":14474,"_27550":53477,"_2978":53893},[],"Certificate / Device",{"_3496":1413,"_30262":1266,"_21040":53895,"_5":14474,"_27550":53477,"_2978":53896},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3496":1414,"_30262":1266,"_21040":53898,"_5":14474,"_27550":53477,"_2978":49903},[],{"_3496":1415,"_30262":1266,"_21040":53900,"_5":14474,"_27550":53477,"_2978":53901},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3496":1416,"_30262":1266,"_21040":53903,"_5":14474,"_27550":53477,"_2978":53546},[],{"_3496":1417,"_30262":1266,"_21040":53905,"_5":14474,"_27550":53481,"_2978":53906},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3496":1418,"_30262":1266,"_21040":53908,"_5":14474,"_27550":53485,"_2978":53909},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3496":1419,"_30262":1266,"_21040":53911,"_5":14474,"_27550":53485,"_2978":53912},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3496":1420,"_30262":1266,"_21040":53914,"_5":14474,"_27550":53489,"_2978":53915},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3496":1421,"_30262":1266,"_21040":53917,"_5":14474,"_27550":53489,"_2978":53918},[],"Transition",{"_3496":1422,"_30262":1266,"_21040":53920,"_5":14474,"_27550":53489,"_2978":53921},[],"AWS calls",{"_3496":1423,"_30262":1266,"_21040":53923,"_5":14474,"_27550":53489,"_2978":53924},[],"`NotRegistered` → `Requested`",{"_3496":1424,"_30262":1266,"_21040":53926,"_5":14474,"_27550":53489,"_2978":53927},[],"none (metadata write only)",{"_3496":1425,"_30262":1266,"_21040":53929,"_5":14474,"_27550":53489,"_2978":53930},[],"`Requested` → `Registering`",{"_3496":1426,"_30262":1266,"_21040":53932,"_5":14474,"_27550":53489,"_2978":53933},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3496":1427,"_30262":1266,"_21040":53935,"_5":14474,"_27550":53489,"_2978":53936},[],"`Registering` → `Succeeded`",{"_3496":1428,"_30262":1266,"_21040":53938,"_5":14474,"_27550":53489,"_2978":53939},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3496":1429,"_30262":1266,"_21040":53941,"_5":14474,"_27550":53489,"_2978":53942},[],"`Registering` → `Failed`",{"_3496":1430,"_30262":1266,"_21040":53944,"_5":14474,"_27550":53489,"_2978":53945},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3496":1431,"_30262":1266,"_21040":53947,"_5":14474,"_27550":53489,"_2978":53948},[],"`Failed` / `Succeeded` → `Requested`",{"_3496":1432,"_30262":1266,"_21040":53950,"_5":14474,"_27550":53489,"_2978":53951},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3496":1433,"_30262":1266,"_21040":53953,"_5":14474,"_27550":53493,"_2978":53954},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3496":1434,"_30262":1266,"_21040":53956,"_5":14474,"_27550":53493,"_2978":53957},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3496":1435,"_30262":1266,"_21040":53959,"_5":14474,"_27550":53493,"_2978":53960},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3496":1436,"_30262":1266,"_21040":53962,"_5":14474,"_27550":53493,"_2978":53963},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3496":1437,"_30262":1266,"_21040":53965,"_5":14474,"_27550":53493,"_2978":53966},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3496":1438,"_30262":1266,"_21040":53968,"_5":14474,"_27550":53493,"_2978":53969},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3496":1439,"_30262":1266,"_21040":53971,"_5":14474,"_27550":53497,"_2978":53972},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3496":1440,"_30262":1266,"_21040":53974,"_5":14474,"_27550":53501,"_2978":53975},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3496":1441,"_30262":1266,"_21040":53977,"_5":14474,"_27550":53501,"_2978":53978},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3496":1442,"_30262":1266,"_21040":53980,"_5":14474,"_27550":53505,"_2978":53981},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3496":1443,"_30262":1266,"_21040":53983,"_5":14474,"_27550":53509,"_2978":53984},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3496":1444,"_30262":1266,"_21040":53986,"_5":14474,"_27550":53509,"_2978":53987},[],"Creates or updates the IoT policies configured in the DMS.",{"_3496":1445,"_30262":1266,"_21040":53989,"_5":14474,"_27550":53509,"_2978":53990},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3496":1446,"_30262":1266,"_21040":53992,"_5":14474,"_27550":53509,"_2978":53993},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3496":1447,"_30262":1266,"_21040":53995,"_5":14474,"_27550":53509,"_2978":53996},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3496":1448,"_30262":1266,"_21040":53998,"_5":14474,"_27550":53509,"_2978":53999},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3496":1449,"_30262":1266,"_21040":54001,"_5":14474,"_27550":53509,"_2978":54002},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3496":1450,"_30262":1266,"_21040":54004,"_5":14474,"_27550":53513,"_2978":54005},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3496":1451,"_30262":1266,"_21040":54007,"_5":14474,"_27550":53513,"_2978":54008},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3496":1452,"_30262":1266,"_21040":54010,"_5":14474,"_27550":53513,"_2978":54011},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3496":1453,"_30262":1266,"_21040":54013,"_5":14474,"_27550":53513,"_2978":54014},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3496":1454,"_30262":1266,"_21040":54016,"_5":14474,"_27550":53513,"_2978":54017},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3496":1455,"_30262":1266,"_21040":54019,"_5":14474,"_27550":53517,"_2978":54020},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3496":1456,"_30262":1266,"_21040":54022,"_5":14474,"_27550":53517,"_2978":53918},[],{"_3496":1457,"_30262":1266,"_21040":54024,"_5":14474,"_27550":53517,"_2978":53921},[],{"_3496":1458,"_30262":1266,"_21040":54026,"_5":14474,"_27550":53517,"_2978":54027},[],"`Unconfigured` → `None` / `Auto`",{"_3496":1459,"_30262":1266,"_21040":54029,"_5":14474,"_27550":53517,"_2978":54030},[],"none (configuration only)",{"_3496":1460,"_30262":1266,"_21040":54032,"_5":14474,"_27550":53517,"_2978":54033},[],"`None` ↔ `Auto`",{"_3496":1461,"_30262":1266,"_21040":54035,"_5":14474,"_27550":53517,"_2978":54030},[],{"_3496":1462,"_30262":1266,"_21040":54037,"_5":14474,"_27550":53517,"_2978":54038},[],"Any → `Jitp`",{"_3496":1463,"_30262":1266,"_21040":54040,"_5":14474,"_27550":53517,"_2978":54041},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3496":1464,"_30262":1266,"_21040":54043,"_5":14474,"_27550":53517,"_2978":54044},[],"`Jitp` → `None` / `Auto`",{"_3496":1465,"_30262":1266,"_21040":54046,"_5":14474,"_27550":53517,"_2978":54047},[],"none (the template stays in the AWS account)",{"_3496":1466,"_30262":1266,"_21040":54049,"_5":14474,"_27550":53521,"_2978":54050},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3496":1467,"_30262":1266,"_21040":54052,"_5":14474,"_27550":53521,"_2978":54053},[],"The full flow from the device's perspective is:",{"_3496":1468,"_30262":1266,"_21040":54055,"_5":14474,"_27550":53521,"_2978":54056},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3496":1469,"_30262":1266,"_21040":54058,"_5":14474,"_27550":53525,"_2978":54059},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3496":1470,"_30262":1266,"_21040":54061,"_5":14474,"_27550":53525,"_2978":53918},[],{"_3496":1471,"_30262":1266,"_21040":54063,"_5":14474,"_27550":53525,"_2978":53921},[],{"_3496":1472,"_30262":1266,"_21040":54065,"_5":14474,"_27550":53525,"_2978":54066},[],"`Absent` → `Provisioned`",{"_3496":1473,"_30262":1266,"_21040":54068,"_5":14474,"_27550":53525,"_2978":54069},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3496":1474,"_30262":1266,"_21040":54071,"_5":14474,"_27550":53525,"_2978":54072},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3496":1475,"_30262":1266,"_21040":54074,"_5":14474,"_27550":53525,"_2978":54075},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3496":1476,"_30262":1266,"_21040":54077,"_5":14474,"_27550":53525,"_2978":54078},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3496":1477,"_30262":1266,"_21040":54080,"_5":14474,"_27550":53529,"_2978":54081},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3496":1478,"_30262":1266,"_21040":54083,"_5":14474,"_27550":53529,"_2978":54084},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3496":1479,"_30262":1266,"_21040":54086,"_5":14474,"_27550":53529,"_2978":54087},[],"For the JITP flow to work correctly:",{"_3496":1480,"_30262":1266,"_21040":54089,"_5":14474,"_27550":53529,"_2978":54090},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3496":1481,"_30262":1266,"_21040":54092,"_5":14474,"_27550":53529,"_2978":54093},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3496":1482,"_30262":1266,"_21040":54095,"_5":14474,"_27550":53529,"_2978":54096},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3496":1483,"_30262":1266,"_21040":54098,"_5":14474,"_27550":53529,"_2978":54099},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3496":1484,"_30262":1266,"_21040":54101,"_5":14474,"_27550":53533,"_2978":54102},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3496":1485,"_30262":1266,"_21040":54104,"_5":14474,"_27550":53533,"_2978":54105},[],"Status in Lamassu",{"_3496":1486,"_30262":1266,"_21040":54107,"_5":14474,"_27550":53533,"_2978":54108},[],"Revocation reason",{"_3496":1487,"_30262":1266,"_21040":54110,"_5":14474,"_27550":53533,"_2978":54111},[],"Status in AWS IoT Core",{"_3496":1488,"_30262":1266,"_21040":54113,"_5":14474,"_27550":53533,"_2978":54114},[],"`Active`",{"_3496":1489,"_30262":1266,"_21040":54116,"_5":14474,"_27550":53533,"_2978":54117},[],"None",{"_3496":1490,"_30262":1266,"_21040":54119,"_5":14474,"_27550":53533,"_2978":54120},[],"`ACTIVE`",{"_3496":1491,"_30262":1266,"_21040":54122,"_5":14474,"_27550":53533,"_2978":54123},[],"`Revoked`",{"_3496":1492,"_30262":1266,"_21040":54125,"_5":14474,"_27550":53533,"_2978":54126},[],"`certificateHold`",{"_3496":1493,"_30262":1266,"_21040":54128,"_5":14474,"_27550":53533,"_2978":54129},[],"`INACTIVE`",{"_3496":1494,"_30262":1266,"_21040":54131,"_5":14474,"_27550":53533,"_2978":54123},[],{"_3496":1495,"_30262":1266,"_21040":54133,"_5":14474,"_27550":53533,"_2978":54134},[],"Any other reason",{"_3496":1496,"_30262":1266,"_21040":54136,"_5":14474,"_27550":53533,"_2978":54137},[],"`REVOKED`",{"_3496":1497,"_30262":1266,"_21040":54139,"_5":14474,"_27550":53533,"_2978":54140},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3496":1498,"_30262":1266,"_21040":54142,"_5":14474,"_27550":53537,"_2978":54143},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3496":1499,"_30262":1266,"_21040":54145,"_5":14474,"_27550":53537,"_2978":53918},[],{"_3496":1500,"_30262":1266,"_21040":54147,"_5":14474,"_27550":53537,"_2978":53921},[],{"_3496":1501,"_30262":1266,"_21040":54149,"_5":14474,"_27550":53537,"_2978":54150},[],"`NotSynced` → `Active`",{"_3496":1502,"_30262":1266,"_21040":54152,"_5":14474,"_27550":53537,"_2978":53629},[],{"_3496":1503,"_30262":1266,"_21040":54154,"_5":14474,"_27550":53537,"_2978":54155},[],"`Active` → `Inactive`",{"_3496":1504,"_30262":1266,"_21040":54157,"_5":14474,"_27550":53537,"_2978":54158},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3496":1505,"_30262":1266,"_21040":54160,"_5":14474,"_27550":53537,"_2978":54161},[],"`Active` → `Revoked`",{"_3496":1506,"_30262":1266,"_21040":54163,"_5":14474,"_27550":53537,"_2978":54158},[],{"_3496":1507,"_30262":1266,"_21040":54165,"_5":14474,"_27550":53537,"_2978":54166},[],"`Inactive` / `Revoked` → `Active`",{"_3496":1508,"_30262":1266,"_21040":54168,"_5":14474,"_27550":53537,"_2978":53629},[],{"_3496":1509,"_30262":1266,"_21040":54170,"_5":14474,"_27550":53537,"_2978":54171},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3496":1510,"_30262":1266,"_21040":54173,"_5":14474,"_27550":53537,"_2978":54174},[],"none (these states are not synced to AWS)",{"_3496":1511,"_30262":1266,"_21040":54176,"_5":14474,"_27550":53541,"_2978":54177},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3496":1512,"_30262":1266,"_21040":54179,"_5":14474,"_27550":53541,"_2978":54180},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3496":1513,"_30262":1266,"_21040":54182,"_5":14474,"_27550":53541,"_2978":54183},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3496":1514,"_30262":1266,"_21040":54185,"_5":14474,"_27550":53545,"_2978":54186},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3496":1515,"_30262":1266,"_21040":54188,"_5":14474,"_27550":53545,"_2978":54189},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3496":1516,"_30262":1266,"_21040":54191,"_5":14474,"_27550":53549,"_2978":54192},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3496":1517,"_30262":1266,"_21040":54194,"_5":14474,"_27550":53549,"_2978":54195},[],"There are two action types:",{"_3496":1518,"_30262":1266,"_21040":54197,"_5":14474,"_27550":53549,"_2978":54198},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3496":1519,"_30262":1266,"_21040":54200,"_5":14474,"_27550":53549,"_2978":54201},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3496":1520,"_30262":1266,"_21040":54203,"_5":14474,"_27550":53549,"_2978":54204},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3496":1521,"_30262":1266,"_21040":54206,"_5":14474,"_27550":53553,"_2978":54207},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3496":1522,"_30262":1266,"_21040":54209,"_5":14474,"_27550":53553,"_2978":54210},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3496":1523,"_30262":1266,"_21040":54212,"_5":14474,"_27550":53553,"_2978":54213},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3496":1524,"_30262":1266,"_21040":54215,"_5":14474,"_27550":53557,"_2978":54216},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3496":1525,"_30262":1266,"_21040":54218,"_5":14474,"_27550":53557,"_2978":54219},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3496":1526,"_30262":1266,"_21040":54221,"_5":14474,"_27550":53557,"_2978":54222},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3496":1527,"_30262":1266,"_21040":54224,"_5":14474,"_27550":53557,"_2978":54225},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3496":1528,"_30262":1266,"_21040":54227,"_5":14474,"_27550":53557,"_2978":54228},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3496":1529,"_30262":1266,"_21040":54230,"_5":14474,"_27550":53557,"_2978":54231},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3496":1530,"_30262":1266,"_21040":54233,"_5":14474,"_27550":53557,"_2978":54234},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3496":1531,"_30262":1266,"_21040":54236,"_5":14474,"_27550":53557,"_2978":54237},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3496":1532,"_30262":1266,"_21040":54239,"_5":14474,"_27550":53557,"_2978":54240},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3496":1533,"_30262":1266,"_21040":54242,"_5":14474,"_27550":53557,"_2978":54243},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3496":1534,"_30262":1266,"_21040":54245,"_5":14474,"_27550":53557,"_2978":54246},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3496":1535,"_30262":1266,"_21040":54248,"_5":14474,"_27550":53557,"_2978":54249},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3496":1536,"_30262":1266,"_21040":54251,"_5":14474,"_27550":53557,"_2978":54252},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3496":1537,"_30262":1266,"_21040":54254,"_5":14474,"_27550":53557,"_2978":54255},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3496":1538,"_30262":1266,"_21040":54257,"_5":14474,"_27550":53557,"_2978":54258},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3496":1539,"_30262":1266,"_21040":54260,"_5":14474,"_27550":53557,"_2978":54261},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3496":1540,"_30262":1266,"_21040":54263,"_5":14474,"_27550":53557,"_2978":54264},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3496":1541,"_30262":1266,"_21040":54266,"_5":14474,"_27550":53557,"_2978":54267},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3496":1542,"_30262":1266,"_21040":54269,"_5":14474,"_27550":53557,"_2978":54270},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3496":1543,"_30262":1266,"_21040":54272,"_5":14474,"_27550":53557,"_2978":54273},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3496":1544,"_30262":1266,"_21040":54275,"_5":14474,"_27550":53557,"_2978":54276},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3496":1545,"_30262":1266,"_21040":54278,"_5":14474,"_27550":53557,"_2978":54279},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3496":1546,"_30262":1266,"_21040":54281,"_5":14474,"_27550":53557,"_2978":54282},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3496":1547,"_30262":1266,"_21040":54284,"_5":14474,"_27550":53557,"_2978":54285},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3496":1548,"_30262":1548,"_5":14825,"_2978":51989,"_30620":54287,"_21040":54288,"_27550":1548},[49507,50975,51989],[],{"_3496":1549,"_30262":1548,"_21040":54290,"_5":14474,"_27550":1548,"_2978":54291},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3496":1550,"_30262":1548,"_5":30617,"_21040":54293,"_27550":54294,"_2978":54295},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#start-here","Start here",{"_3496":1551,"_30262":1548,"_5":30617,"_21040":54297,"_27550":54298,"_2978":51987},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#devices-and-identities",{"_3496":1552,"_30262":1548,"_5":30617,"_21040":54300,"_27550":54301,"_2978":52170},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#enrollment-with-pki",{"_3496":1553,"_30262":1548,"_5":30617,"_21040":54303,"_27550":54304,"_2978":53454},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#integrations",{"_3496":1554,"_30262":1548,"_5":30617,"_21040":54306,"_27550":54307,"_2978":54308},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3496":1555,"_30262":1548,"_21040":54310,"_5":14474,"_27550":1548,"_2978":54311},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3496":1556,"_30262":1548,"_21040":54313,"_5":14474,"_27550":54294,"_2978":54314},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3496":1557,"_30262":1548,"_21040":54316,"_5":14474,"_27550":54294,"_2978":54317},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3496":1558,"_30262":1548,"_21040":54319,"_5":14474,"_27550":54298,"_2978":54320},[],"Resource",{"_3496":1559,"_30262":1548,"_21040":54322,"_5":14474,"_27550":54298,"_2978":54323},[],"What it represents",{"_3496":1560,"_30262":1548,"_21040":54325,"_5":14474,"_27550":54298,"_2978":54326},[],"**Device**",{"_3496":1561,"_30262":1548,"_21040":54328,"_5":14474,"_27550":54298,"_2978":54329},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3496":1562,"_30262":1548,"_21040":54331,"_5":14474,"_27550":54298,"_2978":54332},[],"**Identity**",{"_3496":1563,"_30262":1548,"_21040":54334,"_5":14474,"_27550":54298,"_2978":54335},[],"The device's association with its certificates: an active version and a history.",{"_3496":1564,"_30262":1548,"_21040":54337,"_5":14474,"_27550":54298,"_2978":54338},[],"**DMS**",{"_3496":1565,"_30262":1548,"_21040":54340,"_5":14474,"_27550":54298,"_2978":54341},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3496":1566,"_30262":1548,"_21040":54343,"_5":14474,"_27550":54298,"_2978":54344},[],"**Fleet**",{"_3496":1567,"_30262":1548,"_21040":54346,"_5":14474,"_27550":54298,"_2978":54347},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3496":1568,"_30262":1548,"_21040":54349,"_5":14474,"_27550":54298,"_2978":54350},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3496":1569,"_30262":1548,"_21040":54352,"_5":14474,"_27550":54298,"_2978":54353},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3496":1570,"_30262":1548,"_21040":54355,"_5":14474,"_27550":54301,"_2978":54356},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3496":1571,"_30262":1548,"_21040":54358,"_5":14474,"_27550":54301,"_2978":54359},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3496":1572,"_30262":1548,"_21040":54361,"_5":14474,"_27550":54301,"_2978":54362},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3496":1573,"_30262":1548,"_21040":54364,"_5":14474,"_27550":54301,"_2978":54365},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3496":1574,"_30262":1548,"_21040":54367,"_5":14474,"_27550":54301,"_2978":54368},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3496":1575,"_30262":1548,"_21040":54370,"_5":14474,"_27550":54301,"_2978":54371},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3496":1576,"_30262":1548,"_21040":54373,"_5":14474,"_27550":54301,"_2978":54374},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3496":1577,"_30262":1548,"_21040":54376,"_5":14474,"_27550":54301,"_2978":54377},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3496":1578,"_30262":1548,"_21040":54379,"_5":14474,"_27550":54304,"_2978":54380},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3496":1579,"_30262":1548,"_21040":54382,"_5":14474,"_27550":54304,"_2978":54383},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3496":1580,"_30262":1548,"_21040":54385,"_5":14474,"_27550":54307,"_2978":54386},[],"Participant",{"_3496":1581,"_30262":1548,"_21040":54388,"_5":14474,"_27550":54307,"_2978":54389},[],"Responsibility",{"_3496":1582,"_30262":1548,"_21040":54391,"_5":14474,"_27550":54307,"_2978":54392},[],"PKI administrator",{"_3496":1583,"_30262":1548,"_21040":54394,"_5":14474,"_27550":54307,"_2978":54395},[],"CA, issuance profile, chain and revocation publication.",{"_3496":1584,"_30262":1548,"_21040":54397,"_5":14474,"_27550":54307,"_2978":54398},[],"Provisioning administrator",{"_3496":1585,"_30262":1548,"_21040":54400,"_5":14474,"_27550":54307,"_2978":54401},[],"DMS, admission, authentication per operation and inventory.",{"_3496":1586,"_30262":1548,"_21040":54403,"_5":14474,"_27550":54307,"_2978":54404},[],"Device integrator",{"_3496":1587,"_30262":1548,"_21040":54406,"_5":14474,"_27550":54307,"_2978":54407},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3496":1588,"_30262":1548,"_21040":54409,"_5":14474,"_27550":54307,"_2978":54410},[],"Consumer integrator",{"_3496":1589,"_30262":1548,"_21040":54412,"_5":14474,"_27550":54307,"_2978":54413},[],"Trusted issuers, validation and device permissions in the destination.",{"_3496":1590,"_30262":1548,"_21040":54415,"_5":14474,"_27550":54307,"_2978":54416},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3496":1591,"_30262":1591,"_5":14825,"_2978":54418,"_30620":54419,"_21040":54421,"_27550":1591},"Enroll and connect your first device",[49507,50975,51989,54420],"Getting started",[],{"_3496":1592,"_30262":1591,"_21040":54423,"_5":14474,"_27550":1591,"_2978":54424},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3496":1593,"_30262":1591,"_5":30617,"_21040":54426,"_27550":54427,"_2978":49517},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3496":1594,"_30262":1591,"_5":30617,"_21040":54429,"_27550":54430,"_2978":54431},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3496":1595,"_30262":1591,"_5":30617,"_21040":54433,"_27550":54434,"_2978":54435},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3496":1596,"_30262":1591,"_5":30617,"_21040":54437,"_27550":54438,"_2978":54439},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3496":1597,"_30262":1591,"_5":30617,"_21040":54441,"_27550":54442,"_2978":54443},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3496":1598,"_30262":1591,"_5":30617,"_21040":54445,"_27550":54446,"_2978":54447},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3496":1599,"_30262":1591,"_5":30617,"_21040":54449,"_27550":54450,"_2978":54451},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3496":1600,"_30262":1591,"_5":30617,"_21040":54453,"_27550":54454,"_2978":54455},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3496":1601,"_30262":1591,"_21040":54457,"_5":14474,"_27550":1591,"_2978":54458},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3496":1602,"_30262":1591,"_21040":54460,"_5":14474,"_27550":54427,"_2978":54461},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3496":1603,"_30262":1591,"_21040":54463,"_5":14474,"_27550":54427,"_2978":54464},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3496":1604,"_30262":1591,"_21040":54466,"_5":14474,"_27550":54427,"_2978":54467},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3496":1605,"_30262":1591,"_21040":54469,"_5":14474,"_27550":54427,"_2978":54470},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3496":1606,"_30262":1591,"_21040":54472,"_5":14474,"_27550":54427,"_2978":54473},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3496":1607,"_30262":1591,"_21040":54475,"_5":14474,"_27550":54430,"_2978":54476},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3496":1608,"_30262":1591,"_21040":54478,"_5":14474,"_27550":54430,"_2978":54479},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3496":1609,"_30262":1591,"_21040":54481,"_5":14474,"_27550":54434,"_2978":54482},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3496":1610,"_30262":1591,"_21040":54484,"_5":14474,"_27550":54434,"_2978":54485},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3496":1611,"_30262":1591,"_21040":54487,"_5":14474,"_27550":54434,"_2978":54488},[],"Setting",{"_3496":1612,"_30262":1591,"_21040":54490,"_5":14474,"_27550":54434,"_2978":54491},[],"Evaluation value",{"_3496":1613,"_30262":1591,"_21040":54493,"_5":14474,"_27550":54434,"_2978":54494},[],"Enrollment CA",{"_3496":1614,"_30262":1591,"_21040":54496,"_5":14474,"_27550":54434,"_2978":54497},[],"Issuing root from `device-root.pem`.",{"_3496":1615,"_30262":1591,"_21040":54499,"_5":14474,"_27550":54434,"_2978":52300},[],{"_3496":1616,"_30262":1591,"_21040":54501,"_5":14474,"_27550":54434,"_2978":54502},[],"The 1-hour leaf profile you just prepared.",{"_3496":1617,"_30262":1591,"_21040":54504,"_5":14474,"_27550":54434,"_2978":54505},[],"Protocol / Registration Mode",{"_3496":1618,"_30262":1591,"_21040":54507,"_5":14474,"_27550":54434,"_2978":54508},[],"`EST_RFC7030` / `JITP`.",{"_3496":1619,"_30262":1591,"_21040":54510,"_5":14474,"_27550":54434,"_2978":54511},[],"Verify CSR Signature",{"_3496":1620,"_30262":1591,"_21040":54513,"_5":14474,"_27550":54434,"_2978":54514},[],"Enabled.",{"_3496":1621,"_30262":1591,"_21040":54516,"_5":14474,"_27550":54434,"_2978":54517},[],"Enable Replaceable Enrollment",{"_3496":1622,"_30262":1591,"_21040":54519,"_5":14474,"_27550":54434,"_2978":54520},[],"Disabled; the ID must be new.",{"_3496":1623,"_30262":1591,"_21040":54522,"_5":14474,"_27550":54434,"_2978":54523},[],"Initial authentication",{"_3496":1624,"_30262":1591,"_21040":54525,"_5":14474,"_27550":54434,"_2978":54526},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3496":1625,"_30262":1591,"_21040":54528,"_5":14474,"_27550":54434,"_2978":54529},[],"Renewal authentication",{"_3496":1626,"_30262":1591,"_21040":54531,"_5":14474,"_27550":54434,"_2978":54532},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3496":1627,"_30262":1591,"_21040":54534,"_5":14474,"_27550":54434,"_2978":54535},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3496":1628,"_30262":1591,"_21040":54537,"_5":14474,"_27550":54434,"_2978":54538},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3496":1629,"_30262":1591,"_21040":54540,"_5":14474,"_27550":54434,"_2978":54541},[],"Re-enrollment Delta",{"_3496":1630,"_30262":1591,"_21040":54543,"_5":14474,"_27550":54434,"_2978":54544},[],"1 hour.",{"_3496":1631,"_30262":1591,"_21040":54546,"_5":14474,"_27550":54434,"_2978":54547},[],"Preventive / Critical Delta",{"_3496":1632,"_30262":1591,"_21040":54549,"_5":14474,"_27550":54434,"_2978":54550},[],"30 minutes / 10 minutes.",{"_3496":1633,"_30262":1591,"_21040":54552,"_5":14474,"_27550":54434,"_2978":54553},[],"Revoke on Re-enrollment",{"_3496":1634,"_30262":1591,"_21040":54555,"_5":14474,"_27550":54434,"_2978":54556},[],"Disabled to test the successor before retiring the previous identity.",{"_3496":1635,"_30262":1591,"_21040":54558,"_5":14474,"_27550":54434,"_2978":52308},[],{"_3496":1636,"_30262":1591,"_21040":54560,"_5":14474,"_27550":54434,"_2978":54561},[],"Disabled; the operational key is generated in the client.",{"_3496":1637,"_30262":1591,"_21040":54563,"_5":14474,"_27550":54434,"_2978":54564},[],"CA Distribution",{"_3496":1638,"_30262":1591,"_21040":54566,"_5":14474,"_27550":54434,"_2978":54567},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3496":1639,"_30262":1591,"_21040":54569,"_5":14474,"_27550":54434,"_2978":54570},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3496":1640,"_30262":1591,"_21040":54572,"_5":14474,"_27550":54438,"_2978":54573},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3496":1641,"_30262":1591,"_21040":54575,"_5":14474,"_27550":54438,"_2978":54576},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3496":1642,"_30262":1591,"_21040":54578,"_5":14474,"_27550":54442,"_2978":54579},[],"Generate a new key and CSR with the selected identifier:",{"_3496":1643,"_30262":1591,"_21040":54581,"_5":14474,"_27550":54442,"_2978":54582},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3496":1644,"_30262":1591,"_21040":54584,"_5":14474,"_27550":54442,"_2978":54585},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3496":1645,"_30262":1591,"_21040":54587,"_5":14474,"_27550":54446,"_2978":54588},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3496":1646,"_30262":1591,"_21040":54590,"_5":14474,"_27550":54446,"_2978":54591},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3496":1647,"_30262":1591,"_21040":54593,"_5":14474,"_27550":54450,"_2978":54594},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3496":1648,"_30262":1591,"_21040":54596,"_5":14474,"_27550":54450,"_2978":54597},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3496":1649,"_30262":1591,"_21040":54599,"_5":14474,"_27550":54450,"_2978":54600},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3496":1650,"_30262":1591,"_21040":54602,"_5":14474,"_27550":54450,"_2978":54603},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3496":1651,"_30262":1591,"_21040":54605,"_5":14474,"_27550":54450,"_2978":54606},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3496":1652,"_30262":1591,"_21040":54608,"_5":14474,"_27550":54454,"_2978":54609},[],"Check",{"_3496":1653,"_30262":1591,"_21040":54611,"_5":14474,"_27550":54454,"_2978":54612},[],"Expected result",{"_3496":1654,"_30262":1591,"_21040":54614,"_5":14474,"_27550":54454,"_2978":54615},[],"Registration",{"_3496":1655,"_30262":1591,"_21040":54617,"_5":14474,"_27550":54454,"_2978":54618},[],"ID created automatically and correct DMS.",{"_3496":1656,"_30262":1591,"_21040":54620,"_5":14474,"_27550":54454,"_2978":53876},[],{"_3496":1657,"_30262":1591,"_21040":54622,"_5":14474,"_27550":54454,"_2978":54623},[],"CN, profile, serial and key verified.",{"_3496":1658,"_30262":1591,"_21040":54625,"_5":14474,"_27550":54454,"_2978":54626},[],"Inventory",{"_3496":1659,"_30262":1591,"_21040":54628,"_5":14474,"_27550":54454,"_2978":54629},[],"Received serial visible as the current identity and in history.",{"_3496":1660,"_30262":1591,"_21040":54631,"_5":14474,"_27550":54454,"_2978":54632},[],"Consumer",{"_3496":1661,"_30262":1591,"_21040":54634,"_5":14474,"_27550":54454,"_2978":54635},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3496":1662,"_30262":1591,"_21040":54637,"_5":14474,"_27550":54454,"_2978":54638},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3496":1663,"_30262":1591,"_21040":54640,"_5":14474,"_27550":54454,"_2978":54641},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3496":1664,"_30262":1664,"_5":14825,"_2978":52005,"_30620":54643,"_21040":54644,"_27550":1664},[49507,50975,51989,54420],[],{"_3496":1665,"_30262":1664,"_21040":54646,"_5":14474,"_27550":1664,"_2978":54647},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3496":1666,"_30262":1664,"_5":30617,"_21040":54649,"_27550":54650,"_2978":49517},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3496":1667,"_30262":1664,"_5":30617,"_21040":54652,"_27550":54653,"_2978":54654},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3496":1668,"_30262":1664,"_5":30617,"_21040":54656,"_27550":54657,"_2978":54658},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3496":1669,"_30262":1664,"_5":30617,"_21040":54660,"_27550":54661,"_2978":54662},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3496":1670,"_30262":1664,"_5":30617,"_21040":54664,"_27550":54665,"_2978":54666},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3496":1671,"_30262":1664,"_5":30617,"_21040":54668,"_27550":54669,"_2978":54670},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3496":1672,"_30262":1664,"_5":30617,"_21040":54672,"_27550":54673,"_2978":54612},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3496":1673,"_30262":1664,"_5":30617,"_21040":54675,"_27550":54676,"_2978":54677},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3496":1674,"_30262":1664,"_5":30617,"_21040":54679,"_27550":54680,"_2978":54681},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3496":1675,"_30262":1664,"_21040":54683,"_5":14474,"_27550":1664,"_2978":54684},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3496":1676,"_30262":1664,"_21040":54686,"_5":14474,"_27550":1664,"_2978":54687},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3496":1677,"_30262":1664,"_21040":54689,"_5":14474,"_27550":54650,"_2978":54690},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3496":1678,"_30262":1664,"_21040":54692,"_5":14474,"_27550":54650,"_2978":54693},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3496":1679,"_30262":1664,"_21040":54695,"_5":14474,"_27550":54650,"_2978":54696},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3496":1680,"_30262":1664,"_21040":54698,"_5":14474,"_27550":54650,"_2978":54699},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3496":1681,"_30262":1664,"_21040":54701,"_5":14474,"_27550":54653,"_2978":54702},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3496":1682,"_30262":1664,"_21040":54704,"_5":14474,"_27550":54653,"_2978":54705},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3496":1683,"_30262":1664,"_21040":54707,"_5":14474,"_27550":54653,"_2978":54708},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3496":1684,"_30262":1664,"_21040":54710,"_5":14474,"_27550":54653,"_2978":54711},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3496":1685,"_30262":1664,"_21040":54713,"_5":14474,"_27550":54653,"_2978":54714},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3496":1686,"_30262":1664,"_21040":54716,"_5":14474,"_27550":54653,"_2978":54717},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3496":1687,"_30262":1664,"_21040":54719,"_5":14474,"_27550":54653,"_2978":54720},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3496":1688,"_30262":1664,"_21040":54722,"_5":14474,"_27550":54653,"_2978":54723},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3496":1689,"_30262":1664,"_21040":54725,"_5":14474,"_27550":54657,"_2978":54726},[],"Open **Managed Devices** and the registration action. Complete:",{"_3496":1690,"_30262":1664,"_21040":54728,"_5":14474,"_27550":54657,"_2978":54729},[],"**Device ID**: `device-001`.",{"_3496":1691,"_30262":1664,"_21040":54731,"_5":14474,"_27550":54657,"_2978":54732},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3496":1692,"_30262":1664,"_21040":54734,"_5":14474,"_27550":54657,"_2978":54735},[],"**Icon** and **Tags**: optional classification.",{"_3496":1693,"_30262":1664,"_21040":54737,"_5":14474,"_27550":54657,"_2978":54738},[],"Confirm registration.",{"_3496":1694,"_30262":1664,"_21040":54740,"_5":14474,"_27550":54661,"_2978":54741},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3496":1695,"_30262":1664,"_21040":54743,"_5":14474,"_27550":54661,"_2978":54744},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3496":1696,"_30262":1664,"_21040":54746,"_5":14474,"_27550":54665,"_2978":54747},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3496":1697,"_30262":1664,"_21040":54749,"_5":14474,"_27550":54665,"_2978":54750},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3496":1698,"_30262":1664,"_21040":54752,"_5":14474,"_27550":54669,"_2978":54753},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3496":1699,"_30262":1664,"_21040":54755,"_5":14474,"_27550":54669,"_2978":54756},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3496":1700,"_30262":1664,"_21040":54758,"_5":14474,"_27550":54673,"_2978":54609},[],{"_3496":1701,"_30262":1664,"_21040":54760,"_5":14474,"_27550":54673,"_2978":54761},[],"Result",{"_3496":1702,"_30262":1664,"_21040":54763,"_5":14474,"_27550":54673,"_2978":53859},[],{"_3496":1703,"_30262":1664,"_21040":54765,"_5":14474,"_27550":54673,"_2978":54766},[],"`device-001` appears in inventory with the expected DMS.",{"_3496":1704,"_30262":1664,"_21040":54768,"_5":14474,"_27550":54673,"_2978":54769},[],"Current identity",{"_3496":1705,"_30262":1664,"_21040":54771,"_5":14474,"_27550":54673,"_2978":54772},[],"The associated certificate matches the one you verified in PKI.",{"_3496":1706,"_30262":1664,"_21040":54774,"_5":14474,"_27550":54673,"_2978":54775},[],"History",{"_3496":1707,"_30262":1664,"_21040":54777,"_5":14474,"_27550":54673,"_2978":54778},[],"The associated issuance appears with its serial number and dates.",{"_3496":1708,"_30262":1664,"_21040":54780,"_5":14474,"_27550":54673,"_2978":54781},[],"Key and certificate",{"_3496":1709,"_30262":1664,"_21040":54783,"_5":14474,"_27550":54673,"_2978":54784},[],"You have the verified pair ready to install on the device.",{"_3496":1710,"_30262":1664,"_21040":54786,"_5":14474,"_27550":54676,"_2978":54787},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3496":1711,"_30262":1664,"_21040":54789,"_5":14474,"_27550":54676,"_2978":54790},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3496":1712,"_30262":1664,"_21040":54792,"_5":14474,"_27550":54676,"_2978":54793},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3496":1713,"_30262":1664,"_21040":54795,"_5":14474,"_27550":54676,"_2978":54796},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3496":1714,"_30262":1664,"_21040":54798,"_5":14474,"_27550":54680,"_2978":54799},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3496":1715,"_30262":1664,"_21040":54801,"_5":14474,"_27550":54680,"_2978":54802},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3496":1716,"_30262":1664,"_21040":54804,"_5":14474,"_27550":54680,"_2978":54805},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3496":1717,"_30262":1717,"_5":14825,"_2978":54807,"_30620":54808,"_21040":54809,"_27550":1717},"Lamassu IoT Platform",[49507,50975],[],{"_3496":1718,"_30262":1717,"_21040":54811,"_5":14474,"_27550":1717,"_2978":54812},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3496":1719,"_30262":1717,"_5":30617,"_21040":54814,"_27550":54815,"_2978":54295},[],"/docs/pr-preview/pr-61/platform/overview#start-here",{"_3496":1720,"_30262":1717,"_5":30617,"_21040":54817,"_27550":54818,"_2978":54819},[],"/docs/pr-preview/pr-61/platform/overview#choose-your-path","Choose your path",{"_3496":1721,"_30262":1717,"_5":30617,"_21040":54821,"_27550":54822,"_2978":54823},[],"/docs/pr-preview/pr-61/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3496":1722,"_30262":1717,"_5":30617,"_21040":54825,"_27550":54826,"_2978":54827},[],"/docs/pr-preview/pr-61/platform/overview#core-capabilities","Core capabilities",{"_3496":1723,"_30262":1717,"_5":30617,"_21040":54829,"_27550":54830,"_2978":54831},[],"/docs/pr-preview/pr-61/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3496":1724,"_30262":1717,"_5":30617,"_21040":54833,"_27550":54834,"_2978":54835},[],"/docs/pr-preview/pr-61/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3496":1725,"_30262":1717,"_5":30617,"_21040":54837,"_27550":54838,"_2978":54839},[],"/docs/pr-preview/pr-61/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3496":1726,"_30262":1717,"_5":30617,"_21040":54841,"_27550":54842,"_2978":54843},[],"/docs/pr-preview/pr-61/platform/overview#automate-device-identities","Automate device identities",{"_3496":1727,"_30262":1717,"_5":30617,"_21040":54845,"_27550":54846,"_2978":54847},[],"/docs/pr-preview/pr-61/platform/overview#publish-validation-status","Publish validation status",{"_3496":1728,"_30262":1717,"_5":30617,"_21040":54849,"_27550":54850,"_2978":54851},[],"/docs/pr-preview/pr-61/platform/overview#react-to-events","React to events",{"_3496":1729,"_30262":1717,"_5":30617,"_21040":54853,"_27550":54854,"_2978":54855},[],"/docs/pr-preview/pr-61/platform/overview#operational-reference","Operational reference",{"_3496":1730,"_30262":1717,"_21040":54857,"_5":14474,"_27550":1717,"_2978":54858},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3496":1731,"_30262":1717,"_21040":54860,"_5":14474,"_27550":54815,"_2978":54861},[],"Choose the result you need:",{"_3496":1732,"_30262":1717,"_21040":54863,"_5":14474,"_27550":54815,"_2978":54864},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3496":1733,"_30262":1717,"_21040":54866,"_5":14474,"_27550":54815,"_2978":54867},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3496":1734,"_30262":1717,"_21040":54869,"_5":14474,"_27550":54815,"_2978":54870},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3496":1735,"_30262":1717,"_21040":54872,"_5":14474,"_27550":54818,"_2978":54873},[],"Section",{"_3496":1736,"_30262":1717,"_21040":54875,"_5":14474,"_27550":54818,"_2978":54876},[],"What you manage",{"_3496":1737,"_30262":1717,"_21040":54878,"_5":14474,"_27550":54818,"_2978":54879},[],"Entry point",{"_3496":1738,"_30262":1717,"_21040":54881,"_5":14474,"_27550":54818,"_2978":54882},[],"**PKI**",{"_3496":1739,"_30262":1717,"_21040":54884,"_5":14474,"_27550":54818,"_2978":54885},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3496":1740,"_30262":1717,"_21040":54887,"_5":14474,"_27550":54818,"_2978":54888},[],"PKI overview",{"_3496":1741,"_30262":1717,"_21040":54890,"_5":14474,"_27550":54818,"_2978":54891},[],"**IoT Fleets**",{"_3496":1742,"_30262":1717,"_21040":54893,"_5":14474,"_27550":54818,"_2978":54894},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3496":1743,"_30262":1717,"_21040":54896,"_5":14474,"_27550":54818,"_2978":54897},[],"IoT Fleets overview",{"_3496":1744,"_30262":1717,"_21040":54899,"_5":14474,"_27550":54818,"_2978":54900},[],"**Administration**",{"_3496":1745,"_30262":1717,"_21040":54902,"_5":14474,"_27550":54818,"_2978":54903},[],"Operator permissions, audit and event subscriptions.",{"_3496":1746,"_30262":1717,"_21040":54905,"_5":14474,"_27550":54818,"_2978":50973},[],{"_3496":1747,"_30262":1717,"_21040":54907,"_5":14474,"_27550":54818,"_2978":54908},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3496":1748,"_30262":1717,"_21040":54910,"_5":14474,"_27550":54822,"_2978":54911},[],"An identity's journey connects four responsibilities:",{"_3496":1749,"_30262":1717,"_21040":54913,"_5":14474,"_27550":54822,"_2978":54914},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3496":1750,"_30262":1717,"_21040":54916,"_5":14474,"_27550":54822,"_2978":54917},[],"The provisioning administrator configures the DMS and initial trust.",{"_3496":1751,"_30262":1717,"_21040":54919,"_5":14474,"_27550":54822,"_2978":54920},[],"The device client requests a certificate and installs it with the matching key.",{"_3496":1752,"_30262":1717,"_21040":54922,"_5":14474,"_27550":54822,"_2978":54923},[],"The consumer validates the identity and applies its access permissions.",{"_3496":1753,"_30262":1717,"_21040":54925,"_5":14474,"_27550":54822,"_2978":54926},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3496":1754,"_30262":1717,"_21040":54928,"_5":14474,"_27550":54830,"_2978":54929},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3496":1755,"_30262":1717,"_21040":54931,"_5":14474,"_27550":54834,"_2978":54932},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3496":1756,"_30262":1717,"_21040":54934,"_5":14474,"_27550":54838,"_2978":54935},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3496":1757,"_30262":1717,"_21040":54937,"_5":14474,"_27550":54842,"_2978":54938},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3496":1758,"_30262":1717,"_21040":54940,"_5":14474,"_27550":54846,"_2978":54941},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3496":1759,"_30262":1717,"_21040":54943,"_5":14474,"_27550":54850,"_2978":54944},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3496":1760,"_30262":1717,"_21040":54946,"_5":14474,"_27550":54854,"_2978":54389},[],{"_3496":1761,"_30262":1717,"_21040":54948,"_5":14474,"_27550":54854,"_2978":54949},[],"What it prepares or checks",{"_3496":1762,"_30262":1717,"_21040":54951,"_5":14474,"_27550":54854,"_2978":54392},[],{"_3496":1763,"_30262":1717,"_21040":54953,"_5":14474,"_27550":54854,"_2978":54954},[],"Key custody, CA hierarchy, profiles and validation.",{"_3496":1764,"_30262":1717,"_21040":54956,"_5":14474,"_27550":54854,"_2978":54957},[],"Fleet administrator",{"_3496":1765,"_30262":1717,"_21040":54959,"_5":14474,"_27550":54854,"_2978":54960},[],"DMS, device admission, renewal policy and inventory.",{"_3496":1766,"_30262":1717,"_21040":54962,"_5":14474,"_27550":54854,"_2978":54404},[],{"_3496":1767,"_30262":1717,"_21040":54964,"_5":14474,"_27550":54854,"_2978":54965},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3496":1768,"_30262":1717,"_21040":54967,"_5":14474,"_27550":54854,"_2978":54410},[],{"_3496":1769,"_30262":1717,"_21040":54969,"_5":14474,"_27550":54854,"_2978":54970},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3496":1770,"_30262":1717,"_21040":54972,"_5":14474,"_27550":54854,"_2978":54973},[],"Infrastructure operator",{"_3496":1771,"_30262":1717,"_21040":54975,"_5":14474,"_27550":54854,"_2978":54976},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3496":1772,"_30262":1717,"_21040":54978,"_5":14474,"_27550":54854,"_2978":54979},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3496":1773,"_30262":1773,"_5":14825,"_2978":54981,"_30620":54982,"_21040":54985,"_27550":1773},"CA hierarchy and rotation",[49507,50975,54983,54984],"PKI","Keys, authorities and certificates",[],{"_3496":1774,"_30262":1773,"_21040":54987,"_5":14474,"_27550":1773,"_2978":54988},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3496":1775,"_30262":1773,"_5":30617,"_21040":54990,"_27550":54991,"_2978":54992},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3496":1776,"_30262":1773,"_5":30617,"_21040":54994,"_27550":54995,"_2978":54996},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3496":1777,"_30262":1773,"_5":30617,"_21040":54998,"_27550":54999,"_2978":55000},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3496":1778,"_30262":1773,"_5":30617,"_21040":55002,"_27550":55003,"_2978":55004},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3496":1779,"_30262":1773,"_5":30617,"_21040":55006,"_27550":55007,"_2978":55008},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3496":1780,"_30262":1773,"_5":30617,"_21040":55010,"_27550":55011,"_2978":55012},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3496":1781,"_30262":1773,"_5":30617,"_21040":55014,"_27550":55015,"_2978":55016},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3496":1782,"_30262":1773,"_5":30617,"_21040":55018,"_27550":55019,"_2978":55020},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3496":1783,"_30262":1773,"_5":30617,"_21040":55022,"_27550":55023,"_2978":55024},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3496":1784,"_30262":1773,"_5":30617,"_21040":55026,"_27550":55027,"_2978":55028},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3496":1785,"_30262":1773,"_5":30617,"_21040":55030,"_27550":55031,"_2978":55032},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3496":1786,"_30262":1773,"_5":30617,"_21040":55034,"_27550":55035,"_2978":55036},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3496":1787,"_30262":1773,"_21040":55038,"_5":14474,"_27550":1773,"_2978":55039},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3496":1788,"_30262":1773,"_21040":55041,"_5":14474,"_27550":1773,"_2978":55042},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3496":1789,"_30262":1773,"_21040":55044,"_5":14474,"_27550":54991,"_2978":55045},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3496":1790,"_30262":1773,"_21040":55047,"_5":14474,"_27550":54991,"_2978":55048},[],"environment, such as production and preproduction;",{"_3496":1791,"_30262":1773,"_21040":55050,"_5":14474,"_27550":54991,"_2978":55051},[],"owner or operating team;",{"_3496":1792,"_30262":1773,"_21040":55053,"_5":14474,"_27550":54991,"_2978":55054},[],"device family or manufacturing process;",{"_3496":1793,"_30262":1773,"_21040":55056,"_5":14474,"_27550":54991,"_2978":55057},[],"region or regulatory requirement;",{"_3496":1794,"_30262":1773,"_21040":55059,"_5":14474,"_27550":54991,"_2978":55060},[],"cryptographic engine or key policy;",{"_3496":1795,"_30262":1773,"_21040":55062,"_5":14474,"_27550":54991,"_2978":55063},[],"maintenance window and renewal cadence.",{"_3496":1796,"_30262":1773,"_21040":55065,"_5":14474,"_27550":54991,"_2978":55066},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3496":1797,"_30262":1773,"_21040":55068,"_5":14474,"_27550":54991,"_2978":55069},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3496":1798,"_30262":1773,"_21040":55071,"_5":14474,"_27550":54995,"_2978":55072},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3496":1799,"_30262":1773,"_21040":55074,"_5":14474,"_27550":54995,"_2978":55075},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3496":1800,"_30262":1773,"_21040":55077,"_5":14474,"_27550":54995,"_2978":55078},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3496":1801,"_30262":1773,"_21040":55080,"_5":14474,"_27550":54995,"_2978":55081},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3496":1802,"_30262":1773,"_21040":55083,"_5":14474,"_27550":54999,"_2978":55084},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3496":1803,"_30262":1773,"_21040":55086,"_5":14474,"_27550":54999,"_2978":55087},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3496":1804,"_30262":1773,"_21040":55089,"_5":14474,"_27550":54999,"_2978":55090},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3496":1805,"_30262":1773,"_21040":55092,"_5":14474,"_27550":54999,"_2978":55093},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3496":1806,"_30262":1773,"_21040":55095,"_5":14474,"_27550":55007,"_2978":55096},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3496":1807,"_30262":1773,"_21040":55098,"_5":14474,"_27550":55011,"_2978":55099},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3496":1808,"_30262":1773,"_21040":55101,"_5":14474,"_27550":55015,"_2978":55102},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3496":1809,"_30262":1773,"_21040":55104,"_5":14474,"_27550":55019,"_2978":55105},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3496":1810,"_30262":1773,"_21040":55107,"_5":14474,"_27550":55023,"_2978":55108},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3496":1811,"_30262":1773,"_21040":55110,"_5":14474,"_27550":55027,"_2978":55111},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3496":1812,"_30262":1773,"_21040":55113,"_5":14474,"_27550":55031,"_2978":55114},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3496":1813,"_30262":1773,"_21040":55116,"_5":14474,"_27550":55031,"_2978":55117},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3496":1814,"_30262":1773,"_21040":55119,"_5":14474,"_27550":55031,"_2978":55120},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3496":1815,"_30262":1773,"_21040":55122,"_5":14474,"_27550":55031,"_2978":55123},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3496":1816,"_30262":1773,"_21040":55125,"_5":14474,"_27550":55035,"_2978":55126},[],"The new chain ends in an anchor installed by the consumer.",{"_3496":1817,"_30262":1773,"_21040":55128,"_5":14474,"_27550":55035,"_2978":55129},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3496":1818,"_30262":1773,"_21040":55131,"_5":14474,"_27550":55035,"_2978":55132},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3496":1819,"_30262":1773,"_21040":55134,"_5":14474,"_27550":55035,"_2978":55135},[],"Re-enrollment accepts the old identity during the planned period.",{"_3496":1820,"_30262":1773,"_21040":55137,"_5":14474,"_27550":55035,"_2978":55138},[],"OCSP and CRL respond for the authorities that remain active.",{"_3496":1821,"_30262":1773,"_21040":55140,"_5":14474,"_27550":55035,"_2978":55141},[],"No DMS is left accidentally issuing from the old CA.",{"_3496":1822,"_30262":1773,"_21040":55143,"_5":14474,"_27550":55035,"_2978":55144},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3496":1823,"_30262":1823,"_5":14825,"_2978":55146,"_30620":55147,"_21040":55148,"_27550":1823},"Certification authorities",[49507,50975,54983,54984],[],{"_3496":1824,"_30262":1823,"_21040":55150,"_5":14474,"_27550":1823,"_2978":55151},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3496":1825,"_30262":1823,"_5":30617,"_21040":55153,"_27550":55154,"_2978":55155},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3496":1826,"_30262":1823,"_5":30617,"_21040":55157,"_27550":55158,"_2978":55159},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3496":1827,"_30262":1823,"_5":30617,"_21040":55161,"_27550":55162,"_2978":49517},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#before-you-begin",{"_3496":1828,"_30262":1823,"_5":30617,"_21040":55164,"_27550":55165,"_2978":55166},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3496":1829,"_30262":1823,"_5":30617,"_21040":55168,"_27550":55169,"_2978":55170},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3496":1830,"_30262":1823,"_5":30617,"_21040":55172,"_27550":55173,"_2978":55174},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3496":1831,"_30262":1823,"_5":30617,"_21040":55176,"_27550":55177,"_2978":55178},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3496":1832,"_30262":1823,"_5":30617,"_21040":55180,"_27550":55181,"_2978":55182},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3496":1833,"_30262":1823,"_5":30617,"_21040":55184,"_27550":55185,"_2978":55186},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3496":1834,"_30262":1823,"_5":30617,"_21040":55188,"_27550":55189,"_2978":55190},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3496":1835,"_30262":1823,"_5":30617,"_21040":55192,"_27550":55193,"_2978":55194},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3496":1836,"_30262":1823,"_5":30617,"_21040":55196,"_27550":55197,"_2978":55198},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3496":1837,"_30262":1823,"_5":30617,"_21040":55200,"_27550":55201,"_2978":55202},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3496":1838,"_30262":1823,"_5":30617,"_21040":55204,"_27550":55205,"_2978":55206},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3496":1839,"_30262":1823,"_5":30617,"_21040":55208,"_27550":55209,"_2978":55210},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3496":1840,"_30262":1823,"_5":30617,"_21040":55212,"_27550":55213,"_2978":55214},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3496":1841,"_30262":1823,"_5":30617,"_21040":55216,"_27550":55217,"_2978":55218},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3496":1842,"_30262":1823,"_5":30617,"_21040":55220,"_27550":55221,"_2978":55222},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3496":1843,"_30262":1823,"_5":30617,"_21040":55224,"_27550":55225,"_2978":55226},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3496":1844,"_30262":1823,"_5":30617,"_21040":55228,"_27550":55229,"_2978":55230},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3496":1845,"_30262":1823,"_5":30617,"_21040":55232,"_27550":55233,"_2978":55234},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3496":1846,"_30262":1823,"_5":30617,"_21040":55236,"_27550":55237,"_2978":55238},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3496":1847,"_30262":1823,"_5":30617,"_21040":55240,"_27550":55241,"_2978":55242},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3496":1848,"_30262":1823,"_21040":55244,"_5":14474,"_27550":1823,"_2978":55245},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3496":1849,"_30262":1823,"_21040":55247,"_5":14474,"_27550":1823,"_2978":55248},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3496":1850,"_30262":1823,"_21040":55250,"_5":14474,"_27550":1823,"_2978":55251},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3496":1851,"_30262":1823,"_21040":55253,"_5":14474,"_27550":55154,"_2978":55254},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3496":1852,"_30262":1823,"_21040":55256,"_5":14474,"_27550":55154,"_2978":55257},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3496":1853,"_30262":1823,"_21040":55259,"_5":14474,"_27550":55154,"_2978":55260},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3496":1854,"_30262":1823,"_21040":55262,"_5":14474,"_27550":55154,"_2978":55263},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3496":1855,"_30262":1823,"_21040":55265,"_5":14474,"_27550":55154,"_2978":55266},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3496":1856,"_30262":1823,"_21040":55268,"_5":14474,"_27550":55162,"_2978":55269},[],"Decide whether the CA will be a root or an intermediate.",{"_3496":1857,"_30262":1823,"_21040":55271,"_5":14474,"_27550":55162,"_2978":55272},[],"Choose the engine that will keep the key.",{"_3496":1858,"_30262":1823,"_21040":55274,"_5":14474,"_27550":55162,"_2978":55275},[],"Define a validity longer than that of the certificates it will issue.",{"_3496":1859,"_30262":1823,"_21040":55277,"_5":14474,"_27550":55162,"_2978":55278},[],"For an intermediate CA, make sure the parent CA is active.",{"_3496":1860,"_30262":1823,"_21040":55280,"_5":14474,"_27550":55165,"_2978":55281},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3496":1861,"_30262":1823,"_21040":55283,"_5":14474,"_27550":55169,"_2978":55284},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3496":1862,"_30262":1823,"_21040":55286,"_5":14474,"_27550":55169,"_2978":55287},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3496":1863,"_30262":1823,"_21040":55289,"_5":14474,"_27550":55173,"_2978":55290},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3496":1864,"_30262":1823,"_21040":55292,"_5":14474,"_27550":55177,"_2978":55293},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3496":1865,"_30262":1823,"_21040":55295,"_5":14474,"_27550":55177,"_2978":55296},[],"`C`: two-letter ISO 3166-1 country code.",{"_3496":1866,"_30262":1823,"_21040":55298,"_5":14474,"_27550":55177,"_2978":55299},[],"`ST`: state or province.",{"_3496":1867,"_30262":1823,"_21040":55301,"_5":14474,"_27550":55177,"_2978":55302},[],"`L`: locality.",{"_3496":1868,"_30262":1823,"_21040":55304,"_5":14474,"_27550":55177,"_2978":55305},[],"`O`: organization.",{"_3496":1869,"_30262":1823,"_21040":55307,"_5":14474,"_27550":55177,"_2978":55308},[],"`OU`: organizational unit.",{"_3496":1870,"_30262":1823,"_21040":55310,"_5":14474,"_27550":55177,"_2978":55311},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3496":1871,"_30262":1823,"_21040":55313,"_5":14474,"_27550":55181,"_2978":55314},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3496":1872,"_30262":1823,"_21040":55316,"_5":14474,"_27550":55181,"_2978":55317},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3496":1873,"_30262":1823,"_21040":55319,"_5":14474,"_27550":55185,"_2978":55320},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3496":1874,"_30262":1823,"_21040":55322,"_5":14474,"_27550":55185,"_2978":55323},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3496":1875,"_30262":1823,"_21040":55325,"_5":14474,"_27550":55189,"_2978":55326},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3496":1876,"_30262":1823,"_21040":55328,"_5":14474,"_27550":55189,"_2978":55329},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3496":1877,"_30262":1823,"_21040":55331,"_5":14474,"_27550":55193,"_2978":55332},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3496":1878,"_30262":1823,"_21040":55334,"_5":14474,"_27550":55193,"_2978":55335},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3496":1879,"_30262":1823,"_21040":55337,"_5":14474,"_27550":55193,"_2978":55338},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3496":1880,"_30262":1823,"_21040":55340,"_5":14474,"_27550":55197,"_2978":55341},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3496":1881,"_30262":1823,"_21040":55343,"_5":14474,"_27550":55201,"_2978":55344},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3496":1882,"_30262":1823,"_21040":55346,"_5":14474,"_27550":55201,"_2978":55347},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3496":1883,"_30262":1823,"_21040":55349,"_5":14474,"_27550":55205,"_2978":55350},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3496":1884,"_30262":1823,"_21040":55352,"_5":14474,"_27550":55209,"_2978":55353},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3496":1885,"_30262":1823,"_21040":55355,"_5":14474,"_27550":55209,"_2978":55356},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3496":1886,"_30262":1823,"_21040":55358,"_5":14474,"_27550":55213,"_2978":55359},[],"Open a CA from the inventory to review:",{"_3496":1887,"_30262":1823,"_21040":55361,"_5":14474,"_27550":55213,"_2978":55362},[],"Status and validity period.",{"_3496":1888,"_30262":1823,"_21040":55364,"_5":14474,"_27550":55213,"_2978":55365},[],"Certificate and chain in PEM format.",{"_3496":1889,"_30262":1823,"_21040":55367,"_5":14474,"_27550":55213,"_2978":55368},[],"Number of active, expired and revoked certificates.",{"_3496":1890,"_30262":1823,"_21040":55370,"_5":14474,"_27550":55213,"_2978":55371},[],"Certificates issued in **Issued Certificates**.",{"_3496":1891,"_30262":1823,"_21040":55373,"_5":14474,"_27550":55213,"_2978":55374},[],"The CRL linked to the authority.",{"_3496":1892,"_30262":1823,"_21040":55376,"_5":14474,"_27550":55213,"_2978":55377},[],"Metadata and the associated cryptographic engine.",{"_3496":1893,"_30262":1823,"_21040":55379,"_5":14474,"_27550":55213,"_2978":55380},[],"You can filter the inventory by name, status and CA type.",{"_3496":1894,"_30262":1823,"_21040":55382,"_5":14474,"_27550":55217,"_2978":55383},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3496":1895,"_30262":1823,"_21040":55385,"_5":14474,"_27550":55217,"_2978":55386},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3496":1896,"_30262":1823,"_21040":55388,"_5":14474,"_27550":55217,"_2978":55389},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3496":1897,"_30262":1823,"_21040":55391,"_5":14474,"_27550":55217,"_2978":55392},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3496":1898,"_30262":1823,"_21040":55394,"_5":14474,"_27550":55221,"_2978":55395},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3496":1899,"_30262":1823,"_21040":55397,"_5":14474,"_27550":55225,"_2978":55398},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3496":1900,"_30262":1823,"_21040":55400,"_5":14474,"_27550":55229,"_2978":55401},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3496":1901,"_30262":1823,"_21040":55403,"_5":14474,"_27550":55233,"_2978":55404},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3496":1902,"_30262":1823,"_21040":55406,"_5":14474,"_27550":55237,"_2978":55407},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3496":1903,"_30262":1823,"_21040":55409,"_5":14474,"_27550":55241,"_2978":55410},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3496":1904,"_30262":1823,"_21040":55412,"_5":14474,"_27550":55241,"_2978":55413},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3496":1905,"_30262":1823,"_21040":55415,"_5":14474,"_27550":55241,"_2978":55416},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3496":1906,"_30262":1906,"_5":14825,"_2978":55418,"_30620":55419,"_21040":55420,"_27550":1906},"Certificate profiles",[49507,50975,54983,54984],[],{"_3496":1907,"_30262":1906,"_21040":55422,"_5":14474,"_27550":1906,"_2978":55423},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3496":1908,"_30262":1906,"_5":30617,"_21040":55425,"_27550":55426,"_2978":55427},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3496":1909,"_30262":1906,"_5":30617,"_21040":55429,"_27550":55430,"_2978":55431},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#validity","Validity",{"_3496":1910,"_30262":1906,"_5":30617,"_21040":55433,"_27550":55434,"_2978":55435},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3496":1911,"_30262":1906,"_5":30617,"_21040":55437,"_27550":55438,"_2978":55439},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3496":1912,"_30262":1906,"_5":30617,"_21040":55441,"_27550":55442,"_2978":55443},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#subject","Subject",{"_3496":1913,"_30262":1906,"_5":30617,"_21040":55445,"_27550":55446,"_2978":55447},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3496":1914,"_30262":1906,"_5":30617,"_21040":55449,"_27550":55450,"_2978":55451},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3496":1915,"_30262":1906,"_5":30617,"_21040":55453,"_27550":55454,"_2978":55455},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3496":1916,"_30262":1906,"_5":30617,"_21040":55457,"_27550":55458,"_2978":55459},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3496":1917,"_30262":1906,"_5":30617,"_21040":55461,"_27550":55462,"_2978":55463},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3496":1918,"_30262":1906,"_5":30617,"_21040":55465,"_27550":55466,"_2978":55467},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3496":1919,"_30262":1906,"_5":30617,"_21040":55469,"_27550":55470,"_2978":55471},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3496":1920,"_30262":1906,"_5":30617,"_21040":55473,"_27550":55474,"_2978":55475},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3496":1921,"_30262":1906,"_5":30617,"_21040":55477,"_27550":55478,"_2978":55479},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3496":1922,"_30262":1906,"_5":30617,"_21040":55481,"_27550":55482,"_2978":55483},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#design-examples","Design examples",{"_3496":1923,"_30262":1906,"_5":30617,"_21040":55485,"_27550":55486,"_2978":55487},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3496":1924,"_30262":1906,"_21040":55489,"_5":14474,"_27550":1906,"_2978":55490},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3496":1925,"_30262":1906,"_21040":55492,"_5":14474,"_27550":1906,"_2978":55493},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3496":1926,"_30262":1906,"_21040":55495,"_5":14474,"_27550":55430,"_2978":55496},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3496":1927,"_30262":1906,"_21040":55498,"_5":14474,"_27550":55430,"_2978":55499},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3496":1928,"_30262":1906,"_21040":55501,"_5":14474,"_27550":55434,"_2978":55502},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3496":1929,"_30262":1906,"_21040":55504,"_5":14474,"_27550":55438,"_2978":55505},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3496":1930,"_30262":1906,"_21040":55507,"_5":14474,"_27550":55438,"_2978":55508},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3496":1931,"_30262":1906,"_21040":55510,"_5":14474,"_27550":55438,"_2978":55511},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3496":1932,"_30262":1906,"_21040":55513,"_5":14474,"_27550":55442,"_2978":55514},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3496":1933,"_30262":1906,"_21040":55516,"_5":14474,"_27550":55446,"_2978":55517},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3496":1934,"_30262":1906,"_21040":55519,"_5":14474,"_27550":55446,"_2978":55520},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3496":1935,"_30262":1906,"_21040":55522,"_5":14474,"_27550":55450,"_2978":55523},[],"The cryptographic enforcement can:",{"_3496":1936,"_30262":1906,"_21040":55525,"_5":14474,"_27550":55450,"_2978":55526},[],"allow or block RSA keys;",{"_3496":1937,"_30262":1906,"_21040":55528,"_5":14474,"_27550":55450,"_2978":55529},[],"limit the supported RSA sizes;",{"_3496":1938,"_30262":1906,"_21040":55531,"_5":14474,"_27550":55450,"_2978":55532},[],"allow or block ECDSA keys;",{"_3496":1939,"_30262":1906,"_21040":55534,"_5":14474,"_27550":55450,"_2978":55535},[],"limit the supported ECDSA sizes or curves.",{"_3496":1940,"_30262":1906,"_21040":55537,"_5":14474,"_27550":55450,"_2978":55538},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3496":1941,"_30262":1906,"_21040":55540,"_5":14474,"_27550":55454,"_2978":55541},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3496":1942,"_30262":1906,"_21040":55543,"_5":14474,"_27550":55454,"_2978":52745},[],{"_3496":1943,"_30262":1906,"_21040":55545,"_5":14474,"_27550":55454,"_2978":55546},[],"First choice",{"_3496":1944,"_30262":1906,"_21040":55548,"_5":14474,"_27550":55454,"_2978":55549},[],"Second choice",{"_3496":1945,"_30262":1906,"_21040":55551,"_5":14474,"_27550":55454,"_2978":55552},[],"If neither is supplied",{"_3496":1946,"_30262":1906,"_21040":55554,"_5":14474,"_27550":55454,"_2978":55555},[],"Direct signing with a CA",{"_3496":1947,"_30262":1906,"_21040":55557,"_5":14474,"_27550":55454,"_2978":55558},[],"`issuance_profile` embedded in the request",{"_3496":1948,"_30262":1906,"_21040":55560,"_5":14474,"_27550":55454,"_2978":55561},[],"Request `issuance_profile_id`",{"_3496":1949,"_30262":1906,"_21040":55563,"_5":14474,"_27550":55454,"_2978":55564},[],"CA default profile (`profile_id`).",{"_3496":1950,"_30262":1906,"_21040":55566,"_5":14474,"_27550":55454,"_2978":55567},[],"Issuance through a DMS",{"_3496":1951,"_30262":1906,"_21040":55569,"_5":14474,"_27550":55454,"_2978":55570},[],"`settings.issuance_profile_id`",{"_3496":1952,"_30262":1906,"_21040":55572,"_5":14474,"_27550":55454,"_2978":55573},[],"`settings.issuance_profile` embedded in the DMS",{"_3496":1953,"_30262":1906,"_21040":55575,"_5":14474,"_27550":55454,"_2978":55576},[],"Enrollment CA default profile.",{"_3496":1954,"_30262":1906,"_21040":55578,"_5":14474,"_27550":55454,"_2978":55579},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3496":1955,"_30262":1906,"_21040":55581,"_5":14474,"_27550":55454,"_2978":55582},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3496":1956,"_30262":1906,"_21040":55584,"_5":14474,"_27550":55462,"_2978":55585},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3496":1957,"_30262":1906,"_21040":55587,"_5":14474,"_27550":55466,"_2978":55588},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3496":1958,"_30262":1906,"_21040":55590,"_5":14474,"_27550":55470,"_2978":55591},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3496":1959,"_30262":1906,"_21040":55593,"_5":14474,"_27550":55474,"_2978":55594},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3496":1960,"_30262":1906,"_21040":55596,"_5":14474,"_27550":55478,"_2978":55597},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3496":1961,"_30262":1906,"_21040":55599,"_5":14474,"_27550":55478,"_2978":55600},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3496":1962,"_30262":1906,"_21040":55602,"_5":14474,"_27550":55482,"_2978":55603},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3496":1963,"_30262":1906,"_21040":55605,"_5":14474,"_27550":55482,"_2978":55606},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3496":1964,"_30262":1906,"_21040":55608,"_5":14474,"_27550":55482,"_2978":55609},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3496":1965,"_30262":1906,"_21040":55611,"_5":14474,"_27550":55482,"_2978":55612},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3496":1966,"_30262":1906,"_21040":55614,"_5":14474,"_27550":55486,"_2978":55615},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3496":1967,"_30262":1906,"_21040":55617,"_5":14474,"_27550":55486,"_2978":55618},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3496":1968,"_30262":1968,"_5":14825,"_2978":55620,"_30620":55621,"_21040":55623,"_27550":1968},"Certificate validation",[49507,50975,54983,55622],"Validation",[],{"_3496":1969,"_30262":1968,"_21040":55625,"_5":14474,"_27550":1968,"_2978":55626},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3496":1970,"_30262":1968,"_5":30617,"_21040":55628,"_27550":55629,"_2978":55630},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3496":1971,"_30262":1968,"_5":30617,"_21040":55632,"_27550":55633,"_2978":55634},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3496":1972,"_30262":1968,"_5":30617,"_21040":55636,"_27550":55637,"_2978":55638},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3496":1973,"_30262":1968,"_21040":55640,"_5":14474,"_27550":1968,"_2978":55641},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3496":1974,"_30262":1968,"_21040":55643,"_5":14474,"_27550":55629,"_2978":55644},[],"Verify these criteria together:",{"_3496":1975,"_30262":1968,"_21040":55646,"_5":14474,"_27550":55629,"_2978":54609},[],{"_3496":1976,"_30262":1968,"_21040":55648,"_5":14474,"_27550":55629,"_2978":55649},[],"Required result",{"_3496":1977,"_30262":1968,"_21040":55651,"_5":14474,"_27550":55629,"_2978":55652},[],"Chain and signature",{"_3496":1978,"_30262":1968,"_21040":55654,"_5":14474,"_27550":55629,"_2978":55655},[],"Valid chain to a root deliberately installed in the consumer.",{"_3496":1979,"_30262":1968,"_21040":55657,"_5":14474,"_27550":55629,"_2978":55658},[],"Dates",{"_3496":1980,"_30262":1968,"_21040":55660,"_5":14474,"_27550":55629,"_2978":55661},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3496":1981,"_30262":1968,"_21040":55663,"_5":14474,"_27550":55629,"_2978":50644},[],{"_3496":1982,"_30262":1968,"_21040":55665,"_5":14474,"_27550":55629,"_2978":55666},[],"Name, SAN or identifier matches the expected peer.",{"_3496":1983,"_30262":1968,"_21040":55668,"_5":14474,"_27550":55629,"_2978":49897},[],{"_3496":1984,"_30262":1968,"_21040":55670,"_5":14474,"_27550":55629,"_2978":55671},[],"KU, EKU and constraints permit the specific operation.",{"_3496":1985,"_30262":1968,"_21040":55673,"_5":14474,"_27550":55629,"_2978":55674},[],"Revocation",{"_3496":1986,"_30262":1968,"_21040":55676,"_5":14474,"_27550":55629,"_2978":55677},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3496":1987,"_30262":1968,"_21040":55679,"_5":14474,"_27550":55629,"_2978":55680},[],"Authorization",{"_3496":1988,"_30262":1968,"_21040":55682,"_5":14474,"_27550":55629,"_2978":55683},[],"The application permits that identity to perform the action.",{"_3496":1989,"_30262":1968,"_21040":55685,"_5":14474,"_27550":55629,"_2978":55686},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3496":1990,"_30262":1968,"_21040":55688,"_5":14474,"_27550":55633,"_2978":55689},[],"Mechanism",{"_3496":1991,"_30262":1968,"_21040":55691,"_5":14474,"_27550":55633,"_2978":55692},[],"When to use it",{"_3496":1992,"_30262":1968,"_21040":55694,"_5":14474,"_27550":55633,"_2978":55695},[],"What you must maintain",{"_3496":1993,"_30262":1968,"_21040":55697,"_5":14474,"_27550":55633,"_2978":55698},[],"OCSP",{"_3496":1994,"_30262":1968,"_21040":55700,"_5":14474,"_27550":55633,"_2978":55701},[],"Status query for a specific certificate.",{"_3496":1995,"_30262":1968,"_21040":55703,"_5":14474,"_27550":55633,"_2978":55704},[],"Responder access, signature verification and cache/freshness policy.",{"_3496":1996,"_30262":1968,"_21040":55706,"_5":14474,"_27550":55633,"_2978":55707},[],"CRL",{"_3496":1997,"_30262":1968,"_21040":55709,"_5":14474,"_27550":55633,"_2978":55710},[],"Local checks for many certificates or offline operation.",{"_3496":1998,"_30262":1968,"_21040":55712,"_5":14474,"_27550":55633,"_2978":55713},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3496":1999,"_30262":1968,"_21040":55715,"_5":14474,"_27550":55633,"_2978":55716},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3496":2000,"_30262":1968,"_21040":55718,"_5":14474,"_27550":55633,"_2978":55719},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3496":2001,"_30262":1968,"_21040":55721,"_5":14474,"_27550":55637,"_2978":55722},[],"Accept a current, authorized certificate with a known chain.",{"_3496":2002,"_30262":1968,"_21040":55724,"_5":14474,"_27550":55637,"_2978":55725},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3496":2003,"_30262":1968,"_21040":55727,"_5":14474,"_27550":55637,"_2978":55728},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3496":2004,"_30262":1968,"_21040":55730,"_5":14474,"_27550":55637,"_2978":55731},[],"Check that a new connection with that identity is rejected.",{"_3496":2005,"_30262":1968,"_21040":55733,"_5":14474,"_27550":55637,"_2978":55734},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3496":2006,"_30262":1968,"_21040":55736,"_5":14474,"_27550":55637,"_2978":55737},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3496":2007,"_30262":1968,"_21040":55739,"_5":14474,"_27550":55637,"_2978":55740},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3496":2008,"_30262":1968,"_21040":55742,"_5":14474,"_27550":55637,"_2978":55743},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3496":2009,"_30262":1968,"_21040":55745,"_5":14474,"_27550":55637,"_2978":55746},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3496":2010,"_30262":2010,"_5":14825,"_2978":55748,"_30620":55749,"_21040":55750,"_27550":2010},"Certificates",[49507,50975,54983,54984],[],{"_3496":2011,"_30262":2010,"_21040":55752,"_5":14474,"_27550":2010,"_2978":55753},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3496":2012,"_30262":2010,"_5":30617,"_21040":55755,"_27550":55756,"_2978":55757},[],"/docs/pr-preview/pr-61/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3496":2013,"_30262":2010,"_5":30617,"_21040":55759,"_27550":55760,"_2978":55761},[],"/docs/pr-preview/pr-61/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3496":2014,"_30262":2010,"_5":30617,"_21040":55763,"_27550":55764,"_2978":55765},[],"/docs/pr-preview/pr-61/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3496":2015,"_30262":2010,"_5":30617,"_21040":55767,"_27550":55768,"_2978":55769},[],"/docs/pr-preview/pr-61/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3496":2016,"_30262":2010,"_5":30617,"_21040":55771,"_27550":55772,"_2978":55773},[],"/docs/pr-preview/pr-61/platform/pki/certificates#open-the-action","Open the action",{"_3496":2017,"_30262":2010,"_5":30617,"_21040":55775,"_27550":55776,"_2978":55777},[],"/docs/pr-preview/pr-61/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3496":2018,"_30262":2010,"_5":30617,"_21040":55779,"_27550":55780,"_2978":55781},[],"/docs/pr-preview/pr-61/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3496":2019,"_30262":2010,"_5":30617,"_21040":55783,"_27550":55784,"_2978":55785},[],"/docs/pr-preview/pr-61/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3496":2020,"_30262":2010,"_5":30617,"_21040":55787,"_27550":55788,"_2978":55789},[],"/docs/pr-preview/pr-61/platform/pki/certificates#continue","Continue",{"_3496":2021,"_30262":2010,"_21040":55791,"_5":14474,"_27550":2010,"_2978":55792},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3496":2022,"_30262":2010,"_21040":55794,"_5":14474,"_27550":55756,"_2978":55795},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3496":2023,"_30262":2010,"_21040":55797,"_5":14474,"_27550":55756,"_2978":55798},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3496":2024,"_30262":2010,"_21040":55800,"_5":14474,"_27550":55756,"_2978":55801},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3496":2025,"_30262":2010,"_21040":55803,"_5":14474,"_27550":55756,"_2978":55804},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3496":2026,"_30262":2010,"_21040":55806,"_5":14474,"_27550":55756,"_2978":55807},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3496":2027,"_30262":2010,"_21040":55809,"_5":14474,"_27550":55756,"_2978":55810},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3496":2028,"_30262":2010,"_21040":55812,"_5":14474,"_27550":55756,"_2978":55813},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3496":2029,"_30262":2010,"_21040":55815,"_5":14474,"_27550":55760,"_2978":55816},[],"Download the PEM and inspect it:",{"_3496":2030,"_30262":2010,"_21040":55818,"_5":14474,"_27550":55760,"_2978":55819},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3496":2031,"_30262":2010,"_21040":55821,"_5":14474,"_27550":55764,"_2978":55822},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3496":2032,"_30262":2010,"_21040":55824,"_5":14474,"_27550":55764,"_2978":55825},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3496":2033,"_30262":2010,"_21040":55827,"_5":14474,"_27550":55764,"_2978":55828},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3496":2034,"_30262":2010,"_21040":55830,"_5":14474,"_27550":55764,"_2978":55831},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3496":2035,"_30262":2010,"_21040":55833,"_5":14474,"_27550":55764,"_2978":55834},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3496":2036,"_30262":2010,"_21040":55836,"_5":14474,"_27550":55764,"_2978":55837},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3496":2037,"_30262":2010,"_21040":55839,"_5":14474,"_27550":55764,"_2978":55840},[],"For browser key generation, follow Issue your first certificate.",{"_3496":2038,"_30262":2010,"_21040":55842,"_5":14474,"_27550":55768,"_2978":55843},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3496":2039,"_30262":2010,"_21040":55845,"_5":14474,"_27550":55772,"_2978":55846},[],"Locate the correct issuer and serial and select **Revoke Certificate**. A walkthrough is available in Revoke a certificate and check the CRL. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3496":2040,"_30262":2010,"_21040":55848,"_5":14474,"_27550":55776,"_2978":55849},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3496":2041,"_30262":2010,"_21040":55851,"_5":14474,"_27550":55780,"_2978":55852},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3496":2042,"_30262":2010,"_21040":55854,"_5":14474,"_27550":55780,"_2978":55855},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3496":2043,"_30262":2010,"_21040":55857,"_5":14474,"_27550":55780,"_2978":55858},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3496":2044,"_30262":2010,"_21040":55860,"_5":14474,"_27550":55784,"_2978":55861},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3496":2045,"_30262":2010,"_21040":55863,"_5":14474,"_27550":55784,"_2978":55864},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3496":2046,"_30262":2010,"_21040":55866,"_5":14474,"_27550":55784,"_2978":55867},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3496":2047,"_30262":2010,"_21040":55869,"_5":14474,"_27550":55788,"_2978":55870},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3496":2048,"_30262":2010,"_21040":55872,"_5":14474,"_27550":55788,"_2978":55873},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3496":2049,"_30262":2049,"_5":14825,"_2978":55875,"_30620":55876,"_21040":55878,"_27550":2049},"Certificate lifecycle",[49507,50975,54983,55877],"Concepts",[],{"_3496":2050,"_30262":2049,"_21040":55880,"_5":14474,"_27550":2049,"_2978":55881},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3496":2051,"_30262":2049,"_5":30617,"_21040":55883,"_27550":55884,"_2978":55885},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3496":2052,"_30262":2049,"_5":30617,"_21040":55887,"_27550":55888,"_2978":55889},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3496":2053,"_30262":2049,"_5":30617,"_21040":55891,"_27550":55892,"_2978":55893},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3496":2054,"_30262":2049,"_5":30617,"_21040":55895,"_27550":55896,"_2978":55897},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3496":2055,"_30262":2049,"_5":30617,"_21040":55899,"_27550":55900,"_2978":55901},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3496":2056,"_30262":2049,"_5":30617,"_21040":55903,"_27550":55904,"_2978":55905},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3496":2057,"_30262":2049,"_5":30617,"_21040":55907,"_27550":55908,"_2978":55909},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3496":2058,"_30262":2049,"_5":30617,"_21040":55911,"_27550":55912,"_2978":55913},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3496":2059,"_30262":2049,"_5":30617,"_21040":55915,"_27550":55916,"_2978":55917},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3496":2060,"_30262":2049,"_5":30617,"_21040":55919,"_27550":55920,"_2978":55921},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3496":2061,"_30262":2049,"_21040":55923,"_5":14474,"_27550":2049,"_2978":55924},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3496":2062,"_30262":2049,"_21040":55926,"_5":14474,"_27550":55888,"_2978":55927},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3496":2063,"_30262":2049,"_21040":55929,"_5":14474,"_27550":55892,"_2978":55930},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3496":2064,"_30262":2049,"_21040":55932,"_5":14474,"_27550":55896,"_2978":55933},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3496":2065,"_30262":2049,"_21040":55935,"_5":14474,"_27550":55900,"_2978":55936},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3496":2066,"_30262":2049,"_21040":55938,"_5":14474,"_27550":55904,"_2978":55939},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3496":2067,"_30262":2049,"_21040":55941,"_5":14474,"_27550":55908,"_2978":55942},[],"Lamassu persists four X.509 states:",{"_3496":2068,"_30262":2049,"_21040":55944,"_5":14474,"_27550":55908,"_2978":55945},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3496":2069,"_30262":2049,"_21040":55947,"_5":14474,"_27550":55908,"_2978":55948},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3496":2070,"_30262":2049,"_21040":55950,"_5":14474,"_27550":55908,"_2978":55951},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3496":2071,"_30262":2049,"_21040":55953,"_5":14474,"_27550":55908,"_2978":55954},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3496":2072,"_30262":2049,"_21040":55956,"_5":14474,"_27550":55908,"_2978":55957},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3496":2073,"_30262":2049,"_21040":55959,"_5":14474,"_27550":55912,"_2978":55960},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3496":2074,"_30262":2049,"_21040":55962,"_5":14474,"_27550":55912,"_2978":55963},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3496":2075,"_30262":2049,"_21040":55965,"_5":14474,"_27550":55912,"_2978":55966},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3496":2076,"_30262":2049,"_21040":55968,"_5":14474,"_27550":55916,"_2978":55969},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3496":2077,"_30262":2049,"_21040":55971,"_5":14474,"_27550":55916,"_2978":55972},[],"Before confirming:",{"_3496":2078,"_30262":2049,"_21040":55974,"_5":14474,"_27550":55916,"_2978":55975},[],"Identify DMSs, devices and services that trust that chain.",{"_3496":2079,"_30262":2049,"_21040":55977,"_5":14474,"_27550":55916,"_2978":55978},[],"Distribute the new chain of trust.",{"_3496":2080,"_30262":2049,"_21040":55980,"_5":14474,"_27550":55916,"_2978":55981},[],"Reissue the necessary identities.",{"_3496":2081,"_30262":2049,"_21040":55983,"_5":14474,"_27550":55916,"_2978":55984},[],"Check OCSP and CRL from a real consumer.",{"_3496":2082,"_30262":2049,"_21040":55986,"_5":14474,"_27550":55916,"_2978":55987},[],"Revoke the old CA once no legitimate traffic remains.",{"_3496":2083,"_30262":2049,"_21040":55989,"_5":14474,"_27550":55916,"_2978":55990},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3496":2084,"_30262":2049,"_21040":55992,"_5":14474,"_27550":55920,"_2978":55993},[],"Certificates entering the preventive or critical renewal window.",{"_3496":2085,"_30262":2049,"_21040":55995,"_5":14474,"_27550":55920,"_2978":55996},[],"Repeated enrollment or re-enrollment failures.",{"_3496":2086,"_30262":2049,"_21040":55998,"_5":14474,"_27550":55920,"_2978":55999},[],"Status changes and revocation reasons.",{"_3496":2087,"_30262":2049,"_21040":56001,"_5":14474,"_27550":55920,"_2978":56002},[],"OCSP and CRL publication and validity.",{"_3496":2088,"_30262":2049,"_21040":56004,"_5":14474,"_27550":55920,"_2978":56005},[],"Dependencies still presenting a replaced certificate.",{"_3496":2089,"_30262":2049,"_21040":56007,"_5":14474,"_27550":55920,"_2978":56008},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3496":2090,"_30262":2090,"_5":14825,"_2978":56010,"_30620":56011,"_21040":56012,"_27550":2090},"Trust model",[49507,50975,54983,55877],[],{"_3496":2091,"_30262":2090,"_21040":56014,"_5":14474,"_27550":2090,"_2978":56015},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3496":2092,"_30262":2090,"_5":30617,"_21040":56017,"_27550":56018,"_2978":56019},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3496":2093,"_30262":2090,"_5":30617,"_21040":56021,"_27550":56022,"_2978":56023},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3496":2094,"_30262":2090,"_5":30617,"_21040":56025,"_27550":56026,"_2978":56027},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3496":2095,"_30262":2090,"_5":30617,"_21040":56029,"_27550":56030,"_2978":56031},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3496":2096,"_30262":2090,"_5":30617,"_21040":56033,"_27550":56034,"_2978":56035},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3496":2097,"_30262":2090,"_5":30617,"_21040":56037,"_27550":56038,"_2978":56039},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3496":2098,"_30262":2090,"_5":30617,"_21040":56041,"_27550":56042,"_2978":56043},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3496":2099,"_30262":2090,"_5":30617,"_21040":56045,"_27550":56046,"_2978":56047},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3496":2100,"_30262":2090,"_5":30617,"_21040":56049,"_27550":56050,"_2978":56051},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3496":2101,"_30262":2090,"_5":30617,"_21040":56053,"_27550":56054,"_2978":56055},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3496":2102,"_30262":2090,"_21040":56057,"_5":14474,"_27550":2090,"_2978":56058},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3496":2103,"_30262":2090,"_21040":56060,"_5":14474,"_27550":56022,"_2978":56061},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3496":2104,"_30262":2090,"_21040":56063,"_5":14474,"_27550":56026,"_2978":56064},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3496":2105,"_30262":2090,"_21040":56066,"_5":14474,"_27550":56030,"_2978":56067},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3496":2106,"_30262":2090,"_21040":56069,"_5":14474,"_27550":56034,"_2978":56070},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3496":2107,"_30262":2090,"_21040":56072,"_5":14474,"_27550":56038,"_2978":56073},[],"The device proves it can enroll according to the DMS policy.",{"_3496":2108,"_30262":2090,"_21040":56075,"_5":14474,"_27550":56038,"_2978":56076},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3496":2109,"_30262":2090,"_21040":56078,"_5":14474,"_27550":56038,"_2978":56079},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3496":2110,"_30262":2090,"_21040":56081,"_5":14474,"_27550":56038,"_2978":56082},[],"The device installs the certificate and the chain it needs.",{"_3496":2111,"_30262":2090,"_21040":56084,"_5":14474,"_27550":56038,"_2978":56085},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3496":2112,"_30262":2090,"_21040":56087,"_5":14474,"_27550":56038,"_2978":56088},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3496":2113,"_30262":2090,"_21040":56090,"_5":14474,"_27550":56042,"_2978":56091},[],"A DMS relates three sets that are worth designing separately:",{"_3496":2114,"_30262":2090,"_21040":56093,"_5":14474,"_27550":56042,"_2978":56094},[],"**Enrollment CA:** signs the new identities.",{"_3496":2115,"_30262":2090,"_21040":56096,"_5":14474,"_27550":56042,"_2978":56097},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3496":2116,"_30262":2090,"_21040":56099,"_5":14474,"_27550":56042,"_2978":56100},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3496":2117,"_30262":2090,"_21040":56102,"_5":14474,"_27550":56042,"_2978":56103},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3496":2118,"_30262":2090,"_21040":56105,"_5":14474,"_27550":56046,"_2978":56106},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3496":2119,"_30262":2090,"_21040":56108,"_5":14474,"_27550":56046,"_2978":56109},[],"that the current date is between `Not Before` and `Not After`;",{"_3496":2120,"_30262":2090,"_21040":56111,"_5":14474,"_27550":56046,"_2978":56112},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3496":2121,"_30262":2090,"_21040":56114,"_5":14474,"_27550":56046,"_2978":56115},[],"that names, SANs and subject match the expected identity;",{"_3496":2122,"_30262":2090,"_21040":56117,"_5":14474,"_27550":56046,"_2978":56118},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3496":2123,"_30262":2090,"_21040":56120,"_5":14474,"_27550":56046,"_2978":56121},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3496":2124,"_30262":2090,"_21040":56123,"_5":14474,"_27550":56046,"_2978":56124},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3496":2125,"_30262":2090,"_21040":56126,"_5":14474,"_27550":56050,"_2978":56127},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3496":2126,"_30262":2090,"_21040":56129,"_5":14474,"_27550":56054,"_2978":56130},[],"Keep the root out of daily operations, or with very restricted access.",{"_3496":2127,"_30262":2090,"_21040":56132,"_5":14474,"_27550":56054,"_2978":56133},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3496":2128,"_30262":2090,"_21040":56135,"_5":14474,"_27550":56054,"_2978":56136},[],"Assign explicit profiles to every use case.",{"_3496":2129,"_30262":2090,"_21040":56138,"_5":14474,"_27550":56054,"_2978":56139},[],"Distribute the new trust before starting a rotation.",{"_3496":2130,"_30262":2090,"_21040":56141,"_5":14474,"_27550":56054,"_2978":56142},[],"Keep enough overlap to renew a disconnected fleet.",{"_3496":2131,"_30262":2090,"_21040":56144,"_5":14474,"_27550":56054,"_2978":56145},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3496":2132,"_30262":2090,"_21040":56147,"_5":14474,"_27550":56054,"_2978":56148},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3496":2133,"_30262":2133,"_5":14825,"_2978":56150,"_30620":56151,"_21040":56152,"_27550":2133},"Revocation lists (CRL)",[49507,50975,54983,55622],[],{"_3496":2134,"_30262":2133,"_21040":56154,"_5":14474,"_27550":2133,"_2978":56155},[],"Generate and distribute signed lists to validate certificates offline.",{"_3496":2135,"_30262":2133,"_5":30617,"_21040":56157,"_27550":56158,"_2978":56159},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings","CRL settings",{"_3496":2136,"_30262":2133,"_5":30617,"_21040":56161,"_27550":56162,"_2978":56163},[],"/docs/pr-preview/pr-61/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3496":2137,"_30262":2133,"_5":30617,"_21040":56165,"_27550":56166,"_2978":56167},[],"/docs/pr-preview/pr-61/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3496":2138,"_30262":2133,"_5":30617,"_21040":56169,"_27550":56170,"_2978":56171},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-contents","CRL contents",{"_3496":2139,"_30262":2133,"_5":30617,"_21040":56173,"_27550":56174,"_2978":56175},[],"/docs/pr-preview/pr-61/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3496":2140,"_30262":2133,"_5":30617,"_21040":56177,"_27550":56178,"_2978":56179},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings-api","CRL settings API",{"_3496":2141,"_30262":2133,"_5":30617,"_21040":56181,"_27550":56182,"_2978":56183},[],"/docs/pr-preview/pr-61/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3496":2142,"_30262":2133,"_5":30617,"_21040":56185,"_27550":56186,"_2978":56187},[],"/docs/pr-preview/pr-61/platform/pki/crl#from-the-interface","From the interface",{"_3496":2143,"_30262":2133,"_5":30617,"_21040":56189,"_27550":56190,"_2978":56191},[],"/docs/pr-preview/pr-61/platform/pki/crl#references","References",{"_3496":2144,"_30262":2133,"_21040":56193,"_5":14474,"_27550":2133,"_2978":56194},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3496":2145,"_30262":2133,"_21040":56196,"_5":14474,"_27550":56158,"_2978":56197},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3496":2146,"_30262":2133,"_21040":56199,"_5":14474,"_27550":56158,"_2978":56200},[],"Field",{"_3496":2147,"_30262":2133,"_21040":56202,"_5":14474,"_27550":56158,"_2978":49897},[],{"_3496":2148,"_30262":2133,"_21040":56204,"_5":14474,"_27550":56158,"_2978":56205},[],"`ca_id`",{"_3496":2149,"_30262":2133,"_21040":56207,"_5":14474,"_27550":56158,"_2978":56208},[],"ID of the CA the settings belong to.",{"_3496":2150,"_30262":2133,"_21040":56210,"_5":14474,"_27550":56158,"_2978":56211},[],"`status`",{"_3496":2151,"_30262":2133,"_21040":56213,"_5":14474,"_27550":56158,"_2978":56214},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3496":2152,"_30262":2133,"_21040":56216,"_5":14474,"_27550":56158,"_2978":56217},[],"`legacy_ski`",{"_3496":2153,"_30262":2133,"_21040":56219,"_5":14474,"_27550":56158,"_2978":56220},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3496":2154,"_30262":2133,"_21040":56222,"_5":14474,"_27550":56158,"_2978":56223},[],"`latest_crl`",{"_3496":2155,"_30262":2133,"_21040":56225,"_5":14474,"_27550":56158,"_2978":56226},[],"Version, validity start and end of the last published list. Read-only.",{"_3496":2156,"_30262":2133,"_21040":56228,"_5":14474,"_27550":56158,"_2978":56229},[],"`crl_options` field",{"_3496":2157,"_30262":2133,"_21040":56231,"_5":14474,"_27550":56158,"_2978":49897},[],{"_3496":2158,"_30262":2133,"_21040":56233,"_5":14474,"_27550":56158,"_2978":56234},[],"Initial value",{"_3496":2159,"_30262":2133,"_21040":56236,"_5":14474,"_27550":56158,"_2978":56237},[],"`validity`",{"_3496":2160,"_30262":2133,"_21040":56239,"_5":14474,"_27550":56158,"_2978":56240},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3496":2161,"_30262":2133,"_21040":56242,"_5":14474,"_27550":56158,"_2978":56243},[],"7 days.",{"_3496":2162,"_30262":2133,"_21040":56245,"_5":14474,"_27550":56158,"_2978":56246},[],"`refresh_interval`",{"_3496":2163,"_30262":2133,"_21040":56248,"_5":14474,"_27550":56158,"_2978":56249},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3496":2164,"_30262":2133,"_21040":56251,"_5":14474,"_27550":56158,"_2978":56252},[],"6 days and 23 hours.",{"_3496":2165,"_30262":2133,"_21040":56254,"_5":14474,"_27550":56158,"_2978":56255},[],"`regenerate_on_revoke`",{"_3496":2166,"_30262":2133,"_21040":56257,"_5":14474,"_27550":56158,"_2978":56258},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3496":2167,"_30262":2133,"_21040":56260,"_5":14474,"_27550":56158,"_2978":56261},[],"`true`.",{"_3496":2168,"_30262":2133,"_21040":56263,"_5":14474,"_27550":56158,"_2978":56264},[],"`signer_serial_number`",{"_3496":2169,"_30262":2133,"_21040":56266,"_5":14474,"_27550":56158,"_2978":56267},[],"Serial number of the existing certificate that signs the CRL.",{"_3496":2170,"_30262":2133,"_21040":56269,"_5":14474,"_27550":56158,"_2978":56270},[],"Serial number of the CA’s current certificate.",{"_3496":2171,"_30262":2133,"_21040":56272,"_5":14474,"_27550":56158,"_2978":56273},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3496":2172,"_30262":2133,"_21040":56275,"_5":14474,"_27550":56158,"_2978":56276},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3496":2173,"_30262":2133,"_21040":56278,"_5":14474,"_27550":56158,"_2978":56279},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3496":2174,"_30262":2133,"_21040":56281,"_5":14474,"_27550":56158,"_2978":56282},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3496":2175,"_30262":2133,"_21040":56284,"_5":14474,"_27550":56158,"_2978":56285},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3496":2176,"_30262":2133,"_21040":56287,"_5":14474,"_27550":56158,"_2978":56288},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3496":2177,"_30262":2133,"_21040":56290,"_5":14474,"_27550":56158,"_2978":56291},[],"Adjust validity and signer before deleting a CA.",{"_3496":2178,"_30262":2133,"_21040":56293,"_5":14474,"_27550":56158,"_2978":56294},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3496":2179,"_30262":2133,"_21040":56296,"_5":14474,"_27550":56158,"_2978":56297},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3496":2180,"_30262":2133,"_21040":56299,"_5":14474,"_27550":56158,"_2978":56300},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3496":2181,"_30262":2133,"_21040":56302,"_5":14474,"_27550":56162,"_2978":56303},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3496":2182,"_30262":2133,"_21040":56305,"_5":14474,"_27550":56162,"_2978":56306},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3496":2183,"_30262":2133,"_21040":56308,"_5":14474,"_27550":56162,"_2978":56309},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3496":2184,"_30262":2133,"_21040":56311,"_5":14474,"_27550":56162,"_2978":56312},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3496":2185,"_30262":2133,"_21040":56314,"_5":14474,"_27550":56166,"_2978":56315},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3496":2186,"_30262":2133,"_21040":56317,"_5":14474,"_27550":56166,"_2978":56318},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3496":2187,"_30262":2133,"_21040":56320,"_5":14474,"_27550":56166,"_2978":56321},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3496":2188,"_30262":2133,"_21040":56323,"_5":14474,"_27550":56166,"_2978":56324},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3496":2189,"_30262":2133,"_21040":56326,"_5":14474,"_27550":56166,"_2978":56327},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3496":2190,"_30262":2133,"_21040":56329,"_5":14474,"_27550":56166,"_2978":56330},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3496":2191,"_30262":2133,"_21040":56332,"_5":14474,"_27550":56166,"_2978":56333},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3496":2192,"_30262":2133,"_21040":56335,"_5":14474,"_27550":56166,"_2978":56336},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3496":2193,"_30262":2133,"_21040":56338,"_5":14474,"_27550":56166,"_2978":56339},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3496":2194,"_30262":2133,"_21040":56341,"_5":14474,"_27550":56170,"_2978":56342},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3496":2195,"_30262":2133,"_21040":56344,"_5":14474,"_27550":56170,"_2978":56345},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3496":2196,"_30262":2133,"_21040":56347,"_5":14474,"_27550":56174,"_2978":56348},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3496":2197,"_30262":2133,"_21040":56350,"_5":14474,"_27550":56174,"_2978":56351},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3496":2198,"_30262":2133,"_21040":56353,"_5":14474,"_27550":56174,"_2978":56354},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3496":2199,"_30262":2133,"_21040":56356,"_5":14474,"_27550":56174,"_2978":56357},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3496":2200,"_30262":2133,"_21040":56359,"_5":14474,"_27550":56174,"_2978":56360},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3496":2201,"_30262":2133,"_21040":56362,"_5":14474,"_27550":56178,"_2978":56363},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3496":2202,"_30262":2133,"_21040":56365,"_5":14474,"_27550":56178,"_2978":52748},[],{"_3496":2203,"_30262":2133,"_21040":56367,"_5":14474,"_27550":56178,"_2978":56368},[],"Relative path",{"_3496":2204,"_30262":2133,"_21040":56370,"_5":14474,"_27550":56178,"_2978":52745},[],{"_3496":2205,"_30262":2133,"_21040":56372,"_5":14474,"_27550":56178,"_2978":56373},[],"`GET`",{"_3496":2206,"_30262":2133,"_21040":56375,"_5":14474,"_27550":56178,"_2978":56376},[],"`/v1/crl-settings`",{"_3496":2207,"_30262":2133,"_21040":56378,"_5":14474,"_27550":56178,"_2978":56379},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3496":2208,"_30262":2133,"_21040":56381,"_5":14474,"_27550":56178,"_2978":56373},[],{"_3496":2209,"_30262":2133,"_21040":56383,"_5":14474,"_27550":56178,"_2978":56384},[],"`/v1/crl-settings/{ca-id}`",{"_3496":2210,"_30262":2133,"_21040":56386,"_5":14474,"_27550":56178,"_2978":56387},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3496":2211,"_30262":2133,"_21040":56389,"_5":14474,"_27550":56178,"_2978":56390},[],"`PUT`",{"_3496":2212,"_30262":2133,"_21040":56392,"_5":14474,"_27550":56178,"_2978":56384},[],{"_3496":2213,"_30262":2133,"_21040":56394,"_5":14474,"_27550":56178,"_2978":56395},[],"Replace the CRL configuration of a CA.",{"_3496":2214,"_30262":2133,"_21040":56397,"_5":14474,"_27550":56178,"_2978":56398},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3496":2215,"_30262":2133,"_21040":56400,"_5":14474,"_27550":56178,"_2978":56401},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3496":2216,"_30262":2133,"_21040":56403,"_5":14474,"_27550":56182,"_2978":56404},[],"Symptom",{"_3496":2217,"_30262":2133,"_21040":56406,"_5":14474,"_27550":56182,"_2978":56407},[],"Cause",{"_3496":2218,"_30262":2133,"_21040":56409,"_5":14474,"_27550":56182,"_2978":56410},[],"Action",{"_3496":2219,"_30262":2133,"_21040":56412,"_5":14474,"_27550":56182,"_2978":56413},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3496":2220,"_30262":2133,"_21040":56415,"_5":14474,"_27550":56182,"_2978":56416},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3496":2221,"_30262":2133,"_21040":56418,"_5":14474,"_27550":56182,"_2978":56419},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3496":2222,"_30262":2133,"_21040":56421,"_5":14474,"_27550":56182,"_2978":56422},[],"`PUT` returns 400.",{"_3496":2223,"_30262":2133,"_21040":56424,"_5":14474,"_27550":56182,"_2978":56425},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3496":2224,"_30262":2133,"_21040":56427,"_5":14474,"_27550":56182,"_2978":56428},[],"Set the serial number of a valid certificate of that CA.",{"_3496":2225,"_30262":2133,"_21040":56430,"_5":14474,"_27550":56182,"_2978":56431},[],"`PUT` returns 404.",{"_3496":2226,"_30262":2133,"_21040":56433,"_5":14474,"_27550":56182,"_2978":56434},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3496":2227,"_30262":2133,"_21040":56436,"_5":14474,"_27550":56182,"_2978":56437},[],"Check the CA ID and the signer serial number.",{"_3496":2228,"_30262":2133,"_21040":56439,"_5":14474,"_27550":56182,"_2978":56440},[],"`PUT` returns 400 from a 3.x client.",{"_3496":2229,"_30262":2133,"_21040":56442,"_5":14474,"_27550":56182,"_2978":56443},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3496":2230,"_30262":2133,"_21040":56445,"_5":14474,"_27550":56182,"_2978":56446},[],"Update the client to send the new field.",{"_3496":2231,"_30262":2133,"_21040":56448,"_5":14474,"_27550":56182,"_2978":56449},[],"The CRL does not change after revoking a certificate.",{"_3496":2232,"_30262":2133,"_21040":56451,"_5":14474,"_27550":56182,"_2978":56452},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3496":2233,"_30262":2133,"_21040":56454,"_5":14474,"_27550":56182,"_2978":56455},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3496":2234,"_30262":2133,"_21040":56457,"_5":14474,"_27550":56182,"_2978":56458},[],"A verifier rejects the CRL because of the issuer.",{"_3496":2235,"_30262":2133,"_21040":56460,"_5":14474,"_27550":56182,"_2978":56461},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3496":2236,"_30262":2133,"_21040":56463,"_5":14474,"_27550":56182,"_2978":56464},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3496":2237,"_30262":2133,"_21040":56466,"_5":14474,"_27550":56186,"_2978":56467},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3496":2238,"_30262":2133,"_21040":56469,"_5":14474,"_27550":56190,"_2978":56470},[],"RFC 5280: X.509 and CRL profile.",{"_3496":2239,"_30262":2133,"_21040":56472,"_5":14474,"_27550":56190,"_2978":56473},[],"OpenSSL: openssl-crl.",{"_3496":2240,"_30262":2133,"_21040":56475,"_5":14474,"_27550":56190,"_2978":56476},[],"OpenSSL: openssl-verify.",{"_3496":2241,"_30262":2133,"_21040":56478,"_5":14474,"_27550":56190,"_2978":56479},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3496":2242,"_30262":2133,"_21040":56481,"_5":14474,"_27550":56190,"_2978":56482},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3496":2243,"_30262":2243,"_5":14825,"_2978":56484,"_30620":56485,"_21040":56486,"_27550":2243},"Keys and cryptographic engines",[49507,50975,54983,54984],[],{"_3496":2244,"_30262":2243,"_21040":56488,"_5":14474,"_27550":2243,"_2978":56489},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3496":2245,"_30262":2243,"_5":30617,"_21040":56491,"_27550":56492,"_2978":56493},[],"/docs/pr-preview/pr-61/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3496":2246,"_30262":2243,"_5":30617,"_21040":56495,"_27550":56496,"_2978":56497},[],"/docs/pr-preview/pr-61/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3496":2247,"_30262":2243,"_5":30617,"_21040":56499,"_27550":56500,"_2978":56501},[],"/docs/pr-preview/pr-61/platform/pki/key-management#file-system","File System",{"_3496":2248,"_30262":2243,"_5":30617,"_21040":56503,"_27550":56504,"_2978":56505},[],"/docs/pr-preview/pr-61/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3496":2249,"_30262":2243,"_5":30617,"_21040":56507,"_27550":56508,"_2978":56509},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3496":2250,"_30262":2243,"_5":30617,"_21040":56511,"_27550":56512,"_2978":56513},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-kms","AWS KMS",{"_3496":2251,"_30262":2243,"_5":30617,"_21040":56515,"_27550":56516,"_2978":56517},[],"/docs/pr-preview/pr-61/platform/pki/key-management#pkcs11","PKCS#11",{"_3496":2252,"_30262":2243,"_5":30617,"_21040":56519,"_27550":56520,"_2978":56521},[],"/docs/pr-preview/pr-61/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3496":2253,"_30262":2243,"_5":30617,"_21040":56523,"_27550":56524,"_2978":56525},[],"/docs/pr-preview/pr-61/platform/pki/key-management#key-inventory","Key inventory",{"_3496":2254,"_30262":2243,"_5":30617,"_21040":56527,"_27550":56528,"_2978":56529},[],"/docs/pr-preview/pr-61/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3496":2255,"_30262":2243,"_5":30617,"_21040":56531,"_27550":56532,"_2978":56533},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3496":2256,"_30262":2243,"_5":30617,"_21040":56535,"_27550":56536,"_2978":56537},[],"/docs/pr-preview/pr-61/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3496":2257,"_30262":2243,"_5":30617,"_21040":56539,"_27550":56540,"_2978":56541},[],"/docs/pr-preview/pr-61/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3496":2258,"_30262":2243,"_5":30617,"_21040":56543,"_27550":56544,"_2978":56545},[],"/docs/pr-preview/pr-61/platform/pki/key-management#view-details","View details",{"_3496":2259,"_30262":2243,"_5":30617,"_21040":56547,"_27550":56548,"_2978":56549},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3496":2260,"_30262":2243,"_5":30617,"_21040":56551,"_27550":56552,"_2978":56553},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign","Sign",{"_3496":2261,"_30262":2243,"_5":30617,"_21040":56555,"_27550":56556,"_2978":56557},[],"/docs/pr-preview/pr-61/platform/pki/key-management#verify","Verify",{"_3496":2262,"_30262":2243,"_5":30617,"_21040":56559,"_27550":56560,"_2978":56561},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3496":2263,"_30262":2243,"_5":30617,"_21040":56563,"_27550":56564,"_2978":56565},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3496":2264,"_30262":2243,"_5":30617,"_21040":56567,"_27550":56568,"_2978":56569},[],"/docs/pr-preview/pr-61/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3496":2265,"_30262":2243,"_21040":56571,"_5":14474,"_27550":2243,"_2978":56572},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3496":2266,"_30262":2243,"_21040":56574,"_5":14474,"_27550":2243,"_2978":56575},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3496":2267,"_30262":2243,"_21040":56577,"_5":14474,"_27550":56492,"_2978":56578},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3496":2268,"_30262":2243,"_21040":56580,"_5":14474,"_27550":56492,"_2978":56581},[],"In practice, it lets you:",{"_3496":2269,"_30262":2243,"_21040":56583,"_5":14474,"_27550":56492,"_2978":56584},[],"Generate new key pairs from Lamassu IoT.",{"_3496":2270,"_30262":2243,"_21040":56586,"_5":14474,"_27550":56492,"_2978":56587},[],"Import keys created externally.",{"_3496":2271,"_30262":2243,"_21040":56589,"_5":14474,"_27550":56492,"_2978":56590},[],"Delegate custody and cryptographic operations to external engines.",{"_3496":2272,"_30262":2243,"_21040":56592,"_5":14474,"_27550":56492,"_2978":56593},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3496":2273,"_30262":2243,"_21040":56595,"_5":14474,"_27550":56496,"_2978":56596},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3496":2274,"_30262":2243,"_21040":56598,"_5":14474,"_27550":56496,"_2978":56599},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3496":2275,"_30262":2243,"_21040":56601,"_5":14474,"_27550":56496,"_2978":56602},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3496":2276,"_30262":2243,"_21040":56604,"_5":14474,"_27550":56500,"_2978":56605},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3496":2277,"_30262":2243,"_21040":56607,"_5":14474,"_27550":56504,"_2978":56608},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3496":2278,"_30262":2243,"_21040":56610,"_5":14474,"_27550":56504,"_2978":56611},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3496":2279,"_30262":2243,"_21040":56613,"_5":14474,"_27550":56508,"_2978":56614},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3496":2280,"_30262":2243,"_21040":56616,"_5":14474,"_27550":56512,"_2978":56617},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3496":2281,"_30262":2243,"_21040":56619,"_5":14474,"_27550":56516,"_2978":56620},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3496":2282,"_30262":2243,"_21040":56622,"_5":14474,"_27550":56520,"_2978":56623},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3496":2283,"_30262":2243,"_21040":56625,"_5":14474,"_27550":56520,"_2978":56626},[],"Lamassu shows the enabled engines in the console.",{"_3496":2284,"_30262":2243,"_21040":56628,"_5":14474,"_27550":56520,"_2978":56629},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3496":2285,"_30262":2243,"_21040":56631,"_5":14474,"_27550":56520,"_2978":56632},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3496":2286,"_30262":2243,"_21040":56634,"_5":14474,"_27550":56524,"_2978":56635},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3496":2287,"_30262":2243,"_21040":56637,"_5":14474,"_27550":56524,"_2978":56638},[],"The table includes the following fields:",{"_3496":2288,"_30262":2243,"_21040":56640,"_5":14474,"_27550":56524,"_2978":56641},[],"**Name**: descriptive name of the key.",{"_3496":2289,"_30262":2243,"_21040":56643,"_5":14474,"_27550":56524,"_2978":56644},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3496":2290,"_30262":2243,"_21040":56646,"_5":14474,"_27550":56524,"_2978":56647},[],"**Strength**: visual indicator of cryptographic strength.",{"_3496":2291,"_30262":2243,"_21040":56649,"_5":14474,"_27550":56524,"_2978":56650},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3496":2292,"_30262":2243,"_21040":56652,"_5":14474,"_27550":56524,"_2978":56653},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3496":2293,"_30262":2243,"_21040":56655,"_5":14474,"_27550":56524,"_2978":56656},[],"**Aliases**: alternative names associated with the key.",{"_3496":2294,"_30262":2243,"_21040":56658,"_5":14474,"_27550":56524,"_2978":56659},[],"**Tags**: labels for classification and search.",{"_3496":2295,"_30262":2243,"_21040":56661,"_5":14474,"_27550":56524,"_2978":56662},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3496":2296,"_30262":2243,"_21040":56664,"_5":14474,"_27550":56524,"_2978":56665},[],"From this view you also reach the most common actions:",{"_3496":2297,"_30262":2243,"_21040":56667,"_5":14474,"_27550":56524,"_2978":56668},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3496":2298,"_30262":2243,"_21040":56670,"_5":14474,"_27550":56524,"_2978":56671},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3496":2299,"_30262":2243,"_21040":56673,"_5":14474,"_27550":56524,"_2978":56674},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3496":2300,"_30262":2243,"_21040":56676,"_5":14474,"_27550":56524,"_2978":56677},[],"**Delete Key** to remove the key from the system.",{"_3496":2301,"_30262":2243,"_21040":56679,"_5":14474,"_27550":56528,"_2978":56680},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3496":2302,"_30262":2243,"_21040":56682,"_5":14474,"_27550":56532,"_2978":56683},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3496":2303,"_30262":2243,"_21040":56685,"_5":14474,"_27550":56532,"_2978":56686},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3496":2304,"_30262":2243,"_21040":56688,"_5":14474,"_27550":56532,"_2978":56689},[],"**Key Name**: unique and descriptive name.",{"_3496":2305,"_30262":2243,"_21040":56691,"_5":14474,"_27550":56532,"_2978":56692},[],"**Crypto Engine**: engine that will keep the key.",{"_3496":2306,"_30262":2243,"_21040":56694,"_5":14474,"_27550":56532,"_2978":56695},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3496":2307,"_30262":2243,"_21040":56697,"_5":14474,"_27550":56532,"_2978":56698},[],"**Tags**: metadata to classify the key.",{"_3496":2308,"_30262":2243,"_21040":56700,"_5":14474,"_27550":56532,"_2978":56701},[],"**Metadata**: additional information for advanced uses.",{"_3496":2309,"_30262":2243,"_21040":56703,"_5":14474,"_27550":56536,"_2978":56704},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3496":2310,"_30262":2243,"_21040":56706,"_5":14474,"_27550":56536,"_2978":56707},[],"When you have an exportable private key and the destination engine supports import.",{"_3496":2311,"_30262":2243,"_21040":56709,"_5":14474,"_27550":56536,"_2978":56710},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3496":2312,"_30262":2243,"_21040":56712,"_5":14474,"_27550":56536,"_2978":56713},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3496":2313,"_30262":2243,"_21040":56715,"_5":14474,"_27550":56536,"_2978":56716},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3496":2314,"_30262":2243,"_21040":56718,"_5":14474,"_27550":56536,"_2978":56719},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3496":2315,"_30262":2243,"_21040":56721,"_5":14474,"_27550":56536,"_2978":56722},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3496":2316,"_30262":2243,"_21040":56724,"_5":14474,"_27550":56536,"_2978":56725},[],"**Tags**: labels for organization and search.",{"_3496":2317,"_30262":2243,"_21040":56727,"_5":14474,"_27550":56536,"_2978":56728},[],"**Metadata**: additional optional information.",{"_3496":2318,"_30262":2243,"_21040":56730,"_5":14474,"_27550":56536,"_2978":56731},[],"**Private Key (PEM)**: private key in PEM format.",{"_3496":2319,"_30262":2243,"_21040":56733,"_5":14474,"_27550":56536,"_2978":56734},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3496":2320,"_30262":2243,"_21040":56736,"_5":14474,"_27550":56540,"_2978":56737},[],"Each registered key has a detail view and several operational actions.",{"_3496":2321,"_30262":2243,"_21040":56739,"_5":14474,"_27550":56544,"_2978":56740},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3496":2322,"_30262":2243,"_21040":56742,"_5":14474,"_27550":56544,"_2978":56743},[],"The **Overview** tab shows, among others, these fields:",{"_3496":2323,"_30262":2243,"_21040":56745,"_5":14474,"_27550":56544,"_2978":56746},[],"**Key Name**: descriptive name.",{"_3496":2324,"_30262":2243,"_21040":56748,"_5":14474,"_27550":56544,"_2978":56749},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3496":2325,"_30262":2243,"_21040":56751,"_5":14474,"_27550":56544,"_2978":56752},[],"**Tags**: associated labels.",{"_3496":2326,"_30262":2243,"_21040":56754,"_5":14474,"_27550":56544,"_2978":56755},[],"**Aliases**: alternative names.",{"_3496":2327,"_30262":2243,"_21040":56757,"_5":14474,"_27550":56544,"_2978":56758},[],"**Crypto Engine**: engine where the key resides.",{"_3496":2328,"_30262":2243,"_21040":56760,"_5":14474,"_27550":56544,"_2978":56761},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3496":2329,"_30262":2243,"_21040":56763,"_5":14474,"_27550":56544,"_2978":56764},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3496":2330,"_30262":2243,"_21040":56766,"_5":14474,"_27550":56544,"_2978":56767},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3496":2331,"_30262":2243,"_21040":56769,"_5":14474,"_27550":56548,"_2978":56770},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3496":2332,"_30262":2243,"_21040":56772,"_5":14474,"_27550":56548,"_2978":56773},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3496":2333,"_30262":2243,"_21040":56775,"_5":14474,"_27550":56548,"_2978":56776},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3496":2334,"_30262":2243,"_21040":56778,"_5":14474,"_27550":56552,"_2978":56779},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3496":2335,"_30262":2243,"_21040":56781,"_5":14474,"_27550":56552,"_2978":56782},[],"Main fields:",{"_3496":2336,"_30262":2243,"_21040":56784,"_5":14474,"_27550":56552,"_2978":56785},[],"**Algorithm**: signing algorithm available for the key type.",{"_3496":2337,"_30262":2243,"_21040":56787,"_5":14474,"_27550":56552,"_2978":56788},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3496":2338,"_30262":2243,"_21040":56790,"_5":14474,"_27550":56552,"_2978":56791},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3496":2339,"_30262":2243,"_21040":56793,"_5":14474,"_27550":56552,"_2978":56794},[],"**Message**: content to sign.",{"_3496":2340,"_30262":2243,"_21040":56796,"_5":14474,"_27550":56552,"_2978":56797},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3496":2341,"_30262":2243,"_21040":56799,"_5":14474,"_27550":56556,"_2978":56800},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3496":2342,"_30262":2243,"_21040":56802,"_5":14474,"_27550":56556,"_2978":56782},[],{"_3496":2343,"_30262":2243,"_21040":56804,"_5":14474,"_27550":56556,"_2978":56805},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3496":2344,"_30262":2243,"_21040":56807,"_5":14474,"_27550":56556,"_2978":56808},[],"**Message Type**: `Raw` or `Digest`.",{"_3496":2345,"_30262":2243,"_21040":56810,"_5":14474,"_27550":56556,"_2978":56811},[],"**Payload Encoding**: encoding of the message.",{"_3496":2346,"_30262":2243,"_21040":56813,"_5":14474,"_27550":56556,"_2978":56814},[],"**Message**: original message or hash.",{"_3496":2347,"_30262":2243,"_21040":56816,"_5":14474,"_27550":56556,"_2978":56817},[],"**Signature**: signature to check.",{"_3496":2348,"_30262":2243,"_21040":56819,"_5":14474,"_27550":56556,"_2978":56820},[],"**Result**: indicator of the validation result.",{"_3496":2349,"_30262":2243,"_21040":56822,"_5":14474,"_27550":56560,"_2978":56823},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3496":2350,"_30262":2243,"_21040":56825,"_5":14474,"_27550":56560,"_2978":56826},[],"This flow is useful for:",{"_3496":2351,"_30262":2243,"_21040":56828,"_5":14474,"_27550":56560,"_2978":56829},[],"Requesting certificates from an external CA.",{"_3496":2352,"_30262":2243,"_21040":56831,"_5":14474,"_27550":56560,"_2978":56832},[],"Renewing an identity while keeping the same key.",{"_3496":2353,"_30262":2243,"_21040":56834,"_5":14474,"_27550":56560,"_2978":56835},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3496":2354,"_30262":2243,"_21040":56837,"_5":14474,"_27550":56560,"_2978":56838},[],"**Common Name (CN)**: main name of the identity.",{"_3496":2355,"_30262":2243,"_21040":56840,"_5":14474,"_27550":56560,"_2978":56841},[],"**Organization (O)**: organization or company.",{"_3496":2356,"_30262":2243,"_21040":56843,"_5":14474,"_27550":56560,"_2978":56844},[],"**Organizational Unit (OU)**: department or unit.",{"_3496":2357,"_30262":2243,"_21040":56846,"_5":14474,"_27550":56560,"_2978":56847},[],"**Country (C)**: two-letter country code.",{"_3496":2358,"_30262":2243,"_21040":56849,"_5":14474,"_27550":56560,"_2978":56850},[],"**State / Province (ST)**: state or province.",{"_3496":2359,"_30262":2243,"_21040":56852,"_5":14474,"_27550":56560,"_2978":56853},[],"**Locality (L)**: city or locality.",{"_3496":2360,"_30262":2243,"_21040":56855,"_5":14474,"_27550":56560,"_2978":56856},[],"**Email Address**: contact email.",{"_3496":2361,"_30262":2243,"_21040":56858,"_5":14474,"_27550":56560,"_2978":56859},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3496":2362,"_30262":2243,"_21040":56861,"_5":14474,"_27550":56560,"_2978":56862},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3496":2363,"_30262":2243,"_21040":56864,"_5":14474,"_27550":56564,"_2978":56865},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3496":2364,"_30262":2243,"_21040":56867,"_5":14474,"_27550":56564,"_2978":56868},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3496":2365,"_30262":2243,"_21040":56870,"_5":14474,"_27550":56568,"_2978":56871},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3496":2366,"_30262":2243,"_21040":56873,"_5":14474,"_27550":56568,"_2978":56874},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3496":2367,"_30262":2367,"_5":14825,"_2978":56876,"_30620":56877,"_21040":56878,"_27550":2367},"Online validation with OCSP",[49507,50975,54983,55622],[],{"_3496":2368,"_30262":2367,"_21040":56880,"_5":14474,"_27550":2367,"_2978":56881},[],"Query signed status and verify the responder’s response.",{"_3496":2369,"_30262":2367,"_5":30617,"_21040":56883,"_27550":56884,"_2978":56885},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3496":2370,"_30262":2367,"_5":30617,"_21040":56887,"_27550":56888,"_2978":56889},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3496":2371,"_30262":2367,"_5":30617,"_21040":56891,"_27550":56892,"_2978":56893},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3496":2372,"_30262":2367,"_5":30617,"_21040":56895,"_27550":56896,"_2978":56897},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3496":2373,"_30262":2367,"_5":30617,"_21040":56899,"_27550":56900,"_2978":56901},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3496":2374,"_30262":2367,"_5":30617,"_21040":56903,"_27550":56904,"_2978":56191},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#references",{"_3496":2375,"_30262":2367,"_21040":56906,"_5":14474,"_27550":2367,"_2978":56907},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3496":2376,"_30262":2367,"_21040":56909,"_5":14474,"_27550":56884,"_2978":56910},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3496":2377,"_30262":2367,"_21040":56912,"_5":14474,"_27550":56884,"_2978":56913},[],"Record status",{"_3496":2378,"_30262":2367,"_21040":56915,"_5":14474,"_27550":56884,"_2978":56916},[],"Signed response",{"_3496":2379,"_30262":2367,"_21040":56918,"_5":14474,"_27550":56884,"_2978":54120},[],{"_3496":2380,"_30262":2367,"_21040":56920,"_5":14474,"_27550":56884,"_2978":56921},[],"`Good`.",{"_3496":2381,"_30262":2367,"_21040":56923,"_5":14474,"_27550":56884,"_2978":54137},[],{"_3496":2382,"_30262":2367,"_21040":56925,"_5":14474,"_27550":56884,"_2978":56926},[],"`Revoked`, with revocation reason and timestamp.",{"_3496":2383,"_30262":2367,"_21040":56928,"_5":14474,"_27550":56884,"_2978":56929},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3496":2384,"_30262":2367,"_21040":56931,"_5":14474,"_27550":56884,"_2978":56932},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3496":2385,"_30262":2367,"_21040":56934,"_5":14474,"_27550":56884,"_2978":56935},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3496":2386,"_30262":2367,"_21040":56937,"_5":14474,"_27550":56884,"_2978":56938},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3496":2387,"_30262":2367,"_21040":56940,"_5":14474,"_27550":56884,"_2978":56941},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3496":2388,"_30262":2367,"_21040":56943,"_5":14474,"_27550":56888,"_2978":56944},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3496":2389,"_30262":2367,"_21040":56946,"_5":14474,"_27550":56888,"_2978":56947},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3496":2390,"_30262":2367,"_21040":56949,"_5":14474,"_27550":56892,"_2978":56950},[],"The service accepts:",{"_3496":2391,"_30262":2367,"_21040":56952,"_5":14474,"_27550":56892,"_2978":52748},[],{"_3496":2392,"_30262":2367,"_21040":56954,"_5":14474,"_27550":56892,"_2978":56955},[],"VA service path",{"_3496":2393,"_30262":2367,"_21040":56957,"_5":14474,"_27550":56892,"_2978":56958},[],"Format",{"_3496":2394,"_30262":2367,"_21040":56960,"_5":14474,"_27550":56892,"_2978":56961},[],"`POST`",{"_3496":2395,"_30262":2367,"_21040":56963,"_5":14474,"_27550":56892,"_2978":56964},[],"`/ocsp`",{"_3496":2396,"_30262":2367,"_21040":56966,"_5":14474,"_27550":56892,"_2978":56967},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3496":2397,"_30262":2367,"_21040":56969,"_5":14474,"_27550":56892,"_2978":56373},[],{"_3496":2398,"_30262":2367,"_21040":56971,"_5":14474,"_27550":56892,"_2978":56972},[],"`/ocsp/{ocsp_request}`",{"_3496":2399,"_30262":2367,"_21040":56974,"_5":14474,"_27550":56892,"_2978":56975},[],"DER request encoded using padded URL Base64.",{"_3496":2400,"_30262":2367,"_21040":56977,"_5":14474,"_27550":56892,"_2978":56978},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3496":2401,"_30262":2367,"_21040":56980,"_5":14474,"_27550":56896,"_2978":56981},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3496":2402,"_30262":2367,"_21040":56983,"_5":14474,"_27550":56896,"_2978":56984},[],"Generate the request:",{"_3496":2403,"_30262":2367,"_21040":56986,"_5":14474,"_27550":56896,"_2978":56987},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3496":2404,"_30262":2367,"_21040":56989,"_5":14474,"_27550":56896,"_2978":56990},[],"Replace the example URL with the inspected endpoint:",{"_3496":2405,"_30262":2367,"_21040":56992,"_5":14474,"_27550":56896,"_2978":56993},[],"Verify the returned DER:",{"_3496":2406,"_30262":2367,"_21040":56995,"_5":14474,"_27550":56896,"_2978":56996},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3496":2407,"_30262":2367,"_21040":56998,"_5":14474,"_27550":56900,"_2978":56999},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3496":2408,"_30262":2367,"_21040":57001,"_5":14474,"_27550":56900,"_2978":57002},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3496":2409,"_30262":2367,"_21040":57004,"_5":14474,"_27550":56904,"_2978":57005},[],"RFC 6960: OCSP.",{"_3496":2410,"_30262":2367,"_21040":57007,"_5":14474,"_27550":56904,"_2978":57008},[],"OpenSSL: openssl-ocsp.",{"_3496":2411,"_30262":2367,"_21040":57010,"_5":14474,"_27550":56904,"_2978":57011},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3496":2412,"_30262":2367,"_21040":57013,"_5":14474,"_27550":56904,"_2978":56482},[],{"_3496":2413,"_30262":2413,"_5":14825,"_2978":54983,"_30620":57015,"_21040":57016,"_27550":2413},[49507,50975,54983],[],{"_3496":2414,"_30262":2413,"_21040":57018,"_5":14474,"_27550":2413,"_2978":57019},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3496":2415,"_30262":2413,"_5":30617,"_21040":57021,"_27550":57022,"_2978":54295},[],"/docs/pr-preview/pr-61/platform/pki/overview#start-here",{"_3496":2416,"_30262":2413,"_5":30617,"_21040":57024,"_27550":57025,"_2978":57026},[],"/docs/pr-preview/pr-61/platform/pki/overview#what-you-need","What you need",{"_3496":2417,"_30262":2413,"_5":30617,"_21040":57028,"_27550":57029,"_2978":54827},[],"/docs/pr-preview/pr-61/platform/pki/overview#core-capabilities",{"_3496":2418,"_30262":2413,"_5":30617,"_21040":57031,"_27550":57032,"_2978":54831},[],"/docs/pr-preview/pr-61/platform/pki/overview#build-your-trust-hierarchy",{"_3496":2419,"_30262":2413,"_5":30617,"_21040":57034,"_27550":57035,"_2978":54835},[],"/docs/pr-preview/pr-61/platform/pki/overview#protect-cryptographic-keys",{"_3496":2420,"_30262":2413,"_5":30617,"_21040":57037,"_27550":57038,"_2978":54839},[],"/docs/pr-preview/pr-61/platform/pki/overview#issue-and-control-certificates",{"_3496":2421,"_30262":2413,"_5":30617,"_21040":57040,"_27550":57041,"_2978":54847},[],"/docs/pr-preview/pr-61/platform/pki/overview#publish-validation-status",{"_3496":2422,"_30262":2413,"_5":30617,"_21040":57043,"_27550":57044,"_2978":57045},[],"/docs/pr-preview/pr-61/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3496":2423,"_30262":2413,"_5":30617,"_21040":57047,"_27550":57048,"_2978":55789},[],"/docs/pr-preview/pr-61/platform/pki/overview#continue",{"_3496":2424,"_30262":2413,"_21040":57050,"_5":14474,"_27550":2413,"_2978":57051},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3496":2425,"_30262":2413,"_21040":57053,"_5":14474,"_27550":57022,"_2978":57054},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3496":2426,"_30262":2413,"_21040":57056,"_5":14474,"_27550":57022,"_2978":57057},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3496":2427,"_30262":2413,"_21040":57059,"_5":14474,"_27550":57025,"_2978":57060},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3496":2428,"_30262":2413,"_21040":57062,"_5":14474,"_27550":57025,"_2978":57063},[],"An available cryptographic engine to keep the authority's key.",{"_3496":2429,"_30262":2413,"_21040":57065,"_5":14474,"_27550":57025,"_2978":57066},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3496":2430,"_30262":2413,"_21040":57068,"_5":14474,"_27550":57025,"_2978":57069},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3496":2431,"_30262":2413,"_21040":57071,"_5":14474,"_27550":57025,"_2978":57072},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3496":2432,"_30262":2413,"_21040":57074,"_5":14474,"_27550":57032,"_2978":57075},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3496":2433,"_30262":2413,"_21040":57077,"_5":14474,"_27550":57035,"_2978":57078},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3496":2434,"_30262":2413,"_21040":57080,"_5":14474,"_27550":57038,"_2978":57081},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3496":2435,"_30262":2413,"_21040":57083,"_5":14474,"_27550":57041,"_2978":57084},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3496":2436,"_30262":2413,"_21040":57086,"_5":14474,"_27550":57044,"_2978":57087},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3496":2437,"_30262":2413,"_21040":57089,"_5":14474,"_27550":57044,"_2978":57090},[],"its subject and extensions identify the expected client;",{"_3496":2438,"_30262":2413,"_21040":57092,"_5":14474,"_27550":57044,"_2978":57093},[],"its public key matches the client's private key;",{"_3496":2439,"_30262":2413,"_21040":57095,"_5":14474,"_27550":57044,"_2978":57096},[],"its chain reaches a root trusted by the consumer;",{"_3496":2440,"_30262":2413,"_21040":57098,"_5":14474,"_27550":57044,"_2978":57099},[],"its dates and usages allow the operation;",{"_3496":2441,"_30262":2413,"_21040":57101,"_5":14474,"_27550":57044,"_2978":57102},[],"the consumer applies revocation checks and authorization.",{"_3496":2442,"_30262":2413,"_21040":57104,"_5":14474,"_27550":57044,"_2978":57105},[],"The issuance path includes the first independent checks.",{"_3496":2443,"_30262":2413,"_21040":57107,"_5":14474,"_27550":57048,"_2978":57108},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3496":2444,"_30262":2413,"_21040":57110,"_5":14474,"_27550":57048,"_2978":57111},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3496":2445,"_30262":2413,"_21040":57113,"_5":14474,"_27550":57048,"_2978":57114},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3496":2446,"_30262":2446,"_5":14825,"_2978":57116,"_30620":57117,"_21040":57118,"_27550":2446},"Create your first CA",[49507,50975,54983,54420],[],{"_3496":2447,"_30262":2446,"_21040":57120,"_5":14474,"_27550":2446,"_2978":57121},[],"Create an evaluation root and check its certificate before issuing.",{"_3496":2448,"_30262":2446,"_5":30617,"_21040":57123,"_27550":57124,"_2978":49517},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3496":2449,"_30262":2446,"_5":30617,"_21040":57126,"_27550":57127,"_2978":57128},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#create-the-authority","Create the authority",{"_3496":2450,"_30262":2446,"_5":30617,"_21040":57130,"_27550":57131,"_2978":57132},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3496":2451,"_30262":2446,"_5":30617,"_21040":57134,"_27550":57135,"_2978":54677},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3496":2452,"_30262":2446,"_5":30617,"_21040":57137,"_27550":57138,"_2978":49541},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3496":2453,"_30262":2446,"_21040":57140,"_5":14474,"_27550":2446,"_2978":57141},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3496":2454,"_30262":2446,"_21040":57143,"_5":14474,"_27550":57124,"_2978":57144},[],"Console access and permission to create keys and authorities.",{"_3496":2455,"_30262":2446,"_21040":57146,"_5":14474,"_27550":57124,"_2978":57147},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3496":2456,"_30262":2446,"_21040":57149,"_5":14474,"_27550":57124,"_2978":57150},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3496":2457,"_30262":2446,"_21040":57152,"_5":14474,"_27550":57124,"_2978":57153},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3496":2458,"_30262":2446,"_21040":57155,"_5":14474,"_27550":57127,"_2978":57156},[],"Follow the interactive walkthrough to create a root CA with a new ECDSA P-384 key, an example subject and a client-certificate issuance profile. The availability and lifetime of profiles depend on your environment; choose values appropriate for your CA.",{"_3496":2459,"_30262":2446,"_21040":57158,"_5":14474,"_27550":57127,"_2978":57159},[],"The example sets **CA Name** to `Acme Showcase Root CA`, which becomes the subject Common Name (CN). It also sets the optional subject fields &#x2A;*Country (C)** to `ES` and &#x2A;*Organization (O)** to `Acme`; use values appropriate for your authority.",{"_3496":2460,"_30262":2446,"_21040":57161,"_5":14474,"_27550":57127,"_2978":57162},[],"Open the new CA and select **Certificate PEM**. Download or copy its public certificate to `ca.pem`, including the complete `BEGIN CERTIFICATE` and `END CERTIFICATE` block. The private key remains in the configured engine. To reuse an existing key instead, see the authorities guide.",{"_3496":2461,"_30262":2446,"_21040":57164,"_5":14474,"_27550":57131,"_2978":57165},[],"Run from the directory where you saved `ca.pem`:",{"_3496":2462,"_30262":2446,"_21040":57167,"_5":14474,"_27550":57131,"_2978":57168},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3496":2463,"_30262":2446,"_21040":57170,"_5":14474,"_27550":57131,"_2978":57171},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3496":2464,"_30262":2446,"_21040":57173,"_5":14474,"_27550":57135,"_2978":57174},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3496":2465,"_30262":2446,"_21040":57176,"_5":14474,"_27550":57135,"_2978":57177},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3496":2466,"_30262":2446,"_21040":57179,"_5":14474,"_27550":57135,"_2978":57180},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3496":2467,"_30262":2446,"_21040":57182,"_5":14474,"_27550":57135,"_2978":57183},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3496":2468,"_30262":2446,"_21040":57185,"_5":14474,"_27550":57138,"_2978":57186},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3496":2469,"_30262":2469,"_5":14825,"_2978":57188,"_30620":57189,"_21040":57190,"_27550":2469},"Issue and verify a certificate",[49507,50975,54983,54420],[],{"_3496":2470,"_30262":2469,"_21040":57192,"_5":14474,"_27550":2469,"_2978":57193},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3496":2471,"_30262":2469,"_5":30617,"_21040":57195,"_27550":57196,"_2978":49517},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3496":2472,"_30262":2469,"_5":30617,"_21040":57198,"_27550":57199,"_2978":57200},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3496":2473,"_30262":2469,"_5":30617,"_21040":57202,"_27550":57203,"_2978":57204},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3496":2474,"_30262":2469,"_5":30617,"_21040":57206,"_27550":57207,"_2978":57208},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3496":2475,"_30262":2469,"_5":30617,"_21040":57210,"_27550":57211,"_2978":57212},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3496":2476,"_30262":2469,"_5":30617,"_21040":57214,"_27550":57215,"_2978":57216},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3496":2477,"_30262":2469,"_5":30617,"_21040":57218,"_27550":57219,"_2978":57220},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3496":2478,"_30262":2469,"_5":30617,"_21040":57222,"_27550":57223,"_2978":57224},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3496":2479,"_30262":2469,"_5":30617,"_21040":57226,"_27550":57227,"_2978":57228},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3496":2480,"_30262":2469,"_5":30617,"_21040":57230,"_27550":57231,"_2978":57232},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3496":2481,"_30262":2469,"_5":30617,"_21040":57234,"_27550":57235,"_2978":54677},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3496":2482,"_30262":2469,"_5":30617,"_21040":57237,"_27550":57238,"_2978":49541},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#next-step",{"_3496":2483,"_30262":2469,"_21040":57240,"_5":14474,"_27550":2469,"_2978":57241},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3496":2484,"_30262":2469,"_21040":57243,"_5":14474,"_27550":57196,"_2978":57244},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3496":2485,"_30262":2469,"_21040":57246,"_5":14474,"_27550":57196,"_2978":57247},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3496":2486,"_30262":2469,"_21040":57249,"_5":14474,"_27550":57196,"_2978":57250},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3496":2487,"_30262":2469,"_21040":57252,"_5":14474,"_27550":57196,"_2978":57253},[],"A client identifier: here we use `device-001`.",{"_3496":2488,"_30262":2469,"_21040":57255,"_5":14474,"_27550":57196,"_2978":57256},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3496":2489,"_30262":2469,"_21040":57258,"_5":14474,"_27550":57199,"_2978":57259},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3496":2490,"_30262":2469,"_21040":57261,"_5":14474,"_27550":57203,"_2978":57262},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3496":2491,"_30262":2469,"_21040":57264,"_5":14474,"_27550":57203,"_2978":57265},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3496":2492,"_30262":2469,"_21040":57267,"_5":14474,"_27550":57207,"_2978":57268},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3496":2493,"_30262":2469,"_21040":57270,"_5":14474,"_27550":57207,"_2978":57271},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3496":2494,"_30262":2469,"_21040":57273,"_5":14474,"_27550":57211,"_2978":57274},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3496":2495,"_30262":2469,"_21040":57276,"_5":14474,"_27550":57211,"_2978":57277},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3496":2496,"_30262":2469,"_21040":57279,"_5":14474,"_27550":57215,"_2978":57280},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3496":2497,"_30262":2469,"_21040":57282,"_5":14474,"_27550":57219,"_2978":57283},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3496":2498,"_30262":2469,"_21040":57285,"_5":14474,"_27550":57223,"_2978":57286},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3496":2499,"_30262":2469,"_21040":57288,"_5":14474,"_27550":57227,"_2978":57289},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3496":2500,"_30262":2469,"_21040":57291,"_5":14474,"_27550":57227,"_2978":57292},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3496":2501,"_30262":2469,"_21040":57294,"_5":14474,"_27550":57227,"_2978":57295},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3496":2502,"_30262":2469,"_21040":57297,"_5":14474,"_27550":57231,"_2978":57298},[],"In Bash, compare the two public-key digests:",{"_3496":2503,"_30262":2469,"_21040":57300,"_5":14474,"_27550":57231,"_2978":57301},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3496":2504,"_30262":2469,"_21040":57303,"_5":14474,"_27550":57231,"_2978":57304},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3496":2505,"_30262":2469,"_21040":57306,"_5":14474,"_27550":57235,"_2978":54761},[],{"_3496":2506,"_30262":2469,"_21040":57308,"_5":14474,"_27550":57235,"_2978":57309},[],"What to review",{"_3496":2507,"_30262":2469,"_21040":57311,"_5":14474,"_27550":57235,"_2978":57312},[],"The CA rejects issuance",{"_3496":2508,"_30262":2469,"_21040":57314,"_5":14474,"_27550":57235,"_2978":57315},[],"Permissions, CA state and key, algorithm and profile.",{"_3496":2509,"_30262":2469,"_21040":57317,"_5":14474,"_27550":57235,"_2978":57318},[],"Different subject or usages",{"_3496":2510,"_30262":2469,"_21040":57320,"_5":14474,"_27550":57235,"_2978":57321},[],"Applied profile and requested values.",{"_3496":2511,"_30262":2469,"_21040":57323,"_5":14474,"_27550":57235,"_2978":57324},[],"Issuer cannot be found",{"_3496":2512,"_30262":2469,"_21040":57326,"_5":14474,"_27550":57235,"_2978":57327},[],"Downloaded CA and required intermediate chain.",{"_3496":2513,"_30262":2469,"_21040":57329,"_5":14474,"_27550":57235,"_2978":57330},[],"Validity fails",{"_3496":2514,"_30262":2469,"_21040":57332,"_5":14474,"_27550":57235,"_2978":57333},[],"Certificate and CA dates, and the computer's clock.",{"_3496":2515,"_30262":2469,"_21040":57335,"_5":14474,"_27550":57235,"_2978":57336},[],"Public-key digests differ",{"_3496":2516,"_30262":2469,"_21040":57338,"_5":14474,"_27550":57235,"_2978":57339},[],"Certificate and key files from the same issuance.",{"_3496":2517,"_30262":2469,"_21040":57341,"_5":14474,"_27550":57235,"_2978":57342},[],"See PKI diagnostics to narrow an issuance failure.",{"_3496":2518,"_30262":2469,"_21040":57344,"_5":14474,"_27550":57238,"_2978":57345},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3496":2519,"_30262":2469,"_21040":57347,"_5":14474,"_27550":57238,"_2978":57348},[],"Manage certificates for inspection, status and revocation.",{"_3496":2520,"_30262":2469,"_21040":57350,"_5":14474,"_27550":57238,"_2978":57351},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3496":2521,"_30262":2469,"_21040":57353,"_5":14474,"_27550":57238,"_2978":57354},[],"Prepare EST for the device to request its next identities.",{"_3496":2522,"_30262":2469,"_21040":57356,"_5":14474,"_27550":57238,"_2978":57357},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3496":2523,"_30262":2523,"_5":14825,"_2978":57359,"_30620":57360,"_21040":57361,"_27550":2523},"PKI getting started",[49507,50975,54983,54420],[],{"_3496":2524,"_30262":2523,"_21040":57363,"_5":14474,"_27550":2523,"_2978":57364},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3496":2525,"_30262":2523,"_5":30617,"_21040":57366,"_27550":57367,"_2978":49517},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#before-you-begin",{"_3496":2526,"_30262":2523,"_5":30617,"_21040":57369,"_27550":57370,"_2978":57371},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3496":2527,"_30262":2523,"_5":30617,"_21040":57373,"_27550":57374,"_2978":54612},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#expected-result",{"_3496":2528,"_30262":2523,"_5":30617,"_21040":57376,"_27550":57377,"_2978":57378},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3496":2529,"_30262":2523,"_21040":57380,"_5":14474,"_27550":2523,"_2978":57381},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3496":2530,"_30262":2523,"_21040":57383,"_5":14474,"_27550":57367,"_2978":57384},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3496":2531,"_30262":2523,"_21040":57386,"_5":14474,"_27550":57367,"_2978":57387},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3496":2532,"_30262":2523,"_21040":57389,"_5":14474,"_27550":57367,"_2978":57390},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3496":2533,"_30262":2523,"_21040":57392,"_5":14474,"_27550":57367,"_2978":57393},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3496":2534,"_30262":2523,"_21040":57395,"_5":14474,"_27550":57367,"_2978":57396},[],"A working directory with restricted access for the downloaded key.",{"_3496":2535,"_30262":2523,"_21040":57398,"_5":14474,"_27550":57370,"_2978":57399},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3496":2536,"_30262":2523,"_21040":57401,"_5":14474,"_27550":57370,"_2978":57402},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3496":2537,"_30262":2523,"_21040":57404,"_5":14474,"_27550":57370,"_2978":57405},[],"<Card title=\"3. Revoke a certificate and check the CRL\" description=\"Revoke device-042 among 100 issued certificates and confirm it appears in the CA's CRL.\" href=\"/docs/platform/pki/quickstarts/revoke-certificate\" />",{"_3496":2538,"_30262":2523,"_21040":57407,"_5":14474,"_27550":57370,"_2978":57408},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3496":2539,"_30262":2523,"_21040":57410,"_5":14474,"_27550":57370,"_2978":57411},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3496":2540,"_30262":2523,"_21040":57413,"_5":14474,"_27550":57374,"_2978":57414},[],"File or resource",{"_3496":2541,"_30262":2523,"_21040":57416,"_5":14474,"_27550":57374,"_2978":54609},[],{"_3496":2542,"_30262":2523,"_21040":57418,"_5":14474,"_27550":57374,"_2978":57419},[],"Active root CA and `ca.pem`",{"_3496":2543,"_30262":2523,"_21040":57421,"_5":14474,"_27550":57374,"_2978":57422},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3496":2544,"_30262":2523,"_21040":57424,"_5":14474,"_27550":57374,"_2978":57425},[],"End-entity certificate and `device.crt`",{"_3496":2545,"_30262":2523,"_21040":57427,"_5":14474,"_27550":57374,"_2978":57428},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3496":2546,"_30262":2523,"_21040":57430,"_5":14474,"_27550":57374,"_2978":57431},[],"Private key `device.key`",{"_3496":2547,"_30262":2523,"_21040":57433,"_5":14474,"_27550":57374,"_2978":57434},[],"Its public key matches the one included in `device.crt`.",{"_3496":2548,"_30262":2523,"_21040":57436,"_5":14474,"_27550":57374,"_2978":57437},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3496":2549,"_30262":2523,"_21040":57439,"_5":14474,"_27550":57377,"_2978":57440},[],"To operate certificates, continue with Certificates and Validation.",{"_3496":2550,"_30262":2523,"_21040":57442,"_5":14474,"_27550":57377,"_2978":57443},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3496":2551,"_30262":2523,"_21040":57445,"_5":14474,"_27550":57377,"_2978":57446},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3496":2552,"_30262":2552,"_5":14825,"_2978":57448,"_30620":57449,"_21040":57450,"_27550":2552},"Revoke a certificate and check the CRL",[49507,50975,54983,54420],[],{"_3496":2553,"_30262":2552,"_21040":57452,"_5":14474,"_27550":2552,"_2978":57453},[],"Revoke a certificate among many issued by a CA and confirm that its CRL lists it.",{"_3496":2554,"_30262":2552,"_5":30617,"_21040":57455,"_27550":57456,"_2978":49517},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#before-you-begin",{"_3496":2555,"_30262":2552,"_5":30617,"_21040":57458,"_27550":57459,"_2978":57460},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#revoke-the-certificate","Revoke the certificate",{"_3496":2556,"_30262":2552,"_5":30617,"_21040":57462,"_27550":57463,"_2978":57464},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#find-the-certificate","Find the certificate",{"_3496":2557,"_30262":2552,"_5":30617,"_21040":57466,"_27550":57467,"_2978":57468},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#revoke-it","Revoke it",{"_3496":2558,"_30262":2552,"_5":30617,"_21040":57470,"_27550":57471,"_2978":57472},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#confirm-and-read-the-status","Confirm and read the status",{"_3496":2559,"_30262":2552,"_5":30617,"_21040":57474,"_27550":57475,"_2978":55761},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#download-the-certificate",{"_3496":2560,"_30262":2552,"_5":30617,"_21040":57477,"_27550":57478,"_2978":57479},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#check-the-crl","Check the CRL",{"_3496":2561,"_30262":2552,"_5":30617,"_21040":57481,"_27550":57482,"_2978":57483},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#verify-with-the-list","Verify with the list",{"_3496":2562,"_30262":2552,"_5":30617,"_21040":57485,"_27550":57486,"_2978":54677},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#if-the-result-fails",{"_3496":2563,"_30262":2552,"_21040":57488,"_5":14474,"_27550":2552,"_2978":57489},[],"You will revoke the certificate of `device-042`, one of the 100 certificates issued by the CA, and then check that the CA's revocation list (CRL) includes it while the other certificates remain valid. The result is a revoked certificate in Lamassu and a downloaded CRL that names its serial number and reason.",{"_3496":2564,"_30262":2552,"_21040":57491,"_5":14474,"_27550":57456,"_2978":57492},[],"A CA with issued certificates and permission to change their status. The example uses `Acme Showcase Root CA` from Create your first CA, with the 100 client certificates `device-001` to `device-100`. A smaller set works the same way.",{"_3496":2565,"_30262":2552,"_21040":57494,"_5":14474,"_27550":57456,"_2978":57495},[],"The CA's public certificate in `ca.pem`, as saved in the first path.",{"_3496":2566,"_30262":2552,"_21040":57497,"_5":14474,"_27550":57456,"_2978":57498},[],"OpenSSL 3.x and `curl` on a computer that can reach the CRL endpoint.",{"_3496":2567,"_30262":2552,"_21040":57500,"_5":14474,"_27550":57456,"_2978":57501},[],"Only `CertificateHold` can be undone later. Any other reason is final, so use an evaluation certificate for this path. Before revoking in production, identify the consumers of the identity and prepare a replacement.",{"_3496":2568,"_30262":2552,"_21040":57503,"_5":14474,"_27550":57459,"_2978":57504},[],"Follow the interactive walkthrough. It opens the issuing CA, filters its **Issued Certificates** by Common Name to find `device-042` among the 100, and revokes it with the reason `KeyCompromise`.",{"_3496":2569,"_30262":2552,"_21040":57506,"_5":14474,"_27550":57459,"_2978":57507},[],"In the console, the steps are:",{"_3496":2570,"_30262":2552,"_21040":57509,"_5":14474,"_27550":57463,"_2978":57510},[],"Open **Certification Authorities**, select the issuing CA and go to **Issued Certificates**. Search by `Common Name` for `device-042`. The CA's own certificate is also listed in this tab; do not confuse the two.",{"_3496":2571,"_30262":2552,"_21040":57512,"_5":14474,"_27550":57467,"_2978":57513},[],"Open the **More actions** menu of the matching row and select **Revoke Certificate**. In the confirmation dialog, choose the **Revocation Reason** that describes the incident. This example uses `KeyCompromise`, because the device key is considered exposed. Use `CertificateHold` only for a reversible suspension.",{"_3496":2572,"_30262":2552,"_21040":57515,"_5":14474,"_27550":57471,"_2978":57516},[],"Select **Confirm Revocation**. The row changes to `REVOKED` and shows the reason and the revocation time. If you need to verify the result later, read the record again rather than trusting the dialog.",{"_3496":2573,"_30262":2552,"_21040":57518,"_5":14474,"_27550":57471,"_2978":57519},[],"Revocation does not delete the certificate or its key, and it does not close sessions that are already established. See Certificates for the reasons and their consequences.",{"_3496":2574,"_30262":2552,"_21040":57521,"_5":14474,"_27550":57475,"_2978":57522},[],"From the same **More actions** menu, select **Download PEM** and save the file as `device-042.crt`. Note its serial number and the CRL distribution point (CDP) it carries:",{"_3496":2575,"_30262":2552,"_21040":57524,"_5":14474,"_27550":57475,"_2978":57525},[],"The URL ends with the ID of the **issuing CA**, not the ID or serial of the certificate. Your serial number differs from the one shown.",{"_3496":2576,"_30262":2552,"_21040":57527,"_5":14474,"_27550":57478,"_2978":57528},[],"Lamassu regenerates the CA's CRL when a certificate is revoked, provided `regenerate_on_revoke` is enabled; it is by default. The endpoint is public and does not require authentication. Replace the URL with the CDP of your certificate and download the list:",{"_3496":2577,"_30262":2552,"_21040":57530,"_5":14474,"_27550":57478,"_2978":57531},[],"Check that the list is signed by your CA, is current and contains the serial number:",{"_3496":2578,"_30262":2552,"_21040":57533,"_5":14474,"_27550":57478,"_2978":57534},[],"Expect `verify OK`, the expected issuer, a `lastUpdate` not earlier than the revocation and an entry for the serial of `device-042` with reason `Key Compromise`; the list also names any other certificate previously revoked by this CA. A CRL with the same number as before the revocation means it has not been regenerated yet.",{"_3496":2579,"_30262":2552,"_21040":57536,"_5":14474,"_27550":57482,"_2978":57537},[],"`openssl verify` can apply the downloaded list to a certificate. The revoked certificate must be rejected and any other certificate from the same CA must still pass. For `device-001`, download its PEM in the same way and save it as `device-001.crt`:",{"_3496":2580,"_30262":2552,"_21040":57539,"_5":14474,"_27550":57482,"_2978":57540},[],"This check uses your local copy of the list: it does not download newer lists or prove that every client has refreshed its copy. For online status, see OCSP.",{"_3496":2581,"_30262":2552,"_21040":57542,"_5":14474,"_27550":57486,"_2978":54761},[],{"_3496":2582,"_30262":2552,"_21040":57544,"_5":14474,"_27550":57486,"_2978":57309},[],{"_3496":2583,"_30262":2552,"_21040":57546,"_5":14474,"_27550":57486,"_2978":57547},[],"**Revoke Certificate** is not available",{"_3496":2584,"_30262":2552,"_21040":57549,"_5":14474,"_27550":57486,"_2978":57550},[],"The certificate is already `REVOKED` for a final reason or is `EXPIRED`.",{"_3496":2585,"_30262":2552,"_21040":57552,"_5":14474,"_27550":57486,"_2978":57553},[],"The CRL download returns 404",{"_3496":2586,"_30262":2552,"_21040":57555,"_5":14474,"_27550":57486,"_2978":57556},[],"The ID in the URL is not the issuing CA's: use the CDP of the certificate.",{"_3496":2587,"_30262":2552,"_21040":57558,"_5":14474,"_27550":57486,"_2978":57559},[],"`verify OK` fails",{"_3496":2588,"_30262":2552,"_21040":57561,"_5":14474,"_27550":57486,"_2978":57562},[],"`ca.pem` is not the certificate of the CA that signed the list.",{"_3496":2589,"_30262":2552,"_21040":57564,"_5":14474,"_27550":57486,"_2978":57565},[],"The serial is not in the list",{"_3496":2590,"_30262":2552,"_21040":57567,"_5":14474,"_27550":57486,"_2978":57568},[],"The list was downloaded before the revocation, or its regeneration failed. See CRL settings errors.",{"_3496":2591,"_30262":2552,"_21040":57570,"_5":14474,"_27550":57486,"_2978":57571},[],"`device-001` is also rejected",{"_3496":2592,"_30262":2552,"_21040":57573,"_5":14474,"_27550":57486,"_2978":57574},[],"The certificate was revoked, or `ca.pem` does not match its issuer.",{"_3496":2593,"_30262":2552,"_21040":57576,"_5":14474,"_27550":57486,"_2978":57577},[],"<Card title=\"Manage certificates\" description=\"Reasons, holds and reactivation.\" href=\"/docs/platform/pki/certificates\" />",{"_3496":2594,"_30262":2552,"_21040":57579,"_5":14474,"_27550":57486,"_2978":57580},[],"<Card title=\"Revocation lists (CRL)\" description=\"Settings, regeneration and publication.\" href=\"/docs/platform/pki/crl\" />",{"_3496":2595,"_30262":2552,"_21040":57582,"_5":14474,"_27550":57486,"_2978":57583},[],"<Card title=\"Validate with OCSP\" description=\"Query the signed status of a certificate.\" href=\"/docs/platform/pki/ocsp\" />",{"_3496":2596,"_30262":2596,"_5":14825,"_2978":57585,"_30620":57586,"_21040":57587,"_27550":2596},"PKI troubleshooting",[49507,50975,54983,53558],[],{"_3496":2597,"_30262":2596,"_21040":57589,"_5":14474,"_27550":2596,"_2978":57590},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3496":2598,"_30262":2596,"_5":30617,"_21040":57592,"_27550":57593,"_2978":57594},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3496":2599,"_30262":2596,"_5":30617,"_21040":57596,"_27550":57597,"_2978":57598},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3496":2600,"_30262":2596,"_5":30617,"_21040":57600,"_27550":57601,"_2978":57602},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3496":2601,"_30262":2596,"_21040":57604,"_5":14474,"_27550":2596,"_2978":57605},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3496":2602,"_30262":2596,"_21040":57607,"_5":14474,"_27550":2596,"_2978":57608},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3496":2603,"_30262":2596,"_21040":57610,"_5":14474,"_27550":57593,"_2978":54609},[],{"_3496":2604,"_30262":2596,"_21040":57612,"_5":14474,"_27550":57593,"_2978":57613},[],"What to inspect",{"_3496":2605,"_30262":2596,"_21040":57615,"_5":14474,"_27550":57593,"_2978":49541},[],{"_3496":2606,"_30262":2596,"_21040":57617,"_5":14474,"_27550":57593,"_2978":53825},[],{"_3496":2607,"_30262":2596,"_21040":57619,"_5":14474,"_27550":57593,"_2978":57620},[],"Exists, is active and has usable dates.",{"_3496":2608,"_30262":2596,"_21040":57622,"_5":14474,"_27550":57593,"_2978":57623},[],"Authorities.",{"_3496":2609,"_30262":2596,"_21040":57625,"_5":14474,"_27550":57593,"_2978":57626},[],"Key",{"_3496":2610,"_30262":2596,"_21040":57628,"_5":14474,"_27550":57593,"_2978":57629},[],"The record has a usable private key and the engine can sign.",{"_3496":2611,"_30262":2596,"_21040":57631,"_5":14474,"_27550":57593,"_2978":57632},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3496":2612,"_30262":2596,"_21040":57634,"_5":14474,"_27550":57593,"_2978":57635},[],"CSR",{"_3496":2613,"_30262":2596,"_21040":57637,"_5":14474,"_27550":57593,"_2978":57638},[],"Correct PEM and verifiable signature.",{"_3496":2614,"_30262":2596,"_21040":57640,"_5":14474,"_27550":57593,"_2978":57641},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3496":2615,"_30262":2596,"_21040":57643,"_5":14474,"_27550":57593,"_2978":57644},[],"Profile",{"_3496":2616,"_30262":2596,"_21040":57646,"_5":14474,"_27550":57593,"_2978":57647},[],"Selected source, existing ID, allowed algorithm and size.",{"_3496":2617,"_30262":2596,"_21040":57649,"_5":14474,"_27550":57593,"_2978":57650},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3496":2618,"_30262":2596,"_21040":57652,"_5":14474,"_27550":57593,"_2978":54761},[],{"_3496":2619,"_30262":2596,"_21040":57654,"_5":14474,"_27550":57593,"_2978":57655},[],"Appropriate subject, SAN, usages and dates.",{"_3496":2620,"_30262":2596,"_21040":57657,"_5":14474,"_27550":57593,"_2978":57658},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3496":2621,"_30262":2596,"_21040":57660,"_5":14474,"_27550":57593,"_2978":57661},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3496":2622,"_30262":2596,"_21040":57663,"_5":14474,"_27550":57593,"_2978":57664},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3496":2623,"_30262":2596,"_21040":57666,"_5":14474,"_27550":57597,"_2978":57667},[],"Check each boundary independently:",{"_3496":2624,"_30262":2596,"_21040":57669,"_5":14474,"_27550":57597,"_2978":57670},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3496":2625,"_30262":2596,"_21040":57672,"_5":14474,"_27550":57597,"_2978":57673},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3496":2626,"_30262":2596,"_21040":57675,"_5":14474,"_27550":57597,"_2978":57676},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3496":2627,"_30262":2596,"_21040":57678,"_5":14474,"_27550":57597,"_2978":57679},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3496":2628,"_30262":2596,"_21040":57681,"_5":14474,"_27550":57597,"_2978":57682},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3496":2629,"_30262":2596,"_21040":57684,"_5":14474,"_27550":57597,"_2978":57685},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3496":2630,"_30262":2596,"_21040":57687,"_5":14474,"_27550":57601,"_2978":57688},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3496":2631,"_30262":2596,"_21040":57690,"_5":14474,"_27550":57601,"_2978":57691},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3496":2632,"_30262":2632,"_5":14825,"_2978":57693,"_30620":57694,"_21040":57695,"_27550":2632},"Security",[49507],[],{"_3496":2633,"_30262":2632,"_21040":57697,"_5":14474,"_27550":2632,"_2978":57698},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3496":2634,"_30262":2632,"_5":30617,"_21040":57700,"_27550":57701,"_2978":57702},[],"/docs/pr-preview/pr-61/security#report-a-vulnerability","Report a vulnerability",{"_3496":2635,"_30262":2632,"_5":30617,"_21040":57704,"_27550":57705,"_2978":57706},[],"/docs/pr-preview/pr-61/security#what-to-include-in-a-report","What to include in a report",{"_3496":2636,"_30262":2632,"_5":30617,"_21040":57708,"_27550":57709,"_2978":57710},[],"/docs/pr-preview/pr-61/security#supported-versions","Supported versions",{"_3496":2637,"_30262":2632,"_5":30617,"_21040":57712,"_27550":57713,"_2978":57714},[],"/docs/pr-preview/pr-61/security#responsible-disclosure","Responsible disclosure",{"_3496":2638,"_30262":2632,"_21040":57716,"_5":14474,"_27550":2632,"_2978":57717},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3496":2639,"_30262":2632,"_21040":57719,"_5":14474,"_27550":57701,"_2978":57720},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3496":2640,"_30262":2632,"_21040":57722,"_5":14474,"_27550":57701,"_2978":57723},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3496":2641,"_30262":2632,"_21040":57725,"_5":14474,"_27550":57701,"_2978":15098},[],{"_3496":2642,"_30262":2632,"_21040":57727,"_5":14474,"_27550":57701,"_2978":15038},[],{"_3496":2643,"_30262":2632,"_21040":57729,"_5":14474,"_27550":57701,"_2978":15085},[],{"_3496":2644,"_30262":2632,"_21040":57731,"_5":14474,"_27550":57701,"_2978":57732},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3496":2645,"_30262":2632,"_21040":57734,"_5":14474,"_27550":57701,"_2978":57735},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3496":2646,"_30262":2632,"_21040":57737,"_5":14474,"_27550":57705,"_2978":57738},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3496":2647,"_30262":2632,"_21040":57740,"_5":14474,"_27550":57705,"_2978":57741},[],"Do not include in the report:",{"_3496":2648,"_30262":2632,"_21040":57743,"_5":14474,"_27550":57705,"_2978":57744},[],"Credentials, tokens, or private keys",{"_3496":2649,"_30262":2632,"_21040":57746,"_5":14474,"_27550":57705,"_2978":57747},[],"Customer data or customer-identifiable information",{"_3496":2650,"_30262":2632,"_21040":57749,"_5":14474,"_27550":57705,"_2978":57750},[],"Confidential architecture or internal infrastructure details",{"_3496":2651,"_30262":2632,"_21040":57752,"_5":14474,"_27550":57709,"_2978":57753},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3496":2652,"_30262":2632,"_21040":57755,"_5":14474,"_27550":57709,"_2978":57756},[],"For upgrade guidance, see Upgrades.",{"_3496":2653,"_30262":2632,"_21040":57758,"_5":14474,"_27550":57713,"_2978":57759},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3496":2654,"_30262":2632,"_21040":57761,"_5":14474,"_27550":57713,"_2978":57762},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3496":2655,"_30262":2632,"_21040":57764,"_5":14474,"_27550":57713,"_2978":57765},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3496":2656,"_30262":2632,"_21040":57767,"_5":14474,"_27550":57713,"_2978":57768},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3496":2657,"_30262":2632,"_21040":57770,"_5":14474,"_27550":57713,"_2978":57771},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3496":2658,"_30262":2658,"_5":14825,"_2978":57773,"_30620":57774,"_21040":57776,"_27550":2658},"3.8.0 to 4.0.0",[49507,57775],"Upgrades",[],{"_3496":2659,"_30262":2658,"_21040":57778,"_5":14474,"_27550":2658,"_2978":57779},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3496":2660,"_30262":2658,"_5":30617,"_21040":57781,"_27550":57782,"_2978":57783},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3496":2661,"_30262":2658,"_5":30617,"_21040":57785,"_27550":57786,"_2978":57787},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3496":2662,"_30262":2658,"_5":30617,"_21040":57789,"_27550":57790,"_2978":57791},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3496":2663,"_30262":2658,"_5":30617,"_21040":57793,"_27550":57794,"_2978":57795},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3496":2664,"_30262":2658,"_5":30617,"_21040":57797,"_27550":57798,"_2978":57799},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3496":2665,"_30262":2658,"_5":30617,"_21040":57801,"_27550":57802,"_2978":57803},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3496":2666,"_30262":2658,"_5":30617,"_21040":57805,"_27550":57806,"_2978":57807},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3496":2667,"_30262":2658,"_5":30617,"_21040":57809,"_27550":57810,"_2978":57811},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3496":2668,"_30262":2658,"_5":30617,"_21040":57813,"_27550":57814,"_2978":57815},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3496":2669,"_30262":2658,"_5":30617,"_21040":57817,"_27550":57818,"_2978":57819},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3496":2670,"_30262":2658,"_5":30617,"_21040":57821,"_27550":57822,"_2978":57823},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3496":2671,"_30262":2658,"_5":30617,"_21040":57825,"_27550":57826,"_2978":57827},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3496":2672,"_30262":2658,"_5":30617,"_21040":57829,"_27550":57830,"_2978":57831},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3496":2673,"_30262":2658,"_5":30617,"_21040":57833,"_27550":57834,"_2978":57835},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3496":2674,"_30262":2658,"_5":30617,"_21040":57837,"_27550":57838,"_2978":57839},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3496":2675,"_30262":2658,"_5":30617,"_21040":57841,"_27550":57842,"_2978":57843},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3496":2676,"_30262":2658,"_5":30617,"_21040":57845,"_27550":57846,"_2978":57847},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3496":2677,"_30262":2658,"_5":30617,"_21040":57849,"_27550":57850,"_2978":57851},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3496":2678,"_30262":2658,"_5":30617,"_21040":57853,"_27550":57854,"_2978":57855},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3496":2679,"_30262":2658,"_5":30617,"_21040":57857,"_27550":57858,"_2978":57859},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3496":2680,"_30262":2658,"_5":30617,"_21040":57861,"_27550":57862,"_2978":57863},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3496":2681,"_30262":2658,"_5":30617,"_21040":57865,"_27550":57866,"_2978":57867},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3496":2682,"_30262":2658,"_5":30617,"_21040":57869,"_27550":57870,"_2978":57871},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3496":2683,"_30262":2658,"_5":30617,"_21040":57873,"_27550":57874,"_2978":57875},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3496":2684,"_30262":2658,"_5":30617,"_21040":57877,"_27550":57878,"_2978":57879},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3496":2685,"_30262":2658,"_5":30617,"_21040":57881,"_27550":57882,"_2978":57883},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3496":2686,"_30262":2658,"_5":30617,"_21040":57885,"_27550":57886,"_2978":57887},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3496":2687,"_30262":2658,"_5":30617,"_21040":57889,"_27550":57890,"_2978":57891},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3496":2688,"_30262":2658,"_5":30617,"_21040":57893,"_27550":57894,"_2978":57895},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3496":2689,"_30262":2658,"_5":30617,"_21040":57897,"_27550":57898,"_2978":57899},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3496":2690,"_30262":2658,"_5":30617,"_21040":57901,"_27550":57902,"_2978":57903},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3496":2691,"_30262":2658,"_5":30617,"_21040":57905,"_27550":57906,"_2978":57907},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3496":2692,"_30262":2658,"_5":30617,"_21040":57909,"_27550":57910,"_2978":57911},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3496":2693,"_30262":2658,"_5":30617,"_21040":57913,"_27550":57914,"_2978":57915},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3496":2694,"_30262":2658,"_5":30617,"_21040":57917,"_27550":57918,"_2978":57919},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3496":2695,"_30262":2658,"_5":30617,"_21040":57921,"_27550":57922,"_2978":57923},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3496":2696,"_30262":2658,"_5":30617,"_21040":57925,"_27550":57926,"_2978":57927},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3496":2697,"_30262":2658,"_5":30617,"_21040":57929,"_27550":57930,"_2978":57931},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3496":2698,"_30262":2658,"_5":30617,"_21040":57933,"_27550":57934,"_2978":57935},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3496":2699,"_30262":2658,"_5":30617,"_21040":57937,"_27550":57938,"_2978":57939},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3496":2700,"_30262":2658,"_5":30617,"_21040":57941,"_27550":57942,"_2978":53558},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3496":2701,"_30262":2658,"_5":30617,"_21040":57944,"_27550":57945,"_2978":57946},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3496":2702,"_30262":2658,"_5":30617,"_21040":57948,"_27550":57949,"_2978":57950},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3496":2703,"_30262":2658,"_21040":57952,"_5":14474,"_27550":2658,"_2978":57953},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3496":2704,"_30262":2658,"_21040":57955,"_5":14474,"_27550":2658,"_2978":57956},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3496":2705,"_30262":2658,"_21040":57958,"_5":14474,"_27550":2658,"_2978":57959},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3496":2706,"_30262":2658,"_21040":57961,"_5":14474,"_27550":2658,"_2978":57962},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3496":2707,"_30262":2658,"_21040":57964,"_5":14474,"_27550":2658,"_2978":57965},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3496":2708,"_30262":2658,"_21040":57967,"_5":14474,"_27550":2658,"_2978":57968},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3496":2709,"_30262":2658,"_21040":57970,"_5":14474,"_27550":2658,"_2978":57971},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3496":2710,"_30262":2658,"_21040":57973,"_5":14474,"_27550":57786,"_2978":57974},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3496":2711,"_30262":2658,"_21040":57976,"_5":14474,"_27550":57786,"_2978":57977},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3496":2712,"_30262":2658,"_21040":57979,"_5":14474,"_27550":57790,"_2978":57980},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3496":2713,"_30262":2658,"_21040":57982,"_5":14474,"_27550":57790,"_2978":57983},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3496":2714,"_30262":2658,"_21040":57985,"_5":14474,"_27550":57794,"_2978":57986},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3496":2715,"_30262":2658,"_21040":57988,"_5":14474,"_27550":57798,"_2978":57989},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3496":2716,"_30262":2658,"_21040":57991,"_5":14474,"_27550":57798,"_2978":57992},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3496":2717,"_30262":2658,"_21040":57994,"_5":14474,"_27550":57798,"_2978":57995},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3496":2718,"_30262":2658,"_21040":57997,"_5":14474,"_27550":57798,"_2978":57998},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3496":2719,"_30262":2658,"_21040":58000,"_5":14474,"_27550":57798,"_2978":58001},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3496":2720,"_30262":2658,"_21040":58003,"_5":14474,"_27550":57802,"_2978":58004},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3496":2721,"_30262":2658,"_21040":58006,"_5":14474,"_27550":57802,"_2978":58007},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3496":2722,"_30262":2658,"_21040":58009,"_5":14474,"_27550":57802,"_2978":58010},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3496":2723,"_30262":2658,"_21040":58012,"_5":14474,"_27550":57802,"_2978":58013},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3496":2724,"_30262":2658,"_21040":58015,"_5":14474,"_27550":57802,"_2978":58016},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3496":2725,"_30262":2658,"_21040":58018,"_5":14474,"_27550":57802,"_2978":58019},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3496":2726,"_30262":2658,"_21040":58021,"_5":14474,"_27550":57806,"_2978":58022},[],"Change",{"_3496":2727,"_30262":2658,"_21040":58024,"_5":14474,"_27550":57806,"_2978":58025},[],"Who is affected",{"_3496":2728,"_30262":2658,"_21040":58027,"_5":14474,"_27550":57806,"_2978":58028},[],"Severity",{"_3496":2729,"_30262":2658,"_21040":58030,"_5":14474,"_27550":57806,"_2978":56410},[],{"_3496":2730,"_30262":2658,"_21040":58032,"_5":14474,"_27550":57806,"_2978":57815},[],{"_3496":2731,"_30262":2658,"_21040":58034,"_5":14474,"_27550":57806,"_2978":58035},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3496":2732,"_30262":2658,"_21040":58037,"_5":14474,"_27550":57806,"_2978":58038},[],"High: KMS and VA start on empty volumes",{"_3496":2733,"_30262":2658,"_21040":58040,"_5":14474,"_27550":57806,"_2978":58041},[],"Copy the data into the new volumes",{"_3496":2734,"_30262":2658,"_21040":58043,"_5":14474,"_27550":57806,"_2978":57819},[],{"_3496":2735,"_30262":2658,"_21040":58045,"_5":14474,"_27550":57806,"_2978":58046},[],"Every Helm release",{"_3496":2736,"_30262":2658,"_21040":58048,"_5":14474,"_27550":57806,"_2978":58049},[],"High: `helm upgrade` fails",{"_3496":2737,"_30262":2658,"_21040":58051,"_5":14474,"_27550":57806,"_2978":58052},[],"Remove or rename legacy keys",{"_3496":2738,"_30262":2658,"_21040":58054,"_5":14474,"_27550":57806,"_2978":57823},[],{"_3496":2739,"_30262":2658,"_21040":58056,"_5":14474,"_27550":57806,"_2978":58057},[],"Every deployment",{"_3496":2740,"_30262":2658,"_21040":58059,"_5":14474,"_27550":57806,"_2978":58060},[],"High: without a bootstrap principal there is no administrator",{"_3496":2741,"_30262":2658,"_21040":58062,"_5":14474,"_27550":57806,"_2978":58063},[],"Configure `services.authz`",{"_3496":2742,"_30262":2658,"_21040":58065,"_5":14474,"_27550":57806,"_2978":57827},[],{"_3496":2743,"_30262":2658,"_21040":58067,"_5":14474,"_27550":57806,"_2978":58046},[],{"_3496":2744,"_30262":2658,"_21040":58069,"_5":14474,"_27550":57806,"_2978":58070},[],"High: `helm upgrade` fails on the old keys",{"_3496":2745,"_30262":2658,"_21040":58072,"_5":14474,"_27550":57806,"_2978":58073},[],"Move JWKS and roles into `services.authz`",{"_3496":2746,"_30262":2658,"_21040":58075,"_5":14474,"_27550":57806,"_2978":57847},[],{"_3496":2747,"_30262":2658,"_21040":58077,"_5":14474,"_27550":57806,"_2978":58078},[],"3.8.0 deployments with per-service databases",{"_3496":2748,"_30262":2658,"_21040":58080,"_5":14474,"_27550":57806,"_2978":58081},[],"High: services find no data, or a migration aborts",{"_3496":2749,"_30262":2658,"_21040":58083,"_5":14474,"_27550":57806,"_2978":58084},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3496":2750,"_30262":2658,"_21040":58086,"_5":14474,"_27550":57806,"_2978":57851},[],{"_3496":2751,"_30262":2658,"_21040":58088,"_5":14474,"_27550":57806,"_2978":58089},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3496":2752,"_30262":2658,"_21040":58091,"_5":14474,"_27550":57806,"_2978":58092},[],"High: the backend no longer starts with them",{"_3496":2753,"_30262":2658,"_21040":58094,"_5":14474,"_27550":57806,"_2978":58095},[],"Move to PostgreSQL before upgrading",{"_3496":2754,"_30262":2658,"_21040":58097,"_5":14474,"_27550":57806,"_2978":57895},[],{"_3496":2755,"_30262":2658,"_21040":58099,"_5":14474,"_27550":57806,"_2978":58100},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3496":2756,"_30262":2658,"_21040":58102,"_5":14474,"_27550":57806,"_2978":58103},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3496":2757,"_30262":2658,"_21040":58105,"_5":14474,"_27550":57806,"_2978":58106},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3496":2758,"_30262":2658,"_21040":58108,"_5":14474,"_27550":57806,"_2978":58109},[],"Webhooks with file references",{"_3496":2759,"_30262":2658,"_21040":58111,"_5":14474,"_27550":57806,"_2978":58112},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3496":2760,"_30262":2658,"_21040":58114,"_5":14474,"_27550":57806,"_2978":58115},[],"High: enrollments calling the webhook fail",{"_3496":2761,"_30262":2658,"_21040":58117,"_5":14474,"_27550":57806,"_2978":58118},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3496":2762,"_30262":2658,"_21040":58120,"_5":14474,"_27550":57806,"_2978":57831},[],{"_3496":2763,"_30262":2658,"_21040":58122,"_5":14474,"_27550":57806,"_2978":58123},[],"Releases with per-service identity overrides or mounted key material",{"_3496":2764,"_30262":2658,"_21040":58125,"_5":14474,"_27550":57806,"_2978":58126},[],"Medium: services cannot read their files",{"_3496":2765,"_30262":2658,"_21040":58128,"_5":14474,"_27550":57806,"_2978":58129},[],"Remove the overrides and fix volume ownership",{"_3496":2766,"_30262":2658,"_21040":58131,"_5":14474,"_27550":57806,"_2978":57835},[],{"_3496":2767,"_30262":2658,"_21040":58133,"_5":14474,"_27550":57806,"_2978":58134},[],"Releases that set `amqp.tls`",{"_3496":2768,"_30262":2658,"_21040":58136,"_5":14474,"_27550":57806,"_2978":58137},[],"Medium: clients connect to the wrong port",{"_3496":2769,"_30262":2658,"_21040":58139,"_5":14474,"_27550":57806,"_2978":58140},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3496":2770,"_30262":2658,"_21040":58142,"_5":14474,"_27550":57806,"_2978":57855},[],{"_3496":2771,"_30262":2658,"_21040":58144,"_5":14474,"_27550":57806,"_2978":58145},[],"Installations whose CA keys predate the KMS",{"_3496":2772,"_30262":2658,"_21040":58147,"_5":14474,"_27550":57806,"_2978":58148},[],"Medium: CA keys stay unmanaged",{"_3496":2773,"_30262":2658,"_21040":58150,"_5":14474,"_27550":57806,"_2978":58151},[],"Run the CA-to-KMS migration",{"_3496":2774,"_30262":2658,"_21040":58153,"_5":14474,"_27550":57806,"_2978":58154},[],"Receiver certificate verification",{"_3496":2775,"_30262":2658,"_21040":58156,"_5":14474,"_27550":57806,"_2978":58157},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3496":2776,"_30262":2658,"_21040":58159,"_5":14474,"_27550":57806,"_2978":58160},[],"Medium: credentials go to an unverified receiver",{"_3496":2777,"_30262":2658,"_21040":58162,"_5":14474,"_27550":57806,"_2978":58163},[],"Set `insecure_skip_verify` to `false`",{"_3496":2778,"_30262":2658,"_21040":58165,"_5":14474,"_27550":57806,"_2978":57871},[],{"_3496":2779,"_30262":2658,"_21040":58167,"_5":14474,"_27550":57806,"_2978":58168},[],"Scripts and consoles that edit DMSs through the API",{"_3496":2780,"_30262":2658,"_21040":58170,"_5":14474,"_27550":57806,"_2978":58171},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3496":2781,"_30262":2658,"_21040":58173,"_5":14474,"_27550":57806,"_2978":58174},[],"Read the DMS before editing and use the new field",{"_3496":2782,"_30262":2658,"_21040":58176,"_5":14474,"_27550":57806,"_2978":57891},[],{"_3496":2783,"_30262":2658,"_21040":58178,"_5":14474,"_27550":57806,"_2978":58179},[],"Clients that create or update CRL settings through the API",{"_3496":2784,"_30262":2658,"_21040":58181,"_5":14474,"_27550":57806,"_2978":58182},[],"Medium: requests with the old field return an error",{"_3496":2785,"_30262":2658,"_21040":58184,"_5":14474,"_27550":57806,"_2978":58185},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3496":2786,"_30262":2658,"_21040":58187,"_5":14474,"_27550":57806,"_2978":57899},[],{"_3496":2787,"_30262":2658,"_21040":58189,"_5":14474,"_27550":57806,"_2978":58190},[],"Alert subscriptions and consumers of the VA events",{"_3496":2788,"_30262":2658,"_21040":58192,"_5":14474,"_27550":57806,"_2978":58193},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3496":2789,"_30262":2658,"_21040":58195,"_5":14474,"_27550":57806,"_2978":58196},[],"Review conditions filtering on the old event payload or subject",{"_3496":2790,"_30262":2658,"_21040":58198,"_5":14474,"_27550":57806,"_2978":57887},[],{"_3496":2791,"_30262":2658,"_21040":58200,"_5":14474,"_27550":57806,"_2978":58201},[],"Consumers that read the device `events` field",{"_3496":2792,"_30262":2658,"_21040":58203,"_5":14474,"_27550":57806,"_2978":58204},[],"Medium: the field disappears",{"_3496":2793,"_30262":2658,"_21040":58206,"_5":14474,"_27550":57806,"_2978":58207},[],"Use the new event endpoints",{"_3496":2794,"_30262":2658,"_21040":58209,"_5":14474,"_27550":57806,"_2978":57907},[],{"_3496":2795,"_30262":2658,"_21040":58211,"_5":14474,"_27550":57806,"_2978":58212},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3496":2796,"_30262":2658,"_21040":58214,"_5":14474,"_27550":57806,"_2978":58215},[],"Medium: the VA migration aborts",{"_3496":2797,"_30262":2658,"_21040":58217,"_5":14474,"_27550":57806,"_2978":58218},[],"Fix the affected roles before upgrading",{"_3496":2798,"_30262":2658,"_21040":58220,"_5":14474,"_27550":57806,"_2978":57839},[],{"_3496":2799,"_30262":2658,"_21040":58222,"_5":14474,"_27550":57806,"_2978":58223},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3496":2800,"_30262":2658,"_21040":58225,"_5":14474,"_27550":57806,"_2978":58226},[],"Low to medium: validation errors or changed defaults",{"_3496":2801,"_30262":2658,"_21040":58228,"_5":14474,"_27550":57806,"_2978":58229},[],"Update the values file",{"_3496":2802,"_30262":2658,"_21040":58231,"_5":14474,"_27550":57806,"_2978":57879},[],{"_3496":2803,"_30262":2658,"_21040":58233,"_5":14474,"_27550":57806,"_2978":58234},[],"Clients that send the DMS ID in the update body",{"_3496":2804,"_30262":2658,"_21040":58236,"_5":14474,"_27550":57806,"_2978":58237},[],"Low: the ID in the URL wins",{"_3496":2805,"_30262":2658,"_21040":58239,"_5":14474,"_27550":57806,"_2978":58240},[],"Send the ID in the URL",{"_3496":2806,"_30262":2658,"_21040":58242,"_5":14474,"_27550":57806,"_2978":57903},[],{"_3496":2807,"_30262":2658,"_21040":58244,"_5":14474,"_27550":57806,"_2978":58245},[],"Clients that send an `id` when creating or importing CAs",{"_3496":2808,"_30262":2658,"_21040":58247,"_5":14474,"_27550":57806,"_2978":58248},[],"Low: the ID in the body is ignored, and the field is removed",{"_3496":2809,"_30262":2658,"_21040":58250,"_5":14474,"_27550":57806,"_2978":58251},[],"Let the backend assign the ID and use the returned one",{"_3496":2810,"_30262":2658,"_21040":58253,"_5":14474,"_27550":57806,"_2978":57883},[],{"_3496":2811,"_30262":2658,"_21040":58255,"_5":14474,"_27550":57806,"_2978":58256},[],"Consumers that match on certificate `type`",{"_3496":2812,"_30262":2658,"_21040":58258,"_5":14474,"_27550":57806,"_2978":58259},[],"Low: two values are renamed",{"_3496":2813,"_30262":2658,"_21040":58261,"_5":14474,"_27550":57806,"_2978":58262},[],"Adapt consumers",{"_3496":2814,"_30262":2658,"_21040":58264,"_5":14474,"_27550":57806,"_2978":57875},[],{"_3496":2815,"_30262":2658,"_21040":58266,"_5":14474,"_27550":57806,"_2978":58267},[],"Any DMS",{"_3496":2816,"_30262":2658,"_21040":58269,"_5":14474,"_27550":57806,"_2978":58270},[],"Low: informational",{"_3496":2817,"_30262":2658,"_21040":58272,"_5":14474,"_27550":57806,"_2978":58273},[],"Read both blocks before editing",{"_3496":2818,"_30262":2658,"_21040":58275,"_5":14474,"_27550":57814,"_2978":58276},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3496":2819,"_30262":2658,"_21040":58278,"_5":14474,"_27550":57814,"_2978":58279},[],"Step 4 of the migration guide copies the data.",{"_3496":2820,"_30262":2658,"_21040":58281,"_5":14474,"_27550":57818,"_2978":58282},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3496":2821,"_30262":2658,"_21040":58284,"_5":14474,"_27550":57822,"_2978":58285},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3496":2822,"_30262":2658,"_21040":58287,"_5":14474,"_27550":57826,"_2978":58288},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3496":2823,"_30262":2658,"_21040":58290,"_5":14474,"_27550":57830,"_2978":58291},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3496":2824,"_30262":2658,"_21040":58293,"_5":14474,"_27550":57830,"_2978":58294},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3496":2825,"_30262":2658,"_21040":58296,"_5":14474,"_27550":57834,"_2978":58297},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3496":2826,"_30262":2658,"_21040":58299,"_5":14474,"_27550":57838,"_2978":58300},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3496":2827,"_30262":2658,"_21040":58302,"_5":14474,"_27550":57838,"_2978":58303},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3496":2828,"_30262":2658,"_21040":58305,"_5":14474,"_27550":57838,"_2978":58306},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3496":2829,"_30262":2658,"_21040":58308,"_5":14474,"_27550":57838,"_2978":58309},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3496":2830,"_30262":2658,"_21040":58311,"_5":14474,"_27550":57838,"_2978":58312},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3496":2831,"_30262":2658,"_21040":58314,"_5":14474,"_27550":57838,"_2978":58315},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3496":2832,"_30262":2658,"_21040":58317,"_5":14474,"_27550":57846,"_2978":58318},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3496":2833,"_30262":2658,"_21040":58320,"_5":14474,"_27550":57846,"_2978":58321},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3496":2834,"_30262":2658,"_21040":58323,"_5":14474,"_27550":57846,"_2978":58324},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3496":2835,"_30262":2658,"_21040":58326,"_5":14474,"_27550":57846,"_2978":58327},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3496":2836,"_30262":2658,"_21040":58329,"_5":14474,"_27550":57846,"_2978":58330},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3496":2837,"_30262":2658,"_21040":58332,"_5":14474,"_27550":57850,"_2978":58333},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3496":2838,"_30262":2658,"_21040":58335,"_5":14474,"_27550":57854,"_2978":58336},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3496":2839,"_30262":2658,"_21040":58338,"_5":14474,"_27550":57854,"_2978":58339},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3496":2840,"_30262":2658,"_21040":58341,"_5":14474,"_27550":57854,"_2978":58342},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3496":2841,"_30262":2658,"_21040":58344,"_5":14474,"_27550":57854,"_2978":58345},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3496":2842,"_30262":2658,"_21040":58347,"_5":14474,"_27550":57854,"_2978":58348},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3496":2843,"_30262":2658,"_21040":58350,"_5":14474,"_27550":57854,"_2978":58351},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3496":2844,"_30262":2658,"_21040":58353,"_5":14474,"_27550":57854,"_2978":58354},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3496":2845,"_30262":2658,"_21040":58356,"_5":14474,"_27550":57854,"_2978":58357},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3496":2846,"_30262":2658,"_21040":58359,"_5":14474,"_27550":57858,"_2978":58360},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3496":2847,"_30262":2658,"_21040":58362,"_5":14474,"_27550":57866,"_2978":58363},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3496":2848,"_30262":2658,"_21040":58365,"_5":14474,"_27550":57866,"_2978":58366},[],"Field in 3.8.0",{"_3496":2849,"_30262":2658,"_21040":58368,"_5":14474,"_27550":57866,"_2978":58369},[],"Field in 4.0.0",{"_3496":2850,"_30262":2658,"_21040":58371,"_5":14474,"_27550":57866,"_2978":58372},[],"`validate_server_cert`",{"_3496":2851,"_30262":2658,"_21040":58374,"_5":14474,"_27550":57866,"_2978":58375},[],"`insecure_skip_verify` (value negated)",{"_3496":2852,"_30262":2658,"_21040":58377,"_5":14474,"_27550":57866,"_2978":58378},[],"`oidc`",{"_3496":2853,"_30262":2658,"_21040":58380,"_5":14474,"_27550":57866,"_2978":58381},[],"`jwt_options`",{"_3496":2854,"_30262":2658,"_21040":58383,"_5":14474,"_27550":57866,"_2978":58384},[],"`apikey`",{"_3496":2855,"_30262":2658,"_21040":58386,"_5":14474,"_27550":57866,"_2978":58387},[],"`apikey_options`",{"_3496":2856,"_30262":2658,"_21040":58389,"_5":14474,"_27550":57866,"_2978":58390},[],"`mtls`",{"_3496":2857,"_30262":2658,"_21040":58392,"_5":14474,"_27550":57866,"_2978":58393},[],"`mtls_options`",{"_3496":2858,"_30262":2658,"_21040":58395,"_5":14474,"_27550":57866,"_2978":58396},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3496":2859,"_30262":2658,"_21040":58398,"_5":14474,"_27550":57866,"_2978":58399},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3496":2860,"_30262":2658,"_21040":58401,"_5":14474,"_27550":57866,"_2978":58402},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3496":2861,"_30262":2658,"_21040":58404,"_5":14474,"_27550":57870,"_2978":58405},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3496":2862,"_30262":2658,"_21040":58407,"_5":14474,"_27550":57870,"_2978":58408},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3496":2863,"_30262":2658,"_21040":58410,"_5":14474,"_27550":57870,"_2978":58411},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3496":2864,"_30262":2658,"_21040":58413,"_5":14474,"_27550":57874,"_2978":58414},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3496":2865,"_30262":2658,"_21040":58416,"_5":14474,"_27550":57878,"_2978":58417},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3496":2866,"_30262":2658,"_21040":58419,"_5":14474,"_27550":57882,"_2978":58420},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3496":2867,"_30262":2658,"_21040":58422,"_5":14474,"_27550":57886,"_2978":58423},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3496":2868,"_30262":2658,"_21040":58425,"_5":14474,"_27550":57886,"_2978":58426},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3496":2869,"_30262":2658,"_21040":58428,"_5":14474,"_27550":57886,"_2978":58429},[],"`POST /v1/devices/:id/events` creates an event.",{"_3496":2870,"_30262":2658,"_21040":58431,"_5":14474,"_27550":57886,"_2978":58432},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3496":2871,"_30262":2658,"_21040":58434,"_5":14474,"_27550":57890,"_2978":58435},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3496":2872,"_30262":2658,"_21040":58437,"_5":14474,"_27550":57894,"_2978":58438},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3496":2873,"_30262":2658,"_21040":58440,"_5":14474,"_27550":57894,"_2978":58441},[],"Route",{"_3496":2874,"_30262":2658,"_21040":58443,"_5":14474,"_27550":57894,"_2978":52745},[],{"_3496":2875,"_30262":2658,"_21040":58445,"_5":14474,"_27550":57894,"_2978":58446},[],"`GET /v1/crl-settings`",{"_3496":2876,"_30262":2658,"_21040":58448,"_5":14474,"_27550":57894,"_2978":58449},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3496":2877,"_30262":2658,"_21040":58451,"_5":14474,"_27550":57894,"_2978":58452},[],"`GET /v1/crl-settings/{ca-id}`",{"_3496":2878,"_30262":2658,"_21040":58454,"_5":14474,"_27550":57894,"_2978":58455},[],"Reads the settings of a CA.",{"_3496":2879,"_30262":2658,"_21040":58457,"_5":14474,"_27550":57894,"_2978":58458},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3496":2880,"_30262":2658,"_21040":58460,"_5":14474,"_27550":57894,"_2978":58461},[],"Replaces `crl_options`.",{"_3496":2881,"_30262":2658,"_21040":58463,"_5":14474,"_27550":57894,"_2978":58464},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3496":2882,"_30262":2658,"_21040":58466,"_5":14474,"_27550":57894,"_2978":58467},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3496":2883,"_30262":2658,"_21040":58469,"_5":14474,"_27550":57894,"_2978":58470},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3496":2884,"_30262":2658,"_21040":58472,"_5":14474,"_27550":57894,"_2978":58473},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3496":2885,"_30262":2658,"_21040":58475,"_5":14474,"_27550":57894,"_2978":58476},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3496":2886,"_30262":2658,"_21040":58478,"_5":14474,"_27550":57894,"_2978":58479},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3496":2887,"_30262":2658,"_21040":58481,"_5":14474,"_27550":57894,"_2978":58482},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3496":2888,"_30262":2658,"_21040":58484,"_5":14474,"_27550":57894,"_2978":58485},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3496":2889,"_30262":2658,"_21040":58487,"_5":14474,"_27550":57894,"_2978":58488},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3496":2890,"_30262":2658,"_21040":58490,"_5":14474,"_27550":57894,"_2978":58491},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3496":2891,"_30262":2658,"_21040":58493,"_5":14474,"_27550":57894,"_2978":58494},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3496":2892,"_30262":2658,"_21040":58496,"_5":14474,"_27550":57898,"_2978":58497},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3496":2893,"_30262":2658,"_21040":58499,"_5":14474,"_27550":57902,"_2978":58500},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3496":2894,"_30262":2658,"_21040":58502,"_5":14474,"_27550":57906,"_2978":58503},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3496":2895,"_30262":2658,"_21040":58505,"_5":14474,"_27550":57910,"_2978":58506},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3496":2896,"_30262":2658,"_21040":58508,"_5":14474,"_27550":57914,"_2978":58509},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3496":2897,"_30262":2658,"_21040":58511,"_5":14474,"_27550":57914,"_2978":58512},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3496":2898,"_30262":2658,"_21040":58514,"_5":14474,"_27550":57914,"_2978":58515},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3496":2899,"_30262":2658,"_21040":58517,"_5":14474,"_27550":57914,"_2978":58518},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3496":2900,"_30262":2658,"_21040":58520,"_5":14474,"_27550":57914,"_2978":58521},[],"Record the names of your local-storage PVCs:",{"_3496":2901,"_30262":2658,"_21040":58523,"_5":14474,"_27550":57914,"_2978":58524},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3496":2902,"_30262":2658,"_21040":58526,"_5":14474,"_27550":57918,"_2978":58527},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3496":2903,"_30262":2658,"_21040":58529,"_5":14474,"_27550":57918,"_2978":58530},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3496":2904,"_30262":2658,"_21040":58532,"_5":14474,"_27550":57918,"_2978":58533},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3496":2905,"_30262":2658,"_21040":58535,"_5":14474,"_27550":57918,"_2978":58536},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3496":2906,"_30262":2658,"_21040":58538,"_5":14474,"_27550":57918,"_2978":58539},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3496":2907,"_30262":2658,"_21040":58541,"_5":14474,"_27550":57922,"_2978":58542},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3496":2908,"_30262":2658,"_21040":58544,"_5":14474,"_27550":57922,"_2978":58545},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3496":2909,"_30262":2658,"_21040":58547,"_5":14474,"_27550":57922,"_2978":58548},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3496":2910,"_30262":2658,"_21040":58550,"_5":14474,"_27550":57922,"_2978":58551},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3496":2911,"_30262":2658,"_21040":58553,"_5":14474,"_27550":57922,"_2978":58554},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3496":2912,"_30262":2658,"_21040":58556,"_5":14474,"_27550":57922,"_2978":58557},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3496":2913,"_30262":2658,"_21040":58559,"_5":14474,"_27550":57922,"_2978":58560},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3496":2914,"_30262":2658,"_21040":58562,"_5":14474,"_27550":57922,"_2978":58563},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3496":2915,"_30262":2658,"_21040":58565,"_5":14474,"_27550":57922,"_2978":58566},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3496":2916,"_30262":2658,"_21040":58568,"_5":14474,"_27550":57922,"_2978":58569},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3496":2917,"_30262":2658,"_21040":58571,"_5":14474,"_27550":57922,"_2978":58572},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3496":2918,"_30262":2658,"_21040":58574,"_5":14474,"_27550":57922,"_2978":58575},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3496":2919,"_30262":2658,"_21040":58577,"_5":14474,"_27550":57926,"_2978":58578},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3496":2920,"_30262":2658,"_21040":58580,"_5":14474,"_27550":57926,"_2978":58581},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3496":2921,"_30262":2658,"_21040":58583,"_5":14474,"_27550":57930,"_2978":58584},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3496":2922,"_30262":2658,"_21040":58586,"_5":14474,"_27550":57930,"_2978":58587},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3496":2923,"_30262":2658,"_21040":58589,"_5":14474,"_27550":57930,"_2978":58590},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3496":2924,"_30262":2658,"_21040":58592,"_5":14474,"_27550":57930,"_2978":58593},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3496":2925,"_30262":2658,"_21040":58595,"_5":14474,"_27550":57930,"_2978":58596},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3496":2926,"_30262":2658,"_21040":58598,"_5":14474,"_27550":57930,"_2978":58599},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3496":2927,"_30262":2658,"_21040":58601,"_5":14474,"_27550":57930,"_2978":58602},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3496":2928,"_30262":2658,"_21040":58604,"_5":14474,"_27550":57930,"_2978":58605},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3496":2929,"_30262":2658,"_21040":58607,"_5":14474,"_27550":57930,"_2978":58608},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3496":2930,"_30262":2658,"_21040":58610,"_5":14474,"_27550":57930,"_2978":58611},[],"**Remove the helper and restore the recorded replica counts:**",{"_3496":2931,"_30262":2658,"_21040":58613,"_5":14474,"_27550":57930,"_2978":58614},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3496":2932,"_30262":2658,"_21040":58616,"_5":14474,"_27550":57934,"_2978":58617},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3496":2933,"_30262":2658,"_21040":58619,"_5":14474,"_27550":57934,"_2978":58620},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3496":2934,"_30262":2658,"_21040":58622,"_5":14474,"_27550":57938,"_2978":58623},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3496":2935,"_30262":2658,"_21040":58625,"_5":14474,"_27550":57938,"_2978":58626},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3496":2936,"_30262":2658,"_21040":58628,"_5":14474,"_27550":57938,"_2978":58629},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3496":2937,"_30262":2658,"_21040":58631,"_5":14474,"_27550":57938,"_2978":58632},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3496":2938,"_30262":2658,"_21040":58634,"_5":14474,"_27550":57938,"_2978":58635},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3496":2939,"_30262":2658,"_21040":58637,"_5":14474,"_27550":57938,"_2978":58638},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3496":2940,"_30262":2658,"_21040":58640,"_5":14474,"_27550":57938,"_2978":58641},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3496":2941,"_30262":2658,"_21040":58643,"_5":14474,"_27550":57938,"_2978":58644},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3496":2942,"_30262":2658,"_21040":58646,"_5":14474,"_27550":57942,"_2978":58647},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3496":2943,"_30262":2658,"_21040":58649,"_5":14474,"_27550":57942,"_2978":58650},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3496":2944,"_30262":2658,"_21040":58652,"_5":14474,"_27550":57942,"_2978":58653},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3496":2945,"_30262":2658,"_21040":58655,"_5":14474,"_27550":57942,"_2978":58656},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3496":2946,"_30262":2658,"_21040":58658,"_5":14474,"_27550":57942,"_2978":58659},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3496":2947,"_30262":2658,"_21040":58661,"_5":14474,"_27550":57942,"_2978":58662},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3496":2948,"_30262":2658,"_21040":58664,"_5":14474,"_27550":57942,"_2978":58665},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3496":2949,"_30262":2658,"_21040":58667,"_5":14474,"_27550":57942,"_2978":58668},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3496":2950,"_30262":2658,"_21040":58670,"_5":14474,"_27550":57942,"_2978":58671},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3496":2951,"_30262":2658,"_21040":58673,"_5":14474,"_27550":57942,"_2978":58674},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3496":2952,"_30262":2658,"_21040":58676,"_5":14474,"_27550":57942,"_2978":58677},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3496":2953,"_30262":2658,"_21040":58679,"_5":14474,"_27550":57945,"_2978":58680},[],"After the upgrade, check in this order:",{"_3496":2954,"_30262":2658,"_21040":58682,"_5":14474,"_27550":57945,"_2978":58683},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3496":2955,"_30262":2658,"_21040":58685,"_5":14474,"_27550":57945,"_2978":58686},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3496":2956,"_30262":2658,"_21040":58688,"_5":14474,"_27550":57945,"_2978":58689},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3496":2957,"_30262":2658,"_21040":58691,"_5":14474,"_27550":57945,"_2978":58692},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3496":2958,"_30262":2658,"_21040":58694,"_5":14474,"_27550":57945,"_2978":58695},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3496":2959,"_30262":2658,"_21040":58697,"_5":14474,"_27550":57945,"_2978":58698},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3496":2960,"_30262":2658,"_21040":58700,"_5":14474,"_27550":57945,"_2978":58701},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3496":2961,"_30262":2658,"_21040":58703,"_5":14474,"_27550":57945,"_2978":58704},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3496":2962,"_30262":2658,"_21040":58706,"_5":14474,"_27550":57945,"_2978":58707},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3496":2963,"_30262":2658,"_21040":58709,"_5":14474,"_27550":57945,"_2978":58710},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3496":2964,"_30262":2658,"_21040":58712,"_5":14474,"_27550":57945,"_2978":58713},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3496":2965,"_30262":2658,"_21040":58715,"_5":14474,"_27550":57945,"_2978":58716},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3496":2966,"_30262":2658,"_21040":58718,"_5":14474,"_27550":57945,"_2978":58719},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3496":2967,"_30262":2658,"_21040":58721,"_5":14474,"_27550":57945,"_2978":58722},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3496":2968,"_30262":2658,"_21040":58724,"_5":14474,"_27550":57945,"_2978":58725},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3496":2969,"_30262":2658,"_21040":58727,"_5":14474,"_27550":57949,"_2978":58728},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3496":2970,"_30262":2658,"_21040":58730,"_5":14474,"_27550":57949,"_2978":58731},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3496":2971,"_30262":2658,"_21040":58733,"_5":14474,"_27550":57949,"_2978":58734},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3496":2972,"_30262":2658,"_21040":58736,"_5":14474,"_27550":57949,"_2978":58737},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3496":2973,"_30262":2658,"_21040":58739,"_5":14474,"_27550":57949,"_2978":58740},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58743":58744,"_58745":58746,"_58747":58748,"_58749":58750,"_18251":3013,"_70600":3013},"language","english","sortableProperties",[2978,30262,5,27550],"sortablePropertiesWithTypes",{"_2978