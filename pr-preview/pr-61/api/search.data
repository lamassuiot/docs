 en Amazon EC2.",{"_3569":72143,"_31013":72141,"_5":31368,"_21476":119617,"_28165":119618,"_3038":119619},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3569":72144,"_31013":72141,"_5":31368,"_21476":119621,"_28165":119622,"_3038":119623},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3569":72145,"_31013":72141,"_5":31368,"_21476":119625,"_28165":119626,"_3038":119627},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3569":72146,"_31013":72141,"_5":31368,"_21476":119629,"_28165":119630,"_3038":119631},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3569":72147,"_31013":72141,"_5":31368,"_21476":119633,"_28165":119634,"_3038":119635},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3569":72148,"_31013":72141,"_5":31368,"_21476":119637,"_28165":119638,"_3038":119639},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3569":72149,"_31013":72141,"_5":31368,"_21476":119641,"_28165":119642,"_3038":119643},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3569":72150,"_31013":72141,"_21476":119645,"_5":14750,"_28165":72141,"_3038":119646},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3569":72151,"_31013":72141,"_21476":119648,"_5":14750,"_28165":119618,"_3038":119649},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3569":72152,"_31013":72141,"_21476":119651,"_5":14750,"_28165":119618,"_3038":119652},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3569":72153,"_31013":72141,"_21476":119654,"_5":14750,"_28165":119618,"_3038":119655},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3569":72154,"_31013":72141,"_21476":119657,"_5":14750,"_28165":119622,"_3038":119658},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3569":72155,"_31013":72141,"_21476":119660,"_5":14750,"_28165":119622,"_3038":119661},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3569":72156,"_31013":72141,"_21476":119663,"_5":14750,"_28165":119622,"_3038":119664},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3569":72157,"_31013":72141,"_21476":119666,"_5":14750,"_28165":119626,"_3038":119667},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3569":72158,"_31013":72141,"_21476":119669,"_5":14750,"_28165":119630,"_3038":119670},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3569":72159,"_31013":72141,"_21476":119672,"_5":14750,"_28165":119634,"_3038":119673},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3569":72160,"_31013":72141,"_21476":119675,"_5":14750,"_28165":119638,"_3038":119676},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3569":72161,"_31013":72141,"_21476":119678,"_5":14750,"_28165":119642,"_3038":119679},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3569":72162,"_31013":72162,"_5":15116,"_3038":119681,"_31371":119682,"_21476":119683,"_28165":72162},"Despliega Lamassu",[50615,119610],[],{"_3569":72163,"_31013":72162,"_21476":119685,"_5":14750,"_28165":72162,"_3038":119686},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3569":72164,"_31013":72162,"_5":31368,"_21476":119688,"_28165":119689,"_3038":119690},[],"/docs/pr-preview/pr-61/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3569":72165,"_31013":72162,"_5":31368,"_21476":119692,"_28165":119693,"_3038":119694},[],"/docs/pr-preview/pr-61/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3569":72166,"_31013":72162,"_5":31368,"_21476":119696,"_28165":119697,"_3038":119698},[],"/docs/pr-preview/pr-61/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3569":72167,"_31013":72162,"_21476":119700,"_5":14750,"_28165":72162,"_3038":119701},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3569":72168,"_31013":72162,"_21476":119703,"_5":14750,"_28165":119689,"_3038":119704},[],"Modelo",{"_3569":72169,"_31013":72162,"_21476":119706,"_5":14750,"_28165":119689,"_3038":119707},[],"Recomendado para",{"_3569":72170,"_31013":72162,"_21476":119709,"_5":14750,"_28165":119689,"_3038":119710},[],"Quién opera la infraestructura",{"_3569":72171,"_31013":72162,"_21476":119712,"_5":14750,"_28165":119689,"_3038":119713},[],"Punto de partida",{"_3569":72172,"_31013":72162,"_21476":119715,"_5":14750,"_28165":119689,"_3038":50722},[],{"_3569":72173,"_31013":72162,"_21476":119717,"_5":14750,"_28165":119689,"_3038":119718},[],"Producción, entornos regulados y despliegues personalizados",{"_3569":72174,"_31013":72162,"_21476":119720,"_5":14750,"_28165":119689,"_3038":119721},[],"Tu equipo",{"_3569":72175,"_31013":72162,"_21476":119723,"_5":14750,"_28165":119689,"_3038":119724},[],"Helm o Fastlane",{"_3569":72176,"_31013":72162,"_21476":119726,"_5":14750,"_28165":119689,"_3038":50734},[],{"_3569":72177,"_31013":72162,"_21476":119728,"_5":14750,"_28165":119689,"_3038":119729},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3569":72178,"_31013":72162,"_21476":119731,"_5":14750,"_28165":119689,"_3038":119721},[],{"_3569":72179,"_31013":72162,"_21476":119733,"_5":14750,"_28165":119689,"_3038":119734},[],"Imagen preconfigurada en EC2",{"_3569":72180,"_31013":72162,"_21476":119736,"_5":14750,"_28165":119689,"_3038":50745},[],{"_3569":72181,"_31013":72162,"_21476":119738,"_5":14750,"_28165":119689,"_3038":119739},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3569":72182,"_31013":72162,"_21476":119741,"_5":14750,"_28165":119689,"_3038":50751},[],{"_3569":72183,"_31013":72162,"_21476":119743,"_5":14750,"_28165":119689,"_3038":119744},[],"Suscripción gestionada",{"_3569":72184,"_31013":72162,"_21476":119746,"_5":14750,"_28165":119689,"_3038":119747},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3569":72185,"_31013":72162,"_21476":119749,"_5":14750,"_28165":119689,"_3038":119750},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3569":72186,"_31013":72162,"_21476":119752,"_5":14750,"_28165":119689,"_3038":119753},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3569":72187,"_31013":72162,"_21476":119755,"_5":14750,"_28165":119693,"_3038":119756},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3569":72188,"_31013":72162,"_21476":119758,"_5":14750,"_28165":119697,"_3038":119759},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3569":72189,"_31013":72189,"_5":15116,"_3038":119761,"_31371":119762,"_21476":119763,"_28165":72189},"Utiliza Lamassu como SaaS",[50615,119610,119611],[],{"_3569":72190,"_31013":72189,"_21476":119765,"_5":14750,"_28165":72189,"_3038":119766},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3569":72191,"_31013":72189,"_5":31368,"_21476":119768,"_28165":119769,"_3038":119770},[],"/docs/pr-preview/pr-61/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3569":72192,"_31013":72189,"_5":31368,"_21476":119772,"_28165":119773,"_3038":119774},[],"/docs/pr-preview/pr-61/es/deployment/saas#planes","Planes",{"_3569":72193,"_31013":72189,"_5":31368,"_21476":119776,"_28165":119777,"_3038":119778},[],"/docs/pr-preview/pr-61/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3569":72194,"_31013":72189,"_21476":119780,"_5":14750,"_28165":72189,"_3038":119781},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3569":72195,"_31013":72189,"_21476":119783,"_5":14750,"_28165":119769,"_3038":119784},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3569":72196,"_31013":72189,"_21476":119786,"_5":14750,"_28165":119769,"_3038":119787},[],"Copias de seguridad automáticas.",{"_3569":72197,"_31013":72189,"_21476":119789,"_5":14750,"_28165":119769,"_3038":119790},[],"Actualizaciones de versión.",{"_3569":72198,"_31013":72189,"_21476":119792,"_5":14750,"_28165":119769,"_3038":119793},[],"Soporte técnico y SLA según el plan contratado.",{"_3569":72199,"_31013":72189,"_21476":119795,"_5":14750,"_28165":119773,"_3038":50806},[],{"_3569":72200,"_31013":72189,"_21476":119797,"_5":14750,"_28165":119773,"_3038":119798},[],"Dispositivos",{"_3569":72201,"_31013":72189,"_21476":119800,"_5":14750,"_28165":119773,"_3038":119801},[],"Soporte",{"_3569":72202,"_31013":72189,"_21476":119803,"_5":14750,"_28165":119773,"_3038":50815},[],{"_3569":72203,"_31013":72189,"_21476":119805,"_5":14750,"_28165":119773,"_3038":50818},[],{"_3569":72204,"_31013":72189,"_21476":119807,"_5":14750,"_28165":119773,"_3038":119808},[],"Hasta 1.000",{"_3569":72205,"_31013":72189,"_21476":119810,"_5":14750,"_28165":119773,"_3038":50824},[],{"_3569":72206,"_31013":72189,"_21476":119812,"_5":14750,"_28165":119773,"_3038":119813},[],"99,5 %",{"_3569":72207,"_31013":72189,"_21476":119815,"_5":14750,"_28165":119773,"_3038":50830},[],{"_3569":72208,"_31013":72189,"_21476":119817,"_5":14750,"_28165":119773,"_3038":119818},[],"Hasta 10.000",{"_3569":72209,"_31013":72189,"_21476":119820,"_5":14750,"_28165":119773,"_3038":119821},[],"Email y chat",{"_3569":72210,"_31013":72189,"_21476":119823,"_5":14750,"_28165":119773,"_3038":119824},[],"99,9 %",{"_3569":72211,"_31013":72189,"_21476":119826,"_5":14750,"_28165":119773,"_3038":50842},[],{"_3569":72212,"_31013":72189,"_21476":119828,"_5":14750,"_28165":119773,"_3038":119829},[],"Ilimitados",{"_3569":72213,"_31013":72189,"_21476":119831,"_5":14750,"_28165":119773,"_3038":119832},[],"Dedicado",{"_3569":72214,"_31013":72189,"_21476":119834,"_5":14750,"_28165":119773,"_3038":119835},[],"99,99 %",{"_3569":72215,"_31013":72189,"_21476":119837,"_5":14750,"_28165":119777,"_3038":119838},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3569":72216,"_31013":72189,"_21476":119840,"_5":14750,"_28165":119777,"_3038":119841},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3569":72217,"_31013":72217,"_5":15116,"_3038":50859,"_31371":119843,"_21476":119845,"_28165":72217},[50615,119610,119844],"Kubernetes autogestionado",[],{"_3569":72218,"_31013":72217,"_21476":119847,"_5":14750,"_28165":72217,"_3038":119848},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3569":72219,"_31013":72217,"_5":31368,"_21476":119850,"_28165":119851,"_3038":119852},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3569":72220,"_31013":72217,"_5":31368,"_21476":119854,"_28165":119855,"_3038":119856},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3569":72221,"_31013":72217,"_5":31368,"_21476":119858,"_28165":119859,"_3038":119860},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3569":72222,"_31013":72217,"_5":31368,"_21476":119862,"_28165":119863,"_3038":119864},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3569":72223,"_31013":72217,"_5":31368,"_21476":119866,"_28165":119867,"_3038":119868},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3569":72224,"_31013":72217,"_5":31368,"_21476":119870,"_28165":119871,"_3038":119872},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3569":72225,"_31013":72217,"_5":31368,"_21476":119874,"_28165":119875,"_3038":119876},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3569":72226,"_31013":72217,"_5":31368,"_21476":119878,"_28165":119879,"_3038":119880},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3569":72227,"_31013":72217,"_5":31368,"_21476":119882,"_28165":119883,"_3038":119884},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3569":72228,"_31013":72217,"_5":31368,"_21476":119886,"_28165":119887,"_3038":119888},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3569":72229,"_31013":72217,"_5":31368,"_21476":119890,"_28165":119891,"_3038":119892},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3569":72230,"_31013":72217,"_21476":119894,"_5":14750,"_28165":119851,"_3038":119895},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3569":72231,"_31013":72217,"_21476":119897,"_5":14750,"_28165":119851,"_3038":119898},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3569":72232,"_31013":72217,"_21476":119900,"_5":14750,"_28165":119855,"_3038":119901},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3569":72233,"_31013":72217,"_21476":119903,"_5":14750,"_28165":119855,"_3038":119904},[],"Fastlane instala o configura",{"_3569":72234,"_31013":72217,"_21476":119906,"_5":14750,"_28165":119855,"_3038":119907},[],"Tú sigues proporcionando",{"_3569":72235,"_31013":72217,"_21476":119909,"_5":14750,"_28165":119855,"_3038":119910},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3569":72236,"_31013":72217,"_21476":119912,"_5":14750,"_28165":119855,"_3038":119913},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3569":72237,"_31013":72217,"_21476":119915,"_5":14750,"_28165":119855,"_3038":119916},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3569":72238,"_31013":72217,"_21476":119918,"_5":14750,"_28165":119855,"_3038":119919},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3569":72239,"_31013":72217,"_21476":119921,"_5":14750,"_28165":119855,"_3038":119922},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3569":72240,"_31013":72217,"_21476":119924,"_5":14750,"_28165":119855,"_3038":119925},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3569":72241,"_31013":72217,"_21476":119927,"_5":14750,"_28165":119855,"_3038":119928},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3569":72242,"_31013":72217,"_21476":119930,"_5":14750,"_28165":119855,"_3038":119931},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3569":72243,"_31013":72217,"_21476":119933,"_5":14750,"_28165":119855,"_3038":119934},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3569":72244,"_31013":72217,"_21476":119936,"_5":14750,"_28165":119859,"_3038":119937},[],"Necesitas:",{"_3569":72245,"_31013":72217,"_21476":119939,"_5":14750,"_28165":119859,"_3038":119940},[],"un clúster Kubernetes existente",{"_3569":72246,"_31013":72217,"_21476":119942,"_5":14750,"_28165":119859,"_3038":119943},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3569":72247,"_31013":72217,"_21476":119945,"_5":14750,"_28165":119859,"_3038":50961},[],{"_3569":72248,"_31013":72217,"_21476":119947,"_5":14750,"_28165":119859,"_3038":24323},[],{"_3569":72249,"_31013":72217,"_21476":119949,"_5":14750,"_28165":119859,"_3038":119950},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3569":72250,"_31013":72217,"_21476":119952,"_5":14750,"_28165":119859,"_3038":119953},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3569":72251,"_31013":72217,"_21476":119955,"_5":14750,"_28165":119859,"_3038":119956},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3569":72252,"_31013":72217,"_21476":119958,"_5":14750,"_28165":119859,"_3038":119959},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3569":72253,"_31013":72217,"_21476":119961,"_5":14750,"_28165":119859,"_3038":119962},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3569":72254,"_31013":72217,"_21476":119964,"_5":14750,"_28165":119863,"_3038":119965},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3569":72255,"_31013":72217,"_21476":119967,"_5":14750,"_28165":119863,"_3038":119968},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3569":72256,"_31013":72217,"_21476":119970,"_5":14750,"_28165":119867,"_3038":119971},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3569":72257,"_31013":72217,"_21476":119973,"_5":14750,"_28165":119867,"_3038":119974},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3569":72258,"_31013":72217,"_21476":119976,"_5":14750,"_28165":119867,"_3038":119977},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3569":72259,"_31013":72217,"_21476":119979,"_5":14750,"_28165":119867,"_3038":119980},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3569":72260,"_31013":72217,"_21476":119982,"_5":14750,"_28165":119871,"_3038":119983},[],"Opción",{"_3569":72261,"_31013":72217,"_21476":119985,"_5":14750,"_28165":119871,"_3038":119986},[],"Valor predeterminado",{"_3569":72262,"_31013":72217,"_21476":119988,"_5":14750,"_28165":119871,"_3038":119989},[],"Propósito",{"_3569":72263,"_31013":72217,"_21476":119991,"_5":14750,"_28165":119871,"_3038":51008},[],{"_3569":72264,"_31013":72217,"_21476":119993,"_5":14750,"_28165":119871,"_3038":51011},[],{"_3569":72265,"_31013":72217,"_21476":119995,"_5":14750,"_28165":119871,"_3038":119996},[],"Muestra la ayuda",{"_3569":72266,"_31013":72217,"_21476":119998,"_5":14750,"_28165":119871,"_3038":51017},[],{"_3569":72267,"_31013":72217,"_21476":120000,"_5":14750,"_28165":119871,"_3038":120001},[],"contexto actual",{"_3569":72268,"_31013":72217,"_21476":120003,"_5":14750,"_28165":119871,"_3038":120004},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3569":72269,"_31013":72217,"_21476":120006,"_5":14750,"_28165":119871,"_3038":51026},[],{"_3569":72270,"_31013":72217,"_21476":120008,"_5":14750,"_28165":119871,"_3038":6751},[],{"_3569":72271,"_31013":72217,"_21476":120010,"_5":14750,"_28165":119871,"_3038":120011},[],"Omite prompts y genera credenciales para las dependencias",{"_3569":72272,"_31013":72217,"_21476":120013,"_5":14750,"_28165":119871,"_3038":51034},[],{"_3569":72273,"_31013":72217,"_21476":120015,"_5":14750,"_28165":119871,"_3038":51037},[],{"_3569":72274,"_31013":72217,"_21476":120017,"_5":14750,"_28165":119871,"_3038":120018},[],"Namespace de la instalación",{"_3569":72275,"_31013":72217,"_21476":120020,"_5":14750,"_28165":119871,"_3038":51043},[],{"_3569":72276,"_31013":72217,"_21476":120022,"_5":14750,"_28165":119871,"_3038":51046},[],{"_3569":72277,"_31013":72217,"_21476":120024,"_5":14750,"_28165":119871,"_3038":120025},[],"Dominio usado por la UI, OIDC y el certificado",{"_3569":72278,"_31013":72217,"_21476":120027,"_5":14750,"_28165":119871,"_3038":51052},[],{"_3569":72279,"_31013":72217,"_21476":120029,"_5":14750,"_28165":119871,"_3038":15486},[],{"_3569":72280,"_31013":72217,"_21476":120031,"_5":14750,"_28165":119871,"_3038":120032},[],"Versión del chart de Lamassu",{"_3569":72281,"_31013":72217,"_21476":120034,"_5":14750,"_28165":119871,"_3038":51060},[],{"_3569":72282,"_31013":72217,"_21476":120036,"_5":14750,"_28165":119871,"_3038":51063},[],{"_3569":72283,"_31013":72217,"_21476":120038,"_5":14750,"_28165":119871,"_3038":120039},[],"Puerto del listener HTTPS",{"_3569":72284,"_31013":72217,"_21476":120041,"_5":14750,"_28165":119871,"_3038":51069},[],{"_3569":72285,"_31013":72217,"_21476":120043,"_5":14750,"_28165":119871,"_3038":51072},[],{"_3569":72286,"_31013":72217,"_21476":120045,"_5":14750,"_28165":119871,"_3038":120046},[],"Puerto del listener HTTP",{"_3569":72287,"_31013":72217,"_21476":120048,"_5":14750,"_28165":119871,"_3038":51078},[],{"_3569":72288,"_31013":72217,"_21476":120050,"_5":14750,"_28165":119871,"_3038":51011},[],{"_3569":72289,"_31013":72217,"_21476":120052,"_5":14750,"_28165":119871,"_3038":120053},[],"Certificado PEM para TLS downstream",{"_3569":72290,"_31013":72217,"_21476":120055,"_5":14750,"_28165":119871,"_3038":51086},[],{"_3569":72291,"_31013":72217,"_21476":120057,"_5":14750,"_28165":119871,"_3038":51011},[],{"_3569":72292,"_31013":72217,"_21476":120059,"_5":14750,"_28165":119871,"_3038":120060},[],"Clave privada PEM para TLS downstream",{"_3569":72293,"_31013":72217,"_21476":120062,"_5":14750,"_28165":119871,"_3038":51094},[],{"_3569":72294,"_31013":72217,"_21476":120064,"_5":14750,"_28165":119871,"_3038":120065},[],"chart del repositorio",{"_3569":72295,"_31013":72217,"_21476":120067,"_5":14750,"_28165":119871,"_3038":120068},[],"Usa un chart local de Lamassu sin empaquetar",{"_3569":72296,"_31013":72217,"_21476":120070,"_5":14750,"_28165":119871,"_3038":51103},[],{"_3569":72297,"_31013":72217,"_21476":120072,"_5":14750,"_28165":119871,"_3038":120073},[],"detección automática",{"_3569":72298,"_31013":72217,"_21476":120075,"_5":14750,"_28165":119871,"_3038":120076},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3569":72299,"_31013":72217,"_21476":120078,"_5":14750,"_28165":119871,"_3038":51111},[],{"_3569":72300,"_31013":72217,"_21476":120080,"_5":14750,"_28165":119871,"_3038":6751},[],{"_3569":72301,"_31013":72217,"_21476":120082,"_5":14750,"_28165":119871,"_3038":120083},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3569":72302,"_31013":72217,"_21476":120085,"_5":14750,"_28165":119871,"_3038":51119},[],{"_3569":72303,"_31013":72217,"_21476":120087,"_5":14750,"_28165":119871,"_3038":6751},[],{"_3569":72304,"_31013":72217,"_21476":120089,"_5":14750,"_28165":119871,"_3038":120090},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3569":72305,"_31013":72217,"_21476":120092,"_5":14750,"_28165":119871,"_3038":51127},[],{"_3569":72306,"_31013":72217,"_21476":120094,"_5":14750,"_28165":119871,"_3038":6751},[],{"_3569":72307,"_31013":72217,"_21476":120096,"_5":14750,"_28165":119871,"_3038":120097},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3569":72308,"_31013":72217,"_21476":120099,"_5":14750,"_28165":119871,"_3038":51135},[],{"_3569":72309,"_31013":72217,"_21476":120101,"_5":14750,"_28165":119871,"_3038":6751},[],{"_3569":72310,"_31013":72217,"_21476":120103,"_5":14750,"_28165":119871,"_3038":120104},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3569":72311,"_31013":72217,"_21476":120106,"_5":14750,"_28165":119871,"_3038":51143},[],{"_3569":72312,"_31013":72217,"_21476":120108,"_5":14750,"_28165":119871,"_3038":51146},[],{"_3569":72313,"_31013":72217,"_21476":120110,"_5":14750,"_28165":119871,"_3038":120111},[],"Usa otro chart local de SoftHSM",{"_3569":72314,"_31013":72217,"_21476":120113,"_5":14750,"_28165":119871,"_3038":120114},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3569":72315,"_31013":72217,"_21476":120116,"_5":14750,"_28165":119875,"_3038":120117},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3569":72316,"_31013":72217,"_21476":120119,"_5":14750,"_28165":119875,"_3038":120120},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3569":72317,"_31013":72217,"_21476":120122,"_5":14750,"_28165":119875,"_3038":120123},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3569":72318,"_31013":72217,"_21476":120125,"_5":14750,"_28165":119875,"_3038":120126},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3569":72319,"_31013":72217,"_21476":120128,"_5":14750,"_28165":119875,"_3038":120129},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3569":72320,"_31013":72217,"_21476":120131,"_5":14750,"_28165":119875,"_3038":120132},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3569":72321,"_31013":72217,"_21476":120134,"_5":14750,"_28165":119879,"_3038":51173},[],{"_3569":72322,"_31013":72217,"_21476":120136,"_5":14750,"_28165":119879,"_3038":120137},[],"valida las herramientas locales y el clúster seleccionado",{"_3569":72323,"_31013":72217,"_21476":120139,"_5":14750,"_28165":119879,"_3038":120140},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3569":72324,"_31013":72217,"_21476":120142,"_5":14750,"_28165":119879,"_3038":120143},[],"crea el namespace",{"_3569":72325,"_31013":72217,"_21476":120145,"_5":14750,"_28165":119879,"_3038":120146},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3569":72326,"_31013":72217,"_21476":120148,"_5":14750,"_28165":119879,"_3038":120149},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3569":72327,"_31013":72217,"_21476":120151,"_5":14750,"_28165":119879,"_3038":120152},[],"instala RabbitMQ",{"_3569":72328,"_31013":72217,"_21476":120154,"_5":14750,"_28165":119879,"_3038":120155},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3569":72329,"_31013":72217,"_21476":120157,"_5":14750,"_28165":119879,"_3038":120158},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3569":72330,"_31013":72217,"_21476":120160,"_5":14750,"_28165":119879,"_3038":120161},[],"carga datos de ejemplo opcionalmente",{"_3569":72331,"_31013":72217,"_21476":120163,"_5":14750,"_28165":119879,"_3038":120164},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3569":72332,"_31013":72217,"_21476":120166,"_5":14750,"_28165":119883,"_3038":120167},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3569":72333,"_31013":72217,"_21476":120169,"_5":14750,"_28165":119883,"_3038":120170},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3569":72334,"_31013":72217,"_21476":120172,"_5":14750,"_28165":119887,"_3038":120173},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3569":72335,"_31013":72217,"_21476":120175,"_5":14750,"_28165":119887,"_3038":120176},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3569":72336,"_31013":72217,"_21476":120178,"_5":14750,"_28165":119887,"_3038":120179},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3569":72337,"_31013":72217,"_21476":120181,"_5":14750,"_28165":119891,"_3038":120182},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3569":72338,"_31013":72338,"_5":15116,"_3038":120184,"_31371":120185,"_21476":120186,"_28165":72338},"Instala con Helm",[50615,119610,119844],[],{"_3569":72339,"_31013":72338,"_21476":120188,"_5":14750,"_28165":72338,"_3038":120189},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3569":72340,"_31013":72338,"_5":31368,"_21476":120191,"_28165":120192,"_3038":120193},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3569":72341,"_31013":72338,"_5":31368,"_21476":120195,"_28165":120196,"_3038":119860},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3569":72342,"_31013":72338,"_5":31368,"_21476":120198,"_28165":120199,"_3038":120200},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3569":72343,"_31013":72338,"_5":31368,"_21476":120202,"_28165":120203,"_3038":120204},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3569":72344,"_31013":72338,"_5":31368,"_21476":120206,"_28165":120207,"_3038":120208},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3569":72345,"_31013":72338,"_5":31368,"_21476":120210,"_28165":120211,"_3038":120212},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3569":72346,"_31013":72338,"_5":31368,"_21476":120214,"_28165":120215,"_3038":120216},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3569":72347,"_31013":72338,"_5":31368,"_21476":120218,"_28165":120219,"_3038":120220},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3569":72348,"_31013":72338,"_5":31368,"_21476":120222,"_28165":120223,"_3038":120224},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3569":72349,"_31013":72338,"_5":31368,"_21476":120226,"_28165":120227,"_3038":120228},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3569":72350,"_31013":72338,"_5":31368,"_21476":120230,"_28165":120231,"_3038":120232},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3569":72351,"_31013":72338,"_21476":120234,"_5":14750,"_28165":120192,"_3038":120235},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3569":72352,"_31013":72338,"_21476":120237,"_5":14750,"_28165":120196,"_3038":120238},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3569":72353,"_31013":72338,"_21476":120240,"_5":14750,"_28165":120196,"_3038":120241},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3569":72354,"_31013":72338,"_21476":120243,"_5":14750,"_28165":120196,"_3038":120244},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3569":72355,"_31013":72338,"_21476":120246,"_5":14750,"_28165":120196,"_3038":120247},[],"un broker RabbitMQ accesible y sus credenciales",{"_3569":72356,"_31013":72338,"_21476":120249,"_5":14750,"_28165":120196,"_3038":120250},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3569":72357,"_31013":72338,"_21476":120252,"_5":14750,"_28165":120196,"_3038":120253},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3569":72358,"_31013":72338,"_21476":120255,"_5":14750,"_28165":120196,"_3038":120256},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3569":72359,"_31013":72338,"_21476":120258,"_5":14750,"_28165":120196,"_3038":120259},[],"una StorageClass y un diseño de tráfico externo",{"_3569":72360,"_31013":72338,"_21476":120261,"_5":14750,"_28165":120196,"_3038":120262},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3569":72361,"_31013":72338,"_21476":120264,"_5":14750,"_28165":120196,"_3038":120265},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3569":72362,"_31013":72338,"_21476":120267,"_5":14750,"_28165":120196,"_3038":120268},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3569":72363,"_31013":72338,"_21476":120270,"_5":14750,"_28165":120199,"_3038":120271},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3569":72364,"_31013":72338,"_21476":120273,"_5":14750,"_28165":120199,"_3038":120274},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3569":72365,"_31013":72338,"_21476":120276,"_5":14750,"_28165":120199,"_3038":120277},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3569":72366,"_31013":72338,"_21476":120279,"_5":14750,"_28165":120203,"_3038":120280},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3569":72367,"_31013":72338,"_21476":120282,"_5":14750,"_28165":120203,"_3038":120283},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3569":72368,"_31013":72338,"_21476":120285,"_5":14750,"_28165":120203,"_3038":120286},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3569":72369,"_31013":72338,"_21476":120288,"_5":14750,"_28165":120203,"_3038":120289},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3569":72370,"_31013":72338,"_21476":120291,"_5":14750,"_28165":120207,"_3038":120292},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3569":72371,"_31013":72338,"_21476":120294,"_5":14750,"_28165":120211,"_3038":120295},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3569":72372,"_31013":72338,"_21476":120297,"_5":14750,"_28165":120211,"_3038":120298},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3569":72373,"_31013":72338,"_21476":120300,"_5":14750,"_28165":120211,"_3038":120301},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3569":72374,"_31013":72338,"_21476":120303,"_5":14750,"_28165":120211,"_3038":120304},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3569":72375,"_31013":72338,"_21476":120306,"_5":14750,"_28165":120211,"_3038":120307},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3569":72376,"_31013":72338,"_21476":120309,"_5":14750,"_28165":120211,"_3038":120310},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3569":72377,"_31013":72338,"_21476":120312,"_5":14750,"_28165":120211,"_3038":120313},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3569":72378,"_31013":72338,"_21476":120315,"_5":14750,"_28165":120215,"_3038":120316},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3569":72379,"_31013":72338,"_21476":120318,"_5":14750,"_28165":120215,"_3038":120319},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3569":72380,"_31013":72338,"_21476":120321,"_5":14750,"_28165":120215,"_3038":120322},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3569":72381,"_31013":72338,"_21476":120324,"_5":14750,"_28165":120215,"_3038":120325},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3569":72382,"_31013":72338,"_21476":120327,"_5":14750,"_28165":120219,"_3038":120328},[],"Para instalar un checkout local:",{"_3569":72383,"_31013":72338,"_21476":120330,"_5":14750,"_28165":120223,"_3038":120331},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3569":72384,"_31013":72338,"_21476":120333,"_5":14750,"_28165":120223,"_3038":120334},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3569":72385,"_31013":72338,"_21476":120336,"_5":14750,"_28165":120227,"_3038":120337},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3569":72386,"_31013":72338,"_21476":120339,"_5":14750,"_28165":120227,"_3038":120340},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3569":72387,"_31013":72338,"_21476":120342,"_5":14750,"_28165":120227,"_3038":120343},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3569":72388,"_31013":72338,"_21476":120345,"_5":14750,"_28165":120227,"_3038":120346},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3569":72389,"_31013":72338,"_21476":120348,"_5":14750,"_28165":120227,"_3038":120349},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3569":72390,"_31013":72338,"_21476":120351,"_5":14750,"_28165":120231,"_3038":120352},[],"Antes de pasar a producción, revisa:",{"_3569":72391,"_31013":72338,"_21476":120354,"_5":14750,"_28165":120231,"_3038":120355},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3569":72392,"_31013":72338,"_21476":120357,"_5":14750,"_28165":120231,"_3038":120358},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3569":72393,"_31013":72338,"_21476":120360,"_5":14750,"_28165":120231,"_3038":120361},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3569":72394,"_31013":72338,"_21476":120363,"_5":14750,"_28165":120231,"_3038":120364},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3569":72395,"_31013":72338,"_21476":120366,"_5":14750,"_28165":120231,"_3038":120367},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3569":72396,"_31013":72338,"_21476":120369,"_5":14750,"_28165":120231,"_3038":120370},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3569":72397,"_31013":72338,"_21476":120372,"_5":14750,"_28165":120231,"_3038":120373},[],"SMTP, observabilidad y entrega de alertas",{"_3569":72398,"_31013":72338,"_21476":120375,"_5":14750,"_28165":120231,"_3038":120376},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3569":72399,"_31013":72338,"_21476":120378,"_5":14750,"_28165":120231,"_3038":120379},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3569":72400,"_31013":72400,"_5":15116,"_3038":120381,"_31371":120382,"_21476":120383,"_28165":72400},"Expón el Gateway",[50615,119610,119844],[],{"_3569":72401,"_31013":72400,"_21476":120385,"_5":14750,"_28165":72400,"_3038":120386},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3569":72402,"_31013":72400,"_5":31368,"_21476":120388,"_28165":120389,"_3038":120390},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3569":72403,"_31013":72400,"_5":31368,"_21476":120392,"_28165":120393,"_3038":120394},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3569":72404,"_31013":72400,"_5":31368,"_21476":120396,"_28165":120397,"_3038":120398},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3569":72405,"_31013":72400,"_5":31368,"_21476":120400,"_28165":120401,"_3038":51441},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#k3s",{"_3569":72406,"_31013":72400,"_5":31368,"_21476":120403,"_28165":120404,"_3038":120405},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3569":72407,"_31013":72400,"_5":31368,"_21476":120407,"_28165":120408,"_3038":120409},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3569":72408,"_31013":72400,"_5":31368,"_21476":120411,"_28165":120412,"_3038":120413},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3569":72409,"_31013":72400,"_5":31368,"_21476":120415,"_28165":120416,"_3038":120417},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3569":72410,"_31013":72400,"_5":31368,"_21476":120419,"_28165":120420,"_3038":120421},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3569":72411,"_31013":72400,"_5":31368,"_21476":120423,"_28165":120424,"_3038":120425},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3569":72412,"_31013":72400,"_5":31368,"_21476":120427,"_28165":120428,"_3038":120429},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3569":72413,"_31013":72400,"_21476":120431,"_5":14750,"_28165":120389,"_3038":120432},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3569":72414,"_31013":72400,"_21476":120434,"_5":14750,"_28165":120389,"_3038":120435},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3569":72415,"_31013":72400,"_21476":120437,"_5":14750,"_28165":120393,"_3038":120438},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3569":72416,"_31013":72400,"_21476":120440,"_5":14750,"_28165":120393,"_3038":120441},[],"Defínelo únicamente cuando:",{"_3569":72417,"_31013":72400,"_21476":120443,"_5":14750,"_28165":120393,"_3038":120444},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3569":72418,"_31013":72400,"_21476":120446,"_5":14750,"_28165":120393,"_3038":120447},[],"esa dirección está asignada a este Gateway",{"_3569":72419,"_31013":72400,"_21476":120449,"_5":14750,"_28165":120393,"_3038":120450},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3569":72420,"_31013":72400,"_21476":120452,"_5":14750,"_28165":120393,"_3038":120453},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3569":72421,"_31013":72400,"_21476":120455,"_5":14750,"_28165":120393,"_3038":120456},[],"No confundas estos valores:",{"_3569":72422,"_31013":72400,"_21476":120458,"_5":14750,"_28165":120393,"_3038":120459},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3569":72423,"_31013":72400,"_21476":120461,"_5":14750,"_28165":120393,"_3038":120462},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3569":72424,"_31013":72400,"_21476":120464,"_5":14750,"_28165":120393,"_3038":120465},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3569":72425,"_31013":72400,"_21476":120467,"_5":14750,"_28165":120397,"_3038":120468},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3569":72426,"_31013":72400,"_21476":120470,"_5":14750,"_28165":120397,"_3038":120471},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3569":72427,"_31013":72400,"_21476":120473,"_5":14750,"_28165":120401,"_3038":120474},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3569":72428,"_31013":72400,"_21476":120476,"_5":14750,"_28165":120401,"_3038":120477},[],"Para el diseño recomendado:",{"_3569":72429,"_31013":72400,"_21476":120479,"_5":14750,"_28165":120401,"_3038":120480},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3569":72430,"_31013":72400,"_21476":120482,"_5":14750,"_28165":120401,"_3038":120483},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3569":72431,"_31013":72400,"_21476":120485,"_5":14750,"_28165":120401,"_3038":120486},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3569":72432,"_31013":72400,"_21476":120488,"_5":14750,"_28165":120401,"_3038":120489},[],"Apunta DNS a la dirección accesible de la VM.",{"_3569":72433,"_31013":72400,"_21476":120491,"_5":14750,"_28165":120401,"_3038":120492},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3569":72434,"_31013":72400,"_21476":120494,"_5":14750,"_28165":120404,"_3038":120495},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3569":72435,"_31013":72400,"_21476":120497,"_5":14750,"_28165":120408,"_3038":120498},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3569":72436,"_31013":72400,"_21476":120500,"_5":14750,"_28165":120408,"_3038":120501},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3569":72437,"_31013":72400,"_21476":120503,"_5":14750,"_28165":120412,"_3038":120504},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3569":72438,"_31013":72400,"_21476":120506,"_5":14750,"_28165":120412,"_3038":120507},[],"Requisito",{"_3569":72439,"_31013":72400,"_21476":120509,"_5":14750,"_28165":120412,"_3038":120510},[],"Diseño recomendado",{"_3569":72440,"_31013":72400,"_21476":120512,"_5":14750,"_28165":120412,"_3038":120513},[],"Consecuencia",{"_3569":72441,"_31013":72400,"_21476":120515,"_5":14750,"_28165":120412,"_3038":120516},[],"Varias URL o servicios de Lamassu",{"_3569":72442,"_31013":72400,"_21476":120518,"_5":14750,"_28165":120412,"_3038":120519},[],"Un Gateway con varias rutas",{"_3569":72443,"_31013":72400,"_21476":120521,"_5":14750,"_28165":120412,"_3038":120522},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3569":72444,"_31013":72400,"_21476":120524,"_5":14750,"_28165":120412,"_3038":120525},[],"Gateways independientes e IP externas distintas",{"_3569":72445,"_31013":72400,"_21476":120527,"_5":14750,"_28165":120412,"_3038":120528},[],"Una VIP por Gateway",{"_3569":72446,"_31013":72400,"_21476":120530,"_5":14750,"_28165":120412,"_3038":120531},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3569":72447,"_31013":72400,"_21476":120533,"_5":14750,"_28165":120412,"_3038":120534},[],"Gateways independientes, un nodo y una IP",{"_3569":72448,"_31013":72400,"_21476":120536,"_5":14750,"_28165":120412,"_3038":120537},[],"Puertos externos diferentes",{"_3569":72449,"_31013":72400,"_21476":120539,"_5":14750,"_28165":120412,"_3038":120540},[],"Los clientes deben indicar puertos no estándar",{"_3569":72450,"_31013":72400,"_21476":120542,"_5":14750,"_28165":120412,"_3038":120543},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3569":72451,"_31013":72400,"_21476":120545,"_5":14750,"_28165":120412,"_3038":120546},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3569":72452,"_31013":72400,"_21476":120548,"_5":14750,"_28165":120412,"_3038":120549},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3569":72453,"_31013":72400,"_21476":120551,"_5":14750,"_28165":120412,"_3038":120552},[],"Recursos Gateway separados pero proxy compartido",{"_3569":72454,"_31013":72400,"_21476":120554,"_5":14750,"_28165":120412,"_3038":120555},[],"Modo merged Gateway de Envoy",{"_3569":72455,"_31013":72400,"_21476":120557,"_5":14750,"_28165":120412,"_3038":120558},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3569":72456,"_31013":72400,"_21476":120560,"_5":14750,"_28165":120412,"_3038":120561},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3569":72457,"_31013":72400,"_21476":120563,"_5":14750,"_28165":120412,"_3038":120564},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3569":72458,"_31013":72400,"_21476":120566,"_5":14750,"_28165":120412,"_3038":120567},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3569":72459,"_31013":72400,"_21476":120569,"_5":14750,"_28165":120412,"_3038":120570},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3569":72460,"_31013":72400,"_21476":120572,"_5":14750,"_28165":120416,"_3038":120573},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3569":72461,"_31013":72400,"_21476":120575,"_5":14750,"_28165":120420,"_3038":120576},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3569":72462,"_31013":72400,"_21476":120578,"_5":14750,"_28165":120420,"_3038":120579},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3569":72463,"_31013":72400,"_21476":120581,"_5":14750,"_28165":120420,"_3038":120582},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3569":72464,"_31013":72400,"_21476":120584,"_5":14750,"_28165":120420,"_3038":120585},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3569":72465,"_31013":72400,"_21476":120587,"_5":14750,"_28165":120420,"_3038":120588},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3569":72466,"_31013":72400,"_21476":120590,"_5":14750,"_28165":120424,"_3038":120591},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3569":72467,"_31013":72400,"_21476":120593,"_5":14750,"_28165":120424,"_3038":120594},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3569":72468,"_31013":72400,"_21476":120596,"_5":14750,"_28165":120428,"_3038":120597},[],"Comprueba, en orden:",{"_3569":72469,"_31013":72400,"_21476":120599,"_5":14750,"_28165":120428,"_3038":120600},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3569":72470,"_31013":72400,"_21476":120602,"_5":14750,"_28165":120428,"_3038":120603},[],"Su estado contiene la dirección esperada.",{"_3569":72471,"_31013":72400,"_21476":120605,"_5":14750,"_28165":120428,"_3038":120606},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3569":72472,"_31013":72400,"_21476":120608,"_5":14750,"_28165":120428,"_3038":120609},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3569":72473,"_31013":72400,"_21476":120611,"_5":14750,"_28165":120428,"_3038":120612},[],"DNS resuelve al endpoint accesible externamente.",{"_3569":72474,"_31013":72400,"_21476":120614,"_5":14750,"_28165":120428,"_3038":120615},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3569":72475,"_31013":72400,"_21476":120617,"_5":14750,"_28165":120428,"_3038":120618},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3569":72476,"_31013":72476,"_5":15116,"_3038":50722,"_31371":120620,"_21476":120621,"_28165":72476},[50615,119610,119844],[],{"_3569":72477,"_31013":72476,"_21476":120623,"_5":14750,"_28165":72476,"_3038":120624},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3569":72478,"_31013":72476,"_5":31368,"_21476":120626,"_28165":120627,"_3038":120628},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3569":72479,"_31013":72476,"_5":31368,"_21476":120630,"_28165":120631,"_3038":120632},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3569":72480,"_31013":72476,"_5":31368,"_21476":120634,"_28165":120635,"_3038":120636},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3569":72481,"_31013":72476,"_5":31368,"_21476":120638,"_28165":120639,"_3038":120640},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3569":72482,"_31013":72476,"_5":31368,"_21476":120642,"_28165":120643,"_3038":120644},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3569":72483,"_31013":72476,"_5":31368,"_21476":120646,"_28165":120647,"_3038":120648},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3569":72484,"_31013":72476,"_21476":120650,"_5":14750,"_28165":120627,"_3038":120651},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3569":72485,"_31013":72476,"_21476":120653,"_5":14750,"_28165":120631,"_3038":120654},[],"Flujo",{"_3569":72486,"_31013":72476,"_21476":120656,"_5":14750,"_28165":120631,"_3038":120657},[],"Úsalo para",{"_3569":72487,"_31013":72476,"_21476":120659,"_5":14750,"_28165":120631,"_3038":120660},[],"Qué instala",{"_3569":72488,"_31013":72476,"_21476":120662,"_5":14750,"_28165":120631,"_3038":51703},[],{"_3569":72489,"_31013":72476,"_21476":120664,"_5":14750,"_28165":120631,"_3038":120665},[],"Producción y entornos controlados",{"_3569":72490,"_31013":72476,"_21476":120667,"_5":14750,"_28165":120631,"_3038":120668},[],"Servicios de Lamassu y recursos de Gateway API",{"_3569":72491,"_31013":72476,"_21476":120670,"_5":14750,"_28165":120631,"_3038":50859},[],{"_3569":72492,"_31013":72476,"_21476":120672,"_5":14750,"_28165":120631,"_3038":120673},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3569":72493,"_31013":72476,"_21476":120675,"_5":14750,"_28165":120631,"_3038":120676},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3569":72494,"_31013":72476,"_21476":120678,"_5":14750,"_28165":120635,"_3038":120679},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3569":72495,"_31013":72476,"_21476":120681,"_5":14750,"_28165":120635,"_3038":120682},[],"Área",{"_3569":72496,"_31013":72476,"_21476":120684,"_5":14750,"_28165":120635,"_3038":120685},[],"El chart de Lamassu proporciona",{"_3569":72497,"_31013":72476,"_21476":120687,"_5":14750,"_28165":120635,"_3038":120688},[],"Tú proporcionas",{"_3569":72498,"_31013":72476,"_21476":120690,"_5":14750,"_28165":120635,"_3038":120691},[],"Aplicaciones Lamassu",{"_3569":72499,"_31013":72476,"_21476":120693,"_5":14750,"_28165":120635,"_3038":120694},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3569":72500,"_31013":72476,"_21476":120696,"_5":14750,"_28165":120635,"_3038":120697},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3569":72501,"_31013":72476,"_21476":120699,"_5":14750,"_28165":120635,"_3038":120700},[],"Datos PostgreSQL",{"_3569":72502,"_31013":72476,"_21476":120702,"_5":14750,"_28165":120635,"_3038":120703},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3569":72503,"_31013":72476,"_21476":120705,"_5":14750,"_28165":120635,"_3038":120706},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3569":72504,"_31013":72476,"_21476":120708,"_5":14750,"_28165":120635,"_3038":120709},[],"Mensajería",{"_3569":72505,"_31013":72476,"_21476":120711,"_5":14750,"_28165":120635,"_3038":120712},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3569":72506,"_31013":72476,"_21476":120714,"_5":14750,"_28165":120635,"_3038":120715},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3569":72507,"_31013":72476,"_21476":120717,"_5":14750,"_28165":120635,"_3038":120718},[],"Identidad",{"_3569":72508,"_31013":72476,"_21476":120720,"_5":14750,"_28165":120635,"_3038":120721},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3569":72509,"_31013":72476,"_21476":120723,"_5":14750,"_28165":120635,"_3038":120724},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3569":72510,"_31013":72476,"_21476":120726,"_5":14750,"_28165":120635,"_3038":120727},[],"Enrutamiento externo",{"_3569":72511,"_31013":72476,"_21476":120729,"_5":14750,"_28165":120635,"_3038":120730},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3569":72512,"_31013":72476,"_21476":120732,"_5":14750,"_28165":120635,"_3038":120733},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3569":72513,"_31013":72476,"_21476":120735,"_5":14750,"_28165":120635,"_3038":51777},[],{"_3569":72514,"_31013":72476,"_21476":120737,"_5":14750,"_28165":120635,"_3038":120738},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3569":72515,"_31013":72476,"_21476":120740,"_5":14750,"_28165":120635,"_3038":120741},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3569":72516,"_31013":72476,"_21476":120743,"_5":14750,"_28165":120635,"_3038":120744},[],"Datos persistentes de la aplicación",{"_3569":72517,"_31013":72476,"_21476":120746,"_5":14750,"_28165":120635,"_3038":120747},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3569":72518,"_31013":72476,"_21476":120749,"_5":14750,"_28165":120635,"_3038":120750},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3569":72519,"_31013":72476,"_21476":120752,"_5":14750,"_28165":120635,"_3038":120753},[],"Integraciones opcionales",{"_3569":72520,"_31013":72476,"_21476":120755,"_5":14750,"_28165":120635,"_3038":120756},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3569":72521,"_31013":72476,"_21476":120758,"_5":14750,"_28165":120635,"_3038":120759},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3569":72522,"_31013":72476,"_21476":120761,"_5":14750,"_28165":120635,"_3038":120762},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3569":72523,"_31013":72476,"_21476":120764,"_5":14750,"_28165":120635,"_3038":120765},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3569":72524,"_31013":72476,"_21476":120767,"_5":14750,"_28165":120639,"_3038":120768},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3569":72525,"_31013":72476,"_21476":120770,"_5":14750,"_28165":120639,"_3038":120771},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3569":72526,"_31013":72476,"_21476":120773,"_5":14750,"_28165":120643,"_3038":120774},[],"Kubernetes 1.24 o posterior",{"_3569":72527,"_31013":72476,"_21476":120776,"_5":14750,"_28165":120643,"_3038":120777},[],"Helm 3.2 o posterior",{"_3569":72528,"_31013":72476,"_21476":120779,"_5":14750,"_28165":120643,"_3038":120780},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3569":72529,"_31013":72476,"_21476":120782,"_5":14750,"_28165":120643,"_3038":120783},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3569":72530,"_31013":72476,"_21476":120785,"_5":14750,"_28165":120643,"_3038":120786},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3569":72531,"_31013":72476,"_21476":120788,"_5":14750,"_28165":120643,"_3038":120789},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3569":72532,"_31013":72476,"_21476":120791,"_5":14750,"_28165":120643,"_3038":120792},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3569":72533,"_31013":72476,"_21476":120794,"_5":14750,"_28165":120647,"_3038":120795},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3569":72534,"_31013":72476,"_21476":120797,"_5":14750,"_28165":120647,"_3038":120798},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3569":72535,"_31013":72476,"_21476":120800,"_5":14750,"_28165":120647,"_3038":120801},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3569":72536,"_31013":72476,"_21476":120803,"_5":14750,"_28165":120647,"_3038":120804},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3569":72537,"_31013":72537,"_5":15116,"_3038":120806,"_31371":120807,"_21476":120809,"_28165":72537},"Resolución de problemas de despliegue",[50615,119610,120808],"Operación",[],{"_3569":72538,"_31013":72537,"_21476":120811,"_5":14750,"_28165":72537,"_3038":120812},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3569":72539,"_31013":72537,"_5":31368,"_21476":120814,"_28165":120815,"_3038":120816},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3569":72540,"_31013":72537,"_5":31368,"_21476":120818,"_28165":120819,"_3038":120820},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3569":72541,"_31013":72537,"_5":31368,"_21476":120822,"_28165":120823,"_3038":120824},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3569":72542,"_31013":72537,"_5":31368,"_21476":120826,"_28165":120827,"_3038":120828},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3569":72543,"_31013":72537,"_5":31368,"_21476":120830,"_28165":120831,"_3038":120832},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3569":72544,"_31013":72537,"_5":31368,"_21476":120834,"_28165":120835,"_3038":120836},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3569":72545,"_31013":72537,"_5":31368,"_21476":120838,"_28165":120839,"_3038":120840},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3569":72546,"_31013":72537,"_5":31368,"_21476":120842,"_28165":120843,"_3038":120844},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3569":72547,"_31013":72537,"_5":31368,"_21476":120846,"_28165":120847,"_3038":120848},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3569":72548,"_31013":72537,"_5":31368,"_21476":120850,"_28165":120851,"_3038":120852},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3569":72549,"_31013":72537,"_5":31368,"_21476":120854,"_28165":120855,"_3038":120856},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3569":72550,"_31013":72537,"_5":31368,"_21476":120858,"_28165":120859,"_3038":120860},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3569":72551,"_31013":72537,"_5":31368,"_21476":120862,"_28165":120863,"_3038":120864},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3569":72552,"_31013":72537,"_21476":120866,"_5":14750,"_28165":72537,"_3038":120867},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3569":72553,"_31013":72537,"_21476":120869,"_5":14750,"_28165":120819,"_3038":120870},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3569":72554,"_31013":72537,"_21476":120872,"_5":14750,"_28165":120823,"_3038":120873},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3569":72555,"_31013":72537,"_21476":120875,"_5":14750,"_28165":120827,"_3038":120876},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3569":72556,"_31013":72537,"_21476":120878,"_5":14750,"_28165":120831,"_3038":120879},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3569":72557,"_31013":72537,"_21476":120881,"_5":14750,"_28165":120835,"_3038":120882},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3569":72558,"_31013":72537,"_21476":120884,"_5":14750,"_28165":120839,"_3038":120885},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3569":72559,"_31013":72537,"_21476":120887,"_5":14750,"_28165":120839,"_3038":120888},[],"Ejecuta también la prueba de conectividad del chart:",{"_3569":72560,"_31013":72537,"_21476":120890,"_5":14750,"_28165":120839,"_3038":120891},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3569":72561,"_31013":72537,"_21476":120893,"_5":14750,"_28165":120839,"_3038":120894},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3569":72562,"_31013":72537,"_21476":120896,"_5":14750,"_28165":120843,"_3038":120897},[],"Si recibes un 401:",{"_3569":72563,"_31013":72537,"_21476":120899,"_5":14750,"_28165":120843,"_3038":120900},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3569":72564,"_31013":72537,"_21476":120902,"_5":14750,"_28165":120843,"_3038":120903},[],"verifica emisor, audiencia y expiración del token;",{"_3569":72565,"_31013":72537,"_21476":120905,"_5":14750,"_28165":120843,"_3038":120906},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3569":72566,"_31013":72537,"_21476":120908,"_5":14750,"_28165":120843,"_3038":120909},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3569":72567,"_31013":72537,"_21476":120911,"_5":14750,"_28165":120843,"_3038":120912},[],"Si el login termina pero las APIs devuelven 403:",{"_3569":72568,"_31013":72537,"_21476":120914,"_5":14750,"_28165":120843,"_3038":120915},[],"inspecciona los claims reales del token;",{"_3569":72569,"_31013":72537,"_21476":120917,"_5":14750,"_28165":120843,"_3038":120918},[],"confirma que coinciden con un principal activo;",{"_3569":72570,"_31013":72537,"_21476":120920,"_5":14750,"_28165":120843,"_3038":120921},[],"revisa las políticas concedidas al principal;",{"_3569":72571,"_31013":72537,"_21476":120923,"_5":14750,"_28165":120843,"_3038":120924},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3569":72572,"_31013":72537,"_21476":120926,"_5":14750,"_28165":120843,"_3038":120927},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3569":72573,"_31013":72537,"_21476":120929,"_5":14750,"_28165":120847,"_3038":120930},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3569":72574,"_31013":72537,"_21476":120932,"_5":14750,"_28165":120847,"_3038":120933},[],"Localiza el pod y Service de authz.",{"_3569":72575,"_31013":72537,"_21476":120935,"_5":14750,"_28165":120847,"_3038":120936},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3569":72576,"_31013":72537,"_21476":120938,"_5":14750,"_28165":120847,"_3038":120939},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3569":72577,"_31013":72537,"_21476":120941,"_5":14750,"_28165":120847,"_3038":120942},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3569":72578,"_31013":72537,"_21476":120944,"_5":14750,"_28165":120847,"_3038":120945},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3569":72579,"_31013":72537,"_21476":120947,"_5":14750,"_28165":120851,"_3038":120948},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3569":72580,"_31013":72537,"_21476":120950,"_5":14750,"_28165":120855,"_3038":120951},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3569":72581,"_31013":72537,"_21476":120953,"_5":14750,"_28165":120855,"_3038":120954},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3569":72582,"_31013":72537,"_21476":120956,"_5":14750,"_28165":120855,"_3038":120957},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3569":72583,"_31013":72537,"_21476":120959,"_5":14750,"_28165":120855,"_3038":120960},[],"volumen persistente sin enlazar;",{"_3569":72584,"_31013":72537,"_21476":120962,"_5":14750,"_28165":120855,"_3038":120963},[],"imagen inaccesible o política de pull incorrecta;",{"_3569":72585,"_31013":72537,"_21476":120965,"_5":14750,"_28165":120855,"_3038":120966},[],"configuración inválida del motor criptográfico;",{"_3569":72586,"_31013":72537,"_21476":120968,"_5":14750,"_28165":120855,"_3038":120969},[],"límites de CPU o memoria demasiado bajos;",{"_3569":72587,"_31013":72537,"_21476":120971,"_5":14750,"_28165":120855,"_3038":120972},[],"migración previa incompleta.",{"_3569":72588,"_31013":72537,"_21476":120974,"_5":14750,"_28165":120855,"_3038":120975},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3569":72589,"_31013":72537,"_21476":120977,"_5":14750,"_28165":120855,"_3038":120978},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3569":72590,"_31013":72537,"_21476":120980,"_5":14750,"_28165":120855,"_3038":120981},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3569":72591,"_31013":72537,"_21476":120983,"_5":14750,"_28165":120859,"_3038":120984},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3569":72592,"_31013":72537,"_21476":120986,"_5":14750,"_28165":120859,"_3038":120987},[],"verifica que esté habilitado en el servicio emisor;",{"_3569":72593,"_31013":72537,"_21476":120989,"_5":14750,"_28165":120859,"_3038":120990},[],"comprueba conectividad y credenciales AMQP;",{"_3569":72594,"_31013":72537,"_21476":120992,"_5":14750,"_28165":120859,"_3038":120993},[],"revisa exchange, routing key, colas y consumidores;",{"_3569":72595,"_31013":72537,"_21476":120995,"_5":14750,"_28165":120859,"_3038":120996},[],"inspecciona dead-letter queues;",{"_3569":72596,"_31013":72537,"_21476":120998,"_5":14750,"_28165":120859,"_3038":120999},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3569":72597,"_31013":72537,"_21476":121001,"_5":14750,"_28165":120859,"_3038":121002},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3569":72598,"_31013":72537,"_21476":121004,"_5":14750,"_28165":120859,"_3038":121005},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3569":72599,"_31013":72537,"_21476":121007,"_5":14750,"_28165":120859,"_3038":121008},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3569":72600,"_31013":72537,"_21476":121010,"_5":14750,"_28165":120859,"_3038":121011},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3569":72601,"_31013":72537,"_21476":121013,"_5":14750,"_28165":120859,"_3038":121014},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3569":72602,"_31013":72537,"_21476":121016,"_5":14750,"_28165":120859,"_3038":121017},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3569":72603,"_31013":72537,"_21476":121019,"_5":14750,"_28165":120859,"_3038":121020},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3569":72604,"_31013":72537,"_21476":121022,"_5":14750,"_28165":120863,"_3038":121023},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3569":72605,"_31013":72537,"_21476":121025,"_5":14750,"_28165":120863,"_3038":121026},[],"Antes de cerrar una incidencia, guarda:",{"_3569":72606,"_31013":72537,"_21476":121028,"_5":14750,"_28165":120863,"_3038":121029},[],"causa confirmada;",{"_3569":72607,"_31013":72537,"_21476":121031,"_5":14750,"_28165":120863,"_3038":121032},[],"alcance temporal y recursos afectados;",{"_3569":72608,"_31013":72537,"_21476":121034,"_5":14750,"_28165":120863,"_3038":121035},[],"comandos o consultas utilizados;",{"_3569":72609,"_31013":72537,"_21476":121037,"_5":14750,"_28165":120863,"_3038":121038},[],"cambio aplicado y forma de revertirlo;",{"_3569":72610,"_31013":72537,"_21476":121040,"_5":14750,"_28165":120863,"_3038":121041},[],"validación desde un consumidor;",{"_3569":72611,"_31013":72537,"_21476":121043,"_5":14750,"_28165":120863,"_3038":121044},[],"acción preventiva y propietario.",{"_3569":72612,"_31013":72612,"_5":15116,"_3038":121046,"_31371":121047,"_21476":121050,"_28165":72612},"Control de acceso",[50615,121048,121049],"Plataforma","Administración",[],{"_3569":72613,"_31013":72612,"_21476":121052,"_5":14750,"_28165":72612,"_3038":121053},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3569":72614,"_31013":72612,"_5":31368,"_21476":121055,"_28165":121056,"_3038":121057},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3569":72615,"_31013":72612,"_5":31368,"_21476":121059,"_28165":121060,"_3038":121061},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3569":72616,"_31013":72612,"_5":31368,"_21476":121063,"_28165":121064,"_3038":121065},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3569":72617,"_31013":72612,"_5":31368,"_21476":121067,"_28165":121068,"_3038":121069},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3569":72618,"_31013":72612,"_5":31368,"_21476":121071,"_28165":121072,"_3038":121073},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3569":72619,"_31013":72612,"_5":31368,"_21476":121075,"_28165":121076,"_3038":121077},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3569":72620,"_31013":72612,"_5":31368,"_21476":121079,"_28165":121080,"_3038":121081},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3569":72621,"_31013":72612,"_5":31368,"_21476":121083,"_28165":121084,"_3038":121085},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3569":72622,"_31013":72612,"_5":31368,"_21476":121087,"_28165":121088,"_3038":121089},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3569":72623,"_31013":72612,"_5":31368,"_21476":121091,"_28165":121092,"_3038":121093},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3569":72624,"_31013":72612,"_5":31368,"_21476":121095,"_28165":121096,"_3038":121097},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3569":72625,"_31013":72612,"_5":31368,"_21476":121099,"_28165":121100,"_3038":121101},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3569":72626,"_31013":72612,"_5":31368,"_21476":121103,"_28165":121104,"_3038":121105},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3569":72627,"_31013":72612,"_5":31368,"_21476":121107,"_28165":121108,"_3038":121109},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3569":72628,"_31013":72612,"_5":31368,"_21476":121111,"_28165":121112,"_3038":121113},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3569":72629,"_31013":72612,"_5":31368,"_21476":121115,"_28165":121116,"_3038":120216},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3569":72630,"_31013":72612,"_5":31368,"_21476":121118,"_28165":121119,"_3038":121120},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3569":72631,"_31013":72612,"_5":31368,"_21476":121122,"_28165":121123,"_3038":121124},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3569":72632,"_31013":72612,"_5":31368,"_21476":121126,"_28165":121127,"_3038":121128},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3569":72633,"_31013":72612,"_5":31368,"_21476":121130,"_28165":121131,"_3038":121132},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3569":72634,"_31013":72612,"_5":31368,"_21476":121134,"_28165":121135,"_3038":121136},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3569":72635,"_31013":72612,"_5":31368,"_21476":121138,"_28165":121139,"_3038":121140},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3569":72636,"_31013":72612,"_5":31368,"_21476":121142,"_28165":121143,"_3038":121144},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3569":72637,"_31013":72612,"_5":31368,"_21476":121146,"_28165":121147,"_3038":121148},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3569":72638,"_31013":72612,"_5":31368,"_21476":121150,"_28165":121151,"_3038":121152},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3569":72639,"_31013":72612,"_5":31368,"_21476":121154,"_28165":121155,"_3038":121156},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3569":72640,"_31013":72612,"_5":31368,"_21476":121158,"_28165":121159,"_3038":121160},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3569":72641,"_31013":72612,"_5":31368,"_21476":121162,"_28165":121163,"_3038":121164},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3569":72642,"_31013":72612,"_5":31368,"_21476":121166,"_28165":121167,"_3038":121168},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3569":72643,"_31013":72612,"_5":31368,"_21476":121170,"_28165":121171,"_3038":121172},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3569":72644,"_31013":72612,"_5":31368,"_21476":121174,"_28165":121175,"_3038":121176},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3569":72645,"_31013":72612,"_21476":121178,"_5":14750,"_28165":72612,"_3038":121179},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3569":72646,"_31013":72612,"_21476":121181,"_5":14750,"_28165":72612,"_3038":121182},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3569":72647,"_31013":72612,"_21476":121184,"_5":14750,"_28165":72612,"_3038":121185},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3569":72648,"_31013":72612,"_21476":121187,"_5":14750,"_28165":121056,"_3038":121188},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3569":72649,"_31013":72612,"_21476":121190,"_5":14750,"_28165":121056,"_3038":121191},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3569":72650,"_31013":72612,"_21476":121193,"_5":14750,"_28165":121056,"_3038":121194},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3569":72651,"_31013":72612,"_21476":121196,"_5":14750,"_28165":121056,"_3038":121197},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3569":72652,"_31013":72612,"_21476":121199,"_5":14750,"_28165":121056,"_3038":121200},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3569":72653,"_31013":72612,"_21476":121202,"_5":14750,"_28165":121056,"_3038":121203},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3569":72654,"_31013":72612,"_21476":121205,"_5":14750,"_28165":121060,"_3038":121206},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3569":72655,"_31013":72612,"_21476":121208,"_5":14750,"_28165":121060,"_3038":121209},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3569":72656,"_31013":72612,"_21476":121211,"_5":14750,"_28165":121064,"_3038":121212},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3569":72657,"_31013":72612,"_21476":121214,"_5":14750,"_28165":121064,"_3038":121215},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3569":72658,"_31013":72612,"_21476":121217,"_5":14750,"_28165":121064,"_3038":121218},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3569":72659,"_31013":72612,"_21476":121220,"_5":14750,"_28165":121064,"_3038":121221},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3569":72660,"_31013":72612,"_21476":121223,"_5":14750,"_28165":121064,"_3038":121224},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3569":72661,"_31013":72612,"_21476":121226,"_5":14750,"_28165":121064,"_3038":121227},[],"Carga por separado las políticas concedidas a cada principal.",{"_3569":72662,"_31013":72612,"_21476":121229,"_5":14750,"_28165":121064,"_3038":121230},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3569":72663,"_31013":72612,"_21476":121232,"_5":14750,"_28165":121064,"_3038":121233},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3569":72664,"_31013":72612,"_21476":121235,"_5":14750,"_28165":121064,"_3038":121236},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3569":72665,"_31013":72612,"_21476":121238,"_5":14750,"_28165":121064,"_3038":121239},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3569":72666,"_31013":72612,"_21476":121241,"_5":14750,"_28165":121064,"_3038":121242},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3569":72667,"_31013":72612,"_21476":121244,"_5":14750,"_28165":121064,"_3038":121245},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3569":72668,"_31013":72612,"_21476":121247,"_5":14750,"_28165":121068,"_3038":121248},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3569":72669,"_31013":72612,"_21476":121250,"_5":14750,"_28165":121068,"_3038":121251},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3569":72670,"_31013":72612,"_21476":121253,"_5":14750,"_28165":121068,"_3038":121254},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3569":72671,"_31013":72612,"_21476":121256,"_5":14750,"_28165":121068,"_3038":121257},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3569":72672,"_31013":72612,"_21476":121259,"_5":14750,"_28165":121068,"_3038":121260},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3569":72673,"_31013":72612,"_21476":121262,"_5":14750,"_28165":121068,"_3038":121263},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3569":72674,"_31013":72612,"_21476":121265,"_5":14750,"_28165":121068,"_3038":121266},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3569":72675,"_31013":72612,"_21476":121268,"_5":14750,"_28165":121068,"_3038":121269},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3569":72676,"_31013":72612,"_21476":121271,"_5":14750,"_28165":121072,"_3038":121272},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3569":72677,"_31013":72612,"_21476":121274,"_5":14750,"_28165":121072,"_3038":121275},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3569":72678,"_31013":72612,"_21476":121277,"_5":14750,"_28165":121072,"_3038":121278},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3569":72679,"_31013":72612,"_21476":121280,"_5":14750,"_28165":121072,"_3038":121281},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3569":72680,"_31013":72612,"_21476":121283,"_5":14750,"_28165":121072,"_3038":121284},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3569":72681,"_31013":72612,"_21476":121286,"_5":14750,"_28165":121072,"_3038":121287},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3569":72682,"_31013":72612,"_21476":121289,"_5":14750,"_28165":121072,"_3038":121290},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3569":72683,"_31013":72612,"_21476":121292,"_5":14750,"_28165":121072,"_3038":121293},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3569":72684,"_31013":72612,"_21476":121295,"_5":14750,"_28165":121072,"_3038":121296},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3569":72685,"_31013":72612,"_21476":121298,"_5":14750,"_28165":121072,"_3038":121299},[],"Las acciones se dividen en dos grupos:",{"_3569":72686,"_31013":72612,"_21476":121301,"_5":14750,"_28165":121072,"_3038":121302},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3569":72687,"_31013":72612,"_21476":121304,"_5":14750,"_28165":121072,"_3038":121305},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3569":72688,"_31013":72612,"_21476":121307,"_5":14750,"_28165":121072,"_3038":121308},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3569":72689,"_31013":72612,"_21476":121310,"_5":14750,"_28165":121076,"_3038":121311},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3569":72690,"_31013":72612,"_21476":121313,"_5":14750,"_28165":121076,"_3038":121314},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3569":72691,"_31013":72612,"_21476":121316,"_5":14750,"_28165":121076,"_3038":121317},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3569":72692,"_31013":72612,"_21476":121319,"_5":14750,"_28165":121080,"_3038":121320},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3569":72693,"_31013":72612,"_21476":121322,"_5":14750,"_28165":121080,"_3038":121323},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3569":72694,"_31013":72612,"_21476":121325,"_5":14750,"_28165":121080,"_3038":121326},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3569":72695,"_31013":72612,"_21476":121328,"_5":14750,"_28165":121080,"_3038":121329},[],"Los operadores implementados son:",{"_3569":72696,"_31013":72612,"_21476":121331,"_5":14750,"_28165":121080,"_3038":121332},[],"`equals`, para igualdad exacta;",{"_3569":72697,"_31013":72612,"_21476":121334,"_5":14750,"_28165":121080,"_3038":121335},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3569":72698,"_31013":72612,"_21476":121337,"_5":14750,"_28165":121080,"_3038":121338},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3569":72699,"_31013":72612,"_21476":121340,"_5":14750,"_28165":121080,"_3038":121341},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3569":72700,"_31013":72612,"_21476":121343,"_5":14750,"_28165":121084,"_3038":121344},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3569":72701,"_31013":72612,"_21476":121346,"_5":14750,"_28165":121084,"_3038":121347},[],"Los modos disponibles son:",{"_3569":72702,"_31013":72612,"_21476":121349,"_5":14750,"_28165":121084,"_3038":121350},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3569":72703,"_31013":72612,"_21476":121352,"_5":14750,"_28165":121084,"_3038":121353},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3569":72704,"_31013":72612,"_21476":121355,"_5":14750,"_28165":121084,"_3038":121356},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3569":72705,"_31013":72612,"_21476":121358,"_5":14750,"_28165":121084,"_3038":121359},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3569":72706,"_31013":72612,"_21476":121361,"_5":14750,"_28165":121084,"_3038":121362},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3569":72707,"_31013":72612,"_21476":121364,"_5":14750,"_28165":121084,"_3038":121365},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3569":72708,"_31013":72612,"_21476":121367,"_5":14750,"_28165":121088,"_3038":121368},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3569":72709,"_31013":72612,"_21476":121370,"_5":14750,"_28165":121088,"_3038":121371},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3569":72710,"_31013":72612,"_21476":121373,"_5":14750,"_28165":121088,"_3038":121374},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3569":72711,"_31013":72612,"_21476":121376,"_5":14750,"_28165":121088,"_3038":121377},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3569":72712,"_31013":72612,"_21476":121379,"_5":14750,"_28165":121096,"_3038":121380},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3569":72713,"_31013":72612,"_21476":121382,"_5":14750,"_28165":121096,"_3038":121383},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3569":72714,"_31013":72612,"_21476":121385,"_5":14750,"_28165":121100,"_3038":121386},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3569":72715,"_31013":72612,"_21476":121388,"_5":14750,"_28165":121100,"_3038":121389},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3569":72716,"_31013":72612,"_21476":121391,"_5":14750,"_28165":121104,"_3038":121392},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3569":72717,"_31013":72612,"_21476":121394,"_5":14750,"_28165":121104,"_3038":121395},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3569":72718,"_31013":72612,"_21476":121397,"_5":14750,"_28165":121104,"_3038":121398},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3569":72719,"_31013":72612,"_21476":121400,"_5":14750,"_28165":121108,"_3038":121401},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3569":72720,"_31013":72612,"_21476":121403,"_5":14750,"_28165":121108,"_3038":121404},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3569":72721,"_31013":72612,"_21476":121406,"_5":14750,"_28165":121108,"_3038":121407},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3569":72722,"_31013":72612,"_21476":121409,"_5":14750,"_28165":121108,"_3038":121410},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3569":72723,"_31013":72612,"_21476":121412,"_5":14750,"_28165":121108,"_3038":121413},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3569":72724,"_31013":72612,"_21476":121415,"_5":14750,"_28165":121108,"_3038":121416},[],"Ten en cuenta que:",{"_3569":72725,"_31013":72612,"_21476":121418,"_5":14750,"_28165":121108,"_3038":121419},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3569":72726,"_31013":72612,"_21476":121421,"_5":14750,"_28165":121108,"_3038":121422},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3569":72727,"_31013":72612,"_21476":121424,"_5":14750,"_28165":121108,"_3038":121425},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3569":72728,"_31013":72612,"_21476":121427,"_5":14750,"_28165":121112,"_3038":121428},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3569":72729,"_31013":72612,"_21476":121430,"_5":14750,"_28165":121112,"_3038":121431},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3569":72730,"_31013":72612,"_21476":121433,"_5":14750,"_28165":121112,"_3038":121434},[],"acceso completo y de solo lectura a KMS;",{"_3569":72731,"_31013":72612,"_21476":121436,"_5":14750,"_28165":121112,"_3038":121437},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3569":72732,"_31013":72612,"_21476":121439,"_5":14750,"_28165":121112,"_3038":121440},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3569":72733,"_31013":72612,"_21476":121442,"_5":14750,"_28165":121112,"_3038":121443},[],"acceso a la interfaz;",{"_3569":72734,"_31013":72612,"_21476":121445,"_5":14750,"_28165":121112,"_3038":121446},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3569":72735,"_31013":72612,"_21476":121448,"_5":14750,"_28165":121112,"_3038":121449},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3569":72736,"_31013":72612,"_21476":121451,"_5":14750,"_28165":121112,"_3038":121452},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3569":72737,"_31013":72612,"_21476":121454,"_5":14750,"_28165":121116,"_3038":121455},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3569":72738,"_31013":72612,"_21476":121457,"_5":14750,"_28165":121116,"_3038":121458},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3569":72739,"_31013":72612,"_21476":121460,"_5":14750,"_28165":121116,"_3038":121461},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3569":72740,"_31013":72612,"_21476":121463,"_5":14750,"_28165":121119,"_3038":121464},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3569":72741,"_31013":72612,"_21476":121466,"_5":14750,"_28165":121123,"_3038":121467},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3569":72742,"_31013":72612,"_21476":121469,"_5":14750,"_28165":121123,"_3038":121470},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3569":72743,"_31013":72612,"_21476":121472,"_5":14750,"_28165":121127,"_3038":121473},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3569":72744,"_31013":72612,"_21476":121475,"_5":14750,"_28165":121131,"_3038":121476},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3569":72745,"_31013":72612,"_21476":121478,"_5":14750,"_28165":121135,"_3038":121479},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3569":72746,"_31013":72612,"_21476":121481,"_5":14750,"_28165":121139,"_3038":121482},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3569":72747,"_31013":72612,"_21476":121484,"_5":14750,"_28165":121139,"_3038":121485},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3569":72748,"_31013":72612,"_21476":121487,"_5":14750,"_28165":121143,"_3038":121488},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3569":72749,"_31013":72612,"_21476":121490,"_5":14750,"_28165":121143,"_3038":121491},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3569":72750,"_31013":72612,"_21476":121493,"_5":14750,"_28165":121143,"_3038":121494},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3569":72751,"_31013":72612,"_21476":121496,"_5":14750,"_28165":121143,"_3038":121497},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3569":72752,"_31013":72612,"_21476":121499,"_5":14750,"_28165":121143,"_3038":121500},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3569":72753,"_31013":72612,"_21476":121502,"_5":14750,"_28165":121143,"_3038":121503},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3569":72754,"_31013":72612,"_21476":121505,"_5":14750,"_28165":121143,"_3038":121506},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3569":72755,"_31013":72612,"_21476":121508,"_5":14750,"_28165":121143,"_3038":121509},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3569":72756,"_31013":72612,"_21476":121511,"_5":14750,"_28165":121147,"_3038":121512},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3569":72757,"_31013":72612,"_21476":121514,"_5":14750,"_28165":121147,"_3038":121515},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3569":72758,"_31013":72612,"_21476":121517,"_5":14750,"_28165":121147,"_3038":121518},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3569":72759,"_31013":72612,"_21476":121520,"_5":14750,"_28165":121151,"_3038":121521},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3569":72760,"_31013":72612,"_21476":121523,"_5":14750,"_28165":121151,"_3038":121524},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3569":72761,"_31013":72612,"_21476":121526,"_5":14750,"_28165":121151,"_3038":121527},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3569":72762,"_31013":72612,"_21476":121529,"_5":14750,"_28165":121151,"_3038":121530},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3569":72763,"_31013":72612,"_21476":121532,"_5":14750,"_28165":121151,"_3038":121533},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3569":72764,"_31013":72612,"_21476":121535,"_5":14750,"_28165":121151,"_3038":121536},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3569":72765,"_31013":72612,"_21476":121538,"_5":14750,"_28165":121151,"_3038":121539},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3569":72766,"_31013":72612,"_21476":121541,"_5":14750,"_28165":121151,"_3038":121542},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3569":72767,"_31013":72612,"_21476":121544,"_5":14750,"_28165":121159,"_3038":121545},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3569":72768,"_31013":72612,"_21476":121547,"_5":14750,"_28165":121163,"_3038":121548},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3569":72769,"_31013":72612,"_21476":121550,"_5":14750,"_28165":121163,"_3038":121551},[],"que exista un principal activo del tipo correcto;",{"_3569":72770,"_31013":72612,"_21476":121553,"_5":14750,"_28165":121163,"_3038":121554},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3569":72771,"_31013":72612,"_21476":121556,"_5":14750,"_28165":121163,"_3038":121557},[],"que todas las condiciones del principal se cumplan;",{"_3569":72772,"_31013":72612,"_21476":121559,"_5":14750,"_28165":121163,"_3038":121560},[],"que el principal tenga concedida la política esperada;",{"_3569":72773,"_31013":72612,"_21476":121562,"_5":14750,"_28165":121163,"_3038":121563},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3569":72774,"_31013":72612,"_21476":121565,"_5":14750,"_28165":121163,"_3038":121566},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3569":72775,"_31013":72612,"_21476":121568,"_5":14750,"_28165":121163,"_3038":121569},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3569":72776,"_31013":72612,"_21476":121571,"_5":14750,"_28165":121167,"_3038":121572},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3569":72777,"_31013":72612,"_21476":121574,"_5":14750,"_28165":121171,"_3038":121575},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3569":72778,"_31013":72612,"_21476":121577,"_5":14750,"_28165":121175,"_3038":121578},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3569":72779,"_31013":72612,"_21476":121580,"_5":14750,"_28165":121175,"_3038":121581},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3569":72780,"_31013":72780,"_5":15116,"_3038":121583,"_31371":121584,"_21476":121585,"_28165":72780},"Alertas y suscripciones",[50615,121048,121049],[],{"_3569":72781,"_31013":72780,"_21476":121587,"_5":14750,"_28165":72780,"_3038":121588},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3569":72782,"_31013":72780,"_5":31368,"_21476":121590,"_28165":121591,"_3038":121592},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3569":72783,"_31013":72780,"_5":31368,"_21476":121594,"_28165":121595,"_3038":121596},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3569":72784,"_31013":72780,"_5":31368,"_21476":121598,"_28165":121599,"_3038":121600},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3569":72785,"_31013":72780,"_5":31368,"_21476":121602,"_28165":121603,"_3038":121604},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3569":72786,"_31013":72780,"_5":31368,"_21476":121606,"_28165":121607,"_3038":121608},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3569":72787,"_31013":72780,"_5":31368,"_21476":121610,"_28165":121611,"_3038":121612},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3569":72788,"_31013":72780,"_5":31368,"_21476":121614,"_28165":121615,"_3038":121616},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3569":72789,"_31013":72780,"_5":31368,"_21476":121618,"_28165":121619,"_3038":121620},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3569":72790,"_31013":72780,"_5":31368,"_21476":121622,"_28165":121623,"_3038":121624},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3569":72791,"_31013":72780,"_5":31368,"_21476":121626,"_28165":121627,"_3038":121628},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3569":72792,"_31013":72780,"_5":31368,"_21476":121630,"_28165":121631,"_3038":121632},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3569":72793,"_31013":72780,"_21476":121634,"_5":14750,"_28165":72780,"_3038":121635},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3569":72794,"_31013":72780,"_21476":121637,"_5":14750,"_28165":121591,"_3038":121638},[],"Un servicio publica un evento de dominio.",{"_3569":72795,"_31013":72780,"_21476":121640,"_5":14750,"_28165":121591,"_3038":121641},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3569":72796,"_31013":72780,"_21476":121643,"_5":14750,"_28165":121591,"_3038":121644},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3569":72797,"_31013":72780,"_21476":121646,"_5":14750,"_28165":121591,"_3038":121647},[],"Lamassu entrega el evento al canal configurado.",{"_3569":72798,"_31013":72780,"_21476":121649,"_5":14750,"_28165":121591,"_3038":121650},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3569":72799,"_31013":72780,"_21476":121652,"_5":14750,"_28165":121595,"_3038":121653},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3569":72800,"_31013":72780,"_21476":121655,"_5":14750,"_28165":121595,"_3038":121656},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3569":72801,"_31013":72780,"_21476":121658,"_5":14750,"_28165":121595,"_3038":121659},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3569":72802,"_31013":72780,"_21476":121661,"_5":14750,"_28165":121595,"_3038":121662},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3569":72803,"_31013":72780,"_21476":121664,"_5":14750,"_28165":121595,"_3038":121665},[],"`apikey_options` necesita `header` y `key`.",{"_3569":72804,"_31013":72780,"_21476":121667,"_5":14750,"_28165":121595,"_3038":121668},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3569":72805,"_31013":72780,"_21476":121670,"_5":14750,"_28165":121595,"_3038":121671},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3569":72806,"_31013":72780,"_21476":121673,"_5":14750,"_28165":121595,"_3038":121674},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3569":72807,"_31013":72780,"_21476":121676,"_5":14750,"_28165":121603,"_3038":121677},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3569":72808,"_31013":72780,"_21476":121679,"_5":14750,"_28165":121607,"_3038":121680},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3569":72809,"_31013":72780,"_21476":121682,"_5":14750,"_28165":121611,"_3038":121683},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3569":72810,"_31013":72780,"_21476":121685,"_5":14750,"_28165":121611,"_3038":121686},[],"**None** notifica todas las instancias del evento.",{"_3569":72811,"_31013":72780,"_21476":121688,"_5":14750,"_28165":121611,"_3038":121689},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3569":72812,"_31013":72780,"_21476":121691,"_5":14750,"_28165":121611,"_3038":121692},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3569":72813,"_31013":72780,"_21476":121694,"_5":14750,"_28165":121611,"_3038":121695},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3569":72814,"_31013":72780,"_21476":121697,"_5":14750,"_28165":121611,"_3038":121698},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3569":72815,"_31013":72780,"_21476":121700,"_5":14750,"_28165":121611,"_3038":121701},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3569":72816,"_31013":72780,"_21476":121703,"_5":14750,"_28165":121615,"_3038":121704},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3569":72817,"_31013":72780,"_21476":121706,"_5":14750,"_28165":121619,"_3038":121707},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3569":72818,"_31013":72780,"_21476":121709,"_5":14750,"_28165":121619,"_3038":121710},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3569":72819,"_31013":72780,"_21476":121712,"_5":14750,"_28165":121619,"_3038":121713},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3569":72820,"_31013":72780,"_21476":121715,"_5":14750,"_28165":121619,"_3038":121716},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3569":72821,"_31013":72780,"_21476":121718,"_5":14750,"_28165":121619,"_3038":121719},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3569":72822,"_31013":72780,"_21476":121721,"_5":14750,"_28165":121619,"_3038":121722},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3569":72823,"_31013":72780,"_21476":121724,"_5":14750,"_28165":121619,"_3038":121725},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3569":72824,"_31013":72780,"_21476":121727,"_5":14750,"_28165":121619,"_3038":121728},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3569":72825,"_31013":72780,"_21476":121730,"_5":14750,"_28165":121623,"_3038":121731},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3569":72826,"_31013":72780,"_21476":121733,"_5":14750,"_28165":121623,"_3038":121734},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3569":72827,"_31013":72780,"_21476":121736,"_5":14750,"_28165":121623,"_3038":121737},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3569":72828,"_31013":72780,"_21476":121739,"_5":14750,"_28165":121623,"_3038":121740},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3569":72829,"_31013":72780,"_21476":121742,"_5":14750,"_28165":121623,"_3038":121743},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3569":72830,"_31013":72780,"_21476":121745,"_5":14750,"_28165":121623,"_3038":121746},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3569":72831,"_31013":72780,"_21476":121748,"_5":14750,"_28165":121623,"_3038":121749},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3569":72832,"_31013":72780,"_21476":121751,"_5":14750,"_28165":121623,"_3038":121752},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3569":72833,"_31013":72780,"_21476":121754,"_5":14750,"_28165":121627,"_3038":121755},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3569":72834,"_31013":72780,"_21476":121757,"_5":14750,"_28165":121627,"_3038":121758},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3569":72835,"_31013":72780,"_21476":121760,"_5":14750,"_28165":121631,"_3038":121761},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3569":72836,"_31013":72780,"_21476":121763,"_5":14750,"_28165":121631,"_3038":121764},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3569":72837,"_31013":72780,"_21476":121766,"_5":14750,"_28165":121631,"_3038":121767},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3569":72838,"_31013":72780,"_21476":121769,"_5":14750,"_28165":121631,"_3038":121770},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3569":72839,"_31013":72780,"_21476":121772,"_5":14750,"_28165":121631,"_3038":121773},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3569":72840,"_31013":72780,"_21476":121775,"_5":14750,"_28165":121631,"_3038":121776},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3569":72841,"_31013":72780,"_21476":121778,"_5":14750,"_28165":121631,"_3038":121779},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3569":72842,"_31013":72780,"_21476":121781,"_5":14750,"_28165":121631,"_3038":121782},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3569":72843,"_31013":72780,"_21476":121784,"_5":14750,"_28165":121631,"_3038":121785},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3569":72844,"_31013":72844,"_5":15116,"_3038":121787,"_31371":121788,"_21476":121789,"_28165":72844},"Registros de auditoría",[50615,121048,121049],[],{"_3569":72845,"_31013":72844,"_21476":121791,"_5":14750,"_28165":72844,"_3038":121792},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3569":72846,"_31013":72844,"_5":31368,"_21476":121794,"_28165":121795,"_3038":121796},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3569":72847,"_31013":72844,"_5":31368,"_21476":121798,"_28165":121799,"_3038":121800},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3569":72848,"_31013":72844,"_5":31368,"_21476":121802,"_28165":121803,"_3038":121804},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3569":72849,"_31013":72844,"_5":31368,"_21476":121806,"_28165":121807,"_3038":121808},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3569":72850,"_31013":72844,"_5":31368,"_21476":121810,"_28165":121811,"_3038":121812},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3569":72851,"_31013":72844,"_5":31368,"_21476":121814,"_28165":121815,"_3038":121816},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3569":72852,"_31013":72844,"_5":31368,"_21476":121818,"_28165":121819,"_3038":121820},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3569":72853,"_31013":72844,"_5":31368,"_21476":121822,"_28165":121823,"_3038":121824},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3569":72854,"_31013":72844,"_5":31368,"_21476":121826,"_28165":121827,"_3038":121828},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3569":72855,"_31013":72844,"_5":31368,"_21476":121830,"_28165":121831,"_3038":121832},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3569":72856,"_31013":72844,"_5":31368,"_21476":121834,"_28165":121835,"_3038":121836},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3569":72857,"_31013":72844,"_21476":121838,"_5":14750,"_28165":72844,"_3038":121839},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3569":72858,"_31013":72844,"_21476":121841,"_5":14750,"_28165":121795,"_3038":121842},[],"El cuerpo de auditoría incluye:",{"_3569":72859,"_31013":72844,"_21476":121844,"_5":14750,"_28165":121795,"_3038":121845},[],"input: datos recibidos por la operación;",{"_3569":72860,"_31013":72844,"_21476":121847,"_5":14750,"_28165":121795,"_3038":121848},[],"has\\_error: indica si el servicio devolvió un error;",{"_3569":72861,"_31013":72844,"_21476":121850,"_5":14750,"_28165":121795,"_3038":121851},[],"output: resultado producido o mensaje de error;",{"_3569":72862,"_31013":72844,"_21476":121853,"_5":14750,"_28165":121795,"_3038":121854},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3569":72863,"_31013":72844,"_21476":121856,"_5":14750,"_28165":121795,"_3038":121857},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3569":72864,"_31013":72844,"_21476":121859,"_5":14750,"_28165":121795,"_3038":121860},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3569":72865,"_31013":72844,"_21476":121862,"_5":14750,"_28165":121799,"_3038":121863},[],"El backend aplica auditoría a mutaciones de:",{"_3569":72866,"_31013":72844,"_21476":121865,"_5":14750,"_28165":121799,"_3038":121866},[],"autoridades, certificados y perfiles de emisión;",{"_3569":72867,"_31013":72844,"_21476":121868,"_5":14750,"_28165":121799,"_3038":121869},[],"claves y motores KMS;",{"_3569":72868,"_31013":72844,"_21476":121871,"_5":14750,"_28165":121799,"_3038":121872},[],"dispositivos e identidades;",{"_3569":72869,"_31013":72844,"_21476":121874,"_5":14750,"_28165":121799,"_3038":121875},[],"DMS y operaciones de enrolamiento;",{"_3569":72870,"_31013":72844,"_21476":121877,"_5":14750,"_28165":121799,"_3038":121878},[],"funciones de validación y CRL;",{"_3569":72871,"_31013":72844,"_21476":121880,"_5":14750,"_28165":121799,"_3038":121881},[],"principales, políticas y concesiones de autorización.",{"_3569":72872,"_31013":72844,"_21476":121883,"_5":14750,"_28165":121799,"_3038":121884},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3569":72873,"_31013":72844,"_21476":121886,"_5":14750,"_28165":121803,"_3038":121887},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3569":72874,"_31013":72844,"_21476":121889,"_5":14750,"_28165":121803,"_3038":121890},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3569":72875,"_31013":72844,"_21476":121892,"_5":14750,"_28165":121803,"_3038":121893},[],"Diseña el consumidor para:",{"_3569":72876,"_31013":72844,"_21476":121895,"_5":14750,"_28165":121803,"_3038":121896},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3569":72877,"_31013":72844,"_21476":121898,"_5":14750,"_28165":121803,"_3038":121899},[],"conservar el CloudEvent completo sin modificar;",{"_3569":72878,"_31013":72844,"_21476":121901,"_5":14750,"_28165":121803,"_3038":121902},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3569":72879,"_31013":72844,"_21476":121904,"_5":14750,"_28165":121803,"_3038":121905},[],"cifrar en tránsito y en reposo;",{"_3569":72880,"_31013":72844,"_21476":121907,"_5":14750,"_28165":121803,"_3038":121908},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3569":72881,"_31013":72844,"_21476":121910,"_5":14750,"_28165":121803,"_3038":121911},[],"aplicar una política explícita de retención y legal hold;",{"_3569":72882,"_31013":72844,"_21476":121913,"_5":14750,"_28165":121803,"_3038":121914},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3569":72883,"_31013":72844,"_21476":121916,"_5":14750,"_28165":121807,"_3038":121917},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3569":72884,"_31013":72844,"_21476":121919,"_5":14750,"_28165":121807,"_3038":121920},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3569":72885,"_31013":72844,"_21476":121922,"_5":14750,"_28165":121815,"_3038":121923},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3569":72886,"_31013":72844,"_21476":121925,"_5":14750,"_28165":121819,"_3038":121926},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3569":72887,"_31013":72844,"_21476":121928,"_5":14750,"_28165":121823,"_3038":121929},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3569":72888,"_31013":72844,"_21476":121931,"_5":14750,"_28165":121827,"_3038":121932},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3569":72889,"_31013":72844,"_21476":121934,"_5":14750,"_28165":121831,"_3038":121935},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3569":72890,"_31013":72844,"_21476":121937,"_5":14750,"_28165":121835,"_3038":121938},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3569":72891,"_31013":72844,"_21476":121940,"_5":14750,"_28165":121835,"_3038":121941},[],"aparece un evento de auditoría correcto;",{"_3569":72892,"_31013":72844,"_21476":121943,"_5":14750,"_28165":121835,"_3038":121944},[],"el principal coincide con la identidad utilizada;",{"_3569":72893,"_31013":72844,"_21476":121946,"_5":14750,"_28165":121835,"_3038":121947},[],"el consumidor lo persiste una sola vez;",{"_3569":72894,"_31013":72844,"_21476":121949,"_5":14750,"_28165":121835,"_3038":121950},[],"puede recuperarse por recurso, actor y periodo;",{"_3569":72895,"_31013":72844,"_21476":121952,"_5":14750,"_28165":121835,"_3038":121953},[],"una interrupción del consumidor produce una alerta.",{"_3569":72896,"_31013":72844,"_21476":121955,"_5":14750,"_28165":121835,"_3038":121956},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3569":72897,"_31013":72897,"_5":15116,"_3038":121958,"_31371":121959,"_21476":121960,"_28165":72897},"Arquitectura de la plataforma",[50615,121048],[],{"_3569":72898,"_31013":72897,"_21476":121962,"_5":14750,"_28165":72897,"_3038":121963},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3569":72899,"_31013":72897,"_5":31368,"_21476":121965,"_28165":121966,"_3038":121967},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3569":72900,"_31013":72897,"_5":31368,"_21476":121969,"_28165":121970,"_3038":121971},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3569":72901,"_31013":72897,"_5":31368,"_21476":121973,"_28165":121974,"_3038":121975},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3569":72902,"_31013":72897,"_5":31368,"_21476":121977,"_28165":121978,"_3038":121979},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3569":72903,"_31013":72897,"_5":31368,"_21476":121981,"_28165":121982,"_3038":121983},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3569":72904,"_31013":72897,"_21476":121985,"_5":14750,"_28165":72897,"_3038":121986},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3569":72905,"_31013":72897,"_21476":121988,"_5":14750,"_28165":72897,"_3038":121989},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3569":72906,"_31013":72897,"_21476":121991,"_5":14750,"_28165":121966,"_3038":121992},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3569":72907,"_31013":72897,"_21476":121994,"_5":14750,"_28165":121970,"_3038":121995},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3569":72908,"_31013":72897,"_21476":121997,"_5":14750,"_28165":121974,"_3038":121998},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3569":72909,"_31013":72897,"_21476":122000,"_5":14750,"_28165":121978,"_3038":122001},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3569":72910,"_31013":72897,"_21476":122003,"_5":14750,"_28165":121982,"_3038":122004},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3569":72911,"_31013":72911,"_5":15116,"_3038":122006,"_31371":122007,"_21476":122008,"_28165":72911},"Cómo funciona Lamassu",[50615,121048],[],{"_3569":72912,"_31013":72911,"_21476":122010,"_5":14750,"_28165":72911,"_3038":122011},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3569":72913,"_31013":72911,"_5":31368,"_21476":122013,"_28165":122014,"_3038":122015},[],"/docs/pr-preview/pr-61/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3569":72914,"_31013":72911,"_5":31368,"_21476":122017,"_28165":122018,"_3038":122019},[],"/docs/pr-preview/pr-61/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3569":72915,"_31013":72911,"_21476":122021,"_5":14750,"_28165":72911,"_3038":122022},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3569":72916,"_31013":72911,"_21476":122024,"_5":14750,"_28165":122014,"_3038":122025},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3569":72917,"_31013":72911,"_21476":122027,"_5":14750,"_28165":122014,"_3038":122028},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3569":72918,"_31013":72911,"_21476":122030,"_5":14750,"_28165":122014,"_3038":122031},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3569":72919,"_31013":72911,"_21476":122033,"_5":14750,"_28165":122014,"_3038":122034},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3569":72920,"_31013":72911,"_21476":122036,"_5":14750,"_28165":122014,"_3038":122037},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3569":72921,"_31013":72911,"_21476":122039,"_5":14750,"_28165":122018,"_3038":122040},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3569":72922,"_31013":72911,"_21476":122042,"_5":14750,"_28165":122018,"_3038":122043},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3569":72923,"_31013":72911,"_21476":122045,"_5":14750,"_28165":122018,"_3038":122046},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3569":72924,"_31013":72911,"_21476":122048,"_5":14750,"_28165":122018,"_3038":122049},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3569":72925,"_31013":72911,"_21476":122051,"_5":14750,"_28165":122018,"_3038":122052},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3569":72926,"_31013":72911,"_21476":122054,"_5":14750,"_28165":122018,"_3038":122055},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3569":72927,"_31013":72911,"_21476":122057,"_5":14750,"_28165":122018,"_3038":122058},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3569":72928,"_31013":72928,"_5":15116,"_3038":122060,"_31371":122061,"_21476":122062,"_28165":72928},"Dispositivos e identidades",[50615,121048,53104,122060],[],{"_3569":72929,"_31013":72928,"_21476":122064,"_5":14750,"_28165":72928,"_3038":122065},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3569":72930,"_31013":72928,"_5":31368,"_21476":122067,"_28165":122068,"_3038":122069},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3569":72931,"_31013":72928,"_5":31368,"_21476":122071,"_28165":122072,"_3038":122073},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3569":72932,"_31013":72928,"_5":31368,"_21476":122075,"_28165":122076,"_3038":122077},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3569":72933,"_31013":72928,"_5":31368,"_21476":122079,"_28165":122080,"_3038":122081},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3569":72934,"_31013":72928,"_5":31368,"_21476":122083,"_28165":122084,"_3038":122085},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3569":72935,"_31013":72928,"_5":31368,"_21476":122087,"_28165":122088,"_3038":122089},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3569":72936,"_31013":72928,"_5":31368,"_21476":122091,"_28165":122092,"_3038":122093},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3569":72937,"_31013":72928,"_5":31368,"_21476":122095,"_28165":122096,"_3038":122097},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3569":72938,"_31013":72928,"_5":31368,"_21476":122099,"_28165":122100,"_3038":122101},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3569":72939,"_31013":72928,"_5":31368,"_21476":122103,"_28165":122104,"_3038":122105},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3569":72940,"_31013":72928,"_5":31368,"_21476":122107,"_28165":122108,"_3038":122109},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3569":72941,"_31013":72928,"_21476":122111,"_5":14750,"_28165":72928,"_3038":122112},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3569":72942,"_31013":72928,"_21476":122114,"_5":14750,"_28165":72928,"_3038":122115},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3569":72943,"_31013":72928,"_21476":122117,"_5":14750,"_28165":122068,"_3038":122118},[],"Vista operativa",{"_3569":72944,"_31013":72928,"_21476":122120,"_5":14750,"_28165":122068,"_3038":122121},[],"Interpretación",{"_3569":72945,"_31013":72928,"_21476":122123,"_5":14750,"_28165":122068,"_3038":53167},[],{"_3569":72946,"_31013":72928,"_21476":122125,"_5":14750,"_28165":122068,"_3038":122126},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3569":72947,"_31013":72928,"_21476":122128,"_5":14750,"_28165":122068,"_3038":53173},[],{"_3569":72948,"_31013":72928,"_21476":122130,"_5":14750,"_28165":122068,"_3038":122131},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3569":72949,"_31013":72928,"_21476":122133,"_5":14750,"_28165":122068,"_3038":53179},[],{"_3569":72950,"_31013":72928,"_21476":122135,"_5":14750,"_28165":122068,"_3038":122136},[],"La identidad está en la ventana operativa de renovación.",{"_3569":72951,"_31013":72928,"_21476":122138,"_5":14750,"_28165":122068,"_3038":53185},[],{"_3569":72952,"_31013":72928,"_21476":122140,"_5":14750,"_28165":122068,"_3038":122141},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3569":72953,"_31013":72928,"_21476":122143,"_5":14750,"_28165":122068,"_3038":53191},[],{"_3569":72954,"_31013":72928,"_21476":122145,"_5":14750,"_28165":122068,"_3038":122146},[],"La identidad ha vencido.",{"_3569":72955,"_31013":72928,"_21476":122148,"_5":14750,"_28165":122068,"_3038":53197},[],{"_3569":72956,"_31013":72928,"_21476":122150,"_5":14750,"_28165":122068,"_3038":122151},[],"La identidad está marcada como revocada.",{"_3569":72957,"_31013":72928,"_21476":122153,"_5":14750,"_28165":122068,"_3038":53203},[],{"_3569":72958,"_31013":72928,"_21476":122155,"_5":14750,"_28165":122068,"_3038":122156},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3569":72959,"_31013":72928,"_21476":122158,"_5":14750,"_28165":122068,"_3038":122159},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3569":72960,"_31013":72928,"_21476":122161,"_5":14750,"_28165":122072,"_3038":122162},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3569":72961,"_31013":72928,"_21476":122164,"_5":14750,"_28165":122072,"_3038":122165},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3569":72962,"_31013":72928,"_21476":122167,"_5":14750,"_28165":122072,"_3038":122168},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3569":72963,"_31013":72928,"_21476":122170,"_5":14750,"_28165":122072,"_3038":122171},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3569":72964,"_31013":72928,"_21476":122173,"_5":14750,"_28165":122076,"_3038":122174},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3569":72965,"_31013":72928,"_21476":122176,"_5":14750,"_28165":122080,"_3038":122177},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3569":72966,"_31013":72928,"_21476":122179,"_5":14750,"_28165":122084,"_3038":122180},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3569":72967,"_31013":72928,"_21476":122182,"_5":14750,"_28165":122088,"_3038":122183},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3569":72968,"_31013":72928,"_21476":122185,"_5":14750,"_28165":122092,"_3038":122186},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3569":72969,"_31013":72928,"_21476":122188,"_5":14750,"_28165":122092,"_3038":122189},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3569":72970,"_31013":72928,"_21476":122191,"_5":14750,"_28165":122096,"_3038":122192},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3569":72971,"_31013":72928,"_21476":122194,"_5":14750,"_28165":122096,"_3038":122195},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3569":72972,"_31013":72928,"_21476":122197,"_5":14750,"_28165":122096,"_3038":122198},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3569":72973,"_31013":72928,"_21476":122200,"_5":14750,"_28165":122096,"_3038":122201},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3569":72974,"_31013":72928,"_21476":122203,"_5":14750,"_28165":122096,"_3038":122204},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3569":72975,"_31013":72928,"_21476":122206,"_5":14750,"_28165":122096,"_3038":122207},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3569":72976,"_31013":72928,"_21476":122209,"_5":14750,"_28165":122100,"_3038":122210},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3569":72977,"_31013":72928,"_21476":122212,"_5":14750,"_28165":122100,"_3038":122213},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3569":72978,"_31013":72928,"_21476":122215,"_5":14750,"_28165":122104,"_3038":122216},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3569":72979,"_31013":72928,"_21476":122218,"_5":14750,"_28165":122104,"_3038":122219},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3569":72980,"_31013":72928,"_21476":122221,"_5":14750,"_28165":122104,"_3038":122222},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3569":72981,"_31013":72928,"_21476":122224,"_5":14750,"_28165":122104,"_3038":122225},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3569":72982,"_31013":72928,"_21476":122227,"_5":14750,"_28165":122108,"_3038":122228},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3569":72983,"_31013":72928,"_21476":122230,"_5":14750,"_28165":122108,"_3038":122231},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3569":72984,"_31013":72984,"_5":15116,"_3038":122233,"_31371":122234,"_21476":122236,"_28165":72984},"Identidad inicial y autenticación",[50615,121048,53104,122060,122235],"Enrolamiento con PKI",[],{"_3569":72985,"_31013":72984,"_21476":122238,"_5":14750,"_28165":72984,"_3038":122239},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3569":72986,"_31013":72984,"_5":31368,"_21476":122241,"_28165":122242,"_3038":122243},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3569":72987,"_31013":72984,"_5":31368,"_21476":122245,"_28165":122246,"_3038":122247},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3569":72988,"_31013":72984,"_5":31368,"_21476":122249,"_28165":122250,"_3038":122251},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3569":72989,"_31013":72984,"_5":31368,"_21476":122253,"_28165":122254,"_3038":122255},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3569":72990,"_31013":72984,"_5":31368,"_21476":122257,"_28165":122258,"_3038":122259},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3569":72991,"_31013":72984,"_21476":122261,"_5":14750,"_28165":72984,"_3038":122262},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3569":72992,"_31013":72984,"_21476":122264,"_5":14750,"_28165":122242,"_3038":122265},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3569":72993,"_31013":72984,"_21476":122267,"_5":14750,"_28165":122242,"_3038":122268},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3569":72994,"_31013":72984,"_21476":122270,"_5":14750,"_28165":122246,"_3038":122271},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3569":72995,"_31013":72984,"_21476":122273,"_5":14750,"_28165":122246,"_3038":122274},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3569":72996,"_31013":72984,"_21476":122276,"_5":14750,"_28165":122246,"_3038":122277},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3569":72997,"_31013":72984,"_21476":122279,"_5":14750,"_28165":122250,"_3038":122280},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3569":72998,"_31013":72984,"_21476":122282,"_5":14750,"_28165":122250,"_3038":122283},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3569":72999,"_31013":72984,"_21476":122285,"_5":14750,"_28165":122254,"_3038":122286},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3569":73000,"_31013":72984,"_21476":122288,"_5":14750,"_28165":122254,"_3038":122289},[],"Ejemplo de cuerpo:",{"_3569":73001,"_31013":72984,"_21476":122291,"_5":14750,"_28165":122254,"_3038":122292},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3569":73002,"_31013":72984,"_21476":122294,"_5":14750,"_28165":122254,"_3038":122295},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3569":73003,"_31013":72984,"_21476":122297,"_5":14750,"_28165":122254,"_3038":122298},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3569":73004,"_31013":72984,"_21476":122300,"_5":14750,"_28165":122254,"_3038":122301},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3569":73005,"_31013":72984,"_21476":122303,"_5":14750,"_28165":122258,"_3038":122304},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3569":73006,"_31013":72984,"_21476":122306,"_5":14750,"_28165":122258,"_3038":122307},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3569":73007,"_31013":73007,"_5":15116,"_3038":122309,"_31371":122310,"_21476":122311,"_28165":73007},"Configura y opera el DMS",[50615,121048,53104,122060,122235],[],{"_3569":73008,"_31013":73007,"_21476":122313,"_5":14750,"_28165":73007,"_3038":122314},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3569":73009,"_31013":73007,"_5":31368,"_21476":122316,"_28165":122317,"_3038":119619},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3569":73010,"_31013":73007,"_5":31368,"_21476":122319,"_28165":122320,"_3038":122321},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3569":73011,"_31013":73007,"_5":31368,"_21476":122323,"_28165":122324,"_3038":122325},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3569":73012,"_31013":73007,"_5":31368,"_21476":122327,"_28165":122328,"_3038":122329},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3569":73013,"_31013":73007,"_5":31368,"_21476":122331,"_28165":122332,"_3038":122333},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3569":73014,"_31013":73007,"_5":31368,"_21476":122335,"_28165":122336,"_3038":122337},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3569":73015,"_31013":73007,"_5":31368,"_21476":122339,"_28165":122340,"_3038":122341},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3569":73016,"_31013":73007,"_5":31368,"_21476":122343,"_28165":122344,"_3038":122345},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3569":73017,"_31013":73007,"_5":31368,"_21476":122347,"_28165":122348,"_3038":53399},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3569":73018,"_31013":73007,"_5":31368,"_21476":122350,"_28165":122351,"_3038":53403},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3569":73019,"_31013":73007,"_5":31368,"_21476":122353,"_28165":122354,"_3038":122355},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3569":73020,"_31013":73007,"_5":31368,"_21476":122357,"_28165":122358,"_3038":122359},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3569":73021,"_31013":73007,"_5":31368,"_21476":122361,"_28165":122362,"_3038":122363},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3569":73022,"_31013":73007,"_5":31368,"_21476":122365,"_28165":122366,"_3038":122367},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3569":73023,"_31013":73007,"_5":31368,"_21476":122369,"_28165":122370,"_3038":53423},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3569":73024,"_31013":73007,"_5":31368,"_21476":122372,"_28165":122373,"_3038":122374},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3569":73025,"_31013":73007,"_5":31368,"_21476":122376,"_28165":122377,"_3038":122378},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3569":73026,"_31013":73007,"_5":31368,"_21476":122380,"_28165":122381,"_3038":122382},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3569":73027,"_31013":73007,"_21476":122384,"_5":14750,"_28165":73007,"_3038":122385},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3569":73028,"_31013":73007,"_21476":122387,"_5":14750,"_28165":122317,"_3038":122388},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3569":73029,"_31013":73007,"_21476":122390,"_5":14750,"_28165":122317,"_3038":122391},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3569":73030,"_31013":73007,"_21476":122393,"_5":14750,"_28165":122320,"_3038":122394},[],"Sigue el recorrido interactivo para configurar un DMS para EST. El ejemplo establece **Name** en `DMS Showcase`, de donde se deriva el identificador `dms-showcase` usado en las URLs EST, y selecciona dos CAs preparadas de antemano: **DMS Enrollment CA** firma las identidades de los dispositivos y **DMS Bootstrap CA** valida la credencial inicial. Los valores son de este ejemplo; usa nombres y CAs apropiados para tu flota.",{"_3569":73031,"_31013":73007,"_21476":122396,"_5":14750,"_28165":122324,"_3038":122397},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3569":73032,"_31013":73007,"_21476":122399,"_5":14750,"_28165":122328,"_3038":122400},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3569":73033,"_31013":73007,"_21476":122402,"_5":14750,"_28165":122332,"_3038":122403},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3569":73034,"_31013":73007,"_21476":122405,"_5":14750,"_28165":122336,"_3038":122406},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3569":73035,"_31013":73007,"_21476":122408,"_5":14750,"_28165":122340,"_3038":122409},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3569":73036,"_31013":73007,"_21476":122411,"_5":14750,"_28165":122348,"_3038":122412},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3569":73037,"_31013":73007,"_21476":122414,"_5":14750,"_28165":122348,"_3038":122415},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3569":73038,"_31013":73007,"_21476":122417,"_5":14750,"_28165":122351,"_3038":122418},[],"Campo de `settings.enrollment_settings`",{"_3569":73039,"_31013":73007,"_21476":122420,"_5":14750,"_28165":122351,"_3038":122421},[],"Decisión",{"_3569":73040,"_31013":73007,"_21476":122423,"_5":14750,"_28165":122351,"_3038":53477},[],{"_3569":73041,"_31013":73007,"_21476":122425,"_5":14750,"_28165":122351,"_3038":122426},[],"`EST_RFC7030` para estas operaciones.",{"_3569":73042,"_31013":73007,"_21476":122428,"_5":14750,"_28165":122351,"_3038":53483},[],{"_3569":73043,"_31013":73007,"_21476":122430,"_5":14750,"_28165":122351,"_3038":122431},[],"ID de la CA que firmará.",{"_3569":73044,"_31013":73007,"_21476":122433,"_5":14750,"_28165":122351,"_3038":53489},[],{"_3569":73045,"_31013":73007,"_21476":122435,"_5":14750,"_28165":122351,"_3038":122436},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3569":73046,"_31013":73007,"_21476":122438,"_5":14750,"_28165":122351,"_3038":53495},[],{"_3569":73047,"_31013":73007,"_21476":122440,"_5":14750,"_28165":122351,"_3038":122441},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3569":73048,"_31013":73007,"_21476":122443,"_5":14750,"_28165":122351,"_3038":53501},[],{"_3569":73049,"_31013":73007,"_21476":122445,"_5":14750,"_28165":122351,"_3038":122446},[],"Uno de los cuatro modos de autenticación.",{"_3569":73050,"_31013":73007,"_21476":122448,"_5":14750,"_28165":122351,"_3038":122449},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3569":73051,"_31013":73007,"_21476":122451,"_5":14750,"_28165":122354,"_3038":122452},[],"Los bloques son independientes:",{"_3569":73052,"_31013":73007,"_21476":122454,"_5":14750,"_28165":122354,"_3038":122455},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3569":73053,"_31013":73007,"_21476":122457,"_5":14750,"_28165":122354,"_3038":122458},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3569":73054,"_31013":73007,"_21476":122460,"_5":14750,"_28165":122354,"_3038":53519},[],{"_3569":73055,"_31013":73007,"_21476":122462,"_5":14750,"_28165":122354,"_3038":122463},[],"Control aplicado en la operación configurada",{"_3569":73056,"_31013":73007,"_21476":122465,"_5":14750,"_28165":122354,"_3038":53525},[],{"_3569":73057,"_31013":73007,"_21476":122467,"_5":14750,"_28165":122354,"_3038":122468},[],"Validación del certificado presentado.",{"_3569":73058,"_31013":73007,"_21476":122470,"_5":14750,"_28165":122354,"_3038":53531},[],{"_3569":73059,"_31013":73007,"_21476":122472,"_5":14750,"_28165":122354,"_3038":122473},[],"Autorización del webhook configurado.",{"_3569":73060,"_31013":73007,"_21476":122475,"_5":14750,"_28165":122354,"_3038":53537},[],{"_3569":73061,"_31013":73007,"_21476":122477,"_5":14750,"_28165":122354,"_3038":122478},[],"Validación del certificado y, después, aprobación del webhook.",{"_3569":73062,"_31013":73007,"_21476":122480,"_5":14750,"_28165":122354,"_3038":53543},[],{"_3569":73063,"_31013":73007,"_21476":122482,"_5":14750,"_28165":122354,"_3038":122483},[],"Sin autenticación del solicitante por el DMS.",{"_3569":73064,"_31013":73007,"_21476":122485,"_5":14750,"_28165":122354,"_3038":122486},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3569":73065,"_31013":73007,"_21476":122488,"_5":14750,"_28165":122354,"_3038":122489},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3569":73066,"_31013":73007,"_21476":122491,"_5":14750,"_28165":122354,"_3038":122492},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3569":73067,"_31013":73007,"_21476":122494,"_5":14750,"_28165":122354,"_3038":122495},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3569":73068,"_31013":73007,"_21476":122497,"_5":14750,"_28165":122358,"_3038":122498},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3569":73069,"_31013":73007,"_21476":122500,"_5":14750,"_28165":122358,"_3038":122501},[],"Campo de `external_webhook_settings`",{"_3569":73070,"_31013":73007,"_21476":122503,"_5":14750,"_28165":122358,"_3038":122421},[],{"_3569":73071,"_31013":73007,"_21476":122505,"_5":14750,"_28165":122358,"_3038":53569},[],{"_3569":73072,"_31013":73007,"_21476":122507,"_5":14750,"_28165":122358,"_3038":122508},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3569":73073,"_31013":73007,"_21476":122510,"_5":14750,"_28165":122358,"_3038":53575},[],{"_3569":73074,"_31013":73007,"_21476":122512,"_5":14750,"_28165":122358,"_3038":122513},[],"`POST` o `PUT`; `POST` por defecto.",{"_3569":73075,"_31013":73007,"_21476":122515,"_5":14750,"_28165":122358,"_3038":53581},[],{"_3569":73076,"_31013":73007,"_21476":122517,"_5":14750,"_28165":122358,"_3038":122518},[],"Etiqueta usada en los logs del servicio.",{"_3569":73077,"_31013":73007,"_21476":122520,"_5":14750,"_28165":122358,"_3038":53587},[],{"_3569":73078,"_31013":73007,"_21476":122522,"_5":14750,"_28165":122358,"_3038":122523},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3569":73079,"_31013":73007,"_21476":122525,"_5":14750,"_28165":122358,"_3038":53593},[],{"_3569":73080,"_31013":73007,"_21476":122527,"_5":14750,"_28165":122358,"_3038":122528},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3569":73081,"_31013":73007,"_21476":122530,"_5":14750,"_28165":122358,"_3038":53599},[],{"_3569":73082,"_31013":73007,"_21476":122532,"_5":14750,"_28165":122358,"_3038":122533},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3569":73083,"_31013":73007,"_21476":122535,"_5":14750,"_28165":122358,"_3038":53605},[],{"_3569":73084,"_31013":73007,"_21476":122537,"_5":14750,"_28165":122358,"_3038":122538},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3569":73085,"_31013":73007,"_21476":122540,"_5":14750,"_28165":122358,"_3038":53611},[],{"_3569":73086,"_31013":73007,"_21476":122542,"_5":14750,"_28165":122358,"_3038":122543},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3569":73087,"_31013":73007,"_21476":122545,"_5":14750,"_28165":122358,"_3038":53617},[],{"_3569":73088,"_31013":73007,"_21476":122547,"_5":14750,"_28165":122358,"_3038":122548},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3569":73089,"_31013":73007,"_21476":122550,"_5":14750,"_28165":122358,"_3038":53623},[],{"_3569":73090,"_31013":73007,"_21476":122552,"_5":14750,"_28165":122358,"_3038":122553},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3569":73091,"_31013":73007,"_21476":122555,"_5":14750,"_28165":122358,"_3038":122556},[],"Reglas de esa configuración:",{"_3569":73092,"_31013":73007,"_21476":122558,"_5":14750,"_28165":122358,"_3038":122559},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3569":73093,"_31013":73007,"_21476":122561,"_5":14750,"_28165":122358,"_3038":122562},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3569":73094,"_31013":73007,"_21476":122564,"_5":14750,"_28165":122358,"_3038":122565},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3569":73095,"_31013":73007,"_21476":122567,"_5":14750,"_28165":122358,"_3038":122568},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3569":73096,"_31013":73007,"_21476":122570,"_5":14750,"_28165":122358,"_3038":122571},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3569":73097,"_31013":73007,"_21476":122573,"_5":14750,"_28165":122358,"_3038":122574},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3569":73098,"_31013":73007,"_21476":122576,"_5":14750,"_28165":122358,"_3038":122577},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3569":73099,"_31013":73007,"_21476":122579,"_5":14750,"_28165":122358,"_3038":122580},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3569":73100,"_31013":73007,"_21476":122582,"_5":14750,"_28165":122358,"_3038":122583},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3569":73101,"_31013":73007,"_21476":122585,"_5":14750,"_28165":122362,"_3038":122586},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3569":73102,"_31013":73007,"_21476":122588,"_5":14750,"_28165":122366,"_3038":122589},[],"Campo de `settings.reenrollment_settings`",{"_3569":73103,"_31013":73007,"_21476":122591,"_5":14750,"_28165":122366,"_3038":122592},[],"Función",{"_3569":73104,"_31013":73007,"_21476":122594,"_5":14750,"_28165":122366,"_3038":53667},[],{"_3569":73105,"_31013":73007,"_21476":122596,"_5":14750,"_28165":122366,"_3038":122597},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3569":73106,"_31013":73007,"_21476":122599,"_5":14750,"_28165":122366,"_3038":53673},[],{"_3569":73107,"_31013":73007,"_21476":122601,"_5":14750,"_28165":122366,"_3038":122602},[],"Umbral operativo preventivo de monitorización.",{"_3569":73108,"_31013":73007,"_21476":122604,"_5":14750,"_28165":122366,"_3038":53679},[],{"_3569":73109,"_31013":73007,"_21476":122606,"_5":14750,"_28165":122366,"_3038":122607},[],"Umbral operativo crítico de monitorización.",{"_3569":73110,"_31013":73007,"_21476":122609,"_5":14750,"_28165":122366,"_3038":53685},[],{"_3569":73111,"_31013":73007,"_21476":122611,"_5":14750,"_28165":122366,"_3038":122612},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3569":73112,"_31013":73007,"_21476":122614,"_5":14750,"_28165":122366,"_3038":53691},[],{"_3569":73113,"_31013":73007,"_21476":122616,"_5":14750,"_28165":122366,"_3038":122617},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3569":73114,"_31013":73007,"_21476":122619,"_5":14750,"_28165":122366,"_3038":53697},[],{"_3569":73115,"_31013":73007,"_21476":122621,"_5":14750,"_28165":122366,"_3038":122622},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3569":73116,"_31013":73007,"_21476":122624,"_5":14750,"_28165":122366,"_3038":122625},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3569":73117,"_31013":73007,"_21476":122627,"_5":14750,"_28165":122370,"_3038":122628},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3569":73118,"_31013":73007,"_21476":122630,"_5":14750,"_28165":122373,"_3038":119983},[],{"_3569":73119,"_31013":73007,"_21476":122632,"_5":14750,"_28165":122373,"_3038":122633},[],"Qué publica",{"_3569":73120,"_31013":73007,"_21476":122635,"_5":14750,"_28165":122373,"_3038":53714},[],{"_3569":73121,"_31013":73007,"_21476":122637,"_5":14750,"_28165":122373,"_3038":122638},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3569":73122,"_31013":73007,"_21476":122640,"_5":14750,"_28165":122373,"_3038":53720},[],{"_3569":73123,"_31013":73007,"_21476":122642,"_5":14750,"_28165":122373,"_3038":122643},[],"Certificado de la CA emisora seleccionada.",{"_3569":73124,"_31013":73007,"_21476":122645,"_5":14750,"_28165":122373,"_3038":53726},[],{"_3569":73125,"_31013":73007,"_21476":122647,"_5":14750,"_28165":122373,"_3038":122648},[],"Certificados de las CAs elegidas explícitamente.",{"_3569":73126,"_31013":73007,"_21476":122650,"_5":14750,"_28165":122373,"_3038":122651},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3569":73127,"_31013":73007,"_21476":122653,"_5":14750,"_28165":122377,"_3038":122654},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3569":73128,"_31013":73007,"_21476":122656,"_5":14750,"_28165":122377,"_3038":122657},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3569":73129,"_31013":73007,"_21476":122659,"_5":14750,"_28165":122377,"_3038":122660},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3569":73130,"_31013":73007,"_21476":122662,"_5":14750,"_28165":122381,"_3038":122663},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3569":73131,"_31013":73131,"_5":15116,"_3038":122665,"_31371":122666,"_21476":122667,"_28165":73131},"Integra el cliente EST",[50615,121048,53104,122060,122235],[],{"_3569":73132,"_31013":73131,"_21476":122669,"_5":14750,"_28165":73131,"_3038":122670},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3569":73133,"_31013":73131,"_5":31368,"_21476":122672,"_28165":122673,"_3038":119619},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3569":73134,"_31013":73131,"_5":31368,"_21476":122675,"_28165":122676,"_3038":122677},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3569":73135,"_31013":73131,"_5":31368,"_21476":122679,"_28165":122680,"_3038":122681},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3569":73136,"_31013":73131,"_5":31368,"_21476":122683,"_28165":122684,"_3038":122685},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3569":73137,"_31013":73131,"_5":31368,"_21476":122687,"_28165":122688,"_3038":122689},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3569":73138,"_31013":73131,"_5":31368,"_21476":122691,"_28165":122692,"_3038":122693},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3569":73139,"_31013":73131,"_21476":122695,"_5":14750,"_28165":73131,"_3038":122696},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3569":73140,"_31013":73131,"_21476":122698,"_5":14750,"_28165":122673,"_3038":122699},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3569":73141,"_31013":73131,"_21476":122701,"_5":14750,"_28165":122673,"_3038":122702},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3569":73142,"_31013":73131,"_21476":122704,"_5":14750,"_28165":122673,"_3038":122705},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3569":73143,"_31013":73131,"_21476":122707,"_5":14750,"_28165":122676,"_3038":122708},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3569":73144,"_31013":73131,"_21476":122710,"_5":14750,"_28165":122676,"_3038":122711},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3569":73145,"_31013":73131,"_21476":122713,"_5":14750,"_28165":122680,"_3038":122714},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3569":73146,"_31013":73131,"_21476":122716,"_5":14750,"_28165":122680,"_3038":122717},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3569":73147,"_31013":73131,"_21476":122719,"_5":14750,"_28165":122684,"_3038":122720},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3569":73148,"_31013":73131,"_21476":122722,"_5":14750,"_28165":122684,"_3038":122723},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3569":73149,"_31013":73131,"_21476":122725,"_5":14750,"_28165":122688,"_3038":122726},[],"Para el caso de una raíz que emite directamente:",{"_3569":73150,"_31013":73131,"_21476":122728,"_5":14750,"_28165":122688,"_3038":122729},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3569":73151,"_31013":73131,"_21476":122731,"_5":14750,"_28165":122688,"_3038":122732},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3569":73152,"_31013":73131,"_21476":122734,"_5":14750,"_28165":122692,"_3038":122735},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3569":73153,"_31013":73153,"_5":15116,"_3038":122737,"_31371":122738,"_21476":122739,"_28165":73153},"Referencia EST",[50615,121048,53104,122060,122235],[],{"_3569":73154,"_31013":73153,"_21476":122741,"_5":14750,"_28165":73153,"_3038":122742},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3569":73155,"_31013":73153,"_5":31368,"_21476":122744,"_28165":122745,"_3038":122746},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3569":73156,"_31013":73153,"_5":31368,"_21476":122748,"_28165":122749,"_3038":23272},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3569":73157,"_31013":73153,"_5":31368,"_21476":122751,"_28165":122752,"_3038":26751},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3569":73158,"_31013":73153,"_5":31368,"_21476":122754,"_28165":122755,"_3038":26758},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3569":73159,"_31013":73153,"_5":31368,"_21476":122757,"_28165":122758,"_3038":26068},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3569":73160,"_31013":73153,"_5":31368,"_21476":122760,"_28165":122761,"_3038":122762},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3569":73161,"_31013":73153,"_5":31368,"_21476":122764,"_28165":122765,"_3038":122766},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3569":73162,"_31013":73153,"_5":31368,"_21476":122768,"_28165":122769,"_3038":122770},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3569":73163,"_31013":73153,"_21476":122772,"_5":14750,"_28165":73153,"_3038":122773},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3569":73164,"_31013":73153,"_21476":122775,"_5":14750,"_28165":122745,"_3038":122776},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3569":73165,"_31013":73153,"_21476":122778,"_5":14750,"_28165":122745,"_3038":120808},[],{"_3569":73166,"_31013":73153,"_21476":122780,"_5":14750,"_28165":122745,"_3038":122781},[],"Método",{"_3569":73167,"_31013":73153,"_21476":122783,"_5":14750,"_28165":122745,"_3038":122784},[],"Autenticación y condición",{"_3569":73168,"_31013":73153,"_21476":122786,"_5":14750,"_28165":122745,"_3038":53869},[],{"_3569":73169,"_31013":73153,"_21476":122788,"_5":14750,"_28165":122745,"_3038":53872},[],{"_3569":73170,"_31013":73153,"_21476":122790,"_5":14750,"_28165":122745,"_3038":122791},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3569":73171,"_31013":73153,"_21476":122793,"_5":14750,"_28165":122745,"_3038":53878},[],{"_3569":73172,"_31013":73153,"_21476":122795,"_5":14750,"_28165":122745,"_3038":53881},[],{"_3569":73173,"_31013":73153,"_21476":122797,"_5":14750,"_28165":122745,"_3038":122798},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3569":73174,"_31013":73153,"_21476":122800,"_5":14750,"_28165":122745,"_3038":53887},[],{"_3569":73175,"_31013":73153,"_21476":122802,"_5":14750,"_28165":122745,"_3038":53881},[],{"_3569":73176,"_31013":73153,"_21476":122804,"_5":14750,"_28165":122745,"_3038":122805},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3569":73177,"_31013":73153,"_21476":122807,"_5":14750,"_28165":122745,"_3038":53895},[],{"_3569":73178,"_31013":73153,"_21476":122809,"_5":14750,"_28165":122745,"_3038":53881},[],{"_3569":73179,"_31013":73153,"_21476":122811,"_5":14750,"_28165":122745,"_3038":122812},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3569":73180,"_31013":73153,"_21476":122814,"_5":14750,"_28165":122745,"_3038":122815},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3569":73181,"_31013":73153,"_21476":122817,"_5":14750,"_28165":122749,"_3038":122818},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3569":73182,"_31013":73153,"_21476":122820,"_5":14750,"_28165":122749,"_3038":122821},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3569":73183,"_31013":73153,"_21476":122823,"_5":14750,"_28165":122752,"_3038":122824},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3569":73184,"_31013":73153,"_21476":122826,"_5":14750,"_28165":122752,"_3038":122827},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3569":73185,"_31013":73153,"_21476":122829,"_5":14750,"_28165":122755,"_3038":122830},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3569":73186,"_31013":73153,"_21476":122832,"_5":14750,"_28165":122755,"_3038":122833},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3569":73187,"_31013":73153,"_21476":122835,"_5":14750,"_28165":122758,"_3038":122836},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3569":73188,"_31013":73153,"_21476":122838,"_5":14750,"_28165":122758,"_3038":122839},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3569":73189,"_31013":73153,"_21476":122841,"_5":14750,"_28165":122761,"_3038":122842},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3569":73190,"_31013":73153,"_21476":122844,"_5":14750,"_28165":122761,"_3038":122845},[],"Parte",{"_3569":73191,"_31013":73153,"_21476":122847,"_5":14750,"_28165":122761,"_3038":122848},[],"Contenido tras decodificar su Base64",{"_3569":73192,"_31013":73153,"_21476":122850,"_5":14750,"_28165":122761,"_3038":53939},[],{"_3569":73193,"_31013":73153,"_21476":122852,"_5":14750,"_28165":122761,"_3038":122853},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3569":73194,"_31013":73153,"_21476":122855,"_5":14750,"_28165":122761,"_3038":53945},[],{"_3569":73195,"_31013":73153,"_21476":122857,"_5":14750,"_28165":122761,"_3038":122858},[],"PKCS#7 DER con el certificado emitido.",{"_3569":73196,"_31013":73153,"_21476":122860,"_5":14750,"_28165":122761,"_3038":122861},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3569":73197,"_31013":73153,"_21476":122863,"_5":14750,"_28165":122765,"_3038":122864},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3569":73198,"_31013":73153,"_21476":122866,"_5":14750,"_28165":122765,"_3038":122867},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3569":73199,"_31013":73153,"_21476":122869,"_5":14750,"_28165":122765,"_3038":122870},[],"Convierte y comprueba el resultado:",{"_3569":73200,"_31013":73153,"_21476":122872,"_5":14750,"_28165":122765,"_3038":122873},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3569":73201,"_31013":73153,"_21476":122875,"_5":14750,"_28165":122769,"_3038":122876},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3569":73202,"_31013":73153,"_21476":122878,"_5":14750,"_28165":122769,"_3038":122879},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3569":73203,"_31013":73203,"_5":15116,"_3038":122235,"_31371":122881,"_21476":122882,"_28165":73203},[50615,121048,53104,122060,122235],[],{"_3569":73204,"_31013":73203,"_21476":122884,"_5":14750,"_28165":73203,"_3038":122885},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3569":73205,"_31013":73203,"_5":31368,"_21476":122887,"_28165":122888,"_3038":122889},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3569":73206,"_31013":73203,"_5":31368,"_21476":122891,"_28165":122892,"_3038":122893},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3569":73207,"_31013":73203,"_5":31368,"_21476":122895,"_28165":122896,"_3038":122897},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3569":73208,"_31013":73203,"_5":31368,"_21476":122899,"_28165":122900,"_3038":122901},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3569":73209,"_31013":73203,"_21476":122903,"_5":14750,"_28165":73203,"_3038":122904},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3569":73210,"_31013":73203,"_21476":122906,"_5":14750,"_28165":122888,"_3038":122907},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3569":73211,"_31013":73203,"_21476":122909,"_5":14750,"_28165":122888,"_3038":122910},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3569":73212,"_31013":73203,"_21476":122912,"_5":14750,"_28165":122888,"_3038":122913},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3569":73213,"_31013":73203,"_21476":122915,"_5":14750,"_28165":122888,"_3038":122916},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3569":73214,"_31013":73203,"_21476":122918,"_5":14750,"_28165":122888,"_3038":122919},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3569":73215,"_31013":73203,"_21476":122921,"_5":14750,"_28165":122888,"_3038":122922},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3569":73216,"_31013":73203,"_21476":122924,"_5":14750,"_28165":122892,"_3038":122925},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3569":73217,"_31013":73203,"_21476":122927,"_5":14750,"_28165":122892,"_3038":122928},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3569":73218,"_31013":73203,"_21476":122930,"_5":14750,"_28165":122892,"_3038":122931},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3569":73219,"_31013":73203,"_21476":122933,"_5":14750,"_28165":122892,"_3038":122934},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3569":73220,"_31013":73203,"_21476":122936,"_5":14750,"_28165":122896,"_3038":122937},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3569":73221,"_31013":73203,"_21476":122939,"_5":14750,"_28165":122896,"_3038":122940},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3569":73222,"_31013":73203,"_21476":122942,"_5":14750,"_28165":122896,"_3038":122943},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3569":73223,"_31013":73203,"_21476":122945,"_5":14750,"_28165":122896,"_3038":122946},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3569":73224,"_31013":73203,"_21476":122948,"_5":14750,"_28165":122900,"_3038":122949},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3569":73225,"_31013":73203,"_21476":122951,"_5":14750,"_28165":122900,"_3038":122952},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3569":73226,"_31013":73226,"_5":15116,"_3038":122954,"_31371":122955,"_21476":122956,"_28165":73226},"Estrategias de aprovisionamiento",[50615,121048,53104,122060,122235],[],{"_3569":73227,"_31013":73226,"_21476":122958,"_5":14750,"_28165":73226,"_3038":122959},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3569":73228,"_31013":73226,"_5":31368,"_21476":122961,"_28165":122962,"_3038":122963},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3569":73229,"_31013":73226,"_5":31368,"_21476":122965,"_28165":122966,"_3038":122967},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3569":73230,"_31013":73226,"_5":31368,"_21476":122969,"_28165":122970,"_3038":122971},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3569":73231,"_31013":73226,"_5":31368,"_21476":122973,"_28165":122974,"_3038":122975},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3569":73232,"_31013":73226,"_5":31368,"_21476":122977,"_28165":122978,"_3038":122979},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3569":73233,"_31013":73226,"_21476":122981,"_5":14750,"_28165":73226,"_3038":122982},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3569":73234,"_31013":73226,"_21476":122984,"_5":14750,"_28165":122962,"_3038":122985},[],"Recorrido",{"_3569":73235,"_31013":73226,"_21476":122987,"_5":14750,"_28165":122962,"_3038":122988},[],"Cuándo existe el dispositivo",{"_3569":73236,"_31013":73226,"_21476":122990,"_5":14750,"_28165":122962,"_3038":122991},[],"Qué compruebas",{"_3569":73237,"_31013":73226,"_21476":122993,"_5":14750,"_28165":122962,"_3038":122994},[],"Asignación manual",{"_3569":73238,"_31013":73226,"_21476":122996,"_5":14750,"_28165":122962,"_3038":122997},[],"El operador lo crea antes de asociar un certificado.",{"_3569":73239,"_31013":73226,"_21476":122999,"_5":14750,"_28165":122962,"_3038":123000},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3569":73240,"_31013":73226,"_21476":123002,"_5":14750,"_28165":122962,"_3038":123003},[],"EST con `JITP`",{"_3569":73241,"_31013":73226,"_21476":123005,"_5":14750,"_28165":122962,"_3038":123006},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3569":73242,"_31013":73226,"_21476":123008,"_5":14750,"_28165":122962,"_3038":123009},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3569":73243,"_31013":73226,"_21476":123011,"_5":14750,"_28165":122962,"_3038":123012},[],"EST con `PRE_REGISTRATION`",{"_3569":73244,"_31013":73226,"_21476":123014,"_5":14750,"_28165":122962,"_3038":123015},[],"Debe existir antes de `/simpleenroll`.",{"_3569":73245,"_31013":73226,"_21476":123017,"_5":14750,"_28165":122962,"_3038":123018},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3569":73246,"_31013":73226,"_21476":123020,"_5":14750,"_28165":122962,"_3038":123021},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3569":73247,"_31013":73226,"_21476":123023,"_5":14750,"_28165":122962,"_3038":123024},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3569":73248,"_31013":73226,"_21476":123026,"_5":14750,"_28165":122966,"_3038":123027},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3569":73249,"_31013":73226,"_21476":123029,"_5":14750,"_28165":122966,"_3038":123030},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3569":73250,"_31013":73226,"_21476":123032,"_5":14750,"_28165":122966,"_3038":123033},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3569":73251,"_31013":73226,"_21476":123035,"_5":14750,"_28165":122970,"_3038":123036},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3569":73252,"_31013":73226,"_21476":123038,"_5":14750,"_28165":122970,"_3038":123039},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3569":73253,"_31013":73226,"_21476":123041,"_5":14750,"_28165":122970,"_3038":123042},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3569":73254,"_31013":73226,"_21476":123044,"_5":14750,"_28165":122970,"_3038":123045},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3569":73255,"_31013":73226,"_21476":123047,"_5":14750,"_28165":122970,"_3038":123048},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3569":73256,"_31013":73226,"_21476":123050,"_5":14750,"_28165":122970,"_3038":123051},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3569":73257,"_31013":73226,"_21476":123053,"_5":14750,"_28165":122974,"_3038":119983},[],{"_3569":73258,"_31013":73226,"_21476":123055,"_5":14750,"_28165":122974,"_3038":123056},[],"Material que atraviesa EST",{"_3569":73259,"_31013":73226,"_21476":123058,"_5":14750,"_28165":122974,"_3038":123059},[],"Clave generada por el dispositivo",{"_3569":73260,"_31013":73226,"_21476":123061,"_5":14750,"_28165":122974,"_3038":123062},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3569":73261,"_31013":73226,"_21476":123064,"_5":14750,"_28165":122974,"_3038":123065},[],"Clave ya disponible en el dispositivo",{"_3569":73262,"_31013":73226,"_21476":123067,"_5":14750,"_28165":122974,"_3038":123068},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3569":73263,"_31013":73226,"_21476":123070,"_5":14750,"_28165":122974,"_3038":53423},[],{"_3569":73264,"_31013":73226,"_21476":123072,"_5":14750,"_28165":122974,"_3038":123073},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3569":73265,"_31013":73226,"_21476":123075,"_5":14750,"_28165":122974,"_3038":123076},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3569":73266,"_31013":73226,"_21476":123078,"_5":14750,"_28165":122978,"_3038":123079},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3569":73267,"_31013":73267,"_5":15116,"_3038":123081,"_31371":123082,"_21476":123083,"_28165":73267},"Renovación y recuperación",[50615,121048,53104,122060,122235],[],{"_3569":73268,"_31013":73267,"_21476":123085,"_5":14750,"_28165":73267,"_3038":123086},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3569":73269,"_31013":73267,"_5":31368,"_21476":123088,"_28165":123089,"_3038":123090},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3569":73270,"_31013":73267,"_5":31368,"_21476":123092,"_28165":123093,"_3038":123094},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3569":73271,"_31013":73267,"_5":31368,"_21476":123096,"_28165":123097,"_3038":123098},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3569":73272,"_31013":73267,"_5":31368,"_21476":123100,"_28165":123101,"_3038":123102},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3569":73273,"_31013":73267,"_5":31368,"_21476":123104,"_28165":123105,"_3038":123106},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3569":73274,"_31013":73267,"_21476":123108,"_5":14750,"_28165":73267,"_3038":123109},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3569":73275,"_31013":73267,"_21476":123111,"_5":14750,"_28165":123089,"_3038":123112},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3569":73276,"_31013":73267,"_21476":123114,"_5":14750,"_28165":123089,"_3038":123115},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3569":73277,"_31013":73267,"_21476":123117,"_5":14750,"_28165":123089,"_3038":123118},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3569":73278,"_31013":73267,"_21476":123120,"_5":14750,"_28165":123089,"_3038":123121},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3569":73279,"_31013":73267,"_21476":123123,"_5":14750,"_28165":123093,"_3038":123124},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3569":73280,"_31013":73267,"_21476":123126,"_5":14750,"_28165":123093,"_3038":123127},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3569":73281,"_31013":73267,"_21476":123129,"_5":14750,"_28165":123097,"_3038":123130},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3569":73282,"_31013":73267,"_21476":123132,"_5":14750,"_28165":123097,"_3038":123133},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3569":73283,"_31013":73267,"_21476":123135,"_5":14750,"_28165":123097,"_3038":123136},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3569":73284,"_31013":73267,"_21476":123138,"_5":14750,"_28165":123101,"_3038":123139},[],"Situación",{"_3569":73285,"_31013":73267,"_21476":123141,"_5":14750,"_28165":123101,"_3038":123142},[],"Procedimiento",{"_3569":73286,"_31013":73267,"_21476":123144,"_5":14750,"_28165":123101,"_3038":123145},[],"Certificado vigente, fuera de ventana",{"_3569":73287,"_31013":73267,"_21476":123147,"_5":14750,"_28165":123101,"_3038":123148},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3569":73288,"_31013":73267,"_21476":123150,"_5":14750,"_28165":123101,"_3038":123151},[],"Certificado vencido, clave disponible",{"_3569":73289,"_31013":73267,"_21476":123153,"_5":14750,"_28165":123101,"_3038":123154},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3569":73290,"_31013":73267,"_21476":123156,"_5":14750,"_28165":123101,"_3038":123157},[],"Renovación por webhook o `NO_AUTH`",{"_3569":73291,"_31013":73267,"_21476":123159,"_5":14750,"_28165":123101,"_3038":123160},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3569":73292,"_31013":73267,"_21476":123162,"_5":14750,"_28165":123101,"_3038":123163},[],"Clave perdida o inaccesible",{"_3569":73293,"_31013":73267,"_21476":123165,"_5":14750,"_28165":123101,"_3038":123166},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3569":73294,"_31013":73267,"_21476":123168,"_5":14750,"_28165":123101,"_3038":123169},[],"Identidad actual revocada",{"_3569":73295,"_31013":73267,"_21476":123171,"_5":14750,"_28165":123101,"_3038":123172},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3569":73296,"_31013":73267,"_21476":123174,"_5":14750,"_28165":123101,"_3038":123175},[],"Dispositivo sin identidad",{"_3569":73297,"_31013":73267,"_21476":123177,"_5":14750,"_28165":123101,"_3038":123178},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3569":73298,"_31013":73267,"_21476":123180,"_5":14750,"_28165":123101,"_3038":123181},[],"Dispositivo retirado",{"_3569":73299,"_31013":73267,"_21476":123183,"_5":14750,"_28165":123101,"_3038":123184},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3569":73300,"_31013":73267,"_21476":123186,"_5":14750,"_28165":123101,"_3038":123187},[],"Timeout, HTTP 500 o fallo de instalación",{"_3569":73301,"_31013":73267,"_21476":123189,"_5":14750,"_28165":123101,"_3038":123190},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3569":73302,"_31013":73267,"_21476":123192,"_5":14750,"_28165":123105,"_3038":123193},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3569":73303,"_31013":73267,"_21476":123195,"_5":14750,"_28165":123105,"_3038":123196},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3569":73304,"_31013":73304,"_5":15116,"_3038":123198,"_31371":123199,"_21476":123200,"_28165":73304},"Diagnóstico de enrolamiento",[50615,121048,53104,122060,122235],[],{"_3569":73305,"_31013":73304,"_21476":123202,"_5":14750,"_28165":73304,"_3038":123203},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3569":73306,"_31013":73304,"_5":31368,"_21476":123205,"_28165":123206,"_3038":123207},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3569":73307,"_31013":73304,"_5":31368,"_21476":123209,"_28165":123210,"_3038":123211},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3569":73308,"_31013":73304,"_5":31368,"_21476":123213,"_28165":123214,"_3038":122770},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3569":73309,"_31013":73304,"_5":31368,"_21476":123216,"_28165":123217,"_3038":123218},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3569":73310,"_31013":73304,"_21476":123220,"_5":14750,"_28165":73304,"_3038":123221},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3569":73311,"_31013":73304,"_21476":123223,"_5":14750,"_28165":123210,"_3038":123224},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3569":73312,"_31013":73304,"_21476":123226,"_5":14750,"_28165":123210,"_3038":123227},[],"Síntoma o mensaje",{"_3569":73313,"_31013":73304,"_21476":123229,"_5":14750,"_28165":123210,"_3038":123230},[],"Qué revisar",{"_3569":73314,"_31013":73304,"_21476":123232,"_5":14750,"_28165":123210,"_3038":123233},[],"curl rechaza TLS, nombre o emisor",{"_3569":73315,"_31013":73304,"_21476":123235,"_5":14750,"_28165":123210,"_3038":123236},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3569":73316,"_31013":73304,"_21476":123238,"_5":14750,"_28165":123210,"_3038":123239},[],"404 o APS ausente",{"_3569":73317,"_31013":73304,"_21476":123241,"_5":14750,"_28165":123210,"_3038":123242},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3569":73318,"_31013":73304,"_21476":123244,"_5":14750,"_28165":123210,"_3038":123245},[],"400, error de CSR o formato",{"_3569":73319,"_31013":73304,"_21476":123247,"_5":14750,"_28165":123210,"_3038":123248},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3569":73320,"_31013":73304,"_21476":123250,"_5":14750,"_28165":123210,"_3038":123251},[],"Credencial ausente o certificado no válido",{"_3569":73321,"_31013":73304,"_21476":123253,"_5":14750,"_28165":123210,"_3038":123254},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3569":73322,"_31013":73304,"_21476":123256,"_5":14750,"_28165":123210,"_3038":123257},[],"Webhook deniega, expira o responde sin autorización",{"_3569":73323,"_31013":73304,"_21476":123259,"_5":14750,"_28165":123210,"_3038":123260},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3569":73324,"_31013":73304,"_21476":123262,"_5":14750,"_28165":123210,"_3038":54352},[],{"_3569":73325,"_31013":73304,"_21476":123264,"_5":14750,"_28165":123210,"_3038":123265},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3569":73326,"_31013":73304,"_21476":123267,"_5":14750,"_28165":123210,"_3038":54358},[],{"_3569":73327,"_31013":73304,"_21476":123269,"_5":14750,"_28165":123210,"_3038":123270},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3569":73328,"_31013":73304,"_21476":123272,"_5":14750,"_28165":123210,"_3038":54364},[],{"_3569":73329,"_31013":73304,"_21476":123274,"_5":14750,"_28165":123210,"_3038":123275},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3569":73330,"_31013":73304,"_21476":123277,"_5":14750,"_28165":123210,"_3038":54370},[],{"_3569":73331,"_31013":73304,"_21476":123279,"_5":14750,"_28165":123210,"_3038":123280},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3569":73332,"_31013":73304,"_21476":123282,"_5":14750,"_28165":123210,"_3038":54376},[],{"_3569":73333,"_31013":73304,"_21476":123284,"_5":14750,"_28165":123210,"_3038":123285},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3569":73334,"_31013":73304,"_21476":123287,"_5":14750,"_28165":123210,"_3038":123288},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3569":73335,"_31013":73304,"_21476":123290,"_5":14750,"_28165":123210,"_3038":123291},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3569":73336,"_31013":73304,"_21476":123293,"_5":14750,"_28165":123210,"_3038":123294},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3569":73337,"_31013":73304,"_21476":123296,"_5":14750,"_28165":123210,"_3038":123297},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3569":73338,"_31013":73304,"_21476":123299,"_5":14750,"_28165":123210,"_3038":54394},[],{"_3569":73339,"_31013":73304,"_21476":123301,"_5":14750,"_28165":123210,"_3038":123302},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3569":73340,"_31013":73304,"_21476":123304,"_5":14750,"_28165":123210,"_3038":54400},[],{"_3569":73341,"_31013":73304,"_21476":123306,"_5":14750,"_28165":123210,"_3038":123307},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3569":73342,"_31013":73304,"_21476":123309,"_5":14750,"_28165":123210,"_3038":123310},[],"DMS propietario distinto",{"_3569":73343,"_31013":73304,"_21476":123312,"_5":14750,"_28165":123210,"_3038":123313},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3569":73344,"_31013":73304,"_21476":123315,"_5":14750,"_28165":123210,"_3038":54412},[],{"_3569":73345,"_31013":73304,"_21476":123317,"_5":14750,"_28165":123210,"_3038":123318},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3569":73346,"_31013":73304,"_21476":123320,"_5":14750,"_28165":123210,"_3038":54418},[],{"_3569":73347,"_31013":73304,"_21476":123322,"_5":14750,"_28165":123210,"_3038":123323},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3569":73348,"_31013":73304,"_21476":123325,"_5":14750,"_28165":123210,"_3038":123326},[],"Certificado actual revocado",{"_3569":73349,"_31013":73304,"_21476":123328,"_5":14750,"_28165":123210,"_3038":123329},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3569":73350,"_31013":73304,"_21476":123331,"_5":14750,"_28165":123210,"_3038":123332},[],"Error de CA, perfil o firma",{"_3569":73351,"_31013":73304,"_21476":123334,"_5":14750,"_28165":123210,"_3038":123335},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3569":73352,"_31013":73304,"_21476":123337,"_5":14750,"_28165":123210,"_3038":123338},[],"HTTP 200 sin conexión del dispositivo",{"_3569":73353,"_31013":73304,"_21476":123340,"_5":14750,"_28165":123210,"_3038":123341},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3569":73354,"_31013":73304,"_21476":123343,"_5":14750,"_28165":123210,"_3038":123344},[],"Timeout o error después de emitir",{"_3569":73355,"_31013":73304,"_21476":123346,"_5":14750,"_28165":123210,"_3038":123347},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3569":73356,"_31013":73304,"_21476":123349,"_5":14750,"_28165":123214,"_3038":123350},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3569":73357,"_31013":73304,"_21476":123352,"_5":14750,"_28165":123214,"_3038":123353},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3569":73358,"_31013":73304,"_21476":123355,"_5":14750,"_28165":123217,"_3038":123356},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3569":73359,"_31013":73304,"_21476":123358,"_5":14750,"_28165":123217,"_3038":123359},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3569":73360,"_31013":73304,"_21476":123361,"_5":14750,"_28165":123217,"_3038":123362},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3569":73361,"_31013":73304,"_21476":123364,"_5":14750,"_28165":123217,"_3038":123365},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3569":73362,"_31013":73304,"_21476":123367,"_5":14750,"_28165":123217,"_3038":123368},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3569":73363,"_31013":73304,"_21476":123370,"_5":14750,"_28165":123217,"_3038":123371},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3569":73364,"_31013":73304,"_21476":123373,"_5":14750,"_28165":123217,"_3038":123374},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3569":73365,"_31013":73365,"_5":15116,"_3038":123376,"_31371":123377,"_21476":123378,"_28165":73365},"Distribución y actualización de confianza",[50615,121048,53104,122060,122235],[],{"_3569":73366,"_31013":73365,"_21476":123380,"_5":14750,"_28165":73365,"_3038":123381},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3569":73367,"_31013":73365,"_5":31368,"_21476":123383,"_28165":123384,"_3038":123385},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3569":73368,"_31013":73365,"_5":31368,"_21476":123387,"_28165":123388,"_3038":123389},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3569":73369,"_31013":73365,"_5":31368,"_21476":123391,"_28165":123392,"_3038":123393},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3569":73370,"_31013":73365,"_5":31368,"_21476":123395,"_28165":123396,"_3038":123397},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3569":73371,"_31013":73365,"_5":31368,"_21476":123399,"_28165":123400,"_3038":123401},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3569":73372,"_31013":73365,"_21476":123403,"_5":14750,"_28165":73365,"_3038":123404},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3569":73373,"_31013":73365,"_21476":123406,"_5":14750,"_28165":123384,"_3038":123407},[],"Relación",{"_3569":73374,"_31013":73365,"_21476":123409,"_5":14750,"_28165":123384,"_3038":123410},[],"Material que prepara el responsable",{"_3569":73375,"_31013":73365,"_21476":123412,"_5":14750,"_28165":123384,"_3038":123413},[],"Dispositivo → servidor EST",{"_3569":73376,"_31013":73365,"_21476":123415,"_5":14750,"_28165":123384,"_3038":123416},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3569":73377,"_31013":73365,"_21476":123418,"_5":14750,"_28165":123384,"_3038":123419},[],"DMS → solicitante",{"_3569":73378,"_31013":73365,"_21476":123421,"_5":14750,"_28165":123384,"_3038":123422},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3569":73379,"_31013":73365,"_21476":123424,"_5":14750,"_28165":123384,"_3038":123425},[],"Consumidor → dispositivo",{"_3569":73380,"_31013":73365,"_21476":123427,"_5":14750,"_28165":123384,"_3038":123428},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3569":73381,"_31013":73365,"_21476":123430,"_5":14750,"_28165":123384,"_3038":123431},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3569":73382,"_31013":73365,"_21476":123433,"_5":14750,"_28165":123388,"_3038":123434},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3569":73383,"_31013":73365,"_21476":123436,"_5":14750,"_28165":123388,"_3038":123437},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3569":73384,"_31013":73365,"_21476":123439,"_5":14750,"_28165":123392,"_3038":123440},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3569":73385,"_31013":73365,"_21476":123442,"_5":14750,"_28165":123392,"_3038":123443},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3569":73386,"_31013":73365,"_21476":123445,"_5":14750,"_28165":123392,"_3038":123446},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3569":73387,"_31013":73365,"_21476":123448,"_5":14750,"_28165":123392,"_3038":123449},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3569":73388,"_31013":73365,"_21476":123451,"_5":14750,"_28165":123392,"_3038":123452},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3569":73389,"_31013":73365,"_21476":123454,"_5":14750,"_28165":123392,"_3038":123455},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3569":73390,"_31013":73365,"_21476":123457,"_5":14750,"_28165":123396,"_3038":123458},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3569":73391,"_31013":73365,"_21476":123460,"_5":14750,"_28165":123396,"_3038":123461},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3569":73392,"_31013":73365,"_21476":123463,"_5":14750,"_28165":123396,"_3038":123464},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3569":73393,"_31013":73365,"_21476":123466,"_5":14750,"_28165":123400,"_3038":123467},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3569":73394,"_31013":73394,"_5":15116,"_3038":54567,"_31371":123469,"_21476":123471,"_28165":73394},[50615,121048,53104,122060,123470],"Integraciones",[],{"_3569":73395,"_31013":73394,"_21476":123473,"_5":14750,"_28165":73394,"_3038":123474},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3569":73396,"_31013":73394,"_5":31368,"_21476":123476,"_28165":123477,"_3038":123478},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3569":73397,"_31013":73394,"_5":31368,"_21476":123480,"_28165":123481,"_3038":123482},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3569":73398,"_31013":73394,"_5":31368,"_21476":123484,"_28165":123485,"_3038":123486},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3569":73399,"_31013":73394,"_5":31368,"_21476":123488,"_28165":123489,"_3038":123490},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3569":73400,"_31013":73394,"_5":31368,"_21476":123492,"_28165":123493,"_3038":123494},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3569":73401,"_31013":73394,"_5":31368,"_21476":123496,"_28165":123497,"_3038":123498},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3569":73402,"_31013":73394,"_5":31368,"_21476":123500,"_28165":123501,"_3038":123502},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3569":73403,"_31013":73394,"_5":31368,"_21476":123504,"_28165":123505,"_3038":123506},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3569":73404,"_31013":73394,"_5":31368,"_21476":123508,"_28165":123509,"_3038":54609},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3569":73405,"_31013":73394,"_5":31368,"_21476":123511,"_28165":123512,"_3038":54613},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3569":73406,"_31013":73394,"_5":31368,"_21476":123514,"_28165":123515,"_3038":123516},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3569":73407,"_31013":73394,"_5":31368,"_21476":123518,"_28165":123519,"_3038":123520},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3569":73408,"_31013":73394,"_5":31368,"_21476":123522,"_28165":123523,"_3038":123524},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3569":73409,"_31013":73394,"_5":31368,"_21476":123526,"_28165":123527,"_3038":123528},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3569":73410,"_31013":73394,"_5":31368,"_21476":123530,"_28165":123531,"_3038":123532},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3569":73411,"_31013":73394,"_5":31368,"_21476":123534,"_28165":123535,"_3038":123536},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3569":73412,"_31013":73394,"_5":31368,"_21476":123538,"_28165":123539,"_3038":123540},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3569":73413,"_31013":73394,"_5":31368,"_21476":123542,"_28165":123543,"_3038":123544},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3569":73414,"_31013":73394,"_5":31368,"_21476":123546,"_28165":123547,"_3038":123548},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3569":73415,"_31013":73394,"_5":31368,"_21476":123550,"_28165":123551,"_3038":123552},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3569":73416,"_31013":73394,"_5":31368,"_21476":123554,"_28165":123555,"_3038":123556},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3569":73417,"_31013":73394,"_5":31368,"_21476":123558,"_28165":123559,"_3038":123560},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3569":73418,"_31013":73394,"_5":31368,"_21476":123562,"_28165":123563,"_3038":123564},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3569":73419,"_31013":73394,"_5":31368,"_21476":123566,"_28165":123567,"_3038":123568},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3569":73420,"_31013":73394,"_5":31368,"_21476":123570,"_28165":123571,"_3038":123572},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3569":73421,"_31013":73394,"_21476":123574,"_5":14750,"_28165":73394,"_3038":123575},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3569":73422,"_31013":73394,"_21476":123577,"_5":14750,"_28165":73394,"_3038":123578},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3569":73423,"_31013":73394,"_21476":123580,"_5":14750,"_28165":73394,"_3038":123581},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3569":73424,"_31013":73394,"_21476":123583,"_5":14750,"_28165":123477,"_3038":123584},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3569":73425,"_31013":73394,"_21476":123586,"_5":14750,"_28165":123477,"_3038":123587},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3569":73426,"_31013":73394,"_21476":123589,"_5":14750,"_28165":123477,"_3038":123590},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3569":73427,"_31013":73394,"_21476":123592,"_5":14750,"_28165":123477,"_3038":123593},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3569":73428,"_31013":73394,"_21476":123595,"_5":14750,"_28165":123481,"_3038":123596},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3569":73429,"_31013":73394,"_21476":123598,"_5":14750,"_28165":123485,"_3038":123599},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3569":73430,"_31013":73394,"_21476":123601,"_5":14750,"_28165":123485,"_3038":123602},[],"Acción IAM",{"_3569":73431,"_31013":73394,"_21476":123604,"_5":14750,"_28165":123485,"_3038":119989},[],{"_3569":73432,"_31013":73394,"_21476":123606,"_5":14750,"_28165":123485,"_3038":54708},[],{"_3569":73433,"_31013":73394,"_21476":123608,"_5":14750,"_28165":123485,"_3038":123609},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3569":73434,"_31013":73394,"_21476":123611,"_5":14750,"_28165":123485,"_3038":54714},[],{"_3569":73435,"_31013":73394,"_21476":123613,"_5":14750,"_28165":123485,"_3038":123614},[],"Registrar la CA en AWS IoT",{"_3569":73436,"_31013":73394,"_21476":123616,"_5":14750,"_28165":123485,"_3038":54720},[],{"_3569":73437,"_31013":73394,"_21476":123618,"_5":14750,"_28165":123485,"_3038":123619},[],"Consultar el estado del registro de la CA",{"_3569":73438,"_31013":73394,"_21476":123621,"_5":14750,"_28165":123485,"_3038":54726},[],{"_3569":73439,"_31013":73394,"_21476":123623,"_5":14750,"_28165":123485,"_3038":123624},[],"Crear o actualizar Things en IoT Core",{"_3569":73440,"_31013":73394,"_21476":123626,"_5":14750,"_28165":123485,"_3038":54732},[],{"_3569":73441,"_31013":73394,"_21476":123628,"_5":14750,"_28165":123485,"_3038":123629},[],"Aprovisionar Things mediante plantilla",{"_3569":73442,"_31013":73394,"_21476":123631,"_5":14750,"_28165":123485,"_3038":54738},[],{"_3569":73443,"_31013":73394,"_21476":123633,"_5":14750,"_28165":123485,"_3038":123634},[],"Registrar certificados de dispositivo",{"_3569":73444,"_31013":73394,"_21476":123636,"_5":14750,"_28165":123485,"_3038":54744},[],{"_3569":73445,"_31013":73394,"_21476":123638,"_5":14750,"_28165":123485,"_3038":123639},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3569":73446,"_31013":73394,"_21476":123641,"_5":14750,"_28165":123485,"_3038":54750},[],{"_3569":73447,"_31013":73394,"_21476":123643,"_5":14750,"_28165":123485,"_3038":123644},[],"Crear y adjuntar políticas IoT",{"_3569":73448,"_31013":73394,"_21476":123646,"_5":14750,"_28165":123485,"_3038":54756},[],{"_3569":73449,"_31013":73394,"_21476":123648,"_5":14750,"_28165":123485,"_3038":123649},[],"Gestionar grupos de Things",{"_3569":73450,"_31013":73394,"_21476":123651,"_5":14750,"_28165":123485,"_3038":54762},[],{"_3569":73451,"_31013":73394,"_21476":123653,"_5":14750,"_28165":123485,"_3038":123654},[],"Crear plantillas JITP",{"_3569":73452,"_31013":73394,"_21476":123656,"_5":14750,"_28165":123485,"_3038":54768},[],{"_3569":73453,"_31013":73394,"_21476":123658,"_5":14750,"_28165":123485,"_3038":123659},[],"Leer y escribir el Device Shadow",{"_3569":73454,"_31013":73394,"_21476":123661,"_5":14750,"_28165":123485,"_3038":123662},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3569":73455,"_31013":73394,"_21476":123664,"_5":14750,"_28165":123489,"_3038":123665},[],"Parámetro",{"_3569":73456,"_31013":73394,"_21476":123667,"_5":14750,"_28165":123489,"_3038":123668},[],"Tipo",{"_3569":73457,"_31013":73394,"_21476":123670,"_5":14750,"_28165":123489,"_3038":123671},[],"Requerido",{"_3569":73458,"_31013":73394,"_21476":123673,"_5":14750,"_28165":123489,"_3038":123674},[],"Descripción",{"_3569":73459,"_31013":73394,"_21476":123676,"_5":14750,"_28165":123489,"_3038":54789},[],{"_3569":73460,"_31013":73394,"_21476":123678,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73461,"_31013":73394,"_21476":123680,"_5":14750,"_28165":123489,"_3038":123681},[],"Sí",{"_3569":73462,"_31013":73394,"_21476":123683,"_5":14750,"_28165":123489,"_3038":123684},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3569":73463,"_31013":73394,"_21476":123686,"_5":14750,"_28165":123489,"_3038":54800},[],{"_3569":73464,"_31013":73394,"_21476":123688,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73465,"_31013":73394,"_21476":123690,"_5":14750,"_28165":123489,"_3038":123681},[],{"_3569":73466,"_31013":73394,"_21476":123692,"_5":14750,"_28165":123489,"_3038":123693},[],"Región AWS donde opera el conector.",{"_3569":73467,"_31013":73394,"_21476":123695,"_5":14750,"_28165":123489,"_3038":54810},[],{"_3569":73468,"_31013":73394,"_21476":123697,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73469,"_31013":73394,"_21476":123699,"_5":14750,"_28165":123489,"_3038":123681},[],{"_3569":73470,"_31013":73394,"_21476":123701,"_5":14750,"_28165":123489,"_3038":123702},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3569":73471,"_31013":73394,"_21476":123704,"_5":14750,"_28165":123489,"_3038":54820},[],{"_3569":73472,"_31013":73394,"_21476":123706,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73473,"_31013":73394,"_21476":123708,"_5":14750,"_28165":123489,"_3038":123709},[],"Solo con `auth_method=static`",{"_3569":73474,"_31013":73394,"_21476":123711,"_5":14750,"_28165":123489,"_3038":123712},[],"Clave de acceso AWS.",{"_3569":73475,"_31013":73394,"_21476":123714,"_5":14750,"_28165":123489,"_3038":54831},[],{"_3569":73476,"_31013":73394,"_21476":123716,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73477,"_31013":73394,"_21476":123718,"_5":14750,"_28165":123489,"_3038":123709},[],{"_3569":73478,"_31013":73394,"_21476":123720,"_5":14750,"_28165":123489,"_3038":123721},[],"Clave secreta AWS.",{"_3569":73479,"_31013":73394,"_21476":123723,"_5":14750,"_28165":123489,"_3038":54841},[],{"_3569":73480,"_31013":73394,"_21476":123725,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73481,"_31013":73394,"_21476":123727,"_5":14750,"_28165":123489,"_3038":54846},[],{"_3569":73482,"_31013":73394,"_21476":123729,"_5":14750,"_28165":123489,"_3038":123730},[],"Token de sesión (con `auth_method=static`).",{"_3569":73483,"_31013":73394,"_21476":123732,"_5":14750,"_28165":123489,"_3038":54852},[],{"_3569":73484,"_31013":73394,"_21476":123734,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73485,"_31013":73394,"_21476":123736,"_5":14750,"_28165":123489,"_3038":123737},[],"Solo con `auth_method=role`",{"_3569":73486,"_31013":73394,"_21476":123739,"_5":14750,"_28165":123489,"_3038":123740},[],"ARN del rol a asumir.",{"_3569":73487,"_31013":73394,"_21476":123742,"_5":14750,"_28165":123489,"_3038":54863},[],{"_3569":73488,"_31013":73394,"_21476":123744,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73489,"_31013":73394,"_21476":123746,"_5":14750,"_28165":123489,"_3038":54846},[],{"_3569":73490,"_31013":73394,"_21476":123748,"_5":14750,"_28165":123489,"_3038":123749},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3569":73491,"_31013":73394,"_21476":123751,"_5":14750,"_28165":123489,"_3038":54873},[],{"_3569":73492,"_31013":73394,"_21476":123753,"_5":14750,"_28165":123489,"_3038":92326},[],{"_3569":73493,"_31013":73394,"_21476":123755,"_5":14750,"_28165":123489,"_3038":123681},[],{"_3569":73494,"_31013":73394,"_21476":123757,"_5":14750,"_28165":123489,"_3038":123758},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3569":73495,"_31013":73394,"_21476":123760,"_5":14750,"_28165":123489,"_3038":54883},[],{"_3569":73496,"_31013":73394,"_21476":123762,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73497,"_31013":73394,"_21476":123764,"_5":14750,"_28165":123489,"_3038":123681},[],{"_3569":73498,"_31013":73394,"_21476":123766,"_5":14750,"_28165":123489,"_3038":123767},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3569":73499,"_31013":73394,"_21476":123769,"_5":14750,"_28165":123489,"_3038":54893},[],{"_3569":73500,"_31013":73394,"_21476":123771,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73501,"_31013":73394,"_21476":123773,"_5":14750,"_28165":123489,"_3038":123681},[],{"_3569":73502,"_31013":73394,"_21476":123775,"_5":14750,"_28165":123489,"_3038":123776},[],"URL HTTP del Device Manager de Lamassu.",{"_3569":73503,"_31013":73394,"_21476":123778,"_5":14750,"_28165":123489,"_3038":54903},[],{"_3569":73504,"_31013":73394,"_21476":123780,"_5":14750,"_28165":123489,"_3038":25708},[],{"_3569":73505,"_31013":73394,"_21476":123782,"_5":14750,"_28165":123489,"_3038":123681},[],{"_3569":73506,"_31013":73394,"_21476":123784,"_5":14750,"_28165":123489,"_3038":123785},[],"URL HTTP del servicio de CA de Lamassu.",{"_3569":73507,"_31013":73394,"_21476":123787,"_5":14750,"_28165":123493,"_3038":123788},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3569":73508,"_31013":73394,"_21476":123790,"_5":14750,"_28165":123493,"_3038":123791},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3569":73509,"_31013":73394,"_21476":123793,"_5":14750,"_28165":123493,"_3038":123794},[],"Tipo de CloudEvent",{"_3569":73510,"_31013":73394,"_21476":123796,"_5":14750,"_28165":123493,"_3038":123797},[],"Recurso en Lamassu",{"_3569":73511,"_31013":73394,"_21476":123799,"_5":14750,"_28165":123493,"_3038":123800},[],"Recurso AWS",{"_3569":73512,"_31013":73394,"_21476":123802,"_5":14750,"_28165":123493,"_3038":123803},[],"Acciones IAM",{"_3569":73513,"_31013":73394,"_21476":123805,"_5":14750,"_28165":123493,"_3038":123806},[],"Llamadas AWS y efecto",{"_3569":73514,"_31013":73394,"_21476":123808,"_5":14750,"_28165":123493,"_3038":123809},[],"Dónde en esta página",{"_3569":73515,"_31013":73394,"_21476":123811,"_5":14750,"_28165":123493,"_3038":54937},[],{"_3569":73516,"_31013":73394,"_21476":123813,"_5":14750,"_28165":123493,"_3038":54940},[],{"_3569":73517,"_31013":73394,"_21476":123815,"_5":14750,"_28165":123493,"_3038":54943},[],{"_3569":73518,"_31013":73394,"_21476":123817,"_5":14750,"_28165":123493,"_3038":54946},[],{"_3569":73519,"_31013":73394,"_21476":123819,"_5":14750,"_28165":123493,"_3038":123820},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3569":73520,"_31013":73394,"_21476":123822,"_5":14750,"_28165":123493,"_3038":123506},[],{"_3569":73521,"_31013":73394,"_21476":123824,"_5":14750,"_28165":123493,"_3038":54954},[],{"_3569":73522,"_31013":73394,"_21476":123826,"_5":14750,"_28165":123493,"_3038":54957},[],{"_3569":73523,"_31013":73394,"_21476":123828,"_5":14750,"_28165":123493,"_3038":54960},[],{"_3569":73524,"_31013":73394,"_21476":123830,"_5":14750,"_28165":123493,"_3038":54963},[],{"_3569":73525,"_31013":73394,"_21476":123832,"_5":14750,"_28165":123493,"_3038":123833},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3569":73526,"_31013":73394,"_21476":123835,"_5":14750,"_28165":123493,"_3038":123532},[],{"_3569":73527,"_31013":73394,"_21476":123837,"_5":14750,"_28165":123493,"_3038":54971},[],{"_3569":73528,"_31013":73394,"_21476":123839,"_5":14750,"_28165":123493,"_3038":123840},[],"Dispositivo",{"_3569":73529,"_31013":73394,"_21476":123842,"_5":14750,"_28165":123493,"_3038":54977},[],{"_3569":73530,"_31013":73394,"_21476":123844,"_5":14750,"_28165":123493,"_3038":54980},[],{"_3569":73531,"_31013":73394,"_21476":123846,"_5":14750,"_28165":123493,"_3038":123847},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3569":73532,"_31013":73394,"_21476":123849,"_5":14750,"_28165":123493,"_3038":123540},[],{"_3569":73533,"_31013":73394,"_21476":123851,"_5":14750,"_28165":123493,"_3038":54988},[],{"_3569":73534,"_31013":73394,"_21476":123853,"_5":14750,"_28165":123493,"_3038":123854},[],"Certificado",{"_3569":73535,"_31013":73394,"_21476":123856,"_5":14750,"_28165":123493,"_3038":54994},[],{"_3569":73536,"_31013":73394,"_21476":123858,"_5":14750,"_28165":123493,"_3038":123859},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3569":73537,"_31013":73394,"_21476":123861,"_5":14750,"_28165":123493,"_3038":123862},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3569":73538,"_31013":73394,"_21476":123864,"_5":14750,"_28165":123493,"_3038":123552},[],{"_3569":73539,"_31013":73394,"_21476":123866,"_5":14750,"_28165":123493,"_3038":55005},[],{"_3569":73540,"_31013":73394,"_21476":123868,"_5":14750,"_28165":123493,"_3038":123869},[],"Certificado / Dispositivo",{"_3569":73541,"_31013":73394,"_21476":123871,"_5":14750,"_28165":123493,"_3038":55011},[],{"_3569":73542,"_31013":73394,"_21476":123873,"_5":14750,"_28165":123493,"_3038":51011},[],{"_3569":73543,"_31013":73394,"_21476":123875,"_5":14750,"_28165":123493,"_3038":123876},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3569":73544,"_31013":73394,"_21476":123878,"_5":14750,"_28165":123493,"_3038":123560},[],{"_3569":73545,"_31013":73394,"_21476":123880,"_5":14750,"_28165":123497,"_3038":123881},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3569":73546,"_31013":73394,"_21476":123883,"_5":14750,"_28165":123501,"_3038":123884},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3569":73547,"_31013":73394,"_21476":123886,"_5":14750,"_28165":123501,"_3038":123887},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3569":73548,"_31013":73394,"_21476":123889,"_5":14750,"_28165":123505,"_3038":123890},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3569":73549,"_31013":73394,"_21476":123892,"_5":14750,"_28165":123505,"_3038":123893},[],"Transición",{"_3569":73550,"_31013":73394,"_21476":123895,"_5":14750,"_28165":123505,"_3038":123896},[],"Llamadas AWS",{"_3569":73551,"_31013":73394,"_21476":123898,"_5":14750,"_28165":123505,"_3038":123899},[],"`NoRegistrada` → `Solicitada`",{"_3569":73552,"_31013":73394,"_21476":123901,"_5":14750,"_28165":123505,"_3038":123902},[],"ninguna (solo escritura de metadatos)",{"_3569":73553,"_31013":73394,"_21476":123904,"_5":14750,"_28165":123505,"_3038":123905},[],"`Solicitada` → `Registrando`",{"_3569":73554,"_31013":73394,"_21476":123907,"_5":14750,"_28165":123505,"_3038":123908},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3569":73555,"_31013":73394,"_21476":123910,"_5":14750,"_28165":123505,"_3038":123911},[],"`Registrando` → `Completada`",{"_3569":73556,"_31013":73394,"_21476":123913,"_5":14750,"_28165":123505,"_3038":123914},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3569":73557,"_31013":73394,"_21476":123916,"_5":14750,"_28165":123505,"_3038":123917},[],"`Registrando` → `Fallida`",{"_3569":73558,"_31013":73394,"_21476":123919,"_5":14750,"_28165":123505,"_3038":123920},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3569":73559,"_31013":73394,"_21476":123922,"_5":14750,"_28165":123505,"_3038":123923},[],"`Fallida` / `Completada` → `Solicitada`",{"_3569":73560,"_31013":73394,"_21476":123925,"_5":14750,"_28165":123505,"_3038":123926},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3569":73561,"_31013":73394,"_21476":123928,"_5":14750,"_28165":123509,"_3038":123929},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3569":73562,"_31013":73394,"_21476":123931,"_5":14750,"_28165":123509,"_3038":123932},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3569":73563,"_31013":73394,"_21476":123934,"_5":14750,"_28165":123509,"_3038":123935},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3569":73564,"_31013":73394,"_21476":123937,"_5":14750,"_28165":123509,"_3038":123938},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3569":73565,"_31013":73394,"_21476":123940,"_5":14750,"_28165":123509,"_3038":123941},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3569":73566,"_31013":73394,"_21476":123943,"_5":14750,"_28165":123509,"_3038":123944},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3569":73567,"_31013":73394,"_21476":123946,"_5":14750,"_28165":123512,"_3038":123947},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3569":73568,"_31013":73394,"_21476":123949,"_5":14750,"_28165":123515,"_3038":123950},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3569":73569,"_31013":73394,"_21476":123952,"_5":14750,"_28165":123515,"_3038":123953},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3569":73570,"_31013":73394,"_21476":123955,"_5":14750,"_28165":123519,"_3038":123956},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3569":73571,"_31013":73394,"_21476":123958,"_5":14750,"_28165":123523,"_3038":123959},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3569":73572,"_31013":73394,"_21476":123961,"_5":14750,"_28165":123523,"_3038":123962},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3569":73573,"_31013":73394,"_21476":123964,"_5":14750,"_28165":123523,"_3038":123965},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3569":73574,"_31013":73394,"_21476":123967,"_5":14750,"_28165":123523,"_3038":123968},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3569":73575,"_31013":73394,"_21476":123970,"_5":14750,"_28165":123523,"_3038":123971},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3569":73576,"_31013":73394,"_21476":123973,"_5":14750,"_28165":123523,"_3038":123974},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3569":73577,"_31013":73394,"_21476":123976,"_5":14750,"_28165":123527,"_3038":123977},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3569":73578,"_31013":73394,"_21476":123979,"_5":14750,"_28165":123527,"_3038":123980},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3569":73579,"_31013":73394,"_21476":123982,"_5":14750,"_28165":123527,"_3038":123983},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3569":73580,"_31013":73394,"_21476":123985,"_5":14750,"_28165":123527,"_3038":123986},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3569":73581,"_31013":73394,"_21476":123988,"_5":14750,"_28165":123527,"_3038":123989},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3569":73582,"_31013":73394,"_21476":123991,"_5":14750,"_28165":123531,"_3038":123992},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3569":73583,"_31013":73394,"_21476":123994,"_5":14750,"_28165":123531,"_3038":123893},[],{"_3569":73584,"_31013":73394,"_21476":123996,"_5":14750,"_28165":123531,"_3038":123896},[],{"_3569":73585,"_31013":73394,"_21476":123998,"_5":14750,"_28165":123531,"_3038":123999},[],"`SinConfigurar` → `None` / `Auto`",{"_3569":73586,"_31013":73394,"_21476":124001,"_5":14750,"_28165":123531,"_3038":124002},[],"ninguna (solo configuración)",{"_3569":73587,"_31013":73394,"_21476":124004,"_5":14750,"_28165":123531,"_3038":55148},[],{"_3569":73588,"_31013":73394,"_21476":124006,"_5":14750,"_28165":123531,"_3038":124002},[],{"_3569":73589,"_31013":73394,"_21476":124008,"_5":14750,"_28165":123531,"_3038":124009},[],"Cualquiera → `Jitp`",{"_3569":73590,"_31013":73394,"_21476":124011,"_5":14750,"_28165":123531,"_3038":124012},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3569":73591,"_31013":73394,"_21476":124014,"_5":14750,"_28165":123531,"_3038":55159},[],{"_3569":73592,"_31013":73394,"_21476":124016,"_5":14750,"_28165":123531,"_3038":124017},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3569":73593,"_31013":73394,"_21476":124019,"_5":14750,"_28165":123535,"_3038":124020},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3569":73594,"_31013":73394,"_21476":124022,"_5":14750,"_28165":123535,"_3038":124023},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3569":73595,"_31013":73394,"_21476":124025,"_5":14750,"_28165":123535,"_3038":124026},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3569":73596,"_31013":73394,"_21476":124028,"_5":14750,"_28165":123539,"_3038":124029},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3569":73597,"_31013":73394,"_21476":124031,"_5":14750,"_28165":123539,"_3038":123893},[],{"_3569":73598,"_31013":73394,"_21476":124033,"_5":14750,"_28165":123539,"_3038":123896},[],{"_3569":73599,"_31013":73394,"_21476":124035,"_5":14750,"_28165":123539,"_3038":124036},[],"`Ausente` → `Aprovisionado`",{"_3569":73600,"_31013":73394,"_21476":124038,"_5":14750,"_28165":123539,"_3038":124039},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3569":73601,"_31013":73394,"_21476":124041,"_5":14750,"_28165":123539,"_3038":124042},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3569":73602,"_31013":73394,"_21476":124044,"_5":14750,"_28165":123539,"_3038":124045},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3569":73603,"_31013":73394,"_21476":124047,"_5":14750,"_28165":123539,"_3038":124048},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3569":73604,"_31013":73394,"_21476":124050,"_5":14750,"_28165":123543,"_3038":124051},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3569":73605,"_31013":73394,"_21476":124053,"_5":14750,"_28165":123543,"_3038":124054},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3569":73606,"_31013":73394,"_21476":124056,"_5":14750,"_28165":123543,"_3038":124057},[],"Para que el flujo JITP funcione correctamente:",{"_3569":73607,"_31013":73394,"_21476":124059,"_5":14750,"_28165":123543,"_3038":124060},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3569":73608,"_31013":73394,"_21476":124062,"_5":14750,"_28165":123543,"_3038":124063},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3569":73609,"_31013":73394,"_21476":124065,"_5":14750,"_28165":123543,"_3038":124066},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3569":73610,"_31013":73394,"_21476":124068,"_5":14750,"_28165":123543,"_3038":124069},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3569":73611,"_31013":73394,"_21476":124071,"_5":14750,"_28165":123547,"_3038":124072},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3569":73612,"_31013":73394,"_21476":124074,"_5":14750,"_28165":123547,"_3038":124075},[],"Estado en Lamassu",{"_3569":73613,"_31013":73394,"_21476":124077,"_5":14750,"_28165":123547,"_3038":124078},[],"Razón de revocación",{"_3569":73614,"_31013":73394,"_21476":124080,"_5":14750,"_28165":123547,"_3038":124081},[],"Estado en AWS IoT Core",{"_3569":73615,"_31013":73394,"_21476":124083,"_5":14750,"_28165":123547,"_3038":55229},[],{"_3569":73616,"_31013":73394,"_21476":124085,"_5":14750,"_28165":123547,"_3038":124086},[],"Ninguna",{"_3569":73617,"_31013":73394,"_21476":124088,"_5":14750,"_28165":123547,"_3038":55235},[],{"_3569":73618,"_31013":73394,"_21476":124090,"_5":14750,"_28165":123547,"_3038":55238},[],{"_3569":73619,"_31013":73394,"_21476":124092,"_5":14750,"_28165":123547,"_3038":55241},[],{"_3569":73620,"_31013":73394,"_21476":124094,"_5":14750,"_28165":123547,"_3038":55244},[],{"_3569":73621,"_31013":73394,"_21476":124096,"_5":14750,"_28165":123547,"_3038":55238},[],{"_3569":73622,"_31013":73394,"_21476":124098,"_5":14750,"_28165":123547,"_3038":124099},[],"Cualquier otra razón",{"_3569":73623,"_31013":73394,"_21476":124101,"_5":14750,"_28165":123547,"_3038":55252},[],{"_3569":73624,"_31013":73394,"_21476":124103,"_5":14750,"_28165":123547,"_3038":124104},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3569":73625,"_31013":73394,"_21476":124106,"_5":14750,"_28165":123551,"_3038":124107},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3569":73626,"_31013":73394,"_21476":124109,"_5":14750,"_28165":123551,"_3038":123893},[],{"_3569":73627,"_31013":73394,"_21476":124111,"_5":14750,"_28165":123551,"_3038":123896},[],{"_3569":73628,"_31013":73394,"_21476":124113,"_5":14750,"_28165":123551,"_3038":124114},[],"`NoSincronizado` → `Active`",{"_3569":73629,"_31013":73394,"_21476":124116,"_5":14750,"_28165":123551,"_3038":54744},[],{"_3569":73630,"_31013":73394,"_21476":124118,"_5":14750,"_28165":123551,"_3038":55270},[],{"_3569":73631,"_31013":73394,"_21476":124120,"_5":14750,"_28165":123551,"_3038":124121},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3569":73632,"_31013":73394,"_21476":124123,"_5":14750,"_28165":123551,"_3038":55276},[],{"_3569":73633,"_31013":73394,"_21476":124125,"_5":14750,"_28165":123551,"_3038":124121},[],{"_3569":73634,"_31013":73394,"_21476":124127,"_5":14750,"_28165":123551,"_3038":55281},[],{"_3569":73635,"_31013":73394,"_21476":124129,"_5":14750,"_28165":123551,"_3038":54744},[],{"_3569":73636,"_31013":73394,"_21476":124131,"_5":14750,"_28165":123551,"_3038":55286},[],{"_3569":73637,"_31013":73394,"_21476":124133,"_5":14750,"_28165":123551,"_3038":124134},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3569":73638,"_31013":73394,"_21476":124136,"_5":14750,"_28165":123555,"_3038":124137},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3569":73639,"_31013":73394,"_21476":124139,"_5":14750,"_28165":123555,"_3038":124140},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3569":73640,"_31013":73394,"_21476":124142,"_5":14750,"_28165":123555,"_3038":124143},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3569":73641,"_31013":73394,"_21476":124145,"_5":14750,"_28165":123559,"_3038":124146},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3569":73642,"_31013":73394,"_21476":124148,"_5":14750,"_28165":123559,"_3038":124149},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3569":73643,"_31013":73394,"_21476":124151,"_5":14750,"_28165":123563,"_3038":124152},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3569":73644,"_31013":73394,"_21476":124154,"_5":14750,"_28165":123563,"_3038":124155},[],"Existen dos tipos de acciones:",{"_3569":73645,"_31013":73394,"_21476":124157,"_5":14750,"_28165":123563,"_3038":124158},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3569":73646,"_31013":73394,"_21476":124160,"_5":14750,"_28165":123563,"_3038":124161},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3569":73647,"_31013":73394,"_21476":124163,"_5":14750,"_28165":123563,"_3038":124164},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3569":73648,"_31013":73394,"_21476":124166,"_5":14750,"_28165":123567,"_3038":124167},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3569":73649,"_31013":73394,"_21476":124169,"_5":14750,"_28165":123567,"_3038":124170},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3569":73650,"_31013":73394,"_21476":124172,"_5":14750,"_28165":123567,"_3038":124173},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3569":73651,"_31013":73394,"_21476":124175,"_5":14750,"_28165":123571,"_3038":124176},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3569":73652,"_31013":73394,"_21476":124178,"_5":14750,"_28165":123571,"_3038":124179},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3569":73653,"_31013":73394,"_21476":124181,"_5":14750,"_28165":123571,"_3038":124182},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3569":73654,"_31013":73394,"_21476":124184,"_5":14750,"_28165":123571,"_3038":124185},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3569":73655,"_31013":73394,"_21476":124187,"_5":14750,"_28165":123571,"_3038":124188},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3569":73656,"_31013":73394,"_21476":124190,"_5":14750,"_28165":123571,"_3038":124191},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3569":73657,"_31013":73394,"_21476":124193,"_5":14750,"_28165":123571,"_3038":124194},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3569":73658,"_31013":73394,"_21476":124196,"_5":14750,"_28165":123571,"_3038":124197},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3569":73659,"_31013":73394,"_21476":124199,"_5":14750,"_28165":123571,"_3038":124200},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3569":73660,"_31013":73394,"_21476":124202,"_5":14750,"_28165":123571,"_3038":124203},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3569":73661,"_31013":73394,"_21476":124205,"_5":14750,"_28165":123571,"_3038":124206},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3569":73662,"_31013":73394,"_21476":124208,"_5":14750,"_28165":123571,"_3038":124209},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3569":73663,"_31013":73394,"_21476":124211,"_5":14750,"_28165":123571,"_3038":124212},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3569":73664,"_31013":73394,"_21476":124214,"_5":14750,"_28165":123571,"_3038":124215},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3569":73665,"_31013":73394,"_21476":124217,"_5":14750,"_28165":123571,"_3038":124218},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3569":73666,"_31013":73394,"_21476":124220,"_5":14750,"_28165":123571,"_3038":124221},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3569":73667,"_31013":73394,"_21476":124223,"_5":14750,"_28165":123571,"_3038":124224},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3569":73668,"_31013":73394,"_21476":124226,"_5":14750,"_28165":123571,"_3038":124227},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3569":73669,"_31013":73394,"_21476":124229,"_5":14750,"_28165":123571,"_3038":124230},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3569":73670,"_31013":73394,"_21476":124232,"_5":14750,"_28165":123571,"_3038":124233},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3569":73671,"_31013":73394,"_21476":124235,"_5":14750,"_28165":123571,"_3038":124236},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3569":73672,"_31013":73394,"_21476":124238,"_5":14750,"_28165":123571,"_3038":124239},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3569":73673,"_31013":73394,"_21476":124241,"_5":14750,"_28165":123571,"_3038":124242},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3569":73674,"_31013":73394,"_21476":124244,"_5":14750,"_28165":123571,"_3038":124245},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3569":73675,"_31013":73675,"_5":15116,"_3038":53104,"_31371":124247,"_21476":124248,"_28165":73675},[50615,121048,53104],[],{"_3569":73676,"_31013":73675,"_21476":124250,"_5":14750,"_28165":73675,"_3038":124251},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3569":73677,"_31013":73675,"_5":31368,"_21476":124253,"_28165":124254,"_3038":124255},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3569":73678,"_31013":73675,"_5":31368,"_21476":124257,"_28165":124258,"_3038":122060},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3569":73679,"_31013":73675,"_5":31368,"_21476":124260,"_28165":124261,"_3038":122235},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3569":73680,"_31013":73675,"_5":31368,"_21476":124263,"_28165":124264,"_3038":123470},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#integraciones",{"_3569":73681,"_31013":73675,"_5":31368,"_21476":124266,"_28165":124267,"_3038":124268},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3569":73682,"_31013":73675,"_21476":124270,"_5":14750,"_28165":73675,"_3038":124271},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3569":73683,"_31013":73675,"_21476":124273,"_5":14750,"_28165":124254,"_3038":124274},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3569":73684,"_31013":73675,"_21476":124276,"_5":14750,"_28165":124254,"_3038":124277},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3569":73685,"_31013":73675,"_21476":124279,"_5":14750,"_28165":124258,"_3038":124280},[],"Recurso",{"_3569":73686,"_31013":73675,"_21476":124282,"_5":14750,"_28165":124258,"_3038":124283},[],"Qué representa",{"_3569":73687,"_31013":73675,"_21476":124285,"_5":14750,"_28165":124258,"_3038":124286},[],"**Dispositivo**",{"_3569":73688,"_31013":73675,"_21476":124288,"_5":14750,"_28165":124258,"_3038":124289},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3569":73689,"_31013":73675,"_21476":124291,"_5":14750,"_28165":124258,"_3038":124292},[],"**Identidad**",{"_3569":73690,"_31013":73675,"_21476":124294,"_5":14750,"_28165":124258,"_3038":124295},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3569":73691,"_31013":73675,"_21476":124297,"_5":14750,"_28165":124258,"_3038":55453},[],{"_3569":73692,"_31013":73675,"_21476":124299,"_5":14750,"_28165":124258,"_3038":124300},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3569":73693,"_31013":73675,"_21476":124302,"_5":14750,"_28165":124258,"_3038":124303},[],"**Flota**",{"_3569":73694,"_31013":73675,"_21476":124305,"_5":14750,"_28165":124258,"_3038":124306},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3569":73695,"_31013":73675,"_21476":124308,"_5":14750,"_28165":124258,"_3038":124309},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3569":73696,"_31013":73675,"_21476":124311,"_5":14750,"_28165":124258,"_3038":124312},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3569":73697,"_31013":73675,"_21476":124314,"_5":14750,"_28165":124261,"_3038":124315},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3569":73698,"_31013":73675,"_21476":124317,"_5":14750,"_28165":124261,"_3038":124318},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3569":73699,"_31013":73675,"_21476":124320,"_5":14750,"_28165":124261,"_3038":124321},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3569":73700,"_31013":73675,"_21476":124323,"_5":14750,"_28165":124261,"_3038":124324},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3569":73701,"_31013":73675,"_21476":124326,"_5":14750,"_28165":124261,"_3038":124327},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3569":73702,"_31013":73675,"_21476":124329,"_5":14750,"_28165":124261,"_3038":124330},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3569":73703,"_31013":73675,"_21476":124332,"_5":14750,"_28165":124261,"_3038":124333},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3569":73704,"_31013":73675,"_21476":124335,"_5":14750,"_28165":124261,"_3038":124336},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3569":73705,"_31013":73675,"_21476":124338,"_5":14750,"_28165":124264,"_3038":124339},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3569":73706,"_31013":73675,"_21476":124341,"_5":14750,"_28165":124264,"_3038":124342},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3569":73707,"_31013":73675,"_21476":124344,"_5":14750,"_28165":124267,"_3038":124345},[],"Participante",{"_3569":73708,"_31013":73675,"_21476":124347,"_5":14750,"_28165":124267,"_3038":124348},[],"Responsabilidad",{"_3569":73709,"_31013":73675,"_21476":124350,"_5":14750,"_28165":124267,"_3038":124351},[],"Administrador PKI",{"_3569":73710,"_31013":73675,"_21476":124353,"_5":14750,"_28165":124267,"_3038":124354},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3569":73711,"_31013":73675,"_21476":124356,"_5":14750,"_28165":124267,"_3038":124357},[],"Administrador del aprovisionamiento",{"_3569":73712,"_31013":73675,"_21476":124359,"_5":14750,"_28165":124267,"_3038":124360},[],"DMS, admisión, autenticación por operación e inventario.",{"_3569":73713,"_31013":73675,"_21476":124362,"_5":14750,"_28165":124267,"_3038":124363},[],"Integrador del dispositivo",{"_3569":73714,"_31013":73675,"_21476":124365,"_5":14750,"_28165":124267,"_3038":124366},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3569":73715,"_31013":73675,"_21476":124368,"_5":14750,"_28165":124267,"_3038":124369},[],"Integrador del consumidor",{"_3569":73716,"_31013":73675,"_21476":124371,"_5":14750,"_28165":124267,"_3038":124372},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3569":73717,"_31013":73675,"_21476":124374,"_5":14750,"_28165":124267,"_3038":124375},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3569":73718,"_31013":73718,"_5":15116,"_3038":124377,"_31371":124378,"_21476":124380,"_28165":73718},"Enrola y conecta tu primer dispositivo",[50615,121048,53104,124379],"Primeros pasos",[],{"_3569":73719,"_31013":73718,"_21476":124382,"_5":14750,"_28165":73718,"_3038":124383},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3569":73720,"_31013":73718,"_5":31368,"_21476":124385,"_28165":124386,"_3038":119619},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3569":73721,"_31013":73718,"_5":31368,"_21476":124388,"_28165":124389,"_3038":124390},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3569":73722,"_31013":73718,"_5":31368,"_21476":124392,"_28165":124393,"_3038":124394},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3569":73723,"_31013":73718,"_5":31368,"_21476":124396,"_28165":124397,"_3038":124398},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3569":73724,"_31013":73718,"_5":31368,"_21476":124400,"_28165":124401,"_3038":124402},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3569":73725,"_31013":73718,"_5":31368,"_21476":124404,"_28165":124405,"_3038":124406},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3569":73726,"_31013":73718,"_5":31368,"_21476":124408,"_28165":124409,"_3038":124410},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3569":73727,"_31013":73718,"_5":31368,"_21476":124412,"_28165":124413,"_3038":124414},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3569":73728,"_31013":73718,"_21476":124416,"_5":14750,"_28165":73718,"_3038":124417},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3569":73729,"_31013":73718,"_21476":124419,"_5":14750,"_28165":124386,"_3038":124420},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3569":73730,"_31013":73718,"_21476":124422,"_5":14750,"_28165":124386,"_3038":124423},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3569":73731,"_31013":73718,"_21476":124425,"_5":14750,"_28165":124386,"_3038":124426},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3569":73732,"_31013":73718,"_21476":124428,"_5":14750,"_28165":124386,"_3038":124429},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3569":73733,"_31013":73718,"_21476":124431,"_5":14750,"_28165":124386,"_3038":124432},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3569":73734,"_31013":73718,"_21476":124434,"_5":14750,"_28165":124389,"_3038":124435},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3569":73735,"_31013":73718,"_21476":124437,"_5":14750,"_28165":124389,"_3038":124438},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3569":73736,"_31013":73718,"_21476":124440,"_5":14750,"_28165":124393,"_3038":124441},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3569":73737,"_31013":73718,"_21476":124443,"_5":14750,"_28165":124393,"_3038":124444},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3569":73738,"_31013":73718,"_21476":124446,"_5":14750,"_28165":124393,"_3038":124447},[],"Ajuste",{"_3569":73739,"_31013":73718,"_21476":124449,"_5":14750,"_28165":124393,"_3038":124450},[],"Valor de evaluación",{"_3569":73740,"_31013":73718,"_21476":124452,"_5":14750,"_28165":124393,"_3038":55609},[],{"_3569":73741,"_31013":73718,"_21476":124454,"_5":14750,"_28165":124393,"_3038":124455},[],"Raíz emisora de `device-root.pem`.",{"_3569":73742,"_31013":73718,"_21476":124457,"_5":14750,"_28165":124393,"_3038":122363},[],{"_3569":73743,"_31013":73718,"_21476":124459,"_5":14750,"_28165":124393,"_3038":124460},[],"Perfil final de 1 hora que acabas de preparar.",{"_3569":73744,"_31013":73718,"_21476":124462,"_5":14750,"_28165":124393,"_3038":55620},[],{"_3569":73745,"_31013":73718,"_21476":124464,"_5":14750,"_28165":124393,"_3038":55623},[],{"_3569":73746,"_31013":73718,"_21476":124466,"_5":14750,"_28165":124393,"_3038":55626},[],{"_3569":73747,"_31013":73718,"_21476":124468,"_5":14750,"_28165":124393,"_3038":124469},[],"Habilitado.",{"_3569":73748,"_31013":73718,"_21476":124471,"_5":14750,"_28165":124393,"_3038":55632},[],{"_3569":73749,"_31013":73718,"_21476":124473,"_5":14750,"_28165":124393,"_3038":124474},[],"Deshabilitado; el ID debe ser nuevo.",{"_3569":73750,"_31013":73718,"_21476":124476,"_5":14750,"_28165":124393,"_3038":124477},[],"Autenticación inicial",{"_3569":73751,"_31013":73718,"_21476":124479,"_5":14750,"_28165":124393,"_3038":124480},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3569":73752,"_31013":73718,"_21476":124482,"_5":14750,"_28165":124393,"_3038":124483},[],"Autenticación de renovación",{"_3569":73753,"_31013":73718,"_21476":124485,"_5":14750,"_28165":124393,"_3038":124486},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3569":73754,"_31013":73718,"_21476":124488,"_5":14750,"_28165":124393,"_3038":55650},[],{"_3569":73755,"_31013":73718,"_21476":124490,"_5":14750,"_28165":124393,"_3038":124491},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3569":73756,"_31013":73718,"_21476":124493,"_5":14750,"_28165":124393,"_3038":55656},[],{"_3569":73757,"_31013":73718,"_21476":124495,"_5":14750,"_28165":124393,"_3038":124496},[],"1 hora.",{"_3569":73758,"_31013":73718,"_21476":124498,"_5":14750,"_28165":124393,"_3038":55662},[],{"_3569":73759,"_31013":73718,"_21476":124500,"_5":14750,"_28165":124393,"_3038":124501},[],"30 minutos / 10 minutos.",{"_3569":73760,"_31013":73718,"_21476":124503,"_5":14750,"_28165":124393,"_3038":55668},[],{"_3569":73761,"_31013":73718,"_21476":124505,"_5":14750,"_28165":124393,"_3038":124506},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3569":73762,"_31013":73718,"_21476":124508,"_5":14750,"_28165":124393,"_3038":53423},[],{"_3569":73763,"_31013":73718,"_21476":124510,"_5":14750,"_28165":124393,"_3038":124511},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3569":73764,"_31013":73718,"_21476":124513,"_5":14750,"_28165":124393,"_3038":55679},[],{"_3569":73765,"_31013":73718,"_21476":124515,"_5":14750,"_28165":124393,"_3038":124516},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3569":73766,"_31013":73718,"_21476":124518,"_5":14750,"_28165":124393,"_3038":124519},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3569":73767,"_31013":73718,"_21476":124521,"_5":14750,"_28165":124397,"_3038":124522},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3569":73768,"_31013":73718,"_21476":124524,"_5":14750,"_28165":124397,"_3038":124525},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3569":73769,"_31013":73718,"_21476":124527,"_5":14750,"_28165":124401,"_3038":124528},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3569":73770,"_31013":73718,"_21476":124530,"_5":14750,"_28165":124401,"_3038":124531},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3569":73771,"_31013":73718,"_21476":124533,"_5":14750,"_28165":124401,"_3038":124534},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3569":73772,"_31013":73718,"_21476":124536,"_5":14750,"_28165":124405,"_3038":124537},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3569":73773,"_31013":73718,"_21476":124539,"_5":14750,"_28165":124405,"_3038":124540},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3569":73774,"_31013":73718,"_21476":124542,"_5":14750,"_28165":124409,"_3038":124543},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3569":73775,"_31013":73718,"_21476":124545,"_5":14750,"_28165":124409,"_3038":124546},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3569":73776,"_31013":73718,"_21476":124548,"_5":14750,"_28165":124409,"_3038":124549},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3569":73777,"_31013":73718,"_21476":124551,"_5":14750,"_28165":124409,"_3038":124552},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3569":73778,"_31013":73718,"_21476":124554,"_5":14750,"_28165":124409,"_3038":124555},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3569":73779,"_31013":73718,"_21476":124557,"_5":14750,"_28165":124413,"_3038":124558},[],"Comprobación",{"_3569":73780,"_31013":73718,"_21476":124560,"_5":14750,"_28165":124413,"_3038":124561},[],"Resultado esperado",{"_3569":73781,"_31013":73718,"_21476":124563,"_5":14750,"_28165":124413,"_3038":124564},[],"Registro",{"_3569":73782,"_31013":73718,"_21476":124566,"_5":14750,"_28165":124413,"_3038":124567},[],"ID creado automáticamente y DMS correcto.",{"_3569":73783,"_31013":73718,"_21476":124569,"_5":14750,"_28165":124413,"_3038":123854},[],{"_3569":73784,"_31013":73718,"_21476":124571,"_5":14750,"_28165":124413,"_3038":124572},[],"CN, perfil, serie y clave verificados.",{"_3569":73785,"_31013":73718,"_21476":124574,"_5":14750,"_28165":124413,"_3038":124575},[],"Inventario",{"_3569":73786,"_31013":73718,"_21476":124577,"_5":14750,"_28165":124413,"_3038":124578},[],"Serie recibida visible como identidad actual y en el historial.",{"_3569":73787,"_31013":73718,"_21476":124580,"_5":14750,"_28165":124413,"_3038":124581},[],"Consumidor",{"_3569":73788,"_31013":73718,"_21476":124583,"_5":14750,"_28165":124413,"_3038":124584},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3569":73789,"_31013":73718,"_21476":124586,"_5":14750,"_28165":124413,"_3038":124587},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3569":73790,"_31013":73718,"_21476":124589,"_5":14750,"_28165":124413,"_3038":124590},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3569":73791,"_31013":73791,"_5":15116,"_3038":122077,"_31371":124592,"_21476":124593,"_28165":73791},[50615,121048,53104,124379],[],{"_3569":73792,"_31013":73791,"_21476":124595,"_5":14750,"_28165":73791,"_3038":124596},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3569":73793,"_31013":73791,"_5":31368,"_21476":124598,"_28165":124599,"_3038":119619},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3569":73794,"_31013":73791,"_5":31368,"_21476":124601,"_28165":124602,"_3038":124603},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3569":73795,"_31013":73791,"_5":31368,"_21476":124605,"_28165":124606,"_3038":124607},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3569":73796,"_31013":73791,"_5":31368,"_21476":124609,"_28165":124610,"_3038":124611},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3569":73797,"_31013":73791,"_5":31368,"_21476":124613,"_28165":124614,"_3038":124615},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3569":73798,"_31013":73791,"_5":31368,"_21476":124617,"_28165":124618,"_3038":124619},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3569":73799,"_31013":73791,"_5":31368,"_21476":124621,"_28165":124622,"_3038":124561},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3569":73800,"_31013":73791,"_5":31368,"_21476":124624,"_28165":124625,"_3038":124626},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3569":73801,"_31013":73791,"_5":31368,"_21476":124628,"_28165":124629,"_3038":124630},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3569":73802,"_31013":73791,"_21476":124632,"_5":14750,"_28165":73791,"_3038":124633},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3569":73803,"_31013":73791,"_21476":124635,"_5":14750,"_28165":73791,"_3038":124636},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3569":73804,"_31013":73791,"_21476":124638,"_5":14750,"_28165":124599,"_3038":124639},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3569":73805,"_31013":73791,"_21476":124641,"_5":14750,"_28165":124599,"_3038":124642},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3569":73806,"_31013":73791,"_21476":124644,"_5":14750,"_28165":124599,"_3038":124645},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3569":73807,"_31013":73791,"_21476":124647,"_5":14750,"_28165":124599,"_3038":124648},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3569":73808,"_31013":73791,"_21476":124650,"_5":14750,"_28165":124602,"_3038":124651},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3569":73809,"_31013":73791,"_21476":124653,"_5":14750,"_28165":124602,"_3038":124654},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3569":73810,"_31013":73791,"_21476":124656,"_5":14750,"_28165":124602,"_3038":124657},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3569":73811,"_31013":73791,"_21476":124659,"_5":14750,"_28165":124602,"_3038":124660},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3569":73812,"_31013":73791,"_21476":124662,"_5":14750,"_28165":124602,"_3038":124663},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3569":73813,"_31013":73791,"_21476":124665,"_5":14750,"_28165":124602,"_3038":124666},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3569":73814,"_31013":73791,"_21476":124668,"_5":14750,"_28165":124602,"_3038":124669},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3569":73815,"_31013":73791,"_21476":124671,"_5":14750,"_28165":124602,"_3038":124672},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3569":73816,"_31013":73791,"_21476":124674,"_5":14750,"_28165":124606,"_3038":124675},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3569":73817,"_31013":73791,"_21476":124677,"_5":14750,"_28165":124606,"_3038":55844},[],{"_3569":73818,"_31013":73791,"_21476":124679,"_5":14750,"_28165":124606,"_3038":124680},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3569":73819,"_31013":73791,"_21476":124682,"_5":14750,"_28165":124606,"_3038":124683},[],"**Icon** y **Tags**: clasificación opcional.",{"_3569":73820,"_31013":73791,"_21476":124685,"_5":14750,"_28165":124606,"_3038":124686},[],"Confirma el registro.",{"_3569":73821,"_31013":73791,"_21476":124688,"_5":14750,"_28165":124610,"_3038":124689},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3569":73822,"_31013":73791,"_21476":124691,"_5":14750,"_28165":124610,"_3038":124692},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3569":73823,"_31013":73791,"_21476":124694,"_5":14750,"_28165":124614,"_3038":124695},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3569":73824,"_31013":73791,"_21476":124697,"_5":14750,"_28165":124614,"_3038":124698},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3569":73825,"_31013":73791,"_21476":124700,"_5":14750,"_28165":124618,"_3038":124701},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3569":73826,"_31013":73791,"_21476":124703,"_5":14750,"_28165":124618,"_3038":124704},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3569":73827,"_31013":73791,"_21476":124706,"_5":14750,"_28165":124622,"_3038":124558},[],{"_3569":73828,"_31013":73791,"_21476":124708,"_5":14750,"_28165":124622,"_3038":124709},[],"Resultado",{"_3569":73829,"_31013":73791,"_21476":124711,"_5":14750,"_28165":124622,"_3038":123840},[],{"_3569":73830,"_31013":73791,"_21476":124713,"_5":14750,"_28165":124622,"_3038":124714},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3569":73831,"_31013":73791,"_21476":124716,"_5":14750,"_28165":124622,"_3038":124717},[],"Identidad actual",{"_3569":73832,"_31013":73791,"_21476":124719,"_5":14750,"_28165":124622,"_3038":124720},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3569":73833,"_31013":73791,"_21476":124722,"_5":14750,"_28165":124622,"_3038":124723},[],"Historial",{"_3569":73834,"_31013":73791,"_21476":124725,"_5":14750,"_28165":124622,"_3038":124726},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3569":73835,"_31013":73791,"_21476":124728,"_5":14750,"_28165":124622,"_3038":124729},[],"Clave y certificado",{"_3569":73836,"_31013":73791,"_21476":124731,"_5":14750,"_28165":124622,"_3038":124732},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3569":73837,"_31013":73791,"_21476":124734,"_5":14750,"_28165":124625,"_3038":124735},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3569":73838,"_31013":73791,"_21476":124737,"_5":14750,"_28165":124625,"_3038":124738},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3569":73839,"_31013":73791,"_21476":124740,"_5":14750,"_28165":124625,"_3038":124741},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3569":73840,"_31013":73791,"_21476":124743,"_5":14750,"_28165":124625,"_3038":124744},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3569":73841,"_31013":73791,"_21476":124746,"_5":14750,"_28165":124629,"_3038":124747},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3569":73842,"_31013":73791,"_21476":124749,"_5":14750,"_28165":124629,"_3038":124750},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3569":73843,"_31013":73791,"_21476":124752,"_5":14750,"_28165":124629,"_3038":124753},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3569":73844,"_31013":73844,"_5":15116,"_3038":124755,"_31371":124756,"_21476":124757,"_28165":73844},"Plataforma Lamassu IoT",[50615,121048],[],{"_3569":73845,"_31013":73844,"_21476":124759,"_5":14750,"_28165":73844,"_3038":124760},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3569":73846,"_31013":73844,"_5":31368,"_21476":124762,"_28165":124763,"_3038":124255},[],"/docs/pr-preview/pr-61/es/platform/overview#empieza-aquí",{"_3569":73847,"_31013":73844,"_5":31368,"_21476":124765,"_28165":124766,"_3038":124767},[],"/docs/pr-preview/pr-61/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3569":73848,"_31013":73844,"_5":31368,"_21476":124769,"_28165":124770,"_3038":124771},[],"/docs/pr-preview/pr-61/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3569":73849,"_31013":73844,"_5":31368,"_21476":124773,"_28165":124774,"_3038":124775},[],"/docs/pr-preview/pr-61/es/platform/overview#capacidades-principales","Capacidades principales",{"_3569":73850,"_31013":73844,"_5":31368,"_21476":124777,"_28165":124778,"_3038":124779},[],"/docs/pr-preview/pr-61/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3569":73851,"_31013":73844,"_5":31368,"_21476":124781,"_28165":124782,"_3038":124783},[],"/docs/pr-preview/pr-61/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3569":73852,"_31013":73844,"_5":31368,"_21476":124785,"_28165":124786,"_3038":124787},[],"/docs/pr-preview/pr-61/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3569":73853,"_31013":73844,"_5":31368,"_21476":124789,"_28165":124790,"_3038":124791},[],"/docs/pr-preview/pr-61/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3569":73854,"_31013":73844,"_5":31368,"_21476":124793,"_28165":124794,"_3038":124795},[],"/docs/pr-preview/pr-61/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3569":73855,"_31013":73844,"_5":31368,"_21476":124797,"_28165":124798,"_3038":124799},[],"/docs/pr-preview/pr-61/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3569":73856,"_31013":73844,"_5":31368,"_21476":124801,"_28165":124802,"_3038":124803},[],"/docs/pr-preview/pr-61/es/platform/overview#referencia-operativa","Referencia operativa",{"_3569":73857,"_31013":73844,"_21476":124805,"_5":14750,"_28165":73844,"_3038":124806},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3569":73858,"_31013":73844,"_21476":124808,"_5":14750,"_28165":124763,"_3038":124809},[],"Elige el resultado que necesitas obtener:",{"_3569":73859,"_31013":73844,"_21476":124811,"_5":14750,"_28165":124763,"_3038":124812},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3569":73860,"_31013":73844,"_21476":124814,"_5":14750,"_28165":124763,"_3038":124815},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3569":73861,"_31013":73844,"_21476":124817,"_5":14750,"_28165":124763,"_3038":124818},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3569":73862,"_31013":73844,"_21476":124820,"_5":14750,"_28165":124766,"_3038":124821},[],"Bloque",{"_3569":73863,"_31013":73844,"_21476":124823,"_5":14750,"_28165":124766,"_3038":124824},[],"Qué gestionas",{"_3569":73864,"_31013":73844,"_21476":124826,"_5":14750,"_28165":124766,"_3038":124827},[],"Punto de entrada",{"_3569":73865,"_31013":73844,"_21476":124829,"_5":14750,"_28165":124766,"_3038":55997},[],{"_3569":73866,"_31013":73844,"_21476":124831,"_5":14750,"_28165":124766,"_3038":124832},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3569":73867,"_31013":73844,"_21476":124834,"_5":14750,"_28165":124766,"_3038":124835},[],"Visión general de PKI",{"_3569":73868,"_31013":73844,"_21476":124837,"_5":14750,"_28165":124766,"_3038":56006},[],{"_3569":73869,"_31013":73844,"_21476":124839,"_5":14750,"_28165":124766,"_3038":124840},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3569":73870,"_31013":73844,"_21476":124842,"_5":14750,"_28165":124766,"_3038":124843},[],"Visión general de IoT Fleets",{"_3569":73871,"_31013":73844,"_21476":124845,"_5":14750,"_28165":124766,"_3038":124846},[],"**Administración**",{"_3569":73872,"_31013":73844,"_21476":124848,"_5":14750,"_28165":124766,"_3038":124849},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3569":73873,"_31013":73844,"_21476":124851,"_5":14750,"_28165":124766,"_3038":121046},[],{"_3569":73874,"_31013":73844,"_21476":124853,"_5":14750,"_28165":124766,"_3038":124854},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3569":73875,"_31013":73844,"_21476":124856,"_5":14750,"_28165":124770,"_3038":124857},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3569":73876,"_31013":73844,"_21476":124859,"_5":14750,"_28165":124770,"_3038":124860},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3569":73877,"_31013":73844,"_21476":124862,"_5":14750,"_28165":124770,"_3038":124863},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3569":73878,"_31013":73844,"_21476":124865,"_5":14750,"_28165":124770,"_3038":124866},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3569":73879,"_31013":73844,"_21476":124868,"_5":14750,"_28165":124770,"_3038":124869},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3569":73880,"_31013":73844,"_21476":124871,"_5":14750,"_28165":124770,"_3038":124872},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3569":73881,"_31013":73844,"_21476":124874,"_5":14750,"_28165":124778,"_3038":124875},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3569":73882,"_31013":73844,"_21476":124877,"_5":14750,"_28165":124782,"_3038":124878},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3569":73883,"_31013":73844,"_21476":124880,"_5":14750,"_28165":124786,"_3038":124881},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3569":73884,"_31013":73844,"_21476":124883,"_5":14750,"_28165":124790,"_3038":124884},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3569":73885,"_31013":73844,"_21476":124886,"_5":14750,"_28165":124794,"_3038":124887},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3569":73886,"_31013":73844,"_21476":124889,"_5":14750,"_28165":124798,"_3038":124890},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3569":73887,"_31013":73844,"_21476":124892,"_5":14750,"_28165":124802,"_3038":124348},[],{"_3569":73888,"_31013":73844,"_21476":124894,"_5":14750,"_28165":124802,"_3038":124895},[],"Qué prepara o comprueba",{"_3569":73889,"_31013":73844,"_21476":124897,"_5":14750,"_28165":124802,"_3038":124351},[],{"_3569":73890,"_31013":73844,"_21476":124899,"_5":14750,"_28165":124802,"_3038":124900},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3569":73891,"_31013":73844,"_21476":124902,"_5":14750,"_28165":124802,"_3038":124903},[],"Administrador de la flota",{"_3569":73892,"_31013":73844,"_21476":124905,"_5":14750,"_28165":124802,"_3038":124906},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3569":73893,"_31013":73844,"_21476":124908,"_5":14750,"_28165":124802,"_3038":124363},[],{"_3569":73894,"_31013":73844,"_21476":124910,"_5":14750,"_28165":124802,"_3038":124911},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3569":73895,"_31013":73844,"_21476":124913,"_5":14750,"_28165":124802,"_3038":124369},[],{"_3569":73896,"_31013":73844,"_21476":124915,"_5":14750,"_28165":124802,"_3038":124916},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3569":73897,"_31013":73844,"_21476":124918,"_5":14750,"_28165":124802,"_3038":124919},[],"Operador de infraestructura",{"_3569":73898,"_31013":73844,"_21476":124921,"_5":14750,"_28165":124802,"_3038":124922},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3569":73899,"_31013":73844,"_21476":124924,"_5":14750,"_28165":124802,"_3038":124925},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3569":73900,"_31013":73900,"_5":15116,"_3038":124927,"_31371":124928,"_21476":124930,"_28165":73900},"Jerarquía y rotación de CAs",[50615,121048,56098,124929],"Claves, autoridades y certificados",[],{"_3569":73901,"_31013":73900,"_21476":124932,"_5":14750,"_28165":73900,"_3038":124933},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3569":73902,"_31013":73900,"_5":31368,"_21476":124935,"_28165":124936,"_3038":124937},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3569":73903,"_31013":73900,"_5":31368,"_21476":124939,"_28165":124940,"_3038":124941},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3569":73904,"_31013":73900,"_5":31368,"_21476":124943,"_28165":124944,"_3038":124945},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3569":73905,"_31013":73900,"_5":31368,"_21476":124947,"_28165":124948,"_3038":124949},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3569":73906,"_31013":73900,"_5":31368,"_21476":124951,"_28165":124952,"_3038":124953},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3569":73907,"_31013":73900,"_5":31368,"_21476":124955,"_28165":124956,"_3038":124957},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3569":73908,"_31013":73900,"_5":31368,"_21476":124959,"_28165":124960,"_3038":124961},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3569":73909,"_31013":73900,"_5":31368,"_21476":124963,"_28165":124964,"_3038":124965},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3569":73910,"_31013":73900,"_5":31368,"_21476":124967,"_28165":124968,"_3038":124969},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3569":73911,"_31013":73900,"_5":31368,"_21476":124971,"_28165":124972,"_3038":124973},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3569":73912,"_31013":73900,"_5":31368,"_21476":124975,"_28165":124976,"_3038":124977},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3569":73913,"_31013":73900,"_5":31368,"_21476":124979,"_28165":124980,"_3038":124981},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3569":73914,"_31013":73900,"_21476":124983,"_5":14750,"_28165":73900,"_3038":124984},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3569":73915,"_31013":73900,"_21476":124986,"_5":14750,"_28165":73900,"_3038":124987},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3569":73916,"_31013":73900,"_21476":124989,"_5":14750,"_28165":124936,"_3038":124990},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3569":73917,"_31013":73900,"_21476":124992,"_5":14750,"_28165":124936,"_3038":124993},[],"entorno, como producción y preproducción;",{"_3569":73918,"_31013":73900,"_21476":124995,"_5":14750,"_28165":124936,"_3038":124996},[],"propietario o equipo operador;",{"_3569":73919,"_31013":73900,"_21476":124998,"_5":14750,"_28165":124936,"_3038":124999},[],"familia de dispositivos o proceso de fabricación;",{"_3569":73920,"_31013":73900,"_21476":125001,"_5":14750,"_28165":124936,"_3038":125002},[],"región o requisito regulatorio;",{"_3569":73921,"_31013":73900,"_21476":125004,"_5":14750,"_28165":124936,"_3038":125005},[],"motor criptográfico o política de clave;",{"_3569":73922,"_31013":73900,"_21476":125007,"_5":14750,"_28165":124936,"_3038":125008},[],"ventana de mantenimiento y ritmo de renovación.",{"_3569":73923,"_31013":73900,"_21476":125010,"_5":14750,"_28165":124936,"_3038":125011},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3569":73924,"_31013":73900,"_21476":125013,"_5":14750,"_28165":124936,"_3038":125014},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3569":73925,"_31013":73900,"_21476":125016,"_5":14750,"_28165":124940,"_3038":125017},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3569":73926,"_31013":73900,"_21476":125019,"_5":14750,"_28165":124940,"_3038":125020},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3569":73927,"_31013":73900,"_21476":125022,"_5":14750,"_28165":124940,"_3038":125023},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3569":73928,"_31013":73900,"_21476":125025,"_5":14750,"_28165":124940,"_3038":125026},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3569":73929,"_31013":73900,"_21476":125028,"_5":14750,"_28165":124944,"_3038":125029},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3569":73930,"_31013":73900,"_21476":125031,"_5":14750,"_28165":124944,"_3038":125032},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3569":73931,"_31013":73900,"_21476":125034,"_5":14750,"_28165":124944,"_3038":125035},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3569":73932,"_31013":73900,"_21476":125037,"_5":14750,"_28165":124944,"_3038":125038},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3569":73933,"_31013":73900,"_21476":125040,"_5":14750,"_28165":124952,"_3038":125041},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3569":73934,"_31013":73900,"_21476":125043,"_5":14750,"_28165":124956,"_3038":125044},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3569":73935,"_31013":73900,"_21476":125046,"_5":14750,"_28165":124960,"_3038":125047},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3569":73936,"_31013":73900,"_21476":125049,"_5":14750,"_28165":124964,"_3038":125050},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3569":73937,"_31013":73900,"_21476":125052,"_5":14750,"_28165":124968,"_3038":125053},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3569":73938,"_31013":73900,"_21476":125055,"_5":14750,"_28165":124972,"_3038":125056},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3569":73939,"_31013":73900,"_21476":125058,"_5":14750,"_28165":124976,"_3038":125059},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3569":73940,"_31013":73900,"_21476":125061,"_5":14750,"_28165":124976,"_3038":125062},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3569":73941,"_31013":73900,"_21476":125064,"_5":14750,"_28165":124976,"_3038":125065},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3569":73942,"_31013":73900,"_21476":125067,"_5":14750,"_28165":124976,"_3038":125068},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3569":73943,"_31013":73900,"_21476":125070,"_5":14750,"_28165":124980,"_3038":125071},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3569":73944,"_31013":73900,"_21476":125073,"_5":14750,"_28165":124980,"_3038":125074},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3569":73945,"_31013":73900,"_21476":125076,"_5":14750,"_28165":124980,"_3038":125077},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3569":73946,"_31013":73900,"_21476":125079,"_5":14750,"_28165":124980,"_3038":125080},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3569":73947,"_31013":73900,"_21476":125082,"_5":14750,"_28165":124980,"_3038":125083},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3569":73948,"_31013":73900,"_21476":125085,"_5":14750,"_28165":124980,"_3038":125086},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3569":73949,"_31013":73900,"_21476":125088,"_5":14750,"_28165":124980,"_3038":125089},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3569":73950,"_31013":73950,"_5":15116,"_3038":125091,"_31371":125092,"_21476":125093,"_28165":73950},"Autoridades de certificación",[50615,121048,56098,124929],[],{"_3569":73951,"_31013":73950,"_21476":125095,"_5":14750,"_28165":73950,"_3038":125096},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3569":73952,"_31013":73950,"_5":31368,"_21476":125098,"_28165":125099,"_3038":125100},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3569":73953,"_31013":73950,"_5":31368,"_21476":125102,"_28165":125103,"_3038":125104},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3569":73954,"_31013":73950,"_5":31368,"_21476":125106,"_28165":125107,"_3038":119619},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3569":73955,"_31013":73950,"_5":31368,"_21476":125109,"_28165":125110,"_3038":125111},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3569":73956,"_31013":73950,"_5":31368,"_21476":125113,"_28165":125114,"_3038":125115},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3569":73957,"_31013":73950,"_5":31368,"_21476":125117,"_28165":125118,"_3038":125119},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3569":73958,"_31013":73950,"_5":31368,"_21476":125121,"_28165":125122,"_3038":125123},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3569":73959,"_31013":73950,"_5":31368,"_21476":125125,"_28165":125126,"_3038":125127},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3569":73960,"_31013":73950,"_5":31368,"_21476":125129,"_28165":125130,"_3038":125131},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3569":73961,"_31013":73950,"_5":31368,"_21476":125133,"_28165":125134,"_3038":125135},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3569":73962,"_31013":73950,"_5":31368,"_21476":125137,"_28165":125138,"_3038":125139},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3569":73963,"_31013":73950,"_5":31368,"_21476":125141,"_28165":125142,"_3038":125143},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3569":73964,"_31013":73950,"_5":31368,"_21476":125145,"_28165":125146,"_3038":125147},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3569":73965,"_31013":73950,"_5":31368,"_21476":125149,"_28165":125150,"_3038":125151},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3569":73966,"_31013":73950,"_5":31368,"_21476":125153,"_28165":125154,"_3038":125155},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3569":73967,"_31013":73950,"_5":31368,"_21476":125157,"_28165":125158,"_3038":125159},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3569":73968,"_31013":73950,"_5":31368,"_21476":125161,"_28165":125162,"_3038":125163},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3569":73969,"_31013":73950,"_5":31368,"_21476":125165,"_28165":125166,"_3038":125167},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3569":73970,"_31013":73950,"_5":31368,"_21476":125169,"_28165":125170,"_3038":125171},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3569":73971,"_31013":73950,"_5":31368,"_21476":125173,"_28165":125174,"_3038":125175},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3569":73972,"_31013":73950,"_5":31368,"_21476":125177,"_28165":125178,"_3038":125179},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3569":73973,"_31013":73950,"_5":31368,"_21476":125181,"_28165":125182,"_3038":125183},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3569":73974,"_31013":73950,"_5":31368,"_21476":125185,"_28165":125186,"_3038":125187},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3569":73975,"_31013":73950,"_21476":125189,"_5":14750,"_28165":73950,"_3038":125190},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3569":73976,"_31013":73950,"_21476":125192,"_5":14750,"_28165":73950,"_3038":125193},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3569":73977,"_31013":73950,"_21476":125195,"_5":14750,"_28165":73950,"_3038":125196},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3569":73978,"_31013":73950,"_21476":125198,"_5":14750,"_28165":125099,"_3038":125199},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3569":73979,"_31013":73950,"_21476":125201,"_5":14750,"_28165":125099,"_3038":125202},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3569":73980,"_31013":73950,"_21476":125204,"_5":14750,"_28165":125099,"_3038":125205},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3569":73981,"_31013":73950,"_21476":125207,"_5":14750,"_28165":125099,"_3038":125208},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3569":73982,"_31013":73950,"_21476":125210,"_5":14750,"_28165":125099,"_3038":125211},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3569":73983,"_31013":73950,"_21476":125213,"_5":14750,"_28165":125107,"_3038":125214},[],"Decide si la CA será raíz o intermedia.",{"_3569":73984,"_31013":73950,"_21476":125216,"_5":14750,"_28165":125107,"_3038":125217},[],"Elige el motor que custodiará la clave.",{"_3569":73985,"_31013":73950,"_21476":125219,"_5":14750,"_28165":125107,"_3038":125220},[],"Define una validez superior a la de los certificados que emitirá.",{"_3569":73986,"_31013":73950,"_21476":125222,"_5":14750,"_28165":125107,"_3038":125223},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3569":73987,"_31013":73950,"_21476":125225,"_5":14750,"_28165":125110,"_3038":125226},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3569":73988,"_31013":73950,"_21476":125228,"_5":14750,"_28165":125114,"_3038":125229},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3569":73989,"_31013":73950,"_21476":125231,"_5":14750,"_28165":125114,"_3038":125232},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3569":73990,"_31013":73950,"_21476":125234,"_5":14750,"_28165":125118,"_3038":125235},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3569":73991,"_31013":73950,"_21476":125237,"_5":14750,"_28165":125122,"_3038":125238},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3569":73992,"_31013":73950,"_21476":125240,"_5":14750,"_28165":125122,"_3038":125241},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3569":73993,"_31013":73950,"_21476":125243,"_5":14750,"_28165":125122,"_3038":125244},[],"`ST`: estado o provincia.",{"_3569":73994,"_31013":73950,"_21476":125246,"_5":14750,"_28165":125122,"_3038":125247},[],"`L`: localidad.",{"_3569":73995,"_31013":73950,"_21476":125249,"_5":14750,"_28165":125122,"_3038":125250},[],"`O`: organización.",{"_3569":73996,"_31013":73950,"_21476":125252,"_5":14750,"_28165":125122,"_3038":125253},[],"`OU`: unidad organizativa.",{"_3569":73997,"_31013":73950,"_21476":125255,"_5":14750,"_28165":125122,"_3038":125256},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3569":73998,"_31013":73950,"_21476":125258,"_5":14750,"_28165":125126,"_3038":125259},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3569":73999,"_31013":73950,"_21476":125261,"_5":14750,"_28165":125126,"_3038":125262},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3569":74000,"_31013":73950,"_21476":125264,"_5":14750,"_28165":125130,"_3038":125265},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3569":74001,"_31013":73950,"_21476":125267,"_5":14750,"_28165":125130,"_3038":125268},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3569":74002,"_31013":73950,"_21476":125270,"_5":14750,"_28165":125134,"_3038":125271},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3569":74003,"_31013":73950,"_21476":125273,"_5":14750,"_28165":125134,"_3038":125274},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3569":74004,"_31013":73950,"_21476":125276,"_5":14750,"_28165":125138,"_3038":125277},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3569":74005,"_31013":73950,"_21476":125279,"_5":14750,"_28165":125138,"_3038":125280},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3569":74006,"_31013":73950,"_21476":125282,"_5":14750,"_28165":125138,"_3038":125283},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3569":74007,"_31013":73950,"_21476":125285,"_5":14750,"_28165":125142,"_3038":125286},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3569":74008,"_31013":73950,"_21476":125288,"_5":14750,"_28165":125146,"_3038":125289},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3569":74009,"_31013":73950,"_21476":125291,"_5":14750,"_28165":125146,"_3038":125292},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3569":74010,"_31013":73950,"_21476":125294,"_5":14750,"_28165":125150,"_3038":125295},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3569":74011,"_31013":73950,"_21476":125297,"_5":14750,"_28165":125154,"_3038":125298},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3569":74012,"_31013":73950,"_21476":125300,"_5":14750,"_28165":125154,"_3038":125301},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3569":74013,"_31013":73950,"_21476":125303,"_5":14750,"_28165":125158,"_3038":125304},[],"Abre una CA desde el inventario para consultar:",{"_3569":74014,"_31013":73950,"_21476":125306,"_5":14750,"_28165":125158,"_3038":125307},[],"Estado y periodo de validez.",{"_3569":74015,"_31013":73950,"_21476":125309,"_5":14750,"_28165":125158,"_3038":125310},[],"Certificado y cadena en formato PEM.",{"_3569":74016,"_31013":73950,"_21476":125312,"_5":14750,"_28165":125158,"_3038":125313},[],"Número de certificados activos, expirados y revocados.",{"_3569":74017,"_31013":73950,"_21476":125315,"_5":14750,"_28165":125158,"_3038":125316},[],"Certificados emitidos en **Issued Certificates**.",{"_3569":74018,"_31013":73950,"_21476":125318,"_5":14750,"_28165":125158,"_3038":125319},[],"CRL vinculada a la autoridad.",{"_3569":74019,"_31013":73950,"_21476":125321,"_5":14750,"_28165":125158,"_3038":125322},[],"Metadatos y motor criptográfico asociado.",{"_3569":74020,"_31013":73950,"_21476":125324,"_5":14750,"_28165":125158,"_3038":125325},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3569":74021,"_31013":73950,"_21476":125327,"_5":14750,"_28165":125162,"_3038":125328},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3569":74022,"_31013":73950,"_21476":125330,"_5":14750,"_28165":125162,"_3038":125331},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3569":74023,"_31013":73950,"_21476":125333,"_5":14750,"_28165":125162,"_3038":125334},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3569":74024,"_31013":73950,"_21476":125336,"_5":14750,"_28165":125162,"_3038":125337},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3569":74025,"_31013":73950,"_21476":125339,"_5":14750,"_28165":125166,"_3038":125340},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3569":74026,"_31013":73950,"_21476":125342,"_5":14750,"_28165":125170,"_3038":125343},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3569":74027,"_31013":73950,"_21476":125345,"_5":14750,"_28165":125174,"_3038":125346},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3569":74028,"_31013":73950,"_21476":125348,"_5":14750,"_28165":125178,"_3038":125349},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3569":74029,"_31013":73950,"_21476":125351,"_5":14750,"_28165":125182,"_3038":125352},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3569":74030,"_31013":73950,"_21476":125354,"_5":14750,"_28165":125186,"_3038":125355},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3569":74031,"_31013":73950,"_21476":125357,"_5":14750,"_28165":125186,"_3038":125358},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3569":74032,"_31013":73950,"_21476":125360,"_5":14750,"_28165":125186,"_3038":125361},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3569":74033,"_31013":74033,"_5":15116,"_3038":125363,"_31371":125364,"_21476":125365,"_28165":74033},"Perfiles de certificado",[50615,121048,56098,124929],[],{"_3569":74034,"_31013":74033,"_21476":125367,"_5":14750,"_28165":74033,"_3038":125368},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3569":74035,"_31013":74033,"_5":31368,"_21476":125370,"_28165":125371,"_3038":125372},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3569":74036,"_31013":74033,"_5":31368,"_21476":125374,"_28165":125375,"_3038":125376},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#validez","Validez",{"_3569":74037,"_31013":74033,"_5":31368,"_21476":125378,"_28165":125379,"_3038":125380},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3569":74038,"_31013":74033,"_5":31368,"_21476":125382,"_28165":125383,"_3038":125384},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3569":74039,"_31013":74033,"_5":31368,"_21476":125386,"_28165":125387,"_3038":125388},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3569":74040,"_31013":74033,"_5":31368,"_21476":125390,"_28165":125391,"_3038":125392},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3569":74041,"_31013":74033,"_5":31368,"_21476":125394,"_28165":125395,"_3038":125396},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3569":74042,"_31013":74033,"_5":31368,"_21476":125398,"_28165":125399,"_3038":125400},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3569":74043,"_31013":74033,"_5":31368,"_21476":125402,"_28165":125403,"_3038":125404},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3569":74044,"_31013":74033,"_5":31368,"_21476":125406,"_28165":125407,"_3038":125408},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3569":74045,"_31013":74033,"_5":31368,"_21476":125410,"_28165":125411,"_3038":125412},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3569":74046,"_31013":74033,"_5":31368,"_21476":125414,"_28165":125415,"_3038":125416},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3569":74047,"_31013":74033,"_5":31368,"_21476":125418,"_28165":125419,"_3038":125420},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3569":74048,"_31013":74033,"_5":31368,"_21476":125422,"_28165":125423,"_3038":125424},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3569":74049,"_31013":74033,"_5":31368,"_21476":125426,"_28165":125427,"_3038":125428},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3569":74050,"_31013":74033,"_5":31368,"_21476":125430,"_28165":125431,"_3038":125432},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3569":74051,"_31013":74033,"_21476":125434,"_5":14750,"_28165":74033,"_3038":125435},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3569":74052,"_31013":74033,"_21476":125437,"_5":14750,"_28165":74033,"_3038":125438},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3569":74053,"_31013":74033,"_21476":125440,"_5":14750,"_28165":125375,"_3038":125441},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3569":74054,"_31013":74033,"_21476":125443,"_5":14750,"_28165":125375,"_3038":125444},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3569":74055,"_31013":74033,"_21476":125446,"_5":14750,"_28165":125379,"_3038":125447},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3569":74056,"_31013":74033,"_21476":125449,"_5":14750,"_28165":125383,"_3038":125450},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3569":74057,"_31013":74033,"_21476":125452,"_5":14750,"_28165":125383,"_3038":125453},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3569":74058,"_31013":74033,"_21476":125455,"_5":14750,"_28165":125383,"_3038":125456},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3569":74059,"_31013":74033,"_21476":125458,"_5":14750,"_28165":125387,"_3038":125459},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3569":74060,"_31013":74033,"_21476":125461,"_5":14750,"_28165":125391,"_3038":125462},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3569":74061,"_31013":74033,"_21476":125464,"_5":14750,"_28165":125391,"_3038":125465},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3569":74062,"_31013":74033,"_21476":125467,"_5":14750,"_28165":125395,"_3038":125468},[],"La aplicación criptográfica puede:",{"_3569":74063,"_31013":74033,"_21476":125470,"_5":14750,"_28165":125395,"_3038":125471},[],"permitir o bloquear claves RSA;",{"_3569":74064,"_31013":74033,"_21476":125473,"_5":14750,"_28165":125395,"_3038":125474},[],"limitar los tamaños RSA admitidos;",{"_3569":74065,"_31013":74033,"_21476":125476,"_5":14750,"_28165":125395,"_3038":125477},[],"permitir o bloquear claves ECDSA;",{"_3569":74066,"_31013":74033,"_21476":125479,"_5":14750,"_28165":125395,"_3038":125480},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3569":74067,"_31013":74033,"_21476":125482,"_5":14750,"_28165":125395,"_3038":125483},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3569":74068,"_31013":74033,"_21476":125485,"_5":14750,"_28165":125399,"_3038":125486},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3569":74069,"_31013":74033,"_21476":125488,"_5":14750,"_28165":125399,"_3038":120808},[],{"_3569":74070,"_31013":74033,"_21476":125490,"_5":14750,"_28165":125399,"_3038":125491},[],"Primera opción",{"_3569":74071,"_31013":74033,"_21476":125493,"_5":14750,"_28165":125399,"_3038":125494},[],"Segunda opción",{"_3569":74072,"_31013":74033,"_21476":125496,"_5":14750,"_28165":125399,"_3038":125497},[],"Si no hay ninguna",{"_3569":74073,"_31013":74033,"_21476":125499,"_5":14750,"_28165":125399,"_3038":125500},[],"Firma directa con una CA",{"_3569":74074,"_31013":74033,"_21476":125502,"_5":14750,"_28165":125399,"_3038":125503},[],"`issuance_profile` incluido en la solicitud",{"_3569":74075,"_31013":74033,"_21476":125505,"_5":14750,"_28165":125399,"_3038":125506},[],"`issuance_profile_id` de la solicitud",{"_3569":74076,"_31013":74033,"_21476":125508,"_5":14750,"_28165":125399,"_3038":125509},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3569":74077,"_31013":74033,"_21476":125511,"_5":14750,"_28165":125399,"_3038":125512},[],"Emisión mediante DMS",{"_3569":74078,"_31013":74033,"_21476":125514,"_5":14750,"_28165":125399,"_3038":56685},[],{"_3569":74079,"_31013":74033,"_21476":125516,"_5":14750,"_28165":125399,"_3038":125517},[],"`settings.issuance_profile` incluido en el DMS",{"_3569":74080,"_31013":74033,"_21476":125519,"_5":14750,"_28165":125399,"_3038":125520},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3569":74081,"_31013":74033,"_21476":125522,"_5":14750,"_28165":125399,"_3038":125523},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3569":74082,"_31013":74033,"_21476":125525,"_5":14750,"_28165":125399,"_3038":125526},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3569":74083,"_31013":74033,"_21476":125528,"_5":14750,"_28165":125407,"_3038":125529},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3569":74084,"_31013":74033,"_21476":125531,"_5":14750,"_28165":125411,"_3038":125532},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3569":74085,"_31013":74033,"_21476":125534,"_5":14750,"_28165":125415,"_3038":125535},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3569":74086,"_31013":74033,"_21476":125537,"_5":14750,"_28165":125419,"_3038":125538},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3569":74087,"_31013":74033,"_21476":125540,"_5":14750,"_28165":125423,"_3038":125541},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3569":74088,"_31013":74033,"_21476":125543,"_5":14750,"_28165":125423,"_3038":125544},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3569":74089,"_31013":74033,"_21476":125546,"_5":14750,"_28165":125427,"_3038":125547},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3569":74090,"_31013":74033,"_21476":125549,"_5":14750,"_28165":125427,"_3038":125550},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3569":74091,"_31013":74033,"_21476":125552,"_5":14750,"_28165":125427,"_3038":125553},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3569":74092,"_31013":74033,"_21476":125555,"_5":14750,"_28165":125427,"_3038":125556},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3569":74093,"_31013":74033,"_21476":125558,"_5":14750,"_28165":125431,"_3038":125559},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3569":74094,"_31013":74033,"_21476":125561,"_5":14750,"_28165":125431,"_3038":125562},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3569":74095,"_31013":74095,"_5":15116,"_3038":125564,"_31371":125565,"_21476":125567,"_28165":74095},"Validación de certificados",[50615,121048,56098,125566],"Validación",[],{"_3569":74096,"_31013":74095,"_21476":125569,"_5":14750,"_28165":74095,"_3038":125570},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3569":74097,"_31013":74095,"_5":31368,"_21476":125572,"_28165":125573,"_3038":125574},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3569":74098,"_31013":74095,"_5":31368,"_21476":125576,"_28165":125577,"_3038":125578},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3569":74099,"_31013":74095,"_5":31368,"_21476":125580,"_28165":125581,"_3038":125582},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3569":74100,"_31013":74095,"_21476":125584,"_5":14750,"_28165":74095,"_3038":125585},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3569":74101,"_31013":74095,"_21476":125587,"_5":14750,"_28165":125573,"_3038":125588},[],"Verifica estos criterios juntos:",{"_3569":74102,"_31013":74095,"_21476":125590,"_5":14750,"_28165":125573,"_3038":124558},[],{"_3569":74103,"_31013":74095,"_21476":125592,"_5":14750,"_28165":125573,"_3038":125593},[],"Resultado necesario",{"_3569":74104,"_31013":74095,"_21476":125595,"_5":14750,"_28165":125573,"_3038":125596},[],"Cadena y firma",{"_3569":74105,"_31013":74095,"_21476":125598,"_5":14750,"_28165":125573,"_3038":125599},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3569":74106,"_31013":74095,"_21476":125601,"_5":14750,"_28165":125573,"_3038":125602},[],"Fechas",{"_3569":74107,"_31013":74095,"_21476":125604,"_5":14750,"_28165":125573,"_3038":125605},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3569":74108,"_31013":74095,"_21476":125607,"_5":14750,"_28165":125573,"_3038":120718},[],{"_3569":74109,"_31013":74095,"_21476":125609,"_5":14750,"_28165":125573,"_3038":125610},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3569":74110,"_31013":74095,"_21476":125612,"_5":14750,"_28165":125573,"_3038":125613},[],"Uso",{"_3569":74111,"_31013":74095,"_21476":125615,"_5":14750,"_28165":125573,"_3038":125616},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3569":74112,"_31013":74095,"_21476":125618,"_5":14750,"_28165":125573,"_3038":125619},[],"Revocación",{"_3569":74113,"_31013":74095,"_21476":125621,"_5":14750,"_28165":125573,"_3038":125622},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3569":74114,"_31013":74095,"_21476":125624,"_5":14750,"_28165":125573,"_3038":125625},[],"Autorización",{"_3569":74115,"_31013":74095,"_21476":125627,"_5":14750,"_28165":125573,"_3038":125628},[],"La aplicación permite la acción a esa identidad.",{"_3569":74116,"_31013":74095,"_21476":125630,"_5":14750,"_28165":125573,"_3038":125631},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3569":74117,"_31013":74095,"_21476":125633,"_5":14750,"_28165":125577,"_3038":125634},[],"Mecanismo",{"_3569":74118,"_31013":74095,"_21476":125636,"_5":14750,"_28165":125577,"_3038":125637},[],"Cuándo utilizarlo",{"_3569":74119,"_31013":74095,"_21476":125639,"_5":14750,"_28165":125577,"_3038":125640},[],"Qué debes mantener",{"_3569":74120,"_31013":74095,"_21476":125642,"_5":14750,"_28165":125577,"_3038":56813},[],{"_3569":74121,"_31013":74095,"_21476":125644,"_5":14750,"_28165":125577,"_3038":125645},[],"Consulta del estado de un certificado concreto.",{"_3569":74122,"_31013":74095,"_21476":125647,"_5":14750,"_28165":125577,"_3038":125648},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3569":74123,"_31013":74095,"_21476":125650,"_5":14750,"_28165":125577,"_3038":56822},[],{"_3569":74124,"_31013":74095,"_21476":125652,"_5":14750,"_28165":125577,"_3038":125653},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3569":74125,"_31013":74095,"_21476":125655,"_5":14750,"_28165":125577,"_3038":125656},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3569":74126,"_31013":74095,"_21476":125658,"_5":14750,"_28165":125577,"_3038":125659},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3569":74127,"_31013":74095,"_21476":125661,"_5":14750,"_28165":125577,"_3038":125662},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3569":74128,"_31013":74095,"_21476":125664,"_5":14750,"_28165":125581,"_3038":125665},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3569":74129,"_31013":74095,"_21476":125667,"_5":14750,"_28165":125581,"_3038":125668},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3569":74130,"_31013":74095,"_21476":125670,"_5":14750,"_28165":125581,"_3038":125671},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3569":74131,"_31013":74095,"_21476":125673,"_5":14750,"_28165":125581,"_3038":125674},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3569":74132,"_31013":74095,"_21476":125676,"_5":14750,"_28165":125581,"_3038":125677},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3569":74133,"_31013":74095,"_21476":125679,"_5":14750,"_28165":125581,"_3038":125680},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3569":74134,"_31013":74095,"_21476":125682,"_5":14750,"_28165":125581,"_3038":125683},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3569":74135,"_31013":74095,"_21476":125685,"_5":14750,"_28165":125581,"_3038":125686},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3569":74136,"_31013":74095,"_21476":125688,"_5":14750,"_28165":125581,"_3038":125689},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3569":74137,"_31013":74137,"_5":15116,"_3038":125691,"_31371":125692,"_21476":125693,"_28165":74137},"Certificados",[50615,121048,56098,124929],[],{"_3569":74138,"_31013":74137,"_21476":125695,"_5":14750,"_28165":74137,"_3038":125696},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3569":74139,"_31013":74137,"_5":31368,"_21476":125698,"_28165":125699,"_3038":125700},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3569":74140,"_31013":74137,"_5":31368,"_21476":125702,"_28165":125703,"_3038":125704},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3569":74141,"_31013":74137,"_5":31368,"_21476":125706,"_28165":125707,"_3038":125708},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3569":74142,"_31013":74137,"_5":31368,"_21476":125710,"_28165":125711,"_3038":125712},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3569":74143,"_31013":74137,"_5":31368,"_21476":125714,"_28165":125715,"_3038":125716},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3569":74144,"_31013":74137,"_5":31368,"_21476":125718,"_28165":125719,"_3038":125720},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3569":74145,"_31013":74137,"_5":31368,"_21476":125722,"_28165":125723,"_3038":125724},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3569":74146,"_31013":74137,"_5":31368,"_21476":125726,"_28165":125727,"_3038":125728},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3569":74147,"_31013":74137,"_5":31368,"_21476":125730,"_28165":125731,"_3038":125732},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#continúa","Continúa",{"_3569":74148,"_31013":74137,"_21476":125734,"_5":14750,"_28165":74137,"_3038":125735},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3569":74149,"_31013":74137,"_21476":125737,"_5":14750,"_28165":125699,"_3038":125738},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3569":74150,"_31013":74137,"_21476":125740,"_5":14750,"_28165":125699,"_3038":125741},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3569":74151,"_31013":74137,"_21476":125743,"_5":14750,"_28165":125699,"_3038":125744},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3569":74152,"_31013":74137,"_21476":125746,"_5":14750,"_28165":125699,"_3038":125747},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3569":74153,"_31013":74137,"_21476":125749,"_5":14750,"_28165":125699,"_3038":125750},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3569":74154,"_31013":74137,"_21476":125752,"_5":14750,"_28165":125699,"_3038":125753},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3569":74155,"_31013":74137,"_21476":125755,"_5":14750,"_28165":125699,"_3038":125756},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3569":74156,"_31013":74137,"_21476":125758,"_5":14750,"_28165":125703,"_3038":125759},[],"Descarga el PEM e inspecciónalo:",{"_3569":74157,"_31013":74137,"_21476":125761,"_5":14750,"_28165":125703,"_3038":125762},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3569":74158,"_31013":74137,"_21476":125764,"_5":14750,"_28165":125707,"_3038":125765},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3569":74159,"_31013":74137,"_21476":125767,"_5":14750,"_28165":125707,"_3038":125768},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3569":74160,"_31013":74137,"_21476":125770,"_5":14750,"_28165":125707,"_3038":125771},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3569":74161,"_31013":74137,"_21476":125773,"_5":14750,"_28165":125707,"_3038":125774},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3569":74162,"_31013":74137,"_21476":125776,"_5":14750,"_28165":125707,"_3038":125777},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3569":74163,"_31013":74137,"_21476":125779,"_5":14750,"_28165":125707,"_3038":125780},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3569":74164,"_31013":74137,"_21476":125782,"_5":14750,"_28165":125707,"_3038":125783},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3569":74165,"_31013":74137,"_21476":125785,"_5":14750,"_28165":125711,"_3038":125786},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3569":74166,"_31013":74137,"_21476":125788,"_5":14750,"_28165":125715,"_3038":125789},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Hay un recorrido guiado en Revoca un certificado y comprueba la CRL. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3569":74167,"_31013":74137,"_21476":125791,"_5":14750,"_28165":125719,"_3038":125792},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3569":74168,"_31013":74137,"_21476":125794,"_5":14750,"_28165":125723,"_3038":125795},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3569":74169,"_31013":74137,"_21476":125797,"_5":14750,"_28165":125723,"_3038":125798},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3569":74170,"_31013":74137,"_21476":125800,"_5":14750,"_28165":125723,"_3038":125801},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3569":74171,"_31013":74137,"_21476":125803,"_5":14750,"_28165":125727,"_3038":125804},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3569":74172,"_31013":74137,"_21476":125806,"_5":14750,"_28165":125727,"_3038":125807},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3569":74173,"_31013":74137,"_21476":125809,"_5":14750,"_28165":125727,"_3038":125810},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3569":74174,"_31013":74137,"_21476":125812,"_5":14750,"_28165":125731,"_3038":125813},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3569":74175,"_31013":74137,"_21476":125815,"_5":14750,"_28165":125731,"_3038":125816},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3569":74176,"_31013":74176,"_5":15116,"_3038":125818,"_31371":125819,"_21476":125821,"_28165":74176},"Ciclo de vida de un certificado",[50615,121048,56098,125820],"Conceptos",[],{"_3569":74177,"_31013":74176,"_21476":125823,"_5":14750,"_28165":74176,"_3038":125824},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3569":74178,"_31013":74176,"_5":31368,"_21476":125826,"_28165":125827,"_3038":125828},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3569":74179,"_31013":74176,"_5":31368,"_21476":125830,"_28165":125831,"_3038":125832},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3569":74180,"_31013":74176,"_5":31368,"_21476":125834,"_28165":125835,"_3038":125836},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3569":74181,"_31013":74176,"_5":31368,"_21476":125838,"_28165":125839,"_3038":125840},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3569":74182,"_31013":74176,"_5":31368,"_21476":125842,"_28165":125843,"_3038":125844},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3569":74183,"_31013":74176,"_5":31368,"_21476":125846,"_28165":125847,"_3038":125848},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3569":74184,"_31013":74176,"_5":31368,"_21476":125850,"_28165":125851,"_3038":123552},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3569":74185,"_31013":74176,"_5":31368,"_21476":125853,"_28165":125854,"_3038":125855},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3569":74186,"_31013":74176,"_5":31368,"_21476":125857,"_28165":125858,"_3038":125859},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3569":74187,"_31013":74176,"_5":31368,"_21476":125861,"_28165":125862,"_3038":125863},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3569":74188,"_31013":74176,"_21476":125865,"_5":14750,"_28165":74176,"_3038":125866},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3569":74189,"_31013":74176,"_21476":125868,"_5":14750,"_28165":125831,"_3038":125869},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3569":74190,"_31013":74176,"_21476":125871,"_5":14750,"_28165":125835,"_3038":125872},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3569":74191,"_31013":74176,"_21476":125874,"_5":14750,"_28165":125839,"_3038":125875},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3569":74192,"_31013":74176,"_21476":125877,"_5":14750,"_28165":125843,"_3038":125878},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3569":74193,"_31013":74176,"_21476":125880,"_5":14750,"_28165":125847,"_3038":125881},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3569":74194,"_31013":74176,"_21476":125883,"_5":14750,"_28165":125851,"_3038":125884},[],"Lamassu persiste cuatro estados X.509:",{"_3569":74195,"_31013":74176,"_21476":125886,"_5":14750,"_28165":125851,"_3038":125887},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3569":74196,"_31013":74176,"_21476":125889,"_5":14750,"_28165":125851,"_3038":125890},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3569":74197,"_31013":74176,"_21476":125892,"_5":14750,"_28165":125851,"_3038":125893},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3569":74198,"_31013":74176,"_21476":125895,"_5":14750,"_28165":125851,"_3038":125896},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3569":74199,"_31013":74176,"_21476":125898,"_5":14750,"_28165":125851,"_3038":125899},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3569":74200,"_31013":74176,"_21476":125901,"_5":14750,"_28165":125854,"_3038":125902},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3569":74201,"_31013":74176,"_21476":125904,"_5":14750,"_28165":125854,"_3038":125905},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3569":74202,"_31013":74176,"_21476":125907,"_5":14750,"_28165":125854,"_3038":125908},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3569":74203,"_31013":74176,"_21476":125910,"_5":14750,"_28165":125858,"_3038":125911},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3569":74204,"_31013":74176,"_21476":125913,"_5":14750,"_28165":125858,"_3038":125914},[],"Antes de confirmar:",{"_3569":74205,"_31013":74176,"_21476":125916,"_5":14750,"_28165":125858,"_3038":125917},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3569":74206,"_31013":74176,"_21476":125919,"_5":14750,"_28165":125858,"_3038":125920},[],"Distribuye la nueva cadena de confianza.",{"_3569":74207,"_31013":74176,"_21476":125922,"_5":14750,"_28165":125858,"_3038":125923},[],"Reemite las identidades necesarias.",{"_3569":74208,"_31013":74176,"_21476":125925,"_5":14750,"_28165":125858,"_3038":125926},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3569":74209,"_31013":74176,"_21476":125928,"_5":14750,"_28165":125858,"_3038":125929},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3569":74210,"_31013":74176,"_21476":125931,"_5":14750,"_28165":125858,"_3038":125932},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3569":74211,"_31013":74176,"_21476":125934,"_5":14750,"_28165":125862,"_3038":125935},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3569":74212,"_31013":74176,"_21476":125937,"_5":14750,"_28165":125862,"_3038":125938},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3569":74213,"_31013":74176,"_21476":125940,"_5":14750,"_28165":125862,"_3038":125941},[],"Cambios de estado y razones de revocación.",{"_3569":74214,"_31013":74176,"_21476":125943,"_5":14750,"_28165":125862,"_3038":125944},[],"Publicación y vigencia de OCSP y CRLs.",{"_3569":74215,"_31013":74176,"_21476":125946,"_5":14750,"_28165":125862,"_3038":125947},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3569":74216,"_31013":74176,"_21476":125949,"_5":14750,"_28165":125862,"_3038":125950},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3569":74217,"_31013":74217,"_5":15116,"_3038":125952,"_31371":125953,"_21476":125954,"_28165":74217},"Modelo de confianza",[50615,121048,56098,125820],[],{"_3569":74218,"_31013":74217,"_21476":125956,"_5":14750,"_28165":74217,"_3038":125957},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3569":74219,"_31013":74217,"_5":31368,"_21476":125959,"_28165":125960,"_3038":125961},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3569":74220,"_31013":74217,"_5":31368,"_21476":125963,"_28165":125964,"_3038":125965},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3569":74221,"_31013":74217,"_5":31368,"_21476":125967,"_28165":125968,"_3038":125969},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3569":74222,"_31013":74217,"_5":31368,"_21476":125971,"_28165":125972,"_3038":125973},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3569":74223,"_31013":74217,"_5":31368,"_21476":125975,"_28165":125976,"_3038":125977},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3569":74224,"_31013":74217,"_5":31368,"_21476":125979,"_28165":125980,"_3038":125981},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#arquitecturas-de-confianza-e-interoperabilidad","Arquitecturas de confianza e interoperabilidad",{"_3569":74225,"_31013":74217,"_5":31368,"_21476":125983,"_28165":125984,"_3038":125985},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#ca-única-y-jerarquía","CA única y jerarquía",{"_3569":74226,"_31013":74217,"_5":31368,"_21476":125987,"_28165":125988,"_3038":125989},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#firma-cruzada-directa-y-malla","Firma cruzada directa y malla",{"_3569":74227,"_31013":74217,"_5":31368,"_21476":125991,"_28165":125992,"_3038":125993},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#modelo-híbrido","Modelo híbrido",{"_3569":74228,"_31013":74217,"_5":31368,"_21476":125995,"_28165":125996,"_3038":125997},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#punto-de-confianza-unificador","Punto de confianza unificador",{"_3569":74229,"_31013":74217,"_5":31368,"_21476":125999,"_28165":126000,"_3038":126001},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#ca-puente","CA puente",{"_3569":74230,"_31013":74217,"_5":31368,"_21476":126003,"_28165":126004,"_3038":126005},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#listas-de-confianza","Listas de confianza",{"_3569":74231,"_31013":74217,"_5":31368,"_21476":126007,"_28165":126008,"_3038":126009},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#qué-puede-mostrar-lamassu","Qué puede mostrar Lamassu",{"_3569":74232,"_31013":74217,"_5":31368,"_21476":126011,"_28165":126012,"_3038":126013},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3569":74233,"_31013":74217,"_5":31368,"_21476":126015,"_28165":126016,"_3038":126017},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3569":74234,"_31013":74217,"_5":31368,"_21476":126019,"_28165":126020,"_3038":126021},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3569":74235,"_31013":74217,"_5":31368,"_21476":126023,"_28165":126024,"_3038":126025},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3569":74236,"_31013":74217,"_5":31368,"_21476":126027,"_28165":126028,"_3038":126029},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3569":74237,"_31013":74217,"_21476":126031,"_5":14750,"_28165":74217,"_3038":126032},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3569":74238,"_31013":74217,"_21476":126034,"_5":14750,"_28165":125964,"_3038":126035},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3569":74239,"_31013":74217,"_21476":126037,"_5":14750,"_28165":125968,"_3038":126038},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3569":74240,"_31013":74217,"_21476":126040,"_5":14750,"_28165":125972,"_3038":126041},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3569":74241,"_31013":74217,"_21476":126043,"_5":14750,"_28165":125976,"_3038":126044},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3569":74242,"_31013":74217,"_21476":126046,"_5":14750,"_28165":125980,"_3038":126047},[],"El RFC 5217 distingue la estructura interna de una PKI de las relaciones entre dominios. En los esquemas siguientes, `A → B` significa que A firma un certificado de CA para B. La validación comienza en el ancla elegida por el consumidor; una firma en una dirección no implica confianza recíproca.",{"_3569":74243,"_31013":74217,"_21476":126049,"_5":14750,"_28165":125980,"_3038":119704},[],{"_3569":74244,"_31013":74217,"_21476":126051,"_5":14750,"_28165":125980,"_3038":126052},[],"Estructura",{"_3569":74245,"_31013":74217,"_21476":126054,"_5":14750,"_28165":125980,"_3038":126055},[],"Qué tener en cuenta",{"_3569":74246,"_31013":74217,"_21476":126057,"_5":14750,"_28165":125980,"_3038":126058},[],"CA única",{"_3569":74247,"_31013":74217,"_21476":126060,"_5":14750,"_28165":125980,"_3038":126061},[],"`CA → identidad`.",{"_3569":74248,"_31013":74217,"_21476":126063,"_5":14750,"_28165":125980,"_3038":126064},[],"La raíz emite directamente; su compromiso afecta a todas las identidades.",{"_3569":74249,"_31013":74217,"_21476":126066,"_5":14750,"_28165":125980,"_3038":126067},[],"Jerárquico",{"_3569":74250,"_31013":74217,"_21476":126069,"_5":14750,"_28165":125980,"_3038":126070},[],"`Raíz → intermedia → identidad`.",{"_3569":74251,"_31013":74217,"_21476":126072,"_5":14750,"_28165":125980,"_3038":126073},[],"Distribuye la raíz y presenta las intermedias; limita profundidad, usos y validez.",{"_3569":74252,"_31013":74217,"_21476":126075,"_5":14750,"_28165":125980,"_3038":126076},[],"Malla completa o parcial",{"_3569":74253,"_31013":74217,"_21476":126078,"_5":14750,"_28165":125980,"_3038":126079},[],"Varias CAs autofirmadas se certifican entre sí; en la parcial faltan enlaces.",{"_3569":74254,"_31013":74217,"_21476":126081,"_5":14750,"_28165":125980,"_3038":126082},[],"Comprueba cada dirección y cada ancla: en una malla parcial puede no existir ruta a todos los dominios.",{"_3569":74255,"_31013":74217,"_21476":126084,"_5":14750,"_28165":125980,"_3038":126085},[],"Híbrido",{"_3569":74256,"_31013":74217,"_21476":126087,"_5":14750,"_28165":125980,"_3038":126088},[],"Combina jerarquías y enlaces cruzados.",{"_3569":74257,"_31013":74217,"_21476":126090,"_5":14750,"_28165":125980,"_3038":126091},[],"Documenta rutas alternativas y restricciones; no todos los consumidores construyen o aceptan las mismas rutas.",{"_3569":74258,"_31013":74217,"_21476":126093,"_5":14750,"_28165":125980,"_3038":125997},[],{"_3569":74259,"_31013":74217,"_21476":126095,"_5":14750,"_28165":125980,"_3038":126096},[],"`Unificadora → PCA-A` y `Unificadora → PCA-B`.",{"_3569":74260,"_31013":74217,"_21476":126098,"_5":14750,"_28165":125980,"_3038":126099},[],"Para validar entre dominios, el consumidor confía en la unificadora y dispone de los certificados cruzados. Las PCA conservan sus certificados autofirmados.",{"_3569":74261,"_31013":74217,"_21476":126101,"_5":14750,"_28165":125980,"_3038":126102},[],"Certificación cruzada directa",{"_3569":74262,"_31013":74217,"_21476":126104,"_5":14750,"_28165":125980,"_3038":126105},[],"`PCA-A → PCA-B`; añade `PCA-B → PCA-A` para reciprocidad.",{"_3569":74263,"_31013":74217,"_21476":126107,"_5":14750,"_28165":125980,"_3038":126108},[],"Cada dominio conserva su ancla; prueba ambas direcciones y restringe rutas no deseadas.",{"_3569":74264,"_31013":74217,"_21476":126110,"_5":14750,"_28165":125980,"_3038":126001},[],{"_3569":74265,"_31013":74217,"_21476":126112,"_5":14750,"_28165":125980,"_3038":126113},[],"`PCA-A → Puente → PCA-B`; añade las firmas inversas para el sentido contrario.",{"_3569":74266,"_31013":74217,"_21476":126115,"_5":14750,"_28165":125980,"_3038":126116},[],"La puente no es ancla de los dominios y no emite identidades finales salvo para su operación. Acuerda políticas y restricciones.",{"_3569":74267,"_31013":74217,"_21476":126118,"_5":14750,"_28165":125980,"_3038":126119},[],"Lista de confianza",{"_3569":74268,"_31013":74217,"_21476":126121,"_5":14750,"_28165":125980,"_3038":126122},[],"El consumidor confía en las raíces A y B, localmente o mediante una autoridad que gestiona la lista.",{"_3569":74269,"_31013":74217,"_21476":126124,"_5":14750,"_28165":125980,"_3038":126125},[],"No requiere certificación cruzada. Distribuir certificados no equivale a instalar anclas; controla su actualización y retirada.",{"_3569":74270,"_31013":74217,"_21476":126127,"_5":14750,"_28165":125980,"_3038":126128},[],"PCA es la CA principal designada para las relaciones entre PKIs; una identidad es un certificado de entidad final. Las primeras cuatro filas describen arquitecturas dentro de una PKI; las tres siguientes, relaciones entre dominios, y la última, un modelo externo a esas relaciones. Una intermedia ordinaria no demuestra por sí sola una CA unificadora.",{"_3569":74271,"_31013":74217,"_21476":126130,"_5":14750,"_28165":125984,"_3038":126131},[],"Una PKI de CA única utiliza una raíz autofirmada para emitir directamente las identidades. Es fácil de entender y resulta útil para una primera prueba, pero concentra la emisión y la confianza en una sola clave. Si esa clave se compromete, hay que sustituir el ancla y renovar las identidades afectadas.",{"_3569":74272,"_31013":74217,"_21476":126133,"_5":14750,"_28165":125984,"_3038":126134},[],"En una jerarquía, la raíz firma una o varias CAs intermedias, que emiten las identidades. Esto permite separar, por ejemplo, producción y pruebas, o dispositivos y servicios, y restringir el uso de la raíz. Cada consumidor necesita confiar en la raíz y disponer de las intermedias para construir la cadena. El diseño debe prever la profundidad permitida, los usos y los vencimientos de cada CA.",{"_3569":74273,"_31013":74217,"_21476":126136,"_5":14750,"_28165":125984,"_3038":126137},[],"En Lamassu, crea una raíz y emite una identidad para el primer caso; para el segundo, crea una intermedia bajo otra raíz y emite desde ella. Descarga los certificados y comprueba las dos cadenas desde un consumidor, incluyendo una prueba con un ancla incorrecta.",{"_3569":74274,"_31013":74217,"_21476":126139,"_5":14750,"_28165":125984,"_3038":126140},[],"El siguiente recorrido interactivo muestra ambos escenarios en la consola: la raíz aislada y la jerarquía, con los certificados públicos y los certificados de identidad descargados.",{"_3569":74275,"_31013":74217,"_21476":126142,"_5":14750,"_28165":125988,"_3038":126143},[],"La firma cruzada permite que una CA emita un certificado para la clave pública de otra CA. Así, un consumidor que confía en A puede construir una ruta hacia una identidad emitida por B usando el certificado de B firmado por A. El certificado autofirmado de B puede seguir existiendo para sus propios consumidores. Para que los consumidores que confían en B también puedan validar identidades de A, hace falta una firma en el sentido contrario y una ruta aceptada por su validador.",{"_3569":74276,"_31013":74217,"_21476":126145,"_5":14750,"_28165":125988,"_3038":126146},[],"Una malla extiende esta relación a varias CAs: es completa cuando cada CA firma a todas las demás y parcial cuando faltan enlaces. La completa ofrece enlaces directos, pero aumenta el número de relaciones que administrar; la parcial reduce enlaces, aunque puede dejar rutas inexistentes o más difíciles de construir. No debe suponerse que una ruta es aceptable solo porque aparece en un grafo.",{"_3569":74277,"_31013":74217,"_21476":126148,"_5":14750,"_28165":125988,"_3038":126149},[],"Para demostrarlo, crea raíces A, B y C y certificados de prueba. Empieza con A → B, valida una identidad de B desde A y comprueba que la dirección opuesta no está cubierta hasta añadir B → A. Añade enlaces para construir una malla parcial y compara las rutas disponibles. Controla los certificados que recibe el validador para detectar rutas alternativas.",{"_3569":74278,"_31013":74217,"_21476":126151,"_5":14750,"_28165":125988,"_3038":126152},[],"El siguiente recorrido muestra una malla parcial con A ↔ B, A → C y B → C. Los certificados se prepararon antes de la grabación; la guía describe las validaciones realizadas fuera de la consola.",{"_3569":74279,"_31013":74217,"_21476":126154,"_5":14750,"_28165":125992,"_3038":126155},[],"Una PKI híbrida combina jerarquías de CAs subordinadas con certificaciones cruzadas. Puede aparecer, por ejemplo, cuando dos organizaciones con jerarquías propias necesitan interoperar sin reemplazar sus raíces. Las ramas mantienen su estructura, pero las rutas entre ellas añaden complejidad a la distribución de certificados, a la revocación y a la interpretación de políticas.",{"_3569":74280,"_31013":74217,"_21476":126157,"_5":14750,"_28165":125992,"_3038":126158},[],"Una demo puede partir de dos raíces A y B, con una intermedia emisora bajo B, y añadir A → B. Desde el ancla A, el consumidor debe disponer del certificado de B firmado por A y de la intermedia de B para validar la identidad final. Comprueba también el fallo cuando falta un enlace y las posibles rutas alternativas.",{"_3569":74281,"_31013":74217,"_21476":126160,"_5":14750,"_28165":125996,"_3038":126161},[],"Este modelo incorpora una CA superior que firma unilateralmente las PCA de los dominios participantes. Cada PCA puede conservar su certificado autofirmado y su funcionamiento anterior; los consumidores que necesiten validar entre dominios utilizan la CA unificadora como ancla y obtienen los certificados cruzados necesarios.",{"_3569":74282,"_31013":74217,"_21476":126163,"_5":14750,"_28165":125996,"_3038":126164},[],"La ventaja es ofrecer un punto común de confianza sin reconstruir necesariamente las PKIs existentes. A cambio, hay que distribuir y gobernar esa nueva ancla, acordar políticas y evaluar el impacto de su compromiso o sustitución. Un consumidor que solo necesita su dominio puede continuar confiando en su PCA anterior.",{"_3569":74283,"_31013":74217,"_21476":126166,"_5":14750,"_28165":125996,"_3038":126167},[],"En la demo, crea primero dos PCA autofirmadas y después los enlaces Unificadora → PCA-A y Unificadora → PCA-B. Emite una identidad desde cada dominio y valida ambas desde el ancla unificadora; comprueba que los certificados cruzados corresponden a las mismas claves de las PCA originales.",{"_3569":74284,"_31013":74217,"_21476":126169,"_5":14750,"_28165":126000,"_3038":126170},[],"La CA puente conecta dominios que mantienen sus propias anclas. Para validar una identidad de B desde A, la ruta puede seguir A → Puente → B; para el sentido opuesto se necesitan los enlaces correspondientes. La puente no debe convertirse en el ancla de los dominios y no emite certificados de entidad final salvo los necesarios para su propia operación.",{"_3569":74285,"_31013":74217,"_21476":126172,"_5":14750,"_28165":126000,"_3038":126173},[],"Centralizar relaciones en una puente puede reducir el número de acuerdos directos, pero exige gobierno compartido, políticas documentadas, mapeo de políticas y restricciones coherentes. También aumenta la importancia de que los validadores puedan descubrir y procesar correctamente rutas y extensiones.",{"_3569":74286,"_31013":74217,"_21476":126175,"_5":14750,"_28165":126000,"_3038":126176},[],"Para la demo, crea dos PCA y una CA puente, establece los enlaces necesarios en ambos sentidos y valida una identidad de cada dominio desde el ancla del otro. Inspecciona las extensiones y documenta cualquier requisito del RFC que la versión o el validador no permitan verificar: un grafo conectado por sí solo no demuestra un modelo puente completo.",{"_3569":74287,"_31013":74217,"_21476":126178,"_5":14750,"_28165":126004,"_3038":126179},[],"Una lista de confianza permite a un consumidor aceptar varias PKIs instalando explícitamente sus anclas, sin que las CAs se certifiquen entre sí. La lista puede administrarse localmente o por una autoridad de confianza para varios consumidores. Es un enfoque directo, aunque mantener las altas, bajas y actualizaciones resulta más difícil a medida que crece el número de consumidores.",{"_3569":74288,"_31013":74217,"_21476":126181,"_5":14750,"_28165":126004,"_3038":126182},[],"En la demo, crea dos raíces independientes y una identidad bajo cada una. Valida ambas con una lista que contenga las dos raíces; después retira una y comprueba que la identidad correspondiente deja de validarse. Si distribuyes certificados mediante EST `/cacerts`, muestra por separado la decisión del consumidor de instalarlos como anclas.",{"_3569":74289,"_31013":74217,"_21476":126184,"_5":14750,"_28165":126008,"_3038":126185},[],"Puedes crear raíces e intermedias, emitir identidades y registrar CAs externas como se explica en Autoridades. El código del dashboard también incluye una operación de firma cruzada que crea otro certificado para la clave existente de la CA destino, firmado por la CA seleccionada. Su disponibilidad depende de la versión desplegada. En ese flujo ambas CAs deben estar activas y tener su clave privada en el KMS; una importación solo con certificado no basta. Verifica la clave pública y que el sujeto del certificado cruzado reproduce el de la CA destino: algunos sujetos importados no pueden reproducirse exactamente.",{"_3569":74290,"_31013":74217,"_21476":126187,"_5":14750,"_28165":126008,"_3038":126188},[],"La operación permite construir enlaces para estas topologías, pero el grafo o la emisión no prueban interoperabilidad ni conformidad completa con el RFC. Comprueba `basicConstraints`, `keyCertSign`, validez, longitud de ruta y restricciones de nombres y políticas. Verifica la disponibilidad y procesamiento de `policyMappings` y `policyConstraints` en la versión desplegada y en cada validador. Acuerda políticas, niveles de garantía, publicación y revocación entre dominios.",{"_3569":74291,"_31013":74217,"_21476":126190,"_5":14750,"_28165":126008,"_3038":126191},[],"Para cada ruta, descarga la identidad y los certificados de CA necesarios. Valida desde el consumidor con su ancla explícita y las intermedias como material auxiliar; prueba también el sentido inverso y un caso que deba fallar. Repite con las comprobaciones de revocación y políticas realmente aplicadas por ese consumidor. Consulta Validación y Distribución de confianza.",{"_3569":74292,"_31013":74217,"_21476":126193,"_5":14750,"_28165":126012,"_3038":126194},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3569":74293,"_31013":74217,"_21476":126196,"_5":14750,"_28165":126012,"_3038":126197},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3569":74294,"_31013":74217,"_21476":126199,"_5":14750,"_28165":126012,"_3038":126200},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3569":74295,"_31013":74217,"_21476":126202,"_5":14750,"_28165":126012,"_3038":126203},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3569":74296,"_31013":74217,"_21476":126205,"_5":14750,"_28165":126012,"_3038":126206},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3569":74297,"_31013":74217,"_21476":126208,"_5":14750,"_28165":126012,"_3038":126209},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3569":74298,"_31013":74217,"_21476":126211,"_5":14750,"_28165":126016,"_3038":126212},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3569":74299,"_31013":74217,"_21476":126214,"_5":14750,"_28165":126016,"_3038":126215},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3569":74300,"_31013":74217,"_21476":126217,"_5":14750,"_28165":126016,"_3038":126218},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3569":74301,"_31013":74217,"_21476":126220,"_5":14750,"_28165":126016,"_3038":126221},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3569":74302,"_31013":74217,"_21476":126223,"_5":14750,"_28165":126016,"_3038":126224},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3569":74303,"_31013":74217,"_21476":126226,"_5":14750,"_28165":126020,"_3038":126227},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3569":74304,"_31013":74217,"_21476":126229,"_5":14750,"_28165":126020,"_3038":126230},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3569":74305,"_31013":74217,"_21476":126232,"_5":14750,"_28165":126020,"_3038":126233},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3569":74306,"_31013":74217,"_21476":126235,"_5":14750,"_28165":126020,"_3038":126236},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3569":74307,"_31013":74217,"_21476":126238,"_5":14750,"_28165":126020,"_3038":126239},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3569":74308,"_31013":74217,"_21476":126241,"_5":14750,"_28165":126020,"_3038":126242},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3569":74309,"_31013":74217,"_21476":126244,"_5":14750,"_28165":126020,"_3038":126245},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3569":74310,"_31013":74217,"_21476":126247,"_5":14750,"_28165":126024,"_3038":126248},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3569":74311,"_31013":74217,"_21476":126250,"_5":14750,"_28165":126028,"_3038":126251},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3569":74312,"_31013":74217,"_21476":126253,"_5":14750,"_28165":126028,"_3038":126254},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3569":74313,"_31013":74217,"_21476":126256,"_5":14750,"_28165":126028,"_3038":126257},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3569":74314,"_31013":74217,"_21476":126259,"_5":14750,"_28165":126028,"_3038":126260},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3569":74315,"_31013":74217,"_21476":126262,"_5":14750,"_28165":126028,"_3038":126263},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3569":74316,"_31013":74217,"_21476":126265,"_5":14750,"_28165":126028,"_3038":126266},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3569":74317,"_31013":74217,"_21476":126268,"_5":14750,"_28165":126028,"_3038":126269},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3569":74318,"_31013":74318,"_5":15116,"_3038":126271,"_31371":126272,"_21476":126273,"_28165":74318},"Listas de revocación (CRL)",[50615,121048,56098,125566],[],{"_3569":74319,"_31013":74318,"_21476":126275,"_5":14750,"_28165":74318,"_3038":126276},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3569":74320,"_31013":74318,"_5":31368,"_21476":126278,"_28165":126279,"_3038":126280},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3569":74321,"_31013":74318,"_5":31368,"_21476":126282,"_28165":126283,"_3038":126284},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3569":74322,"_31013":74318,"_5":31368,"_21476":126286,"_28165":126287,"_3038":126288},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3569":74323,"_31013":74318,"_5":31368,"_21476":126290,"_28165":126291,"_3038":126292},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3569":74324,"_31013":74318,"_5":31368,"_21476":126294,"_28165":126295,"_3038":126296},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3569":74325,"_31013":74318,"_5":31368,"_21476":126298,"_28165":126299,"_3038":126300},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3569":74326,"_31013":74318,"_5":31368,"_21476":126302,"_28165":126303,"_3038":126304},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3569":74327,"_31013":74318,"_5":31368,"_21476":126306,"_28165":126307,"_3038":126308},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3569":74328,"_31013":74318,"_5":31368,"_21476":126310,"_28165":126311,"_3038":126312},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#referencias","Referencias",{"_3569":74329,"_31013":74318,"_21476":126314,"_5":14750,"_28165":74318,"_3038":126315},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3569":74330,"_31013":74318,"_21476":126317,"_5":14750,"_28165":126279,"_3038":126318},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3569":74331,"_31013":74318,"_21476":126320,"_5":14750,"_28165":126279,"_3038":126321},[],"Campo",{"_3569":74332,"_31013":74318,"_21476":126323,"_5":14750,"_28165":126279,"_3038":122592},[],{"_3569":74333,"_31013":74318,"_21476":126325,"_5":14750,"_28165":126279,"_3038":57499},[],{"_3569":74334,"_31013":74318,"_21476":126327,"_5":14750,"_28165":126279,"_3038":126328},[],"ID de la CA a la que pertenecen los ajustes.",{"_3569":74335,"_31013":74318,"_21476":126330,"_5":14750,"_28165":126279,"_3038":57505},[],{"_3569":74336,"_31013":74318,"_21476":126332,"_5":14750,"_28165":126279,"_3038":126333},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3569":74337,"_31013":74318,"_21476":126335,"_5":14750,"_28165":126279,"_3038":57511},[],{"_3569":74338,"_31013":74318,"_21476":126337,"_5":14750,"_28165":126279,"_3038":126338},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3569":74339,"_31013":74318,"_21476":126340,"_5":14750,"_28165":126279,"_3038":57517},[],{"_3569":74340,"_31013":74318,"_21476":126342,"_5":14750,"_28165":126279,"_3038":126343},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3569":74341,"_31013":74318,"_21476":126345,"_5":14750,"_28165":126279,"_3038":126346},[],"Campo de `crl_options`",{"_3569":74342,"_31013":74318,"_21476":126348,"_5":14750,"_28165":126279,"_3038":122592},[],{"_3569":74343,"_31013":74318,"_21476":126350,"_5":14750,"_28165":126279,"_3038":126351},[],"Valor inicial",{"_3569":74344,"_31013":74318,"_21476":126353,"_5":14750,"_28165":126279,"_3038":57531},[],{"_3569":74345,"_31013":74318,"_21476":126355,"_5":14750,"_28165":126279,"_3038":126356},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3569":74346,"_31013":74318,"_21476":126358,"_5":14750,"_28165":126279,"_3038":126359},[],"7 días.",{"_3569":74347,"_31013":74318,"_21476":126361,"_5":14750,"_28165":126279,"_3038":57540},[],{"_3569":74348,"_31013":74318,"_21476":126363,"_5":14750,"_28165":126279,"_3038":126364},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3569":74349,"_31013":74318,"_21476":126366,"_5":14750,"_28165":126279,"_3038":126367},[],"6 días y 23 horas.",{"_3569":74350,"_31013":74318,"_21476":126369,"_5":14750,"_28165":126279,"_3038":57549},[],{"_3569":74351,"_31013":74318,"_21476":126371,"_5":14750,"_28165":126279,"_3038":126372},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3569":74352,"_31013":74318,"_21476":126374,"_5":14750,"_28165":126279,"_3038":57555},[],{"_3569":74353,"_31013":74318,"_21476":126376,"_5":14750,"_28165":126279,"_3038":57558},[],{"_3569":74354,"_31013":74318,"_21476":126378,"_5":14750,"_28165":126279,"_3038":126379},[],"Número de serie del certificado existente que firma la CRL.",{"_3569":74355,"_31013":74318,"_21476":126381,"_5":14750,"_28165":126279,"_3038":126382},[],"Número de serie del certificado actual de la CA.",{"_3569":74356,"_31013":74318,"_21476":126384,"_5":14750,"_28165":126279,"_3038":126385},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3569":74357,"_31013":74318,"_21476":126387,"_5":14750,"_28165":126279,"_3038":126388},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3569":74358,"_31013":74318,"_21476":126390,"_5":14750,"_28165":126279,"_3038":126391},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3569":74359,"_31013":74318,"_21476":126393,"_5":14750,"_28165":126279,"_3038":126394},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3569":74360,"_31013":74318,"_21476":126396,"_5":14750,"_28165":126279,"_3038":126397},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3569":74361,"_31013":74318,"_21476":126399,"_5":14750,"_28165":126279,"_3038":126400},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3569":74362,"_31013":74318,"_21476":126402,"_5":14750,"_28165":126279,"_3038":126403},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3569":74363,"_31013":74318,"_21476":126405,"_5":14750,"_28165":126279,"_3038":126406},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3569":74364,"_31013":74318,"_21476":126408,"_5":14750,"_28165":126279,"_3038":126409},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3569":74365,"_31013":74318,"_21476":126411,"_5":14750,"_28165":126279,"_3038":126412},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3569":74366,"_31013":74318,"_21476":126414,"_5":14750,"_28165":126283,"_3038":126415},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3569":74367,"_31013":74318,"_21476":126417,"_5":14750,"_28165":126283,"_3038":126418},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3569":74368,"_31013":74318,"_21476":126420,"_5":14750,"_28165":126283,"_3038":126421},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3569":74369,"_31013":74318,"_21476":126423,"_5":14750,"_28165":126283,"_3038":126424},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3569":74370,"_31013":74318,"_21476":126426,"_5":14750,"_28165":126287,"_3038":126427},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3569":74371,"_31013":74318,"_21476":126429,"_5":14750,"_28165":126287,"_3038":126430},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3569":74372,"_31013":74318,"_21476":126432,"_5":14750,"_28165":126287,"_3038":126433},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3569":74373,"_31013":74318,"_21476":126435,"_5":14750,"_28165":126287,"_3038":126436},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3569":74374,"_31013":74318,"_21476":126438,"_5":14750,"_28165":126287,"_3038":126439},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3569":74375,"_31013":74318,"_21476":126441,"_5":14750,"_28165":126287,"_3038":126442},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3569":74376,"_31013":74318,"_21476":126444,"_5":14750,"_28165":126287,"_3038":126445},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3569":74377,"_31013":74318,"_21476":126447,"_5":14750,"_28165":126287,"_3038":126448},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3569":74378,"_31013":74318,"_21476":126450,"_5":14750,"_28165":126287,"_3038":126451},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3569":74379,"_31013":74318,"_21476":126453,"_5":14750,"_28165":126291,"_3038":126454},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3569":74380,"_31013":74318,"_21476":126456,"_5":14750,"_28165":126291,"_3038":126457},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3569":74381,"_31013":74318,"_21476":126459,"_5":14750,"_28165":126295,"_3038":126460},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3569":74382,"_31013":74318,"_21476":126462,"_5":14750,"_28165":126295,"_3038":126463},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3569":74383,"_31013":74318,"_21476":126465,"_5":14750,"_28165":126295,"_3038":126466},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3569":74384,"_31013":74318,"_21476":126468,"_5":14750,"_28165":126295,"_3038":126469},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3569":74385,"_31013":74318,"_21476":126471,"_5":14750,"_28165":126295,"_3038":126472},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3569":74386,"_31013":74318,"_21476":126474,"_5":14750,"_28165":126299,"_3038":126475},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3569":74387,"_31013":74318,"_21476":126477,"_5":14750,"_28165":126299,"_3038":122781},[],{"_3569":74388,"_31013":74318,"_21476":126479,"_5":14750,"_28165":126299,"_3038":126480},[],"Path relativo",{"_3569":74389,"_31013":74318,"_21476":126482,"_5":14750,"_28165":126299,"_3038":120808},[],{"_3569":74390,"_31013":74318,"_21476":126484,"_5":14750,"_28165":126299,"_3038":57667},[],{"_3569":74391,"_31013":74318,"_21476":126486,"_5":14750,"_28165":126299,"_3038":57670},[],{"_3569":74392,"_31013":74318,"_21476":126488,"_5":14750,"_28165":126299,"_3038":126489},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3569":74393,"_31013":74318,"_21476":126491,"_5":14750,"_28165":126299,"_3038":57667},[],{"_3569":74394,"_31013":74318,"_21476":126493,"_5":14750,"_28165":126299,"_3038":57678},[],{"_3569":74395,"_31013":74318,"_21476":126495,"_5":14750,"_28165":126299,"_3038":126496},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3569":74396,"_31013":74318,"_21476":126498,"_5":14750,"_28165":126299,"_3038":57684},[],{"_3569":74397,"_31013":74318,"_21476":126500,"_5":14750,"_28165":126299,"_3038":57678},[],{"_3569":74398,"_31013":74318,"_21476":126502,"_5":14750,"_28165":126299,"_3038":126503},[],"Sustituir la configuración de CRL de una CA.",{"_3569":74399,"_31013":74318,"_21476":126505,"_5":14750,"_28165":126299,"_3038":126506},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3569":74400,"_31013":74318,"_21476":126508,"_5":14750,"_28165":126299,"_3038":126509},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3569":74401,"_31013":74318,"_21476":126511,"_5":14750,"_28165":126303,"_3038":126512},[],"Síntoma",{"_3569":74402,"_31013":74318,"_21476":126514,"_5":14750,"_28165":126303,"_3038":126515},[],"Causa",{"_3569":74403,"_31013":74318,"_21476":126517,"_5":14750,"_28165":126303,"_3038":126518},[],"Acción",{"_3569":74404,"_31013":74318,"_21476":126520,"_5":14750,"_28165":126303,"_3038":126521},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3569":74405,"_31013":74318,"_21476":126523,"_5":14750,"_28165":126303,"_3038":126524},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3569":74406,"_31013":74318,"_21476":126526,"_5":14750,"_28165":126303,"_3038":126527},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3569":74407,"_31013":74318,"_21476":126529,"_5":14750,"_28165":126303,"_3038":126530},[],"`PUT` devuelve 400.",{"_3569":74408,"_31013":74318,"_21476":126532,"_5":14750,"_28165":126303,"_3038":126533},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3569":74409,"_31013":74318,"_21476":126535,"_5":14750,"_28165":126303,"_3038":126536},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3569":74410,"_31013":74318,"_21476":126538,"_5":14750,"_28165":126303,"_3038":126539},[],"`PUT` devuelve 404.",{"_3569":74411,"_31013":74318,"_21476":126541,"_5":14750,"_28165":126303,"_3038":126542},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3569":74412,"_31013":74318,"_21476":126544,"_5":14750,"_28165":126303,"_3038":126545},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3569":74413,"_31013":74318,"_21476":126547,"_5":14750,"_28165":126303,"_3038":126548},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3569":74414,"_31013":74318,"_21476":126550,"_5":14750,"_28165":126303,"_3038":126551},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3569":74415,"_31013":74318,"_21476":126553,"_5":14750,"_28165":126303,"_3038":126554},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3569":74416,"_31013":74318,"_21476":126556,"_5":14750,"_28165":126303,"_3038":126557},[],"La CRL no cambia tras revocar un certificado.",{"_3569":74417,"_31013":74318,"_21476":126559,"_5":14750,"_28165":126303,"_3038":126560},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3569":74418,"_31013":74318,"_21476":126562,"_5":14750,"_28165":126303,"_3038":126563},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3569":74419,"_31013":74318,"_21476":126565,"_5":14750,"_28165":126303,"_3038":126566},[],"Un verificador rechaza la CRL por el emisor.",{"_3569":74420,"_31013":74318,"_21476":126568,"_5":14750,"_28165":126303,"_3038":126569},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3569":74421,"_31013":74318,"_21476":126571,"_5":14750,"_28165":126303,"_3038":126572},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3569":74422,"_31013":74318,"_21476":126574,"_5":14750,"_28165":126307,"_3038":126575},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3569":74423,"_31013":74318,"_21476":126577,"_5":14750,"_28165":126311,"_3038":126578},[],"RFC 5280: perfil X.509 y CRL.",{"_3569":74424,"_31013":74318,"_21476":126580,"_5":14750,"_28165":126311,"_3038":57767},[],{"_3569":74425,"_31013":74318,"_21476":126582,"_5":14750,"_28165":126311,"_3038":57770},[],{"_3569":74426,"_31013":74318,"_21476":126584,"_5":14750,"_28165":126311,"_3038":126585},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3569":74427,"_31013":74318,"_21476":126587,"_5":14750,"_28165":126311,"_3038":126588},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3569":74428,"_31013":74428,"_5":15116,"_3038":126590,"_31371":126591,"_21476":126592,"_28165":74428},"Claves y motores criptográficos",[50615,121048,56098,124929],[],{"_3569":74429,"_31013":74428,"_21476":126594,"_5":14750,"_28165":74428,"_3038":126595},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3569":74430,"_31013":74428,"_5":31368,"_21476":126597,"_28165":126598,"_3038":126599},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3569":74431,"_31013":74428,"_5":31368,"_21476":126601,"_28165":126602,"_3038":126603},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3569":74432,"_31013":74428,"_5":31368,"_21476":126605,"_28165":126606,"_3038":57795},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#file-system",{"_3569":74433,"_31013":74428,"_5":31368,"_21476":126608,"_28165":126609,"_3038":57799},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#hashicorp-vault",{"_3569":74434,"_31013":74428,"_5":31368,"_21476":126611,"_28165":126612,"_3038":57803},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#aws-secrets-manager",{"_3569":74435,"_31013":74428,"_5":31368,"_21476":126614,"_28165":126615,"_3038":57807},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#aws-kms",{"_3569":74436,"_31013":74428,"_5":31368,"_21476":126617,"_28165":126618,"_3038":57811},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#pkcs11",{"_3569":74437,"_31013":74428,"_5":31368,"_21476":126620,"_28165":126621,"_3038":57815},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#azure-key-vault",{"_3569":74438,"_31013":74428,"_5":31368,"_21476":126623,"_28165":126624,"_3038":126625},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3569":74439,"_31013":74428,"_5":31368,"_21476":126627,"_28165":126628,"_3038":126629},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3569":74440,"_31013":74428,"_5":31368,"_21476":126631,"_28165":126632,"_3038":126633},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3569":74441,"_31013":74428,"_5":31368,"_21476":126635,"_28165":126636,"_3038":126637},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3569":74442,"_31013":74428,"_5":31368,"_21476":126639,"_28165":126640,"_3038":126641},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3569":74443,"_31013":74428,"_5":31368,"_21476":126643,"_28165":126644,"_3038":126645},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3569":74444,"_31013":74428,"_5":31368,"_21476":126647,"_28165":126648,"_3038":126649},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3569":74445,"_31013":74428,"_5":31368,"_21476":126651,"_28165":126652,"_3038":57847},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#sign",{"_3569":74446,"_31013":74428,"_5":31368,"_21476":126654,"_28165":126655,"_3038":57851},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#verify",{"_3569":74447,"_31013":74428,"_5":31368,"_21476":126657,"_28165":126658,"_3038":126659},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3569":74448,"_31013":74428,"_5":31368,"_21476":126661,"_28165":126662,"_3038":126663},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3569":74449,"_31013":74428,"_5":31368,"_21476":126665,"_28165":126666,"_3038":126667},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3569":74450,"_31013":74428,"_21476":126669,"_5":14750,"_28165":74428,"_3038":126670},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3569":74451,"_31013":74428,"_21476":126672,"_5":14750,"_28165":74428,"_3038":126673},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3569":74452,"_31013":74428,"_21476":126675,"_5":14750,"_28165":126598,"_3038":126676},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3569":74453,"_31013":74428,"_21476":126678,"_5":14750,"_28165":126598,"_3038":126679},[],"En la práctica, permite:",{"_3569":74454,"_31013":74428,"_21476":126681,"_5":14750,"_28165":126598,"_3038":126682},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3569":74455,"_31013":74428,"_21476":126684,"_5":14750,"_28165":126598,"_3038":126685},[],"Importar claves creadas externamente.",{"_3569":74456,"_31013":74428,"_21476":126687,"_5":14750,"_28165":126598,"_3038":126688},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3569":74457,"_31013":74428,"_21476":126690,"_5":14750,"_28165":126598,"_3038":126691},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3569":74458,"_31013":74428,"_21476":126693,"_5":14750,"_28165":126602,"_3038":126694},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3569":74459,"_31013":74428,"_21476":126696,"_5":14750,"_28165":126602,"_3038":126697},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3569":74460,"_31013":74428,"_21476":126699,"_5":14750,"_28165":126602,"_3038":126700},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3569":74461,"_31013":74428,"_21476":126702,"_5":14750,"_28165":126606,"_3038":126703},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3569":74462,"_31013":74428,"_21476":126705,"_5":14750,"_28165":126609,"_3038":126706},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3569":74463,"_31013":74428,"_21476":126708,"_5":14750,"_28165":126609,"_3038":126709},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3569":74464,"_31013":74428,"_21476":126711,"_5":14750,"_28165":126612,"_3038":126712},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3569":74465,"_31013":74428,"_21476":126714,"_5":14750,"_28165":126615,"_3038":126715},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3569":74466,"_31013":74428,"_21476":126717,"_5":14750,"_28165":126618,"_3038":126718},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3569":74467,"_31013":74428,"_21476":126720,"_5":14750,"_28165":126621,"_3038":126721},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3569":74468,"_31013":74428,"_21476":126723,"_5":14750,"_28165":126621,"_3038":126724},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3569":74469,"_31013":74428,"_21476":126726,"_5":14750,"_28165":126621,"_3038":126727},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3569":74470,"_31013":74428,"_21476":126729,"_5":14750,"_28165":126621,"_3038":126730},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3569":74471,"_31013":74428,"_21476":126732,"_5":14750,"_28165":126624,"_3038":126733},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3569":74472,"_31013":74428,"_21476":126735,"_5":14750,"_28165":126624,"_3038":126736},[],"La tabla incluye los siguientes campos:",{"_3569":74473,"_31013":74428,"_21476":126738,"_5":14750,"_28165":126624,"_3038":126739},[],"**Name**: nombre descriptivo de la clave.",{"_3569":74474,"_31013":74428,"_21476":126741,"_5":14750,"_28165":126624,"_3038":126742},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3569":74475,"_31013":74428,"_21476":126744,"_5":14750,"_28165":126624,"_3038":126745},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3569":74476,"_31013":74428,"_21476":126747,"_5":14750,"_28165":126624,"_3038":126748},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3569":74477,"_31013":74428,"_21476":126750,"_5":14750,"_28165":126624,"_3038":126751},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3569":74478,"_31013":74428,"_21476":126753,"_5":14750,"_28165":126624,"_3038":126754},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3569":74479,"_31013":74428,"_21476":126756,"_5":14750,"_28165":126624,"_3038":126757},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3569":74480,"_31013":74428,"_21476":126759,"_5":14750,"_28165":126624,"_3038":126760},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3569":74481,"_31013":74428,"_21476":126762,"_5":14750,"_28165":126624,"_3038":126763},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3569":74482,"_31013":74428,"_21476":126765,"_5":14750,"_28165":126624,"_3038":126766},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3569":74483,"_31013":74428,"_21476":126768,"_5":14750,"_28165":126624,"_3038":126769},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3569":74484,"_31013":74428,"_21476":126771,"_5":14750,"_28165":126624,"_3038":126772},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3569":74485,"_31013":74428,"_21476":126774,"_5":14750,"_28165":126624,"_3038":126775},[],"**Delete Key** para eliminar la clave del sistema.",{"_3569":74486,"_31013":74428,"_21476":126777,"_5":14750,"_28165":126628,"_3038":126778},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3569":74487,"_31013":74428,"_21476":126780,"_5":14750,"_28165":126632,"_3038":126781},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3569":74488,"_31013":74428,"_21476":126783,"_5":14750,"_28165":126632,"_3038":126784},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3569":74489,"_31013":74428,"_21476":126786,"_5":14750,"_28165":126632,"_3038":126787},[],"**Key Name**: nombre único y descriptivo.",{"_3569":74490,"_31013":74428,"_21476":126789,"_5":14750,"_28165":126632,"_3038":126790},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3569":74491,"_31013":74428,"_21476":126792,"_5":14750,"_28165":126632,"_3038":126793},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3569":74492,"_31013":74428,"_21476":126795,"_5":14750,"_28165":126632,"_3038":126796},[],"**Tags**: metadatos para clasificar la clave.",{"_3569":74493,"_31013":74428,"_21476":126798,"_5":14750,"_28165":126632,"_3038":126799},[],"**Metadata**: información adicional para usos avanzados.",{"_3569":74494,"_31013":74428,"_21476":126801,"_5":14750,"_28165":126636,"_3038":126802},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3569":74495,"_31013":74428,"_21476":126804,"_5":14750,"_28165":126636,"_3038":126805},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3569":74496,"_31013":74428,"_21476":126807,"_5":14750,"_28165":126636,"_3038":126808},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3569":74497,"_31013":74428,"_21476":126810,"_5":14750,"_28165":126636,"_3038":126811},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3569":74498,"_31013":74428,"_21476":126813,"_5":14750,"_28165":126636,"_3038":126814},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3569":74499,"_31013":74428,"_21476":126816,"_5":14750,"_28165":126636,"_3038":126817},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3569":74500,"_31013":74428,"_21476":126819,"_5":14750,"_28165":126636,"_3038":126820},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3569":74501,"_31013":74428,"_21476":126822,"_5":14750,"_28165":126636,"_3038":126823},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3569":74502,"_31013":74428,"_21476":126825,"_5":14750,"_28165":126636,"_3038":126826},[],"**Metadata**: información adicional opcional.",{"_3569":74503,"_31013":74428,"_21476":126828,"_5":14750,"_28165":126636,"_3038":126829},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3569":74504,"_31013":74428,"_21476":126831,"_5":14750,"_28165":126636,"_3038":126832},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3569":74505,"_31013":74428,"_21476":126834,"_5":14750,"_28165":126640,"_3038":126835},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3569":74506,"_31013":74428,"_21476":126837,"_5":14750,"_28165":126644,"_3038":126838},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3569":74507,"_31013":74428,"_21476":126840,"_5":14750,"_28165":126644,"_3038":126841},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3569":74508,"_31013":74428,"_21476":126843,"_5":14750,"_28165":126644,"_3038":126844},[],"**Key Name**: nombre descriptivo.",{"_3569":74509,"_31013":74428,"_21476":126846,"_5":14750,"_28165":126644,"_3038":126847},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3569":74510,"_31013":74428,"_21476":126849,"_5":14750,"_28165":126644,"_3038":126850},[],"**Tags**: etiquetas asociadas.",{"_3569":74511,"_31013":74428,"_21476":126852,"_5":14750,"_28165":126644,"_3038":126853},[],"**Aliases**: nombres alternativos.",{"_3569":74512,"_31013":74428,"_21476":126855,"_5":14750,"_28165":126644,"_3038":126856},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3569":74513,"_31013":74428,"_21476":126858,"_5":14750,"_28165":126644,"_3038":126859},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3569":74514,"_31013":74428,"_21476":126861,"_5":14750,"_28165":126644,"_3038":126862},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3569":74515,"_31013":74428,"_21476":126864,"_5":14750,"_28165":126644,"_3038":126865},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3569":74516,"_31013":74428,"_21476":126867,"_5":14750,"_28165":126648,"_3038":126868},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3569":74517,"_31013":74428,"_21476":126870,"_5":14750,"_28165":126648,"_3038":126871},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3569":74518,"_31013":74428,"_21476":126873,"_5":14750,"_28165":126648,"_3038":126874},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3569":74519,"_31013":74428,"_21476":126876,"_5":14750,"_28165":126652,"_3038":126877},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3569":74520,"_31013":74428,"_21476":126879,"_5":14750,"_28165":126652,"_3038":126880},[],"Campos principales:",{"_3569":74521,"_31013":74428,"_21476":126882,"_5":14750,"_28165":126652,"_3038":126883},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3569":74522,"_31013":74428,"_21476":126885,"_5":14750,"_28165":126652,"_3038":126886},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3569":74523,"_31013":74428,"_21476":126888,"_5":14750,"_28165":126652,"_3038":126889},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3569":74524,"_31013":74428,"_21476":126891,"_5":14750,"_28165":126652,"_3038":126892},[],"**Message**: contenido que se va a firmar.",{"_3569":74525,"_31013":74428,"_21476":126894,"_5":14750,"_28165":126652,"_3038":126895},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3569":74526,"_31013":74428,"_21476":126897,"_5":14750,"_28165":126655,"_3038":126898},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3569":74527,"_31013":74428,"_21476":126900,"_5":14750,"_28165":126655,"_3038":126880},[],{"_3569":74528,"_31013":74428,"_21476":126902,"_5":14750,"_28165":126655,"_3038":126903},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3569":74529,"_31013":74428,"_21476":126905,"_5":14750,"_28165":126655,"_3038":126906},[],"**Message Type**: `Raw` o `Digest`.",{"_3569":74530,"_31013":74428,"_21476":126908,"_5":14750,"_28165":126655,"_3038":126909},[],"**Payload Encoding**: codificación del mensaje.",{"_3569":74531,"_31013":74428,"_21476":126911,"_5":14750,"_28165":126655,"_3038":126912},[],"**Message**: mensaje original o hash.",{"_3569":74532,"_31013":74428,"_21476":126914,"_5":14750,"_28165":126655,"_3038":126915},[],"**Signature**: firma que se desea comprobar.",{"_3569":74533,"_31013":74428,"_21476":126917,"_5":14750,"_28165":126655,"_3038":126918},[],"**Result**: indicador del resultado de la validación.",{"_3569":74534,"_31013":74428,"_21476":126920,"_5":14750,"_28165":126658,"_3038":126921},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3569":74535,"_31013":74428,"_21476":126923,"_5":14750,"_28165":126658,"_3038":126924},[],"Este flujo es útil para:",{"_3569":74536,"_31013":74428,"_21476":126926,"_5":14750,"_28165":126658,"_3038":126927},[],"Solicitar certificados a una CA externa.",{"_3569":74537,"_31013":74428,"_21476":126929,"_5":14750,"_28165":126658,"_3038":126930},[],"Renovar una identidad manteniendo la misma clave.",{"_3569":74538,"_31013":74428,"_21476":126932,"_5":14750,"_28165":126658,"_3038":126933},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3569":74539,"_31013":74428,"_21476":126935,"_5":14750,"_28165":126658,"_3038":126936},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3569":74540,"_31013":74428,"_21476":126938,"_5":14750,"_28165":126658,"_3038":126939},[],"**Organization (O)**: organización o empresa.",{"_3569":74541,"_31013":74428,"_21476":126941,"_5":14750,"_28165":126658,"_3038":126942},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3569":74542,"_31013":74428,"_21476":126944,"_5":14750,"_28165":126658,"_3038":126945},[],"**Country (C)**: código de país de dos letras.",{"_3569":74543,"_31013":74428,"_21476":126947,"_5":14750,"_28165":126658,"_3038":126948},[],"**State / Province (ST)**: estado o provincia.",{"_3569":74544,"_31013":74428,"_21476":126950,"_5":14750,"_28165":126658,"_3038":126951},[],"**Locality (L)**: ciudad o localidad.",{"_3569":74545,"_31013":74428,"_21476":126953,"_5":14750,"_28165":126658,"_3038":126954},[],"**Email Address**: correo de contacto.",{"_3569":74546,"_31013":74428,"_21476":126956,"_5":14750,"_28165":126658,"_3038":126957},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3569":74547,"_31013":74428,"_21476":126959,"_5":14750,"_28165":126658,"_3038":126960},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3569":74548,"_31013":74428,"_21476":126962,"_5":14750,"_28165":126662,"_3038":126963},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3569":74549,"_31013":74428,"_21476":126965,"_5":14750,"_28165":126662,"_3038":126966},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3569":74550,"_31013":74428,"_21476":126968,"_5":14750,"_28165":126666,"_3038":126969},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3569":74551,"_31013":74428,"_21476":126971,"_5":14750,"_28165":126666,"_3038":126972},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3569":74552,"_31013":74552,"_5":15116,"_3038":126974,"_31371":126975,"_21476":126976,"_28165":74552},"Validación online con OCSP",[50615,121048,56098,125566],[],{"_3569":74553,"_31013":74552,"_21476":126978,"_5":14750,"_28165":74552,"_3038":126979},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3569":74554,"_31013":74552,"_5":31368,"_21476":126981,"_28165":126982,"_3038":126983},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3569":74555,"_31013":74552,"_5":31368,"_21476":126985,"_28165":126986,"_3038":126987},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3569":74556,"_31013":74552,"_5":31368,"_21476":126989,"_28165":126990,"_3038":126991},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3569":74557,"_31013":74552,"_5":31368,"_21476":126993,"_28165":126994,"_3038":126995},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3569":74558,"_31013":74552,"_5":31368,"_21476":126997,"_28165":126998,"_3038":126999},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3569":74559,"_31013":74552,"_5":31368,"_21476":127001,"_28165":127002,"_3038":126312},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#referencias",{"_3569":74560,"_31013":74552,"_21476":127004,"_5":14750,"_28165":74552,"_3038":127005},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3569":74561,"_31013":74552,"_21476":127007,"_5":14750,"_28165":126982,"_3038":127008},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3569":74562,"_31013":74552,"_21476":127010,"_5":14750,"_28165":126982,"_3038":127011},[],"Estado del registro",{"_3569":74563,"_31013":74552,"_21476":127013,"_5":14750,"_28165":126982,"_3038":127014},[],"Respuesta firmada",{"_3569":74564,"_31013":74552,"_21476":127016,"_5":14750,"_28165":126982,"_3038":55235},[],{"_3569":74565,"_31013":74552,"_21476":127018,"_5":14750,"_28165":126982,"_3038":58215},[],{"_3569":74566,"_31013":74552,"_21476":127020,"_5":14750,"_28165":126982,"_3038":55252},[],{"_3569":74567,"_31013":74552,"_21476":127022,"_5":14750,"_28165":126982,"_3038":127023},[],"`Revoked`, con razón y fecha de revocación.",{"_3569":74568,"_31013":74552,"_21476":127025,"_5":14750,"_28165":126982,"_3038":127026},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3569":74569,"_31013":74552,"_21476":127028,"_5":14750,"_28165":126982,"_3038":127029},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3569":74570,"_31013":74552,"_21476":127031,"_5":14750,"_28165":126982,"_3038":127032},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3569":74571,"_31013":74552,"_21476":127034,"_5":14750,"_28165":126982,"_3038":127035},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3569":74572,"_31013":74552,"_21476":127037,"_5":14750,"_28165":126982,"_3038":127038},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3569":74573,"_31013":74552,"_21476":127040,"_5":14750,"_28165":126986,"_3038":127041},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3569":74574,"_31013":74552,"_21476":127043,"_5":14750,"_28165":126986,"_3038":127044},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3569":74575,"_31013":74552,"_21476":127046,"_5":14750,"_28165":126990,"_3038":127047},[],"El servicio acepta:",{"_3569":74576,"_31013":74552,"_21476":127049,"_5":14750,"_28165":126990,"_3038":122781},[],{"_3569":74577,"_31013":74552,"_21476":127051,"_5":14750,"_28165":126990,"_3038":127052},[],"Ruta del servicio VA",{"_3569":74578,"_31013":74552,"_21476":127054,"_5":14750,"_28165":126990,"_3038":127055},[],"Formato",{"_3569":74579,"_31013":74552,"_21476":127057,"_5":14750,"_28165":126990,"_3038":58255},[],{"_3569":74580,"_31013":74552,"_21476":127059,"_5":14750,"_28165":126990,"_3038":58258},[],{"_3569":74581,"_31013":74552,"_21476":127061,"_5":14750,"_28165":126990,"_3038":127062},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3569":74582,"_31013":74552,"_21476":127064,"_5":14750,"_28165":126990,"_3038":57667},[],{"_3569":74583,"_31013":74552,"_21476":127066,"_5":14750,"_28165":126990,"_3038":58266},[],{"_3569":74584,"_31013":74552,"_21476":127068,"_5":14750,"_28165":126990,"_3038":127069},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3569":74585,"_31013":74552,"_21476":127071,"_5":14750,"_28165":126990,"_3038":127072},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3569":74586,"_31013":74552,"_21476":127074,"_5":14750,"_28165":126994,"_3038":127075},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3569":74587,"_31013":74552,"_21476":127077,"_5":14750,"_28165":126994,"_3038":127078},[],"Genera la solicitud:",{"_3569":74588,"_31013":74552,"_21476":127080,"_5":14750,"_28165":126994,"_3038":127081},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3569":74589,"_31013":74552,"_21476":127083,"_5":14750,"_28165":126994,"_3038":127084},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3569":74590,"_31013":74552,"_21476":127086,"_5":14750,"_28165":126994,"_3038":127087},[],"Verifica el DER recibido:",{"_3569":74591,"_31013":74552,"_21476":127089,"_5":14750,"_28165":126994,"_3038":127090},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3569":74592,"_31013":74552,"_21476":127092,"_5":14750,"_28165":126998,"_3038":127093},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3569":74593,"_31013":74552,"_21476":127095,"_5":14750,"_28165":126998,"_3038":127096},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3569":74594,"_31013":74552,"_21476":127098,"_5":14750,"_28165":127002,"_3038":58299},[],{"_3569":74595,"_31013":74552,"_21476":127100,"_5":14750,"_28165":127002,"_3038":58302},[],{"_3569":74596,"_31013":74552,"_21476":127102,"_5":14750,"_28165":127002,"_3038":127103},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3569":74597,"_31013":74552,"_21476":127105,"_5":14750,"_28165":127002,"_3038":126588},[],{"_3569":74598,"_31013":74598,"_5":15116,"_3038":56098,"_31371":127107,"_21476":127108,"_28165":74598},[50615,121048,56098],[],{"_3569":74599,"_31013":74598,"_21476":127110,"_5":14750,"_28165":74598,"_3038":127111},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3569":74600,"_31013":74598,"_5":31368,"_21476":127113,"_28165":127114,"_3038":124255},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#empieza-aquí",{"_3569":74601,"_31013":74598,"_5":31368,"_21476":127116,"_28165":127117,"_3038":127118},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3569":74602,"_31013":74598,"_5":31368,"_21476":127120,"_28165":127121,"_3038":124775},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#capacidades-principales",{"_3569":74603,"_31013":74598,"_5":31368,"_21476":127123,"_28165":127124,"_3038":124779},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3569":74604,"_31013":74598,"_5":31368,"_21476":127126,"_28165":127127,"_3038":124783},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3569":74605,"_31013":74598,"_5":31368,"_21476":127129,"_28165":127130,"_3038":124787},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#emite-y-controla-certificados",{"_3569":74606,"_31013":74598,"_5":31368,"_21476":127132,"_28165":127133,"_3038":124795},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#publica-el-estado-de-validación",{"_3569":74607,"_31013":74598,"_5":31368,"_21476":127135,"_28165":127136,"_3038":127137},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3569":74608,"_31013":74598,"_5":31368,"_21476":127139,"_28165":127140,"_3038":125732},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#continúa",{"_3569":74609,"_31013":74598,"_21476":127142,"_5":14750,"_28165":74598,"_3038":127143},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3569":74610,"_31013":74598,"_21476":127145,"_5":14750,"_28165":127114,"_3038":127146},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3569":74611,"_31013":74598,"_21476":127148,"_5":14750,"_28165":127114,"_3038":127149},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3569":74612,"_31013":74598,"_21476":127151,"_5":14750,"_28165":127117,"_3038":127152},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3569":74613,"_31013":74598,"_21476":127154,"_5":14750,"_28165":127117,"_3038":127155},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3569":74614,"_31013":74598,"_21476":127157,"_5":14750,"_28165":127117,"_3038":127158},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3569":74615,"_31013":74598,"_21476":127160,"_5":14750,"_28165":127117,"_3038":127161},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3569":74616,"_31013":74598,"_21476":127163,"_5":14750,"_28165":127117,"_3038":127164},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3569":74617,"_31013":74598,"_21476":127166,"_5":14750,"_28165":127124,"_3038":127167},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3569":74618,"_31013":74598,"_21476":127169,"_5":14750,"_28165":127127,"_3038":127170},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3569":74619,"_31013":74598,"_21476":127172,"_5":14750,"_28165":127130,"_3038":127173},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3569":74620,"_31013":74598,"_21476":127175,"_5":14750,"_28165":127133,"_3038":127176},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3569":74621,"_31013":74598,"_21476":127178,"_5":14750,"_28165":127136,"_3038":127179},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3569":74622,"_31013":74598,"_21476":127181,"_5":14750,"_28165":127136,"_3038":127182},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3569":74623,"_31013":74598,"_21476":127184,"_5":14750,"_28165":127136,"_3038":127185},[],"su clave pública corresponda a la clave privada del cliente;",{"_3569":74624,"_31013":74598,"_21476":127187,"_5":14750,"_28165":127136,"_3038":127188},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3569":74625,"_31013":74598,"_21476":127190,"_5":14750,"_28165":127136,"_3038":127191},[],"sus fechas y usos permitan la operación;",{"_3569":74626,"_31013":74598,"_21476":127193,"_5":14750,"_28165":127136,"_3038":127194},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3569":74627,"_31013":74598,"_21476":127196,"_5":14750,"_28165":127136,"_3038":127197},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3569":74628,"_31013":74598,"_21476":127199,"_5":14750,"_28165":127140,"_3038":127200},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3569":74629,"_31013":74598,"_21476":127202,"_5":14750,"_28165":127140,"_3038":127203},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3569":74630,"_31013":74598,"_21476":127205,"_5":14750,"_28165":127140,"_3038":127206},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3569":74631,"_31013":74631,"_5":15116,"_3038":127208,"_31371":127209,"_21476":127210,"_28165":74631},"Crea tu primera CA",[50615,121048,56098,124379],[],{"_3569":74632,"_31013":74631,"_21476":127212,"_5":14750,"_28165":74631,"_3038":127213},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3569":74633,"_31013":74631,"_5":31368,"_21476":127215,"_28165":127216,"_3038":119619},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3569":74634,"_31013":74631,"_5":31368,"_21476":127218,"_28165":127219,"_3038":127220},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#crea-la-autoridad","Crea la autoridad",{"_3569":74635,"_31013":74631,"_5":31368,"_21476":127222,"_28165":127223,"_3038":127224},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3569":74636,"_31013":74631,"_5":31368,"_21476":127226,"_28165":127227,"_3038":124626},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3569":74637,"_31013":74631,"_5":31368,"_21476":127229,"_28165":127230,"_3038":119643},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3569":74638,"_31013":74631,"_21476":127232,"_5":14750,"_28165":74631,"_3038":127233},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3569":74639,"_31013":74631,"_21476":127235,"_5":14750,"_28165":127216,"_3038":127236},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3569":74640,"_31013":74631,"_21476":127238,"_5":14750,"_28165":127216,"_3038":127239},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3569":74641,"_31013":74631,"_21476":127241,"_5":14750,"_28165":127216,"_3038":127242},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3569":74642,"_31013":74631,"_21476":127244,"_5":14750,"_28165":127216,"_3038":127245},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3569":74643,"_31013":74631,"_21476":127247,"_5":14750,"_28165":127219,"_3038":127248},[],"Sigue el recorrido interactivo para crear una CA raíz con una clave ECDSA P-384 nueva, un sujeto de ejemplo y un perfil de emisión para certificados de cliente. La disponibilidad y la vigencia de los perfiles dependen del entorno; elige valores adecuados para tu CA.",{"_3569":74644,"_31013":74631,"_21476":127250,"_5":14750,"_28165":127219,"_3038":127251},[],"El ejemplo define **CA Name** como `Acme Showcase Root CA`, que se convierte en el Common Name (CN) del subject. También completa los campos opcionales &#x2A;*Country (C)** con `ES` y &#x2A;*Organization (O)** con `Acme`; utiliza los valores que correspondan a tu autoridad.",{"_3569":74645,"_31013":74631,"_21476":127253,"_5":14750,"_28165":127219,"_3038":127254},[],"Abre la nueva CA y selecciona **Certificate PEM**. Descarga o copia su certificado público en `ca.pem`, incluyendo el bloque completo entre `BEGIN CERTIFICATE` y `END CERTIFICATE`. La clave privada permanece en el motor configurado. Para reutilizar una clave existente, consulta la guía de autoridades.",{"_3569":74646,"_31013":74631,"_21476":127256,"_5":14750,"_28165":127223,"_3038":127257},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3569":74647,"_31013":74631,"_21476":127259,"_5":14750,"_28165":127223,"_3038":127260},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3569":74648,"_31013":74631,"_21476":127262,"_5":14750,"_28165":127223,"_3038":127263},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3569":74649,"_31013":74631,"_21476":127265,"_5":14750,"_28165":127227,"_3038":127266},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3569":74650,"_31013":74631,"_21476":127268,"_5":14750,"_28165":127227,"_3038":127269},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3569":74651,"_31013":74631,"_21476":127271,"_5":14750,"_28165":127227,"_3038":127272},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3569":74652,"_31013":74631,"_21476":127274,"_5":14750,"_28165":127227,"_3038":127275},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3569":74653,"_31013":74631,"_21476":127277,"_5":14750,"_28165":127230,"_3038":127278},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3569":74654,"_31013":74654,"_5":15116,"_3038":127280,"_31371":127281,"_21476":127282,"_28165":74654},"Emite y verifica un certificado",[50615,121048,56098,124379],[],{"_3569":74655,"_31013":74654,"_21476":127284,"_5":14750,"_28165":74654,"_3038":127285},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3569":74656,"_31013":74654,"_5":31368,"_21476":127287,"_28165":127288,"_3038":119619},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3569":74657,"_31013":74654,"_5":31368,"_21476":127290,"_28165":127291,"_3038":127292},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3569":74658,"_31013":74654,"_5":31368,"_21476":127294,"_28165":127295,"_3038":127296},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3569":74659,"_31013":74654,"_5":31368,"_21476":127298,"_28165":127299,"_3038":127300},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3569":74660,"_31013":74654,"_5":31368,"_21476":127302,"_28165":127303,"_3038":127304},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3569":74661,"_31013":74654,"_5":31368,"_21476":127306,"_28165":127307,"_3038":127308},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3569":74662,"_31013":74654,"_5":31368,"_21476":127310,"_28165":127311,"_3038":127312},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3569":74663,"_31013":74654,"_5":31368,"_21476":127314,"_28165":127315,"_3038":127316},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3569":74664,"_31013":74654,"_5":31368,"_21476":127318,"_28165":127319,"_3038":127320},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3569":74665,"_31013":74654,"_5":31368,"_21476":127322,"_28165":127323,"_3038":127324},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3569":74666,"_31013":74654,"_5":31368,"_21476":127326,"_28165":127327,"_3038":124626},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3569":74667,"_31013":74654,"_5":31368,"_21476":127329,"_28165":127330,"_3038":119643},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3569":74668,"_31013":74654,"_21476":127332,"_5":14750,"_28165":74654,"_3038":127333},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3569":74669,"_31013":74654,"_21476":127335,"_5":14750,"_28165":127288,"_3038":127336},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3569":74670,"_31013":74654,"_21476":127338,"_5":14750,"_28165":127288,"_3038":127339},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3569":74671,"_31013":74654,"_21476":127341,"_5":14750,"_28165":127288,"_3038":127342},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3569":74672,"_31013":74654,"_21476":127344,"_5":14750,"_28165":127288,"_3038":127345},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3569":74673,"_31013":74654,"_21476":127347,"_5":14750,"_28165":127288,"_3038":127348},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3569":74674,"_31013":74654,"_21476":127350,"_5":14750,"_28165":127291,"_3038":127351},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3569":74675,"_31013":74654,"_21476":127353,"_5":14750,"_28165":127295,"_3038":127354},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3569":74676,"_31013":74654,"_21476":127356,"_5":14750,"_28165":127295,"_3038":127357},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3569":74677,"_31013":74654,"_21476":127359,"_5":14750,"_28165":127299,"_3038":127360},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3569":74678,"_31013":74654,"_21476":127362,"_5":14750,"_28165":127299,"_3038":127363},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3569":74679,"_31013":74654,"_21476":127365,"_5":14750,"_28165":127303,"_3038":127366},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3569":74680,"_31013":74654,"_21476":127368,"_5":14750,"_28165":127303,"_3038":127369},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3569":74681,"_31013":74654,"_21476":127371,"_5":14750,"_28165":127307,"_3038":127372},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3569":74682,"_31013":74654,"_21476":127374,"_5":14750,"_28165":127311,"_3038":127375},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3569":74683,"_31013":74654,"_21476":127377,"_5":14750,"_28165":127315,"_3038":127378},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3569":74684,"_31013":74654,"_21476":127380,"_5":14750,"_28165":127319,"_3038":127381},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3569":74685,"_31013":74654,"_21476":127383,"_5":14750,"_28165":127319,"_3038":127384},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3569":74686,"_31013":74654,"_21476":127386,"_5":14750,"_28165":127319,"_3038":127387},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3569":74687,"_31013":74654,"_21476":127389,"_5":14750,"_28165":127323,"_3038":127390},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3569":74688,"_31013":74654,"_21476":127392,"_5":14750,"_28165":127323,"_3038":127393},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3569":74689,"_31013":74654,"_21476":127395,"_5":14750,"_28165":127323,"_3038":127396},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3569":74690,"_31013":74654,"_21476":127398,"_5":14750,"_28165":127327,"_3038":124709},[],{"_3569":74691,"_31013":74654,"_21476":127400,"_5":14750,"_28165":127327,"_3038":123230},[],{"_3569":74692,"_31013":74654,"_21476":127402,"_5":14750,"_28165":127327,"_3038":127403},[],"La CA rechaza la emisión",{"_3569":74693,"_31013":74654,"_21476":127405,"_5":14750,"_28165":127327,"_3038":127406},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3569":74694,"_31013":74654,"_21476":127408,"_5":14750,"_28165":127327,"_3038":127409},[],"Sujeto o usos diferentes",{"_3569":74695,"_31013":74654,"_21476":127411,"_5":14750,"_28165":127327,"_3038":127412},[],"Perfil aplicado y valores solicitados.",{"_3569":74696,"_31013":74654,"_21476":127414,"_5":14750,"_28165":127327,"_3038":127415},[],"No se encuentra el emisor",{"_3569":74697,"_31013":74654,"_21476":127417,"_5":14750,"_28165":127327,"_3038":127418},[],"CA descargada y cadena intermedia necesaria.",{"_3569":74698,"_31013":74654,"_21476":127420,"_5":14750,"_28165":127327,"_3038":127421},[],"Falla la vigencia",{"_3569":74699,"_31013":74654,"_21476":127423,"_5":14750,"_28165":127327,"_3038":127424},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3569":74700,"_31013":74654,"_21476":127426,"_5":14750,"_28165":127327,"_3038":127427},[],"Los resúmenes de clave difieren",{"_3569":74701,"_31013":74654,"_21476":127429,"_5":14750,"_28165":127327,"_3038":127430},[],"Archivos de certificado y clave de la misma emisión.",{"_3569":74702,"_31013":74654,"_21476":127432,"_5":14750,"_28165":127327,"_3038":127433},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3569":74703,"_31013":74654,"_21476":127435,"_5":14750,"_28165":127330,"_3038":127436},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3569":74704,"_31013":74654,"_21476":127438,"_5":14750,"_28165":127330,"_3038":127439},[],"Gestionar certificados para inspección, estado y revocación.",{"_3569":74705,"_31013":74654,"_21476":127441,"_5":14750,"_28165":127330,"_3038":127442},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3569":74706,"_31013":74654,"_21476":127444,"_5":14750,"_28165":127330,"_3038":127445},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3569":74707,"_31013":74654,"_21476":127447,"_5":14750,"_28165":127330,"_3038":127448},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3569":74708,"_31013":74708,"_5":15116,"_3038":127450,"_31371":127451,"_21476":127452,"_28165":74708},"Primeros pasos de PKI",[50615,121048,56098,124379],[],{"_3569":74709,"_31013":74708,"_21476":127454,"_5":14750,"_28165":74708,"_3038":127455},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3569":74710,"_31013":74708,"_5":31368,"_21476":127457,"_28165":127458,"_3038":119619},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3569":74711,"_31013":74708,"_5":31368,"_21476":127460,"_28165":127461,"_3038":127462},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3569":74712,"_31013":74708,"_5":31368,"_21476":127464,"_28165":127465,"_3038":124561},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3569":74713,"_31013":74708,"_5":31368,"_21476":127467,"_28165":127468,"_3038":127469},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3569":74714,"_31013":74708,"_21476":127471,"_5":14750,"_28165":74708,"_3038":127472},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3569":74715,"_31013":74708,"_21476":127474,"_5":14750,"_28165":127458,"_3038":127475},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3569":74716,"_31013":74708,"_21476":127477,"_5":14750,"_28165":127458,"_3038":127478},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3569":74717,"_31013":74708,"_21476":127480,"_5":14750,"_28165":127458,"_3038":127481},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3569":74718,"_31013":74708,"_21476":127483,"_5":14750,"_28165":127458,"_3038":127484},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3569":74719,"_31013":74708,"_21476":127486,"_5":14750,"_28165":127458,"_3038":127487},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3569":74720,"_31013":74708,"_21476":127489,"_5":14750,"_28165":127461,"_3038":127490},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3569":74721,"_31013":74708,"_21476":127492,"_5":14750,"_28165":127461,"_3038":127493},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3569":74722,"_31013":74708,"_21476":127495,"_5":14750,"_28165":127461,"_3038":127496},[],"<Card title=\"3. Revoca un certificado y comprueba la CRL\" description=\"Revoca device-042 entre 100 certificados emitidos y confirma que aparece en la CRL de la CA.\" href=\"/docs/platform/pki/quickstarts/revoke-certificate\" />",{"_3569":74723,"_31013":74708,"_21476":127498,"_5":14750,"_28165":127461,"_3038":127499},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3569":74724,"_31013":74708,"_21476":127501,"_5":14750,"_28165":127461,"_3038":127502},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3569":74725,"_31013":74708,"_21476":127504,"_5":14750,"_28165":127465,"_3038":127505},[],"Archivo o recurso",{"_3569":74726,"_31013":74708,"_21476":127507,"_5":14750,"_28165":127465,"_3038":124558},[],{"_3569":74727,"_31013":74708,"_21476":127509,"_5":14750,"_28165":127465,"_3038":127510},[],"CA raíz activa y `ca.pem`",{"_3569":74728,"_31013":74708,"_21476":127512,"_5":14750,"_28165":127465,"_3038":127513},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3569":74729,"_31013":74708,"_21476":127515,"_5":14750,"_28165":127465,"_3038":127516},[],"Certificado final y `device.crt`",{"_3569":74730,"_31013":74708,"_21476":127518,"_5":14750,"_28165":127465,"_3038":127519},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3569":74731,"_31013":74708,"_21476":127521,"_5":14750,"_28165":127465,"_3038":127522},[],"Clave privada `device.key`",{"_3569":74732,"_31013":74708,"_21476":127524,"_5":14750,"_28165":127465,"_3038":127525},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3569":74733,"_31013":74708,"_21476":127527,"_5":14750,"_28165":127465,"_3038":127528},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3569":74734,"_31013":74708,"_21476":127530,"_5":14750,"_28165":127468,"_3038":127531},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3569":74735,"_31013":74708,"_21476":127533,"_5":14750,"_28165":127468,"_3038":127534},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3569":74736,"_31013":74708,"_21476":127536,"_5":14750,"_28165":127468,"_3038":127537},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3569":74737,"_31013":74737,"_5":15116,"_3038":127539,"_31371":127540,"_21476":127541,"_28165":74737},"Revoca un certificado y comprueba la CRL",[50615,121048,56098,124379],[],{"_3569":74738,"_31013":74737,"_21476":127543,"_5":14750,"_28165":74737,"_3038":127544},[],"Revoca un certificado entre los muchos emitidos por una CA y confirma que su CRL lo incluye.",{"_3569":74739,"_31013":74737,"_5":31368,"_21476":127546,"_28165":127547,"_3038":119619},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#antes-de-empezar",{"_3569":74740,"_31013":74737,"_5":31368,"_21476":127549,"_28165":127550,"_3038":127551},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#revoca-el-certificado","Revoca el certificado",{"_3569":74741,"_31013":74737,"_5":31368,"_21476":127553,"_28165":127554,"_3038":127555},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#localiza-el-certificado","Localiza el certificado",{"_3569":74742,"_31013":74737,"_5":31368,"_21476":127557,"_28165":127558,"_3038":127559},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#revócalo","Revócalo",{"_3569":74743,"_31013":74737,"_5":31368,"_21476":127561,"_28165":127562,"_3038":127563},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#confirma-y-lee-el-estado","Confirma y lee el estado",{"_3569":74744,"_31013":74737,"_5":31368,"_21476":127565,"_28165":127566,"_3038":125704},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#descarga-el-certificado",{"_3569":74745,"_31013":74737,"_5":31368,"_21476":127568,"_28165":127569,"_3038":127570},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#comprueba-la-crl","Comprueba la CRL",{"_3569":74746,"_31013":74737,"_5":31368,"_21476":127572,"_28165":127573,"_3038":127574},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#verifica-con-la-lista","Verifica con la lista",{"_3569":74747,"_31013":74737,"_5":31368,"_21476":127576,"_28165":127577,"_3038":124626},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#si-el-resultado-falla",{"_3569":74748,"_31013":74737,"_21476":127579,"_5":14750,"_28165":74737,"_3038":127580},[],"Revocarás el certificado de `device-042`, uno de los 100 certificados emitidos por la CA, y después comprobarás que la lista de revocación (CRL) de la CA lo incluye mientras los demás certificados siguen siendo válidos. Al terminar tendrás un certificado revocado en Lamassu y una CRL descargada que recoge su número de serie y el motivo.",{"_3569":74749,"_31013":74737,"_21476":127582,"_5":14750,"_28165":127547,"_3038":127583},[],"Una CA con certificados emitidos y permisos para cambiar su estado. El ejemplo utiliza `Acme Showcase Root CA`, de Crea tu primera CA, con los 100 certificados de cliente `device-001` a `device-100`. Con menos certificados el procedimiento es el mismo.",{"_3569":74750,"_31013":74737,"_21476":127585,"_5":14750,"_28165":127547,"_3038":127586},[],"El certificado público de la CA en `ca.pem`, tal como se guardó en el primer recorrido.",{"_3569":74751,"_31013":74737,"_21476":127588,"_5":14750,"_28165":127547,"_3038":127589},[],"OpenSSL 3.x y `curl` en un equipo con acceso al endpoint de la CRL.",{"_3569":74752,"_31013":74737,"_21476":127591,"_5":14750,"_28165":127547,"_3038":127592},[],"Solo `CertificateHold` puede deshacerse más adelante. Cualquier otro motivo es final, así que usa un certificado de evaluación en este recorrido. Antes de revocar en producción, identifica los consumidores de la identidad y prepara un reemplazo.",{"_3569":74753,"_31013":74737,"_21476":127594,"_5":14750,"_28165":127550,"_3038":127595},[],"Sigue el recorrido interactivo. Abre la CA emisora, filtra sus **Issued Certificates** por Common Name para localizar `device-042` entre los 100 y lo revoca con el motivo `KeyCompromise`.",{"_3569":74754,"_31013":74737,"_21476":127597,"_5":14750,"_28165":127550,"_3038":127598},[],"En la consola, los pasos son:",{"_3569":74755,"_31013":74737,"_21476":127600,"_5":14750,"_28165":127554,"_3038":127601},[],"Abre **Certification Authorities**, selecciona la CA emisora y entra en **Issued Certificates**. Busca `device-042` por `Common Name`. El certificado de la propia CA aparece también en esta pestaña; no los confundas.",{"_3569":74756,"_31013":74737,"_21476":127603,"_5":14750,"_28165":127558,"_3038":127604},[],"Abre el menú **More actions** de la fila encontrada y selecciona **Revoke Certificate**. En el diálogo de confirmación, elige el **Revocation Reason** que describa el incidente. Este ejemplo usa `KeyCompromise`, porque se considera que la clave del dispositivo está expuesta. Usa `CertificateHold` solo para una suspensión reversible.",{"_3569":74757,"_31013":74737,"_21476":127606,"_5":14750,"_28165":127562,"_3038":127607},[],"Selecciona **Confirm Revocation**. La fila pasa a `REVOKED` y muestra el motivo y la hora de revocación. Si necesitas verificarlo más tarde, vuelve a leer el registro en lugar de fiarte del diálogo.",{"_3569":74758,"_31013":74737,"_21476":127609,"_5":14750,"_28165":127562,"_3038":127610},[],"La revocación no elimina el certificado ni su clave, y no cierra las sesiones ya establecidas. Consulta Certificados para conocer los motivos y sus consecuencias.",{"_3569":74759,"_31013":74737,"_21476":127612,"_5":14750,"_28165":127566,"_3038":127613},[],"Desde el mismo menú **More actions**, selecciona **Download PEM** y guarda el archivo como `device-042.crt`. Anota su número de serie y el punto de distribución de CRL (CDP) que incluye:",{"_3569":74760,"_31013":74737,"_21476":127615,"_5":14750,"_28165":127566,"_3038":127616},[],"La URL termina con el ID de la **CA emisora**, no con el ID ni el número de serie del certificado. Tu número de serie será distinto del mostrado.",{"_3569":74761,"_31013":74737,"_21476":127618,"_5":14750,"_28165":127569,"_3038":127619},[],"Lamassu regenera la CRL de la CA cuando se revoca un certificado, siempre que `regenerate_on_revoke` esté activado, como ocurre por defecto. El endpoint es público y no requiere autenticación. Sustituye la URL por el CDP de tu certificado y descarga la lista:",{"_3569":74762,"_31013":74737,"_21476":127621,"_5":14750,"_28165":127569,"_3038":127622},[],"Comprueba que la lista está firmada por tu CA, está vigente y contiene el número de serie:",{"_3569":74763,"_31013":74737,"_21476":127624,"_5":14750,"_28165":127569,"_3038":127625},[],"Debe aparecer `verify OK`, el emisor esperado, un `lastUpdate` no anterior a la revocación y una entrada con el número de serie de `device-042` y el motivo `Key Compromise`; la lista recoge también cualquier otro certificado que esta CA hubiera revocado antes. Si el número de CRL es el mismo que antes de revocar, la lista todavía no se ha regenerado.",{"_3569":74764,"_31013":74737,"_21476":127627,"_5":14750,"_28165":127573,"_3038":127628},[],"`openssl verify` puede aplicar la lista descargada a un certificado. El certificado revocado debe rechazarse y cualquier otro certificado de la misma CA debe seguir superando la comprobación. Para `device-001`, descarga su PEM del mismo modo y guárdalo como `device-001.crt`:",{"_3569":74765,"_31013":74737,"_21476":127630,"_5":14750,"_28165":127573,"_3038":127631},[],"Esta comprobación usa tu copia local de la lista: no descarga listas más recientes ni demuestra que todos los clientes hayan refrescado la suya. Para consultar el estado en línea, consulta OCSP.",{"_3569":74766,"_31013":74737,"_21476":127633,"_5":14750,"_28165":127577,"_3038":124709},[],{"_3569":74767,"_31013":74737,"_21476":127635,"_5":14750,"_28165":127577,"_3038":123230},[],{"_3569":74768,"_31013":74737,"_21476":127637,"_5":14750,"_28165":127577,"_3038":127638},[],"**Revoke Certificate** no está disponible",{"_3569":74769,"_31013":74737,"_21476":127640,"_5":14750,"_28165":127577,"_3038":127641},[],"El certificado ya está `REVOKED` por un motivo final o está `EXPIRED`.",{"_3569":74770,"_31013":74737,"_21476":127643,"_5":14750,"_28165":127577,"_3038":127644},[],"La descarga de la CRL devuelve 404",{"_3569":74771,"_31013":74737,"_21476":127646,"_5":14750,"_28165":127577,"_3038":127647},[],"El ID de la URL no es el de la CA emisora: usa el CDP del certificado.",{"_3569":74772,"_31013":74737,"_21476":127649,"_5":14750,"_28165":127577,"_3038":127650},[],"`verify OK` no aparece",{"_3569":74773,"_31013":74737,"_21476":127652,"_5":14750,"_28165":127577,"_3038":127653},[],"`ca.pem` no es el certificado de la CA que firmó la lista.",{"_3569":74774,"_31013":74737,"_21476":127655,"_5":14750,"_28165":127577,"_3038":127656},[],"El serial no está en la lista",{"_3569":74775,"_31013":74737,"_21476":127658,"_5":14750,"_28165":127577,"_3038":127659},[],"La lista se descargó antes de la revocación o su regeneración falló. Consulta los errores de configuración de CRL.",{"_3569":74776,"_31013":74737,"_21476":127661,"_5":14750,"_28165":127577,"_3038":127662},[],"`device-001` también se rechaza",{"_3569":74777,"_31013":74737,"_21476":127664,"_5":14750,"_28165":127577,"_3038":127665},[],"El certificado fue revocado o `ca.pem` no corresponde a su emisor.",{"_3569":74778,"_31013":74737,"_21476":127667,"_5":14750,"_28165":127577,"_3038":127668},[],"<Card title=\"Gestionar certificados\" description=\"Motivos, suspensiones y reactivación.\" href=\"/docs/platform/pki/certificates\" />",{"_3569":74779,"_31013":74737,"_21476":127670,"_5":14750,"_28165":127577,"_3038":127671},[],"<Card title=\"Listas de revocación (CRL)\" description=\"Configuración, regeneración y publicación.\" href=\"/docs/platform/pki/crl\" />",{"_3569":74780,"_31013":74737,"_21476":127673,"_5":14750,"_28165":127577,"_3038":127674},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3569":74781,"_31013":74781,"_5":15116,"_3038":127676,"_31371":127677,"_21476":127679,"_28165":74781},"Resolución de problemas PKI",[50615,121048,56098,127678],"Resolución de problemas",[],{"_3569":74782,"_31013":74781,"_21476":127681,"_5":14750,"_28165":74781,"_3038":127682},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3569":74783,"_31013":74781,"_5":31368,"_21476":127684,"_28165":127685,"_3038":127686},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3569":74784,"_31013":74781,"_5":31368,"_21476":127688,"_28165":127689,"_3038":127690},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3569":74785,"_31013":74781,"_5":31368,"_21476":127692,"_28165":127693,"_3038":127694},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3569":74786,"_31013":74781,"_21476":127696,"_5":14750,"_28165":74781,"_3038":127697},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3569":74787,"_31013":74781,"_21476":127699,"_5":14750,"_28165":74781,"_3038":127700},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3569":74788,"_31013":74781,"_21476":127702,"_5":14750,"_28165":127685,"_3038":124558},[],{"_3569":74789,"_31013":74781,"_21476":127704,"_5":14750,"_28165":127685,"_3038":123230},[],{"_3569":74790,"_31013":74781,"_21476":127706,"_5":14750,"_28165":127685,"_3038":119643},[],{"_3569":74791,"_31013":74781,"_21476":127708,"_5":14750,"_28165":127685,"_3038":54940},[],{"_3569":74792,"_31013":74781,"_21476":127710,"_5":14750,"_28165":127685,"_3038":127711},[],"Existe, está activa y sus fechas son utilizables.",{"_3569":74793,"_31013":74781,"_21476":127713,"_5":14750,"_28165":127685,"_3038":127714},[],"Autoridades.",{"_3569":74794,"_31013":74781,"_21476":127716,"_5":14750,"_28165":127685,"_3038":127717},[],"Clave",{"_3569":74795,"_31013":74781,"_21476":127719,"_5":14750,"_28165":127685,"_3038":127720},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3569":74796,"_31013":74781,"_21476":127722,"_5":14750,"_28165":127685,"_3038":127723},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3569":74797,"_31013":74781,"_21476":127725,"_5":14750,"_28165":127685,"_3038":58929},[],{"_3569":74798,"_31013":74781,"_21476":127727,"_5":14750,"_28165":127685,"_3038":127728},[],"PEM correcto y firma verificable.",{"_3569":74799,"_31013":74781,"_21476":127730,"_5":14750,"_28165":127685,"_3038":58935},[],{"_3569":74800,"_31013":74781,"_21476":127732,"_5":14750,"_28165":127685,"_3038":127733},[],"Perfil",{"_3569":74801,"_31013":74781,"_21476":127735,"_5":14750,"_28165":127685,"_3038":127736},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3569":74802,"_31013":74781,"_21476":127738,"_5":14750,"_28165":127685,"_3038":127739},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3569":74803,"_31013":74781,"_21476":127741,"_5":14750,"_28165":127685,"_3038":124709},[],{"_3569":74804,"_31013":74781,"_21476":127743,"_5":14750,"_28165":127685,"_3038":127744},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3569":74805,"_31013":74781,"_21476":127746,"_5":14750,"_28165":127685,"_3038":127747},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3569":74806,"_31013":74781,"_21476":127749,"_5":14750,"_28165":127685,"_3038":127750},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3569":74807,"_31013":74781,"_21476":127752,"_5":14750,"_28165":127685,"_3038":127753},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3569":74808,"_31013":74781,"_21476":127755,"_5":14750,"_28165":127689,"_3038":127756},[],"Revisa cada frontera por separado:",{"_3569":74809,"_31013":74781,"_21476":127758,"_5":14750,"_28165":127689,"_3038":127759},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3569":74810,"_31013":74781,"_21476":127761,"_5":14750,"_28165":127689,"_3038":127762},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3569":74811,"_31013":74781,"_21476":127764,"_5":14750,"_28165":127689,"_3038":127765},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3569":74812,"_31013":74781,"_21476":127767,"_5":14750,"_28165":127689,"_3038":127768},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3569":74813,"_31013":74781,"_21476":127770,"_5":14750,"_28165":127689,"_3038":127771},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3569":74814,"_31013":74781,"_21476":127773,"_5":14750,"_28165":127689,"_3038":127774},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3569":74815,"_31013":74781,"_21476":127776,"_5":14750,"_28165":127693,"_3038":127777},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3569":74816,"_31013":74781,"_21476":127779,"_5":14750,"_28165":127693,"_3038":127780},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3569":74817,"_31013":74817,"_5":15116,"_3038":127782,"_31371":127783,"_21476":127784,"_28165":74817},"Seguridad",[50615],[],{"_3569":74818,"_31013":74817,"_21476":127786,"_5":14750,"_28165":74817,"_3038":127787},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3569":74819,"_31013":74817,"_5":31368,"_21476":127789,"_28165":127790,"_3038":127791},[],"/docs/pr-preview/pr-61/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3569":74820,"_31013":74817,"_5":31368,"_21476":127793,"_28165":127794,"_3038":127795},[],"/docs/pr-preview/pr-61/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3569":74821,"_31013":74817,"_5":31368,"_21476":127797,"_28165":127798,"_3038":127799},[],"/docs/pr-preview/pr-61/es/security#versiones-soportadas","Versiones soportadas",{"_3569":74822,"_31013":74817,"_5":31368,"_21476":127801,"_28165":127802,"_3038":127803},[],"/docs/pr-preview/pr-61/es/security#divulgación-responsable","Divulgación responsable",{"_3569":74823,"_31013":74817,"_21476":127805,"_5":14750,"_28165":74817,"_3038":127806},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3569":74824,"_31013":74817,"_21476":127808,"_5":14750,"_28165":127790,"_3038":127809},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3569":74825,"_31013":74817,"_21476":127811,"_5":14750,"_28165":127790,"_3038":127812},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3569":74826,"_31013":74817,"_21476":127814,"_5":14750,"_28165":127790,"_3038":15413},[],{"_3569":74827,"_31013":74817,"_21476":127816,"_5":14750,"_28165":127790,"_3038":15353},[],{"_3569":74828,"_31013":74817,"_21476":127818,"_5":14750,"_28165":127790,"_3038":15400},[],{"_3569":74829,"_31013":74817,"_21476":127820,"_5":14750,"_28165":127790,"_3038":127821},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3569":74830,"_31013":74817,"_21476":127823,"_5":14750,"_28165":127790,"_3038":127824},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3569":74831,"_31013":74817,"_21476":127826,"_5":14750,"_28165":127794,"_3038":127827},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3569":74832,"_31013":74817,"_21476":127829,"_5":14750,"_28165":127794,"_3038":127830},[],"No incluyas en el reporte:",{"_3569":74833,"_31013":74817,"_21476":127832,"_5":14750,"_28165":127794,"_3038":127833},[],"Credenciales, tokens o claves privadas",{"_3569":74834,"_31013":74817,"_21476":127835,"_5":14750,"_28165":127794,"_3038":127836},[],"Datos de clientes o información identificable de clientes",{"_3569":74835,"_31013":74817,"_21476":127838,"_5":14750,"_28165":127794,"_3038":127839},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3569":74836,"_31013":74817,"_21476":127841,"_5":14750,"_28165":127798,"_3038":127842},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3569":74837,"_31013":74817,"_21476":127844,"_5":14750,"_28165":127798,"_3038":127845},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3569":74838,"_31013":74817,"_21476":127847,"_5":14750,"_28165":127802,"_3038":127848},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3569":74839,"_31013":74817,"_21476":127850,"_5":14750,"_28165":127802,"_3038":127851},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3569":74840,"_31013":74817,"_21476":127853,"_5":14750,"_28165":127802,"_3038":127854},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3569":74841,"_31013":74817,"_21476":127856,"_5":14750,"_28165":127802,"_3038":127857},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3569":74842,"_31013":74817,"_21476":127859,"_5":14750,"_28165":127802,"_3038":127860},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3569":74843,"_31013":74843,"_5":15116,"_3038":127862,"_31371":127863,"_21476":127865,"_28165":74843},"3.8.0 a 4.0.0",[50615,127864],"Actualizaciones",[],{"_3569":74844,"_31013":74843,"_21476":127867,"_5":14750,"_28165":74843,"_3038":127868},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3569":74845,"_31013":74843,"_5":31368,"_21476":127870,"_28165":127871,"_3038":127872},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3569":74846,"_31013":74843,"_5":31368,"_21476":127874,"_28165":127875,"_3038":127876},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3569":74847,"_31013":74843,"_5":31368,"_21476":127878,"_28165":127879,"_3038":127880},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3569":74848,"_31013":74843,"_5":31368,"_21476":127882,"_28165":127883,"_3038":127884},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3569":74849,"_31013":74843,"_5":31368,"_21476":127886,"_28165":127887,"_3038":127888},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3569":74850,"_31013":74843,"_5":31368,"_21476":127890,"_28165":127891,"_3038":127892},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3569":74851,"_31013":74843,"_5":31368,"_21476":127894,"_28165":127895,"_3038":59101},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3569":74852,"_31013":74843,"_5":31368,"_21476":127897,"_28165":127898,"_3038":127899},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3569":74853,"_31013":74843,"_5":31368,"_21476":127901,"_28165":127902,"_3038":127903},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3569":74854,"_31013":74843,"_5":31368,"_21476":127905,"_28165":127906,"_3038":127907},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3569":74855,"_31013":74843,"_5":31368,"_21476":127909,"_28165":127910,"_3038":127911},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3569":74856,"_31013":74843,"_5":31368,"_21476":127913,"_28165":127914,"_3038":127915},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3569":74857,"_31013":74843,"_5":31368,"_21476":127917,"_28165":127918,"_3038":127919},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3569":74858,"_31013":74843,"_5":31368,"_21476":127921,"_28165":127922,"_3038":127923},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3569":74859,"_31013":74843,"_5":31368,"_21476":127925,"_28165":127926,"_3038":127927},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3569":74860,"_31013":74843,"_5":31368,"_21476":127929,"_28165":127930,"_3038":127931},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3569":74861,"_31013":74843,"_5":31368,"_21476":127933,"_28165":127934,"_3038":127935},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3569":74862,"_31013":74843,"_5":31368,"_21476":127937,"_28165":127938,"_3038":127939},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3569":74863,"_31013":74843,"_5":31368,"_21476":127941,"_28165":127942,"_3038":127943},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3569":74864,"_31013":74843,"_5":31368,"_21476":127945,"_28165":127946,"_3038":127947},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3569":74865,"_31013":74843,"_5":31368,"_21476":127949,"_28165":127950,"_3038":127951},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3569":74866,"_31013":74843,"_5":31368,"_21476":127953,"_28165":127954,"_3038":127955},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3569":74867,"_31013":74843,"_5":31368,"_21476":127957,"_28165":127958,"_3038":127959},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3569":74868,"_31013":74843,"_5":31368,"_21476":127961,"_28165":127962,"_3038":127963},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3569":74869,"_31013":74843,"_5":31368,"_21476":127965,"_28165":127966,"_3038":127967},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3569":74870,"_31013":74843,"_5":31368,"_21476":127969,"_28165":127970,"_3038":127971},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3569":74871,"_31013":74843,"_5":31368,"_21476":127973,"_28165":127974,"_3038":127975},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3569":74872,"_31013":74843,"_5":31368,"_21476":127977,"_28165":127978,"_3038":127979},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3569":74873,"_31013":74843,"_5":31368,"_21476":127981,"_28165":127982,"_3038":127983},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3569":74874,"_31013":74843,"_5":31368,"_21476":127985,"_28165":127986,"_3038":127987},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3569":74875,"_31013":74843,"_5":31368,"_21476":127989,"_28165":127990,"_3038":127991},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3569":74876,"_31013":74843,"_5":31368,"_21476":127993,"_28165":127994,"_3038":127995},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3569":74877,"_31013":74843,"_5":31368,"_21476":127997,"_28165":127998,"_3038":127999},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3569":74878,"_31013":74843,"_5":31368,"_21476":128001,"_28165":128002,"_3038":128003},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3569":74879,"_31013":74843,"_5":31368,"_21476":128005,"_28165":128006,"_3038":128007},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3569":74880,"_31013":74843,"_5":31368,"_21476":128009,"_28165":128010,"_3038":128011},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3569":74881,"_31013":74843,"_5":31368,"_21476":128013,"_28165":128014,"_3038":128015},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3569":74882,"_31013":74843,"_5":31368,"_21476":128017,"_28165":128018,"_3038":128019},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3569":74883,"_31013":74843,"_5":31368,"_21476":128021,"_28165":128022,"_3038":128023},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3569":74884,"_31013":74843,"_5":31368,"_21476":128025,"_28165":128026,"_3038":128027},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3569":74885,"_31013":74843,"_5":31368,"_21476":128029,"_28165":128030,"_3038":123572},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3569":74886,"_31013":74843,"_5":31368,"_21476":128032,"_28165":128033,"_3038":128034},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3569":74887,"_31013":74843,"_5":31368,"_21476":128036,"_28165":128037,"_3038":128038},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3569":74888,"_31013":74843,"_21476":128040,"_5":14750,"_28165":74843,"_3038":128041},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3569":74889,"_31013":74843,"_21476":128043,"_5":14750,"_28165":74843,"_3038":128044},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3569":74890,"_31013":74843,"_21476":128046,"_5":14750,"_28165":74843,"_3038":128047},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3569":74891,"_31013":74843,"_21476":128049,"_5":14750,"_28165":74843,"_3038":128050},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3569":74892,"_31013":74843,"_21476":128052,"_5":14750,"_28165":74843,"_3038":128053},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3569":74893,"_31013":74843,"_21476":128055,"_5":14750,"_28165":74843,"_3038":128056},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3569":74894,"_31013":74843,"_21476":128058,"_5":14750,"_28165":74843,"_3038":128059},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3569":74895,"_31013":74843,"_21476":128061,"_5":14750,"_28165":127875,"_3038":128062},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3569":74896,"_31013":74843,"_21476":128064,"_5":14750,"_28165":127875,"_3038":128065},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3569":74897,"_31013":74843,"_21476":128067,"_5":14750,"_28165":127879,"_3038":128068},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3569":74898,"_31013":74843,"_21476":128070,"_5":14750,"_28165":127879,"_3038":128071},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3569":74899,"_31013":74843,"_21476":128073,"_5":14750,"_28165":127883,"_3038":128074},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3569":74900,"_31013":74843,"_21476":128076,"_5":14750,"_28165":127887,"_3038":128077},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3569":74901,"_31013":74843,"_21476":128079,"_5":14750,"_28165":127887,"_3038":128080},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3569":74902,"_31013":74843,"_21476":128082,"_5":14750,"_28165":127887,"_3038":128083},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3569":74903,"_31013":74843,"_21476":128085,"_5":14750,"_28165":127887,"_3038":128086},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3569":74904,"_31013":74843,"_21476":128088,"_5":14750,"_28165":127887,"_3038":128089},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3569":74905,"_31013":74843,"_21476":128091,"_5":14750,"_28165":127891,"_3038":128092},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3569":74906,"_31013":74843,"_21476":128094,"_5":14750,"_28165":127891,"_3038":128095},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3569":74907,"_31013":74843,"_21476":128097,"_5":14750,"_28165":127891,"_3038":128098},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3569":74908,"_31013":74843,"_21476":128100,"_5":14750,"_28165":127891,"_3038":128101},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3569":74909,"_31013":74843,"_21476":128103,"_5":14750,"_28165":127891,"_3038":128104},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3569":74910,"_31013":74843,"_21476":128106,"_5":14750,"_28165":127891,"_3038":128107},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3569":74911,"_31013":74843,"_21476":128109,"_5":14750,"_28165":127895,"_3038":128110},[],"Cambio",{"_3569":74912,"_31013":74843,"_21476":128112,"_5":14750,"_28165":127895,"_3038":128113},[],"A quién afecta",{"_3569":74913,"_31013":74843,"_21476":128115,"_5":14750,"_28165":127895,"_3038":128116},[],"Gravedad",{"_3569":74914,"_31013":74843,"_21476":128118,"_5":14750,"_28165":127895,"_3038":126518},[],{"_3569":74915,"_31013":74843,"_21476":128120,"_5":14750,"_28165":127895,"_3038":127903},[],{"_3569":74916,"_31013":74843,"_21476":128122,"_5":14750,"_28165":127895,"_3038":128123},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3569":74917,"_31013":74843,"_21476":128125,"_5":14750,"_28165":127895,"_3038":128126},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3569":74918,"_31013":74843,"_21476":128128,"_5":14750,"_28165":127895,"_3038":128129},[],"Copiar los datos a los volúmenes nuevos",{"_3569":74919,"_31013":74843,"_21476":128131,"_5":14750,"_28165":127895,"_3038":127907},[],{"_3569":74920,"_31013":74843,"_21476":128133,"_5":14750,"_28165":127895,"_3038":128134},[],"Todas las releases de Helm",{"_3569":74921,"_31013":74843,"_21476":128136,"_5":14750,"_28165":127895,"_3038":128137},[],"Alta: `helm upgrade` falla",{"_3569":74922,"_31013":74843,"_21476":128139,"_5":14750,"_28165":127895,"_3038":128140},[],"Eliminar o renombrar las claves heredadas",{"_3569":74923,"_31013":74843,"_21476":128142,"_5":14750,"_28165":127895,"_3038":127911},[],{"_3569":74924,"_31013":74843,"_21476":128144,"_5":14750,"_28165":127895,"_3038":128145},[],"Todos los despliegues",{"_3569":74925,"_31013":74843,"_21476":128147,"_5":14750,"_28165":127895,"_3038":128148},[],"Alta: sin principal de bootstrap no hay administrador",{"_3569":74926,"_31013":74843,"_21476":128150,"_5":14750,"_28165":127895,"_3038":128151},[],"Configurar `services.authz`",{"_3569":74927,"_31013":74843,"_21476":128153,"_5":14750,"_28165":127895,"_3038":127915},[],{"_3569":74928,"_31013":74843,"_21476":128155,"_5":14750,"_28165":127895,"_3038":128134},[],{"_3569":74929,"_31013":74843,"_21476":128157,"_5":14750,"_28165":127895,"_3038":128158},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3569":74930,"_31013":74843,"_21476":128160,"_5":14750,"_28165":127895,"_3038":128161},[],"Mover JWKS y roles a `services.authz`",{"_3569":74931,"_31013":74843,"_21476":128163,"_5":14750,"_28165":127895,"_3038":127935},[],{"_3569":74932,"_31013":74843,"_21476":128165,"_5":14750,"_28165":127895,"_3038":128166},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3569":74933,"_31013":74843,"_21476":128168,"_5":14750,"_28165":127895,"_3038":128169},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3569":74934,"_31013":74843,"_21476":128171,"_5":14750,"_28165":127895,"_3038":128172},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3569":74935,"_31013":74843,"_21476":128174,"_5":14750,"_28165":127895,"_3038":127939},[],{"_3569":74936,"_31013":74843,"_21476":128176,"_5":14750,"_28165":127895,"_3038":128177},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3569":74937,"_31013":74843,"_21476":128179,"_5":14750,"_28165":127895,"_3038":128180},[],"Alta: el backend ya no arranca con ellos",{"_3569":74938,"_31013":74843,"_21476":128182,"_5":14750,"_28165":127895,"_3038":128183},[],"Pasar a PostgreSQL antes de actualizar",{"_3569":74939,"_31013":74843,"_21476":128185,"_5":14750,"_28165":127895,"_3038":127983},[],{"_3569":74940,"_31013":74843,"_21476":128187,"_5":14750,"_28165":127895,"_3038":128188},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3569":74941,"_31013":74843,"_21476":128190,"_5":14750,"_28165":127895,"_3038":128191},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3569":74942,"_31013":74843,"_21476":128193,"_5":14750,"_28165":127895,"_3038":128194},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3569":74943,"_31013":74843,"_21476":128196,"_5":14750,"_28165":127895,"_3038":128197},[],"Webhooks con referencias a archivos",{"_3569":74944,"_31013":74843,"_21476":128199,"_5":14750,"_28165":127895,"_3038":128200},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3569":74945,"_31013":74843,"_21476":128202,"_5":14750,"_28165":127895,"_3038":128203},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3569":74946,"_31013":74843,"_21476":128205,"_5":14750,"_28165":127895,"_3038":128206},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3569":74947,"_31013":74843,"_21476":128208,"_5":14750,"_28165":127895,"_3038":127919},[],{"_3569":74948,"_31013":74843,"_21476":128210,"_5":14750,"_28165":127895,"_3038":128211},[],"Releases con identidades por servicio o material de claves montado",{"_3569":74949,"_31013":74843,"_21476":128213,"_5":14750,"_28165":127895,"_3038":128214},[],"Media: los servicios no pueden leer sus archivos",{"_3569":74950,"_31013":74843,"_21476":128216,"_5":14750,"_28165":127895,"_3038":128217},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3569":74951,"_31013":74843,"_21476":128219,"_5":14750,"_28165":127895,"_3038":127923},[],{"_3569":74952,"_31013":74843,"_21476":128221,"_5":14750,"_28165":127895,"_3038":128222},[],"Releases que definen `amqp.tls`",{"_3569":74953,"_31013":74843,"_21476":128224,"_5":14750,"_28165":127895,"_3038":128225},[],"Media: los clientes se conectan al puerto equivocado",{"_3569":74954,"_31013":74843,"_21476":128227,"_5":14750,"_28165":127895,"_3038":128228},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3569":74955,"_31013":74843,"_21476":128230,"_5":14750,"_28165":127895,"_3038":127943},[],{"_3569":74956,"_31013":74843,"_21476":128232,"_5":14750,"_28165":127895,"_3038":128233},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3569":74957,"_31013":74843,"_21476":128235,"_5":14750,"_28165":127895,"_3038":128236},[],"Media: las claves de CA quedan sin gestionar",{"_3569":74958,"_31013":74843,"_21476":128238,"_5":14750,"_28165":127895,"_3038":128239},[],"Ejecutar la migración de CA a KMS",{"_3569":74959,"_31013":74843,"_21476":128241,"_5":14750,"_28165":127895,"_3038":128242},[],"Verificación del certificado del receptor",{"_3569":74960,"_31013":74843,"_21476":128244,"_5":14750,"_28165":127895,"_3038":128245},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3569":74961,"_31013":74843,"_21476":128247,"_5":14750,"_28165":127895,"_3038":128248},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3569":74962,"_31013":74843,"_21476":128250,"_5":14750,"_28165":127895,"_3038":128251},[],"Poner `insecure_skip_verify` a `false`",{"_3569":74963,"_31013":74843,"_21476":128253,"_5":14750,"_28165":127895,"_3038":127959},[],{"_3569":74964,"_31013":74843,"_21476":128255,"_5":14750,"_28165":127895,"_3038":128256},[],"Scripts y consolas que editan DMS por API",{"_3569":74965,"_31013":74843,"_21476":128258,"_5":14750,"_28165":127895,"_3038":128259},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3569":74966,"_31013":74843,"_21476":128261,"_5":14750,"_28165":127895,"_3038":128262},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3569":74967,"_31013":74843,"_21476":128264,"_5":14750,"_28165":127895,"_3038":127979},[],{"_3569":74968,"_31013":74843,"_21476":128266,"_5":14750,"_28165":127895,"_3038":128267},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3569":74969,"_31013":74843,"_21476":128269,"_5":14750,"_28165":127895,"_3038":128270},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3569":74970,"_31013":74843,"_21476":128272,"_5":14750,"_28165":127895,"_3038":128273},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3569":74971,"_31013":74843,"_21476":128275,"_5":14750,"_28165":127895,"_3038":127987},[],{"_3569":74972,"_31013":74843,"_21476":128277,"_5":14750,"_28165":127895,"_3038":128278},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3569":74973,"_31013":74843,"_21476":128280,"_5":14750,"_28165":127895,"_3038":128281},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3569":74974,"_31013":74843,"_21476":128283,"_5":14750,"_28165":127895,"_3038":128284},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3569":74975,"_31013":74843,"_21476":128286,"_5":14750,"_28165":127895,"_3038":127975},[],{"_3569":74976,"_31013":74843,"_21476":128288,"_5":14750,"_28165":127895,"_3038":128289},[],"Consumidores que leen el campo `events` del dispositivo",{"_3569":74977,"_31013":74843,"_21476":128291,"_5":14750,"_28165":127895,"_3038":128292},[],"Media: el campo desaparece",{"_3569":74978,"_31013":74843,"_21476":128294,"_5":14750,"_28165":127895,"_3038":128295},[],"Usar los nuevos endpoints de eventos",{"_3569":74979,"_31013":74843,"_21476":128297,"_5":14750,"_28165":127895,"_3038":127995},[],{"_3569":74980,"_31013":74843,"_21476":128299,"_5":14750,"_28165":127895,"_3038":128300},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3569":74981,"_31013":74843,"_21476":128302,"_5":14750,"_28165":127895,"_3038":128303},[],"Media: la migración de la VA aborta",{"_3569":74982,"_31013":74843,"_21476":128305,"_5":14750,"_28165":127895,"_3038":128306},[],"Corregir los roles afectados antes de actualizar",{"_3569":74983,"_31013":74843,"_21476":128308,"_5":14750,"_28165":127895,"_3038":127927},[],{"_3569":74984,"_31013":74843,"_21476":128310,"_5":14750,"_28165":127895,"_3038":128311},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3569":74985,"_31013":74843,"_21476":128313,"_5":14750,"_28165":127895,"_3038":128314},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3569":74986,"_31013":74843,"_21476":128316,"_5":14750,"_28165":127895,"_3038":128317},[],"Actualizar el archivo de values",{"_3569":74987,"_31013":74843,"_21476":128319,"_5":14750,"_28165":127895,"_3038":127967},[],{"_3569":74988,"_31013":74843,"_21476":128321,"_5":14750,"_28165":127895,"_3038":128322},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3569":74989,"_31013":74843,"_21476":128324,"_5":14750,"_28165":127895,"_3038":128325},[],"Baja: prevalece el ID de la URL",{"_3569":74990,"_31013":74843,"_21476":128327,"_5":14750,"_28165":127895,"_3038":128328},[],"Enviar el ID en la URL",{"_3569":74991,"_31013":74843,"_21476":128330,"_5":14750,"_28165":127895,"_3038":127991},[],{"_3569":74992,"_31013":74843,"_21476":128332,"_5":14750,"_28165":127895,"_3038":128333},[],"Clientes que envían un `id` al crear o importar CAs",{"_3569":74993,"_31013":74843,"_21476":128335,"_5":14750,"_28165":127895,"_3038":128336},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3569":74994,"_31013":74843,"_21476":128338,"_5":14750,"_28165":127895,"_3038":128339},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3569":74995,"_31013":74843,"_21476":128341,"_5":14750,"_28165":127895,"_3038":127971},[],{"_3569":74996,"_31013":74843,"_21476":128343,"_5":14750,"_28165":127895,"_3038":128344},[],"Consumidores que comparan el `type` del certificado",{"_3569":74997,"_31013":74843,"_21476":128346,"_5":14750,"_28165":127895,"_3038":128347},[],"Baja: dos valores cambian de nombre",{"_3569":74998,"_31013":74843,"_21476":128349,"_5":14750,"_28165":127895,"_3038":128350},[],"Adaptar los consumidores",{"_3569":74999,"_31013":74843,"_21476":128352,"_5":14750,"_28165":127895,"_3038":127963},[],{"_3569":75000,"_31013":74843,"_21476":128354,"_5":14750,"_28165":127895,"_3038":128355},[],"Cualquier DMS",{"_3569":75001,"_31013":74843,"_21476":128357,"_5":14750,"_28165":127895,"_3038":128358},[],"Baja: solo informativo",{"_3569":75002,"_31013":74843,"_21476":128360,"_5":14750,"_28165":127895,"_3038":128361},[],"Revisar ambos bloques antes de editar",{"_3569":75003,"_31013":74843,"_21476":128363,"_5":14750,"_28165":127902,"_3038":128364},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3569":75004,"_31013":74843,"_21476":128366,"_5":14750,"_28165":127902,"_3038":128367},[],"El paso 4 de la guía de migración copia los datos.",{"_3569":75005,"_31013":74843,"_21476":128369,"_5":14750,"_28165":127906,"_3038":128370},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3569":75006,"_31013":74843,"_21476":128372,"_5":14750,"_28165":127910,"_3038":128373},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3569":75007,"_31013":74843,"_21476":128375,"_5":14750,"_28165":127914,"_3038":128376},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3569":75008,"_31013":74843,"_21476":128378,"_5":14750,"_28165":127918,"_3038":128379},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3569":75009,"_31013":74843,"_21476":128381,"_5":14750,"_28165":127918,"_3038":128382},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3569":75010,"_31013":74843,"_21476":128384,"_5":14750,"_28165":127922,"_3038":128385},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3569":75011,"_31013":74843,"_21476":128387,"_5":14750,"_28165":127926,"_3038":128388},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3569":75012,"_31013":74843,"_21476":128390,"_5":14750,"_28165":127926,"_3038":128391},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3569":75013,"_31013":74843,"_21476":128393,"_5":14750,"_28165":127926,"_3038":128394},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3569":75014,"_31013":74843,"_21476":128396,"_5":14750,"_28165":127926,"_3038":128397},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3569":75015,"_31013":74843,"_21476":128399,"_5":14750,"_28165":127926,"_3038":128400},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3569":75016,"_31013":74843,"_21476":128402,"_5":14750,"_28165":127926,"_3038":128403},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3569":75017,"_31013":74843,"_21476":128405,"_5":14750,"_28165":127934,"_3038":128406},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3569":75018,"_31013":74843,"_21476":128408,"_5":14750,"_28165":127934,"_3038":128409},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3569":75019,"_31013":74843,"_21476":128411,"_5":14750,"_28165":127934,"_3038":128412},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3569":75020,"_31013":74843,"_21476":128414,"_5":14750,"_28165":127934,"_3038":128415},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3569":75021,"_31013":74843,"_21476":128417,"_5":14750,"_28165":127934,"_3038":128418},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3569":75022,"_31013":74843,"_21476":128420,"_5":14750,"_28165":127938,"_3038":128421},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3569":75023,"_31013":74843,"_21476":128423,"_5":14750,"_28165":127942,"_3038":128424},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3569":75024,"_31013":74843,"_21476":128426,"_5":14750,"_28165":127942,"_3038":128427},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3569":75025,"_31013":74843,"_21476":128429,"_5":14750,"_28165":127942,"_3038":128430},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3569":75026,"_31013":74843,"_21476":128432,"_5":14750,"_28165":127942,"_3038":128433},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3569":75027,"_31013":74843,"_21476":128435,"_5":14750,"_28165":127942,"_3038":128436},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3569":75028,"_31013":74843,"_21476":128438,"_5":14750,"_28165":127942,"_3038":128439},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3569":75029,"_31013":74843,"_21476":128441,"_5":14750,"_28165":127942,"_3038":128442},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3569":75030,"_31013":74843,"_21476":128444,"_5":14750,"_28165":127942,"_3038":128445},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3569":75031,"_31013":74843,"_21476":128447,"_5":14750,"_28165":127946,"_3038":128448},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3569":75032,"_31013":74843,"_21476":128450,"_5":14750,"_28165":127954,"_3038":128451},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3569":75033,"_31013":74843,"_21476":128453,"_5":14750,"_28165":127954,"_3038":128454},[],"Campo en 3.8.0",{"_3569":75034,"_31013":74843,"_21476":128456,"_5":14750,"_28165":127954,"_3038":128457},[],"Campo en 4.0.0",{"_3569":75035,"_31013":74843,"_21476":128459,"_5":14750,"_28165":127954,"_3038":59666},[],{"_3569":75036,"_31013":74843,"_21476":128461,"_5":14750,"_28165":127954,"_3038":128462},[],"`insecure_skip_verify` (con el valor negado)",{"_3569":75037,"_31013":74843,"_21476":128464,"_5":14750,"_28165":127954,"_3038":59672},[],{"_3569":75038,"_31013":74843,"_21476":128466,"_5":14750,"_28165":127954,"_3038":59675},[],{"_3569":75039,"_31013":74843,"_21476":128468,"_5":14750,"_28165":127954,"_3038":59678},[],{"_3569":75040,"_31013":74843,"_21476":128470,"_5":14750,"_28165":127954,"_3038":59681},[],{"_3569":75041,"_31013":74843,"_21476":128472,"_5":14750,"_28165":127954,"_3038":59684},[],{"_3569":75042,"_31013":74843,"_21476":128474,"_5":14750,"_28165":127954,"_3038":59687},[],{"_3569":75043,"_31013":74843,"_21476":128476,"_5":14750,"_28165":127954,"_3038":128477},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3569":75044,"_31013":74843,"_21476":128479,"_5":14750,"_28165":127954,"_3038":128480},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3569":75045,"_31013":74843,"_21476":128482,"_5":14750,"_28165":127954,"_3038":128483},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3569":75046,"_31013":74843,"_21476":128485,"_5":14750,"_28165":127958,"_3038":128486},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3569":75047,"_31013":74843,"_21476":128488,"_5":14750,"_28165":127958,"_3038":128489},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3569":75048,"_31013":74843,"_21476":128491,"_5":14750,"_28165":127958,"_3038":128492},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3569":75049,"_31013":74843,"_21476":128494,"_5":14750,"_28165":127962,"_3038":128495},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3569":75050,"_31013":74843,"_21476":128497,"_5":14750,"_28165":127966,"_3038":128498},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3569":75051,"_31013":74843,"_21476":128500,"_5":14750,"_28165":127970,"_3038":128501},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3569":75052,"_31013":74843,"_21476":128503,"_5":14750,"_28165":127974,"_3038":128504},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3569":75053,"_31013":74843,"_21476":128506,"_5":14750,"_28165":127974,"_3038":128507},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3569":75054,"_31013":74843,"_21476":128509,"_5":14750,"_28165":127974,"_3038":128510},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3569":75055,"_31013":74843,"_21476":128512,"_5":14750,"_28165":127974,"_3038":128513},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3569":75056,"_31013":74843,"_21476":128515,"_5":14750,"_28165":127978,"_3038":128516},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3569":75057,"_31013":74843,"_21476":128518,"_5":14750,"_28165":127982,"_3038":128519},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3569":75058,"_31013":74843,"_21476":128521,"_5":14750,"_28165":127982,"_3038":128522},[],"Ruta",{"_3569":75059,"_31013":74843,"_21476":128524,"_5":14750,"_28165":127982,"_3038":120808},[],{"_3569":75060,"_31013":74843,"_21476":128526,"_5":14750,"_28165":127982,"_3038":59740},[],{"_3569":75061,"_31013":74843,"_21476":128528,"_5":14750,"_28165":127982,"_3038":128529},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3569":75062,"_31013":74843,"_21476":128531,"_5":14750,"_28165":127982,"_3038":59746},[],{"_3569":75063,"_31013":74843,"_21476":128533,"_5":14750,"_28165":127982,"_3038":128534},[],"Lee los ajustes de una CA.",{"_3569":75064,"_31013":74843,"_21476":128536,"_5":14750,"_28165":127982,"_3038":59752},[],{"_3569":75065,"_31013":74843,"_21476":128538,"_5":14750,"_28165":127982,"_3038":128539},[],"Sustituye los `crl_options`.",{"_3569":75066,"_31013":74843,"_21476":128541,"_5":14750,"_28165":127982,"_3038":128542},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3569":75067,"_31013":74843,"_21476":128544,"_5":14750,"_28165":127982,"_3038":128545},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3569":75068,"_31013":74843,"_21476":128547,"_5":14750,"_28165":127982,"_3038":128548},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3569":75069,"_31013":74843,"_21476":128550,"_5":14750,"_28165":127982,"_3038":128551},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3569":75070,"_31013":74843,"_21476":128553,"_5":14750,"_28165":127982,"_3038":128554},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3569":75071,"_31013":74843,"_21476":128556,"_5":14750,"_28165":127982,"_3038":128557},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3569":75072,"_31013":74843,"_21476":128559,"_5":14750,"_28165":127982,"_3038":128560},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3569":75073,"_31013":74843,"_21476":128562,"_5":14750,"_28165":127982,"_3038":128563},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3569":75074,"_31013":74843,"_21476":128565,"_5":14750,"_28165":127982,"_3038":128566},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3569":75075,"_31013":74843,"_21476":128568,"_5":14750,"_28165":127982,"_3038":128569},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3569":75076,"_31013":74843,"_21476":128571,"_5":14750,"_28165":127982,"_3038":128572},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3569":75077,"_31013":74843,"_21476":128574,"_5":14750,"_28165":127986,"_3038":128575},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3569":75078,"_31013":74843,"_21476":128577,"_5":14750,"_28165":127990,"_3038":128578},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3569":75079,"_31013":74843,"_21476":128580,"_5":14750,"_28165":127994,"_3038":128581},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3569":75080,"_31013":74843,"_21476":128583,"_5":14750,"_28165":127998,"_3038":128584},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3569":75081,"_31013":74843,"_21476":128586,"_5":14750,"_28165":128002,"_3038":128587},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3569":75082,"_31013":74843,"_21476":128589,"_5":14750,"_28165":128002,"_3038":128590},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3569":75083,"_31013":74843,"_21476":128592,"_5":14750,"_28165":128002,"_3038":128593},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3569":75084,"_31013":74843,"_21476":128595,"_5":14750,"_28165":128002,"_3038":128596},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3569":75085,"_31013":74843,"_21476":128598,"_5":14750,"_28165":128002,"_3038":128599},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3569":75086,"_31013":74843,"_21476":128601,"_5":14750,"_28165":128002,"_3038":128602},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3569":75087,"_31013":74843,"_21476":128604,"_5":14750,"_28165":128006,"_3038":128605},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3569":75088,"_31013":74843,"_21476":128607,"_5":14750,"_28165":128006,"_3038":128608},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3569":75089,"_31013":74843,"_21476":128610,"_5":14750,"_28165":128006,"_3038":128611},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3569":75090,"_31013":74843,"_21476":128613,"_5":14750,"_28165":128006,"_3038":128614},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3569":75091,"_31013":74843,"_21476":128616,"_5":14750,"_28165":128006,"_3038":128617},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3569":75092,"_31013":74843,"_21476":128619,"_5":14750,"_28165":128010,"_3038":128620},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3569":75093,"_31013":74843,"_21476":128622,"_5":14750,"_28165":128010,"_3038":128623},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3569":75094,"_31013":74843,"_21476":128625,"_5":14750,"_28165":128010,"_3038":128626},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3569":75095,"_31013":74843,"_21476":128628,"_5":14750,"_28165":128010,"_3038":128629},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3569":75096,"_31013":74843,"_21476":128631,"_5":14750,"_28165":128010,"_3038":128632},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3569":75097,"_31013":74843,"_21476":128634,"_5":14750,"_28165":128010,"_3038":128635},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3569":75098,"_31013":74843,"_21476":128637,"_5":14750,"_28165":128010,"_3038":128638},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3569":75099,"_31013":74843,"_21476":128640,"_5":14750,"_28165":128010,"_3038":128641},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3569":75100,"_31013":74843,"_21476":128643,"_5":14750,"_28165":128010,"_3038":128644},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3569":75101,"_31013":74843,"_21476":128646,"_5":14750,"_28165":128010,"_3038":128647},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3569":75102,"_31013":74843,"_21476":128649,"_5":14750,"_28165":128010,"_3038":128650},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3569":75103,"_31013":74843,"_21476":128652,"_5":14750,"_28165":128010,"_3038":128653},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3569":75104,"_31013":74843,"_21476":128655,"_5":14750,"_28165":128014,"_3038":128656},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3569":75105,"_31013":74843,"_21476":128658,"_5":14750,"_28165":128014,"_3038":128659},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3569":75106,"_31013":74843,"_21476":128661,"_5":14750,"_28165":128018,"_3038":128662},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3569":75107,"_31013":74843,"_21476":128664,"_5":14750,"_28165":128018,"_3038":128665},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3569":75108,"_31013":74843,"_21476":128667,"_5":14750,"_28165":128018,"_3038":128668},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3569":75109,"_31013":74843,"_21476":128670,"_5":14750,"_28165":128018,"_3038":128671},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3569":75110,"_31013":74843,"_21476":128673,"_5":14750,"_28165":128018,"_3038":128674},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3569":75111,"_31013":74843,"_21476":128676,"_5":14750,"_28165":128018,"_3038":128677},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3569":75112,"_31013":74843,"_21476":128679,"_5":14750,"_28165":128018,"_3038":128680},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3569":75113,"_31013":74843,"_21476":128682,"_5":14750,"_28165":128018,"_3038":128683},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3569":75114,"_31013":74843,"_21476":128685,"_5":14750,"_28165":128018,"_3038":128686},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3569":75115,"_31013":74843,"_21476":128688,"_5":14750,"_28165":128018,"_3038":128689},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3569":75116,"_31013":74843,"_21476":128691,"_5":14750,"_28165":128018,"_3038":128692},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3569":75117,"_31013":74843,"_21476":128694,"_5":14750,"_28165":128022,"_3038":128695},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3569":75118,"_31013":74843,"_21476":128697,"_5":14750,"_28165":128022,"_3038":128698},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3569":75119,"_31013":74843,"_21476":128700,"_5":14750,"_28165":128026,"_3038":128701},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3569":75120,"_31013":74843,"_21476":128703,"_5":14750,"_28165":128026,"_3038":128704},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3569":75121,"_31013":74843,"_21476":128706,"_5":14750,"_28165":128026,"_3038":128707},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3569":75122,"_31013":74843,"_21476":128709,"_5":14750,"_28165":128026,"_3038":128710},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3569":75123,"_31013":74843,"_21476":128712,"_5":14750,"_28165":128026,"_3038":128713},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3569":75124,"_31013":74843,"_21476":128715,"_5":14750,"_28165":128026,"_3038":128716},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3569":75125,"_31013":74843,"_21476":128718,"_5":14750,"_28165":128026,"_3038":128719},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3569":75126,"_31013":74843,"_21476":128721,"_5":14750,"_28165":128026,"_3038":128722},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3569":75127,"_31013":74843,"_21476":128724,"_5":14750,"_28165":128030,"_3038":128725},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3569":75128,"_31013":74843,"_21476":128727,"_5":14750,"_28165":128030,"_3038":128728},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3569":75129,"_31013":74843,"_21476":128730,"_5":14750,"_28165":128030,"_3038":128731},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3569":75130,"_31013":74843,"_21476":128733,"_5":14750,"_28165":128030,"_3038":128734},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3569":75131,"_31013":74843,"_21476":128736,"_5":14750,"_28165":128030,"_3038":128737},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3569":75132,"_31013":74843,"_21476":128739,"_5":14750,"_28165":128030,"_3038":128740},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3569":75133,"_31013":74843,"_21476":128742,"_5":14750,"_28165":128030,"_3038":128743},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3569":75134,"_31013":74843,"_21476":128745,"_5":14750,"_28165":128030,"_3038":128746},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3569":75135,"_31013":74843,"_21476":128748,"_5":14750,"_28165":128030,"_3038":128749},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3569":75136,"_31013":74843,"_21476":128751,"_5":14750,"_28165":128030,"_3038":128752},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3569":75137,"_31013":74843,"_21476":128754,"_5":14750,"_28165":128030,"_3038":128755},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3569":75138,"_31013":74843,"_21476":128757,"_5":14750,"_28165":128033,"_3038":128758},[],"Tras la actualización, comprueba en este orden:",{"_3569":75139,"_31013":74843,"_21476":128760,"_5":14750,"_28165":128033,"_3038":128761},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3569":75140,"_31013":74843,"_21476":128763,"_5":14750,"_28165":128033,"_3038":128764},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3569":75141,"_31013":74843,"_21476":128766,"_5":14750,"_28165":128033,"_3038":128767},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3569":75142,"_31013":74843,"_21476":128769,"_5":14750,"_28165":128033,"_3038":128770},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3569":75143,"_31013":74843,"_21476":128772,"_5":14750,"_28165":128033,"_3038":128773},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3569":75144,"_31013":74843,"_21476":128775,"_5":14750,"_28165":128033,"_3038":128776},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3569":75145,"_31013":74843,"_21476":128778,"_5":14750,"_28165":128033,"_3038":128779},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3569":75146,"_31013":74843,"_21476":128781,"_5":14750,"_28165":128033,"_3038":128782},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3569":75147,"_31013":74843,"_21476":128784,"_5":14750,"_28165":128033,"_3038":128785},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3569":75148,"_31013":74843,"_21476":128787,"_5":14750,"_28165":128033,"_3038":128788},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3569":75149,"_31013":74843,"_21476":128790,"_5":14750,"_28165":128033,"_3038":128791},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3569":75150,"_31013":74843,"_21476":128793,"_5":14750,"_28165":128033,"_3038":128794},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3569":75151,"_31013":74843,"_21476":128796,"_5":14750,"_28165":128033,"_3038":128797},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3569":75152,"_31013":74843,"_21476":128799,"_5":14750,"_28165":128033,"_3038":128800},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3569":75153,"_31013":74843,"_21476":128802,"_5":14750,"_28165":128033,"_3038":128803},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3569":75154,"_31013":74843,"_21476":128805,"_5":14750,"_28165":128037,"_3038":128806},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3569":75155,"_31013":74843,"_21476":128808,"_5":14750,"_28165":128037,"_3038":128809},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3569":75156,"_31013":74843,"_21476":128811,"_5":14750,"_28165":128037,"_3038":128812},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3569":75157,"_31013":74843,"_21476":128814,"_5":14750,"_28165":128037,"_3038":128815},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3569":75158,"_31013":74843,"_21476":128817,"_5":14750,"_28165":128037,"_3038":128818},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60037":128820,"_60039":128821,"_60041":128822,"_60043":128823,"_18631":3073,"_72134":3073},"spanish",[3038,31013,5,28165],{"_3038":25708,"_31013":25708,"_5":25708,"_28165":25708},{"_3038":128824,"_31013":131845,"_5":134866,"_28165":137887},{"_4792":128825,"_60047":128826,"_5":25708},{"_3663":4756,"_15220":9885,"_15239":14064,"_3650":6235,"_15226":6164,"_20398":4307,"_14851":6212,"_14858":3464,"_29955":4099,"_30368":6558,"_30388":4796,"_29989":7250,"_35451":5737,"_30096":26922,"_30432":10150,"_35458":6758,"_35461":7140,"_35464":6640,"_35467":3340,"_30839":7833,"_35472":4870,"_35474":3361,"_30869":6844,"_15235":3389,"_35478":7732,"_35481":3527,"_35483":8595,"_30416":4907,"_30834":4027,"_30882":3125,"_35488":11277,"_35490":4478,"_35492":10433,"_30113":6507,"_35495":13801,"_35497":9020,"_35499":8786,"_35501":5348,"_35503":7831,"_30030":3643,"_35506":3532,"_3653":8296,"_30024":7245,"_30453":3513,"_35511":7415,"_35513":4244,"_35516":5128,"_30070":13727,"_35520":4537,"_29946":7163,"_35523":3260,"_29994":16494,"_35526":25227,"_35528":5329,"_35531":8826,"_15229":7795,"_35534":4514,"_35536":6506,"_35539":9586,"_35541":4757,"_31072":13353,"_35544":20194,"_35546":10649,"_20401":14707,"_35549":21122,"_35551":7770,"_29967":6227,"_30410":3558,"_35555":7281,"_35557":7621,"_35559":6201,"_30899":3455,"_35562":7167,"_35564":8806,"_35566":7794,"_30993":23329,"_30469":6438,"_35570":6705,"_35572":11621,"_30009":6056,"_35575":7771,"_35577":8062,"_35579":3492,"_30915":14675,"_30090":29536,"_29445":9755,"_35584":19381,"_35586":14788,"_35588":5151,"_30139":23363,"_35592":5029,"_30404":7177,"_35596":11921,"_35598":21978,"_35600":17725,"_35602":3377,"_35604":4795,"_35606":3766,"_30128":3499,"_3666":24013,"_35610":4142,"_35612":5224,"_35614":7824,"_35617":7202,"_35619"