30450,"_20891":115789,"_27386":115790,"_2933":115791},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3450":69835,"_30100":69832,"_5":30450,"_20891":115793,"_27386":115794,"_2933":115795},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3450":69836,"_30100":69832,"_5":30450,"_20891":115797,"_27386":115798,"_2933":115799},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3450":69837,"_30100":69832,"_5":30450,"_20891":115801,"_27386":115802,"_2933":115803},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3450":69838,"_30100":69832,"_5":30450,"_20891":115805,"_27386":115806,"_2933":115807},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3450":69839,"_30100":69832,"_5":30450,"_20891":115809,"_27386":115810,"_2933":115811},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3450":69840,"_30100":69832,"_5":30450,"_20891":115813,"_27386":115814,"_2933":115815},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3450":69841,"_30100":69832,"_20891":115817,"_5":14349,"_27386":69832,"_2933":115818},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3450":69842,"_30100":69832,"_20891":115820,"_5":14349,"_27386":115790,"_2933":115821},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3450":69843,"_30100":69832,"_20891":115823,"_5":14349,"_27386":115790,"_2933":115824},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3450":69844,"_30100":69832,"_20891":115826,"_5":14349,"_27386":115790,"_2933":115827},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3450":69845,"_30100":69832,"_20891":115829,"_5":14349,"_27386":115794,"_2933":115830},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3450":69846,"_30100":69832,"_20891":115832,"_5":14349,"_27386":115794,"_2933":115833},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3450":69847,"_30100":69832,"_20891":115835,"_5":14349,"_27386":115794,"_2933":115836},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3450":69848,"_30100":69832,"_20891":115838,"_5":14349,"_27386":115798,"_2933":115839},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3450":69849,"_30100":69832,"_20891":115841,"_5":14349,"_27386":115802,"_2933":115842},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3450":69850,"_30100":69832,"_20891":115844,"_5":14349,"_27386":115806,"_2933":115845},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3450":69851,"_30100":69832,"_20891":115847,"_5":14349,"_27386":115810,"_2933":115848},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3450":69852,"_30100":69832,"_20891":115850,"_5":14349,"_27386":115814,"_2933":115851},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3450":69853,"_30100":69853,"_5":14701,"_2933":115853,"_30453":115854,"_20891":115855,"_27386":69853},"Despliega Lamassu",[49052,115782],[],{"_3450":69854,"_30100":69853,"_20891":115857,"_5":14349,"_27386":69853,"_2933":115858},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3450":69855,"_30100":69853,"_5":30450,"_20891":115860,"_27386":115861,"_2933":115862},[],"/docs/pr-preview/pr-61/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3450":69856,"_30100":69853,"_5":30450,"_20891":115864,"_27386":115865,"_2933":115866},[],"/docs/pr-preview/pr-61/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3450":69857,"_30100":69853,"_5":30450,"_20891":115868,"_27386":115869,"_2933":115870},[],"/docs/pr-preview/pr-61/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3450":69858,"_30100":69853,"_20891":115872,"_5":14349,"_27386":69853,"_2933":115873},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3450":69859,"_30100":69853,"_20891":115875,"_5":14349,"_27386":115861,"_2933":115876},[],"Modelo",{"_3450":69860,"_30100":69853,"_20891":115878,"_5":14349,"_27386":115861,"_2933":115879},[],"Recomendado para",{"_3450":69861,"_30100":69853,"_20891":115881,"_5":14349,"_27386":115861,"_2933":115882},[],"Quién opera la infraestructura",{"_3450":69862,"_30100":69853,"_20891":115884,"_5":14349,"_27386":115861,"_2933":115885},[],"Punto de partida",{"_3450":69863,"_30100":69853,"_20891":115887,"_5":14349,"_27386":115861,"_2933":49159},[],{"_3450":69864,"_30100":69853,"_20891":115889,"_5":14349,"_27386":115861,"_2933":115890},[],"Producción, entornos regulados y despliegues personalizados",{"_3450":69865,"_30100":69853,"_20891":115892,"_5":14349,"_27386":115861,"_2933":115893},[],"Tu equipo",{"_3450":69866,"_30100":69853,"_20891":115895,"_5":14349,"_27386":115861,"_2933":115896},[],"Helm o Fastlane",{"_3450":69867,"_30100":69853,"_20891":115898,"_5":14349,"_27386":115861,"_2933":49171},[],{"_3450":69868,"_30100":69853,"_20891":115900,"_5":14349,"_27386":115861,"_2933":115901},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3450":69869,"_30100":69853,"_20891":115903,"_5":14349,"_27386":115861,"_2933":115893},[],{"_3450":69870,"_30100":69853,"_20891":115905,"_5":14349,"_27386":115861,"_2933":115906},[],"Imagen preconfigurada en EC2",{"_3450":69871,"_30100":69853,"_20891":115908,"_5":14349,"_27386":115861,"_2933":49182},[],{"_3450":69872,"_30100":69853,"_20891":115910,"_5":14349,"_27386":115861,"_2933":115911},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3450":69873,"_30100":69853,"_20891":115913,"_5":14349,"_27386":115861,"_2933":49188},[],{"_3450":69874,"_30100":69853,"_20891":115915,"_5":14349,"_27386":115861,"_2933":115916},[],"Suscripción gestionada",{"_3450":69875,"_30100":69853,"_20891":115918,"_5":14349,"_27386":115861,"_2933":115919},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3450":69876,"_30100":69853,"_20891":115921,"_5":14349,"_27386":115861,"_2933":115922},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3450":69877,"_30100":69853,"_20891":115924,"_5":14349,"_27386":115861,"_2933":115925},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3450":69878,"_30100":69853,"_20891":115927,"_5":14349,"_27386":115865,"_2933":115928},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3450":69879,"_30100":69853,"_20891":115930,"_5":14349,"_27386":115869,"_2933":115931},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3450":69880,"_30100":69880,"_5":14701,"_2933":115933,"_30453":115934,"_20891":115935,"_27386":69880},"Utiliza Lamassu como SaaS",[49052,115782,115783],[],{"_3450":69881,"_30100":69880,"_20891":115937,"_5":14349,"_27386":69880,"_2933":115938},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3450":69882,"_30100":69880,"_5":30450,"_20891":115940,"_27386":115941,"_2933":115942},[],"/docs/pr-preview/pr-61/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3450":69883,"_30100":69880,"_5":30450,"_20891":115944,"_27386":115945,"_2933":115946},[],"/docs/pr-preview/pr-61/es/deployment/saas#planes","Planes",{"_3450":69884,"_30100":69880,"_5":30450,"_20891":115948,"_27386":115949,"_2933":115950},[],"/docs/pr-preview/pr-61/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3450":69885,"_30100":69880,"_20891":115952,"_5":14349,"_27386":69880,"_2933":115953},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3450":69886,"_30100":69880,"_20891":115955,"_5":14349,"_27386":115941,"_2933":115956},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3450":69887,"_30100":69880,"_20891":115958,"_5":14349,"_27386":115941,"_2933":115959},[],"Copias de seguridad automáticas.",{"_3450":69888,"_30100":69880,"_20891":115961,"_5":14349,"_27386":115941,"_2933":115962},[],"Actualizaciones de versión.",{"_3450":69889,"_30100":69880,"_20891":115964,"_5":14349,"_27386":115941,"_2933":115965},[],"Soporte técnico y SLA según el plan contratado.",{"_3450":69890,"_30100":69880,"_20891":115967,"_5":14349,"_27386":115945,"_2933":49243},[],{"_3450":69891,"_30100":69880,"_20891":115969,"_5":14349,"_27386":115945,"_2933":115970},[],"Dispositivos",{"_3450":69892,"_30100":69880,"_20891":115972,"_5":14349,"_27386":115945,"_2933":115973},[],"Soporte",{"_3450":69893,"_30100":69880,"_20891":115975,"_5":14349,"_27386":115945,"_2933":49252},[],{"_3450":69894,"_30100":69880,"_20891":115977,"_5":14349,"_27386":115945,"_2933":49255},[],{"_3450":69895,"_30100":69880,"_20891":115979,"_5":14349,"_27386":115945,"_2933":115980},[],"Hasta 1.000",{"_3450":69896,"_30100":69880,"_20891":115982,"_5":14349,"_27386":115945,"_2933":49261},[],{"_3450":69897,"_30100":69880,"_20891":115984,"_5":14349,"_27386":115945,"_2933":115985},[],"99,5 %",{"_3450":69898,"_30100":69880,"_20891":115987,"_5":14349,"_27386":115945,"_2933":49267},[],{"_3450":69899,"_30100":69880,"_20891":115989,"_5":14349,"_27386":115945,"_2933":115990},[],"Hasta 10.000",{"_3450":69900,"_30100":69880,"_20891":115992,"_5":14349,"_27386":115945,"_2933":115993},[],"Email y chat",{"_3450":69901,"_30100":69880,"_20891":115995,"_5":14349,"_27386":115945,"_2933":115996},[],"99,9 %",{"_3450":69902,"_30100":69880,"_20891":115998,"_5":14349,"_27386":115945,"_2933":49279},[],{"_3450":69903,"_30100":69880,"_20891":116000,"_5":14349,"_27386":115945,"_2933":116001},[],"Ilimitados",{"_3450":69904,"_30100":69880,"_20891":116003,"_5":14349,"_27386":115945,"_2933":116004},[],"Dedicado",{"_3450":69905,"_30100":69880,"_20891":116006,"_5":14349,"_27386":115945,"_2933":116007},[],"99,99 %",{"_3450":69906,"_30100":69880,"_20891":116009,"_5":14349,"_27386":115949,"_2933":116010},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3450":69907,"_30100":69880,"_20891":116012,"_5":14349,"_27386":115949,"_2933":116013},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3450":69908,"_30100":69908,"_5":14701,"_2933":49296,"_30453":116015,"_20891":116017,"_27386":69908},[49052,115782,116016],"Kubernetes autogestionado",[],{"_3450":69909,"_30100":69908,"_20891":116019,"_5":14349,"_27386":69908,"_2933":116020},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3450":69910,"_30100":69908,"_5":30450,"_20891":116022,"_27386":116023,"_2933":116024},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3450":69911,"_30100":69908,"_5":30450,"_20891":116026,"_27386":116027,"_2933":116028},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3450":69912,"_30100":69908,"_5":30450,"_20891":116030,"_27386":116031,"_2933":116032},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3450":69913,"_30100":69908,"_5":30450,"_20891":116034,"_27386":116035,"_2933":116036},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3450":69914,"_30100":69908,"_5":30450,"_20891":116038,"_27386":116039,"_2933":116040},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3450":69915,"_30100":69908,"_5":30450,"_20891":116042,"_27386":116043,"_2933":116044},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3450":69916,"_30100":69908,"_5":30450,"_20891":116046,"_27386":116047,"_2933":116048},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3450":69917,"_30100":69908,"_5":30450,"_20891":116050,"_27386":116051,"_2933":116052},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3450":69918,"_30100":69908,"_5":30450,"_20891":116054,"_27386":116055,"_2933":116056},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3450":69919,"_30100":69908,"_5":30450,"_20891":116058,"_27386":116059,"_2933":116060},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3450":69920,"_30100":69908,"_5":30450,"_20891":116062,"_27386":116063,"_2933":116064},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3450":69921,"_30100":69908,"_20891":116066,"_5":14349,"_27386":116023,"_2933":116067},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3450":69922,"_30100":69908,"_20891":116069,"_5":14349,"_27386":116023,"_2933":116070},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3450":69923,"_30100":69908,"_20891":116072,"_5":14349,"_27386":116027,"_2933":116073},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3450":69924,"_30100":69908,"_20891":116075,"_5":14349,"_27386":116027,"_2933":116076},[],"Fastlane instala o configura",{"_3450":69925,"_30100":69908,"_20891":116078,"_5":14349,"_27386":116027,"_2933":116079},[],"Tú sigues proporcionando",{"_3450":69926,"_30100":69908,"_20891":116081,"_5":14349,"_27386":116027,"_2933":116082},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3450":69927,"_30100":69908,"_20891":116084,"_5":14349,"_27386":116027,"_2933":116085},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3450":69928,"_30100":69908,"_20891":116087,"_5":14349,"_27386":116027,"_2933":116088},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3450":69929,"_30100":69908,"_20891":116090,"_5":14349,"_27386":116027,"_2933":116091},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3450":69930,"_30100":69908,"_20891":116093,"_5":14349,"_27386":116027,"_2933":116094},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3450":69931,"_30100":69908,"_20891":116096,"_5":14349,"_27386":116027,"_2933":116097},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3450":69932,"_30100":69908,"_20891":116099,"_5":14349,"_27386":116027,"_2933":116100},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3450":69933,"_30100":69908,"_20891":116102,"_5":14349,"_27386":116027,"_2933":116103},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3450":69934,"_30100":69908,"_20891":116105,"_5":14349,"_27386":116027,"_2933":116106},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3450":69935,"_30100":69908,"_20891":116108,"_5":14349,"_27386":116031,"_2933":116109},[],"Necesitas:",{"_3450":69936,"_30100":69908,"_20891":116111,"_5":14349,"_27386":116031,"_2933":116112},[],"un clúster Kubernetes existente",{"_3450":69937,"_30100":69908,"_20891":116114,"_5":14349,"_27386":116031,"_2933":116115},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3450":69938,"_30100":69908,"_20891":116117,"_5":14349,"_27386":116031,"_2933":49398},[],{"_3450":69939,"_30100":69908,"_20891":116119,"_5":14349,"_27386":116031,"_2933":23617},[],{"_3450":69940,"_30100":69908,"_20891":116121,"_5":14349,"_27386":116031,"_2933":116122},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3450":69941,"_30100":69908,"_20891":116124,"_5":14349,"_27386":116031,"_2933":116125},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3450":69942,"_30100":69908,"_20891":116127,"_5":14349,"_27386":116031,"_2933":116128},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3450":69943,"_30100":69908,"_20891":116130,"_5":14349,"_27386":116031,"_2933":116131},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3450":69944,"_30100":69908,"_20891":116133,"_5":14349,"_27386":116031,"_2933":116134},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3450":69945,"_30100":69908,"_20891":116136,"_5":14349,"_27386":116035,"_2933":116137},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3450":69946,"_30100":69908,"_20891":116139,"_5":14349,"_27386":116035,"_2933":116140},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3450":69947,"_30100":69908,"_20891":116142,"_5":14349,"_27386":116039,"_2933":116143},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3450":69948,"_30100":69908,"_20891":116145,"_5":14349,"_27386":116039,"_2933":116146},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3450":69949,"_30100":69908,"_20891":116148,"_5":14349,"_27386":116039,"_2933":116149},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3450":69950,"_30100":69908,"_20891":116151,"_5":14349,"_27386":116039,"_2933":116152},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3450":69951,"_30100":69908,"_20891":116154,"_5":14349,"_27386":116043,"_2933":116155},[],"Opción",{"_3450":69952,"_30100":69908,"_20891":116157,"_5":14349,"_27386":116043,"_2933":116158},[],"Valor predeterminado",{"_3450":69953,"_30100":69908,"_20891":116160,"_5":14349,"_27386":116043,"_2933":116161},[],"Propósito",{"_3450":69954,"_30100":69908,"_20891":116163,"_5":14349,"_27386":116043,"_2933":49445},[],{"_3450":69955,"_30100":69908,"_20891":116165,"_5":14349,"_27386":116043,"_2933":49448},[],{"_3450":69956,"_30100":69908,"_20891":116167,"_5":14349,"_27386":116043,"_2933":116168},[],"Muestra la ayuda",{"_3450":69957,"_30100":69908,"_20891":116170,"_5":14349,"_27386":116043,"_2933":49454},[],{"_3450":69958,"_30100":69908,"_20891":116172,"_5":14349,"_27386":116043,"_2933":116173},[],"contexto actual",{"_3450":69959,"_30100":69908,"_20891":116175,"_5":14349,"_27386":116043,"_2933":116176},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3450":69960,"_30100":69908,"_20891":116178,"_5":14349,"_27386":116043,"_2933":49463},[],{"_3450":69961,"_30100":69908,"_20891":116180,"_5":14349,"_27386":116043,"_2933":6512},[],{"_3450":69962,"_30100":69908,"_20891":116182,"_5":14349,"_27386":116043,"_2933":116183},[],"Omite prompts y genera credenciales para las dependencias",{"_3450":69963,"_30100":69908,"_20891":116185,"_5":14349,"_27386":116043,"_2933":49471},[],{"_3450":69964,"_30100":69908,"_20891":116187,"_5":14349,"_27386":116043,"_2933":49474},[],{"_3450":69965,"_30100":69908,"_20891":116189,"_5":14349,"_27386":116043,"_2933":116190},[],"Namespace de la instalación",{"_3450":69966,"_30100":69908,"_20891":116192,"_5":14349,"_27386":116043,"_2933":49480},[],{"_3450":69967,"_30100":69908,"_20891":116194,"_5":14349,"_27386":116043,"_2933":49483},[],{"_3450":69968,"_30100":69908,"_20891":116196,"_5":14349,"_27386":116043,"_2933":116197},[],"Dominio usado por la UI, OIDC y el certificado",{"_3450":69969,"_30100":69908,"_20891":116199,"_5":14349,"_27386":116043,"_2933":49489},[],{"_3450":69970,"_30100":69908,"_20891":116201,"_5":14349,"_27386":116043,"_2933":15047},[],{"_3450":69971,"_30100":69908,"_20891":116203,"_5":14349,"_27386":116043,"_2933":116204},[],"Versión del chart de Lamassu",{"_3450":69972,"_30100":69908,"_20891":116206,"_5":14349,"_27386":116043,"_2933":49497},[],{"_3450":69973,"_30100":69908,"_20891":116208,"_5":14349,"_27386":116043,"_2933":49500},[],{"_3450":69974,"_30100":69908,"_20891":116210,"_5":14349,"_27386":116043,"_2933":116211},[],"Puerto del listener HTTPS",{"_3450":69975,"_30100":69908,"_20891":116213,"_5":14349,"_27386":116043,"_2933":49506},[],{"_3450":69976,"_30100":69908,"_20891":116215,"_5":14349,"_27386":116043,"_2933":49509},[],{"_3450":69977,"_30100":69908,"_20891":116217,"_5":14349,"_27386":116043,"_2933":116218},[],"Puerto del listener HTTP",{"_3450":69978,"_30100":69908,"_20891":116220,"_5":14349,"_27386":116043,"_2933":49515},[],{"_3450":69979,"_30100":69908,"_20891":116222,"_5":14349,"_27386":116043,"_2933":49448},[],{"_3450":69980,"_30100":69908,"_20891":116224,"_5":14349,"_27386":116043,"_2933":116225},[],"Certificado PEM para TLS downstream",{"_3450":69981,"_30100":69908,"_20891":116227,"_5":14349,"_27386":116043,"_2933":49523},[],{"_3450":69982,"_30100":69908,"_20891":116229,"_5":14349,"_27386":116043,"_2933":49448},[],{"_3450":69983,"_30100":69908,"_20891":116231,"_5":14349,"_27386":116043,"_2933":116232},[],"Clave privada PEM para TLS downstream",{"_3450":69984,"_30100":69908,"_20891":116234,"_5":14349,"_27386":116043,"_2933":49531},[],{"_3450":69985,"_30100":69908,"_20891":116236,"_5":14349,"_27386":116043,"_2933":116237},[],"chart del repositorio",{"_3450":69986,"_30100":69908,"_20891":116239,"_5":14349,"_27386":116043,"_2933":116240},[],"Usa un chart local de Lamassu sin empaquetar",{"_3450":69987,"_30100":69908,"_20891":116242,"_5":14349,"_27386":116043,"_2933":49540},[],{"_3450":69988,"_30100":69908,"_20891":116244,"_5":14349,"_27386":116043,"_2933":116245},[],"detección automática",{"_3450":69989,"_30100":69908,"_20891":116247,"_5":14349,"_27386":116043,"_2933":116248},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3450":69990,"_30100":69908,"_20891":116250,"_5":14349,"_27386":116043,"_2933":49548},[],{"_3450":69991,"_30100":69908,"_20891":116252,"_5":14349,"_27386":116043,"_2933":6512},[],{"_3450":69992,"_30100":69908,"_20891":116254,"_5":14349,"_27386":116043,"_2933":116255},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3450":69993,"_30100":69908,"_20891":116257,"_5":14349,"_27386":116043,"_2933":49556},[],{"_3450":69994,"_30100":69908,"_20891":116259,"_5":14349,"_27386":116043,"_2933":6512},[],{"_3450":69995,"_30100":69908,"_20891":116261,"_5":14349,"_27386":116043,"_2933":116262},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3450":69996,"_30100":69908,"_20891":116264,"_5":14349,"_27386":116043,"_2933":49564},[],{"_3450":69997,"_30100":69908,"_20891":116266,"_5":14349,"_27386":116043,"_2933":6512},[],{"_3450":69998,"_30100":69908,"_20891":116268,"_5":14349,"_27386":116043,"_2933":116269},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3450":69999,"_30100":69908,"_20891":116271,"_5":14349,"_27386":116043,"_2933":49572},[],{"_3450":70000,"_30100":69908,"_20891":116273,"_5":14349,"_27386":116043,"_2933":6512},[],{"_3450":70001,"_30100":69908,"_20891":116275,"_5":14349,"_27386":116043,"_2933":116276},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3450":70002,"_30100":69908,"_20891":116278,"_5":14349,"_27386":116043,"_2933":49580},[],{"_3450":70003,"_30100":69908,"_20891":116280,"_5":14349,"_27386":116043,"_2933":49583},[],{"_3450":70004,"_30100":69908,"_20891":116282,"_5":14349,"_27386":116043,"_2933":116283},[],"Usa otro chart local de SoftHSM",{"_3450":70005,"_30100":69908,"_20891":116285,"_5":14349,"_27386":116043,"_2933":116286},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3450":70006,"_30100":69908,"_20891":116288,"_5":14349,"_27386":116047,"_2933":116289},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3450":70007,"_30100":69908,"_20891":116291,"_5":14349,"_27386":116047,"_2933":116292},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3450":70008,"_30100":69908,"_20891":116294,"_5":14349,"_27386":116047,"_2933":116295},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3450":70009,"_30100":69908,"_20891":116297,"_5":14349,"_27386":116047,"_2933":116298},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3450":70010,"_30100":69908,"_20891":116300,"_5":14349,"_27386":116047,"_2933":116301},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3450":70011,"_30100":69908,"_20891":116303,"_5":14349,"_27386":116047,"_2933":116304},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3450":70012,"_30100":69908,"_20891":116306,"_5":14349,"_27386":116051,"_2933":49610},[],{"_3450":70013,"_30100":69908,"_20891":116308,"_5":14349,"_27386":116051,"_2933":116309},[],"valida las herramientas locales y el clúster seleccionado",{"_3450":70014,"_30100":69908,"_20891":116311,"_5":14349,"_27386":116051,"_2933":116312},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3450":70015,"_30100":69908,"_20891":116314,"_5":14349,"_27386":116051,"_2933":116315},[],"crea el namespace",{"_3450":70016,"_30100":69908,"_20891":116317,"_5":14349,"_27386":116051,"_2933":116318},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3450":70017,"_30100":69908,"_20891":116320,"_5":14349,"_27386":116051,"_2933":116321},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3450":70018,"_30100":69908,"_20891":116323,"_5":14349,"_27386":116051,"_2933":116324},[],"instala RabbitMQ",{"_3450":70019,"_30100":69908,"_20891":116326,"_5":14349,"_27386":116051,"_2933":116327},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3450":70020,"_30100":69908,"_20891":116329,"_5":14349,"_27386":116051,"_2933":116330},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3450":70021,"_30100":69908,"_20891":116332,"_5":14349,"_27386":116051,"_2933":116333},[],"carga datos de ejemplo opcionalmente",{"_3450":70022,"_30100":69908,"_20891":116335,"_5":14349,"_27386":116051,"_2933":116336},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3450":70023,"_30100":69908,"_20891":116338,"_5":14349,"_27386":116055,"_2933":116339},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3450":70024,"_30100":69908,"_20891":116341,"_5":14349,"_27386":116055,"_2933":116342},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3450":70025,"_30100":69908,"_20891":116344,"_5":14349,"_27386":116059,"_2933":116345},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3450":70026,"_30100":69908,"_20891":116347,"_5":14349,"_27386":116059,"_2933":116348},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3450":70027,"_30100":69908,"_20891":116350,"_5":14349,"_27386":116059,"_2933":116351},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3450":70028,"_30100":69908,"_20891":116353,"_5":14349,"_27386":116063,"_2933":116354},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3450":70029,"_30100":70029,"_5":14701,"_2933":116356,"_30453":116357,"_20891":116358,"_27386":70029},"Instala con Helm",[49052,115782,116016],[],{"_3450":70030,"_30100":70029,"_20891":116360,"_5":14349,"_27386":70029,"_2933":116361},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3450":70031,"_30100":70029,"_5":30450,"_20891":116363,"_27386":116364,"_2933":116365},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3450":70032,"_30100":70029,"_5":30450,"_20891":116367,"_27386":116368,"_2933":116032},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3450":70033,"_30100":70029,"_5":30450,"_20891":116370,"_27386":116371,"_2933":116372},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3450":70034,"_30100":70029,"_5":30450,"_20891":116374,"_27386":116375,"_2933":116376},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3450":70035,"_30100":70029,"_5":30450,"_20891":116378,"_27386":116379,"_2933":116380},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3450":70036,"_30100":70029,"_5":30450,"_20891":116382,"_27386":116383,"_2933":116384},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3450":70037,"_30100":70029,"_5":30450,"_20891":116386,"_27386":116387,"_2933":116388},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3450":70038,"_30100":70029,"_5":30450,"_20891":116390,"_27386":116391,"_2933":116392},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3450":70039,"_30100":70029,"_5":30450,"_20891":116394,"_27386":116395,"_2933":116396},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3450":70040,"_30100":70029,"_5":30450,"_20891":116398,"_27386":116399,"_2933":116400},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3450":70041,"_30100":70029,"_5":30450,"_20891":116402,"_27386":116403,"_2933":116404},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3450":70042,"_30100":70029,"_20891":116406,"_5":14349,"_27386":116364,"_2933":116407},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3450":70043,"_30100":70029,"_20891":116409,"_5":14349,"_27386":116368,"_2933":116410},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3450":70044,"_30100":70029,"_20891":116412,"_5":14349,"_27386":116368,"_2933":116413},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3450":70045,"_30100":70029,"_20891":116415,"_5":14349,"_27386":116368,"_2933":116416},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3450":70046,"_30100":70029,"_20891":116418,"_5":14349,"_27386":116368,"_2933":116419},[],"un broker RabbitMQ accesible y sus credenciales",{"_3450":70047,"_30100":70029,"_20891":116421,"_5":14349,"_27386":116368,"_2933":116422},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3450":70048,"_30100":70029,"_20891":116424,"_5":14349,"_27386":116368,"_2933":116425},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3450":70049,"_30100":70029,"_20891":116427,"_5":14349,"_27386":116368,"_2933":116428},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3450":70050,"_30100":70029,"_20891":116430,"_5":14349,"_27386":116368,"_2933":116431},[],"una StorageClass y un diseño de tráfico externo",{"_3450":70051,"_30100":70029,"_20891":116433,"_5":14349,"_27386":116368,"_2933":116434},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3450":70052,"_30100":70029,"_20891":116436,"_5":14349,"_27386":116368,"_2933":116437},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3450":70053,"_30100":70029,"_20891":116439,"_5":14349,"_27386":116368,"_2933":116440},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3450":70054,"_30100":70029,"_20891":116442,"_5":14349,"_27386":116371,"_2933":116443},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3450":70055,"_30100":70029,"_20891":116445,"_5":14349,"_27386":116371,"_2933":116446},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3450":70056,"_30100":70029,"_20891":116448,"_5":14349,"_27386":116371,"_2933":116449},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3450":70057,"_30100":70029,"_20891":116451,"_5":14349,"_27386":116375,"_2933":116452},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3450":70058,"_30100":70029,"_20891":116454,"_5":14349,"_27386":116375,"_2933":116455},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3450":70059,"_30100":70029,"_20891":116457,"_5":14349,"_27386":116375,"_2933":116458},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3450":70060,"_30100":70029,"_20891":116460,"_5":14349,"_27386":116375,"_2933":116461},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3450":70061,"_30100":70029,"_20891":116463,"_5":14349,"_27386":116379,"_2933":116464},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3450":70062,"_30100":70029,"_20891":116466,"_5":14349,"_27386":116383,"_2933":116467},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3450":70063,"_30100":70029,"_20891":116469,"_5":14349,"_27386":116383,"_2933":116470},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3450":70064,"_30100":70029,"_20891":116472,"_5":14349,"_27386":116383,"_2933":116473},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3450":70065,"_30100":70029,"_20891":116475,"_5":14349,"_27386":116383,"_2933":116476},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3450":70066,"_30100":70029,"_20891":116478,"_5":14349,"_27386":116383,"_2933":116479},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3450":70067,"_30100":70029,"_20891":116481,"_5":14349,"_27386":116383,"_2933":116482},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3450":70068,"_30100":70029,"_20891":116484,"_5":14349,"_27386":116383,"_2933":116485},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3450":70069,"_30100":70029,"_20891":116487,"_5":14349,"_27386":116387,"_2933":116488},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3450":70070,"_30100":70029,"_20891":116490,"_5":14349,"_27386":116387,"_2933":116491},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3450":70071,"_30100":70029,"_20891":116493,"_5":14349,"_27386":116387,"_2933":116494},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3450":70072,"_30100":70029,"_20891":116496,"_5":14349,"_27386":116387,"_2933":116497},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3450":70073,"_30100":70029,"_20891":116499,"_5":14349,"_27386":116391,"_2933":116500},[],"Para instalar un checkout local:",{"_3450":70074,"_30100":70029,"_20891":116502,"_5":14349,"_27386":116395,"_2933":116503},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3450":70075,"_30100":70029,"_20891":116505,"_5":14349,"_27386":116395,"_2933":116506},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3450":70076,"_30100":70029,"_20891":116508,"_5":14349,"_27386":116399,"_2933":116509},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3450":70077,"_30100":70029,"_20891":116511,"_5":14349,"_27386":116399,"_2933":116512},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3450":70078,"_30100":70029,"_20891":116514,"_5":14349,"_27386":116399,"_2933":116515},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3450":70079,"_30100":70029,"_20891":116517,"_5":14349,"_27386":116399,"_2933":116518},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3450":70080,"_30100":70029,"_20891":116520,"_5":14349,"_27386":116399,"_2933":116521},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3450":70081,"_30100":70029,"_20891":116523,"_5":14349,"_27386":116403,"_2933":116524},[],"Antes de pasar a producción, revisa:",{"_3450":70082,"_30100":70029,"_20891":116526,"_5":14349,"_27386":116403,"_2933":116527},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3450":70083,"_30100":70029,"_20891":116529,"_5":14349,"_27386":116403,"_2933":116530},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3450":70084,"_30100":70029,"_20891":116532,"_5":14349,"_27386":116403,"_2933":116533},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3450":70085,"_30100":70029,"_20891":116535,"_5":14349,"_27386":116403,"_2933":116536},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3450":70086,"_30100":70029,"_20891":116538,"_5":14349,"_27386":116403,"_2933":116539},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3450":70087,"_30100":70029,"_20891":116541,"_5":14349,"_27386":116403,"_2933":116542},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3450":70088,"_30100":70029,"_20891":116544,"_5":14349,"_27386":116403,"_2933":116545},[],"SMTP, observabilidad y entrega de alertas",{"_3450":70089,"_30100":70029,"_20891":116547,"_5":14349,"_27386":116403,"_2933":116548},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3450":70090,"_30100":70029,"_20891":116550,"_5":14349,"_27386":116403,"_2933":116551},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3450":70091,"_30100":70091,"_5":14701,"_2933":116553,"_30453":116554,"_20891":116555,"_27386":70091},"Expón el Gateway",[49052,115782,116016],[],{"_3450":70092,"_30100":70091,"_20891":116557,"_5":14349,"_27386":70091,"_2933":116558},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3450":70093,"_30100":70091,"_5":30450,"_20891":116560,"_27386":116561,"_2933":116562},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3450":70094,"_30100":70091,"_5":30450,"_20891":116564,"_27386":116565,"_2933":116566},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3450":70095,"_30100":70091,"_5":30450,"_20891":116568,"_27386":116569,"_2933":116570},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3450":70096,"_30100":70091,"_5":30450,"_20891":116572,"_27386":116573,"_2933":49878},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#k3s",{"_3450":70097,"_30100":70091,"_5":30450,"_20891":116575,"_27386":116576,"_2933":116577},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3450":70098,"_30100":70091,"_5":30450,"_20891":116579,"_27386":116580,"_2933":116581},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3450":70099,"_30100":70091,"_5":30450,"_20891":116583,"_27386":116584,"_2933":116585},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3450":70100,"_30100":70091,"_5":30450,"_20891":116587,"_27386":116588,"_2933":116589},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3450":70101,"_30100":70091,"_5":30450,"_20891":116591,"_27386":116592,"_2933":116593},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3450":70102,"_30100":70091,"_5":30450,"_20891":116595,"_27386":116596,"_2933":116597},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3450":70103,"_30100":70091,"_20891":116599,"_5":14349,"_27386":116561,"_2933":116600},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3450":70104,"_30100":70091,"_20891":116602,"_5":14349,"_27386":116561,"_2933":116603},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3450":70105,"_30100":70091,"_20891":116605,"_5":14349,"_27386":116565,"_2933":116606},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3450":70106,"_30100":70091,"_20891":116608,"_5":14349,"_27386":116565,"_2933":116609},[],"Defínelo únicamente cuando:",{"_3450":70107,"_30100":70091,"_20891":116611,"_5":14349,"_27386":116565,"_2933":116612},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3450":70108,"_30100":70091,"_20891":116614,"_5":14349,"_27386":116565,"_2933":116615},[],"esa dirección está asignada a este Gateway",{"_3450":70109,"_30100":70091,"_20891":116617,"_5":14349,"_27386":116565,"_2933":116618},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3450":70110,"_30100":70091,"_20891":116620,"_5":14349,"_27386":116565,"_2933":116621},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3450":70111,"_30100":70091,"_20891":116623,"_5":14349,"_27386":116565,"_2933":116624},[],"No confundas estos valores:",{"_3450":70112,"_30100":70091,"_20891":116626,"_5":14349,"_27386":116565,"_2933":116627},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3450":70113,"_30100":70091,"_20891":116629,"_5":14349,"_27386":116565,"_2933":116630},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3450":70114,"_30100":70091,"_20891":116632,"_5":14349,"_27386":116565,"_2933":116633},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3450":70115,"_30100":70091,"_20891":116635,"_5":14349,"_27386":116569,"_2933":116636},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3450":70116,"_30100":70091,"_20891":116638,"_5":14349,"_27386":116569,"_2933":116639},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3450":70117,"_30100":70091,"_20891":116641,"_5":14349,"_27386":116573,"_2933":116642},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3450":70118,"_30100":70091,"_20891":116644,"_5":14349,"_27386":116573,"_2933":116645},[],"Para el diseño recomendado:",{"_3450":70119,"_30100":70091,"_20891":116647,"_5":14349,"_27386":116573,"_2933":116648},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3450":70120,"_30100":70091,"_20891":116650,"_5":14349,"_27386":116573,"_2933":116651},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3450":70121,"_30100":70091,"_20891":116653,"_5":14349,"_27386":116573,"_2933":116654},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3450":70122,"_30100":70091,"_20891":116656,"_5":14349,"_27386":116573,"_2933":116657},[],"Apunta DNS a la dirección accesible de la VM.",{"_3450":70123,"_30100":70091,"_20891":116659,"_5":14349,"_27386":116573,"_2933":116660},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3450":70124,"_30100":70091,"_20891":116662,"_5":14349,"_27386":116576,"_2933":116663},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3450":70125,"_30100":70091,"_20891":116665,"_5":14349,"_27386":116580,"_2933":116666},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3450":70126,"_30100":70091,"_20891":116668,"_5":14349,"_27386":116580,"_2933":116669},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3450":70127,"_30100":70091,"_20891":116671,"_5":14349,"_27386":116584,"_2933":116672},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3450":70128,"_30100":70091,"_20891":116674,"_5":14349,"_27386":116584,"_2933":116675},[],"Requisito",{"_3450":70129,"_30100":70091,"_20891":116677,"_5":14349,"_27386":116584,"_2933":116678},[],"Diseño recomendado",{"_3450":70130,"_30100":70091,"_20891":116680,"_5":14349,"_27386":116584,"_2933":116681},[],"Consecuencia",{"_3450":70131,"_30100":70091,"_20891":116683,"_5":14349,"_27386":116584,"_2933":116684},[],"Varias URL o servicios de Lamassu",{"_3450":70132,"_30100":70091,"_20891":116686,"_5":14349,"_27386":116584,"_2933":116687},[],"Un Gateway con varias rutas",{"_3450":70133,"_30100":70091,"_20891":116689,"_5":14349,"_27386":116584,"_2933":116690},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3450":70134,"_30100":70091,"_20891":116692,"_5":14349,"_27386":116584,"_2933":116693},[],"Gateways independientes e IP externas distintas",{"_3450":70135,"_30100":70091,"_20891":116695,"_5":14349,"_27386":116584,"_2933":116696},[],"Una VIP por Gateway",{"_3450":70136,"_30100":70091,"_20891":116698,"_5":14349,"_27386":116584,"_2933":116699},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3450":70137,"_30100":70091,"_20891":116701,"_5":14349,"_27386":116584,"_2933":116702},[],"Gateways independientes, un nodo y una IP",{"_3450":70138,"_30100":70091,"_20891":116704,"_5":14349,"_27386":116584,"_2933":116705},[],"Puertos externos diferentes",{"_3450":70139,"_30100":70091,"_20891":116707,"_5":14349,"_27386":116584,"_2933":116708},[],"Los clientes deben indicar puertos no estándar",{"_3450":70140,"_30100":70091,"_20891":116710,"_5":14349,"_27386":116584,"_2933":116711},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3450":70141,"_30100":70091,"_20891":116713,"_5":14349,"_27386":116584,"_2933":116714},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3450":70142,"_30100":70091,"_20891":116716,"_5":14349,"_27386":116584,"_2933":116717},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3450":70143,"_30100":70091,"_20891":116719,"_5":14349,"_27386":116584,"_2933":116720},[],"Recursos Gateway separados pero proxy compartido",{"_3450":70144,"_30100":70091,"_20891":116722,"_5":14349,"_27386":116584,"_2933":116723},[],"Modo merged Gateway de Envoy",{"_3450":70145,"_30100":70091,"_20891":116725,"_5":14349,"_27386":116584,"_2933":116726},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3450":70146,"_30100":70091,"_20891":116728,"_5":14349,"_27386":116584,"_2933":116729},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3450":70147,"_30100":70091,"_20891":116731,"_5":14349,"_27386":116584,"_2933":116732},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3450":70148,"_30100":70091,"_20891":116734,"_5":14349,"_27386":116584,"_2933":116735},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3450":70149,"_30100":70091,"_20891":116737,"_5":14349,"_27386":116584,"_2933":116738},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3450":70150,"_30100":70091,"_20891":116740,"_5":14349,"_27386":116588,"_2933":116741},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3450":70151,"_30100":70091,"_20891":116743,"_5":14349,"_27386":116588,"_2933":116744},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3450":70152,"_30100":70091,"_20891":116746,"_5":14349,"_27386":116588,"_2933":116747},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3450":70153,"_30100":70091,"_20891":116749,"_5":14349,"_27386":116588,"_2933":116750},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3450":70154,"_30100":70091,"_20891":116752,"_5":14349,"_27386":116588,"_2933":116753},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3450":70155,"_30100":70091,"_20891":116755,"_5":14349,"_27386":116592,"_2933":116756},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3450":70156,"_30100":70091,"_20891":116758,"_5":14349,"_27386":116592,"_2933":116759},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3450":70157,"_30100":70091,"_20891":116761,"_5":14349,"_27386":116596,"_2933":116762},[],"Comprueba, en orden:",{"_3450":70158,"_30100":70091,"_20891":116764,"_5":14349,"_27386":116596,"_2933":116765},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3450":70159,"_30100":70091,"_20891":116767,"_5":14349,"_27386":116596,"_2933":116768},[],"Su estado contiene la dirección esperada.",{"_3450":70160,"_30100":70091,"_20891":116770,"_5":14349,"_27386":116596,"_2933":116771},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3450":70161,"_30100":70091,"_20891":116773,"_5":14349,"_27386":116596,"_2933":116774},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3450":70162,"_30100":70091,"_20891":116776,"_5":14349,"_27386":116596,"_2933":116777},[],"DNS resuelve al endpoint accesible externamente.",{"_3450":70163,"_30100":70091,"_20891":116779,"_5":14349,"_27386":116596,"_2933":116780},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3450":70164,"_30100":70091,"_20891":116782,"_5":14349,"_27386":116596,"_2933":116783},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3450":70165,"_30100":70165,"_5":14701,"_2933":49159,"_30453":116785,"_20891":116786,"_27386":70165},[49052,115782,116016],[],{"_3450":70166,"_30100":70165,"_20891":116788,"_5":14349,"_27386":70165,"_2933":116789},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3450":70167,"_30100":70165,"_5":30450,"_20891":116791,"_27386":116792,"_2933":116793},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3450":70168,"_30100":70165,"_5":30450,"_20891":116795,"_27386":116796,"_2933":116797},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3450":70169,"_30100":70165,"_5":30450,"_20891":116799,"_27386":116800,"_2933":116801},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3450":70170,"_30100":70165,"_5":30450,"_20891":116803,"_27386":116804,"_2933":116805},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3450":70171,"_30100":70165,"_5":30450,"_20891":116807,"_27386":116808,"_2933":116809},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3450":70172,"_30100":70165,"_5":30450,"_20891":116811,"_27386":116812,"_2933":116813},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3450":70173,"_30100":70165,"_20891":116815,"_5":14349,"_27386":116792,"_2933":116816},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3450":70174,"_30100":70165,"_20891":116818,"_5":14349,"_27386":116796,"_2933":116819},[],"Flujo",{"_3450":70175,"_30100":70165,"_20891":116821,"_5":14349,"_27386":116796,"_2933":116822},[],"Úsalo para",{"_3450":70176,"_30100":70165,"_20891":116824,"_5":14349,"_27386":116796,"_2933":116825},[],"Qué instala",{"_3450":70177,"_30100":70165,"_20891":116827,"_5":14349,"_27386":116796,"_2933":50133},[],{"_3450":70178,"_30100":70165,"_20891":116829,"_5":14349,"_27386":116796,"_2933":116830},[],"Producción y entornos controlados",{"_3450":70179,"_30100":70165,"_20891":116832,"_5":14349,"_27386":116796,"_2933":116833},[],"Servicios de Lamassu y recursos de Gateway API",{"_3450":70180,"_30100":70165,"_20891":116835,"_5":14349,"_27386":116796,"_2933":49296},[],{"_3450":70181,"_30100":70165,"_20891":116837,"_5":14349,"_27386":116796,"_2933":116838},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3450":70182,"_30100":70165,"_20891":116840,"_5":14349,"_27386":116796,"_2933":116841},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3450":70183,"_30100":70165,"_20891":116843,"_5":14349,"_27386":116800,"_2933":116844},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3450":70184,"_30100":70165,"_20891":116846,"_5":14349,"_27386":116800,"_2933":116847},[],"Área",{"_3450":70185,"_30100":70165,"_20891":116849,"_5":14349,"_27386":116800,"_2933":116850},[],"El chart de Lamassu proporciona",{"_3450":70186,"_30100":70165,"_20891":116852,"_5":14349,"_27386":116800,"_2933":116853},[],"Tú proporcionas",{"_3450":70187,"_30100":70165,"_20891":116855,"_5":14349,"_27386":116800,"_2933":116856},[],"Aplicaciones Lamassu",{"_3450":70188,"_30100":70165,"_20891":116858,"_5":14349,"_27386":116800,"_2933":116859},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3450":70189,"_30100":70165,"_20891":116861,"_5":14349,"_27386":116800,"_2933":116862},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3450":70190,"_30100":70165,"_20891":116864,"_5":14349,"_27386":116800,"_2933":116865},[],"Datos PostgreSQL",{"_3450":70191,"_30100":70165,"_20891":116867,"_5":14349,"_27386":116800,"_2933":116868},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3450":70192,"_30100":70165,"_20891":116870,"_5":14349,"_27386":116800,"_2933":116871},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3450":70193,"_30100":70165,"_20891":116873,"_5":14349,"_27386":116800,"_2933":116874},[],"Mensajería",{"_3450":70194,"_30100":70165,"_20891":116876,"_5":14349,"_27386":116800,"_2933":116877},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3450":70195,"_30100":70165,"_20891":116879,"_5":14349,"_27386":116800,"_2933":116880},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3450":70196,"_30100":70165,"_20891":116882,"_5":14349,"_27386":116800,"_2933":116883},[],"Identidad",{"_3450":70197,"_30100":70165,"_20891":116885,"_5":14349,"_27386":116800,"_2933":116886},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3450":70198,"_30100":70165,"_20891":116888,"_5":14349,"_27386":116800,"_2933":116889},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3450":70199,"_30100":70165,"_20891":116891,"_5":14349,"_27386":116800,"_2933":116892},[],"Enrutamiento externo",{"_3450":70200,"_30100":70165,"_20891":116894,"_5":14349,"_27386":116800,"_2933":116895},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3450":70201,"_30100":70165,"_20891":116897,"_5":14349,"_27386":116800,"_2933":116898},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3450":70202,"_30100":70165,"_20891":116900,"_5":14349,"_27386":116800,"_2933":50207},[],{"_3450":70203,"_30100":70165,"_20891":116902,"_5":14349,"_27386":116800,"_2933":116903},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3450":70204,"_30100":70165,"_20891":116905,"_5":14349,"_27386":116800,"_2933":116906},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3450":70205,"_30100":70165,"_20891":116908,"_5":14349,"_27386":116800,"_2933":116909},[],"Datos persistentes de la aplicación",{"_3450":70206,"_30100":70165,"_20891":116911,"_5":14349,"_27386":116800,"_2933":116912},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3450":70207,"_30100":70165,"_20891":116914,"_5":14349,"_27386":116800,"_2933":116915},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3450":70208,"_30100":70165,"_20891":116917,"_5":14349,"_27386":116800,"_2933":116918},[],"Integraciones opcionales",{"_3450":70209,"_30100":70165,"_20891":116920,"_5":14349,"_27386":116800,"_2933":116921},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3450":70210,"_30100":70165,"_20891":116923,"_5":14349,"_27386":116800,"_2933":116924},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3450":70211,"_30100":70165,"_20891":116926,"_5":14349,"_27386":116800,"_2933":116927},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3450":70212,"_30100":70165,"_20891":116929,"_5":14349,"_27386":116800,"_2933":116930},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3450":70213,"_30100":70165,"_20891":116932,"_5":14349,"_27386":116804,"_2933":116933},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3450":70214,"_30100":70165,"_20891":116935,"_5":14349,"_27386":116804,"_2933":116936},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3450":70215,"_30100":70165,"_20891":116938,"_5":14349,"_27386":116808,"_2933":116939},[],"Kubernetes 1.24 o posterior",{"_3450":70216,"_30100":70165,"_20891":116941,"_5":14349,"_27386":116808,"_2933":116942},[],"Helm 3.2 o posterior",{"_3450":70217,"_30100":70165,"_20891":116944,"_5":14349,"_27386":116808,"_2933":116945},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3450":70218,"_30100":70165,"_20891":116947,"_5":14349,"_27386":116808,"_2933":116948},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3450":70219,"_30100":70165,"_20891":116950,"_5":14349,"_27386":116808,"_2933":116951},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3450":70220,"_30100":70165,"_20891":116953,"_5":14349,"_27386":116808,"_2933":116954},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3450":70221,"_30100":70165,"_20891":116956,"_5":14349,"_27386":116808,"_2933":116957},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3450":70222,"_30100":70165,"_20891":116959,"_5":14349,"_27386":116812,"_2933":116960},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3450":70223,"_30100":70165,"_20891":116962,"_5":14349,"_27386":116812,"_2933":116963},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3450":70224,"_30100":70165,"_20891":116965,"_5":14349,"_27386":116812,"_2933":116966},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3450":70225,"_30100":70165,"_20891":116968,"_5":14349,"_27386":116812,"_2933":116969},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3450":70226,"_30100":70226,"_5":14701,"_2933":116971,"_30453":116972,"_20891":116974,"_27386":70226},"Resolución de problemas de despliegue",[49052,115782,116973],"Operación",[],{"_3450":70227,"_30100":70226,"_20891":116976,"_5":14349,"_27386":70226,"_2933":116977},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3450":70228,"_30100":70226,"_5":30450,"_20891":116979,"_27386":116980,"_2933":116981},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3450":70229,"_30100":70226,"_5":30450,"_20891":116983,"_27386":116984,"_2933":116985},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3450":70230,"_30100":70226,"_5":30450,"_20891":116987,"_27386":116988,"_2933":116989},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3450":70231,"_30100":70226,"_5":30450,"_20891":116991,"_27386":116992,"_2933":116993},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3450":70232,"_30100":70226,"_5":30450,"_20891":116995,"_27386":116996,"_2933":116997},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3450":70233,"_30100":70226,"_5":30450,"_20891":116999,"_27386":117000,"_2933":117001},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3450":70234,"_30100":70226,"_5":30450,"_20891":117003,"_27386":117004,"_2933":117005},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3450":70235,"_30100":70226,"_5":30450,"_20891":117007,"_27386":117008,"_2933":117009},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3450":70236,"_30100":70226,"_5":30450,"_20891":117011,"_27386":117012,"_2933":117013},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3450":70237,"_30100":70226,"_5":30450,"_20891":117015,"_27386":117016,"_2933":117017},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3450":70238,"_30100":70226,"_5":30450,"_20891":117019,"_27386":117020,"_2933":117021},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3450":70239,"_30100":70226,"_5":30450,"_20891":117023,"_27386":117024,"_2933":117025},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3450":70240,"_30100":70226,"_5":30450,"_20891":117027,"_27386":117028,"_2933":117029},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3450":70241,"_30100":70226,"_20891":117031,"_5":14349,"_27386":70226,"_2933":117032},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3450":70242,"_30100":70226,"_20891":117034,"_5":14349,"_27386":116984,"_2933":117035},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3450":70243,"_30100":70226,"_20891":117037,"_5":14349,"_27386":116988,"_2933":117038},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3450":70244,"_30100":70226,"_20891":117040,"_5":14349,"_27386":116992,"_2933":117041},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3450":70245,"_30100":70226,"_20891":117043,"_5":14349,"_27386":116996,"_2933":117044},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3450":70246,"_30100":70226,"_20891":117046,"_5":14349,"_27386":117000,"_2933":117047},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3450":70247,"_30100":70226,"_20891":117049,"_5":14349,"_27386":117004,"_2933":117050},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3450":70248,"_30100":70226,"_20891":117052,"_5":14349,"_27386":117004,"_2933":117053},[],"Ejecuta también la prueba de conectividad del chart:",{"_3450":70249,"_30100":70226,"_20891":117055,"_5":14349,"_27386":117004,"_2933":117056},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3450":70250,"_30100":70226,"_20891":117058,"_5":14349,"_27386":117004,"_2933":117059},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3450":70251,"_30100":70226,"_20891":117061,"_5":14349,"_27386":117008,"_2933":117062},[],"Si recibes un 401:",{"_3450":70252,"_30100":70226,"_20891":117064,"_5":14349,"_27386":117008,"_2933":117065},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3450":70253,"_30100":70226,"_20891":117067,"_5":14349,"_27386":117008,"_2933":117068},[],"verifica emisor, audiencia y expiración del token;",{"_3450":70254,"_30100":70226,"_20891":117070,"_5":14349,"_27386":117008,"_2933":117071},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3450":70255,"_30100":70226,"_20891":117073,"_5":14349,"_27386":117008,"_2933":117074},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3450":70256,"_30100":70226,"_20891":117076,"_5":14349,"_27386":117008,"_2933":117077},[],"Si el login termina pero las APIs devuelven 403:",{"_3450":70257,"_30100":70226,"_20891":117079,"_5":14349,"_27386":117008,"_2933":117080},[],"inspecciona los claims reales del token;",{"_3450":70258,"_30100":70226,"_20891":117082,"_5":14349,"_27386":117008,"_2933":117083},[],"confirma que coinciden con un principal activo;",{"_3450":70259,"_30100":70226,"_20891":117085,"_5":14349,"_27386":117008,"_2933":117086},[],"revisa las políticas concedidas al principal;",{"_3450":70260,"_30100":70226,"_20891":117088,"_5":14349,"_27386":117008,"_2933":117089},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3450":70261,"_30100":70226,"_20891":117091,"_5":14349,"_27386":117008,"_2933":117092},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3450":70262,"_30100":70226,"_20891":117094,"_5":14349,"_27386":117012,"_2933":117095},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3450":70263,"_30100":70226,"_20891":117097,"_5":14349,"_27386":117012,"_2933":117098},[],"Localiza el pod y Service de authz.",{"_3450":70264,"_30100":70226,"_20891":117100,"_5":14349,"_27386":117012,"_2933":117101},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3450":70265,"_30100":70226,"_20891":117103,"_5":14349,"_27386":117012,"_2933":117104},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3450":70266,"_30100":70226,"_20891":117106,"_5":14349,"_27386":117012,"_2933":117107},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3450":70267,"_30100":70226,"_20891":117109,"_5":14349,"_27386":117012,"_2933":117110},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3450":70268,"_30100":70226,"_20891":117112,"_5":14349,"_27386":117016,"_2933":117113},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3450":70269,"_30100":70226,"_20891":117115,"_5":14349,"_27386":117020,"_2933":117116},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3450":70270,"_30100":70226,"_20891":117118,"_5":14349,"_27386":117020,"_2933":117119},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3450":70271,"_30100":70226,"_20891":117121,"_5":14349,"_27386":117020,"_2933":117122},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3450":70272,"_30100":70226,"_20891":117124,"_5":14349,"_27386":117020,"_2933":117125},[],"volumen persistente sin enlazar;",{"_3450":70273,"_30100":70226,"_20891":117127,"_5":14349,"_27386":117020,"_2933":117128},[],"imagen inaccesible o política de pull incorrecta;",{"_3450":70274,"_30100":70226,"_20891":117130,"_5":14349,"_27386":117020,"_2933":117131},[],"configuración inválida del motor criptográfico;",{"_3450":70275,"_30100":70226,"_20891":117133,"_5":14349,"_27386":117020,"_2933":117134},[],"límites de CPU o memoria demasiado bajos;",{"_3450":70276,"_30100":70226,"_20891":117136,"_5":14349,"_27386":117020,"_2933":117137},[],"migración previa incompleta.",{"_3450":70277,"_30100":70226,"_20891":117139,"_5":14349,"_27386":117020,"_2933":117140},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3450":70278,"_30100":70226,"_20891":117142,"_5":14349,"_27386":117020,"_2933":117143},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3450":70279,"_30100":70226,"_20891":117145,"_5":14349,"_27386":117020,"_2933":117146},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3450":70280,"_30100":70226,"_20891":117148,"_5":14349,"_27386":117024,"_2933":117149},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3450":70281,"_30100":70226,"_20891":117151,"_5":14349,"_27386":117024,"_2933":117152},[],"verifica que esté habilitado en el servicio emisor;",{"_3450":70282,"_30100":70226,"_20891":117154,"_5":14349,"_27386":117024,"_2933":117155},[],"comprueba conectividad y credenciales AMQP;",{"_3450":70283,"_30100":70226,"_20891":117157,"_5":14349,"_27386":117024,"_2933":117158},[],"revisa exchange, routing key, colas y consumidores;",{"_3450":70284,"_30100":70226,"_20891":117160,"_5":14349,"_27386":117024,"_2933":117161},[],"inspecciona dead-letter queues;",{"_3450":70285,"_30100":70226,"_20891":117163,"_5":14349,"_27386":117024,"_2933":117164},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3450":70286,"_30100":70226,"_20891":117166,"_5":14349,"_27386":117024,"_2933":117167},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3450":70287,"_30100":70226,"_20891":117169,"_5":14349,"_27386":117024,"_2933":117170},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3450":70288,"_30100":70226,"_20891":117172,"_5":14349,"_27386":117024,"_2933":117173},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3450":70289,"_30100":70226,"_20891":117175,"_5":14349,"_27386":117024,"_2933":117176},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3450":70290,"_30100":70226,"_20891":117178,"_5":14349,"_27386":117024,"_2933":117179},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3450":70291,"_30100":70226,"_20891":117181,"_5":14349,"_27386":117024,"_2933":117182},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3450":70292,"_30100":70226,"_20891":117184,"_5":14349,"_27386":117024,"_2933":117185},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3450":70293,"_30100":70226,"_20891":117187,"_5":14349,"_27386":117028,"_2933":117188},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3450":70294,"_30100":70226,"_20891":117190,"_5":14349,"_27386":117028,"_2933":117191},[],"Antes de cerrar una incidencia, guarda:",{"_3450":70295,"_30100":70226,"_20891":117193,"_5":14349,"_27386":117028,"_2933":117194},[],"causa confirmada;",{"_3450":70296,"_30100":70226,"_20891":117196,"_5":14349,"_27386":117028,"_2933":117197},[],"alcance temporal y recursos afectados;",{"_3450":70297,"_30100":70226,"_20891":117199,"_5":14349,"_27386":117028,"_2933":117200},[],"comandos o consultas utilizados;",{"_3450":70298,"_30100":70226,"_20891":117202,"_5":14349,"_27386":117028,"_2933":117203},[],"cambio aplicado y forma de revertirlo;",{"_3450":70299,"_30100":70226,"_20891":117205,"_5":14349,"_27386":117028,"_2933":117206},[],"validación desde un consumidor;",{"_3450":70300,"_30100":70226,"_20891":117208,"_5":14349,"_27386":117028,"_2933":117209},[],"acción preventiva y propietario.",{"_3450":70301,"_30100":70301,"_5":14701,"_2933":117211,"_30453":117212,"_20891":117215,"_27386":70301},"Control de acceso",[49052,117213,117214],"Plataforma","Administración",[],{"_3450":70302,"_30100":70301,"_20891":117217,"_5":14349,"_27386":70301,"_2933":117218},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3450":70303,"_30100":70301,"_5":30450,"_20891":117220,"_27386":117221,"_2933":117222},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3450":70304,"_30100":70301,"_5":30450,"_20891":117224,"_27386":117225,"_2933":117226},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3450":70305,"_30100":70301,"_5":30450,"_20891":117228,"_27386":117229,"_2933":117230},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3450":70306,"_30100":70301,"_5":30450,"_20891":117232,"_27386":117233,"_2933":117234},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3450":70307,"_30100":70301,"_5":30450,"_20891":117236,"_27386":117237,"_2933":117238},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3450":70308,"_30100":70301,"_5":30450,"_20891":117240,"_27386":117241,"_2933":117242},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3450":70309,"_30100":70301,"_5":30450,"_20891":117244,"_27386":117245,"_2933":117246},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3450":70310,"_30100":70301,"_5":30450,"_20891":117248,"_27386":117249,"_2933":117250},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3450":70311,"_30100":70301,"_5":30450,"_20891":117252,"_27386":117253,"_2933":117254},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3450":70312,"_30100":70301,"_5":30450,"_20891":117256,"_27386":117257,"_2933":117258},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3450":70313,"_30100":70301,"_5":30450,"_20891":117260,"_27386":117261,"_2933":117262},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3450":70314,"_30100":70301,"_5":30450,"_20891":117264,"_27386":117265,"_2933":117266},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3450":70315,"_30100":70301,"_5":30450,"_20891":117268,"_27386":117269,"_2933":117270},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3450":70316,"_30100":70301,"_5":30450,"_20891":117272,"_27386":117273,"_2933":117274},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3450":70317,"_30100":70301,"_5":30450,"_20891":117276,"_27386":117277,"_2933":117278},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3450":70318,"_30100":70301,"_5":30450,"_20891":117280,"_27386":117281,"_2933":116388},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3450":70319,"_30100":70301,"_5":30450,"_20891":117283,"_27386":117284,"_2933":117285},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3450":70320,"_30100":70301,"_5":30450,"_20891":117287,"_27386":117288,"_2933":117289},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3450":70321,"_30100":70301,"_5":30450,"_20891":117291,"_27386":117292,"_2933":117293},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3450":70322,"_30100":70301,"_5":30450,"_20891":117295,"_27386":117296,"_2933":117297},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3450":70323,"_30100":70301,"_5":30450,"_20891":117299,"_27386":117300,"_2933":117301},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3450":70324,"_30100":70301,"_5":30450,"_20891":117303,"_27386":117304,"_2933":117305},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3450":70325,"_30100":70301,"_5":30450,"_20891":117307,"_27386":117308,"_2933":117309},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3450":70326,"_30100":70301,"_5":30450,"_20891":117311,"_27386":117312,"_2933":117313},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3450":70327,"_30100":70301,"_5":30450,"_20891":117315,"_27386":117316,"_2933":117317},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3450":70328,"_30100":70301,"_5":30450,"_20891":117319,"_27386":117320,"_2933":117321},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3450":70329,"_30100":70301,"_5":30450,"_20891":117323,"_27386":117324,"_2933":117325},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3450":70330,"_30100":70301,"_5":30450,"_20891":117327,"_27386":117328,"_2933":117329},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3450":70331,"_30100":70301,"_5":30450,"_20891":117331,"_27386":117332,"_2933":117333},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3450":70332,"_30100":70301,"_5":30450,"_20891":117335,"_27386":117336,"_2933":117337},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3450":70333,"_30100":70301,"_5":30450,"_20891":117339,"_27386":117340,"_2933":117341},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3450":70334,"_30100":70301,"_20891":117343,"_5":14349,"_27386":70301,"_2933":117344},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3450":70335,"_30100":70301,"_20891":117346,"_5":14349,"_27386":70301,"_2933":117347},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3450":70336,"_30100":70301,"_20891":117349,"_5":14349,"_27386":70301,"_2933":117350},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3450":70337,"_30100":70301,"_20891":117352,"_5":14349,"_27386":117221,"_2933":117353},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3450":70338,"_30100":70301,"_20891":117355,"_5":14349,"_27386":117221,"_2933":117356},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3450":70339,"_30100":70301,"_20891":117358,"_5":14349,"_27386":117221,"_2933":117359},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3450":70340,"_30100":70301,"_20891":117361,"_5":14349,"_27386":117221,"_2933":117362},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3450":70341,"_30100":70301,"_20891":117364,"_5":14349,"_27386":117221,"_2933":117365},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3450":70342,"_30100":70301,"_20891":117367,"_5":14349,"_27386":117221,"_2933":117368},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3450":70343,"_30100":70301,"_20891":117370,"_5":14349,"_27386":117225,"_2933":117371},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3450":70344,"_30100":70301,"_20891":117373,"_5":14349,"_27386":117225,"_2933":117374},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3450":70345,"_30100":70301,"_20891":117376,"_5":14349,"_27386":117229,"_2933":117377},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3450":70346,"_30100":70301,"_20891":117379,"_5":14349,"_27386":117229,"_2933":117380},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3450":70347,"_30100":70301,"_20891":117382,"_5":14349,"_27386":117229,"_2933":117383},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3450":70348,"_30100":70301,"_20891":117385,"_5":14349,"_27386":117229,"_2933":117386},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3450":70349,"_30100":70301,"_20891":117388,"_5":14349,"_27386":117229,"_2933":117389},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3450":70350,"_30100":70301,"_20891":117391,"_5":14349,"_27386":117229,"_2933":117392},[],"Carga por separado las políticas concedidas a cada principal.",{"_3450":70351,"_30100":70301,"_20891":117394,"_5":14349,"_27386":117229,"_2933":117395},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3450":70352,"_30100":70301,"_20891":117397,"_5":14349,"_27386":117229,"_2933":117398},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3450":70353,"_30100":70301,"_20891":117400,"_5":14349,"_27386":117229,"_2933":117401},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3450":70354,"_30100":70301,"_20891":117403,"_5":14349,"_27386":117229,"_2933":117404},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3450":70355,"_30100":70301,"_20891":117406,"_5":14349,"_27386":117229,"_2933":117407},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3450":70356,"_30100":70301,"_20891":117409,"_5":14349,"_27386":117229,"_2933":117410},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3450":70357,"_30100":70301,"_20891":117412,"_5":14349,"_27386":117233,"_2933":117413},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3450":70358,"_30100":70301,"_20891":117415,"_5":14349,"_27386":117233,"_2933":117416},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3450":70359,"_30100":70301,"_20891":117418,"_5":14349,"_27386":117233,"_2933":117419},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3450":70360,"_30100":70301,"_20891":117421,"_5":14349,"_27386":117233,"_2933":117422},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3450":70361,"_30100":70301,"_20891":117424,"_5":14349,"_27386":117233,"_2933":117425},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3450":70362,"_30100":70301,"_20891":117427,"_5":14349,"_27386":117233,"_2933":117428},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3450":70363,"_30100":70301,"_20891":117430,"_5":14349,"_27386":117233,"_2933":117431},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3450":70364,"_30100":70301,"_20891":117433,"_5":14349,"_27386":117233,"_2933":117434},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3450":70365,"_30100":70301,"_20891":117436,"_5":14349,"_27386":117237,"_2933":117437},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3450":70366,"_30100":70301,"_20891":117439,"_5":14349,"_27386":117237,"_2933":117440},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3450":70367,"_30100":70301,"_20891":117442,"_5":14349,"_27386":117237,"_2933":117443},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3450":70368,"_30100":70301,"_20891":117445,"_5":14349,"_27386":117237,"_2933":117446},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3450":70369,"_30100":70301,"_20891":117448,"_5":14349,"_27386":117237,"_2933":117449},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3450":70370,"_30100":70301,"_20891":117451,"_5":14349,"_27386":117237,"_2933":117452},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3450":70371,"_30100":70301,"_20891":117454,"_5":14349,"_27386":117237,"_2933":117455},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3450":70372,"_30100":70301,"_20891":117457,"_5":14349,"_27386":117237,"_2933":117458},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3450":70373,"_30100":70301,"_20891":117460,"_5":14349,"_27386":117237,"_2933":117461},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3450":70374,"_30100":70301,"_20891":117463,"_5":14349,"_27386":117237,"_2933":117464},[],"Las acciones se dividen en dos grupos:",{"_3450":70375,"_30100":70301,"_20891":117466,"_5":14349,"_27386":117237,"_2933":117467},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3450":70376,"_30100":70301,"_20891":117469,"_5":14349,"_27386":117237,"_2933":117470},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3450":70377,"_30100":70301,"_20891":117472,"_5":14349,"_27386":117237,"_2933":117473},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3450":70378,"_30100":70301,"_20891":117475,"_5":14349,"_27386":117241,"_2933":117476},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3450":70379,"_30100":70301,"_20891":117478,"_5":14349,"_27386":117241,"_2933":117479},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3450":70380,"_30100":70301,"_20891":117481,"_5":14349,"_27386":117241,"_2933":117482},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3450":70381,"_30100":70301,"_20891":117484,"_5":14349,"_27386":117245,"_2933":117485},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3450":70382,"_30100":70301,"_20891":117487,"_5":14349,"_27386":117245,"_2933":117488},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3450":70383,"_30100":70301,"_20891":117490,"_5":14349,"_27386":117245,"_2933":117491},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3450":70384,"_30100":70301,"_20891":117493,"_5":14349,"_27386":117245,"_2933":117494},[],"Los operadores implementados son:",{"_3450":70385,"_30100":70301,"_20891":117496,"_5":14349,"_27386":117245,"_2933":117497},[],"`equals`, para igualdad exacta;",{"_3450":70386,"_30100":70301,"_20891":117499,"_5":14349,"_27386":117245,"_2933":117500},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3450":70387,"_30100":70301,"_20891":117502,"_5":14349,"_27386":117245,"_2933":117503},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3450":70388,"_30100":70301,"_20891":117505,"_5":14349,"_27386":117245,"_2933":117506},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3450":70389,"_30100":70301,"_20891":117508,"_5":14349,"_27386":117249,"_2933":117509},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3450":70390,"_30100":70301,"_20891":117511,"_5":14349,"_27386":117249,"_2933":117512},[],"Los modos disponibles son:",{"_3450":70391,"_30100":70301,"_20891":117514,"_5":14349,"_27386":117249,"_2933":117515},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3450":70392,"_30100":70301,"_20891":117517,"_5":14349,"_27386":117249,"_2933":117518},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3450":70393,"_30100":70301,"_20891":117520,"_5":14349,"_27386":117249,"_2933":117521},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3450":70394,"_30100":70301,"_20891":117523,"_5":14349,"_27386":117249,"_2933":117524},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3450":70395,"_30100":70301,"_20891":117526,"_5":14349,"_27386":117249,"_2933":117527},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3450":70396,"_30100":70301,"_20891":117529,"_5":14349,"_27386":117249,"_2933":117530},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3450":70397,"_30100":70301,"_20891":117532,"_5":14349,"_27386":117253,"_2933":117533},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3450":70398,"_30100":70301,"_20891":117535,"_5":14349,"_27386":117253,"_2933":117536},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3450":70399,"_30100":70301,"_20891":117538,"_5":14349,"_27386":117253,"_2933":117539},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3450":70400,"_30100":70301,"_20891":117541,"_5":14349,"_27386":117253,"_2933":117542},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3450":70401,"_30100":70301,"_20891":117544,"_5":14349,"_27386":117261,"_2933":117545},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3450":70402,"_30100":70301,"_20891":117547,"_5":14349,"_27386":117261,"_2933":117548},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3450":70403,"_30100":70301,"_20891":117550,"_5":14349,"_27386":117265,"_2933":117551},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3450":70404,"_30100":70301,"_20891":117553,"_5":14349,"_27386":117265,"_2933":117554},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3450":70405,"_30100":70301,"_20891":117556,"_5":14349,"_27386":117269,"_2933":117557},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3450":70406,"_30100":70301,"_20891":117559,"_5":14349,"_27386":117269,"_2933":117560},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3450":70407,"_30100":70301,"_20891":117562,"_5":14349,"_27386":117269,"_2933":117563},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3450":70408,"_30100":70301,"_20891":117565,"_5":14349,"_27386":117273,"_2933":117566},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3450":70409,"_30100":70301,"_20891":117568,"_5":14349,"_27386":117273,"_2933":117569},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3450":70410,"_30100":70301,"_20891":117571,"_5":14349,"_27386":117273,"_2933":117572},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3450":70411,"_30100":70301,"_20891":117574,"_5":14349,"_27386":117273,"_2933":117575},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3450":70412,"_30100":70301,"_20891":117577,"_5":14349,"_27386":117273,"_2933":117578},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3450":70413,"_30100":70301,"_20891":117580,"_5":14349,"_27386":117273,"_2933":117581},[],"Ten en cuenta que:",{"_3450":70414,"_30100":70301,"_20891":117583,"_5":14349,"_27386":117273,"_2933":117584},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3450":70415,"_30100":70301,"_20891":117586,"_5":14349,"_27386":117273,"_2933":117587},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3450":70416,"_30100":70301,"_20891":117589,"_5":14349,"_27386":117273,"_2933":117590},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3450":70417,"_30100":70301,"_20891":117592,"_5":14349,"_27386":117277,"_2933":117593},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3450":70418,"_30100":70301,"_20891":117595,"_5":14349,"_27386":117277,"_2933":117596},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3450":70419,"_30100":70301,"_20891":117598,"_5":14349,"_27386":117277,"_2933":117599},[],"acceso completo y de solo lectura a KMS;",{"_3450":70420,"_30100":70301,"_20891":117601,"_5":14349,"_27386":117277,"_2933":117602},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3450":70421,"_30100":70301,"_20891":117604,"_5":14349,"_27386":117277,"_2933":117605},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3450":70422,"_30100":70301,"_20891":117607,"_5":14349,"_27386":117277,"_2933":117608},[],"acceso a la interfaz;",{"_3450":70423,"_30100":70301,"_20891":117610,"_5":14349,"_27386":117277,"_2933":117611},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3450":70424,"_30100":70301,"_20891":117613,"_5":14349,"_27386":117277,"_2933":117614},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3450":70425,"_30100":70301,"_20891":117616,"_5":14349,"_27386":117277,"_2933":117617},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3450":70426,"_30100":70301,"_20891":117619,"_5":14349,"_27386":117281,"_2933":117620},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3450":70427,"_30100":70301,"_20891":117622,"_5":14349,"_27386":117281,"_2933":117623},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3450":70428,"_30100":70301,"_20891":117625,"_5":14349,"_27386":117281,"_2933":117626},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3450":70429,"_30100":70301,"_20891":117628,"_5":14349,"_27386":117284,"_2933":117629},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3450":70430,"_30100":70301,"_20891":117631,"_5":14349,"_27386":117288,"_2933":117632},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3450":70431,"_30100":70301,"_20891":117634,"_5":14349,"_27386":117288,"_2933":117635},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3450":70432,"_30100":70301,"_20891":117637,"_5":14349,"_27386":117292,"_2933":117638},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3450":70433,"_30100":70301,"_20891":117640,"_5":14349,"_27386":117296,"_2933":117641},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3450":70434,"_30100":70301,"_20891":117643,"_5":14349,"_27386":117300,"_2933":117644},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3450":70435,"_30100":70301,"_20891":117646,"_5":14349,"_27386":117304,"_2933":117647},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3450":70436,"_30100":70301,"_20891":117649,"_5":14349,"_27386":117304,"_2933":117650},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3450":70437,"_30100":70301,"_20891":117652,"_5":14349,"_27386":117308,"_2933":117653},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3450":70438,"_30100":70301,"_20891":117655,"_5":14349,"_27386":117308,"_2933":117656},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3450":70439,"_30100":70301,"_20891":117658,"_5":14349,"_27386":117308,"_2933":117659},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3450":70440,"_30100":70301,"_20891":117661,"_5":14349,"_27386":117308,"_2933":117662},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3450":70441,"_30100":70301,"_20891":117664,"_5":14349,"_27386":117308,"_2933":117665},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3450":70442,"_30100":70301,"_20891":117667,"_5":14349,"_27386":117308,"_2933":117668},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3450":70443,"_30100":70301,"_20891":117670,"_5":14349,"_27386":117308,"_2933":117671},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3450":70444,"_30100":70301,"_20891":117673,"_5":14349,"_27386":117308,"_2933":117674},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3450":70445,"_30100":70301,"_20891":117676,"_5":14349,"_27386":117312,"_2933":117677},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3450":70446,"_30100":70301,"_20891":117679,"_5":14349,"_27386":117312,"_2933":117680},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3450":70447,"_30100":70301,"_20891":117682,"_5":14349,"_27386":117312,"_2933":117683},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3450":70448,"_30100":70301,"_20891":117685,"_5":14349,"_27386":117316,"_2933":117686},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3450":70449,"_30100":70301,"_20891":117688,"_5":14349,"_27386":117316,"_2933":117689},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3450":70450,"_30100":70301,"_20891":117691,"_5":14349,"_27386":117316,"_2933":117692},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3450":70451,"_30100":70301,"_20891":117694,"_5":14349,"_27386":117316,"_2933":117695},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3450":70452,"_30100":70301,"_20891":117697,"_5":14349,"_27386":117316,"_2933":117698},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3450":70453,"_30100":70301,"_20891":117700,"_5":14349,"_27386":117316,"_2933":117701},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3450":70454,"_30100":70301,"_20891":117703,"_5":14349,"_27386":117316,"_2933":117704},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3450":70455,"_30100":70301,"_20891":117706,"_5":14349,"_27386":117316,"_2933":117707},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3450":70456,"_30100":70301,"_20891":117709,"_5":14349,"_27386":117324,"_2933":117710},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3450":70457,"_30100":70301,"_20891":117712,"_5":14349,"_27386":117328,"_2933":117713},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3450":70458,"_30100":70301,"_20891":117715,"_5":14349,"_27386":117328,"_2933":117716},[],"que exista un principal activo del tipo correcto;",{"_3450":70459,"_30100":70301,"_20891":117718,"_5":14349,"_27386":117328,"_2933":117719},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3450":70460,"_30100":70301,"_20891":117721,"_5":14349,"_27386":117328,"_2933":117722},[],"que todas las condiciones del principal se cumplan;",{"_3450":70461,"_30100":70301,"_20891":117724,"_5":14349,"_27386":117328,"_2933":117725},[],"que el principal tenga concedida la política esperada;",{"_3450":70462,"_30100":70301,"_20891":117727,"_5":14349,"_27386":117328,"_2933":117728},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3450":70463,"_30100":70301,"_20891":117730,"_5":14349,"_27386":117328,"_2933":117731},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3450":70464,"_30100":70301,"_20891":117733,"_5":14349,"_27386":117328,"_2933":117734},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3450":70465,"_30100":70301,"_20891":117736,"_5":14349,"_27386":117332,"_2933":117737},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3450":70466,"_30100":70301,"_20891":117739,"_5":14349,"_27386":117336,"_2933":117740},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3450":70467,"_30100":70301,"_20891":117742,"_5":14349,"_27386":117340,"_2933":117743},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3450":70468,"_30100":70301,"_20891":117745,"_5":14349,"_27386":117340,"_2933":117746},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3450":70469,"_30100":70469,"_5":14701,"_2933":117748,"_30453":117749,"_20891":117750,"_27386":70469},"Alertas y suscripciones",[49052,117213,117214],[],{"_3450":70470,"_30100":70469,"_20891":117752,"_5":14349,"_27386":70469,"_2933":117753},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3450":70471,"_30100":70469,"_5":30450,"_20891":117755,"_27386":117756,"_2933":117757},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3450":70472,"_30100":70469,"_5":30450,"_20891":117759,"_27386":117760,"_2933":117761},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3450":70473,"_30100":70469,"_5":30450,"_20891":117763,"_27386":117764,"_2933":117765},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3450":70474,"_30100":70469,"_5":30450,"_20891":117767,"_27386":117768,"_2933":117769},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3450":70475,"_30100":70469,"_5":30450,"_20891":117771,"_27386":117772,"_2933":117773},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3450":70476,"_30100":70469,"_5":30450,"_20891":117775,"_27386":117776,"_2933":117777},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3450":70477,"_30100":70469,"_5":30450,"_20891":117779,"_27386":117780,"_2933":117781},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3450":70478,"_30100":70469,"_5":30450,"_20891":117783,"_27386":117784,"_2933":117785},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3450":70479,"_30100":70469,"_5":30450,"_20891":117787,"_27386":117788,"_2933":117789},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3450":70480,"_30100":70469,"_5":30450,"_20891":117791,"_27386":117792,"_2933":117793},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3450":70481,"_30100":70469,"_5":30450,"_20891":117795,"_27386":117796,"_2933":117797},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3450":70482,"_30100":70469,"_20891":117799,"_5":14349,"_27386":70469,"_2933":117800},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3450":70483,"_30100":70469,"_20891":117802,"_5":14349,"_27386":117756,"_2933":117803},[],"Un servicio publica un evento de dominio.",{"_3450":70484,"_30100":70469,"_20891":117805,"_5":14349,"_27386":117756,"_2933":117806},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3450":70485,"_30100":70469,"_20891":117808,"_5":14349,"_27386":117756,"_2933":117809},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3450":70486,"_30100":70469,"_20891":117811,"_5":14349,"_27386":117756,"_2933":117812},[],"Lamassu entrega el evento al canal configurado.",{"_3450":70487,"_30100":70469,"_20891":117814,"_5":14349,"_27386":117756,"_2933":117815},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3450":70488,"_30100":70469,"_20891":117817,"_5":14349,"_27386":117760,"_2933":117818},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3450":70489,"_30100":70469,"_20891":117820,"_5":14349,"_27386":117760,"_2933":117821},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3450":70490,"_30100":70469,"_20891":117823,"_5":14349,"_27386":117760,"_2933":117824},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3450":70491,"_30100":70469,"_20891":117826,"_5":14349,"_27386":117760,"_2933":117827},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3450":70492,"_30100":70469,"_20891":117829,"_5":14349,"_27386":117760,"_2933":117830},[],"`apikey_options` necesita `header` y `key`.",{"_3450":70493,"_30100":70469,"_20891":117832,"_5":14349,"_27386":117760,"_2933":117833},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3450":70494,"_30100":70469,"_20891":117835,"_5":14349,"_27386":117760,"_2933":117836},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3450":70495,"_30100":70469,"_20891":117838,"_5":14349,"_27386":117760,"_2933":117839},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3450":70496,"_30100":70469,"_20891":117841,"_5":14349,"_27386":117768,"_2933":117842},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3450":70497,"_30100":70469,"_20891":117844,"_5":14349,"_27386":117772,"_2933":117845},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3450":70498,"_30100":70469,"_20891":117847,"_5":14349,"_27386":117776,"_2933":117848},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3450":70499,"_30100":70469,"_20891":117850,"_5":14349,"_27386":117776,"_2933":117851},[],"**None** notifica todas las instancias del evento.",{"_3450":70500,"_30100":70469,"_20891":117853,"_5":14349,"_27386":117776,"_2933":117854},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3450":70501,"_30100":70469,"_20891":117856,"_5":14349,"_27386":117776,"_2933":117857},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3450":70502,"_30100":70469,"_20891":117859,"_5":14349,"_27386":117776,"_2933":117860},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3450":70503,"_30100":70469,"_20891":117862,"_5":14349,"_27386":117776,"_2933":117863},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3450":70504,"_30100":70469,"_20891":117865,"_5":14349,"_27386":117776,"_2933":117866},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3450":70505,"_30100":70469,"_20891":117868,"_5":14349,"_27386":117780,"_2933":117869},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3450":70506,"_30100":70469,"_20891":117871,"_5":14349,"_27386":117784,"_2933":117872},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3450":70507,"_30100":70469,"_20891":117874,"_5":14349,"_27386":117784,"_2933":117875},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3450":70508,"_30100":70469,"_20891":117877,"_5":14349,"_27386":117784,"_2933":117878},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3450":70509,"_30100":70469,"_20891":117880,"_5":14349,"_27386":117784,"_2933":117881},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3450":70510,"_30100":70469,"_20891":117883,"_5":14349,"_27386":117784,"_2933":117884},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3450":70511,"_30100":70469,"_20891":117886,"_5":14349,"_27386":117784,"_2933":117887},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3450":70512,"_30100":70469,"_20891":117889,"_5":14349,"_27386":117784,"_2933":117890},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3450":70513,"_30100":70469,"_20891":117892,"_5":14349,"_27386":117784,"_2933":117893},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3450":70514,"_30100":70469,"_20891":117895,"_5":14349,"_27386":117788,"_2933":117896},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3450":70515,"_30100":70469,"_20891":117898,"_5":14349,"_27386":117788,"_2933":117899},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3450":70516,"_30100":70469,"_20891":117901,"_5":14349,"_27386":117788,"_2933":117902},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3450":70517,"_30100":70469,"_20891":117904,"_5":14349,"_27386":117788,"_2933":117905},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3450":70518,"_30100":70469,"_20891":117907,"_5":14349,"_27386":117788,"_2933":117908},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3450":70519,"_30100":70469,"_20891":117910,"_5":14349,"_27386":117788,"_2933":117911},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3450":70520,"_30100":70469,"_20891":117913,"_5":14349,"_27386":117788,"_2933":117914},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3450":70521,"_30100":70469,"_20891":117916,"_5":14349,"_27386":117788,"_2933":117917},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3450":70522,"_30100":70469,"_20891":117919,"_5":14349,"_27386":117792,"_2933":117920},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3450":70523,"_30100":70469,"_20891":117922,"_5":14349,"_27386":117792,"_2933":117923},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3450":70524,"_30100":70469,"_20891":117925,"_5":14349,"_27386":117796,"_2933":117926},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3450":70525,"_30100":70469,"_20891":117928,"_5":14349,"_27386":117796,"_2933":117929},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3450":70526,"_30100":70469,"_20891":117931,"_5":14349,"_27386":117796,"_2933":117932},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3450":70527,"_30100":70469,"_20891":117934,"_5":14349,"_27386":117796,"_2933":117935},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3450":70528,"_30100":70469,"_20891":117937,"_5":14349,"_27386":117796,"_2933":117938},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3450":70529,"_30100":70469,"_20891":117940,"_5":14349,"_27386":117796,"_2933":117941},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3450":70530,"_30100":70469,"_20891":117943,"_5":14349,"_27386":117796,"_2933":117944},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3450":70531,"_30100":70469,"_20891":117946,"_5":14349,"_27386":117796,"_2933":117947},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3450":70532,"_30100":70469,"_20891":117949,"_5":14349,"_27386":117796,"_2933":117950},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3450":70533,"_30100":70533,"_5":14701,"_2933":117952,"_30453":117953,"_20891":117954,"_27386":70533},"Registros de auditoría",[49052,117213,117214],[],{"_3450":70534,"_30100":70533,"_20891":117956,"_5":14349,"_27386":70533,"_2933":117957},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3450":70535,"_30100":70533,"_5":30450,"_20891":117959,"_27386":117960,"_2933":117961},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3450":70536,"_30100":70533,"_5":30450,"_20891":117963,"_27386":117964,"_2933":117965},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3450":70537,"_30100":70533,"_5":30450,"_20891":117967,"_27386":117968,"_2933":117969},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3450":70538,"_30100":70533,"_5":30450,"_20891":117971,"_27386":117972,"_2933":117973},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3450":70539,"_30100":70533,"_5":30450,"_20891":117975,"_27386":117976,"_2933":117977},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3450":70540,"_30100":70533,"_5":30450,"_20891":117979,"_27386":117980,"_2933":117981},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3450":70541,"_30100":70533,"_5":30450,"_20891":117983,"_27386":117984,"_2933":117985},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3450":70542,"_30100":70533,"_5":30450,"_20891":117987,"_27386":117988,"_2933":117989},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3450":70543,"_30100":70533,"_5":30450,"_20891":117991,"_27386":117992,"_2933":117993},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3450":70544,"_30100":70533,"_5":30450,"_20891":117995,"_27386":117996,"_2933":117997},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3450":70545,"_30100":70533,"_5":30450,"_20891":117999,"_27386":118000,"_2933":118001},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3450":70546,"_30100":70533,"_20891":118003,"_5":14349,"_27386":70533,"_2933":118004},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3450":70547,"_30100":70533,"_20891":118006,"_5":14349,"_27386":117960,"_2933":118007},[],"El cuerpo de auditoría incluye:",{"_3450":70548,"_30100":70533,"_20891":118009,"_5":14349,"_27386":117960,"_2933":118010},[],"input: datos recibidos por la operación;",{"_3450":70549,"_30100":70533,"_20891":118012,"_5":14349,"_27386":117960,"_2933":118013},[],"has\\_error: indica si el servicio devolvió un error;",{"_3450":70550,"_30100":70533,"_20891":118015,"_5":14349,"_27386":117960,"_2933":118016},[],"output: resultado producido o mensaje de error;",{"_3450":70551,"_30100":70533,"_20891":118018,"_5":14349,"_27386":117960,"_2933":118019},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3450":70552,"_30100":70533,"_20891":118021,"_5":14349,"_27386":117960,"_2933":118022},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3450":70553,"_30100":70533,"_20891":118024,"_5":14349,"_27386":117960,"_2933":118025},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3450":70554,"_30100":70533,"_20891":118027,"_5":14349,"_27386":117964,"_2933":118028},[],"El backend aplica auditoría a mutaciones de:",{"_3450":70555,"_30100":70533,"_20891":118030,"_5":14349,"_27386":117964,"_2933":118031},[],"autoridades, certificados y perfiles de emisión;",{"_3450":70556,"_30100":70533,"_20891":118033,"_5":14349,"_27386":117964,"_2933":118034},[],"claves y motores KMS;",{"_3450":70557,"_30100":70533,"_20891":118036,"_5":14349,"_27386":117964,"_2933":118037},[],"dispositivos e identidades;",{"_3450":70558,"_30100":70533,"_20891":118039,"_5":14349,"_27386":117964,"_2933":118040},[],"DMS y operaciones de enrolamiento;",{"_3450":70559,"_30100":70533,"_20891":118042,"_5":14349,"_27386":117964,"_2933":118043},[],"funciones de validación y CRL;",{"_3450":70560,"_30100":70533,"_20891":118045,"_5":14349,"_27386":117964,"_2933":118046},[],"principales, políticas y concesiones de autorización.",{"_3450":70561,"_30100":70533,"_20891":118048,"_5":14349,"_27386":117964,"_2933":118049},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3450":70562,"_30100":70533,"_20891":118051,"_5":14349,"_27386":117968,"_2933":118052},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3450":70563,"_30100":70533,"_20891":118054,"_5":14349,"_27386":117968,"_2933":118055},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3450":70564,"_30100":70533,"_20891":118057,"_5":14349,"_27386":117968,"_2933":118058},[],"Diseña el consumidor para:",{"_3450":70565,"_30100":70533,"_20891":118060,"_5":14349,"_27386":117968,"_2933":118061},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3450":70566,"_30100":70533,"_20891":118063,"_5":14349,"_27386":117968,"_2933":118064},[],"conservar el CloudEvent completo sin modificar;",{"_3450":70567,"_30100":70533,"_20891":118066,"_5":14349,"_27386":117968,"_2933":118067},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3450":70568,"_30100":70533,"_20891":118069,"_5":14349,"_27386":117968,"_2933":118070},[],"cifrar en tránsito y en reposo;",{"_3450":70569,"_30100":70533,"_20891":118072,"_5":14349,"_27386":117968,"_2933":118073},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3450":70570,"_30100":70533,"_20891":118075,"_5":14349,"_27386":117968,"_2933":118076},[],"aplicar una política explícita de retención y legal hold;",{"_3450":70571,"_30100":70533,"_20891":118078,"_5":14349,"_27386":117968,"_2933":118079},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3450":70572,"_30100":70533,"_20891":118081,"_5":14349,"_27386":117972,"_2933":118082},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3450":70573,"_30100":70533,"_20891":118084,"_5":14349,"_27386":117972,"_2933":118085},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3450":70574,"_30100":70533,"_20891":118087,"_5":14349,"_27386":117980,"_2933":118088},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3450":70575,"_30100":70533,"_20891":118090,"_5":14349,"_27386":117984,"_2933":118091},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3450":70576,"_30100":70533,"_20891":118093,"_5":14349,"_27386":117988,"_2933":118094},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3450":70577,"_30100":70533,"_20891":118096,"_5":14349,"_27386":117992,"_2933":118097},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3450":70578,"_30100":70533,"_20891":118099,"_5":14349,"_27386":117996,"_2933":118100},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3450":70579,"_30100":70533,"_20891":118102,"_5":14349,"_27386":118000,"_2933":118103},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3450":70580,"_30100":70533,"_20891":118105,"_5":14349,"_27386":118000,"_2933":118106},[],"aparece un evento de auditoría correcto;",{"_3450":70581,"_30100":70533,"_20891":118108,"_5":14349,"_27386":118000,"_2933":118109},[],"el principal coincide con la identidad utilizada;",{"_3450":70582,"_30100":70533,"_20891":118111,"_5":14349,"_27386":118000,"_2933":118112},[],"el consumidor lo persiste una sola vez;",{"_3450":70583,"_30100":70533,"_20891":118114,"_5":14349,"_27386":118000,"_2933":118115},[],"puede recuperarse por recurso, actor y periodo;",{"_3450":70584,"_30100":70533,"_20891":118117,"_5":14349,"_27386":118000,"_2933":118118},[],"una interrupción del consumidor produce una alerta.",{"_3450":70585,"_30100":70533,"_20891":118120,"_5":14349,"_27386":118000,"_2933":118121},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3450":70586,"_30100":70586,"_5":14701,"_2933":118123,"_30453":118124,"_20891":118125,"_27386":70586},"Arquitectura de la plataforma",[49052,117213],[],{"_3450":70587,"_30100":70586,"_20891":118127,"_5":14349,"_27386":70586,"_2933":118128},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3450":70588,"_30100":70586,"_5":30450,"_20891":118130,"_27386":118131,"_2933":118132},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3450":70589,"_30100":70586,"_5":30450,"_20891":118134,"_27386":118135,"_2933":118136},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3450":70590,"_30100":70586,"_5":30450,"_20891":118138,"_27386":118139,"_2933":118140},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3450":70591,"_30100":70586,"_5":30450,"_20891":118142,"_27386":118143,"_2933":118144},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3450":70592,"_30100":70586,"_5":30450,"_20891":118146,"_27386":118147,"_2933":118148},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3450":70593,"_30100":70586,"_20891":118150,"_5":14349,"_27386":70586,"_2933":118151},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3450":70594,"_30100":70586,"_20891":118153,"_5":14349,"_27386":70586,"_2933":118154},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3450":70595,"_30100":70586,"_20891":118156,"_5":14349,"_27386":118131,"_2933":118157},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3450":70596,"_30100":70586,"_20891":118159,"_5":14349,"_27386":118135,"_2933":118160},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3450":70597,"_30100":70586,"_20891":118162,"_5":14349,"_27386":118139,"_2933":118163},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3450":70598,"_30100":70586,"_20891":118165,"_5":14349,"_27386":118143,"_2933":118166},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3450":70599,"_30100":70586,"_20891":118168,"_5":14349,"_27386":118147,"_2933":118169},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3450":70600,"_30100":70600,"_5":14701,"_2933":118171,"_30453":118172,"_20891":118173,"_27386":70600},"Cómo funciona Lamassu",[49052,117213],[],{"_3450":70601,"_30100":70600,"_20891":118175,"_5":14349,"_27386":70600,"_2933":118176},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3450":70602,"_30100":70600,"_5":30450,"_20891":118178,"_27386":118179,"_2933":118180},[],"/docs/pr-preview/pr-61/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3450":70603,"_30100":70600,"_5":30450,"_20891":118182,"_27386":118183,"_2933":118184},[],"/docs/pr-preview/pr-61/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3450":70604,"_30100":70600,"_20891":118186,"_5":14349,"_27386":70600,"_2933":118187},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3450":70605,"_30100":70600,"_20891":118189,"_5":14349,"_27386":118179,"_2933":118190},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3450":70606,"_30100":70600,"_20891":118192,"_5":14349,"_27386":118179,"_2933":118193},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3450":70607,"_30100":70600,"_20891":118195,"_5":14349,"_27386":118179,"_2933":118196},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3450":70608,"_30100":70600,"_20891":118198,"_5":14349,"_27386":118179,"_2933":118199},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3450":70609,"_30100":70600,"_20891":118201,"_5":14349,"_27386":118179,"_2933":118202},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3450":70610,"_30100":70600,"_20891":118204,"_5":14349,"_27386":118183,"_2933":118205},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3450":70611,"_30100":70600,"_20891":118207,"_5":14349,"_27386":118183,"_2933":118208},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3450":70612,"_30100":70600,"_20891":118210,"_5":14349,"_27386":118183,"_2933":118211},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3450":70613,"_30100":70600,"_20891":118213,"_5":14349,"_27386":118183,"_2933":118214},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3450":70614,"_30100":70600,"_20891":118216,"_5":14349,"_27386":118183,"_2933":118217},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3450":70615,"_30100":70600,"_20891":118219,"_5":14349,"_27386":118183,"_2933":118220},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3450":70616,"_30100":70600,"_20891":118222,"_5":14349,"_27386":118183,"_2933":118223},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3450":70617,"_30100":70617,"_5":14701,"_2933":118225,"_30453":118226,"_20891":118227,"_27386":70617},"Dispositivos e identidades",[49052,117213,51534,118225],[],{"_3450":70618,"_30100":70617,"_20891":118229,"_5":14349,"_27386":70617,"_2933":118230},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3450":70619,"_30100":70617,"_5":30450,"_20891":118232,"_27386":118233,"_2933":118234},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3450":70620,"_30100":70617,"_5":30450,"_20891":118236,"_27386":118237,"_2933":118238},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3450":70621,"_30100":70617,"_5":30450,"_20891":118240,"_27386":118241,"_2933":118242},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3450":70622,"_30100":70617,"_5":30450,"_20891":118244,"_27386":118245,"_2933":118246},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3450":70623,"_30100":70617,"_5":30450,"_20891":118248,"_27386":118249,"_2933":118250},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3450":70624,"_30100":70617,"_5":30450,"_20891":118252,"_27386":118253,"_2933":118254},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3450":70625,"_30100":70617,"_5":30450,"_20891":118256,"_27386":118257,"_2933":118258},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3450":70626,"_30100":70617,"_5":30450,"_20891":118260,"_27386":118261,"_2933":118262},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3450":70627,"_30100":70617,"_5":30450,"_20891":118264,"_27386":118265,"_2933":118266},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3450":70628,"_30100":70617,"_5":30450,"_20891":118268,"_27386":118269,"_2933":118270},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3450":70629,"_30100":70617,"_5":30450,"_20891":118272,"_27386":118273,"_2933":118274},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3450":70630,"_30100":70617,"_20891":118276,"_5":14349,"_27386":70617,"_2933":118277},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3450":70631,"_30100":70617,"_20891":118279,"_5":14349,"_27386":70617,"_2933":118280},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3450":70632,"_30100":70617,"_20891":118282,"_5":14349,"_27386":118233,"_2933":118283},[],"Vista operativa",{"_3450":70633,"_30100":70617,"_20891":118285,"_5":14349,"_27386":118233,"_2933":118286},[],"Interpretación",{"_3450":70634,"_30100":70617,"_20891":118288,"_5":14349,"_27386":118233,"_2933":51597},[],{"_3450":70635,"_30100":70617,"_20891":118290,"_5":14349,"_27386":118233,"_2933":118291},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3450":70636,"_30100":70617,"_20891":118293,"_5":14349,"_27386":118233,"_2933":51603},[],{"_3450":70637,"_30100":70617,"_20891":118295,"_5":14349,"_27386":118233,"_2933":118296},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3450":70638,"_30100":70617,"_20891":118298,"_5":14349,"_27386":118233,"_2933":51609},[],{"_3450":70639,"_30100":70617,"_20891":118300,"_5":14349,"_27386":118233,"_2933":118301},[],"La identidad está en la ventana operativa de renovación.",{"_3450":70640,"_30100":70617,"_20891":118303,"_5":14349,"_27386":118233,"_2933":51615},[],{"_3450":70641,"_30100":70617,"_20891":118305,"_5":14349,"_27386":118233,"_2933":118306},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3450":70642,"_30100":70617,"_20891":118308,"_5":14349,"_27386":118233,"_2933":51621},[],{"_3450":70643,"_30100":70617,"_20891":118310,"_5":14349,"_27386":118233,"_2933":118311},[],"La identidad ha vencido.",{"_3450":70644,"_30100":70617,"_20891":118313,"_5":14349,"_27386":118233,"_2933":51627},[],{"_3450":70645,"_30100":70617,"_20891":118315,"_5":14349,"_27386":118233,"_2933":118316},[],"La identidad está marcada como revocada.",{"_3450":70646,"_30100":70617,"_20891":118318,"_5":14349,"_27386":118233,"_2933":51633},[],{"_3450":70647,"_30100":70617,"_20891":118320,"_5":14349,"_27386":118233,"_2933":118321},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3450":70648,"_30100":70617,"_20891":118323,"_5":14349,"_27386":118233,"_2933":118324},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3450":70649,"_30100":70617,"_20891":118326,"_5":14349,"_27386":118237,"_2933":118327},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3450":70650,"_30100":70617,"_20891":118329,"_5":14349,"_27386":118237,"_2933":118330},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3450":70651,"_30100":70617,"_20891":118332,"_5":14349,"_27386":118237,"_2933":118333},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3450":70652,"_30100":70617,"_20891":118335,"_5":14349,"_27386":118237,"_2933":118336},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3450":70653,"_30100":70617,"_20891":118338,"_5":14349,"_27386":118241,"_2933":118339},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3450":70654,"_30100":70617,"_20891":118341,"_5":14349,"_27386":118245,"_2933":118342},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3450":70655,"_30100":70617,"_20891":118344,"_5":14349,"_27386":118249,"_2933":118345},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3450":70656,"_30100":70617,"_20891":118347,"_5":14349,"_27386":118253,"_2933":118348},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3450":70657,"_30100":70617,"_20891":118350,"_5":14349,"_27386":118257,"_2933":118351},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3450":70658,"_30100":70617,"_20891":118353,"_5":14349,"_27386":118257,"_2933":118354},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3450":70659,"_30100":70617,"_20891":118356,"_5":14349,"_27386":118261,"_2933":118357},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3450":70660,"_30100":70617,"_20891":118359,"_5":14349,"_27386":118261,"_2933":118360},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3450":70661,"_30100":70617,"_20891":118362,"_5":14349,"_27386":118261,"_2933":118363},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3450":70662,"_30100":70617,"_20891":118365,"_5":14349,"_27386":118261,"_2933":118366},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3450":70663,"_30100":70617,"_20891":118368,"_5":14349,"_27386":118261,"_2933":118369},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3450":70664,"_30100":70617,"_20891":118371,"_5":14349,"_27386":118261,"_2933":118372},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3450":70665,"_30100":70617,"_20891":118374,"_5":14349,"_27386":118265,"_2933":118375},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3450":70666,"_30100":70617,"_20891":118377,"_5":14349,"_27386":118265,"_2933":118378},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3450":70667,"_30100":70617,"_20891":118380,"_5":14349,"_27386":118269,"_2933":118381},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3450":70668,"_30100":70617,"_20891":118383,"_5":14349,"_27386":118269,"_2933":118384},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3450":70669,"_30100":70617,"_20891":118386,"_5":14349,"_27386":118269,"_2933":118387},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3450":70670,"_30100":70617,"_20891":118389,"_5":14349,"_27386":118269,"_2933":118390},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3450":70671,"_30100":70617,"_20891":118392,"_5":14349,"_27386":118273,"_2933":118393},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3450":70672,"_30100":70617,"_20891":118395,"_5":14349,"_27386":118273,"_2933":118396},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3450":70673,"_30100":70673,"_5":14701,"_2933":118398,"_30453":118399,"_20891":118401,"_27386":70673},"Identidad inicial y autenticación",[49052,117213,51534,118225,118400],"Enrolamiento con PKI",[],{"_3450":70674,"_30100":70673,"_20891":118403,"_5":14349,"_27386":70673,"_2933":118404},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3450":70675,"_30100":70673,"_5":30450,"_20891":118406,"_27386":118407,"_2933":118408},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3450":70676,"_30100":70673,"_5":30450,"_20891":118410,"_27386":118411,"_2933":118412},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3450":70677,"_30100":70673,"_5":30450,"_20891":118414,"_27386":118415,"_2933":118416},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3450":70678,"_30100":70673,"_5":30450,"_20891":118418,"_27386":118419,"_2933":118420},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3450":70679,"_30100":70673,"_5":30450,"_20891":118422,"_27386":118423,"_2933":118424},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3450":70680,"_30100":70673,"_20891":118426,"_5":14349,"_27386":70673,"_2933":118427},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3450":70681,"_30100":70673,"_20891":118429,"_5":14349,"_27386":118407,"_2933":118430},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3450":70682,"_30100":70673,"_20891":118432,"_5":14349,"_27386":118407,"_2933":118433},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3450":70683,"_30100":70673,"_20891":118435,"_5":14349,"_27386":118411,"_2933":118436},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3450":70684,"_30100":70673,"_20891":118438,"_5":14349,"_27386":118411,"_2933":118439},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3450":70685,"_30100":70673,"_20891":118441,"_5":14349,"_27386":118411,"_2933":118442},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3450":70686,"_30100":70673,"_20891":118444,"_5":14349,"_27386":118415,"_2933":118445},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3450":70687,"_30100":70673,"_20891":118447,"_5":14349,"_27386":118415,"_2933":118448},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3450":70688,"_30100":70673,"_20891":118450,"_5":14349,"_27386":118419,"_2933":118451},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3450":70689,"_30100":70673,"_20891":118453,"_5":14349,"_27386":118419,"_2933":118454},[],"Ejemplo de cuerpo:",{"_3450":70690,"_30100":70673,"_20891":118456,"_5":14349,"_27386":118419,"_2933":118457},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3450":70691,"_30100":70673,"_20891":118459,"_5":14349,"_27386":118419,"_2933":118460},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3450":70692,"_30100":70673,"_20891":118462,"_5":14349,"_27386":118419,"_2933":118463},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3450":70693,"_30100":70673,"_20891":118465,"_5":14349,"_27386":118419,"_2933":118466},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3450":70694,"_30100":70673,"_20891":118468,"_5":14349,"_27386":118423,"_2933":118469},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3450":70695,"_30100":70673,"_20891":118471,"_5":14349,"_27386":118423,"_2933":118472},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3450":70696,"_30100":70696,"_5":14701,"_2933":118474,"_30453":118475,"_20891":118476,"_27386":70696},"Configura y opera el DMS",[49052,117213,51534,118225,118400],[],{"_3450":70697,"_30100":70696,"_20891":118478,"_5":14349,"_27386":70696,"_2933":118479},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3450":70698,"_30100":70696,"_5":30450,"_20891":118481,"_27386":118482,"_2933":115791},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3450":70699,"_30100":70696,"_5":30450,"_20891":118484,"_27386":118485,"_2933":118486},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3450":70700,"_30100":70696,"_5":30450,"_20891":118488,"_27386":118489,"_2933":118490},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3450":70701,"_30100":70696,"_5":30450,"_20891":118492,"_27386":118493,"_2933":118494},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3450":70702,"_30100":70696,"_5":30450,"_20891":118496,"_27386":118497,"_2933":118498},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3450":70703,"_30100":70696,"_5":30450,"_20891":118500,"_27386":118501,"_2933":118502},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3450":70704,"_30100":70696,"_5":30450,"_20891":118504,"_27386":118505,"_2933":118506},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3450":70705,"_30100":70696,"_5":30450,"_20891":118508,"_27386":118509,"_2933":118510},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3450":70706,"_30100":70696,"_5":30450,"_20891":118512,"_27386":118513,"_2933":51829},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3450":70707,"_30100":70696,"_5":30450,"_20891":118515,"_27386":118516,"_2933":51833},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3450":70708,"_30100":70696,"_5":30450,"_20891":118518,"_27386":118519,"_2933":118520},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3450":70709,"_30100":70696,"_5":30450,"_20891":118522,"_27386":118523,"_2933":118524},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3450":70710,"_30100":70696,"_5":30450,"_20891":118526,"_27386":118527,"_2933":118528},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3450":70711,"_30100":70696,"_5":30450,"_20891":118530,"_27386":118531,"_2933":118532},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3450":70712,"_30100":70696,"_5":30450,"_20891":118534,"_27386":118535,"_2933":51853},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3450":70713,"_30100":70696,"_5":30450,"_20891":118537,"_27386":118538,"_2933":118539},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3450":70714,"_30100":70696,"_5":30450,"_20891":118541,"_27386":118542,"_2933":118543},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3450":70715,"_30100":70696,"_5":30450,"_20891":118545,"_27386":118546,"_2933":118547},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3450":70716,"_30100":70696,"_20891":118549,"_5":14349,"_27386":70696,"_2933":118550},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3450":70717,"_30100":70696,"_20891":118552,"_5":14349,"_27386":118482,"_2933":118553},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3450":70718,"_30100":70696,"_20891":118555,"_5":14349,"_27386":118482,"_2933":118556},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3450":70719,"_30100":70696,"_20891":118558,"_5":14349,"_27386":118485,"_2933":118559},[],"Sigue el recorrido interactivo para configurar un DMS para EST. El ejemplo establece **Name** en `DMS Showcase`, de donde se deriva el identificador `dms-showcase` usado en las URLs EST, y selecciona dos CAs preparadas de antemano: **DMS Enrollment CA** firma las identidades de los dispositivos y **DMS Bootstrap CA** valida la credencial inicial. Los valores son de este ejemplo; usa nombres y CAs apropiados para tu flota.",{"_3450":70720,"_30100":70696,"_20891":118561,"_5":14349,"_27386":118489,"_2933":118562},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3450":70721,"_30100":70696,"_20891":118564,"_5":14349,"_27386":118493,"_2933":118565},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3450":70722,"_30100":70696,"_20891":118567,"_5":14349,"_27386":118497,"_2933":118568},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3450":70723,"_30100":70696,"_20891":118570,"_5":14349,"_27386":118501,"_2933":118571},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3450":70724,"_30100":70696,"_20891":118573,"_5":14349,"_27386":118505,"_2933":118574},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3450":70725,"_30100":70696,"_20891":118576,"_5":14349,"_27386":118513,"_2933":118577},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3450":70726,"_30100":70696,"_20891":118579,"_5":14349,"_27386":118513,"_2933":118580},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3450":70727,"_30100":70696,"_20891":118582,"_5":14349,"_27386":118516,"_2933":118583},[],"Campo de `settings.enrollment_settings`",{"_3450":70728,"_30100":70696,"_20891":118585,"_5":14349,"_27386":118516,"_2933":118586},[],"Decisión",{"_3450":70729,"_30100":70696,"_20891":118588,"_5":14349,"_27386":118516,"_2933":51907},[],{"_3450":70730,"_30100":70696,"_20891":118590,"_5":14349,"_27386":118516,"_2933":118591},[],"`EST_RFC7030` para estas operaciones.",{"_3450":70731,"_30100":70696,"_20891":118593,"_5":14349,"_27386":118516,"_2933":51913},[],{"_3450":70732,"_30100":70696,"_20891":118595,"_5":14349,"_27386":118516,"_2933":118596},[],"ID de la CA que firmará.",{"_3450":70733,"_30100":70696,"_20891":118598,"_5":14349,"_27386":118516,"_2933":51919},[],{"_3450":70734,"_30100":70696,"_20891":118600,"_5":14349,"_27386":118516,"_2933":118601},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3450":70735,"_30100":70696,"_20891":118603,"_5":14349,"_27386":118516,"_2933":51925},[],{"_3450":70736,"_30100":70696,"_20891":118605,"_5":14349,"_27386":118516,"_2933":118606},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3450":70737,"_30100":70696,"_20891":118608,"_5":14349,"_27386":118516,"_2933":51931},[],{"_3450":70738,"_30100":70696,"_20891":118610,"_5":14349,"_27386":118516,"_2933":118611},[],"Uno de los cuatro modos de autenticación.",{"_3450":70739,"_30100":70696,"_20891":118613,"_5":14349,"_27386":118516,"_2933":118614},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3450":70740,"_30100":70696,"_20891":118616,"_5":14349,"_27386":118519,"_2933":118617},[],"Los bloques son independientes:",{"_3450":70741,"_30100":70696,"_20891":118619,"_5":14349,"_27386":118519,"_2933":118620},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3450":70742,"_30100":70696,"_20891":118622,"_5":14349,"_27386":118519,"_2933":118623},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3450":70743,"_30100":70696,"_20891":118625,"_5":14349,"_27386":118519,"_2933":51949},[],{"_3450":70744,"_30100":70696,"_20891":118627,"_5":14349,"_27386":118519,"_2933":118628},[],"Control aplicado en la operación configurada",{"_3450":70745,"_30100":70696,"_20891":118630,"_5":14349,"_27386":118519,"_2933":51955},[],{"_3450":70746,"_30100":70696,"_20891":118632,"_5":14349,"_27386":118519,"_2933":118633},[],"Validación del certificado presentado.",{"_3450":70747,"_30100":70696,"_20891":118635,"_5":14349,"_27386":118519,"_2933":51961},[],{"_3450":70748,"_30100":70696,"_20891":118637,"_5":14349,"_27386":118519,"_2933":118638},[],"Autorización del webhook configurado.",{"_3450":70749,"_30100":70696,"_20891":118640,"_5":14349,"_27386":118519,"_2933":51967},[],{"_3450":70750,"_30100":70696,"_20891":118642,"_5":14349,"_27386":118519,"_2933":118643},[],"Validación del certificado y, después, aprobación del webhook.",{"_3450":70751,"_30100":70696,"_20891":118645,"_5":14349,"_27386":118519,"_2933":51973},[],{"_3450":70752,"_30100":70696,"_20891":118647,"_5":14349,"_27386":118519,"_2933":118648},[],"Sin autenticación del solicitante por el DMS.",{"_3450":70753,"_30100":70696,"_20891":118650,"_5":14349,"_27386":118519,"_2933":118651},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3450":70754,"_30100":70696,"_20891":118653,"_5":14349,"_27386":118519,"_2933":118654},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3450":70755,"_30100":70696,"_20891":118656,"_5":14349,"_27386":118519,"_2933":118657},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3450":70756,"_30100":70696,"_20891":118659,"_5":14349,"_27386":118519,"_2933":118660},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3450":70757,"_30100":70696,"_20891":118662,"_5":14349,"_27386":118523,"_2933":118663},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3450":70758,"_30100":70696,"_20891":118665,"_5":14349,"_27386":118523,"_2933":118666},[],"Campo de `external_webhook_settings`",{"_3450":70759,"_30100":70696,"_20891":118668,"_5":14349,"_27386":118523,"_2933":118586},[],{"_3450":70760,"_30100":70696,"_20891":118670,"_5":14349,"_27386":118523,"_2933":51999},[],{"_3450":70761,"_30100":70696,"_20891":118672,"_5":14349,"_27386":118523,"_2933":118673},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3450":70762,"_30100":70696,"_20891":118675,"_5":14349,"_27386":118523,"_2933":52005},[],{"_3450":70763,"_30100":70696,"_20891":118677,"_5":14349,"_27386":118523,"_2933":118678},[],"`POST` o `PUT`; `POST` por defecto.",{"_3450":70764,"_30100":70696,"_20891":118680,"_5":14349,"_27386":118523,"_2933":52011},[],{"_3450":70765,"_30100":70696,"_20891":118682,"_5":14349,"_27386":118523,"_2933":118683},[],"Etiqueta usada en los logs del servicio.",{"_3450":70766,"_30100":70696,"_20891":118685,"_5":14349,"_27386":118523,"_2933":52017},[],{"_3450":70767,"_30100":70696,"_20891":118687,"_5":14349,"_27386":118523,"_2933":118688},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3450":70768,"_30100":70696,"_20891":118690,"_5":14349,"_27386":118523,"_2933":52023},[],{"_3450":70769,"_30100":70696,"_20891":118692,"_5":14349,"_27386":118523,"_2933":118693},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3450":70770,"_30100":70696,"_20891":118695,"_5":14349,"_27386":118523,"_2933":52029},[],{"_3450":70771,"_30100":70696,"_20891":118697,"_5":14349,"_27386":118523,"_2933":118698},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3450":70772,"_30100":70696,"_20891":118700,"_5":14349,"_27386":118523,"_2933":52035},[],{"_3450":70773,"_30100":70696,"_20891":118702,"_5":14349,"_27386":118523,"_2933":118703},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3450":70774,"_30100":70696,"_20891":118705,"_5":14349,"_27386":118523,"_2933":52041},[],{"_3450":70775,"_30100":70696,"_20891":118707,"_5":14349,"_27386":118523,"_2933":118708},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3450":70776,"_30100":70696,"_20891":118710,"_5":14349,"_27386":118523,"_2933":52047},[],{"_3450":70777,"_30100":70696,"_20891":118712,"_5":14349,"_27386":118523,"_2933":118713},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3450":70778,"_30100":70696,"_20891":118715,"_5":14349,"_27386":118523,"_2933":52053},[],{"_3450":70779,"_30100":70696,"_20891":118717,"_5":14349,"_27386":118523,"_2933":118718},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3450":70780,"_30100":70696,"_20891":118720,"_5":14349,"_27386":118523,"_2933":118721},[],"Reglas de esa configuración:",{"_3450":70781,"_30100":70696,"_20891":118723,"_5":14349,"_27386":118523,"_2933":118724},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3450":70782,"_30100":70696,"_20891":118726,"_5":14349,"_27386":118523,"_2933":118727},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3450":70783,"_30100":70696,"_20891":118729,"_5":14349,"_27386":118523,"_2933":118730},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3450":70784,"_30100":70696,"_20891":118732,"_5":14349,"_27386":118523,"_2933":118733},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3450":70785,"_30100":70696,"_20891":118735,"_5":14349,"_27386":118523,"_2933":118736},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3450":70786,"_30100":70696,"_20891":118738,"_5":14349,"_27386":118523,"_2933":118739},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3450":70787,"_30100":70696,"_20891":118741,"_5":14349,"_27386":118523,"_2933":118742},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3450":70788,"_30100":70696,"_20891":118744,"_5":14349,"_27386":118523,"_2933":118745},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3450":70789,"_30100":70696,"_20891":118747,"_5":14349,"_27386":118523,"_2933":118748},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3450":70790,"_30100":70696,"_20891":118750,"_5":14349,"_27386":118527,"_2933":118751},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3450":70791,"_30100":70696,"_20891":118753,"_5":14349,"_27386":118531,"_2933":118754},[],"Campo de `settings.reenrollment_settings`",{"_3450":70792,"_30100":70696,"_20891":118756,"_5":14349,"_27386":118531,"_2933":118757},[],"Función",{"_3450":70793,"_30100":70696,"_20891":118759,"_5":14349,"_27386":118531,"_2933":52097},[],{"_3450":70794,"_30100":70696,"_20891":118761,"_5":14349,"_27386":118531,"_2933":118762},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3450":70795,"_30100":70696,"_20891":118764,"_5":14349,"_27386":118531,"_2933":52103},[],{"_3450":70796,"_30100":70696,"_20891":118766,"_5":14349,"_27386":118531,"_2933":118767},[],"Umbral operativo preventivo de monitorización.",{"_3450":70797,"_30100":70696,"_20891":118769,"_5":14349,"_27386":118531,"_2933":52109},[],{"_3450":70798,"_30100":70696,"_20891":118771,"_5":14349,"_27386":118531,"_2933":118772},[],"Umbral operativo crítico de monitorización.",{"_3450":70799,"_30100":70696,"_20891":118774,"_5":14349,"_27386":118531,"_2933":52115},[],{"_3450":70800,"_30100":70696,"_20891":118776,"_5":14349,"_27386":118531,"_2933":118777},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3450":70801,"_30100":70696,"_20891":118779,"_5":14349,"_27386":118531,"_2933":52121},[],{"_3450":70802,"_30100":70696,"_20891":118781,"_5":14349,"_27386":118531,"_2933":118782},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3450":70803,"_30100":70696,"_20891":118784,"_5":14349,"_27386":118531,"_2933":52127},[],{"_3450":70804,"_30100":70696,"_20891":118786,"_5":14349,"_27386":118531,"_2933":118787},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3450":70805,"_30100":70696,"_20891":118789,"_5":14349,"_27386":118531,"_2933":118790},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3450":70806,"_30100":70696,"_20891":118792,"_5":14349,"_27386":118535,"_2933":118793},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3450":70807,"_30100":70696,"_20891":118795,"_5":14349,"_27386":118538,"_2933":116155},[],{"_3450":70808,"_30100":70696,"_20891":118797,"_5":14349,"_27386":118538,"_2933":118798},[],"Qué publica",{"_3450":70809,"_30100":70696,"_20891":118800,"_5":14349,"_27386":118538,"_2933":52144},[],{"_3450":70810,"_30100":70696,"_20891":118802,"_5":14349,"_27386":118538,"_2933":118803},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3450":70811,"_30100":70696,"_20891":118805,"_5":14349,"_27386":118538,"_2933":52150},[],{"_3450":70812,"_30100":70696,"_20891":118807,"_5":14349,"_27386":118538,"_2933":118808},[],"Certificado de la CA emisora seleccionada.",{"_3450":70813,"_30100":70696,"_20891":118810,"_5":14349,"_27386":118538,"_2933":52156},[],{"_3450":70814,"_30100":70696,"_20891":118812,"_5":14349,"_27386":118538,"_2933":118813},[],"Certificados de las CAs elegidas explícitamente.",{"_3450":70815,"_30100":70696,"_20891":118815,"_5":14349,"_27386":118538,"_2933":118816},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3450":70816,"_30100":70696,"_20891":118818,"_5":14349,"_27386":118542,"_2933":118819},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3450":70817,"_30100":70696,"_20891":118821,"_5":14349,"_27386":118542,"_2933":118822},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3450":70818,"_30100":70696,"_20891":118824,"_5":14349,"_27386":118542,"_2933":118825},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3450":70819,"_30100":70696,"_20891":118827,"_5":14349,"_27386":118546,"_2933":118828},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3450":70820,"_30100":70820,"_5":14701,"_2933":118830,"_30453":118831,"_20891":118832,"_27386":70820},"Integra el cliente EST",[49052,117213,51534,118225,118400],[],{"_3450":70821,"_30100":70820,"_20891":118834,"_5":14349,"_27386":70820,"_2933":118835},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3450":70822,"_30100":70820,"_5":30450,"_20891":118837,"_27386":118838,"_2933":115791},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3450":70823,"_30100":70820,"_5":30450,"_20891":118840,"_27386":118841,"_2933":118842},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3450":70824,"_30100":70820,"_5":30450,"_20891":118844,"_27386":118845,"_2933":118846},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3450":70825,"_30100":70820,"_5":30450,"_20891":118848,"_27386":118849,"_2933":118850},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3450":70826,"_30100":70820,"_5":30450,"_20891":118852,"_27386":118853,"_2933":118854},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3450":70827,"_30100":70820,"_5":30450,"_20891":118856,"_27386":118857,"_2933":118858},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3450":70828,"_30100":70820,"_20891":118860,"_5":14349,"_27386":70820,"_2933":118861},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3450":70829,"_30100":70820,"_20891":118863,"_5":14349,"_27386":118838,"_2933":118864},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3450":70830,"_30100":70820,"_20891":118866,"_5":14349,"_27386":118838,"_2933":118867},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3450":70831,"_30100":70820,"_20891":118869,"_5":14349,"_27386":118838,"_2933":118870},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3450":70832,"_30100":70820,"_20891":118872,"_5":14349,"_27386":118841,"_2933":118873},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3450":70833,"_30100":70820,"_20891":118875,"_5":14349,"_27386":118841,"_2933":118876},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3450":70834,"_30100":70820,"_20891":118878,"_5":14349,"_27386":118845,"_2933":118879},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3450":70835,"_30100":70820,"_20891":118881,"_5":14349,"_27386":118845,"_2933":118882},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3450":70836,"_30100":70820,"_20891":118884,"_5":14349,"_27386":118849,"_2933":118885},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3450":70837,"_30100":70820,"_20891":118887,"_5":14349,"_27386":118849,"_2933":118888},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3450":70838,"_30100":70820,"_20891":118890,"_5":14349,"_27386":118853,"_2933":118891},[],"Para el caso de una raíz que emite directamente:",{"_3450":70839,"_30100":70820,"_20891":118893,"_5":14349,"_27386":118853,"_2933":118894},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3450":70840,"_30100":70820,"_20891":118896,"_5":14349,"_27386":118853,"_2933":118897},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3450":70841,"_30100":70820,"_20891":118899,"_5":14349,"_27386":118857,"_2933":118900},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3450":70842,"_30100":70842,"_5":14701,"_2933":118902,"_30453":118903,"_20891":118904,"_27386":70842},"Referencia EST",[49052,117213,51534,118225,118400],[],{"_3450":70843,"_30100":70842,"_20891":118906,"_5":14349,"_27386":70842,"_2933":118907},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3450":70844,"_30100":70842,"_5":30450,"_20891":118909,"_27386":118910,"_2933":118911},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3450":70845,"_30100":70842,"_5":30450,"_20891":118913,"_27386":118914,"_2933":22642},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3450":70846,"_30100":70842,"_5":30450,"_20891":118916,"_27386":118917,"_2933":25996},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3450":70847,"_30100":70842,"_5":30450,"_20891":118919,"_27386":118920,"_2933":26003},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3450":70848,"_30100":70842,"_5":30450,"_20891":118922,"_27386":118923,"_2933":25322},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3450":70849,"_30100":70842,"_5":30450,"_20891":118925,"_27386":118926,"_2933":118927},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3450":70850,"_30100":70842,"_5":30450,"_20891":118929,"_27386":118930,"_2933":118931},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3450":70851,"_30100":70842,"_5":30450,"_20891":118933,"_27386":118934,"_2933":118935},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3450":70852,"_30100":70842,"_20891":118937,"_5":14349,"_27386":70842,"_2933":118938},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3450":70853,"_30100":70842,"_20891":118940,"_5":14349,"_27386":118910,"_2933":118941},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3450":70854,"_30100":70842,"_20891":118943,"_5":14349,"_27386":118910,"_2933":116973},[],{"_3450":70855,"_30100":70842,"_20891":118945,"_5":14349,"_27386":118910,"_2933":118946},[],"Método",{"_3450":70856,"_30100":70842,"_20891":118948,"_5":14349,"_27386":118910,"_2933":118949},[],"Autenticación y condición",{"_3450":70857,"_30100":70842,"_20891":118951,"_5":14349,"_27386":118910,"_2933":52299},[],{"_3450":70858,"_30100":70842,"_20891":118953,"_5":14349,"_27386":118910,"_2933":52302},[],{"_3450":70859,"_30100":70842,"_20891":118955,"_5":14349,"_27386":118910,"_2933":118956},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3450":70860,"_30100":70842,"_20891":118958,"_5":14349,"_27386":118910,"_2933":52308},[],{"_3450":70861,"_30100":70842,"_20891":118960,"_5":14349,"_27386":118910,"_2933":52311},[],{"_3450":70862,"_30100":70842,"_20891":118962,"_5":14349,"_27386":118910,"_2933":118963},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3450":70863,"_30100":70842,"_20891":118965,"_5":14349,"_27386":118910,"_2933":52317},[],{"_3450":70864,"_30100":70842,"_20891":118967,"_5":14349,"_27386":118910,"_2933":52311},[],{"_3450":70865,"_30100":70842,"_20891":118969,"_5":14349,"_27386":118910,"_2933":118970},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3450":70866,"_30100":70842,"_20891":118972,"_5":14349,"_27386":118910,"_2933":52325},[],{"_3450":70867,"_30100":70842,"_20891":118974,"_5":14349,"_27386":118910,"_2933":52311},[],{"_3450":70868,"_30100":70842,"_20891":118976,"_5":14349,"_27386":118910,"_2933":118977},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3450":70869,"_30100":70842,"_20891":118979,"_5":14349,"_27386":118910,"_2933":118980},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3450":70870,"_30100":70842,"_20891":118982,"_5":14349,"_27386":118914,"_2933":118983},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3450":70871,"_30100":70842,"_20891":118985,"_5":14349,"_27386":118914,"_2933":118986},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3450":70872,"_30100":70842,"_20891":118988,"_5":14349,"_27386":118917,"_2933":118989},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3450":70873,"_30100":70842,"_20891":118991,"_5":14349,"_27386":118917,"_2933":118992},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3450":70874,"_30100":70842,"_20891":118994,"_5":14349,"_27386":118920,"_2933":118995},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3450":70875,"_30100":70842,"_20891":118997,"_5":14349,"_27386":118920,"_2933":118998},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3450":70876,"_30100":70842,"_20891":119000,"_5":14349,"_27386":118923,"_2933":119001},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3450":70877,"_30100":70842,"_20891":119003,"_5":14349,"_27386":118923,"_2933":119004},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3450":70878,"_30100":70842,"_20891":119006,"_5":14349,"_27386":118926,"_2933":119007},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3450":70879,"_30100":70842,"_20891":119009,"_5":14349,"_27386":118926,"_2933":119010},[],"Parte",{"_3450":70880,"_30100":70842,"_20891":119012,"_5":14349,"_27386":118926,"_2933":119013},[],"Contenido tras decodificar su Base64",{"_3450":70881,"_30100":70842,"_20891":119015,"_5":14349,"_27386":118926,"_2933":52369},[],{"_3450":70882,"_30100":70842,"_20891":119017,"_5":14349,"_27386":118926,"_2933":119018},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3450":70883,"_30100":70842,"_20891":119020,"_5":14349,"_27386":118926,"_2933":52375},[],{"_3450":70884,"_30100":70842,"_20891":119022,"_5":14349,"_27386":118926,"_2933":119023},[],"PKCS#7 DER con el certificado emitido.",{"_3450":70885,"_30100":70842,"_20891":119025,"_5":14349,"_27386":118926,"_2933":119026},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3450":70886,"_30100":70842,"_20891":119028,"_5":14349,"_27386":118930,"_2933":119029},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3450":70887,"_30100":70842,"_20891":119031,"_5":14349,"_27386":118930,"_2933":119032},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3450":70888,"_30100":70842,"_20891":119034,"_5":14349,"_27386":118930,"_2933":119035},[],"Convierte y comprueba el resultado:",{"_3450":70889,"_30100":70842,"_20891":119037,"_5":14349,"_27386":118930,"_2933":119038},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3450":70890,"_30100":70842,"_20891":119040,"_5":14349,"_27386":118934,"_2933":119041},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3450":70891,"_30100":70842,"_20891":119043,"_5":14349,"_27386":118934,"_2933":119044},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3450":70892,"_30100":70892,"_5":14701,"_2933":118400,"_30453":119046,"_20891":119047,"_27386":70892},[49052,117213,51534,118225,118400],[],{"_3450":70893,"_30100":70892,"_20891":119049,"_5":14349,"_27386":70892,"_2933":119050},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3450":70894,"_30100":70892,"_5":30450,"_20891":119052,"_27386":119053,"_2933":119054},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3450":70895,"_30100":70892,"_5":30450,"_20891":119056,"_27386":119057,"_2933":119058},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3450":70896,"_30100":70892,"_5":30450,"_20891":119060,"_27386":119061,"_2933":119062},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3450":70897,"_30100":70892,"_5":30450,"_20891":119064,"_27386":119065,"_2933":119066},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3450":70898,"_30100":70892,"_20891":119068,"_5":14349,"_27386":70892,"_2933":119069},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3450":70899,"_30100":70892,"_20891":119071,"_5":14349,"_27386":119053,"_2933":119072},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3450":70900,"_30100":70892,"_20891":119074,"_5":14349,"_27386":119053,"_2933":119075},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3450":70901,"_30100":70892,"_20891":119077,"_5":14349,"_27386":119053,"_2933":119078},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3450":70902,"_30100":70892,"_20891":119080,"_5":14349,"_27386":119053,"_2933":119081},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3450":70903,"_30100":70892,"_20891":119083,"_5":14349,"_27386":119053,"_2933":119084},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3450":70904,"_30100":70892,"_20891":119086,"_5":14349,"_27386":119053,"_2933":119087},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3450":70905,"_30100":70892,"_20891":119089,"_5":14349,"_27386":119057,"_2933":119090},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3450":70906,"_30100":70892,"_20891":119092,"_5":14349,"_27386":119057,"_2933":119093},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3450":70907,"_30100":70892,"_20891":119095,"_5":14349,"_27386":119057,"_2933":119096},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3450":70908,"_30100":70892,"_20891":119098,"_5":14349,"_27386":119057,"_2933":119099},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3450":70909,"_30100":70892,"_20891":119101,"_5":14349,"_27386":119061,"_2933":119102},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3450":70910,"_30100":70892,"_20891":119104,"_5":14349,"_27386":119061,"_2933":119105},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3450":70911,"_30100":70892,"_20891":119107,"_5":14349,"_27386":119061,"_2933":119108},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3450":70912,"_30100":70892,"_20891":119110,"_5":14349,"_27386":119061,"_2933":119111},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3450":70913,"_30100":70892,"_20891":119113,"_5":14349,"_27386":119065,"_2933":119114},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3450":70914,"_30100":70892,"_20891":119116,"_5":14349,"_27386":119065,"_2933":119117},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3450":70915,"_30100":70915,"_5":14701,"_2933":119119,"_30453":119120,"_20891":119121,"_27386":70915},"Estrategias de aprovisionamiento",[49052,117213,51534,118225,118400],[],{"_3450":70916,"_30100":70915,"_20891":119123,"_5":14349,"_27386":70915,"_2933":119124},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3450":70917,"_30100":70915,"_5":30450,"_20891":119126,"_27386":119127,"_2933":119128},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3450":70918,"_30100":70915,"_5":30450,"_20891":119130,"_27386":119131,"_2933":119132},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3450":70919,"_30100":70915,"_5":30450,"_20891":119134,"_27386":119135,"_2933":119136},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3450":70920,"_30100":70915,"_5":30450,"_20891":119138,"_27386":119139,"_2933":119140},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3450":70921,"_30100":70915,"_5":30450,"_20891":119142,"_27386":119143,"_2933":119144},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3450":70922,"_30100":70915,"_20891":119146,"_5":14349,"_27386":70915,"_2933":119147},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3450":70923,"_30100":70915,"_20891":119149,"_5":14349,"_27386":119127,"_2933":119150},[],"Recorrido",{"_3450":70924,"_30100":70915,"_20891":119152,"_5":14349,"_27386":119127,"_2933":119153},[],"Cuándo existe el dispositivo",{"_3450":70925,"_30100":70915,"_20891":119155,"_5":14349,"_27386":119127,"_2933":119156},[],"Qué compruebas",{"_3450":70926,"_30100":70915,"_20891":119158,"_5":14349,"_27386":119127,"_2933":119159},[],"Asignación manual",{"_3450":70927,"_30100":70915,"_20891":119161,"_5":14349,"_27386":119127,"_2933":119162},[],"El operador lo crea antes de asociar un certificado.",{"_3450":70928,"_30100":70915,"_20891":119164,"_5":14349,"_27386":119127,"_2933":119165},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3450":70929,"_30100":70915,"_20891":119167,"_5":14349,"_27386":119127,"_2933":119168},[],"EST con `JITP`",{"_3450":70930,"_30100":70915,"_20891":119170,"_5":14349,"_27386":119127,"_2933":119171},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3450":70931,"_30100":70915,"_20891":119173,"_5":14349,"_27386":119127,"_2933":119174},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3450":70932,"_30100":70915,"_20891":119176,"_5":14349,"_27386":119127,"_2933":119177},[],"EST con `PRE_REGISTRATION`",{"_3450":70933,"_30100":70915,"_20891":119179,"_5":14349,"_27386":119127,"_2933":119180},[],"Debe existir antes de `/simpleenroll`.",{"_3450":70934,"_30100":70915,"_20891":119182,"_5":14349,"_27386":119127,"_2933":119183},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3450":70935,"_30100":70915,"_20891":119185,"_5":14349,"_27386":119127,"_2933":119186},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3450":70936,"_30100":70915,"_20891":119188,"_5":14349,"_27386":119127,"_2933":119189},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3450":70937,"_30100":70915,"_20891":119191,"_5":14349,"_27386":119131,"_2933":119192},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3450":70938,"_30100":70915,"_20891":119194,"_5":14349,"_27386":119131,"_2933":119195},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3450":70939,"_30100":70915,"_20891":119197,"_5":14349,"_27386":119131,"_2933":119198},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3450":70940,"_30100":70915,"_20891":119200,"_5":14349,"_27386":119135,"_2933":119201},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3450":70941,"_30100":70915,"_20891":119203,"_5":14349,"_27386":119135,"_2933":119204},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3450":70942,"_30100":70915,"_20891":119206,"_5":14349,"_27386":119135,"_2933":119207},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3450":70943,"_30100":70915,"_20891":119209,"_5":14349,"_27386":119135,"_2933":119210},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3450":70944,"_30100":70915,"_20891":119212,"_5":14349,"_27386":119135,"_2933":119213},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3450":70945,"_30100":70915,"_20891":119215,"_5":14349,"_27386":119135,"_2933":119216},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3450":70946,"_30100":70915,"_20891":119218,"_5":14349,"_27386":119139,"_2933":116155},[],{"_3450":70947,"_30100":70915,"_20891":119220,"_5":14349,"_27386":119139,"_2933":119221},[],"Material que atraviesa EST",{"_3450":70948,"_30100":70915,"_20891":119223,"_5":14349,"_27386":119139,"_2933":119224},[],"Clave generada por el dispositivo",{"_3450":70949,"_30100":70915,"_20891":119226,"_5":14349,"_27386":119139,"_2933":119227},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3450":70950,"_30100":70915,"_20891":119229,"_5":14349,"_27386":119139,"_2933":119230},[],"Clave ya disponible en el dispositivo",{"_3450":70951,"_30100":70915,"_20891":119232,"_5":14349,"_27386":119139,"_2933":119233},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3450":70952,"_30100":70915,"_20891":119235,"_5":14349,"_27386":119139,"_2933":51853},[],{"_3450":70953,"_30100":70915,"_20891":119237,"_5":14349,"_27386":119139,"_2933":119238},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3450":70954,"_30100":70915,"_20891":119240,"_5":14349,"_27386":119139,"_2933":119241},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3450":70955,"_30100":70915,"_20891":119243,"_5":14349,"_27386":119143,"_2933":119244},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3450":70956,"_30100":70956,"_5":14701,"_2933":119246,"_30453":119247,"_20891":119248,"_27386":70956},"Renovación y recuperación",[49052,117213,51534,118225,118400],[],{"_3450":70957,"_30100":70956,"_20891":119250,"_5":14349,"_27386":70956,"_2933":119251},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3450":70958,"_30100":70956,"_5":30450,"_20891":119253,"_27386":119254,"_2933":119255},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3450":70959,"_30100":70956,"_5":30450,"_20891":119257,"_27386":119258,"_2933":119259},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3450":70960,"_30100":70956,"_5":30450,"_20891":119261,"_27386":119262,"_2933":119263},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3450":70961,"_30100":70956,"_5":30450,"_20891":119265,"_27386":119266,"_2933":119267},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3450":70962,"_30100":70956,"_5":30450,"_20891":119269,"_27386":119270,"_2933":119271},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3450":70963,"_30100":70956,"_20891":119273,"_5":14349,"_27386":70956,"_2933":119274},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3450":70964,"_30100":70956,"_20891":119276,"_5":14349,"_27386":119254,"_2933":119277},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3450":70965,"_30100":70956,"_20891":119279,"_5":14349,"_27386":119254,"_2933":119280},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3450":70966,"_30100":70956,"_20891":119282,"_5":14349,"_27386":119254,"_2933":119283},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3450":70967,"_30100":70956,"_20891":119285,"_5":14349,"_27386":119254,"_2933":119286},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3450":70968,"_30100":70956,"_20891":119288,"_5":14349,"_27386":119258,"_2933":119289},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3450":70969,"_30100":70956,"_20891":119291,"_5":14349,"_27386":119258,"_2933":119292},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3450":70970,"_30100":70956,"_20891":119294,"_5":14349,"_27386":119262,"_2933":119295},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3450":70971,"_30100":70956,"_20891":119297,"_5":14349,"_27386":119262,"_2933":119298},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3450":70972,"_30100":70956,"_20891":119300,"_5":14349,"_27386":119262,"_2933":119301},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3450":70973,"_30100":70956,"_20891":119303,"_5":14349,"_27386":119266,"_2933":119304},[],"Situación",{"_3450":70974,"_30100":70956,"_20891":119306,"_5":14349,"_27386":119266,"_2933":119307},[],"Procedimiento",{"_3450":70975,"_30100":70956,"_20891":119309,"_5":14349,"_27386":119266,"_2933":119310},[],"Certificado vigente, fuera de ventana",{"_3450":70976,"_30100":70956,"_20891":119312,"_5":14349,"_27386":119266,"_2933":119313},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3450":70977,"_30100":70956,"_20891":119315,"_5":14349,"_27386":119266,"_2933":119316},[],"Certificado vencido, clave disponible",{"_3450":70978,"_30100":70956,"_20891":119318,"_5":14349,"_27386":119266,"_2933":119319},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3450":70979,"_30100":70956,"_20891":119321,"_5":14349,"_27386":119266,"_2933":119322},[],"Renovación por webhook o `NO_AUTH`",{"_3450":70980,"_30100":70956,"_20891":119324,"_5":14349,"_27386":119266,"_2933":119325},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3450":70981,"_30100":70956,"_20891":119327,"_5":14349,"_27386":119266,"_2933":119328},[],"Clave perdida o inaccesible",{"_3450":70982,"_30100":70956,"_20891":119330,"_5":14349,"_27386":119266,"_2933":119331},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3450":70983,"_30100":70956,"_20891":119333,"_5":14349,"_27386":119266,"_2933":119334},[],"Identidad actual revocada",{"_3450":70984,"_30100":70956,"_20891":119336,"_5":14349,"_27386":119266,"_2933":119337},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3450":70985,"_30100":70956,"_20891":119339,"_5":14349,"_27386":119266,"_2933":119340},[],"Dispositivo sin identidad",{"_3450":70986,"_30100":70956,"_20891":119342,"_5":14349,"_27386":119266,"_2933":119343},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3450":70987,"_30100":70956,"_20891":119345,"_5":14349,"_27386":119266,"_2933":119346},[],"Dispositivo retirado",{"_3450":70988,"_30100":70956,"_20891":119348,"_5":14349,"_27386":119266,"_2933":119349},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3450":70989,"_30100":70956,"_20891":119351,"_5":14349,"_27386":119266,"_2933":119352},[],"Timeout, HTTP 500 o fallo de instalación",{"_3450":70990,"_30100":70956,"_20891":119354,"_5":14349,"_27386":119266,"_2933":119355},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3450":70991,"_30100":70956,"_20891":119357,"_5":14349,"_27386":119270,"_2933":119358},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3450":70992,"_30100":70956,"_20891":119360,"_5":14349,"_27386":119270,"_2933":119361},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3450":70993,"_30100":70993,"_5":14701,"_2933":119363,"_30453":119364,"_20891":119365,"_27386":70993},"Diagnóstico de enrolamiento",[49052,117213,51534,118225,118400],[],{"_3450":70994,"_30100":70993,"_20891":119367,"_5":14349,"_27386":70993,"_2933":119368},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3450":70995,"_30100":70993,"_5":30450,"_20891":119370,"_27386":119371,"_2933":119372},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3450":70996,"_30100":70993,"_5":30450,"_20891":119374,"_27386":119375,"_2933":119376},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3450":70997,"_30100":70993,"_5":30450,"_20891":119378,"_27386":119379,"_2933":118935},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3450":70998,"_30100":70993,"_5":30450,"_20891":119381,"_27386":119382,"_2933":119383},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3450":70999,"_30100":70993,"_20891":119385,"_5":14349,"_27386":70993,"_2933":119386},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3450":71000,"_30100":70993,"_20891":119388,"_5":14349,"_27386":119375,"_2933":119389},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3450":71001,"_30100":70993,"_20891":119391,"_5":14349,"_27386":119375,"_2933":119392},[],"Síntoma o mensaje",{"_3450":71002,"_30100":70993,"_20891":119394,"_5":14349,"_27386":119375,"_2933":119395},[],"Qué revisar",{"_3450":71003,"_30100":70993,"_20891":119397,"_5":14349,"_27386":119375,"_2933":119398},[],"curl rechaza TLS, nombre o emisor",{"_3450":71004,"_30100":70993,"_20891":119400,"_5":14349,"_27386":119375,"_2933":119401},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3450":71005,"_30100":70993,"_20891":119403,"_5":14349,"_27386":119375,"_2933":119404},[],"404 o APS ausente",{"_3450":71006,"_30100":70993,"_20891":119406,"_5":14349,"_27386":119375,"_2933":119407},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3450":71007,"_30100":70993,"_20891":119409,"_5":14349,"_27386":119375,"_2933":119410},[],"400, error de CSR o formato",{"_3450":71008,"_30100":70993,"_20891":119412,"_5":14349,"_27386":119375,"_2933":119413},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3450":71009,"_30100":70993,"_20891":119415,"_5":14349,"_27386":119375,"_2933":119416},[],"Credencial ausente o certificado no válido",{"_3450":71010,"_30100":70993,"_20891":119418,"_5":14349,"_27386":119375,"_2933":119419},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3450":71011,"_30100":70993,"_20891":119421,"_5":14349,"_27386":119375,"_2933":119422},[],"Webhook deniega, expira o responde sin autorización",{"_3450":71012,"_30100":70993,"_20891":119424,"_5":14349,"_27386":119375,"_2933":119425},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3450":71013,"_30100":70993,"_20891":119427,"_5":14349,"_27386":119375,"_2933":52782},[],{"_3450":71014,"_30100":70993,"_20891":119429,"_5":14349,"_27386":119375,"_2933":119430},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3450":71015,"_30100":70993,"_20891":119432,"_5":14349,"_27386":119375,"_2933":52788},[],{"_3450":71016,"_30100":70993,"_20891":119434,"_5":14349,"_27386":119375,"_2933":119435},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3450":71017,"_30100":70993,"_20891":119437,"_5":14349,"_27386":119375,"_2933":52794},[],{"_3450":71018,"_30100":70993,"_20891":119439,"_5":14349,"_27386":119375,"_2933":119440},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3450":71019,"_30100":70993,"_20891":119442,"_5":14349,"_27386":119375,"_2933":52800},[],{"_3450":71020,"_30100":70993,"_20891":119444,"_5":14349,"_27386":119375,"_2933":119445},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3450":71021,"_30100":70993,"_20891":119447,"_5":14349,"_27386":119375,"_2933":52806},[],{"_3450":71022,"_30100":70993,"_20891":119449,"_5":14349,"_27386":119375,"_2933":119450},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3450":71023,"_30100":70993,"_20891":119452,"_5":14349,"_27386":119375,"_2933":119453},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3450":71024,"_30100":70993,"_20891":119455,"_5":14349,"_27386":119375,"_2933":119456},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3450":71025,"_30100":70993,"_20891":119458,"_5":14349,"_27386":119375,"_2933":119459},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3450":71026,"_30100":70993,"_20891":119461,"_5":14349,"_27386":119375,"_2933":119462},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3450":71027,"_30100":70993,"_20891":119464,"_5":14349,"_27386":119375,"_2933":52824},[],{"_3450":71028,"_30100":70993,"_20891":119466,"_5":14349,"_27386":119375,"_2933":119467},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3450":71029,"_30100":70993,"_20891":119469,"_5":14349,"_27386":119375,"_2933":52830},[],{"_3450":71030,"_30100":70993,"_20891":119471,"_5":14349,"_27386":119375,"_2933":119472},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3450":71031,"_30100":70993,"_20891":119474,"_5":14349,"_27386":119375,"_2933":119475},[],"DMS propietario distinto",{"_3450":71032,"_30100":70993,"_20891":119477,"_5":14349,"_27386":119375,"_2933":119478},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3450":71033,"_30100":70993,"_20891":119480,"_5":14349,"_27386":119375,"_2933":52842},[],{"_3450":71034,"_30100":70993,"_20891":119482,"_5":14349,"_27386":119375,"_2933":119483},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3450":71035,"_30100":70993,"_20891":119485,"_5":14349,"_27386":119375,"_2933":52848},[],{"_3450":71036,"_30100":70993,"_20891":119487,"_5":14349,"_27386":119375,"_2933":119488},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3450":71037,"_30100":70993,"_20891":119490,"_5":14349,"_27386":119375,"_2933":119491},[],"Certificado actual revocado",{"_3450":71038,"_30100":70993,"_20891":119493,"_5":14349,"_27386":119375,"_2933":119494},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3450":71039,"_30100":70993,"_20891":119496,"_5":14349,"_27386":119375,"_2933":119497},[],"Error de CA, perfil o firma",{"_3450":71040,"_30100":70993,"_20891":119499,"_5":14349,"_27386":119375,"_2933":119500},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3450":71041,"_30100":70993,"_20891":119502,"_5":14349,"_27386":119375,"_2933":119503},[],"HTTP 200 sin conexión del dispositivo",{"_3450":71042,"_30100":70993,"_20891":119505,"_5":14349,"_27386":119375,"_2933":119506},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3450":71043,"_30100":70993,"_20891":119508,"_5":14349,"_27386":119375,"_2933":119509},[],"Timeout o error después de emitir",{"_3450":71044,"_30100":70993,"_20891":119511,"_5":14349,"_27386":119375,"_2933":119512},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3450":71045,"_30100":70993,"_20891":119514,"_5":14349,"_27386":119379,"_2933":119515},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3450":71046,"_30100":70993,"_20891":119517,"_5":14349,"_27386":119379,"_2933":119518},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3450":71047,"_30100":70993,"_20891":119520,"_5":14349,"_27386":119382,"_2933":119521},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3450":71048,"_30100":70993,"_20891":119523,"_5":14349,"_27386":119382,"_2933":119524},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3450":71049,"_30100":70993,"_20891":119526,"_5":14349,"_27386":119382,"_2933":119527},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3450":71050,"_30100":70993,"_20891":119529,"_5":14349,"_27386":119382,"_2933":119530},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3450":71051,"_30100":70993,"_20891":119532,"_5":14349,"_27386":119382,"_2933":119533},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3450":71052,"_30100":70993,"_20891":119535,"_5":14349,"_27386":119382,"_2933":119536},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3450":71053,"_30100":70993,"_20891":119538,"_5":14349,"_27386":119382,"_2933":119539},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3450":71054,"_30100":71054,"_5":14701,"_2933":119541,"_30453":119542,"_20891":119543,"_27386":71054},"Distribución y actualización de confianza",[49052,117213,51534,118225,118400],[],{"_3450":71055,"_30100":71054,"_20891":119545,"_5":14349,"_27386":71054,"_2933":119546},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3450":71056,"_30100":71054,"_5":30450,"_20891":119548,"_27386":119549,"_2933":119550},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3450":71057,"_30100":71054,"_5":30450,"_20891":119552,"_27386":119553,"_2933":119554},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3450":71058,"_30100":71054,"_5":30450,"_20891":119556,"_27386":119557,"_2933":119558},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3450":71059,"_30100":71054,"_5":30450,"_20891":119560,"_27386":119561,"_2933":119562},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3450":71060,"_30100":71054,"_5":30450,"_20891":119564,"_27386":119565,"_2933":119566},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3450":71061,"_30100":71054,"_20891":119568,"_5":14349,"_27386":71054,"_2933":119569},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3450":71062,"_30100":71054,"_20891":119571,"_5":14349,"_27386":119549,"_2933":119572},[],"Relación",{"_3450":71063,"_30100":71054,"_20891":119574,"_5":14349,"_27386":119549,"_2933":119575},[],"Material que prepara el responsable",{"_3450":71064,"_30100":71054,"_20891":119577,"_5":14349,"_27386":119549,"_2933":119578},[],"Dispositivo → servidor EST",{"_3450":71065,"_30100":71054,"_20891":119580,"_5":14349,"_27386":119549,"_2933":119581},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3450":71066,"_30100":71054,"_20891":119583,"_5":14349,"_27386":119549,"_2933":119584},[],"DMS → solicitante",{"_3450":71067,"_30100":71054,"_20891":119586,"_5":14349,"_27386":119549,"_2933":119587},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3450":71068,"_30100":71054,"_20891":119589,"_5":14349,"_27386":119549,"_2933":119590},[],"Consumidor → dispositivo",{"_3450":71069,"_30100":71054,"_20891":119592,"_5":14349,"_27386":119549,"_2933":119593},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3450":71070,"_30100":71054,"_20891":119595,"_5":14349,"_27386":119549,"_2933":119596},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3450":71071,"_30100":71054,"_20891":119598,"_5":14349,"_27386":119553,"_2933":119599},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3450":71072,"_30100":71054,"_20891":119601,"_5":14349,"_27386":119553,"_2933":119602},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3450":71073,"_30100":71054,"_20891":119604,"_5":14349,"_27386":119557,"_2933":119605},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3450":71074,"_30100":71054,"_20891":119607,"_5":14349,"_27386":119557,"_2933":119608},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3450":71075,"_30100":71054,"_20891":119610,"_5":14349,"_27386":119557,"_2933":119611},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3450":71076,"_30100":71054,"_20891":119613,"_5":14349,"_27386":119557,"_2933":119614},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3450":71077,"_30100":71054,"_20891":119616,"_5":14349,"_27386":119557,"_2933":119617},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3450":71078,"_30100":71054,"_20891":119619,"_5":14349,"_27386":119557,"_2933":119620},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3450":71079,"_30100":71054,"_20891":119622,"_5":14349,"_27386":119561,"_2933":119623},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3450":71080,"_30100":71054,"_20891":119625,"_5":14349,"_27386":119561,"_2933":119626},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3450":71081,"_30100":71054,"_20891":119628,"_5":14349,"_27386":119561,"_2933":119629},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3450":71082,"_30100":71054,"_20891":119631,"_5":14349,"_27386":119565,"_2933":119632},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3450":71083,"_30100":71083,"_5":14701,"_2933":52997,"_30453":119634,"_20891":119636,"_27386":71083},[49052,117213,51534,118225,119635],"Integraciones",[],{"_3450":71084,"_30100":71083,"_20891":119638,"_5":14349,"_27386":71083,"_2933":119639},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3450":71085,"_30100":71083,"_5":30450,"_20891":119641,"_27386":119642,"_2933":119643},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3450":71086,"_30100":71083,"_5":30450,"_20891":119645,"_27386":119646,"_2933":119647},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3450":71087,"_30100":71083,"_5":30450,"_20891":119649,"_27386":119650,"_2933":119651},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3450":71088,"_30100":71083,"_5":30450,"_20891":119653,"_27386":119654,"_2933":119655},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3450":71089,"_30100":71083,"_5":30450,"_20891":119657,"_27386":119658,"_2933":119659},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3450":71090,"_30100":71083,"_5":30450,"_20891":119661,"_27386":119662,"_2933":119663},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3450":71091,"_30100":71083,"_5":30450,"_20891":119665,"_27386":119666,"_2933":119667},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3450":71092,"_30100":71083,"_5":30450,"_20891":119669,"_27386":119670,"_2933":119671},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3450":71093,"_30100":71083,"_5":30450,"_20891":119673,"_27386":119674,"_2933":53039},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3450":71094,"_30100":71083,"_5":30450,"_20891":119676,"_27386":119677,"_2933":53043},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3450":71095,"_30100":71083,"_5":30450,"_20891":119679,"_27386":119680,"_2933":119681},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3450":71096,"_30100":71083,"_5":30450,"_20891":119683,"_27386":119684,"_2933":119685},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3450":71097,"_30100":71083,"_5":30450,"_20891":119687,"_27386":119688,"_2933":119689},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3450":71098,"_30100":71083,"_5":30450,"_20891":119691,"_27386":119692,"_2933":119693},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3450":71099,"_30100":71083,"_5":30450,"_20891":119695,"_27386":119696,"_2933":119697},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3450":71100,"_30100":71083,"_5":30450,"_20891":119699,"_27386":119700,"_2933":119701},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3450":71101,"_30100":71083,"_5":30450,"_20891":119703,"_27386":119704,"_2933":119705},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3450":71102,"_30100":71083,"_5":30450,"_20891":119707,"_27386":119708,"_2933":119709},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3450":71103,"_30100":71083,"_5":30450,"_20891":119711,"_27386":119712,"_2933":119713},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3450":71104,"_30100":71083,"_5":30450,"_20891":119715,"_27386":119716,"_2933":119717},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3450":71105,"_30100":71083,"_5":30450,"_20891":119719,"_27386":119720,"_2933":119721},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3450":71106,"_30100":71083,"_5":30450,"_20891":119723,"_27386":119724,"_2933":119725},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3450":71107,"_30100":71083,"_5":30450,"_20891":119727,"_27386":119728,"_2933":119729},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3450":71108,"_30100":71083,"_5":30450,"_20891":119731,"_27386":119732,"_2933":119733},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3450":71109,"_30100":71083,"_5":30450,"_20891":119735,"_27386":119736,"_2933":119737},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3450":71110,"_30100":71083,"_20891":119739,"_5":14349,"_27386":71083,"_2933":119740},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3450":71111,"_30100":71083,"_20891":119742,"_5":14349,"_27386":71083,"_2933":119743},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3450":71112,"_30100":71083,"_20891":119745,"_5":14349,"_27386":71083,"_2933":119746},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3450":71113,"_30100":71083,"_20891":119748,"_5":14349,"_27386":119642,"_2933":119749},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3450":71114,"_30100":71083,"_20891":119751,"_5":14349,"_27386":119642,"_2933":119752},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3450":71115,"_30100":71083,"_20891":119754,"_5":14349,"_27386":119642,"_2933":119755},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3450":71116,"_30100":71083,"_20891":119757,"_5":14349,"_27386":119642,"_2933":119758},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3450":71117,"_30100":71083,"_20891":119760,"_5":14349,"_27386":119646,"_2933":119761},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3450":71118,"_30100":71083,"_20891":119763,"_5":14349,"_27386":119650,"_2933":119764},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3450":71119,"_30100":71083,"_20891":119766,"_5":14349,"_27386":119650,"_2933":119767},[],"Acción IAM",{"_3450":71120,"_30100":71083,"_20891":119769,"_5":14349,"_27386":119650,"_2933":116161},[],{"_3450":71121,"_30100":71083,"_20891":119771,"_5":14349,"_27386":119650,"_2933":53138},[],{"_3450":71122,"_30100":71083,"_20891":119773,"_5":14349,"_27386":119650,"_2933":119774},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3450":71123,"_30100":71083,"_20891":119776,"_5":14349,"_27386":119650,"_2933":53144},[],{"_3450":71124,"_30100":71083,"_20891":119778,"_5":14349,"_27386":119650,"_2933":119779},[],"Registrar la CA en AWS IoT",{"_3450":71125,"_30100":71083,"_20891":119781,"_5":14349,"_27386":119650,"_2933":53150},[],{"_3450":71126,"_30100":71083,"_20891":119783,"_5":14349,"_27386":119650,"_2933":119784},[],"Consultar el estado del registro de la CA",{"_3450":71127,"_30100":71083,"_20891":119786,"_5":14349,"_27386":119650,"_2933":53156},[],{"_3450":71128,"_30100":71083,"_20891":119788,"_5":14349,"_27386":119650,"_2933":119789},[],"Crear o actualizar Things en IoT Core",{"_3450":71129,"_30100":71083,"_20891":119791,"_5":14349,"_27386":119650,"_2933":53162},[],{"_3450":71130,"_30100":71083,"_20891":119793,"_5":14349,"_27386":119650,"_2933":119794},[],"Aprovisionar Things mediante plantilla",{"_3450":71131,"_30100":71083,"_20891":119796,"_5":14349,"_27386":119650,"_2933":53168},[],{"_3450":71132,"_30100":71083,"_20891":119798,"_5":14349,"_27386":119650,"_2933":119799},[],"Registrar certificados de dispositivo",{"_3450":71133,"_30100":71083,"_20891":119801,"_5":14349,"_27386":119650,"_2933":53174},[],{"_3450":71134,"_30100":71083,"_20891":119803,"_5":14349,"_27386":119650,"_2933":119804},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3450":71135,"_30100":71083,"_20891":119806,"_5":14349,"_27386":119650,"_2933":53180},[],{"_3450":71136,"_30100":71083,"_20891":119808,"_5":14349,"_27386":119650,"_2933":119809},[],"Crear y adjuntar políticas IoT",{"_3450":71137,"_30100":71083,"_20891":119811,"_5":14349,"_27386":119650,"_2933":53186},[],{"_3450":71138,"_30100":71083,"_20891":119813,"_5":14349,"_27386":119650,"_2933":119814},[],"Gestionar grupos de Things",{"_3450":71139,"_30100":71083,"_20891":119816,"_5":14349,"_27386":119650,"_2933":53192},[],{"_3450":71140,"_30100":71083,"_20891":119818,"_5":14349,"_27386":119650,"_2933":119819},[],"Crear plantillas JITP",{"_3450":71141,"_30100":71083,"_20891":119821,"_5":14349,"_27386":119650,"_2933":53198},[],{"_3450":71142,"_30100":71083,"_20891":119823,"_5":14349,"_27386":119650,"_2933":119824},[],"Leer y escribir el Device Shadow",{"_3450":71143,"_30100":71083,"_20891":119826,"_5":14349,"_27386":119650,"_2933":119827},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3450":71144,"_30100":71083,"_20891":119829,"_5":14349,"_27386":119654,"_2933":119830},[],"Parámetro",{"_3450":71145,"_30100":71083,"_20891":119832,"_5":14349,"_27386":119654,"_2933":119833},[],"Tipo",{"_3450":71146,"_30100":71083,"_20891":119835,"_5":14349,"_27386":119654,"_2933":119836},[],"Requerido",{"_3450":71147,"_30100":71083,"_20891":119838,"_5":14349,"_27386":119654,"_2933":119839},[],"Descripción",{"_3450":71148,"_30100":71083,"_20891":119841,"_5":14349,"_27386":119654,"_2933":53219},[],{"_3450":71149,"_30100":71083,"_20891":119843,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71150,"_30100":71083,"_20891":119845,"_5":14349,"_27386":119654,"_2933":119846},[],"Sí",{"_3450":71151,"_30100":71083,"_20891":119848,"_5":14349,"_27386":119654,"_2933":119849},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3450":71152,"_30100":71083,"_20891":119851,"_5":14349,"_27386":119654,"_2933":53230},[],{"_3450":71153,"_30100":71083,"_20891":119853,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71154,"_30100":71083,"_20891":119855,"_5":14349,"_27386":119654,"_2933":119846},[],{"_3450":71155,"_30100":71083,"_20891":119857,"_5":14349,"_27386":119654,"_2933":119858},[],"Región AWS donde opera el conector.",{"_3450":71156,"_30100":71083,"_20891":119860,"_5":14349,"_27386":119654,"_2933":53240},[],{"_3450":71157,"_30100":71083,"_20891":119862,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71158,"_30100":71083,"_20891":119864,"_5":14349,"_27386":119654,"_2933":119846},[],{"_3450":71159,"_30100":71083,"_20891":119866,"_5":14349,"_27386":119654,"_2933":119867},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3450":71160,"_30100":71083,"_20891":119869,"_5":14349,"_27386":119654,"_2933":53250},[],{"_3450":71161,"_30100":71083,"_20891":119871,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71162,"_30100":71083,"_20891":119873,"_5":14349,"_27386":119654,"_2933":119874},[],"Solo con `auth_method=static`",{"_3450":71163,"_30100":71083,"_20891":119876,"_5":14349,"_27386":119654,"_2933":119877},[],"Clave de acceso AWS.",{"_3450":71164,"_30100":71083,"_20891":119879,"_5":14349,"_27386":119654,"_2933":53261},[],{"_3450":71165,"_30100":71083,"_20891":119881,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71166,"_30100":71083,"_20891":119883,"_5":14349,"_27386":119654,"_2933":119874},[],{"_3450":71167,"_30100":71083,"_20891":119885,"_5":14349,"_27386":119654,"_2933":119886},[],"Clave secreta AWS.",{"_3450":71168,"_30100":71083,"_20891":119888,"_5":14349,"_27386":119654,"_2933":53271},[],{"_3450":71169,"_30100":71083,"_20891":119890,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71170,"_30100":71083,"_20891":119892,"_5":14349,"_27386":119654,"_2933":53276},[],{"_3450":71171,"_30100":71083,"_20891":119894,"_5":14349,"_27386":119654,"_2933":119895},[],"Token de sesión (con `auth_method=static`).",{"_3450":71172,"_30100":71083,"_20891":119897,"_5":14349,"_27386":119654,"_2933":53282},[],{"_3450":71173,"_30100":71083,"_20891":119899,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71174,"_30100":71083,"_20891":119901,"_5":14349,"_27386":119654,"_2933":119902},[],"Solo con `auth_method=role`",{"_3450":71175,"_30100":71083,"_20891":119904,"_5":14349,"_27386":119654,"_2933":119905},[],"ARN del rol a asumir.",{"_3450":71176,"_30100":71083,"_20891":119907,"_5":14349,"_27386":119654,"_2933":53293},[],{"_3450":71177,"_30100":71083,"_20891":119909,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71178,"_30100":71083,"_20891":119911,"_5":14349,"_27386":119654,"_2933":53276},[],{"_3450":71179,"_30100":71083,"_20891":119913,"_5":14349,"_27386":119654,"_2933":119914},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3450":71180,"_30100":71083,"_20891":119916,"_5":14349,"_27386":119654,"_2933":53303},[],{"_3450":71181,"_30100":71083,"_20891":119918,"_5":14349,"_27386":119654,"_2933":89384},[],{"_3450":71182,"_30100":71083,"_20891":119920,"_5":14349,"_27386":119654,"_2933":119846},[],{"_3450":71183,"_30100":71083,"_20891":119922,"_5":14349,"_27386":119654,"_2933":119923},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3450":71184,"_30100":71083,"_20891":119925,"_5":14349,"_27386":119654,"_2933":53313},[],{"_3450":71185,"_30100":71083,"_20891":119927,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71186,"_30100":71083,"_20891":119929,"_5":14349,"_27386":119654,"_2933":119846},[],{"_3450":71187,"_30100":71083,"_20891":119931,"_5":14349,"_27386":119654,"_2933":119932},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3450":71188,"_30100":71083,"_20891":119934,"_5":14349,"_27386":119654,"_2933":53323},[],{"_3450":71189,"_30100":71083,"_20891":119936,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71190,"_30100":71083,"_20891":119938,"_5":14349,"_27386":119654,"_2933":119846},[],{"_3450":71191,"_30100":71083,"_20891":119940,"_5":14349,"_27386":119654,"_2933":119941},[],"URL HTTP del Device Manager de Lamassu.",{"_3450":71192,"_30100":71083,"_20891":119943,"_5":14349,"_27386":119654,"_2933":53333},[],{"_3450":71193,"_30100":71083,"_20891":119945,"_5":14349,"_27386":119654,"_2933":24962},[],{"_3450":71194,"_30100":71083,"_20891":119947,"_5":14349,"_27386":119654,"_2933":119846},[],{"_3450":71195,"_30100":71083,"_20891":119949,"_5":14349,"_27386":119654,"_2933":119950},[],"URL HTTP del servicio de CA de Lamassu.",{"_3450":71196,"_30100":71083,"_20891":119952,"_5":14349,"_27386":119658,"_2933":119953},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3450":71197,"_30100":71083,"_20891":119955,"_5":14349,"_27386":119658,"_2933":119956},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3450":71198,"_30100":71083,"_20891":119958,"_5":14349,"_27386":119658,"_2933":119959},[],"Tipo de CloudEvent",{"_3450":71199,"_30100":71083,"_20891":119961,"_5":14349,"_27386":119658,"_2933":119962},[],"Recurso en Lamassu",{"_3450":71200,"_30100":71083,"_20891":119964,"_5":14349,"_27386":119658,"_2933":119965},[],"Recurso AWS",{"_3450":71201,"_30100":71083,"_20891":119967,"_5":14349,"_27386":119658,"_2933":119968},[],"Acciones IAM",{"_3450":71202,"_30100":71083,"_20891":119970,"_5":14349,"_27386":119658,"_2933":119971},[],"Llamadas AWS y efecto",{"_3450":71203,"_30100":71083,"_20891":119973,"_5":14349,"_27386":119658,"_2933":119974},[],"Dónde en esta página",{"_3450":71204,"_30100":71083,"_20891":119976,"_5":14349,"_27386":119658,"_2933":53367},[],{"_3450":71205,"_30100":71083,"_20891":119978,"_5":14349,"_27386":119658,"_2933":53370},[],{"_3450":71206,"_30100":71083,"_20891":119980,"_5":14349,"_27386":119658,"_2933":53373},[],{"_3450":71207,"_30100":71083,"_20891":119982,"_5":14349,"_27386":119658,"_2933":53376},[],{"_3450":71208,"_30100":71083,"_20891":119984,"_5":14349,"_27386":119658,"_2933":119985},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3450":71209,"_30100":71083,"_20891":119987,"_5":14349,"_27386":119658,"_2933":119671},[],{"_3450":71210,"_30100":71083,"_20891":119989,"_5":14349,"_27386":119658,"_2933":53384},[],{"_3450":71211,"_30100":71083,"_20891":119991,"_5":14349,"_27386":119658,"_2933":53387},[],{"_3450":71212,"_30100":71083,"_20891":119993,"_5":14349,"_27386":119658,"_2933":53390},[],{"_3450":71213,"_30100":71083,"_20891":119995,"_5":14349,"_27386":119658,"_2933":53393},[],{"_3450":71214,"_30100":71083,"_20891":119997,"_5":14349,"_27386":119658,"_2933":119998},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3450":71215,"_30100":71083,"_20891":120000,"_5":14349,"_27386":119658,"_2933":119697},[],{"_3450":71216,"_30100":71083,"_20891":120002,"_5":14349,"_27386":119658,"_2933":53401},[],{"_3450":71217,"_30100":71083,"_20891":120004,"_5":14349,"_27386":119658,"_2933":120005},[],"Dispositivo",{"_3450":71218,"_30100":71083,"_20891":120007,"_5":14349,"_27386":119658,"_2933":53407},[],{"_3450":71219,"_30100":71083,"_20891":120009,"_5":14349,"_27386":119658,"_2933":53410},[],{"_3450":71220,"_30100":71083,"_20891":120011,"_5":14349,"_27386":119658,"_2933":120012},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3450":71221,"_30100":71083,"_20891":120014,"_5":14349,"_27386":119658,"_2933":119705},[],{"_3450":71222,"_30100":71083,"_20891":120016,"_5":14349,"_27386":119658,"_2933":53418},[],{"_3450":71223,"_30100":71083,"_20891":120018,"_5":14349,"_27386":119658,"_2933":120019},[],"Certificado",{"_3450":71224,"_30100":71083,"_20891":120021,"_5":14349,"_27386":119658,"_2933":53424},[],{"_3450":71225,"_30100":71083,"_20891":120023,"_5":14349,"_27386":119658,"_2933":120024},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3450":71226,"_30100":71083,"_20891":120026,"_5":14349,"_27386":119658,"_2933":120027},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3450":71227,"_30100":71083,"_20891":120029,"_5":14349,"_27386":119658,"_2933":119717},[],{"_3450":71228,"_30100":71083,"_20891":120031,"_5":14349,"_27386":119658,"_2933":53435},[],{"_3450":71229,"_30100":71083,"_20891":120033,"_5":14349,"_27386":119658,"_2933":120034},[],"Certificado / Dispositivo",{"_3450":71230,"_30100":71083,"_20891":120036,"_5":14349,"_27386":119658,"_2933":53441},[],{"_3450":71231,"_30100":71083,"_20891":120038,"_5":14349,"_27386":119658,"_2933":49448},[],{"_3450":71232,"_30100":71083,"_20891":120040,"_5":14349,"_27386":119658,"_2933":120041},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3450":71233,"_30100":71083,"_20891":120043,"_5":14349,"_27386":119658,"_2933":119725},[],{"_3450":71234,"_30100":71083,"_20891":120045,"_5":14349,"_27386":119662,"_2933":120046},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3450":71235,"_30100":71083,"_20891":120048,"_5":14349,"_27386":119666,"_2933":120049},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3450":71236,"_30100":71083,"_20891":120051,"_5":14349,"_27386":119666,"_2933":120052},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3450":71237,"_30100":71083,"_20891":120054,"_5":14349,"_27386":119670,"_2933":120055},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3450":71238,"_30100":71083,"_20891":120057,"_5":14349,"_27386":119670,"_2933":120058},[],"Transición",{"_3450":71239,"_30100":71083,"_20891":120060,"_5":14349,"_27386":119670,"_2933":120061},[],"Llamadas AWS",{"_3450":71240,"_30100":71083,"_20891":120063,"_5":14349,"_27386":119670,"_2933":120064},[],"`NoRegistrada` → `Solicitada`",{"_3450":71241,"_30100":71083,"_20891":120066,"_5":14349,"_27386":119670,"_2933":120067},[],"ninguna (solo escritura de metadatos)",{"_3450":71242,"_30100":71083,"_20891":120069,"_5":14349,"_27386":119670,"_2933":120070},[],"`Solicitada` → `Registrando`",{"_3450":71243,"_30100":71083,"_20891":120072,"_5":14349,"_27386":119670,"_2933":120073},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3450":71244,"_30100":71083,"_20891":120075,"_5":14349,"_27386":119670,"_2933":120076},[],"`Registrando` → `Completada`",{"_3450":71245,"_30100":71083,"_20891":120078,"_5":14349,"_27386":119670,"_2933":120079},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3450":71246,"_30100":71083,"_20891":120081,"_5":14349,"_27386":119670,"_2933":120082},[],"`Registrando` → `Fallida`",{"_3450":71247,"_30100":71083,"_20891":120084,"_5":14349,"_27386":119670,"_2933":120085},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3450":71248,"_30100":71083,"_20891":120087,"_5":14349,"_27386":119670,"_2933":120088},[],"`Fallida` / `Completada` → `Solicitada`",{"_3450":71249,"_30100":71083,"_20891":120090,"_5":14349,"_27386":119670,"_2933":120091},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3450":71250,"_30100":71083,"_20891":120093,"_5":14349,"_27386":119674,"_2933":120094},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3450":71251,"_30100":71083,"_20891":120096,"_5":14349,"_27386":119674,"_2933":120097},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3450":71252,"_30100":71083,"_20891":120099,"_5":14349,"_27386":119674,"_2933":120100},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3450":71253,"_30100":71083,"_20891":120102,"_5":14349,"_27386":119674,"_2933":120103},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3450":71254,"_30100":71083,"_20891":120105,"_5":14349,"_27386":119674,"_2933":120106},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3450":71255,"_30100":71083,"_20891":120108,"_5":14349,"_27386":119674,"_2933":120109},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3450":71256,"_30100":71083,"_20891":120111,"_5":14349,"_27386":119677,"_2933":120112},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3450":71257,"_30100":71083,"_20891":120114,"_5":14349,"_27386":119680,"_2933":120115},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3450":71258,"_30100":71083,"_20891":120117,"_5":14349,"_27386":119680,"_2933":120118},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3450":71259,"_30100":71083,"_20891":120120,"_5":14349,"_27386":119684,"_2933":120121},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3450":71260,"_30100":71083,"_20891":120123,"_5":14349,"_27386":119688,"_2933":120124},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3450":71261,"_30100":71083,"_20891":120126,"_5":14349,"_27386":119688,"_2933":120127},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3450":71262,"_30100":71083,"_20891":120129,"_5":14349,"_27386":119688,"_2933":120130},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3450":71263,"_30100":71083,"_20891":120132,"_5":14349,"_27386":119688,"_2933":120133},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3450":71264,"_30100":71083,"_20891":120135,"_5":14349,"_27386":119688,"_2933":120136},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3450":71265,"_30100":71083,"_20891":120138,"_5":14349,"_27386":119688,"_2933":120139},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3450":71266,"_30100":71083,"_20891":120141,"_5":14349,"_27386":119692,"_2933":120142},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3450":71267,"_30100":71083,"_20891":120144,"_5":14349,"_27386":119692,"_2933":120145},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3450":71268,"_30100":71083,"_20891":120147,"_5":14349,"_27386":119692,"_2933":120148},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3450":71269,"_30100":71083,"_20891":120150,"_5":14349,"_27386":119692,"_2933":120151},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3450":71270,"_30100":71083,"_20891":120153,"_5":14349,"_27386":119692,"_2933":120154},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3450":71271,"_30100":71083,"_20891":120156,"_5":14349,"_27386":119696,"_2933":120157},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3450":71272,"_30100":71083,"_20891":120159,"_5":14349,"_27386":119696,"_2933":120058},[],{"_3450":71273,"_30100":71083,"_20891":120161,"_5":14349,"_27386":119696,"_2933":120061},[],{"_3450":71274,"_30100":71083,"_20891":120163,"_5":14349,"_27386":119696,"_2933":120164},[],"`SinConfigurar` → `None` / `Auto`",{"_3450":71275,"_30100":71083,"_20891":120166,"_5":14349,"_27386":119696,"_2933":120167},[],"ninguna (solo configuración)",{"_3450":71276,"_30100":71083,"_20891":120169,"_5":14349,"_27386":119696,"_2933":53578},[],{"_3450":71277,"_30100":71083,"_20891":120171,"_5":14349,"_27386":119696,"_2933":120167},[],{"_3450":71278,"_30100":71083,"_20891":120173,"_5":14349,"_27386":119696,"_2933":120174},[],"Cualquiera → `Jitp`",{"_3450":71279,"_30100":71083,"_20891":120176,"_5":14349,"_27386":119696,"_2933":120177},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3450":71280,"_30100":71083,"_20891":120179,"_5":14349,"_27386":119696,"_2933":53589},[],{"_3450":71281,"_30100":71083,"_20891":120181,"_5":14349,"_27386":119696,"_2933":120182},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3450":71282,"_30100":71083,"_20891":120184,"_5":14349,"_27386":119700,"_2933":120185},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3450":71283,"_30100":71083,"_20891":120187,"_5":14349,"_27386":119700,"_2933":120188},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3450":71284,"_30100":71083,"_20891":120190,"_5":14349,"_27386":119700,"_2933":120191},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3450":71285,"_30100":71083,"_20891":120193,"_5":14349,"_27386":119704,"_2933":120194},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3450":71286,"_30100":71083,"_20891":120196,"_5":14349,"_27386":119704,"_2933":120058},[],{"_3450":71287,"_30100":71083,"_20891":120198,"_5":14349,"_27386":119704,"_2933":120061},[],{"_3450":71288,"_30100":71083,"_20891":120200,"_5":14349,"_27386":119704,"_2933":120201},[],"`Ausente` → `Aprovisionado`",{"_3450":71289,"_30100":71083,"_20891":120203,"_5":14349,"_27386":119704,"_2933":120204},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3450":71290,"_30100":71083,"_20891":120206,"_5":14349,"_27386":119704,"_2933":120207},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3450":71291,"_30100":71083,"_20891":120209,"_5":14349,"_27386":119704,"_2933":120210},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3450":71292,"_30100":71083,"_20891":120212,"_5":14349,"_27386":119704,"_2933":120213},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3450":71293,"_30100":71083,"_20891":120215,"_5":14349,"_27386":119708,"_2933":120216},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3450":71294,"_30100":71083,"_20891":120218,"_5":14349,"_27386":119708,"_2933":120219},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3450":71295,"_30100":71083,"_20891":120221,"_5":14349,"_27386":119708,"_2933":120222},[],"Para que el flujo JITP funcione correctamente:",{"_3450":71296,"_30100":71083,"_20891":120224,"_5":14349,"_27386":119708,"_2933":120225},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3450":71297,"_30100":71083,"_20891":120227,"_5":14349,"_27386":119708,"_2933":120228},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3450":71298,"_30100":71083,"_20891":120230,"_5":14349,"_27386":119708,"_2933":120231},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3450":71299,"_30100":71083,"_20891":120233,"_5":14349,"_27386":119708,"_2933":120234},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3450":71300,"_30100":71083,"_20891":120236,"_5":14349,"_27386":119712,"_2933":120237},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3450":71301,"_30100":71083,"_20891":120239,"_5":14349,"_27386":119712,"_2933":120240},[],"Estado en Lamassu",{"_3450":71302,"_30100":71083,"_20891":120242,"_5":14349,"_27386":119712,"_2933":120243},[],"Razón de revocación",{"_3450":71303,"_30100":71083,"_20891":120245,"_5":14349,"_27386":119712,"_2933":120246},[],"Estado en AWS IoT Core",{"_3450":71304,"_30100":71083,"_20891":120248,"_5":14349,"_27386":119712,"_2933":53659},[],{"_3450":71305,"_30100":71083,"_20891":120250,"_5":14349,"_27386":119712,"_2933":120251},[],"Ninguna",{"_3450":71306,"_30100":71083,"_20891":120253,"_5":14349,"_27386":119712,"_2933":53665},[],{"_3450":71307,"_30100":71083,"_20891":120255,"_5":14349,"_27386":119712,"_2933":53668},[],{"_3450":71308,"_30100":71083,"_20891":120257,"_5":14349,"_27386":119712,"_2933":53671},[],{"_3450":71309,"_30100":71083,"_20891":120259,"_5":14349,"_27386":119712,"_2933":53674},[],{"_3450":71310,"_30100":71083,"_20891":120261,"_5":14349,"_27386":119712,"_2933":53668},[],{"_3450":71311,"_30100":71083,"_20891":120263,"_5":14349,"_27386":119712,"_2933":120264},[],"Cualquier otra razón",{"_3450":71312,"_30100":71083,"_20891":120266,"_5":14349,"_27386":119712,"_2933":53682},[],{"_3450":71313,"_30100":71083,"_20891":120268,"_5":14349,"_27386":119712,"_2933":120269},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3450":71314,"_30100":71083,"_20891":120271,"_5":14349,"_27386":119716,"_2933":120272},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3450":71315,"_30100":71083,"_20891":120274,"_5":14349,"_27386":119716,"_2933":120058},[],{"_3450":71316,"_30100":71083,"_20891":120276,"_5":14349,"_27386":119716,"_2933":120061},[],{"_3450":71317,"_30100":71083,"_20891":120278,"_5":14349,"_27386":119716,"_2933":120279},[],"`NoSincronizado` → `Active`",{"_3450":71318,"_30100":71083,"_20891":120281,"_5":14349,"_27386":119716,"_2933":53174},[],{"_3450":71319,"_30100":71083,"_20891":120283,"_5":14349,"_27386":119716,"_2933":53700},[],{"_3450":71320,"_30100":71083,"_20891":120285,"_5":14349,"_27386":119716,"_2933":120286},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3450":71321,"_30100":71083,"_20891":120288,"_5":14349,"_27386":119716,"_2933":53706},[],{"_3450":71322,"_30100":71083,"_20891":120290,"_5":14349,"_27386":119716,"_2933":120286},[],{"_3450":71323,"_30100":71083,"_20891":120292,"_5":14349,"_27386":119716,"_2933":53711},[],{"_3450":71324,"_30100":71083,"_20891":120294,"_5":14349,"_27386":119716,"_2933":53174},[],{"_3450":71325,"_30100":71083,"_20891":120296,"_5":14349,"_27386":119716,"_2933":53716},[],{"_3450":71326,"_30100":71083,"_20891":120298,"_5":14349,"_27386":119716,"_2933":120299},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3450":71327,"_30100":71083,"_20891":120301,"_5":14349,"_27386":119720,"_2933":120302},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3450":71328,"_30100":71083,"_20891":120304,"_5":14349,"_27386":119720,"_2933":120305},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3450":71329,"_30100":71083,"_20891":120307,"_5":14349,"_27386":119720,"_2933":120308},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3450":71330,"_30100":71083,"_20891":120310,"_5":14349,"_27386":119724,"_2933":120311},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3450":71331,"_30100":71083,"_20891":120313,"_5":14349,"_27386":119724,"_2933":120314},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3450":71332,"_30100":71083,"_20891":120316,"_5":14349,"_27386":119728,"_2933":120317},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3450":71333,"_30100":71083,"_20891":120319,"_5":14349,"_27386":119728,"_2933":120320},[],"Existen dos tipos de acciones:",{"_3450":71334,"_30100":71083,"_20891":120322,"_5":14349,"_27386":119728,"_2933":120323},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3450":71335,"_30100":71083,"_20891":120325,"_5":14349,"_27386":119728,"_2933":120326},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3450":71336,"_30100":71083,"_20891":120328,"_5":14349,"_27386":119728,"_2933":120329},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3450":71337,"_30100":71083,"_20891":120331,"_5":14349,"_27386":119732,"_2933":120332},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3450":71338,"_30100":71083,"_20891":120334,"_5":14349,"_27386":119732,"_2933":120335},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3450":71339,"_30100":71083,"_20891":120337,"_5":14349,"_27386":119732,"_2933":120338},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3450":71340,"_30100":71083,"_20891":120340,"_5":14349,"_27386":119736,"_2933":120341},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3450":71341,"_30100":71083,"_20891":120343,"_5":14349,"_27386":119736,"_2933":120344},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3450":71342,"_30100":71083,"_20891":120346,"_5":14349,"_27386":119736,"_2933":120347},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3450":71343,"_30100":71083,"_20891":120349,"_5":14349,"_27386":119736,"_2933":120350},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3450":71344,"_30100":71083,"_20891":120352,"_5":14349,"_27386":119736,"_2933":120353},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3450":71345,"_30100":71083,"_20891":120355,"_5":14349,"_27386":119736,"_2933":120356},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3450":71346,"_30100":71083,"_20891":120358,"_5":14349,"_27386":119736,"_2933":120359},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3450":71347,"_30100":71083,"_20891":120361,"_5":14349,"_27386":119736,"_2933":120362},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3450":71348,"_30100":71083,"_20891":120364,"_5":14349,"_27386":119736,"_2933":120365},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3450":71349,"_30100":71083,"_20891":120367,"_5":14349,"_27386":119736,"_2933":120368},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3450":71350,"_30100":71083,"_20891":120370,"_5":14349,"_27386":119736,"_2933":120371},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3450":71351,"_30100":71083,"_20891":120373,"_5":14349,"_27386":119736,"_2933":120374},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3450":71352,"_30100":71083,"_20891":120376,"_5":14349,"_27386":119736,"_2933":120377},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3450":71353,"_30100":71083,"_20891":120379,"_5":14349,"_27386":119736,"_2933":120380},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3450":71354,"_30100":71083,"_20891":120382,"_5":14349,"_27386":119736,"_2933":120383},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3450":71355,"_30100":71083,"_20891":120385,"_5":14349,"_27386":119736,"_2933":120386},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3450":71356,"_30100":71083,"_20891":120388,"_5":14349,"_27386":119736,"_2933":120389},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3450":71357,"_30100":71083,"_20891":120391,"_5":14349,"_27386":119736,"_2933":120392},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3450":71358,"_30100":71083,"_20891":120394,"_5":14349,"_27386":119736,"_2933":120395},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3450":71359,"_30100":71083,"_20891":120397,"_5":14349,"_27386":119736,"_2933":120398},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3450":71360,"_30100":71083,"_20891":120400,"_5":14349,"_27386":119736,"_2933":120401},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3450":71361,"_30100":71083,"_20891":120403,"_5":14349,"_27386":119736,"_2933":120404},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3450":71362,"_30100":71083,"_20891":120406,"_5":14349,"_27386":119736,"_2933":120407},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3450":71363,"_30100":71083,"_20891":120409,"_5":14349,"_27386":119736,"_2933":120410},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3450":71364,"_30100":71364,"_5":14701,"_2933":51534,"_30453":120412,"_20891":120413,"_27386":71364},[49052,117213,51534],[],{"_3450":71365,"_30100":71364,"_20891":120415,"_5":14349,"_27386":71364,"_2933":120416},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3450":71366,"_30100":71364,"_5":30450,"_20891":120418,"_27386":120419,"_2933":120420},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3450":71367,"_30100":71364,"_5":30450,"_20891":120422,"_27386":120423,"_2933":118225},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3450":71368,"_30100":71364,"_5":30450,"_20891":120425,"_27386":120426,"_2933":118400},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3450":71369,"_30100":71364,"_5":30450,"_20891":120428,"_27386":120429,"_2933":119635},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#integraciones",{"_3450":71370,"_30100":71364,"_5":30450,"_20891":120431,"_27386":120432,"_2933":120433},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3450":71371,"_30100":71364,"_20891":120435,"_5":14349,"_27386":71364,"_2933":120436},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3450":71372,"_30100":71364,"_20891":120438,"_5":14349,"_27386":120419,"_2933":120439},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3450":71373,"_30100":71364,"_20891":120441,"_5":14349,"_27386":120419,"_2933":120442},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3450":71374,"_30100":71364,"_20891":120444,"_5":14349,"_27386":120423,"_2933":120445},[],"Recurso",{"_3450":71375,"_30100":71364,"_20891":120447,"_5":14349,"_27386":120423,"_2933":120448},[],"Qué representa",{"_3450":71376,"_30100":71364,"_20891":120450,"_5":14349,"_27386":120423,"_2933":120451},[],"**Dispositivo**",{"_3450":71377,"_30100":71364,"_20891":120453,"_5":14349,"_27386":120423,"_2933":120454},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3450":71378,"_30100":71364,"_20891":120456,"_5":14349,"_27386":120423,"_2933":120457},[],"**Identidad**",{"_3450":71379,"_30100":71364,"_20891":120459,"_5":14349,"_27386":120423,"_2933":120460},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3450":71380,"_30100":71364,"_20891":120462,"_5":14349,"_27386":120423,"_2933":53883},[],{"_3450":71381,"_30100":71364,"_20891":120464,"_5":14349,"_27386":120423,"_2933":120465},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3450":71382,"_30100":71364,"_20891":120467,"_5":14349,"_27386":120423,"_2933":120468},[],"**Flota**",{"_3450":71383,"_30100":71364,"_20891":120470,"_5":14349,"_27386":120423,"_2933":120471},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3450":71384,"_30100":71364,"_20891":120473,"_5":14349,"_27386":120423,"_2933":120474},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3450":71385,"_30100":71364,"_20891":120476,"_5":14349,"_27386":120423,"_2933":120477},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3450":71386,"_30100":71364,"_20891":120479,"_5":14349,"_27386":120426,"_2933":120480},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3450":71387,"_30100":71364,"_20891":120482,"_5":14349,"_27386":120426,"_2933":120483},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3450":71388,"_30100":71364,"_20891":120485,"_5":14349,"_27386":120426,"_2933":120486},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3450":71389,"_30100":71364,"_20891":120488,"_5":14349,"_27386":120426,"_2933":120489},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3450":71390,"_30100":71364,"_20891":120491,"_5":14349,"_27386":120426,"_2933":120492},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3450":71391,"_30100":71364,"_20891":120494,"_5":14349,"_27386":120426,"_2933":120495},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3450":71392,"_30100":71364,"_20891":120497,"_5":14349,"_27386":120426,"_2933":120498},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3450":71393,"_30100":71364,"_20891":120500,"_5":14349,"_27386":120426,"_2933":120501},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3450":71394,"_30100":71364,"_20891":120503,"_5":14349,"_27386":120429,"_2933":120504},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3450":71395,"_30100":71364,"_20891":120506,"_5":14349,"_27386":120429,"_2933":120507},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3450":71396,"_30100":71364,"_20891":120509,"_5":14349,"_27386":120432,"_2933":120510},[],"Participante",{"_3450":71397,"_30100":71364,"_20891":120512,"_5":14349,"_27386":120432,"_2933":120513},[],"Responsabilidad",{"_3450":71398,"_30100":71364,"_20891":120515,"_5":14349,"_27386":120432,"_2933":120516},[],"Administrador PKI",{"_3450":71399,"_30100":71364,"_20891":120518,"_5":14349,"_27386":120432,"_2933":120519},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3450":71400,"_30100":71364,"_20891":120521,"_5":14349,"_27386":120432,"_2933":120522},[],"Administrador del aprovisionamiento",{"_3450":71401,"_30100":71364,"_20891":120524,"_5":14349,"_27386":120432,"_2933":120525},[],"DMS, admisión, autenticación por operación e inventario.",{"_3450":71402,"_30100":71364,"_20891":120527,"_5":14349,"_27386":120432,"_2933":120528},[],"Integrador del dispositivo",{"_3450":71403,"_30100":71364,"_20891":120530,"_5":14349,"_27386":120432,"_2933":120531},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3450":71404,"_30100":71364,"_20891":120533,"_5":14349,"_27386":120432,"_2933":120534},[],"Integrador del consumidor",{"_3450":71405,"_30100":71364,"_20891":120536,"_5":14349,"_27386":120432,"_2933":120537},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3450":71406,"_30100":71364,"_20891":120539,"_5":14349,"_27386":120432,"_2933":120540},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3450":71407,"_30100":71407,"_5":14701,"_2933":120542,"_30453":120543,"_20891":120545,"_27386":71407},"Enrola y conecta tu primer dispositivo",[49052,117213,51534,120544],"Primeros pasos",[],{"_3450":71408,"_30100":71407,"_20891":120547,"_5":14349,"_27386":71407,"_2933":120548},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3450":71409,"_30100":71407,"_5":30450,"_20891":120550,"_27386":120551,"_2933":115791},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3450":71410,"_30100":71407,"_5":30450,"_20891":120553,"_27386":120554,"_2933":120555},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3450":71411,"_30100":71407,"_5":30450,"_20891":120557,"_27386":120558,"_2933":120559},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3450":71412,"_30100":71407,"_5":30450,"_20891":120561,"_27386":120562,"_2933":120563},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3450":71413,"_30100":71407,"_5":30450,"_20891":120565,"_27386":120566,"_2933":120567},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3450":71414,"_30100":71407,"_5":30450,"_20891":120569,"_27386":120570,"_2933":120571},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3450":71415,"_30100":71407,"_5":30450,"_20891":120573,"_27386":120574,"_2933":120575},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3450":71416,"_30100":71407,"_5":30450,"_20891":120577,"_27386":120578,"_2933":120579},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3450":71417,"_30100":71407,"_20891":120581,"_5":14349,"_27386":71407,"_2933":120582},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3450":71418,"_30100":71407,"_20891":120584,"_5":14349,"_27386":120551,"_2933":120585},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3450":71419,"_30100":71407,"_20891":120587,"_5":14349,"_27386":120551,"_2933":120588},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3450":71420,"_30100":71407,"_20891":120590,"_5":14349,"_27386":120551,"_2933":120591},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3450":71421,"_30100":71407,"_20891":120593,"_5":14349,"_27386":120551,"_2933":120594},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3450":71422,"_30100":71407,"_20891":120596,"_5":14349,"_27386":120551,"_2933":120597},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3450":71423,"_30100":71407,"_20891":120599,"_5":14349,"_27386":120554,"_2933":120600},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3450":71424,"_30100":71407,"_20891":120602,"_5":14349,"_27386":120554,"_2933":120603},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3450":71425,"_30100":71407,"_20891":120605,"_5":14349,"_27386":120558,"_2933":120606},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3450":71426,"_30100":71407,"_20891":120608,"_5":14349,"_27386":120558,"_2933":120609},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3450":71427,"_30100":71407,"_20891":120611,"_5":14349,"_27386":120558,"_2933":120612},[],"Ajuste",{"_3450":71428,"_30100":71407,"_20891":120614,"_5":14349,"_27386":120558,"_2933":120615},[],"Valor de evaluación",{"_3450":71429,"_30100":71407,"_20891":120617,"_5":14349,"_27386":120558,"_2933":54039},[],{"_3450":71430,"_30100":71407,"_20891":120619,"_5":14349,"_27386":120558,"_2933":120620},[],"Raíz emisora de `device-root.pem`.",{"_3450":71431,"_30100":71407,"_20891":120622,"_5":14349,"_27386":120558,"_2933":118528},[],{"_3450":71432,"_30100":71407,"_20891":120624,"_5":14349,"_27386":120558,"_2933":120625},[],"Perfil final de 1 hora que acabas de preparar.",{"_3450":71433,"_30100":71407,"_20891":120627,"_5":14349,"_27386":120558,"_2933":54050},[],{"_3450":71434,"_30100":71407,"_20891":120629,"_5":14349,"_27386":120558,"_2933":54053},[],{"_3450":71435,"_30100":71407,"_20891":120631,"_5":14349,"_27386":120558,"_2933":54056},[],{"_3450":71436,"_30100":71407,"_20891":120633,"_5":14349,"_27386":120558,"_2933":120634},[],"Habilitado.",{"_3450":71437,"_30100":71407,"_20891":120636,"_5":14349,"_27386":120558,"_2933":54062},[],{"_3450":71438,"_30100":71407,"_20891":120638,"_5":14349,"_27386":120558,"_2933":120639},[],"Deshabilitado; el ID debe ser nuevo.",{"_3450":71439,"_30100":71407,"_20891":120641,"_5":14349,"_27386":120558,"_2933":120642},[],"Autenticación inicial",{"_3450":71440,"_30100":71407,"_20891":120644,"_5":14349,"_27386":120558,"_2933":120645},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3450":71441,"_30100":71407,"_20891":120647,"_5":14349,"_27386":120558,"_2933":120648},[],"Autenticación de renovación",{"_3450":71442,"_30100":71407,"_20891":120650,"_5":14349,"_27386":120558,"_2933":120651},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3450":71443,"_30100":71407,"_20891":120653,"_5":14349,"_27386":120558,"_2933":54080},[],{"_3450":71444,"_30100":71407,"_20891":120655,"_5":14349,"_27386":120558,"_2933":120656},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3450":71445,"_30100":71407,"_20891":120658,"_5":14349,"_27386":120558,"_2933":54086},[],{"_3450":71446,"_30100":71407,"_20891":120660,"_5":14349,"_27386":120558,"_2933":120661},[],"1 hora.",{"_3450":71447,"_30100":71407,"_20891":120663,"_5":14349,"_27386":120558,"_2933":54092},[],{"_3450":71448,"_30100":71407,"_20891":120665,"_5":14349,"_27386":120558,"_2933":120666},[],"30 minutos / 10 minutos.",{"_3450":71449,"_30100":71407,"_20891":120668,"_5":14349,"_27386":120558,"_2933":54098},[],{"_3450":71450,"_30100":71407,"_20891":120670,"_5":14349,"_27386":120558,"_2933":120671},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3450":71451,"_30100":71407,"_20891":120673,"_5":14349,"_27386":120558,"_2933":51853},[],{"_3450":71452,"_30100":71407,"_20891":120675,"_5":14349,"_27386":120558,"_2933":120676},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3450":71453,"_30100":71407,"_20891":120678,"_5":14349,"_27386":120558,"_2933":54109},[],{"_3450":71454,"_30100":71407,"_20891":120680,"_5":14349,"_27386":120558,"_2933":120681},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3450":71455,"_30100":71407,"_20891":120683,"_5":14349,"_27386":120558,"_2933":120684},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3450":71456,"_30100":71407,"_20891":120686,"_5":14349,"_27386":120562,"_2933":120687},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3450":71457,"_30100":71407,"_20891":120689,"_5":14349,"_27386":120562,"_2933":120690},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3450":71458,"_30100":71407,"_20891":120692,"_5":14349,"_27386":120566,"_2933":120693},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3450":71459,"_30100":71407,"_20891":120695,"_5":14349,"_27386":120566,"_2933":120696},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3450":71460,"_30100":71407,"_20891":120698,"_5":14349,"_27386":120566,"_2933":120699},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3450":71461,"_30100":71407,"_20891":120701,"_5":14349,"_27386":120570,"_2933":120702},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3450":71462,"_30100":71407,"_20891":120704,"_5":14349,"_27386":120570,"_2933":120705},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3450":71463,"_30100":71407,"_20891":120707,"_5":14349,"_27386":120574,"_2933":120708},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3450":71464,"_30100":71407,"_20891":120710,"_5":14349,"_27386":120574,"_2933":120711},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3450":71465,"_30100":71407,"_20891":120713,"_5":14349,"_27386":120574,"_2933":120714},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3450":71466,"_30100":71407,"_20891":120716,"_5":14349,"_27386":120574,"_2933":120717},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3450":71467,"_30100":71407,"_20891":120719,"_5":14349,"_27386":120574,"_2933":120720},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3450":71468,"_30100":71407,"_20891":120722,"_5":14349,"_27386":120578,"_2933":120723},[],"Comprobación",{"_3450":71469,"_30100":71407,"_20891":120725,"_5":14349,"_27386":120578,"_2933":120726},[],"Resultado esperado",{"_3450":71470,"_30100":71407,"_20891":120728,"_5":14349,"_27386":120578,"_2933":120729},[],"Registro",{"_3450":71471,"_30100":71407,"_20891":120731,"_5":14349,"_27386":120578,"_2933":120732},[],"ID creado automáticamente y DMS correcto.",{"_3450":71472,"_30100":71407,"_20891":120734,"_5":14349,"_27386":120578,"_2933":120019},[],{"_3450":71473,"_30100":71407,"_20891":120736,"_5":14349,"_27386":120578,"_2933":120737},[],"CN, perfil, serie y clave verificados.",{"_3450":71474,"_30100":71407,"_20891":120739,"_5":14349,"_27386":120578,"_2933":120740},[],"Inventario",{"_3450":71475,"_30100":71407,"_20891":120742,"_5":14349,"_27386":120578,"_2933":120743},[],"Serie recibida visible como identidad actual y en el historial.",{"_3450":71476,"_30100":71407,"_20891":120745,"_5":14349,"_27386":120578,"_2933":120746},[],"Consumidor",{"_3450":71477,"_30100":71407,"_20891":120748,"_5":14349,"_27386":120578,"_2933":120749},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3450":71478,"_30100":71407,"_20891":120751,"_5":14349,"_27386":120578,"_2933":120752},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3450":71479,"_30100":71407,"_20891":120754,"_5":14349,"_27386":120578,"_2933":120755},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3450":71480,"_30100":71480,"_5":14701,"_2933":118242,"_30453":120757,"_20891":120758,"_27386":71480},[49052,117213,51534,120544],[],{"_3450":71481,"_30100":71480,"_20891":120760,"_5":14349,"_27386":71480,"_2933":120761},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3450":71482,"_30100":71480,"_5":30450,"_20891":120763,"_27386":120764,"_2933":115791},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3450":71483,"_30100":71480,"_5":30450,"_20891":120766,"_27386":120767,"_2933":120768},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3450":71484,"_30100":71480,"_5":30450,"_20891":120770,"_27386":120771,"_2933":120772},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3450":71485,"_30100":71480,"_5":30450,"_20891":120774,"_27386":120775,"_2933":120776},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3450":71486,"_30100":71480,"_5":30450,"_20891":120778,"_27386":120779,"_2933":120780},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3450":71487,"_30100":71480,"_5":30450,"_20891":120782,"_27386":120783,"_2933":120784},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3450":71488,"_30100":71480,"_5":30450,"_20891":120786,"_27386":120787,"_2933":120726},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3450":71489,"_30100":71480,"_5":30450,"_20891":120789,"_27386":120790,"_2933":120791},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3450":71490,"_30100":71480,"_5":30450,"_20891":120793,"_27386":120794,"_2933":120795},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3450":71491,"_30100":71480,"_20891":120797,"_5":14349,"_27386":71480,"_2933":120798},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3450":71492,"_30100":71480,"_20891":120800,"_5":14349,"_27386":71480,"_2933":120801},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3450":71493,"_30100":71480,"_20891":120803,"_5":14349,"_27386":120764,"_2933":120804},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3450":71494,"_30100":71480,"_20891":120806,"_5":14349,"_27386":120764,"_2933":120807},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3450":71495,"_30100":71480,"_20891":120809,"_5":14349,"_27386":120764,"_2933":120810},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3450":71496,"_30100":71480,"_20891":120812,"_5":14349,"_27386":120764,"_2933":120813},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3450":71497,"_30100":71480,"_20891":120815,"_5":14349,"_27386":120767,"_2933":120816},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3450":71498,"_30100":71480,"_20891":120818,"_5":14349,"_27386":120767,"_2933":120819},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3450":71499,"_30100":71480,"_20891":120821,"_5":14349,"_27386":120767,"_2933":120822},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3450":71500,"_30100":71480,"_20891":120824,"_5":14349,"_27386":120767,"_2933":120825},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3450":71501,"_30100":71480,"_20891":120827,"_5":14349,"_27386":120767,"_2933":120828},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3450":71502,"_30100":71480,"_20891":120830,"_5":14349,"_27386":120767,"_2933":120831},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3450":71503,"_30100":71480,"_20891":120833,"_5":14349,"_27386":120767,"_2933":120834},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3450":71504,"_30100":71480,"_20891":120836,"_5":14349,"_27386":120767,"_2933":120837},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3450":71505,"_30100":71480,"_20891":120839,"_5":14349,"_27386":120771,"_2933":120840},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3450":71506,"_30100":71480,"_20891":120842,"_5":14349,"_27386":120771,"_2933":54274},[],{"_3450":71507,"_30100":71480,"_20891":120844,"_5":14349,"_27386":120771,"_2933":120845},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3450":71508,"_30100":71480,"_20891":120847,"_5":14349,"_27386":120771,"_2933":120848},[],"**Icon** y **Tags**: clasificación opcional.",{"_3450":71509,"_30100":71480,"_20891":120850,"_5":14349,"_27386":120771,"_2933":120851},[],"Confirma el registro.",{"_3450":71510,"_30100":71480,"_20891":120853,"_5":14349,"_27386":120775,"_2933":120854},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3450":71511,"_30100":71480,"_20891":120856,"_5":14349,"_27386":120775,"_2933":120857},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3450":71512,"_30100":71480,"_20891":120859,"_5":14349,"_27386":120779,"_2933":120860},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3450":71513,"_30100":71480,"_20891":120862,"_5":14349,"_27386":120779,"_2933":120863},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3450":71514,"_30100":71480,"_20891":120865,"_5":14349,"_27386":120783,"_2933":120866},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3450":71515,"_30100":71480,"_20891":120868,"_5":14349,"_27386":120783,"_2933":120869},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3450":71516,"_30100":71480,"_20891":120871,"_5":14349,"_27386":120787,"_2933":120723},[],{"_3450":71517,"_30100":71480,"_20891":120873,"_5":14349,"_27386":120787,"_2933":120874},[],"Resultado",{"_3450":71518,"_30100":71480,"_20891":120876,"_5":14349,"_27386":120787,"_2933":120005},[],{"_3450":71519,"_30100":71480,"_20891":120878,"_5":14349,"_27386":120787,"_2933":120879},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3450":71520,"_30100":71480,"_20891":120881,"_5":14349,"_27386":120787,"_2933":120882},[],"Identidad actual",{"_3450":71521,"_30100":71480,"_20891":120884,"_5":14349,"_27386":120787,"_2933":120885},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3450":71522,"_30100":71480,"_20891":120887,"_5":14349,"_27386":120787,"_2933":120888},[],"Historial",{"_3450":71523,"_30100":71480,"_20891":120890,"_5":14349,"_27386":120787,"_2933":120891},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3450":71524,"_30100":71480,"_20891":120893,"_5":14349,"_27386":120787,"_2933":120894},[],"Clave y certificado",{"_3450":71525,"_30100":71480,"_20891":120896,"_5":14349,"_27386":120787,"_2933":120897},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3450":71526,"_30100":71480,"_20891":120899,"_5":14349,"_27386":120790,"_2933":120900},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3450":71527,"_30100":71480,"_20891":120902,"_5":14349,"_27386":120790,"_2933":120903},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3450":71528,"_30100":71480,"_20891":120905,"_5":14349,"_27386":120790,"_2933":120906},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3450":71529,"_30100":71480,"_20891":120908,"_5":14349,"_27386":120790,"_2933":120909},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3450":71530,"_30100":71480,"_20891":120911,"_5":14349,"_27386":120794,"_2933":120912},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3450":71531,"_30100":71480,"_20891":120914,"_5":14349,"_27386":120794,"_2933":120915},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3450":71532,"_30100":71480,"_20891":120917,"_5":14349,"_27386":120794,"_2933":120918},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3450":71533,"_30100":71533,"_5":14701,"_2933":120920,"_30453":120921,"_20891":120922,"_27386":71533},"Plataforma Lamassu IoT",[49052,117213],[],{"_3450":71534,"_30100":71533,"_20891":120924,"_5":14349,"_27386":71533,"_2933":120925},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3450":71535,"_30100":71533,"_5":30450,"_20891":120927,"_27386":120928,"_2933":120420},[],"/docs/pr-preview/pr-61/es/platform/overview#empieza-aquí",{"_3450":71536,"_30100":71533,"_5":30450,"_20891":120930,"_27386":120931,"_2933":120932},[],"/docs/pr-preview/pr-61/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3450":71537,"_30100":71533,"_5":30450,"_20891":120934,"_27386":120935,"_2933":120936},[],"/docs/pr-preview/pr-61/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3450":71538,"_30100":71533,"_5":30450,"_20891":120938,"_27386":120939,"_2933":120940},[],"/docs/pr-preview/pr-61/es/platform/overview#capacidades-principales","Capacidades principales",{"_3450":71539,"_30100":71533,"_5":30450,"_20891":120942,"_27386":120943,"_2933":120944},[],"/docs/pr-preview/pr-61/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3450":71540,"_30100":71533,"_5":30450,"_20891":120946,"_27386":120947,"_2933":120948},[],"/docs/pr-preview/pr-61/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3450":71541,"_30100":71533,"_5":30450,"_20891":120950,"_27386":120951,"_2933":120952},[],"/docs/pr-preview/pr-61/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3450":71542,"_30100":71533,"_5":30450,"_20891":120954,"_27386":120955,"_2933":120956},[],"/docs/pr-preview/pr-61/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3450":71543,"_30100":71533,"_5":30450,"_20891":120958,"_27386":120959,"_2933":120960},[],"/docs/pr-preview/pr-61/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3450":71544,"_30100":71533,"_5":30450,"_20891":120962,"_27386":120963,"_2933":120964},[],"/docs/pr-preview/pr-61/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3450":71545,"_30100":71533,"_5":30450,"_20891":120966,"_27386":120967,"_2933":120968},[],"/docs/pr-preview/pr-61/es/platform/overview#referencia-operativa","Referencia operativa",{"_3450":71546,"_30100":71533,"_20891":120970,"_5":14349,"_27386":71533,"_2933":120971},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3450":71547,"_30100":71533,"_20891":120973,"_5":14349,"_27386":120928,"_2933":120974},[],"Elige el resultado que necesitas obtener:",{"_3450":71548,"_30100":71533,"_20891":120976,"_5":14349,"_27386":120928,"_2933":120977},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3450":71549,"_30100":71533,"_20891":120979,"_5":14349,"_27386":120928,"_2933":120980},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3450":71550,"_30100":71533,"_20891":120982,"_5":14349,"_27386":120928,"_2933":120983},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3450":71551,"_30100":71533,"_20891":120985,"_5":14349,"_27386":120931,"_2933":120986},[],"Bloque",{"_3450":71552,"_30100":71533,"_20891":120988,"_5":14349,"_27386":120931,"_2933":120989},[],"Qué gestionas",{"_3450":71553,"_30100":71533,"_20891":120991,"_5":14349,"_27386":120931,"_2933":120992},[],"Punto de entrada",{"_3450":71554,"_30100":71533,"_20891":120994,"_5":14349,"_27386":120931,"_2933":54427},[],{"_3450":71555,"_30100":71533,"_20891":120996,"_5":14349,"_27386":120931,"_2933":120997},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3450":71556,"_30100":71533,"_20891":120999,"_5":14349,"_27386":120931,"_2933":121000},[],"Visión general de PKI",{"_3450":71557,"_30100":71533,"_20891":121002,"_5":14349,"_27386":120931,"_2933":54436},[],{"_3450":71558,"_30100":71533,"_20891":121004,"_5":14349,"_27386":120931,"_2933":121005},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3450":71559,"_30100":71533,"_20891":121007,"_5":14349,"_27386":120931,"_2933":121008},[],"Visión general de IoT Fleets",{"_3450":71560,"_30100":71533,"_20891":121010,"_5":14349,"_27386":120931,"_2933":121011},[],"**Administración**",{"_3450":71561,"_30100":71533,"_20891":121013,"_5":14349,"_27386":120931,"_2933":121014},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3450":71562,"_30100":71533,"_20891":121016,"_5":14349,"_27386":120931,"_2933":117211},[],{"_3450":71563,"_30100":71533,"_20891":121018,"_5":14349,"_27386":120931,"_2933":121019},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3450":71564,"_30100":71533,"_20891":121021,"_5":14349,"_27386":120935,"_2933":121022},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3450":71565,"_30100":71533,"_20891":121024,"_5":14349,"_27386":120935,"_2933":121025},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3450":71566,"_30100":71533,"_20891":121027,"_5":14349,"_27386":120935,"_2933":121028},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3450":71567,"_30100":71533,"_20891":121030,"_5":14349,"_27386":120935,"_2933":121031},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3450":71568,"_30100":71533,"_20891":121033,"_5":14349,"_27386":120935,"_2933":121034},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3450":71569,"_30100":71533,"_20891":121036,"_5":14349,"_27386":120935,"_2933":121037},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3450":71570,"_30100":71533,"_20891":121039,"_5":14349,"_27386":120943,"_2933":121040},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3450":71571,"_30100":71533,"_20891":121042,"_5":14349,"_27386":120947,"_2933":121043},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3450":71572,"_30100":71533,"_20891":121045,"_5":14349,"_27386":120951,"_2933":121046},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3450":71573,"_30100":71533,"_20891":121048,"_5":14349,"_27386":120955,"_2933":121049},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3450":71574,"_30100":71533,"_20891":121051,"_5":14349,"_27386":120959,"_2933":121052},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3450":71575,"_30100":71533,"_20891":121054,"_5":14349,"_27386":120963,"_2933":121055},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3450":71576,"_30100":71533,"_20891":121057,"_5":14349,"_27386":120967,"_2933":120513},[],{"_3450":71577,"_30100":71533,"_20891":121059,"_5":14349,"_27386":120967,"_2933":121060},[],"Qué prepara o comprueba",{"_3450":71578,"_30100":71533,"_20891":121062,"_5":14349,"_27386":120967,"_2933":120516},[],{"_3450":71579,"_30100":71533,"_20891":121064,"_5":14349,"_27386":120967,"_2933":121065},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3450":71580,"_30100":71533,"_20891":121067,"_5":14349,"_27386":120967,"_2933":121068},[],"Administrador de la flota",{"_3450":71581,"_30100":71533,"_20891":121070,"_5":14349,"_27386":120967,"_2933":121071},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3450":71582,"_30100":71533,"_20891":121073,"_5":14349,"_27386":120967,"_2933":120528},[],{"_3450":71583,"_30100":71533,"_20891":121075,"_5":14349,"_27386":120967,"_2933":121076},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3450":71584,"_30100":71533,"_20891":121078,"_5":14349,"_27386":120967,"_2933":120534},[],{"_3450":71585,"_30100":71533,"_20891":121080,"_5":14349,"_27386":120967,"_2933":121081},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3450":71586,"_30100":71533,"_20891":121083,"_5":14349,"_27386":120967,"_2933":121084},[],"Operador de infraestructura",{"_3450":71587,"_30100":71533,"_20891":121086,"_5":14349,"_27386":120967,"_2933":121087},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3450":71588,"_30100":71533,"_20891":121089,"_5":14349,"_27386":120967,"_2933":121090},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3450":71589,"_30100":71589,"_5":14701,"_2933":121092,"_30453":121093,"_20891":121095,"_27386":71589},"Jerarquía y rotación de CAs",[49052,117213,54528,121094],"Claves, autoridades y certificados",[],{"_3450":71590,"_30100":71589,"_20891":121097,"_5":14349,"_27386":71589,"_2933":121098},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3450":71591,"_30100":71589,"_5":30450,"_20891":121100,"_27386":121101,"_2933":121102},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3450":71592,"_30100":71589,"_5":30450,"_20891":121104,"_27386":121105,"_2933":121106},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3450":71593,"_30100":71589,"_5":30450,"_20891":121108,"_27386":121109,"_2933":121110},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3450":71594,"_30100":71589,"_5":30450,"_20891":121112,"_27386":121113,"_2933":121114},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3450":71595,"_30100":71589,"_5":30450,"_20891":121116,"_27386":121117,"_2933":121118},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3450":71596,"_30100":71589,"_5":30450,"_20891":121120,"_27386":121121,"_2933":121122},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3450":71597,"_30100":71589,"_5":30450,"_20891":121124,"_27386":121125,"_2933":121126},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3450":71598,"_30100":71589,"_5":30450,"_20891":121128,"_27386":121129,"_2933":121130},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3450":71599,"_30100":71589,"_5":30450,"_20891":121132,"_27386":121133,"_2933":121134},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3450":71600,"_30100":71589,"_5":30450,"_20891":121136,"_27386":121137,"_2933":121138},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3450":71601,"_30100":71589,"_5":30450,"_20891":121140,"_27386":121141,"_2933":121142},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3450":71602,"_30100":71589,"_5":30450,"_20891":121144,"_27386":121145,"_2933":121146},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3450":71603,"_30100":71589,"_20891":121148,"_5":14349,"_27386":71589,"_2933":121149},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3450":71604,"_30100":71589,"_20891":121151,"_5":14349,"_27386":71589,"_2933":121152},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3450":71605,"_30100":71589,"_20891":121154,"_5":14349,"_27386":121101,"_2933":121155},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3450":71606,"_30100":71589,"_20891":121157,"_5":14349,"_27386":121101,"_2933":121158},[],"entorno, como producción y preproducción;",{"_3450":71607,"_30100":71589,"_20891":121160,"_5":14349,"_27386":121101,"_2933":121161},[],"propietario o equipo operador;",{"_3450":71608,"_30100":71589,"_20891":121163,"_5":14349,"_27386":121101,"_2933":121164},[],"familia de dispositivos o proceso de fabricación;",{"_3450":71609,"_30100":71589,"_20891":121166,"_5":14349,"_27386":121101,"_2933":121167},[],"región o requisito regulatorio;",{"_3450":71610,"_30100":71589,"_20891":121169,"_5":14349,"_27386":121101,"_2933":121170},[],"motor criptográfico o política de clave;",{"_3450":71611,"_30100":71589,"_20891":121172,"_5":14349,"_27386":121101,"_2933":121173},[],"ventana de mantenimiento y ritmo de renovación.",{"_3450":71612,"_30100":71589,"_20891":121175,"_5":14349,"_27386":121101,"_2933":121176},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3450":71613,"_30100":71589,"_20891":121178,"_5":14349,"_27386":121101,"_2933":121179},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3450":71614,"_30100":71589,"_20891":121181,"_5":14349,"_27386":121105,"_2933":121182},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3450":71615,"_30100":71589,"_20891":121184,"_5":14349,"_27386":121105,"_2933":121185},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3450":71616,"_30100":71589,"_20891":121187,"_5":14349,"_27386":121105,"_2933":121188},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3450":71617,"_30100":71589,"_20891":121190,"_5":14349,"_27386":121105,"_2933":121191},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3450":71618,"_30100":71589,"_20891":121193,"_5":14349,"_27386":121109,"_2933":121194},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3450":71619,"_30100":71589,"_20891":121196,"_5":14349,"_27386":121109,"_2933":121197},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3450":71620,"_30100":71589,"_20891":121199,"_5":14349,"_27386":121109,"_2933":121200},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3450":71621,"_30100":71589,"_20891":121202,"_5":14349,"_27386":121109,"_2933":121203},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3450":71622,"_30100":71589,"_20891":121205,"_5":14349,"_27386":121117,"_2933":121206},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3450":71623,"_30100":71589,"_20891":121208,"_5":14349,"_27386":121121,"_2933":121209},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3450":71624,"_30100":71589,"_20891":121211,"_5":14349,"_27386":121125,"_2933":121212},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3450":71625,"_30100":71589,"_20891":121214,"_5":14349,"_27386":121129,"_2933":121215},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3450":71626,"_30100":71589,"_20891":121217,"_5":14349,"_27386":121133,"_2933":121218},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3450":71627,"_30100":71589,"_20891":121220,"_5":14349,"_27386":121137,"_2933":121221},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3450":71628,"_30100":71589,"_20891":121223,"_5":14349,"_27386":121141,"_2933":121224},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3450":71629,"_30100":71589,"_20891":121226,"_5":14349,"_27386":121141,"_2933":121227},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3450":71630,"_30100":71589,"_20891":121229,"_5":14349,"_27386":121141,"_2933":121230},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3450":71631,"_30100":71589,"_20891":121232,"_5":14349,"_27386":121141,"_2933":121233},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3450":71632,"_30100":71589,"_20891":121235,"_5":14349,"_27386":121145,"_2933":121236},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3450":71633,"_30100":71589,"_20891":121238,"_5":14349,"_27386":121145,"_2933":121239},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3450":71634,"_30100":71589,"_20891":121241,"_5":14349,"_27386":121145,"_2933":121242},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3450":71635,"_30100":71589,"_20891":121244,"_5":14349,"_27386":121145,"_2933":121245},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3450":71636,"_30100":71589,"_20891":121247,"_5":14349,"_27386":121145,"_2933":121248},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3450":71637,"_30100":71589,"_20891":121250,"_5":14349,"_27386":121145,"_2933":121251},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3450":71638,"_30100":71589,"_20891":121253,"_5":14349,"_27386":121145,"_2933":121254},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3450":71639,"_30100":71639,"_5":14701,"_2933":121256,"_30453":121257,"_20891":121258,"_27386":71639},"Autoridades de certificación",[49052,117213,54528,121094],[],{"_3450":71640,"_30100":71639,"_20891":121260,"_5":14349,"_27386":71639,"_2933":121261},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3450":71641,"_30100":71639,"_5":30450,"_20891":121263,"_27386":121264,"_2933":121265},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3450":71642,"_30100":71639,"_5":30450,"_20891":121267,"_27386":121268,"_2933":121269},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3450":71643,"_30100":71639,"_5":30450,"_20891":121271,"_27386":121272,"_2933":115791},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3450":71644,"_30100":71639,"_5":30450,"_20891":121274,"_27386":121275,"_2933":121276},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3450":71645,"_30100":71639,"_5":30450,"_20891":121278,"_27386":121279,"_2933":121280},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3450":71646,"_30100":71639,"_5":30450,"_20891":121282,"_27386":121283,"_2933":121284},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3450":71647,"_30100":71639,"_5":30450,"_20891":121286,"_27386":121287,"_2933":121288},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3450":71648,"_30100":71639,"_5":30450,"_20891":121290,"_27386":121291,"_2933":121292},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3450":71649,"_30100":71639,"_5":30450,"_20891":121294,"_27386":121295,"_2933":121296},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3450":71650,"_30100":71639,"_5":30450,"_20891":121298,"_27386":121299,"_2933":121300},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3450":71651,"_30100":71639,"_5":30450,"_20891":121302,"_27386":121303,"_2933":121304},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3450":71652,"_30100":71639,"_5":30450,"_20891":121306,"_27386":121307,"_2933":121308},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3450":71653,"_30100":71639,"_5":30450,"_20891":121310,"_27386":121311,"_2933":121312},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3450":71654,"_30100":71639,"_5":30450,"_20891":121314,"_27386":121315,"_2933":121316},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3450":71655,"_30100":71639,"_5":30450,"_20891":121318,"_27386":121319,"_2933":121320},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3450":71656,"_30100":71639,"_5":30450,"_20891":121322,"_27386":121323,"_2933":121324},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3450":71657,"_30100":71639,"_5":30450,"_20891":121326,"_27386":121327,"_2933":121328},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3450":71658,"_30100":71639,"_5":30450,"_20891":121330,"_27386":121331,"_2933":121332},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3450":71659,"_30100":71639,"_5":30450,"_20891":121334,"_27386":121335,"_2933":121336},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3450":71660,"_30100":71639,"_5":30450,"_20891":121338,"_27386":121339,"_2933":121340},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3450":71661,"_30100":71639,"_5":30450,"_20891":121342,"_27386":121343,"_2933":121344},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3450":71662,"_30100":71639,"_5":30450,"_20891":121346,"_27386":121347,"_2933":121348},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3450":71663,"_30100":71639,"_5":30450,"_20891":121350,"_27386":121351,"_2933":121352},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3450":71664,"_30100":71639,"_20891":121354,"_5":14349,"_27386":71639,"_2933":121355},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3450":71665,"_30100":71639,"_20891":121357,"_5":14349,"_27386":71639,"_2933":121358},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3450":71666,"_30100":71639,"_20891":121360,"_5":14349,"_27386":71639,"_2933":121361},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3450":71667,"_30100":71639,"_20891":121363,"_5":14349,"_27386":121264,"_2933":121364},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3450":71668,"_30100":71639,"_20891":121366,"_5":14349,"_27386":121264,"_2933":121367},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3450":71669,"_30100":71639,"_20891":121369,"_5":14349,"_27386":121264,"_2933":121370},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3450":71670,"_30100":71639,"_20891":121372,"_5":14349,"_27386":121264,"_2933":121373},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3450":71671,"_30100":71639,"_20891":121375,"_5":14349,"_27386":121264,"_2933":121376},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3450":71672,"_30100":71639,"_20891":121378,"_5":14349,"_27386":121272,"_2933":121379},[],"Decide si la CA será raíz o intermedia.",{"_3450":71673,"_30100":71639,"_20891":121381,"_5":14349,"_27386":121272,"_2933":121382},[],"Elige el motor que custodiará la clave.",{"_3450":71674,"_30100":71639,"_20891":121384,"_5":14349,"_27386":121272,"_2933":121385},[],"Define una validez superior a la de los certificados que emitirá.",{"_3450":71675,"_30100":71639,"_20891":121387,"_5":14349,"_27386":121272,"_2933":121388},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3450":71676,"_30100":71639,"_20891":121390,"_5":14349,"_27386":121275,"_2933":121391},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3450":71677,"_30100":71639,"_20891":121393,"_5":14349,"_27386":121279,"_2933":121394},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3450":71678,"_30100":71639,"_20891":121396,"_5":14349,"_27386":121279,"_2933":121397},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3450":71679,"_30100":71639,"_20891":121399,"_5":14349,"_27386":121283,"_2933":121400},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3450":71680,"_30100":71639,"_20891":121402,"_5":14349,"_27386":121287,"_2933":121403},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3450":71681,"_30100":71639,"_20891":121405,"_5":14349,"_27386":121287,"_2933":121406},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3450":71682,"_30100":71639,"_20891":121408,"_5":14349,"_27386":121287,"_2933":121409},[],"`ST`: estado o provincia.",{"_3450":71683,"_30100":71639,"_20891":121411,"_5":14349,"_27386":121287,"_2933":121412},[],"`L`: localidad.",{"_3450":71684,"_30100":71639,"_20891":121414,"_5":14349,"_27386":121287,"_2933":121415},[],"`O`: organización.",{"_3450":71685,"_30100":71639,"_20891":121417,"_5":14349,"_27386":121287,"_2933":121418},[],"`OU`: unidad organizativa.",{"_3450":71686,"_30100":71639,"_20891":121420,"_5":14349,"_27386":121287,"_2933":121421},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3450":71687,"_30100":71639,"_20891":121423,"_5":14349,"_27386":121291,"_2933":121424},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3450":71688,"_30100":71639,"_20891":121426,"_5":14349,"_27386":121291,"_2933":121427},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3450":71689,"_30100":71639,"_20891":121429,"_5":14349,"_27386":121295,"_2933":121430},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3450":71690,"_30100":71639,"_20891":121432,"_5":14349,"_27386":121295,"_2933":121433},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3450":71691,"_30100":71639,"_20891":121435,"_5":14349,"_27386":121299,"_2933":121436},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3450":71692,"_30100":71639,"_20891":121438,"_5":14349,"_27386":121299,"_2933":121439},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3450":71693,"_30100":71639,"_20891":121441,"_5":14349,"_27386":121303,"_2933":121442},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3450":71694,"_30100":71639,"_20891":121444,"_5":14349,"_27386":121303,"_2933":121445},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3450":71695,"_30100":71639,"_20891":121447,"_5":14349,"_27386":121303,"_2933":121448},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3450":71696,"_30100":71639,"_20891":121450,"_5":14349,"_27386":121307,"_2933":121451},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3450":71697,"_30100":71639,"_20891":121453,"_5":14349,"_27386":121311,"_2933":121454},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3450":71698,"_30100":71639,"_20891":121456,"_5":14349,"_27386":121311,"_2933":121457},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3450":71699,"_30100":71639,"_20891":121459,"_5":14349,"_27386":121315,"_2933":121460},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3450":71700,"_30100":71639,"_20891":121462,"_5":14349,"_27386":121319,"_2933":121463},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3450":71701,"_30100":71639,"_20891":121465,"_5":14349,"_27386":121319,"_2933":121466},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3450":71702,"_30100":71639,"_20891":121468,"_5":14349,"_27386":121323,"_2933":121469},[],"Abre una CA desde el inventario para consultar:",{"_3450":71703,"_30100":71639,"_20891":121471,"_5":14349,"_27386":121323,"_2933":121472},[],"Estado y periodo de validez.",{"_3450":71704,"_30100":71639,"_20891":121474,"_5":14349,"_27386":121323,"_2933":121475},[],"Certificado y cadena en formato PEM.",{"_3450":71705,"_30100":71639,"_20891":121477,"_5":14349,"_27386":121323,"_2933":121478},[],"Número de certificados activos, expirados y revocados.",{"_3450":71706,"_30100":71639,"_20891":121480,"_5":14349,"_27386":121323,"_2933":121481},[],"Certificados emitidos en **Issued Certificates**.",{"_3450":71707,"_30100":71639,"_20891":121483,"_5":14349,"_27386":121323,"_2933":121484},[],"CRL vinculada a la autoridad.",{"_3450":71708,"_30100":71639,"_20891":121486,"_5":14349,"_27386":121323,"_2933":121487},[],"Metadatos y motor criptográfico asociado.",{"_3450":71709,"_30100":71639,"_20891":121489,"_5":14349,"_27386":121323,"_2933":121490},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3450":71710,"_30100":71639,"_20891":121492,"_5":14349,"_27386":121327,"_2933":121493},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3450":71711,"_30100":71639,"_20891":121495,"_5":14349,"_27386":121327,"_2933":121496},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3450":71712,"_30100":71639,"_20891":121498,"_5":14349,"_27386":121327,"_2933":121499},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3450":71713,"_30100":71639,"_20891":121501,"_5":14349,"_27386":121327,"_2933":121502},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3450":71714,"_30100":71639,"_20891":121504,"_5":14349,"_27386":121331,"_2933":121505},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3450":71715,"_30100":71639,"_20891":121507,"_5":14349,"_27386":121335,"_2933":121508},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3450":71716,"_30100":71639,"_20891":121510,"_5":14349,"_27386":121339,"_2933":121511},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3450":71717,"_30100":71639,"_20891":121513,"_5":14349,"_27386":121343,"_2933":121514},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3450":71718,"_30100":71639,"_20891":121516,"_5":14349,"_27386":121347,"_2933":121517},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3450":71719,"_30100":71639,"_20891":121519,"_5":14349,"_27386":121351,"_2933":121520},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3450":71720,"_30100":71639,"_20891":121522,"_5":14349,"_27386":121351,"_2933":121523},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3450":71721,"_30100":71639,"_20891":121525,"_5":14349,"_27386":121351,"_2933":121526},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3450":71722,"_30100":71722,"_5":14701,"_2933":121528,"_30453":121529,"_20891":121530,"_27386":71722},"Perfiles de certificado",[49052,117213,54528,121094],[],{"_3450":71723,"_30100":71722,"_20891":121532,"_5":14349,"_27386":71722,"_2933":121533},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3450":71724,"_30100":71722,"_5":30450,"_20891":121535,"_27386":121536,"_2933":121537},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3450":71725,"_30100":71722,"_5":30450,"_20891":121539,"_27386":121540,"_2933":121541},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#validez","Validez",{"_3450":71726,"_30100":71722,"_5":30450,"_20891":121543,"_27386":121544,"_2933":121545},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3450":71727,"_30100":71722,"_5":30450,"_20891":121547,"_27386":121548,"_2933":121549},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3450":71728,"_30100":71722,"_5":30450,"_20891":121551,"_27386":121552,"_2933":121553},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3450":71729,"_30100":71722,"_5":30450,"_20891":121555,"_27386":121556,"_2933":121557},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3450":71730,"_30100":71722,"_5":30450,"_20891":121559,"_27386":121560,"_2933":121561},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3450":71731,"_30100":71722,"_5":30450,"_20891":121563,"_27386":121564,"_2933":121565},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3450":71732,"_30100":71722,"_5":30450,"_20891":121567,"_27386":121568,"_2933":121569},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3450":71733,"_30100":71722,"_5":30450,"_20891":121571,"_27386":121572,"_2933":121573},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3450":71734,"_30100":71722,"_5":30450,"_20891":121575,"_27386":121576,"_2933":121577},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3450":71735,"_30100":71722,"_5":30450,"_20891":121579,"_27386":121580,"_2933":121581},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3450":71736,"_30100":71722,"_5":30450,"_20891":121583,"_27386":121584,"_2933":121585},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3450":71737,"_30100":71722,"_5":30450,"_20891":121587,"_27386":121588,"_2933":121589},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3450":71738,"_30100":71722,"_5":30450,"_20891":121591,"_27386":121592,"_2933":121593},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3450":71739,"_30100":71722,"_5":30450,"_20891":121595,"_27386":121596,"_2933":121597},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3450":71740,"_30100":71722,"_20891":121599,"_5":14349,"_27386":71722,"_2933":121600},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3450":71741,"_30100":71722,"_20891":121602,"_5":14349,"_27386":71722,"_2933":121603},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3450":71742,"_30100":71722,"_20891":121605,"_5":14349,"_27386":121540,"_2933":121606},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3450":71743,"_30100":71722,"_20891":121608,"_5":14349,"_27386":121540,"_2933":121609},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3450":71744,"_30100":71722,"_20891":121611,"_5":14349,"_27386":121544,"_2933":121612},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3450":71745,"_30100":71722,"_20891":121614,"_5":14349,"_27386":121548,"_2933":121615},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3450":71746,"_30100":71722,"_20891":121617,"_5":14349,"_27386":121548,"_2933":121618},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3450":71747,"_30100":71722,"_20891":121620,"_5":14349,"_27386":121548,"_2933":121621},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3450":71748,"_30100":71722,"_20891":121623,"_5":14349,"_27386":121552,"_2933":121624},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3450":71749,"_30100":71722,"_20891":121626,"_5":14349,"_27386":121556,"_2933":121627},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3450":71750,"_30100":71722,"_20891":121629,"_5":14349,"_27386":121556,"_2933":121630},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3450":71751,"_30100":71722,"_20891":121632,"_5":14349,"_27386":121560,"_2933":121633},[],"La aplicación criptográfica puede:",{"_3450":71752,"_30100":71722,"_20891":121635,"_5":14349,"_27386":121560,"_2933":121636},[],"permitir o bloquear claves RSA;",{"_3450":71753,"_30100":71722,"_20891":121638,"_5":14349,"_27386":121560,"_2933":121639},[],"limitar los tamaños RSA admitidos;",{"_3450":71754,"_30100":71722,"_20891":121641,"_5":14349,"_27386":121560,"_2933":121642},[],"permitir o bloquear claves ECDSA;",{"_3450":71755,"_30100":71722,"_20891":121644,"_5":14349,"_27386":121560,"_2933":121645},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3450":71756,"_30100":71722,"_20891":121647,"_5":14349,"_27386":121560,"_2933":121648},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3450":71757,"_30100":71722,"_20891":121650,"_5":14349,"_27386":121564,"_2933":121651},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3450":71758,"_30100":71722,"_20891":121653,"_5":14349,"_27386":121564,"_2933":116973},[],{"_3450":71759,"_30100":71722,"_20891":121655,"_5":14349,"_27386":121564,"_2933":121656},[],"Primera opción",{"_3450":71760,"_30100":71722,"_20891":121658,"_5":14349,"_27386":121564,"_2933":121659},[],"Segunda opción",{"_3450":71761,"_30100":71722,"_20891":121661,"_5":14349,"_27386":121564,"_2933":121662},[],"Si no hay ninguna",{"_3450":71762,"_30100":71722,"_20891":121664,"_5":14349,"_27386":121564,"_2933":121665},[],"Firma directa con una CA",{"_3450":71763,"_30100":71722,"_20891":121667,"_5":14349,"_27386":121564,"_2933":121668},[],"`issuance_profile` incluido en la solicitud",{"_3450":71764,"_30100":71722,"_20891":121670,"_5":14349,"_27386":121564,"_2933":121671},[],"`issuance_profile_id` de la solicitud",{"_3450":71765,"_30100":71722,"_20891":121673,"_5":14349,"_27386":121564,"_2933":121674},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3450":71766,"_30100":71722,"_20891":121676,"_5":14349,"_27386":121564,"_2933":121677},[],"Emisión mediante DMS",{"_3450":71767,"_30100":71722,"_20891":121679,"_5":14349,"_27386":121564,"_2933":55115},[],{"_3450":71768,"_30100":71722,"_20891":121681,"_5":14349,"_27386":121564,"_2933":121682},[],"`settings.issuance_profile` incluido en el DMS",{"_3450":71769,"_30100":71722,"_20891":121684,"_5":14349,"_27386":121564,"_2933":121685},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3450":71770,"_30100":71722,"_20891":121687,"_5":14349,"_27386":121564,"_2933":121688},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3450":71771,"_30100":71722,"_20891":121690,"_5":14349,"_27386":121564,"_2933":121691},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3450":71772,"_30100":71722,"_20891":121693,"_5":14349,"_27386":121572,"_2933":121694},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3450":71773,"_30100":71722,"_20891":121696,"_5":14349,"_27386":121576,"_2933":121697},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3450":71774,"_30100":71722,"_20891":121699,"_5":14349,"_27386":121580,"_2933":121700},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3450":71775,"_30100":71722,"_20891":121702,"_5":14349,"_27386":121584,"_2933":121703},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3450":71776,"_30100":71722,"_20891":121705,"_5":14349,"_27386":121588,"_2933":121706},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3450":71777,"_30100":71722,"_20891":121708,"_5":14349,"_27386":121588,"_2933":121709},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3450":71778,"_30100":71722,"_20891":121711,"_5":14349,"_27386":121592,"_2933":121712},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3450":71779,"_30100":71722,"_20891":121714,"_5":14349,"_27386":121592,"_2933":121715},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3450":71780,"_30100":71722,"_20891":121717,"_5":14349,"_27386":121592,"_2933":121718},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3450":71781,"_30100":71722,"_20891":121720,"_5":14349,"_27386":121592,"_2933":121721},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3450":71782,"_30100":71722,"_20891":121723,"_5":14349,"_27386":121596,"_2933":121724},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3450":71783,"_30100":71722,"_20891":121726,"_5":14349,"_27386":121596,"_2933":121727},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3450":71784,"_30100":71784,"_5":14701,"_2933":121729,"_30453":121730,"_20891":121732,"_27386":71784},"Validación de certificados",[49052,117213,54528,121731],"Validación",[],{"_3450":71785,"_30100":71784,"_20891":121734,"_5":14349,"_27386":71784,"_2933":121735},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3450":71786,"_30100":71784,"_5":30450,"_20891":121737,"_27386":121738,"_2933":121739},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3450":71787,"_30100":71784,"_5":30450,"_20891":121741,"_27386":121742,"_2933":121743},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3450":71788,"_30100":71784,"_5":30450,"_20891":121745,"_27386":121746,"_2933":121747},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3450":71789,"_30100":71784,"_20891":121749,"_5":14349,"_27386":71784,"_2933":121750},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3450":71790,"_30100":71784,"_20891":121752,"_5":14349,"_27386":121738,"_2933":121753},[],"Verifica estos criterios juntos:",{"_3450":71791,"_30100":71784,"_20891":121755,"_5":14349,"_27386":121738,"_2933":120723},[],{"_3450":71792,"_30100":71784,"_20891":121757,"_5":14349,"_27386":121738,"_2933":121758},[],"Resultado necesario",{"_3450":71793,"_30100":71784,"_20891":121760,"_5":14349,"_27386":121738,"_2933":121761},[],"Cadena y firma",{"_3450":71794,"_30100":71784,"_20891":121763,"_5":14349,"_27386":121738,"_2933":121764},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3450":71795,"_30100":71784,"_20891":121766,"_5":14349,"_27386":121738,"_2933":121767},[],"Fechas",{"_3450":71796,"_30100":71784,"_20891":121769,"_5":14349,"_27386":121738,"_2933":121770},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3450":71797,"_30100":71784,"_20891":121772,"_5":14349,"_27386":121738,"_2933":116883},[],{"_3450":71798,"_30100":71784,"_20891":121774,"_5":14349,"_27386":121738,"_2933":121775},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3450":71799,"_30100":71784,"_20891":121777,"_5":14349,"_27386":121738,"_2933":121778},[],"Uso",{"_3450":71800,"_30100":71784,"_20891":121780,"_5":14349,"_27386":121738,"_2933":121781},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3450":71801,"_30100":71784,"_20891":121783,"_5":14349,"_27386":121738,"_2933":121784},[],"Revocación",{"_3450":71802,"_30100":71784,"_20891":121786,"_5":14349,"_27386":121738,"_2933":121787},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3450":71803,"_30100":71784,"_20891":121789,"_5":14349,"_27386":121738,"_2933":121790},[],"Autorización",{"_3450":71804,"_30100":71784,"_20891":121792,"_5":14349,"_27386":121738,"_2933":121793},[],"La aplicación permite la acción a esa identidad.",{"_3450":71805,"_30100":71784,"_20891":121795,"_5":14349,"_27386":121738,"_2933":121796},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3450":71806,"_30100":71784,"_20891":121798,"_5":14349,"_27386":121742,"_2933":121799},[],"Mecanismo",{"_3450":71807,"_30100":71784,"_20891":121801,"_5":14349,"_27386":121742,"_2933":121802},[],"Cuándo utilizarlo",{"_3450":71808,"_30100":71784,"_20891":121804,"_5":14349,"_27386":121742,"_2933":121805},[],"Qué debes mantener",{"_3450":71809,"_30100":71784,"_20891":121807,"_5":14349,"_27386":121742,"_2933":55243},[],{"_3450":71810,"_30100":71784,"_20891":121809,"_5":14349,"_27386":121742,"_2933":121810},[],"Consulta del estado de un certificado concreto.",{"_3450":71811,"_30100":71784,"_20891":121812,"_5":14349,"_27386":121742,"_2933":121813},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3450":71812,"_30100":71784,"_20891":121815,"_5":14349,"_27386":121742,"_2933":55252},[],{"_3450":71813,"_30100":71784,"_20891":121817,"_5":14349,"_27386":121742,"_2933":121818},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3450":71814,"_30100":71784,"_20891":121820,"_5":14349,"_27386":121742,"_2933":121821},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3450":71815,"_30100":71784,"_20891":121823,"_5":14349,"_27386":121742,"_2933":121824},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3450":71816,"_30100":71784,"_20891":121826,"_5":14349,"_27386":121742,"_2933":121827},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3450":71817,"_30100":71784,"_20891":121829,"_5":14349,"_27386":121746,"_2933":121830},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3450":71818,"_30100":71784,"_20891":121832,"_5":14349,"_27386":121746,"_2933":121833},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3450":71819,"_30100":71784,"_20891":121835,"_5":14349,"_27386":121746,"_2933":121836},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3450":71820,"_30100":71784,"_20891":121838,"_5":14349,"_27386":121746,"_2933":121839},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3450":71821,"_30100":71784,"_20891":121841,"_5":14349,"_27386":121746,"_2933":121842},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3450":71822,"_30100":71784,"_20891":121844,"_5":14349,"_27386":121746,"_2933":121845},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3450":71823,"_30100":71784,"_20891":121847,"_5":14349,"_27386":121746,"_2933":121848},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3450":71824,"_30100":71784,"_20891":121850,"_5":14349,"_27386":121746,"_2933":121851},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3450":71825,"_30100":71784,"_20891":121853,"_5":14349,"_27386":121746,"_2933":121854},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3450":71826,"_30100":71826,"_5":14701,"_2933":121856,"_30453":121857,"_20891":121858,"_27386":71826},"Certificados",[49052,117213,54528,121094],[],{"_3450":71827,"_30100":71826,"_20891":121860,"_5":14349,"_27386":71826,"_2933":121861},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3450":71828,"_30100":71826,"_5":30450,"_20891":121863,"_27386":121864,"_2933":121865},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3450":71829,"_30100":71826,"_5":30450,"_20891":121867,"_27386":121868,"_2933":121869},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3450":71830,"_30100":71826,"_5":30450,"_20891":121871,"_27386":121872,"_2933":121873},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3450":71831,"_30100":71826,"_5":30450,"_20891":121875,"_27386":121876,"_2933":121877},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3450":71832,"_30100":71826,"_5":30450,"_20891":121879,"_27386":121880,"_2933":121881},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3450":71833,"_30100":71826,"_5":30450,"_20891":121883,"_27386":121884,"_2933":121885},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3450":71834,"_30100":71826,"_5":30450,"_20891":121887,"_27386":121888,"_2933":121889},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3450":71835,"_30100":71826,"_5":30450,"_20891":121891,"_27386":121892,"_2933":121893},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3450":71836,"_30100":71826,"_5":30450,"_20891":121895,"_27386":121896,"_2933":121897},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#continúa","Continúa",{"_3450":71837,"_30100":71826,"_20891":121899,"_5":14349,"_27386":71826,"_2933":121900},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3450":71838,"_30100":71826,"_20891":121902,"_5":14349,"_27386":121864,"_2933":121903},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3450":71839,"_30100":71826,"_20891":121905,"_5":14349,"_27386":121864,"_2933":121906},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3450":71840,"_30100":71826,"_20891":121908,"_5":14349,"_27386":121864,"_2933":121909},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3450":71841,"_30100":71826,"_20891":121911,"_5":14349,"_27386":121864,"_2933":121912},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3450":71842,"_30100":71826,"_20891":121914,"_5":14349,"_27386":121864,"_2933":121915},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3450":71843,"_30100":71826,"_20891":121917,"_5":14349,"_27386":121864,"_2933":121918},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3450":71844,"_30100":71826,"_20891":121920,"_5":14349,"_27386":121864,"_2933":121921},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3450":71845,"_30100":71826,"_20891":121923,"_5":14349,"_27386":121868,"_2933":121924},[],"Descarga el PEM e inspecciónalo:",{"_3450":71846,"_30100":71826,"_20891":121926,"_5":14349,"_27386":121868,"_2933":121927},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3450":71847,"_30100":71826,"_20891":121929,"_5":14349,"_27386":121872,"_2933":121930},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3450":71848,"_30100":71826,"_20891":121932,"_5":14349,"_27386":121872,"_2933":121933},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3450":71849,"_30100":71826,"_20891":121935,"_5":14349,"_27386":121872,"_2933":121936},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3450":71850,"_30100":71826,"_20891":121938,"_5":14349,"_27386":121872,"_2933":121939},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3450":71851,"_30100":71826,"_20891":121941,"_5":14349,"_27386":121872,"_2933":121942},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3450":71852,"_30100":71826,"_20891":121944,"_5":14349,"_27386":121872,"_2933":121945},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3450":71853,"_30100":71826,"_20891":121947,"_5":14349,"_27386":121872,"_2933":121948},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3450":71854,"_30100":71826,"_20891":121950,"_5":14349,"_27386":121876,"_2933":121951},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3450":71855,"_30100":71826,"_20891":121953,"_5":14349,"_27386":121880,"_2933":121954},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3450":71856,"_30100":71826,"_20891":121956,"_5":14349,"_27386":121884,"_2933":121957},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3450":71857,"_30100":71826,"_20891":121959,"_5":14349,"_27386":121888,"_2933":121960},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3450":71858,"_30100":71826,"_20891":121962,"_5":14349,"_27386":121888,"_2933":121963},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3450":71859,"_30100":71826,"_20891":121965,"_5":14349,"_27386":121888,"_2933":121966},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3450":71860,"_30100":71826,"_20891":121968,"_5":14349,"_27386":121892,"_2933":121969},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3450":71861,"_30100":71826,"_20891":121971,"_5":14349,"_27386":121892,"_2933":121972},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3450":71862,"_30100":71826,"_20891":121974,"_5":14349,"_27386":121892,"_2933":121975},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3450":71863,"_30100":71826,"_20891":121977,"_5":14349,"_27386":121896,"_2933":121978},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3450":71864,"_30100":71826,"_20891":121980,"_5":14349,"_27386":121896,"_2933":121981},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3450":71865,"_30100":71865,"_5":14701,"_2933":121983,"_30453":121984,"_20891":121986,"_27386":71865},"Ciclo de vida de un certificado",[49052,117213,54528,121985],"Conceptos",[],{"_3450":71866,"_30100":71865,"_20891":121988,"_5":14349,"_27386":71865,"_2933":121989},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3450":71867,"_30100":71865,"_5":30450,"_20891":121991,"_27386":121992,"_2933":121993},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3450":71868,"_30100":71865,"_5":30450,"_20891":121995,"_27386":121996,"_2933":121997},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3450":71869,"_30100":71865,"_5":30450,"_20891":121999,"_27386":122000,"_2933":122001},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3450":71870,"_30100":71865,"_5":30450,"_20891":122003,"_27386":122004,"_2933":122005},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3450":71871,"_30100":71865,"_5":30450,"_20891":122007,"_27386":122008,"_2933":122009},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3450":71872,"_30100":71865,"_5":30450,"_20891":122011,"_27386":122012,"_2933":122013},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3450":71873,"_30100":71865,"_5":30450,"_20891":122015,"_27386":122016,"_2933":119717},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3450":71874,"_30100":71865,"_5":30450,"_20891":122018,"_27386":122019,"_2933":122020},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3450":71875,"_30100":71865,"_5":30450,"_20891":122022,"_27386":122023,"_2933":122024},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3450":71876,"_30100":71865,"_5":30450,"_20891":122026,"_27386":122027,"_2933":122028},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3450":71877,"_30100":71865,"_20891":122030,"_5":14349,"_27386":71865,"_2933":122031},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3450":71878,"_30100":71865,"_20891":122033,"_5":14349,"_27386":121996,"_2933":122034},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3450":71879,"_30100":71865,"_20891":122036,"_5":14349,"_27386":122000,"_2933":122037},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3450":71880,"_30100":71865,"_20891":122039,"_5":14349,"_27386":122004,"_2933":122040},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3450":71881,"_30100":71865,"_20891":122042,"_5":14349,"_27386":122008,"_2933":122043},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3450":71882,"_30100":71865,"_20891":122045,"_5":14349,"_27386":122012,"_2933":122046},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3450":71883,"_30100":71865,"_20891":122048,"_5":14349,"_27386":122016,"_2933":122049},[],"Lamassu persiste cuatro estados X.509:",{"_3450":71884,"_30100":71865,"_20891":122051,"_5":14349,"_27386":122016,"_2933":122052},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3450":71885,"_30100":71865,"_20891":122054,"_5":14349,"_27386":122016,"_2933":122055},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3450":71886,"_30100":71865,"_20891":122057,"_5":14349,"_27386":122016,"_2933":122058},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3450":71887,"_30100":71865,"_20891":122060,"_5":14349,"_27386":122016,"_2933":122061},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3450":71888,"_30100":71865,"_20891":122063,"_5":14349,"_27386":122016,"_2933":122064},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3450":71889,"_30100":71865,"_20891":122066,"_5":14349,"_27386":122019,"_2933":122067},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3450":71890,"_30100":71865,"_20891":122069,"_5":14349,"_27386":122019,"_2933":122070},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3450":71891,"_30100":71865,"_20891":122072,"_5":14349,"_27386":122019,"_2933":122073},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3450":71892,"_30100":71865,"_20891":122075,"_5":14349,"_27386":122023,"_2933":122076},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3450":71893,"_30100":71865,"_20891":122078,"_5":14349,"_27386":122023,"_2933":122079},[],"Antes de confirmar:",{"_3450":71894,"_30100":71865,"_20891":122081,"_5":14349,"_27386":122023,"_2933":122082},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3450":71895,"_30100":71865,"_20891":122084,"_5":14349,"_27386":122023,"_2933":122085},[],"Distribuye la nueva cadena de confianza.",{"_3450":71896,"_30100":71865,"_20891":122087,"_5":14349,"_27386":122023,"_2933":122088},[],"Reemite las identidades necesarias.",{"_3450":71897,"_30100":71865,"_20891":122090,"_5":14349,"_27386":122023,"_2933":122091},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3450":71898,"_30100":71865,"_20891":122093,"_5":14349,"_27386":122023,"_2933":122094},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3450":71899,"_30100":71865,"_20891":122096,"_5":14349,"_27386":122023,"_2933":122097},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3450":71900,"_30100":71865,"_20891":122099,"_5":14349,"_27386":122027,"_2933":122100},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3450":71901,"_30100":71865,"_20891":122102,"_5":14349,"_27386":122027,"_2933":122103},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3450":71902,"_30100":71865,"_20891":122105,"_5":14349,"_27386":122027,"_2933":122106},[],"Cambios de estado y razones de revocación.",{"_3450":71903,"_30100":71865,"_20891":122108,"_5":14349,"_27386":122027,"_2933":122109},[],"Publicación y vigencia de OCSP y CRLs.",{"_3450":71904,"_30100":71865,"_20891":122111,"_5":14349,"_27386":122027,"_2933":122112},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3450":71905,"_30100":71865,"_20891":122114,"_5":14349,"_27386":122027,"_2933":122115},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3450":71906,"_30100":71906,"_5":14701,"_2933":122117,"_30453":122118,"_20891":122119,"_27386":71906},"Modelo de confianza",[49052,117213,54528,121985],[],{"_3450":71907,"_30100":71906,"_20891":122121,"_5":14349,"_27386":71906,"_2933":122122},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3450":71908,"_30100":71906,"_5":30450,"_20891":122124,"_27386":122125,"_2933":122126},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3450":71909,"_30100":71906,"_5":30450,"_20891":122128,"_27386":122129,"_2933":122130},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3450":71910,"_30100":71906,"_5":30450,"_20891":122132,"_27386":122133,"_2933":122134},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3450":71911,"_30100":71906,"_5":30450,"_20891":122136,"_27386":122137,"_2933":122138},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3450":71912,"_30100":71906,"_5":30450,"_20891":122140,"_27386":122141,"_2933":122142},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3450":71913,"_30100":71906,"_5":30450,"_20891":122144,"_27386":122145,"_2933":122146},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3450":71914,"_30100":71906,"_5":30450,"_20891":122148,"_27386":122149,"_2933":122150},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3450":71915,"_30100":71906,"_5":30450,"_20891":122152,"_27386":122153,"_2933":122154},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3450":71916,"_30100":71906,"_5":30450,"_20891":122156,"_27386":122157,"_2933":122158},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3450":71917,"_30100":71906,"_5":30450,"_20891":122160,"_27386":122161,"_2933":122162},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3450":71918,"_30100":71906,"_20891":122164,"_5":14349,"_27386":71906,"_2933":122165},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3450":71919,"_30100":71906,"_20891":122167,"_5":14349,"_27386":122129,"_2933":122168},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3450":71920,"_30100":71906,"_20891":122170,"_5":14349,"_27386":122133,"_2933":122171},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3450":71921,"_30100":71906,"_20891":122173,"_5":14349,"_27386":122137,"_2933":122174},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3450":71922,"_30100":71906,"_20891":122176,"_5":14349,"_27386":122141,"_2933":122177},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3450":71923,"_30100":71906,"_20891":122179,"_5":14349,"_27386":122145,"_2933":122180},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3450":71924,"_30100":71906,"_20891":122182,"_5":14349,"_27386":122145,"_2933":122183},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3450":71925,"_30100":71906,"_20891":122185,"_5":14349,"_27386":122145,"_2933":122186},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3450":71926,"_30100":71906,"_20891":122188,"_5":14349,"_27386":122145,"_2933":122189},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3450":71927,"_30100":71906,"_20891":122191,"_5":14349,"_27386":122145,"_2933":122192},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3450":71928,"_30100":71906,"_20891":122194,"_5":14349,"_27386":122145,"_2933":122195},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3450":71929,"_30100":71906,"_20891":122197,"_5":14349,"_27386":122149,"_2933":122198},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3450":71930,"_30100":71906,"_20891":122200,"_5":14349,"_27386":122149,"_2933":122201},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3450":71931,"_30100":71906,"_20891":122203,"_5":14349,"_27386":122149,"_2933":122204},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3450":71932,"_30100":71906,"_20891":122206,"_5":14349,"_27386":122149,"_2933":122207},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3450":71933,"_30100":71906,"_20891":122209,"_5":14349,"_27386":122149,"_2933":122210},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3450":71934,"_30100":71906,"_20891":122212,"_5":14349,"_27386":122153,"_2933":122213},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3450":71935,"_30100":71906,"_20891":122215,"_5":14349,"_27386":122153,"_2933":122216},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3450":71936,"_30100":71906,"_20891":122218,"_5":14349,"_27386":122153,"_2933":122219},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3450":71937,"_30100":71906,"_20891":122221,"_5":14349,"_27386":122153,"_2933":122222},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3450":71938,"_30100":71906,"_20891":122224,"_5":14349,"_27386":122153,"_2933":122225},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3450":71939,"_30100":71906,"_20891":122227,"_5":14349,"_27386":122153,"_2933":122228},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3450":71940,"_30100":71906,"_20891":122230,"_5":14349,"_27386":122153,"_2933":122231},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3450":71941,"_30100":71906,"_20891":122233,"_5":14349,"_27386":122157,"_2933":122234},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3450":71942,"_30100":71906,"_20891":122236,"_5":14349,"_27386":122161,"_2933":122237},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3450":71943,"_30100":71906,"_20891":122239,"_5":14349,"_27386":122161,"_2933":122240},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3450":71944,"_30100":71906,"_20891":122242,"_5":14349,"_27386":122161,"_2933":122243},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3450":71945,"_30100":71906,"_20891":122245,"_5":14349,"_27386":122161,"_2933":122246},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3450":71946,"_30100":71906,"_20891":122248,"_5":14349,"_27386":122161,"_2933":122249},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3450":71947,"_30100":71906,"_20891":122251,"_5":14349,"_27386":122161,"_2933":122252},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3450":71948,"_30100":71906,"_20891":122254,"_5":14349,"_27386":122161,"_2933":122255},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3450":71949,"_30100":71949,"_5":14701,"_2933":122257,"_30453":122258,"_20891":122259,"_27386":71949},"Listas de revocación (CRL)",[49052,117213,54528,121731],[],{"_3450":71950,"_30100":71949,"_20891":122261,"_5":14349,"_27386":71949,"_2933":122262},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3450":71951,"_30100":71949,"_5":30450,"_20891":122264,"_27386":122265,"_2933":122266},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3450":71952,"_30100":71949,"_5":30450,"_20891":122268,"_27386":122269,"_2933":122270},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3450":71953,"_30100":71949,"_5":30450,"_20891":122272,"_27386":122273,"_2933":122274},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3450":71954,"_30100":71949,"_5":30450,"_20891":122276,"_27386":122277,"_2933":122278},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3450":71955,"_30100":71949,"_5":30450,"_20891":122280,"_27386":122281,"_2933":122282},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3450":71956,"_30100":71949,"_5":30450,"_20891":122284,"_27386":122285,"_2933":122286},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3450":71957,"_30100":71949,"_5":30450,"_20891":122288,"_27386":122289,"_2933":122290},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3450":71958,"_30100":71949,"_5":30450,"_20891":122292,"_27386":122293,"_2933":122294},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3450":71959,"_30100":71949,"_5":30450,"_20891":122296,"_27386":122297,"_2933":122298},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#referencias","Referencias",{"_3450":71960,"_30100":71949,"_20891":122300,"_5":14349,"_27386":71949,"_2933":122301},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3450":71961,"_30100":71949,"_20891":122303,"_5":14349,"_27386":122265,"_2933":122304},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3450":71962,"_30100":71949,"_20891":122306,"_5":14349,"_27386":122265,"_2933":122307},[],"Campo",{"_3450":71963,"_30100":71949,"_20891":122309,"_5":14349,"_27386":122265,"_2933":118757},[],{"_3450":71964,"_30100":71949,"_20891":122311,"_5":14349,"_27386":122265,"_2933":55750},[],{"_3450":71965,"_30100":71949,"_20891":122313,"_5":14349,"_27386":122265,"_2933":122314},[],"ID de la CA a la que pertenecen los ajustes.",{"_3450":71966,"_30100":71949,"_20891":122316,"_5":14349,"_27386":122265,"_2933":55756},[],{"_3450":71967,"_30100":71949,"_20891":122318,"_5":14349,"_27386":122265,"_2933":122319},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3450":71968,"_30100":71949,"_20891":122321,"_5":14349,"_27386":122265,"_2933":55762},[],{"_3450":71969,"_30100":71949,"_20891":122323,"_5":14349,"_27386":122265,"_2933":122324},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3450":71970,"_30100":71949,"_20891":122326,"_5":14349,"_27386":122265,"_2933":55768},[],{"_3450":71971,"_30100":71949,"_20891":122328,"_5":14349,"_27386":122265,"_2933":122329},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3450":71972,"_30100":71949,"_20891":122331,"_5":14349,"_27386":122265,"_2933":122332},[],"Campo de `crl_options`",{"_3450":71973,"_30100":71949,"_20891":122334,"_5":14349,"_27386":122265,"_2933":118757},[],{"_3450":71974,"_30100":71949,"_20891":122336,"_5":14349,"_27386":122265,"_2933":122337},[],"Valor inicial",{"_3450":71975,"_30100":71949,"_20891":122339,"_5":14349,"_27386":122265,"_2933":55782},[],{"_3450":71976,"_30100":71949,"_20891":122341,"_5":14349,"_27386":122265,"_2933":122342},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3450":71977,"_30100":71949,"_20891":122344,"_5":14349,"_27386":122265,"_2933":122345},[],"7 días.",{"_3450":71978,"_30100":71949,"_20891":122347,"_5":14349,"_27386":122265,"_2933":55791},[],{"_3450":71979,"_30100":71949,"_20891":122349,"_5":14349,"_27386":122265,"_2933":122350},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3450":71980,"_30100":71949,"_20891":122352,"_5":14349,"_27386":122265,"_2933":122353},[],"6 días y 23 horas.",{"_3450":71981,"_30100":71949,"_20891":122355,"_5":14349,"_27386":122265,"_2933":55800},[],{"_3450":71982,"_30100":71949,"_20891":122357,"_5":14349,"_27386":122265,"_2933":122358},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3450":71983,"_30100":71949,"_20891":122360,"_5":14349,"_27386":122265,"_2933":55806},[],{"_3450":71984,"_30100":71949,"_20891":122362,"_5":14349,"_27386":122265,"_2933":55809},[],{"_3450":71985,"_30100":71949,"_20891":122364,"_5":14349,"_27386":122265,"_2933":122365},[],"Número de serie del certificado existente que firma la CRL.",{"_3450":71986,"_30100":71949,"_20891":122367,"_5":14349,"_27386":122265,"_2933":122368},[],"Número de serie del certificado actual de la CA.",{"_3450":71987,"_30100":71949,"_20891":122370,"_5":14349,"_27386":122265,"_2933":122371},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3450":71988,"_30100":71949,"_20891":122373,"_5":14349,"_27386":122265,"_2933":122374},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3450":71989,"_30100":71949,"_20891":122376,"_5":14349,"_27386":122265,"_2933":122377},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3450":71990,"_30100":71949,"_20891":122379,"_5":14349,"_27386":122265,"_2933":122380},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3450":71991,"_30100":71949,"_20891":122382,"_5":14349,"_27386":122265,"_2933":122383},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3450":71992,"_30100":71949,"_20891":122385,"_5":14349,"_27386":122265,"_2933":122386},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3450":71993,"_30100":71949,"_20891":122388,"_5":14349,"_27386":122265,"_2933":122389},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3450":71994,"_30100":71949,"_20891":122391,"_5":14349,"_27386":122265,"_2933":122392},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3450":71995,"_30100":71949,"_20891":122394,"_5":14349,"_27386":122265,"_2933":122395},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3450":71996,"_30100":71949,"_20891":122397,"_5":14349,"_27386":122265,"_2933":122398},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3450":71997,"_30100":71949,"_20891":122400,"_5":14349,"_27386":122269,"_2933":122401},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3450":71998,"_30100":71949,"_20891":122403,"_5":14349,"_27386":122269,"_2933":122404},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3450":71999,"_30100":71949,"_20891":122406,"_5":14349,"_27386":122269,"_2933":122407},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3450":72000,"_30100":71949,"_20891":122409,"_5":14349,"_27386":122269,"_2933":122410},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3450":72001,"_30100":71949,"_20891":122412,"_5":14349,"_27386":122273,"_2933":122413},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3450":72002,"_30100":71949,"_20891":122415,"_5":14349,"_27386":122273,"_2933":122416},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3450":72003,"_30100":71949,"_20891":122418,"_5":14349,"_27386":122273,"_2933":122419},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3450":72004,"_30100":71949,"_20891":122421,"_5":14349,"_27386":122273,"_2933":122422},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3450":72005,"_30100":71949,"_20891":122424,"_5":14349,"_27386":122273,"_2933":122425},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3450":72006,"_30100":71949,"_20891":122427,"_5":14349,"_27386":122273,"_2933":122428},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3450":72007,"_30100":71949,"_20891":122430,"_5":14349,"_27386":122273,"_2933":122431},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3450":72008,"_30100":71949,"_20891":122433,"_5":14349,"_27386":122273,"_2933":122434},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3450":72009,"_30100":71949,"_20891":122436,"_5":14349,"_27386":122273,"_2933":122437},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3450":72010,"_30100":71949,"_20891":122439,"_5":14349,"_27386":122277,"_2933":122440},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3450":72011,"_30100":71949,"_20891":122442,"_5":14349,"_27386":122277,"_2933":122443},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3450":72012,"_30100":71949,"_20891":122445,"_5":14349,"_27386":122281,"_2933":122446},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3450":72013,"_30100":71949,"_20891":122448,"_5":14349,"_27386":122281,"_2933":122449},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3450":72014,"_30100":71949,"_20891":122451,"_5":14349,"_27386":122281,"_2933":122452},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3450":72015,"_30100":71949,"_20891":122454,"_5":14349,"_27386":122281,"_2933":122455},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3450":72016,"_30100":71949,"_20891":122457,"_5":14349,"_27386":122281,"_2933":122458},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3450":72017,"_30100":71949,"_20891":122460,"_5":14349,"_27386":122285,"_2933":122461},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3450":72018,"_30100":71949,"_20891":122463,"_5":14349,"_27386":122285,"_2933":118946},[],{"_3450":72019,"_30100":71949,"_20891":122465,"_5":14349,"_27386":122285,"_2933":122466},[],"Path relativo",{"_3450":72020,"_30100":71949,"_20891":122468,"_5":14349,"_27386":122285,"_2933":116973},[],{"_3450":72021,"_30100":71949,"_20891":122470,"_5":14349,"_27386":122285,"_2933":55918},[],{"_3450":72022,"_30100":71949,"_20891":122472,"_5":14349,"_27386":122285,"_2933":55921},[],{"_3450":72023,"_30100":71949,"_20891":122474,"_5":14349,"_27386":122285,"_2933":122475},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3450":72024,"_30100":71949,"_20891":122477,"_5":14349,"_27386":122285,"_2933":55918},[],{"_3450":72025,"_30100":71949,"_20891":122479,"_5":14349,"_27386":122285,"_2933":55929},[],{"_3450":72026,"_30100":71949,"_20891":122481,"_5":14349,"_27386":122285,"_2933":122482},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3450":72027,"_30100":71949,"_20891":122484,"_5":14349,"_27386":122285,"_2933":55935},[],{"_3450":72028,"_30100":71949,"_20891":122486,"_5":14349,"_27386":122285,"_2933":55929},[],{"_3450":72029,"_30100":71949,"_20891":122488,"_5":14349,"_27386":122285,"_2933":122489},[],"Sustituir la configuración de CRL de una CA.",{"_3450":72030,"_30100":71949,"_20891":122491,"_5":14349,"_27386":122285,"_2933":122492},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3450":72031,"_30100":71949,"_20891":122494,"_5":14349,"_27386":122285,"_2933":122495},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3450":72032,"_30100":71949,"_20891":122497,"_5":14349,"_27386":122289,"_2933":122498},[],"Síntoma",{"_3450":72033,"_30100":71949,"_20891":122500,"_5":14349,"_27386":122289,"_2933":122501},[],"Causa",{"_3450":72034,"_30100":71949,"_20891":122503,"_5":14349,"_27386":122289,"_2933":122504},[],"Acción",{"_3450":72035,"_30100":71949,"_20891":122506,"_5":14349,"_27386":122289,"_2933":122507},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3450":72036,"_30100":71949,"_20891":122509,"_5":14349,"_27386":122289,"_2933":122510},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3450":72037,"_30100":71949,"_20891":122512,"_5":14349,"_27386":122289,"_2933":122513},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3450":72038,"_30100":71949,"_20891":122515,"_5":14349,"_27386":122289,"_2933":122516},[],"`PUT` devuelve 400.",{"_3450":72039,"_30100":71949,"_20891":122518,"_5":14349,"_27386":122289,"_2933":122519},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3450":72040,"_30100":71949,"_20891":122521,"_5":14349,"_27386":122289,"_2933":122522},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3450":72041,"_30100":71949,"_20891":122524,"_5":14349,"_27386":122289,"_2933":122525},[],"`PUT` devuelve 404.",{"_3450":72042,"_30100":71949,"_20891":122527,"_5":14349,"_27386":122289,"_2933":122528},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3450":72043,"_30100":71949,"_20891":122530,"_5":14349,"_27386":122289,"_2933":122531},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3450":72044,"_30100":71949,"_20891":122533,"_5":14349,"_27386":122289,"_2933":122534},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3450":72045,"_30100":71949,"_20891":122536,"_5":14349,"_27386":122289,"_2933":122537},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3450":72046,"_30100":71949,"_20891":122539,"_5":14349,"_27386":122289,"_2933":122540},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3450":72047,"_30100":71949,"_20891":122542,"_5":14349,"_27386":122289,"_2933":122543},[],"La CRL no cambia tras revocar un certificado.",{"_3450":72048,"_30100":71949,"_20891":122545,"_5":14349,"_27386":122289,"_2933":122546},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3450":72049,"_30100":71949,"_20891":122548,"_5":14349,"_27386":122289,"_2933":122549},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3450":72050,"_30100":71949,"_20891":122551,"_5":14349,"_27386":122289,"_2933":122552},[],"Un verificador rechaza la CRL por el emisor.",{"_3450":72051,"_30100":71949,"_20891":122554,"_5":14349,"_27386":122289,"_2933":122555},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3450":72052,"_30100":71949,"_20891":122557,"_5":14349,"_27386":122289,"_2933":122558},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3450":72053,"_30100":71949,"_20891":122560,"_5":14349,"_27386":122293,"_2933":122561},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3450":72054,"_30100":71949,"_20891":122563,"_5":14349,"_27386":122297,"_2933":122564},[],"RFC 5280: perfil X.509 y CRL.",{"_3450":72055,"_30100":71949,"_20891":122566,"_5":14349,"_27386":122297,"_2933":56018},[],{"_3450":72056,"_30100":71949,"_20891":122568,"_5":14349,"_27386":122297,"_2933":56021},[],{"_3450":72057,"_30100":71949,"_20891":122570,"_5":14349,"_27386":122297,"_2933":122571},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3450":72058,"_30100":71949,"_20891":122573,"_5":14349,"_27386":122297,"_2933":122574},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3450":72059,"_30100":72059,"_5":14701,"_2933":122576,"_30453":122577,"_20891":122578,"_27386":72059},"Claves y motores criptográficos",[49052,117213,54528,121094],[],{"_3450":72060,"_30100":72059,"_20891":122580,"_5":14349,"_27386":72059,"_2933":122581},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3450":72061,"_30100":72059,"_5":30450,"_20891":122583,"_27386":122584,"_2933":122585},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3450":72062,"_30100":72059,"_5":30450,"_20891":122587,"_27386":122588,"_2933":122589},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3450":72063,"_30100":72059,"_5":30450,"_20891":122591,"_27386":122592,"_2933":56046},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#file-system",{"_3450":72064,"_30100":72059,"_5":30450,"_20891":122594,"_27386":122595,"_2933":56050},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#hashicorp-vault",{"_3450":72065,"_30100":72059,"_5":30450,"_20891":122597,"_27386":122598,"_2933":56054},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#aws-secrets-manager",{"_3450":72066,"_30100":72059,"_5":30450,"_20891":122600,"_27386":122601,"_2933":56058},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#aws-kms",{"_3450":72067,"_30100":72059,"_5":30450,"_20891":122603,"_27386":122604,"_2933":56062},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#pkcs11",{"_3450":72068,"_30100":72059,"_5":30450,"_20891":122606,"_27386":122607,"_2933":56066},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#azure-key-vault",{"_3450":72069,"_30100":72059,"_5":30450,"_20891":122609,"_27386":122610,"_2933":122611},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3450":72070,"_30100":72059,"_5":30450,"_20891":122613,"_27386":122614,"_2933":122615},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3450":72071,"_30100":72059,"_5":30450,"_20891":122617,"_27386":122618,"_2933":122619},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3450":72072,"_30100":72059,"_5":30450,"_20891":122621,"_27386":122622,"_2933":122623},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3450":72073,"_30100":72059,"_5":30450,"_20891":122625,"_27386":122626,"_2933":122627},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3450":72074,"_30100":72059,"_5":30450,"_20891":122629,"_27386":122630,"_2933":122631},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3450":72075,"_30100":72059,"_5":30450,"_20891":122633,"_27386":122634,"_2933":122635},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3450":72076,"_30100":72059,"_5":30450,"_20891":122637,"_27386":122638,"_2933":56098},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#sign",{"_3450":72077,"_30100":72059,"_5":30450,"_20891":122640,"_27386":122641,"_2933":56102},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#verify",{"_3450":72078,"_30100":72059,"_5":30450,"_20891":122643,"_27386":122644,"_2933":122645},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3450":72079,"_30100":72059,"_5":30450,"_20891":122647,"_27386":122648,"_2933":122649},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3450":72080,"_30100":72059,"_5":30450,"_20891":122651,"_27386":122652,"_2933":122653},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3450":72081,"_30100":72059,"_20891":122655,"_5":14349,"_27386":72059,"_2933":122656},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3450":72082,"_30100":72059,"_20891":122658,"_5":14349,"_27386":72059,"_2933":122659},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3450":72083,"_30100":72059,"_20891":122661,"_5":14349,"_27386":122584,"_2933":122662},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3450":72084,"_30100":72059,"_20891":122664,"_5":14349,"_27386":122584,"_2933":122665},[],"En la práctica, permite:",{"_3450":72085,"_30100":72059,"_20891":122667,"_5":14349,"_27386":122584,"_2933":122668},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3450":72086,"_30100":72059,"_20891":122670,"_5":14349,"_27386":122584,"_2933":122671},[],"Importar claves creadas externamente.",{"_3450":72087,"_30100":72059,"_20891":122673,"_5":14349,"_27386":122584,"_2933":122674},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3450":72088,"_30100":72059,"_20891":122676,"_5":14349,"_27386":122584,"_2933":122677},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3450":72089,"_30100":72059,"_20891":122679,"_5":14349,"_27386":122588,"_2933":122680},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3450":72090,"_30100":72059,"_20891":122682,"_5":14349,"_27386":122588,"_2933":122683},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3450":72091,"_30100":72059,"_20891":122685,"_5":14349,"_27386":122588,"_2933":122686},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3450":72092,"_30100":72059,"_20891":122688,"_5":14349,"_27386":122592,"_2933":122689},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3450":72093,"_30100":72059,"_20891":122691,"_5":14349,"_27386":122595,"_2933":122692},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3450":72094,"_30100":72059,"_20891":122694,"_5":14349,"_27386":122595,"_2933":122695},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3450":72095,"_30100":72059,"_20891":122697,"_5":14349,"_27386":122598,"_2933":122698},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3450":72096,"_30100":72059,"_20891":122700,"_5":14349,"_27386":122601,"_2933":122701},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3450":72097,"_30100":72059,"_20891":122703,"_5":14349,"_27386":122604,"_2933":122704},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3450":72098,"_30100":72059,"_20891":122706,"_5":14349,"_27386":122607,"_2933":122707},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3450":72099,"_30100":72059,"_20891":122709,"_5":14349,"_27386":122607,"_2933":122710},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3450":72100,"_30100":72059,"_20891":122712,"_5":14349,"_27386":122607,"_2933":122713},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3450":72101,"_30100":72059,"_20891":122715,"_5":14349,"_27386":122607,"_2933":122716},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3450":72102,"_30100":72059,"_20891":122718,"_5":14349,"_27386":122610,"_2933":122719},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3450":72103,"_30100":72059,"_20891":122721,"_5":14349,"_27386":122610,"_2933":122722},[],"La tabla incluye los siguientes campos:",{"_3450":72104,"_30100":72059,"_20891":122724,"_5":14349,"_27386":122610,"_2933":122725},[],"**Name**: nombre descriptivo de la clave.",{"_3450":72105,"_30100":72059,"_20891":122727,"_5":14349,"_27386":122610,"_2933":122728},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3450":72106,"_30100":72059,"_20891":122730,"_5":14349,"_27386":122610,"_2933":122731},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3450":72107,"_30100":72059,"_20891":122733,"_5":14349,"_27386":122610,"_2933":122734},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3450":72108,"_30100":72059,"_20891":122736,"_5":14349,"_27386":122610,"_2933":122737},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3450":72109,"_30100":72059,"_20891":122739,"_5":14349,"_27386":122610,"_2933":122740},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3450":72110,"_30100":72059,"_20891":122742,"_5":14349,"_27386":122610,"_2933":122743},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3450":72111,"_30100":72059,"_20891":122745,"_5":14349,"_27386":122610,"_2933":122746},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3450":72112,"_30100":72059,"_20891":122748,"_5":14349,"_27386":122610,"_2933":122749},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3450":72113,"_30100":72059,"_20891":122751,"_5":14349,"_27386":122610,"_2933":122752},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3450":72114,"_30100":72059,"_20891":122754,"_5":14349,"_27386":122610,"_2933":122755},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3450":72115,"_30100":72059,"_20891":122757,"_5":14349,"_27386":122610,"_2933":122758},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3450":72116,"_30100":72059,"_20891":122760,"_5":14349,"_27386":122610,"_2933":122761},[],"**Delete Key** para eliminar la clave del sistema.",{"_3450":72117,"_30100":72059,"_20891":122763,"_5":14349,"_27386":122614,"_2933":122764},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3450":72118,"_30100":72059,"_20891":122766,"_5":14349,"_27386":122618,"_2933":122767},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3450":72119,"_30100":72059,"_20891":122769,"_5":14349,"_27386":122618,"_2933":122770},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3450":72120,"_30100":72059,"_20891":122772,"_5":14349,"_27386":122618,"_2933":122773},[],"**Key Name**: nombre único y descriptivo.",{"_3450":72121,"_30100":72059,"_20891":122775,"_5":14349,"_27386":122618,"_2933":122776},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3450":72122,"_30100":72059,"_20891":122778,"_5":14349,"_27386":122618,"_2933":122779},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3450":72123,"_30100":72059,"_20891":122781,"_5":14349,"_27386":122618,"_2933":122782},[],"**Tags**: metadatos para clasificar la clave.",{"_3450":72124,"_30100":72059,"_20891":122784,"_5":14349,"_27386":122618,"_2933":122785},[],"**Metadata**: información adicional para usos avanzados.",{"_3450":72125,"_30100":72059,"_20891":122787,"_5":14349,"_27386":122622,"_2933":122788},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3450":72126,"_30100":72059,"_20891":122790,"_5":14349,"_27386":122622,"_2933":122791},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3450":72127,"_30100":72059,"_20891":122793,"_5":14349,"_27386":122622,"_2933":122794},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3450":72128,"_30100":72059,"_20891":122796,"_5":14349,"_27386":122622,"_2933":122797},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3450":72129,"_30100":72059,"_20891":122799,"_5":14349,"_27386":122622,"_2933":122800},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3450":72130,"_30100":72059,"_20891":122802,"_5":14349,"_27386":122622,"_2933":122803},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3450":72131,"_30100":72059,"_20891":122805,"_5":14349,"_27386":122622,"_2933":122806},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3450":72132,"_30100":72059,"_20891":122808,"_5":14349,"_27386":122622,"_2933":122809},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3450":72133,"_30100":72059,"_20891":122811,"_5":14349,"_27386":122622,"_2933":122812},[],"**Metadata**: información adicional opcional.",{"_3450":72134,"_30100":72059,"_20891":122814,"_5":14349,"_27386":122622,"_2933":122815},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3450":72135,"_30100":72059,"_20891":122817,"_5":14349,"_27386":122622,"_2933":122818},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3450":72136,"_30100":72059,"_20891":122820,"_5":14349,"_27386":122626,"_2933":122821},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3450":72137,"_30100":72059,"_20891":122823,"_5":14349,"_27386":122630,"_2933":122824},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3450":72138,"_30100":72059,"_20891":122826,"_5":14349,"_27386":122630,"_2933":122827},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3450":72139,"_30100":72059,"_20891":122829,"_5":14349,"_27386":122630,"_2933":122830},[],"**Key Name**: nombre descriptivo.",{"_3450":72140,"_30100":72059,"_20891":122832,"_5":14349,"_27386":122630,"_2933":122833},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3450":72141,"_30100":72059,"_20891":122835,"_5":14349,"_27386":122630,"_2933":122836},[],"**Tags**: etiquetas asociadas.",{"_3450":72142,"_30100":72059,"_20891":122838,"_5":14349,"_27386":122630,"_2933":122839},[],"**Aliases**: nombres alternativos.",{"_3450":72143,"_30100":72059,"_20891":122841,"_5":14349,"_27386":122630,"_2933":122842},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3450":72144,"_30100":72059,"_20891":122844,"_5":14349,"_27386":122630,"_2933":122845},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3450":72145,"_30100":72059,"_20891":122847,"_5":14349,"_27386":122630,"_2933":122848},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3450":72146,"_30100":72059,"_20891":122850,"_5":14349,"_27386":122630,"_2933":122851},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3450":72147,"_30100":72059,"_20891":122853,"_5":14349,"_27386":122634,"_2933":122854},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3450":72148,"_30100":72059,"_20891":122856,"_5":14349,"_27386":122634,"_2933":122857},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3450":72149,"_30100":72059,"_20891":122859,"_5":14349,"_27386":122634,"_2933":122860},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3450":72150,"_30100":72059,"_20891":122862,"_5":14349,"_27386":122638,"_2933":122863},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3450":72151,"_30100":72059,"_20891":122865,"_5":14349,"_27386":122638,"_2933":122866},[],"Campos principales:",{"_3450":72152,"_30100":72059,"_20891":122868,"_5":14349,"_27386":122638,"_2933":122869},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3450":72153,"_30100":72059,"_20891":122871,"_5":14349,"_27386":122638,"_2933":122872},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3450":72154,"_30100":72059,"_20891":122874,"_5":14349,"_27386":122638,"_2933":122875},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3450":72155,"_30100":72059,"_20891":122877,"_5":14349,"_27386":122638,"_2933":122878},[],"**Message**: contenido que se va a firmar.",{"_3450":72156,"_30100":72059,"_20891":122880,"_5":14349,"_27386":122638,"_2933":122881},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3450":72157,"_30100":72059,"_20891":122883,"_5":14349,"_27386":122641,"_2933":122884},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3450":72158,"_30100":72059,"_20891":122886,"_5":14349,"_27386":122641,"_2933":122866},[],{"_3450":72159,"_30100":72059,"_20891":122888,"_5":14349,"_27386":122641,"_2933":122889},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3450":72160,"_30100":72059,"_20891":122891,"_5":14349,"_27386":122641,"_2933":122892},[],"**Message Type**: `Raw` o `Digest`.",{"_3450":72161,"_30100":72059,"_20891":122894,"_5":14349,"_27386":122641,"_2933":122895},[],"**Payload Encoding**: codificación del mensaje.",{"_3450":72162,"_30100":72059,"_20891":122897,"_5":14349,"_27386":122641,"_2933":122898},[],"**Message**: mensaje original o hash.",{"_3450":72163,"_30100":72059,"_20891":122900,"_5":14349,"_27386":122641,"_2933":122901},[],"**Signature**: firma que se desea comprobar.",{"_3450":72164,"_30100":72059,"_20891":122903,"_5":14349,"_27386":122641,"_2933":122904},[],"**Result**: indicador del resultado de la validación.",{"_3450":72165,"_30100":72059,"_20891":122906,"_5":14349,"_27386":122644,"_2933":122907},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3450":72166,"_30100":72059,"_20891":122909,"_5":14349,"_27386":122644,"_2933":122910},[],"Este flujo es útil para:",{"_3450":72167,"_30100":72059,"_20891":122912,"_5":14349,"_27386":122644,"_2933":122913},[],"Solicitar certificados a una CA externa.",{"_3450":72168,"_30100":72059,"_20891":122915,"_5":14349,"_27386":122644,"_2933":122916},[],"Renovar una identidad manteniendo la misma clave.",{"_3450":72169,"_30100":72059,"_20891":122918,"_5":14349,"_27386":122644,"_2933":122919},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3450":72170,"_30100":72059,"_20891":122921,"_5":14349,"_27386":122644,"_2933":122922},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3450":72171,"_30100":72059,"_20891":122924,"_5":14349,"_27386":122644,"_2933":122925},[],"**Organization (O)**: organización o empresa.",{"_3450":72172,"_30100":72059,"_20891":122927,"_5":14349,"_27386":122644,"_2933":122928},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3450":72173,"_30100":72059,"_20891":122930,"_5":14349,"_27386":122644,"_2933":122931},[],"**Country (C)**: código de país de dos letras.",{"_3450":72174,"_30100":72059,"_20891":122933,"_5":14349,"_27386":122644,"_2933":122934},[],"**State / Province (ST)**: estado o provincia.",{"_3450":72175,"_30100":72059,"_20891":122936,"_5":14349,"_27386":122644,"_2933":122937},[],"**Locality (L)**: ciudad o localidad.",{"_3450":72176,"_30100":72059,"_20891":122939,"_5":14349,"_27386":122644,"_2933":122940},[],"**Email Address**: correo de contacto.",{"_3450":72177,"_30100":72059,"_20891":122942,"_5":14349,"_27386":122644,"_2933":122943},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3450":72178,"_30100":72059,"_20891":122945,"_5":14349,"_27386":122644,"_2933":122946},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3450":72179,"_30100":72059,"_20891":122948,"_5":14349,"_27386":122648,"_2933":122949},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3450":72180,"_30100":72059,"_20891":122951,"_5":14349,"_27386":122648,"_2933":122952},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3450":72181,"_30100":72059,"_20891":122954,"_5":14349,"_27386":122652,"_2933":122955},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3450":72182,"_30100":72059,"_20891":122957,"_5":14349,"_27386":122652,"_2933":122958},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3450":72183,"_30100":72183,"_5":14701,"_2933":122960,"_30453":122961,"_20891":122962,"_27386":72183},"Validación online con OCSP",[49052,117213,54528,121731],[],{"_3450":72184,"_30100":72183,"_20891":122964,"_5":14349,"_27386":72183,"_2933":122965},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3450":72185,"_30100":72183,"_5":30450,"_20891":122967,"_27386":122968,"_2933":122969},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3450":72186,"_30100":72183,"_5":30450,"_20891":122971,"_27386":122972,"_2933":122973},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3450":72187,"_30100":72183,"_5":30450,"_20891":122975,"_27386":122976,"_2933":122977},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3450":72188,"_30100":72183,"_5":30450,"_20891":122979,"_27386":122980,"_2933":122981},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3450":72189,"_30100":72183,"_5":30450,"_20891":122983,"_27386":122984,"_2933":122985},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3450":72190,"_30100":72183,"_5":30450,"_20891":122987,"_27386":122988,"_2933":122298},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#referencias",{"_3450":72191,"_30100":72183,"_20891":122990,"_5":14349,"_27386":72183,"_2933":122991},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3450":72192,"_30100":72183,"_20891":122993,"_5":14349,"_27386":122968,"_2933":122994},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3450":72193,"_30100":72183,"_20891":122996,"_5":14349,"_27386":122968,"_2933":122997},[],"Estado del registro",{"_3450":72194,"_30100":72183,"_20891":122999,"_5":14349,"_27386":122968,"_2933":123000},[],"Respuesta firmada",{"_3450":72195,"_30100":72183,"_20891":123002,"_5":14349,"_27386":122968,"_2933":53665},[],{"_3450":72196,"_30100":72183,"_20891":123004,"_5":14349,"_27386":122968,"_2933":56466},[],{"_3450":72197,"_30100":72183,"_20891":123006,"_5":14349,"_27386":122968,"_2933":53682},[],{"_3450":72198,"_30100":72183,"_20891":123008,"_5":14349,"_27386":122968,"_2933":123009},[],"`Revoked`, con razón y fecha de revocación.",{"_3450":72199,"_30100":72183,"_20891":123011,"_5":14349,"_27386":122968,"_2933":123012},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3450":72200,"_30100":72183,"_20891":123014,"_5":14349,"_27386":122968,"_2933":123015},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3450":72201,"_30100":72183,"_20891":123017,"_5":14349,"_27386":122968,"_2933":123018},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3450":72202,"_30100":72183,"_20891":123020,"_5":14349,"_27386":122968,"_2933":123021},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3450":72203,"_30100":72183,"_20891":123023,"_5":14349,"_27386":122968,"_2933":123024},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3450":72204,"_30100":72183,"_20891":123026,"_5":14349,"_27386":122972,"_2933":123027},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3450":72205,"_30100":72183,"_20891":123029,"_5":14349,"_27386":122972,"_2933":123030},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3450":72206,"_30100":72183,"_20891":123032,"_5":14349,"_27386":122976,"_2933":123033},[],"El servicio acepta:",{"_3450":72207,"_30100":72183,"_20891":123035,"_5":14349,"_27386":122976,"_2933":118946},[],{"_3450":72208,"_30100":72183,"_20891":123037,"_5":14349,"_27386":122976,"_2933":123038},[],"Ruta del servicio VA",{"_3450":72209,"_30100":72183,"_20891":123040,"_5":14349,"_27386":122976,"_2933":123041},[],"Formato",{"_3450":72210,"_30100":72183,"_20891":123043,"_5":14349,"_27386":122976,"_2933":56506},[],{"_3450":72211,"_30100":72183,"_20891":123045,"_5":14349,"_27386":122976,"_2933":56509},[],{"_3450":72212,"_30100":72183,"_20891":123047,"_5":14349,"_27386":122976,"_2933":123048},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3450":72213,"_30100":72183,"_20891":123050,"_5":14349,"_27386":122976,"_2933":55918},[],{"_3450":72214,"_30100":72183,"_20891":123052,"_5":14349,"_27386":122976,"_2933":56517},[],{"_3450":72215,"_30100":72183,"_20891":123054,"_5":14349,"_27386":122976,"_2933":123055},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3450":72216,"_30100":72183,"_20891":123057,"_5":14349,"_27386":122976,"_2933":123058},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3450":72217,"_30100":72183,"_20891":123060,"_5":14349,"_27386":122980,"_2933":123061},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3450":72218,"_30100":72183,"_20891":123063,"_5":14349,"_27386":122980,"_2933":123064},[],"Genera la solicitud:",{"_3450":72219,"_30100":72183,"_20891":123066,"_5":14349,"_27386":122980,"_2933":123067},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3450":72220,"_30100":72183,"_20891":123069,"_5":14349,"_27386":122980,"_2933":123070},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3450":72221,"_30100":72183,"_20891":123072,"_5":14349,"_27386":122980,"_2933":123073},[],"Verifica el DER recibido:",{"_3450":72222,"_30100":72183,"_20891":123075,"_5":14349,"_27386":122980,"_2933":123076},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3450":72223,"_30100":72183,"_20891":123078,"_5":14349,"_27386":122984,"_2933":123079},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3450":72224,"_30100":72183,"_20891":123081,"_5":14349,"_27386":122984,"_2933":123082},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3450":72225,"_30100":72183,"_20891":123084,"_5":14349,"_27386":122988,"_2933":56550},[],{"_3450":72226,"_30100":72183,"_20891":123086,"_5":14349,"_27386":122988,"_2933":56553},[],{"_3450":72227,"_30100":72183,"_20891":123088,"_5":14349,"_27386":122988,"_2933":123089},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3450":72228,"_30100":72183,"_20891":123091,"_5":14349,"_27386":122988,"_2933":122574},[],{"_3450":72229,"_30100":72229,"_5":14701,"_2933":54528,"_30453":123093,"_20891":123094,"_27386":72229},[49052,117213,54528],[],{"_3450":72230,"_30100":72229,"_20891":123096,"_5":14349,"_27386":72229,"_2933":123097},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3450":72231,"_30100":72229,"_5":30450,"_20891":123099,"_27386":123100,"_2933":120420},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#empieza-aquí",{"_3450":72232,"_30100":72229,"_5":30450,"_20891":123102,"_27386":123103,"_2933":123104},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3450":72233,"_30100":72229,"_5":30450,"_20891":123106,"_27386":123107,"_2933":120940},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#capacidades-principales",{"_3450":72234,"_30100":72229,"_5":30450,"_20891":123109,"_27386":123110,"_2933":120944},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3450":72235,"_30100":72229,"_5":30450,"_20891":123112,"_27386":123113,"_2933":120948},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3450":72236,"_30100":72229,"_5":30450,"_20891":123115,"_27386":123116,"_2933":120952},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#emite-y-controla-certificados",{"_3450":72237,"_30100":72229,"_5":30450,"_20891":123118,"_27386":123119,"_2933":120960},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#publica-el-estado-de-validación",{"_3450":72238,"_30100":72229,"_5":30450,"_20891":123121,"_27386":123122,"_2933":123123},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3450":72239,"_30100":72229,"_5":30450,"_20891":123125,"_27386":123126,"_2933":121897},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#continúa",{"_3450":72240,"_30100":72229,"_20891":123128,"_5":14349,"_27386":72229,"_2933":123129},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3450":72241,"_30100":72229,"_20891":123131,"_5":14349,"_27386":123100,"_2933":123132},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3450":72242,"_30100":72229,"_20891":123134,"_5":14349,"_27386":123100,"_2933":123135},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3450":72243,"_30100":72229,"_20891":123137,"_5":14349,"_27386":123103,"_2933":123138},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3450":72244,"_30100":72229,"_20891":123140,"_5":14349,"_27386":123103,"_2933":123141},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3450":72245,"_30100":72229,"_20891":123143,"_5":14349,"_27386":123103,"_2933":123144},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3450":72246,"_30100":72229,"_20891":123146,"_5":14349,"_27386":123103,"_2933":123147},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3450":72247,"_30100":72229,"_20891":123149,"_5":14349,"_27386":123103,"_2933":123150},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3450":72248,"_30100":72229,"_20891":123152,"_5":14349,"_27386":123110,"_2933":123153},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3450":72249,"_30100":72229,"_20891":123155,"_5":14349,"_27386":123113,"_2933":123156},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3450":72250,"_30100":72229,"_20891":123158,"_5":14349,"_27386":123116,"_2933":123159},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3450":72251,"_30100":72229,"_20891":123161,"_5":14349,"_27386":123119,"_2933":123162},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3450":72252,"_30100":72229,"_20891":123164,"_5":14349,"_27386":123122,"_2933":123165},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3450":72253,"_30100":72229,"_20891":123167,"_5":14349,"_27386":123122,"_2933":123168},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3450":72254,"_30100":72229,"_20891":123170,"_5":14349,"_27386":123122,"_2933":123171},[],"su clave pública corresponda a la clave privada del cliente;",{"_3450":72255,"_30100":72229,"_20891":123173,"_5":14349,"_27386":123122,"_2933":123174},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3450":72256,"_30100":72229,"_20891":123176,"_5":14349,"_27386":123122,"_2933":123177},[],"sus fechas y usos permitan la operación;",{"_3450":72257,"_30100":72229,"_20891":123179,"_5":14349,"_27386":123122,"_2933":123180},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3450":72258,"_30100":72229,"_20891":123182,"_5":14349,"_27386":123122,"_2933":123183},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3450":72259,"_30100":72229,"_20891":123185,"_5":14349,"_27386":123126,"_2933":123186},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3450":72260,"_30100":72229,"_20891":123188,"_5":14349,"_27386":123126,"_2933":123189},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3450":72261,"_30100":72229,"_20891":123191,"_5":14349,"_27386":123126,"_2933":123192},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3450":72262,"_30100":72262,"_5":14701,"_2933":123194,"_30453":123195,"_20891":123196,"_27386":72262},"Crea tu primera CA",[49052,117213,54528,120544],[],{"_3450":72263,"_30100":72262,"_20891":123198,"_5":14349,"_27386":72262,"_2933":123199},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3450":72264,"_30100":72262,"_5":30450,"_20891":123201,"_27386":123202,"_2933":115791},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3450":72265,"_30100":72262,"_5":30450,"_20891":123204,"_27386":123205,"_2933":123206},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#crea-la-autoridad","Crea la autoridad",{"_3450":72266,"_30100":72262,"_5":30450,"_20891":123208,"_27386":123209,"_2933":123210},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3450":72267,"_30100":72262,"_5":30450,"_20891":123212,"_27386":123213,"_2933":120791},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3450":72268,"_30100":72262,"_5":30450,"_20891":123215,"_27386":123216,"_2933":115815},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3450":72269,"_30100":72262,"_20891":123218,"_5":14349,"_27386":72262,"_2933":123219},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3450":72270,"_30100":72262,"_20891":123221,"_5":14349,"_27386":123202,"_2933":123222},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3450":72271,"_30100":72262,"_20891":123224,"_5":14349,"_27386":123202,"_2933":123225},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3450":72272,"_30100":72262,"_20891":123227,"_5":14349,"_27386":123202,"_2933":123228},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3450":72273,"_30100":72262,"_20891":123230,"_5":14349,"_27386":123202,"_2933":123231},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3450":72274,"_30100":72262,"_20891":123233,"_5":14349,"_27386":123205,"_2933":123234},[],"Sigue el recorrido interactivo para crear una CA raíz con una clave ECDSA P-384 nueva, un sujeto de ejemplo y un perfil de emisión para certificados de cliente. La disponibilidad y la vigencia de los perfiles dependen del entorno; elige valores adecuados para tu CA.",{"_3450":72275,"_30100":72262,"_20891":123236,"_5":14349,"_27386":123205,"_2933":123237},[],"El ejemplo define **CA Name** como `Acme Showcase Root CA`, que se convierte en el Common Name (CN) del subject. También completa los campos opcionales &#x2A;*Country (C)** con `ES` y &#x2A;*Organization (O)** con `Acme`; utiliza los valores que correspondan a tu autoridad.",{"_3450":72276,"_30100":72262,"_20891":123239,"_5":14349,"_27386":123205,"_2933":123240},[],"Abre la nueva CA y selecciona **Certificate PEM**. Descarga o copia su certificado público en `ca.pem`, incluyendo el bloque completo entre `BEGIN CERTIFICATE` y `END CERTIFICATE`. La clave privada permanece en el motor configurado. Para reutilizar una clave existente, consulta la guía de autoridades.",{"_3450":72277,"_30100":72262,"_20891":123242,"_5":14349,"_27386":123209,"_2933":123243},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3450":72278,"_30100":72262,"_20891":123245,"_5":14349,"_27386":123209,"_2933":123246},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3450":72279,"_30100":72262,"_20891":123248,"_5":14349,"_27386":123209,"_2933":123249},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3450":72280,"_30100":72262,"_20891":123251,"_5":14349,"_27386":123213,"_2933":123252},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3450":72281,"_30100":72262,"_20891":123254,"_5":14349,"_27386":123213,"_2933":123255},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3450":72282,"_30100":72262,"_20891":123257,"_5":14349,"_27386":123213,"_2933":123258},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3450":72283,"_30100":72262,"_20891":123260,"_5":14349,"_27386":123213,"_2933":123261},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3450":72284,"_30100":72262,"_20891":123263,"_5":14349,"_27386":123216,"_2933":123264},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3450":72285,"_30100":72285,"_5":14701,"_2933":123266,"_30453":123267,"_20891":123268,"_27386":72285},"Emite y verifica un certificado",[49052,117213,54528,120544],[],{"_3450":72286,"_30100":72285,"_20891":123270,"_5":14349,"_27386":72285,"_2933":123271},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3450":72287,"_30100":72285,"_5":30450,"_20891":123273,"_27386":123274,"_2933":115791},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3450":72288,"_30100":72285,"_5":30450,"_20891":123276,"_27386":123277,"_2933":123278},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3450":72289,"_30100":72285,"_5":30450,"_20891":123280,"_27386":123281,"_2933":123282},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3450":72290,"_30100":72285,"_5":30450,"_20891":123284,"_27386":123285,"_2933":123286},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3450":72291,"_30100":72285,"_5":30450,"_20891":123288,"_27386":123289,"_2933":123290},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3450":72292,"_30100":72285,"_5":30450,"_20891":123292,"_27386":123293,"_2933":123294},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3450":72293,"_30100":72285,"_5":30450,"_20891":123296,"_27386":123297,"_2933":123298},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3450":72294,"_30100":72285,"_5":30450,"_20891":123300,"_27386":123301,"_2933":123302},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3450":72295,"_30100":72285,"_5":30450,"_20891":123304,"_27386":123305,"_2933":123306},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3450":72296,"_30100":72285,"_5":30450,"_20891":123308,"_27386":123309,"_2933":123310},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3450":72297,"_30100":72285,"_5":30450,"_20891":123312,"_27386":123313,"_2933":120791},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3450":72298,"_30100":72285,"_5":30450,"_20891":123315,"_27386":123316,"_2933":115815},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3450":72299,"_30100":72285,"_20891":123318,"_5":14349,"_27386":72285,"_2933":123319},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3450":72300,"_30100":72285,"_20891":123321,"_5":14349,"_27386":123274,"_2933":123322},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3450":72301,"_30100":72285,"_20891":123324,"_5":14349,"_27386":123274,"_2933":123325},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3450":72302,"_30100":72285,"_20891":123327,"_5":14349,"_27386":123274,"_2933":123328},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3450":72303,"_30100":72285,"_20891":123330,"_5":14349,"_27386":123274,"_2933":123331},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3450":72304,"_30100":72285,"_20891":123333,"_5":14349,"_27386":123274,"_2933":123334},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3450":72305,"_30100":72285,"_20891":123336,"_5":14349,"_27386":123277,"_2933":123337},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3450":72306,"_30100":72285,"_20891":123339,"_5":14349,"_27386":123281,"_2933":123340},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3450":72307,"_30100":72285,"_20891":123342,"_5":14349,"_27386":123281,"_2933":123343},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3450":72308,"_30100":72285,"_20891":123345,"_5":14349,"_27386":123285,"_2933":123346},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3450":72309,"_30100":72285,"_20891":123348,"_5":14349,"_27386":123285,"_2933":123349},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3450":72310,"_30100":72285,"_20891":123351,"_5":14349,"_27386":123289,"_2933":123352},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3450":72311,"_30100":72285,"_20891":123354,"_5":14349,"_27386":123289,"_2933":123355},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3450":72312,"_30100":72285,"_20891":123357,"_5":14349,"_27386":123293,"_2933":123358},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3450":72313,"_30100":72285,"_20891":123360,"_5":14349,"_27386":123297,"_2933":123361},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3450":72314,"_30100":72285,"_20891":123363,"_5":14349,"_27386":123301,"_2933":123364},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3450":72315,"_30100":72285,"_20891":123366,"_5":14349,"_27386":123305,"_2933":123367},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3450":72316,"_30100":72285,"_20891":123369,"_5":14349,"_27386":123305,"_2933":123370},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3450":72317,"_30100":72285,"_20891":123372,"_5":14349,"_27386":123305,"_2933":123373},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3450":72318,"_30100":72285,"_20891":123375,"_5":14349,"_27386":123309,"_2933":123376},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3450":72319,"_30100":72285,"_20891":123378,"_5":14349,"_27386":123309,"_2933":123379},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3450":72320,"_30100":72285,"_20891":123381,"_5":14349,"_27386":123309,"_2933":123382},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3450":72321,"_30100":72285,"_20891":123384,"_5":14349,"_27386":123313,"_2933":120874},[],{"_3450":72322,"_30100":72285,"_20891":123386,"_5":14349,"_27386":123313,"_2933":119395},[],{"_3450":72323,"_30100":72285,"_20891":123388,"_5":14349,"_27386":123313,"_2933":123389},[],"La CA rechaza la emisión",{"_3450":72324,"_30100":72285,"_20891":123391,"_5":14349,"_27386":123313,"_2933":123392},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3450":72325,"_30100":72285,"_20891":123394,"_5":14349,"_27386":123313,"_2933":123395},[],"Sujeto o usos diferentes",{"_3450":72326,"_30100":72285,"_20891":123397,"_5":14349,"_27386":123313,"_2933":123398},[],"Perfil aplicado y valores solicitados.",{"_3450":72327,"_30100":72285,"_20891":123400,"_5":14349,"_27386":123313,"_2933":123401},[],"No se encuentra el emisor",{"_3450":72328,"_30100":72285,"_20891":123403,"_5":14349,"_27386":123313,"_2933":123404},[],"CA descargada y cadena intermedia necesaria.",{"_3450":72329,"_30100":72285,"_20891":123406,"_5":14349,"_27386":123313,"_2933":123407},[],"Falla la vigencia",{"_3450":72330,"_30100":72285,"_20891":123409,"_5":14349,"_27386":123313,"_2933":123410},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3450":72331,"_30100":72285,"_20891":123412,"_5":14349,"_27386":123313,"_2933":123413},[],"Los resúmenes de clave difieren",{"_3450":72332,"_30100":72285,"_20891":123415,"_5":14349,"_27386":123313,"_2933":123416},[],"Archivos de certificado y clave de la misma emisión.",{"_3450":72333,"_30100":72285,"_20891":123418,"_5":14349,"_27386":123313,"_2933":123419},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3450":72334,"_30100":72285,"_20891":123421,"_5":14349,"_27386":123316,"_2933":123422},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3450":72335,"_30100":72285,"_20891":123424,"_5":14349,"_27386":123316,"_2933":123425},[],"Gestionar certificados para inspección, estado y revocación.",{"_3450":72336,"_30100":72285,"_20891":123427,"_5":14349,"_27386":123316,"_2933":123428},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3450":72337,"_30100":72285,"_20891":123430,"_5":14349,"_27386":123316,"_2933":123431},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3450":72338,"_30100":72285,"_20891":123433,"_5":14349,"_27386":123316,"_2933":123434},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3450":72339,"_30100":72339,"_5":14701,"_2933":123436,"_30453":123437,"_20891":123438,"_27386":72339},"Primeros pasos de PKI",[49052,117213,54528,120544],[],{"_3450":72340,"_30100":72339,"_20891":123440,"_5":14349,"_27386":72339,"_2933":123441},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3450":72341,"_30100":72339,"_5":30450,"_20891":123443,"_27386":123444,"_2933":115791},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3450":72342,"_30100":72339,"_5":30450,"_20891":123446,"_27386":123447,"_2933":123448},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3450":72343,"_30100":72339,"_5":30450,"_20891":123450,"_27386":123451,"_2933":120726},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3450":72344,"_30100":72339,"_5":30450,"_20891":123453,"_27386":123454,"_2933":123455},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3450":72345,"_30100":72339,"_20891":123457,"_5":14349,"_27386":72339,"_2933":123458},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3450":72346,"_30100":72339,"_20891":123460,"_5":14349,"_27386":123444,"_2933":123461},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3450":72347,"_30100":72339,"_20891":123463,"_5":14349,"_27386":123444,"_2933":123464},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3450":72348,"_30100":72339,"_20891":123466,"_5":14349,"_27386":123444,"_2933":123467},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3450":72349,"_30100":72339,"_20891":123469,"_5":14349,"_27386":123444,"_2933":123470},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3450":72350,"_30100":72339,"_20891":123472,"_5":14349,"_27386":123444,"_2933":123473},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3450":72351,"_30100":72339,"_20891":123475,"_5":14349,"_27386":123447,"_2933":123476},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3450":72352,"_30100":72339,"_20891":123478,"_5":14349,"_27386":123447,"_2933":123479},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3450":72353,"_30100":72339,"_20891":123481,"_5":14349,"_27386":123447,"_2933":123482},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3450":72354,"_30100":72339,"_20891":123484,"_5":14349,"_27386":123447,"_2933":123485},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3450":72355,"_30100":72339,"_20891":123487,"_5":14349,"_27386":123451,"_2933":123488},[],"Archivo o recurso",{"_3450":72356,"_30100":72339,"_20891":123490,"_5":14349,"_27386":123451,"_2933":120723},[],{"_3450":72357,"_30100":72339,"_20891":123492,"_5":14349,"_27386":123451,"_2933":123493},[],"CA raíz activa y `ca.pem`",{"_3450":72358,"_30100":72339,"_20891":123495,"_5":14349,"_27386":123451,"_2933":123496},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3450":72359,"_30100":72339,"_20891":123498,"_5":14349,"_27386":123451,"_2933":123499},[],"Certificado final y `device.crt`",{"_3450":72360,"_30100":72339,"_20891":123501,"_5":14349,"_27386":123451,"_2933":123502},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3450":72361,"_30100":72339,"_20891":123504,"_5":14349,"_27386":123451,"_2933":123505},[],"Clave privada `device.key`",{"_3450":72362,"_30100":72339,"_20891":123507,"_5":14349,"_27386":123451,"_2933":123508},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3450":72363,"_30100":72339,"_20891":123510,"_5":14349,"_27386":123451,"_2933":123511},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3450":72364,"_30100":72339,"_20891":123513,"_5":14349,"_27386":123454,"_2933":123514},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3450":72365,"_30100":72339,"_20891":123516,"_5":14349,"_27386":123454,"_2933":123517},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3450":72366,"_30100":72339,"_20891":123519,"_5":14349,"_27386":123454,"_2933":123520},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3450":72367,"_30100":72367,"_5":14701,"_2933":123522,"_30453":123523,"_20891":123525,"_27386":72367},"Resolución de problemas PKI",[49052,117213,54528,123524],"Resolución de problemas",[],{"_3450":72368,"_30100":72367,"_20891":123527,"_5":14349,"_27386":72367,"_2933":123528},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3450":72369,"_30100":72367,"_5":30450,"_20891":123530,"_27386":123531,"_2933":123532},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3450":72370,"_30100":72367,"_5":30450,"_20891":123534,"_27386":123535,"_2933":123536},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3450":72371,"_30100":72367,"_5":30450,"_20891":123538,"_27386":123539,"_2933":123540},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3450":72372,"_30100":72367,"_20891":123542,"_5":14349,"_27386":72367,"_2933":123543},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3450":72373,"_30100":72367,"_20891":123545,"_5":14349,"_27386":72367,"_2933":123546},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3450":72374,"_30100":72367,"_20891":123548,"_5":14349,"_27386":123531,"_2933":120723},[],{"_3450":72375,"_30100":72367,"_20891":123550,"_5":14349,"_27386":123531,"_2933":119395},[],{"_3450":72376,"_30100":72367,"_20891":123552,"_5":14349,"_27386":123531,"_2933":115815},[],{"_3450":72377,"_30100":72367,"_20891":123554,"_5":14349,"_27386":123531,"_2933":53370},[],{"_3450":72378,"_30100":72367,"_20891":123556,"_5":14349,"_27386":123531,"_2933":123557},[],"Existe, está activa y sus fechas son utilizables.",{"_3450":72379,"_30100":72367,"_20891":123559,"_5":14349,"_27386":123531,"_2933":123560},[],"Autoridades.",{"_3450":72380,"_30100":72367,"_20891":123562,"_5":14349,"_27386":123531,"_2933":123563},[],"Clave",{"_3450":72381,"_30100":72367,"_20891":123565,"_5":14349,"_27386":123531,"_2933":123566},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3450":72382,"_30100":72367,"_20891":123568,"_5":14349,"_27386":123531,"_2933":123569},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3450":72383,"_30100":72367,"_20891":123571,"_5":14349,"_27386":123531,"_2933":57040},[],{"_3450":72384,"_30100":72367,"_20891":123573,"_5":14349,"_27386":123531,"_2933":123574},[],"PEM correcto y firma verificable.",{"_3450":72385,"_30100":72367,"_20891":123576,"_5":14349,"_27386":123531,"_2933":57046},[],{"_3450":72386,"_30100":72367,"_20891":123578,"_5":14349,"_27386":123531,"_2933":123579},[],"Perfil",{"_3450":72387,"_30100":72367,"_20891":123581,"_5":14349,"_27386":123531,"_2933":123582},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3450":72388,"_30100":72367,"_20891":123584,"_5":14349,"_27386":123531,"_2933":123585},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3450":72389,"_30100":72367,"_20891":123587,"_5":14349,"_27386":123531,"_2933":120874},[],{"_3450":72390,"_30100":72367,"_20891":123589,"_5":14349,"_27386":123531,"_2933":123590},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3450":72391,"_30100":72367,"_20891":123592,"_5":14349,"_27386":123531,"_2933":123593},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3450":72392,"_30100":72367,"_20891":123595,"_5":14349,"_27386":123531,"_2933":123596},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3450":72393,"_30100":72367,"_20891":123598,"_5":14349,"_27386":123531,"_2933":123599},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3450":72394,"_30100":72367,"_20891":123601,"_5":14349,"_27386":123535,"_2933":123602},[],"Revisa cada frontera por separado:",{"_3450":72395,"_30100":72367,"_20891":123604,"_5":14349,"_27386":123535,"_2933":123605},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3450":72396,"_30100":72367,"_20891":123607,"_5":14349,"_27386":123535,"_2933":123608},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3450":72397,"_30100":72367,"_20891":123610,"_5":14349,"_27386":123535,"_2933":123611},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3450":72398,"_30100":72367,"_20891":123613,"_5":14349,"_27386":123535,"_2933":123614},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3450":72399,"_30100":72367,"_20891":123616,"_5":14349,"_27386":123535,"_2933":123617},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3450":72400,"_30100":72367,"_20891":123619,"_5":14349,"_27386":123535,"_2933":123620},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3450":72401,"_30100":72367,"_20891":123622,"_5":14349,"_27386":123539,"_2933":123623},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3450":72402,"_30100":72367,"_20891":123625,"_5":14349,"_27386":123539,"_2933":123626},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3450":72403,"_30100":72403,"_5":14701,"_2933":123628,"_30453":123629,"_20891":123630,"_27386":72403},"Seguridad",[49052],[],{"_3450":72404,"_30100":72403,"_20891":123632,"_5":14349,"_27386":72403,"_2933":123633},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3450":72405,"_30100":72403,"_5":30450,"_20891":123635,"_27386":123636,"_2933":123637},[],"/docs/pr-preview/pr-61/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3450":72406,"_30100":72403,"_5":30450,"_20891":123639,"_27386":123640,"_2933":123641},[],"/docs/pr-preview/pr-61/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3450":72407,"_30100":72403,"_5":30450,"_20891":123643,"_27386":123644,"_2933":123645},[],"/docs/pr-preview/pr-61/es/security#versiones-soportadas","Versiones soportadas",{"_3450":72408,"_30100":72403,"_5":30450,"_20891":123647,"_27386":123648,"_2933":123649},[],"/docs/pr-preview/pr-61/es/security#divulgación-responsable","Divulgación responsable",{"_3450":72409,"_30100":72403,"_20891":123651,"_5":14349,"_27386":72403,"_2933":123652},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3450":72410,"_30100":72403,"_20891":123654,"_5":14349,"_27386":123636,"_2933":123655},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3450":72411,"_30100":72403,"_20891":123657,"_5":14349,"_27386":123636,"_2933":123658},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3450":72412,"_30100":72403,"_20891":123660,"_5":14349,"_27386":123636,"_2933":14974},[],{"_3450":72413,"_30100":72403,"_20891":123662,"_5":14349,"_27386":123636,"_2933":14914},[],{"_3450":72414,"_30100":72403,"_20891":123664,"_5":14349,"_27386":123636,"_2933":14961},[],{"_3450":72415,"_30100":72403,"_20891":123666,"_5":14349,"_27386":123636,"_2933":123667},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3450":72416,"_30100":72403,"_20891":123669,"_5":14349,"_27386":123636,"_2933":123670},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3450":72417,"_30100":72403,"_20891":123672,"_5":14349,"_27386":123640,"_2933":123673},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3450":72418,"_30100":72403,"_20891":123675,"_5":14349,"_27386":123640,"_2933":123676},[],"No incluyas en el reporte:",{"_3450":72419,"_30100":72403,"_20891":123678,"_5":14349,"_27386":123640,"_2933":123679},[],"Credenciales, tokens o claves privadas",{"_3450":72420,"_30100":72403,"_20891":123681,"_5":14349,"_27386":123640,"_2933":123682},[],"Datos de clientes o información identificable de clientes",{"_3450":72421,"_30100":72403,"_20891":123684,"_5":14349,"_27386":123640,"_2933":123685},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3450":72422,"_30100":72403,"_20891":123687,"_5":14349,"_27386":123644,"_2933":123688},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3450":72423,"_30100":72403,"_20891":123690,"_5":14349,"_27386":123644,"_2933":123691},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3450":72424,"_30100":72403,"_20891":123693,"_5":14349,"_27386":123648,"_2933":123694},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3450":72425,"_30100":72403,"_20891":123696,"_5":14349,"_27386":123648,"_2933":123697},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3450":72426,"_30100":72403,"_20891":123699,"_5":14349,"_27386":123648,"_2933":123700},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3450":72427,"_30100":72403,"_20891":123702,"_5":14349,"_27386":123648,"_2933":123703},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3450":72428,"_30100":72403,"_20891":123705,"_5":14349,"_27386":123648,"_2933":123706},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3450":72429,"_30100":72429,"_5":14701,"_2933":123708,"_30453":123709,"_20891":123711,"_27386":72429},"3.8.0 a 4.0.0",[49052,123710],"Actualizaciones",[],{"_3450":72430,"_30100":72429,"_20891":123713,"_5":14349,"_27386":72429,"_2933":123714},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3450":72431,"_30100":72429,"_5":30450,"_20891":123716,"_27386":123717,"_2933":123718},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3450":72432,"_30100":72429,"_5":30450,"_20891":123720,"_27386":123721,"_2933":123722},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3450":72433,"_30100":72429,"_5":30450,"_20891":123724,"_27386":123725,"_2933":123726},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3450":72434,"_30100":72429,"_5":30450,"_20891":123728,"_27386":123729,"_2933":123730},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3450":72435,"_30100":72429,"_5":30450,"_20891":123732,"_27386":123733,"_2933":123734},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3450":72436,"_30100":72429,"_5":30450,"_20891":123736,"_27386":123737,"_2933":123738},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3450":72437,"_30100":72429,"_5":30450,"_20891":123740,"_27386":123741,"_2933":57212},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3450":72438,"_30100":72429,"_5":30450,"_20891":123743,"_27386":123744,"_2933":123745},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3450":72439,"_30100":72429,"_5":30450,"_20891":123747,"_27386":123748,"_2933":123749},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3450":72440,"_30100":72429,"_5":30450,"_20891":123751,"_27386":123752,"_2933":123753},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3450":72441,"_30100":72429,"_5":30450,"_20891":123755,"_27386":123756,"_2933":123757},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3450":72442,"_30100":72429,"_5":30450,"_20891":123759,"_27386":123760,"_2933":123761},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3450":72443,"_30100":72429,"_5":30450,"_20891":123763,"_27386":123764,"_2933":123765},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3450":72444,"_30100":72429,"_5":30450,"_20891":123767,"_27386":123768,"_2933":123769},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3450":72445,"_30100":72429,"_5":30450,"_20891":123771,"_27386":123772,"_2933":123773},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3450":72446,"_30100":72429,"_5":30450,"_20891":123775,"_27386":123776,"_2933":123777},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3450":72447,"_30100":72429,"_5":30450,"_20891":123779,"_27386":123780,"_2933":123781},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3450":72448,"_30100":72429,"_5":30450,"_20891":123783,"_27386":123784,"_2933":123785},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3450":72449,"_30100":72429,"_5":30450,"_20891":123787,"_27386":123788,"_2933":123789},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3450":72450,"_30100":72429,"_5":30450,"_20891":123791,"_27386":123792,"_2933":123793},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3450":72451,"_30100":72429,"_5":30450,"_20891":123795,"_27386":123796,"_2933":123797},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3450":72452,"_30100":72429,"_5":30450,"_20891":123799,"_27386":123800,"_2933":123801},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3450":72453,"_30100":72429,"_5":30450,"_20891":123803,"_27386":123804,"_2933":123805},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3450":72454,"_30100":72429,"_5":30450,"_20891":123807,"_27386":123808,"_2933":123809},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3450":72455,"_30100":72429,"_5":30450,"_20891":123811,"_27386":123812,"_2933":123813},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3450":72456,"_30100":72429,"_5":30450,"_20891":123815,"_27386":123816,"_2933":123817},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3450":72457,"_30100":72429,"_5":30450,"_20891":123819,"_27386":123820,"_2933":123821},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3450":72458,"_30100":72429,"_5":30450,"_20891":123823,"_27386":123824,"_2933":123825},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3450":72459,"_30100":72429,"_5":30450,"_20891":123827,"_27386":123828,"_2933":123829},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3450":72460,"_30100":72429,"_5":30450,"_20891":123831,"_27386":123832,"_2933":123833},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3450":72461,"_30100":72429,"_5":30450,"_20891":123835,"_27386":123836,"_2933":123837},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3450":72462,"_30100":72429,"_5":30450,"_20891":123839,"_27386":123840,"_2933":123841},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3450":72463,"_30100":72429,"_5":30450,"_20891":123843,"_27386":123844,"_2933":123845},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3450":72464,"_30100":72429,"_5":30450,"_20891":123847,"_27386":123848,"_2933":123849},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3450":72465,"_30100":72429,"_5":30450,"_20891":123851,"_27386":123852,"_2933":123853},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3450":72466,"_30100":72429,"_5":30450,"_20891":123855,"_27386":123856,"_2933":123857},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3450":72467,"_30100":72429,"_5":30450,"_20891":123859,"_27386":123860,"_2933":123861},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3450":72468,"_30100":72429,"_5":30450,"_20891":123863,"_27386":123864,"_2933":123865},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3450":72469,"_30100":72429,"_5":30450,"_20891":123867,"_27386":123868,"_2933":123869},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3450":72470,"_30100":72429,"_5":30450,"_20891":123871,"_27386":123872,"_2933":123873},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3450":72471,"_30100":72429,"_5":30450,"_20891":123875,"_27386":123876,"_2933":119737},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3450":72472,"_30100":72429,"_5":30450,"_20891":123878,"_27386":123879,"_2933":123880},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3450":72473,"_30100":72429,"_5":30450,"_20891":123882,"_27386":123883,"_2933":123884},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3450":72474,"_30100":72429,"_20891":123886,"_5":14349,"_27386":72429,"_2933":123887},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3450":72475,"_30100":72429,"_20891":123889,"_5":14349,"_27386":72429,"_2933":123890},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3450":72476,"_30100":72429,"_20891":123892,"_5":14349,"_27386":72429,"_2933":123893},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3450":72477,"_30100":72429,"_20891":123895,"_5":14349,"_27386":72429,"_2933":123896},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3450":72478,"_30100":72429,"_20891":123898,"_5":14349,"_27386":72429,"_2933":123899},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3450":72479,"_30100":72429,"_20891":123901,"_5":14349,"_27386":72429,"_2933":123902},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3450":72480,"_30100":72429,"_20891":123904,"_5":14349,"_27386":72429,"_2933":123905},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3450":72481,"_30100":72429,"_20891":123907,"_5":14349,"_27386":123721,"_2933":123908},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3450":72482,"_30100":72429,"_20891":123910,"_5":14349,"_27386":123721,"_2933":123911},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3450":72483,"_30100":72429,"_20891":123913,"_5":14349,"_27386":123725,"_2933":123914},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3450":72484,"_30100":72429,"_20891":123916,"_5":14349,"_27386":123725,"_2933":123917},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3450":72485,"_30100":72429,"_20891":123919,"_5":14349,"_27386":123729,"_2933":123920},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3450":72486,"_30100":72429,"_20891":123922,"_5":14349,"_27386":123733,"_2933":123923},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3450":72487,"_30100":72429,"_20891":123925,"_5":14349,"_27386":123733,"_2933":123926},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3450":72488,"_30100":72429,"_20891":123928,"_5":14349,"_27386":123733,"_2933":123929},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3450":72489,"_30100":72429,"_20891":123931,"_5":14349,"_27386":123733,"_2933":123932},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3450":72490,"_30100":72429,"_20891":123934,"_5":14349,"_27386":123733,"_2933":123935},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3450":72491,"_30100":72429,"_20891":123937,"_5":14349,"_27386":123737,"_2933":123938},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3450":72492,"_30100":72429,"_20891":123940,"_5":14349,"_27386":123737,"_2933":123941},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3450":72493,"_30100":72429,"_20891":123943,"_5":14349,"_27386":123737,"_2933":123944},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3450":72494,"_30100":72429,"_20891":123946,"_5":14349,"_27386":123737,"_2933":123947},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3450":72495,"_30100":72429,"_20891":123949,"_5":14349,"_27386":123737,"_2933":123950},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3450":72496,"_30100":72429,"_20891":123952,"_5":14349,"_27386":123737,"_2933":123953},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3450":72497,"_30100":72429,"_20891":123955,"_5":14349,"_27386":123741,"_2933":123956},[],"Cambio",{"_3450":72498,"_30100":72429,"_20891":123958,"_5":14349,"_27386":123741,"_2933":123959},[],"A quién afecta",{"_3450":72499,"_30100":72429,"_20891":123961,"_5":14349,"_27386":123741,"_2933":123962},[],"Gravedad",{"_3450":72500,"_30100":72429,"_20891":123964,"_5":14349,"_27386":123741,"_2933":122504},[],{"_3450":72501,"_30100":72429,"_20891":123966,"_5":14349,"_27386":123741,"_2933":123749},[],{"_3450":72502,"_30100":72429,"_20891":123968,"_5":14349,"_27386":123741,"_2933":123969},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3450":72503,"_30100":72429,"_20891":123971,"_5":14349,"_27386":123741,"_2933":123972},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3450":72504,"_30100":72429,"_20891":123974,"_5":14349,"_27386":123741,"_2933":123975},[],"Copiar los datos a los volúmenes nuevos",{"_3450":72505,"_30100":72429,"_20891":123977,"_5":14349,"_27386":123741,"_2933":123753},[],{"_3450":72506,"_30100":72429,"_20891":123979,"_5":14349,"_27386":123741,"_2933":123980},[],"Todas las releases de Helm",{"_3450":72507,"_30100":72429,"_20891":123982,"_5":14349,"_27386":123741,"_2933":123983},[],"Alta: `helm upgrade` falla",{"_3450":72508,"_30100":72429,"_20891":123985,"_5":14349,"_27386":123741,"_2933":123986},[],"Eliminar o renombrar las claves heredadas",{"_3450":72509,"_30100":72429,"_20891":123988,"_5":14349,"_27386":123741,"_2933":123757},[],{"_3450":72510,"_30100":72429,"_20891":123990,"_5":14349,"_27386":123741,"_2933":123991},[],"Todos los despliegues",{"_3450":72511,"_30100":72429,"_20891":123993,"_5":14349,"_27386":123741,"_2933":123994},[],"Alta: sin principal de bootstrap no hay administrador",{"_3450":72512,"_30100":72429,"_20891":123996,"_5":14349,"_27386":123741,"_2933":123997},[],"Configurar `services.authz`",{"_3450":72513,"_30100":72429,"_20891":123999,"_5":14349,"_27386":123741,"_2933":123761},[],{"_3450":72514,"_30100":72429,"_20891":124001,"_5":14349,"_27386":123741,"_2933":123980},[],{"_3450":72515,"_30100":72429,"_20891":124003,"_5":14349,"_27386":123741,"_2933":124004},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3450":72516,"_30100":72429,"_20891":124006,"_5":14349,"_27386":123741,"_2933":124007},[],"Mover JWKS y roles a `services.authz`",{"_3450":72517,"_30100":72429,"_20891":124009,"_5":14349,"_27386":123741,"_2933":123781},[],{"_3450":72518,"_30100":72429,"_20891":124011,"_5":14349,"_27386":123741,"_2933":124012},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3450":72519,"_30100":72429,"_20891":124014,"_5":14349,"_27386":123741,"_2933":124015},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3450":72520,"_30100":72429,"_20891":124017,"_5":14349,"_27386":123741,"_2933":124018},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3450":72521,"_30100":72429,"_20891":124020,"_5":14349,"_27386":123741,"_2933":123785},[],{"_3450":72522,"_30100":72429,"_20891":124022,"_5":14349,"_27386":123741,"_2933":124023},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3450":72523,"_30100":72429,"_20891":124025,"_5":14349,"_27386":123741,"_2933":124026},[],"Alta: el backend ya no arranca con ellos",{"_3450":72524,"_30100":72429,"_20891":124028,"_5":14349,"_27386":123741,"_2933":124029},[],"Pasar a PostgreSQL antes de actualizar",{"_3450":72525,"_30100":72429,"_20891":124031,"_5":14349,"_27386":123741,"_2933":123829},[],{"_3450":72526,"_30100":72429,"_20891":124033,"_5":14349,"_27386":123741,"_2933":124034},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3450":72527,"_30100":72429,"_20891":124036,"_5":14349,"_27386":123741,"_2933":124037},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3450":72528,"_30100":72429,"_20891":124039,"_5":14349,"_27386":123741,"_2933":124040},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3450":72529,"_30100":72429,"_20891":124042,"_5":14349,"_27386":123741,"_2933":124043},[],"Webhooks con referencias a archivos",{"_3450":72530,"_30100":72429,"_20891":124045,"_5":14349,"_27386":123741,"_2933":124046},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3450":72531,"_30100":72429,"_20891":124048,"_5":14349,"_27386":123741,"_2933":124049},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3450":72532,"_30100":72429,"_20891":124051,"_5":14349,"_27386":123741,"_2933":124052},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3450":72533,"_30100":72429,"_20891":124054,"_5":14349,"_27386":123741,"_2933":123765},[],{"_3450":72534,"_30100":72429,"_20891":124056,"_5":14349,"_27386":123741,"_2933":124057},[],"Releases con identidades por servicio o material de claves montado",{"_3450":72535,"_30100":72429,"_20891":124059,"_5":14349,"_27386":123741,"_2933":124060},[],"Media: los servicios no pueden leer sus archivos",{"_3450":72536,"_30100":72429,"_20891":124062,"_5":14349,"_27386":123741,"_2933":124063},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3450":72537,"_30100":72429,"_20891":124065,"_5":14349,"_27386":123741,"_2933":123769},[],{"_3450":72538,"_30100":72429,"_20891":124067,"_5":14349,"_27386":123741,"_2933":124068},[],"Releases que definen `amqp.tls`",{"_3450":72539,"_30100":72429,"_20891":124070,"_5":14349,"_27386":123741,"_2933":124071},[],"Media: los clientes se conectan al puerto equivocado",{"_3450":72540,"_30100":72429,"_20891":124073,"_5":14349,"_27386":123741,"_2933":124074},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3450":72541,"_30100":72429,"_20891":124076,"_5":14349,"_27386":123741,"_2933":123789},[],{"_3450":72542,"_30100":72429,"_20891":124078,"_5":14349,"_27386":123741,"_2933":124079},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3450":72543,"_30100":72429,"_20891":124081,"_5":14349,"_27386":123741,"_2933":124082},[],"Media: las claves de CA quedan sin gestionar",{"_3450":72544,"_30100":72429,"_20891":124084,"_5":14349,"_27386":123741,"_2933":124085},[],"Ejecutar la migración de CA a KMS",{"_3450":72545,"_30100":72429,"_20891":124087,"_5":14349,"_27386":123741,"_2933":124088},[],"Verificación del certificado del receptor",{"_3450":72546,"_30100":72429,"_20891":124090,"_5":14349,"_27386":123741,"_2933":124091},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3450":72547,"_30100":72429,"_20891":124093,"_5":14349,"_27386":123741,"_2933":124094},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3450":72548,"_30100":72429,"_20891":124096,"_5":14349,"_27386":123741,"_2933":124097},[],"Poner `insecure_skip_verify` a `false`",{"_3450":72549,"_30100":72429,"_20891":124099,"_5":14349,"_27386":123741,"_2933":123805},[],{"_3450":72550,"_30100":72429,"_20891":124101,"_5":14349,"_27386":123741,"_2933":124102},[],"Scripts y consolas que editan DMS por API",{"_3450":72551,"_30100":72429,"_20891":124104,"_5":14349,"_27386":123741,"_2933":124105},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3450":72552,"_30100":72429,"_20891":124107,"_5":14349,"_27386":123741,"_2933":124108},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3450":72553,"_30100":72429,"_20891":124110,"_5":14349,"_27386":123741,"_2933":123825},[],{"_3450":72554,"_30100":72429,"_20891":124112,"_5":14349,"_27386":123741,"_2933":124113},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3450":72555,"_30100":72429,"_20891":124115,"_5":14349,"_27386":123741,"_2933":124116},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3450":72556,"_30100":72429,"_20891":124118,"_5":14349,"_27386":123741,"_2933":124119},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3450":72557,"_30100":72429,"_20891":124121,"_5":14349,"_27386":123741,"_2933":123833},[],{"_3450":72558,"_30100":72429,"_20891":124123,"_5":14349,"_27386":123741,"_2933":124124},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3450":72559,"_30100":72429,"_20891":124126,"_5":14349,"_27386":123741,"_2933":124127},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3450":72560,"_30100":72429,"_20891":124129,"_5":14349,"_27386":123741,"_2933":124130},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3450":72561,"_30100":72429,"_20891":124132,"_5":14349,"_27386":123741,"_2933":123821},[],{"_3450":72562,"_30100":72429,"_20891":124134,"_5":14349,"_27386":123741,"_2933":124135},[],"Consumidores que leen el campo `events` del dispositivo",{"_3450":72563,"_30100":72429,"_20891":124137,"_5":14349,"_27386":123741,"_2933":124138},[],"Media: el campo desaparece",{"_3450":72564,"_30100":72429,"_20891":124140,"_5":14349,"_27386":123741,"_2933":124141},[],"Usar los nuevos endpoints de eventos",{"_3450":72565,"_30100":72429,"_20891":124143,"_5":14349,"_27386":123741,"_2933":123841},[],{"_3450":72566,"_30100":72429,"_20891":124145,"_5":14349,"_27386":123741,"_2933":124146},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3450":72567,"_30100":72429,"_20891":124148,"_5":14349,"_27386":123741,"_2933":124149},[],"Media: la migración de la VA aborta",{"_3450":72568,"_30100":72429,"_20891":124151,"_5":14349,"_27386":123741,"_2933":124152},[],"Corregir los roles afectados antes de actualizar",{"_3450":72569,"_30100":72429,"_20891":124154,"_5":14349,"_27386":123741,"_2933":123773},[],{"_3450":72570,"_30100":72429,"_20891":124156,"_5":14349,"_27386":123741,"_2933":124157},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3450":72571,"_30100":72429,"_20891":124159,"_5":14349,"_27386":123741,"_2933":124160},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3450":72572,"_30100":72429,"_20891":124162,"_5":14349,"_27386":123741,"_2933":124163},[],"Actualizar el archivo de values",{"_3450":72573,"_30100":72429,"_20891":124165,"_5":14349,"_27386":123741,"_2933":123813},[],{"_3450":72574,"_30100":72429,"_20891":124167,"_5":14349,"_27386":123741,"_2933":124168},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3450":72575,"_30100":72429,"_20891":124170,"_5":14349,"_27386":123741,"_2933":124171},[],"Baja: prevalece el ID de la URL",{"_3450":72576,"_30100":72429,"_20891":124173,"_5":14349,"_27386":123741,"_2933":124174},[],"Enviar el ID en la URL",{"_3450":72577,"_30100":72429,"_20891":124176,"_5":14349,"_27386":123741,"_2933":123837},[],{"_3450":72578,"_30100":72429,"_20891":124178,"_5":14349,"_27386":123741,"_2933":124179},[],"Clientes que envían un `id` al crear o importar CAs",{"_3450":72579,"_30100":72429,"_20891":124181,"_5":14349,"_27386":123741,"_2933":124182},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3450":72580,"_30100":72429,"_20891":124184,"_5":14349,"_27386":123741,"_2933":124185},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3450":72581,"_30100":72429,"_20891":124187,"_5":14349,"_27386":123741,"_2933":123817},[],{"_3450":72582,"_30100":72429,"_20891":124189,"_5":14349,"_27386":123741,"_2933":124190},[],"Consumidores que comparan el `type` del certificado",{"_3450":72583,"_30100":72429,"_20891":124192,"_5":14349,"_27386":123741,"_2933":124193},[],"Baja: dos valores cambian de nombre",{"_3450":72584,"_30100":72429,"_20891":124195,"_5":14349,"_27386":123741,"_2933":124196},[],"Adaptar los consumidores",{"_3450":72585,"_30100":72429,"_20891":124198,"_5":14349,"_27386":123741,"_2933":123809},[],{"_3450":72586,"_30100":72429,"_20891":124200,"_5":14349,"_27386":123741,"_2933":124201},[],"Cualquier DMS",{"_3450":72587,"_30100":72429,"_20891":124203,"_5":14349,"_27386":123741,"_2933":124204},[],"Baja: solo informativo",{"_3450":72588,"_30100":72429,"_20891":124206,"_5":14349,"_27386":123741,"_2933":124207},[],"Revisar ambos bloques antes de editar",{"_3450":72589,"_30100":72429,"_20891":124209,"_5":14349,"_27386":123748,"_2933":124210},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3450":72590,"_30100":72429,"_20891":124212,"_5":14349,"_27386":123748,"_2933":124213},[],"El paso 4 de la guía de migración copia los datos.",{"_3450":72591,"_30100":72429,"_20891":124215,"_5":14349,"_27386":123752,"_2933":124216},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3450":72592,"_30100":72429,"_20891":124218,"_5":14349,"_27386":123756,"_2933":124219},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3450":72593,"_30100":72429,"_20891":124221,"_5":14349,"_27386":123760,"_2933":124222},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3450":72594,"_30100":72429,"_20891":124224,"_5":14349,"_27386":123764,"_2933":124225},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3450":72595,"_30100":72429,"_20891":124227,"_5":14349,"_27386":123764,"_2933":124228},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3450":72596,"_30100":72429,"_20891":124230,"_5":14349,"_27386":123768,"_2933":124231},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3450":72597,"_30100":72429,"_20891":124233,"_5":14349,"_27386":123772,"_2933":124234},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3450":72598,"_30100":72429,"_20891":124236,"_5":14349,"_27386":123772,"_2933":124237},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3450":72599,"_30100":72429,"_20891":124239,"_5":14349,"_27386":123772,"_2933":124240},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3450":72600,"_30100":72429,"_20891":124242,"_5":14349,"_27386":123772,"_2933":124243},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3450":72601,"_30100":72429,"_20891":124245,"_5":14349,"_27386":123772,"_2933":124246},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3450":72602,"_30100":72429,"_20891":124248,"_5":14349,"_27386":123772,"_2933":124249},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3450":72603,"_30100":72429,"_20891":124251,"_5":14349,"_27386":123780,"_2933":124252},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3450":72604,"_30100":72429,"_20891":124254,"_5":14349,"_27386":123780,"_2933":124255},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3450":72605,"_30100":72429,"_20891":124257,"_5":14349,"_27386":123780,"_2933":124258},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3450":72606,"_30100":72429,"_20891":124260,"_5":14349,"_27386":123780,"_2933":124261},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3450":72607,"_30100":72429,"_20891":124263,"_5":14349,"_27386":123780,"_2933":124264},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3450":72608,"_30100":72429,"_20891":124266,"_5":14349,"_27386":123784,"_2933":124267},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3450":72609,"_30100":72429,"_20891":124269,"_5":14349,"_27386":123788,"_2933":124270},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3450":72610,"_30100":72429,"_20891":124272,"_5":14349,"_27386":123788,"_2933":124273},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3450":72611,"_30100":72429,"_20891":124275,"_5":14349,"_27386":123788,"_2933":124276},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3450":72612,"_30100":72429,"_20891":124278,"_5":14349,"_27386":123788,"_2933":124279},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3450":72613,"_30100":72429,"_20891":124281,"_5":14349,"_27386":123788,"_2933":124282},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3450":72614,"_30100":72429,"_20891":124284,"_5":14349,"_27386":123788,"_2933":124285},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3450":72615,"_30100":72429,"_20891":124287,"_5":14349,"_27386":123788,"_2933":124288},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3450":72616,"_30100":72429,"_20891":124290,"_5":14349,"_27386":123788,"_2933":124291},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3450":72617,"_30100":72429,"_20891":124293,"_5":14349,"_27386":123792,"_2933":124294},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3450":72618,"_30100":72429,"_20891":124296,"_5":14349,"_27386":123800,"_2933":124297},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3450":72619,"_30100":72429,"_20891":124299,"_5":14349,"_27386":123800,"_2933":124300},[],"Campo en 3.8.0",{"_3450":72620,"_30100":72429,"_20891":124302,"_5":14349,"_27386":123800,"_2933":124303},[],"Campo en 4.0.0",{"_3450":72621,"_30100":72429,"_20891":124305,"_5":14349,"_27386":123800,"_2933":57777},[],{"_3450":72622,"_30100":72429,"_20891":124307,"_5":14349,"_27386":123800,"_2933":124308},[],"`insecure_skip_verify` (con el valor negado)",{"_3450":72623,"_30100":72429,"_20891":124310,"_5":14349,"_27386":123800,"_2933":57783},[],{"_3450":72624,"_30100":72429,"_20891":124312,"_5":14349,"_27386":123800,"_2933":57786},[],{"_3450":72625,"_30100":72429,"_20891":124314,"_5":14349,"_27386":123800,"_2933":57789},[],{"_3450":72626,"_30100":72429,"_20891":124316,"_5":14349,"_27386":123800,"_2933":57792},[],{"_3450":72627,"_30100":72429,"_20891":124318,"_5":14349,"_27386":123800,"_2933":57795},[],{"_3450":72628,"_30100":72429,"_20891":124320,"_5":14349,"_27386":123800,"_2933":57798},[],{"_3450":72629,"_30100":72429,"_20891":124322,"_5":14349,"_27386":123800,"_2933":124323},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3450":72630,"_30100":72429,"_20891":124325,"_5":14349,"_27386":123800,"_2933":124326},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3450":72631,"_30100":72429,"_20891":124328,"_5":14349,"_27386":123800,"_2933":124329},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3450":72632,"_30100":72429,"_20891":124331,"_5":14349,"_27386":123804,"_2933":124332},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3450":72633,"_30100":72429,"_20891":124334,"_5":14349,"_27386":123804,"_2933":124335},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3450":72634,"_30100":72429,"_20891":124337,"_5":14349,"_27386":123804,"_2933":124338},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3450":72635,"_30100":72429,"_20891":124340,"_5":14349,"_27386":123808,"_2933":124341},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3450":72636,"_30100":72429,"_20891":124343,"_5":14349,"_27386":123812,"_2933":124344},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3450":72637,"_30100":72429,"_20891":124346,"_5":14349,"_27386":123816,"_2933":124347},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3450":72638,"_30100":72429,"_20891":124349,"_5":14349,"_27386":123820,"_2933":124350},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3450":72639,"_30100":72429,"_20891":124352,"_5":14349,"_27386":123820,"_2933":124353},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3450":72640,"_30100":72429,"_20891":124355,"_5":14349,"_27386":123820,"_2933":124356},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3450":72641,"_30100":72429,"_20891":124358,"_5":14349,"_27386":123820,"_2933":124359},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3450":72642,"_30100":72429,"_20891":124361,"_5":14349,"_27386":123824,"_2933":124362},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3450":72643,"_30100":72429,"_20891":124364,"_5":14349,"_27386":123828,"_2933":124365},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3450":72644,"_30100":72429,"_20891":124367,"_5":14349,"_27386":123828,"_2933":124368},[],"Ruta",{"_3450":72645,"_30100":72429,"_20891":124370,"_5":14349,"_27386":123828,"_2933":116973},[],{"_3450":72646,"_30100":72429,"_20891":124372,"_5":14349,"_27386":123828,"_2933":57851},[],{"_3450":72647,"_30100":72429,"_20891":124374,"_5":14349,"_27386":123828,"_2933":124375},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3450":72648,"_30100":72429,"_20891":124377,"_5":14349,"_27386":123828,"_2933":57857},[],{"_3450":72649,"_30100":72429,"_20891":124379,"_5":14349,"_27386":123828,"_2933":124380},[],"Lee los ajustes de una CA.",{"_3450":72650,"_30100":72429,"_20891":124382,"_5":14349,"_27386":123828,"_2933":57863},[],{"_3450":72651,"_30100":72429,"_20891":124384,"_5":14349,"_27386":123828,"_2933":124385},[],"Sustituye los `crl_options`.",{"_3450":72652,"_30100":72429,"_20891":124387,"_5":14349,"_27386":123828,"_2933":124388},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3450":72653,"_30100":72429,"_20891":124390,"_5":14349,"_27386":123828,"_2933":124391},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3450":72654,"_30100":72429,"_20891":124393,"_5":14349,"_27386":123828,"_2933":124394},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3450":72655,"_30100":72429,"_20891":124396,"_5":14349,"_27386":123828,"_2933":124397},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3450":72656,"_30100":72429,"_20891":124399,"_5":14349,"_27386":123828,"_2933":124400},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3450":72657,"_30100":72429,"_20891":124402,"_5":14349,"_27386":123828,"_2933":124403},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3450":72658,"_30100":72429,"_20891":124405,"_5":14349,"_27386":123828,"_2933":124406},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3450":72659,"_30100":72429,"_20891":124408,"_5":14349,"_27386":123828,"_2933":124409},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3450":72660,"_30100":72429,"_20891":124411,"_5":14349,"_27386":123828,"_2933":124412},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3450":72661,"_30100":72429,"_20891":124414,"_5":14349,"_27386":123828,"_2933":124415},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3450":72662,"_30100":72429,"_20891":124417,"_5":14349,"_27386":123828,"_2933":124418},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3450":72663,"_30100":72429,"_20891":124420,"_5":14349,"_27386":123832,"_2933":124421},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3450":72664,"_30100":72429,"_20891":124423,"_5":14349,"_27386":123836,"_2933":124424},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3450":72665,"_30100":72429,"_20891":124426,"_5":14349,"_27386":123840,"_2933":124427},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3450":72666,"_30100":72429,"_20891":124429,"_5":14349,"_27386":123844,"_2933":124430},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3450":72667,"_30100":72429,"_20891":124432,"_5":14349,"_27386":123848,"_2933":124433},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3450":72668,"_30100":72429,"_20891":124435,"_5":14349,"_27386":123848,"_2933":124436},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3450":72669,"_30100":72429,"_20891":124438,"_5":14349,"_27386":123848,"_2933":124439},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3450":72670,"_30100":72429,"_20891":124441,"_5":14349,"_27386":123848,"_2933":124442},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3450":72671,"_30100":72429,"_20891":124444,"_5":14349,"_27386":123848,"_2933":124445},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3450":72672,"_30100":72429,"_20891":124447,"_5":14349,"_27386":123848,"_2933":124448},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3450":72673,"_30100":72429,"_20891":124450,"_5":14349,"_27386":123852,"_2933":124451},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3450":72674,"_30100":72429,"_20891":124453,"_5":14349,"_27386":123852,"_2933":124454},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3450":72675,"_30100":72429,"_20891":124456,"_5":14349,"_27386":123852,"_2933":124457},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3450":72676,"_30100":72429,"_20891":124459,"_5":14349,"_27386":123852,"_2933":124460},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3450":72677,"_30100":72429,"_20891":124462,"_5":14349,"_27386":123852,"_2933":124463},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3450":72678,"_30100":72429,"_20891":124465,"_5":14349,"_27386":123856,"_2933":124466},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3450":72679,"_30100":72429,"_20891":124468,"_5":14349,"_27386":123856,"_2933":124469},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3450":72680,"_30100":72429,"_20891":124471,"_5":14349,"_27386":123856,"_2933":124472},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3450":72681,"_30100":72429,"_20891":124474,"_5":14349,"_27386":123856,"_2933":124475},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3450":72682,"_30100":72429,"_20891":124477,"_5":14349,"_27386":123856,"_2933":124478},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3450":72683,"_30100":72429,"_20891":124480,"_5":14349,"_27386":123856,"_2933":124481},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3450":72684,"_30100":72429,"_20891":124483,"_5":14349,"_27386":123856,"_2933":124484},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3450":72685,"_30100":72429,"_20891":124486,"_5":14349,"_27386":123856,"_2933":124487},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3450":72686,"_30100":72429,"_20891":124489,"_5":14349,"_27386":123856,"_2933":124490},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3450":72687,"_30100":72429,"_20891":124492,"_5":14349,"_27386":123856,"_2933":124493},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3450":72688,"_30100":72429,"_20891":124495,"_5":14349,"_27386":123856,"_2933":124496},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3450":72689,"_30100":72429,"_20891":124498,"_5":14349,"_27386":123856,"_2933":124499},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3450":72690,"_30100":72429,"_20891":124501,"_5":14349,"_27386":123860,"_2933":124502},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3450":72691,"_30100":72429,"_20891":124504,"_5":14349,"_27386":123860,"_2933":124505},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3450":72692,"_30100":72429,"_20891":124507,"_5":14349,"_27386":123864,"_2933":124508},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3450":72693,"_30100":72429,"_20891":124510,"_5":14349,"_27386":123864,"_2933":124511},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3450":72694,"_30100":72429,"_20891":124513,"_5":14349,"_27386":123864,"_2933":124514},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3450":72695,"_30100":72429,"_20891":124516,"_5":14349,"_27386":123864,"_2933":124517},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3450":72696,"_30100":72429,"_20891":124519,"_5":14349,"_27386":123864,"_2933":124520},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3450":72697,"_30100":72429,"_20891":124522,"_5":14349,"_27386":123864,"_2933":124523},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3450":72698,"_30100":72429,"_20891":124525,"_5":14349,"_27386":123864,"_2933":124526},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3450":72699,"_30100":72429,"_20891":124528,"_5":14349,"_27386":123864,"_2933":124529},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3450":72700,"_30100":72429,"_20891":124531,"_5":14349,"_27386":123864,"_2933":124532},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3450":72701,"_30100":72429,"_20891":124534,"_5":14349,"_27386":123864,"_2933":124535},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3450":72702,"_30100":72429,"_20891":124537,"_5":14349,"_27386":123864,"_2933":124538},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3450":72703,"_30100":72429,"_20891":124540,"_5":14349,"_27386":123868,"_2933":124541},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3450":72704,"_30100":72429,"_20891":124543,"_5":14349,"_27386":123868,"_2933":124544},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3450":72705,"_30100":72429,"_20891":124546,"_5":14349,"_27386":123872,"_2933":124547},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3450":72706,"_30100":72429,"_20891":124549,"_5":14349,"_27386":123872,"_2933":124550},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3450":72707,"_30100":72429,"_20891":124552,"_5":14349,"_27386":123872,"_2933":124553},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3450":72708,"_30100":72429,"_20891":124555,"_5":14349,"_27386":123872,"_2933":124556},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3450":72709,"_30100":72429,"_20891":124558,"_5":14349,"_27386":123872,"_2933":124559},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3450":72710,"_30100":72429,"_20891":124561,"_5":14349,"_27386":123872,"_2933":124562},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3450":72711,"_30100":72429,"_20891":124564,"_5":14349,"_27386":123872,"_2933":124565},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3450":72712,"_30100":72429,"_20891":124567,"_5":14349,"_27386":123872,"_2933":124568},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3450":72713,"_30100":72429,"_20891":124570,"_5":14349,"_27386":123876,"_2933":124571},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3450":72714,"_30100":72429,"_20891":124573,"_5":14349,"_27386":123876,"_2933":124574},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3450":72715,"_30100":72429,"_20891":124576,"_5":14349,"_27386":123876,"_2933":124577},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3450":72716,"_30100":72429,"_20891":124579,"_5":14349,"_27386":123876,"_2933":124580},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3450":72717,"_30100":72429,"_20891":124582,"_5":14349,"_27386":123876,"_2933":124583},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3450":72718,"_30100":72429,"_20891":124585,"_5":14349,"_27386":123876,"_2933":124586},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3450":72719,"_30100":72429,"_20891":124588,"_5":14349,"_27386":123876,"_2933":124589},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3450":72720,"_30100":72429,"_20891":124591,"_5":14349,"_27386":123876,"_2933":124592},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3450":72721,"_30100":72429,"_20891":124594,"_5":14349,"_27386":123876,"_2933":124595},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3450":72722,"_30100":72429,"_20891":124597,"_5":14349,"_27386":123876,"_2933":124598},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3450":72723,"_30100":72429,"_20891":124600,"_5":14349,"_27386":123876,"_2933":124601},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3450":72724,"_30100":72429,"_20891":124603,"_5":14349,"_27386":123879,"_2933":124604},[],"Tras la actualización, comprueba en este orden:",{"_3450":72725,"_30100":72429,"_20891":124606,"_5":14349,"_27386":123879,"_2933":124607},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3450":72726,"_30100":72429,"_20891":124609,"_5":14349,"_27386":123879,"_2933":124610},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3450":72727,"_30100":72429,"_20891":124612,"_5":14349,"_27386":123879,"_2933":124613},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3450":72728,"_30100":72429,"_20891":124615,"_5":14349,"_27386":123879,"_2933":124616},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3450":72729,"_30100":72429,"_20891":124618,"_5":14349,"_27386":123879,"_2933":124619},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3450":72730,"_30100":72429,"_20891":124621,"_5":14349,"_27386":123879,"_2933":124622},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3450":72731,"_30100":72429,"_20891":124624,"_5":14349,"_27386":123879,"_2933":124625},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3450":72732,"_30100":72429,"_20891":124627,"_5":14349,"_27386":123879,"_2933":124628},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3450":72733,"_30100":72429,"_20891":124630,"_5":14349,"_27386":123879,"_2933":124631},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3450":72734,"_30100":72429,"_20891":124633,"_5":14349,"_27386":123879,"_2933":124634},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3450":72735,"_30100":72429,"_20891":124636,"_5":14349,"_27386":123879,"_2933":124637},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3450":72736,"_30100":72429,"_20891":124639,"_5":14349,"_27386":123879,"_2933":124640},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3450":72737,"_30100":72429,"_20891":124642,"_5":14349,"_27386":123879,"_2933":124643},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3450":72738,"_30100":72429,"_20891":124645,"_5":14349,"_27386":123879,"_2933":124646},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3450":72739,"_30100":72429,"_20891":124648,"_5":14349,"_27386":123879,"_2933":124649},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3450":72740,"_30100":72429,"_20891":124651,"_5":14349,"_27386":123883,"_2933":124652},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3450":72741,"_30100":72429,"_20891":124654,"_5":14349,"_27386":123883,"_2933":124655},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3450":72742,"_30100":72429,"_20891":124657,"_5":14349,"_27386":123883,"_2933":124658},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3450":72743,"_30100":72429,"_20891":124660,"_5":14349,"_27386":123883,"_2933":124661},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3450":72744,"_30100":72429,"_20891":124663,"_5":14349,"_27386":123883,"_2933":124664},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58148":124666,"_58150":124667,"_58152":124668,"_58154":124669,"_18119":2968,"_69825":2968},"spanish",[2933,30100,5,27386],{"_2933":24962,"_30100":24962,"_5":24962,"_27386":24962},{"_2933":124670,"_30100":127586,"_5":130502,"_27386":133418},{"_4627":124671,"_58158":124672,"_5":24962},{"_14425":25328,"_14806":6079,"_14825":4466,"_29103":6980,"_14812":8523,"_19834":18211,"_14446":5984,"_14453":5816,"_29045":3025,"_29454":5812,"_29475":4389,"_29079":12727,"_34414":4020,"_29182":26167,"_29519":9836,"_34421":6519,"_34424":5934,"_34427":6987,"_34430":4142,"_29926":8391,"_34435":4019,"_34437":6927,"_29956":7029,"_14821":6200,"_34441":7475,"_34444":7548,"_3