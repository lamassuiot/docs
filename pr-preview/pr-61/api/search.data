[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3582":19,"_31169":15,"_5":31524,"_21582":50853,"_28301":50854,"_3051":50855},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3582":20,"_31169":15,"_5":31524,"_21582":50857,"_28301":50858,"_3051":50859},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3582":21,"_31169":15,"_5":31524,"_21582":50861,"_28301":50862,"_3051":50863},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3582":22,"_31169":15,"_5":31524,"_21582":50865,"_28301":50866,"_3051":50867},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3582":23,"_31169":15,"_5":31524,"_21582":50869,"_28301":50870,"_3051":50871},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#next-step","Next step",{"_3582":24,"_31169":15,"_21582":50873,"_5":14829,"_28301":15,"_3051":50874},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3582":25,"_31169":15,"_21582":50876,"_5":14829,"_28301":50846,"_3051":50877},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3582":26,"_31169":15,"_21582":50879,"_5":14829,"_28301":50846,"_3051":50880},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3582":27,"_31169":15,"_21582":50882,"_5":14829,"_28301":50846,"_3051":50883},[],"A security group allowing the necessary endpoints.",{"_3582":28,"_31169":15,"_21582":50885,"_5":14829,"_28301":50850,"_3051":50886},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3582":29,"_31169":15,"_21582":50888,"_5":14829,"_28301":50850,"_3051":50889},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3582":30,"_31169":15,"_21582":50891,"_5":14829,"_28301":50850,"_3051":50892},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3582":31,"_31169":15,"_21582":50894,"_5":14829,"_28301":50854,"_3051":50895},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3582":32,"_31169":15,"_21582":50897,"_5":14829,"_28301":50858,"_3051":50898},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3582":33,"_31169":15,"_21582":50900,"_5":14829,"_28301":50862,"_3051":50901},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3582":34,"_31169":15,"_21582":50903,"_5":14829,"_28301":50866,"_3051":50904},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3582":35,"_31169":15,"_21582":50906,"_5":14829,"_28301":50870,"_3051":50907},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3582":36,"_31169":36,"_5":15200,"_3051":50909,"_31527":50910,"_21582":50911,"_28301":36},"Deploy Lamassu",[50837,50838],[],{"_3582":37,"_31169":36,"_21582":50913,"_5":14829,"_28301":36,"_3051":50914},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3582":38,"_31169":36,"_5":31524,"_21582":50916,"_28301":50917,"_3051":50918},[],"/docs/pr-preview/pr-61/deployment/overview#choose-a-model","Choose a model",{"_3582":39,"_31169":36,"_5":31524,"_21582":50920,"_28301":50921,"_3051":50922},[],"/docs/pr-preview/pr-61/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3582":40,"_31169":36,"_5":31524,"_21582":50924,"_28301":50925,"_3051":50926},[],"/docs/pr-preview/pr-61/deployment/overview#after-deployment","After deployment",{"_3582":41,"_31169":36,"_21582":50928,"_5":14829,"_28301":36,"_3051":50929},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3582":42,"_31169":36,"_21582":50931,"_5":14829,"_28301":50917,"_3051":50932},[],"Model",{"_3582":43,"_31169":36,"_21582":50934,"_5":14829,"_28301":50917,"_3051":50935},[],"Recommended for",{"_3582":44,"_31169":36,"_21582":50937,"_5":14829,"_28301":50917,"_3051":50938},[],"Who operates the infrastructure",{"_3582":45,"_31169":36,"_21582":50940,"_5":14829,"_28301":50917,"_3051":50941},[],"Starting point",{"_3582":46,"_31169":36,"_21582":50943,"_5":14829,"_28301":50917,"_3051":50944},[],"Kubernetes self-managed",{"_3582":47,"_31169":36,"_21582":50946,"_5":14829,"_28301":50917,"_3051":50947},[],"Production, regulated environments and custom deployments",{"_3582":48,"_31169":36,"_21582":50949,"_5":14829,"_28301":50917,"_3051":50950},[],"Your team",{"_3582":49,"_31169":36,"_21582":50952,"_5":14829,"_28301":50917,"_3051":50953},[],"Helm or Fastlane",{"_3582":50,"_31169":36,"_21582":50955,"_5":14829,"_28301":50917,"_3051":50956},[],"AWS Marketplace",{"_3582":51,"_31169":36,"_21582":50958,"_5":14829,"_28301":50917,"_3051":50959},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3582":52,"_31169":36,"_21582":50961,"_5":14829,"_28301":50917,"_3051":50950},[],{"_3582":53,"_31169":36,"_21582":50963,"_5":14829,"_28301":50917,"_3051":50964},[],"Preconfigured image on EC2",{"_3582":54,"_31169":36,"_21582":50966,"_5":14829,"_28301":50917,"_3051":50967},[],"SaaS",{"_3582":55,"_31169":36,"_21582":50969,"_5":14829,"_28301":50917,"_3051":50970},[],"Teams that want to use the platform without operating it",{"_3582":56,"_31169":36,"_21582":50972,"_5":14829,"_28301":50917,"_3051":50973},[],"Lamassu",{"_3582":57,"_31169":36,"_21582":50975,"_5":14829,"_28301":50917,"_3051":50976},[],"Managed subscription",{"_3582":58,"_31169":36,"_21582":50978,"_5":14829,"_28301":50917,"_3051":50979},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3582":59,"_31169":36,"_21582":50981,"_5":14829,"_28301":50917,"_3051":50982},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3582":60,"_31169":36,"_21582":50984,"_5":14829,"_28301":50917,"_3051":50985},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3582":61,"_31169":36,"_21582":50987,"_5":14829,"_28301":50921,"_3051":50988},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3582":62,"_31169":36,"_21582":50990,"_5":14829,"_28301":50925,"_3051":50991},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3582":63,"_31169":63,"_5":15200,"_3051":50993,"_31527":50994,"_21582":50995,"_28301":63},"Use Lamassu as SaaS",[50837,50838,50839],[],{"_3582":64,"_31169":63,"_21582":50997,"_5":14829,"_28301":63,"_3051":50998},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3582":65,"_31169":63,"_5":31524,"_21582":51000,"_28301":51001,"_3051":51002},[],"/docs/pr-preview/pr-61/deployment/saas#what-the-service-manages","What the service manages",{"_3582":66,"_31169":63,"_5":31524,"_21582":51004,"_28301":51005,"_3051":51006},[],"/docs/pr-preview/pr-61/deployment/saas#plans","Plans",{"_3582":67,"_31169":63,"_5":31524,"_21582":51008,"_28301":51009,"_3051":51010},[],"/docs/pr-preview/pr-61/deployment/saas#request-access","Request access",{"_3582":68,"_31169":63,"_21582":51012,"_5":14829,"_28301":63,"_3051":51013},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3582":69,"_31169":63,"_21582":51015,"_5":14829,"_28301":51001,"_3051":51016},[],"Platform availability and maintenance.",{"_3582":70,"_31169":63,"_21582":51018,"_5":14829,"_28301":51001,"_3051":51019},[],"Automatic backups.",{"_3582":71,"_31169":63,"_21582":51021,"_5":14829,"_28301":51001,"_3051":51022},[],"Version upgrades.",{"_3582":72,"_31169":63,"_21582":51024,"_5":14829,"_28301":51001,"_3051":51025},[],"Technical support and SLA according to your plan.",{"_3582":73,"_31169":63,"_21582":51027,"_5":14829,"_28301":51005,"_3051":51028},[],"Plan",{"_3582":74,"_31169":63,"_21582":51030,"_5":14829,"_28301":51005,"_3051":51031},[],"Devices",{"_3582":75,"_31169":63,"_21582":51033,"_5":14829,"_28301":51005,"_3051":51034},[],"Support",{"_3582":76,"_31169":63,"_21582":51036,"_5":14829,"_28301":51005,"_3051":51037},[],"SLA",{"_3582":77,"_31169":63,"_21582":51039,"_5":14829,"_28301":51005,"_3051":51040},[],"Starter",{"_3582":78,"_31169":63,"_21582":51042,"_5":14829,"_28301":51005,"_3051":51043},[],"Up to 1,000",{"_3582":79,"_31169":63,"_21582":51045,"_5":14829,"_28301":51005,"_3051":51046},[],"Email",{"_3582":80,"_31169":63,"_21582":51048,"_5":14829,"_28301":51005,"_3051":51049},[],"99.5 %",{"_3582":81,"_31169":63,"_21582":51051,"_5":14829,"_28301":51005,"_3051":51052},[],"Professional",{"_3582":82,"_31169":63,"_21582":51054,"_5":14829,"_28301":51005,"_3051":51055},[],"Up to 10,000",{"_3582":83,"_31169":63,"_21582":51057,"_5":14829,"_28301":51005,"_3051":51058},[],"Email and chat",{"_3582":84,"_31169":63,"_21582":51060,"_5":14829,"_28301":51005,"_3051":51061},[],"99.9 %",{"_3582":85,"_31169":63,"_21582":51063,"_5":14829,"_28301":51005,"_3051":51064},[],"Enterprise",{"_3582":86,"_31169":63,"_21582":51066,"_5":14829,"_28301":51005,"_3051":51067},[],"Unlimited",{"_3582":87,"_31169":63,"_21582":51069,"_5":14829,"_28301":51005,"_3051":51070},[],"Dedicated",{"_3582":88,"_31169":63,"_21582":51072,"_5":14829,"_28301":51005,"_3051":51073},[],"99.99 %",{"_3582":89,"_31169":63,"_21582":51075,"_5":14829,"_28301":51009,"_3051":51076},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3582":90,"_31169":63,"_21582":51078,"_5":14829,"_28301":51009,"_3051":51079},[],"When you receive your instance's credentials, continue with Get started.",{"_3582":91,"_31169":91,"_5":15200,"_3051":51081,"_31527":51082,"_21582":51083,"_28301":91},"Fastlane",[50837,50838,50944],[],{"_3582":92,"_31169":91,"_21582":51085,"_5":14829,"_28301":91,"_3051":51086},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3582":93,"_31169":91,"_5":31524,"_21582":51088,"_28301":51089,"_3051":51090},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3582":94,"_31169":91,"_5":31524,"_21582":51092,"_28301":51093,"_3051":51094},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3582":95,"_31169":91,"_5":31524,"_21582":51096,"_28301":51097,"_3051":50847},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#before-you-begin",{"_3582":96,"_31169":91,"_5":31524,"_21582":51099,"_28301":51100,"_3051":51101},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3582":97,"_31169":91,"_5":31524,"_21582":51103,"_28301":51104,"_3051":51105},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3582":98,"_31169":91,"_5":31524,"_21582":51107,"_28301":51108,"_3051":51109},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3582":99,"_31169":91,"_5":31524,"_21582":51111,"_28301":51112,"_3051":51113},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3582":100,"_31169":91,"_5":31524,"_21582":51115,"_28301":51116,"_3051":51117},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3582":101,"_31169":91,"_5":31524,"_21582":51119,"_28301":51120,"_3051":51121},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3582":102,"_31169":91,"_5":31524,"_21582":51123,"_28301":51124,"_3051":51125},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3582":103,"_31169":91,"_5":31524,"_21582":51127,"_28301":51128,"_3051":51129},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3582":104,"_31169":91,"_21582":51131,"_5":14829,"_28301":51089,"_3051":51132},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3582":105,"_31169":91,"_21582":51134,"_5":14829,"_28301":51089,"_3051":51135},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3582":106,"_31169":91,"_21582":51137,"_5":14829,"_28301":51093,"_3051":51138},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3582":107,"_31169":91,"_21582":51140,"_5":14829,"_28301":51093,"_3051":51141},[],"Fastlane installs or configures",{"_3582":108,"_31169":91,"_21582":51143,"_5":14829,"_28301":51093,"_3051":51144},[],"You still provide",{"_3582":109,"_31169":91,"_21582":51146,"_5":14829,"_28301":51093,"_3051":51147},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3582":110,"_31169":91,"_21582":51149,"_5":14829,"_28301":51093,"_3051":51150},[],"The Kubernetes cluster, nodes and persistent storage",{"_3582":111,"_31169":91,"_21582":51152,"_5":14829,"_28301":51093,"_3051":51153},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3582":112,"_31169":91,"_21582":51155,"_5":14829,"_28301":51093,"_3051":51156},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3582":113,"_31169":91,"_21582":51158,"_5":14829,"_28301":51093,"_3051":51159},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3582":114,"_31169":91,"_21582":51161,"_5":14829,"_28301":51093,"_3051":51162},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3582":115,"_31169":91,"_21582":51164,"_5":14829,"_28301":51093,"_3051":51165},[],"Optional observability and lab HSM components",{"_3582":116,"_31169":91,"_21582":51167,"_5":14829,"_28301":51093,"_3051":51168},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3582":117,"_31169":91,"_21582":51170,"_5":14829,"_28301":51093,"_3051":51171},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3582":118,"_31169":91,"_21582":51173,"_5":14829,"_28301":51097,"_3051":51174},[],"You need:",{"_3582":119,"_31169":91,"_21582":51176,"_5":14829,"_28301":51097,"_3051":51177},[],"an existing Kubernetes cluster",{"_3582":120,"_31169":91,"_21582":51179,"_5":14829,"_28301":51097,"_3051":51180},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3582":121,"_31169":91,"_21582":51182,"_5":14829,"_28301":51097,"_3051":51183},[],"`yq`",{"_3582":122,"_31169":91,"_21582":51185,"_5":14829,"_28301":51097,"_3051":24444},[],{"_3582":123,"_31169":91,"_21582":51187,"_5":14829,"_28301":51097,"_3051":51188},[],"`jq` only when using `--sample-data` or `--development`",{"_3582":124,"_31169":91,"_21582":51190,"_5":14829,"_28301":51097,"_3051":51191},[],"`ssh-keygen` only when using `--with-hsm`",{"_3582":125,"_31169":91,"_21582":51193,"_5":14829,"_28301":51097,"_3051":51194},[],"free external ports 80 and 443 on a single-node K3s host",{"_3582":126,"_31169":91,"_21582":51196,"_5":14829,"_28301":51097,"_3051":51197},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3582":127,"_31169":91,"_21582":51199,"_5":14829,"_28301":51097,"_3051":51200},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3582":128,"_31169":91,"_21582":51202,"_5":14829,"_28301":51100,"_3051":51203},[],"Run the script from a clone of the Helm repository:",{"_3582":129,"_31169":91,"_21582":51205,"_5":14829,"_28301":51100,"_3051":51206},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3582":130,"_31169":91,"_21582":51208,"_5":14829,"_28301":51104,"_3051":51209},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3582":131,"_31169":91,"_21582":51211,"_5":14829,"_28301":51104,"_3051":51212},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3582":132,"_31169":91,"_21582":51214,"_5":14829,"_28301":51104,"_3051":51215},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3582":133,"_31169":91,"_21582":51217,"_5":14829,"_28301":51104,"_3051":51218},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3582":134,"_31169":91,"_21582":51220,"_5":14829,"_28301":51108,"_3051":51221},[],"Option",{"_3582":135,"_31169":91,"_21582":51223,"_5":14829,"_28301":51108,"_3051":51224},[],"Default",{"_3582":136,"_31169":91,"_21582":51226,"_5":14829,"_28301":51108,"_3051":51227},[],"Purpose",{"_3582":137,"_31169":91,"_21582":51229,"_5":14829,"_28301":51108,"_3051":51230},[],"`-h`, `--help`",{"_3582":138,"_31169":91,"_21582":51232,"_5":14829,"_28301":51108,"_3051":51233},[],"—",{"_3582":139,"_31169":91,"_21582":51235,"_5":14829,"_28301":51108,"_3051":51236},[],"Show help",{"_3582":140,"_31169":91,"_21582":51238,"_5":14829,"_28301":51108,"_3051":51239},[],"`-c`, `--context`",{"_3582":141,"_31169":91,"_21582":51241,"_5":14829,"_28301":51108,"_3051":51242},[],"current context",{"_3582":142,"_31169":91,"_21582":51244,"_5":14829,"_28301":51108,"_3051":51245},[],"Select the kubeconfig context for kubectl and Helm",{"_3582":143,"_31169":91,"_21582":51247,"_5":14829,"_28301":51108,"_3051":51248},[],"`-n`, `--non-interactive`",{"_3582":144,"_31169":91,"_21582":51250,"_5":14829,"_28301":51108,"_3051":6810},[],{"_3582":145,"_31169":91,"_21582":51252,"_5":14829,"_28301":51108,"_3051":51253},[],"Skip prompts and generate dependency credentials",{"_3582":146,"_31169":91,"_21582":51255,"_5":14829,"_28301":51108,"_3051":51256},[],"`-ns`, `--namespace`",{"_3582":147,"_31169":91,"_21582":51258,"_5":14829,"_28301":51108,"_3051":51259},[],"`lamassu-dev`",{"_3582":148,"_31169":91,"_21582":51261,"_5":14829,"_28301":51108,"_3051":51262},[],"Namespace for the installation",{"_3582":149,"_31169":91,"_21582":51264,"_5":14829,"_28301":51108,"_3051":51265},[],"`-d`, `--domain`",{"_3582":150,"_31169":91,"_21582":51267,"_5":14829,"_28301":51108,"_3051":51268},[],"`dev.lamassu.io`",{"_3582":151,"_31169":91,"_21582":51270,"_5":14829,"_28301":51108,"_3051":51271},[],"Domain used by the UI, OIDC and certificate",{"_3582":152,"_31169":91,"_21582":51273,"_5":14829,"_28301":51108,"_3051":51274},[],"`-v`, `--version`",{"_3582":153,"_31169":91,"_21582":51276,"_5":14829,"_28301":51108,"_3051":15570},[],{"_3582":154,"_31169":91,"_21582":51278,"_5":14829,"_28301":51108,"_3051":51279},[],"Lamassu chart version",{"_3582":155,"_31169":91,"_21582":51281,"_5":14829,"_28301":51108,"_3051":51282},[],"`--https-port`",{"_3582":156,"_31169":91,"_21582":51284,"_5":14829,"_28301":51108,"_3051":51285},[],"`443`",{"_3582":157,"_31169":91,"_21582":51287,"_5":14829,"_28301":51108,"_3051":51288},[],"Gateway HTTPS listener port",{"_3582":158,"_31169":91,"_21582":51290,"_5":14829,"_28301":51108,"_3051":51291},[],"`--http-port`",{"_3582":159,"_31169":91,"_21582":51293,"_5":14829,"_28301":51108,"_3051":51294},[],"`80`",{"_3582":160,"_31169":91,"_21582":51296,"_5":14829,"_28301":51108,"_3051":51297},[],"Gateway HTTP listener port",{"_3582":161,"_31169":91,"_21582":51299,"_5":14829,"_28301":51108,"_3051":51300},[],"`--tls-crt`",{"_3582":162,"_31169":91,"_21582":51302,"_5":14829,"_28301":51108,"_3051":51233},[],{"_3582":163,"_31169":91,"_21582":51304,"_5":14829,"_28301":51108,"_3051":51305},[],"PEM certificate for downstream TLS",{"_3582":164,"_31169":91,"_21582":51307,"_5":14829,"_28301":51108,"_3051":51308},[],"`--tls-key`",{"_3582":165,"_31169":91,"_21582":51310,"_5":14829,"_28301":51108,"_3051":51233},[],{"_3582":166,"_31169":91,"_21582":51312,"_5":14829,"_28301":51108,"_3051":51313},[],"PEM private key for downstream TLS",{"_3582":167,"_31169":91,"_21582":51315,"_5":14829,"_28301":51108,"_3051":51316},[],"`-l`, `--local-chart-path`",{"_3582":168,"_31169":91,"_21582":51318,"_5":14829,"_28301":51108,"_3051":51319},[],"repository chart",{"_3582":169,"_31169":91,"_21582":51321,"_5":14829,"_28301":51108,"_3051":51322},[],"Use an unpacked local Lamassu chart",{"_3582":170,"_31169":91,"_21582":51324,"_5":14829,"_28301":51108,"_3051":51325},[],"`-ip`, `--gateway-ip`",{"_3582":171,"_31169":91,"_21582":51327,"_5":14829,"_28301":51108,"_3051":9062},[],{"_3582":172,"_31169":91,"_21582":51329,"_5":14829,"_28301":51108,"_3051":51330},[],"Override the address written to `gateway.addresses`",{"_3582":173,"_31169":91,"_21582":51332,"_5":14829,"_28301":51108,"_3051":51333},[],"`--otel`",{"_3582":174,"_31169":91,"_21582":51335,"_5":14829,"_28301":51108,"_3051":6810},[],{"_3582":175,"_31169":91,"_21582":51337,"_5":14829,"_28301":51108,"_3051":51338},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3582":176,"_31169":91,"_21582":51340,"_5":14829,"_28301":51108,"_3051":51341},[],"`--development`",{"_3582":177,"_31169":91,"_21582":51343,"_5":14829,"_28301":51108,"_3051":6810},[],{"_3582":178,"_31169":91,"_21582":51345,"_5":14829,"_28301":51108,"_3051":51346},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3582":179,"_31169":91,"_21582":51348,"_5":14829,"_28301":51108,"_3051":51349},[],"`--sample-data`",{"_3582":180,"_31169":91,"_21582":51351,"_5":14829,"_28301":51108,"_3051":6810},[],{"_3582":181,"_31169":91,"_21582":51353,"_5":14829,"_28301":51108,"_3051":51354},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3582":182,"_31169":91,"_21582":51356,"_5":14829,"_28301":51108,"_3051":51357},[],"`--with-hsm`",{"_3582":183,"_31169":91,"_21582":51359,"_5":14829,"_28301":51108,"_3051":6810},[],{"_3582":184,"_31169":91,"_21582":51361,"_5":14829,"_28301":51108,"_3051":51362},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3582":185,"_31169":91,"_21582":51364,"_5":14829,"_28301":51108,"_3051":51365},[],"`--softhsm-chart-path`",{"_3582":186,"_31169":91,"_21582":51367,"_5":14829,"_28301":51108,"_3051":51368},[],"`./charts/softhsm`",{"_3582":187,"_31169":91,"_21582":51370,"_5":14829,"_28301":51108,"_3051":51371},[],"Use a different local SoftHSM chart",{"_3582":188,"_31169":91,"_21582":51373,"_5":14829,"_28301":51108,"_3051":51374},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3582":189,"_31169":91,"_21582":51376,"_5":14829,"_28301":51112,"_3051":51377},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3582":190,"_31169":91,"_21582":51379,"_5":14829,"_28301":51112,"_3051":51380},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3582":191,"_31169":91,"_21582":51382,"_5":14829,"_28301":51112,"_3051":51383},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3582":192,"_31169":91,"_21582":51385,"_5":14829,"_28301":51112,"_3051":51386},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3582":193,"_31169":91,"_21582":51388,"_5":14829,"_28301":51112,"_3051":51389},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3582":194,"_31169":91,"_21582":51391,"_5":14829,"_28301":51112,"_3051":51392},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3582":195,"_31169":91,"_21582":51394,"_5":14829,"_28301":51116,"_3051":51395},[],"Fastlane:",{"_3582":196,"_31169":91,"_21582":51397,"_5":14829,"_28301":51116,"_3051":51398},[],"validates local tools and the selected cluster",{"_3582":197,"_31169":91,"_21582":51400,"_5":14829,"_28301":51116,"_3051":51401},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3582":198,"_31169":91,"_21582":51403,"_5":14829,"_28301":51116,"_3051":51404},[],"creates the namespace",{"_3582":199,"_31169":91,"_21582":51406,"_5":14829,"_28301":51116,"_3051":51407},[],"installs PostgreSQL and creates the required databases",{"_3582":200,"_31169":91,"_21582":51409,"_5":14829,"_28301":51116,"_3051":51410},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3582":201,"_31169":91,"_21582":51412,"_5":14829,"_28301":51116,"_3051":51413},[],"installs RabbitMQ",{"_3582":202,"_31169":91,"_21582":51415,"_5":14829,"_28301":51116,"_3051":51416},[],"optionally installs observability and lab HSM components",{"_3582":203,"_31169":91,"_21582":51418,"_5":14829,"_28301":51116,"_3051":51419},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3582":204,"_31169":91,"_21582":51421,"_5":14829,"_28301":51116,"_3051":51422},[],"optionally loads sample data",{"_3582":205,"_31169":91,"_21582":51424,"_5":14829,"_28301":51116,"_3051":51425},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3582":206,"_31169":91,"_21582":51427,"_5":14829,"_28301":51120,"_3051":51428},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3582":207,"_31169":91,"_21582":51430,"_5":14829,"_28301":51120,"_3051":51431},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3582":208,"_31169":91,"_21582":51433,"_5":14829,"_28301":51124,"_3051":51434},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3582":209,"_31169":91,"_21582":51436,"_5":14829,"_28301":51124,"_3051":51437},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3582":210,"_31169":91,"_21582":51439,"_5":14829,"_28301":51124,"_3051":51440},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3582":211,"_31169":91,"_21582":51442,"_5":14829,"_28301":51128,"_3051":51443},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3582":212,"_31169":212,"_5":15200,"_3051":51445,"_31527":51446,"_21582":51447,"_28301":212},"Install with Helm",[50837,50838,50944],[],{"_3582":213,"_31169":212,"_21582":51449,"_5":14829,"_28301":212,"_3051":51450},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3582":214,"_31169":212,"_5":31524,"_21582":51452,"_28301":51453,"_3051":51454},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3582":215,"_31169":212,"_5":31524,"_21582":51456,"_28301":51457,"_3051":50847},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#before-you-begin",{"_3582":216,"_31169":212,"_5":31524,"_21582":51459,"_28301":51460,"_3051":51461},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3582":217,"_31169":212,"_5":31524,"_21582":51463,"_28301":51464,"_3051":51465},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3582":218,"_31169":212,"_5":31524,"_21582":51467,"_28301":51468,"_3051":51469},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3582":219,"_31169":212,"_5":31524,"_21582":51471,"_28301":51472,"_3051":51473},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3582":220,"_31169":212,"_5":31524,"_21582":51475,"_28301":51476,"_3051":51477},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3582":221,"_31169":212,"_5":31524,"_21582":51479,"_28301":51480,"_3051":51481},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3582":222,"_31169":212,"_5":31524,"_21582":51483,"_28301":51484,"_3051":51485},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3582":223,"_31169":212,"_5":31524,"_21582":51487,"_28301":51488,"_3051":51489},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3582":224,"_31169":212,"_5":31524,"_21582":51491,"_28301":51492,"_3051":51493},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3582":225,"_31169":212,"_21582":51495,"_5":14829,"_28301":51453,"_3051":51496},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3582":226,"_31169":212,"_21582":51498,"_5":14829,"_28301":51457,"_3051":51499},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3582":227,"_31169":212,"_21582":51501,"_5":14829,"_28301":51457,"_3051":51502},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3582":228,"_31169":212,"_21582":51504,"_5":14829,"_28301":51457,"_3051":51505},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3582":229,"_31169":212,"_21582":51507,"_5":14829,"_28301":51457,"_3051":51508},[],"a reachable RabbitMQ broker and credentials",{"_3582":230,"_31169":212,"_21582":51510,"_5":14829,"_28301":51457,"_3051":51511},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3582":231,"_31169":212,"_21582":51513,"_5":14829,"_28301":51457,"_3051":51514},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3582":232,"_31169":212,"_21582":51516,"_5":14829,"_28301":51457,"_3051":51517},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3582":233,"_31169":212,"_21582":51519,"_5":14829,"_28301":51457,"_3051":51520},[],"a StorageClass and an external traffic design",{"_3582":234,"_31169":212,"_21582":51522,"_5":14829,"_28301":51457,"_3051":51523},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3582":235,"_31169":212,"_21582":51525,"_5":14829,"_28301":51457,"_3051":51526},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3582":236,"_31169":212,"_21582":51528,"_5":14829,"_28301":51457,"_3051":51529},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3582":237,"_31169":212,"_21582":51531,"_5":14829,"_28301":51460,"_3051":51532},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3582":238,"_31169":212,"_21582":51534,"_5":14829,"_28301":51460,"_3051":51535},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3582":239,"_31169":212,"_21582":51537,"_5":14829,"_28301":51460,"_3051":51538},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3582":240,"_31169":212,"_21582":51540,"_5":14829,"_28301":51464,"_3051":51541},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3582":241,"_31169":212,"_21582":51543,"_5":14829,"_28301":51464,"_3051":51544},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3582":242,"_31169":212,"_21582":51546,"_5":14829,"_28301":51464,"_3051":51547},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3582":243,"_31169":212,"_21582":51549,"_5":14829,"_28301":51464,"_3051":51550},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3582":244,"_31169":212,"_21582":51552,"_5":14829,"_28301":51468,"_3051":51553},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3582":245,"_31169":212,"_21582":51555,"_5":14829,"_28301":51472,"_3051":51556},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3582":246,"_31169":212,"_21582":51558,"_5":14829,"_28301":51472,"_3051":51559},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3582":247,"_31169":212,"_21582":51561,"_5":14829,"_28301":51472,"_3051":51562},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3582":248,"_31169":212,"_21582":51564,"_5":14829,"_28301":51472,"_3051":51565},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3582":249,"_31169":212,"_21582":51567,"_5":14829,"_28301":51472,"_3051":51568},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3582":250,"_31169":212,"_21582":51570,"_5":14829,"_28301":51472,"_3051":51571},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3582":251,"_31169":212,"_21582":51573,"_5":14829,"_28301":51472,"_3051":51574},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3582":252,"_31169":212,"_21582":51576,"_5":14829,"_28301":51476,"_3051":51577},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3582":253,"_31169":212,"_21582":51579,"_5":14829,"_28301":51476,"_3051":51580},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3582":254,"_31169":212,"_21582":51582,"_5":14829,"_28301":51476,"_3051":51583},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3582":255,"_31169":212,"_21582":51585,"_5":14829,"_28301":51476,"_3051":51586},[],"See Access control for the principal and policy model.",{"_3582":256,"_31169":212,"_21582":51588,"_5":14829,"_28301":51480,"_3051":51589},[],"To install a local checkout instead:",{"_3582":257,"_31169":212,"_21582":51591,"_5":14829,"_28301":51484,"_3051":51592},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3582":258,"_31169":212,"_21582":51594,"_5":14829,"_28301":51484,"_3051":51595},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3582":259,"_31169":212,"_21582":51597,"_5":14829,"_28301":51488,"_3051":51598},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3582":260,"_31169":212,"_21582":51600,"_5":14829,"_28301":51488,"_3051":51601},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3582":261,"_31169":212,"_21582":51603,"_5":14829,"_28301":51488,"_3051":51604},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3582":262,"_31169":212,"_21582":51606,"_5":14829,"_28301":51488,"_3051":51607},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3582":263,"_31169":212,"_21582":51609,"_5":14829,"_28301":51488,"_3051":51610},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3582":264,"_31169":212,"_21582":51612,"_5":14829,"_28301":51492,"_3051":51613},[],"Before going live, review:",{"_3582":265,"_31169":212,"_21582":51615,"_5":14829,"_28301":51492,"_3051":51616},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3582":266,"_31169":212,"_21582":51618,"_5":14829,"_28301":51492,"_3051":51619},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3582":267,"_31169":212,"_21582":51621,"_5":14829,"_28301":51492,"_3051":51622},[],"shared VA storage before increasing VA replicas",{"_3582":268,"_31169":212,"_21582":51624,"_5":14829,"_28301":51492,"_3051":51625},[],"managed OIDC roles and removal of evaluation credentials",{"_3582":269,"_31169":212,"_21582":51627,"_5":14829,"_28301":51492,"_3051":51628},[],"a trusted TLS issuer or externally managed certificate",{"_3582":270,"_31169":212,"_21582":51630,"_5":14829,"_28301":51492,"_3051":51631},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3582":271,"_31169":212,"_21582":51633,"_5":14829,"_28301":51492,"_3051":51634},[],"SMTP, observability and alert delivery",{"_3582":272,"_31169":212,"_21582":51636,"_5":14829,"_28301":51492,"_3051":51637},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3582":273,"_31169":212,"_21582":51639,"_5":14829,"_28301":51492,"_3051":51640},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3582":274,"_31169":274,"_5":15200,"_3051":51642,"_31527":51643,"_21582":51644,"_28301":274},"Expose the Gateway",[50837,50838,50944],[],{"_3582":275,"_31169":274,"_21582":51646,"_5":14829,"_28301":274,"_3051":51647},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3582":276,"_31169":274,"_5":31524,"_21582":51649,"_28301":51650,"_3051":51651},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3582":277,"_31169":274,"_5":31524,"_21582":51653,"_28301":51654,"_3051":51655},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3582":278,"_31169":274,"_5":31524,"_21582":51657,"_28301":51658,"_3051":51659},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3582":279,"_31169":274,"_5":31524,"_21582":51661,"_28301":51662,"_3051":51663},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#k3s","K3s",{"_3582":280,"_31169":274,"_5":31524,"_21582":51665,"_28301":51666,"_3051":51667},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3582":281,"_31169":274,"_5":31524,"_21582":51669,"_28301":51670,"_3051":51671},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3582":282,"_31169":274,"_5":31524,"_21582":51673,"_28301":51674,"_3051":51675},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3582":283,"_31169":274,"_5":31524,"_21582":51677,"_28301":51678,"_3051":51679},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3582":284,"_31169":274,"_5":31524,"_21582":51681,"_28301":51682,"_3051":51683},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3582":285,"_31169":274,"_5":31524,"_21582":51685,"_28301":51686,"_3051":51687},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3582":286,"_31169":274,"_5":31524,"_21582":51689,"_28301":51690,"_3051":51691},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3582":287,"_31169":274,"_21582":51693,"_5":14829,"_28301":51650,"_3051":51694},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3582":288,"_31169":274,"_21582":51696,"_5":14829,"_28301":51650,"_3051":51697},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3582":289,"_31169":274,"_21582":51699,"_5":14829,"_28301":51654,"_3051":51700},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3582":290,"_31169":274,"_21582":51702,"_5":14829,"_28301":51654,"_3051":51703},[],"Set it only when:",{"_3582":291,"_31169":274,"_21582":51705,"_5":14829,"_28301":51654,"_3051":51706},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3582":292,"_31169":274,"_21582":51708,"_5":14829,"_28301":51654,"_3051":51709},[],"that address is allocated to this Gateway",{"_3582":293,"_31169":274,"_21582":51711,"_5":14829,"_28301":51654,"_3051":51712},[],"the surrounding network already routes traffic for it to the cluster",{"_3582":294,"_31169":274,"_21582":51714,"_5":14829,"_28301":51654,"_3051":51715},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3582":295,"_31169":274,"_21582":51717,"_5":14829,"_28301":51654,"_3051":51718},[],"Keep these two settings separate:",{"_3582":296,"_31169":274,"_21582":51720,"_5":14829,"_28301":51654,"_3051":51721},[],"`gateway.addresses` requests an address for the Gateway.",{"_3582":297,"_31169":274,"_21582":51723,"_5":14829,"_28301":51654,"_3051":51724},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3582":298,"_31169":274,"_21582":51726,"_5":14829,"_28301":51654,"_3051":51727},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3582":299,"_31169":274,"_21582":51729,"_5":14829,"_28301":51658,"_3051":51730},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3582":300,"_31169":274,"_21582":51732,"_5":14829,"_28301":51658,"_3051":51733},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3582":301,"_31169":274,"_21582":51735,"_5":14829,"_28301":51662,"_3051":51736},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3582":302,"_31169":274,"_21582":51738,"_5":14829,"_28301":51662,"_3051":51739},[],"For the recommended design:",{"_3582":303,"_31169":274,"_21582":51741,"_5":14829,"_28301":51662,"_3051":51742},[],"Use only one externally exposed Lamassu Gateway.",{"_3582":304,"_31169":274,"_21582":51744,"_5":14829,"_28301":51662,"_3051":51745},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3582":305,"_31169":274,"_21582":51747,"_5":14829,"_28301":51662,"_3051":51748},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3582":306,"_31169":274,"_21582":51750,"_5":14829,"_28301":51662,"_3051":51751},[],"Point DNS at the VM's reachable address.",{"_3582":307,"_31169":274,"_21582":51753,"_5":14829,"_28301":51662,"_3051":51754},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3582":308,"_31169":274,"_21582":51756,"_5":14829,"_28301":51666,"_3051":51757},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3582":309,"_31169":274,"_21582":51759,"_5":14829,"_28301":51670,"_3051":51760},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3582":310,"_31169":274,"_21582":51762,"_5":14829,"_28301":51670,"_3051":51763},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3582":311,"_31169":274,"_21582":51765,"_5":14829,"_28301":51674,"_3051":51766},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3582":312,"_31169":274,"_21582":51768,"_5":14829,"_28301":51674,"_3051":51769},[],"Requirement",{"_3582":313,"_31169":274,"_21582":51771,"_5":14829,"_28301":51674,"_3051":51772},[],"Recommended design",{"_3582":314,"_31169":274,"_21582":51774,"_5":14829,"_28301":51674,"_3051":51775},[],"Consequence",{"_3582":315,"_31169":274,"_21582":51777,"_5":14829,"_28301":51674,"_3051":51778},[],"Several Lamassu URLs or services",{"_3582":316,"_31169":274,"_21582":51780,"_5":14829,"_28301":51674,"_3051":51781},[],"One Gateway with multiple routes",{"_3582":317,"_31169":274,"_21582":51783,"_5":14829,"_28301":51674,"_3051":51784},[],"One IP and one proxy fleet; this is the chart default",{"_3582":318,"_31169":274,"_21582":51786,"_5":14829,"_28301":51674,"_3051":51787},[],"Independent Gateways and separate external IPs",{"_3582":319,"_31169":274,"_21582":51789,"_5":14829,"_28301":51674,"_3051":51790},[],"One VIP per Gateway",{"_3582":320,"_31169":274,"_21582":51792,"_5":14829,"_28301":51674,"_3051":51793},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3582":321,"_31169":274,"_21582":51795,"_5":14829,"_28301":51674,"_3051":51796},[],"Independent Gateways on one node and one IP",{"_3582":322,"_31169":274,"_21582":51798,"_5":14829,"_28301":51674,"_3051":51799},[],"Use different external ports",{"_3582":323,"_31169":274,"_21582":51801,"_5":14829,"_28301":51674,"_3051":51802},[],"Clients must include non-standard ports",{"_3582":324,"_31169":274,"_21582":51804,"_5":14829,"_28301":51674,"_3051":51805},[],"Separate TLS/mTLS termination behind one IP",{"_3582":325,"_31169":274,"_21582":51807,"_5":14829,"_28301":51674,"_3051":51808},[],"Front-door SNI routing to internal Gateways",{"_3582":326,"_31169":274,"_21582":51810,"_5":14829,"_28301":51674,"_3051":51811},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3582":327,"_31169":274,"_21582":51813,"_5":14829,"_28301":51674,"_3051":51814},[],"Separate Gateway resources but shared proxy infrastructure",{"_3582":328,"_31169":274,"_21582":51816,"_5":14829,"_28301":51674,"_3051":51817},[],"Envoy merged-Gateway mode",{"_3582":329,"_31169":274,"_21582":51819,"_5":14829,"_28301":51674,"_3051":51820},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3582":330,"_31169":274,"_21582":51822,"_5":14829,"_28301":51674,"_3051":51823},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3582":331,"_31169":274,"_21582":51825,"_5":14829,"_28301":51674,"_3051":51826},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3582":332,"_31169":274,"_21582":51828,"_5":14829,"_28301":51674,"_3051":51829},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3582":333,"_31169":274,"_21582":51831,"_5":14829,"_28301":51674,"_3051":51832},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3582":334,"_31169":274,"_21582":51834,"_5":14829,"_28301":51678,"_3051":51835},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3582":335,"_31169":274,"_21582":51837,"_5":14829,"_28301":51682,"_3051":51838},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3582":336,"_31169":274,"_21582":51840,"_5":14829,"_28301":51682,"_3051":51841},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3582":337,"_31169":274,"_21582":51843,"_5":14829,"_28301":51682,"_3051":51844},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3582":338,"_31169":274,"_21582":51846,"_5":14829,"_28301":51682,"_3051":51847},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3582":339,"_31169":274,"_21582":51849,"_5":14829,"_28301":51682,"_3051":51850},[],"If none of those are possible, use different external ports or change the external network design.",{"_3582":340,"_31169":274,"_21582":51852,"_5":14829,"_28301":51686,"_3051":51853},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3582":341,"_31169":274,"_21582":51855,"_5":14829,"_28301":51686,"_3051":51856},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3582":342,"_31169":274,"_21582":51858,"_5":14829,"_28301":51690,"_3051":51859},[],"Check, in order:",{"_3582":343,"_31169":274,"_21582":51861,"_5":14829,"_28301":51690,"_3051":51862},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3582":344,"_31169":274,"_21582":51864,"_5":14829,"_28301":51690,"_3051":51865},[],"Its status contains the expected address.",{"_3582":345,"_31169":274,"_21582":51867,"_5":14829,"_28301":51690,"_3051":51868},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3582":346,"_31169":274,"_21582":51870,"_5":14829,"_28301":51690,"_3051":51871},[],"Port 443 reaches that address from the client network.",{"_3582":347,"_31169":274,"_21582":51873,"_5":14829,"_28301":51690,"_3051":51874},[],"DNS resolves to the externally reachable endpoint.",{"_3582":348,"_31169":274,"_21582":51876,"_5":14829,"_28301":51690,"_3051":51877},[],"The certificate contains the DNS name or IP used by the client.",{"_3582":349,"_31169":274,"_21582":51879,"_5":14829,"_28301":51690,"_3051":51880},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3582":350,"_31169":350,"_5":15200,"_3051":50944,"_31527":51882,"_21582":51883,"_28301":350},[50837,50838,50944],[],{"_3582":351,"_31169":350,"_21582":51885,"_5":14829,"_28301":350,"_3051":51886},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3582":352,"_31169":350,"_5":31524,"_21582":51888,"_28301":51889,"_3051":51890},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3582":353,"_31169":350,"_5":31524,"_21582":51892,"_28301":51893,"_3051":51894},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3582":354,"_31169":350,"_5":31524,"_21582":51896,"_28301":51897,"_3051":51898},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3582":355,"_31169":350,"_5":31524,"_21582":51900,"_28301":51901,"_3051":51902},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3582":356,"_31169":350,"_5":31524,"_21582":51904,"_28301":51905,"_3051":51906},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3582":357,"_31169":350,"_5":31524,"_21582":51908,"_28301":51909,"_3051":51910},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3582":358,"_31169":350,"_21582":51912,"_5":14829,"_28301":51889,"_3051":51913},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3582":359,"_31169":350,"_21582":51915,"_5":14829,"_28301":51893,"_3051":51916},[],"Workflow",{"_3582":360,"_31169":350,"_21582":51918,"_5":14829,"_28301":51893,"_3051":51919},[],"Use it for",{"_3582":361,"_31169":350,"_21582":51921,"_5":14829,"_28301":51893,"_3051":51922},[],"What it installs",{"_3582":362,"_31169":350,"_21582":51924,"_5":14829,"_28301":51893,"_3051":51925},[],"Helm",{"_3582":363,"_31169":350,"_21582":51927,"_5":14829,"_28301":51893,"_3051":51928},[],"Production and controlled environments",{"_3582":364,"_31169":350,"_21582":51930,"_5":14829,"_28301":51893,"_3051":51931},[],"Lamassu services and Gateway API resources",{"_3582":365,"_31169":350,"_21582":51933,"_5":14829,"_28301":51893,"_3051":51081},[],{"_3582":366,"_31169":350,"_21582":51935,"_5":14829,"_28301":51893,"_3051":51936},[],"Evaluation, demos, CI and small lab clusters",{"_3582":367,"_31169":350,"_21582":51938,"_5":14829,"_28301":51893,"_3051":51939},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3582":368,"_31169":350,"_21582":51941,"_5":14829,"_28301":51897,"_3051":51942},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3582":369,"_31169":350,"_21582":51944,"_5":14829,"_28301":51897,"_3051":51945},[],"Area",{"_3582":370,"_31169":350,"_21582":51947,"_5":14829,"_28301":51897,"_3051":51948},[],"The Lamassu chart provides",{"_3582":371,"_31169":350,"_21582":51950,"_5":14829,"_28301":51897,"_3051":51951},[],"You provide",{"_3582":372,"_31169":350,"_21582":51953,"_5":14829,"_28301":51897,"_3051":51954},[],"Lamassu applications",{"_3582":373,"_31169":350,"_21582":51956,"_5":14829,"_28301":51897,"_3051":51957},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3582":374,"_31169":350,"_21582":51959,"_5":14829,"_28301":51897,"_3051":51960},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3582":375,"_31169":350,"_21582":51962,"_5":14829,"_28301":51897,"_3051":51963},[],"PostgreSQL data",{"_3582":376,"_31169":350,"_21582":51965,"_5":14829,"_28301":51897,"_3051":51966},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3582":377,"_31169":350,"_21582":51968,"_5":14829,"_28301":51897,"_3051":51969},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3582":378,"_31169":350,"_21582":51971,"_5":14829,"_28301":51897,"_3051":51972},[],"Messaging",{"_3582":379,"_31169":350,"_21582":51974,"_5":14829,"_28301":51897,"_3051":51975},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3582":380,"_31169":350,"_21582":51977,"_5":14829,"_28301":51897,"_3051":51978},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3582":381,"_31169":350,"_21582":51980,"_5":14829,"_28301":51897,"_3051":51981},[],"Identity",{"_3582":382,"_31169":350,"_21582":51983,"_5":14829,"_28301":51897,"_3051":51984},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3582":383,"_31169":350,"_21582":51986,"_5":14829,"_28301":51897,"_3051":51987},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3582":384,"_31169":350,"_21582":51989,"_5":14829,"_28301":51897,"_3051":51990},[],"External routing",{"_3582":385,"_31169":350,"_21582":51992,"_5":14829,"_28301":51897,"_3051":51993},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3582":386,"_31169":350,"_21582":51995,"_5":14829,"_28301":51897,"_3051":51996},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3582":387,"_31169":350,"_21582":51998,"_5":14829,"_28301":51897,"_3051":51999},[],"TLS",{"_3582":388,"_31169":350,"_21582":52001,"_5":14829,"_28301":51897,"_3051":52002},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3582":389,"_31169":350,"_21582":52004,"_5":14829,"_28301":51897,"_3051":52005},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3582":390,"_31169":350,"_21582":52007,"_5":14829,"_28301":51897,"_3051":52008},[],"Persistent application data",{"_3582":391,"_31169":350,"_21582":52010,"_5":14829,"_28301":51897,"_3051":52011},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3582":392,"_31169":350,"_21582":52013,"_5":14829,"_28301":51897,"_3051":52014},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3582":393,"_31169":350,"_21582":52016,"_5":14829,"_28301":51897,"_3051":52017},[],"Optional integrations",{"_3582":394,"_31169":350,"_21582":52019,"_5":14829,"_28301":51897,"_3051":52020},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3582":395,"_31169":350,"_21582":52022,"_5":14829,"_28301":51897,"_3051":52023},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3582":396,"_31169":350,"_21582":52025,"_5":14829,"_28301":51897,"_3051":52026},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3582":397,"_31169":350,"_21582":52028,"_5":14829,"_28301":51897,"_3051":52029},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3582":398,"_31169":350,"_21582":52031,"_5":14829,"_28301":51901,"_3051":52032},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3582":399,"_31169":350,"_21582":52034,"_5":14829,"_28301":51901,"_3051":52035},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3582":400,"_31169":350,"_21582":52037,"_5":14829,"_28301":51905,"_3051":52038},[],"Kubernetes 1.24 or newer",{"_3582":401,"_31169":350,"_21582":52040,"_5":14829,"_28301":51905,"_3051":52041},[],"Helm 3.2 or newer",{"_3582":402,"_31169":350,"_21582":52043,"_5":14829,"_28301":51905,"_3051":52044},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3582":403,"_31169":350,"_21582":52046,"_5":14829,"_28301":51905,"_3051":52047},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3582":404,"_31169":350,"_21582":52049,"_5":14829,"_28301":51905,"_3051":52050},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3582":405,"_31169":350,"_21582":52052,"_5":14829,"_28301":51905,"_3051":52053},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3582":406,"_31169":350,"_21582":52055,"_5":14829,"_28301":51905,"_3051":52056},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3582":407,"_31169":350,"_21582":52058,"_5":14829,"_28301":51909,"_3051":52059},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3582":408,"_31169":350,"_21582":52061,"_5":14829,"_28301":51909,"_3051":52062},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3582":409,"_31169":350,"_21582":52064,"_5":14829,"_28301":51909,"_3051":52065},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3582":410,"_31169":350,"_21582":52067,"_5":14829,"_28301":51909,"_3051":52068},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3582":411,"_31169":411,"_5":15200,"_3051":52070,"_31527":52071,"_21582":52073,"_28301":411},"Deployment troubleshooting",[50837,50838,52072],"Operations",[],{"_3582":412,"_31169":411,"_21582":52075,"_5":14829,"_28301":411,"_3051":52076},[],"Diagnose access, service health and infrastructure dependencies.",{"_3582":413,"_31169":411,"_5":31524,"_21582":52078,"_28301":52079,"_3051":52080},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3582":414,"_31169":411,"_5":31524,"_21582":52082,"_28301":52083,"_3051":52084},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3582":415,"_31169":411,"_5":31524,"_21582":52086,"_28301":52087,"_3051":52088},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3582":416,"_31169":411,"_5":31524,"_21582":52090,"_28301":52091,"_3051":52092},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3582":417,"_31169":411,"_5":31524,"_21582":52094,"_28301":52095,"_3051":52096},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3582":418,"_31169":411,"_5":31524,"_21582":52098,"_28301":52099,"_3051":52100},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3582":419,"_31169":411,"_5":31524,"_21582":52102,"_28301":52103,"_3051":52104},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3582":420,"_31169":411,"_5":31524,"_21582":52106,"_28301":52107,"_3051":52108},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3582":421,"_31169":411,"_5":31524,"_21582":52110,"_28301":52111,"_3051":52112},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3582":422,"_31169":411,"_5":31524,"_21582":52114,"_28301":52115,"_3051":52116},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3582":423,"_31169":411,"_5":31524,"_21582":52118,"_28301":52119,"_3051":52120},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3582":424,"_31169":411,"_5":31524,"_21582":52122,"_28301":52123,"_3051":52124},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3582":425,"_31169":411,"_5":31524,"_21582":52126,"_28301":52127,"_3051":52128},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#observability","Observability",{"_3582":426,"_31169":411,"_21582":52130,"_5":14829,"_28301":411,"_3051":52131},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3582":427,"_31169":411,"_21582":52133,"_5":14829,"_28301":52083,"_3051":52134},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3582":428,"_31169":411,"_21582":52136,"_5":14829,"_28301":52087,"_3051":52137},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3582":429,"_31169":411,"_21582":52139,"_5":14829,"_28301":52091,"_3051":52140},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3582":430,"_31169":411,"_21582":52142,"_5":14829,"_28301":52095,"_3051":52143},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3582":431,"_31169":411,"_21582":52145,"_5":14829,"_28301":52099,"_3051":52146},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3582":432,"_31169":411,"_21582":52148,"_5":14829,"_28301":52103,"_3051":52149},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3582":433,"_31169":411,"_21582":52151,"_5":14829,"_28301":52103,"_3051":52152},[],"Also run the chart's connectivity test:",{"_3582":434,"_31169":411,"_21582":52154,"_5":14829,"_28301":52103,"_3051":52155},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3582":435,"_31169":411,"_21582":52157,"_5":14829,"_28301":52103,"_3051":52158},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3582":436,"_31169":411,"_21582":52160,"_5":14829,"_28301":52107,"_3051":52161},[],"If you receive a 401:",{"_3582":437,"_31169":411,"_21582":52163,"_5":14829,"_28301":52107,"_3051":52164},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3582":438,"_31169":411,"_21582":52166,"_5":14829,"_28301":52107,"_3051":52167},[],"verify issuer, audience and expiration of the token;",{"_3582":439,"_31169":411,"_21582":52169,"_5":14829,"_28301":52107,"_3051":52170},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3582":440,"_31169":411,"_21582":52172,"_5":14829,"_28301":52107,"_3051":52173},[],"check that the provider's public and internal routes point to the same realm.",{"_3582":441,"_31169":411,"_21582":52175,"_5":14829,"_28301":52107,"_3051":52176},[],"If login succeeds but the APIs return 403:",{"_3582":442,"_31169":411,"_21582":52178,"_5":14829,"_28301":52107,"_3051":52179},[],"inspect the token's real claims;",{"_3582":443,"_31169":411,"_21582":52181,"_5":14829,"_28301":52107,"_3051":52182},[],"confirm they match an active principal;",{"_3582":444,"_31169":411,"_21582":52184,"_5":14829,"_28301":52107,"_3051":52185},[],"review the policies granted to that principal;",{"_3582":445,"_31169":411,"_21582":52187,"_5":14829,"_28301":52107,"_3051":52188},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3582":446,"_31169":411,"_21582":52190,"_5":14829,"_28301":52107,"_3051":52191},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3582":447,"_31169":411,"_21582":52193,"_5":14829,"_28301":52111,"_3051":52194},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3582":448,"_31169":411,"_21582":52196,"_5":14829,"_28301":52111,"_3051":52197},[],"Locate the authz pod and Service.",{"_3582":449,"_31169":411,"_21582":52199,"_5":14829,"_28301":52111,"_3051":52200},[],"Check /health, logs and its database connection.",{"_3582":450,"_31169":411,"_21582":52202,"_5":14829,"_28301":52111,"_3051":52203},[],"Verify the DNS and port configured in externalAuthorization.",{"_3582":451,"_31169":411,"_21582":52205,"_5":14829,"_28301":52111,"_3051":52206},[],"Check the check route is /v1/ext\\_authz/check.",{"_3582":452,"_31169":411,"_21582":52208,"_5":14829,"_28301":52111,"_3051":52209},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3582":453,"_31169":411,"_21582":52211,"_5":14829,"_28301":52115,"_3051":52212},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3582":454,"_31169":411,"_21582":52214,"_5":14829,"_28301":52119,"_3051":52215},[],"Review kubectl describe pod first. Common causes are:",{"_3582":455,"_31169":411,"_21582":52217,"_5":14829,"_28301":52119,"_3051":52218},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3582":456,"_31169":411,"_21582":52220,"_5":14829,"_28301":52119,"_3051":52221},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3582":457,"_31169":411,"_21582":52223,"_5":14829,"_28301":52119,"_3051":52224},[],"unbound persistent volume;",{"_3582":458,"_31169":411,"_21582":52226,"_5":14829,"_28301":52119,"_3051":52227},[],"inaccessible image or incorrect pull policy;",{"_3582":459,"_31169":411,"_21582":52229,"_5":14829,"_28301":52119,"_3051":52230},[],"invalid cryptographic engine configuration;",{"_3582":460,"_31169":411,"_21582":52232,"_5":14829,"_28301":52119,"_3051":52233},[],"CPU or memory limits set too low;",{"_3582":461,"_31169":411,"_21582":52235,"_5":14829,"_28301":52119,"_3051":52236},[],"an incomplete prior migration.",{"_3582":462,"_31169":411,"_21582":52238,"_5":14829,"_28301":52119,"_3051":52239},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3582":463,"_31169":411,"_21582":52241,"_5":14829,"_28301":52119,"_3051":52242},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3582":464,"_31169":411,"_21582":52244,"_5":14829,"_28301":52119,"_3051":52245},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3582":465,"_31169":411,"_21582":52247,"_5":14829,"_28301":52123,"_3051":52248},[],"Domain and audit events depend on the bus publisher:",{"_3582":466,"_31169":411,"_21582":52250,"_5":14829,"_28301":52123,"_3051":52251},[],"verify it is enabled in the emitting service;",{"_3582":467,"_31169":411,"_21582":52253,"_5":14829,"_28301":52123,"_3051":52254},[],"check AMQP connectivity and credentials;",{"_3582":468,"_31169":411,"_21582":52256,"_5":14829,"_28301":52123,"_3051":52257},[],"review exchange, routing key, queues and consumers;",{"_3582":469,"_31169":411,"_21582":52259,"_5":14829,"_28301":52123,"_3051":52260},[],"inspect dead-letter queues;",{"_3582":470,"_31169":411,"_21582":52262,"_5":14829,"_28301":52123,"_3051":52263},[],"alert on orphan durable queues and backlog growth.",{"_3582":471,"_31169":411,"_21582":52265,"_5":14829,"_28301":52123,"_3051":52266},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3582":472,"_31169":411,"_21582":52268,"_5":14829,"_28301":52123,"_3051":52269},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3582":473,"_31169":411,"_21582":52271,"_5":14829,"_28301":52123,"_3051":52272},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3582":474,"_31169":411,"_21582":52274,"_5":14829,"_28301":52123,"_3051":52275},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3582":475,"_31169":411,"_21582":52277,"_5":14829,"_28301":52123,"_3051":52278},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3582":476,"_31169":411,"_21582":52280,"_5":14829,"_28301":52123,"_3051":52281},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3582":477,"_31169":411,"_21582":52283,"_5":14829,"_28301":52123,"_3051":52284},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3582":478,"_31169":411,"_21582":52286,"_5":14829,"_28301":52127,"_3051":52287},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3582":479,"_31169":411,"_21582":52289,"_5":14829,"_28301":52127,"_3051":52290},[],"Before closing an incident, record:",{"_3582":480,"_31169":411,"_21582":52292,"_5":14829,"_28301":52127,"_3051":52293},[],"the confirmed cause;",{"_3582":481,"_31169":411,"_21582":52295,"_5":14829,"_28301":52127,"_3051":52296},[],"the time scope and affected resources;",{"_3582":482,"_31169":411,"_21582":52298,"_5":14829,"_28301":52127,"_3051":52299},[],"the commands or queries used;",{"_3582":483,"_31169":411,"_21582":52301,"_5":14829,"_28301":52127,"_3051":52302},[],"the applied change and how to revert it;",{"_3582":484,"_31169":411,"_21582":52304,"_5":14829,"_28301":52127,"_3051":52305},[],"validation from a consumer;",{"_3582":485,"_31169":411,"_21582":52307,"_5":14829,"_28301":52127,"_3051":52308},[],"the preventive action and its owner.",{"_3582":486,"_31169":486,"_5":15200,"_3051":52310,"_31527":52311,"_21582":52314,"_28301":486},"Access control",[50837,52312,52313],"Platform","Administration",[],{"_3582":487,"_31169":486,"_21582":52316,"_5":14829,"_28301":486,"_3051":52317},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3582":488,"_31169":486,"_5":31524,"_21582":52319,"_28301":52320,"_3051":52321},[],"/docs/pr-preview/pr-61/platform/administration/access-control#essential-concepts","Essential concepts",{"_3582":489,"_31169":486,"_5":31524,"_21582":52323,"_28301":52324,"_3051":52325},[],"/docs/pr-preview/pr-61/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3582":490,"_31169":486,"_5":31524,"_21582":52327,"_28301":52328,"_3051":52329},[],"/docs/pr-preview/pr-61/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3582":491,"_31169":486,"_5":31524,"_21582":52331,"_28301":52332,"_3051":52333},[],"/docs/pr-preview/pr-61/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3582":492,"_31169":486,"_5":31524,"_21582":52335,"_28301":52336,"_3051":52337},[],"/docs/pr-preview/pr-61/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3582":493,"_31169":486,"_5":31524,"_21582":52339,"_28301":52340,"_3051":52341},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3582":494,"_31169":486,"_5":31524,"_21582":52343,"_28301":52344,"_3051":52345},[],"/docs/pr-preview/pr-61/platform/administration/access-control#oidc-principals","OIDC principals",{"_3582":495,"_31169":486,"_5":31524,"_21582":52347,"_28301":52348,"_3051":52349},[],"/docs/pr-preview/pr-61/platform/administration/access-control#x509-principals","X.509 principals",{"_3582":496,"_31169":486,"_5":31524,"_21582":52351,"_28301":52352,"_3051":52353},[],"/docs/pr-preview/pr-61/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3582":497,"_31169":486,"_5":31524,"_21582":52355,"_28301":52356,"_3051":52357},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3582":498,"_31169":486,"_5":31524,"_21582":52359,"_28301":52360,"_3051":52361},[],"/docs/pr-preview/pr-61/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3582":499,"_31169":486,"_5":31524,"_21582":52363,"_28301":52364,"_3051":52365},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3582":500,"_31169":486,"_5":31524,"_21582":52367,"_28301":52368,"_3051":52369},[],"/docs/pr-preview/pr-61/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3582":501,"_31169":486,"_5":31524,"_21582":52371,"_28301":52372,"_3051":52373},[],"/docs/pr-preview/pr-61/platform/administration/access-control#http-rules","HTTP rules",{"_3582":502,"_31169":486,"_5":31524,"_21582":52375,"_28301":52376,"_3051":52377},[],"/docs/pr-preview/pr-61/platform/administration/access-control#included-policies","Included policies",{"_3582":503,"_31169":486,"_5":31524,"_21582":52379,"_28301":52380,"_3051":51477},[],"/docs/pr-preview/pr-61/platform/administration/access-control#provision-the-first-administrator",{"_3582":504,"_31169":486,"_5":31524,"_21582":52382,"_28301":52383,"_3051":52384},[],"/docs/pr-preview/pr-61/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3582":505,"_31169":486,"_5":31524,"_21582":52386,"_28301":52387,"_3051":52388},[],"/docs/pr-preview/pr-61/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3582":506,"_31169":486,"_5":31524,"_21582":52390,"_28301":52391,"_3051":52392},[],"/docs/pr-preview/pr-61/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3582":507,"_31169":486,"_5":31524,"_21582":52394,"_28301":52395,"_3051":52396},[],"/docs/pr-preview/pr-61/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3582":508,"_31169":486,"_5":31524,"_21582":52398,"_28301":52399,"_3051":52400},[],"/docs/pr-preview/pr-61/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3582":509,"_31169":486,"_5":31524,"_21582":52402,"_28301":52403,"_3051":52404},[],"/docs/pr-preview/pr-61/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3582":510,"_31169":486,"_5":31524,"_21582":52406,"_28301":52407,"_3051":52408},[],"/docs/pr-preview/pr-61/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3582":511,"_31169":486,"_5":31524,"_21582":52410,"_28301":52411,"_3051":52412},[],"/docs/pr-preview/pr-61/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3582":512,"_31169":486,"_5":31524,"_21582":52414,"_28301":52415,"_3051":52416},[],"/docs/pr-preview/pr-61/platform/administration/access-control#operational-checklist","Operational checklist",{"_3582":513,"_31169":486,"_5":31524,"_21582":52418,"_28301":52419,"_3051":52420},[],"/docs/pr-preview/pr-61/platform/administration/access-control#diagnostics","Diagnostics",{"_3582":514,"_31169":486,"_5":31524,"_21582":52422,"_28301":52423,"_3051":52424},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-401","The response is 401",{"_3582":515,"_31169":486,"_5":31524,"_21582":52426,"_28301":52427,"_3051":52428},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-403","The response is 403",{"_3582":516,"_31169":486,"_5":31524,"_21582":52430,"_28301":52431,"_3051":52432},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3582":517,"_31169":486,"_5":31524,"_21582":52434,"_28301":52435,"_3051":52436},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3582":518,"_31169":486,"_5":31524,"_21582":52438,"_28301":52439,"_3051":52440},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3582":519,"_31169":486,"_21582":52442,"_5":14829,"_28301":486,"_3051":52443},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3582":520,"_31169":486,"_21582":52445,"_5":14829,"_28301":486,"_3051":52446},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3582":521,"_31169":486,"_21582":52448,"_5":14829,"_28301":486,"_3051":52449},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3582":522,"_31169":486,"_21582":52451,"_5":14829,"_28301":52320,"_3051":52452},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3582":523,"_31169":486,"_21582":52454,"_5":14829,"_28301":52320,"_3051":52455},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3582":524,"_31169":486,"_21582":52457,"_5":14829,"_28301":52320,"_3051":52458},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3582":525,"_31169":486,"_21582":52460,"_5":14829,"_28301":52320,"_3051":52461},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3582":526,"_31169":486,"_21582":52463,"_5":14829,"_28301":52320,"_3051":52464},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3582":527,"_31169":486,"_21582":52466,"_5":14829,"_28301":52320,"_3051":52467},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3582":528,"_31169":486,"_21582":52469,"_5":14829,"_28301":52324,"_3051":52470},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3582":529,"_31169":486,"_21582":52472,"_5":14829,"_28301":52324,"_3051":52473},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3582":530,"_31169":486,"_21582":52475,"_5":14829,"_28301":52328,"_3051":52476},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3582":531,"_31169":486,"_21582":52478,"_5":14829,"_28301":52328,"_3051":52479},[],"The decision is made **before forwarding the request to the service**:",{"_3582":532,"_31169":486,"_21582":52481,"_5":14829,"_28301":52328,"_3051":52482},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3582":533,"_31169":486,"_21582":52484,"_5":14829,"_28301":52328,"_3051":52485},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3582":534,"_31169":486,"_21582":52487,"_5":14829,"_28301":52328,"_3051":52488},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3582":535,"_31169":486,"_21582":52490,"_5":14829,"_28301":52328,"_3051":52491},[],"It separately loads the policies granted to each principal.",{"_3582":536,"_31169":486,"_21582":52493,"_5":14829,"_28301":52328,"_3051":52494},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3582":537,"_31169":486,"_21582":52496,"_5":14829,"_28301":52328,"_3051":52497},[],"`authz` looks for an HTTP rule granting that action.",{"_3582":538,"_31169":486,"_21582":52499,"_5":14829,"_28301":52328,"_3051":52500},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3582":539,"_31169":486,"_21582":52502,"_5":14829,"_28301":52328,"_3051":52503},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3582":540,"_31169":486,"_21582":52505,"_5":14829,"_28301":52328,"_3051":52506},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3582":541,"_31169":486,"_21582":52508,"_5":14829,"_28301":52328,"_3051":52509},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3582":542,"_31169":486,"_21582":52511,"_5":14829,"_28301":52332,"_3051":52512},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3582":543,"_31169":486,"_21582":52514,"_5":14829,"_28301":52332,"_3051":52515},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3582":544,"_31169":486,"_21582":52517,"_5":14829,"_28301":52332,"_3051":52518},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3582":545,"_31169":486,"_21582":52520,"_5":14829,"_28301":52332,"_3051":52521},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3582":546,"_31169":486,"_21582":52523,"_5":14829,"_28301":52332,"_3051":52524},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3582":547,"_31169":486,"_21582":52526,"_5":14829,"_28301":52332,"_3051":52527},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3582":548,"_31169":486,"_21582":52529,"_5":14829,"_28301":52332,"_3051":52530},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3582":549,"_31169":486,"_21582":52532,"_5":14829,"_28301":52332,"_3051":52533},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3582":550,"_31169":486,"_21582":52535,"_5":14829,"_28301":52336,"_3051":52536},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3582":551,"_31169":486,"_21582":52538,"_5":14829,"_28301":52336,"_3051":52539},[],"The decision is made with the domain operation context:",{"_3582":552,"_31169":486,"_21582":52541,"_5":14829,"_28301":52336,"_3051":52542},[],"The middleware extracts the credential and resolves the matching principals.",{"_3582":553,"_31169":486,"_21582":52544,"_5":14829,"_28301":52336,"_3051":52545},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3582":554,"_31169":486,"_21582":52547,"_5":14829,"_28301":52336,"_3051":52548},[],"`authz` gathers the entity rules of the granted policies.",{"_3582":555,"_31169":486,"_21582":52550,"_5":14829,"_28301":52336,"_3051":52551},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3582":556,"_31169":486,"_21582":52553,"_5":14829,"_28301":52336,"_3051":52554},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3582":557,"_31169":486,"_21582":52556,"_5":14829,"_28301":52336,"_3051":52557},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3582":558,"_31169":486,"_21582":52559,"_5":14829,"_28301":52336,"_3051":52560},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3582":559,"_31169":486,"_21582":52562,"_5":14829,"_28301":52336,"_3051":52563},[],"Actions fall into two groups:",{"_3582":560,"_31169":486,"_21582":52565,"_5":14829,"_28301":52336,"_3051":52566},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3582":561,"_31169":486,"_21582":52568,"_5":14829,"_28301":52336,"_3051":52569},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3582":562,"_31169":486,"_21582":52571,"_5":14829,"_28301":52336,"_3051":52572},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3582":563,"_31169":486,"_21582":52574,"_5":14829,"_28301":52340,"_3051":52575},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3582":564,"_31169":486,"_21582":52577,"_5":14829,"_28301":52340,"_3051":52578},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3582":565,"_31169":486,"_21582":52580,"_5":14829,"_28301":52340,"_3051":52581},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3582":566,"_31169":486,"_21582":52583,"_5":14829,"_28301":52344,"_3051":52584},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3582":567,"_31169":486,"_21582":52586,"_5":14829,"_28301":52344,"_3051":52587},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3582":568,"_31169":486,"_21582":52589,"_5":14829,"_28301":52344,"_3051":52590},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3582":569,"_31169":486,"_21582":52592,"_5":14829,"_28301":52344,"_3051":52593},[],"The implemented operators are:",{"_3582":570,"_31169":486,"_21582":52595,"_5":14829,"_28301":52344,"_3051":52596},[],"`equals`, for exact equality;",{"_3582":571,"_31169":486,"_21582":52598,"_5":14829,"_28301":52344,"_3051":52599},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3582":572,"_31169":486,"_21582":52601,"_5":14829,"_28301":52344,"_3051":52602},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3582":573,"_31169":486,"_21582":52604,"_5":14829,"_28301":52344,"_3051":52605},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3582":574,"_31169":486,"_21582":52607,"_5":14829,"_28301":52348,"_3051":52608},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3582":575,"_31169":486,"_21582":52610,"_5":14829,"_28301":52348,"_3051":52611},[],"The available modes are:",{"_3582":576,"_31169":486,"_21582":52613,"_5":14829,"_28301":52348,"_3051":52614},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3582":577,"_31169":486,"_21582":52616,"_5":14829,"_28301":52348,"_3051":52617},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3582":578,"_31169":486,"_21582":52619,"_5":14829,"_28301":52348,"_3051":52620},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3582":579,"_31169":486,"_21582":52622,"_5":14829,"_28301":52348,"_3051":52623},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3582":580,"_31169":486,"_21582":52625,"_5":14829,"_28301":52348,"_3051":52626},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3582":581,"_31169":486,"_21582":52628,"_5":14829,"_28301":52348,"_3051":52629},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3582":582,"_31169":486,"_21582":52631,"_5":14829,"_28301":52352,"_3051":52632},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3582":583,"_31169":486,"_21582":52634,"_5":14829,"_28301":52352,"_3051":52635},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3582":584,"_31169":486,"_21582":52637,"_5":14829,"_28301":52352,"_3051":52638},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3582":585,"_31169":486,"_21582":52640,"_5":14829,"_28301":52352,"_3051":52641},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3582":586,"_31169":486,"_21582":52643,"_5":14829,"_28301":52360,"_3051":52644},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3582":587,"_31169":486,"_21582":52646,"_5":14829,"_28301":52360,"_3051":52647},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3582":588,"_31169":486,"_21582":52649,"_5":14829,"_28301":52364,"_3051":52650},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3582":589,"_31169":486,"_21582":52652,"_5":14829,"_28301":52364,"_3051":52653},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3582":590,"_31169":486,"_21582":52655,"_5":14829,"_28301":52368,"_3051":52656},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3582":591,"_31169":486,"_21582":52658,"_5":14829,"_28301":52368,"_3051":52659},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3582":592,"_31169":486,"_21582":52661,"_5":14829,"_28301":52368,"_3051":52662},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3582":593,"_31169":486,"_21582":52664,"_5":14829,"_28301":52372,"_3051":52665},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3582":594,"_31169":486,"_21582":52667,"_5":14829,"_28301":52372,"_3051":52668},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3582":595,"_31169":486,"_21582":52670,"_5":14829,"_28301":52372,"_3051":52671},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3582":596,"_31169":486,"_21582":52673,"_5":14829,"_28301":52372,"_3051":52674},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3582":597,"_31169":486,"_21582":52676,"_5":14829,"_28301":52372,"_3051":52677},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3582":598,"_31169":486,"_21582":52679,"_5":14829,"_28301":52372,"_3051":52680},[],"Note that:",{"_3582":599,"_31169":486,"_21582":52682,"_5":14829,"_28301":52372,"_3051":52683},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3582":600,"_31169":486,"_21582":52685,"_5":14829,"_28301":52372,"_3051":52686},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3582":601,"_31169":486,"_21582":52688,"_5":14829,"_28301":52372,"_3051":52689},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3582":602,"_31169":486,"_21582":52691,"_5":14829,"_28301":52376,"_3051":52692},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3582":603,"_31169":486,"_21582":52694,"_5":14829,"_28301":52376,"_3051":52695},[],"full and read-only access to certificates and authorities;",{"_3582":604,"_31169":486,"_21582":52697,"_5":14829,"_28301":52376,"_3051":52698},[],"full and read-only access to the KMS;",{"_3582":605,"_31169":486,"_21582":52700,"_5":14829,"_28301":52376,"_3051":52701},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3582":606,"_31169":486,"_21582":52703,"_5":14829,"_28301":52376,"_3051":52704},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3582":607,"_31169":486,"_21582":52706,"_5":14829,"_28301":52376,"_3051":52707},[],"console access;",{"_3582":608,"_31169":486,"_21582":52709,"_5":14829,"_28301":52376,"_3051":52710},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3582":609,"_31169":486,"_21582":52712,"_5":14829,"_28301":52376,"_3051":52713},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3582":610,"_31169":486,"_21582":52715,"_5":14829,"_28301":52376,"_3051":52716},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3582":611,"_31169":486,"_21582":52718,"_5":14829,"_28301":52380,"_3051":52719},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3582":612,"_31169":486,"_21582":52721,"_5":14829,"_28301":52380,"_3051":52722},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3582":613,"_31169":486,"_21582":52724,"_5":14829,"_28301":52380,"_3051":52725},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3582":614,"_31169":486,"_21582":52727,"_5":14829,"_28301":52383,"_3051":52728},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3582":615,"_31169":486,"_21582":52730,"_5":14829,"_28301":52387,"_3051":52731},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3582":616,"_31169":486,"_21582":52733,"_5":14829,"_28301":52387,"_3051":52734},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3582":617,"_31169":486,"_21582":52736,"_5":14829,"_28301":52391,"_3051":52737},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3582":618,"_31169":486,"_21582":52739,"_5":14829,"_28301":52395,"_3051":52740},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3582":619,"_31169":486,"_21582":52742,"_5":14829,"_28301":52399,"_3051":52743},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3582":620,"_31169":486,"_21582":52745,"_5":14829,"_28301":52403,"_3051":52746},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3582":621,"_31169":486,"_21582":52748,"_5":14829,"_28301":52403,"_3051":52749},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3582":622,"_31169":486,"_21582":52751,"_5":14829,"_28301":52407,"_3051":52752},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3582":623,"_31169":486,"_21582":52754,"_5":14829,"_28301":52407,"_3051":52755},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3582":624,"_31169":486,"_21582":52757,"_5":14829,"_28301":52407,"_3051":52758},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3582":625,"_31169":486,"_21582":52760,"_5":14829,"_28301":52407,"_3051":52761},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3582":626,"_31169":486,"_21582":52763,"_5":14829,"_28301":52407,"_3051":52764},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3582":627,"_31169":486,"_21582":52766,"_5":14829,"_28301":52407,"_3051":52767},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3582":628,"_31169":486,"_21582":52769,"_5":14829,"_28301":52407,"_3051":52770},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3582":629,"_31169":486,"_21582":52772,"_5":14829,"_28301":52407,"_3051":52773},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3582":630,"_31169":486,"_21582":52775,"_5":14829,"_28301":52411,"_3051":52776},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3582":631,"_31169":486,"_21582":52778,"_5":14829,"_28301":52411,"_3051":52779},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3582":632,"_31169":486,"_21582":52781,"_5":14829,"_28301":52411,"_3051":52782},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3582":633,"_31169":486,"_21582":52784,"_5":14829,"_28301":52415,"_3051":52785},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3582":634,"_31169":486,"_21582":52787,"_5":14829,"_28301":52415,"_3051":52788},[],"Use groups or stable roles for people and independent identities for automations.",{"_3582":635,"_31169":486,"_21582":52790,"_5":14829,"_28301":52415,"_3051":52791},[],"Keep at least two recovery administrators and test their access periodically.",{"_3582":636,"_31169":486,"_21582":52793,"_5":14829,"_28301":52415,"_3051":52794},[],"Review active principals, their matches and their grants after IdP changes.",{"_3582":637,"_31169":486,"_21582":52796,"_5":14829,"_28301":52415,"_3051":52797},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3582":638,"_31169":486,"_21582":52799,"_5":14829,"_28301":52415,"_3051":52800},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3582":639,"_31169":486,"_21582":52802,"_5":14829,"_28301":52415,"_3051":52803},[],"Always test one allowed and one denied operation for each role.",{"_3582":640,"_31169":486,"_21582":52805,"_5":14829,"_28301":52415,"_3051":52806},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3582":641,"_31169":486,"_21582":52808,"_5":14829,"_28301":52423,"_3051":52809},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3582":642,"_31169":486,"_21582":52811,"_5":14829,"_28301":52427,"_3051":52812},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3582":643,"_31169":486,"_21582":52814,"_5":14829,"_28301":52427,"_3051":52815},[],"that an active principal of the correct type exists;",{"_3582":644,"_31169":486,"_21582":52817,"_5":14829,"_28301":52427,"_3051":52818},[],"that the claim paths and values match the real token exactly;",{"_3582":645,"_31169":486,"_21582":52820,"_5":14829,"_28301":52427,"_3051":52821},[],"that all of the principal's conditions hold;",{"_3582":646,"_31169":486,"_21582":52823,"_5":14829,"_28301":52427,"_3051":52824},[],"that the principal has the expected policy granted;",{"_3582":647,"_31169":486,"_21582":52826,"_5":14829,"_28301":52427,"_3051":52827},[],"that the policy includes the action and the requested resource type or route;",{"_3582":648,"_31169":486,"_21582":52829,"_5":14829,"_28301":52427,"_3051":52830},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3582":649,"_31169":486,"_21582":52832,"_5":14829,"_28301":52427,"_3051":52833},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3582":650,"_31169":486,"_21582":52835,"_5":14829,"_28301":52431,"_3051":52836},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3582":651,"_31169":486,"_21582":52838,"_5":14829,"_28301":52435,"_3051":52839},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3582":652,"_31169":486,"_21582":52841,"_5":14829,"_28301":52439,"_3051":52842},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3582":653,"_31169":486,"_21582":52844,"_5":14829,"_28301":52439,"_3051":52845},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3582":654,"_31169":654,"_5":15200,"_3051":52847,"_31527":52848,"_21582":52849,"_28301":654},"Alerts and subscriptions",[50837,52312,52313],[],{"_3582":655,"_31169":654,"_21582":52851,"_5":14829,"_28301":654,"_3051":52852},[],"Send PKI events to people and external systems.",{"_3582":656,"_31169":654,"_5":31524,"_21582":52854,"_28301":52855,"_3051":52856},[],"/docs/pr-preview/pr-61/platform/administration/alerts#how-it-works","How it works",{"_3582":657,"_31169":654,"_5":31524,"_21582":52858,"_28301":52859,"_3051":52860},[],"/docs/pr-preview/pr-61/platform/administration/alerts#available-channels","Available channels",{"_3582":658,"_31169":654,"_5":31524,"_21582":52862,"_28301":52863,"_3051":52864},[],"/docs/pr-preview/pr-61/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3582":659,"_31169":654,"_5":31524,"_21582":52866,"_28301":52867,"_3051":52868},[],"/docs/pr-preview/pr-61/platform/administration/alerts#choose-the-event","Choose the event",{"_3582":660,"_31169":654,"_5":31524,"_21582":52870,"_28301":52871,"_3051":52872},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3582":661,"_31169":654,"_5":31524,"_21582":52874,"_28301":52875,"_3051":52876},[],"/docs/pr-preview/pr-61/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3582":662,"_31169":654,"_5":31524,"_21582":52878,"_28301":52879,"_3051":52880},[],"/docs/pr-preview/pr-61/platform/administration/alerts#review-and-activate","Review and activate",{"_3582":663,"_31169":654,"_5":31524,"_21582":52882,"_28301":52883,"_3051":52884},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3582":664,"_31169":654,"_5":31524,"_21582":52886,"_28301":52887,"_3051":52888},[],"/docs/pr-preview/pr-61/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3582":665,"_31169":654,"_5":31524,"_21582":52890,"_28301":52891,"_3051":52892},[],"/docs/pr-preview/pr-61/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3582":666,"_31169":654,"_5":31524,"_21582":52894,"_28301":52895,"_3051":52896},[],"/docs/pr-preview/pr-61/platform/administration/alerts#event-families","Event families",{"_3582":667,"_31169":654,"_21582":52898,"_5":14829,"_28301":654,"_3051":52899},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3582":668,"_31169":654,"_21582":52901,"_5":14829,"_28301":52855,"_3051":52902},[],"A service publishes a domain event.",{"_3582":669,"_31169":654,"_21582":52904,"_5":14829,"_28301":52855,"_3051":52905},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3582":670,"_31169":654,"_21582":52907,"_5":14829,"_28301":52855,"_3051":52908},[],"Each subscription's filter decides whether it should be notified.",{"_3582":671,"_31169":654,"_21582":52910,"_5":14829,"_28301":52855,"_3051":52911},[],"Lamassu delivers the event to the configured channel.",{"_3582":672,"_31169":654,"_21582":52913,"_5":14829,"_28301":52855,"_3051":52914},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3582":673,"_31169":654,"_21582":52916,"_5":14829,"_28301":52859,"_3051":52917},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3582":674,"_31169":654,"_21582":52919,"_5":14829,"_28301":52859,"_3051":52920},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3582":675,"_31169":654,"_21582":52922,"_5":14829,"_28301":52859,"_3051":52923},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3582":676,"_31169":654,"_21582":52925,"_5":14829,"_28301":52859,"_3051":52926},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3582":677,"_31169":654,"_21582":52928,"_5":14829,"_28301":52859,"_3051":52929},[],"`apikey_options` requires `header` and `key`.",{"_3582":678,"_31169":654,"_21582":52931,"_5":14829,"_28301":52859,"_3051":52932},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3582":679,"_31169":654,"_21582":52934,"_5":14829,"_28301":52859,"_3051":52935},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3582":680,"_31169":654,"_21582":52937,"_5":14829,"_28301":52859,"_3051":52938},[],"The alerts API reference documents the full `http_client` schema.",{"_3582":681,"_31169":654,"_21582":52940,"_5":14829,"_28301":52867,"_3051":52941},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3582":682,"_31169":654,"_21582":52943,"_5":14829,"_28301":52871,"_3051":52944},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3582":683,"_31169":654,"_21582":52946,"_5":14829,"_28301":52875,"_3051":52947},[],"Add a filter if you don't want to receive every instance of the event.",{"_3582":684,"_31169":654,"_21582":52949,"_5":14829,"_28301":52875,"_3051":52950},[],"**None** notifies all instances of the event.",{"_3582":685,"_31169":654,"_21582":52952,"_5":14829,"_28301":52875,"_3051":52953},[],"**JSON Path** evaluates one or more specific fields.",{"_3582":686,"_31169":654,"_21582":52955,"_5":14829,"_28301":52875,"_3051":52956},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3582":687,"_31169":654,"_21582":52958,"_5":14829,"_28301":52875,"_3051":52959},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3582":688,"_31169":654,"_21582":52961,"_5":14829,"_28301":52875,"_3051":52962},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3582":689,"_31169":654,"_21582":52964,"_5":14829,"_28301":52875,"_3051":52965},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3582":690,"_31169":654,"_21582":52967,"_5":14829,"_28301":52879,"_3051":52968},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3582":691,"_31169":654,"_21582":52970,"_5":14829,"_28301":52883,"_3051":52971},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3582":692,"_31169":654,"_21582":52973,"_5":14829,"_28301":52883,"_3051":52974},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3582":693,"_31169":654,"_21582":52976,"_5":14829,"_28301":52883,"_3051":52977},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3582":694,"_31169":654,"_21582":52979,"_5":14829,"_28301":52883,"_3051":52980},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3582":695,"_31169":654,"_21582":52982,"_5":14829,"_28301":52883,"_3051":52983},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3582":696,"_31169":654,"_21582":52985,"_5":14829,"_28301":52883,"_3051":52986},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3582":697,"_31169":654,"_21582":52988,"_5":14829,"_28301":52883,"_3051":52989},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3582":698,"_31169":654,"_21582":52991,"_5":14829,"_28301":52883,"_3051":52992},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3582":699,"_31169":654,"_21582":52994,"_5":14829,"_28301":52887,"_3051":52995},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3582":700,"_31169":654,"_21582":52997,"_5":14829,"_28301":52887,"_3051":52998},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3582":701,"_31169":654,"_21582":53000,"_5":14829,"_28301":52887,"_3051":53001},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3582":702,"_31169":654,"_21582":53003,"_5":14829,"_28301":52887,"_3051":53004},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3582":703,"_31169":654,"_21582":53006,"_5":14829,"_28301":52887,"_3051":53007},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3582":704,"_31169":654,"_21582":53009,"_5":14829,"_28301":52887,"_3051":53010},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3582":705,"_31169":654,"_21582":53012,"_5":14829,"_28301":52887,"_3051":53013},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3582":706,"_31169":654,"_21582":53015,"_5":14829,"_28301":52887,"_3051":53016},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3582":707,"_31169":654,"_21582":53018,"_5":14829,"_28301":52891,"_3051":53019},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3582":708,"_31169":654,"_21582":53021,"_5":14829,"_28301":52891,"_3051":53022},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3582":709,"_31169":654,"_21582":53024,"_5":14829,"_28301":52895,"_3051":53025},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3582":710,"_31169":654,"_21582":53027,"_5":14829,"_28301":52895,"_3051":53028},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3582":711,"_31169":654,"_21582":53030,"_5":14829,"_28301":52895,"_3051":53031},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3582":712,"_31169":654,"_21582":53033,"_5":14829,"_28301":52895,"_3051":53034},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3582":713,"_31169":654,"_21582":53036,"_5":14829,"_28301":52895,"_3051":53037},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3582":714,"_31169":654,"_21582":53039,"_5":14829,"_28301":52895,"_3051":53040},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3582":715,"_31169":654,"_21582":53042,"_5":14829,"_28301":52895,"_3051":53043},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3582":716,"_31169":654,"_21582":53045,"_5":14829,"_28301":52895,"_3051":53046},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3582":717,"_31169":654,"_21582":53048,"_5":14829,"_28301":52895,"_3051":53049},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3582":718,"_31169":718,"_5":15200,"_3051":53051,"_31527":53052,"_21582":53053,"_28301":718},"Audit logs",[50837,52312,52313],[],{"_3582":719,"_31169":718,"_21582":53055,"_5":14829,"_28301":718,"_3051":53056},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3582":720,"_31169":718,"_5":31524,"_21582":53058,"_28301":53059,"_3051":53060},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3582":721,"_31169":718,"_5":31524,"_21582":53062,"_28301":53063,"_3051":53064},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#coverage","Coverage",{"_3582":722,"_31169":718,"_5":31524,"_21582":53066,"_28301":53067,"_3051":53068},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3582":723,"_31169":718,"_5":31524,"_21582":53070,"_28301":53071,"_3051":53072},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3582":724,"_31169":718,"_5":31524,"_21582":53074,"_28301":53075,"_3051":53076},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3582":725,"_31169":718,"_5":31524,"_21582":53078,"_28301":53079,"_3051":53080},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3582":726,"_31169":718,"_5":31524,"_21582":53082,"_28301":53083,"_3051":53084},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3582":727,"_31169":718,"_5":31524,"_21582":53086,"_28301":53087,"_3051":53088},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3582":728,"_31169":718,"_5":31524,"_21582":53090,"_28301":53091,"_3051":53092},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3582":729,"_31169":718,"_5":31524,"_21582":53094,"_28301":53095,"_3051":53096},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3582":730,"_31169":718,"_5":31524,"_21582":53098,"_28301":53099,"_3051":53100},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3582":731,"_31169":718,"_21582":53102,"_5":14829,"_28301":718,"_3051":53103},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3582":732,"_31169":718,"_21582":53105,"_5":14829,"_28301":53059,"_3051":53106},[],"The audit body includes:",{"_3582":733,"_31169":718,"_21582":53108,"_5":14829,"_28301":53059,"_3051":53109},[],"input: data received by the operation;",{"_3582":734,"_31169":718,"_21582":53111,"_5":14829,"_28301":53059,"_3051":53112},[],"has\\_error: whether the service returned an error;",{"_3582":735,"_31169":718,"_21582":53114,"_5":14829,"_28301":53059,"_3051":53115},[],"output: produced result or error message;",{"_3582":736,"_31169":718,"_21582":53117,"_5":14829,"_28301":53059,"_3051":53118},[],"principals: identifiers of the principals that matched the request.",{"_3582":737,"_31169":718,"_21582":53120,"_5":14829,"_28301":53059,"_3051":53121},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3582":738,"_31169":718,"_21582":53123,"_5":14829,"_28301":53059,"_3051":53124},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3582":739,"_31169":718,"_21582":53126,"_5":14829,"_28301":53063,"_3051":53127},[],"The backend applies auditing to mutations of:",{"_3582":740,"_31169":718,"_21582":53129,"_5":14829,"_28301":53063,"_3051":53130},[],"authorities, certificates and issuance profiles;",{"_3582":741,"_31169":718,"_21582":53132,"_5":14829,"_28301":53063,"_3051":53133},[],"keys and KMS engines;",{"_3582":742,"_31169":718,"_21582":53135,"_5":14829,"_28301":53063,"_3051":53136},[],"devices and identities;",{"_3582":743,"_31169":718,"_21582":53138,"_5":14829,"_28301":53063,"_3051":53139},[],"DMSs and enrollment operations;",{"_3582":744,"_31169":718,"_21582":53141,"_5":14829,"_28301":53063,"_3051":53142},[],"validation functions and CRL;",{"_3582":745,"_31169":718,"_21582":53144,"_5":14829,"_28301":53063,"_3051":53145},[],"principals, policies and authorization grants.",{"_3582":746,"_31169":718,"_21582":53147,"_5":14829,"_28301":53063,"_3051":53148},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3582":747,"_31169":718,"_21582":53150,"_5":14829,"_28301":53067,"_3051":53151},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3582":748,"_31169":718,"_21582":53153,"_5":14829,"_28301":53067,"_3051":53154},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3582":749,"_31169":718,"_21582":53156,"_5":14829,"_28301":53067,"_3051":53157},[],"Design the consumer to:",{"_3582":750,"_31169":718,"_21582":53159,"_5":14829,"_28301":53067,"_3051":53160},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3582":751,"_31169":718,"_21582":53162,"_5":14829,"_28301":53067,"_3051":53163},[],"keep the complete CloudEvent unmodified;",{"_3582":752,"_31169":718,"_21582":53165,"_5":14829,"_28301":53067,"_3051":53166},[],"record the ingestion time and detect duplicates by ID;",{"_3582":753,"_31169":718,"_21582":53168,"_5":14829,"_28301":53067,"_3051":53169},[],"encrypt in transit and at rest;",{"_3582":754,"_31169":718,"_21582":53171,"_5":14829,"_28301":53067,"_3051":53172},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3582":755,"_31169":718,"_21582":53174,"_5":14829,"_28301":53067,"_3051":53175},[],"apply an explicit retention and legal hold policy;",{"_3582":756,"_31169":718,"_21582":53177,"_5":14829,"_28301":53067,"_3051":53178},[],"alert if it stops consuming or the pending queue grows.",{"_3582":757,"_31169":718,"_21582":53180,"_5":14829,"_28301":53071,"_3051":53181},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3582":758,"_31169":718,"_21582":53183,"_5":14829,"_28301":53071,"_3051":53184},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3582":759,"_31169":718,"_21582":53186,"_5":14829,"_28301":53079,"_3051":53187},[],"Start from the reported time and normalize every source to UTC.",{"_3582":760,"_31169":718,"_21582":53189,"_5":14829,"_28301":53083,"_3051":53190},[],"Filter by event type, service source and resource identifier.",{"_3582":761,"_31169":718,"_21582":53192,"_5":14829,"_28301":53087,"_3051":53193},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3582":762,"_31169":718,"_21582":53195,"_5":14829,"_28301":53091,"_3051":53196},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3582":763,"_31169":718,"_21582":53198,"_5":14829,"_28301":53095,"_3051":53199},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3582":764,"_31169":718,"_21582":53201,"_5":14829,"_28301":53099,"_3051":53202},[],"Generate a controlled mutation in a test environment and check that:",{"_3582":765,"_31169":718,"_21582":53204,"_5":14829,"_28301":53099,"_3051":53205},[],"a successful audit event appears;",{"_3582":766,"_31169":718,"_21582":53207,"_5":14829,"_28301":53099,"_3051":53208},[],"the principal matches the identity used;",{"_3582":767,"_31169":718,"_21582":53210,"_5":14829,"_28301":53099,"_3051":53211},[],"the consumer persists it exactly once;",{"_3582":768,"_31169":718,"_21582":53213,"_5":14829,"_28301":53099,"_3051":53214},[],"it can be retrieved by resource, actor and period;",{"_3582":769,"_31169":718,"_21582":53216,"_5":14829,"_28301":53099,"_3051":53217},[],"a consumer outage raises an alert.",{"_3582":770,"_31169":718,"_21582":53219,"_5":14829,"_28301":53099,"_3051":53220},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3582":771,"_31169":771,"_5":15200,"_3051":53222,"_31527":53223,"_21582":53224,"_28301":771},"Platform architecture",[50837,52312],[],{"_3582":772,"_31169":771,"_21582":53226,"_5":14829,"_28301":771,"_3051":53227},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3582":773,"_31169":771,"_5":31524,"_21582":53229,"_28301":53230,"_3051":53231},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#control-plane","Control plane",{"_3582":774,"_31169":771,"_5":31524,"_21582":53233,"_28301":53234,"_3051":53235},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3582":775,"_31169":771,"_5":31524,"_21582":53237,"_28301":53238,"_3051":53239},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3582":776,"_31169":771,"_5":31524,"_21582":53241,"_28301":53242,"_3051":53243},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#status-and-validation","Status and validation",{"_3582":777,"_31169":771,"_5":31524,"_21582":53245,"_28301":53246,"_3051":53247},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3582":778,"_31169":771,"_21582":53249,"_5":14829,"_28301":771,"_3051":53250},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3582":779,"_31169":771,"_21582":53252,"_5":14829,"_28301":771,"_3051":53253},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3582":780,"_31169":771,"_21582":53255,"_5":14829,"_28301":53230,"_3051":53256},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3582":781,"_31169":771,"_21582":53258,"_5":14829,"_28301":53234,"_3051":53259},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3582":782,"_31169":771,"_21582":53261,"_5":14829,"_28301":53238,"_3051":53262},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3582":783,"_31169":771,"_21582":53264,"_5":14829,"_28301":53242,"_3051":53265},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3582":784,"_31169":771,"_21582":53267,"_5":14829,"_28301":53246,"_3051":53268},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3582":785,"_31169":785,"_5":15200,"_3051":53270,"_31527":53271,"_21582":53272,"_28301":785},"How Lamassu works",[50837,52312],[],{"_3582":786,"_31169":785,"_21582":53274,"_5":14829,"_28301":785,"_3051":53275},[],"The mental model of trust, keys, certificates and devices.",{"_3582":787,"_31169":785,"_5":31524,"_21582":53277,"_28301":53278,"_3051":53279},[],"/docs/pr-preview/pr-61/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3582":788,"_31169":785,"_5":31524,"_21582":53281,"_28301":53282,"_3051":53283},[],"/docs/pr-preview/pr-61/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3582":789,"_31169":785,"_21582":53285,"_5":14829,"_28301":785,"_3051":53286},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3582":790,"_31169":785,"_21582":53288,"_5":14829,"_28301":53278,"_3051":53289},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3582":791,"_31169":785,"_21582":53291,"_5":14829,"_28301":53278,"_3051":53292},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3582":792,"_31169":785,"_21582":53294,"_5":14829,"_28301":53278,"_3051":53295},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3582":793,"_31169":785,"_21582":53297,"_5":14829,"_28301":53278,"_3051":53298},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3582":794,"_31169":785,"_21582":53300,"_5":14829,"_28301":53278,"_3051":53301},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3582":795,"_31169":785,"_21582":53303,"_5":14829,"_28301":53282,"_3051":53304},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3582":796,"_31169":785,"_21582":53306,"_5":14829,"_28301":53282,"_3051":53307},[],"A DMS relates that CA to an enrollment policy.",{"_3582":797,"_31169":785,"_21582":53309,"_5":14829,"_28301":53282,"_3051":53310},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3582":798,"_31169":785,"_21582":53312,"_5":14829,"_28301":53282,"_3051":53313},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3582":799,"_31169":785,"_21582":53315,"_5":14829,"_28301":53282,"_3051":53316},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3582":800,"_31169":785,"_21582":53318,"_5":14829,"_28301":53282,"_3051":53319},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3582":801,"_31169":785,"_21582":53321,"_5":14829,"_28301":53282,"_3051":53322},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3582":802,"_31169":802,"_5":15200,"_3051":53324,"_31527":53325,"_21582":53327,"_28301":802},"Devices and identities",[50837,52312,53326,53324],"IoT Fleets",[],{"_3582":803,"_31169":802,"_21582":53329,"_5":14829,"_28301":802,"_3051":53330},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3582":804,"_31169":802,"_5":31524,"_21582":53332,"_28301":53333,"_3051":53334},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#device-states","Device states",{"_3582":805,"_31169":802,"_5":31524,"_21582":53336,"_28301":53337,"_3051":53338},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3582":806,"_31169":802,"_5":31524,"_21582":53340,"_28301":53341,"_3051":53342},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3582":807,"_31169":802,"_5":31524,"_21582":53344,"_28301":53345,"_3051":53346},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3582":808,"_31169":802,"_5":31524,"_21582":53348,"_28301":53349,"_3051":53350},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3582":809,"_31169":802,"_5":31524,"_21582":53352,"_28301":53353,"_3051":53354},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3582":810,"_31169":802,"_5":31524,"_21582":53356,"_28301":53357,"_3051":53358},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3582":811,"_31169":802,"_5":31524,"_21582":53360,"_28301":53361,"_3051":53362},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3582":812,"_31169":802,"_5":31524,"_21582":53364,"_28301":53365,"_3051":53366},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3582":813,"_31169":802,"_5":31524,"_21582":53368,"_28301":53369,"_3051":53370},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3582":814,"_31169":802,"_5":31524,"_21582":53372,"_28301":53373,"_3051":53374},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3582":815,"_31169":802,"_21582":53376,"_5":14829,"_28301":802,"_3051":53377},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3582":816,"_31169":802,"_21582":53379,"_5":14829,"_28301":802,"_3051":53380},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3582":817,"_31169":802,"_21582":53382,"_5":14829,"_28301":53333,"_3051":53383},[],"Operational view",{"_3582":818,"_31169":802,"_21582":53385,"_5":14829,"_28301":53333,"_3051":53386},[],"Meaning",{"_3582":819,"_31169":802,"_21582":53388,"_5":14829,"_28301":53333,"_3051":53389},[],"**No Identity**",{"_3582":820,"_31169":802,"_21582":53391,"_5":14829,"_28301":53333,"_3051":53392},[],"A record exists without an associated identity.",{"_3582":821,"_31169":802,"_21582":53394,"_5":14829,"_28301":53333,"_3051":53395},[],"**Active**",{"_3582":822,"_31169":802,"_21582":53397,"_5":14829,"_28301":53333,"_3051":53398},[],"The slot is active; also check certificate dates, status and usages.",{"_3582":823,"_31169":802,"_21582":53400,"_5":14829,"_28301":53333,"_3051":53401},[],"**Renewal Pending**",{"_3582":824,"_31169":802,"_21582":53403,"_5":14829,"_28301":53333,"_3051":53404},[],"The identity is in the operational renewal window.",{"_3582":825,"_31169":802,"_21582":53406,"_5":14829,"_28301":53333,"_3051":53407},[],"**Expiring Soon**",{"_3582":826,"_31169":802,"_21582":53409,"_5":14829,"_28301":53333,"_3051":53410},[],"Expiration is approaching according to configured thresholds.",{"_3582":827,"_31169":802,"_21582":53412,"_5":14829,"_28301":53333,"_3051":53413},[],"**Expired**",{"_3582":828,"_31169":802,"_21582":53415,"_5":14829,"_28301":53333,"_3051":53416},[],"The identity has expired.",{"_3582":829,"_31169":802,"_21582":53418,"_5":14829,"_28301":53333,"_3051":53419},[],"**Revoked**",{"_3582":830,"_31169":802,"_21582":53421,"_5":14829,"_28301":53333,"_3051":53422},[],"The identity is marked revoked.",{"_3582":831,"_31169":802,"_21582":53424,"_5":14829,"_28301":53333,"_3051":53425},[],"**Decommissioned**",{"_3582":832,"_31169":802,"_21582":53427,"_5":14829,"_28301":53333,"_3051":53428},[],"The record is retired and ordinary updates do not restore operation.",{"_3582":833,"_31169":802,"_21582":53430,"_5":14829,"_28301":53333,"_3051":53431},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3582":834,"_31169":802,"_21582":53433,"_5":14829,"_28301":53337,"_3051":53434},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3582":835,"_31169":802,"_21582":53436,"_5":14829,"_28301":53337,"_3051":53437},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3582":836,"_31169":802,"_21582":53439,"_5":14829,"_28301":53337,"_3051":53440},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3582":837,"_31169":802,"_21582":53442,"_5":14829,"_28301":53337,"_3051":53443},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3582":838,"_31169":802,"_21582":53445,"_5":14829,"_28301":53341,"_3051":53446},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3582":839,"_31169":802,"_21582":53448,"_5":14829,"_28301":53345,"_3051":53449},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3582":840,"_31169":802,"_21582":53451,"_5":14829,"_28301":53349,"_3051":53452},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3582":841,"_31169":802,"_21582":53454,"_5":14829,"_28301":53353,"_3051":53455},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3582":842,"_31169":802,"_21582":53457,"_5":14829,"_28301":53357,"_3051":53458},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3582":843,"_31169":802,"_21582":53460,"_5":14829,"_28301":53357,"_3051":53461},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3582":844,"_31169":802,"_21582":53463,"_5":14829,"_28301":53361,"_3051":53464},[],"From **No Identity**, use **Assign Identity**:",{"_3582":845,"_31169":802,"_21582":53466,"_5":14829,"_28301":53361,"_3051":53467},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3582":846,"_31169":802,"_21582":53469,"_5":14829,"_28301":53361,"_3051":53470},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3582":847,"_31169":802,"_21582":53472,"_5":14829,"_28301":53361,"_3051":53473},[],"Confirm and read the serial, active version and history again.",{"_3582":848,"_31169":802,"_21582":53475,"_5":14829,"_28301":53361,"_3051":53476},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3582":849,"_31169":802,"_21582":53478,"_5":14829,"_28301":53361,"_3051":53479},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3582":850,"_31169":802,"_21582":53481,"_5":14829,"_28301":53365,"_3051":53482},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3582":851,"_31169":802,"_21582":53484,"_5":14829,"_28301":53365,"_3051":53485},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3582":852,"_31169":802,"_21582":53487,"_5":14829,"_28301":53369,"_3051":53488},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3582":853,"_31169":802,"_21582":53490,"_5":14829,"_28301":53369,"_3051":53491},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3582":854,"_31169":802,"_21582":53493,"_5":14829,"_28301":53369,"_3051":53494},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3582":855,"_31169":802,"_21582":53496,"_5":14829,"_28301":53369,"_3051":53497},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3582":856,"_31169":802,"_21582":53499,"_5":14829,"_28301":53373,"_3051":53500},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3582":857,"_31169":802,"_21582":53502,"_5":14829,"_28301":53373,"_3051":53503},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3582":858,"_31169":858,"_5":15200,"_3051":53505,"_31527":53506,"_21582":53508,"_28301":858},"Bootstrap identity and authentication",[50837,52312,53326,53324,53507],"Enrollment with PKI",[],{"_3582":859,"_31169":858,"_21582":53510,"_5":14829,"_28301":858,"_3051":53511},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3582":860,"_31169":858,"_5":31524,"_21582":53513,"_28301":53514,"_3051":53515},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3582":861,"_31169":858,"_5":31524,"_21582":53517,"_28301":53518,"_3051":53519},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3582":862,"_31169":858,"_5":31524,"_21582":53521,"_28301":53522,"_3051":53523},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3582":863,"_31169":858,"_5":31524,"_21582":53525,"_28301":53526,"_3051":53527},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3582":864,"_31169":858,"_5":31524,"_21582":53529,"_28301":53530,"_3051":53531},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3582":865,"_31169":858,"_21582":53533,"_5":14829,"_28301":858,"_3051":53534},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3582":866,"_31169":858,"_21582":53536,"_5":14829,"_28301":53514,"_3051":53537},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3582":867,"_31169":858,"_21582":53539,"_5":14829,"_28301":53514,"_3051":53540},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3582":868,"_31169":858,"_21582":53542,"_5":14829,"_28301":53518,"_3051":53543},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3582":869,"_31169":858,"_21582":53545,"_5":14829,"_28301":53518,"_3051":53546},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3582":870,"_31169":858,"_21582":53548,"_5":14829,"_28301":53518,"_3051":53549},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3582":871,"_31169":858,"_21582":53551,"_5":14829,"_28301":53522,"_3051":53552},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3582":872,"_31169":858,"_21582":53554,"_5":14829,"_28301":53522,"_3051":53555},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3582":873,"_31169":858,"_21582":53557,"_5":14829,"_28301":53526,"_3051":53558},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3582":874,"_31169":858,"_21582":53560,"_5":14829,"_28301":53526,"_3051":53561},[],"Example body:",{"_3582":875,"_31169":858,"_21582":53563,"_5":14829,"_28301":53526,"_3051":53564},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3582":876,"_31169":858,"_21582":53566,"_5":14829,"_28301":53526,"_3051":53567},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3582":877,"_31169":858,"_21582":53569,"_5":14829,"_28301":53526,"_3051":53570},[],"Continuation requires a successful HTTP response and JSON:",{"_3582":878,"_31169":858,"_21582":53572,"_5":14829,"_28301":53526,"_3051":53573},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3582":879,"_31169":858,"_21582":53575,"_5":14829,"_28301":53530,"_3051":53576},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3582":880,"_31169":858,"_21582":53578,"_5":14829,"_28301":53530,"_3051":53579},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3582":881,"_31169":881,"_5":15200,"_3051":53581,"_31527":53582,"_21582":53583,"_28301":881},"Configure and operate the DMS",[50837,52312,53326,53324,53507],[],{"_3582":882,"_31169":881,"_21582":53585,"_5":14829,"_28301":881,"_3051":53586},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3582":883,"_31169":881,"_5":31524,"_21582":53588,"_28301":53589,"_3051":50847},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3582":884,"_31169":881,"_5":31524,"_21582":53591,"_28301":53592,"_3051":53593},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3582":885,"_31169":881,"_5":31524,"_21582":53595,"_28301":53596,"_3051":53597},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3582":886,"_31169":881,"_5":31524,"_21582":53599,"_28301":53600,"_3051":53601},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3582":887,"_31169":881,"_5":31524,"_21582":53603,"_28301":53604,"_3051":53605},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3582":888,"_31169":881,"_5":31524,"_21582":53607,"_28301":53608,"_3051":53609},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3582":889,"_31169":881,"_5":31524,"_21582":53611,"_28301":53612,"_3051":53613},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3582":890,"_31169":881,"_5":31524,"_21582":53615,"_28301":53616,"_3051":53617},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3582":891,"_31169":881,"_5":31524,"_21582":53619,"_28301":53620,"_3051":53621},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3582":892,"_31169":881,"_5":31524,"_21582":53623,"_28301":53624,"_3051":53625},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3582":893,"_31169":881,"_5":31524,"_21582":53627,"_28301":53628,"_3051":53629},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3582":894,"_31169":881,"_5":31524,"_21582":53631,"_28301":53632,"_3051":53633},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3582":895,"_31169":881,"_5":31524,"_21582":53635,"_28301":53636,"_3051":53637},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3582":896,"_31169":881,"_5":31524,"_21582":53639,"_28301":53640,"_3051":53641},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3582":897,"_31169":881,"_5":31524,"_21582":53643,"_28301":53644,"_3051":53645},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3582":898,"_31169":881,"_5":31524,"_21582":53647,"_28301":53648,"_3051":53649},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3582":899,"_31169":881,"_5":31524,"_21582":53651,"_28301":53652,"_3051":53653},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3582":900,"_31169":881,"_5":31524,"_21582":53655,"_28301":53656,"_3051":53657},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3582":901,"_31169":881,"_21582":53659,"_5":14829,"_28301":881,"_3051":53660},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3582":902,"_31169":881,"_21582":53662,"_5":14829,"_28301":53589,"_3051":53663},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3582":903,"_31169":881,"_21582":53665,"_5":14829,"_28301":53589,"_3051":53666},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3582":904,"_31169":881,"_21582":53668,"_5":14829,"_28301":53592,"_3051":53669},[],"Follow the interactive walkthrough to configure a DMS for EST. The example sets **Name** to `DMS Showcase`, which derives the `dms-showcase` identifier used in the EST URLs, and selects two CAs prepared in advance: **DMS Enrollment CA** signs the device identities and **DMS Bootstrap CA** validates the initial credential. The values are for this example; use names and CAs appropriate for your fleet.",{"_3582":905,"_31169":881,"_21582":53671,"_5":14829,"_28301":53596,"_3051":53672},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3582":906,"_31169":881,"_21582":53674,"_5":14829,"_28301":53600,"_3051":53675},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3582":907,"_31169":881,"_21582":53677,"_5":14829,"_28301":53604,"_3051":53678},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3582":908,"_31169":881,"_21582":53680,"_5":14829,"_28301":53608,"_3051":53681},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3582":909,"_31169":881,"_21582":53683,"_5":14829,"_28301":53612,"_3051":53684},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3582":910,"_31169":881,"_21582":53686,"_5":14829,"_28301":53620,"_3051":53687},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3582":911,"_31169":881,"_21582":53689,"_5":14829,"_28301":53620,"_3051":53690},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3582":912,"_31169":881,"_21582":53692,"_5":14829,"_28301":53624,"_3051":53693},[],"`settings.enrollment_settings` field",{"_3582":913,"_31169":881,"_21582":53695,"_5":14829,"_28301":53624,"_3051":53696},[],"Decision",{"_3582":914,"_31169":881,"_21582":53698,"_5":14829,"_28301":53624,"_3051":53699},[],"`protocol`",{"_3582":915,"_31169":881,"_21582":53701,"_5":14829,"_28301":53624,"_3051":53702},[],"`EST_RFC7030` for these operations.",{"_3582":916,"_31169":881,"_21582":53704,"_5":14829,"_28301":53624,"_3051":53705},[],"`enrollment_ca`",{"_3582":917,"_31169":881,"_21582":53707,"_5":14829,"_28301":53624,"_3051":53708},[],"ID of the signing CA.",{"_3582":918,"_31169":881,"_21582":53710,"_5":14829,"_28301":53624,"_3051":53711},[],"`verify_csr_signature`",{"_3582":919,"_31169":881,"_21582":53713,"_5":14829,"_28301":53624,"_3051":53714},[],"Keep `true` to verify CSR key possession.",{"_3582":920,"_31169":881,"_21582":53716,"_5":14829,"_28301":53624,"_3051":53717},[],"`enable_replaceable_enrollment`",{"_3582":921,"_31169":881,"_21582":53719,"_5":14829,"_28301":53624,"_3051":53720},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3582":922,"_31169":881,"_21582":53722,"_5":14829,"_28301":53624,"_3051":53723},[],"`est_rfc7030_settings.auth_mode`",{"_3582":923,"_31169":881,"_21582":53725,"_5":14829,"_28301":53624,"_3051":53726},[],"One of the four authentication modes.",{"_3582":924,"_31169":881,"_21582":53728,"_5":14829,"_28301":53624,"_3051":53729},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3582":925,"_31169":881,"_21582":53731,"_5":14829,"_28301":53628,"_3051":53732},[],"The blocks are independent:",{"_3582":926,"_31169":881,"_21582":53734,"_5":14829,"_28301":53628,"_3051":53735},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3582":927,"_31169":881,"_21582":53737,"_5":14829,"_28301":53628,"_3051":53738},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3582":928,"_31169":881,"_21582":53740,"_5":14829,"_28301":53628,"_3051":53741},[],"`auth_mode`",{"_3582":929,"_31169":881,"_21582":53743,"_5":14829,"_28301":53628,"_3051":53744},[],"Control applied in the configured operation",{"_3582":930,"_31169":881,"_21582":53746,"_5":14829,"_28301":53628,"_3051":53747},[],"`CLIENT_CERTIFICATE`",{"_3582":931,"_31169":881,"_21582":53749,"_5":14829,"_28301":53628,"_3051":53750},[],"Presented certificate validation.",{"_3582":932,"_31169":881,"_21582":53752,"_5":14829,"_28301":53628,"_3051":53753},[],"`EXTERNAL_WEBHOOK`",{"_3582":933,"_31169":881,"_21582":53755,"_5":14829,"_28301":53628,"_3051":53756},[],"Configured webhook authorization.",{"_3582":934,"_31169":881,"_21582":53758,"_5":14829,"_28301":53628,"_3051":53759},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3582":935,"_31169":881,"_21582":53761,"_5":14829,"_28301":53628,"_3051":53762},[],"Certificate validation followed by webhook approval.",{"_3582":936,"_31169":881,"_21582":53764,"_5":14829,"_28301":53628,"_3051":53765},[],"`NO_AUTH`",{"_3582":937,"_31169":881,"_21582":53767,"_5":14829,"_28301":53628,"_3051":53768},[],"No DMS requester authentication.",{"_3582":938,"_31169":881,"_21582":53770,"_5":14829,"_28301":53628,"_3051":53771},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3582":939,"_31169":881,"_21582":53773,"_5":14829,"_28301":53628,"_3051":53774},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3582":940,"_31169":881,"_21582":53776,"_5":14829,"_28301":53628,"_3051":53777},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3582":941,"_31169":881,"_21582":53779,"_5":14829,"_28301":53628,"_3051":53780},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3582":942,"_31169":881,"_21582":53782,"_5":14829,"_28301":53632,"_3051":53783},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3582":943,"_31169":881,"_21582":53785,"_5":14829,"_28301":53632,"_3051":53786},[],"`external_webhook_settings` field",{"_3582":944,"_31169":881,"_21582":53788,"_5":14829,"_28301":53632,"_3051":53696},[],{"_3582":945,"_31169":881,"_21582":53790,"_5":14829,"_28301":53632,"_3051":53791},[],"`url`",{"_3582":946,"_31169":881,"_21582":53793,"_5":14829,"_28301":53632,"_3051":53794},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3582":947,"_31169":881,"_21582":53796,"_5":14829,"_28301":53632,"_3051":53797},[],"`method`",{"_3582":948,"_31169":881,"_21582":53799,"_5":14829,"_28301":53632,"_3051":53800},[],"`POST` or `PUT`; `POST` by default.",{"_3582":949,"_31169":881,"_21582":53802,"_5":14829,"_28301":53632,"_3051":53803},[],"`name`",{"_3582":950,"_31169":881,"_21582":53805,"_5":14829,"_28301":53632,"_3051":53806},[],"Label used in service logs.",{"_3582":951,"_31169":881,"_21582":53808,"_5":14829,"_28301":53632,"_3051":53809},[],"`config.auth_mode`",{"_3582":952,"_31169":881,"_21582":53811,"_5":14829,"_28301":53632,"_3051":53812},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3582":953,"_31169":881,"_21582":53814,"_5":14829,"_28301":53632,"_3051":53815},[],"`config.log_level`",{"_3582":954,"_31169":881,"_21582":53817,"_5":14829,"_28301":53632,"_3051":53818},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3582":955,"_31169":881,"_21582":53820,"_5":14829,"_28301":53632,"_3051":53821},[],"`config.apikey_options`",{"_3582":956,"_31169":881,"_21582":53823,"_5":14829,"_28301":53632,"_3051":53824},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3582":957,"_31169":881,"_21582":53826,"_5":14829,"_28301":53632,"_3051":53827},[],"`config.jwt_options`",{"_3582":958,"_31169":881,"_21582":53829,"_5":14829,"_28301":53632,"_3051":53830},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3582":959,"_31169":881,"_21582":53832,"_5":14829,"_28301":53632,"_3051":53833},[],"`config.mtls_options`",{"_3582":960,"_31169":881,"_21582":53835,"_5":14829,"_28301":53632,"_3051":53836},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3582":961,"_31169":881,"_21582":53838,"_5":14829,"_28301":53632,"_3051":53839},[],"`config.insecure_skip_verify`",{"_3582":962,"_31169":881,"_21582":53841,"_5":14829,"_28301":53632,"_3051":53842},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3582":963,"_31169":881,"_21582":53844,"_5":14829,"_28301":53632,"_3051":53845},[],"`config.call_timeout`",{"_3582":964,"_31169":881,"_21582":53847,"_5":14829,"_28301":53632,"_3051":53848},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3582":965,"_31169":881,"_21582":53850,"_5":14829,"_28301":53632,"_3051":53851},[],"Rules for that configuration:",{"_3582":966,"_31169":881,"_21582":53853,"_5":14829,"_28301":53632,"_3051":53854},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3582":967,"_31169":881,"_21582":53856,"_5":14829,"_28301":53632,"_3051":53857},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3582":968,"_31169":881,"_21582":53859,"_5":14829,"_28301":53632,"_3051":53860},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3582":969,"_31169":881,"_21582":53862,"_5":14829,"_28301":53632,"_3051":53863},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3582":970,"_31169":881,"_21582":53865,"_5":14829,"_28301":53632,"_3051":53866},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3582":971,"_31169":881,"_21582":53868,"_5":14829,"_28301":53632,"_3051":53869},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3582":972,"_31169":881,"_21582":53871,"_5":14829,"_28301":53632,"_3051":53872},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3582":973,"_31169":881,"_21582":53874,"_5":14829,"_28301":53632,"_3051":53875},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3582":974,"_31169":881,"_21582":53877,"_5":14829,"_28301":53632,"_3051":53878},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3582":975,"_31169":881,"_21582":53880,"_5":14829,"_28301":53636,"_3051":53881},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3582":976,"_31169":881,"_21582":53883,"_5":14829,"_28301":53640,"_3051":53884},[],"`settings.reenrollment_settings` field",{"_3582":977,"_31169":881,"_21582":53886,"_5":14829,"_28301":53640,"_3051":51227},[],{"_3582":978,"_31169":881,"_21582":53888,"_5":14829,"_28301":53640,"_3051":53889},[],"`reenrollment_delta`",{"_3582":979,"_31169":881,"_21582":53891,"_5":14829,"_28301":53640,"_3051":53892},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3582":980,"_31169":881,"_21582":53894,"_5":14829,"_28301":53640,"_3051":53895},[],"`preventive_delta`",{"_3582":981,"_31169":881,"_21582":53897,"_5":14829,"_28301":53640,"_3051":53898},[],"Preventive operational monitoring threshold.",{"_3582":982,"_31169":881,"_21582":53900,"_5":14829,"_28301":53640,"_3051":53901},[],"`critical_delta`",{"_3582":983,"_31169":881,"_21582":53903,"_5":14829,"_28301":53640,"_3051":53904},[],"Critical operational monitoring threshold.",{"_3582":984,"_31169":881,"_21582":53906,"_5":14829,"_28301":53640,"_3051":53907},[],"`enable_expired_renewal`",{"_3582":985,"_31169":881,"_21582":53909,"_5":14829,"_28301":53640,"_3051":53910},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3582":986,"_31169":881,"_21582":53912,"_5":14829,"_28301":53640,"_3051":53913},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3582":987,"_31169":881,"_21582":53915,"_5":14829,"_28301":53640,"_3051":53916},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3582":988,"_31169":881,"_21582":53918,"_5":14829,"_28301":53640,"_3051":53919},[],"`revoke_on_reenrollment`",{"_3582":989,"_31169":881,"_21582":53921,"_5":14829,"_28301":53640,"_3051":53922},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3582":990,"_31169":881,"_21582":53924,"_5":14829,"_28301":53640,"_3051":53925},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3582":991,"_31169":881,"_21582":53927,"_5":14829,"_28301":53644,"_3051":53928},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3582":992,"_31169":881,"_21582":53930,"_5":14829,"_28301":53648,"_3051":51221},[],{"_3582":993,"_31169":881,"_21582":53932,"_5":14829,"_28301":53648,"_3051":53933},[],"Published material",{"_3582":994,"_31169":881,"_21582":53935,"_5":14829,"_28301":53648,"_3051":53936},[],"**Include Lamassu System CA**",{"_3582":995,"_31169":881,"_21582":53938,"_5":14829,"_28301":53648,"_3051":53939},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3582":996,"_31169":881,"_21582":53941,"_5":14829,"_28301":53648,"_3051":53942},[],"**Include Enrollment CA**",{"_3582":997,"_31169":881,"_21582":53944,"_5":14829,"_28301":53648,"_3051":53945},[],"Selected issuing CA certificate.",{"_3582":998,"_31169":881,"_21582":53947,"_5":14829,"_28301":53648,"_3051":53948},[],"**Managed CAs**",{"_3582":999,"_31169":881,"_21582":53950,"_5":14829,"_28301":53648,"_3051":53951},[],"Explicitly selected CA certificates.",{"_3582":1000,"_31169":881,"_21582":53953,"_5":14829,"_28301":53648,"_3051":53954},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3582":1001,"_31169":881,"_21582":53956,"_5":14829,"_28301":53652,"_3051":53957},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3582":1002,"_31169":881,"_21582":53959,"_5":14829,"_28301":53652,"_3051":53960},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3582":1003,"_31169":881,"_21582":53962,"_5":14829,"_28301":53652,"_3051":53963},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3582":1004,"_31169":881,"_21582":53965,"_5":14829,"_28301":53656,"_3051":53966},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3582":1005,"_31169":1005,"_5":15200,"_3051":53968,"_31527":53969,"_21582":53970,"_28301":1005},"Integrate the EST client",[50837,52312,53326,53324,53507],[],{"_3582":1006,"_31169":1005,"_21582":53972,"_5":14829,"_28301":1005,"_3051":53973},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3582":1007,"_31169":1005,"_5":31524,"_21582":53975,"_28301":53976,"_3051":50847},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3582":1008,"_31169":1005,"_5":31524,"_21582":53978,"_28301":53979,"_3051":53980},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3582":1009,"_31169":1005,"_5":31524,"_21582":53982,"_28301":53983,"_3051":53984},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3582":1010,"_31169":1005,"_5":31524,"_21582":53986,"_28301":53987,"_3051":53988},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3582":1011,"_31169":1005,"_5":31524,"_21582":53990,"_28301":53991,"_3051":53992},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3582":1012,"_31169":1005,"_5":31524,"_21582":53994,"_28301":53995,"_3051":53996},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3582":1013,"_31169":1005,"_21582":53998,"_5":14829,"_28301":1005,"_3051":53999},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3582":1014,"_31169":1005,"_21582":54001,"_5":14829,"_28301":53976,"_3051":54002},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3582":1015,"_31169":1005,"_21582":54004,"_5":14829,"_28301":53976,"_3051":54005},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3582":1016,"_31169":1005,"_21582":54007,"_5":14829,"_28301":53976,"_3051":54008},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3582":1017,"_31169":1005,"_21582":54010,"_5":14829,"_28301":53979,"_3051":54011},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3582":1018,"_31169":1005,"_21582":54013,"_5":14829,"_28301":53979,"_3051":54014},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3582":1019,"_31169":1005,"_21582":54016,"_5":14829,"_28301":53983,"_3051":54017},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3582":1020,"_31169":1005,"_21582":54019,"_5":14829,"_28301":53983,"_3051":54020},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3582":1021,"_31169":1005,"_21582":54022,"_5":14829,"_28301":53987,"_3051":54023},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3582":1022,"_31169":1005,"_21582":54025,"_5":14829,"_28301":53987,"_3051":54026},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3582":1023,"_31169":1005,"_21582":54028,"_5":14829,"_28301":53991,"_3051":54029},[],"For a root that issues directly:",{"_3582":1024,"_31169":1005,"_21582":54031,"_5":14829,"_28301":53991,"_3051":54032},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3582":1025,"_31169":1005,"_21582":54034,"_5":14829,"_28301":53991,"_3051":54035},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3582":1026,"_31169":1005,"_21582":54037,"_5":14829,"_28301":53995,"_3051":54038},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3582":1027,"_31169":1027,"_5":15200,"_3051":54040,"_31527":54041,"_21582":54042,"_28301":1027},"EST reference",[50837,52312,53326,53324,53507],[],{"_3582":1028,"_31169":1027,"_21582":54044,"_5":14829,"_28301":1027,"_3051":54045},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3582":1029,"_31169":1027,"_5":31524,"_21582":54047,"_28301":54048,"_3051":54049},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3582":1030,"_31169":1027,"_5":31524,"_21582":54051,"_28301":54052,"_3051":23378},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3582":1031,"_31169":1027,"_5":31524,"_21582":54054,"_28301":54055,"_3051":26877},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3582":1032,"_31169":1027,"_5":31524,"_21582":54057,"_28301":54058,"_3051":26884},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3582":1033,"_31169":1027,"_5":31524,"_21582":54060,"_28301":54061,"_3051":26194},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3582":1034,"_31169":1027,"_5":31524,"_21582":54063,"_28301":54064,"_3051":54065},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3582":1035,"_31169":1027,"_5":31524,"_21582":54067,"_28301":54068,"_3051":54069},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3582":1036,"_31169":1027,"_5":31524,"_21582":54071,"_28301":54072,"_3051":54073},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3582":1037,"_31169":1027,"_21582":54075,"_5":14829,"_28301":1027,"_3051":54076},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3582":1038,"_31169":1027,"_21582":54078,"_5":14829,"_28301":54048,"_3051":54079},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3582":1039,"_31169":1027,"_21582":54081,"_5":14829,"_28301":54048,"_3051":54082},[],"Operation",{"_3582":1040,"_31169":1027,"_21582":54084,"_5":14829,"_28301":54048,"_3051":54085},[],"Method",{"_3582":1041,"_31169":1027,"_21582":54087,"_5":14829,"_28301":54048,"_3051":54088},[],"Authentication and condition",{"_3582":1042,"_31169":1027,"_21582":54090,"_5":14829,"_28301":54048,"_3051":54091},[],"`/cacerts`",{"_3582":1043,"_31169":1027,"_21582":54093,"_5":14829,"_28301":54048,"_3051":54094},[],"GET",{"_3582":1044,"_31169":1027,"_21582":54096,"_5":14829,"_28301":54048,"_3051":54097},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3582":1045,"_31169":1027,"_21582":54099,"_5":14829,"_28301":54048,"_3051":54100},[],"`/simpleenroll`",{"_3582":1046,"_31169":1027,"_21582":54102,"_5":14829,"_28301":54048,"_3051":54103},[],"POST",{"_3582":1047,"_31169":1027,"_21582":54105,"_5":14829,"_28301":54048,"_3051":54106},[],"Initial authentication and DMS registration/replacement policy.",{"_3582":1048,"_31169":1027,"_21582":54108,"_5":14829,"_28301":54048,"_3051":54109},[],"`/simplereenroll`",{"_3582":1049,"_31169":1027,"_21582":54111,"_5":14829,"_28301":54048,"_3051":54103},[],{"_3582":1050,"_31169":1027,"_21582":54113,"_5":14829,"_28301":54048,"_3051":54114},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3582":1051,"_31169":1027,"_21582":54116,"_5":14829,"_28301":54048,"_3051":54117},[],"`/serverkeygen`",{"_3582":1052,"_31169":1027,"_21582":54119,"_5":14829,"_28301":54048,"_3051":54103},[],{"_3582":1053,"_31169":1027,"_21582":54121,"_5":14829,"_28301":54048,"_3051":54122},[],"Initial authentication and admission; server generation enabled.",{"_3582":1054,"_31169":1027,"_21582":54124,"_5":14829,"_28301":54048,"_3051":54125},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3582":1055,"_31169":1027,"_21582":54127,"_5":14829,"_28301":54052,"_3051":54128},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3582":1056,"_31169":1027,"_21582":54130,"_5":14829,"_28301":54052,"_3051":54131},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3582":1057,"_31169":1027,"_21582":54133,"_5":14829,"_28301":54055,"_3051":54134},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3582":1058,"_31169":1027,"_21582":54136,"_5":14829,"_28301":54055,"_3051":54137},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3582":1059,"_31169":1027,"_21582":54139,"_5":14829,"_28301":54058,"_3051":54140},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3582":1060,"_31169":1027,"_21582":54142,"_5":14829,"_28301":54058,"_3051":54143},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3582":1061,"_31169":1027,"_21582":54145,"_5":14829,"_28301":54061,"_3051":54146},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3582":1062,"_31169":1027,"_21582":54148,"_5":14829,"_28301":54061,"_3051":54149},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3582":1063,"_31169":1027,"_21582":54151,"_5":14829,"_28301":54064,"_3051":54152},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3582":1064,"_31169":1027,"_21582":54154,"_5":14829,"_28301":54064,"_3051":54155},[],"Part",{"_3582":1065,"_31169":1027,"_21582":54157,"_5":14829,"_28301":54064,"_3051":54158},[],"Content after decoding its Base64",{"_3582":1066,"_31169":1027,"_21582":54160,"_5":14829,"_28301":54064,"_3051":54161},[],"`application/pkcs8`",{"_3582":1067,"_31169":1027,"_21582":54163,"_5":14829,"_28301":54064,"_3051":54164},[],"Unencrypted DER PKCS#8 private key.",{"_3582":1068,"_31169":1027,"_21582":54166,"_5":14829,"_28301":54064,"_3051":54167},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3582":1069,"_31169":1027,"_21582":54169,"_5":14829,"_28301":54064,"_3051":54170},[],"DER PKCS#7 containing the issued certificate.",{"_3582":1070,"_31169":1027,"_21582":54172,"_5":14829,"_28301":54064,"_3051":54173},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3582":1071,"_31169":1027,"_21582":54175,"_5":14829,"_28301":54068,"_3051":54176},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3582":1072,"_31169":1027,"_21582":54178,"_5":14829,"_28301":54068,"_3051":54179},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3582":1073,"_31169":1027,"_21582":54181,"_5":14829,"_28301":54068,"_3051":54182},[],"Convert and check the result:",{"_3582":1074,"_31169":1027,"_21582":54184,"_5":14829,"_28301":54068,"_3051":54185},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3582":1075,"_31169":1027,"_21582":54187,"_5":14829,"_28301":54072,"_3051":54188},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3582":1076,"_31169":1027,"_21582":54190,"_5":14829,"_28301":54072,"_3051":54191},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3582":1077,"_31169":1077,"_5":15200,"_3051":53507,"_31527":54193,"_21582":54194,"_28301":1077},[50837,52312,53326,53324,53507],[],{"_3582":1078,"_31169":1077,"_21582":54196,"_5":14829,"_28301":1077,"_3051":54197},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3582":1079,"_31169":1077,"_5":31524,"_21582":54199,"_28301":54200,"_3051":54201},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3582":1080,"_31169":1077,"_5":31524,"_21582":54203,"_28301":54204,"_3051":54205},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3582":1081,"_31169":1077,"_5":31524,"_21582":54207,"_28301":54208,"_3051":54209},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3582":1082,"_31169":1077,"_5":31524,"_21582":54211,"_28301":54212,"_3051":54213},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3582":1083,"_31169":1077,"_21582":54215,"_5":14829,"_28301":1077,"_3051":54216},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3582":1084,"_31169":1077,"_21582":54218,"_5":14829,"_28301":54200,"_3051":54219},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3582":1085,"_31169":1077,"_21582":54221,"_5":14829,"_28301":54200,"_3051":54222},[],"The integrator installs initial EST server trust and an admission credential.",{"_3582":1086,"_31169":1077,"_21582":54224,"_5":14829,"_28301":54200,"_3051":54225},[],"The client requests an identity for its `Device ID` through EST.",{"_3582":1087,"_31169":1077,"_21582":54227,"_5":14829,"_28301":54200,"_3051":54228},[],"Certificate, device binding and key/certificate installation are checked.",{"_3582":1088,"_31169":1077,"_21582":54230,"_5":14829,"_28301":54200,"_3051":54231},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3582":1089,"_31169":1077,"_21582":54233,"_5":14829,"_28301":54200,"_3051":54234},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3582":1090,"_31169":1077,"_21582":54236,"_5":14829,"_28301":54204,"_3051":54237},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3582":1091,"_31169":1077,"_21582":54239,"_5":14829,"_28301":54204,"_3051":54240},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3582":1092,"_31169":1077,"_21582":54242,"_5":14829,"_28301":54204,"_3051":54243},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3582":1093,"_31169":1077,"_21582":54245,"_5":14829,"_28301":54204,"_3051":54246},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3582":1094,"_31169":1077,"_21582":54248,"_5":14829,"_28301":54208,"_3051":54249},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3582":1095,"_31169":1077,"_21582":54251,"_5":14829,"_28301":54208,"_3051":54252},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3582":1096,"_31169":1077,"_21582":54254,"_5":14829,"_28301":54208,"_3051":54255},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3582":1097,"_31169":1077,"_21582":54257,"_5":14829,"_28301":54208,"_3051":54258},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3582":1098,"_31169":1077,"_21582":54260,"_5":14829,"_28301":54212,"_3051":54261},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3582":1099,"_31169":1077,"_21582":54263,"_5":14829,"_28301":54212,"_3051":54264},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3582":1100,"_31169":1100,"_5":15200,"_3051":54266,"_31527":54267,"_21582":54268,"_28301":1100},"Provisioning strategies",[50837,52312,53326,53324,53507],[],{"_3582":1101,"_31169":1100,"_21582":54270,"_5":14829,"_28301":1100,"_3051":54271},[],"Choose device registration, identity authorization and key generation.",{"_3582":1102,"_31169":1100,"_5":31524,"_21582":54273,"_28301":54274,"_3051":54275},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3582":1103,"_31169":1100,"_5":31524,"_21582":54277,"_28301":54278,"_3051":54279},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3582":1104,"_31169":1100,"_5":31524,"_21582":54281,"_28301":54282,"_3051":54283},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3582":1105,"_31169":1100,"_5":31524,"_21582":54285,"_28301":54286,"_3051":54287},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3582":1106,"_31169":1100,"_5":31524,"_21582":54289,"_28301":54290,"_3051":54291},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3582":1107,"_31169":1100,"_21582":54293,"_5":14829,"_28301":1100,"_3051":54294},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3582":1108,"_31169":1100,"_21582":54296,"_5":14829,"_28301":54274,"_3051":54297},[],"Path",{"_3582":1109,"_31169":1100,"_21582":54299,"_5":14829,"_28301":54274,"_3051":54300},[],"When the device exists",{"_3582":1110,"_31169":1100,"_21582":54302,"_5":14829,"_28301":54274,"_3051":54303},[],"What to check",{"_3582":1111,"_31169":1100,"_21582":54305,"_5":14829,"_28301":54274,"_3051":54306},[],"Manual assignment",{"_3582":1112,"_31169":1100,"_21582":54308,"_5":14829,"_28301":54274,"_3051":54309},[],"An operator creates it before associating a certificate.",{"_3582":1113,"_31169":1100,"_21582":54311,"_5":14829,"_28301":54274,"_3051":54312},[],"ID, owning DMS, certificate CN and bound serial.",{"_3582":1114,"_31169":1100,"_21582":54314,"_5":14829,"_28301":54274,"_3051":54315},[],"EST with `JITP`",{"_3582":1115,"_31169":1100,"_21582":54317,"_5":14829,"_28301":54274,"_3051":54318},[],"Created for an unknown CN during `/simpleenroll`.",{"_3582":1116,"_31169":1100,"_21582":54320,"_5":14829,"_28301":54274,"_3051":54321},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3582":1117,"_31169":1100,"_21582":54323,"_5":14829,"_28301":54274,"_3051":54324},[],"EST with `PRE_REGISTRATION`",{"_3582":1118,"_31169":1100,"_21582":54326,"_5":14829,"_28301":54274,"_3051":54327},[],"Must exist before `/simpleenroll`.",{"_3582":1119,"_31169":1100,"_21582":54329,"_5":14829,"_28301":54274,"_3051":54330},[],"Approved record, same DMS and replacement conditions for your version.",{"_3582":1120,"_31169":1100,"_21582":54332,"_5":14829,"_28301":54274,"_3051":54333},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3582":1121,"_31169":1100,"_21582":54335,"_5":14829,"_28301":54274,"_3051":54336},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3582":1122,"_31169":1100,"_21582":54338,"_5":14829,"_28301":54278,"_3051":54339},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3582":1123,"_31169":1100,"_21582":54341,"_5":14829,"_28301":54278,"_3051":54342},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3582":1124,"_31169":1100,"_21582":54344,"_5":14829,"_28301":54278,"_3051":54345},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3582":1125,"_31169":1100,"_21582":54347,"_5":14829,"_28301":54282,"_3051":54348},[],"Decide initial enrollment and re-enrollment separately:",{"_3582":1126,"_31169":1100,"_21582":54350,"_5":14829,"_28301":54282,"_3051":54351},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3582":1127,"_31169":1100,"_21582":54353,"_5":14829,"_28301":54282,"_3051":54354},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3582":1128,"_31169":1100,"_21582":54356,"_5":14829,"_28301":54282,"_3051":54357},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3582":1129,"_31169":1100,"_21582":54359,"_5":14829,"_28301":54282,"_3051":54360},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3582":1130,"_31169":1100,"_21582":54362,"_5":14829,"_28301":54282,"_3051":54363},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3582":1131,"_31169":1100,"_21582":54365,"_5":14829,"_28301":54286,"_3051":51221},[],{"_3582":1132,"_31169":1100,"_21582":54367,"_5":14829,"_28301":54286,"_3051":54368},[],"Material crossing EST",{"_3582":1133,"_31169":1100,"_21582":54370,"_5":14829,"_28301":54286,"_3051":54371},[],"Device-generated key",{"_3582":1134,"_31169":1100,"_21582":54373,"_5":14829,"_28301":54286,"_3051":54374},[],"Public CSR and certificate; the key stays on the client.",{"_3582":1135,"_31169":1100,"_21582":54376,"_5":14829,"_28301":54286,"_3051":54377},[],"Existing device key",{"_3582":1136,"_31169":1100,"_21582":54379,"_5":14829,"_28301":54286,"_3051":54380},[],"CSR signed with that key and a new certificate.",{"_3582":1137,"_31169":1100,"_21582":54382,"_5":14829,"_28301":54286,"_3051":53645},[],{"_3582":1138,"_31169":1100,"_21582":54384,"_5":14829,"_28301":54286,"_3051":54385},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3582":1139,"_31169":1100,"_21582":54387,"_5":14829,"_28301":54286,"_3051":54388},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3582":1140,"_31169":1100,"_21582":54390,"_5":14829,"_28301":54290,"_3051":54391},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3582":1141,"_31169":1141,"_5":15200,"_3051":54393,"_31527":54394,"_21582":54395,"_28301":1141},"Renewal and recovery",[50837,52312,53326,53324,53507],[],{"_3582":1142,"_31169":1141,"_21582":54397,"_5":14829,"_28301":1141,"_3051":54398},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3582":1143,"_31169":1141,"_5":31524,"_21582":54400,"_28301":54401,"_3051":54402},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3582":1144,"_31169":1141,"_5":31524,"_21582":54404,"_28301":54405,"_3051":54406},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3582":1145,"_31169":1141,"_5":31524,"_21582":54408,"_28301":54409,"_3051":54410},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3582":1146,"_31169":1141,"_5":31524,"_21582":54412,"_28301":54413,"_3051":54414},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3582":1147,"_31169":1141,"_5":31524,"_21582":54416,"_28301":54417,"_3051":54418},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3582":1148,"_31169":1141,"_21582":54420,"_5":14829,"_28301":1141,"_3051":54421},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3582":1149,"_31169":1141,"_21582":54423,"_5":14829,"_28301":54401,"_3051":54424},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3582":1150,"_31169":1141,"_21582":54426,"_5":14829,"_28301":54401,"_3051":54427},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3582":1151,"_31169":1141,"_21582":54429,"_5":14829,"_28301":54401,"_3051":54430},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3582":1152,"_31169":1141,"_21582":54432,"_5":14829,"_28301":54401,"_3051":54433},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3582":1153,"_31169":1141,"_21582":54435,"_5":14829,"_28301":54405,"_3051":54436},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3582":1154,"_31169":1141,"_21582":54438,"_5":14829,"_28301":54405,"_3051":54439},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3582":1155,"_31169":1141,"_21582":54441,"_5":14829,"_28301":54409,"_3051":54442},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3582":1156,"_31169":1141,"_21582":54444,"_5":14829,"_28301":54409,"_3051":54445},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3582":1157,"_31169":1141,"_21582":54447,"_5":14829,"_28301":54409,"_3051":54448},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3582":1158,"_31169":1141,"_21582":54450,"_5":14829,"_28301":54413,"_3051":54451},[],"Situation",{"_3582":1159,"_31169":1141,"_21582":54453,"_5":14829,"_28301":54413,"_3051":54454},[],"Procedure",{"_3582":1160,"_31169":1141,"_21582":54456,"_5":14829,"_28301":54413,"_3051":54457},[],"Valid certificate, outside the window",{"_3582":1161,"_31169":1141,"_21582":54459,"_5":14829,"_28301":54413,"_3051":54460},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3582":1162,"_31169":1141,"_21582":54462,"_5":14829,"_28301":54413,"_3051":54463},[],"Expired certificate, key available",{"_3582":1163,"_31169":1141,"_21582":54465,"_5":14829,"_28301":54413,"_3051":54466},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3582":1164,"_31169":1141,"_21582":54468,"_5":14829,"_28301":54413,"_3051":54469},[],"Renewal through webhook or `NO_AUTH`",{"_3582":1165,"_31169":1141,"_21582":54471,"_5":14829,"_28301":54413,"_3051":54472},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3582":1166,"_31169":1141,"_21582":54474,"_5":14829,"_28301":54413,"_3051":54475},[],"Lost or inaccessible key",{"_3582":1167,"_31169":1141,"_21582":54477,"_5":14829,"_28301":54413,"_3051":54478},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3582":1168,"_31169":1141,"_21582":54480,"_5":14829,"_28301":54413,"_3051":54481},[],"Current identity revoked",{"_3582":1169,"_31169":1141,"_21582":54483,"_5":14829,"_28301":54413,"_3051":54484},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3582":1170,"_31169":1141,"_21582":54486,"_5":14829,"_28301":54413,"_3051":54487},[],"Device without an identity",{"_3582":1171,"_31169":1141,"_21582":54489,"_5":14829,"_28301":54413,"_3051":54490},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3582":1172,"_31169":1141,"_21582":54492,"_5":14829,"_28301":54413,"_3051":54493},[],"Retired device",{"_3582":1173,"_31169":1141,"_21582":54495,"_5":14829,"_28301":54413,"_3051":54496},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3582":1174,"_31169":1141,"_21582":54498,"_5":14829,"_28301":54413,"_3051":54499},[],"Timeout, HTTP 500 or installation failure",{"_3582":1175,"_31169":1141,"_21582":54501,"_5":14829,"_28301":54413,"_3051":54502},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3582":1176,"_31169":1141,"_21582":54504,"_5":14829,"_28301":54417,"_3051":54505},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3582":1177,"_31169":1141,"_21582":54507,"_5":14829,"_28301":54417,"_3051":54508},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3582":1178,"_31169":1178,"_5":15200,"_3051":54510,"_31527":54511,"_21582":54512,"_28301":1178},"Enrollment troubleshooting",[50837,52312,53326,53324,53507],[],{"_3582":1179,"_31169":1178,"_21582":54514,"_5":14829,"_28301":1178,"_3051":54515},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3582":1180,"_31169":1178,"_5":31524,"_21582":54517,"_28301":54518,"_3051":54519},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3582":1181,"_31169":1178,"_5":31524,"_21582":54521,"_28301":54522,"_3051":54523},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3582":1182,"_31169":1178,"_5":31524,"_21582":54525,"_28301":54526,"_3051":54073},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3582":1183,"_31169":1178,"_5":31524,"_21582":54528,"_28301":54529,"_3051":54530},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3582":1184,"_31169":1178,"_21582":54532,"_5":14829,"_28301":1178,"_3051":54533},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3582":1185,"_31169":1178,"_21582":54535,"_5":14829,"_28301":54522,"_3051":54536},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3582":1186,"_31169":1178,"_21582":54538,"_5":14829,"_28301":54522,"_3051":54539},[],"Symptom or message",{"_3582":1187,"_31169":1178,"_21582":54541,"_5":14829,"_28301":54522,"_3051":54303},[],{"_3582":1188,"_31169":1178,"_21582":54543,"_5":14829,"_28301":54522,"_3051":54544},[],"curl rejects TLS, name or issuer",{"_3582":1189,"_31169":1178,"_21582":54546,"_5":14829,"_28301":54522,"_3051":54547},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3582":1190,"_31169":1178,"_21582":54549,"_5":14829,"_28301":54522,"_3051":54550},[],"404 or missing APS",{"_3582":1191,"_31169":1178,"_21582":54552,"_5":14829,"_28301":54522,"_3051":54553},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3582":1192,"_31169":1178,"_21582":54555,"_5":14829,"_28301":54522,"_3051":54556},[],"400, CSR or format error",{"_3582":1193,"_31169":1178,"_21582":54558,"_5":14829,"_28301":54522,"_3051":54559},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3582":1194,"_31169":1178,"_21582":54561,"_5":14829,"_28301":54522,"_3051":54562},[],"Missing credential or invalid certificate",{"_3582":1195,"_31169":1178,"_21582":54564,"_5":14829,"_28301":54522,"_3051":54565},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3582":1196,"_31169":1178,"_21582":54567,"_5":14829,"_28301":54522,"_3051":54568},[],"Webhook denies, times out or responds without authorization",{"_3582":1197,"_31169":1178,"_21582":54570,"_5":14829,"_28301":54522,"_3051":54571},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3582":1198,"_31169":1178,"_21582":54573,"_5":14829,"_28301":54522,"_3051":54574},[],"`unexpected status code: <n>: redirects are not followed`",{"_3582":1199,"_31169":1178,"_21582":54576,"_5":14829,"_28301":54522,"_3051":54577},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3582":1200,"_31169":1178,"_21582":54579,"_5":14829,"_28301":54522,"_3051":54580},[],"`webhook response exceeds 1048576 bytes`",{"_3582":1201,"_31169":1178,"_21582":54582,"_5":14829,"_28301":54522,"_3051":54583},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3582":1202,"_31169":1178,"_21582":54585,"_5":14829,"_28301":54522,"_3051":54586},[],"`webhook config must not reference files`",{"_3582":1203,"_31169":1178,"_21582":54588,"_5":14829,"_28301":54522,"_3051":54589},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3582":1204,"_31169":1178,"_21582":54591,"_5":14829,"_28301":54522,"_3051":54592},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3582":1205,"_31169":1178,"_21582":54594,"_5":14829,"_28301":54522,"_3051":54595},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3582":1206,"_31169":1178,"_21582":54597,"_5":14829,"_28301":54522,"_3051":54598},[],"`webhook mTLS certificate and key are invalid: …`",{"_3582":1207,"_31169":1178,"_21582":54600,"_5":14829,"_28301":54522,"_3051":54601},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3582":1208,"_31169":1178,"_21582":54603,"_5":14829,"_28301":54522,"_3051":54604},[],"400 `struct validation error` creating or updating a DMS",{"_3582":1209,"_31169":1178,"_21582":54606,"_5":14829,"_28301":54522,"_3051":54607},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3582":1210,"_31169":1178,"_21582":54609,"_5":14829,"_28301":54522,"_3051":54610},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3582":1211,"_31169":1178,"_21582":54612,"_5":14829,"_28301":54522,"_3051":54613},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3582":1212,"_31169":1178,"_21582":54615,"_5":14829,"_28301":54522,"_3051":54616},[],"`device not preregistered`",{"_3582":1213,"_31169":1178,"_21582":54618,"_5":14829,"_28301":54522,"_3051":54619},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3582":1214,"_31169":1178,"_21582":54621,"_5":14829,"_28301":54522,"_3051":54622},[],"`forbiddenNewEnrollment`",{"_3582":1215,"_31169":1178,"_21582":54624,"_5":14829,"_28301":54522,"_3051":54625},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3582":1216,"_31169":1178,"_21582":54627,"_5":14829,"_28301":54522,"_3051":54628},[],"Different owning DMS",{"_3582":1217,"_31169":1178,"_21582":54630,"_5":14829,"_28301":54522,"_3051":54631},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3582":1218,"_31169":1178,"_21582":54633,"_5":14829,"_28301":54522,"_3051":54634},[],"`invalid RawSubject bytes`",{"_3582":1219,"_31169":1178,"_21582":54636,"_5":14829,"_28301":54522,"_3051":54637},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3582":1220,"_31169":1178,"_21582":54639,"_5":14829,"_28301":54522,"_3051":54640},[],"`invalid reenroll window`",{"_3582":1221,"_31169":1178,"_21582":54642,"_5":14829,"_28301":54522,"_3051":54643},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3582":1222,"_31169":1178,"_21582":54645,"_5":14829,"_28301":54522,"_3051":54646},[],"Current certificate revoked",{"_3582":1223,"_31169":1178,"_21582":54648,"_5":14829,"_28301":54522,"_3051":54649},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3582":1224,"_31169":1178,"_21582":54651,"_5":14829,"_28301":54522,"_3051":54652},[],"CA, profile or signing error",{"_3582":1225,"_31169":1178,"_21582":54654,"_5":14829,"_28301":54522,"_3051":54655},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3582":1226,"_31169":1178,"_21582":54657,"_5":14829,"_28301":54522,"_3051":54658},[],"HTTP 200 without a device connection",{"_3582":1227,"_31169":1178,"_21582":54660,"_5":14829,"_28301":54522,"_3051":54661},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3582":1228,"_31169":1178,"_21582":54663,"_5":14829,"_28301":54522,"_3051":54664},[],"Timeout or error after issuance",{"_3582":1229,"_31169":1178,"_21582":54666,"_5":14829,"_28301":54522,"_3051":54667},[],"New certificates, current slot and previous identity's state before retrying.",{"_3582":1230,"_31169":1178,"_21582":54669,"_5":14829,"_28301":54526,"_3051":54670},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3582":1231,"_31169":1178,"_21582":54672,"_5":14829,"_28301":54526,"_3051":54673},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3582":1232,"_31169":1178,"_21582":54675,"_5":14829,"_28301":54529,"_3051":54676},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3582":1233,"_31169":1178,"_21582":54678,"_5":14829,"_28301":54529,"_3051":54679},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3582":1234,"_31169":1178,"_21582":54681,"_5":14829,"_28301":54529,"_3051":54682},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3582":1235,"_31169":1178,"_21582":54684,"_5":14829,"_28301":54529,"_3051":54685},[],"Make one request, save headers/body and query the device and certificates.",{"_3582":1236,"_31169":1178,"_21582":54687,"_5":14829,"_28301":54529,"_3051":54688},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3582":1237,"_31169":1178,"_21582":54690,"_5":14829,"_28301":54529,"_3051":54691},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3582":1238,"_31169":1178,"_21582":54693,"_5":14829,"_28301":54529,"_3051":54694},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3582":1239,"_31169":1239,"_5":15200,"_3051":54696,"_31527":54697,"_21582":54698,"_28301":1239},"Trust distribution and updates",[50837,52312,53326,53324,53507],[],{"_3582":1240,"_31169":1239,"_21582":54700,"_5":14829,"_28301":1239,"_3051":54701},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3582":1241,"_31169":1239,"_5":31524,"_21582":54703,"_28301":54704,"_3051":54705},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3582":1242,"_31169":1239,"_5":31524,"_21582":54707,"_28301":54708,"_3051":54709},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3582":1243,"_31169":1239,"_5":31524,"_21582":54711,"_28301":54712,"_3051":54713},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3582":1244,"_31169":1239,"_5":31524,"_21582":54715,"_28301":54716,"_3051":54717},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3582":1245,"_31169":1239,"_5":31524,"_21582":54719,"_28301":54720,"_3051":54721},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3582":1246,"_31169":1239,"_21582":54723,"_5":14829,"_28301":1239,"_3051":54724},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3582":1247,"_31169":1239,"_21582":54726,"_5":14829,"_28301":54704,"_3051":54727},[],"Relationship",{"_3582":1248,"_31169":1239,"_21582":54729,"_5":14829,"_28301":54704,"_3051":54730},[],"Material prepared by its owner",{"_3582":1249,"_31169":1239,"_21582":54732,"_5":14829,"_28301":54704,"_3051":54733},[],"Device → EST server",{"_3582":1250,"_31169":1239,"_21582":54735,"_5":14829,"_28301":54704,"_3051":54736},[],"Previously verified server root, chain or pin and TLS name.",{"_3582":1251,"_31169":1239,"_21582":54738,"_5":14829,"_28301":54704,"_3051":54739},[],"DMS → requester",{"_3582":1252,"_31169":1239,"_21582":54741,"_5":14829,"_28301":54704,"_3051":54742},[],"CAs and rules authorizing initial or renewal credentials.",{"_3582":1253,"_31169":1239,"_21582":54744,"_5":14829,"_28301":54704,"_3051":54745},[],"Consumer → device",{"_3582":1254,"_31169":1239,"_21582":54747,"_5":14829,"_28301":54704,"_3051":54748},[],"Operational identity roots, intermediates, validation and permissions.",{"_3582":1255,"_31169":1239,"_21582":54750,"_5":14829,"_28301":54704,"_3051":54751},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3582":1256,"_31169":1239,"_21582":54753,"_5":14829,"_28301":54708,"_3051":54754},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3582":1257,"_31169":1239,"_21582":54756,"_5":14829,"_28301":54708,"_3051":54757},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3582":1258,"_31169":1239,"_21582":54759,"_5":14829,"_28301":54712,"_3051":54760},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3582":1259,"_31169":1239,"_21582":54762,"_5":14829,"_28301":54712,"_3051":54763},[],"Select policy-approved roots as anchors.",{"_3582":1260,"_31169":1239,"_21582":54765,"_5":14829,"_28301":54712,"_3051":54766},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3582":1261,"_31169":1239,"_21582":54768,"_5":14829,"_28301":54712,"_3051":54769},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3582":1262,"_31169":1239,"_21582":54771,"_5":14829,"_28301":54712,"_3051":54772},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3582":1263,"_31169":1239,"_21582":54774,"_5":14829,"_28301":54712,"_3051":54775},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3582":1264,"_31169":1239,"_21582":54777,"_5":14829,"_28301":54716,"_3051":54778},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3582":1265,"_31169":1239,"_21582":54780,"_5":14829,"_28301":54716,"_3051":54781},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3582":1266,"_31169":1239,"_21582":54783,"_5":14829,"_28301":54716,"_3051":54784},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3582":1267,"_31169":1239,"_21582":54786,"_5":14829,"_28301":54720,"_3051":54787},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3582":1268,"_31169":1268,"_5":15200,"_3051":54789,"_31527":54790,"_21582":54792,"_28301":1268},"AWS IoT Core",[50837,52312,53326,53324,54791],"Integrations",[],{"_3582":1269,"_31169":1268,"_21582":54794,"_5":14829,"_28301":1268,"_3051":54795},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3582":1270,"_31169":1268,"_5":31524,"_21582":54797,"_28301":54798,"_3051":54799},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3582":1271,"_31169":1268,"_5":31524,"_21582":54801,"_28301":54802,"_3051":54803},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3582":1272,"_31169":1268,"_5":31524,"_21582":54805,"_28301":54806,"_3051":54807},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3582":1273,"_31169":1268,"_5":31524,"_21582":54809,"_28301":54810,"_3051":54811},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3582":1274,"_31169":1268,"_5":31524,"_21582":54813,"_28301":54814,"_3051":54815},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3582":1275,"_31169":1268,"_5":31524,"_21582":54817,"_28301":54818,"_3051":54819},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3582":1276,"_31169":1268,"_5":31524,"_21582":54821,"_28301":54822,"_3051":54823},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3582":1277,"_31169":1268,"_5":31524,"_21582":54825,"_28301":54826,"_3051":54827},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3582":1278,"_31169":1268,"_5":31524,"_21582":54829,"_28301":54830,"_3051":54831},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3582":1279,"_31169":1268,"_5":31524,"_21582":54833,"_28301":54834,"_3051":54835},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3582":1280,"_31169":1268,"_5":31524,"_21582":54837,"_28301":54838,"_3051":54839},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3582":1281,"_31169":1268,"_5":31524,"_21582":54841,"_28301":54842,"_3051":54843},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3582":1282,"_31169":1268,"_5":31524,"_21582":54845,"_28301":54846,"_3051":54847},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3582":1283,"_31169":1268,"_5":31524,"_21582":54849,"_28301":54850,"_3051":54851},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3582":1284,"_31169":1268,"_5":31524,"_21582":54853,"_28301":54854,"_3051":54855},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3582":1285,"_31169":1268,"_5":31524,"_21582":54857,"_28301":54858,"_3051":54859},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3582":1286,"_31169":1268,"_5":31524,"_21582":54861,"_28301":54862,"_3051":54863},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3582":1287,"_31169":1268,"_5":31524,"_21582":54865,"_28301":54866,"_3051":54867},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3582":1288,"_31169":1268,"_5":31524,"_21582":54869,"_28301":54870,"_3051":54871},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3582":1289,"_31169":1268,"_5":31524,"_21582":54873,"_28301":54874,"_3051":54875},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3582":1290,"_31169":1268,"_5":31524,"_21582":54877,"_28301":54878,"_3051":54879},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3582":1291,"_31169":1268,"_5":31524,"_21582":54881,"_28301":54882,"_3051":54883},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3582":1292,"_31169":1268,"_5":31524,"_21582":54885,"_28301":54886,"_3051":54887},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3582":1293,"_31169":1268,"_5":31524,"_21582":54889,"_28301":54890,"_3051":54891},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3582":1294,"_31169":1268,"_5":31524,"_21582":54893,"_28301":54894,"_3051":54895},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3582":1295,"_31169":1268,"_21582":54897,"_5":14829,"_28301":1268,"_3051":54898},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3582":1296,"_31169":1268,"_21582":54900,"_5":14829,"_28301":1268,"_3051":54901},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3582":1297,"_31169":1268,"_21582":54903,"_5":14829,"_28301":1268,"_3051":54904},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3582":1298,"_31169":1268,"_21582":54906,"_5":14829,"_28301":54798,"_3051":54907},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3582":1299,"_31169":1268,"_21582":54909,"_5":14829,"_28301":54798,"_3051":54910},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3582":1300,"_31169":1268,"_21582":54912,"_5":14829,"_28301":54798,"_3051":54913},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3582":1301,"_31169":1268,"_21582":54915,"_5":14829,"_28301":54798,"_3051":54916},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3582":1302,"_31169":1268,"_21582":54918,"_5":14829,"_28301":54802,"_3051":54919},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3582":1303,"_31169":1268,"_21582":54921,"_5":14829,"_28301":54806,"_3051":54922},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3582":1304,"_31169":1268,"_21582":54924,"_5":14829,"_28301":54806,"_3051":54925},[],"IAM action",{"_3582":1305,"_31169":1268,"_21582":54927,"_5":14829,"_28301":54806,"_3051":51227},[],{"_3582":1306,"_31169":1268,"_21582":54929,"_5":14829,"_28301":54806,"_3051":54930},[],"`iot:GetRegistrationCode`",{"_3582":1307,"_31169":1268,"_21582":54932,"_5":14829,"_28301":54806,"_3051":54933},[],"Obtain the verification code for CA registration in the Primary Account",{"_3582":1308,"_31169":1268,"_21582":54935,"_5":14829,"_28301":54806,"_3051":54936},[],"`iot:RegisterCACertificate`",{"_3582":1309,"_31169":1268,"_21582":54938,"_5":14829,"_28301":54806,"_3051":54939},[],"Register the CA in AWS IoT",{"_3582":1310,"_31169":1268,"_21582":54941,"_5":14829,"_28301":54806,"_3051":54942},[],"`iot:DescribeCACertificate`",{"_3582":1311,"_31169":1268,"_21582":54944,"_5":14829,"_28301":54806,"_3051":54945},[],"Check the CA registration status",{"_3582":1312,"_31169":1268,"_21582":54947,"_5":14829,"_28301":54806,"_3051":54948},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3582":1313,"_31169":1268,"_21582":54950,"_5":14829,"_28301":54806,"_3051":54951},[],"Create or update Things in IoT Core",{"_3582":1314,"_31169":1268,"_21582":54953,"_5":14829,"_28301":54806,"_3051":54954},[],"`iot:RegisterThing`",{"_3582":1315,"_31169":1268,"_21582":54956,"_5":14829,"_28301":54806,"_3051":54957},[],"Provision Things through a template",{"_3582":1316,"_31169":1268,"_21582":54959,"_5":14829,"_28301":54806,"_3051":54960},[],"`iot:RegisterCertificate`",{"_3582":1317,"_31169":1268,"_21582":54962,"_5":14829,"_28301":54806,"_3051":54963},[],"Register device certificates",{"_3582":1318,"_31169":1268,"_21582":54965,"_5":14829,"_28301":54806,"_3051":54966},[],"`iot:UpdateCertificate`",{"_3582":1319,"_31169":1268,"_21582":54968,"_5":14829,"_28301":54806,"_3051":54969},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3582":1320,"_31169":1268,"_21582":54971,"_5":14829,"_28301":54806,"_3051":54972},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3582":1321,"_31169":1268,"_21582":54974,"_5":14829,"_28301":54806,"_3051":54975},[],"Create and attach IoT policies",{"_3582":1322,"_31169":1268,"_21582":54977,"_5":14829,"_28301":54806,"_3051":54978},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3582":1323,"_31169":1268,"_21582":54980,"_5":14829,"_28301":54806,"_3051":54981},[],"Manage Thing groups",{"_3582":1324,"_31169":1268,"_21582":54983,"_5":14829,"_28301":54806,"_3051":54984},[],"`iot:CreateProvisioningTemplate`",{"_3582":1325,"_31169":1268,"_21582":54986,"_5":14829,"_28301":54806,"_3051":54987},[],"Create JITP templates",{"_3582":1326,"_31169":1268,"_21582":54989,"_5":14829,"_28301":54806,"_3051":54990},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3582":1327,"_31169":1268,"_21582":54992,"_5":14829,"_28301":54806,"_3051":54993},[],"Read and write the Device Shadow",{"_3582":1328,"_31169":1268,"_21582":54995,"_5":14829,"_28301":54806,"_3051":54996},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3582":1329,"_31169":1268,"_21582":54998,"_5":14829,"_28301":54810,"_3051":54999},[],"Parameter",{"_3582":1330,"_31169":1268,"_21582":55001,"_5":14829,"_28301":54810,"_3051":55002},[],"Type",{"_3582":1331,"_31169":1268,"_21582":55004,"_5":14829,"_28301":54810,"_3051":55005},[],"Required",{"_3582":1332,"_31169":1268,"_21582":55007,"_5":14829,"_28301":54810,"_3051":55008},[],"Description",{"_3582":1333,"_31169":1268,"_21582":55010,"_5":14829,"_28301":54810,"_3051":55011},[],"`connector_id`",{"_3582":1334,"_31169":1268,"_21582":55013,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1335,"_31169":1268,"_21582":55015,"_5":14829,"_28301":54810,"_3051":55016},[],"Yes",{"_3582":1336,"_31169":1268,"_21582":55018,"_5":14829,"_28301":54810,"_3051":55019},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3582":1337,"_31169":1268,"_21582":55021,"_5":14829,"_28301":54810,"_3051":55022},[],"`aws_config.region`",{"_3582":1338,"_31169":1268,"_21582":55024,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1339,"_31169":1268,"_21582":55026,"_5":14829,"_28301":54810,"_3051":55016},[],{"_3582":1340,"_31169":1268,"_21582":55028,"_5":14829,"_28301":54810,"_3051":55029},[],"AWS region where the connector operates.",{"_3582":1341,"_31169":1268,"_21582":55031,"_5":14829,"_28301":54810,"_3051":55032},[],"`aws_config.auth_method`",{"_3582":1342,"_31169":1268,"_21582":55034,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1343,"_31169":1268,"_21582":55036,"_5":14829,"_28301":54810,"_3051":55016},[],{"_3582":1344,"_31169":1268,"_21582":55038,"_5":14829,"_28301":54810,"_3051":55039},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3582":1345,"_31169":1268,"_21582":55041,"_5":14829,"_28301":54810,"_3051":55042},[],"`aws_config.access_key_id`",{"_3582":1346,"_31169":1268,"_21582":55044,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1347,"_31169":1268,"_21582":55046,"_5":14829,"_28301":54810,"_3051":55047},[],"Only with `auth_method=static`",{"_3582":1348,"_31169":1268,"_21582":55049,"_5":14829,"_28301":54810,"_3051":55050},[],"AWS access key.",{"_3582":1349,"_31169":1268,"_21582":55052,"_5":14829,"_28301":54810,"_3051":55053},[],"`aws_config.secret_access_key`",{"_3582":1350,"_31169":1268,"_21582":55055,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1351,"_31169":1268,"_21582":55057,"_5":14829,"_28301":54810,"_3051":55047},[],{"_3582":1352,"_31169":1268,"_21582":55059,"_5":14829,"_28301":54810,"_3051":55060},[],"AWS secret key.",{"_3582":1353,"_31169":1268,"_21582":55062,"_5":14829,"_28301":54810,"_3051":55063},[],"`aws_config.session_token`",{"_3582":1354,"_31169":1268,"_21582":55065,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1355,"_31169":1268,"_21582":55067,"_5":14829,"_28301":54810,"_3051":55068},[],"No",{"_3582":1356,"_31169":1268,"_21582":55070,"_5":14829,"_28301":54810,"_3051":55071},[],"Session token (with `auth_method=static`).",{"_3582":1357,"_31169":1268,"_21582":55073,"_5":14829,"_28301":54810,"_3051":55074},[],"`aws_config.role_arn`",{"_3582":1358,"_31169":1268,"_21582":55076,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1359,"_31169":1268,"_21582":55078,"_5":14829,"_28301":54810,"_3051":55079},[],"Only with `auth_method=role`",{"_3582":1360,"_31169":1268,"_21582":55081,"_5":14829,"_28301":54810,"_3051":55082},[],"ARN of the role to assume.",{"_3582":1361,"_31169":1268,"_21582":55084,"_5":14829,"_28301":54810,"_3051":55085},[],"`aws_config.endpoint_url`",{"_3582":1362,"_31169":1268,"_21582":55087,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1363,"_31169":1268,"_21582":55089,"_5":14829,"_28301":54810,"_3051":55068},[],{"_3582":1364,"_31169":1268,"_21582":55091,"_5":14829,"_28301":54810,"_3051":55092},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3582":1365,"_31169":1268,"_21582":55094,"_5":14829,"_28301":54810,"_3051":55095},[],"`subscriber_event_bus`",{"_3582":1366,"_31169":1268,"_21582":55097,"_5":14829,"_28301":54810,"_3051":18193},[],{"_3582":1367,"_31169":1268,"_21582":55099,"_5":14829,"_28301":54810,"_3051":55016},[],{"_3582":1368,"_31169":1268,"_21582":55101,"_5":14829,"_28301":54810,"_3051":55102},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3582":1369,"_31169":1268,"_21582":55104,"_5":14829,"_28301":54810,"_3051":55105},[],"`dms_manager_client`",{"_3582":1370,"_31169":1268,"_21582":55107,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1371,"_31169":1268,"_21582":55109,"_5":14829,"_28301":54810,"_3051":55016},[],{"_3582":1372,"_31169":1268,"_21582":55111,"_5":14829,"_28301":54810,"_3051":55112},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3582":1373,"_31169":1268,"_21582":55114,"_5":14829,"_28301":54810,"_3051":55115},[],"`device_manager_client`",{"_3582":1374,"_31169":1268,"_21582":55117,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1375,"_31169":1268,"_21582":55119,"_5":14829,"_28301":54810,"_3051":55016},[],{"_3582":1376,"_31169":1268,"_21582":55121,"_5":14829,"_28301":54810,"_3051":55122},[],"HTTP URL of Lamassu's Device Manager.",{"_3582":1377,"_31169":1268,"_21582":55124,"_5":14829,"_28301":54810,"_3051":55125},[],"`ca_client`",{"_3582":1378,"_31169":1268,"_21582":55127,"_5":14829,"_28301":54810,"_3051":25834},[],{"_3582":1379,"_31169":1268,"_21582":55129,"_5":14829,"_28301":54810,"_3051":55016},[],{"_3582":1380,"_31169":1268,"_21582":55131,"_5":14829,"_28301":54810,"_3051":55132},[],"HTTP URL of Lamassu's CA service.",{"_3582":1381,"_31169":1268,"_21582":55134,"_5":14829,"_28301":54814,"_3051":55135},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3582":1382,"_31169":1268,"_21582":55137,"_5":14829,"_28301":54814,"_3051":55138},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3582":1383,"_31169":1268,"_21582":55140,"_5":14829,"_28301":54814,"_3051":55141},[],"CloudEvent type",{"_3582":1384,"_31169":1268,"_21582":55143,"_5":14829,"_28301":54814,"_3051":55144},[],"Lamassu resource",{"_3582":1385,"_31169":1268,"_21582":55146,"_5":14829,"_28301":54814,"_3051":55147},[],"AWS Resource",{"_3582":1386,"_31169":1268,"_21582":55149,"_5":14829,"_28301":54814,"_3051":55150},[],"IAM actions",{"_3582":1387,"_31169":1268,"_21582":55152,"_5":14829,"_28301":54814,"_3051":55153},[],"AWS calls and effect",{"_3582":1388,"_31169":1268,"_21582":55155,"_5":14829,"_28301":54814,"_3051":55156},[],"Where in this page",{"_3582":1389,"_31169":1268,"_21582":55158,"_5":14829,"_28301":54814,"_3051":55159},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3582":1390,"_31169":1268,"_21582":55161,"_5":14829,"_28301":54814,"_3051":55162},[],"CA",{"_3582":1391,"_31169":1268,"_21582":55164,"_5":14829,"_28301":54814,"_3051":55165},[],"`IoTCore/CACertificate`",{"_3582":1392,"_31169":1268,"_21582":55167,"_5":14829,"_28301":54814,"_3051":55168},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3582":1393,"_31169":1268,"_21582":55170,"_5":14829,"_28301":54814,"_3051":55171},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3582":1394,"_31169":1268,"_21582":55173,"_5":14829,"_28301":54814,"_3051":54827},[],{"_3582":1395,"_31169":1268,"_21582":55175,"_5":14829,"_28301":54814,"_3051":55176},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3582":1396,"_31169":1268,"_21582":55178,"_5":14829,"_28301":54814,"_3051":55179},[],"DMS",{"_3582":1397,"_31169":1268,"_21582":55181,"_5":14829,"_28301":54814,"_3051":55182},[],"`IoTCore/ProvisioningTemplate`",{"_3582":1398,"_31169":1268,"_21582":55184,"_5":14829,"_28301":54814,"_3051":55185},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3582":1399,"_31169":1268,"_21582":55187,"_5":14829,"_28301":54814,"_3051":55188},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3582":1400,"_31169":1268,"_21582":55190,"_5":14829,"_28301":54814,"_3051":54855},[],{"_3582":1401,"_31169":1268,"_21582":55192,"_5":14829,"_28301":54814,"_3051":55193},[],"`EventBindDeviceIdentityKey`",{"_3582":1402,"_31169":1268,"_21582":55195,"_5":14829,"_28301":54814,"_3051":55196},[],"Device",{"_3582":1403,"_31169":1268,"_21582":55198,"_5":14829,"_28301":54814,"_3051":55199},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3582":1404,"_31169":1268,"_21582":55201,"_5":14829,"_28301":54814,"_3051":55202},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3582":1405,"_31169":1268,"_21582":55204,"_5":14829,"_28301":54814,"_3051":55205},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3582":1406,"_31169":1268,"_21582":55207,"_5":14829,"_28301":54814,"_3051":54863},[],{"_3582":1407,"_31169":1268,"_21582":55209,"_5":14829,"_28301":54814,"_3051":55210},[],"`EventUpdateCertificateStatusKey`",{"_3582":1408,"_31169":1268,"_21582":55212,"_5":14829,"_28301":54814,"_3051":55213},[],"Certificate",{"_3582":1409,"_31169":1268,"_21582":55215,"_5":14829,"_28301":54814,"_3051":55216},[],"`IoTCore/Certificate`",{"_3582":1410,"_31169":1268,"_21582":55218,"_5":14829,"_28301":54814,"_3051":55219},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3582":1411,"_31169":1268,"_21582":55221,"_5":14829,"_28301":54814,"_3051":55222},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3582":1412,"_31169":1268,"_21582":55224,"_5":14829,"_28301":54814,"_3051":54875},[],{"_3582":1413,"_31169":1268,"_21582":55226,"_5":14829,"_28301":54814,"_3051":55227},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3582":1414,"_31169":1268,"_21582":55229,"_5":14829,"_28301":54814,"_3051":55230},[],"Certificate / Device",{"_3582":1415,"_31169":1268,"_21582":55232,"_5":14829,"_28301":54814,"_3051":55233},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3582":1416,"_31169":1268,"_21582":55235,"_5":14829,"_28301":54814,"_3051":51233},[],{"_3582":1417,"_31169":1268,"_21582":55237,"_5":14829,"_28301":54814,"_3051":55238},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3582":1418,"_31169":1268,"_21582":55240,"_5":14829,"_28301":54814,"_3051":54883},[],{"_3582":1419,"_31169":1268,"_21582":55242,"_5":14829,"_28301":54818,"_3051":55243},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3582":1420,"_31169":1268,"_21582":55245,"_5":14829,"_28301":54822,"_3051":55246},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3582":1421,"_31169":1268,"_21582":55248,"_5":14829,"_28301":54822,"_3051":55249},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3582":1422,"_31169":1268,"_21582":55251,"_5":14829,"_28301":54826,"_3051":55252},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3582":1423,"_31169":1268,"_21582":55254,"_5":14829,"_28301":54826,"_3051":55255},[],"Transition",{"_3582":1424,"_31169":1268,"_21582":55257,"_5":14829,"_28301":54826,"_3051":55258},[],"AWS calls",{"_3582":1425,"_31169":1268,"_21582":55260,"_5":14829,"_28301":54826,"_3051":55261},[],"`NotRegistered` → `Requested`",{"_3582":1426,"_31169":1268,"_21582":55263,"_5":14829,"_28301":54826,"_3051":55264},[],"none (metadata write only)",{"_3582":1427,"_31169":1268,"_21582":55266,"_5":14829,"_28301":54826,"_3051":55267},[],"`Requested` → `Registering`",{"_3582":1428,"_31169":1268,"_21582":55269,"_5":14829,"_28301":54826,"_3051":55270},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3582":1429,"_31169":1268,"_21582":55272,"_5":14829,"_28301":54826,"_3051":55273},[],"`Registering` → `Succeeded`",{"_3582":1430,"_31169":1268,"_21582":55275,"_5":14829,"_28301":54826,"_3051":55276},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3582":1431,"_31169":1268,"_21582":55278,"_5":14829,"_28301":54826,"_3051":55279},[],"`Registering` → `Failed`",{"_3582":1432,"_31169":1268,"_21582":55281,"_5":14829,"_28301":54826,"_3051":55282},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3582":1433,"_31169":1268,"_21582":55284,"_5":14829,"_28301":54826,"_3051":55285},[],"`Failed` / `Succeeded` → `Requested`",{"_3582":1434,"_31169":1268,"_21582":55287,"_5":14829,"_28301":54826,"_3051":55288},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3582":1435,"_31169":1268,"_21582":55290,"_5":14829,"_28301":54830,"_3051":55291},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3582":1436,"_31169":1268,"_21582":55293,"_5":14829,"_28301":54830,"_3051":55294},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3582":1437,"_31169":1268,"_21582":55296,"_5":14829,"_28301":54830,"_3051":55297},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3582":1438,"_31169":1268,"_21582":55299,"_5":14829,"_28301":54830,"_3051":55300},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3582":1439,"_31169":1268,"_21582":55302,"_5":14829,"_28301":54830,"_3051":55303},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3582":1440,"_31169":1268,"_21582":55305,"_5":14829,"_28301":54830,"_3051":55306},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3582":1441,"_31169":1268,"_21582":55308,"_5":14829,"_28301":54834,"_3051":55309},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3582":1442,"_31169":1268,"_21582":55311,"_5":14829,"_28301":54838,"_3051":55312},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3582":1443,"_31169":1268,"_21582":55314,"_5":14829,"_28301":54838,"_3051":55315},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3582":1444,"_31169":1268,"_21582":55317,"_5":14829,"_28301":54842,"_3051":55318},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3582":1445,"_31169":1268,"_21582":55320,"_5":14829,"_28301":54846,"_3051":55321},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3582":1446,"_31169":1268,"_21582":55323,"_5":14829,"_28301":54846,"_3051":55324},[],"Creates or updates the IoT policies configured in the DMS.",{"_3582":1447,"_31169":1268,"_21582":55326,"_5":14829,"_28301":54846,"_3051":55327},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3582":1448,"_31169":1268,"_21582":55329,"_5":14829,"_28301":54846,"_3051":55330},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3582":1449,"_31169":1268,"_21582":55332,"_5":14829,"_28301":54846,"_3051":55333},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3582":1450,"_31169":1268,"_21582":55335,"_5":14829,"_28301":54846,"_3051":55336},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3582":1451,"_31169":1268,"_21582":55338,"_5":14829,"_28301":54846,"_3051":55339},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3582":1452,"_31169":1268,"_21582":55341,"_5":14829,"_28301":54850,"_3051":55342},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3582":1453,"_31169":1268,"_21582":55344,"_5":14829,"_28301":54850,"_3051":55345},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3582":1454,"_31169":1268,"_21582":55347,"_5":14829,"_28301":54850,"_3051":55348},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3582":1455,"_31169":1268,"_21582":55350,"_5":14829,"_28301":54850,"_3051":55351},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3582":1456,"_31169":1268,"_21582":55353,"_5":14829,"_28301":54850,"_3051":55354},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3582":1457,"_31169":1268,"_21582":55356,"_5":14829,"_28301":54854,"_3051":55357},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3582":1458,"_31169":1268,"_21582":55359,"_5":14829,"_28301":54854,"_3051":55255},[],{"_3582":1459,"_31169":1268,"_21582":55361,"_5":14829,"_28301":54854,"_3051":55258},[],{"_3582":1460,"_31169":1268,"_21582":55363,"_5":14829,"_28301":54854,"_3051":55364},[],"`Unconfigured` → `None` / `Auto`",{"_3582":1461,"_31169":1268,"_21582":55366,"_5":14829,"_28301":54854,"_3051":55367},[],"none (configuration only)",{"_3582":1462,"_31169":1268,"_21582":55369,"_5":14829,"_28301":54854,"_3051":55370},[],"`None` ↔ `Auto`",{"_3582":1463,"_31169":1268,"_21582":55372,"_5":14829,"_28301":54854,"_3051":55367},[],{"_3582":1464,"_31169":1268,"_21582":55374,"_5":14829,"_28301":54854,"_3051":55375},[],"Any → `Jitp`",{"_3582":1465,"_31169":1268,"_21582":55377,"_5":14829,"_28301":54854,"_3051":55378},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3582":1466,"_31169":1268,"_21582":55380,"_5":14829,"_28301":54854,"_3051":55381},[],"`Jitp` → `None` / `Auto`",{"_3582":1467,"_31169":1268,"_21582":55383,"_5":14829,"_28301":54854,"_3051":55384},[],"none (the template stays in the AWS account)",{"_3582":1468,"_31169":1268,"_21582":55386,"_5":14829,"_28301":54858,"_3051":55387},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3582":1469,"_31169":1268,"_21582":55389,"_5":14829,"_28301":54858,"_3051":55390},[],"The full flow from the device's perspective is:",{"_3582":1470,"_31169":1268,"_21582":55392,"_5":14829,"_28301":54858,"_3051":55393},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3582":1471,"_31169":1268,"_21582":55395,"_5":14829,"_28301":54862,"_3051":55396},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3582":1472,"_31169":1268,"_21582":55398,"_5":14829,"_28301":54862,"_3051":55255},[],{"_3582":1473,"_31169":1268,"_21582":55400,"_5":14829,"_28301":54862,"_3051":55258},[],{"_3582":1474,"_31169":1268,"_21582":55402,"_5":14829,"_28301":54862,"_3051":55403},[],"`Absent` → `Provisioned`",{"_3582":1475,"_31169":1268,"_21582":55405,"_5":14829,"_28301":54862,"_3051":55406},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3582":1476,"_31169":1268,"_21582":55408,"_5":14829,"_28301":54862,"_3051":55409},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3582":1477,"_31169":1268,"_21582":55411,"_5":14829,"_28301":54862,"_3051":55412},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3582":1478,"_31169":1268,"_21582":55414,"_5":14829,"_28301":54862,"_3051":55415},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3582":1479,"_31169":1268,"_21582":55417,"_5":14829,"_28301":54866,"_3051":55418},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3582":1480,"_31169":1268,"_21582":55420,"_5":14829,"_28301":54866,"_3051":55421},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3582":1481,"_31169":1268,"_21582":55423,"_5":14829,"_28301":54866,"_3051":55424},[],"For the JITP flow to work correctly:",{"_3582":1482,"_31169":1268,"_21582":55426,"_5":14829,"_28301":54866,"_3051":55427},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3582":1483,"_31169":1268,"_21582":55429,"_5":14829,"_28301":54866,"_3051":55430},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3582":1484,"_31169":1268,"_21582":55432,"_5":14829,"_28301":54866,"_3051":55433},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3582":1485,"_31169":1268,"_21582":55435,"_5":14829,"_28301":54866,"_3051":55436},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3582":1486,"_31169":1268,"_21582":55438,"_5":14829,"_28301":54870,"_3051":55439},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3582":1487,"_31169":1268,"_21582":55441,"_5":14829,"_28301":54870,"_3051":55442},[],"Status in Lamassu",{"_3582":1488,"_31169":1268,"_21582":55444,"_5":14829,"_28301":54870,"_3051":55445},[],"Revocation reason",{"_3582":1489,"_31169":1268,"_21582":55447,"_5":14829,"_28301":54870,"_3051":55448},[],"Status in AWS IoT Core",{"_3582":1490,"_31169":1268,"_21582":55450,"_5":14829,"_28301":54870,"_3051":55451},[],"`Active`",{"_3582":1491,"_31169":1268,"_21582":55453,"_5":14829,"_28301":54870,"_3051":55454},[],"None",{"_3582":1492,"_31169":1268,"_21582":55456,"_5":14829,"_28301":54870,"_3051":55457},[],"`ACTIVE`",{"_3582":1493,"_31169":1268,"_21582":55459,"_5":14829,"_28301":54870,"_3051":55460},[],"`Revoked`",{"_3582":1494,"_31169":1268,"_21582":55462,"_5":14829,"_28301":54870,"_3051":55463},[],"`certificateHold`",{"_3582":1495,"_31169":1268,"_21582":55465,"_5":14829,"_28301":54870,"_3051":55466},[],"`INACTIVE`",{"_3582":1496,"_31169":1268,"_21582":55468,"_5":14829,"_28301":54870,"_3051":55460},[],{"_3582":1497,"_31169":1268,"_21582":55470,"_5":14829,"_28301":54870,"_3051":55471},[],"Any other reason",{"_3582":1498,"_31169":1268,"_21582":55473,"_5":14829,"_28301":54870,"_3051":55474},[],"`REVOKED`",{"_3582":1499,"_31169":1268,"_21582":55476,"_5":14829,"_28301":54870,"_3051":55477},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3582":1500,"_31169":1268,"_21582":55479,"_5":14829,"_28301":54874,"_3051":55480},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3582":1501,"_31169":1268,"_21582":55482,"_5":14829,"_28301":54874,"_3051":55255},[],{"_3582":1502,"_31169":1268,"_21582":55484,"_5":14829,"_28301":54874,"_3051":55258},[],{"_3582":1503,"_31169":1268,"_21582":55486,"_5":14829,"_28301":54874,"_3051":55487},[],"`NotSynced` → `Active`",{"_3582":1504,"_31169":1268,"_21582":55489,"_5":14829,"_28301":54874,"_3051":54966},[],{"_3582":1505,"_31169":1268,"_21582":55491,"_5":14829,"_28301":54874,"_3051":55492},[],"`Active` → `Inactive`",{"_3582":1506,"_31169":1268,"_21582":55494,"_5":14829,"_28301":54874,"_3051":55495},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3582":1507,"_31169":1268,"_21582":55497,"_5":14829,"_28301":54874,"_3051":55498},[],"`Active` → `Revoked`",{"_3582":1508,"_31169":1268,"_21582":55500,"_5":14829,"_28301":54874,"_3051":55495},[],{"_3582":1509,"_31169":1268,"_21582":55502,"_5":14829,"_28301":54874,"_3051":55503},[],"`Inactive` / `Revoked` → `Active`",{"_3582":1510,"_31169":1268,"_21582":55505,"_5":14829,"_28301":54874,"_3051":54966},[],{"_3582":1511,"_31169":1268,"_21582":55507,"_5":14829,"_28301":54874,"_3051":55508},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3582":1512,"_31169":1268,"_21582":55510,"_5":14829,"_28301":54874,"_3051":55511},[],"none (these states are not synced to AWS)",{"_3582":1513,"_31169":1268,"_21582":55513,"_5":14829,"_28301":54878,"_3051":55514},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3582":1514,"_31169":1268,"_21582":55516,"_5":14829,"_28301":54878,"_3051":55517},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3582":1515,"_31169":1268,"_21582":55519,"_5":14829,"_28301":54878,"_3051":55520},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3582":1516,"_31169":1268,"_21582":55522,"_5":14829,"_28301":54882,"_3051":55523},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3582":1517,"_31169":1268,"_21582":55525,"_5":14829,"_28301":54882,"_3051":55526},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3582":1518,"_31169":1268,"_21582":55528,"_5":14829,"_28301":54886,"_3051":55529},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3582":1519,"_31169":1268,"_21582":55531,"_5":14829,"_28301":54886,"_3051":55532},[],"There are two action types:",{"_3582":1520,"_31169":1268,"_21582":55534,"_5":14829,"_28301":54886,"_3051":55535},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3582":1521,"_31169":1268,"_21582":55537,"_5":14829,"_28301":54886,"_3051":55538},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3582":1522,"_31169":1268,"_21582":55540,"_5":14829,"_28301":54886,"_3051":55541},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3582":1523,"_31169":1268,"_21582":55543,"_5":14829,"_28301":54890,"_3051":55544},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3582":1524,"_31169":1268,"_21582":55546,"_5":14829,"_28301":54890,"_3051":55547},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3582":1525,"_31169":1268,"_21582":55549,"_5":14829,"_28301":54890,"_3051":55550},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3582":1526,"_31169":1268,"_21582":55552,"_5":14829,"_28301":54894,"_3051":55553},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3582":1527,"_31169":1268,"_21582":55555,"_5":14829,"_28301":54894,"_3051":55556},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3582":1528,"_31169":1268,"_21582":55558,"_5":14829,"_28301":54894,"_3051":55559},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3582":1529,"_31169":1268,"_21582":55561,"_5":14829,"_28301":54894,"_3051":55562},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3582":1530,"_31169":1268,"_21582":55564,"_5":14829,"_28301":54894,"_3051":55565},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3582":1531,"_31169":1268,"_21582":55567,"_5":14829,"_28301":54894,"_3051":55568},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3582":1532,"_31169":1268,"_21582":55570,"_5":14829,"_28301":54894,"_3051":55571},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3582":1533,"_31169":1268,"_21582":55573,"_5":14829,"_28301":54894,"_3051":55574},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3582":1534,"_31169":1268,"_21582":55576,"_5":14829,"_28301":54894,"_3051":55577},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3582":1535,"_31169":1268,"_21582":55579,"_5":14829,"_28301":54894,"_3051":55580},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3582":1536,"_31169":1268,"_21582":55582,"_5":14829,"_28301":54894,"_3051":55583},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3582":1537,"_31169":1268,"_21582":55585,"_5":14829,"_28301":54894,"_3051":55586},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3582":1538,"_31169":1268,"_21582":55588,"_5":14829,"_28301":54894,"_3051":55589},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3582":1539,"_31169":1268,"_21582":55591,"_5":14829,"_28301":54894,"_3051":55592},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3582":1540,"_31169":1268,"_21582":55594,"_5":14829,"_28301":54894,"_3051":55595},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3582":1541,"_31169":1268,"_21582":55597,"_5":14829,"_28301":54894,"_3051":55598},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3582":1542,"_31169":1268,"_21582":55600,"_5":14829,"_28301":54894,"_3051":55601},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3582":1543,"_31169":1268,"_21582":55603,"_5":14829,"_28301":54894,"_3051":55604},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3582":1544,"_31169":1268,"_21582":55606,"_5":14829,"_28301":54894,"_3051":55607},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3582":1545,"_31169":1268,"_21582":55609,"_5":14829,"_28301":54894,"_3051":55610},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3582":1546,"_31169":1268,"_21582":55612,"_5":14829,"_28301":54894,"_3051":55613},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3582":1547,"_31169":1268,"_21582":55615,"_5":14829,"_28301":54894,"_3051":55616},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3582":1548,"_31169":1268,"_21582":55618,"_5":14829,"_28301":54894,"_3051":55619},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3582":1549,"_31169":1268,"_21582":55621,"_5":14829,"_28301":54894,"_3051":55622},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3582":1550,"_31169":1550,"_5":15200,"_3051":53326,"_31527":55624,"_21582":55625,"_28301":1550},[50837,52312,53326],[],{"_3582":1551,"_31169":1550,"_21582":55627,"_5":14829,"_28301":1550,"_3051":55628},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3582":1552,"_31169":1550,"_5":31524,"_21582":55630,"_28301":55631,"_3051":55632},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#start-here","Start here",{"_3582":1553,"_31169":1550,"_5":31524,"_21582":55634,"_28301":55635,"_3051":53324},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#devices-and-identities",{"_3582":1554,"_31169":1550,"_5":31524,"_21582":55637,"_28301":55638,"_3051":53507},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#enrollment-with-pki",{"_3582":1555,"_31169":1550,"_5":31524,"_21582":55640,"_28301":55641,"_3051":54791},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#integrations",{"_3582":1556,"_31169":1550,"_5":31524,"_21582":55643,"_28301":55644,"_3051":55645},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3582":1557,"_31169":1550,"_21582":55647,"_5":14829,"_28301":1550,"_3051":55648},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3582":1558,"_31169":1550,"_21582":55650,"_5":14829,"_28301":55631,"_3051":55651},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3582":1559,"_31169":1550,"_21582":55653,"_5":14829,"_28301":55631,"_3051":55654},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3582":1560,"_31169":1550,"_21582":55656,"_5":14829,"_28301":55635,"_3051":55657},[],"Resource",{"_3582":1561,"_31169":1550,"_21582":55659,"_5":14829,"_28301":55635,"_3051":55660},[],"What it represents",{"_3582":1562,"_31169":1550,"_21582":55662,"_5":14829,"_28301":55635,"_3051":55663},[],"**Device**",{"_3582":1563,"_31169":1550,"_21582":55665,"_5":14829,"_28301":55635,"_3051":55666},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3582":1564,"_31169":1550,"_21582":55668,"_5":14829,"_28301":55635,"_3051":55669},[],"**Identity**",{"_3582":1565,"_31169":1550,"_21582":55671,"_5":14829,"_28301":55635,"_3051":55672},[],"The device's association with its certificates: an active version and a history.",{"_3582":1566,"_31169":1550,"_21582":55674,"_5":14829,"_28301":55635,"_3051":55675},[],"**DMS**",{"_3582":1567,"_31169":1550,"_21582":55677,"_5":14829,"_28301":55635,"_3051":55678},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3582":1568,"_31169":1550,"_21582":55680,"_5":14829,"_28301":55635,"_3051":55681},[],"**Fleet**",{"_3582":1569,"_31169":1550,"_21582":55683,"_5":14829,"_28301":55635,"_3051":55684},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3582":1570,"_31169":1550,"_21582":55686,"_5":14829,"_28301":55635,"_3051":55687},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3582":1571,"_31169":1550,"_21582":55689,"_5":14829,"_28301":55635,"_3051":55690},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3582":1572,"_31169":1550,"_21582":55692,"_5":14829,"_28301":55638,"_3051":55693},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3582":1573,"_31169":1550,"_21582":55695,"_5":14829,"_28301":55638,"_3051":55696},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3582":1574,"_31169":1550,"_21582":55698,"_5":14829,"_28301":55638,"_3051":55699},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3582":1575,"_31169":1550,"_21582":55701,"_5":14829,"_28301":55638,"_3051":55702},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3582":1576,"_31169":1550,"_21582":55704,"_5":14829,"_28301":55638,"_3051":55705},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3582":1577,"_31169":1550,"_21582":55707,"_5":14829,"_28301":55638,"_3051":55708},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3582":1578,"_31169":1550,"_21582":55710,"_5":14829,"_28301":55638,"_3051":55711},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3582":1579,"_31169":1550,"_21582":55713,"_5":14829,"_28301":55638,"_3051":55714},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3582":1580,"_31169":1550,"_21582":55716,"_5":14829,"_28301":55641,"_3051":55717},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3582":1581,"_31169":1550,"_21582":55719,"_5":14829,"_28301":55641,"_3051":55720},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3582":1582,"_31169":1550,"_21582":55722,"_5":14829,"_28301":55644,"_3051":55723},[],"Participant",{"_3582":1583,"_31169":1550,"_21582":55725,"_5":14829,"_28301":55644,"_3051":55726},[],"Responsibility",{"_3582":1584,"_31169":1550,"_21582":55728,"_5":14829,"_28301":55644,"_3051":55729},[],"PKI administrator",{"_3582":1585,"_31169":1550,"_21582":55731,"_5":14829,"_28301":55644,"_3051":55732},[],"CA, issuance profile, chain and revocation publication.",{"_3582":1586,"_31169":1550,"_21582":55734,"_5":14829,"_28301":55644,"_3051":55735},[],"Provisioning administrator",{"_3582":1587,"_31169":1550,"_21582":55737,"_5":14829,"_28301":55644,"_3051":55738},[],"DMS, admission, authentication per operation and inventory.",{"_3582":1588,"_31169":1550,"_21582":55740,"_5":14829,"_28301":55644,"_3051":55741},[],"Device integrator",{"_3582":1589,"_31169":1550,"_21582":55743,"_5":14829,"_28301":55644,"_3051":55744},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3582":1590,"_31169":1550,"_21582":55746,"_5":14829,"_28301":55644,"_3051":55747},[],"Consumer integrator",{"_3582":1591,"_31169":1550,"_21582":55749,"_5":14829,"_28301":55644,"_3051":55750},[],"Trusted issuers, validation and device permissions in the destination.",{"_3582":1592,"_31169":1550,"_21582":55752,"_5":14829,"_28301":55644,"_3051":55753},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3582":1593,"_31169":1593,"_5":15200,"_3051":55755,"_31527":55756,"_21582":55758,"_28301":1593},"Enroll and connect your first device",[50837,52312,53326,55757],"Getting started",[],{"_3582":1594,"_31169":1593,"_21582":55760,"_5":14829,"_28301":1593,"_3051":55761},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3582":1595,"_31169":1593,"_5":31524,"_21582":55763,"_28301":55764,"_3051":50847},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3582":1596,"_31169":1593,"_5":31524,"_21582":55766,"_28301":55767,"_3051":55768},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3582":1597,"_31169":1593,"_5":31524,"_21582":55770,"_28301":55771,"_3051":55772},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3582":1598,"_31169":1593,"_5":31524,"_21582":55774,"_28301":55775,"_3051":55776},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3582":1599,"_31169":1593,"_5":31524,"_21582":55778,"_28301":55779,"_3051":55780},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3582":1600,"_31169":1593,"_5":31524,"_21582":55782,"_28301":55783,"_3051":55784},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3582":1601,"_31169":1593,"_5":31524,"_21582":55786,"_28301":55787,"_3051":55788},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3582":1602,"_31169":1593,"_5":31524,"_21582":55790,"_28301":55791,"_3051":55792},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3582":1603,"_31169":1593,"_21582":55794,"_5":14829,"_28301":1593,"_3051":55795},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3582":1604,"_31169":1593,"_21582":55797,"_5":14829,"_28301":55764,"_3051":55798},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3582":1605,"_31169":1593,"_21582":55800,"_5":14829,"_28301":55764,"_3051":55801},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3582":1606,"_31169":1593,"_21582":55803,"_5":14829,"_28301":55764,"_3051":55804},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3582":1607,"_31169":1593,"_21582":55806,"_5":14829,"_28301":55764,"_3051":55807},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3582":1608,"_31169":1593,"_21582":55809,"_5":14829,"_28301":55764,"_3051":55810},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3582":1609,"_31169":1593,"_21582":55812,"_5":14829,"_28301":55767,"_3051":55813},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3582":1610,"_31169":1593,"_21582":55815,"_5":14829,"_28301":55767,"_3051":55816},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3582":1611,"_31169":1593,"_21582":55818,"_5":14829,"_28301":55771,"_3051":55819},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3582":1612,"_31169":1593,"_21582":55821,"_5":14829,"_28301":55771,"_3051":55822},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3582":1613,"_31169":1593,"_21582":55824,"_5":14829,"_28301":55771,"_3051":55825},[],"Setting",{"_3582":1614,"_31169":1593,"_21582":55827,"_5":14829,"_28301":55771,"_3051":55828},[],"Evaluation value",{"_3582":1615,"_31169":1593,"_21582":55830,"_5":14829,"_28301":55771,"_3051":55831},[],"Enrollment CA",{"_3582":1616,"_31169":1593,"_21582":55833,"_5":14829,"_28301":55771,"_3051":55834},[],"Issuing root from `device-root.pem`.",{"_3582":1617,"_31169":1593,"_21582":55836,"_5":14829,"_28301":55771,"_3051":53637},[],{"_3582":1618,"_31169":1593,"_21582":55838,"_5":14829,"_28301":55771,"_3051":55839},[],"The 1-hour leaf profile you just prepared.",{"_3582":1619,"_31169":1593,"_21582":55841,"_5":14829,"_28301":55771,"_3051":55842},[],"Protocol / Registration Mode",{"_3582":1620,"_31169":1593,"_21582":55844,"_5":14829,"_28301":55771,"_3051":55845},[],"`EST_RFC7030` / `JITP`.",{"_3582":1621,"_31169":1593,"_21582":55847,"_5":14829,"_28301":55771,"_3051":55848},[],"Verify CSR Signature",{"_3582":1622,"_31169":1593,"_21582":55850,"_5":14829,"_28301":55771,"_3051":55851},[],"Enabled.",{"_3582":1623,"_31169":1593,"_21582":55853,"_5":14829,"_28301":55771,"_3051":55854},[],"Enable Replaceable Enrollment",{"_3582":1624,"_31169":1593,"_21582":55856,"_5":14829,"_28301":55771,"_3051":55857},[],"Disabled; the ID must be new.",{"_3582":1625,"_31169":1593,"_21582":55859,"_5":14829,"_28301":55771,"_3051":55860},[],"Initial authentication",{"_3582":1626,"_31169":1593,"_21582":55862,"_5":14829,"_28301":55771,"_3051":55863},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3582":1627,"_31169":1593,"_21582":55865,"_5":14829,"_28301":55771,"_3051":55866},[],"Renewal authentication",{"_3582":1628,"_31169":1593,"_21582":55868,"_5":14829,"_28301":55771,"_3051":55869},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3582":1629,"_31169":1593,"_21582":55871,"_5":14829,"_28301":55771,"_3051":55872},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3582":1630,"_31169":1593,"_21582":55874,"_5":14829,"_28301":55771,"_3051":55875},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3582":1631,"_31169":1593,"_21582":55877,"_5":14829,"_28301":55771,"_3051":55878},[],"Re-enrollment Delta",{"_3582":1632,"_31169":1593,"_21582":55880,"_5":14829,"_28301":55771,"_3051":55881},[],"1 hour.",{"_3582":1633,"_31169":1593,"_21582":55883,"_5":14829,"_28301":55771,"_3051":55884},[],"Preventive / Critical Delta",{"_3582":1634,"_31169":1593,"_21582":55886,"_5":14829,"_28301":55771,"_3051":55887},[],"30 minutes / 10 minutes.",{"_3582":1635,"_31169":1593,"_21582":55889,"_5":14829,"_28301":55771,"_3051":55890},[],"Revoke on Re-enrollment",{"_3582":1636,"_31169":1593,"_21582":55892,"_5":14829,"_28301":55771,"_3051":55893},[],"Disabled to test the successor before retiring the previous identity.",{"_3582":1637,"_31169":1593,"_21582":55895,"_5":14829,"_28301":55771,"_3051":53645},[],{"_3582":1638,"_31169":1593,"_21582":55897,"_5":14829,"_28301":55771,"_3051":55898},[],"Disabled; the operational key is generated in the client.",{"_3582":1639,"_31169":1593,"_21582":55900,"_5":14829,"_28301":55771,"_3051":55901},[],"CA Distribution",{"_3582":1640,"_31169":1593,"_21582":55903,"_5":14829,"_28301":55771,"_3051":55904},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3582":1641,"_31169":1593,"_21582":55906,"_5":14829,"_28301":55771,"_3051":55907},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3582":1642,"_31169":1593,"_21582":55909,"_5":14829,"_28301":55775,"_3051":55910},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3582":1643,"_31169":1593,"_21582":55912,"_5":14829,"_28301":55775,"_3051":55913},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3582":1644,"_31169":1593,"_21582":55915,"_5":14829,"_28301":55779,"_3051":55916},[],"Generate a new key and CSR with the selected identifier:",{"_3582":1645,"_31169":1593,"_21582":55918,"_5":14829,"_28301":55779,"_3051":55919},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3582":1646,"_31169":1593,"_21582":55921,"_5":14829,"_28301":55779,"_3051":55922},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3582":1647,"_31169":1593,"_21582":55924,"_5":14829,"_28301":55783,"_3051":55925},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3582":1648,"_31169":1593,"_21582":55927,"_5":14829,"_28301":55783,"_3051":55928},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3582":1649,"_31169":1593,"_21582":55930,"_5":14829,"_28301":55787,"_3051":55931},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3582":1650,"_31169":1593,"_21582":55933,"_5":14829,"_28301":55787,"_3051":55934},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3582":1651,"_31169":1593,"_21582":55936,"_5":14829,"_28301":55787,"_3051":55937},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3582":1652,"_31169":1593,"_21582":55939,"_5":14829,"_28301":55787,"_3051":55940},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3582":1653,"_31169":1593,"_21582":55942,"_5":14829,"_28301":55787,"_3051":55943},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3582":1654,"_31169":1593,"_21582":55945,"_5":14829,"_28301":55791,"_3051":55946},[],"Check",{"_3582":1655,"_31169":1593,"_21582":55948,"_5":14829,"_28301":55791,"_3051":55949},[],"Expected result",{"_3582":1656,"_31169":1593,"_21582":55951,"_5":14829,"_28301":55791,"_3051":55952},[],"Registration",{"_3582":1657,"_31169":1593,"_21582":55954,"_5":14829,"_28301":55791,"_3051":55955},[],"ID created automatically and correct DMS.",{"_3582":1658,"_31169":1593,"_21582":55957,"_5":14829,"_28301":55791,"_3051":55213},[],{"_3582":1659,"_31169":1593,"_21582":55959,"_5":14829,"_28301":55791,"_3051":55960},[],"CN, profile, serial and key verified.",{"_3582":1660,"_31169":1593,"_21582":55962,"_5":14829,"_28301":55791,"_3051":55963},[],"Inventory",{"_3582":1661,"_31169":1593,"_21582":55965,"_5":14829,"_28301":55791,"_3051":55966},[],"Received serial visible as the current identity and in history.",{"_3582":1662,"_31169":1593,"_21582":55968,"_5":14829,"_28301":55791,"_3051":55969},[],"Consumer",{"_3582":1663,"_31169":1593,"_21582":55971,"_5":14829,"_28301":55791,"_3051":55972},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3582":1664,"_31169":1593,"_21582":55974,"_5":14829,"_28301":55791,"_3051":55975},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3582":1665,"_31169":1593,"_21582":55977,"_5":14829,"_28301":55791,"_3051":55978},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3582":1666,"_31169":1666,"_5":15200,"_3051":53342,"_31527":55980,"_21582":55981,"_28301":1666},[50837,52312,53326,55757],[],{"_3582":1667,"_31169":1666,"_21582":55983,"_5":14829,"_28301":1666,"_3051":55984},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3582":1668,"_31169":1666,"_5":31524,"_21582":55986,"_28301":55987,"_3051":50847},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3582":1669,"_31169":1666,"_5":31524,"_21582":55989,"_28301":55990,"_3051":55991},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3582":1670,"_31169":1666,"_5":31524,"_21582":55993,"_28301":55994,"_3051":55995},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3582":1671,"_31169":1666,"_5":31524,"_21582":55997,"_28301":55998,"_3051":55999},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3582":1672,"_31169":1666,"_5":31524,"_21582":56001,"_28301":56002,"_3051":56003},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3582":1673,"_31169":1666,"_5":31524,"_21582":56005,"_28301":56006,"_3051":56007},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3582":1674,"_31169":1666,"_5":31524,"_21582":56009,"_28301":56010,"_3051":55949},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3582":1675,"_31169":1666,"_5":31524,"_21582":56012,"_28301":56013,"_3051":56014},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3582":1676,"_31169":1666,"_5":31524,"_21582":56016,"_28301":56017,"_3051":56018},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3582":1677,"_31169":1666,"_21582":56020,"_5":14829,"_28301":1666,"_3051":56021},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3582":1678,"_31169":1666,"_21582":56023,"_5":14829,"_28301":1666,"_3051":56024},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3582":1679,"_31169":1666,"_21582":56026,"_5":14829,"_28301":55987,"_3051":56027},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3582":1680,"_31169":1666,"_21582":56029,"_5":14829,"_28301":55987,"_3051":56030},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3582":1681,"_31169":1666,"_21582":56032,"_5":14829,"_28301":55987,"_3051":56033},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3582":1682,"_31169":1666,"_21582":56035,"_5":14829,"_28301":55987,"_3051":56036},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3582":1683,"_31169":1666,"_21582":56038,"_5":14829,"_28301":55990,"_3051":56039},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3582":1684,"_31169":1666,"_21582":56041,"_5":14829,"_28301":55990,"_3051":56042},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3582":1685,"_31169":1666,"_21582":56044,"_5":14829,"_28301":55990,"_3051":56045},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3582":1686,"_31169":1666,"_21582":56047,"_5":14829,"_28301":55990,"_3051":56048},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3582":1687,"_31169":1666,"_21582":56050,"_5":14829,"_28301":55990,"_3051":56051},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3582":1688,"_31169":1666,"_21582":56053,"_5":14829,"_28301":55990,"_3051":56054},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3582":1689,"_31169":1666,"_21582":56056,"_5":14829,"_28301":55990,"_3051":56057},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3582":1690,"_31169":1666,"_21582":56059,"_5":14829,"_28301":55990,"_3051":56060},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3582":1691,"_31169":1666,"_21582":56062,"_5":14829,"_28301":55994,"_3051":56063},[],"Open **Managed Devices** and the registration action. Complete:",{"_3582":1692,"_31169":1666,"_21582":56065,"_5":14829,"_28301":55994,"_3051":56066},[],"**Device ID**: `device-001`.",{"_3582":1693,"_31169":1666,"_21582":56068,"_5":14829,"_28301":55994,"_3051":56069},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3582":1694,"_31169":1666,"_21582":56071,"_5":14829,"_28301":55994,"_3051":56072},[],"**Icon** and **Tags**: optional classification.",{"_3582":1695,"_31169":1666,"_21582":56074,"_5":14829,"_28301":55994,"_3051":56075},[],"Confirm registration.",{"_3582":1696,"_31169":1666,"_21582":56077,"_5":14829,"_28301":55998,"_3051":56078},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3582":1697,"_31169":1666,"_21582":56080,"_5":14829,"_28301":55998,"_3051":56081},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3582":1698,"_31169":1666,"_21582":56083,"_5":14829,"_28301":56002,"_3051":56084},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3582":1699,"_31169":1666,"_21582":56086,"_5":14829,"_28301":56002,"_3051":56087},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3582":1700,"_31169":1666,"_21582":56089,"_5":14829,"_28301":56006,"_3051":56090},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3582":1701,"_31169":1666,"_21582":56092,"_5":14829,"_28301":56006,"_3051":56093},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3582":1702,"_31169":1666,"_21582":56095,"_5":14829,"_28301":56010,"_3051":55946},[],{"_3582":1703,"_31169":1666,"_21582":56097,"_5":14829,"_28301":56010,"_3051":56098},[],"Result",{"_3582":1704,"_31169":1666,"_21582":56100,"_5":14829,"_28301":56010,"_3051":55196},[],{"_3582":1705,"_31169":1666,"_21582":56102,"_5":14829,"_28301":56010,"_3051":56103},[],"`device-001` appears in inventory with the expected DMS.",{"_3582":1706,"_31169":1666,"_21582":56105,"_5":14829,"_28301":56010,"_3051":56106},[],"Current identity",{"_3582":1707,"_31169":1666,"_21582":56108,"_5":14829,"_28301":56010,"_3051":56109},[],"The associated certificate matches the one you verified in PKI.",{"_3582":1708,"_31169":1666,"_21582":56111,"_5":14829,"_28301":56010,"_3051":56112},[],"History",{"_3582":1709,"_31169":1666,"_21582":56114,"_5":14829,"_28301":56010,"_3051":56115},[],"The associated issuance appears with its serial number and dates.",{"_3582":1710,"_31169":1666,"_21582":56117,"_5":14829,"_28301":56010,"_3051":56118},[],"Key and certificate",{"_3582":1711,"_31169":1666,"_21582":56120,"_5":14829,"_28301":56010,"_3051":56121},[],"You have the verified pair ready to install on the device.",{"_3582":1712,"_31169":1666,"_21582":56123,"_5":14829,"_28301":56013,"_3051":56124},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3582":1713,"_31169":1666,"_21582":56126,"_5":14829,"_28301":56013,"_3051":56127},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3582":1714,"_31169":1666,"_21582":56129,"_5":14829,"_28301":56013,"_3051":56130},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3582":1715,"_31169":1666,"_21582":56132,"_5":14829,"_28301":56013,"_3051":56133},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3582":1716,"_31169":1666,"_21582":56135,"_5":14829,"_28301":56017,"_3051":56136},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3582":1717,"_31169":1666,"_21582":56138,"_5":14829,"_28301":56017,"_3051":56139},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3582":1718,"_31169":1666,"_21582":56141,"_5":14829,"_28301":56017,"_3051":56142},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3582":1719,"_31169":1719,"_5":15200,"_3051":56144,"_31527":56145,"_21582":56146,"_28301":1719},"Lamassu IoT Platform",[50837,52312],[],{"_3582":1720,"_31169":1719,"_21582":56148,"_5":14829,"_28301":1719,"_3051":56149},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3582":1721,"_31169":1719,"_5":31524,"_21582":56151,"_28301":56152,"_3051":55632},[],"/docs/pr-preview/pr-61/platform/overview#start-here",{"_3582":1722,"_31169":1719,"_5":31524,"_21582":56154,"_28301":56155,"_3051":56156},[],"/docs/pr-preview/pr-61/platform/overview#choose-your-path","Choose your path",{"_3582":1723,"_31169":1719,"_5":31524,"_21582":56158,"_28301":56159,"_3051":56160},[],"/docs/pr-preview/pr-61/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3582":1724,"_31169":1719,"_5":31524,"_21582":56162,"_28301":56163,"_3051":56164},[],"/docs/pr-preview/pr-61/platform/overview#core-capabilities","Core capabilities",{"_3582":1725,"_31169":1719,"_5":31524,"_21582":56166,"_28301":56167,"_3051":56168},[],"/docs/pr-preview/pr-61/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3582":1726,"_31169":1719,"_5":31524,"_21582":56170,"_28301":56171,"_3051":56172},[],"/docs/pr-preview/pr-61/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3582":1727,"_31169":1719,"_5":31524,"_21582":56174,"_28301":56175,"_3051":56176},[],"/docs/pr-preview/pr-61/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3582":1728,"_31169":1719,"_5":31524,"_21582":56178,"_28301":56179,"_3051":56180},[],"/docs/pr-preview/pr-61/platform/overview#automate-device-identities","Automate device identities",{"_3582":1729,"_31169":1719,"_5":31524,"_21582":56182,"_28301":56183,"_3051":56184},[],"/docs/pr-preview/pr-61/platform/overview#publish-validation-status","Publish validation status",{"_3582":1730,"_31169":1719,"_5":31524,"_21582":56186,"_28301":56187,"_3051":56188},[],"/docs/pr-preview/pr-61/platform/overview#react-to-events","React to events",{"_3582":1731,"_31169":1719,"_5":31524,"_21582":56190,"_28301":56191,"_3051":56192},[],"/docs/pr-preview/pr-61/platform/overview#operational-reference","Operational reference",{"_3582":1732,"_31169":1719,"_21582":56194,"_5":14829,"_28301":1719,"_3051":56195},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3582":1733,"_31169":1719,"_21582":56197,"_5":14829,"_28301":56152,"_3051":56198},[],"Choose the result you need:",{"_3582":1734,"_31169":1719,"_21582":56200,"_5":14829,"_28301":56152,"_3051":56201},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3582":1735,"_31169":1719,"_21582":56203,"_5":14829,"_28301":56152,"_3051":56204},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3582":1736,"_31169":1719,"_21582":56206,"_5":14829,"_28301":56152,"_3051":56207},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3582":1737,"_31169":1719,"_21582":56209,"_5":14829,"_28301":56155,"_3051":56210},[],"Section",{"_3582":1738,"_31169":1719,"_21582":56212,"_5":14829,"_28301":56155,"_3051":56213},[],"What you manage",{"_3582":1739,"_31169":1719,"_21582":56215,"_5":14829,"_28301":56155,"_3051":56216},[],"Entry point",{"_3582":1740,"_31169":1719,"_21582":56218,"_5":14829,"_28301":56155,"_3051":56219},[],"**PKI**",{"_3582":1741,"_31169":1719,"_21582":56221,"_5":14829,"_28301":56155,"_3051":56222},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3582":1742,"_31169":1719,"_21582":56224,"_5":14829,"_28301":56155,"_3051":56225},[],"PKI overview",{"_3582":1743,"_31169":1719,"_21582":56227,"_5":14829,"_28301":56155,"_3051":56228},[],"**IoT Fleets**",{"_3582":1744,"_31169":1719,"_21582":56230,"_5":14829,"_28301":56155,"_3051":56231},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3582":1745,"_31169":1719,"_21582":56233,"_5":14829,"_28301":56155,"_3051":56234},[],"IoT Fleets overview",{"_3582":1746,"_31169":1719,"_21582":56236,"_5":14829,"_28301":56155,"_3051":56237},[],"**Administration**",{"_3582":1747,"_31169":1719,"_21582":56239,"_5":14829,"_28301":56155,"_3051":56240},[],"Operator permissions, audit and event subscriptions.",{"_3582":1748,"_31169":1719,"_21582":56242,"_5":14829,"_28301":56155,"_3051":52310},[],{"_3582":1749,"_31169":1719,"_21582":56244,"_5":14829,"_28301":56155,"_3051":56245},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3582":1750,"_31169":1719,"_21582":56247,"_5":14829,"_28301":56159,"_3051":56248},[],"An identity's journey connects four responsibilities:",{"_3582":1751,"_31169":1719,"_21582":56250,"_5":14829,"_28301":56159,"_3051":56251},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3582":1752,"_31169":1719,"_21582":56253,"_5":14829,"_28301":56159,"_3051":56254},[],"The provisioning administrator configures the DMS and initial trust.",{"_3582":1753,"_31169":1719,"_21582":56256,"_5":14829,"_28301":56159,"_3051":56257},[],"The device client requests a certificate and installs it with the matching key.",{"_3582":1754,"_31169":1719,"_21582":56259,"_5":14829,"_28301":56159,"_3051":56260},[],"The consumer validates the identity and applies its access permissions.",{"_3582":1755,"_31169":1719,"_21582":56262,"_5":14829,"_28301":56159,"_3051":56263},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3582":1756,"_31169":1719,"_21582":56265,"_5":14829,"_28301":56167,"_3051":56266},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3582":1757,"_31169":1719,"_21582":56268,"_5":14829,"_28301":56171,"_3051":56269},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3582":1758,"_31169":1719,"_21582":56271,"_5":14829,"_28301":56175,"_3051":56272},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3582":1759,"_31169":1719,"_21582":56274,"_5":14829,"_28301":56179,"_3051":56275},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3582":1760,"_31169":1719,"_21582":56277,"_5":14829,"_28301":56183,"_3051":56278},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3582":1761,"_31169":1719,"_21582":56280,"_5":14829,"_28301":56187,"_3051":56281},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3582":1762,"_31169":1719,"_21582":56283,"_5":14829,"_28301":56191,"_3051":55726},[],{"_3582":1763,"_31169":1719,"_21582":56285,"_5":14829,"_28301":56191,"_3051":56286},[],"What it prepares or checks",{"_3582":1764,"_31169":1719,"_21582":56288,"_5":14829,"_28301":56191,"_3051":55729},[],{"_3582":1765,"_31169":1719,"_21582":56290,"_5":14829,"_28301":56191,"_3051":56291},[],"Key custody, CA hierarchy, profiles and validation.",{"_3582":1766,"_31169":1719,"_21582":56293,"_5":14829,"_28301":56191,"_3051":56294},[],"Fleet administrator",{"_3582":1767,"_31169":1719,"_21582":56296,"_5":14829,"_28301":56191,"_3051":56297},[],"DMS, device admission, renewal policy and inventory.",{"_3582":1768,"_31169":1719,"_21582":56299,"_5":14829,"_28301":56191,"_3051":55741},[],{"_3582":1769,"_31169":1719,"_21582":56301,"_5":14829,"_28301":56191,"_3051":56302},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3582":1770,"_31169":1719,"_21582":56304,"_5":14829,"_28301":56191,"_3051":55747},[],{"_3582":1771,"_31169":1719,"_21582":56306,"_5":14829,"_28301":56191,"_3051":56307},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3582":1772,"_31169":1719,"_21582":56309,"_5":14829,"_28301":56191,"_3051":56310},[],"Infrastructure operator",{"_3582":1773,"_31169":1719,"_21582":56312,"_5":14829,"_28301":56191,"_3051":56313},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3582":1774,"_31169":1719,"_21582":56315,"_5":14829,"_28301":56191,"_3051":56316},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3582":1775,"_31169":1775,"_5":15200,"_3051":56318,"_31527":56319,"_21582":56322,"_28301":1775},"CA hierarchy and rotation",[50837,52312,56320,56321],"PKI","Keys, authorities and certificates",[],{"_3582":1776,"_31169":1775,"_21582":56324,"_5":14829,"_28301":1775,"_3051":56325},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3582":1777,"_31169":1775,"_5":31524,"_21582":56327,"_28301":56328,"_3051":56329},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3582":1778,"_31169":1775,"_5":31524,"_21582":56331,"_28301":56332,"_3051":56333},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3582":1779,"_31169":1775,"_5":31524,"_21582":56335,"_28301":56336,"_3051":56337},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3582":1780,"_31169":1775,"_5":31524,"_21582":56339,"_28301":56340,"_3051":56341},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3582":1781,"_31169":1775,"_5":31524,"_21582":56343,"_28301":56344,"_3051":56345},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3582":1782,"_31169":1775,"_5":31524,"_21582":56347,"_28301":56348,"_3051":56349},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3582":1783,"_31169":1775,"_5":31524,"_21582":56351,"_28301":56352,"_3051":56353},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3582":1784,"_31169":1775,"_5":31524,"_21582":56355,"_28301":56356,"_3051":56357},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3582":1785,"_31169":1775,"_5":31524,"_21582":56359,"_28301":56360,"_3051":56361},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3582":1786,"_31169":1775,"_5":31524,"_21582":56363,"_28301":56364,"_3051":56365},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3582":1787,"_31169":1775,"_5":31524,"_21582":56367,"_28301":56368,"_3051":56369},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3582":1788,"_31169":1775,"_5":31524,"_21582":56371,"_28301":56372,"_3051":56373},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3582":1789,"_31169":1775,"_21582":56375,"_5":14829,"_28301":1775,"_3051":56376},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3582":1790,"_31169":1775,"_21582":56378,"_5":14829,"_28301":1775,"_3051":56379},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3582":1791,"_31169":1775,"_21582":56381,"_5":14829,"_28301":56328,"_3051":56382},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3582":1792,"_31169":1775,"_21582":56384,"_5":14829,"_28301":56328,"_3051":56385},[],"environment, such as production and preproduction;",{"_3582":1793,"_31169":1775,"_21582":56387,"_5":14829,"_28301":56328,"_3051":56388},[],"owner or operating team;",{"_3582":1794,"_31169":1775,"_21582":56390,"_5":14829,"_28301":56328,"_3051":56391},[],"device family or manufacturing process;",{"_3582":1795,"_31169":1775,"_21582":56393,"_5":14829,"_28301":56328,"_3051":56394},[],"region or regulatory requirement;",{"_3582":1796,"_31169":1775,"_21582":56396,"_5":14829,"_28301":56328,"_3051":56397},[],"cryptographic engine or key policy;",{"_3582":1797,"_31169":1775,"_21582":56399,"_5":14829,"_28301":56328,"_3051":56400},[],"maintenance window and renewal cadence.",{"_3582":1798,"_31169":1775,"_21582":56402,"_5":14829,"_28301":56328,"_3051":56403},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3582":1799,"_31169":1775,"_21582":56405,"_5":14829,"_28301":56328,"_3051":56406},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3582":1800,"_31169":1775,"_21582":56408,"_5":14829,"_28301":56332,"_3051":56409},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3582":1801,"_31169":1775,"_21582":56411,"_5":14829,"_28301":56332,"_3051":56412},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3582":1802,"_31169":1775,"_21582":56414,"_5":14829,"_28301":56332,"_3051":56415},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3582":1803,"_31169":1775,"_21582":56417,"_5":14829,"_28301":56332,"_3051":56418},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3582":1804,"_31169":1775,"_21582":56420,"_5":14829,"_28301":56336,"_3051":56421},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3582":1805,"_31169":1775,"_21582":56423,"_5":14829,"_28301":56336,"_3051":56424},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3582":1806,"_31169":1775,"_21582":56426,"_5":14829,"_28301":56336,"_3051":56427},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3582":1807,"_31169":1775,"_21582":56429,"_5":14829,"_28301":56336,"_3051":56430},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3582":1808,"_31169":1775,"_21582":56432,"_5":14829,"_28301":56344,"_3051":56433},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3582":1809,"_31169":1775,"_21582":56435,"_5":14829,"_28301":56348,"_3051":56436},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3582":1810,"_31169":1775,"_21582":56438,"_5":14829,"_28301":56352,"_3051":56439},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3582":1811,"_31169":1775,"_21582":56441,"_5":14829,"_28301":56356,"_3051":56442},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3582":1812,"_31169":1775,"_21582":56444,"_5":14829,"_28301":56360,"_3051":56445},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3582":1813,"_31169":1775,"_21582":56447,"_5":14829,"_28301":56364,"_3051":56448},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3582":1814,"_31169":1775,"_21582":56450,"_5":14829,"_28301":56368,"_3051":56451},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3582":1815,"_31169":1775,"_21582":56453,"_5":14829,"_28301":56368,"_3051":56454},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3582":1816,"_31169":1775,"_21582":56456,"_5":14829,"_28301":56368,"_3051":56457},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3582":1817,"_31169":1775,"_21582":56459,"_5":14829,"_28301":56368,"_3051":56460},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3582":1818,"_31169":1775,"_21582":56462,"_5":14829,"_28301":56372,"_3051":56463},[],"The new chain ends in an anchor installed by the consumer.",{"_3582":1819,"_31169":1775,"_21582":56465,"_5":14829,"_28301":56372,"_3051":56466},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3582":1820,"_31169":1775,"_21582":56468,"_5":14829,"_28301":56372,"_3051":56469},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3582":1821,"_31169":1775,"_21582":56471,"_5":14829,"_28301":56372,"_3051":56472},[],"Re-enrollment accepts the old identity during the planned period.",{"_3582":1822,"_31169":1775,"_21582":56474,"_5":14829,"_28301":56372,"_3051":56475},[],"OCSP and CRL respond for the authorities that remain active.",{"_3582":1823,"_31169":1775,"_21582":56477,"_5":14829,"_28301":56372,"_3051":56478},[],"No DMS is left accidentally issuing from the old CA.",{"_3582":1824,"_31169":1775,"_21582":56480,"_5":14829,"_28301":56372,"_3051":56481},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3582":1825,"_31169":1825,"_5":15200,"_3051":56483,"_31527":56484,"_21582":56485,"_28301":1825},"Certification authorities",[50837,52312,56320,56321],[],{"_3582":1826,"_31169":1825,"_21582":56487,"_5":14829,"_28301":1825,"_3051":56488},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3582":1827,"_31169":1825,"_5":31524,"_21582":56490,"_28301":56491,"_3051":56492},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3582":1828,"_31169":1825,"_5":31524,"_21582":56494,"_28301":56495,"_3051":56496},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3582":1829,"_31169":1825,"_5":31524,"_21582":56498,"_28301":56499,"_3051":50847},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#before-you-begin",{"_3582":1830,"_31169":1825,"_5":31524,"_21582":56501,"_28301":56502,"_3051":56503},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3582":1831,"_31169":1825,"_5":31524,"_21582":56505,"_28301":56506,"_3051":56507},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3582":1832,"_31169":1825,"_5":31524,"_21582":56509,"_28301":56510,"_3051":56511},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3582":1833,"_31169":1825,"_5":31524,"_21582":56513,"_28301":56514,"_3051":56515},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3582":1834,"_31169":1825,"_5":31524,"_21582":56517,"_28301":56518,"_3051":56519},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3582":1835,"_31169":1825,"_5":31524,"_21582":56521,"_28301":56522,"_3051":56523},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3582":1836,"_31169":1825,"_5":31524,"_21582":56525,"_28301":56526,"_3051":56527},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3582":1837,"_31169":1825,"_5":31524,"_21582":56529,"_28301":56530,"_3051":56531},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3582":1838,"_31169":1825,"_5":31524,"_21582":56533,"_28301":56534,"_3051":56535},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3582":1839,"_31169":1825,"_5":31524,"_21582":56537,"_28301":56538,"_3051":56539},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3582":1840,"_31169":1825,"_5":31524,"_21582":56541,"_28301":56542,"_3051":56543},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3582":1841,"_31169":1825,"_5":31524,"_21582":56545,"_28301":56546,"_3051":56547},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3582":1842,"_31169":1825,"_5":31524,"_21582":56549,"_28301":56550,"_3051":56551},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3582":1843,"_31169":1825,"_5":31524,"_21582":56553,"_28301":56554,"_3051":56555},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3582":1844,"_31169":1825,"_5":31524,"_21582":56557,"_28301":56558,"_3051":56559},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3582":1845,"_31169":1825,"_5":31524,"_21582":56561,"_28301":56562,"_3051":56563},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3582":1846,"_31169":1825,"_5":31524,"_21582":56565,"_28301":56566,"_3051":56567},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3582":1847,"_31169":1825,"_5":31524,"_21582":56569,"_28301":56570,"_3051":56571},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3582":1848,"_31169":1825,"_5":31524,"_21582":56573,"_28301":56574,"_3051":56575},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3582":1849,"_31169":1825,"_5":31524,"_21582":56577,"_28301":56578,"_3051":56579},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3582":1850,"_31169":1825,"_21582":56581,"_5":14829,"_28301":1825,"_3051":56582},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3582":1851,"_31169":1825,"_21582":56584,"_5":14829,"_28301":1825,"_3051":56585},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3582":1852,"_31169":1825,"_21582":56587,"_5":14829,"_28301":1825,"_3051":56588},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3582":1853,"_31169":1825,"_21582":56590,"_5":14829,"_28301":56491,"_3051":56591},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3582":1854,"_31169":1825,"_21582":56593,"_5":14829,"_28301":56491,"_3051":56594},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3582":1855,"_31169":1825,"_21582":56596,"_5":14829,"_28301":56491,"_3051":56597},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3582":1856,"_31169":1825,"_21582":56599,"_5":14829,"_28301":56491,"_3051":56600},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3582":1857,"_31169":1825,"_21582":56602,"_5":14829,"_28301":56491,"_3051":56603},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3582":1858,"_31169":1825,"_21582":56605,"_5":14829,"_28301":56499,"_3051":56606},[],"Decide whether the CA will be a root or an intermediate.",{"_3582":1859,"_31169":1825,"_21582":56608,"_5":14829,"_28301":56499,"_3051":56609},[],"Choose the engine that will keep the key.",{"_3582":1860,"_31169":1825,"_21582":56611,"_5":14829,"_28301":56499,"_3051":56612},[],"Define a validity longer than that of the certificates it will issue.",{"_3582":1861,"_31169":1825,"_21582":56614,"_5":14829,"_28301":56499,"_3051":56615},[],"For an intermediate CA, make sure the parent CA is active.",{"_3582":1862,"_31169":1825,"_21582":56617,"_5":14829,"_28301":56502,"_3051":56618},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3582":1863,"_31169":1825,"_21582":56620,"_5":14829,"_28301":56506,"_3051":56621},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3582":1864,"_31169":1825,"_21582":56623,"_5":14829,"_28301":56506,"_3051":56624},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3582":1865,"_31169":1825,"_21582":56626,"_5":14829,"_28301":56510,"_3051":56627},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3582":1866,"_31169":1825,"_21582":56629,"_5":14829,"_28301":56514,"_3051":56630},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3582":1867,"_31169":1825,"_21582":56632,"_5":14829,"_28301":56514,"_3051":56633},[],"`C`: two-letter ISO 3166-1 country code.",{"_3582":1868,"_31169":1825,"_21582":56635,"_5":14829,"_28301":56514,"_3051":56636},[],"`ST`: state or province.",{"_3582":1869,"_31169":1825,"_21582":56638,"_5":14829,"_28301":56514,"_3051":56639},[],"`L`: locality.",{"_3582":1870,"_31169":1825,"_21582":56641,"_5":14829,"_28301":56514,"_3051":56642},[],"`O`: organization.",{"_3582":1871,"_31169":1825,"_21582":56644,"_5":14829,"_28301":56514,"_3051":56645},[],"`OU`: organizational unit.",{"_3582":1872,"_31169":1825,"_21582":56647,"_5":14829,"_28301":56514,"_3051":56648},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3582":1873,"_31169":1825,"_21582":56650,"_5":14829,"_28301":56518,"_3051":56651},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3582":1874,"_31169":1825,"_21582":56653,"_5":14829,"_28301":56518,"_3051":56654},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3582":1875,"_31169":1825,"_21582":56656,"_5":14829,"_28301":56522,"_3051":56657},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3582":1876,"_31169":1825,"_21582":56659,"_5":14829,"_28301":56522,"_3051":56660},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3582":1877,"_31169":1825,"_21582":56662,"_5":14829,"_28301":56526,"_3051":56663},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3582":1878,"_31169":1825,"_21582":56665,"_5":14829,"_28301":56526,"_3051":56666},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3582":1879,"_31169":1825,"_21582":56668,"_5":14829,"_28301":56530,"_3051":56669},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3582":1880,"_31169":1825,"_21582":56671,"_5":14829,"_28301":56530,"_3051":56672},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3582":1881,"_31169":1825,"_21582":56674,"_5":14829,"_28301":56530,"_3051":56675},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3582":1882,"_31169":1825,"_21582":56677,"_5":14829,"_28301":56534,"_3051":56678},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3582":1883,"_31169":1825,"_21582":56680,"_5":14829,"_28301":56538,"_3051":56681},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3582":1884,"_31169":1825,"_21582":56683,"_5":14829,"_28301":56538,"_3051":56684},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3582":1885,"_31169":1825,"_21582":56686,"_5":14829,"_28301":56542,"_3051":56687},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3582":1886,"_31169":1825,"_21582":56689,"_5":14829,"_28301":56546,"_3051":56690},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3582":1887,"_31169":1825,"_21582":56692,"_5":14829,"_28301":56546,"_3051":56693},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3582":1888,"_31169":1825,"_21582":56695,"_5":14829,"_28301":56550,"_3051":56696},[],"Open a CA from the inventory to review:",{"_3582":1889,"_31169":1825,"_21582":56698,"_5":14829,"_28301":56550,"_3051":56699},[],"Status and validity period.",{"_3582":1890,"_31169":1825,"_21582":56701,"_5":14829,"_28301":56550,"_3051":56702},[],"Certificate and chain in PEM format.",{"_3582":1891,"_31169":1825,"_21582":56704,"_5":14829,"_28301":56550,"_3051":56705},[],"Number of active, expired and revoked certificates.",{"_3582":1892,"_31169":1825,"_21582":56707,"_5":14829,"_28301":56550,"_3051":56708},[],"Certificates issued in **Issued Certificates**.",{"_3582":1893,"_31169":1825,"_21582":56710,"_5":14829,"_28301":56550,"_3051":56711},[],"The CRL linked to the authority.",{"_3582":1894,"_31169":1825,"_21582":56713,"_5":14829,"_28301":56550,"_3051":56714},[],"Metadata and the associated cryptographic engine.",{"_3582":1895,"_31169":1825,"_21582":56716,"_5":14829,"_28301":56550,"_3051":56717},[],"You can filter the inventory by name, status and CA type.",{"_3582":1896,"_31169":1825,"_21582":56719,"_5":14829,"_28301":56554,"_3051":56720},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3582":1897,"_31169":1825,"_21582":56722,"_5":14829,"_28301":56554,"_3051":56723},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3582":1898,"_31169":1825,"_21582":56725,"_5":14829,"_28301":56554,"_3051":56726},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3582":1899,"_31169":1825,"_21582":56728,"_5":14829,"_28301":56554,"_3051":56729},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3582":1900,"_31169":1825,"_21582":56731,"_5":14829,"_28301":56558,"_3051":56732},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3582":1901,"_31169":1825,"_21582":56734,"_5":14829,"_28301":56562,"_3051":56735},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3582":1902,"_31169":1825,"_21582":56737,"_5":14829,"_28301":56566,"_3051":56738},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3582":1903,"_31169":1825,"_21582":56740,"_5":14829,"_28301":56570,"_3051":56741},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3582":1904,"_31169":1825,"_21582":56743,"_5":14829,"_28301":56574,"_3051":56744},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3582":1905,"_31169":1825,"_21582":56746,"_5":14829,"_28301":56578,"_3051":56747},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3582":1906,"_31169":1825,"_21582":56749,"_5":14829,"_28301":56578,"_3051":56750},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3582":1907,"_31169":1825,"_21582":56752,"_5":14829,"_28301":56578,"_3051":56753},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3582":1908,"_31169":1908,"_5":15200,"_3051":56755,"_31527":56756,"_21582":56757,"_28301":1908},"Certificate profiles",[50837,52312,56320,56321],[],{"_3582":1909,"_31169":1908,"_21582":56759,"_5":14829,"_28301":1908,"_3051":56760},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3582":1910,"_31169":1908,"_5":31524,"_21582":56762,"_28301":56763,"_3051":56764},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3582":1911,"_31169":1908,"_5":31524,"_21582":56766,"_28301":56767,"_3051":56768},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#validity","Validity",{"_3582":1912,"_31169":1908,"_5":31524,"_21582":56770,"_28301":56771,"_3051":56772},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3582":1913,"_31169":1908,"_5":31524,"_21582":56774,"_28301":56775,"_3051":56776},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3582":1914,"_31169":1908,"_5":31524,"_21582":56778,"_28301":56779,"_3051":56780},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#subject","Subject",{"_3582":1915,"_31169":1908,"_5":31524,"_21582":56782,"_28301":56783,"_3051":56784},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3582":1916,"_31169":1908,"_5":31524,"_21582":56786,"_28301":56787,"_3051":56788},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3582":1917,"_31169":1908,"_5":31524,"_21582":56790,"_28301":56791,"_3051":56792},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3582":1918,"_31169":1908,"_5":31524,"_21582":56794,"_28301":56795,"_3051":56796},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3582":1919,"_31169":1908,"_5":31524,"_21582":56798,"_28301":56799,"_3051":56800},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3582":1920,"_31169":1908,"_5":31524,"_21582":56802,"_28301":56803,"_3051":56804},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3582":1921,"_31169":1908,"_5":31524,"_21582":56806,"_28301":56807,"_3051":56808},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3582":1922,"_31169":1908,"_5":31524,"_21582":56810,"_28301":56811,"_3051":56812},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3582":1923,"_31169":1908,"_5":31524,"_21582":56814,"_28301":56815,"_3051":56816},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3582":1924,"_31169":1908,"_5":31524,"_21582":56818,"_28301":56819,"_3051":56820},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#design-examples","Design examples",{"_3582":1925,"_31169":1908,"_5":31524,"_21582":56822,"_28301":56823,"_3051":56824},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3582":1926,"_31169":1908,"_21582":56826,"_5":14829,"_28301":1908,"_3051":56827},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3582":1927,"_31169":1908,"_21582":56829,"_5":14829,"_28301":1908,"_3051":56830},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3582":1928,"_31169":1908,"_21582":56832,"_5":14829,"_28301":56767,"_3051":56833},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3582":1929,"_31169":1908,"_21582":56835,"_5":14829,"_28301":56767,"_3051":56836},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3582":1930,"_31169":1908,"_21582":56838,"_5":14829,"_28301":56771,"_3051":56839},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3582":1931,"_31169":1908,"_21582":56841,"_5":14829,"_28301":56775,"_3051":56842},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3582":1932,"_31169":1908,"_21582":56844,"_5":14829,"_28301":56775,"_3051":56845},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3582":1933,"_31169":1908,"_21582":56847,"_5":14829,"_28301":56775,"_3051":56848},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3582":1934,"_31169":1908,"_21582":56850,"_5":14829,"_28301":56779,"_3051":56851},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3582":1935,"_31169":1908,"_21582":56853,"_5":14829,"_28301":56783,"_3051":56854},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3582":1936,"_31169":1908,"_21582":56856,"_5":14829,"_28301":56783,"_3051":56857},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3582":1937,"_31169":1908,"_21582":56859,"_5":14829,"_28301":56787,"_3051":56860},[],"The cryptographic enforcement can:",{"_3582":1938,"_31169":1908,"_21582":56862,"_5":14829,"_28301":56787,"_3051":56863},[],"allow or block RSA keys;",{"_3582":1939,"_31169":1908,"_21582":56865,"_5":14829,"_28301":56787,"_3051":56866},[],"limit the supported RSA sizes;",{"_3582":1940,"_31169":1908,"_21582":56868,"_5":14829,"_28301":56787,"_3051":56869},[],"allow or block ECDSA keys;",{"_3582":1941,"_31169":1908,"_21582":56871,"_5":14829,"_28301":56787,"_3051":56872},[],"limit the supported ECDSA sizes or curves.",{"_3582":1942,"_31169":1908,"_21582":56874,"_5":14829,"_28301":56787,"_3051":56875},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3582":1943,"_31169":1908,"_21582":56877,"_5":14829,"_28301":56791,"_3051":56878},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3582":1944,"_31169":1908,"_21582":56880,"_5":14829,"_28301":56791,"_3051":54082},[],{"_3582":1945,"_31169":1908,"_21582":56882,"_5":14829,"_28301":56791,"_3051":56883},[],"First choice",{"_3582":1946,"_31169":1908,"_21582":56885,"_5":14829,"_28301":56791,"_3051":56886},[],"Second choice",{"_3582":1947,"_31169":1908,"_21582":56888,"_5":14829,"_28301":56791,"_3051":56889},[],"If neither is supplied",{"_3582":1948,"_31169":1908,"_21582":56891,"_5":14829,"_28301":56791,"_3051":56892},[],"Direct signing with a CA",{"_3582":1949,"_31169":1908,"_21582":56894,"_5":14829,"_28301":56791,"_3051":56895},[],"`issuance_profile` embedded in the request",{"_3582":1950,"_31169":1908,"_21582":56897,"_5":14829,"_28301":56791,"_3051":56898},[],"Request `issuance_profile_id`",{"_3582":1951,"_31169":1908,"_21582":56900,"_5":14829,"_28301":56791,"_3051":56901},[],"CA default profile (`profile_id`).",{"_3582":1952,"_31169":1908,"_21582":56903,"_5":14829,"_28301":56791,"_3051":56904},[],"Issuance through a DMS",{"_3582":1953,"_31169":1908,"_21582":56906,"_5":14829,"_28301":56791,"_3051":56907},[],"`settings.issuance_profile_id`",{"_3582":1954,"_31169":1908,"_21582":56909,"_5":14829,"_28301":56791,"_3051":56910},[],"`settings.issuance_profile` embedded in the DMS",{"_3582":1955,"_31169":1908,"_21582":56912,"_5":14829,"_28301":56791,"_3051":56913},[],"Enrollment CA default profile.",{"_3582":1956,"_31169":1908,"_21582":56915,"_5":14829,"_28301":56791,"_3051":56916},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3582":1957,"_31169":1908,"_21582":56918,"_5":14829,"_28301":56791,"_3051":56919},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3582":1958,"_31169":1908,"_21582":56921,"_5":14829,"_28301":56799,"_3051":56922},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3582":1959,"_31169":1908,"_21582":56924,"_5":14829,"_28301":56803,"_3051":56925},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3582":1960,"_31169":1908,"_21582":56927,"_5":14829,"_28301":56807,"_3051":56928},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3582":1961,"_31169":1908,"_21582":56930,"_5":14829,"_28301":56811,"_3051":56931},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3582":1962,"_31169":1908,"_21582":56933,"_5":14829,"_28301":56815,"_3051":56934},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3582":1963,"_31169":1908,"_21582":56936,"_5":14829,"_28301":56815,"_3051":56937},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3582":1964,"_31169":1908,"_21582":56939,"_5":14829,"_28301":56819,"_3051":56940},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3582":1965,"_31169":1908,"_21582":56942,"_5":14829,"_28301":56819,"_3051":56943},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3582":1966,"_31169":1908,"_21582":56945,"_5":14829,"_28301":56819,"_3051":56946},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3582":1967,"_31169":1908,"_21582":56948,"_5":14829,"_28301":56819,"_3051":56949},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3582":1968,"_31169":1908,"_21582":56951,"_5":14829,"_28301":56823,"_3051":56952},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3582":1969,"_31169":1908,"_21582":56954,"_5":14829,"_28301":56823,"_3051":56955},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3582":1970,"_31169":1970,"_5":15200,"_3051":56957,"_31527":56958,"_21582":56960,"_28301":1970},"Certificate validation",[50837,52312,56320,56959],"Validation",[],{"_3582":1971,"_31169":1970,"_21582":56962,"_5":14829,"_28301":1970,"_3051":56963},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3582":1972,"_31169":1970,"_5":31524,"_21582":56965,"_28301":56966,"_3051":56967},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3582":1973,"_31169":1970,"_5":31524,"_21582":56969,"_28301":56970,"_3051":56971},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3582":1974,"_31169":1970,"_5":31524,"_21582":56973,"_28301":56974,"_3051":56975},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3582":1975,"_31169":1970,"_21582":56977,"_5":14829,"_28301":1970,"_3051":56978},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3582":1976,"_31169":1970,"_21582":56980,"_5":14829,"_28301":56966,"_3051":56981},[],"Verify these criteria together:",{"_3582":1977,"_31169":1970,"_21582":56983,"_5":14829,"_28301":56966,"_3051":55946},[],{"_3582":1978,"_31169":1970,"_21582":56985,"_5":14829,"_28301":56966,"_3051":56986},[],"Required result",{"_3582":1979,"_31169":1970,"_21582":56988,"_5":14829,"_28301":56966,"_3051":56989},[],"Chain and signature",{"_3582":1980,"_31169":1970,"_21582":56991,"_5":14829,"_28301":56966,"_3051":56992},[],"Valid chain to a root deliberately installed in the consumer.",{"_3582":1981,"_31169":1970,"_21582":56994,"_5":14829,"_28301":56966,"_3051":56995},[],"Dates",{"_3582":1982,"_31169":1970,"_21582":56997,"_5":14829,"_28301":56966,"_3051":56998},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3582":1983,"_31169":1970,"_21582":57000,"_5":14829,"_28301":56966,"_3051":51981},[],{"_3582":1984,"_31169":1970,"_21582":57002,"_5":14829,"_28301":56966,"_3051":57003},[],"Name, SAN or identifier matches the expected peer.",{"_3582":1985,"_31169":1970,"_21582":57005,"_5":14829,"_28301":56966,"_3051":51227},[],{"_3582":1986,"_31169":1970,"_21582":57007,"_5":14829,"_28301":56966,"_3051":57008},[],"KU, EKU and constraints permit the specific operation.",{"_3582":1987,"_31169":1970,"_21582":57010,"_5":14829,"_28301":56966,"_3051":57011},[],"Revocation",{"_3582":1988,"_31169":1970,"_21582":57013,"_5":14829,"_28301":56966,"_3051":57014},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3582":1989,"_31169":1970,"_21582":57016,"_5":14829,"_28301":56966,"_3051":57017},[],"Authorization",{"_3582":1990,"_31169":1970,"_21582":57019,"_5":14829,"_28301":56966,"_3051":57020},[],"The application permits that identity to perform the action.",{"_3582":1991,"_31169":1970,"_21582":57022,"_5":14829,"_28301":56966,"_3051":57023},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3582":1992,"_31169":1970,"_21582":57025,"_5":14829,"_28301":56970,"_3051":57026},[],"Mechanism",{"_3582":1993,"_31169":1970,"_21582":57028,"_5":14829,"_28301":56970,"_3051":57029},[],"When to use it",{"_3582":1994,"_31169":1970,"_21582":57031,"_5":14829,"_28301":56970,"_3051":57032},[],"What you must maintain",{"_3582":1995,"_31169":1970,"_21582":57034,"_5":14829,"_28301":56970,"_3051":57035},[],"OCSP",{"_3582":1996,"_31169":1970,"_21582":57037,"_5":14829,"_28301":56970,"_3051":57038},[],"Status query for a specific certificate.",{"_3582":1997,"_31169":1970,"_21582":57040,"_5":14829,"_28301":56970,"_3051":57041},[],"Responder access, signature verification and cache/freshness policy.",{"_3582":1998,"_31169":1970,"_21582":57043,"_5":14829,"_28301":56970,"_3051":57044},[],"CRL",{"_3582":1999,"_31169":1970,"_21582":57046,"_5":14829,"_28301":56970,"_3051":57047},[],"Local checks for many certificates or offline operation.",{"_3582":2000,"_31169":1970,"_21582":57049,"_5":14829,"_28301":56970,"_3051":57050},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3582":2001,"_31169":1970,"_21582":57052,"_5":14829,"_28301":56970,"_3051":57053},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3582":2002,"_31169":1970,"_21582":57055,"_5":14829,"_28301":56970,"_3051":57056},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3582":2003,"_31169":1970,"_21582":57058,"_5":14829,"_28301":56974,"_3051":57059},[],"Accept a current, authorized certificate with a known chain.",{"_3582":2004,"_31169":1970,"_21582":57061,"_5":14829,"_28301":56974,"_3051":57062},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3582":2005,"_31169":1970,"_21582":57064,"_5":14829,"_28301":56974,"_3051":57065},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3582":2006,"_31169":1970,"_21582":57067,"_5":14829,"_28301":56974,"_3051":57068},[],"Check that a new connection with that identity is rejected.",{"_3582":2007,"_31169":1970,"_21582":57070,"_5":14829,"_28301":56974,"_3051":57071},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3582":2008,"_31169":1970,"_21582":57073,"_5":14829,"_28301":56974,"_3051":57074},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3582":2009,"_31169":1970,"_21582":57076,"_5":14829,"_28301":56974,"_3051":57077},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3582":2010,"_31169":1970,"_21582":57079,"_5":14829,"_28301":56974,"_3051":57080},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3582":2011,"_31169":1970,"_21582":57082,"_5":14829,"_28301":56974,"_3051":57083},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3582":2012,"_31169":2012,"_5":15200,"_3051":57085,"_31527":57086,"_21582":57087,"_28301":2012},"Certificates",[50837,52312,56320,56321],[],{"_3582":2013,"_31169":2012,"_21582":57089,"_5":14829,"_28301":2012,"_3051":57090},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3582":2014,"_31169":2012,"_5":31524,"_21582":57092,"_28301":57093,"_3051":57094},[],"/docs/pr-preview/pr-61/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3582":2015,"_31169":2012,"_5":31524,"_21582":57096,"_28301":57097,"_3051":57098},[],"/docs/pr-preview/pr-61/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3582":2016,"_31169":2012,"_5":31524,"_21582":57100,"_28301":57101,"_3051":57102},[],"/docs/pr-preview/pr-61/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3582":2017,"_31169":2012,"_5":31524,"_21582":57104,"_28301":57105,"_3051":57106},[],"/docs/pr-preview/pr-61/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3582":2018,"_31169":2012,"_5":31524,"_21582":57108,"_28301":57109,"_3051":57110},[],"/docs/pr-preview/pr-61/platform/pki/certificates#open-the-action","Open the action",{"_3582":2019,"_31169":2012,"_5":31524,"_21582":57112,"_28301":57113,"_3051":57114},[],"/docs/pr-preview/pr-61/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3582":2020,"_31169":2012,"_5":31524,"_21582":57116,"_28301":57117,"_3051":57118},[],"/docs/pr-preview/pr-61/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3582":2021,"_31169":2012,"_5":31524,"_21582":57120,"_28301":57121,"_3051":57122},[],"/docs/pr-preview/pr-61/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3582":2022,"_31169":2012,"_5":31524,"_21582":57124,"_28301":57125,"_3051":57126},[],"/docs/pr-preview/pr-61/platform/pki/certificates#continue","Continue",{"_3582":2023,"_31169":2012,"_21582":57128,"_5":14829,"_28301":2012,"_3051":57129},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3582":2024,"_31169":2012,"_21582":57131,"_5":14829,"_28301":57093,"_3051":57132},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3582":2025,"_31169":2012,"_21582":57134,"_5":14829,"_28301":57093,"_3051":57135},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3582":2026,"_31169":2012,"_21582":57137,"_5":14829,"_28301":57093,"_3051":57138},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3582":2027,"_31169":2012,"_21582":57140,"_5":14829,"_28301":57093,"_3051":57141},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3582":2028,"_31169":2012,"_21582":57143,"_5":14829,"_28301":57093,"_3051":57144},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3582":2029,"_31169":2012,"_21582":57146,"_5":14829,"_28301":57093,"_3051":57147},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3582":2030,"_31169":2012,"_21582":57149,"_5":14829,"_28301":57093,"_3051":57150},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3582":2031,"_31169":2012,"_21582":57152,"_5":14829,"_28301":57097,"_3051":57153},[],"Download the PEM and inspect it:",{"_3582":2032,"_31169":2012,"_21582":57155,"_5":14829,"_28301":57097,"_3051":57156},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3582":2033,"_31169":2012,"_21582":57158,"_5":14829,"_28301":57101,"_3051":57159},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3582":2034,"_31169":2012,"_21582":57161,"_5":14829,"_28301":57101,"_3051":57162},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3582":2035,"_31169":2012,"_21582":57164,"_5":14829,"_28301":57101,"_3051":57165},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3582":2036,"_31169":2012,"_21582":57167,"_5":14829,"_28301":57101,"_3051":57168},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3582":2037,"_31169":2012,"_21582":57170,"_5":14829,"_28301":57101,"_3051":57171},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3582":2038,"_31169":2012,"_21582":57173,"_5":14829,"_28301":57101,"_3051":57174},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3582":2039,"_31169":2012,"_21582":57176,"_5":14829,"_28301":57101,"_3051":57177},[],"For browser key generation, follow Issue your first certificate.",{"_3582":2040,"_31169":2012,"_21582":57179,"_5":14829,"_28301":57105,"_3051":57180},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3582":2041,"_31169":2012,"_21582":57182,"_5":14829,"_28301":57109,"_3051":57183},[],"Locate the correct issuer and serial and select **Revoke Certificate**. A walkthrough is available in Revoke a certificate and check the CRL. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3582":2042,"_31169":2012,"_21582":57185,"_5":14829,"_28301":57113,"_3051":57186},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3582":2043,"_31169":2012,"_21582":57188,"_5":14829,"_28301":57117,"_3051":57189},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3582":2044,"_31169":2012,"_21582":57191,"_5":14829,"_28301":57117,"_3051":57192},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3582":2045,"_31169":2012,"_21582":57194,"_5":14829,"_28301":57117,"_3051":57195},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3582":2046,"_31169":2012,"_21582":57197,"_5":14829,"_28301":57121,"_3051":57198},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3582":2047,"_31169":2012,"_21582":57200,"_5":14829,"_28301":57121,"_3051":57201},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3582":2048,"_31169":2012,"_21582":57203,"_5":14829,"_28301":57121,"_3051":57204},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3582":2049,"_31169":2012,"_21582":57206,"_5":14829,"_28301":57125,"_3051":57207},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3582":2050,"_31169":2012,"_21582":57209,"_5":14829,"_28301":57125,"_3051":57210},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3582":2051,"_31169":2051,"_5":15200,"_3051":57212,"_31527":57213,"_21582":57215,"_28301":2051},"Certificate lifecycle",[50837,52312,56320,57214],"Concepts",[],{"_3582":2052,"_31169":2051,"_21582":57217,"_5":14829,"_28301":2051,"_3051":57218},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3582":2053,"_31169":2051,"_5":31524,"_21582":57220,"_28301":57221,"_3051":57222},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3582":2054,"_31169":2051,"_5":31524,"_21582":57224,"_28301":57225,"_3051":57226},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3582":2055,"_31169":2051,"_5":31524,"_21582":57228,"_28301":57229,"_3051":57230},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3582":2056,"_31169":2051,"_5":31524,"_21582":57232,"_28301":57233,"_3051":57234},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3582":2057,"_31169":2051,"_5":31524,"_21582":57236,"_28301":57237,"_3051":57238},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3582":2058,"_31169":2051,"_5":31524,"_21582":57240,"_28301":57241,"_3051":57242},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3582":2059,"_31169":2051,"_5":31524,"_21582":57244,"_28301":57245,"_3051":57246},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3582":2060,"_31169":2051,"_5":31524,"_21582":57248,"_28301":57249,"_3051":57250},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3582":2061,"_31169":2051,"_5":31524,"_21582":57252,"_28301":57253,"_3051":57254},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3582":2062,"_31169":2051,"_5":31524,"_21582":57256,"_28301":57257,"_3051":57258},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3582":2063,"_31169":2051,"_21582":57260,"_5":14829,"_28301":2051,"_3051":57261},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3582":2064,"_31169":2051,"_21582":57263,"_5":14829,"_28301":57225,"_3051":57264},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3582":2065,"_31169":2051,"_21582":57266,"_5":14829,"_28301":57229,"_3051":57267},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3582":2066,"_31169":2051,"_21582":57269,"_5":14829,"_28301":57233,"_3051":57270},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3582":2067,"_31169":2051,"_21582":57272,"_5":14829,"_28301":57237,"_3051":57273},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3582":2068,"_31169":2051,"_21582":57275,"_5":14829,"_28301":57241,"_3051":57276},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3582":2069,"_31169":2051,"_21582":57278,"_5":14829,"_28301":57245,"_3051":57279},[],"Lamassu persists four X.509 states:",{"_3582":2070,"_31169":2051,"_21582":57281,"_5":14829,"_28301":57245,"_3051":57282},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3582":2071,"_31169":2051,"_21582":57284,"_5":14829,"_28301":57245,"_3051":57285},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3582":2072,"_31169":2051,"_21582":57287,"_5":14829,"_28301":57245,"_3051":57288},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3582":2073,"_31169":2051,"_21582":57290,"_5":14829,"_28301":57245,"_3051":57291},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3582":2074,"_31169":2051,"_21582":57293,"_5":14829,"_28301":57245,"_3051":57294},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3582":2075,"_31169":2051,"_21582":57296,"_5":14829,"_28301":57249,"_3051":57297},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3582":2076,"_31169":2051,"_21582":57299,"_5":14829,"_28301":57249,"_3051":57300},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3582":2077,"_31169":2051,"_21582":57302,"_5":14829,"_28301":57249,"_3051":57303},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3582":2078,"_31169":2051,"_21582":57305,"_5":14829,"_28301":57253,"_3051":57306},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3582":2079,"_31169":2051,"_21582":57308,"_5":14829,"_28301":57253,"_3051":57309},[],"Before confirming:",{"_3582":2080,"_31169":2051,"_21582":57311,"_5":14829,"_28301":57253,"_3051":57312},[],"Identify DMSs, devices and services that trust that chain.",{"_3582":2081,"_31169":2051,"_21582":57314,"_5":14829,"_28301":57253,"_3051":57315},[],"Distribute the new chain of trust.",{"_3582":2082,"_31169":2051,"_21582":57317,"_5":14829,"_28301":57253,"_3051":57318},[],"Reissue the necessary identities.",{"_3582":2083,"_31169":2051,"_21582":57320,"_5":14829,"_28301":57253,"_3051":57321},[],"Check OCSP and CRL from a real consumer.",{"_3582":2084,"_31169":2051,"_21582":57323,"_5":14829,"_28301":57253,"_3051":57324},[],"Revoke the old CA once no legitimate traffic remains.",{"_3582":2085,"_31169":2051,"_21582":57326,"_5":14829,"_28301":57253,"_3051":57327},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3582":2086,"_31169":2051,"_21582":57329,"_5":14829,"_28301":57257,"_3051":57330},[],"Certificates entering the preventive or critical renewal window.",{"_3582":2087,"_31169":2051,"_21582":57332,"_5":14829,"_28301":57257,"_3051":57333},[],"Repeated enrollment or re-enrollment failures.",{"_3582":2088,"_31169":2051,"_21582":57335,"_5":14829,"_28301":57257,"_3051":57336},[],"Status changes and revocation reasons.",{"_3582":2089,"_31169":2051,"_21582":57338,"_5":14829,"_28301":57257,"_3051":57339},[],"OCSP and CRL publication and validity.",{"_3582":2090,"_31169":2051,"_21582":57341,"_5":14829,"_28301":57257,"_3051":57342},[],"Dependencies still presenting a replaced certificate.",{"_3582":2091,"_31169":2051,"_21582":57344,"_5":14829,"_28301":57257,"_3051":57345},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3582":2092,"_31169":2092,"_5":15200,"_3051":57347,"_31527":57348,"_21582":57349,"_28301":2092},"Trust model",[50837,52312,56320,57214],[],{"_3582":2093,"_31169":2092,"_21582":57351,"_5":14829,"_28301":2092,"_3051":57352},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3582":2094,"_31169":2092,"_5":31524,"_21582":57354,"_28301":57355,"_3051":57356},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3582":2095,"_31169":2092,"_5":31524,"_21582":57358,"_28301":57359,"_3051":57360},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3582":2096,"_31169":2092,"_5":31524,"_21582":57362,"_28301":57363,"_3051":57364},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3582":2097,"_31169":2092,"_5":31524,"_21582":57366,"_28301":57367,"_3051":57368},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3582":2098,"_31169":2092,"_5":31524,"_21582":57370,"_28301":57371,"_3051":57372},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3582":2099,"_31169":2092,"_5":31524,"_21582":57374,"_28301":57375,"_3051":57376},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#trust-architectures-and-interoperability","Trust architectures and interoperability",{"_3582":2100,"_31169":2092,"_5":31524,"_21582":57378,"_28301":57379,"_3051":57380},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#single-ca-and-hierarchy","Single CA and hierarchy",{"_3582":2101,"_31169":2092,"_5":31524,"_21582":57382,"_28301":57383,"_3051":57384},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#direct-cross-certification-and-mesh","Direct cross-certification and mesh",{"_3582":2102,"_31169":2092,"_5":31524,"_21582":57386,"_28301":57387,"_3051":57388},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#hybrid-model","Hybrid model",{"_3582":2103,"_31169":2092,"_5":31524,"_21582":57390,"_28301":57391,"_3051":57392},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#unifying-trust-point","Unifying trust point",{"_3582":2104,"_31169":2092,"_5":31524,"_21582":57394,"_28301":57395,"_3051":57396},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#bridge-ca","Bridge CA",{"_3582":2105,"_31169":2092,"_5":31524,"_21582":57398,"_28301":57399,"_3051":57400},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#trust-lists","Trust lists",{"_3582":2106,"_31169":2092,"_5":31524,"_21582":57402,"_28301":57403,"_3051":57404},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#what-lamassu-can-demonstrate","What Lamassu can demonstrate",{"_3582":2107,"_31169":2092,"_5":31524,"_21582":57406,"_28301":57407,"_3051":57408},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3582":2108,"_31169":2092,"_5":31524,"_21582":57410,"_28301":57411,"_3051":57412},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3582":2109,"_31169":2092,"_5":31524,"_21582":57414,"_28301":57415,"_3051":57416},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3582":2110,"_31169":2092,"_5":31524,"_21582":57418,"_28301":57419,"_3051":57420},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3582":2111,"_31169":2092,"_5":31524,"_21582":57422,"_28301":57423,"_3051":57424},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3582":2112,"_31169":2092,"_21582":57426,"_5":14829,"_28301":2092,"_3051":57427},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3582":2113,"_31169":2092,"_21582":57429,"_5":14829,"_28301":57359,"_3051":57430},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3582":2114,"_31169":2092,"_21582":57432,"_5":14829,"_28301":57363,"_3051":57433},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3582":2115,"_31169":2092,"_21582":57435,"_5":14829,"_28301":57367,"_3051":57436},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3582":2116,"_31169":2092,"_21582":57438,"_5":14829,"_28301":57371,"_3051":57439},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3582":2117,"_31169":2092,"_21582":57441,"_5":14829,"_28301":57375,"_3051":57442},[],"RFC 5217 distinguishes a PKI's internal structure from relationships between domains. Below, `A → B` means A signs a CA certificate for B. Validation starts at the relying party's chosen anchor; a signature in one direction does not imply reciprocal trust.",{"_3582":2118,"_31169":2092,"_21582":57444,"_5":14829,"_28301":57375,"_3051":50932},[],{"_3582":2119,"_31169":2092,"_21582":57446,"_5":14829,"_28301":57375,"_3051":57447},[],"Structure",{"_3582":2120,"_31169":2092,"_21582":57449,"_5":14829,"_28301":57375,"_3051":57450},[],"Considerations",{"_3582":2121,"_31169":2092,"_21582":57452,"_5":14829,"_28301":57375,"_3051":57453},[],"Single CA",{"_3582":2122,"_31169":2092,"_21582":57455,"_5":14829,"_28301":57375,"_3051":57456},[],"`CA → identity`.",{"_3582":2123,"_31169":2092,"_21582":57458,"_5":14829,"_28301":57375,"_3051":57459},[],"The root issues identities directly; its compromise affects all of them.",{"_3582":2124,"_31169":2092,"_21582":57461,"_5":14829,"_28301":57375,"_3051":57462},[],"Hierarchical",{"_3582":2125,"_31169":2092,"_21582":57464,"_5":14829,"_28301":57375,"_3051":57465},[],"`Root → intermediate → identity`.",{"_3582":2126,"_31169":2092,"_21582":57467,"_5":14829,"_28301":57375,"_3051":57468},[],"Distribute the root and present intermediates; constrain depth, uses and validity.",{"_3582":2127,"_31169":2092,"_21582":57470,"_5":14829,"_28301":57375,"_3051":57471},[],"Full or partial mesh",{"_3582":2128,"_31169":2092,"_21582":57473,"_5":14829,"_28301":57375,"_3051":57474},[],"Self-signed CAs cross-certify each other; a partial mesh has missing links.",{"_3582":2129,"_31169":2092,"_21582":57476,"_5":14829,"_28301":57375,"_3051":57477},[],"Check each direction and anchor: some domains may be unreachable in a partial mesh.",{"_3582":2130,"_31169":2092,"_21582":57479,"_5":14829,"_28301":57375,"_3051":57480},[],"Hybrid",{"_3582":2131,"_31169":2092,"_21582":57482,"_5":14829,"_28301":57375,"_3051":57483},[],"Combines hierarchies and cross-certification links.",{"_3582":2132,"_31169":2092,"_21582":57485,"_5":14829,"_28301":57375,"_3051":57486},[],"Document alternative paths and constraints; consumers may build or accept different paths.",{"_3582":2133,"_31169":2092,"_21582":57488,"_5":14829,"_28301":57375,"_3051":57392},[],{"_3582":2134,"_31169":2092,"_21582":57490,"_5":14829,"_28301":57375,"_3051":57491},[],"`Unifying CA → PCA-A` and `Unifying CA → PCA-B`.",{"_3582":2135,"_31169":2092,"_21582":57493,"_5":14829,"_28301":57375,"_3051":57494},[],"Cross-domain validation requires trust in the unifying CA and access to cross-certificates. PCAs retain their self-signed certificates.",{"_3582":2136,"_31169":2092,"_21582":57496,"_5":14829,"_28301":57375,"_3051":57497},[],"Direct cross-certification",{"_3582":2137,"_31169":2092,"_21582":57499,"_5":14829,"_28301":57375,"_3051":57500},[],"`PCA-A → PCA-B`; add `PCA-B → PCA-A` for reciprocity.",{"_3582":2138,"_31169":2092,"_21582":57502,"_5":14829,"_28301":57375,"_3051":57503},[],"Each domain keeps its anchor; test both directions and restrict unwanted paths.",{"_3582":2139,"_31169":2092,"_21582":57505,"_5":14829,"_28301":57375,"_3051":57396},[],{"_3582":2140,"_31169":2092,"_21582":57507,"_5":14829,"_28301":57375,"_3051":57508},[],"`PCA-A → Bridge → PCA-B`; add reverse signatures for the opposite path.",{"_3582":2141,"_31169":2092,"_21582":57510,"_5":14829,"_28301":57375,"_3051":57511},[],"The bridge is not a domain anchor and issues end-entity certificates only for its own operation. Agree policies and constraints.",{"_3582":2142,"_31169":2092,"_21582":57513,"_5":14829,"_28301":57375,"_3051":57514},[],"Trust list",{"_3582":2143,"_31169":2092,"_21582":57516,"_5":14829,"_28301":57375,"_3051":57517},[],"The consumer trusts roots A and B, locally or through a trust authority managing the list.",{"_3582":2144,"_31169":2092,"_21582":57519,"_5":14829,"_28301":57375,"_3051":57520},[],"Cross-certification is unnecessary. Distributing certificates does not install trust anchors; control updates and removal.",{"_3582":2145,"_31169":2092,"_21582":57522,"_5":14829,"_28301":57375,"_3051":57523},[],"A PCA is the principal CA designated for relationships between PKIs; an identity is an end-entity certificate. The first four rows describe architectures within a PKI, the next three relationships between domains, and the last a trust model external to those relationships. An ordinary intermediate alone does not demonstrate a unifying CA.",{"_3582":2146,"_31169":2092,"_21582":57525,"_5":14829,"_28301":57375,"_3051":57526},[],"Each diagram below is a short sequence of steps you can play, pause or jump between. A CA is drawn as what it is — a key pair — with one row per certificate issued for that key: a root starts with its self-signed certificate and gains a second row when another CA cross-signs it, same subject and same key under a different issuer. Rows a later step will fill are outlined from the start. Solid arrows indicate certificate issuance; dashed arrows indicate configured trust or distribution, as labeled. The green trace is a validation path: it runs from the identity back to the anchor, opposite to the issuance arrows. An available path is not necessarily accepted by a validator.",{"_3582":2147,"_31169":2092,"_21582":57528,"_5":14829,"_28301":57379,"_3051":57529},[],"A single CA signs identities directly:",{"_3582":2148,"_31169":2092,"_21582":57531,"_5":14829,"_28301":57379,"_3051":57532},[],"A hierarchy separates the root from issuing CAs:",{"_3582":2149,"_31169":2092,"_21582":57534,"_5":14829,"_28301":57379,"_3051":57535},[],"A single-CA PKI uses a self-signed root to issue identities directly. It is easy to understand and useful for an initial test, but concentrates issuance and trust in one key. If that key is compromised, the anchor must be replaced and affected identities renewed.",{"_3582":2150,"_31169":2092,"_21582":57537,"_5":14829,"_28301":57379,"_3051":57538},[],"In a hierarchy, the root signs one or more intermediate CAs that issue identities. This separates, for example, production from testing or devices from services, and allows root usage to be restricted. Each consumer needs to trust the root and have the intermediates available to build the chain. The design must account for permitted depth, uses and expiration at each CA.",{"_3582":2151,"_31169":2092,"_21582":57540,"_5":14829,"_28301":57379,"_3051":57541},[],"In Lamassu, create a root and issue an identity for the first case; for the second, create an intermediate under another root and issue from it. Download the certificates and validate both chains from a consumer, including a test with an incorrect anchor.",{"_3582":2152,"_31169":2092,"_21582":57543,"_5":14829,"_28301":57379,"_3051":57544},[],"The following interactive walkthrough shows both scenarios in the console: the standalone root and the hierarchy, with the public certificates and the downloaded identity certificates.",{"_3582":2153,"_31169":2092,"_21582":57546,"_5":14829,"_28301":57383,"_3051":57547},[],"Bilateral cross-certification: each domain keeps its anchor. Validating B from A uses B’s certificate signed by A; the reverse direction requires the opposite signature.",{"_3582":2154,"_31169":2092,"_21582":57549,"_5":14829,"_28301":57383,"_3051":57550},[],"Example partial mesh: the C → A and C → B signatures are absent; reciprocity must not be assumed.",{"_3582":2155,"_31169":2092,"_21582":57552,"_5":14829,"_28301":57383,"_3051":57553},[],"Cross-certification lets one CA issue a certificate for another CA's public key. A consumer trusting A can then build a path to an identity issued by B using B's certificate signed by A. B's self-signed certificate can remain available for its own consumers. For consumers trusting B to validate identities from A, a signature in the opposite direction and a path accepted by their validator are needed.",{"_3582":2156,"_31169":2092,"_21582":57555,"_5":14829,"_28301":57383,"_3051":57556},[],"A mesh extends this relationship to several CAs: it is full when every CA signs every other CA, and partial when some links are missing. A full mesh offers direct links but increases the number of relationships to manage; a partial mesh reduces links but may leave paths missing or harder to build. A path shown in a graph is not necessarily acceptable to a validator.",{"_3582":2157,"_31169":2092,"_21582":57558,"_5":14829,"_28301":57383,"_3051":57559},[],"To demonstrate this, create roots A, B and C and test certificates. Start with A → B, validate an identity from B using A as the anchor, and check that the opposite direction is not covered until B → A is added. Add links to build a partial mesh and compare available paths. Control the certificates supplied to the validator so alternative paths can be identified.",{"_3582":2158,"_31169":2092,"_21582":57561,"_5":14829,"_28301":57383,"_3051":57562},[],"The following walkthrough shows a partial mesh with A ↔ B, A → C and B → C. The certificates were prepared before recording; the guide describes validations performed outside the console.",{"_3582":2159,"_31169":2092,"_21582":57564,"_5":14829,"_28301":57387,"_3051":57565},[],"Two hierarchies keep their roots and A signs CA B. From anchor A, the chain to identity B includes B’s cross-certificate and intermediate B.",{"_3582":2160,"_31169":2092,"_21582":57567,"_5":14829,"_28301":57387,"_3051":57568},[],"A hybrid PKI combines hierarchies of subordinate CAs with cross-certification. It can arise when two organizations with their own hierarchies need to interoperate without replacing their roots. Each branch retains its structure, but paths between them make certificate distribution, revocation and policy interpretation more complex.",{"_3582":2161,"_31169":2092,"_21582":57570,"_5":14829,"_28301":57387,"_3051":57571},[],"To demonstrate it, create roots A and B, an issuing intermediate under B and an identity issued by it, and add A → B. From anchor A, the consumer needs B's certificate signed by A and B's intermediate to validate the final identity. Also check failure when a link is missing and look for alternative paths.",{"_3582":2162,"_31169":2092,"_21582":57573,"_5":14829,"_28301":57387,"_3051":57574},[],"The following walkthrough starts from those CAs, prepared before recording, and performs the A → B cross-signing with the **Cross Sign** operation. It then compares the authorities table, hierarchy and graph: B appears twice, as a self-signed root and under A, with the same key and a different issuer. Each step's guide describes the validations, which were performed outside the console.",{"_3582":2163,"_31169":2092,"_21582":57576,"_5":14829,"_28301":57387,"_3051":57577},[],"With OpenSSL, using only A as the anchor and B's cross certificate plus the intermediate as auxiliary material, the path `identity → intermediate → B (cross) → A` validates:",{"_3582":2164,"_31169":2092,"_21582":57579,"_5":14829,"_28301":57387,"_3051":57580},[],"Validation fails if the cross certificate is omitted, if the intermediate is missing, or if an unrelated root is used as the anchor. If the validator also trusts B, it may choose the direct path, shorter and not going through A: the cross certificate does not make it unnecessary. The cross certificate has its own expiry (three years in the demo), earlier than root B's and the intermediate's, so the path through A stops validating the intermediate before the direct one does. The demo's certificates contain no certificate policies, name constraints, policy constraints or maximum path length, and this version's **Cross Sign** operation offers no controls for them. The demo therefore does not prove conformance with RFC 5217, only path building with the basic extensions.",{"_3582":2165,"_31169":2092,"_21582":57582,"_5":14829,"_28301":57391,"_3051":57583},[],"Relying parties validating both domains use the unifying CA as their anchor and the PCAs’ cross-certificates.",{"_3582":2166,"_31169":2092,"_21582":57585,"_5":14829,"_28301":57391,"_3051":57586},[],"This model adds a superior CA that unilaterally signs the PCAs of participating domains. Each PCA can keep its self-signed certificate and existing operation; consumers that need cross-domain validation use the unifying CA as their anchor and obtain the required cross-certificates.",{"_3582":2167,"_31169":2092,"_21582":57588,"_5":14829,"_28301":57391,"_3051":57589},[],"The benefit is a common trust point without necessarily rebuilding existing PKIs. In exchange, participants must distribute and govern the new anchor, agree policies and assess the impact of its compromise or replacement. A consumer needing only its own domain can continue to trust its existing PCA.",{"_3582":2168,"_31169":2092,"_21582":57591,"_5":14829,"_28301":57391,"_3051":57592},[],"For the demo, first create two self-signed PCAs, then the links Unifier → PCA-A and Unifier → PCA-B. Issue an identity from each domain and validate both from the unifying anchor; check that the cross-certificates correspond to the same keys as the original PCAs.",{"_3582":2169,"_31169":2092,"_21582":57594,"_5":14829,"_28301":57395,"_3051":57595},[],"Each domain keeps its anchor. Signatures in both directions allow paths A → bridge → B and B → bridge → A.",{"_3582":2170,"_31169":2092,"_21582":57597,"_5":14829,"_28301":57395,"_3051":57598},[],"A bridge CA connects domains that retain their own anchors. To validate an identity from B using A as the anchor, the path can follow A → Bridge → B; the opposite direction requires the corresponding links. The bridge must not become a domain anchor and does not issue end-entity certificates except those required for its own operation.",{"_3582":2171,"_31169":2092,"_21582":57600,"_5":14829,"_28301":57395,"_3051":57601},[],"Centralizing relationships through a bridge can reduce direct agreements, but requires shared governance, documented policies, policy mapping and consistent constraints. It also increases the importance of validators discovering and processing paths and extensions correctly.",{"_3582":2172,"_31169":2092,"_21582":57603,"_5":14829,"_28301":57395,"_3051":57604},[],"For the demo, create two PCAs and a bridge CA, establish the links needed in both directions, and validate an identity from each domain using the other's anchor. Inspect the extensions and document any RFC requirement that the deployed version or validator cannot verify: a connected graph alone does not demonstrate a complete bridge model.",{"_3582":2173,"_31169":2092,"_21582":57606,"_5":14829,"_28301":57399,"_3051":57607},[],"Local list: the relying party configures both roots as anchors, without cross-signatures between them.",{"_3582":2174,"_31169":2092,"_21582":57609,"_5":14829,"_28301":57399,"_3051":57610},[],"Trust authority: an entity maintains a shared list that relying parties use according to their configuration.",{"_3582":2175,"_31169":2092,"_21582":57612,"_5":14829,"_28301":57399,"_3051":57613},[],"A trust list allows a consumer to accept several PKIs by explicitly installing their anchors, without the CAs cross-certifying one another. The list may be managed locally or by a trust authority for multiple consumers. This is a direct approach, although managing additions, removals and updates becomes harder as the number of consumers grows.",{"_3582":2176,"_31169":2092,"_21582":57615,"_5":14829,"_28301":57399,"_3051":57616},[],"For the demo, create two independent roots and an identity under each. Validate both with a list containing both roots, then remove one root and check that the corresponding identity no longer validates. If you distribute certificates through EST `/cacerts`, show the consumer's decision to install them as anchors separately.",{"_3582":2177,"_31169":2092,"_21582":57618,"_5":14829,"_28301":57403,"_3051":57619},[],"You can create roots and intermediates, issue identities and register external CAs as described in Authorities. The dashboard code also includes a cross-signing operation that creates another certificate for the target CA's existing key, signed by the selected CA. Availability depends on the deployed version. In that flow both CAs must be active and have their private keys in the KMS; a certificate-only import is insufficient. Verify the public key and that the cross-certificate subject reproduces the target CA's subject: some imported subjects cannot be reproduced exactly.",{"_3582":2178,"_31169":2092,"_21582":57621,"_5":14829,"_28301":57403,"_3051":57622},[],"The operation can build links for these topologies, but the graph or issuance alone does not prove interoperability or full RFC conformance. Inspect `basicConstraints`, `keyCertSign`, validity, path length, and name and policy constraints. Verify `policyMappings` and `policyConstraints` availability and processing in the deployed version and each validator. Agree policies, assurance levels, publication and revocation across domains.",{"_3582":2179,"_31169":2092,"_21582":57624,"_5":14829,"_28301":57403,"_3051":57625},[],"For each path, download the identity and required CA certificates. Validate from the relying party with its explicit trust anchor and intermediates as auxiliary material; also test the reverse direction and a case that must fail. Repeat with the revocation and policy checks actually enforced by that consumer. See Validation and Trust distribution.",{"_3582":2180,"_31169":2092,"_21582":57627,"_5":14829,"_28301":57407,"_3051":57628},[],"The device proves it can enroll according to the DMS policy.",{"_3582":2181,"_31169":2092,"_21582":57630,"_5":14829,"_28301":57407,"_3051":57631},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3582":2182,"_31169":2092,"_21582":57633,"_5":14829,"_28301":57407,"_3051":57634},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3582":2183,"_31169":2092,"_21582":57636,"_5":14829,"_28301":57407,"_3051":57637},[],"The device installs the certificate and the chain it needs.",{"_3582":2184,"_31169":2092,"_21582":57639,"_5":14829,"_28301":57407,"_3051":57640},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3582":2185,"_31169":2092,"_21582":57642,"_5":14829,"_28301":57407,"_3051":57643},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3582":2186,"_31169":2092,"_21582":57645,"_5":14829,"_28301":57411,"_3051":57646},[],"A DMS relates three sets that are worth designing separately:",{"_3582":2187,"_31169":2092,"_21582":57648,"_5":14829,"_28301":57411,"_3051":57649},[],"**Enrollment CA:** signs the new identities.",{"_3582":2188,"_31169":2092,"_21582":57651,"_5":14829,"_28301":57411,"_3051":57652},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3582":2189,"_31169":2092,"_21582":57654,"_5":14829,"_28301":57411,"_3051":57655},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3582":2190,"_31169":2092,"_21582":57657,"_5":14829,"_28301":57411,"_3051":57658},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3582":2191,"_31169":2092,"_21582":57660,"_5":14829,"_28301":57415,"_3051":57661},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3582":2192,"_31169":2092,"_21582":57663,"_5":14829,"_28301":57415,"_3051":57664},[],"that the current date is between `Not Before` and `Not After`;",{"_3582":2193,"_31169":2092,"_21582":57666,"_5":14829,"_28301":57415,"_3051":57667},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3582":2194,"_31169":2092,"_21582":57669,"_5":14829,"_28301":57415,"_3051":57670},[],"that names, SANs and subject match the expected identity;",{"_3582":2195,"_31169":2092,"_21582":57672,"_5":14829,"_28301":57415,"_3051":57673},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3582":2196,"_31169":2092,"_21582":57675,"_5":14829,"_28301":57415,"_3051":57676},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3582":2197,"_31169":2092,"_21582":57678,"_5":14829,"_28301":57415,"_3051":57679},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3582":2198,"_31169":2092,"_21582":57681,"_5":14829,"_28301":57419,"_3051":57682},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3582":2199,"_31169":2092,"_21582":57684,"_5":14829,"_28301":57423,"_3051":57685},[],"Keep the root out of daily operations, or with very restricted access.",{"_3582":2200,"_31169":2092,"_21582":57687,"_5":14829,"_28301":57423,"_3051":57688},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3582":2201,"_31169":2092,"_21582":57690,"_5":14829,"_28301":57423,"_3051":57691},[],"Assign explicit profiles to every use case.",{"_3582":2202,"_31169":2092,"_21582":57693,"_5":14829,"_28301":57423,"_3051":57694},[],"Distribute the new trust before starting a rotation.",{"_3582":2203,"_31169":2092,"_21582":57696,"_5":14829,"_28301":57423,"_3051":57697},[],"Keep enough overlap to renew a disconnected fleet.",{"_3582":2204,"_31169":2092,"_21582":57699,"_5":14829,"_28301":57423,"_3051":57700},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3582":2205,"_31169":2092,"_21582":57702,"_5":14829,"_28301":57423,"_3051":57703},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3582":2206,"_31169":2206,"_5":15200,"_3051":57705,"_31527":57706,"_21582":57707,"_28301":2206},"Revocation lists (CRL)",[50837,52312,56320,56959],[],{"_3582":2207,"_31169":2206,"_21582":57709,"_5":14829,"_28301":2206,"_3051":57710},[],"Generate and distribute signed lists to validate certificates offline.",{"_3582":2208,"_31169":2206,"_5":31524,"_21582":57712,"_28301":57713,"_3051":57714},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings","CRL settings",{"_3582":2209,"_31169":2206,"_5":31524,"_21582":57716,"_28301":57717,"_3051":57718},[],"/docs/pr-preview/pr-61/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3582":2210,"_31169":2206,"_5":31524,"_21582":57720,"_28301":57721,"_3051":57722},[],"/docs/pr-preview/pr-61/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3582":2211,"_31169":2206,"_5":31524,"_21582":57724,"_28301":57725,"_3051":57726},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-contents","CRL contents",{"_3582":2212,"_31169":2206,"_5":31524,"_21582":57728,"_28301":57729,"_3051":57730},[],"/docs/pr-preview/pr-61/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3582":2213,"_31169":2206,"_5":31524,"_21582":57732,"_28301":57733,"_3051":57734},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings-api","CRL settings API",{"_3582":2214,"_31169":2206,"_5":31524,"_21582":57736,"_28301":57737,"_3051":57738},[],"/docs/pr-preview/pr-61/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3582":2215,"_31169":2206,"_5":31524,"_21582":57740,"_28301":57741,"_3051":57742},[],"/docs/pr-preview/pr-61/platform/pki/crl#from-the-interface","From the interface",{"_3582":2216,"_31169":2206,"_5":31524,"_21582":57744,"_28301":57745,"_3051":57746},[],"/docs/pr-preview/pr-61/platform/pki/crl#references","References",{"_3582":2217,"_31169":2206,"_21582":57748,"_5":14829,"_28301":2206,"_3051":57749},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3582":2218,"_31169":2206,"_21582":57751,"_5":14829,"_28301":57713,"_3051":57752},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3582":2219,"_31169":2206,"_21582":57754,"_5":14829,"_28301":57713,"_3051":57755},[],"Field",{"_3582":2220,"_31169":2206,"_21582":57757,"_5":14829,"_28301":57713,"_3051":51227},[],{"_3582":2221,"_31169":2206,"_21582":57759,"_5":14829,"_28301":57713,"_3051":57760},[],"`ca_id`",{"_3582":2222,"_31169":2206,"_21582":57762,"_5":14829,"_28301":57713,"_3051":57763},[],"ID of the CA the settings belong to.",{"_3582":2223,"_31169":2206,"_21582":57765,"_5":14829,"_28301":57713,"_3051":57766},[],"`status`",{"_3582":2224,"_31169":2206,"_21582":57768,"_5":14829,"_28301":57713,"_3051":57769},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3582":2225,"_31169":2206,"_21582":57771,"_5":14829,"_28301":57713,"_3051":57772},[],"`legacy_ski`",{"_3582":2226,"_31169":2206,"_21582":57774,"_5":14829,"_28301":57713,"_3051":57775},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3582":2227,"_31169":2206,"_21582":57777,"_5":14829,"_28301":57713,"_3051":57778},[],"`latest_crl`",{"_3582":2228,"_31169":2206,"_21582":57780,"_5":14829,"_28301":57713,"_3051":57781},[],"Version, validity start and end of the last published list. Read-only.",{"_3582":2229,"_31169":2206,"_21582":57783,"_5":14829,"_28301":57713,"_3051":57784},[],"`crl_options` field",{"_3582":2230,"_31169":2206,"_21582":57786,"_5":14829,"_28301":57713,"_3051":51227},[],{"_3582":2231,"_31169":2206,"_21582":57788,"_5":14829,"_28301":57713,"_3051":57789},[],"Initial value",{"_3582":2232,"_31169":2206,"_21582":57791,"_5":14829,"_28301":57713,"_3051":57792},[],"`validity`",{"_3582":2233,"_31169":2206,"_21582":57794,"_5":14829,"_28301":57713,"_3051":57795},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3582":2234,"_31169":2206,"_21582":57797,"_5":14829,"_28301":57713,"_3051":57798},[],"7 days.",{"_3582":2235,"_31169":2206,"_21582":57800,"_5":14829,"_28301":57713,"_3051":57801},[],"`refresh_interval`",{"_3582":2236,"_31169":2206,"_21582":57803,"_5":14829,"_28301":57713,"_3051":57804},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3582":2237,"_31169":2206,"_21582":57806,"_5":14829,"_28301":57713,"_3051":57807},[],"6 days and 23 hours.",{"_3582":2238,"_31169":2206,"_21582":57809,"_5":14829,"_28301":57713,"_3051":57810},[],"`regenerate_on_revoke`",{"_3582":2239,"_31169":2206,"_21582":57812,"_5":14829,"_28301":57713,"_3051":57813},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3582":2240,"_31169":2206,"_21582":57815,"_5":14829,"_28301":57713,"_3051":57816},[],"`true`.",{"_3582":2241,"_31169":2206,"_21582":57818,"_5":14829,"_28301":57713,"_3051":57819},[],"`signer_serial_number`",{"_3582":2242,"_31169":2206,"_21582":57821,"_5":14829,"_28301":57713,"_3051":57822},[],"Serial number of the existing certificate that signs the CRL.",{"_3582":2243,"_31169":2206,"_21582":57824,"_5":14829,"_28301":57713,"_3051":57825},[],"Serial number of the CA’s current certificate.",{"_3582":2244,"_31169":2206,"_21582":57827,"_5":14829,"_28301":57713,"_3051":57828},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3582":2245,"_31169":2206,"_21582":57830,"_5":14829,"_28301":57713,"_3051":57831},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3582":2246,"_31169":2206,"_21582":57833,"_5":14829,"_28301":57713,"_3051":57834},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3582":2247,"_31169":2206,"_21582":57836,"_5":14829,"_28301":57713,"_3051":57837},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3582":2248,"_31169":2206,"_21582":57839,"_5":14829,"_28301":57713,"_3051":57840},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3582":2249,"_31169":2206,"_21582":57842,"_5":14829,"_28301":57713,"_3051":57843},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3582":2250,"_31169":2206,"_21582":57845,"_5":14829,"_28301":57713,"_3051":57846},[],"Adjust validity and signer before deleting a CA.",{"_3582":2251,"_31169":2206,"_21582":57848,"_5":14829,"_28301":57713,"_3051":57849},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3582":2252,"_31169":2206,"_21582":57851,"_5":14829,"_28301":57713,"_3051":57852},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3582":2253,"_31169":2206,"_21582":57854,"_5":14829,"_28301":57713,"_3051":57855},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3582":2254,"_31169":2206,"_21582":57857,"_5":14829,"_28301":57717,"_3051":57858},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3582":2255,"_31169":2206,"_21582":57860,"_5":14829,"_28301":57717,"_3051":57861},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3582":2256,"_31169":2206,"_21582":57863,"_5":14829,"_28301":57717,"_3051":57864},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3582":2257,"_31169":2206,"_21582":57866,"_5":14829,"_28301":57717,"_3051":57867},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3582":2258,"_31169":2206,"_21582":57869,"_5":14829,"_28301":57721,"_3051":57870},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3582":2259,"_31169":2206,"_21582":57872,"_5":14829,"_28301":57721,"_3051":57873},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3582":2260,"_31169":2206,"_21582":57875,"_5":14829,"_28301":57721,"_3051":57876},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3582":2261,"_31169":2206,"_21582":57878,"_5":14829,"_28301":57721,"_3051":57879},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3582":2262,"_31169":2206,"_21582":57881,"_5":14829,"_28301":57721,"_3051":57882},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3582":2263,"_31169":2206,"_21582":57884,"_5":14829,"_28301":57721,"_3051":57885},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3582":2264,"_31169":2206,"_21582":57887,"_5":14829,"_28301":57721,"_3051":57888},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3582":2265,"_31169":2206,"_21582":57890,"_5":14829,"_28301":57721,"_3051":57891},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3582":2266,"_31169":2206,"_21582":57893,"_5":14829,"_28301":57721,"_3051":57894},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3582":2267,"_31169":2206,"_21582":57896,"_5":14829,"_28301":57725,"_3051":57897},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3582":2268,"_31169":2206,"_21582":57899,"_5":14829,"_28301":57725,"_3051":57900},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3582":2269,"_31169":2206,"_21582":57902,"_5":14829,"_28301":57729,"_3051":57903},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3582":2270,"_31169":2206,"_21582":57905,"_5":14829,"_28301":57729,"_3051":57906},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3582":2271,"_31169":2206,"_21582":57908,"_5":14829,"_28301":57729,"_3051":57909},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3582":2272,"_31169":2206,"_21582":57911,"_5":14829,"_28301":57729,"_3051":57912},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3582":2273,"_31169":2206,"_21582":57914,"_5":14829,"_28301":57729,"_3051":57915},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3582":2274,"_31169":2206,"_21582":57917,"_5":14829,"_28301":57733,"_3051":57918},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3582":2275,"_31169":2206,"_21582":57920,"_5":14829,"_28301":57733,"_3051":54085},[],{"_3582":2276,"_31169":2206,"_21582":57922,"_5":14829,"_28301":57733,"_3051":57923},[],"Relative path",{"_3582":2277,"_31169":2206,"_21582":57925,"_5":14829,"_28301":57733,"_3051":54082},[],{"_3582":2278,"_31169":2206,"_21582":57927,"_5":14829,"_28301":57733,"_3051":57928},[],"`GET`",{"_3582":2279,"_31169":2206,"_21582":57930,"_5":14829,"_28301":57733,"_3051":57931},[],"`/v1/crl-settings`",{"_3582":2280,"_31169":2206,"_21582":57933,"_5":14829,"_28301":57733,"_3051":57934},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3582":2281,"_31169":2206,"_21582":57936,"_5":14829,"_28301":57733,"_3051":57928},[],{"_3582":2282,"_31169":2206,"_21582":57938,"_5":14829,"_28301":57733,"_3051":57939},[],"`/v1/crl-settings/{ca-id}`",{"_3582":2283,"_31169":2206,"_21582":57941,"_5":14829,"_28301":57733,"_3051":57942},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3582":2284,"_31169":2206,"_21582":57944,"_5":14829,"_28301":57733,"_3051":57945},[],"`PUT`",{"_3582":2285,"_31169":2206,"_21582":57947,"_5":14829,"_28301":57733,"_3051":57939},[],{"_3582":2286,"_31169":2206,"_21582":57949,"_5":14829,"_28301":57733,"_3051":57950},[],"Replace the CRL configuration of a CA.",{"_3582":2287,"_31169":2206,"_21582":57952,"_5":14829,"_28301":57733,"_3051":57953},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3582":2288,"_31169":2206,"_21582":57955,"_5":14829,"_28301":57733,"_3051":57956},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3582":2289,"_31169":2206,"_21582":57958,"_5":14829,"_28301":57737,"_3051":57959},[],"Symptom",{"_3582":2290,"_31169":2206,"_21582":57961,"_5":14829,"_28301":57737,"_3051":57962},[],"Cause",{"_3582":2291,"_31169":2206,"_21582":57964,"_5":14829,"_28301":57737,"_3051":57965},[],"Action",{"_3582":2292,"_31169":2206,"_21582":57967,"_5":14829,"_28301":57737,"_3051":57968},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3582":2293,"_31169":2206,"_21582":57970,"_5":14829,"_28301":57737,"_3051":57971},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3582":2294,"_31169":2206,"_21582":57973,"_5":14829,"_28301":57737,"_3051":57974},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3582":2295,"_31169":2206,"_21582":57976,"_5":14829,"_28301":57737,"_3051":57977},[],"`PUT` returns 400.",{"_3582":2296,"_31169":2206,"_21582":57979,"_5":14829,"_28301":57737,"_3051":57980},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3582":2297,"_31169":2206,"_21582":57982,"_5":14829,"_28301":57737,"_3051":57983},[],"Set the serial number of a valid certificate of that CA.",{"_3582":2298,"_31169":2206,"_21582":57985,"_5":14829,"_28301":57737,"_3051":57986},[],"`PUT` returns 404.",{"_3582":2299,"_31169":2206,"_21582":57988,"_5":14829,"_28301":57737,"_3051":57989},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3582":2300,"_31169":2206,"_21582":57991,"_5":14829,"_28301":57737,"_3051":57992},[],"Check the CA ID and the signer serial number.",{"_3582":2301,"_31169":2206,"_21582":57994,"_5":14829,"_28301":57737,"_3051":57995},[],"`PUT` returns 400 from a 3.x client.",{"_3582":2302,"_31169":2206,"_21582":57997,"_5":14829,"_28301":57737,"_3051":57998},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3582":2303,"_31169":2206,"_21582":58000,"_5":14829,"_28301":57737,"_3051":58001},[],"Update the client to send the new field.",{"_3582":2304,"_31169":2206,"_21582":58003,"_5":14829,"_28301":57737,"_3051":58004},[],"The CRL does not change after revoking a certificate.",{"_3582":2305,"_31169":2206,"_21582":58006,"_5":14829,"_28301":57737,"_3051":58007},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3582":2306,"_31169":2206,"_21582":58009,"_5":14829,"_28301":57737,"_3051":58010},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3582":2307,"_31169":2206,"_21582":58012,"_5":14829,"_28301":57737,"_3051":58013},[],"A verifier rejects the CRL because of the issuer.",{"_3582":2308,"_31169":2206,"_21582":58015,"_5":14829,"_28301":57737,"_3051":58016},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3582":2309,"_31169":2206,"_21582":58018,"_5":14829,"_28301":57737,"_3051":58019},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3582":2310,"_31169":2206,"_21582":58021,"_5":14829,"_28301":57741,"_3051":58022},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3582":2311,"_31169":2206,"_21582":58024,"_5":14829,"_28301":57745,"_3051":58025},[],"RFC 5280: X.509 and CRL profile.",{"_3582":2312,"_31169":2206,"_21582":58027,"_5":14829,"_28301":57745,"_3051":58028},[],"OpenSSL: openssl-crl.",{"_3582":2313,"_31169":2206,"_21582":58030,"_5":14829,"_28301":57745,"_3051":58031},[],"OpenSSL: openssl-verify.",{"_3582":2314,"_31169":2206,"_21582":58033,"_5":14829,"_28301":57745,"_3051":58034},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3582":2315,"_31169":2206,"_21582":58036,"_5":14829,"_28301":57745,"_3051":58037},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3582":2316,"_31169":2316,"_5":15200,"_3051":58039,"_31527":58040,"_21582":58041,"_28301":2316},"Keys and cryptographic engines",[50837,52312,56320,56321],[],{"_3582":2317,"_31169":2316,"_21582":58043,"_5":14829,"_28301":2316,"_3051":58044},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3582":2318,"_31169":2316,"_5":31524,"_21582":58046,"_28301":58047,"_3051":58048},[],"/docs/pr-preview/pr-61/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3582":2319,"_31169":2316,"_5":31524,"_21582":58050,"_28301":58051,"_3051":58052},[],"/docs/pr-preview/pr-61/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3582":2320,"_31169":2316,"_5":31524,"_21582":58054,"_28301":58055,"_3051":58056},[],"/docs/pr-preview/pr-61/platform/pki/key-management#file-system","File System",{"_3582":2321,"_31169":2316,"_5":31524,"_21582":58058,"_28301":58059,"_3051":58060},[],"/docs/pr-preview/pr-61/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3582":2322,"_31169":2316,"_5":31524,"_21582":58062,"_28301":58063,"_3051":58064},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3582":2323,"_31169":2316,"_5":31524,"_21582":58066,"_28301":58067,"_3051":58068},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-kms","AWS KMS",{"_3582":2324,"_31169":2316,"_5":31524,"_21582":58070,"_28301":58071,"_3051":58072},[],"/docs/pr-preview/pr-61/platform/pki/key-management#pkcs11","PKCS#11",{"_3582":2325,"_31169":2316,"_5":31524,"_21582":58074,"_28301":58075,"_3051":58076},[],"/docs/pr-preview/pr-61/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3582":2326,"_31169":2316,"_5":31524,"_21582":58078,"_28301":58079,"_3051":58080},[],"/docs/pr-preview/pr-61/platform/pki/key-management#key-inventory","Key inventory",{"_3582":2327,"_31169":2316,"_5":31524,"_21582":58082,"_28301":58083,"_3051":58084},[],"/docs/pr-preview/pr-61/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3582":2328,"_31169":2316,"_5":31524,"_21582":58086,"_28301":58087,"_3051":58088},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3582":2329,"_31169":2316,"_5":31524,"_21582":58090,"_28301":58091,"_3051":58092},[],"/docs/pr-preview/pr-61/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3582":2330,"_31169":2316,"_5":31524,"_21582":58094,"_28301":58095,"_3051":58096},[],"/docs/pr-preview/pr-61/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3582":2331,"_31169":2316,"_5":31524,"_21582":58098,"_28301":58099,"_3051":58100},[],"/docs/pr-preview/pr-61/platform/pki/key-management#view-details","View details",{"_3582":2332,"_31169":2316,"_5":31524,"_21582":58102,"_28301":58103,"_3051":58104},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3582":2333,"_31169":2316,"_5":31524,"_21582":58106,"_28301":58107,"_3051":58108},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign","Sign",{"_3582":2334,"_31169":2316,"_5":31524,"_21582":58110,"_28301":58111,"_3051":58112},[],"/docs/pr-preview/pr-61/platform/pki/key-management#verify","Verify",{"_3582":2335,"_31169":2316,"_5":31524,"_21582":58114,"_28301":58115,"_3051":58116},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3582":2336,"_31169":2316,"_5":31524,"_21582":58118,"_28301":58119,"_3051":58120},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3582":2337,"_31169":2316,"_5":31524,"_21582":58122,"_28301":58123,"_3051":58124},[],"/docs/pr-preview/pr-61/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3582":2338,"_31169":2316,"_21582":58126,"_5":14829,"_28301":2316,"_3051":58127},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3582":2339,"_31169":2316,"_21582":58129,"_5":14829,"_28301":2316,"_3051":58130},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3582":2340,"_31169":2316,"_21582":58132,"_5":14829,"_28301":58047,"_3051":58133},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3582":2341,"_31169":2316,"_21582":58135,"_5":14829,"_28301":58047,"_3051":58136},[],"In practice, it lets you:",{"_3582":2342,"_31169":2316,"_21582":58138,"_5":14829,"_28301":58047,"_3051":58139},[],"Generate new key pairs from Lamassu IoT.",{"_3582":2343,"_31169":2316,"_21582":58141,"_5":14829,"_28301":58047,"_3051":58142},[],"Import keys created externally.",{"_3582":2344,"_31169":2316,"_21582":58144,"_5":14829,"_28301":58047,"_3051":58145},[],"Delegate custody and cryptographic operations to external engines.",{"_3582":2345,"_31169":2316,"_21582":58147,"_5":14829,"_28301":58047,"_3051":58148},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3582":2346,"_31169":2316,"_21582":58150,"_5":14829,"_28301":58051,"_3051":58151},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3582":2347,"_31169":2316,"_21582":58153,"_5":14829,"_28301":58051,"_3051":58154},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3582":2348,"_31169":2316,"_21582":58156,"_5":14829,"_28301":58051,"_3051":58157},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3582":2349,"_31169":2316,"_21582":58159,"_5":14829,"_28301":58055,"_3051":58160},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3582":2350,"_31169":2316,"_21582":58162,"_5":14829,"_28301":58059,"_3051":58163},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3582":2351,"_31169":2316,"_21582":58165,"_5":14829,"_28301":58059,"_3051":58166},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3582":2352,"_31169":2316,"_21582":58168,"_5":14829,"_28301":58063,"_3051":58169},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3582":2353,"_31169":2316,"_21582":58171,"_5":14829,"_28301":58067,"_3051":58172},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3582":2354,"_31169":2316,"_21582":58174,"_5":14829,"_28301":58071,"_3051":58175},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3582":2355,"_31169":2316,"_21582":58177,"_5":14829,"_28301":58075,"_3051":58178},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3582":2356,"_31169":2316,"_21582":58180,"_5":14829,"_28301":58075,"_3051":58181},[],"Lamassu shows the enabled engines in the console.",{"_3582":2357,"_31169":2316,"_21582":58183,"_5":14829,"_28301":58075,"_3051":58184},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3582":2358,"_31169":2316,"_21582":58186,"_5":14829,"_28301":58075,"_3051":58187},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3582":2359,"_31169":2316,"_21582":58189,"_5":14829,"_28301":58079,"_3051":58190},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3582":2360,"_31169":2316,"_21582":58192,"_5":14829,"_28301":58079,"_3051":58193},[],"The table includes the following fields:",{"_3582":2361,"_31169":2316,"_21582":58195,"_5":14829,"_28301":58079,"_3051":58196},[],"**Name**: descriptive name of the key.",{"_3582":2362,"_31169":2316,"_21582":58198,"_5":14829,"_28301":58079,"_3051":58199},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3582":2363,"_31169":2316,"_21582":58201,"_5":14829,"_28301":58079,"_3051":58202},[],"**Strength**: visual indicator of cryptographic strength.",{"_3582":2364,"_31169":2316,"_21582":58204,"_5":14829,"_28301":58079,"_3051":58205},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3582":2365,"_31169":2316,"_21582":58207,"_5":14829,"_28301":58079,"_3051":58208},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3582":2366,"_31169":2316,"_21582":58210,"_5":14829,"_28301":58079,"_3051":58211},[],"**Aliases**: alternative names associated with the key.",{"_3582":2367,"_31169":2316,"_21582":58213,"_5":14829,"_28301":58079,"_3051":58214},[],"**Tags**: labels for classification and search.",{"_3582":2368,"_31169":2316,"_21582":58216,"_5":14829,"_28301":58079,"_3051":58217},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3582":2369,"_31169":2316,"_21582":58219,"_5":14829,"_28301":58079,"_3051":58220},[],"From this view you also reach the most common actions:",{"_3582":2370,"_31169":2316,"_21582":58222,"_5":14829,"_28301":58079,"_3051":58223},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3582":2371,"_31169":2316,"_21582":58225,"_5":14829,"_28301":58079,"_3051":58226},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3582":2372,"_31169":2316,"_21582":58228,"_5":14829,"_28301":58079,"_3051":58229},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3582":2373,"_31169":2316,"_21582":58231,"_5":14829,"_28301":58079,"_3051":58232},[],"**Delete Key** to remove the key from the system.",{"_3582":2374,"_31169":2316,"_21582":58234,"_5":14829,"_28301":58083,"_3051":58235},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3582":2375,"_31169":2316,"_21582":58237,"_5":14829,"_28301":58087,"_3051":58238},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3582":2376,"_31169":2316,"_21582":58240,"_5":14829,"_28301":58087,"_3051":58241},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3582":2377,"_31169":2316,"_21582":58243,"_5":14829,"_28301":58087,"_3051":58244},[],"**Key Name**: unique and descriptive name.",{"_3582":2378,"_31169":2316,"_21582":58246,"_5":14829,"_28301":58087,"_3051":58247},[],"**Crypto Engine**: engine that will keep the key.",{"_3582":2379,"_31169":2316,"_21582":58249,"_5":14829,"_28301":58087,"_3051":58250},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3582":2380,"_31169":2316,"_21582":58252,"_5":14829,"_28301":58087,"_3051":58253},[],"**Tags**: metadata to classify the key.",{"_3582":2381,"_31169":2316,"_21582":58255,"_5":14829,"_28301":58087,"_3051":58256},[],"**Metadata**: additional information for advanced uses.",{"_3582":2382,"_31169":2316,"_21582":58258,"_5":14829,"_28301":58091,"_3051":58259},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3582":2383,"_31169":2316,"_21582":58261,"_5":14829,"_28301":58091,"_3051":58262},[],"When you have an exportable private key and the destination engine supports import.",{"_3582":2384,"_31169":2316,"_21582":58264,"_5":14829,"_28301":58091,"_3051":58265},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3582":2385,"_31169":2316,"_21582":58267,"_5":14829,"_28301":58091,"_3051":58268},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3582":2386,"_31169":2316,"_21582":58270,"_5":14829,"_28301":58091,"_3051":58271},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3582":2387,"_31169":2316,"_21582":58273,"_5":14829,"_28301":58091,"_3051":58274},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3582":2388,"_31169":2316,"_21582":58276,"_5":14829,"_28301":58091,"_3051":58277},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3582":2389,"_31169":2316,"_21582":58279,"_5":14829,"_28301":58091,"_3051":58280},[],"**Tags**: labels for organization and search.",{"_3582":2390,"_31169":2316,"_21582":58282,"_5":14829,"_28301":58091,"_3051":58283},[],"**Metadata**: additional optional information.",{"_3582":2391,"_31169":2316,"_21582":58285,"_5":14829,"_28301":58091,"_3051":58286},[],"**Private Key (PEM)**: private key in PEM format.",{"_3582":2392,"_31169":2316,"_21582":58288,"_5":14829,"_28301":58091,"_3051":58289},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3582":2393,"_31169":2316,"_21582":58291,"_5":14829,"_28301":58095,"_3051":58292},[],"Each registered key has a detail view and several operational actions.",{"_3582":2394,"_31169":2316,"_21582":58294,"_5":14829,"_28301":58099,"_3051":58295},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3582":2395,"_31169":2316,"_21582":58297,"_5":14829,"_28301":58099,"_3051":58298},[],"The **Overview** tab shows, among others, these fields:",{"_3582":2396,"_31169":2316,"_21582":58300,"_5":14829,"_28301":58099,"_3051":58301},[],"**Key Name**: descriptive name.",{"_3582":2397,"_31169":2316,"_21582":58303,"_5":14829,"_28301":58099,"_3051":58304},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3582":2398,"_31169":2316,"_21582":58306,"_5":14829,"_28301":58099,"_3051":58307},[],"**Tags**: associated labels.",{"_3582":2399,"_31169":2316,"_21582":58309,"_5":14829,"_28301":58099,"_3051":58310},[],"**Aliases**: alternative names.",{"_3582":2400,"_31169":2316,"_21582":58312,"_5":14829,"_28301":58099,"_3051":58313},[],"**Crypto Engine**: engine where the key resides.",{"_3582":2401,"_31169":2316,"_21582":58315,"_5":14829,"_28301":58099,"_3051":58316},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3582":2402,"_31169":2316,"_21582":58318,"_5":14829,"_28301":58099,"_3051":58319},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3582":2403,"_31169":2316,"_21582":58321,"_5":14829,"_28301":58099,"_3051":58322},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3582":2404,"_31169":2316,"_21582":58324,"_5":14829,"_28301":58103,"_3051":58325},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3582":2405,"_31169":2316,"_21582":58327,"_5":14829,"_28301":58103,"_3051":58328},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3582":2406,"_31169":2316,"_21582":58330,"_5":14829,"_28301":58103,"_3051":58331},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3582":2407,"_31169":2316,"_21582":58333,"_5":14829,"_28301":58107,"_3051":58334},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3582":2408,"_31169":2316,"_21582":58336,"_5":14829,"_28301":58107,"_3051":58337},[],"Main fields:",{"_3582":2409,"_31169":2316,"_21582":58339,"_5":14829,"_28301":58107,"_3051":58340},[],"**Algorithm**: signing algorithm available for the key type.",{"_3582":2410,"_31169":2316,"_21582":58342,"_5":14829,"_28301":58107,"_3051":58343},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3582":2411,"_31169":2316,"_21582":58345,"_5":14829,"_28301":58107,"_3051":58346},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3582":2412,"_31169":2316,"_21582":58348,"_5":14829,"_28301":58107,"_3051":58349},[],"**Message**: content to sign.",{"_3582":2413,"_31169":2316,"_21582":58351,"_5":14829,"_28301":58107,"_3051":58352},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3582":2414,"_31169":2316,"_21582":58354,"_5":14829,"_28301":58111,"_3051":58355},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3582":2415,"_31169":2316,"_21582":58357,"_5":14829,"_28301":58111,"_3051":58337},[],{"_3582":2416,"_31169":2316,"_21582":58359,"_5":14829,"_28301":58111,"_3051":58360},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3582":2417,"_31169":2316,"_21582":58362,"_5":14829,"_28301":58111,"_3051":58363},[],"**Message Type**: `Raw` or `Digest`.",{"_3582":2418,"_31169":2316,"_21582":58365,"_5":14829,"_28301":58111,"_3051":58366},[],"**Payload Encoding**: encoding of the message.",{"_3582":2419,"_31169":2316,"_21582":58368,"_5":14829,"_28301":58111,"_3051":58369},[],"**Message**: original message or hash.",{"_3582":2420,"_31169":2316,"_21582":58371,"_5":14829,"_28301":58111,"_3051":58372},[],"**Signature**: signature to check.",{"_3582":2421,"_31169":2316,"_21582":58374,"_5":14829,"_28301":58111,"_3051":58375},[],"**Result**: indicator of the validation result.",{"_3582":2422,"_31169":2316,"_21582":58377,"_5":14829,"_28301":58115,"_3051":58378},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3582":2423,"_31169":2316,"_21582":58380,"_5":14829,"_28301":58115,"_3051":58381},[],"This flow is useful for:",{"_3582":2424,"_31169":2316,"_21582":58383,"_5":14829,"_28301":58115,"_3051":58384},[],"Requesting certificates from an external CA.",{"_3582":2425,"_31169":2316,"_21582":58386,"_5":14829,"_28301":58115,"_3051":58387},[],"Renewing an identity while keeping the same key.",{"_3582":2426,"_31169":2316,"_21582":58389,"_5":14829,"_28301":58115,"_3051":58390},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3582":2427,"_31169":2316,"_21582":58392,"_5":14829,"_28301":58115,"_3051":58393},[],"**Common Name (CN)**: main name of the identity.",{"_3582":2428,"_31169":2316,"_21582":58395,"_5":14829,"_28301":58115,"_3051":58396},[],"**Organization (O)**: organization or company.",{"_3582":2429,"_31169":2316,"_21582":58398,"_5":14829,"_28301":58115,"_3051":58399},[],"**Organizational Unit (OU)**: department or unit.",{"_3582":2430,"_31169":2316,"_21582":58401,"_5":14829,"_28301":58115,"_3051":58402},[],"**Country (C)**: two-letter country code.",{"_3582":2431,"_31169":2316,"_21582":58404,"_5":14829,"_28301":58115,"_3051":58405},[],"**State / Province (ST)**: state or province.",{"_3582":2432,"_31169":2316,"_21582":58407,"_5":14829,"_28301":58115,"_3051":58408},[],"**Locality (L)**: city or locality.",{"_3582":2433,"_31169":2316,"_21582":58410,"_5":14829,"_28301":58115,"_3051":58411},[],"**Email Address**: contact email.",{"_3582":2434,"_31169":2316,"_21582":58413,"_5":14829,"_28301":58115,"_3051":58414},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3582":2435,"_31169":2316,"_21582":58416,"_5":14829,"_28301":58115,"_3051":58417},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3582":2436,"_31169":2316,"_21582":58419,"_5":14829,"_28301":58119,"_3051":58420},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3582":2437,"_31169":2316,"_21582":58422,"_5":14829,"_28301":58119,"_3051":58423},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3582":2438,"_31169":2316,"_21582":58425,"_5":14829,"_28301":58123,"_3051":58426},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3582":2439,"_31169":2316,"_21582":58428,"_5":14829,"_28301":58123,"_3051":58429},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3582":2440,"_31169":2440,"_5":15200,"_3051":58431,"_31527":58432,"_21582":58433,"_28301":2440},"Online validation with OCSP",[50837,52312,56320,56959],[],{"_3582":2441,"_31169":2440,"_21582":58435,"_5":14829,"_28301":2440,"_3051":58436},[],"Query signed status and verify the responder’s response.",{"_3582":2442,"_31169":2440,"_5":31524,"_21582":58438,"_28301":58439,"_3051":58440},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3582":2443,"_31169":2440,"_5":31524,"_21582":58442,"_28301":58443,"_3051":58444},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3582":2444,"_31169":2440,"_5":31524,"_21582":58446,"_28301":58447,"_3051":58448},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3582":2445,"_31169":2440,"_5":31524,"_21582":58450,"_28301":58451,"_3051":58452},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3582":2446,"_31169":2440,"_5":31524,"_21582":58454,"_28301":58455,"_3051":58456},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3582":2447,"_31169":2440,"_5":31524,"_21582":58458,"_28301":58459,"_3051":57746},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#references",{"_3582":2448,"_31169":2440,"_21582":58461,"_5":14829,"_28301":2440,"_3051":58462},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3582":2449,"_31169":2440,"_21582":58464,"_5":14829,"_28301":58439,"_3051":58465},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3582":2450,"_31169":2440,"_21582":58467,"_5":14829,"_28301":58439,"_3051":58468},[],"Record status",{"_3582":2451,"_31169":2440,"_21582":58470,"_5":14829,"_28301":58439,"_3051":58471},[],"Signed response",{"_3582":2452,"_31169":2440,"_21582":58473,"_5":14829,"_28301":58439,"_3051":55457},[],{"_3582":2453,"_31169":2440,"_21582":58475,"_5":14829,"_28301":58439,"_3051":58476},[],"`Good`.",{"_3582":2454,"_31169":2440,"_21582":58478,"_5":14829,"_28301":58439,"_3051":55474},[],{"_3582":2455,"_31169":2440,"_21582":58480,"_5":14829,"_28301":58439,"_3051":58481},[],"`Revoked`, with revocation reason and timestamp.",{"_3582":2456,"_31169":2440,"_21582":58483,"_5":14829,"_28301":58439,"_3051":58484},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3582":2457,"_31169":2440,"_21582":58486,"_5":14829,"_28301":58439,"_3051":58487},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3582":2458,"_31169":2440,"_21582":58489,"_5":14829,"_28301":58439,"_3051":58490},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3582":2459,"_31169":2440,"_21582":58492,"_5":14829,"_28301":58439,"_3051":58493},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3582":2460,"_31169":2440,"_21582":58495,"_5":14829,"_28301":58439,"_3051":58496},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3582":2461,"_31169":2440,"_21582":58498,"_5":14829,"_28301":58443,"_3051":58499},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3582":2462,"_31169":2440,"_21582":58501,"_5":14829,"_28301":58443,"_3051":58502},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3582":2463,"_31169":2440,"_21582":58504,"_5":14829,"_28301":58447,"_3051":58505},[],"The service accepts:",{"_3582":2464,"_31169":2440,"_21582":58507,"_5":14829,"_28301":58447,"_3051":54085},[],{"_3582":2465,"_31169":2440,"_21582":58509,"_5":14829,"_28301":58447,"_3051":58510},[],"VA service path",{"_3582":2466,"_31169":2440,"_21582":58512,"_5":14829,"_28301":58447,"_3051":58513},[],"Format",{"_3582":2467,"_31169":2440,"_21582":58515,"_5":14829,"_28301":58447,"_3051":58516},[],"`POST`",{"_3582":2468,"_31169":2440,"_21582":58518,"_5":14829,"_28301":58447,"_3051":58519},[],"`/ocsp`",{"_3582":2469,"_31169":2440,"_21582":58521,"_5":14829,"_28301":58447,"_3051":58522},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3582":2470,"_31169":2440,"_21582":58524,"_5":14829,"_28301":58447,"_3051":57928},[],{"_3582":2471,"_31169":2440,"_21582":58526,"_5":14829,"_28301":58447,"_3051":58527},[],"`/ocsp/{ocsp_request}`",{"_3582":2472,"_31169":2440,"_21582":58529,"_5":14829,"_28301":58447,"_3051":58530},[],"DER request encoded using padded URL Base64.",{"_3582":2473,"_31169":2440,"_21582":58532,"_5":14829,"_28301":58447,"_3051":58533},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3582":2474,"_31169":2440,"_21582":58535,"_5":14829,"_28301":58451,"_3051":58536},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3582":2475,"_31169":2440,"_21582":58538,"_5":14829,"_28301":58451,"_3051":58539},[],"Generate the request:",{"_3582":2476,"_31169":2440,"_21582":58541,"_5":14829,"_28301":58451,"_3051":58542},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3582":2477,"_31169":2440,"_21582":58544,"_5":14829,"_28301":58451,"_3051":58545},[],"Replace the example URL with the inspected endpoint:",{"_3582":2478,"_31169":2440,"_21582":58547,"_5":14829,"_28301":58451,"_3051":58548},[],"Verify the returned DER:",{"_3582":2479,"_31169":2440,"_21582":58550,"_5":14829,"_28301":58451,"_3051":58551},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3582":2480,"_31169":2440,"_21582":58553,"_5":14829,"_28301":58455,"_3051":58554},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3582":2481,"_31169":2440,"_21582":58556,"_5":14829,"_28301":58455,"_3051":58557},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3582":2482,"_31169":2440,"_21582":58559,"_5":14829,"_28301":58459,"_3051":58560},[],"RFC 6960: OCSP.",{"_3582":2483,"_31169":2440,"_21582":58562,"_5":14829,"_28301":58459,"_3051":58563},[],"OpenSSL: openssl-ocsp.",{"_3582":2484,"_31169":2440,"_21582":58565,"_5":14829,"_28301":58459,"_3051":58566},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3582":2485,"_31169":2440,"_21582":58568,"_5":14829,"_28301":58459,"_3051":58037},[],{"_3582":2486,"_31169":2486,"_5":15200,"_3051":56320,"_31527":58570,"_21582":58571,"_28301":2486},[50837,52312,56320],[],{"_3582":2487,"_31169":2486,"_21582":58573,"_5":14829,"_28301":2486,"_3051":58574},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3582":2488,"_31169":2486,"_5":31524,"_21582":58576,"_28301":58577,"_3051":55632},[],"/docs/pr-preview/pr-61/platform/pki/overview#start-here",{"_3582":2489,"_31169":2486,"_5":31524,"_21582":58579,"_28301":58580,"_3051":58581},[],"/docs/pr-preview/pr-61/platform/pki/overview#what-you-need","What you need",{"_3582":2490,"_31169":2486,"_5":31524,"_21582":58583,"_28301":58584,"_3051":56164},[],"/docs/pr-preview/pr-61/platform/pki/overview#core-capabilities",{"_3582":2491,"_31169":2486,"_5":31524,"_21582":58586,"_28301":58587,"_3051":56168},[],"/docs/pr-preview/pr-61/platform/pki/overview#build-your-trust-hierarchy",{"_3582":2492,"_31169":2486,"_5":31524,"_21582":58589,"_28301":58590,"_3051":56172},[],"/docs/pr-preview/pr-61/platform/pki/overview#protect-cryptographic-keys",{"_3582":2493,"_31169":2486,"_5":31524,"_21582":58592,"_28301":58593,"_3051":56176},[],"/docs/pr-preview/pr-61/platform/pki/overview#issue-and-control-certificates",{"_3582":2494,"_31169":2486,"_5":31524,"_21582":58595,"_28301":58596,"_3051":56184},[],"/docs/pr-preview/pr-61/platform/pki/overview#publish-validation-status",{"_3582":2495,"_31169":2486,"_5":31524,"_21582":58598,"_28301":58599,"_3051":58600},[],"/docs/pr-preview/pr-61/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3582":2496,"_31169":2486,"_5":31524,"_21582":58602,"_28301":58603,"_3051":57126},[],"/docs/pr-preview/pr-61/platform/pki/overview#continue",{"_3582":2497,"_31169":2486,"_21582":58605,"_5":14829,"_28301":2486,"_3051":58606},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3582":2498,"_31169":2486,"_21582":58608,"_5":14829,"_28301":58577,"_3051":58609},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3582":2499,"_31169":2486,"_21582":58611,"_5":14829,"_28301":58577,"_3051":58612},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3582":2500,"_31169":2486,"_21582":58614,"_5":14829,"_28301":58580,"_3051":58615},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3582":2501,"_31169":2486,"_21582":58617,"_5":14829,"_28301":58580,"_3051":58618},[],"An available cryptographic engine to keep the authority's key.",{"_3582":2502,"_31169":2486,"_21582":58620,"_5":14829,"_28301":58580,"_3051":58621},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3582":2503,"_31169":2486,"_21582":58623,"_5":14829,"_28301":58580,"_3051":58624},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3582":2504,"_31169":2486,"_21582":58626,"_5":14829,"_28301":58580,"_3051":58627},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3582":2505,"_31169":2486,"_21582":58629,"_5":14829,"_28301":58587,"_3051":58630},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3582":2506,"_31169":2486,"_21582":58632,"_5":14829,"_28301":58590,"_3051":58633},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3582":2507,"_31169":2486,"_21582":58635,"_5":14829,"_28301":58593,"_3051":58636},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3582":2508,"_31169":2486,"_21582":58638,"_5":14829,"_28301":58596,"_3051":58639},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3582":2509,"_31169":2486,"_21582":58641,"_5":14829,"_28301":58599,"_3051":58642},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3582":2510,"_31169":2486,"_21582":58644,"_5":14829,"_28301":58599,"_3051":58645},[],"its subject and extensions identify the expected client;",{"_3582":2511,"_31169":2486,"_21582":58647,"_5":14829,"_28301":58599,"_3051":58648},[],"its public key matches the client's private key;",{"_3582":2512,"_31169":2486,"_21582":58650,"_5":14829,"_28301":58599,"_3051":58651},[],"its chain reaches a root trusted by the consumer;",{"_3582":2513,"_31169":2486,"_21582":58653,"_5":14829,"_28301":58599,"_3051":58654},[],"its dates and usages allow the operation;",{"_3582":2514,"_31169":2486,"_21582":58656,"_5":14829,"_28301":58599,"_3051":58657},[],"the consumer applies revocation checks and authorization.",{"_3582":2515,"_31169":2486,"_21582":58659,"_5":14829,"_28301":58599,"_3051":58660},[],"The issuance path includes the first independent checks.",{"_3582":2516,"_31169":2486,"_21582":58662,"_5":14829,"_28301":58603,"_3051":58663},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3582":2517,"_31169":2486,"_21582":58665,"_5":14829,"_28301":58603,"_3051":58666},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3582":2518,"_31169":2486,"_21582":58668,"_5":14829,"_28301":58603,"_3051":58669},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3582":2519,"_31169":2519,"_5":15200,"_3051":58671,"_31527":58672,"_21582":58673,"_28301":2519},"Create your first CA",[50837,52312,56320,55757],[],{"_3582":2520,"_31169":2519,"_21582":58675,"_5":14829,"_28301":2519,"_3051":58676},[],"Create an evaluation root and check its certificate before issuing.",{"_3582":2521,"_31169":2519,"_5":31524,"_21582":58678,"_28301":58679,"_3051":50847},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3582":2522,"_31169":2519,"_5":31524,"_21582":58681,"_28301":58682,"_3051":58683},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#create-the-authority","Create the authority",{"_3582":2523,"_31169":2519,"_5":31524,"_21582":58685,"_28301":58686,"_3051":58687},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3582":2524,"_31169":2519,"_5":31524,"_21582":58689,"_28301":58690,"_3051":56014},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3582":2525,"_31169":2519,"_5":31524,"_21582":58692,"_28301":58693,"_3051":50871},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3582":2526,"_31169":2519,"_21582":58695,"_5":14829,"_28301":2519,"_3051":58696},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3582":2527,"_31169":2519,"_21582":58698,"_5":14829,"_28301":58679,"_3051":58699},[],"Console access and permission to create keys and authorities.",{"_3582":2528,"_31169":2519,"_21582":58701,"_5":14829,"_28301":58679,"_3051":58702},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3582":2529,"_31169":2519,"_21582":58704,"_5":14829,"_28301":58679,"_3051":58705},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3582":2530,"_31169":2519,"_21582":58707,"_5":14829,"_28301":58679,"_3051":58708},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3582":2531,"_31169":2519,"_21582":58710,"_5":14829,"_28301":58682,"_3051":58711},[],"Follow the interactive walkthrough to create a root CA with a new ECDSA P-384 key, an example subject and a client-certificate issuance profile. The availability and lifetime of profiles depend on your environment; choose values appropriate for your CA.",{"_3582":2532,"_31169":2519,"_21582":58713,"_5":14829,"_28301":58682,"_3051":58714},[],"The example sets **CA Name** to `Acme Showcase Root CA`, which becomes the subject Common Name (CN). It also sets the optional subject fields &#x2A;*Country (C)** to `ES` and &#x2A;*Organization (O)** to `Acme`; use values appropriate for your authority.",{"_3582":2533,"_31169":2519,"_21582":58716,"_5":14829,"_28301":58682,"_3051":58717},[],"Open the new CA and select **Certificate PEM**. Download or copy its public certificate to `ca.pem`, including the complete `BEGIN CERTIFICATE` and `END CERTIFICATE` block. The private key remains in the configured engine. To reuse an existing key instead, see the authorities guide.",{"_3582":2534,"_31169":2519,"_21582":58719,"_5":14829,"_28301":58686,"_3051":58720},[],"Run from the directory where you saved `ca.pem`:",{"_3582":2535,"_31169":2519,"_21582":58722,"_5":14829,"_28301":58686,"_3051":58723},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3582":2536,"_31169":2519,"_21582":58725,"_5":14829,"_28301":58686,"_3051":58726},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3582":2537,"_31169":2519,"_21582":58728,"_5":14829,"_28301":58690,"_3051":58729},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3582":2538,"_31169":2519,"_21582":58731,"_5":14829,"_28301":58690,"_3051":58732},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3582":2539,"_31169":2519,"_21582":58734,"_5":14829,"_28301":58690,"_3051":58735},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3582":2540,"_31169":2519,"_21582":58737,"_5":14829,"_28301":58690,"_3051":58738},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3582":2541,"_31169":2519,"_21582":58740,"_5":14829,"_28301":58693,"_3051":58741},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3582":2542,"_31169":2542,"_5":15200,"_3051":58743,"_31527":58744,"_21582":58745,"_28301":2542},"Issue and verify a certificate",[50837,52312,56320,55757],[],{"_3582":2543,"_31169":2542,"_21582":58747,"_5":14829,"_28301":2542,"_3051":58748},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3582":2544,"_31169":2542,"_5":31524,"_21582":58750,"_28301":58751,"_3051":50847},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3582":2545,"_31169":2542,"_5":31524,"_21582":58753,"_28301":58754,"_3051":58755},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3582":2546,"_31169":2542,"_5":31524,"_21582":58757,"_28301":58758,"_3051":58759},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3582":2547,"_31169":2542,"_5":31524,"_21582":58761,"_28301":58762,"_3051":58763},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3582":2548,"_31169":2542,"_5":31524,"_21582":58765,"_28301":58766,"_3051":58767},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3582":2549,"_31169":2542,"_5":31524,"_21582":58769,"_28301":58770,"_3051":58771},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3582":2550,"_31169":2542,"_5":31524,"_21582":58773,"_28301":58774,"_3051":58775},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3582":2551,"_31169":2542,"_5":31524,"_21582":58777,"_28301":58778,"_3051":58779},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3582":2552,"_31169":2542,"_5":31524,"_21582":58781,"_28301":58782,"_3051":58783},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3582":2553,"_31169":2542,"_5":31524,"_21582":58785,"_28301":58786,"_3051":58787},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3582":2554,"_31169":2542,"_5":31524,"_21582":58789,"_28301":58790,"_3051":56014},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3582":2555,"_31169":2542,"_5":31524,"_21582":58792,"_28301":58793,"_3051":50871},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#next-step",{"_3582":2556,"_31169":2542,"_21582":58795,"_5":14829,"_28301":2542,"_3051":58796},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3582":2557,"_31169":2542,"_21582":58798,"_5":14829,"_28301":58751,"_3051":58799},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3582":2558,"_31169":2542,"_21582":58801,"_5":14829,"_28301":58751,"_3051":58802},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3582":2559,"_31169":2542,"_21582":58804,"_5":14829,"_28301":58751,"_3051":58805},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3582":2560,"_31169":2542,"_21582":58807,"_5":14829,"_28301":58751,"_3051":58808},[],"A client identifier: here we use `device-001`.",{"_3582":2561,"_31169":2542,"_21582":58810,"_5":14829,"_28301":58751,"_3051":58811},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3582":2562,"_31169":2542,"_21582":58813,"_5":14829,"_28301":58754,"_3051":58814},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3582":2563,"_31169":2542,"_21582":58816,"_5":14829,"_28301":58758,"_3051":58817},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3582":2564,"_31169":2542,"_21582":58819,"_5":14829,"_28301":58758,"_3051":58820},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3582":2565,"_31169":2542,"_21582":58822,"_5":14829,"_28301":58762,"_3051":58823},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3582":2566,"_31169":2542,"_21582":58825,"_5":14829,"_28301":58762,"_3051":58826},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3582":2567,"_31169":2542,"_21582":58828,"_5":14829,"_28301":58766,"_3051":58829},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3582":2568,"_31169":2542,"_21582":58831,"_5":14829,"_28301":58766,"_3051":58832},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3582":2569,"_31169":2542,"_21582":58834,"_5":14829,"_28301":58770,"_3051":58835},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3582":2570,"_31169":2542,"_21582":58837,"_5":14829,"_28301":58774,"_3051":58838},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3582":2571,"_31169":2542,"_21582":58840,"_5":14829,"_28301":58778,"_3051":58841},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3582":2572,"_31169":2542,"_21582":58843,"_5":14829,"_28301":58782,"_3051":58844},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3582":2573,"_31169":2542,"_21582":58846,"_5":14829,"_28301":58782,"_3051":58847},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3582":2574,"_31169":2542,"_21582":58849,"_5":14829,"_28301":58782,"_3051":58850},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3582":2575,"_31169":2542,"_21582":58852,"_5":14829,"_28301":58786,"_3051":58853},[],"In Bash, compare the two public-key digests:",{"_3582":2576,"_31169":2542,"_21582":58855,"_5":14829,"_28301":58786,"_3051":58856},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3582":2577,"_31169":2542,"_21582":58858,"_5":14829,"_28301":58786,"_3051":58859},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3582":2578,"_31169":2542,"_21582":58861,"_5":14829,"_28301":58790,"_3051":56098},[],{"_3582":2579,"_31169":2542,"_21582":58863,"_5":14829,"_28301":58790,"_3051":58864},[],"What to review",{"_3582":2580,"_31169":2542,"_21582":58866,"_5":14829,"_28301":58790,"_3051":58867},[],"The CA rejects issuance",{"_3582":2581,"_31169":2542,"_21582":58869,"_5":14829,"_28301":58790,"_3051":58870},[],"Permissions, CA state and key, algorithm and profile.",{"_3582":2582,"_31169":2542,"_21582":58872,"_5":14829,"_28301":58790,"_3051":58873},[],"Different subject or usages",{"_3582":2583,"_31169":2542,"_21582":58875,"_5":14829,"_28301":58790,"_3051":58876},[],"Applied profile and requested values.",{"_3582":2584,"_31169":2542,"_21582":58878,"_5":14829,"_28301":58790,"_3051":58879},[],"Issuer cannot be found",{"_3582":2585,"_31169":2542,"_21582":58881,"_5":14829,"_28301":58790,"_3051":58882},[],"Downloaded CA and required intermediate chain.",{"_3582":2586,"_31169":2542,"_21582":58884,"_5":14829,"_28301":58790,"_3051":58885},[],"Validity fails",{"_3582":2587,"_31169":2542,"_21582":58887,"_5":14829,"_28301":58790,"_3051":58888},[],"Certificate and CA dates, and the computer's clock.",{"_3582":2588,"_31169":2542,"_21582":58890,"_5":14829,"_28301":58790,"_3051":58891},[],"Public-key digests differ",{"_3582":2589,"_31169":2542,"_21582":58893,"_5":14829,"_28301":58790,"_3051":58894},[],"Certificate and key files from the same issuance.",{"_3582":2590,"_31169":2542,"_21582":58896,"_5":14829,"_28301":58790,"_3051":58897},[],"See PKI diagnostics to narrow an issuance failure.",{"_3582":2591,"_31169":2542,"_21582":58899,"_5":14829,"_28301":58793,"_3051":58900},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3582":2592,"_31169":2542,"_21582":58902,"_5":14829,"_28301":58793,"_3051":58903},[],"Manage certificates for inspection, status and revocation.",{"_3582":2593,"_31169":2542,"_21582":58905,"_5":14829,"_28301":58793,"_3051":58906},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3582":2594,"_31169":2542,"_21582":58908,"_5":14829,"_28301":58793,"_3051":58909},[],"Prepare EST for the device to request its next identities.",{"_3582":2595,"_31169":2542,"_21582":58911,"_5":14829,"_28301":58793,"_3051":58912},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3582":2596,"_31169":2596,"_5":15200,"_3051":58914,"_31527":58915,"_21582":58916,"_28301":2596},"PKI getting started",[50837,52312,56320,55757],[],{"_3582":2597,"_31169":2596,"_21582":58918,"_5":14829,"_28301":2596,"_3051":58919},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3582":2598,"_31169":2596,"_5":31524,"_21582":58921,"_28301":58922,"_3051":50847},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#before-you-begin",{"_3582":2599,"_31169":2596,"_5":31524,"_21582":58924,"_28301":58925,"_3051":58926},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3582":2600,"_31169":2596,"_5":31524,"_21582":58928,"_28301":58929,"_3051":55949},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#expected-result",{"_3582":2601,"_31169":2596,"_5":31524,"_21582":58931,"_28301":58932,"_3051":58933},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3582":2602,"_31169":2596,"_21582":58935,"_5":14829,"_28301":2596,"_3051":58936},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3582":2603,"_31169":2596,"_21582":58938,"_5":14829,"_28301":58922,"_3051":58939},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3582":2604,"_31169":2596,"_21582":58941,"_5":14829,"_28301":58922,"_3051":58942},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3582":2605,"_31169":2596,"_21582":58944,"_5":14829,"_28301":58922,"_3051":58945},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3582":2606,"_31169":2596,"_21582":58947,"_5":14829,"_28301":58922,"_3051":58948},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3582":2607,"_31169":2596,"_21582":58950,"_5":14829,"_28301":58922,"_3051":58951},[],"A working directory with restricted access for the downloaded key.",{"_3582":2608,"_31169":2596,"_21582":58953,"_5":14829,"_28301":58925,"_3051":58954},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3582":2609,"_31169":2596,"_21582":58956,"_5":14829,"_28301":58925,"_3051":58957},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3582":2610,"_31169":2596,"_21582":58959,"_5":14829,"_28301":58925,"_3051":58960},[],"<Card title=\"3. Revoke a certificate and check the CRL\" description=\"Revoke device-042 among 100 issued certificates and confirm it appears in the CA's CRL.\" href=\"/docs/platform/pki/quickstarts/revoke-certificate\" />",{"_3582":2611,"_31169":2596,"_21582":58962,"_5":14829,"_28301":58925,"_3051":58963},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3582":2612,"_31169":2596,"_21582":58965,"_5":14829,"_28301":58925,"_3051":58966},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3582":2613,"_31169":2596,"_21582":58968,"_5":14829,"_28301":58929,"_3051":58969},[],"File or resource",{"_3582":2614,"_31169":2596,"_21582":58971,"_5":14829,"_28301":58929,"_3051":55946},[],{"_3582":2615,"_31169":2596,"_21582":58973,"_5":14829,"_28301":58929,"_3051":58974},[],"Active root CA and `ca.pem`",{"_3582":2616,"_31169":2596,"_21582":58976,"_5":14829,"_28301":58929,"_3051":58977},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3582":2617,"_31169":2596,"_21582":58979,"_5":14829,"_28301":58929,"_3051":58980},[],"End-entity certificate and `device.crt`",{"_3582":2618,"_31169":2596,"_21582":58982,"_5":14829,"_28301":58929,"_3051":58983},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3582":2619,"_31169":2596,"_21582":58985,"_5":14829,"_28301":58929,"_3051":58986},[],"Private key `device.key`",{"_3582":2620,"_31169":2596,"_21582":58988,"_5":14829,"_28301":58929,"_3051":58989},[],"Its public key matches the one included in `device.crt`.",{"_3582":2621,"_31169":2596,"_21582":58991,"_5":14829,"_28301":58929,"_3051":58992},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3582":2622,"_31169":2596,"_21582":58994,"_5":14829,"_28301":58932,"_3051":58995},[],"To operate certificates, continue with Certificates and Validation.",{"_3582":2623,"_31169":2596,"_21582":58997,"_5":14829,"_28301":58932,"_3051":58998},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3582":2624,"_31169":2596,"_21582":59000,"_5":14829,"_28301":58932,"_3051":59001},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3582":2625,"_31169":2625,"_5":15200,"_3051":59003,"_31527":59004,"_21582":59005,"_28301":2625},"Revoke a certificate and check the CRL",[50837,52312,56320,55757],[],{"_3582":2626,"_31169":2625,"_21582":59007,"_5":14829,"_28301":2625,"_3051":59008},[],"Revoke a certificate among many issued by a CA and confirm that its CRL lists it.",{"_3582":2627,"_31169":2625,"_5":31524,"_21582":59010,"_28301":59011,"_3051":50847},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#before-you-begin",{"_3582":2628,"_31169":2625,"_5":31524,"_21582":59013,"_28301":59014,"_3051":59015},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#revoke-the-certificate","Revoke the certificate",{"_3582":2629,"_31169":2625,"_5":31524,"_21582":59017,"_28301":59018,"_3051":59019},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#find-the-certificate","Find the certificate",{"_3582":2630,"_31169":2625,"_5":31524,"_21582":59021,"_28301":59022,"_3051":59023},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#revoke-it","Revoke it",{"_3582":2631,"_31169":2625,"_5":31524,"_21582":59025,"_28301":59026,"_3051":59027},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#confirm-and-read-the-status","Confirm and read the status",{"_3582":2632,"_31169":2625,"_5":31524,"_21582":59029,"_28301":59030,"_3051":57098},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#download-the-certificate",{"_3582":2633,"_31169":2625,"_5":31524,"_21582":59032,"_28301":59033,"_3051":59034},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#check-the-crl","Check the CRL",{"_3582":2634,"_31169":2625,"_5":31524,"_21582":59036,"_28301":59037,"_3051":59038},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#verify-with-the-list","Verify with the list",{"_3582":2635,"_31169":2625,"_5":31524,"_21582":59040,"_28301":59041,"_3051":56014},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#if-the-result-fails",{"_3582":2636,"_31169":2625,"_21582":59043,"_5":14829,"_28301":2625,"_3051":59044},[],"You will revoke the certificate of `device-042`, one of the 100 certificates issued by the CA, and then check that the CA's revocation list (CRL) includes it while the other certificates remain valid. The result is a revoked certificate in Lamassu and a downloaded CRL that names its serial number and reason.",{"_3582":2637,"_31169":2625,"_21582":59046,"_5":14829,"_28301":59011,"_3051":59047},[],"A CA with issued certificates and permission to change their status. The example uses `Acme Showcase Root CA` from Create your first CA, with the 100 client certificates `device-001` to `device-100`. A smaller set works the same way.",{"_3582":2638,"_31169":2625,"_21582":59049,"_5":14829,"_28301":59011,"_3051":59050},[],"The CA's public certificate in `ca.pem`, as saved in the first path.",{"_3582":2639,"_31169":2625,"_21582":59052,"_5":14829,"_28301":59011,"_3051":59053},[],"OpenSSL 3.x and `curl` on a computer that can reach the CRL endpoint.",{"_3582":2640,"_31169":2625,"_21582":59055,"_5":14829,"_28301":59011,"_3051":59056},[],"Only `CertificateHold` can be undone later. Any other reason is final, so use an evaluation certificate for this path. Before revoking in production, identify the consumers of the identity and prepare a replacement.",{"_3582":2641,"_31169":2625,"_21582":59058,"_5":14829,"_28301":59014,"_3051":59059},[],"Follow the interactive walkthrough. It opens the issuing CA, filters its **Issued Certificates** by Common Name to find `device-042` among the 100, and revokes it with the reason `KeyCompromise`.",{"_3582":2642,"_31169":2625,"_21582":59061,"_5":14829,"_28301":59014,"_3051":59062},[],"In the console, the steps are:",{"_3582":2643,"_31169":2625,"_21582":59064,"_5":14829,"_28301":59018,"_3051":59065},[],"Open **Certification Authorities**, select the issuing CA and go to **Issued Certificates**. Search by `Common Name` for `device-042`. The CA's own certificate is also listed in this tab; do not confuse the two.",{"_3582":2644,"_31169":2625,"_21582":59067,"_5":14829,"_28301":59022,"_3051":59068},[],"Open the **More actions** menu of the matching row and select **Revoke Certificate**. In the confirmation dialog, choose the **Revocation Reason** that describes the incident. This example uses `KeyCompromise`, because the device key is considered exposed. Use `CertificateHold` only for a reversible suspension.",{"_3582":2645,"_31169":2625,"_21582":59070,"_5":14829,"_28301":59026,"_3051":59071},[],"Select **Confirm Revocation**. The row changes to `REVOKED` and shows the reason and the revocation time. If you need to verify the result later, read the record again rather than trusting the dialog.",{"_3582":2646,"_31169":2625,"_21582":59073,"_5":14829,"_28301":59026,"_3051":59074},[],"Revocation does not delete the certificate or its key, and it does not close sessions that are already established. See Certificates for the reasons and their consequences.",{"_3582":2647,"_31169":2625,"_21582":59076,"_5":14829,"_28301":59030,"_3051":59077},[],"From the same **More actions** menu, select **Download PEM** and save the file as `device-042.crt`. Note its serial number and the CRL distribution point (CDP) it carries:",{"_3582":2648,"_31169":2625,"_21582":59079,"_5":14829,"_28301":59030,"_3051":59080},[],"The URL ends with the ID of the **issuing CA**, not the ID or serial of the certificate. Your serial number differs from the one shown.",{"_3582":2649,"_31169":2625,"_21582":59082,"_5":14829,"_28301":59033,"_3051":59083},[],"Lamassu regenerates the CA's CRL when a certificate is revoked, provided `regenerate_on_revoke` is enabled; it is by default. The endpoint is public and does not require authentication. Replace the URL with the CDP of your certificate and download the list:",{"_3582":2650,"_31169":2625,"_21582":59085,"_5":14829,"_28301":59033,"_3051":59086},[],"Check that the list is signed by your CA, is current and contains the serial number:",{"_3582":2651,"_31169":2625,"_21582":59088,"_5":14829,"_28301":59033,"_3051":59089},[],"Expect `verify OK`, the expected issuer, a `lastUpdate` not earlier than the revocation and an entry for the serial of `device-042` with reason `Key Compromise`; the list also names any other certificate previously revoked by this CA. A CRL with the same number as before the revocation means it has not been regenerated yet.",{"_3582":2652,"_31169":2625,"_21582":59091,"_5":14829,"_28301":59037,"_3051":59092},[],"`openssl verify` can apply the downloaded list to a certificate. The revoked certificate must be rejected and any other certificate from the same CA must still pass. For `device-001`, download its PEM in the same way and save it as `device-001.crt`:",{"_3582":2653,"_31169":2625,"_21582":59094,"_5":14829,"_28301":59037,"_3051":59095},[],"This check uses your local copy of the list: it does not download newer lists or prove that every client has refreshed its copy. For online status, see OCSP.",{"_3582":2654,"_31169":2625,"_21582":59097,"_5":14829,"_28301":59041,"_3051":56098},[],{"_3582":2655,"_31169":2625,"_21582":59099,"_5":14829,"_28301":59041,"_3051":58864},[],{"_3582":2656,"_31169":2625,"_21582":59101,"_5":14829,"_28301":59041,"_3051":59102},[],"**Revoke Certificate** is not available",{"_3582":2657,"_31169":2625,"_21582":59104,"_5":14829,"_28301":59041,"_3051":59105},[],"The certificate is already `REVOKED` for a final reason or is `EXPIRED`.",{"_3582":2658,"_31169":2625,"_21582":59107,"_5":14829,"_28301":59041,"_3051":59108},[],"The CRL download returns 404",{"_3582":2659,"_31169":2625,"_21582":59110,"_5":14829,"_28301":59041,"_3051":59111},[],"The ID in the URL is not the issuing CA's: use the CDP of the certificate.",{"_3582":2660,"_31169":2625,"_21582":59113,"_5":14829,"_28301":59041,"_3051":59114},[],"`verify OK` fails",{"_3582":2661,"_31169":2625,"_21582":59116,"_5":14829,"_28301":59041,"_3051":59117},[],"`ca.pem` is not the certificate of the CA that signed the list.",{"_3582":2662,"_31169":2625,"_21582":59119,"_5":14829,"_28301":59041,"_3051":59120},[],"The serial is not in the list",{"_3582":2663,"_31169":2625,"_21582":59122,"_5":14829,"_28301":59041,"_3051":59123},[],"The list was downloaded before the revocation, or its regeneration failed. See CRL settings errors.",{"_3582":2664,"_31169":2625,"_21582":59125,"_5":14829,"_28301":59041,"_3051":59126},[],"`device-001` is also rejected",{"_3582":2665,"_31169":2625,"_21582":59128,"_5":14829,"_28301":59041,"_3051":59129},[],"The certificate was revoked, or `ca.pem` does not match its issuer.",{"_3582":2666,"_31169":2625,"_21582":59131,"_5":14829,"_28301":59041,"_3051":59132},[],"<Card title=\"Manage certificates\" description=\"Reasons, holds and reactivation.\" href=\"/docs/platform/pki/certificates\" />",{"_3582":2667,"_31169":2625,"_21582":59134,"_5":14829,"_28301":59041,"_3051":59135},[],"<Card title=\"Revocation lists (CRL)\" description=\"Settings, regeneration and publication.\" href=\"/docs/platform/pki/crl\" />",{"_3582":2668,"_31169":2625,"_21582":59137,"_5":14829,"_28301":59041,"_3051":59138},[],"<Card title=\"Validate with OCSP\" description=\"Query the signed status of a certificate.\" href=\"/docs/platform/pki/ocsp\" />",{"_3582":2669,"_31169":2669,"_5":15200,"_3051":59140,"_31527":59141,"_21582":59142,"_28301":2669},"PKI troubleshooting",[50837,52312,56320,54895],[],{"_3582":2670,"_31169":2669,"_21582":59144,"_5":14829,"_28301":2669,"_3051":59145},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3582":2671,"_31169":2669,"_5":31524,"_21582":59147,"_28301":59148,"_3051":59149},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3582":2672,"_31169":2669,"_5":31524,"_21582":59151,"_28301":59152,"_3051":59153},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3582":2673,"_31169":2669,"_5":31524,"_21582":59155,"_28301":59156,"_3051":59157},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3582":2674,"_31169":2669,"_21582":59159,"_5":14829,"_28301":2669,"_3051":59160},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3582":2675,"_31169":2669,"_21582":59162,"_5":14829,"_28301":2669,"_3051":59163},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3582":2676,"_31169":2669,"_21582":59165,"_5":14829,"_28301":59148,"_3051":55946},[],{"_3582":2677,"_31169":2669,"_21582":59167,"_5":14829,"_28301":59148,"_3051":59168},[],"What to inspect",{"_3582":2678,"_31169":2669,"_21582":59170,"_5":14829,"_28301":59148,"_3051":50871},[],{"_3582":2679,"_31169":2669,"_21582":59172,"_5":14829,"_28301":59148,"_3051":55162},[],{"_3582":2680,"_31169":2669,"_21582":59174,"_5":14829,"_28301":59148,"_3051":59175},[],"Exists, is active and has usable dates.",{"_3582":2681,"_31169":2669,"_21582":59177,"_5":14829,"_28301":59148,"_3051":59178},[],"Authorities.",{"_3582":2682,"_31169":2669,"_21582":59180,"_5":14829,"_28301":59148,"_3051":59181},[],"Key",{"_3582":2683,"_31169":2669,"_21582":59183,"_5":14829,"_28301":59148,"_3051":59184},[],"The record has a usable private key and the engine can sign.",{"_3582":2684,"_31169":2669,"_21582":59186,"_5":14829,"_28301":59148,"_3051":59187},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3582":2685,"_31169":2669,"_21582":59189,"_5":14829,"_28301":59148,"_3051":59190},[],"CSR",{"_3582":2686,"_31169":2669,"_21582":59192,"_5":14829,"_28301":59148,"_3051":59193},[],"Correct PEM and verifiable signature.",{"_3582":2687,"_31169":2669,"_21582":59195,"_5":14829,"_28301":59148,"_3051":59196},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3582":2688,"_31169":2669,"_21582":59198,"_5":14829,"_28301":59148,"_3051":59199},[],"Profile",{"_3582":2689,"_31169":2669,"_21582":59201,"_5":14829,"_28301":59148,"_3051":59202},[],"Selected source, existing ID, allowed algorithm and size.",{"_3582":2690,"_31169":2669,"_21582":59204,"_5":14829,"_28301":59148,"_3051":59205},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3582":2691,"_31169":2669,"_21582":59207,"_5":14829,"_28301":59148,"_3051":56098},[],{"_3582":2692,"_31169":2669,"_21582":59209,"_5":14829,"_28301":59148,"_3051":59210},[],"Appropriate subject, SAN, usages and dates.",{"_3582":2693,"_31169":2669,"_21582":59212,"_5":14829,"_28301":59148,"_3051":59213},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3582":2694,"_31169":2669,"_21582":59215,"_5":14829,"_28301":59148,"_3051":59216},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3582":2695,"_31169":2669,"_21582":59218,"_5":14829,"_28301":59148,"_3051":59219},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3582":2696,"_31169":2669,"_21582":59221,"_5":14829,"_28301":59152,"_3051":59222},[],"Check each boundary independently:",{"_3582":2697,"_31169":2669,"_21582":59224,"_5":14829,"_28301":59152,"_3051":59225},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3582":2698,"_31169":2669,"_21582":59227,"_5":14829,"_28301":59152,"_3051":59228},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3582":2699,"_31169":2669,"_21582":59230,"_5":14829,"_28301":59152,"_3051":59231},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3582":2700,"_31169":2669,"_21582":59233,"_5":14829,"_28301":59152,"_3051":59234},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3582":2701,"_31169":2669,"_21582":59236,"_5":14829,"_28301":59152,"_3051":59237},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3582":2702,"_31169":2669,"_21582":59239,"_5":14829,"_28301":59152,"_3051":59240},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3582":2703,"_31169":2669,"_21582":59242,"_5":14829,"_28301":59156,"_3051":59243},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3582":2704,"_31169":2669,"_21582":59245,"_5":14829,"_28301":59156,"_3051":59246},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3582":2705,"_31169":2705,"_5":15200,"_3051":59248,"_31527":59249,"_21582":59250,"_28301":2705},"Security",[50837],[],{"_3582":2706,"_31169":2705,"_21582":59252,"_5":14829,"_28301":2705,"_3051":59253},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3582":2707,"_31169":2705,"_5":31524,"_21582":59255,"_28301":59256,"_3051":59257},[],"/docs/pr-preview/pr-61/security#report-a-vulnerability","Report a vulnerability",{"_3582":2708,"_31169":2705,"_5":31524,"_21582":59259,"_28301":59260,"_3051":59261},[],"/docs/pr-preview/pr-61/security#what-to-include-in-a-report","What to include in a report",{"_3582":2709,"_31169":2705,"_5":31524,"_21582":59263,"_28301":59264,"_3051":59265},[],"/docs/pr-preview/pr-61/security#supported-versions","Supported versions",{"_3582":2710,"_31169":2705,"_5":31524,"_21582":59267,"_28301":59268,"_3051":59269},[],"/docs/pr-preview/pr-61/security#responsible-disclosure","Responsible disclosure",{"_3582":2711,"_31169":2705,"_21582":59271,"_5":14829,"_28301":2705,"_3051":59272},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3582":2712,"_31169":2705,"_21582":59274,"_5":14829,"_28301":59256,"_3051":59275},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3582":2713,"_31169":2705,"_21582":59277,"_5":14829,"_28301":59256,"_3051":59278},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3582":2714,"_31169":2705,"_21582":59280,"_5":14829,"_28301":59256,"_3051":15497},[],{"_3582":2715,"_31169":2705,"_21582":59282,"_5":14829,"_28301":59256,"_3051":15437},[],{"_3582":2716,"_31169":2705,"_21582":59284,"_5":14829,"_28301":59256,"_3051":15484},[],{"_3582":2717,"_31169":2705,"_21582":59286,"_5":14829,"_28301":59256,"_3051":59287},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3582":2718,"_31169":2705,"_21582":59289,"_5":14829,"_28301":59256,"_3051":59290},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3582":2719,"_31169":2705,"_21582":59292,"_5":14829,"_28301":59260,"_3051":59293},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3582":2720,"_31169":2705,"_21582":59295,"_5":14829,"_28301":59260,"_3051":59296},[],"Do not include in the report:",{"_3582":2721,"_31169":2705,"_21582":59298,"_5":14829,"_28301":59260,"_3051":59299},[],"Credentials, tokens, or private keys",{"_3582":2722,"_31169":2705,"_21582":59301,"_5":14829,"_28301":59260,"_3051":59302},[],"Customer data or customer-identifiable information",{"_3582":2723,"_31169":2705,"_21582":59304,"_5":14829,"_28301":59260,"_3051":59305},[],"Confidential architecture or internal infrastructure details",{"_3582":2724,"_31169":2705,"_21582":59307,"_5":14829,"_28301":59264,"_3051":59308},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3582":2725,"_31169":2705,"_21582":59310,"_5":14829,"_28301":59264,"_3051":59311},[],"For upgrade guidance, see Upgrades.",{"_3582":2726,"_31169":2705,"_21582":59313,"_5":14829,"_28301":59268,"_3051":59314},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3582":2727,"_31169":2705,"_21582":59316,"_5":14829,"_28301":59268,"_3051":59317},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3582":2728,"_31169":2705,"_21582":59319,"_5":14829,"_28301":59268,"_3051":59320},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3582":2729,"_31169":2705,"_21582":59322,"_5":14829,"_28301":59268,"_3051":59323},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3582":2730,"_31169":2705,"_21582":59325,"_5":14829,"_28301":59268,"_3051":59326},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3582":2731,"_31169":2731,"_5":15200,"_3051":59328,"_31527":59329,"_21582":59331,"_28301":2731},"3.8.0 to 4.0.0",[50837,59330],"Upgrades",[],{"_3582":2732,"_31169":2731,"_21582":59333,"_5":14829,"_28301":2731,"_3051":59334},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3582":2733,"_31169":2731,"_5":31524,"_21582":59336,"_28301":59337,"_3051":59338},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3582":2734,"_31169":2731,"_5":31524,"_21582":59340,"_28301":59341,"_3051":59342},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3582":2735,"_31169":2731,"_5":31524,"_21582":59344,"_28301":59345,"_3051":59346},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3582":2736,"_31169":2731,"_5":31524,"_21582":59348,"_28301":59349,"_3051":59350},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3582":2737,"_31169":2731,"_5":31524,"_21582":59352,"_28301":59353,"_3051":59354},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3582":2738,"_31169":2731,"_5":31524,"_21582":59356,"_28301":59357,"_3051":59358},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3582":2739,"_31169":2731,"_5":31524,"_21582":59360,"_28301":59361,"_3051":59362},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3582":2740,"_31169":2731,"_5":31524,"_21582":59364,"_28301":59365,"_3051":59366},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3582":2741,"_31169":2731,"_5":31524,"_21582":59368,"_28301":59369,"_3051":59370},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3582":2742,"_31169":2731,"_5":31524,"_21582":59372,"_28301":59373,"_3051":59374},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3582":2743,"_31169":2731,"_5":31524,"_21582":59376,"_28301":59377,"_3051":59378},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3582":2744,"_31169":2731,"_5":31524,"_21582":59380,"_28301":59381,"_3051":59382},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3582":2745,"_31169":2731,"_5":31524,"_21582":59384,"_28301":59385,"_3051":59386},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3582":2746,"_31169":2731,"_5":31524,"_21582":59388,"_28301":59389,"_3051":59390},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3582":2747,"_31169":2731,"_5":31524,"_21582":59392,"_28301":59393,"_3051":59394},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3582":2748,"_31169":2731,"_5":31524,"_21582":59396,"_28301":59397,"_3051":59398},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3582":2749,"_31169":2731,"_5":31524,"_21582":59400,"_28301":59401,"_3051":59402},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3582":2750,"_31169":2731,"_5":31524,"_21582":59404,"_28301":59405,"_3051":59406},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3582":2751,"_31169":2731,"_5":31524,"_21582":59408,"_28301":59409,"_3051":59410},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3582":2752,"_31169":2731,"_5":31524,"_21582":59412,"_28301":59413,"_3051":59414},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3582":2753,"_31169":2731,"_5":31524,"_21582":59416,"_28301":59417,"_3051":59418},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3582":2754,"_31169":2731,"_5":31524,"_21582":59420,"_28301":59421,"_3051":59422},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3582":2755,"_31169":2731,"_5":31524,"_21582":59424,"_28301":59425,"_3051":59426},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3582":2756,"_31169":2731,"_5":31524,"_21582":59428,"_28301":59429,"_3051":59430},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3582":2757,"_31169":2731,"_5":31524,"_21582":59432,"_28301":59433,"_3051":59434},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3582":2758,"_31169":2731,"_5":31524,"_21582":59436,"_28301":59437,"_3051":59438},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3582":2759,"_31169":2731,"_5":31524,"_21582":59440,"_28301":59441,"_3051":59442},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3582":2760,"_31169":2731,"_5":31524,"_21582":59444,"_28301":59445,"_3051":59446},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3582":2761,"_31169":2731,"_5":31524,"_21582":59448,"_28301":59449,"_3051":59450},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3582":2762,"_31169":2731,"_5":31524,"_21582":59452,"_28301":59453,"_3051":59454},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3582":2763,"_31169":2731,"_5":31524,"_21582":59456,"_28301":59457,"_3051":59458},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3582":2764,"_31169":2731,"_5":31524,"_21582":59460,"_28301":59461,"_3051":59462},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3582":2765,"_31169":2731,"_5":31524,"_21582":59464,"_28301":59465,"_3051":59466},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3582":2766,"_31169":2731,"_5":31524,"_21582":59468,"_28301":59469,"_3051":59470},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3582":2767,"_31169":2731,"_5":31524,"_21582":59472,"_28301":59473,"_3051":59474},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3582":2768,"_31169":2731,"_5":31524,"_21582":59476,"_28301":59477,"_3051":59478},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3582":2769,"_31169":2731,"_5":31524,"_21582":59480,"_28301":59481,"_3051":59482},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3582":2770,"_31169":2731,"_5":31524,"_21582":59484,"_28301":59485,"_3051":59486},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3582":2771,"_31169":2731,"_5":31524,"_21582":59488,"_28301":59489,"_3051":59490},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3582":2772,"_31169":2731,"_5":31524,"_21582":59492,"_28301":59493,"_3051":59494},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3582":2773,"_31169":2731,"_5":31524,"_21582":59496,"_28301":59497,"_3051":54895},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3582":2774,"_31169":2731,"_5":31524,"_21582":59499,"_28301":59500,"_3051":59501},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3582":2775,"_31169":2731,"_5":31524,"_21582":59503,"_28301":59504,"_3051":59505},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3582":2776,"_31169":2731,"_21582":59507,"_5":14829,"_28301":2731,"_3051":59508},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3582":2777,"_31169":2731,"_21582":59510,"_5":14829,"_28301":2731,"_3051":59511},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3582":2778,"_31169":2731,"_21582":59513,"_5":14829,"_28301":2731,"_3051":59514},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3582":2779,"_31169":2731,"_21582":59516,"_5":14829,"_28301":2731,"_3051":59517},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3582":2780,"_31169":2731,"_21582":59519,"_5":14829,"_28301":2731,"_3051":59520},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3582":2781,"_31169":2731,"_21582":59522,"_5":14829,"_28301":2731,"_3051":59523},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3582":2782,"_31169":2731,"_21582":59525,"_5":14829,"_28301":2731,"_3051":59526},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3582":2783,"_31169":2731,"_21582":59528,"_5":14829,"_28301":59341,"_3051":59529},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3582":2784,"_31169":2731,"_21582":59531,"_5":14829,"_28301":59341,"_3051":59532},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3582":2785,"_31169":2731,"_21582":59534,"_5":14829,"_28301":59345,"_3051":59535},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3582":2786,"_31169":2731,"_21582":59537,"_5":14829,"_28301":59345,"_3051":59538},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3582":2787,"_31169":2731,"_21582":59540,"_5":14829,"_28301":59349,"_3051":59541},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3582":2788,"_31169":2731,"_21582":59543,"_5":14829,"_28301":59353,"_3051":59544},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3582":2789,"_31169":2731,"_21582":59546,"_5":14829,"_28301":59353,"_3051":59547},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3582":2790,"_31169":2731,"_21582":59549,"_5":14829,"_28301":59353,"_3051":59550},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3582":2791,"_31169":2731,"_21582":59552,"_5":14829,"_28301":59353,"_3051":59553},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3582":2792,"_31169":2731,"_21582":59555,"_5":14829,"_28301":59353,"_3051":59556},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3582":2793,"_31169":2731,"_21582":59558,"_5":14829,"_28301":59357,"_3051":59559},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3582":2794,"_31169":2731,"_21582":59561,"_5":14829,"_28301":59357,"_3051":59562},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3582":2795,"_31169":2731,"_21582":59564,"_5":14829,"_28301":59357,"_3051":59565},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3582":2796,"_31169":2731,"_21582":59567,"_5":14829,"_28301":59357,"_3051":59568},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3582":2797,"_31169":2731,"_21582":59570,"_5":14829,"_28301":59357,"_3051":59571},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3582":2798,"_31169":2731,"_21582":59573,"_5":14829,"_28301":59357,"_3051":59574},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3582":2799,"_31169":2731,"_21582":59576,"_5":14829,"_28301":59361,"_3051":59577},[],"Change",{"_3582":2800,"_31169":2731,"_21582":59579,"_5":14829,"_28301":59361,"_3051":59580},[],"Who is affected",{"_3582":2801,"_31169":2731,"_21582":59582,"_5":14829,"_28301":59361,"_3051":59583},[],"Severity",{"_3582":2802,"_31169":2731,"_21582":59585,"_5":14829,"_28301":59361,"_3051":57965},[],{"_3582":2803,"_31169":2731,"_21582":59587,"_5":14829,"_28301":59361,"_3051":59370},[],{"_3582":2804,"_31169":2731,"_21582":59589,"_5":14829,"_28301":59361,"_3051":59590},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3582":2805,"_31169":2731,"_21582":59592,"_5":14829,"_28301":59361,"_3051":59593},[],"High: KMS and VA start on empty volumes",{"_3582":2806,"_31169":2731,"_21582":59595,"_5":14829,"_28301":59361,"_3051":59596},[],"Copy the data into the new volumes",{"_3582":2807,"_31169":2731,"_21582":59598,"_5":14829,"_28301":59361,"_3051":59374},[],{"_3582":2808,"_31169":2731,"_21582":59600,"_5":14829,"_28301":59361,"_3051":59601},[],"Every Helm release",{"_3582":2809,"_31169":2731,"_21582":59603,"_5":14829,"_28301":59361,"_3051":59604},[],"High: `helm upgrade` fails",{"_3582":2810,"_31169":2731,"_21582":59606,"_5":14829,"_28301":59361,"_3051":59607},[],"Remove or rename legacy keys",{"_3582":2811,"_31169":2731,"_21582":59609,"_5":14829,"_28301":59361,"_3051":59378},[],{"_3582":2812,"_31169":2731,"_21582":59611,"_5":14829,"_28301":59361,"_3051":59612},[],"Every deployment",{"_3582":2813,"_31169":2731,"_21582":59614,"_5":14829,"_28301":59361,"_3051":59615},[],"High: without a bootstrap principal there is no administrator",{"_3582":2814,"_31169":2731,"_21582":59617,"_5":14829,"_28301":59361,"_3051":59618},[],"Configure `services.authz`",{"_3582":2815,"_31169":2731,"_21582":59620,"_5":14829,"_28301":59361,"_3051":59382},[],{"_3582":2816,"_31169":2731,"_21582":59622,"_5":14829,"_28301":59361,"_3051":59601},[],{"_3582":2817,"_31169":2731,"_21582":59624,"_5":14829,"_28301":59361,"_3051":59625},[],"High: `helm upgrade` fails on the old keys",{"_3582":2818,"_31169":2731,"_21582":59627,"_5":14829,"_28301":59361,"_3051":59628},[],"Move JWKS and roles into `services.authz`",{"_3582":2819,"_31169":2731,"_21582":59630,"_5":14829,"_28301":59361,"_3051":59402},[],{"_3582":2820,"_31169":2731,"_21582":59632,"_5":14829,"_28301":59361,"_3051":59633},[],"3.8.0 deployments with per-service databases",{"_3582":2821,"_31169":2731,"_21582":59635,"_5":14829,"_28301":59361,"_3051":59636},[],"High: services find no data, or a migration aborts",{"_3582":2822,"_31169":2731,"_21582":59638,"_5":14829,"_28301":59361,"_3051":59639},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3582":2823,"_31169":2731,"_21582":59641,"_5":14829,"_28301":59361,"_3051":59406},[],{"_3582":2824,"_31169":2731,"_21582":59643,"_5":14829,"_28301":59361,"_3051":59644},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3582":2825,"_31169":2731,"_21582":59646,"_5":14829,"_28301":59361,"_3051":59647},[],"High: the backend no longer starts with them",{"_3582":2826,"_31169":2731,"_21582":59649,"_5":14829,"_28301":59361,"_3051":59650},[],"Move to PostgreSQL before upgrading",{"_3582":2827,"_31169":2731,"_21582":59652,"_5":14829,"_28301":59361,"_3051":59450},[],{"_3582":2828,"_31169":2731,"_21582":59654,"_5":14829,"_28301":59361,"_3051":59655},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3582":2829,"_31169":2731,"_21582":59657,"_5":14829,"_28301":59361,"_3051":59658},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3582":2830,"_31169":2731,"_21582":59660,"_5":14829,"_28301":59361,"_3051":59661},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3582":2831,"_31169":2731,"_21582":59663,"_5":14829,"_28301":59361,"_3051":59664},[],"Webhooks with file references",{"_3582":2832,"_31169":2731,"_21582":59666,"_5":14829,"_28301":59361,"_3051":59667},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3582":2833,"_31169":2731,"_21582":59669,"_5":14829,"_28301":59361,"_3051":59670},[],"High: enrollments calling the webhook fail",{"_3582":2834,"_31169":2731,"_21582":59672,"_5":14829,"_28301":59361,"_3051":59673},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3582":2835,"_31169":2731,"_21582":59675,"_5":14829,"_28301":59361,"_3051":59386},[],{"_3582":2836,"_31169":2731,"_21582":59677,"_5":14829,"_28301":59361,"_3051":59678},[],"Releases with per-service identity overrides or mounted key material",{"_3582":2837,"_31169":2731,"_21582":59680,"_5":14829,"_28301":59361,"_3051":59681},[],"Medium: services cannot read their files",{"_3582":2838,"_31169":2731,"_21582":59683,"_5":14829,"_28301":59361,"_3051":59684},[],"Remove the overrides and fix volume ownership",{"_3582":2839,"_31169":2731,"_21582":59686,"_5":14829,"_28301":59361,"_3051":59390},[],{"_3582":2840,"_31169":2731,"_21582":59688,"_5":14829,"_28301":59361,"_3051":59689},[],"Releases that set `amqp.tls`",{"_3582":2841,"_31169":2731,"_21582":59691,"_5":14829,"_28301":59361,"_3051":59692},[],"Medium: clients connect to the wrong port",{"_3582":2842,"_31169":2731,"_21582":59694,"_5":14829,"_28301":59361,"_3051":59695},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3582":2843,"_31169":2731,"_21582":59697,"_5":14829,"_28301":59361,"_3051":59410},[],{"_3582":2844,"_31169":2731,"_21582":59699,"_5":14829,"_28301":59361,"_3051":59700},[],"Installations whose CA keys predate the KMS",{"_3582":2845,"_31169":2731,"_21582":59702,"_5":14829,"_28301":59361,"_3051":59703},[],"Medium: CA keys stay unmanaged",{"_3582":2846,"_31169":2731,"_21582":59705,"_5":14829,"_28301":59361,"_3051":59706},[],"Run the CA-to-KMS migration",{"_3582":2847,"_31169":2731,"_21582":59708,"_5":14829,"_28301":59361,"_3051":59709},[],"Receiver certificate verification",{"_3582":2848,"_31169":2731,"_21582":59711,"_5":14829,"_28301":59361,"_3051":59712},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3582":2849,"_31169":2731,"_21582":59714,"_5":14829,"_28301":59361,"_3051":59715},[],"Medium: credentials go to an unverified receiver",{"_3582":2850,"_31169":2731,"_21582":59717,"_5":14829,"_28301":59361,"_3051":59718},[],"Set `insecure_skip_verify` to `false`",{"_3582":2851,"_31169":2731,"_21582":59720,"_5":14829,"_28301":59361,"_3051":59426},[],{"_3582":2852,"_31169":2731,"_21582":59722,"_5":14829,"_28301":59361,"_3051":59723},[],"Scripts and consoles that edit DMSs through the API",{"_3582":2853,"_31169":2731,"_21582":59725,"_5":14829,"_28301":59361,"_3051":59726},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3582":2854,"_31169":2731,"_21582":59728,"_5":14829,"_28301":59361,"_3051":59729},[],"Read the DMS before editing and use the new field",{"_3582":2855,"_31169":2731,"_21582":59731,"_5":14829,"_28301":59361,"_3051":59446},[],{"_3582":2856,"_31169":2731,"_21582":59733,"_5":14829,"_28301":59361,"_3051":59734},[],"Clients that create or update CRL settings through the API",{"_3582":2857,"_31169":2731,"_21582":59736,"_5":14829,"_28301":59361,"_3051":59737},[],"Medium: requests with the old field return an error",{"_3582":2858,"_31169":2731,"_21582":59739,"_5":14829,"_28301":59361,"_3051":59740},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3582":2859,"_31169":2731,"_21582":59742,"_5":14829,"_28301":59361,"_3051":59454},[],{"_3582":2860,"_31169":2731,"_21582":59744,"_5":14829,"_28301":59361,"_3051":59745},[],"Alert subscriptions and consumers of the VA events",{"_3582":2861,"_31169":2731,"_21582":59747,"_5":14829,"_28301":59361,"_3051":59748},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3582":2862,"_31169":2731,"_21582":59750,"_5":14829,"_28301":59361,"_3051":59751},[],"Review conditions filtering on the old event payload or subject",{"_3582":2863,"_31169":2731,"_21582":59753,"_5":14829,"_28301":59361,"_3051":59442},[],{"_3582":2864,"_31169":2731,"_21582":59755,"_5":14829,"_28301":59361,"_3051":59756},[],"Consumers that read the device `events` field",{"_3582":2865,"_31169":2731,"_21582":59758,"_5":14829,"_28301":59361,"_3051":59759},[],"Medium: the field disappears",{"_3582":2866,"_31169":2731,"_21582":59761,"_5":14829,"_28301":59361,"_3051":59762},[],"Use the new event endpoints",{"_3582":2867,"_31169":2731,"_21582":59764,"_5":14829,"_28301":59361,"_3051":59462},[],{"_3582":2868,"_31169":2731,"_21582":59766,"_5":14829,"_28301":59361,"_3051":59767},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3582":2869,"_31169":2731,"_21582":59769,"_5":14829,"_28301":59361,"_3051":59770},[],"Medium: the VA migration aborts",{"_3582":2870,"_31169":2731,"_21582":59772,"_5":14829,"_28301":59361,"_3051":59773},[],"Fix the affected roles before upgrading",{"_3582":2871,"_31169":2731,"_21582":59775,"_5":14829,"_28301":59361,"_3051":59394},[],{"_3582":2872,"_31169":2731,"_21582":59777,"_5":14829,"_28301":59361,"_3051":59778},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3582":2873,"_31169":2731,"_21582":59780,"_5":14829,"_28301":59361,"_3051":59781},[],"Low to medium: validation errors or changed defaults",{"_3582":2874,"_31169":2731,"_21582":59783,"_5":14829,"_28301":59361,"_3051":59784},[],"Update the values file",{"_3582":2875,"_31169":2731,"_21582":59786,"_5":14829,"_28301":59361,"_3051":59434},[],{"_3582":2876,"_31169":2731,"_21582":59788,"_5":14829,"_28301":59361,"_3051":59789},[],"Clients that send the DMS ID in the update body",{"_3582":2877,"_31169":2731,"_21582":59791,"_5":14829,"_28301":59361,"_3051":59792},[],"Low: the ID in the URL wins",{"_3582":2878,"_31169":2731,"_21582":59794,"_5":14829,"_28301":59361,"_3051":59795},[],"Send the ID in the URL",{"_3582":2879,"_31169":2731,"_21582":59797,"_5":14829,"_28301":59361,"_3051":59458},[],{"_3582":2880,"_31169":2731,"_21582":59799,"_5":14829,"_28301":59361,"_3051":59800},[],"Clients that send an `id` when creating or importing CAs",{"_3582":2881,"_31169":2731,"_21582":59802,"_5":14829,"_28301":59361,"_3051":59803},[],"Low: the ID in the body is ignored, and the field is removed",{"_3582":2882,"_31169":2731,"_21582":59805,"_5":14829,"_28301":59361,"_3051":59806},[],"Let the backend assign the ID and use the returned one",{"_3582":2883,"_31169":2731,"_21582":59808,"_5":14829,"_28301":59361,"_3051":59438},[],{"_3582":2884,"_31169":2731,"_21582":59810,"_5":14829,"_28301":59361,"_3051":59811},[],"Consumers that match on certificate `type`",{"_3582":2885,"_31169":2731,"_21582":59813,"_5":14829,"_28301":59361,"_3051":59814},[],"Low: two values are renamed",{"_3582":2886,"_31169":2731,"_21582":59816,"_5":14829,"_28301":59361,"_3051":59817},[],"Adapt consumers",{"_3582":2887,"_31169":2731,"_21582":59819,"_5":14829,"_28301":59361,"_3051":59430},[],{"_3582":2888,"_31169":2731,"_21582":59821,"_5":14829,"_28301":59361,"_3051":59822},[],"Any DMS",{"_3582":2889,"_31169":2731,"_21582":59824,"_5":14829,"_28301":59361,"_3051":59825},[],"Low: informational",{"_3582":2890,"_31169":2731,"_21582":59827,"_5":14829,"_28301":59361,"_3051":59828},[],"Read both blocks before editing",{"_3582":2891,"_31169":2731,"_21582":59830,"_5":14829,"_28301":59369,"_3051":59831},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3582":2892,"_31169":2731,"_21582":59833,"_5":14829,"_28301":59369,"_3051":59834},[],"Step 4 of the migration guide copies the data.",{"_3582":2893,"_31169":2731,"_21582":59836,"_5":14829,"_28301":59373,"_3051":59837},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3582":2894,"_31169":2731,"_21582":59839,"_5":14829,"_28301":59377,"_3051":59840},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3582":2895,"_31169":2731,"_21582":59842,"_5":14829,"_28301":59381,"_3051":59843},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3582":2896,"_31169":2731,"_21582":59845,"_5":14829,"_28301":59385,"_3051":59846},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3582":2897,"_31169":2731,"_21582":59848,"_5":14829,"_28301":59385,"_3051":59849},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3582":2898,"_31169":2731,"_21582":59851,"_5":14829,"_28301":59389,"_3051":59852},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3582":2899,"_31169":2731,"_21582":59854,"_5":14829,"_28301":59393,"_3051":59855},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3582":2900,"_31169":2731,"_21582":59857,"_5":14829,"_28301":59393,"_3051":59858},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3582":2901,"_31169":2731,"_21582":59860,"_5":14829,"_28301":59393,"_3051":59861},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3582":2902,"_31169":2731,"_21582":59863,"_5":14829,"_28301":59393,"_3051":59864},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3582":2903,"_31169":2731,"_21582":59866,"_5":14829,"_28301":59393,"_3051":59867},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3582":2904,"_31169":2731,"_21582":59869,"_5":14829,"_28301":59393,"_3051":59870},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3582":2905,"_31169":2731,"_21582":59872,"_5":14829,"_28301":59401,"_3051":59873},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3582":2906,"_31169":2731,"_21582":59875,"_5":14829,"_28301":59401,"_3051":59876},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3582":2907,"_31169":2731,"_21582":59878,"_5":14829,"_28301":59401,"_3051":59879},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3582":2908,"_31169":2731,"_21582":59881,"_5":14829,"_28301":59401,"_3051":59882},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3582":2909,"_31169":2731,"_21582":59884,"_5":14829,"_28301":59401,"_3051":59885},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3582":2910,"_31169":2731,"_21582":59887,"_5":14829,"_28301":59405,"_3051":59888},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3582":2911,"_31169":2731,"_21582":59890,"_5":14829,"_28301":59409,"_3051":59891},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3582":2912,"_31169":2731,"_21582":59893,"_5":14829,"_28301":59409,"_3051":59894},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3582":2913,"_31169":2731,"_21582":59896,"_5":14829,"_28301":59409,"_3051":59897},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3582":2914,"_31169":2731,"_21582":59899,"_5":14829,"_28301":59409,"_3051":59900},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3582":2915,"_31169":2731,"_21582":59902,"_5":14829,"_28301":59409,"_3051":59903},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3582":2916,"_31169":2731,"_21582":59905,"_5":14829,"_28301":59409,"_3051":59906},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3582":2917,"_31169":2731,"_21582":59908,"_5":14829,"_28301":59409,"_3051":59909},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3582":2918,"_31169":2731,"_21582":59911,"_5":14829,"_28301":59409,"_3051":59912},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3582":2919,"_31169":2731,"_21582":59914,"_5":14829,"_28301":59413,"_3051":59915},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3582":2920,"_31169":2731,"_21582":59917,"_5":14829,"_28301":59421,"_3051":59918},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3582":2921,"_31169":2731,"_21582":59920,"_5":14829,"_28301":59421,"_3051":59921},[],"Field in 3.8.0",{"_3582":2922,"_31169":2731,"_21582":59923,"_5":14829,"_28301":59421,"_3051":59924},[],"Field in 4.0.0",{"_3582":2923,"_31169":2731,"_21582":59926,"_5":14829,"_28301":59421,"_3051":59927},[],"`validate_server_cert`",{"_3582":2924,"_31169":2731,"_21582":59929,"_5":14829,"_28301":59421,"_3051":59930},[],"`insecure_skip_verify` (value negated)",{"_3582":2925,"_31169":2731,"_21582":59932,"_5":14829,"_28301":59421,"_3051":59933},[],"`oidc`",{"_3582":2926,"_31169":2731,"_21582":59935,"_5":14829,"_28301":59421,"_3051":59936},[],"`jwt_options`",{"_3582":2927,"_31169":2731,"_21582":59938,"_5":14829,"_28301":59421,"_3051":59939},[],"`apikey`",{"_3582":2928,"_31169":2731,"_21582":59941,"_5":14829,"_28301":59421,"_3051":59942},[],"`apikey_options`",{"_3582":2929,"_31169":2731,"_21582":59944,"_5":14829,"_28301":59421,"_3051":59945},[],"`mtls`",{"_3582":2930,"_31169":2731,"_21582":59947,"_5":14829,"_28301":59421,"_3051":59948},[],"`mtls_options`",{"_3582":2931,"_31169":2731,"_21582":59950,"_5":14829,"_28301":59421,"_3051":59951},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3582":2932,"_31169":2731,"_21582":59953,"_5":14829,"_28301":59421,"_3051":59954},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3582":2933,"_31169":2731,"_21582":59956,"_5":14829,"_28301":59421,"_3051":59957},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3582":2934,"_31169":2731,"_21582":59959,"_5":14829,"_28301":59425,"_3051":59960},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3582":2935,"_31169":2731,"_21582":59962,"_5":14829,"_28301":59425,"_3051":59963},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3582":2936,"_31169":2731,"_21582":59965,"_5":14829,"_28301":59425,"_3051":59966},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3582":2937,"_31169":2731,"_21582":59968,"_5":14829,"_28301":59429,"_3051":59969},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3582":2938,"_31169":2731,"_21582":59971,"_5":14829,"_28301":59433,"_3051":59972},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3582":2939,"_31169":2731,"_21582":59974,"_5":14829,"_28301":59437,"_3051":59975},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3582":2940,"_31169":2731,"_21582":59977,"_5":14829,"_28301":59441,"_3051":59978},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3582":2941,"_31169":2731,"_21582":59980,"_5":14829,"_28301":59441,"_3051":59981},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3582":2942,"_31169":2731,"_21582":59983,"_5":14829,"_28301":59441,"_3051":59984},[],"`POST /v1/devices/:id/events` creates an event.",{"_3582":2943,"_31169":2731,"_21582":59986,"_5":14829,"_28301":59441,"_3051":59987},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3582":2944,"_31169":2731,"_21582":59989,"_5":14829,"_28301":59445,"_3051":59990},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3582":2945,"_31169":2731,"_21582":59992,"_5":14829,"_28301":59449,"_3051":59993},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3582":2946,"_31169":2731,"_21582":59995,"_5":14829,"_28301":59449,"_3051":59996},[],"Route",{"_3582":2947,"_31169":2731,"_21582":59998,"_5":14829,"_28301":59449,"_3051":54082},[],{"_3582":2948,"_31169":2731,"_21582":60000,"_5":14829,"_28301":59449,"_3051":60001},[],"`GET /v1/crl-settings`",{"_3582":2949,"_31169":2731,"_21582":60003,"_5":14829,"_28301":59449,"_3051":60004},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3582":2950,"_31169":2731,"_21582":60006,"_5":14829,"_28301":59449,"_3051":60007},[],"`GET /v1/crl-settings/{ca-id}`",{"_3582":2951,"_31169":2731,"_21582":60009,"_5":14829,"_28301":59449,"_3051":60010},[],"Reads the settings of a CA.",{"_3582":2952,"_31169":2731,"_21582":60012,"_5":14829,"_28301":59449,"_3051":60013},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3582":2953,"_31169":2731,"_21582":60015,"_5":14829,"_28301":59449,"_3051":60016},[],"Replaces `crl_options`.",{"_3582":2954,"_31169":2731,"_21582":60018,"_5":14829,"_28301":59449,"_3051":60019},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3582":2955,"_31169":2731,"_21582":60021,"_5":14829,"_28301":59449,"_3051":60022},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3582":2956,"_31169":2731,"_21582":60024,"_5":14829,"_28301":59449,"_3051":60025},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3582":2957,"_31169":2731,"_21582":60027,"_5":14829,"_28301":59449,"_3051":60028},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3582":2958,"_31169":2731,"_21582":60030,"_5":14829,"_28301":59449,"_3051":60031},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3582":2959,"_31169":2731,"_21582":60033,"_5":14829,"_28301":59449,"_3051":60034},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3582":2960,"_31169":2731,"_21582":60036,"_5":14829,"_28301":59449,"_3051":60037},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3582":2961,"_31169":2731,"_21582":60039,"_5":14829,"_28301":59449,"_3051":60040},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3582":2962,"_31169":2731,"_21582":60042,"_5":14829,"_28301":59449,"_3051":60043},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3582":2963,"_31169":2731,"_21582":60045,"_5":14829,"_28301":59449,"_3051":60046},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3582":2964,"_31169":2731,"_21582":60048,"_5":14829,"_28301":59449,"_3051":60049},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3582":2965,"_31169":2731,"_21582":60051,"_5":14829,"_28301":59453,"_3051":60052},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3582":2966,"_31169":2731,"_21582":60054,"_5":14829,"_28301":59457,"_3051":60055},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3582":2967,"_31169":2731,"_21582":60057,"_5":14829,"_28301":59461,"_3051":60058},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3582":2968,"_31169":2731,"_21582":60060,"_5":14829,"_28301":59465,"_3051":60061},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3582":2969,"_31169":2731,"_21582":60063,"_5":14829,"_28301":59469,"_3051":60064},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3582":2970,"_31169":2731,"_21582":60066,"_5":14829,"_28301":59469,"_3051":60067},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3582":2971,"_31169":2731,"_21582":60069,"_5":14829,"_28301":59469,"_3051":60070},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3582":2972,"_31169":2731,"_21582":60072,"_5":14829,"_28301":59469,"_3051":60073},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3582":2973,"_31169":2731,"_21582":60075,"_5":14829,"_28301":59469,"_3051":60076},[],"Record the names of your local-storage PVCs:",{"_3582":2974,"_31169":2731,"_21582":60078,"_5":14829,"_28301":59469,"_3051":60079},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3582":2975,"_31169":2731,"_21582":60081,"_5":14829,"_28301":59473,"_3051":60082},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3582":2976,"_31169":2731,"_21582":60084,"_5":14829,"_28301":59473,"_3051":60085},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3582":2977,"_31169":2731,"_21582":60087,"_5":14829,"_28301":59473,"_3051":60088},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3582":2978,"_31169":2731,"_21582":60090,"_5":14829,"_28301":59473,"_3051":60091},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3582":2979,"_31169":2731,"_21582":60093,"_5":14829,"_28301":59473,"_3051":60094},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3582":2980,"_31169":2731,"_21582":60096,"_5":14829,"_28301":59477,"_3051":60097},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3582":2981,"_31169":2731,"_21582":60099,"_5":14829,"_28301":59477,"_3051":60100},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3582":2982,"_31169":2731,"_21582":60102,"_5":14829,"_28301":59477,"_3051":60103},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3582":2983,"_31169":2731,"_21582":60105,"_5":14829,"_28301":59477,"_3051":60106},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3582":2984,"_31169":2731,"_21582":60108,"_5":14829,"_28301":59477,"_3051":60109},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3582":2985,"_31169":2731,"_21582":60111,"_5":14829,"_28301":59477,"_3051":60112},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3582":2986,"_31169":2731,"_21582":60114,"_5":14829,"_28301":59477,"_3051":60115},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3582":2987,"_31169":2731,"_21582":60117,"_5":14829,"_28301":59477,"_3051":60118},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3582":2988,"_31169":2731,"_21582":60120,"_5":14829,"_28301":59477,"_3051":60121},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3582":2989,"_31169":2731,"_21582":60123,"_5":14829,"_28301":59477,"_3051":60124},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3582":2990,"_31169":2731,"_21582":60126,"_5":14829,"_28301":59477,"_3051":60127},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3582":2991,"_31169":2731,"_21582":60129,"_5":14829,"_28301":59477,"_3051":60130},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3582":2992,"_31169":2731,"_21582":60132,"_5":14829,"_28301":59481,"_3051":60133},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3582":2993,"_31169":2731,"_21582":60135,"_5":14829,"_28301":59481,"_3051":60136},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3582":2994,"_31169":2731,"_21582":60138,"_5":14829,"_28301":59485,"_3051":60139},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3582":2995,"_31169":2731,"_21582":60141,"_5":14829,"_28301":59485,"_3051":60142},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3582":2996,"_31169":2731,"_21582":60144,"_5":14829,"_28301":59485,"_3051":60145},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3582":2997,"_31169":2731,"_21582":60147,"_5":14829,"_28301":59485,"_3051":60148},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3582":2998,"_31169":2731,"_21582":60150,"_5":14829,"_28301":59485,"_3051":60151},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3582":2999,"_31169":2731,"_21582":60153,"_5":14829,"_28301":59485,"_3051":60154},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3582":3000,"_31169":2731,"_21582":60156,"_5":14829,"_28301":59485,"_3051":60157},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3582":3001,"_31169":2731,"_21582":60159,"_5":14829,"_28301":59485,"_3051":60160},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3582":3002,"_31169":2731,"_21582":60162,"_5":14829,"_28301":59485,"_3051":60163},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3582":3003,"_31169":2731,"_21582":60165,"_5":14829,"_28301":59485,"_3051":60166},[],"**Remove the helper and restore the recorded replica counts:**",{"_3582":3004,"_31169":2731,"_21582":60168,"_5":14829,"_28301":59485,"_3051":60169},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3582":3005,"_31169":2731,"_21582":60171,"_5":14829,"_28301":59489,"_3051":60172},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3582":3006,"_31169":2731,"_21582":60174,"_5":14829,"_28301":59489,"_3051":60175},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3582":3007,"_31169":2731,"_21582":60177,"_5":14829,"_28301":59493,"_3051":60178},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3582":3008,"_31169":2731,"_21582":60180,"_5":14829,"_28301":59493,"_3051":60181},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3582":3009,"_31169":2731,"_21582":60183,"_5":14829,"_28301":59493,"_3051":60184},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3582":3010,"_31169":2731,"_21582":60186,"_5":14829,"_28301":59493,"_3051":60187},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3582":3011,"_31169":2731,"_21582":60189,"_5":14829,"_28301":59493,"_3051":60190},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3582":3012,"_31169":2731,"_21582":60192,"_5":14829,"_28301":59493,"_3051":60193},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3582":3013,"_31169":2731,"_21582":60195,"_5":14829,"_28301":59493,"_3051":60196},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3582":3014,"_31169":2731,"_21582":60198,"_5":14829,"_28301":59493,"_3051":60199},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3582":3015,"_31169":2731,"_21582":60201,"_5":14829,"_28301":59497,"_3051":60202},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3582":3016,"_31169":2731,"_21582":60204,"_5":14829,"_28301":59497,"_3051":60205},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3582":3017,"_31169":2731,"_21582":60207,"_5":14829,"_28301":59497,"_3051":60208},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3582":3018,"_31169":2731,"_21582":60210,"_5":14829,"_28301":59497,"_3051":60211},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3582":3019,"_31169":2731,"_21582":60213,"_5":14829,"_28301":59497,"_3051":60214},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3582":3020,"_31169":2731,"_21582":60216,"_5":14829,"_28301":59497,"_3051":60217},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3582":3021,"_31169":2731,"_21582":60219,"_5":14829,"_28301":59497,"_3051":60220},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3582":3022,"_31169":2731,"_21582":60222,"_5":14829,"_28301":59497,"_3051":60223},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3582":3023,"_31169":2731,"_21582":60225,"_5":14829,"_28301":59497,"_3051":60226},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3582":3024,"_31169":2731,"_21582":60228,"_5":14829,"_28301":59497,"_3051":60229},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3582":3025,"_31169":2731,"_21582":60231,"_5":14829,"_28301":59497,"_3051":60232},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3582":3026,"_31169":2731,"_21582":60234,"_5":14829,"_28301":59500,"_3051":60235},[],"After the upgrade, check in this order:",{"_3582":3027,"_31169":2731,"_21582":60237,"_5":14829,"_28301":59500,"_3051":60238},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3582":3028,"_31169":2731,"_21582":60240,"_5":14829,"_28301":59500,"_3051":60241},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3582":3029,"_31169":2731,"_21582":60243,"_5":14829,"_28301":59500,"_3051":60244},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3582":3030,"_31169":2731,"_21582":60246,"_5":14829,"_28301":59500,"_3051":60247},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3582":3031,"_31169":2731,"_21582":60249,"_5":14829,"_28301":59500,"_3051":60250},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3582":3032,"_31169":2731,"_21582":60252,"_5":14829,"_28301":59500,"_3051":60253},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3582":3033,"_31169":2731,"_21582":60255,"_5":14829,"_28301":59500,"_3051":60256},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3582":3034,"_31169":2731,"_21582":60258,"_5":14829,"_28301":59500,"_3051":60259},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3582":3035,"_31169":2731,"_21582":60261,"_5":14829,"_28301":59500,"_3051":60262},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3582":3036,"_31169":2731,"_21582":60264,"_5":14829,"_28301":59500,"_3051":60265},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3582":3037,"_31169":2731,"_21582":60267,"_5":14829,"_28301":59500,"_3051":60268},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3582":3038,"_31169":2731,"_21582":60270,"_5":14829,"_28301":59500,"_3051":60271},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3582":3039,"_31169":2731,"_21582":60273,"_5":14829,"_28301":59500,"_3051":60274},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3582":3040,"_31169":2731,"_21582":60276,"_5":14829,"_28301":59500,"_3051":60277},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3582":3041,"_31169":2731,"_21582":60279,"_5":14829,"_28301":59500,"_3051":60280},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3582":3042,"_31169":2731,"_21582":60282,"_5":14829,"_28301":59504,"_3051":60283},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3582":3043,"_31169":2731,"_21582":60285,"_5":14829,"_28301":59504,"_3051":60286},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3582":3044,"_31169":2731,"_21582":60288,"_5":14829,"_28301":59504,"_3051":60289},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3582":3045,"_31169":2731,"_21582":60291,"_5":14829,"_28301":59504,"_3051":60292},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3582":3046,"_31169":2731,"_21582":60294,"_5":14829,"_28301":59504,"_3051":60295},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60298":60299,"_60300":60301,"_60302":60303,"_60304":60305,"_18726":3086,"_72447":3086},"language","english","sortableProperties",[3051,31169,5,28301],"sortablePropertiesWithTypes",{"_3051":25834,"_31169":25834,"_5":25834,"_28301":25834},"sorts",{"_3051":60306,"_31169":63342,"_5":66377,"_28301":69412},{"_4812":60307,"_60308":60309,"_5":25834},{"_3676":3372,"_15304":23239,"_15323":7218,"_3663":4615,"_15310":6493,"_20492":5658,"_14935":17814,"_14942":9123,"_30102":5713,"_30524":7530,"_30544":9845,"_30136":4536,"_35607":4880,"_30243":7475,"_30588":7805,"_35614":6196,"_35617":7345,"_35620":17709,"_35623":3538,"_30995":6767,"_35628":28562,"_35630":3373,"_31025":6241,"_15319":6746,"_35634":14786,"_35637":9172,"_35639":6466,"_30572":6094,"_30990":13231,"_31038":10102,"_35644":7942,"_35646":3468,"_35648":7923,"_30260":3151,"_35651":6253,"_35653":3175,"_35655":16299,"_35657":3803,"_35659":7919,"_30177":27526,"_35662":7284,"_3666":5361,"_30171":7241,"_30609":4348,"_35667":6489,"_35669":6212,"_35672":3512,"_30217":17931,"_35676":23762,"_30093":5695,"_35679":17791,"_30141":3794,"_35682":4932,"_35684":7898,"_35687":5027,"_15313":4883,"_35690":6770,"_35692":6112,"_35695":4918,"_35697":4660,"_31228":3137,"_35700":3972,"_35702":11579,"_20495":13633,"_35705":3386,"_35707":4760,"_30114":6455,"_30566":10670,"_35711":9414,"_35713":4546,"_35715":3390,"_31055":16220,"_35718":7866,"_35720":6080,"_35722":7857,"_31149":5172,"_30625":25841,"_35726":11690,"_35728":5754,"_30156":3856,"_35731":3779,"_35733":7927,"_35735":3403,"_31071":4614,"_30237":6888,"_29592":13188,"_35740":3161,"_35742":3786,"_35744":3166,"_30286":6251,"_35748":5978,"_30560":7386,"_35752":25843,"_35754":6821,"_35756":3479,"_35758":4186,"_35760":3122,"_35762":4764,"_30275":6081,"_3679":5317,"_35766":6097,"_35768":3483,"_35770":8702,"_35773":6303,"_35775":6432,"_35777":4451,"_35779":9910,"_35781":3265,"_35783":17929,"_35785":6078,"_35788":7340,"_35790":25842,"_35792":24755,"_35794":4936,"_35796":10195,"_35799":7583,"_35801":4571,"_35804":4007,"_35807":6751,"_35809":3922,"_35811":3369,"_35813":3226,"_35815":7807,"_35817":50827,"_35819":7060,"_35821":4866,"_35823":5325,"_30571":14911,"_35826":6199,"_35828":7384,"_35830":10512,"_35832":7181,"_35834":3110,"_35836":7587,"_35838":6072,"_35840":3911,"_35842":9964,"_35844":8198,"_35846":11670,"_35848":3470,"_35850":4839,"_35852":7809,"_35854":4900,"_35856":6071,"_35858":7182,"_35860":3405,"_35862":5125,"_35864":3088,"_35866":14753,"_35868":4143,"_35870":7169,"_35872":7916,"_35874":4648,"_35876":5228,"_35878":12481,"_35880":7808,"_35882":3966,"_35884":7914,"_35886":7180,"_