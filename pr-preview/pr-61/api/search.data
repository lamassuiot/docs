0321":58319,"_40323":58322,"_40325":58325,"_40327":58328,"_40329":58331,"_40332":58334,"_40334":58337,"_40336":58340,"_40338":58343},{"_3464":15,"_30135":15,"_5":14718,"_2948":49200,"_30488":49201,"_20936":49205,"_27421":15},"Deploy from AWS Marketplace",[49202,49203,49204],"Docs","Deployment","Other models",[],{"_3464":16,"_30135":15,"_20936":49207,"_5":14366,"_27421":15,"_2948":49208},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3464":17,"_30135":15,"_5":30485,"_20936":49210,"_27421":49211,"_2948":49212},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3464":18,"_30135":15,"_5":30485,"_20936":49214,"_27421":49215,"_2948":49216},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3464":19,"_30135":15,"_5":30485,"_20936":49218,"_27421":49219,"_2948":49220},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3464":20,"_30135":15,"_5":30485,"_20936":49222,"_27421":49223,"_2948":49224},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3464":21,"_30135":15,"_5":30485,"_20936":49226,"_27421":49227,"_2948":49228},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3464":22,"_30135":15,"_5":30485,"_20936":49230,"_27421":49231,"_2948":49232},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3464":23,"_30135":15,"_5":30485,"_20936":49234,"_27421":49235,"_2948":49236},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#next-step","Next step",{"_3464":24,"_30135":15,"_20936":49238,"_5":14366,"_27421":15,"_2948":49239},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3464":25,"_30135":15,"_20936":49241,"_5":14366,"_27421":49211,"_2948":49242},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3464":26,"_30135":15,"_20936":49244,"_5":14366,"_27421":49211,"_2948":49245},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3464":27,"_30135":15,"_20936":49247,"_5":14366,"_27421":49211,"_2948":49248},[],"A security group allowing the necessary endpoints.",{"_3464":28,"_30135":15,"_20936":49250,"_5":14366,"_27421":49215,"_2948":49251},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3464":29,"_30135":15,"_20936":49253,"_5":14366,"_27421":49215,"_2948":49254},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3464":30,"_30135":15,"_20936":49256,"_5":14366,"_27421":49215,"_2948":49257},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3464":31,"_30135":15,"_20936":49259,"_5":14366,"_27421":49219,"_2948":49260},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3464":32,"_30135":15,"_20936":49262,"_5":14366,"_27421":49223,"_2948":49263},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3464":33,"_30135":15,"_20936":49265,"_5":14366,"_27421":49227,"_2948":49266},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3464":34,"_30135":15,"_20936":49268,"_5":14366,"_27421":49231,"_2948":49269},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3464":35,"_30135":15,"_20936":49271,"_5":14366,"_27421":49235,"_2948":49272},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3464":36,"_30135":36,"_5":14718,"_2948":49274,"_30488":49275,"_20936":49276,"_27421":36},"Deploy Lamassu",[49202,49203],[],{"_3464":37,"_30135":36,"_20936":49278,"_5":14366,"_27421":36,"_2948":49279},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3464":38,"_30135":36,"_5":30485,"_20936":49281,"_27421":49282,"_2948":49283},[],"/docs/pr-preview/pr-61/deployment/overview#choose-a-model","Choose a model",{"_3464":39,"_30135":36,"_5":30485,"_20936":49285,"_27421":49286,"_2948":49287},[],"/docs/pr-preview/pr-61/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3464":40,"_30135":36,"_5":30485,"_20936":49289,"_27421":49290,"_2948":49291},[],"/docs/pr-preview/pr-61/deployment/overview#after-deployment","After deployment",{"_3464":41,"_30135":36,"_20936":49293,"_5":14366,"_27421":36,"_2948":49294},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3464":42,"_30135":36,"_20936":49296,"_5":14366,"_27421":49282,"_2948":49297},[],"Model",{"_3464":43,"_30135":36,"_20936":49299,"_5":14366,"_27421":49282,"_2948":49300},[],"Recommended for",{"_3464":44,"_30135":36,"_20936":49302,"_5":14366,"_27421":49282,"_2948":49303},[],"Who operates the infrastructure",{"_3464":45,"_30135":36,"_20936":49305,"_5":14366,"_27421":49282,"_2948":49306},[],"Starting point",{"_3464":46,"_30135":36,"_20936":49308,"_5":14366,"_27421":49282,"_2948":49309},[],"Kubernetes self-managed",{"_3464":47,"_30135":36,"_20936":49311,"_5":14366,"_27421":49282,"_2948":49312},[],"Production, regulated environments and custom deployments",{"_3464":48,"_30135":36,"_20936":49314,"_5":14366,"_27421":49282,"_2948":49315},[],"Your team",{"_3464":49,"_30135":36,"_20936":49317,"_5":14366,"_27421":49282,"_2948":49318},[],"Helm or Fastlane",{"_3464":50,"_30135":36,"_20936":49320,"_5":14366,"_27421":49282,"_2948":49321},[],"AWS Marketplace",{"_3464":51,"_30135":36,"_20936":49323,"_5":14366,"_27421":49282,"_2948":49324},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3464":52,"_30135":36,"_20936":49326,"_5":14366,"_27421":49282,"_2948":49315},[],{"_3464":53,"_30135":36,"_20936":49328,"_5":14366,"_27421":49282,"_2948":49329},[],"Preconfigured image on EC2",{"_3464":54,"_30135":36,"_20936":49331,"_5":14366,"_27421":49282,"_2948":49332},[],"SaaS",{"_3464":55,"_30135":36,"_20936":49334,"_5":14366,"_27421":49282,"_2948":49335},[],"Teams that want to use the platform without operating it",{"_3464":56,"_30135":36,"_20936":49337,"_5":14366,"_27421":49282,"_2948":49338},[],"Lamassu",{"_3464":57,"_30135":36,"_20936":49340,"_5":14366,"_27421":49282,"_2948":49341},[],"Managed subscription",{"_3464":58,"_30135":36,"_20936":49343,"_5":14366,"_27421":49282,"_2948":49344},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3464":59,"_30135":36,"_20936":49346,"_5":14366,"_27421":49282,"_2948":49347},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3464":60,"_30135":36,"_20936":49349,"_5":14366,"_27421":49282,"_2948":49350},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3464":61,"_30135":36,"_20936":49352,"_5":14366,"_27421":49286,"_2948":49353},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3464":62,"_30135":36,"_20936":49355,"_5":14366,"_27421":49290,"_2948":49356},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3464":63,"_30135":63,"_5":14718,"_2948":49358,"_30488":49359,"_20936":49360,"_27421":63},"Use Lamassu as SaaS",[49202,49203,49204],[],{"_3464":64,"_30135":63,"_20936":49362,"_5":14366,"_27421":63,"_2948":49363},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3464":65,"_30135":63,"_5":30485,"_20936":49365,"_27421":49366,"_2948":49367},[],"/docs/pr-preview/pr-61/deployment/saas#what-the-service-manages","What the service manages",{"_3464":66,"_30135":63,"_5":30485,"_20936":49369,"_27421":49370,"_2948":49371},[],"/docs/pr-preview/pr-61/deployment/saas#plans","Plans",{"_3464":67,"_30135":63,"_5":30485,"_20936":49373,"_27421":49374,"_2948":49375},[],"/docs/pr-preview/pr-61/deployment/saas#request-access","Request access",{"_3464":68,"_30135":63,"_20936":49377,"_5":14366,"_27421":63,"_2948":49378},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3464":69,"_30135":63,"_20936":49380,"_5":14366,"_27421":49366,"_2948":49381},[],"Platform availability and maintenance.",{"_3464":70,"_30135":63,"_20936":49383,"_5":14366,"_27421":49366,"_2948":49384},[],"Automatic backups.",{"_3464":71,"_30135":63,"_20936":49386,"_5":14366,"_27421":49366,"_2948":49387},[],"Version upgrades.",{"_3464":72,"_30135":63,"_20936":49389,"_5":14366,"_27421":49366,"_2948":49390},[],"Technical support and SLA according to your plan.",{"_3464":73,"_30135":63,"_20936":49392,"_5":14366,"_27421":49370,"_2948":49393},[],"Plan",{"_3464":74,"_30135":63,"_20936":49395,"_5":14366,"_27421":49370,"_2948":49396},[],"Devices",{"_3464":75,"_30135":63,"_20936":49398,"_5":14366,"_27421":49370,"_2948":49399},[],"Support",{"_3464":76,"_30135":63,"_20936":49401,"_5":14366,"_27421":49370,"_2948":49402},[],"SLA",{"_3464":77,"_30135":63,"_20936":49404,"_5":14366,"_27421":49370,"_2948":49405},[],"Starter",{"_3464":78,"_30135":63,"_20936":49407,"_5":14366,"_27421":49370,"_2948":49408},[],"Up to 1,000",{"_3464":79,"_30135":63,"_20936":49410,"_5":14366,"_27421":49370,"_2948":49411},[],"Email",{"_3464":80,"_30135":63,"_20936":49413,"_5":14366,"_27421":49370,"_2948":49414},[],"99.5 %",{"_3464":81,"_30135":63,"_20936":49416,"_5":14366,"_27421":49370,"_2948":49417},[],"Professional",{"_3464":82,"_30135":63,"_20936":49419,"_5":14366,"_27421":49370,"_2948":49420},[],"Up to 10,000",{"_3464":83,"_30135":63,"_20936":49422,"_5":14366,"_27421":49370,"_2948":49423},[],"Email and chat",{"_3464":84,"_30135":63,"_20936":49425,"_5":14366,"_27421":49370,"_2948":49426},[],"99.9 %",{"_3464":85,"_30135":63,"_20936":49428,"_5":14366,"_27421":49370,"_2948":49429},[],"Enterprise",{"_3464":86,"_30135":63,"_20936":49431,"_5":14366,"_27421":49370,"_2948":49432},[],"Unlimited",{"_3464":87,"_30135":63,"_20936":49434,"_5":14366,"_27421":49370,"_2948":49435},[],"Dedicated",{"_3464":88,"_30135":63,"_20936":49437,"_5":14366,"_27421":49370,"_2948":49438},[],"99.99 %",{"_3464":89,"_30135":63,"_20936":49440,"_5":14366,"_27421":49374,"_2948":49441},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3464":90,"_30135":63,"_20936":49443,"_5":14366,"_27421":49374,"_2948":49444},[],"When you receive your instance's credentials, continue with Get started.",{"_3464":91,"_30135":91,"_5":14718,"_2948":49446,"_30488":49447,"_20936":49448,"_27421":91},"Fastlane",[49202,49203,49309],[],{"_3464":92,"_30135":91,"_20936":49450,"_5":14366,"_27421":91,"_2948":49451},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3464":93,"_30135":91,"_5":30485,"_20936":49453,"_27421":49454,"_2948":49455},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3464":94,"_30135":91,"_5":30485,"_20936":49457,"_27421":49458,"_2948":49459},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3464":95,"_30135":91,"_5":30485,"_20936":49461,"_27421":49462,"_2948":49212},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#before-you-begin",{"_3464":96,"_30135":91,"_5":30485,"_20936":49464,"_27421":49465,"_2948":49466},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3464":97,"_30135":91,"_5":30485,"_20936":49468,"_27421":49469,"_2948":49470},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3464":98,"_30135":91,"_5":30485,"_20936":49472,"_27421":49473,"_2948":49474},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3464":99,"_30135":91,"_5":30485,"_20936":49476,"_27421":49477,"_2948":49478},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3464":100,"_30135":91,"_5":30485,"_20936":49480,"_27421":49481,"_2948":49482},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3464":101,"_30135":91,"_5":30485,"_20936":49484,"_27421":49485,"_2948":49486},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3464":102,"_30135":91,"_5":30485,"_20936":49488,"_27421":49489,"_2948":49490},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3464":103,"_30135":91,"_5":30485,"_20936":49492,"_27421":49493,"_2948":49494},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3464":104,"_30135":91,"_20936":49496,"_5":14366,"_27421":49454,"_2948":49497},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3464":105,"_30135":91,"_20936":49499,"_5":14366,"_27421":49454,"_2948":49500},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3464":106,"_30135":91,"_20936":49502,"_5":14366,"_27421":49458,"_2948":49503},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3464":107,"_30135":91,"_20936":49505,"_5":14366,"_27421":49458,"_2948":49506},[],"Fastlane installs or configures",{"_3464":108,"_30135":91,"_20936":49508,"_5":14366,"_27421":49458,"_2948":49509},[],"You still provide",{"_3464":109,"_30135":91,"_20936":49511,"_5":14366,"_27421":49458,"_2948":49512},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3464":110,"_30135":91,"_20936":49514,"_5":14366,"_27421":49458,"_2948":49515},[],"The Kubernetes cluster, nodes and persistent storage",{"_3464":111,"_30135":91,"_20936":49517,"_5":14366,"_27421":49458,"_2948":49518},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3464":112,"_30135":91,"_20936":49520,"_5":14366,"_27421":49458,"_2948":49521},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3464":113,"_30135":91,"_20936":49523,"_5":14366,"_27421":49458,"_2948":49524},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3464":114,"_30135":91,"_20936":49526,"_5":14366,"_27421":49458,"_2948":49527},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3464":115,"_30135":91,"_20936":49529,"_5":14366,"_27421":49458,"_2948":49530},[],"Optional observability and lab HSM components",{"_3464":116,"_30135":91,"_20936":49532,"_5":14366,"_27421":49458,"_2948":49533},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3464":117,"_30135":91,"_20936":49535,"_5":14366,"_27421":49458,"_2948":49536},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3464":118,"_30135":91,"_20936":49538,"_5":14366,"_27421":49462,"_2948":49539},[],"You need:",{"_3464":119,"_30135":91,"_20936":49541,"_5":14366,"_27421":49462,"_2948":49542},[],"an existing Kubernetes cluster",{"_3464":120,"_30135":91,"_20936":49544,"_5":14366,"_27421":49462,"_2948":49545},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3464":121,"_30135":91,"_20936":49547,"_5":14366,"_27421":49462,"_2948":49548},[],"`yq`",{"_3464":122,"_30135":91,"_20936":49550,"_5":14366,"_27421":49462,"_2948":23657},[],{"_3464":123,"_30135":91,"_20936":49552,"_5":14366,"_27421":49462,"_2948":49553},[],"`jq` only when using `--sample-data` or `--development`",{"_3464":124,"_30135":91,"_20936":49555,"_5":14366,"_27421":49462,"_2948":49556},[],"`ssh-keygen` only when using `--with-hsm`",{"_3464":125,"_30135":91,"_20936":49558,"_5":14366,"_27421":49462,"_2948":49559},[],"free external ports 80 and 443 on a single-node K3s host",{"_3464":126,"_30135":91,"_20936":49561,"_5":14366,"_27421":49462,"_2948":49562},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3464":127,"_30135":91,"_20936":49564,"_5":14366,"_27421":49462,"_2948":49565},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3464":128,"_30135":91,"_20936":49567,"_5":14366,"_27421":49465,"_2948":49568},[],"Run the script from a clone of the Helm repository:",{"_3464":129,"_30135":91,"_20936":49570,"_5":14366,"_27421":49465,"_2948":49571},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3464":130,"_30135":91,"_20936":49573,"_5":14366,"_27421":49469,"_2948":49574},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3464":131,"_30135":91,"_20936":49576,"_5":14366,"_27421":49469,"_2948":49577},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3464":132,"_30135":91,"_20936":49579,"_5":14366,"_27421":49469,"_2948":49580},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3464":133,"_30135":91,"_20936":49582,"_5":14366,"_27421":49469,"_2948":49583},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3464":134,"_30135":91,"_20936":49585,"_5":14366,"_27421":49473,"_2948":49586},[],"Option",{"_3464":135,"_30135":91,"_20936":49588,"_5":14366,"_27421":49473,"_2948":49589},[],"Default",{"_3464":136,"_30135":91,"_20936":49591,"_5":14366,"_27421":49473,"_2948":49592},[],"Purpose",{"_3464":137,"_30135":91,"_20936":49594,"_5":14366,"_27421":49473,"_2948":49595},[],"`-h`, `--help`",{"_3464":138,"_30135":91,"_20936":49597,"_5":14366,"_27421":49473,"_2948":49598},[],"—",{"_3464":139,"_30135":91,"_20936":49600,"_5":14366,"_27421":49473,"_2948":49601},[],"Show help",{"_3464":140,"_30135":91,"_20936":49603,"_5":14366,"_27421":49473,"_2948":49604},[],"`-c`, `--context`",{"_3464":141,"_30135":91,"_20936":49606,"_5":14366,"_27421":49473,"_2948":49607},[],"current context",{"_3464":142,"_30135":91,"_20936":49609,"_5":14366,"_27421":49473,"_2948":49610},[],"Select the kubeconfig context for kubectl and Helm",{"_3464":143,"_30135":91,"_20936":49612,"_5":14366,"_27421":49473,"_2948":49613},[],"`-n`, `--non-interactive`",{"_3464":144,"_30135":91,"_20936":49615,"_5":14366,"_27421":49473,"_2948":6526},[],{"_3464":145,"_30135":91,"_20936":49617,"_5":14366,"_27421":49473,"_2948":49618},[],"Skip prompts and generate dependency credentials",{"_3464":146,"_30135":91,"_20936":49620,"_5":14366,"_27421":49473,"_2948":49621},[],"`-ns`, `--namespace`",{"_3464":147,"_30135":91,"_20936":49623,"_5":14366,"_27421":49473,"_2948":49624},[],"`lamassu-dev`",{"_3464":148,"_30135":91,"_20936":49626,"_5":14366,"_27421":49473,"_2948":49627},[],"Namespace for the installation",{"_3464":149,"_30135":91,"_20936":49629,"_5":14366,"_27421":49473,"_2948":49630},[],"`-d`, `--domain`",{"_3464":150,"_30135":91,"_20936":49632,"_5":14366,"_27421":49473,"_2948":49633},[],"`dev.lamassu.io`",{"_3464":151,"_30135":91,"_20936":49635,"_5":14366,"_27421":49473,"_2948":49636},[],"Domain used by the UI, OIDC and certificate",{"_3464":152,"_30135":91,"_20936":49638,"_5":14366,"_27421":49473,"_2948":49639},[],"`-v`, `--version`",{"_3464":153,"_30135":91,"_20936":49641,"_5":14366,"_27421":49473,"_2948":15064},[],{"_3464":154,"_30135":91,"_20936":49643,"_5":14366,"_27421":49473,"_2948":49644},[],"Lamassu chart version",{"_3464":155,"_30135":91,"_20936":49646,"_5":14366,"_27421":49473,"_2948":49647},[],"`--https-port`",{"_3464":156,"_30135":91,"_20936":49649,"_5":14366,"_27421":49473,"_2948":49650},[],"`443`",{"_3464":157,"_30135":91,"_20936":49652,"_5":14366,"_27421":49473,"_2948":49653},[],"Gateway HTTPS listener port",{"_3464":158,"_30135":91,"_20936":49655,"_5":14366,"_27421":49473,"_2948":49656},[],"`--http-port`",{"_3464":159,"_30135":91,"_20936":49658,"_5":14366,"_27421":49473,"_2948":49659},[],"`80`",{"_3464":160,"_30135":91,"_20936":49661,"_5":14366,"_27421":49473,"_2948":49662},[],"Gateway HTTP listener port",{"_3464":161,"_30135":91,"_20936":49664,"_5":14366,"_27421":49473,"_2948":49665},[],"`--tls-crt`",{"_3464":162,"_30135":91,"_20936":49667,"_5":14366,"_27421":49473,"_2948":49598},[],{"_3464":163,"_30135":91,"_20936":49669,"_5":14366,"_27421":49473,"_2948":49670},[],"PEM certificate for downstream TLS",{"_3464":164,"_30135":91,"_20936":49672,"_5":14366,"_27421":49473,"_2948":49673},[],"`--tls-key`",{"_3464":165,"_30135":91,"_20936":49675,"_5":14366,"_27421":49473,"_2948":49598},[],{"_3464":166,"_30135":91,"_20936":49677,"_5":14366,"_27421":49473,"_2948":49678},[],"PEM private key for downstream TLS",{"_3464":167,"_30135":91,"_20936":49680,"_5":14366,"_27421":49473,"_2948":49681},[],"`-l`, `--local-chart-path`",{"_3464":168,"_30135":91,"_20936":49683,"_5":14366,"_27421":49473,"_2948":49684},[],"repository chart",{"_3464":169,"_30135":91,"_20936":49686,"_5":14366,"_27421":49473,"_2948":49687},[],"Use an unpacked local Lamassu chart",{"_3464":170,"_30135":91,"_20936":49689,"_5":14366,"_27421":49473,"_2948":49690},[],"`-ip`, `--gateway-ip`",{"_3464":171,"_30135":91,"_20936":49692,"_5":14366,"_27421":49473,"_2948":8727},[],{"_3464":172,"_30135":91,"_20936":49694,"_5":14366,"_27421":49473,"_2948":49695},[],"Override the address written to `gateway.addresses`",{"_3464":173,"_30135":91,"_20936":49697,"_5":14366,"_27421":49473,"_2948":49698},[],"`--otel`",{"_3464":174,"_30135":91,"_20936":49700,"_5":14366,"_27421":49473,"_2948":6526},[],{"_3464":175,"_30135":91,"_20936":49702,"_5":14366,"_27421":49473,"_2948":49703},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3464":176,"_30135":91,"_20936":49705,"_5":14366,"_27421":49473,"_2948":49706},[],"`--development`",{"_3464":177,"_30135":91,"_20936":49708,"_5":14366,"_27421":49473,"_2948":6526},[],{"_3464":178,"_30135":91,"_20936":49710,"_5":14366,"_27421":49473,"_2948":49711},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3464":179,"_30135":91,"_20936":49713,"_5":14366,"_27421":49473,"_2948":49714},[],"`--sample-data`",{"_3464":180,"_30135":91,"_20936":49716,"_5":14366,"_27421":49473,"_2948":6526},[],{"_3464":181,"_30135":91,"_20936":49718,"_5":14366,"_27421":49473,"_2948":49719},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3464":182,"_30135":91,"_20936":49721,"_5":14366,"_27421":49473,"_2948":49722},[],"`--with-hsm`",{"_3464":183,"_30135":91,"_20936":49724,"_5":14366,"_27421":49473,"_2948":6526},[],{"_3464":184,"_30135":91,"_20936":49726,"_5":14366,"_27421":49473,"_2948":49727},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3464":185,"_30135":91,"_20936":49729,"_5":14366,"_27421":49473,"_2948":49730},[],"`--softhsm-chart-path`",{"_3464":186,"_30135":91,"_20936":49732,"_5":14366,"_27421":49473,"_2948":49733},[],"`./charts/softhsm`",{"_3464":187,"_30135":91,"_20936":49735,"_5":14366,"_27421":49473,"_2948":49736},[],"Use a different local SoftHSM chart",{"_3464":188,"_30135":91,"_20936":49738,"_5":14366,"_27421":49473,"_2948":49739},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3464":189,"_30135":91,"_20936":49741,"_5":14366,"_27421":49477,"_2948":49742},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3464":190,"_30135":91,"_20936":49744,"_5":14366,"_27421":49477,"_2948":49745},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3464":191,"_30135":91,"_20936":49747,"_5":14366,"_27421":49477,"_2948":49748},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3464":192,"_30135":91,"_20936":49750,"_5":14366,"_27421":49477,"_2948":49751},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3464":193,"_30135":91,"_20936":49753,"_5":14366,"_27421":49477,"_2948":49754},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3464":194,"_30135":91,"_20936":49756,"_5":14366,"_27421":49477,"_2948":49757},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3464":195,"_30135":91,"_20936":49759,"_5":14366,"_27421":49481,"_2948":49760},[],"Fastlane:",{"_3464":196,"_30135":91,"_20936":49762,"_5":14366,"_27421":49481,"_2948":49763},[],"validates local tools and the selected cluster",{"_3464":197,"_30135":91,"_20936":49765,"_5":14366,"_27421":49481,"_2948":49766},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3464":198,"_30135":91,"_20936":49768,"_5":14366,"_27421":49481,"_2948":49769},[],"creates the namespace",{"_3464":199,"_30135":91,"_20936":49771,"_5":14366,"_27421":49481,"_2948":49772},[],"installs PostgreSQL and creates the required databases",{"_3464":200,"_30135":91,"_20936":49774,"_5":14366,"_27421":49481,"_2948":49775},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3464":201,"_30135":91,"_20936":49777,"_5":14366,"_27421":49481,"_2948":49778},[],"installs RabbitMQ",{"_3464":202,"_30135":91,"_20936":49780,"_5":14366,"_27421":49481,"_2948":49781},[],"optionally installs observability and lab HSM components",{"_3464":203,"_30135":91,"_20936":49783,"_5":14366,"_27421":49481,"_2948":49784},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3464":204,"_30135":91,"_20936":49786,"_5":14366,"_27421":49481,"_2948":49787},[],"optionally loads sample data",{"_3464":205,"_30135":91,"_20936":49789,"_5":14366,"_27421":49481,"_2948":49790},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3464":206,"_30135":91,"_20936":49792,"_5":14366,"_27421":49485,"_2948":49793},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3464":207,"_30135":91,"_20936":49795,"_5":14366,"_27421":49485,"_2948":49796},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3464":208,"_30135":91,"_20936":49798,"_5":14366,"_27421":49489,"_2948":49799},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3464":209,"_30135":91,"_20936":49801,"_5":14366,"_27421":49489,"_2948":49802},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3464":210,"_30135":91,"_20936":49804,"_5":14366,"_27421":49489,"_2948":49805},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3464":211,"_30135":91,"_20936":49807,"_5":14366,"_27421":49493,"_2948":49808},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3464":212,"_30135":212,"_5":14718,"_2948":49810,"_30488":49811,"_20936":49812,"_27421":212},"Install with Helm",[49202,49203,49309],[],{"_3464":213,"_30135":212,"_20936":49814,"_5":14366,"_27421":212,"_2948":49815},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3464":214,"_30135":212,"_5":30485,"_20936":49817,"_27421":49818,"_2948":49819},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3464":215,"_30135":212,"_5":30485,"_20936":49821,"_27421":49822,"_2948":49212},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#before-you-begin",{"_3464":216,"_30135":212,"_5":30485,"_20936":49824,"_27421":49825,"_2948":49826},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3464":217,"_30135":212,"_5":30485,"_20936":49828,"_27421":49829,"_2948":49830},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3464":218,"_30135":212,"_5":30485,"_20936":49832,"_27421":49833,"_2948":49834},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3464":219,"_30135":212,"_5":30485,"_20936":49836,"_27421":49837,"_2948":49838},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3464":220,"_30135":212,"_5":30485,"_20936":49840,"_27421":49841,"_2948":49842},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3464":221,"_30135":212,"_5":30485,"_20936":49844,"_27421":49845,"_2948":49846},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3464":222,"_30135":212,"_5":30485,"_20936":49848,"_27421":49849,"_2948":49850},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3464":223,"_30135":212,"_5":30485,"_20936":49852,"_27421":49853,"_2948":49854},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3464":224,"_30135":212,"_5":30485,"_20936":49856,"_27421":49857,"_2948":49858},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3464":225,"_30135":212,"_20936":49860,"_5":14366,"_27421":49818,"_2948":49861},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3464":226,"_30135":212,"_20936":49863,"_5":14366,"_27421":49822,"_2948":49864},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3464":227,"_30135":212,"_20936":49866,"_5":14366,"_27421":49822,"_2948":49867},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3464":228,"_30135":212,"_20936":49869,"_5":14366,"_27421":49822,"_2948":49870},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3464":229,"_30135":212,"_20936":49872,"_5":14366,"_27421":49822,"_2948":49873},[],"a reachable RabbitMQ broker and credentials",{"_3464":230,"_30135":212,"_20936":49875,"_5":14366,"_27421":49822,"_2948":49876},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3464":231,"_30135":212,"_20936":49878,"_5":14366,"_27421":49822,"_2948":49879},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3464":232,"_30135":212,"_20936":49881,"_5":14366,"_27421":49822,"_2948":49882},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3464":233,"_30135":212,"_20936":49884,"_5":14366,"_27421":49822,"_2948":49885},[],"a StorageClass and an external traffic design",{"_3464":234,"_30135":212,"_20936":49887,"_5":14366,"_27421":49822,"_2948":49888},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3464":235,"_30135":212,"_20936":49890,"_5":14366,"_27421":49822,"_2948":49891},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3464":236,"_30135":212,"_20936":49893,"_5":14366,"_27421":49822,"_2948":49894},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3464":237,"_30135":212,"_20936":49896,"_5":14366,"_27421":49825,"_2948":49897},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3464":238,"_30135":212,"_20936":49899,"_5":14366,"_27421":49825,"_2948":49900},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3464":239,"_30135":212,"_20936":49902,"_5":14366,"_27421":49825,"_2948":49903},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3464":240,"_30135":212,"_20936":49905,"_5":14366,"_27421":49829,"_2948":49906},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3464":241,"_30135":212,"_20936":49908,"_5":14366,"_27421":49829,"_2948":49909},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3464":242,"_30135":212,"_20936":49911,"_5":14366,"_27421":49829,"_2948":49912},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3464":243,"_30135":212,"_20936":49914,"_5":14366,"_27421":49829,"_2948":49915},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3464":244,"_30135":212,"_20936":49917,"_5":14366,"_27421":49833,"_2948":49918},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3464":245,"_30135":212,"_20936":49920,"_5":14366,"_27421":49837,"_2948":49921},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3464":246,"_30135":212,"_20936":49923,"_5":14366,"_27421":49837,"_2948":49924},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3464":247,"_30135":212,"_20936":49926,"_5":14366,"_27421":49837,"_2948":49927},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3464":248,"_30135":212,"_20936":49929,"_5":14366,"_27421":49837,"_2948":49930},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3464":249,"_30135":212,"_20936":49932,"_5":14366,"_27421":49837,"_2948":49933},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3464":250,"_30135":212,"_20936":49935,"_5":14366,"_27421":49837,"_2948":49936},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3464":251,"_30135":212,"_20936":49938,"_5":14366,"_27421":49837,"_2948":49939},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3464":252,"_30135":212,"_20936":49941,"_5":14366,"_27421":49841,"_2948":49942},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3464":253,"_30135":212,"_20936":49944,"_5":14366,"_27421":49841,"_2948":49945},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3464":254,"_30135":212,"_20936":49947,"_5":14366,"_27421":49841,"_2948":49948},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3464":255,"_30135":212,"_20936":49950,"_5":14366,"_27421":49841,"_2948":49951},[],"See Access control for the principal and policy model.",{"_3464":256,"_30135":212,"_20936":49953,"_5":14366,"_27421":49845,"_2948":49954},[],"To install a local checkout instead:",{"_3464":257,"_30135":212,"_20936":49956,"_5":14366,"_27421":49849,"_2948":49957},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3464":258,"_30135":212,"_20936":49959,"_5":14366,"_27421":49849,"_2948":49960},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3464":259,"_30135":212,"_20936":49962,"_5":14366,"_27421":49853,"_2948":49963},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3464":260,"_30135":212,"_20936":49965,"_5":14366,"_27421":49853,"_2948":49966},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3464":261,"_30135":212,"_20936":49968,"_5":14366,"_27421":49853,"_2948":49969},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3464":262,"_30135":212,"_20936":49971,"_5":14366,"_27421":49853,"_2948":49972},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3464":263,"_30135":212,"_20936":49974,"_5":14366,"_27421":49853,"_2948":49975},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3464":264,"_30135":212,"_20936":49977,"_5":14366,"_27421":49857,"_2948":49978},[],"Before going live, review:",{"_3464":265,"_30135":212,"_20936":49980,"_5":14366,"_27421":49857,"_2948":49981},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3464":266,"_30135":212,"_20936":49983,"_5":14366,"_27421":49857,"_2948":49984},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3464":267,"_30135":212,"_20936":49986,"_5":14366,"_27421":49857,"_2948":49987},[],"shared VA storage before increasing VA replicas",{"_3464":268,"_30135":212,"_20936":49989,"_5":14366,"_27421":49857,"_2948":49990},[],"managed OIDC roles and removal of evaluation credentials",{"_3464":269,"_30135":212,"_20936":49992,"_5":14366,"_27421":49857,"_2948":49993},[],"a trusted TLS issuer or externally managed certificate",{"_3464":270,"_30135":212,"_20936":49995,"_5":14366,"_27421":49857,"_2948":49996},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3464":271,"_30135":212,"_20936":49998,"_5":14366,"_27421":49857,"_2948":49999},[],"SMTP, observability and alert delivery",{"_3464":272,"_30135":212,"_20936":50001,"_5":14366,"_27421":49857,"_2948":50002},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3464":273,"_30135":212,"_20936":50004,"_5":14366,"_27421":49857,"_2948":50005},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3464":274,"_30135":274,"_5":14718,"_2948":50007,"_30488":50008,"_20936":50009,"_27421":274},"Expose the Gateway",[49202,49203,49309],[],{"_3464":275,"_30135":274,"_20936":50011,"_5":14366,"_27421":274,"_2948":50012},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3464":276,"_30135":274,"_5":30485,"_20936":50014,"_27421":50015,"_2948":50016},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3464":277,"_30135":274,"_5":30485,"_20936":50018,"_27421":50019,"_2948":50020},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3464":278,"_30135":274,"_5":30485,"_20936":50022,"_27421":50023,"_2948":50024},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3464":279,"_30135":274,"_5":30485,"_20936":50026,"_27421":50027,"_2948":50028},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#k3s","K3s",{"_3464":280,"_30135":274,"_5":30485,"_20936":50030,"_27421":50031,"_2948":50032},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3464":281,"_30135":274,"_5":30485,"_20936":50034,"_27421":50035,"_2948":50036},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3464":282,"_30135":274,"_5":30485,"_20936":50038,"_27421":50039,"_2948":50040},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3464":283,"_30135":274,"_5":30485,"_20936":50042,"_27421":50043,"_2948":50044},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3464":284,"_30135":274,"_5":30485,"_20936":50046,"_27421":50047,"_2948":50048},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3464":285,"_30135":274,"_5":30485,"_20936":50050,"_27421":50051,"_2948":50052},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3464":286,"_30135":274,"_20936":50054,"_5":14366,"_27421":50015,"_2948":50055},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3464":287,"_30135":274,"_20936":50057,"_5":14366,"_27421":50015,"_2948":50058},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3464":288,"_30135":274,"_20936":50060,"_5":14366,"_27421":50019,"_2948":50061},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3464":289,"_30135":274,"_20936":50063,"_5":14366,"_27421":50019,"_2948":50064},[],"Set it only when:",{"_3464":290,"_30135":274,"_20936":50066,"_5":14366,"_27421":50019,"_2948":50067},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3464":291,"_30135":274,"_20936":50069,"_5":14366,"_27421":50019,"_2948":50070},[],"that address is allocated to this Gateway",{"_3464":292,"_30135":274,"_20936":50072,"_5":14366,"_27421":50019,"_2948":50073},[],"the surrounding network already routes traffic for it to the cluster",{"_3464":293,"_30135":274,"_20936":50075,"_5":14366,"_27421":50019,"_2948":50076},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3464":294,"_30135":274,"_20936":50078,"_5":14366,"_27421":50019,"_2948":50079},[],"Keep these two settings separate:",{"_3464":295,"_30135":274,"_20936":50081,"_5":14366,"_27421":50019,"_2948":50082},[],"`gateway.addresses` requests an address for the Gateway.",{"_3464":296,"_30135":274,"_20936":50084,"_5":14366,"_27421":50019,"_2948":50085},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3464":297,"_30135":274,"_20936":50087,"_5":14366,"_27421":50019,"_2948":50088},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3464":298,"_30135":274,"_20936":50090,"_5":14366,"_27421":50023,"_2948":50091},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3464":299,"_30135":274,"_20936":50093,"_5":14366,"_27421":50023,"_2948":50094},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3464":300,"_30135":274,"_20936":50096,"_5":14366,"_27421":50027,"_2948":50097},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3464":301,"_30135":274,"_20936":50099,"_5":14366,"_27421":50027,"_2948":50100},[],"For the recommended design:",{"_3464":302,"_30135":274,"_20936":50102,"_5":14366,"_27421":50027,"_2948":50103},[],"Use only one externally exposed Lamassu Gateway.",{"_3464":303,"_30135":274,"_20936":50105,"_5":14366,"_27421":50027,"_2948":50106},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3464":304,"_30135":274,"_20936":50108,"_5":14366,"_27421":50027,"_2948":50109},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3464":305,"_30135":274,"_20936":50111,"_5":14366,"_27421":50027,"_2948":50112},[],"Point DNS at the VM's reachable address.",{"_3464":306,"_30135":274,"_20936":50114,"_5":14366,"_27421":50027,"_2948":50115},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3464":307,"_30135":274,"_20936":50117,"_5":14366,"_27421":50031,"_2948":50118},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3464":308,"_30135":274,"_20936":50120,"_5":14366,"_27421":50035,"_2948":50121},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3464":309,"_30135":274,"_20936":50123,"_5":14366,"_27421":50035,"_2948":50124},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3464":310,"_30135":274,"_20936":50126,"_5":14366,"_27421":50039,"_2948":50127},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3464":311,"_30135":274,"_20936":50129,"_5":14366,"_27421":50039,"_2948":50130},[],"Requirement",{"_3464":312,"_30135":274,"_20936":50132,"_5":14366,"_27421":50039,"_2948":50133},[],"Recommended design",{"_3464":313,"_30135":274,"_20936":50135,"_5":14366,"_27421":50039,"_2948":50136},[],"Consequence",{"_3464":314,"_30135":274,"_20936":50138,"_5":14366,"_27421":50039,"_2948":50139},[],"Several Lamassu URLs or services",{"_3464":315,"_30135":274,"_20936":50141,"_5":14366,"_27421":50039,"_2948":50142},[],"One Gateway with multiple routes",{"_3464":316,"_30135":274,"_20936":50144,"_5":14366,"_27421":50039,"_2948":50145},[],"One IP and one proxy fleet; this is the chart default",{"_3464":317,"_30135":274,"_20936":50147,"_5":14366,"_27421":50039,"_2948":50148},[],"Independent Gateways and separate external IPs",{"_3464":318,"_30135":274,"_20936":50150,"_5":14366,"_27421":50039,"_2948":50151},[],"One VIP per Gateway",{"_3464":319,"_30135":274,"_20936":50153,"_5":14366,"_27421":50039,"_2948":50154},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3464":320,"_30135":274,"_20936":50156,"_5":14366,"_27421":50039,"_2948":50157},[],"Independent Gateways on one node and one IP",{"_3464":321,"_30135":274,"_20936":50159,"_5":14366,"_27421":50039,"_2948":50160},[],"Use different external ports",{"_3464":322,"_30135":274,"_20936":50162,"_5":14366,"_27421":50039,"_2948":50163},[],"Clients must include non-standard ports",{"_3464":323,"_30135":274,"_20936":50165,"_5":14366,"_27421":50039,"_2948":50166},[],"Separate TLS/mTLS termination behind one IP",{"_3464":324,"_30135":274,"_20936":50168,"_5":14366,"_27421":50039,"_2948":50169},[],"Front-door SNI routing to internal Gateways",{"_3464":325,"_30135":274,"_20936":50171,"_5":14366,"_27421":50039,"_2948":50172},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3464":326,"_30135":274,"_20936":50174,"_5":14366,"_27421":50039,"_2948":50175},[],"Separate Gateway resources but shared proxy infrastructure",{"_3464":327,"_30135":274,"_20936":50177,"_5":14366,"_27421":50039,"_2948":50178},[],"Envoy merged-Gateway mode",{"_3464":328,"_30135":274,"_20936":50180,"_5":14366,"_27421":50039,"_2948":50181},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3464":329,"_30135":274,"_20936":50183,"_5":14366,"_27421":50039,"_2948":50184},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3464":330,"_30135":274,"_20936":50186,"_5":14366,"_27421":50039,"_2948":50187},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3464":331,"_30135":274,"_20936":50189,"_5":14366,"_27421":50039,"_2948":50190},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3464":332,"_30135":274,"_20936":50192,"_5":14366,"_27421":50039,"_2948":50193},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3464":333,"_30135":274,"_20936":50195,"_5":14366,"_27421":50043,"_2948":50196},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3464":334,"_30135":274,"_20936":50198,"_5":14366,"_27421":50043,"_2948":50199},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3464":335,"_30135":274,"_20936":50201,"_5":14366,"_27421":50043,"_2948":50202},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3464":336,"_30135":274,"_20936":50204,"_5":14366,"_27421":50043,"_2948":50205},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3464":337,"_30135":274,"_20936":50207,"_5":14366,"_27421":50043,"_2948":50208},[],"If none of those are possible, use different external ports or change the external network design.",{"_3464":338,"_30135":274,"_20936":50210,"_5":14366,"_27421":50047,"_2948":50211},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3464":339,"_30135":274,"_20936":50213,"_5":14366,"_27421":50047,"_2948":50214},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3464":340,"_30135":274,"_20936":50216,"_5":14366,"_27421":50051,"_2948":50217},[],"Check, in order:",{"_3464":341,"_30135":274,"_20936":50219,"_5":14366,"_27421":50051,"_2948":50220},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3464":342,"_30135":274,"_20936":50222,"_5":14366,"_27421":50051,"_2948":50223},[],"Its status contains the expected address.",{"_3464":343,"_30135":274,"_20936":50225,"_5":14366,"_27421":50051,"_2948":50226},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3464":344,"_30135":274,"_20936":50228,"_5":14366,"_27421":50051,"_2948":50229},[],"Port 443 reaches that address from the client network.",{"_3464":345,"_30135":274,"_20936":50231,"_5":14366,"_27421":50051,"_2948":50232},[],"DNS resolves to the externally reachable endpoint.",{"_3464":346,"_30135":274,"_20936":50234,"_5":14366,"_27421":50051,"_2948":50235},[],"The certificate contains the DNS name or IP used by the client.",{"_3464":347,"_30135":274,"_20936":50237,"_5":14366,"_27421":50051,"_2948":50238},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3464":348,"_30135":348,"_5":14718,"_2948":49309,"_30488":50240,"_20936":50241,"_27421":348},[49202,49203,49309],[],{"_3464":349,"_30135":348,"_20936":50243,"_5":14366,"_27421":348,"_2948":50244},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3464":350,"_30135":348,"_5":30485,"_20936":50246,"_27421":50247,"_2948":50248},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3464":351,"_30135":348,"_5":30485,"_20936":50250,"_27421":50251,"_2948":50252},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3464":352,"_30135":348,"_5":30485,"_20936":50254,"_27421":50255,"_2948":50256},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3464":353,"_30135":348,"_5":30485,"_20936":50258,"_27421":50259,"_2948":50260},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3464":354,"_30135":348,"_5":30485,"_20936":50262,"_27421":50263,"_2948":50264},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3464":355,"_30135":348,"_5":30485,"_20936":50266,"_27421":50267,"_2948":50268},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3464":356,"_30135":348,"_20936":50270,"_5":14366,"_27421":50247,"_2948":50271},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3464":357,"_30135":348,"_20936":50273,"_5":14366,"_27421":50251,"_2948":50274},[],"Workflow",{"_3464":358,"_30135":348,"_20936":50276,"_5":14366,"_27421":50251,"_2948":50277},[],"Use it for",{"_3464":359,"_30135":348,"_20936":50279,"_5":14366,"_27421":50251,"_2948":50280},[],"What it installs",{"_3464":360,"_30135":348,"_20936":50282,"_5":14366,"_27421":50251,"_2948":50283},[],"Helm",{"_3464":361,"_30135":348,"_20936":50285,"_5":14366,"_27421":50251,"_2948":50286},[],"Production and controlled environments",{"_3464":362,"_30135":348,"_20936":50288,"_5":14366,"_27421":50251,"_2948":50289},[],"Lamassu services and Gateway API resources",{"_3464":363,"_30135":348,"_20936":50291,"_5":14366,"_27421":50251,"_2948":49446},[],{"_3464":364,"_30135":348,"_20936":50293,"_5":14366,"_27421":50251,"_2948":50294},[],"Evaluation, demos, CI and small lab clusters",{"_3464":365,"_30135":348,"_20936":50296,"_5":14366,"_27421":50251,"_2948":50297},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3464":366,"_30135":348,"_20936":50299,"_5":14366,"_27421":50255,"_2948":50300},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3464":367,"_30135":348,"_20936":50302,"_5":14366,"_27421":50255,"_2948":50303},[],"Area",{"_3464":368,"_30135":348,"_20936":50305,"_5":14366,"_27421":50255,"_2948":50306},[],"The Lamassu chart provides",{"_3464":369,"_30135":348,"_20936":50308,"_5":14366,"_27421":50255,"_2948":50309},[],"You provide",{"_3464":370,"_30135":348,"_20936":50311,"_5":14366,"_27421":50255,"_2948":50312},[],"Lamassu applications",{"_3464":371,"_30135":348,"_20936":50314,"_5":14366,"_27421":50255,"_2948":50315},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3464":372,"_30135":348,"_20936":50317,"_5":14366,"_27421":50255,"_2948":50318},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3464":373,"_30135":348,"_20936":50320,"_5":14366,"_27421":50255,"_2948":50321},[],"PostgreSQL data",{"_3464":374,"_30135":348,"_20936":50323,"_5":14366,"_27421":50255,"_2948":50324},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3464":375,"_30135":348,"_20936":50326,"_5":14366,"_27421":50255,"_2948":50327},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3464":376,"_30135":348,"_20936":50329,"_5":14366,"_27421":50255,"_2948":50330},[],"Messaging",{"_3464":377,"_30135":348,"_20936":50332,"_5":14366,"_27421":50255,"_2948":50333},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3464":378,"_30135":348,"_20936":50335,"_5":14366,"_27421":50255,"_2948":50336},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3464":379,"_30135":348,"_20936":50338,"_5":14366,"_27421":50255,"_2948":50339},[],"Identity",{"_3464":380,"_30135":348,"_20936":50341,"_5":14366,"_27421":50255,"_2948":50342},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3464":381,"_30135":348,"_20936":50344,"_5":14366,"_27421":50255,"_2948":50345},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3464":382,"_30135":348,"_20936":50347,"_5":14366,"_27421":50255,"_2948":50348},[],"External routing",{"_3464":383,"_30135":348,"_20936":50350,"_5":14366,"_27421":50255,"_2948":50351},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3464":384,"_30135":348,"_20936":50353,"_5":14366,"_27421":50255,"_2948":50354},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3464":385,"_30135":348,"_20936":50356,"_5":14366,"_27421":50255,"_2948":50357},[],"TLS",{"_3464":386,"_30135":348,"_20936":50359,"_5":14366,"_27421":50255,"_2948":50360},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3464":387,"_30135":348,"_20936":50362,"_5":14366,"_27421":50255,"_2948":50363},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3464":388,"_30135":348,"_20936":50365,"_5":14366,"_27421":50255,"_2948":50366},[],"Persistent application data",{"_3464":389,"_30135":348,"_20936":50368,"_5":14366,"_27421":50255,"_2948":50369},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3464":390,"_30135":348,"_20936":50371,"_5":14366,"_27421":50255,"_2948":50372},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3464":391,"_30135":348,"_20936":50374,"_5":14366,"_27421":50255,"_2948":50375},[],"Optional integrations",{"_3464":392,"_30135":348,"_20936":50377,"_5":14366,"_27421":50255,"_2948":50378},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3464":393,"_30135":348,"_20936":50380,"_5":14366,"_27421":50255,"_2948":50381},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3464":394,"_30135":348,"_20936":50383,"_5":14366,"_27421":50255,"_2948":50384},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3464":395,"_30135":348,"_20936":50386,"_5":14366,"_27421":50255,"_2948":50387},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3464":396,"_30135":348,"_20936":50389,"_5":14366,"_27421":50259,"_2948":50390},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3464":397,"_30135":348,"_20936":50392,"_5":14366,"_27421":50259,"_2948":50393},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3464":398,"_30135":348,"_20936":50395,"_5":14366,"_27421":50263,"_2948":50396},[],"Kubernetes 1.24 or newer",{"_3464":399,"_30135":348,"_20936":50398,"_5":14366,"_27421":50263,"_2948":50399},[],"Helm 3.2 or newer",{"_3464":400,"_30135":348,"_20936":50401,"_5":14366,"_27421":50263,"_2948":50402},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3464":401,"_30135":348,"_20936":50404,"_5":14366,"_27421":50263,"_2948":50405},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3464":402,"_30135":348,"_20936":50407,"_5":14366,"_27421":50263,"_2948":50408},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3464":403,"_30135":348,"_20936":50410,"_5":14366,"_27421":50263,"_2948":50411},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3464":404,"_30135":348,"_20936":50413,"_5":14366,"_27421":50263,"_2948":50414},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3464":405,"_30135":348,"_20936":50416,"_5":14366,"_27421":50267,"_2948":50417},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3464":406,"_30135":348,"_20936":50419,"_5":14366,"_27421":50267,"_2948":50420},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3464":407,"_30135":348,"_20936":50422,"_5":14366,"_27421":50267,"_2948":50423},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3464":408,"_30135":348,"_20936":50425,"_5":14366,"_27421":50267,"_2948":50426},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3464":409,"_30135":409,"_5":14718,"_2948":50428,"_30488":50429,"_20936":50431,"_27421":409},"Deployment troubleshooting",[49202,49203,50430],"Operations",[],{"_3464":410,"_30135":409,"_20936":50433,"_5":14366,"_27421":409,"_2948":50434},[],"Diagnose access, service health and infrastructure dependencies.",{"_3464":411,"_30135":409,"_5":30485,"_20936":50436,"_27421":50437,"_2948":50438},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3464":412,"_30135":409,"_5":30485,"_20936":50440,"_27421":50441,"_2948":50442},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3464":413,"_30135":409,"_5":30485,"_20936":50444,"_27421":50445,"_2948":50446},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3464":414,"_30135":409,"_5":30485,"_20936":50448,"_27421":50449,"_2948":50450},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3464":415,"_30135":409,"_5":30485,"_20936":50452,"_27421":50453,"_2948":50454},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3464":416,"_30135":409,"_5":30485,"_20936":50456,"_27421":50457,"_2948":50458},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3464":417,"_30135":409,"_5":30485,"_20936":50460,"_27421":50461,"_2948":50462},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3464":418,"_30135":409,"_5":30485,"_20936":50464,"_27421":50465,"_2948":50466},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3464":419,"_30135":409,"_5":30485,"_20936":50468,"_27421":50469,"_2948":50470},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3464":420,"_30135":409,"_5":30485,"_20936":50472,"_27421":50473,"_2948":50474},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3464":421,"_30135":409,"_5":30485,"_20936":50476,"_27421":50477,"_2948":50478},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3464":422,"_30135":409,"_5":30485,"_20936":50480,"_27421":50481,"_2948":50482},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3464":423,"_30135":409,"_5":30485,"_20936":50484,"_27421":50485,"_2948":50486},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#observability","Observability",{"_3464":424,"_30135":409,"_20936":50488,"_5":14366,"_27421":409,"_2948":50489},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3464":425,"_30135":409,"_20936":50491,"_5":14366,"_27421":50441,"_2948":50492},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3464":426,"_30135":409,"_20936":50494,"_5":14366,"_27421":50445,"_2948":50495},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3464":427,"_30135":409,"_20936":50497,"_5":14366,"_27421":50449,"_2948":50498},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3464":428,"_30135":409,"_20936":50500,"_5":14366,"_27421":50453,"_2948":50501},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3464":429,"_30135":409,"_20936":50503,"_5":14366,"_27421":50457,"_2948":50504},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3464":430,"_30135":409,"_20936":50506,"_5":14366,"_27421":50461,"_2948":50507},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3464":431,"_30135":409,"_20936":50509,"_5":14366,"_27421":50461,"_2948":50510},[],"Also run the chart's connectivity test:",{"_3464":432,"_30135":409,"_20936":50512,"_5":14366,"_27421":50461,"_2948":50513},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3464":433,"_30135":409,"_20936":50515,"_5":14366,"_27421":50461,"_2948":50516},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3464":434,"_30135":409,"_20936":50518,"_5":14366,"_27421":50465,"_2948":50519},[],"If you receive a 401:",{"_3464":435,"_30135":409,"_20936":50521,"_5":14366,"_27421":50465,"_2948":50522},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3464":436,"_30135":409,"_20936":50524,"_5":14366,"_27421":50465,"_2948":50525},[],"verify issuer, audience and expiration of the token;",{"_3464":437,"_30135":409,"_20936":50527,"_5":14366,"_27421":50465,"_2948":50528},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3464":438,"_30135":409,"_20936":50530,"_5":14366,"_27421":50465,"_2948":50531},[],"check that the provider's public and internal routes point to the same realm.",{"_3464":439,"_30135":409,"_20936":50533,"_5":14366,"_27421":50465,"_2948":50534},[],"If login succeeds but the APIs return 403:",{"_3464":440,"_30135":409,"_20936":50536,"_5":14366,"_27421":50465,"_2948":50537},[],"inspect the token's real claims;",{"_3464":441,"_30135":409,"_20936":50539,"_5":14366,"_27421":50465,"_2948":50540},[],"confirm they match an active principal;",{"_3464":442,"_30135":409,"_20936":50542,"_5":14366,"_27421":50465,"_2948":50543},[],"review the policies granted to that principal;",{"_3464":443,"_30135":409,"_20936":50545,"_5":14366,"_27421":50465,"_2948":50546},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3464":444,"_30135":409,"_20936":50548,"_5":14366,"_27421":50465,"_2948":50549},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3464":445,"_30135":409,"_20936":50551,"_5":14366,"_27421":50469,"_2948":50552},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3464":446,"_30135":409,"_20936":50554,"_5":14366,"_27421":50469,"_2948":50555},[],"Locate the authz pod and Service.",{"_3464":447,"_30135":409,"_20936":50557,"_5":14366,"_27421":50469,"_2948":50558},[],"Check /health, logs and its database connection.",{"_3464":448,"_30135":409,"_20936":50560,"_5":14366,"_27421":50469,"_2948":50561},[],"Verify the DNS and port configured in externalAuthorization.",{"_3464":449,"_30135":409,"_20936":50563,"_5":14366,"_27421":50469,"_2948":50564},[],"Check the check route is /v1/ext\\_authz/check.",{"_3464":450,"_30135":409,"_20936":50566,"_5":14366,"_27421":50469,"_2948":50567},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3464":451,"_30135":409,"_20936":50569,"_5":14366,"_27421":50473,"_2948":50570},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3464":452,"_30135":409,"_20936":50572,"_5":14366,"_27421":50477,"_2948":50573},[],"Review kubectl describe pod first. Common causes are:",{"_3464":453,"_30135":409,"_20936":50575,"_5":14366,"_27421":50477,"_2948":50576},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3464":454,"_30135":409,"_20936":50578,"_5":14366,"_27421":50477,"_2948":50579},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3464":455,"_30135":409,"_20936":50581,"_5":14366,"_27421":50477,"_2948":50582},[],"unbound persistent volume;",{"_3464":456,"_30135":409,"_20936":50584,"_5":14366,"_27421":50477,"_2948":50585},[],"inaccessible image or incorrect pull policy;",{"_3464":457,"_30135":409,"_20936":50587,"_5":14366,"_27421":50477,"_2948":50588},[],"invalid cryptographic engine configuration;",{"_3464":458,"_30135":409,"_20936":50590,"_5":14366,"_27421":50477,"_2948":50591},[],"CPU or memory limits set too low;",{"_3464":459,"_30135":409,"_20936":50593,"_5":14366,"_27421":50477,"_2948":50594},[],"an incomplete prior migration.",{"_3464":460,"_30135":409,"_20936":50596,"_5":14366,"_27421":50477,"_2948":50597},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3464":461,"_30135":409,"_20936":50599,"_5":14366,"_27421":50477,"_2948":50600},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3464":462,"_30135":409,"_20936":50602,"_5":14366,"_27421":50477,"_2948":50603},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3464":463,"_30135":409,"_20936":50605,"_5":14366,"_27421":50481,"_2948":50606},[],"Domain and audit events depend on the bus publisher:",{"_3464":464,"_30135":409,"_20936":50608,"_5":14366,"_27421":50481,"_2948":50609},[],"verify it is enabled in the emitting service;",{"_3464":465,"_30135":409,"_20936":50611,"_5":14366,"_27421":50481,"_2948":50612},[],"check AMQP connectivity and credentials;",{"_3464":466,"_30135":409,"_20936":50614,"_5":14366,"_27421":50481,"_2948":50615},[],"review exchange, routing key, queues and consumers;",{"_3464":467,"_30135":409,"_20936":50617,"_5":14366,"_27421":50481,"_2948":50618},[],"inspect dead-letter queues;",{"_3464":468,"_30135":409,"_20936":50620,"_5":14366,"_27421":50481,"_2948":50621},[],"alert on orphan durable queues and backlog growth.",{"_3464":469,"_30135":409,"_20936":50623,"_5":14366,"_27421":50481,"_2948":50624},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3464":470,"_30135":409,"_20936":50626,"_5":14366,"_27421":50481,"_2948":50627},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3464":471,"_30135":409,"_20936":50629,"_5":14366,"_27421":50481,"_2948":50630},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3464":472,"_30135":409,"_20936":50632,"_5":14366,"_27421":50481,"_2948":50633},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3464":473,"_30135":409,"_20936":50635,"_5":14366,"_27421":50481,"_2948":50636},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3464":474,"_30135":409,"_20936":50638,"_5":14366,"_27421":50481,"_2948":50639},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3464":475,"_30135":409,"_20936":50641,"_5":14366,"_27421":50481,"_2948":50642},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3464":476,"_30135":409,"_20936":50644,"_5":14366,"_27421":50485,"_2948":50645},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3464":477,"_30135":409,"_20936":50647,"_5":14366,"_27421":50485,"_2948":50648},[],"Before closing an incident, record:",{"_3464":478,"_30135":409,"_20936":50650,"_5":14366,"_27421":50485,"_2948":50651},[],"the confirmed cause;",{"_3464":479,"_30135":409,"_20936":50653,"_5":14366,"_27421":50485,"_2948":50654},[],"the time scope and affected resources;",{"_3464":480,"_30135":409,"_20936":50656,"_5":14366,"_27421":50485,"_2948":50657},[],"the commands or queries used;",{"_3464":481,"_30135":409,"_20936":50659,"_5":14366,"_27421":50485,"_2948":50660},[],"the applied change and how to revert it;",{"_3464":482,"_30135":409,"_20936":50662,"_5":14366,"_27421":50485,"_2948":50663},[],"validation from a consumer;",{"_3464":483,"_30135":409,"_20936":50665,"_5":14366,"_27421":50485,"_2948":50666},[],"the preventive action and its owner.",{"_3464":484,"_30135":484,"_5":14718,"_2948":50668,"_30488":50669,"_20936":50672,"_27421":484},"Access control",[49202,50670,50671],"Platform","Administration",[],{"_3464":485,"_30135":484,"_20936":50674,"_5":14366,"_27421":484,"_2948":50675},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3464":486,"_30135":484,"_5":30485,"_20936":50677,"_27421":50678,"_2948":50679},[],"/docs/pr-preview/pr-61/platform/administration/access-control#essential-concepts","Essential concepts",{"_3464":487,"_30135":484,"_5":30485,"_20936":50681,"_27421":50682,"_2948":50683},[],"/docs/pr-preview/pr-61/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3464":488,"_30135":484,"_5":30485,"_20936":50685,"_27421":50686,"_2948":50687},[],"/docs/pr-preview/pr-61/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3464":489,"_30135":484,"_5":30485,"_20936":50689,"_27421":50690,"_2948":50691},[],"/docs/pr-preview/pr-61/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3464":490,"_30135":484,"_5":30485,"_20936":50693,"_27421":50694,"_2948":50695},[],"/docs/pr-preview/pr-61/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3464":491,"_30135":484,"_5":30485,"_20936":50697,"_27421":50698,"_2948":50699},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3464":492,"_30135":484,"_5":30485,"_20936":50701,"_27421":50702,"_2948":50703},[],"/docs/pr-preview/pr-61/platform/administration/access-control#oidc-principals","OIDC principals",{"_3464":493,"_30135":484,"_5":30485,"_20936":50705,"_27421":50706,"_2948":50707},[],"/docs/pr-preview/pr-61/platform/administration/access-control#x509-principals","X.509 principals",{"_3464":494,"_30135":484,"_5":30485,"_20936":50709,"_27421":50710,"_2948":50711},[],"/docs/pr-preview/pr-61/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3464":495,"_30135":484,"_5":30485,"_20936":50713,"_27421":50714,"_2948":50715},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3464":496,"_30135":484,"_5":30485,"_20936":50717,"_27421":50718,"_2948":50719},[],"/docs/pr-preview/pr-61/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3464":497,"_30135":484,"_5":30485,"_20936":50721,"_27421":50722,"_2948":50723},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3464":498,"_30135":484,"_5":30485,"_20936":50725,"_27421":50726,"_2948":50727},[],"/docs/pr-preview/pr-61/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3464":499,"_30135":484,"_5":30485,"_20936":50729,"_27421":50730,"_2948":50731},[],"/docs/pr-preview/pr-61/platform/administration/access-control#http-rules","HTTP rules",{"_3464":500,"_30135":484,"_5":30485,"_20936":50733,"_27421":50734,"_2948":50735},[],"/docs/pr-preview/pr-61/platform/administration/access-control#included-policies","Included policies",{"_3464":501,"_30135":484,"_5":30485,"_20936":50737,"_27421":50738,"_2948":49842},[],"/docs/pr-preview/pr-61/platform/administration/access-control#provision-the-first-administrator",{"_3464":502,"_30135":484,"_5":30485,"_20936":50740,"_27421":50741,"_2948":50742},[],"/docs/pr-preview/pr-61/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3464":503,"_30135":484,"_5":30485,"_20936":50744,"_27421":50745,"_2948":50746},[],"/docs/pr-preview/pr-61/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3464":504,"_30135":484,"_5":30485,"_20936":50748,"_27421":50749,"_2948":50750},[],"/docs/pr-preview/pr-61/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3464":505,"_30135":484,"_5":30485,"_20936":50752,"_27421":50753,"_2948":50754},[],"/docs/pr-preview/pr-61/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3464":506,"_30135":484,"_5":30485,"_20936":50756,"_27421":50757,"_2948":50758},[],"/docs/pr-preview/pr-61/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3464":507,"_30135":484,"_5":30485,"_20936":50760,"_27421":50761,"_2948":50762},[],"/docs/pr-preview/pr-61/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3464":508,"_30135":484,"_5":30485,"_20936":50764,"_27421":50765,"_2948":50766},[],"/docs/pr-preview/pr-61/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3464":509,"_30135":484,"_5":30485,"_20936":50768,"_27421":50769,"_2948":50770},[],"/docs/pr-preview/pr-61/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3464":510,"_30135":484,"_5":30485,"_20936":50772,"_27421":50773,"_2948":50774},[],"/docs/pr-preview/pr-61/platform/administration/access-control#operational-checklist","Operational checklist",{"_3464":511,"_30135":484,"_5":30485,"_20936":50776,"_27421":50777,"_2948":50778},[],"/docs/pr-preview/pr-61/platform/administration/access-control#diagnostics","Diagnostics",{"_3464":512,"_30135":484,"_5":30485,"_20936":50780,"_27421":50781,"_2948":50782},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-401","The response is 401",{"_3464":513,"_30135":484,"_5":30485,"_20936":50784,"_27421":50785,"_2948":50786},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-403","The response is 403",{"_3464":514,"_30135":484,"_5":30485,"_20936":50788,"_27421":50789,"_2948":50790},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3464":515,"_30135":484,"_5":30485,"_20936":50792,"_27421":50793,"_2948":50794},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3464":516,"_30135":484,"_5":30485,"_20936":50796,"_27421":50797,"_2948":50798},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3464":517,"_30135":484,"_20936":50800,"_5":14366,"_27421":484,"_2948":50801},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3464":518,"_30135":484,"_20936":50803,"_5":14366,"_27421":484,"_2948":50804},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3464":519,"_30135":484,"_20936":50806,"_5":14366,"_27421":484,"_2948":50807},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3464":520,"_30135":484,"_20936":50809,"_5":14366,"_27421":50678,"_2948":50810},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3464":521,"_30135":484,"_20936":50812,"_5":14366,"_27421":50678,"_2948":50813},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3464":522,"_30135":484,"_20936":50815,"_5":14366,"_27421":50678,"_2948":50816},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3464":523,"_30135":484,"_20936":50818,"_5":14366,"_27421":50678,"_2948":50819},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3464":524,"_30135":484,"_20936":50821,"_5":14366,"_27421":50678,"_2948":50822},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3464":525,"_30135":484,"_20936":50824,"_5":14366,"_27421":50678,"_2948":50825},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3464":526,"_30135":484,"_20936":50827,"_5":14366,"_27421":50682,"_2948":50828},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3464":527,"_30135":484,"_20936":50830,"_5":14366,"_27421":50682,"_2948":50831},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3464":528,"_30135":484,"_20936":50833,"_5":14366,"_27421":50686,"_2948":50834},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3464":529,"_30135":484,"_20936":50836,"_5":14366,"_27421":50686,"_2948":50837},[],"The decision is made **before forwarding the request to the service**:",{"_3464":530,"_30135":484,"_20936":50839,"_5":14366,"_27421":50686,"_2948":50840},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3464":531,"_30135":484,"_20936":50842,"_5":14366,"_27421":50686,"_2948":50843},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3464":532,"_30135":484,"_20936":50845,"_5":14366,"_27421":50686,"_2948":50846},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3464":533,"_30135":484,"_20936":50848,"_5":14366,"_27421":50686,"_2948":50849},[],"It separately loads the policies granted to each principal.",{"_3464":534,"_30135":484,"_20936":50851,"_5":14366,"_27421":50686,"_2948":50852},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3464":535,"_30135":484,"_20936":50854,"_5":14366,"_27421":50686,"_2948":50855},[],"`authz` looks for an HTTP rule granting that action.",{"_3464":536,"_30135":484,"_20936":50857,"_5":14366,"_27421":50686,"_2948":50858},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3464":537,"_30135":484,"_20936":50860,"_5":14366,"_27421":50686,"_2948":50861},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3464":538,"_30135":484,"_20936":50863,"_5":14366,"_27421":50686,"_2948":50864},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3464":539,"_30135":484,"_20936":50866,"_5":14366,"_27421":50686,"_2948":50867},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3464":540,"_30135":484,"_20936":50869,"_5":14366,"_27421":50690,"_2948":50870},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3464":541,"_30135":484,"_20936":50872,"_5":14366,"_27421":50690,"_2948":50873},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3464":542,"_30135":484,"_20936":50875,"_5":14366,"_27421":50690,"_2948":50876},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3464":543,"_30135":484,"_20936":50878,"_5":14366,"_27421":50690,"_2948":50879},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3464":544,"_30135":484,"_20936":50881,"_5":14366,"_27421":50690,"_2948":50882},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3464":545,"_30135":484,"_20936":50884,"_5":14366,"_27421":50690,"_2948":50885},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3464":546,"_30135":484,"_20936":50887,"_5":14366,"_27421":50690,"_2948":50888},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3464":547,"_30135":484,"_20936":50890,"_5":14366,"_27421":50690,"_2948":50891},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3464":548,"_30135":484,"_20936":50893,"_5":14366,"_27421":50694,"_2948":50894},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3464":549,"_30135":484,"_20936":50896,"_5":14366,"_27421":50694,"_2948":50897},[],"The decision is made with the domain operation context:",{"_3464":550,"_30135":484,"_20936":50899,"_5":14366,"_27421":50694,"_2948":50900},[],"The middleware extracts the credential and resolves the matching principals.",{"_3464":551,"_30135":484,"_20936":50902,"_5":14366,"_27421":50694,"_2948":50903},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3464":552,"_30135":484,"_20936":50905,"_5":14366,"_27421":50694,"_2948":50906},[],"`authz` gathers the entity rules of the granted policies.",{"_3464":553,"_30135":484,"_20936":50908,"_5":14366,"_27421":50694,"_2948":50909},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3464":554,"_30135":484,"_20936":50911,"_5":14366,"_27421":50694,"_2948":50912},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3464":555,"_30135":484,"_20936":50914,"_5":14366,"_27421":50694,"_2948":50915},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3464":556,"_30135":484,"_20936":50917,"_5":14366,"_27421":50694,"_2948":50918},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3464":557,"_30135":484,"_20936":50920,"_5":14366,"_27421":50694,"_2948":50921},[],"Actions fall into two groups:",{"_3464":558,"_30135":484,"_20936":50923,"_5":14366,"_27421":50694,"_2948":50924},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3464":559,"_30135":484,"_20936":50926,"_5":14366,"_27421":50694,"_2948":50927},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3464":560,"_30135":484,"_20936":50929,"_5":14366,"_27421":50694,"_2948":50930},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3464":561,"_30135":484,"_20936":50932,"_5":14366,"_27421":50698,"_2948":50933},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3464":562,"_30135":484,"_20936":50935,"_5":14366,"_27421":50698,"_2948":50936},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3464":563,"_30135":484,"_20936":50938,"_5":14366,"_27421":50698,"_2948":50939},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3464":564,"_30135":484,"_20936":50941,"_5":14366,"_27421":50702,"_2948":50942},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3464":565,"_30135":484,"_20936":50944,"_5":14366,"_27421":50702,"_2948":50945},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3464":566,"_30135":484,"_20936":50947,"_5":14366,"_27421":50702,"_2948":50948},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3464":567,"_30135":484,"_20936":50950,"_5":14366,"_27421":50702,"_2948":50951},[],"The implemented operators are:",{"_3464":568,"_30135":484,"_20936":50953,"_5":14366,"_27421":50702,"_2948":50954},[],"`equals`, for exact equality;",{"_3464":569,"_30135":484,"_20936":50956,"_5":14366,"_27421":50702,"_2948":50957},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3464":570,"_30135":484,"_20936":50959,"_5":14366,"_27421":50702,"_2948":50960},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3464":571,"_30135":484,"_20936":50962,"_5":14366,"_27421":50702,"_2948":50963},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3464":572,"_30135":484,"_20936":50965,"_5":14366,"_27421":50706,"_2948":50966},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3464":573,"_30135":484,"_20936":50968,"_5":14366,"_27421":50706,"_2948":50969},[],"The available modes are:",{"_3464":574,"_30135":484,"_20936":50971,"_5":14366,"_27421":50706,"_2948":50972},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3464":575,"_30135":484,"_20936":50974,"_5":14366,"_27421":50706,"_2948":50975},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3464":576,"_30135":484,"_20936":50977,"_5":14366,"_27421":50706,"_2948":50978},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3464":577,"_30135":484,"_20936":50980,"_5":14366,"_27421":50706,"_2948":50981},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3464":578,"_30135":484,"_20936":50983,"_5":14366,"_27421":50706,"_2948":50984},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3464":579,"_30135":484,"_20936":50986,"_5":14366,"_27421":50706,"_2948":50987},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3464":580,"_30135":484,"_20936":50989,"_5":14366,"_27421":50710,"_2948":50990},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3464":581,"_30135":484,"_20936":50992,"_5":14366,"_27421":50710,"_2948":50993},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3464":582,"_30135":484,"_20936":50995,"_5":14366,"_27421":50710,"_2948":50996},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3464":583,"_30135":484,"_20936":50998,"_5":14366,"_27421":50710,"_2948":50999},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3464":584,"_30135":484,"_20936":51001,"_5":14366,"_27421":50718,"_2948":51002},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3464":585,"_30135":484,"_20936":51004,"_5":14366,"_27421":50718,"_2948":51005},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3464":586,"_30135":484,"_20936":51007,"_5":14366,"_27421":50722,"_2948":51008},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3464":587,"_30135":484,"_20936":51010,"_5":14366,"_27421":50722,"_2948":51011},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3464":588,"_30135":484,"_20936":51013,"_5":14366,"_27421":50726,"_2948":51014},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3464":589,"_30135":484,"_20936":51016,"_5":14366,"_27421":50726,"_2948":51017},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3464":590,"_30135":484,"_20936":51019,"_5":14366,"_27421":50726,"_2948":51020},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3464":591,"_30135":484,"_20936":51022,"_5":14366,"_27421":50730,"_2948":51023},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3464":592,"_30135":484,"_20936":51025,"_5":14366,"_27421":50730,"_2948":51026},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3464":593,"_30135":484,"_20936":51028,"_5":14366,"_27421":50730,"_2948":51029},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3464":594,"_30135":484,"_20936":51031,"_5":14366,"_27421":50730,"_2948":51032},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3464":595,"_30135":484,"_20936":51034,"_5":14366,"_27421":50730,"_2948":51035},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3464":596,"_30135":484,"_20936":51037,"_5":14366,"_27421":50730,"_2948":51038},[],"Note that:",{"_3464":597,"_30135":484,"_20936":51040,"_5":14366,"_27421":50730,"_2948":51041},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3464":598,"_30135":484,"_20936":51043,"_5":14366,"_27421":50730,"_2948":51044},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3464":599,"_30135":484,"_20936":51046,"_5":14366,"_27421":50730,"_2948":51047},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3464":600,"_30135":484,"_20936":51049,"_5":14366,"_27421":50734,"_2948":51050},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3464":601,"_30135":484,"_20936":51052,"_5":14366,"_27421":50734,"_2948":51053},[],"full and read-only access to certificates and authorities;",{"_3464":602,"_30135":484,"_20936":51055,"_5":14366,"_27421":50734,"_2948":51056},[],"full and read-only access to the KMS;",{"_3464":603,"_30135":484,"_20936":51058,"_5":14366,"_27421":50734,"_2948":51059},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3464":604,"_30135":484,"_20936":51061,"_5":14366,"_27421":50734,"_2948":51062},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3464":605,"_30135":484,"_20936":51064,"_5":14366,"_27421":50734,"_2948":51065},[],"console access;",{"_3464":606,"_30135":484,"_20936":51067,"_5":14366,"_27421":50734,"_2948":51068},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3464":607,"_30135":484,"_20936":51070,"_5":14366,"_27421":50734,"_2948":51071},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3464":608,"_30135":484,"_20936":51073,"_5":14366,"_27421":50734,"_2948":51074},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3464":609,"_30135":484,"_20936":51076,"_5":14366,"_27421":50738,"_2948":51077},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3464":610,"_30135":484,"_20936":51079,"_5":14366,"_27421":50738,"_2948":51080},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3464":611,"_30135":484,"_20936":51082,"_5":14366,"_27421":50738,"_2948":51083},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3464":612,"_30135":484,"_20936":51085,"_5":14366,"_27421":50741,"_2948":51086},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3464":613,"_30135":484,"_20936":51088,"_5":14366,"_27421":50745,"_2948":51089},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3464":614,"_30135":484,"_20936":51091,"_5":14366,"_27421":50745,"_2948":51092},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3464":615,"_30135":484,"_20936":51094,"_5":14366,"_27421":50749,"_2948":51095},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3464":616,"_30135":484,"_20936":51097,"_5":14366,"_27421":50753,"_2948":51098},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3464":617,"_30135":484,"_20936":51100,"_5":14366,"_27421":50757,"_2948":51101},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3464":618,"_30135":484,"_20936":51103,"_5":14366,"_27421":50761,"_2948":51104},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3464":619,"_30135":484,"_20936":51106,"_5":14366,"_27421":50761,"_2948":51107},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3464":620,"_30135":484,"_20936":51109,"_5":14366,"_27421":50765,"_2948":51110},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3464":621,"_30135":484,"_20936":51112,"_5":14366,"_27421":50765,"_2948":51113},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3464":622,"_30135":484,"_20936":51115,"_5":14366,"_27421":50765,"_2948":51116},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3464":623,"_30135":484,"_20936":51118,"_5":14366,"_27421":50765,"_2948":51119},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3464":624,"_30135":484,"_20936":51121,"_5":14366,"_27421":50765,"_2948":51122},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3464":625,"_30135":484,"_20936":51124,"_5":14366,"_27421":50765,"_2948":51125},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3464":626,"_30135":484,"_20936":51127,"_5":14366,"_27421":50765,"_2948":51128},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3464":627,"_30135":484,"_20936":51130,"_5":14366,"_27421":50765,"_2948":51131},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3464":628,"_30135":484,"_20936":51133,"_5":14366,"_27421":50769,"_2948":51134},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3464":629,"_30135":484,"_20936":51136,"_5":14366,"_27421":50769,"_2948":51137},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3464":630,"_30135":484,"_20936":51139,"_5":14366,"_27421":50769,"_2948":51140},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3464":631,"_30135":484,"_20936":51142,"_5":14366,"_27421":50773,"_2948":51143},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3464":632,"_30135":484,"_20936":51145,"_5":14366,"_27421":50773,"_2948":51146},[],"Use groups or stable roles for people and independent identities for automations.",{"_3464":633,"_30135":484,"_20936":51148,"_5":14366,"_27421":50773,"_2948":51149},[],"Keep at least two recovery administrators and test their access periodically.",{"_3464":634,"_30135":484,"_20936":51151,"_5":14366,"_27421":50773,"_2948":51152},[],"Review active principals, their matches and their grants after IdP changes.",{"_3464":635,"_30135":484,"_20936":51154,"_5":14366,"_27421":50773,"_2948":51155},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3464":636,"_30135":484,"_20936":51157,"_5":14366,"_27421":50773,"_2948":51158},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3464":637,"_30135":484,"_20936":51160,"_5":14366,"_27421":50773,"_2948":51161},[],"Always test one allowed and one denied operation for each role.",{"_3464":638,"_30135":484,"_20936":51163,"_5":14366,"_27421":50773,"_2948":51164},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3464":639,"_30135":484,"_20936":51166,"_5":14366,"_27421":50781,"_2948":51167},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3464":640,"_30135":484,"_20936":51169,"_5":14366,"_27421":50785,"_2948":51170},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3464":641,"_30135":484,"_20936":51172,"_5":14366,"_27421":50785,"_2948":51173},[],"that an active principal of the correct type exists;",{"_3464":642,"_30135":484,"_20936":51175,"_5":14366,"_27421":50785,"_2948":51176},[],"that the claim paths and values match the real token exactly;",{"_3464":643,"_30135":484,"_20936":51178,"_5":14366,"_27421":50785,"_2948":51179},[],"that all of the principal's conditions hold;",{"_3464":644,"_30135":484,"_20936":51181,"_5":14366,"_27421":50785,"_2948":51182},[],"that the principal has the expected policy granted;",{"_3464":645,"_30135":484,"_20936":51184,"_5":14366,"_27421":50785,"_2948":51185},[],"that the policy includes the action and the requested resource type or route;",{"_3464":646,"_30135":484,"_20936":51187,"_5":14366,"_27421":50785,"_2948":51188},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3464":647,"_30135":484,"_20936":51190,"_5":14366,"_27421":50785,"_2948":51191},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3464":648,"_30135":484,"_20936":51193,"_5":14366,"_27421":50789,"_2948":51194},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3464":649,"_30135":484,"_20936":51196,"_5":14366,"_27421":50793,"_2948":51197},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3464":650,"_30135":484,"_20936":51199,"_5":14366,"_27421":50797,"_2948":51200},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3464":651,"_30135":484,"_20936":51202,"_5":14366,"_27421":50797,"_2948":51203},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3464":652,"_30135":652,"_5":14718,"_2948":51205,"_30488":51206,"_20936":51207,"_27421":652},"Alerts and subscriptions",[49202,50670,50671],[],{"_3464":653,"_30135":652,"_20936":51209,"_5":14366,"_27421":652,"_2948":51210},[],"Send PKI events to people and external systems.",{"_3464":654,"_30135":652,"_5":30485,"_20936":51212,"_27421":51213,"_2948":51214},[],"/docs/pr-preview/pr-61/platform/administration/alerts#how-it-works","How it works",{"_3464":655,"_30135":652,"_5":30485,"_20936":51216,"_27421":51217,"_2948":51218},[],"/docs/pr-preview/pr-61/platform/administration/alerts#available-channels","Available channels",{"_3464":656,"_30135":652,"_5":30485,"_20936":51220,"_27421":51221,"_2948":51222},[],"/docs/pr-preview/pr-61/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3464":657,"_30135":652,"_5":30485,"_20936":51224,"_27421":51225,"_2948":51226},[],"/docs/pr-preview/pr-61/platform/administration/alerts#choose-the-event","Choose the event",{"_3464":658,"_30135":652,"_5":30485,"_20936":51228,"_27421":51229,"_2948":51230},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3464":659,"_30135":652,"_5":30485,"_20936":51232,"_27421":51233,"_2948":51234},[],"/docs/pr-preview/pr-61/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3464":660,"_30135":652,"_5":30485,"_20936":51236,"_27421":51237,"_2948":51238},[],"/docs/pr-preview/pr-61/platform/administration/alerts#review-and-activate","Review and activate",{"_3464":661,"_30135":652,"_5":30485,"_20936":51240,"_27421":51241,"_2948":51242},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3464":662,"_30135":652,"_5":30485,"_20936":51244,"_27421":51245,"_2948":51246},[],"/docs/pr-preview/pr-61/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3464":663,"_30135":652,"_5":30485,"_20936":51248,"_27421":51249,"_2948":51250},[],"/docs/pr-preview/pr-61/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3464":664,"_30135":652,"_5":30485,"_20936":51252,"_27421":51253,"_2948":51254},[],"/docs/pr-preview/pr-61/platform/administration/alerts#event-families","Event families",{"_3464":665,"_30135":652,"_20936":51256,"_5":14366,"_27421":652,"_2948":51257},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3464":666,"_30135":652,"_20936":51259,"_5":14366,"_27421":51213,"_2948":51260},[],"A service publishes a domain event.",{"_3464":667,"_30135":652,"_20936":51262,"_5":14366,"_27421":51213,"_2948":51263},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3464":668,"_30135":652,"_20936":51265,"_5":14366,"_27421":51213,"_2948":51266},[],"Each subscription's filter decides whether it should be notified.",{"_3464":669,"_30135":652,"_20936":51268,"_5":14366,"_27421":51213,"_2948":51269},[],"Lamassu delivers the event to the configured channel.",{"_3464":670,"_30135":652,"_20936":51271,"_5":14366,"_27421":51213,"_2948":51272},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3464":671,"_30135":652,"_20936":51274,"_5":14366,"_27421":51217,"_2948":51275},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3464":672,"_30135":652,"_20936":51277,"_5":14366,"_27421":51217,"_2948":51278},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3464":673,"_30135":652,"_20936":51280,"_5":14366,"_27421":51217,"_2948":51281},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3464":674,"_30135":652,"_20936":51283,"_5":14366,"_27421":51217,"_2948":51284},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3464":675,"_30135":652,"_20936":51286,"_5":14366,"_27421":51217,"_2948":51287},[],"`apikey_options` requires `header` and `key`.",{"_3464":676,"_30135":652,"_20936":51289,"_5":14366,"_27421":51217,"_2948":51290},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3464":677,"_30135":652,"_20936":51292,"_5":14366,"_27421":51217,"_2948":51293},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3464":678,"_30135":652,"_20936":51295,"_5":14366,"_27421":51217,"_2948":51296},[],"The alerts API reference documents the full `http_client` schema.",{"_3464":679,"_30135":652,"_20936":51298,"_5":14366,"_27421":51225,"_2948":51299},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3464":680,"_30135":652,"_20936":51301,"_5":14366,"_27421":51229,"_2948":51302},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3464":681,"_30135":652,"_20936":51304,"_5":14366,"_27421":51233,"_2948":51305},[],"Add a filter if you don't want to receive every instance of the event.",{"_3464":682,"_30135":652,"_20936":51307,"_5":14366,"_27421":51233,"_2948":51308},[],"**None** notifies all instances of the event.",{"_3464":683,"_30135":652,"_20936":51310,"_5":14366,"_27421":51233,"_2948":51311},[],"**JSON Path** evaluates one or more specific fields.",{"_3464":684,"_30135":652,"_20936":51313,"_5":14366,"_27421":51233,"_2948":51314},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3464":685,"_30135":652,"_20936":51316,"_5":14366,"_27421":51233,"_2948":51317},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3464":686,"_30135":652,"_20936":51319,"_5":14366,"_27421":51233,"_2948":51320},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3464":687,"_30135":652,"_20936":51322,"_5":14366,"_27421":51233,"_2948":51323},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3464":688,"_30135":652,"_20936":51325,"_5":14366,"_27421":51237,"_2948":51326},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3464":689,"_30135":652,"_20936":51328,"_5":14366,"_27421":51241,"_2948":51329},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3464":690,"_30135":652,"_20936":51331,"_5":14366,"_27421":51241,"_2948":51332},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3464":691,"_30135":652,"_20936":51334,"_5":14366,"_27421":51241,"_2948":51335},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3464":692,"_30135":652,"_20936":51337,"_5":14366,"_27421":51241,"_2948":51338},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3464":693,"_30135":652,"_20936":51340,"_5":14366,"_27421":51241,"_2948":51341},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3464":694,"_30135":652,"_20936":51343,"_5":14366,"_27421":51241,"_2948":51344},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3464":695,"_30135":652,"_20936":51346,"_5":14366,"_27421":51241,"_2948":51347},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3464":696,"_30135":652,"_20936":51349,"_5":14366,"_27421":51241,"_2948":51350},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3464":697,"_30135":652,"_20936":51352,"_5":14366,"_27421":51245,"_2948":51353},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3464":698,"_30135":652,"_20936":51355,"_5":14366,"_27421":51245,"_2948":51356},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3464":699,"_30135":652,"_20936":51358,"_5":14366,"_27421":51245,"_2948":51359},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3464":700,"_30135":652,"_20936":51361,"_5":14366,"_27421":51245,"_2948":51362},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3464":701,"_30135":652,"_20936":51364,"_5":14366,"_27421":51245,"_2948":51365},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3464":702,"_30135":652,"_20936":51367,"_5":14366,"_27421":51245,"_2948":51368},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3464":703,"_30135":652,"_20936":51370,"_5":14366,"_27421":51245,"_2948":51371},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3464":704,"_30135":652,"_20936":51373,"_5":14366,"_27421":51245,"_2948":51374},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3464":705,"_30135":652,"_20936":51376,"_5":14366,"_27421":51249,"_2948":51377},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3464":706,"_30135":652,"_20936":51379,"_5":14366,"_27421":51249,"_2948":51380},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3464":707,"_30135":652,"_20936":51382,"_5":14366,"_27421":51253,"_2948":51383},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3464":708,"_30135":652,"_20936":51385,"_5":14366,"_27421":51253,"_2948":51386},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3464":709,"_30135":652,"_20936":51388,"_5":14366,"_27421":51253,"_2948":51389},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3464":710,"_30135":652,"_20936":51391,"_5":14366,"_27421":51253,"_2948":51392},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3464":711,"_30135":652,"_20936":51394,"_5":14366,"_27421":51253,"_2948":51395},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3464":712,"_30135":652,"_20936":51397,"_5":14366,"_27421":51253,"_2948":51398},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3464":713,"_30135":652,"_20936":51400,"_5":14366,"_27421":51253,"_2948":51401},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3464":714,"_30135":652,"_20936":51403,"_5":14366,"_27421":51253,"_2948":51404},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3464":715,"_30135":652,"_20936":51406,"_5":14366,"_27421":51253,"_2948":51407},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3464":716,"_30135":716,"_5":14718,"_2948":51409,"_30488":51410,"_20936":51411,"_27421":716},"Audit logs",[49202,50670,50671],[],{"_3464":717,"_30135":716,"_20936":51413,"_5":14366,"_27421":716,"_2948":51414},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3464":718,"_30135":716,"_5":30485,"_20936":51416,"_27421":51417,"_2948":51418},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3464":719,"_30135":716,"_5":30485,"_20936":51420,"_27421":51421,"_2948":51422},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#coverage","Coverage",{"_3464":720,"_30135":716,"_5":30485,"_20936":51424,"_27421":51425,"_2948":51426},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3464":721,"_30135":716,"_5":30485,"_20936":51428,"_27421":51429,"_2948":51430},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3464":722,"_30135":716,"_5":30485,"_20936":51432,"_27421":51433,"_2948":51434},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3464":723,"_30135":716,"_5":30485,"_20936":51436,"_27421":51437,"_2948":51438},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3464":724,"_30135":716,"_5":30485,"_20936":51440,"_27421":51441,"_2948":51442},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3464":725,"_30135":716,"_5":30485,"_20936":51444,"_27421":51445,"_2948":51446},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3464":726,"_30135":716,"_5":30485,"_20936":51448,"_27421":51449,"_2948":51450},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3464":727,"_30135":716,"_5":30485,"_20936":51452,"_27421":51453,"_2948":51454},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3464":728,"_30135":716,"_5":30485,"_20936":51456,"_27421":51457,"_2948":51458},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3464":729,"_30135":716,"_20936":51460,"_5":14366,"_27421":716,"_2948":51461},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3464":730,"_30135":716,"_20936":51463,"_5":14366,"_27421":51417,"_2948":51464},[],"The audit body includes:",{"_3464":731,"_30135":716,"_20936":51466,"_5":14366,"_27421":51417,"_2948":51467},[],"input: data received by the operation;",{"_3464":732,"_30135":716,"_20936":51469,"_5":14366,"_27421":51417,"_2948":51470},[],"has\\_error: whether the service returned an error;",{"_3464":733,"_30135":716,"_20936":51472,"_5":14366,"_27421":51417,"_2948":51473},[],"output: produced result or error message;",{"_3464":734,"_30135":716,"_20936":51475,"_5":14366,"_27421":51417,"_2948":51476},[],"principals: identifiers of the principals that matched the request.",{"_3464":735,"_30135":716,"_20936":51478,"_5":14366,"_27421":51417,"_2948":51479},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3464":736,"_30135":716,"_20936":51481,"_5":14366,"_27421":51417,"_2948":51482},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3464":737,"_30135":716,"_20936":51484,"_5":14366,"_27421":51421,"_2948":51485},[],"The backend applies auditing to mutations of:",{"_3464":738,"_30135":716,"_20936":51487,"_5":14366,"_27421":51421,"_2948":51488},[],"authorities, certificates and issuance profiles;",{"_3464":739,"_30135":716,"_20936":51490,"_5":14366,"_27421":51421,"_2948":51491},[],"keys and KMS engines;",{"_3464":740,"_30135":716,"_20936":51493,"_5":14366,"_27421":51421,"_2948":51494},[],"devices and identities;",{"_3464":741,"_30135":716,"_20936":51496,"_5":14366,"_27421":51421,"_2948":51497},[],"DMSs and enrollment operations;",{"_3464":742,"_30135":716,"_20936":51499,"_5":14366,"_27421":51421,"_2948":51500},[],"validation functions and CRL;",{"_3464":743,"_30135":716,"_20936":51502,"_5":14366,"_27421":51421,"_2948":51503},[],"principals, policies and authorization grants.",{"_3464":744,"_30135":716,"_20936":51505,"_5":14366,"_27421":51421,"_2948":51506},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3464":745,"_30135":716,"_20936":51508,"_5":14366,"_27421":51425,"_2948":51509},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3464":746,"_30135":716,"_20936":51511,"_5":14366,"_27421":51425,"_2948":51512},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3464":747,"_30135":716,"_20936":51514,"_5":14366,"_27421":51425,"_2948":51515},[],"Design the consumer to:",{"_3464":748,"_30135":716,"_20936":51517,"_5":14366,"_27421":51425,"_2948":51518},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3464":749,"_30135":716,"_20936":51520,"_5":14366,"_27421":51425,"_2948":51521},[],"keep the complete CloudEvent unmodified;",{"_3464":750,"_30135":716,"_20936":51523,"_5":14366,"_27421":51425,"_2948":51524},[],"record the ingestion time and detect duplicates by ID;",{"_3464":751,"_30135":716,"_20936":51526,"_5":14366,"_27421":51425,"_2948":51527},[],"encrypt in transit and at rest;",{"_3464":752,"_30135":716,"_20936":51529,"_5":14366,"_27421":51425,"_2948":51530},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3464":753,"_30135":716,"_20936":51532,"_5":14366,"_27421":51425,"_2948":51533},[],"apply an explicit retention and legal hold policy;",{"_3464":754,"_30135":716,"_20936":51535,"_5":14366,"_27421":51425,"_2948":51536},[],"alert if it stops consuming or the pending queue grows.",{"_3464":755,"_30135":716,"_20936":51538,"_5":14366,"_27421":51429,"_2948":51539},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3464":756,"_30135":716,"_20936":51541,"_5":14366,"_27421":51429,"_2948":51542},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3464":757,"_30135":716,"_20936":51544,"_5":14366,"_27421":51437,"_2948":51545},[],"Start from the reported time and normalize every source to UTC.",{"_3464":758,"_30135":716,"_20936":51547,"_5":14366,"_27421":51441,"_2948":51548},[],"Filter by event type, service source and resource identifier.",{"_3464":759,"_30135":716,"_20936":51550,"_5":14366,"_27421":51445,"_2948":51551},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3464":760,"_30135":716,"_20936":51553,"_5":14366,"_27421":51449,"_2948":51554},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3464":761,"_30135":716,"_20936":51556,"_5":14366,"_27421":51453,"_2948":51557},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3464":762,"_30135":716,"_20936":51559,"_5":14366,"_27421":51457,"_2948":51560},[],"Generate a controlled mutation in a test environment and check that:",{"_3464":763,"_30135":716,"_20936":51562,"_5":14366,"_27421":51457,"_2948":51563},[],"a successful audit event appears;",{"_3464":764,"_30135":716,"_20936":51565,"_5":14366,"_27421":51457,"_2948":51566},[],"the principal matches the identity used;",{"_3464":765,"_30135":716,"_20936":51568,"_5":14366,"_27421":51457,"_2948":51569},[],"the consumer persists it exactly once;",{"_3464":766,"_30135":716,"_20936":51571,"_5":14366,"_27421":51457,"_2948":51572},[],"it can be retrieved by resource, actor and period;",{"_3464":767,"_30135":716,"_20936":51574,"_5":14366,"_27421":51457,"_2948":51575},[],"a consumer outage raises an alert.",{"_3464":768,"_30135":716,"_20936":51577,"_5":14366,"_27421":51457,"_2948":51578},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3464":769,"_30135":769,"_5":14718,"_2948":51580,"_30488":51581,"_20936":51582,"_27421":769},"Platform architecture",[49202,50670],[],{"_3464":770,"_30135":769,"_20936":51584,"_5":14366,"_27421":769,"_2948":51585},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3464":771,"_30135":769,"_5":30485,"_20936":51587,"_27421":51588,"_2948":51589},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#control-plane","Control plane",{"_3464":772,"_30135":769,"_5":30485,"_20936":51591,"_27421":51592,"_2948":51593},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3464":773,"_30135":769,"_5":30485,"_20936":51595,"_27421":51596,"_2948":51597},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3464":774,"_30135":769,"_5":30485,"_20936":51599,"_27421":51600,"_2948":51601},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#status-and-validation","Status and validation",{"_3464":775,"_30135":769,"_5":30485,"_20936":51603,"_27421":51604,"_2948":51605},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3464":776,"_30135":769,"_20936":51607,"_5":14366,"_27421":769,"_2948":51608},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3464":777,"_30135":769,"_20936":51610,"_5":14366,"_27421":769,"_2948":51611},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3464":778,"_30135":769,"_20936":51613,"_5":14366,"_27421":51588,"_2948":51614},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3464":779,"_30135":769,"_20936":51616,"_5":14366,"_27421":51592,"_2948":51617},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3464":780,"_30135":769,"_20936":51619,"_5":14366,"_27421":51596,"_2948":51620},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3464":781,"_30135":769,"_20936":51622,"_5":14366,"_27421":51600,"_2948":51623},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3464":782,"_30135":769,"_20936":51625,"_5":14366,"_27421":51604,"_2948":51626},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3464":783,"_30135":783,"_5":14718,"_2948":51628,"_30488":51629,"_20936":51630,"_27421":783},"How Lamassu works",[49202,50670],[],{"_3464":784,"_30135":783,"_20936":51632,"_5":14366,"_27421":783,"_2948":51633},[],"The mental model of trust, keys, certificates and devices.",{"_3464":785,"_30135":783,"_5":30485,"_20936":51635,"_27421":51636,"_2948":51637},[],"/docs/pr-preview/pr-61/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3464":786,"_30135":783,"_5":30485,"_20936":51639,"_27421":51640,"_2948":51641},[],"/docs/pr-preview/pr-61/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3464":787,"_30135":783,"_20936":51643,"_5":14366,"_27421":783,"_2948":51644},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3464":788,"_30135":783,"_20936":51646,"_5":14366,"_27421":51636,"_2948":51647},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3464":789,"_30135":783,"_20936":51649,"_5":14366,"_27421":51636,"_2948":51650},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3464":790,"_30135":783,"_20936":51652,"_5":14366,"_27421":51636,"_2948":51653},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3464":791,"_30135":783,"_20936":51655,"_5":14366,"_27421":51636,"_2948":51656},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3464":792,"_30135":783,"_20936":51658,"_5":14366,"_27421":51636,"_2948":51659},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3464":793,"_30135":783,"_20936":51661,"_5":14366,"_27421":51640,"_2948":51662},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3464":794,"_30135":783,"_20936":51664,"_5":14366,"_27421":51640,"_2948":51665},[],"A DMS relates that CA to an enrollment policy.",{"_3464":795,"_30135":783,"_20936":51667,"_5":14366,"_27421":51640,"_2948":51668},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3464":796,"_30135":783,"_20936":51670,"_5":14366,"_27421":51640,"_2948":51671},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3464":797,"_30135":783,"_20936":51673,"_5":14366,"_27421":51640,"_2948":51674},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3464":798,"_30135":783,"_20936":51676,"_5":14366,"_27421":51640,"_2948":51677},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3464":799,"_30135":783,"_20936":51679,"_5":14366,"_27421":51640,"_2948":51680},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3464":800,"_30135":800,"_5":14718,"_2948":51682,"_30488":51683,"_20936":51685,"_27421":800},"Devices and identities",[49202,50670,51684,51682],"IoT Fleets",[],{"_3464":801,"_30135":800,"_20936":51687,"_5":14366,"_27421":800,"_2948":51688},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3464":802,"_30135":800,"_5":30485,"_20936":51690,"_27421":51691,"_2948":51692},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#device-states","Device states",{"_3464":803,"_30135":800,"_5":30485,"_20936":51694,"_27421":51695,"_2948":51696},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3464":804,"_30135":800,"_5":30485,"_20936":51698,"_27421":51699,"_2948":51700},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3464":805,"_30135":800,"_5":30485,"_20936":51702,"_27421":51703,"_2948":51704},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3464":806,"_30135":800,"_5":30485,"_20936":51706,"_27421":51707,"_2948":51708},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3464":807,"_30135":800,"_5":30485,"_20936":51710,"_27421":51711,"_2948":51712},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3464":808,"_30135":800,"_5":30485,"_20936":51714,"_27421":51715,"_2948":51716},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3464":809,"_30135":800,"_5":30485,"_20936":51718,"_27421":51719,"_2948":51720},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3464":810,"_30135":800,"_5":30485,"_20936":51722,"_27421":51723,"_2948":51724},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3464":811,"_30135":800,"_5":30485,"_20936":51726,"_27421":51727,"_2948":51728},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3464":812,"_30135":800,"_5":30485,"_20936":51730,"_27421":51731,"_2948":51732},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3464":813,"_30135":800,"_20936":51734,"_5":14366,"_27421":800,"_2948":51735},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3464":814,"_30135":800,"_20936":51737,"_5":14366,"_27421":800,"_2948":51738},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3464":815,"_30135":800,"_20936":51740,"_5":14366,"_27421":51691,"_2948":51741},[],"Operational view",{"_3464":816,"_30135":800,"_20936":51743,"_5":14366,"_27421":51691,"_2948":51744},[],"Meaning",{"_3464":817,"_30135":800,"_20936":51746,"_5":14366,"_27421":51691,"_2948":51747},[],"**No Identity**",{"_3464":818,"_30135":800,"_20936":51749,"_5":14366,"_27421":51691,"_2948":51750},[],"A record exists without an associated identity.",{"_3464":819,"_30135":800,"_20936":51752,"_5":14366,"_27421":51691,"_2948":51753},[],"**Active**",{"_3464":820,"_30135":800,"_20936":51755,"_5":14366,"_27421":51691,"_2948":51756},[],"The slot is active; also check certificate dates, status and usages.",{"_3464":821,"_30135":800,"_20936":51758,"_5":14366,"_27421":51691,"_2948":51759},[],"**Renewal Pending**",{"_3464":822,"_30135":800,"_20936":51761,"_5":14366,"_27421":51691,"_2948":51762},[],"The identity is in the operational renewal window.",{"_3464":823,"_30135":800,"_20936":51764,"_5":14366,"_27421":51691,"_2948":51765},[],"**Expiring Soon**",{"_3464":824,"_30135":800,"_20936":51767,"_5":14366,"_27421":51691,"_2948":51768},[],"Expiration is approaching according to configured thresholds.",{"_3464":825,"_30135":800,"_20936":51770,"_5":14366,"_27421":51691,"_2948":51771},[],"**Expired**",{"_3464":826,"_30135":800,"_20936":51773,"_5":14366,"_27421":51691,"_2948":51774},[],"The identity has expired.",{"_3464":827,"_30135":800,"_20936":51776,"_5":14366,"_27421":51691,"_2948":51777},[],"**Revoked**",{"_3464":828,"_30135":800,"_20936":51779,"_5":14366,"_27421":51691,"_2948":51780},[],"The identity is marked revoked.",{"_3464":829,"_30135":800,"_20936":51782,"_5":14366,"_27421":51691,"_2948":51783},[],"**Decommissioned**",{"_3464":830,"_30135":800,"_20936":51785,"_5":14366,"_27421":51691,"_2948":51786},[],"The record is retired and ordinary updates do not restore operation.",{"_3464":831,"_30135":800,"_20936":51788,"_5":14366,"_27421":51691,"_2948":51789},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3464":832,"_30135":800,"_20936":51791,"_5":14366,"_27421":51695,"_2948":51792},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3464":833,"_30135":800,"_20936":51794,"_5":14366,"_27421":51695,"_2948":51795},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3464":834,"_30135":800,"_20936":51797,"_5":14366,"_27421":51695,"_2948":51798},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3464":835,"_30135":800,"_20936":51800,"_5":14366,"_27421":51695,"_2948":51801},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3464":836,"_30135":800,"_20936":51803,"_5":14366,"_27421":51699,"_2948":51804},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3464":837,"_30135":800,"_20936":51806,"_5":14366,"_27421":51703,"_2948":51807},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3464":838,"_30135":800,"_20936":51809,"_5":14366,"_27421":51707,"_2948":51810},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3464":839,"_30135":800,"_20936":51812,"_5":14366,"_27421":51711,"_2948":51813},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3464":840,"_30135":800,"_20936":51815,"_5":14366,"_27421":51715,"_2948":51816},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3464":841,"_30135":800,"_20936":51818,"_5":14366,"_27421":51715,"_2948":51819},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3464":842,"_30135":800,"_20936":51821,"_5":14366,"_27421":51719,"_2948":51822},[],"From **No Identity**, use **Assign Identity**:",{"_3464":843,"_30135":800,"_20936":51824,"_5":14366,"_27421":51719,"_2948":51825},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3464":844,"_30135":800,"_20936":51827,"_5":14366,"_27421":51719,"_2948":51828},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3464":845,"_30135":800,"_20936":51830,"_5":14366,"_27421":51719,"_2948":51831},[],"Confirm and read the serial, active version and history again.",{"_3464":846,"_30135":800,"_20936":51833,"_5":14366,"_27421":51719,"_2948":51834},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3464":847,"_30135":800,"_20936":51836,"_5":14366,"_27421":51719,"_2948":51837},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3464":848,"_30135":800,"_20936":51839,"_5":14366,"_27421":51723,"_2948":51840},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3464":849,"_30135":800,"_20936":51842,"_5":14366,"_27421":51723,"_2948":51843},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3464":850,"_30135":800,"_20936":51845,"_5":14366,"_27421":51727,"_2948":51846},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3464":851,"_30135":800,"_20936":51848,"_5":14366,"_27421":51727,"_2948":51849},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3464":852,"_30135":800,"_20936":51851,"_5":14366,"_27421":51727,"_2948":51852},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3464":853,"_30135":800,"_20936":51854,"_5":14366,"_27421":51727,"_2948":51855},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3464":854,"_30135":800,"_20936":51857,"_5":14366,"_27421":51731,"_2948":51858},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3464":855,"_30135":800,"_20936":51860,"_5":14366,"_27421":51731,"_2948":51861},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3464":856,"_30135":856,"_5":14718,"_2948":51863,"_30488":51864,"_20936":51866,"_27421":856},"Bootstrap identity and authentication",[49202,50670,51684,51682,51865],"Enrollment with PKI",[],{"_3464":857,"_30135":856,"_20936":51868,"_5":14366,"_27421":856,"_2948":51869},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3464":858,"_30135":856,"_5":30485,"_20936":51871,"_27421":51872,"_2948":51873},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3464":859,"_30135":856,"_5":30485,"_20936":51875,"_27421":51876,"_2948":51877},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3464":860,"_30135":856,"_5":30485,"_20936":51879,"_27421":51880,"_2948":51881},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3464":861,"_30135":856,"_5":30485,"_20936":51883,"_27421":51884,"_2948":51885},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3464":862,"_30135":856,"_5":30485,"_20936":51887,"_27421":51888,"_2948":51889},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3464":863,"_30135":856,"_20936":51891,"_5":14366,"_27421":856,"_2948":51892},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3464":864,"_30135":856,"_20936":51894,"_5":14366,"_27421":51872,"_2948":51895},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3464":865,"_30135":856,"_20936":51897,"_5":14366,"_27421":51872,"_2948":51898},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3464":866,"_30135":856,"_20936":51900,"_5":14366,"_27421":51876,"_2948":51901},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3464":867,"_30135":856,"_20936":51903,"_5":14366,"_27421":51876,"_2948":51904},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3464":868,"_30135":856,"_20936":51906,"_5":14366,"_27421":51876,"_2948":51907},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3464":869,"_30135":856,"_20936":51909,"_5":14366,"_27421":51880,"_2948":51910},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3464":870,"_30135":856,"_20936":51912,"_5":14366,"_27421":51880,"_2948":51913},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3464":871,"_30135":856,"_20936":51915,"_5":14366,"_27421":51884,"_2948":51916},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3464":872,"_30135":856,"_20936":51918,"_5":14366,"_27421":51884,"_2948":51919},[],"Example body:",{"_3464":873,"_30135":856,"_20936":51921,"_5":14366,"_27421":51884,"_2948":51922},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3464":874,"_30135":856,"_20936":51924,"_5":14366,"_27421":51884,"_2948":51925},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3464":875,"_30135":856,"_20936":51927,"_5":14366,"_27421":51884,"_2948":51928},[],"Continuation requires a successful HTTP response and JSON:",{"_3464":876,"_30135":856,"_20936":51930,"_5":14366,"_27421":51884,"_2948":51931},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3464":877,"_30135":856,"_20936":51933,"_5":14366,"_27421":51888,"_2948":51934},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3464":878,"_30135":856,"_20936":51936,"_5":14366,"_27421":51888,"_2948":51937},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3464":879,"_30135":879,"_5":14718,"_2948":51939,"_30488":51940,"_20936":51941,"_27421":879},"Configure and operate the DMS",[49202,50670,51684,51682,51865],[],{"_3464":880,"_30135":879,"_20936":51943,"_5":14366,"_27421":879,"_2948":51944},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3464":881,"_30135":879,"_5":30485,"_20936":51946,"_27421":51947,"_2948":49212},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3464":882,"_30135":879,"_5":30485,"_20936":51949,"_27421":51950,"_2948":51951},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3464":883,"_30135":879,"_5":30485,"_20936":51953,"_27421":51954,"_2948":51955},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3464":884,"_30135":879,"_5":30485,"_20936":51957,"_27421":51958,"_2948":51959},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3464":885,"_30135":879,"_5":30485,"_20936":51961,"_27421":51962,"_2948":51963},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3464":886,"_30135":879,"_5":30485,"_20936":51965,"_27421":51966,"_2948":51967},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3464":887,"_30135":879,"_5":30485,"_20936":51969,"_27421":51970,"_2948":51971},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3464":888,"_30135":879,"_5":30485,"_20936":51973,"_27421":51974,"_2948":51975},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3464":889,"_30135":879,"_5":30485,"_20936":51977,"_27421":51978,"_2948":51979},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3464":890,"_30135":879,"_5":30485,"_20936":51981,"_27421":51982,"_2948":51983},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3464":891,"_30135":879,"_5":30485,"_20936":51985,"_27421":51986,"_2948":51987},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3464":892,"_30135":879,"_5":30485,"_20936":51989,"_27421":51990,"_2948":51991},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3464":893,"_30135":879,"_5":30485,"_20936":51993,"_27421":51994,"_2948":51995},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3464":894,"_30135":879,"_5":30485,"_20936":51997,"_27421":51998,"_2948":51999},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3464":895,"_30135":879,"_5":30485,"_20936":52001,"_27421":52002,"_2948":52003},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3464":896,"_30135":879,"_5":30485,"_20936":52005,"_27421":52006,"_2948":52007},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3464":897,"_30135":879,"_5":30485,"_20936":52009,"_27421":52010,"_2948":52011},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3464":898,"_30135":879,"_5":30485,"_20936":52013,"_27421":52014,"_2948":52015},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3464":899,"_30135":879,"_20936":52017,"_5":14366,"_27421":879,"_2948":52018},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3464":900,"_30135":879,"_20936":52020,"_5":14366,"_27421":51947,"_2948":52021},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3464":901,"_30135":879,"_20936":52023,"_5":14366,"_27421":51947,"_2948":52024},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3464":902,"_30135":879,"_20936":52026,"_5":14366,"_27421":51954,"_2948":52027},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3464":903,"_30135":879,"_20936":52029,"_5":14366,"_27421":51958,"_2948":52030},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3464":904,"_30135":879,"_20936":52032,"_5":14366,"_27421":51962,"_2948":52033},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3464":905,"_30135":879,"_20936":52035,"_5":14366,"_27421":51966,"_2948":52036},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3464":906,"_30135":879,"_20936":52038,"_5":14366,"_27421":51970,"_2948":52039},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3464":907,"_30135":879,"_20936":52041,"_5":14366,"_27421":51978,"_2948":52042},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3464":908,"_30135":879,"_20936":52044,"_5":14366,"_27421":51978,"_2948":52045},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3464":909,"_30135":879,"_20936":52047,"_5":14366,"_27421":51982,"_2948":52048},[],"`settings.enrollment_settings` field",{"_3464":910,"_30135":879,"_20936":52050,"_5":14366,"_27421":51982,"_2948":52051},[],"Decision",{"_3464":911,"_30135":879,"_20936":52053,"_5":14366,"_27421":51982,"_2948":52054},[],"`protocol`",{"_3464":912,"_30135":879,"_20936":52056,"_5":14366,"_27421":51982,"_2948":52057},[],"`EST_RFC7030` for these operations.",{"_3464":913,"_30135":879,"_20936":52059,"_5":14366,"_27421":51982,"_2948":52060},[],"`enrollment_ca`",{"_3464":914,"_30135":879,"_20936":52062,"_5":14366,"_27421":51982,"_2948":52063},[],"ID of the signing CA.",{"_3464":915,"_30135":879,"_20936":52065,"_5":14366,"_27421":51982,"_2948":52066},[],"`verify_csr_signature`",{"_3464":916,"_30135":879,"_20936":52068,"_5":14366,"_27421":51982,"_2948":52069},[],"Keep `true` to verify CSR key possession.",{"_3464":917,"_30135":879,"_20936":52071,"_5":14366,"_27421":51982,"_2948":52072},[],"`enable_replaceable_enrollment`",{"_3464":918,"_30135":879,"_20936":52074,"_5":14366,"_27421":51982,"_2948":52075},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3464":919,"_30135":879,"_20936":52077,"_5":14366,"_27421":51982,"_2948":52078},[],"`est_rfc7030_settings.auth_mode`",{"_3464":920,"_30135":879,"_20936":52080,"_5":14366,"_27421":51982,"_2948":52081},[],"One of the four authentication modes.",{"_3464":921,"_30135":879,"_20936":52083,"_5":14366,"_27421":51982,"_2948":52084},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3464":922,"_30135":879,"_20936":52086,"_5":14366,"_27421":51986,"_2948":52087},[],"The blocks are independent:",{"_3464":923,"_30135":879,"_20936":52089,"_5":14366,"_27421":51986,"_2948":52090},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3464":924,"_30135":879,"_20936":52092,"_5":14366,"_27421":51986,"_2948":52093},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3464":925,"_30135":879,"_20936":52095,"_5":14366,"_27421":51986,"_2948":52096},[],"`auth_mode`",{"_3464":926,"_30135":879,"_20936":52098,"_5":14366,"_27421":51986,"_2948":52099},[],"Control applied in the configured operation",{"_3464":927,"_30135":879,"_20936":52101,"_5":14366,"_27421":51986,"_2948":52102},[],"`CLIENT_CERTIFICATE`",{"_3464":928,"_30135":879,"_20936":52104,"_5":14366,"_27421":51986,"_2948":52105},[],"Presented certificate validation.",{"_3464":929,"_30135":879,"_20936":52107,"_5":14366,"_27421":51986,"_2948":52108},[],"`EXTERNAL_WEBHOOK`",{"_3464":930,"_30135":879,"_20936":52110,"_5":14366,"_27421":51986,"_2948":52111},[],"Configured webhook authorization.",{"_3464":931,"_30135":879,"_20936":52113,"_5":14366,"_27421":51986,"_2948":52114},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3464":932,"_30135":879,"_20936":52116,"_5":14366,"_27421":51986,"_2948":52117},[],"Certificate validation followed by webhook approval.",{"_3464":933,"_30135":879,"_20936":52119,"_5":14366,"_27421":51986,"_2948":52120},[],"`NO_AUTH`",{"_3464":934,"_30135":879,"_20936":52122,"_5":14366,"_27421":51986,"_2948":52123},[],"No DMS requester authentication.",{"_3464":935,"_30135":879,"_20936":52125,"_5":14366,"_27421":51986,"_2948":52126},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3464":936,"_30135":879,"_20936":52128,"_5":14366,"_27421":51986,"_2948":52129},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3464":937,"_30135":879,"_20936":52131,"_5":14366,"_27421":51986,"_2948":52132},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3464":938,"_30135":879,"_20936":52134,"_5":14366,"_27421":51986,"_2948":52135},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3464":939,"_30135":879,"_20936":52137,"_5":14366,"_27421":51990,"_2948":52138},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3464":940,"_30135":879,"_20936":52140,"_5":14366,"_27421":51990,"_2948":52141},[],"`external_webhook_settings` field",{"_3464":941,"_30135":879,"_20936":52143,"_5":14366,"_27421":51990,"_2948":52051},[],{"_3464":942,"_30135":879,"_20936":52145,"_5":14366,"_27421":51990,"_2948":52146},[],"`url`",{"_3464":943,"_30135":879,"_20936":52148,"_5":14366,"_27421":51990,"_2948":52149},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3464":944,"_30135":879,"_20936":52151,"_5":14366,"_27421":51990,"_2948":52152},[],"`method`",{"_3464":945,"_30135":879,"_20936":52154,"_5":14366,"_27421":51990,"_2948":52155},[],"`POST` or `PUT`; `POST` by default.",{"_3464":946,"_30135":879,"_20936":52157,"_5":14366,"_27421":51990,"_2948":52158},[],"`name`",{"_3464":947,"_30135":879,"_20936":52160,"_5":14366,"_27421":51990,"_2948":52161},[],"Label used in service logs.",{"_3464":948,"_30135":879,"_20936":52163,"_5":14366,"_27421":51990,"_2948":52164},[],"`config.auth_mode`",{"_3464":949,"_30135":879,"_20936":52166,"_5":14366,"_27421":51990,"_2948":52167},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3464":950,"_30135":879,"_20936":52169,"_5":14366,"_27421":51990,"_2948":52170},[],"`config.log_level`",{"_3464":951,"_30135":879,"_20936":52172,"_5":14366,"_27421":51990,"_2948":52173},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3464":952,"_30135":879,"_20936":52175,"_5":14366,"_27421":51990,"_2948":52176},[],"`config.apikey_options`",{"_3464":953,"_30135":879,"_20936":52178,"_5":14366,"_27421":51990,"_2948":52179},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3464":954,"_30135":879,"_20936":52181,"_5":14366,"_27421":51990,"_2948":52182},[],"`config.jwt_options`",{"_3464":955,"_30135":879,"_20936":52184,"_5":14366,"_27421":51990,"_2948":52185},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3464":956,"_30135":879,"_20936":52187,"_5":14366,"_27421":51990,"_2948":52188},[],"`config.mtls_options`",{"_3464":957,"_30135":879,"_20936":52190,"_5":14366,"_27421":51990,"_2948":52191},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3464":958,"_30135":879,"_20936":52193,"_5":14366,"_27421":51990,"_2948":52194},[],"`config.insecure_skip_verify`",{"_3464":959,"_30135":879,"_20936":52196,"_5":14366,"_27421":51990,"_2948":52197},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3464":960,"_30135":879,"_20936":52199,"_5":14366,"_27421":51990,"_2948":52200},[],"`config.call_timeout`",{"_3464":961,"_30135":879,"_20936":52202,"_5":14366,"_27421":51990,"_2948":52203},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3464":962,"_30135":879,"_20936":52205,"_5":14366,"_27421":51990,"_2948":52206},[],"Rules for that configuration:",{"_3464":963,"_30135":879,"_20936":52208,"_5":14366,"_27421":51990,"_2948":52209},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3464":964,"_30135":879,"_20936":52211,"_5":14366,"_27421":51990,"_2948":52212},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3464":965,"_30135":879,"_20936":52214,"_5":14366,"_27421":51990,"_2948":52215},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3464":966,"_30135":879,"_20936":52217,"_5":14366,"_27421":51990,"_2948":52218},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3464":967,"_30135":879,"_20936":52220,"_5":14366,"_27421":51990,"_2948":52221},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3464":968,"_30135":879,"_20936":52223,"_5":14366,"_27421":51990,"_2948":52224},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3464":969,"_30135":879,"_20936":52226,"_5":14366,"_27421":51990,"_2948":52227},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3464":970,"_30135":879,"_20936":52229,"_5":14366,"_27421":51990,"_2948":52230},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3464":971,"_30135":879,"_20936":52232,"_5":14366,"_27421":51990,"_2948":52233},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3464":972,"_30135":879,"_20936":52235,"_5":14366,"_27421":51994,"_2948":52236},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3464":973,"_30135":879,"_20936":52238,"_5":14366,"_27421":51998,"_2948":52239},[],"`settings.reenrollment_settings` field",{"_3464":974,"_30135":879,"_20936":52241,"_5":14366,"_27421":51998,"_2948":49592},[],{"_3464":975,"_30135":879,"_20936":52243,"_5":14366,"_27421":51998,"_2948":52244},[],"`reenrollment_delta`",{"_3464":976,"_30135":879,"_20936":52246,"_5":14366,"_27421":51998,"_2948":52247},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3464":977,"_30135":879,"_20936":52249,"_5":14366,"_27421":51998,"_2948":52250},[],"`preventive_delta`",{"_3464":978,"_30135":879,"_20936":52252,"_5":14366,"_27421":51998,"_2948":52253},[],"Preventive operational monitoring threshold.",{"_3464":979,"_30135":879,"_20936":52255,"_5":14366,"_27421":51998,"_2948":52256},[],"`critical_delta`",{"_3464":980,"_30135":879,"_20936":52258,"_5":14366,"_27421":51998,"_2948":52259},[],"Critical operational monitoring threshold.",{"_3464":981,"_30135":879,"_20936":52261,"_5":14366,"_27421":51998,"_2948":52262},[],"`enable_expired_renewal`",{"_3464":982,"_30135":879,"_20936":52264,"_5":14366,"_27421":51998,"_2948":52265},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3464":983,"_30135":879,"_20936":52267,"_5":14366,"_27421":51998,"_2948":52268},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3464":984,"_30135":879,"_20936":52270,"_5":14366,"_27421":51998,"_2948":52271},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3464":985,"_30135":879,"_20936":52273,"_5":14366,"_27421":51998,"_2948":52274},[],"`revoke_on_reenrollment`",{"_3464":986,"_30135":879,"_20936":52276,"_5":14366,"_27421":51998,"_2948":52277},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3464":987,"_30135":879,"_20936":52279,"_5":14366,"_27421":51998,"_2948":52280},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3464":988,"_30135":879,"_20936":52282,"_5":14366,"_27421":52002,"_2948":52283},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3464":989,"_30135":879,"_20936":52285,"_5":14366,"_27421":52006,"_2948":49586},[],{"_3464":990,"_30135":879,"_20936":52287,"_5":14366,"_27421":52006,"_2948":52288},[],"Published material",{"_3464":991,"_30135":879,"_20936":52290,"_5":14366,"_27421":52006,"_2948":52291},[],"**Include Lamassu System CA**",{"_3464":992,"_30135":879,"_20936":52293,"_5":14366,"_27421":52006,"_2948":52294},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3464":993,"_30135":879,"_20936":52296,"_5":14366,"_27421":52006,"_2948":52297},[],"**Include Enrollment CA**",{"_3464":994,"_30135":879,"_20936":52299,"_5":14366,"_27421":52006,"_2948":52300},[],"Selected issuing CA certificate.",{"_3464":995,"_30135":879,"_20936":52302,"_5":14366,"_27421":52006,"_2948":52303},[],"**Managed CAs**",{"_3464":996,"_30135":879,"_20936":52305,"_5":14366,"_27421":52006,"_2948":52306},[],"Explicitly selected CA certificates.",{"_3464":997,"_30135":879,"_20936":52308,"_5":14366,"_27421":52006,"_2948":52309},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3464":998,"_30135":879,"_20936":52311,"_5":14366,"_27421":52010,"_2948":52312},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3464":999,"_30135":879,"_20936":52314,"_5":14366,"_27421":52010,"_2948":52315},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3464":1000,"_30135":879,"_20936":52317,"_5":14366,"_27421":52010,"_2948":52318},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3464":1001,"_30135":879,"_20936":52320,"_5":14366,"_27421":52014,"_2948":52321},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3464":1002,"_30135":1002,"_5":14718,"_2948":52323,"_30488":52324,"_20936":52325,"_27421":1002},"Integrate the EST client",[49202,50670,51684,51682,51865],[],{"_3464":1003,"_30135":1002,"_20936":52327,"_5":14366,"_27421":1002,"_2948":52328},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3464":1004,"_30135":1002,"_5":30485,"_20936":52330,"_27421":52331,"_2948":49212},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3464":1005,"_30135":1002,"_5":30485,"_20936":52333,"_27421":52334,"_2948":52335},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3464":1006,"_30135":1002,"_5":30485,"_20936":52337,"_27421":52338,"_2948":52339},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3464":1007,"_30135":1002,"_5":30485,"_20936":52341,"_27421":52342,"_2948":52343},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3464":1008,"_30135":1002,"_5":30485,"_20936":52345,"_27421":52346,"_2948":52347},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3464":1009,"_30135":1002,"_5":30485,"_20936":52349,"_27421":52350,"_2948":52351},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3464":1010,"_30135":1002,"_20936":52353,"_5":14366,"_27421":1002,"_2948":52354},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3464":1011,"_30135":1002,"_20936":52356,"_5":14366,"_27421":52331,"_2948":52357},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3464":1012,"_30135":1002,"_20936":52359,"_5":14366,"_27421":52331,"_2948":52360},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3464":1013,"_30135":1002,"_20936":52362,"_5":14366,"_27421":52331,"_2948":52363},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3464":1014,"_30135":1002,"_20936":52365,"_5":14366,"_27421":52334,"_2948":52366},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3464":1015,"_30135":1002,"_20936":52368,"_5":14366,"_27421":52334,"_2948":52369},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3464":1016,"_30135":1002,"_20936":52371,"_5":14366,"_27421":52338,"_2948":52372},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3464":1017,"_30135":1002,"_20936":52374,"_5":14366,"_27421":52338,"_2948":52375},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3464":1018,"_30135":1002,"_20936":52377,"_5":14366,"_27421":52342,"_2948":52378},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3464":1019,"_30135":1002,"_20936":52380,"_5":14366,"_27421":52342,"_2948":52381},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3464":1020,"_30135":1002,"_20936":52383,"_5":14366,"_27421":52346,"_2948":52384},[],"For a root that issues directly:",{"_3464":1021,"_30135":1002,"_20936":52386,"_5":14366,"_27421":52346,"_2948":52387},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3464":1022,"_30135":1002,"_20936":52389,"_5":14366,"_27421":52346,"_2948":52390},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3464":1023,"_30135":1002,"_20936":52392,"_5":14366,"_27421":52350,"_2948":52393},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3464":1024,"_30135":1024,"_5":14718,"_2948":52395,"_30488":52396,"_20936":52397,"_27421":1024},"EST reference",[49202,50670,51684,51682,51865],[],{"_3464":1025,"_30135":1024,"_20936":52399,"_5":14366,"_27421":1024,"_2948":52400},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3464":1026,"_30135":1024,"_5":30485,"_20936":52402,"_27421":52403,"_2948":52404},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3464":1027,"_30135":1024,"_5":30485,"_20936":52406,"_27421":52407,"_2948":22687},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3464":1028,"_30135":1024,"_5":30485,"_20936":52409,"_27421":52410,"_2948":26036},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3464":1029,"_30135":1024,"_5":30485,"_20936":52412,"_27421":52413,"_2948":26043},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3464":1030,"_30135":1024,"_5":30485,"_20936":52415,"_27421":52416,"_2948":25362},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3464":1031,"_30135":1024,"_5":30485,"_20936":52418,"_27421":52419,"_2948":52420},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3464":1032,"_30135":1024,"_5":30485,"_20936":52422,"_27421":52423,"_2948":52424},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3464":1033,"_30135":1024,"_5":30485,"_20936":52426,"_27421":52427,"_2948":52428},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3464":1034,"_30135":1024,"_20936":52430,"_5":14366,"_27421":1024,"_2948":52431},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3464":1035,"_30135":1024,"_20936":52433,"_5":14366,"_27421":52403,"_2948":52434},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3464":1036,"_30135":1024,"_20936":52436,"_5":14366,"_27421":52403,"_2948":52437},[],"Operation",{"_3464":1037,"_30135":1024,"_20936":52439,"_5":14366,"_27421":52403,"_2948":52440},[],"Method",{"_3464":1038,"_30135":1024,"_20936":52442,"_5":14366,"_27421":52403,"_2948":52443},[],"Authentication and condition",{"_3464":1039,"_30135":1024,"_20936":52445,"_5":14366,"_27421":52403,"_2948":52446},[],"`/cacerts`",{"_3464":1040,"_30135":1024,"_20936":52448,"_5":14366,"_27421":52403,"_2948":52449},[],"GET",{"_3464":1041,"_30135":1024,"_20936":52451,"_5":14366,"_27421":52403,"_2948":52452},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3464":1042,"_30135":1024,"_20936":52454,"_5":14366,"_27421":52403,"_2948":52455},[],"`/simpleenroll`",{"_3464":1043,"_30135":1024,"_20936":52457,"_5":14366,"_27421":52403,"_2948":52458},[],"POST",{"_3464":1044,"_30135":1024,"_20936":52460,"_5":14366,"_27421":52403,"_2948":52461},[],"Initial authentication and DMS registration/replacement policy.",{"_3464":1045,"_30135":1024,"_20936":52463,"_5":14366,"_27421":52403,"_2948":52464},[],"`/simplereenroll`",{"_3464":1046,"_30135":1024,"_20936":52466,"_5":14366,"_27421":52403,"_2948":52458},[],{"_3464":1047,"_30135":1024,"_20936":52468,"_5":14366,"_27421":52403,"_2948":52469},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3464":1048,"_30135":1024,"_20936":52471,"_5":14366,"_27421":52403,"_2948":52472},[],"`/serverkeygen`",{"_3464":1049,"_30135":1024,"_20936":52474,"_5":14366,"_27421":52403,"_2948":52458},[],{"_3464":1050,"_30135":1024,"_20936":52476,"_5":14366,"_27421":52403,"_2948":52477},[],"Initial authentication and admission; server generation enabled.",{"_3464":1051,"_30135":1024,"_20936":52479,"_5":14366,"_27421":52403,"_2948":52480},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3464":1052,"_30135":1024,"_20936":52482,"_5":14366,"_27421":52407,"_2948":52483},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3464":1053,"_30135":1024,"_20936":52485,"_5":14366,"_27421":52407,"_2948":52486},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3464":1054,"_30135":1024,"_20936":52488,"_5":14366,"_27421":52410,"_2948":52489},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3464":1055,"_30135":1024,"_20936":52491,"_5":14366,"_27421":52410,"_2948":52492},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3464":1056,"_30135":1024,"_20936":52494,"_5":14366,"_27421":52413,"_2948":52495},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3464":1057,"_30135":1024,"_20936":52497,"_5":14366,"_27421":52413,"_2948":52498},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3464":1058,"_30135":1024,"_20936":52500,"_5":14366,"_27421":52416,"_2948":52501},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3464":1059,"_30135":1024,"_20936":52503,"_5":14366,"_27421":52416,"_2948":52504},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3464":1060,"_30135":1024,"_20936":52506,"_5":14366,"_27421":52419,"_2948":52507},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3464":1061,"_30135":1024,"_20936":52509,"_5":14366,"_27421":52419,"_2948":52510},[],"Part",{"_3464":1062,"_30135":1024,"_20936":52512,"_5":14366,"_27421":52419,"_2948":52513},[],"Content after decoding its Base64",{"_3464":1063,"_30135":1024,"_20936":52515,"_5":14366,"_27421":52419,"_2948":52516},[],"`application/pkcs8`",{"_3464":1064,"_30135":1024,"_20936":52518,"_5":14366,"_27421":52419,"_2948":52519},[],"Unencrypted DER PKCS#8 private key.",{"_3464":1065,"_30135":1024,"_20936":52521,"_5":14366,"_27421":52419,"_2948":52522},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3464":1066,"_30135":1024,"_20936":52524,"_5":14366,"_27421":52419,"_2948":52525},[],"DER PKCS#7 containing the issued certificate.",{"_3464":1067,"_30135":1024,"_20936":52527,"_5":14366,"_27421":52419,"_2948":52528},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3464":1068,"_30135":1024,"_20936":52530,"_5":14366,"_27421":52423,"_2948":52531},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3464":1069,"_30135":1024,"_20936":52533,"_5":14366,"_27421":52423,"_2948":52534},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3464":1070,"_30135":1024,"_20936":52536,"_5":14366,"_27421":52423,"_2948":52537},[],"Convert and check the result:",{"_3464":1071,"_30135":1024,"_20936":52539,"_5":14366,"_27421":52423,"_2948":52540},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3464":1072,"_30135":1024,"_20936":52542,"_5":14366,"_27421":52427,"_2948":52543},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3464":1073,"_30135":1024,"_20936":52545,"_5":14366,"_27421":52427,"_2948":52546},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3464":1074,"_30135":1074,"_5":14718,"_2948":51865,"_30488":52548,"_20936":52549,"_27421":1074},[49202,50670,51684,51682,51865],[],{"_3464":1075,"_30135":1074,"_20936":52551,"_5":14366,"_27421":1074,"_2948":52552},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3464":1076,"_30135":1074,"_5":30485,"_20936":52554,"_27421":52555,"_2948":52556},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3464":1077,"_30135":1074,"_5":30485,"_20936":52558,"_27421":52559,"_2948":52560},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3464":1078,"_30135":1074,"_5":30485,"_20936":52562,"_27421":52563,"_2948":52564},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3464":1079,"_30135":1074,"_5":30485,"_20936":52566,"_27421":52567,"_2948":52568},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3464":1080,"_30135":1074,"_20936":52570,"_5":14366,"_27421":1074,"_2948":52571},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3464":1081,"_30135":1074,"_20936":52573,"_5":14366,"_27421":52555,"_2948":52574},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3464":1082,"_30135":1074,"_20936":52576,"_5":14366,"_27421":52555,"_2948":52577},[],"The integrator installs initial EST server trust and an admission credential.",{"_3464":1083,"_30135":1074,"_20936":52579,"_5":14366,"_27421":52555,"_2948":52580},[],"The client requests an identity for its `Device ID` through EST.",{"_3464":1084,"_30135":1074,"_20936":52582,"_5":14366,"_27421":52555,"_2948":52583},[],"Certificate, device binding and key/certificate installation are checked.",{"_3464":1085,"_30135":1074,"_20936":52585,"_5":14366,"_27421":52555,"_2948":52586},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3464":1086,"_30135":1074,"_20936":52588,"_5":14366,"_27421":52555,"_2948":52589},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3464":1087,"_30135":1074,"_20936":52591,"_5":14366,"_27421":52559,"_2948":52592},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3464":1088,"_30135":1074,"_20936":52594,"_5":14366,"_27421":52559,"_2948":52595},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":1089,"_30135":1074,"_20936":52597,"_5":14366,"_27421":52559,"_2948":52598},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3464":1090,"_30135":1074,"_20936":52600,"_5":14366,"_27421":52559,"_2948":52601},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3464":1091,"_30135":1074,"_20936":52603,"_5":14366,"_27421":52563,"_2948":52604},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3464":1092,"_30135":1074,"_20936":52606,"_5":14366,"_27421":52563,"_2948":52607},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3464":1093,"_30135":1074,"_20936":52609,"_5":14366,"_27421":52563,"_2948":52610},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3464":1094,"_30135":1074,"_20936":52612,"_5":14366,"_27421":52563,"_2948":52613},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3464":1095,"_30135":1074,"_20936":52615,"_5":14366,"_27421":52567,"_2948":52616},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3464":1096,"_30135":1074,"_20936":52618,"_5":14366,"_27421":52567,"_2948":52619},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3464":1097,"_30135":1097,"_5":14718,"_2948":52621,"_30488":52622,"_20936":52623,"_27421":1097},"Provisioning strategies",[49202,50670,51684,51682,51865],[],{"_3464":1098,"_30135":1097,"_20936":52625,"_5":14366,"_27421":1097,"_2948":52626},[],"Choose device registration, identity authorization and key generation.",{"_3464":1099,"_30135":1097,"_5":30485,"_20936":52628,"_27421":52629,"_2948":52630},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3464":1100,"_30135":1097,"_5":30485,"_20936":52632,"_27421":52633,"_2948":52634},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3464":1101,"_30135":1097,"_5":30485,"_20936":52636,"_27421":52637,"_2948":52638},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3464":1102,"_30135":1097,"_5":30485,"_20936":52640,"_27421":52641,"_2948":52642},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3464":1103,"_30135":1097,"_5":30485,"_20936":52644,"_27421":52645,"_2948":52646},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3464":1104,"_30135":1097,"_20936":52648,"_5":14366,"_27421":1097,"_2948":52649},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3464":1105,"_30135":1097,"_20936":52651,"_5":14366,"_27421":52629,"_2948":52652},[],"Path",{"_3464":1106,"_30135":1097,"_20936":52654,"_5":14366,"_27421":52629,"_2948":52655},[],"When the device exists",{"_3464":1107,"_30135":1097,"_20936":52657,"_5":14366,"_27421":52629,"_2948":52658},[],"What to check",{"_3464":1108,"_30135":1097,"_20936":52660,"_5":14366,"_27421":52629,"_2948":52661},[],"Manual assignment",{"_3464":1109,"_30135":1097,"_20936":52663,"_5":14366,"_27421":52629,"_2948":52664},[],"An operator creates it before associating a certificate.",{"_3464":1110,"_30135":1097,"_20936":52666,"_5":14366,"_27421":52629,"_2948":52667},[],"ID, owning DMS, certificate CN and bound serial.",{"_3464":1111,"_30135":1097,"_20936":52669,"_5":14366,"_27421":52629,"_2948":52670},[],"EST with `JITP`",{"_3464":1112,"_30135":1097,"_20936":52672,"_5":14366,"_27421":52629,"_2948":52673},[],"Created for an unknown CN during `/simpleenroll`.",{"_3464":1113,"_30135":1097,"_20936":52675,"_5":14366,"_27421":52629,"_2948":52676},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3464":1114,"_30135":1097,"_20936":52678,"_5":14366,"_27421":52629,"_2948":52679},[],"EST with `PRE_REGISTRATION`",{"_3464":1115,"_30135":1097,"_20936":52681,"_5":14366,"_27421":52629,"_2948":52682},[],"Must exist before `/simpleenroll`.",{"_3464":1116,"_30135":1097,"_20936":52684,"_5":14366,"_27421":52629,"_2948":52685},[],"Approved record, same DMS and replacement conditions for your version.",{"_3464":1117,"_30135":1097,"_20936":52687,"_5":14366,"_27421":52629,"_2948":52688},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3464":1118,"_30135":1097,"_20936":52690,"_5":14366,"_27421":52629,"_2948":52691},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3464":1119,"_30135":1097,"_20936":52693,"_5":14366,"_27421":52633,"_2948":52694},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3464":1120,"_30135":1097,"_20936":52696,"_5":14366,"_27421":52633,"_2948":52697},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3464":1121,"_30135":1097,"_20936":52699,"_5":14366,"_27421":52633,"_2948":52700},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3464":1122,"_30135":1097,"_20936":52702,"_5":14366,"_27421":52637,"_2948":52703},[],"Decide initial enrollment and re-enrollment separately:",{"_3464":1123,"_30135":1097,"_20936":52705,"_5":14366,"_27421":52637,"_2948":52706},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3464":1124,"_30135":1097,"_20936":52708,"_5":14366,"_27421":52637,"_2948":52709},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3464":1125,"_30135":1097,"_20936":52711,"_5":14366,"_27421":52637,"_2948":52712},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3464":1126,"_30135":1097,"_20936":52714,"_5":14366,"_27421":52637,"_2948":52715},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3464":1127,"_30135":1097,"_20936":52717,"_5":14366,"_27421":52637,"_2948":52718},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3464":1128,"_30135":1097,"_20936":52720,"_5":14366,"_27421":52641,"_2948":49586},[],{"_3464":1129,"_30135":1097,"_20936":52722,"_5":14366,"_27421":52641,"_2948":52723},[],"Material crossing EST",{"_3464":1130,"_30135":1097,"_20936":52725,"_5":14366,"_27421":52641,"_2948":52726},[],"Device-generated key",{"_3464":1131,"_30135":1097,"_20936":52728,"_5":14366,"_27421":52641,"_2948":52729},[],"Public CSR and certificate; the key stays on the client.",{"_3464":1132,"_30135":1097,"_20936":52731,"_5":14366,"_27421":52641,"_2948":52732},[],"Existing device key",{"_3464":1133,"_30135":1097,"_20936":52734,"_5":14366,"_27421":52641,"_2948":52735},[],"CSR signed with that key and a new certificate.",{"_3464":1134,"_30135":1097,"_20936":52737,"_5":14366,"_27421":52641,"_2948":52003},[],{"_3464":1135,"_30135":1097,"_20936":52739,"_5":14366,"_27421":52641,"_2948":52740},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3464":1136,"_30135":1097,"_20936":52742,"_5":14366,"_27421":52641,"_2948":52743},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3464":1137,"_30135":1097,"_20936":52745,"_5":14366,"_27421":52645,"_2948":52746},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3464":1138,"_30135":1138,"_5":14718,"_2948":52748,"_30488":52749,"_20936":52750,"_27421":1138},"Renewal and recovery",[49202,50670,51684,51682,51865],[],{"_3464":1139,"_30135":1138,"_20936":52752,"_5":14366,"_27421":1138,"_2948":52753},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3464":1140,"_30135":1138,"_5":30485,"_20936":52755,"_27421":52756,"_2948":52757},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3464":1141,"_30135":1138,"_5":30485,"_20936":52759,"_27421":52760,"_2948":52761},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3464":1142,"_30135":1138,"_5":30485,"_20936":52763,"_27421":52764,"_2948":52765},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3464":1143,"_30135":1138,"_5":30485,"_20936":52767,"_27421":52768,"_2948":52769},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3464":1144,"_30135":1138,"_5":30485,"_20936":52771,"_27421":52772,"_2948":52773},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3464":1145,"_30135":1138,"_20936":52775,"_5":14366,"_27421":1138,"_2948":52776},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3464":1146,"_30135":1138,"_20936":52778,"_5":14366,"_27421":52756,"_2948":52779},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3464":1147,"_30135":1138,"_20936":52781,"_5":14366,"_27421":52756,"_2948":52782},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3464":1148,"_30135":1138,"_20936":52784,"_5":14366,"_27421":52756,"_2948":52785},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3464":1149,"_30135":1138,"_20936":52787,"_5":14366,"_27421":52756,"_2948":52788},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3464":1150,"_30135":1138,"_20936":52790,"_5":14366,"_27421":52760,"_2948":52791},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3464":1151,"_30135":1138,"_20936":52793,"_5":14366,"_27421":52760,"_2948":52794},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3464":1152,"_30135":1138,"_20936":52796,"_5":14366,"_27421":52764,"_2948":52797},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3464":1153,"_30135":1138,"_20936":52799,"_5":14366,"_27421":52764,"_2948":52800},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3464":1154,"_30135":1138,"_20936":52802,"_5":14366,"_27421":52764,"_2948":52803},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3464":1155,"_30135":1138,"_20936":52805,"_5":14366,"_27421":52768,"_2948":52806},[],"Situation",{"_3464":1156,"_30135":1138,"_20936":52808,"_5":14366,"_27421":52768,"_2948":52809},[],"Procedure",{"_3464":1157,"_30135":1138,"_20936":52811,"_5":14366,"_27421":52768,"_2948":52812},[],"Valid certificate, outside the window",{"_3464":1158,"_30135":1138,"_20936":52814,"_5":14366,"_27421":52768,"_2948":52815},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3464":1159,"_30135":1138,"_20936":52817,"_5":14366,"_27421":52768,"_2948":52818},[],"Expired certificate, key available",{"_3464":1160,"_30135":1138,"_20936":52820,"_5":14366,"_27421":52768,"_2948":52821},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3464":1161,"_30135":1138,"_20936":52823,"_5":14366,"_27421":52768,"_2948":52824},[],"Renewal through webhook or `NO_AUTH`",{"_3464":1162,"_30135":1138,"_20936":52826,"_5":14366,"_27421":52768,"_2948":52827},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3464":1163,"_30135":1138,"_20936":52829,"_5":14366,"_27421":52768,"_2948":52830},[],"Lost or inaccessible key",{"_3464":1164,"_30135":1138,"_20936":52832,"_5":14366,"_27421":52768,"_2948":52833},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3464":1165,"_30135":1138,"_20936":52835,"_5":14366,"_27421":52768,"_2948":52836},[],"Current identity revoked",{"_3464":1166,"_30135":1138,"_20936":52838,"_5":14366,"_27421":52768,"_2948":52839},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3464":1167,"_30135":1138,"_20936":52841,"_5":14366,"_27421":52768,"_2948":52842},[],"Device without an identity",{"_3464":1168,"_30135":1138,"_20936":52844,"_5":14366,"_27421":52768,"_2948":52845},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3464":1169,"_30135":1138,"_20936":52847,"_5":14366,"_27421":52768,"_2948":52848},[],"Retired device",{"_3464":1170,"_30135":1138,"_20936":52850,"_5":14366,"_27421":52768,"_2948":52851},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3464":1171,"_30135":1138,"_20936":52853,"_5":14366,"_27421":52768,"_2948":52854},[],"Timeout, HTTP 500 or installation failure",{"_3464":1172,"_30135":1138,"_20936":52856,"_5":14366,"_27421":52768,"_2948":52857},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3464":1173,"_30135":1138,"_20936":52859,"_5":14366,"_27421":52772,"_2948":52860},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3464":1174,"_30135":1138,"_20936":52862,"_5":14366,"_27421":52772,"_2948":52863},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3464":1175,"_30135":1175,"_5":14718,"_2948":52865,"_30488":52866,"_20936":52867,"_27421":1175},"Enrollment troubleshooting",[49202,50670,51684,51682,51865],[],{"_3464":1176,"_30135":1175,"_20936":52869,"_5":14366,"_27421":1175,"_2948":52870},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3464":1177,"_30135":1175,"_5":30485,"_20936":52872,"_27421":52873,"_2948":52874},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3464":1178,"_30135":1175,"_5":30485,"_20936":52876,"_27421":52877,"_2948":52878},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3464":1179,"_30135":1175,"_5":30485,"_20936":52880,"_27421":52881,"_2948":52428},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3464":1180,"_30135":1175,"_5":30485,"_20936":52883,"_27421":52884,"_2948":52885},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3464":1181,"_30135":1175,"_20936":52887,"_5":14366,"_27421":1175,"_2948":52888},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3464":1182,"_30135":1175,"_20936":52890,"_5":14366,"_27421":52877,"_2948":52891},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3464":1183,"_30135":1175,"_20936":52893,"_5":14366,"_27421":52877,"_2948":52894},[],"Symptom or message",{"_3464":1184,"_30135":1175,"_20936":52896,"_5":14366,"_27421":52877,"_2948":52658},[],{"_3464":1185,"_30135":1175,"_20936":52898,"_5":14366,"_27421":52877,"_2948":52899},[],"curl rejects TLS, name or issuer",{"_3464":1186,"_30135":1175,"_20936":52901,"_5":14366,"_27421":52877,"_2948":52902},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3464":1187,"_30135":1175,"_20936":52904,"_5":14366,"_27421":52877,"_2948":52905},[],"404 or missing APS",{"_3464":1188,"_30135":1175,"_20936":52907,"_5":14366,"_27421":52877,"_2948":52908},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3464":1189,"_30135":1175,"_20936":52910,"_5":14366,"_27421":52877,"_2948":52911},[],"400, CSR or format error",{"_3464":1190,"_30135":1175,"_20936":52913,"_5":14366,"_27421":52877,"_2948":52914},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3464":1191,"_30135":1175,"_20936":52916,"_5":14366,"_27421":52877,"_2948":52917},[],"Missing credential or invalid certificate",{"_3464":1192,"_30135":1175,"_20936":52919,"_5":14366,"_27421":52877,"_2948":52920},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3464":1193,"_30135":1175,"_20936":52922,"_5":14366,"_27421":52877,"_2948":52923},[],"Webhook denies, times out or responds without authorization",{"_3464":1194,"_30135":1175,"_20936":52925,"_5":14366,"_27421":52877,"_2948":52926},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3464":1195,"_30135":1175,"_20936":52928,"_5":14366,"_27421":52877,"_2948":52929},[],"`unexpected status code: <n>: redirects are not followed`",{"_3464":1196,"_30135":1175,"_20936":52931,"_5":14366,"_27421":52877,"_2948":52932},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3464":1197,"_30135":1175,"_20936":52934,"_5":14366,"_27421":52877,"_2948":52935},[],"`webhook response exceeds 1048576 bytes`",{"_3464":1198,"_30135":1175,"_20936":52937,"_5":14366,"_27421":52877,"_2948":52938},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3464":1199,"_30135":1175,"_20936":52940,"_5":14366,"_27421":52877,"_2948":52941},[],"`webhook config must not reference files`",{"_3464":1200,"_30135":1175,"_20936":52943,"_5":14366,"_27421":52877,"_2948":52944},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3464":1201,"_30135":1175,"_20936":52946,"_5":14366,"_27421":52877,"_2948":52947},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3464":1202,"_30135":1175,"_20936":52949,"_5":14366,"_27421":52877,"_2948":52950},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3464":1203,"_30135":1175,"_20936":52952,"_5":14366,"_27421":52877,"_2948":52953},[],"`webhook mTLS certificate and key are invalid: …`",{"_3464":1204,"_30135":1175,"_20936":52955,"_5":14366,"_27421":52877,"_2948":52956},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3464":1205,"_30135":1175,"_20936":52958,"_5":14366,"_27421":52877,"_2948":52959},[],"400 `struct validation error` creating or updating a DMS",{"_3464":1206,"_30135":1175,"_20936":52961,"_5":14366,"_27421":52877,"_2948":52962},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3464":1207,"_30135":1175,"_20936":52964,"_5":14366,"_27421":52877,"_2948":52965},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3464":1208,"_30135":1175,"_20936":52967,"_5":14366,"_27421":52877,"_2948":52968},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3464":1209,"_30135":1175,"_20936":52970,"_5":14366,"_27421":52877,"_2948":52971},[],"`device not preregistered`",{"_3464":1210,"_30135":1175,"_20936":52973,"_5":14366,"_27421":52877,"_2948":52974},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3464":1211,"_30135":1175,"_20936":52976,"_5":14366,"_27421":52877,"_2948":52977},[],"`forbiddenNewEnrollment`",{"_3464":1212,"_30135":1175,"_20936":52979,"_5":14366,"_27421":52877,"_2948":52980},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3464":1213,"_30135":1175,"_20936":52982,"_5":14366,"_27421":52877,"_2948":52983},[],"Different owning DMS",{"_3464":1214,"_30135":1175,"_20936":52985,"_5":14366,"_27421":52877,"_2948":52986},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3464":1215,"_30135":1175,"_20936":52988,"_5":14366,"_27421":52877,"_2948":52989},[],"`invalid RawSubject bytes`",{"_3464":1216,"_30135":1175,"_20936":52991,"_5":14366,"_27421":52877,"_2948":52992},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3464":1217,"_30135":1175,"_20936":52994,"_5":14366,"_27421":52877,"_2948":52995},[],"`invalid reenroll window`",{"_3464":1218,"_30135":1175,"_20936":52997,"_5":14366,"_27421":52877,"_2948":52998},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3464":1219,"_30135":1175,"_20936":53000,"_5":14366,"_27421":52877,"_2948":53001},[],"Current certificate revoked",{"_3464":1220,"_30135":1175,"_20936":53003,"_5":14366,"_27421":52877,"_2948":53004},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3464":1221,"_30135":1175,"_20936":53006,"_5":14366,"_27421":52877,"_2948":53007},[],"CA, profile or signing error",{"_3464":1222,"_30135":1175,"_20936":53009,"_5":14366,"_27421":52877,"_2948":53010},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3464":1223,"_30135":1175,"_20936":53012,"_5":14366,"_27421":52877,"_2948":53013},[],"HTTP 200 without a device connection",{"_3464":1224,"_30135":1175,"_20936":53015,"_5":14366,"_27421":52877,"_2948":53016},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3464":1225,"_30135":1175,"_20936":53018,"_5":14366,"_27421":52877,"_2948":53019},[],"Timeout or error after issuance",{"_3464":1226,"_30135":1175,"_20936":53021,"_5":14366,"_27421":52877,"_2948":53022},[],"New certificates, current slot and previous identity's state before retrying.",{"_3464":1227,"_30135":1175,"_20936":53024,"_5":14366,"_27421":52881,"_2948":53025},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3464":1228,"_30135":1175,"_20936":53027,"_5":14366,"_27421":52881,"_2948":53028},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3464":1229,"_30135":1175,"_20936":53030,"_5":14366,"_27421":52884,"_2948":53031},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3464":1230,"_30135":1175,"_20936":53033,"_5":14366,"_27421":52884,"_2948":53034},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3464":1231,"_30135":1175,"_20936":53036,"_5":14366,"_27421":52884,"_2948":53037},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3464":1232,"_30135":1175,"_20936":53039,"_5":14366,"_27421":52884,"_2948":53040},[],"Make one request, save headers/body and query the device and certificates.",{"_3464":1233,"_30135":1175,"_20936":53042,"_5":14366,"_27421":52884,"_2948":53043},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3464":1234,"_30135":1175,"_20936":53045,"_5":14366,"_27421":52884,"_2948":53046},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3464":1235,"_30135":1175,"_20936":53048,"_5":14366,"_27421":52884,"_2948":53049},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3464":1236,"_30135":1236,"_5":14718,"_2948":53051,"_30488":53052,"_20936":53053,"_27421":1236},"Trust distribution and updates",[49202,50670,51684,51682,51865],[],{"_3464":1237,"_30135":1236,"_20936":53055,"_5":14366,"_27421":1236,"_2948":53056},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3464":1238,"_30135":1236,"_5":30485,"_20936":53058,"_27421":53059,"_2948":53060},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3464":1239,"_30135":1236,"_5":30485,"_20936":53062,"_27421":53063,"_2948":53064},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3464":1240,"_30135":1236,"_5":30485,"_20936":53066,"_27421":53067,"_2948":53068},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3464":1241,"_30135":1236,"_5":30485,"_20936":53070,"_27421":53071,"_2948":53072},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3464":1242,"_30135":1236,"_5":30485,"_20936":53074,"_27421":53075,"_2948":53076},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3464":1243,"_30135":1236,"_20936":53078,"_5":14366,"_27421":1236,"_2948":53079},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3464":1244,"_30135":1236,"_20936":53081,"_5":14366,"_27421":53059,"_2948":53082},[],"Relationship",{"_3464":1245,"_30135":1236,"_20936":53084,"_5":14366,"_27421":53059,"_2948":53085},[],"Material prepared by its owner",{"_3464":1246,"_30135":1236,"_20936":53087,"_5":14366,"_27421":53059,"_2948":53088},[],"Device → EST server",{"_3464":1247,"_30135":1236,"_20936":53090,"_5":14366,"_27421":53059,"_2948":53091},[],"Previously verified server root, chain or pin and TLS name.",{"_3464":1248,"_30135":1236,"_20936":53093,"_5":14366,"_27421":53059,"_2948":53094},[],"DMS → requester",{"_3464":1249,"_30135":1236,"_20936":53096,"_5":14366,"_27421":53059,"_2948":53097},[],"CAs and rules authorizing initial or renewal credentials.",{"_3464":1250,"_30135":1236,"_20936":53099,"_5":14366,"_27421":53059,"_2948":53100},[],"Consumer → device",{"_3464":1251,"_30135":1236,"_20936":53102,"_5":14366,"_27421":53059,"_2948":53103},[],"Operational identity roots, intermediates, validation and permissions.",{"_3464":1252,"_30135":1236,"_20936":53105,"_5":14366,"_27421":53059,"_2948":53106},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3464":1253,"_30135":1236,"_20936":53108,"_5":14366,"_27421":53063,"_2948":53109},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3464":1254,"_30135":1236,"_20936":53111,"_5":14366,"_27421":53063,"_2948":53112},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3464":1255,"_30135":1236,"_20936":53114,"_5":14366,"_27421":53067,"_2948":53115},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3464":1256,"_30135":1236,"_20936":53117,"_5":14366,"_27421":53067,"_2948":53118},[],"Select policy-approved roots as anchors.",{"_3464":1257,"_30135":1236,"_20936":53120,"_5":14366,"_27421":53067,"_2948":53121},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3464":1258,"_30135":1236,"_20936":53123,"_5":14366,"_27421":53067,"_2948":53124},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3464":1259,"_30135":1236,"_20936":53126,"_5":14366,"_27421":53067,"_2948":53127},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3464":1260,"_30135":1236,"_20936":53129,"_5":14366,"_27421":53067,"_2948":53130},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3464":1261,"_30135":1236,"_20936":53132,"_5":14366,"_27421":53071,"_2948":53133},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3464":1262,"_30135":1236,"_20936":53135,"_5":14366,"_27421":53071,"_2948":53136},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3464":1263,"_30135":1236,"_20936":53138,"_5":14366,"_27421":53071,"_2948":53139},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3464":1264,"_30135":1236,"_20936":53141,"_5":14366,"_27421":53075,"_2948":53142},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3464":1265,"_30135":1265,"_5":14718,"_2948":53144,"_30488":53145,"_20936":53147,"_27421":1265},"AWS IoT Core",[49202,50670,51684,51682,53146],"Integrations",[],{"_3464":1266,"_30135":1265,"_20936":53149,"_5":14366,"_27421":1265,"_2948":53150},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3464":1267,"_30135":1265,"_5":30485,"_20936":53152,"_27421":53153,"_2948":53154},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3464":1268,"_30135":1265,"_5":30485,"_20936":53156,"_27421":53157,"_2948":53158},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3464":1269,"_30135":1265,"_5":30485,"_20936":53160,"_27421":53161,"_2948":53162},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3464":1270,"_30135":1265,"_5":30485,"_20936":53164,"_27421":53165,"_2948":53166},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3464":1271,"_30135":1265,"_5":30485,"_20936":53168,"_27421":53169,"_2948":53170},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3464":1272,"_30135":1265,"_5":30485,"_20936":53172,"_27421":53173,"_2948":53174},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3464":1273,"_30135":1265,"_5":30485,"_20936":53176,"_27421":53177,"_2948":53178},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3464":1274,"_30135":1265,"_5":30485,"_20936":53180,"_27421":53181,"_2948":53182},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3464":1275,"_30135":1265,"_5":30485,"_20936":53184,"_27421":53185,"_2948":53186},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3464":1276,"_30135":1265,"_5":30485,"_20936":53188,"_27421":53189,"_2948":53190},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3464":1277,"_30135":1265,"_5":30485,"_20936":53192,"_27421":53193,"_2948":53194},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3464":1278,"_30135":1265,"_5":30485,"_20936":53196,"_27421":53197,"_2948":53198},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3464":1279,"_30135":1265,"_5":30485,"_20936":53200,"_27421":53201,"_2948":53202},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3464":1280,"_30135":1265,"_5":30485,"_20936":53204,"_27421":53205,"_2948":53206},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3464":1281,"_30135":1265,"_5":30485,"_20936":53208,"_27421":53209,"_2948":53210},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3464":1282,"_30135":1265,"_5":30485,"_20936":53212,"_27421":53213,"_2948":53214},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3464":1283,"_30135":1265,"_5":30485,"_20936":53216,"_27421":53217,"_2948":53218},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3464":1284,"_30135":1265,"_5":30485,"_20936":53220,"_27421":53221,"_2948":53222},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3464":1285,"_30135":1265,"_5":30485,"_20936":53224,"_27421":53225,"_2948":53226},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3464":1286,"_30135":1265,"_5":30485,"_20936":53228,"_27421":53229,"_2948":53230},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3464":1287,"_30135":1265,"_5":30485,"_20936":53232,"_27421":53233,"_2948":53234},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3464":1288,"_30135":1265,"_5":30485,"_20936":53236,"_27421":53237,"_2948":53238},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3464":1289,"_30135":1265,"_5":30485,"_20936":53240,"_27421":53241,"_2948":53242},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3464":1290,"_30135":1265,"_5":30485,"_20936":53244,"_27421":53245,"_2948":53246},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3464":1291,"_30135":1265,"_5":30485,"_20936":53248,"_27421":53249,"_2948":53250},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3464":1292,"_30135":1265,"_20936":53252,"_5":14366,"_27421":1265,"_2948":53253},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3464":1293,"_30135":1265,"_20936":53255,"_5":14366,"_27421":1265,"_2948":53256},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3464":1294,"_30135":1265,"_20936":53258,"_5":14366,"_27421":1265,"_2948":53259},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3464":1295,"_30135":1265,"_20936":53261,"_5":14366,"_27421":53153,"_2948":53262},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3464":1296,"_30135":1265,"_20936":53264,"_5":14366,"_27421":53153,"_2948":53265},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3464":1297,"_30135":1265,"_20936":53267,"_5":14366,"_27421":53153,"_2948":53268},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3464":1298,"_30135":1265,"_20936":53270,"_5":14366,"_27421":53153,"_2948":53271},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3464":1299,"_30135":1265,"_20936":53273,"_5":14366,"_27421":53157,"_2948":53274},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3464":1300,"_30135":1265,"_20936":53276,"_5":14366,"_27421":53161,"_2948":53277},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3464":1301,"_30135":1265,"_20936":53279,"_5":14366,"_27421":53161,"_2948":53280},[],"IAM action",{"_3464":1302,"_30135":1265,"_20936":53282,"_5":14366,"_27421":53161,"_2948":49592},[],{"_3464":1303,"_30135":1265,"_20936":53284,"_5":14366,"_27421":53161,"_2948":53285},[],"`iot:GetRegistrationCode`",{"_3464":1304,"_30135":1265,"_20936":53287,"_5":14366,"_27421":53161,"_2948":53288},[],"Obtain the verification code for CA registration in the Primary Account",{"_3464":1305,"_30135":1265,"_20936":53290,"_5":14366,"_27421":53161,"_2948":53291},[],"`iot:RegisterCACertificate`",{"_3464":1306,"_30135":1265,"_20936":53293,"_5":14366,"_27421":53161,"_2948":53294},[],"Register the CA in AWS IoT",{"_3464":1307,"_30135":1265,"_20936":53296,"_5":14366,"_27421":53161,"_2948":53297},[],"`iot:DescribeCACertificate`",{"_3464":1308,"_30135":1265,"_20936":53299,"_5":14366,"_27421":53161,"_2948":53300},[],"Check the CA registration status",{"_3464":1309,"_30135":1265,"_20936":53302,"_5":14366,"_27421":53161,"_2948":53303},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3464":1310,"_30135":1265,"_20936":53305,"_5":14366,"_27421":53161,"_2948":53306},[],"Create or update Things in IoT Core",{"_3464":1311,"_30135":1265,"_20936":53308,"_5":14366,"_27421":53161,"_2948":53309},[],"`iot:RegisterThing`",{"_3464":1312,"_30135":1265,"_20936":53311,"_5":14366,"_27421":53161,"_2948":53312},[],"Provision Things through a template",{"_3464":1313,"_30135":1265,"_20936":53314,"_5":14366,"_27421":53161,"_2948":53315},[],"`iot:RegisterCertificate`",{"_3464":1314,"_30135":1265,"_20936":53317,"_5":14366,"_27421":53161,"_2948":53318},[],"Register device certificates",{"_3464":1315,"_30135":1265,"_20936":53320,"_5":14366,"_27421":53161,"_2948":53321},[],"`iot:UpdateCertificate`",{"_3464":1316,"_30135":1265,"_20936":53323,"_5":14366,"_27421":53161,"_2948":53324},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3464":1317,"_30135":1265,"_20936":53326,"_5":14366,"_27421":53161,"_2948":53327},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3464":1318,"_30135":1265,"_20936":53329,"_5":14366,"_27421":53161,"_2948":53330},[],"Create and attach IoT policies",{"_3464":1319,"_30135":1265,"_20936":53332,"_5":14366,"_27421":53161,"_2948":53333},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3464":1320,"_30135":1265,"_20936":53335,"_5":14366,"_27421":53161,"_2948":53336},[],"Manage Thing groups",{"_3464":1321,"_30135":1265,"_20936":53338,"_5":14366,"_27421":53161,"_2948":53339},[],"`iot:CreateProvisioningTemplate`",{"_3464":1322,"_30135":1265,"_20936":53341,"_5":14366,"_27421":53161,"_2948":53342},[],"Create JITP templates",{"_3464":1323,"_30135":1265,"_20936":53344,"_5":14366,"_27421":53161,"_2948":53345},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3464":1324,"_30135":1265,"_20936":53347,"_5":14366,"_27421":53161,"_2948":53348},[],"Read and write the Device Shadow",{"_3464":1325,"_30135":1265,"_20936":53350,"_5":14366,"_27421":53161,"_2948":53351},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3464":1326,"_30135":1265,"_20936":53353,"_5":14366,"_27421":53165,"_2948":53354},[],"Parameter",{"_3464":1327,"_30135":1265,"_20936":53356,"_5":14366,"_27421":53165,"_2948":53357},[],"Type",{"_3464":1328,"_30135":1265,"_20936":53359,"_5":14366,"_27421":53165,"_2948":53360},[],"Required",{"_3464":1329,"_30135":1265,"_20936":53362,"_5":14366,"_27421":53165,"_2948":53363},[],"Description",{"_3464":1330,"_30135":1265,"_20936":53365,"_5":14366,"_27421":53165,"_2948":53366},[],"`connector_id`",{"_3464":1331,"_30135":1265,"_20936":53368,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1332,"_30135":1265,"_20936":53370,"_5":14366,"_27421":53165,"_2948":53371},[],"Yes",{"_3464":1333,"_30135":1265,"_20936":53373,"_5":14366,"_27421":53165,"_2948":53374},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3464":1334,"_30135":1265,"_20936":53376,"_5":14366,"_27421":53165,"_2948":53377},[],"`aws_config.region`",{"_3464":1335,"_30135":1265,"_20936":53379,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1336,"_30135":1265,"_20936":53381,"_5":14366,"_27421":53165,"_2948":53371},[],{"_3464":1337,"_30135":1265,"_20936":53383,"_5":14366,"_27421":53165,"_2948":53384},[],"AWS region where the connector operates.",{"_3464":1338,"_30135":1265,"_20936":53386,"_5":14366,"_27421":53165,"_2948":53387},[],"`aws_config.auth_method`",{"_3464":1339,"_30135":1265,"_20936":53389,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1340,"_30135":1265,"_20936":53391,"_5":14366,"_27421":53165,"_2948":53371},[],{"_3464":1341,"_30135":1265,"_20936":53393,"_5":14366,"_27421":53165,"_2948":53394},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3464":1342,"_30135":1265,"_20936":53396,"_5":14366,"_27421":53165,"_2948":53397},[],"`aws_config.access_key_id`",{"_3464":1343,"_30135":1265,"_20936":53399,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1344,"_30135":1265,"_20936":53401,"_5":14366,"_27421":53165,"_2948":53402},[],"Only with `auth_method=static`",{"_3464":1345,"_30135":1265,"_20936":53404,"_5":14366,"_27421":53165,"_2948":53405},[],"AWS access key.",{"_3464":1346,"_30135":1265,"_20936":53407,"_5":14366,"_27421":53165,"_2948":53408},[],"`aws_config.secret_access_key`",{"_3464":1347,"_30135":1265,"_20936":53410,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1348,"_30135":1265,"_20936":53412,"_5":14366,"_27421":53165,"_2948":53402},[],{"_3464":1349,"_30135":1265,"_20936":53414,"_5":14366,"_27421":53165,"_2948":53415},[],"AWS secret key.",{"_3464":1350,"_30135":1265,"_20936":53417,"_5":14366,"_27421":53165,"_2948":53418},[],"`aws_config.session_token`",{"_3464":1351,"_30135":1265,"_20936":53420,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1352,"_30135":1265,"_20936":53422,"_5":14366,"_27421":53165,"_2948":53423},[],"No",{"_3464":1353,"_30135":1265,"_20936":53425,"_5":14366,"_27421":53165,"_2948":53426},[],"Session token (with `auth_method=static`).",{"_3464":1354,"_30135":1265,"_20936":53428,"_5":14366,"_27421":53165,"_2948":53429},[],"`aws_config.role_arn`",{"_3464":1355,"_30135":1265,"_20936":53431,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1356,"_30135":1265,"_20936":53433,"_5":14366,"_27421":53165,"_2948":53434},[],"Only with `auth_method=role`",{"_3464":1357,"_30135":1265,"_20936":53436,"_5":14366,"_27421":53165,"_2948":53437},[],"ARN of the role to assume.",{"_3464":1358,"_30135":1265,"_20936":53439,"_5":14366,"_27421":53165,"_2948":53440},[],"`aws_config.endpoint_url`",{"_3464":1359,"_30135":1265,"_20936":53442,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1360,"_30135":1265,"_20936":53444,"_5":14366,"_27421":53165,"_2948":53423},[],{"_3464":1361,"_30135":1265,"_20936":53446,"_5":14366,"_27421":53165,"_2948":53447},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3464":1362,"_30135":1265,"_20936":53449,"_5":14366,"_27421":53165,"_2948":53450},[],"`subscriber_event_bus`",{"_3464":1363,"_30135":1265,"_20936":53452,"_5":14366,"_27421":53165,"_2948":17615},[],{"_3464":1364,"_30135":1265,"_20936":53454,"_5":14366,"_27421":53165,"_2948":53371},[],{"_3464":1365,"_30135":1265,"_20936":53456,"_5":14366,"_27421":53165,"_2948":53457},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3464":1366,"_30135":1265,"_20936":53459,"_5":14366,"_27421":53165,"_2948":53460},[],"`dms_manager_client`",{"_3464":1367,"_30135":1265,"_20936":53462,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1368,"_30135":1265,"_20936":53464,"_5":14366,"_27421":53165,"_2948":53371},[],{"_3464":1369,"_30135":1265,"_20936":53466,"_5":14366,"_27421":53165,"_2948":53467},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3464":1370,"_30135":1265,"_20936":53469,"_5":14366,"_27421":53165,"_2948":53470},[],"`device_manager_client`",{"_3464":1371,"_30135":1265,"_20936":53472,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1372,"_30135":1265,"_20936":53474,"_5":14366,"_27421":53165,"_2948":53371},[],{"_3464":1373,"_30135":1265,"_20936":53476,"_5":14366,"_27421":53165,"_2948":53477},[],"HTTP URL of Lamassu's Device Manager.",{"_3464":1374,"_30135":1265,"_20936":53479,"_5":14366,"_27421":53165,"_2948":53480},[],"`ca_client`",{"_3464":1375,"_30135":1265,"_20936":53482,"_5":14366,"_27421":53165,"_2948":25002},[],{"_3464":1376,"_30135":1265,"_20936":53484,"_5":14366,"_27421":53165,"_2948":53371},[],{"_3464":1377,"_30135":1265,"_20936":53486,"_5":14366,"_27421":53165,"_2948":53487},[],"HTTP URL of Lamassu's CA service.",{"_3464":1378,"_30135":1265,"_20936":53489,"_5":14366,"_27421":53169,"_2948":53490},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3464":1379,"_30135":1265,"_20936":53492,"_5":14366,"_27421":53169,"_2948":53493},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3464":1380,"_30135":1265,"_20936":53495,"_5":14366,"_27421":53169,"_2948":53496},[],"CloudEvent type",{"_3464":1381,"_30135":1265,"_20936":53498,"_5":14366,"_27421":53169,"_2948":53499},[],"Lamassu resource",{"_3464":1382,"_30135":1265,"_20936":53501,"_5":14366,"_27421":53169,"_2948":53502},[],"AWS Resource",{"_3464":1383,"_30135":1265,"_20936":53504,"_5":14366,"_27421":53169,"_2948":53505},[],"IAM actions",{"_3464":1384,"_30135":1265,"_20936":53507,"_5":14366,"_27421":53169,"_2948":53508},[],"AWS calls and effect",{"_3464":1385,"_30135":1265,"_20936":53510,"_5":14366,"_27421":53169,"_2948":53511},[],"Where in this page",{"_3464":1386,"_30135":1265,"_20936":53513,"_5":14366,"_27421":53169,"_2948":53514},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3464":1387,"_30135":1265,"_20936":53516,"_5":14366,"_27421":53169,"_2948":53517},[],"CA",{"_3464":1388,"_30135":1265,"_20936":53519,"_5":14366,"_27421":53169,"_2948":53520},[],"`IoTCore/CACertificate`",{"_3464":1389,"_30135":1265,"_20936":53522,"_5":14366,"_27421":53169,"_2948":53523},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3464":1390,"_30135":1265,"_20936":53525,"_5":14366,"_27421":53169,"_2948":53526},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3464":1391,"_30135":1265,"_20936":53528,"_5":14366,"_27421":53169,"_2948":53182},[],{"_3464":1392,"_30135":1265,"_20936":53530,"_5":14366,"_27421":53169,"_2948":53531},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3464":1393,"_30135":1265,"_20936":53533,"_5":14366,"_27421":53169,"_2948":53534},[],"DMS",{"_3464":1394,"_30135":1265,"_20936":53536,"_5":14366,"_27421":53169,"_2948":53537},[],"`IoTCore/ProvisioningTemplate`",{"_3464":1395,"_30135":1265,"_20936":53539,"_5":14366,"_27421":53169,"_2948":53540},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3464":1396,"_30135":1265,"_20936":53542,"_5":14366,"_27421":53169,"_2948":53543},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3464":1397,"_30135":1265,"_20936":53545,"_5":14366,"_27421":53169,"_2948":53210},[],{"_3464":1398,"_30135":1265,"_20936":53547,"_5":14366,"_27421":53169,"_2948":53548},[],"`EventBindDeviceIdentityKey`",{"_3464":1399,"_30135":1265,"_20936":53550,"_5":14366,"_27421":53169,"_2948":53551},[],"Device",{"_3464":1400,"_30135":1265,"_20936":53553,"_5":14366,"_27421":53169,"_2948":53554},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3464":1401,"_30135":1265,"_20936":53556,"_5":14366,"_27421":53169,"_2948":53557},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3464":1402,"_30135":1265,"_20936":53559,"_5":14366,"_27421":53169,"_2948":53560},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3464":1403,"_30135":1265,"_20936":53562,"_5":14366,"_27421":53169,"_2948":53218},[],{"_3464":1404,"_30135":1265,"_20936":53564,"_5":14366,"_27421":53169,"_2948":53565},[],"`EventUpdateCertificateStatusKey`",{"_3464":1405,"_30135":1265,"_20936":53567,"_5":14366,"_27421":53169,"_2948":53568},[],"Certificate",{"_3464":1406,"_30135":1265,"_20936":53570,"_5":14366,"_27421":53169,"_2948":53571},[],"`IoTCore/Certificate`",{"_3464":1407,"_30135":1265,"_20936":53573,"_5":14366,"_27421":53169,"_2948":53574},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3464":1408,"_30135":1265,"_20936":53576,"_5":14366,"_27421":53169,"_2948":53577},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3464":1409,"_30135":1265,"_20936":53579,"_5":14366,"_27421":53169,"_2948":53230},[],{"_3464":1410,"_30135":1265,"_20936":53581,"_5":14366,"_27421":53169,"_2948":53582},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3464":1411,"_30135":1265,"_20936":53584,"_5":14366,"_27421":53169,"_2948":53585},[],"Certificate / Device",{"_3464":1412,"_30135":1265,"_20936":53587,"_5":14366,"_27421":53169,"_2948":53588},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3464":1413,"_30135":1265,"_20936":53590,"_5":14366,"_27421":53169,"_2948":49598},[],{"_3464":1414,"_30135":1265,"_20936":53592,"_5":14366,"_27421":53169,"_2948":53593},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3464":1415,"_30135":1265,"_20936":53595,"_5":14366,"_27421":53169,"_2948":53238},[],{"_3464":1416,"_30135":1265,"_20936":53597,"_5":14366,"_27421":53173,"_2948":53598},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3464":1417,"_30135":1265,"_20936":53600,"_5":14366,"_27421":53177,"_2948":53601},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3464":1418,"_30135":1265,"_20936":53603,"_5":14366,"_27421":53177,"_2948":53604},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3464":1419,"_30135":1265,"_20936":53606,"_5":14366,"_27421":53181,"_2948":53607},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3464":1420,"_30135":1265,"_20936":53609,"_5":14366,"_27421":53181,"_2948":53610},[],"Transition",{"_3464":1421,"_30135":1265,"_20936":53612,"_5":14366,"_27421":53181,"_2948":53613},[],"AWS calls",{"_3464":1422,"_30135":1265,"_20936":53615,"_5":14366,"_27421":53181,"_2948":53616},[],"`NotRegistered` → `Requested`",{"_3464":1423,"_30135":1265,"_20936":53618,"_5":14366,"_27421":53181,"_2948":53619},[],"none (metadata write only)",{"_3464":1424,"_30135":1265,"_20936":53621,"_5":14366,"_27421":53181,"_2948":53622},[],"`Requested` → `Registering`",{"_3464":1425,"_30135":1265,"_20936":53624,"_5":14366,"_27421":53181,"_2948":53625},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3464":1426,"_30135":1265,"_20936":53627,"_5":14366,"_27421":53181,"_2948":53628},[],"`Registering` → `Succeeded`",{"_3464":1427,"_30135":1265,"_20936":53630,"_5":14366,"_27421":53181,"_2948":53631},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3464":1428,"_30135":1265,"_20936":53633,"_5":14366,"_27421":53181,"_2948":53634},[],"`Registering` → `Failed`",{"_3464":1429,"_30135":1265,"_20936":53636,"_5":14366,"_27421":53181,"_2948":53637},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3464":1430,"_30135":1265,"_20936":53639,"_5":14366,"_27421":53181,"_2948":53640},[],"`Failed` / `Succeeded` → `Requested`",{"_3464":1431,"_30135":1265,"_20936":53642,"_5":14366,"_27421":53181,"_2948":53643},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3464":1432,"_30135":1265,"_20936":53645,"_5":14366,"_27421":53185,"_2948":53646},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3464":1433,"_30135":1265,"_20936":53648,"_5":14366,"_27421":53185,"_2948":53649},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3464":1434,"_30135":1265,"_20936":53651,"_5":14366,"_27421":53185,"_2948":53652},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3464":1435,"_30135":1265,"_20936":53654,"_5":14366,"_27421":53185,"_2948":53655},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3464":1436,"_30135":1265,"_20936":53657,"_5":14366,"_27421":53185,"_2948":53658},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3464":1437,"_30135":1265,"_20936":53660,"_5":14366,"_27421":53185,"_2948":53661},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3464":1438,"_30135":1265,"_20936":53663,"_5":14366,"_27421":53189,"_2948":53664},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3464":1439,"_30135":1265,"_20936":53666,"_5":14366,"_27421":53193,"_2948":53667},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3464":1440,"_30135":1265,"_20936":53669,"_5":14366,"_27421":53193,"_2948":53670},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3464":1441,"_30135":1265,"_20936":53672,"_5":14366,"_27421":53197,"_2948":53673},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3464":1442,"_30135":1265,"_20936":53675,"_5":14366,"_27421":53201,"_2948":53676},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3464":1443,"_30135":1265,"_20936":53678,"_5":14366,"_27421":53201,"_2948":53679},[],"Creates or updates the IoT policies configured in the DMS.",{"_3464":1444,"_30135":1265,"_20936":53681,"_5":14366,"_27421":53201,"_2948":53682},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3464":1445,"_30135":1265,"_20936":53684,"_5":14366,"_27421":53201,"_2948":53685},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3464":1446,"_30135":1265,"_20936":53687,"_5":14366,"_27421":53201,"_2948":53688},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3464":1447,"_30135":1265,"_20936":53690,"_5":14366,"_27421":53201,"_2948":53691},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3464":1448,"_30135":1265,"_20936":53693,"_5":14366,"_27421":53201,"_2948":53694},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3464":1449,"_30135":1265,"_20936":53696,"_5":14366,"_27421":53205,"_2948":53697},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3464":1450,"_30135":1265,"_20936":53699,"_5":14366,"_27421":53205,"_2948":53700},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3464":1451,"_30135":1265,"_20936":53702,"_5":14366,"_27421":53205,"_2948":53703},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3464":1452,"_30135":1265,"_20936":53705,"_5":14366,"_27421":53205,"_2948":53706},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3464":1453,"_30135":1265,"_20936":53708,"_5":14366,"_27421":53205,"_2948":53709},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3464":1454,"_30135":1265,"_20936":53711,"_5":14366,"_27421":53209,"_2948":53712},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3464":1455,"_30135":1265,"_20936":53714,"_5":14366,"_27421":53209,"_2948":53610},[],{"_3464":1456,"_30135":1265,"_20936":53716,"_5":14366,"_27421":53209,"_2948":53613},[],{"_3464":1457,"_30135":1265,"_20936":53718,"_5":14366,"_27421":53209,"_2948":53719},[],"`Unconfigured` → `None` / `Auto`",{"_3464":1458,"_30135":1265,"_20936":53721,"_5":14366,"_27421":53209,"_2948":53722},[],"none (configuration only)",{"_3464":1459,"_30135":1265,"_20936":53724,"_5":14366,"_27421":53209,"_2948":53725},[],"`None` ↔ `Auto`",{"_3464":1460,"_30135":1265,"_20936":53727,"_5":14366,"_27421":53209,"_2948":53722},[],{"_3464":1461,"_30135":1265,"_20936":53729,"_5":14366,"_27421":53209,"_2948":53730},[],"Any → `Jitp`",{"_3464":1462,"_30135":1265,"_20936":53732,"_5":14366,"_27421":53209,"_2948":53733},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3464":1463,"_30135":1265,"_20936":53735,"_5":14366,"_27421":53209,"_2948":53736},[],"`Jitp` → `None` / `Auto`",{"_3464":1464,"_30135":1265,"_20936":53738,"_5":14366,"_27421":53209,"_2948":53739},[],"none (the template stays in the AWS account)",{"_3464":1465,"_30135":1265,"_20936":53741,"_5":14366,"_27421":53213,"_2948":53742},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3464":1466,"_30135":1265,"_20936":53744,"_5":14366,"_27421":53213,"_2948":53745},[],"The full flow from the device's perspective is:",{"_3464":1467,"_30135":1265,"_20936":53747,"_5":14366,"_27421":53213,"_2948":53748},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3464":1468,"_30135":1265,"_20936":53750,"_5":14366,"_27421":53217,"_2948":53751},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3464":1469,"_30135":1265,"_20936":53753,"_5":14366,"_27421":53217,"_2948":53610},[],{"_3464":1470,"_30135":1265,"_20936":53755,"_5":14366,"_27421":53217,"_2948":53613},[],{"_3464":1471,"_30135":1265,"_20936":53757,"_5":14366,"_27421":53217,"_2948":53758},[],"`Absent` → `Provisioned`",{"_3464":1472,"_30135":1265,"_20936":53760,"_5":14366,"_27421":53217,"_2948":53761},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3464":1473,"_30135":1265,"_20936":53763,"_5":14366,"_27421":53217,"_2948":53764},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3464":1474,"_30135":1265,"_20936":53766,"_5":14366,"_27421":53217,"_2948":53767},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3464":1475,"_30135":1265,"_20936":53769,"_5":14366,"_27421":53217,"_2948":53770},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3464":1476,"_30135":1265,"_20936":53772,"_5":14366,"_27421":53221,"_2948":53773},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3464":1477,"_30135":1265,"_20936":53775,"_5":14366,"_27421":53221,"_2948":53776},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3464":1478,"_30135":1265,"_20936":53778,"_5":14366,"_27421":53221,"_2948":53779},[],"For the JITP flow to work correctly:",{"_3464":1479,"_30135":1265,"_20936":53781,"_5":14366,"_27421":53221,"_2948":53782},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3464":1480,"_30135":1265,"_20936":53784,"_5":14366,"_27421":53221,"_2948":53785},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3464":1481,"_30135":1265,"_20936":53787,"_5":14366,"_27421":53221,"_2948":53788},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3464":1482,"_30135":1265,"_20936":53790,"_5":14366,"_27421":53221,"_2948":53791},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3464":1483,"_30135":1265,"_20936":53793,"_5":14366,"_27421":53225,"_2948":53794},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3464":1484,"_30135":1265,"_20936":53796,"_5":14366,"_27421":53225,"_2948":53797},[],"Status in Lamassu",{"_3464":1485,"_30135":1265,"_20936":53799,"_5":14366,"_27421":53225,"_2948":53800},[],"Revocation reason",{"_3464":1486,"_30135":1265,"_20936":53802,"_5":14366,"_27421":53225,"_2948":53803},[],"Status in AWS IoT Core",{"_3464":1487,"_30135":1265,"_20936":53805,"_5":14366,"_27421":53225,"_2948":53806},[],"`Active`",{"_3464":1488,"_30135":1265,"_20936":53808,"_5":14366,"_27421":53225,"_2948":53809},[],"None",{"_3464":1489,"_30135":1265,"_20936":53811,"_5":14366,"_27421":53225,"_2948":53812},[],"`ACTIVE`",{"_3464":1490,"_30135":1265,"_20936":53814,"_5":14366,"_27421":53225,"_2948":53815},[],"`Revoked`",{"_3464":1491,"_30135":1265,"_20936":53817,"_5":14366,"_27421":53225,"_2948":53818},[],"`certificateHold`",{"_3464":1492,"_30135":1265,"_20936":53820,"_5":14366,"_27421":53225,"_2948":53821},[],"`INACTIVE`",{"_3464":1493,"_30135":1265,"_20936":53823,"_5":14366,"_27421":53225,"_2948":53815},[],{"_3464":1494,"_30135":1265,"_20936":53825,"_5":14366,"_27421":53225,"_2948":53826},[],"Any other reason",{"_3464":1495,"_30135":1265,"_20936":53828,"_5":14366,"_27421":53225,"_2948":53829},[],"`REVOKED`",{"_3464":1496,"_30135":1265,"_20936":53831,"_5":14366,"_27421":53225,"_2948":53832},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3464":1497,"_30135":1265,"_20936":53834,"_5":14366,"_27421":53229,"_2948":53835},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3464":1498,"_30135":1265,"_20936":53837,"_5":14366,"_27421":53229,"_2948":53610},[],{"_3464":1499,"_30135":1265,"_20936":53839,"_5":14366,"_27421":53229,"_2948":53613},[],{"_3464":1500,"_30135":1265,"_20936":53841,"_5":14366,"_27421":53229,"_2948":53842},[],"`NotSynced` → `Active`",{"_3464":1501,"_30135":1265,"_20936":53844,"_5":14366,"_27421":53229,"_2948":53321},[],{"_3464":1502,"_30135":1265,"_20936":53846,"_5":14366,"_27421":53229,"_2948":53847},[],"`Active` → `Inactive`",{"_3464":1503,"_30135":1265,"_20936":53849,"_5":14366,"_27421":53229,"_2948":53850},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3464":1504,"_30135":1265,"_20936":53852,"_5":14366,"_27421":53229,"_2948":53853},[],"`Active` → `Revoked`",{"_3464":1505,"_30135":1265,"_20936":53855,"_5":14366,"_27421":53229,"_2948":53850},[],{"_3464":1506,"_30135":1265,"_20936":53857,"_5":14366,"_27421":53229,"_2948":53858},[],"`Inactive` / `Revoked` → `Active`",{"_3464":1507,"_30135":1265,"_20936":53860,"_5":14366,"_27421":53229,"_2948":53321},[],{"_3464":1508,"_30135":1265,"_20936":53862,"_5":14366,"_27421":53229,"_2948":53863},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3464":1509,"_30135":1265,"_20936":53865,"_5":14366,"_27421":53229,"_2948":53866},[],"none (these states are not synced to AWS)",{"_3464":1510,"_30135":1265,"_20936":53868,"_5":14366,"_27421":53233,"_2948":53869},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3464":1511,"_30135":1265,"_20936":53871,"_5":14366,"_27421":53233,"_2948":53872},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3464":1512,"_30135":1265,"_20936":53874,"_5":14366,"_27421":53233,"_2948":53875},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3464":1513,"_30135":1265,"_20936":53877,"_5":14366,"_27421":53237,"_2948":53878},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3464":1514,"_30135":1265,"_20936":53880,"_5":14366,"_27421":53237,"_2948":53881},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3464":1515,"_30135":1265,"_20936":53883,"_5":14366,"_27421":53241,"_2948":53884},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3464":1516,"_30135":1265,"_20936":53886,"_5":14366,"_27421":53241,"_2948":53887},[],"There are two action types:",{"_3464":1517,"_30135":1265,"_20936":53889,"_5":14366,"_27421":53241,"_2948":53890},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3464":1518,"_30135":1265,"_20936":53892,"_5":14366,"_27421":53241,"_2948":53893},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3464":1519,"_30135":1265,"_20936":53895,"_5":14366,"_27421":53241,"_2948":53896},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3464":1520,"_30135":1265,"_20936":53898,"_5":14366,"_27421":53245,"_2948":53899},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3464":1521,"_30135":1265,"_20936":53901,"_5":14366,"_27421":53245,"_2948":53902},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3464":1522,"_30135":1265,"_20936":53904,"_5":14366,"_27421":53245,"_2948":53905},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3464":1523,"_30135":1265,"_20936":53907,"_5":14366,"_27421":53249,"_2948":53908},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3464":1524,"_30135":1265,"_20936":53910,"_5":14366,"_27421":53249,"_2948":53911},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3464":1525,"_30135":1265,"_20936":53913,"_5":14366,"_27421":53249,"_2948":53914},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3464":1526,"_30135":1265,"_20936":53916,"_5":14366,"_27421":53249,"_2948":53917},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3464":1527,"_30135":1265,"_20936":53919,"_5":14366,"_27421":53249,"_2948":53920},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3464":1528,"_30135":1265,"_20936":53922,"_5":14366,"_27421":53249,"_2948":53923},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3464":1529,"_30135":1265,"_20936":53925,"_5":14366,"_27421":53249,"_2948":53926},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3464":1530,"_30135":1265,"_20936":53928,"_5":14366,"_27421":53249,"_2948":53929},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3464":1531,"_30135":1265,"_20936":53931,"_5":14366,"_27421":53249,"_2948":53932},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3464":1532,"_30135":1265,"_20936":53934,"_5":14366,"_27421":53249,"_2948":53935},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3464":1533,"_30135":1265,"_20936":53937,"_5":14366,"_27421":53249,"_2948":53938},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3464":1534,"_30135":1265,"_20936":53940,"_5":14366,"_27421":53249,"_2948":53941},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3464":1535,"_30135":1265,"_20936":53943,"_5":14366,"_27421":53249,"_2948":53944},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3464":1536,"_30135":1265,"_20936":53946,"_5":14366,"_27421":53249,"_2948":53947},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3464":1537,"_30135":1265,"_20936":53949,"_5":14366,"_27421":53249,"_2948":53950},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3464":1538,"_30135":1265,"_20936":53952,"_5":14366,"_27421":53249,"_2948":53953},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3464":1539,"_30135":1265,"_20936":53955,"_5":14366,"_27421":53249,"_2948":53956},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3464":1540,"_30135":1265,"_20936":53958,"_5":14366,"_27421":53249,"_2948":53959},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3464":1541,"_30135":1265,"_20936":53961,"_5":14366,"_27421":53249,"_2948":53962},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3464":1542,"_30135":1265,"_20936":53964,"_5":14366,"_27421":53249,"_2948":53965},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3464":1543,"_30135":1265,"_20936":53967,"_5":14366,"_27421":53249,"_2948":53968},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3464":1544,"_30135":1265,"_20936":53970,"_5":14366,"_27421":53249,"_2948":53971},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":1545,"_30135":1265,"_20936":53973,"_5":14366,"_27421":53249,"_2948":53974},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3464":1546,"_30135":1265,"_20936":53976,"_5":14366,"_27421":53249,"_2948":53977},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3464":1547,"_30135":1547,"_5":14718,"_2948":51684,"_30488":53979,"_20936":53980,"_27421":1547},[49202,50670,51684],[],{"_3464":1548,"_30135":1547,"_20936":53982,"_5":14366,"_27421":1547,"_2948":53983},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3464":1549,"_30135":1547,"_5":30485,"_20936":53985,"_27421":53986,"_2948":53987},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#start-here","Start here",{"_3464":1550,"_30135":1547,"_5":30485,"_20936":53989,"_27421":53990,"_2948":51682},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#devices-and-identities",{"_3464":1551,"_30135":1547,"_5":30485,"_20936":53992,"_27421":53993,"_2948":51865},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#enrollment-with-pki",{"_3464":1552,"_30135":1547,"_5":30485,"_20936":53995,"_27421":53996,"_2948":53146},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#integrations",{"_3464":1553,"_30135":1547,"_5":30485,"_20936":53998,"_27421":53999,"_2948":54000},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3464":1554,"_30135":1547,"_20936":54002,"_5":14366,"_27421":1547,"_2948":54003},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3464":1555,"_30135":1547,"_20936":54005,"_5":14366,"_27421":53986,"_2948":54006},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3464":1556,"_30135":1547,"_20936":54008,"_5":14366,"_27421":53986,"_2948":54009},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3464":1557,"_30135":1547,"_20936":54011,"_5":14366,"_27421":53990,"_2948":54012},[],"Resource",{"_3464":1558,"_30135":1547,"_20936":54014,"_5":14366,"_27421":53990,"_2948":54015},[],"What it represents",{"_3464":1559,"_30135":1547,"_20936":54017,"_5":14366,"_27421":53990,"_2948":54018},[],"**Device**",{"_3464":1560,"_30135":1547,"_20936":54020,"_5":14366,"_27421":53990,"_2948":54021},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3464":1561,"_30135":1547,"_20936":54023,"_5":14366,"_27421":53990,"_2948":54024},[],"**Identity**",{"_3464":1562,"_30135":1547,"_20936":54026,"_5":14366,"_27421":53990,"_2948":54027},[],"The device's association with its certificates: an active version and a history.",{"_3464":1563,"_30135":1547,"_20936":54029,"_5":14366,"_27421":53990,"_2948":54030},[],"**DMS**",{"_3464":1564,"_30135":1547,"_20936":54032,"_5":14366,"_27421":53990,"_2948":54033},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3464":1565,"_30135":1547,"_20936":54035,"_5":14366,"_27421":53990,"_2948":54036},[],"**Fleet**",{"_3464":1566,"_30135":1547,"_20936":54038,"_5":14366,"_27421":53990,"_2948":54039},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3464":1567,"_30135":1547,"_20936":54041,"_5":14366,"_27421":53990,"_2948":54042},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3464":1568,"_30135":1547,"_20936":54044,"_5":14366,"_27421":53990,"_2948":54045},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3464":1569,"_30135":1547,"_20936":54047,"_5":14366,"_27421":53993,"_2948":54048},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3464":1570,"_30135":1547,"_20936":54050,"_5":14366,"_27421":53993,"_2948":54051},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3464":1571,"_30135":1547,"_20936":54053,"_5":14366,"_27421":53993,"_2948":54054},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3464":1572,"_30135":1547,"_20936":54056,"_5":14366,"_27421":53993,"_2948":54057},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3464":1573,"_30135":1547,"_20936":54059,"_5":14366,"_27421":53993,"_2948":54060},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3464":1574,"_30135":1547,"_20936":54062,"_5":14366,"_27421":53993,"_2948":54063},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3464":1575,"_30135":1547,"_20936":54065,"_5":14366,"_27421":53993,"_2948":54066},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":1576,"_30135":1547,"_20936":54068,"_5":14366,"_27421":53993,"_2948":54069},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3464":1577,"_30135":1547,"_20936":54071,"_5":14366,"_27421":53996,"_2948":54072},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3464":1578,"_30135":1547,"_20936":54074,"_5":14366,"_27421":53996,"_2948":54075},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3464":1579,"_30135":1547,"_20936":54077,"_5":14366,"_27421":53999,"_2948":54078},[],"Participant",{"_3464":1580,"_30135":1547,"_20936":54080,"_5":14366,"_27421":53999,"_2948":54081},[],"Responsibility",{"_3464":1581,"_30135":1547,"_20936":54083,"_5":14366,"_27421":53999,"_2948":54084},[],"PKI administrator",{"_3464":1582,"_30135":1547,"_20936":54086,"_5":14366,"_27421":53999,"_2948":54087},[],"CA, issuance profile, chain and revocation publication.",{"_3464":1583,"_30135":1547,"_20936":54089,"_5":14366,"_27421":53999,"_2948":54090},[],"Provisioning administrator",{"_3464":1584,"_30135":1547,"_20936":54092,"_5":14366,"_27421":53999,"_2948":54093},[],"DMS, admission, authentication per operation and inventory.",{"_3464":1585,"_30135":1547,"_20936":54095,"_5":14366,"_27421":53999,"_2948":54096},[],"Device integrator",{"_3464":1586,"_30135":1547,"_20936":54098,"_5":14366,"_27421":53999,"_2948":54099},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3464":1587,"_30135":1547,"_20936":54101,"_5":14366,"_27421":53999,"_2948":54102},[],"Consumer integrator",{"_3464":1588,"_30135":1547,"_20936":54104,"_5":14366,"_27421":53999,"_2948":54105},[],"Trusted issuers, validation and device permissions in the destination.",{"_3464":1589,"_30135":1547,"_20936":54107,"_5":14366,"_27421":53999,"_2948":54108},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3464":1590,"_30135":1590,"_5":14718,"_2948":54110,"_30488":54111,"_20936":54113,"_27421":1590},"Enroll and connect your first device",[49202,50670,51684,54112],"Getting started",[],{"_3464":1591,"_30135":1590,"_20936":54115,"_5":14366,"_27421":1590,"_2948":54116},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3464":1592,"_30135":1590,"_5":30485,"_20936":54118,"_27421":54119,"_2948":49212},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3464":1593,"_30135":1590,"_5":30485,"_20936":54121,"_27421":54122,"_2948":54123},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3464":1594,"_30135":1590,"_5":30485,"_20936":54125,"_27421":54126,"_2948":54127},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3464":1595,"_30135":1590,"_5":30485,"_20936":54129,"_27421":54130,"_2948":54131},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3464":1596,"_30135":1590,"_5":30485,"_20936":54133,"_27421":54134,"_2948":54135},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3464":1597,"_30135":1590,"_5":30485,"_20936":54137,"_27421":54138,"_2948":54139},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3464":1598,"_30135":1590,"_5":30485,"_20936":54141,"_27421":54142,"_2948":54143},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3464":1599,"_30135":1590,"_5":30485,"_20936":54145,"_27421":54146,"_2948":54147},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3464":1600,"_30135":1590,"_20936":54149,"_5":14366,"_27421":1590,"_2948":54150},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3464":1601,"_30135":1590,"_20936":54152,"_5":14366,"_27421":54119,"_2948":54153},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3464":1602,"_30135":1590,"_20936":54155,"_5":14366,"_27421":54119,"_2948":54156},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3464":1603,"_30135":1590,"_20936":54158,"_5":14366,"_27421":54119,"_2948":54159},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3464":1604,"_30135":1590,"_20936":54161,"_5":14366,"_27421":54119,"_2948":54162},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3464":1605,"_30135":1590,"_20936":54164,"_5":14366,"_27421":54119,"_2948":54165},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3464":1606,"_30135":1590,"_20936":54167,"_5":14366,"_27421":54122,"_2948":54168},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3464":1607,"_30135":1590,"_20936":54170,"_5":14366,"_27421":54122,"_2948":54171},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3464":1608,"_30135":1590,"_20936":54173,"_5":14366,"_27421":54126,"_2948":54174},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3464":1609,"_30135":1590,"_20936":54176,"_5":14366,"_27421":54126,"_2948":54177},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3464":1610,"_30135":1590,"_20936":54179,"_5":14366,"_27421":54126,"_2948":54180},[],"Setting",{"_3464":1611,"_30135":1590,"_20936":54182,"_5":14366,"_27421":54126,"_2948":54183},[],"Evaluation value",{"_3464":1612,"_30135":1590,"_20936":54185,"_5":14366,"_27421":54126,"_2948":54186},[],"Enrollment CA",{"_3464":1613,"_30135":1590,"_20936":54188,"_5":14366,"_27421":54126,"_2948":54189},[],"Issuing root from `device-root.pem`.",{"_3464":1614,"_30135":1590,"_20936":54191,"_5":14366,"_27421":54126,"_2948":51995},[],{"_3464":1615,"_30135":1590,"_20936":54193,"_5":14366,"_27421":54126,"_2948":54194},[],"The 1-hour leaf profile you just prepared.",{"_3464":1616,"_30135":1590,"_20936":54196,"_5":14366,"_27421":54126,"_2948":54197},[],"Protocol / Registration Mode",{"_3464":1617,"_30135":1590,"_20936":54199,"_5":14366,"_27421":54126,"_2948":54200},[],"`EST_RFC7030` / `JITP`.",{"_3464":1618,"_30135":1590,"_20936":54202,"_5":14366,"_27421":54126,"_2948":54203},[],"Verify CSR Signature",{"_3464":1619,"_30135":1590,"_20936":54205,"_5":14366,"_27421":54126,"_2948":54206},[],"Enabled.",{"_3464":1620,"_30135":1590,"_20936":54208,"_5":14366,"_27421":54126,"_2948":54209},[],"Enable Replaceable Enrollment",{"_3464":1621,"_30135":1590,"_20936":54211,"_5":14366,"_27421":54126,"_2948":54212},[],"Disabled; the ID must be new.",{"_3464":1622,"_30135":1590,"_20936":54214,"_5":14366,"_27421":54126,"_2948":54215},[],"Initial authentication",{"_3464":1623,"_30135":1590,"_20936":54217,"_5":14366,"_27421":54126,"_2948":54218},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3464":1624,"_30135":1590,"_20936":54220,"_5":14366,"_27421":54126,"_2948":54221},[],"Renewal authentication",{"_3464":1625,"_30135":1590,"_20936":54223,"_5":14366,"_27421":54126,"_2948":54224},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3464":1626,"_30135":1590,"_20936":54226,"_5":14366,"_27421":54126,"_2948":54227},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3464":1627,"_30135":1590,"_20936":54229,"_5":14366,"_27421":54126,"_2948":54230},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3464":1628,"_30135":1590,"_20936":54232,"_5":14366,"_27421":54126,"_2948":54233},[],"Re-enrollment Delta",{"_3464":1629,"_30135":1590,"_20936":54235,"_5":14366,"_27421":54126,"_2948":54236},[],"1 hour.",{"_3464":1630,"_30135":1590,"_20936":54238,"_5":14366,"_27421":54126,"_2948":54239},[],"Preventive / Critical Delta",{"_3464":1631,"_30135":1590,"_20936":54241,"_5":14366,"_27421":54126,"_2948":54242},[],"30 minutes / 10 minutes.",{"_3464":1632,"_30135":1590,"_20936":54244,"_5":14366,"_27421":54126,"_2948":54245},[],"Revoke on Re-enrollment",{"_3464":1633,"_30135":1590,"_20936":54247,"_5":14366,"_27421":54126,"_2948":54248},[],"Disabled to test the successor before retiring the previous identity.",{"_3464":1634,"_30135":1590,"_20936":54250,"_5":14366,"_27421":54126,"_2948":52003},[],{"_3464":1635,"_30135":1590,"_20936":54252,"_5":14366,"_27421":54126,"_2948":54253},[],"Disabled; the operational key is generated in the client.",{"_3464":1636,"_30135":1590,"_20936":54255,"_5":14366,"_27421":54126,"_2948":54256},[],"CA Distribution",{"_3464":1637,"_30135":1590,"_20936":54258,"_5":14366,"_27421":54126,"_2948":54259},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3464":1638,"_30135":1590,"_20936":54261,"_5":14366,"_27421":54126,"_2948":54262},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3464":1639,"_30135":1590,"_20936":54264,"_5":14366,"_27421":54130,"_2948":54265},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3464":1640,"_30135":1590,"_20936":54267,"_5":14366,"_27421":54130,"_2948":54268},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3464":1641,"_30135":1590,"_20936":54270,"_5":14366,"_27421":54134,"_2948":54271},[],"Generate a new key and CSR with the selected identifier:",{"_3464":1642,"_30135":1590,"_20936":54273,"_5":14366,"_27421":54134,"_2948":54274},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3464":1643,"_30135":1590,"_20936":54276,"_5":14366,"_27421":54134,"_2948":54277},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3464":1644,"_30135":1590,"_20936":54279,"_5":14366,"_27421":54138,"_2948":54280},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3464":1645,"_30135":1590,"_20936":54282,"_5":14366,"_27421":54138,"_2948":54283},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3464":1646,"_30135":1590,"_20936":54285,"_5":14366,"_27421":54142,"_2948":54286},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3464":1647,"_30135":1590,"_20936":54288,"_5":14366,"_27421":54142,"_2948":54289},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3464":1648,"_30135":1590,"_20936":54291,"_5":14366,"_27421":54142,"_2948":54292},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3464":1649,"_30135":1590,"_20936":54294,"_5":14366,"_27421":54142,"_2948":54295},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3464":1650,"_30135":1590,"_20936":54297,"_5":14366,"_27421":54142,"_2948":54298},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3464":1651,"_30135":1590,"_20936":54300,"_5":14366,"_27421":54146,"_2948":54301},[],"Check",{"_3464":1652,"_30135":1590,"_20936":54303,"_5":14366,"_27421":54146,"_2948":54304},[],"Expected result",{"_3464":1653,"_30135":1590,"_20936":54306,"_5":14366,"_27421":54146,"_2948":54307},[],"Registration",{"_3464":1654,"_30135":1590,"_20936":54309,"_5":14366,"_27421":54146,"_2948":54310},[],"ID created automatically and correct DMS.",{"_3464":1655,"_30135":1590,"_20936":54312,"_5":14366,"_27421":54146,"_2948":53568},[],{"_3464":1656,"_30135":1590,"_20936":54314,"_5":14366,"_27421":54146,"_2948":54315},[],"CN, profile, serial and key verified.",{"_3464":1657,"_30135":1590,"_20936":54317,"_5":14366,"_27421":54146,"_2948":54318},[],"Inventory",{"_3464":1658,"_30135":1590,"_20936":54320,"_5":14366,"_27421":54146,"_2948":54321},[],"Received serial visible as the current identity and in history.",{"_3464":1659,"_30135":1590,"_20936":54323,"_5":14366,"_27421":54146,"_2948":54324},[],"Consumer",{"_3464":1660,"_30135":1590,"_20936":54326,"_5":14366,"_27421":54146,"_2948":54327},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3464":1661,"_30135":1590,"_20936":54329,"_5":14366,"_27421":54146,"_2948":54330},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3464":1662,"_30135":1590,"_20936":54332,"_5":14366,"_27421":54146,"_2948":54333},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3464":1663,"_30135":1663,"_5":14718,"_2948":51700,"_30488":54335,"_20936":54336,"_27421":1663},[49202,50670,51684,54112],[],{"_3464":1664,"_30135":1663,"_20936":54338,"_5":14366,"_27421":1663,"_2948":54339},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3464":1665,"_30135":1663,"_5":30485,"_20936":54341,"_27421":54342,"_2948":49212},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3464":1666,"_30135":1663,"_5":30485,"_20936":54344,"_27421":54345,"_2948":54346},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3464":1667,"_30135":1663,"_5":30485,"_20936":54348,"_27421":54349,"_2948":54350},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3464":1668,"_30135":1663,"_5":30485,"_20936":54352,"_27421":54353,"_2948":54354},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3464":1669,"_30135":1663,"_5":30485,"_20936":54356,"_27421":54357,"_2948":54358},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3464":1670,"_30135":1663,"_5":30485,"_20936":54360,"_27421":54361,"_2948":54362},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3464":1671,"_30135":1663,"_5":30485,"_20936":54364,"_27421":54365,"_2948":54304},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3464":1672,"_30135":1663,"_5":30485,"_20936":54367,"_27421":54368,"_2948":54369},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3464":1673,"_30135":1663,"_5":30485,"_20936":54371,"_27421":54372,"_2948":54373},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3464":1674,"_30135":1663,"_20936":54375,"_5":14366,"_27421":1663,"_2948":54376},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3464":1675,"_30135":1663,"_20936":54378,"_5":14366,"_27421":1663,"_2948":54379},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3464":1676,"_30135":1663,"_20936":54381,"_5":14366,"_27421":54342,"_2948":54382},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3464":1677,"_30135":1663,"_20936":54384,"_5":14366,"_27421":54342,"_2948":54385},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3464":1678,"_30135":1663,"_20936":54387,"_5":14366,"_27421":54342,"_2948":54388},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3464":1679,"_30135":1663,"_20936":54390,"_5":14366,"_27421":54342,"_2948":54391},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3464":1680,"_30135":1663,"_20936":54393,"_5":14366,"_27421":54345,"_2948":54394},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3464":1681,"_30135":1663,"_20936":54396,"_5":14366,"_27421":54345,"_2948":54397},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3464":1682,"_30135":1663,"_20936":54399,"_5":14366,"_27421":54345,"_2948":54400},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3464":1683,"_30135":1663,"_20936":54402,"_5":14366,"_27421":54345,"_2948":54403},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3464":1684,"_30135":1663,"_20936":54405,"_5":14366,"_27421":54345,"_2948":54406},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3464":1685,"_30135":1663,"_20936":54408,"_5":14366,"_27421":54345,"_2948":54409},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3464":1686,"_30135":1663,"_20936":54411,"_5":14366,"_27421":54345,"_2948":54412},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3464":1687,"_30135":1663,"_20936":54414,"_5":14366,"_27421":54345,"_2948":54415},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3464":1688,"_30135":1663,"_20936":54417,"_5":14366,"_27421":54349,"_2948":54418},[],"Open **Managed Devices** and the registration action. Complete:",{"_3464":1689,"_30135":1663,"_20936":54420,"_5":14366,"_27421":54349,"_2948":54421},[],"**Device ID**: `device-001`.",{"_3464":1690,"_30135":1663,"_20936":54423,"_5":14366,"_27421":54349,"_2948":54424},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3464":1691,"_30135":1663,"_20936":54426,"_5":14366,"_27421":54349,"_2948":54427},[],"**Icon** and **Tags**: optional classification.",{"_3464":1692,"_30135":1663,"_20936":54429,"_5":14366,"_27421":54349,"_2948":54430},[],"Confirm registration.",{"_3464":1693,"_30135":1663,"_20936":54432,"_5":14366,"_27421":54353,"_2948":54433},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3464":1694,"_30135":1663,"_20936":54435,"_5":14366,"_27421":54353,"_2948":54436},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3464":1695,"_30135":1663,"_20936":54438,"_5":14366,"_27421":54357,"_2948":54439},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3464":1696,"_30135":1663,"_20936":54441,"_5":14366,"_27421":54357,"_2948":54442},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3464":1697,"_30135":1663,"_20936":54444,"_5":14366,"_27421":54361,"_2948":54445},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3464":1698,"_30135":1663,"_20936":54447,"_5":14366,"_27421":54361,"_2948":54448},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3464":1699,"_30135":1663,"_20936":54450,"_5":14366,"_27421":54365,"_2948":54301},[],{"_3464":1700,"_30135":1663,"_20936":54452,"_5":14366,"_27421":54365,"_2948":54453},[],"Result",{"_3464":1701,"_30135":1663,"_20936":54455,"_5":14366,"_27421":54365,"_2948":53551},[],{"_3464":1702,"_30135":1663,"_20936":54457,"_5":14366,"_27421":54365,"_2948":54458},[],"`device-001` appears in inventory with the expected DMS.",{"_3464":1703,"_30135":1663,"_20936":54460,"_5":14366,"_27421":54365,"_2948":54461},[],"Current identity",{"_3464":1704,"_30135":1663,"_20936":54463,"_5":14366,"_27421":54365,"_2948":54464},[],"The associated certificate matches the one you verified in PKI.",{"_3464":1705,"_30135":1663,"_20936":54466,"_5":14366,"_27421":54365,"_2948":54467},[],"History",{"_3464":1706,"_30135":1663,"_20936":54469,"_5":14366,"_27421":54365,"_2948":54470},[],"The associated issuance appears with its serial number and dates.",{"_3464":1707,"_30135":1663,"_20936":54472,"_5":14366,"_27421":54365,"_2948":54473},[],"Key and certificate",{"_3464":1708,"_30135":1663,"_20936":54475,"_5":14366,"_27421":54365,"_2948":54476},[],"You have the verified pair ready to install on the device.",{"_3464":1709,"_30135":1663,"_20936":54478,"_5":14366,"_27421":54368,"_2948":54479},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3464":1710,"_30135":1663,"_20936":54481,"_5":14366,"_27421":54368,"_2948":54482},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3464":1711,"_30135":1663,"_20936":54484,"_5":14366,"_27421":54368,"_2948":54485},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3464":1712,"_30135":1663,"_20936":54487,"_5":14366,"_27421":54368,"_2948":54488},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3464":1713,"_30135":1663,"_20936":54490,"_5":14366,"_27421":54372,"_2948":54491},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3464":1714,"_30135":1663,"_20936":54493,"_5":14366,"_27421":54372,"_2948":54494},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3464":1715,"_30135":1663,"_20936":54496,"_5":14366,"_27421":54372,"_2948":54497},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3464":1716,"_30135":1716,"_5":14718,"_2948":54499,"_30488":54500,"_20936":54501,"_27421":1716},"Lamassu IoT Platform",[49202,50670],[],{"_3464":1717,"_30135":1716,"_20936":54503,"_5":14366,"_27421":1716,"_2948":54504},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3464":1718,"_30135":1716,"_5":30485,"_20936":54506,"_27421":54507,"_2948":54508},[],"/docs/pr-preview/pr-61/platform/overview#explore-the-console","Explore the console",{"_3464":1719,"_30135":1716,"_5":30485,"_20936":54510,"_27421":54511,"_2948":53987},[],"/docs/pr-preview/pr-61/platform/overview#start-here",{"_3464":1720,"_30135":1716,"_5":30485,"_20936":54513,"_27421":54514,"_2948":54515},[],"/docs/pr-preview/pr-61/platform/overview#choose-your-path","Choose your path",{"_3464":1721,"_30135":1716,"_5":30485,"_20936":54517,"_27421":54518,"_2948":54519},[],"/docs/pr-preview/pr-61/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3464":1722,"_30135":1716,"_5":30485,"_20936":54521,"_27421":54522,"_2948":54523},[],"/docs/pr-preview/pr-61/platform/overview#core-capabilities","Core capabilities",{"_3464":1723,"_30135":1716,"_5":30485,"_20936":54525,"_27421":54526,"_2948":54527},[],"/docs/pr-preview/pr-61/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3464":1724,"_30135":1716,"_5":30485,"_20936":54529,"_27421":54530,"_2948":54531},[],"/docs/pr-preview/pr-61/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3464":1725,"_30135":1716,"_5":30485,"_20936":54533,"_27421":54534,"_2948":54535},[],"/docs/pr-preview/pr-61/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3464":1726,"_30135":1716,"_5":30485,"_20936":54537,"_27421":54538,"_2948":54539},[],"/docs/pr-preview/pr-61/platform/overview#automate-device-identities","Automate device identities",{"_3464":1727,"_30135":1716,"_5":30485,"_20936":54541,"_27421":54542,"_2948":54543},[],"/docs/pr-preview/pr-61/platform/overview#publish-validation-status","Publish validation status",{"_3464":1728,"_30135":1716,"_5":30485,"_20936":54545,"_27421":54546,"_2948":54547},[],"/docs/pr-preview/pr-61/platform/overview#react-to-events","React to events",{"_3464":1729,"_30135":1716,"_5":30485,"_20936":54549,"_27421":54550,"_2948":54551},[],"/docs/pr-preview/pr-61/platform/overview#operational-reference","Operational reference",{"_3464":1730,"_30135":1716,"_20936":54553,"_5":14366,"_27421":1716,"_2948":54554},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3464":1731,"_30135":1716,"_20936":54556,"_5":14366,"_27421":54507,"_2948":54557},[],"Take an interactive tour of certificates, certification authorities and devices.",{"_3464":1732,"_30135":1716,"_20936":54559,"_5":14366,"_27421":54511,"_2948":54560},[],"Choose the result you need:",{"_3464":1733,"_30135":1716,"_20936":54562,"_5":14366,"_27421":54511,"_2948":54563},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3464":1734,"_30135":1716,"_20936":54565,"_5":14366,"_27421":54511,"_2948":54566},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3464":1735,"_30135":1716,"_20936":54568,"_5":14366,"_27421":54511,"_2948":54569},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3464":1736,"_30135":1716,"_20936":54571,"_5":14366,"_27421":54514,"_2948":54572},[],"Section",{"_3464":1737,"_30135":1716,"_20936":54574,"_5":14366,"_27421":54514,"_2948":54575},[],"What you manage",{"_3464":1738,"_30135":1716,"_20936":54577,"_5":14366,"_27421":54514,"_2948":54578},[],"Entry point",{"_3464":1739,"_30135":1716,"_20936":54580,"_5":14366,"_27421":54514,"_2948":54581},[],"**PKI**",{"_3464":1740,"_30135":1716,"_20936":54583,"_5":14366,"_27421":54514,"_2948":54584},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3464":1741,"_30135":1716,"_20936":54586,"_5":14366,"_27421":54514,"_2948":54587},[],"PKI overview",{"_3464":1742,"_30135":1716,"_20936":54589,"_5":14366,"_27421":54514,"_2948":54590},[],"**IoT Fleets**",{"_3464":1743,"_30135":1716,"_20936":54592,"_5":14366,"_27421":54514,"_2948":54593},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3464":1744,"_30135":1716,"_20936":54595,"_5":14366,"_27421":54514,"_2948":54596},[],"IoT Fleets overview",{"_3464":1745,"_30135":1716,"_20936":54598,"_5":14366,"_27421":54514,"_2948":54599},[],"**Administration**",{"_3464":1746,"_30135":1716,"_20936":54601,"_5":14366,"_27421":54514,"_2948":54602},[],"Operator permissions, audit and event subscriptions.",{"_3464":1747,"_30135":1716,"_20936":54604,"_5":14366,"_27421":54514,"_2948":50668},[],{"_3464":1748,"_30135":1716,"_20936":54606,"_5":14366,"_27421":54514,"_2948":54607},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3464":1749,"_30135":1716,"_20936":54609,"_5":14366,"_27421":54518,"_2948":54610},[],"An identity's journey connects four responsibilities:",{"_3464":1750,"_30135":1716,"_20936":54612,"_5":14366,"_27421":54518,"_2948":54613},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3464":1751,"_30135":1716,"_20936":54615,"_5":14366,"_27421":54518,"_2948":54616},[],"The provisioning administrator configures the DMS and initial trust.",{"_3464":1752,"_30135":1716,"_20936":54618,"_5":14366,"_27421":54518,"_2948":54619},[],"The device client requests a certificate and installs it with the matching key.",{"_3464":1753,"_30135":1716,"_20936":54621,"_5":14366,"_27421":54518,"_2948":54622},[],"The consumer validates the identity and applies its access permissions.",{"_3464":1754,"_30135":1716,"_20936":54624,"_5":14366,"_27421":54518,"_2948":54625},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3464":1755,"_30135":1716,"_20936":54627,"_5":14366,"_27421":54526,"_2948":54628},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3464":1756,"_30135":1716,"_20936":54630,"_5":14366,"_27421":54530,"_2948":54631},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3464":1757,"_30135":1716,"_20936":54633,"_5":14366,"_27421":54534,"_2948":54634},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3464":1758,"_30135":1716,"_20936":54636,"_5":14366,"_27421":54538,"_2948":54637},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3464":1759,"_30135":1716,"_20936":54639,"_5":14366,"_27421":54542,"_2948":54640},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3464":1760,"_30135":1716,"_20936":54642,"_5":14366,"_27421":54546,"_2948":54643},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3464":1761,"_30135":1716,"_20936":54645,"_5":14366,"_27421":54550,"_2948":54081},[],{"_3464":1762,"_30135":1716,"_20936":54647,"_5":14366,"_27421":54550,"_2948":54648},[],"What it prepares or checks",{"_3464":1763,"_30135":1716,"_20936":54650,"_5":14366,"_27421":54550,"_2948":54084},[],{"_3464":1764,"_30135":1716,"_20936":54652,"_5":14366,"_27421":54550,"_2948":54653},[],"Key custody, CA hierarchy, profiles and validation.",{"_3464":1765,"_30135":1716,"_20936":54655,"_5":14366,"_27421":54550,"_2948":54656},[],"Fleet administrator",{"_3464":1766,"_30135":1716,"_20936":54658,"_5":14366,"_27421":54550,"_2948":54659},[],"DMS, device admission, renewal policy and inventory.",{"_3464":1767,"_30135":1716,"_20936":54661,"_5":14366,"_27421":54550,"_2948":54096},[],{"_3464":1768,"_30135":1716,"_20936":54663,"_5":14366,"_27421":54550,"_2948":54664},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3464":1769,"_30135":1716,"_20936":54666,"_5":14366,"_27421":54550,"_2948":54102},[],{"_3464":1770,"_30135":1716,"_20936":54668,"_5":14366,"_27421":54550,"_2948":54669},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3464":1771,"_30135":1716,"_20936":54671,"_5":14366,"_27421":54550,"_2948":54672},[],"Infrastructure operator",{"_3464":1772,"_30135":1716,"_20936":54674,"_5":14366,"_27421":54550,"_2948":54675},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3464":1773,"_30135":1716,"_20936":54677,"_5":14366,"_27421":54550,"_2948":54678},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3464":1774,"_30135":1774,"_5":14718,"_2948":54680,"_30488":54681,"_20936":54684,"_27421":1774},"CA hierarchy and rotation",[49202,50670,54682,54683],"PKI","Keys, authorities and certificates",[],{"_3464":1775,"_30135":1774,"_20936":54686,"_5":14366,"_27421":1774,"_2948":54687},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3464":1776,"_30135":1774,"_5":30485,"_20936":54689,"_27421":54690,"_2948":54691},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3464":1777,"_30135":1774,"_5":30485,"_20936":54693,"_27421":54694,"_2948":54695},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3464":1778,"_30135":1774,"_5":30485,"_20936":54697,"_27421":54698,"_2948":54699},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3464":1779,"_30135":1774,"_5":30485,"_20936":54701,"_27421":54702,"_2948":54703},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3464":1780,"_30135":1774,"_5":30485,"_20936":54705,"_27421":54706,"_2948":54707},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3464":1781,"_30135":1774,"_5":30485,"_20936":54709,"_27421":54710,"_2948":54711},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3464":1782,"_30135":1774,"_5":30485,"_20936":54713,"_27421":54714,"_2948":54715},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3464":1783,"_30135":1774,"_5":30485,"_20936":54717,"_27421":54718,"_2948":54719},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3464":1784,"_30135":1774,"_5":30485,"_20936":54721,"_27421":54722,"_2948":54723},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3464":1785,"_30135":1774,"_5":30485,"_20936":54725,"_27421":54726,"_2948":54727},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3464":1786,"_30135":1774,"_5":30485,"_20936":54729,"_27421":54730,"_2948":54731},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3464":1787,"_30135":1774,"_5":30485,"_20936":54733,"_27421":54734,"_2948":54735},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3464":1788,"_30135":1774,"_20936":54737,"_5":14366,"_27421":1774,"_2948":54738},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3464":1789,"_30135":1774,"_20936":54740,"_5":14366,"_27421":1774,"_2948":54741},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3464":1790,"_30135":1774,"_20936":54743,"_5":14366,"_27421":54690,"_2948":54744},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3464":1791,"_30135":1774,"_20936":54746,"_5":14366,"_27421":54690,"_2948":54747},[],"environment, such as production and preproduction;",{"_3464":1792,"_30135":1774,"_20936":54749,"_5":14366,"_27421":54690,"_2948":54750},[],"owner or operating team;",{"_3464":1793,"_30135":1774,"_20936":54752,"_5":14366,"_27421":54690,"_2948":54753},[],"device family or manufacturing process;",{"_3464":1794,"_30135":1774,"_20936":54755,"_5":14366,"_27421":54690,"_2948":54756},[],"region or regulatory requirement;",{"_3464":1795,"_30135":1774,"_20936":54758,"_5":14366,"_27421":54690,"_2948":54759},[],"cryptographic engine or key policy;",{"_3464":1796,"_30135":1774,"_20936":54761,"_5":14366,"_27421":54690,"_2948":54762},[],"maintenance window and renewal cadence.",{"_3464":1797,"_30135":1774,"_20936":54764,"_5":14366,"_27421":54690,"_2948":54765},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3464":1798,"_30135":1774,"_20936":54767,"_5":14366,"_27421":54690,"_2948":54768},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3464":1799,"_30135":1774,"_20936":54770,"_5":14366,"_27421":54694,"_2948":54771},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3464":1800,"_30135":1774,"_20936":54773,"_5":14366,"_27421":54694,"_2948":54774},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3464":1801,"_30135":1774,"_20936":54776,"_5":14366,"_27421":54694,"_2948":54777},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3464":1802,"_30135":1774,"_20936":54779,"_5":14366,"_27421":54694,"_2948":54780},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3464":1803,"_30135":1774,"_20936":54782,"_5":14366,"_27421":54698,"_2948":54783},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3464":1804,"_30135":1774,"_20936":54785,"_5":14366,"_27421":54698,"_2948":54786},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3464":1805,"_30135":1774,"_20936":54788,"_5":14366,"_27421":54698,"_2948":54789},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3464":1806,"_30135":1774,"_20936":54791,"_5":14366,"_27421":54698,"_2948":54792},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3464":1807,"_30135":1774,"_20936":54794,"_5":14366,"_27421":54706,"_2948":54795},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3464":1808,"_30135":1774,"_20936":54797,"_5":14366,"_27421":54710,"_2948":54798},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3464":1809,"_30135":1774,"_20936":54800,"_5":14366,"_27421":54714,"_2948":54801},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3464":1810,"_30135":1774,"_20936":54803,"_5":14366,"_27421":54718,"_2948":54804},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3464":1811,"_30135":1774,"_20936":54806,"_5":14366,"_27421":54722,"_2948":54807},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3464":1812,"_30135":1774,"_20936":54809,"_5":14366,"_27421":54726,"_2948":54810},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3464":1813,"_30135":1774,"_20936":54812,"_5":14366,"_27421":54730,"_2948":54813},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3464":1814,"_30135":1774,"_20936":54815,"_5":14366,"_27421":54730,"_2948":54816},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3464":1815,"_30135":1774,"_20936":54818,"_5":14366,"_27421":54730,"_2948":54819},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3464":1816,"_30135":1774,"_20936":54821,"_5":14366,"_27421":54730,"_2948":54822},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3464":1817,"_30135":1774,"_20936":54824,"_5":14366,"_27421":54734,"_2948":54825},[],"The new chain ends in an anchor installed by the consumer.",{"_3464":1818,"_30135":1774,"_20936":54827,"_5":14366,"_27421":54734,"_2948":54828},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3464":1819,"_30135":1774,"_20936":54830,"_5":14366,"_27421":54734,"_2948":54831},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3464":1820,"_30135":1774,"_20936":54833,"_5":14366,"_27421":54734,"_2948":54834},[],"Re-enrollment accepts the old identity during the planned period.",{"_3464":1821,"_30135":1774,"_20936":54836,"_5":14366,"_27421":54734,"_2948":54837},[],"OCSP and CRL respond for the authorities that remain active.",{"_3464":1822,"_30135":1774,"_20936":54839,"_5":14366,"_27421":54734,"_2948":54840},[],"No DMS is left accidentally issuing from the old CA.",{"_3464":1823,"_30135":1774,"_20936":54842,"_5":14366,"_27421":54734,"_2948":54843},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3464":1824,"_30135":1824,"_5":14718,"_2948":54845,"_30488":54846,"_20936":54847,"_27421":1824},"Certification authorities",[49202,50670,54682,54683],[],{"_3464":1825,"_30135":1824,"_20936":54849,"_5":14366,"_27421":1824,"_2948":54850},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3464":1826,"_30135":1824,"_5":30485,"_20936":54852,"_27421":54853,"_2948":54854},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3464":1827,"_30135":1824,"_5":30485,"_20936":54856,"_27421":54857,"_2948":54858},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3464":1828,"_30135":1824,"_5":30485,"_20936":54860,"_27421":54861,"_2948":49212},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#before-you-begin",{"_3464":1829,"_30135":1824,"_5":30485,"_20936":54863,"_27421":54864,"_2948":54865},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3464":1830,"_30135":1824,"_5":30485,"_20936":54867,"_27421":54868,"_2948":54869},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3464":1831,"_30135":1824,"_5":30485,"_20936":54871,"_27421":54872,"_2948":54873},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3464":1832,"_30135":1824,"_5":30485,"_20936":54875,"_27421":54876,"_2948":54877},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3464":1833,"_30135":1824,"_5":30485,"_20936":54879,"_27421":54880,"_2948":54881},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3464":1834,"_30135":1824,"_5":30485,"_20936":54883,"_27421":54884,"_2948":54885},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3464":1835,"_30135":1824,"_5":30485,"_20936":54887,"_27421":54888,"_2948":54889},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3464":1836,"_30135":1824,"_5":30485,"_20936":54891,"_27421":54892,"_2948":54893},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3464":1837,"_30135":1824,"_5":30485,"_20936":54895,"_27421":54896,"_2948":54897},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3464":1838,"_30135":1824,"_5":30485,"_20936":54899,"_27421":54900,"_2948":54901},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3464":1839,"_30135":1824,"_5":30485,"_20936":54903,"_27421":54904,"_2948":54905},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3464":1840,"_30135":1824,"_5":30485,"_20936":54907,"_27421":54908,"_2948":54909},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3464":1841,"_30135":1824,"_5":30485,"_20936":54911,"_27421":54912,"_2948":54913},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3464":1842,"_30135":1824,"_5":30485,"_20936":54915,"_27421":54916,"_2948":54917},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3464":1843,"_30135":1824,"_5":30485,"_20936":54919,"_27421":54920,"_2948":54921},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3464":1844,"_30135":1824,"_5":30485,"_20936":54923,"_27421":54924,"_2948":54925},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3464":1845,"_30135":1824,"_5":30485,"_20936":54927,"_27421":54928,"_2948":54929},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3464":1846,"_30135":1824,"_5":30485,"_20936":54931,"_27421":54932,"_2948":54933},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3464":1847,"_30135":1824,"_5":30485,"_20936":54935,"_27421":54936,"_2948":54937},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3464":1848,"_30135":1824,"_5":30485,"_20936":54939,"_27421":54940,"_2948":54941},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3464":1849,"_30135":1824,"_20936":54943,"_5":14366,"_27421":1824,"_2948":54944},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3464":1850,"_30135":1824,"_20936":54946,"_5":14366,"_27421":1824,"_2948":54947},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3464":1851,"_30135":1824,"_20936":54949,"_5":14366,"_27421":1824,"_2948":54950},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3464":1852,"_30135":1824,"_20936":54952,"_5":14366,"_27421":54853,"_2948":54953},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3464":1853,"_30135":1824,"_20936":54955,"_5":14366,"_27421":54853,"_2948":54956},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3464":1854,"_30135":1824,"_20936":54958,"_5":14366,"_27421":54853,"_2948":54959},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3464":1855,"_30135":1824,"_20936":54961,"_5":14366,"_27421":54853,"_2948":54962},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3464":1856,"_30135":1824,"_20936":54964,"_5":14366,"_27421":54853,"_2948":54965},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3464":1857,"_30135":1824,"_20936":54967,"_5":14366,"_27421":54861,"_2948":54968},[],"Decide whether the CA will be a root or an intermediate.",{"_3464":1858,"_30135":1824,"_20936":54970,"_5":14366,"_27421":54861,"_2948":54971},[],"Choose the engine that will keep the key.",{"_3464":1859,"_30135":1824,"_20936":54973,"_5":14366,"_27421":54861,"_2948":54974},[],"Define a validity longer than that of the certificates it will issue.",{"_3464":1860,"_30135":1824,"_20936":54976,"_5":14366,"_27421":54861,"_2948":54977},[],"For an intermediate CA, make sure the parent CA is active.",{"_3464":1861,"_30135":1824,"_20936":54979,"_5":14366,"_27421":54864,"_2948":54980},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3464":1862,"_30135":1824,"_20936":54982,"_5":14366,"_27421":54868,"_2948":54983},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3464":1863,"_30135":1824,"_20936":54985,"_5":14366,"_27421":54868,"_2948":54986},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3464":1864,"_30135":1824,"_20936":54988,"_5":14366,"_27421":54872,"_2948":54989},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3464":1865,"_30135":1824,"_20936":54991,"_5":14366,"_27421":54876,"_2948":54992},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3464":1866,"_30135":1824,"_20936":54994,"_5":14366,"_27421":54876,"_2948":54995},[],"`C`: two-letter ISO 3166-1 country code.",{"_3464":1867,"_30135":1824,"_20936":54997,"_5":14366,"_27421":54876,"_2948":54998},[],"`ST`: state or province.",{"_3464":1868,"_30135":1824,"_20936":55000,"_5":14366,"_27421":54876,"_2948":55001},[],"`L`: locality.",{"_3464":1869,"_30135":1824,"_20936":55003,"_5":14366,"_27421":54876,"_2948":55004},[],"`O`: organization.",{"_3464":1870,"_30135":1824,"_20936":55006,"_5":14366,"_27421":54876,"_2948":55007},[],"`OU`: organizational unit.",{"_3464":1871,"_30135":1824,"_20936":55009,"_5":14366,"_27421":54876,"_2948":55010},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3464":1872,"_30135":1824,"_20936":55012,"_5":14366,"_27421":54880,"_2948":55013},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3464":1873,"_30135":1824,"_20936":55015,"_5":14366,"_27421":54880,"_2948":55016},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3464":1874,"_30135":1824,"_20936":55018,"_5":14366,"_27421":54884,"_2948":55019},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3464":1875,"_30135":1824,"_20936":55021,"_5":14366,"_27421":54884,"_2948":55022},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3464":1876,"_30135":1824,"_20936":55024,"_5":14366,"_27421":54888,"_2948":55025},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3464":1877,"_30135":1824,"_20936":55027,"_5":14366,"_27421":54888,"_2948":55028},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3464":1878,"_30135":1824,"_20936":55030,"_5":14366,"_27421":54892,"_2948":55031},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3464":1879,"_30135":1824,"_20936":55033,"_5":14366,"_27421":54892,"_2948":55034},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3464":1880,"_30135":1824,"_20936":55036,"_5":14366,"_27421":54892,"_2948":55037},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3464":1881,"_30135":1824,"_20936":55039,"_5":14366,"_27421":54896,"_2948":55040},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3464":1882,"_30135":1824,"_20936":55042,"_5":14366,"_27421":54900,"_2948":55043},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3464":1883,"_30135":1824,"_20936":55045,"_5":14366,"_27421":54900,"_2948":55046},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3464":1884,"_30135":1824,"_20936":55048,"_5":14366,"_27421":54904,"_2948":55049},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3464":1885,"_30135":1824,"_20936":55051,"_5":14366,"_27421":54908,"_2948":55052},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3464":1886,"_30135":1824,"_20936":55054,"_5":14366,"_27421":54908,"_2948":55055},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3464":1887,"_30135":1824,"_20936":55057,"_5":14366,"_27421":54912,"_2948":55058},[],"Open a CA from the inventory to review:",{"_3464":1888,"_30135":1824,"_20936":55060,"_5":14366,"_27421":54912,"_2948":55061},[],"Status and validity period.",{"_3464":1889,"_30135":1824,"_20936":55063,"_5":14366,"_27421":54912,"_2948":55064},[],"Certificate and chain in PEM format.",{"_3464":1890,"_30135":1824,"_20936":55066,"_5":14366,"_27421":54912,"_2948":55067},[],"Number of active, expired and revoked certificates.",{"_3464":1891,"_30135":1824,"_20936":55069,"_5":14366,"_27421":54912,"_2948":55070},[],"Certificates issued in **Issued Certificates**.",{"_3464":1892,"_30135":1824,"_20936":55072,"_5":14366,"_27421":54912,"_2948":55073},[],"The CRL linked to the authority.",{"_3464":1893,"_30135":1824,"_20936":55075,"_5":14366,"_27421":54912,"_2948":55076},[],"Metadata and the associated cryptographic engine.",{"_3464":1894,"_30135":1824,"_20936":55078,"_5":14366,"_27421":54912,"_2948":55079},[],"You can filter the inventory by name, status and CA type.",{"_3464":1895,"_30135":1824,"_20936":55081,"_5":14366,"_27421":54916,"_2948":55082},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3464":1896,"_30135":1824,"_20936":55084,"_5":14366,"_27421":54916,"_2948":55085},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3464":1897,"_30135":1824,"_20936":55087,"_5":14366,"_27421":54916,"_2948":55088},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3464":1898,"_30135":1824,"_20936":55090,"_5":14366,"_27421":54916,"_2948":55091},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3464":1899,"_30135":1824,"_20936":55093,"_5":14366,"_27421":54920,"_2948":55094},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3464":1900,"_30135":1824,"_20936":55096,"_5":14366,"_27421":54924,"_2948":55097},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3464":1901,"_30135":1824,"_20936":55099,"_5":14366,"_27421":54928,"_2948":55100},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3464":1902,"_30135":1824,"_20936":55102,"_5":14366,"_27421":54932,"_2948":55103},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3464":1903,"_30135":1824,"_20936":55105,"_5":14366,"_27421":54936,"_2948":55106},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3464":1904,"_30135":1824,"_20936":55108,"_5":14366,"_27421":54940,"_2948":55109},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3464":1905,"_30135":1824,"_20936":55111,"_5":14366,"_27421":54940,"_2948":55112},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3464":1906,"_30135":1824,"_20936":55114,"_5":14366,"_27421":54940,"_2948":55115},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3464":1907,"_30135":1907,"_5":14718,"_2948":55117,"_30488":55118,"_20936":55119,"_27421":1907},"Certificate profiles",[49202,50670,54682,54683],[],{"_3464":1908,"_30135":1907,"_20936":55121,"_5":14366,"_27421":1907,"_2948":55122},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3464":1909,"_30135":1907,"_5":30485,"_20936":55124,"_27421":55125,"_2948":55126},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3464":1910,"_30135":1907,"_5":30485,"_20936":55128,"_27421":55129,"_2948":55130},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#validity","Validity",{"_3464":1911,"_30135":1907,"_5":30485,"_20936":55132,"_27421":55133,"_2948":55134},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3464":1912,"_30135":1907,"_5":30485,"_20936":55136,"_27421":55137,"_2948":55138},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3464":1913,"_30135":1907,"_5":30485,"_20936":55140,"_27421":55141,"_2948":55142},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#subject","Subject",{"_3464":1914,"_30135":1907,"_5":30485,"_20936":55144,"_27421":55145,"_2948":55146},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3464":1915,"_30135":1907,"_5":30485,"_20936":55148,"_27421":55149,"_2948":55150},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3464":1916,"_30135":1907,"_5":30485,"_20936":55152,"_27421":55153,"_2948":55154},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3464":1917,"_30135":1907,"_5":30485,"_20936":55156,"_27421":55157,"_2948":55158},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3464":1918,"_30135":1907,"_5":30485,"_20936":55160,"_27421":55161,"_2948":55162},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3464":1919,"_30135":1907,"_5":30485,"_20936":55164,"_27421":55165,"_2948":55166},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3464":1920,"_30135":1907,"_5":30485,"_20936":55168,"_27421":55169,"_2948":55170},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3464":1921,"_30135":1907,"_5":30485,"_20936":55172,"_27421":55173,"_2948":55174},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3464":1922,"_30135":1907,"_5":30485,"_20936":55176,"_27421":55177,"_2948":55178},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3464":1923,"_30135":1907,"_5":30485,"_20936":55180,"_27421":55181,"_2948":55182},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#design-examples","Design examples",{"_3464":1924,"_30135":1907,"_5":30485,"_20936":55184,"_27421":55185,"_2948":55186},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3464":1925,"_30135":1907,"_20936":55188,"_5":14366,"_27421":1907,"_2948":55189},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3464":1926,"_30135":1907,"_20936":55191,"_5":14366,"_27421":1907,"_2948":55192},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3464":1927,"_30135":1907,"_20936":55194,"_5":14366,"_27421":55129,"_2948":55195},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3464":1928,"_30135":1907,"_20936":55197,"_5":14366,"_27421":55129,"_2948":55198},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3464":1929,"_30135":1907,"_20936":55200,"_5":14366,"_27421":55133,"_2948":55201},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3464":1930,"_30135":1907,"_20936":55203,"_5":14366,"_27421":55137,"_2948":55204},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3464":1931,"_30135":1907,"_20936":55206,"_5":14366,"_27421":55137,"_2948":55207},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3464":1932,"_30135":1907,"_20936":55209,"_5":14366,"_27421":55137,"_2948":55210},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3464":1933,"_30135":1907,"_20936":55212,"_5":14366,"_27421":55141,"_2948":55213},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3464":1934,"_30135":1907,"_20936":55215,"_5":14366,"_27421":55145,"_2948":55216},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3464":1935,"_30135":1907,"_20936":55218,"_5":14366,"_27421":55145,"_2948":55219},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3464":1936,"_30135":1907,"_20936":55221,"_5":14366,"_27421":55149,"_2948":55222},[],"The cryptographic enforcement can:",{"_3464":1937,"_30135":1907,"_20936":55224,"_5":14366,"_27421":55149,"_2948":55225},[],"allow or block RSA keys;",{"_3464":1938,"_30135":1907,"_20936":55227,"_5":14366,"_27421":55149,"_2948":55228},[],"limit the supported RSA sizes;",{"_3464":1939,"_30135":1907,"_20936":55230,"_5":14366,"_27421":55149,"_2948":55231},[],"allow or block ECDSA keys;",{"_3464":1940,"_30135":1907,"_20936":55233,"_5":14366,"_27421":55149,"_2948":55234},[],"limit the supported ECDSA sizes or curves.",{"_3464":1941,"_30135":1907,"_20936":55236,"_5":14366,"_27421":55149,"_2948":55237},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3464":1942,"_30135":1907,"_20936":55239,"_5":14366,"_27421":55153,"_2948":55240},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3464":1943,"_30135":1907,"_20936":55242,"_5":14366,"_27421":55153,"_2948":52437},[],{"_3464":1944,"_30135":1907,"_20936":55244,"_5":14366,"_27421":55153,"_2948":55245},[],"First choice",{"_3464":1945,"_30135":1907,"_20936":55247,"_5":14366,"_27421":55153,"_2948":55248},[],"Second choice",{"_3464":1946,"_30135":1907,"_20936":55250,"_5":14366,"_27421":55153,"_2948":55251},[],"If neither is supplied",{"_3464":1947,"_30135":1907,"_20936":55253,"_5":14366,"_27421":55153,"_2948":55254},[],"Direct signing with a CA",{"_3464":1948,"_30135":1907,"_20936":55256,"_5":14366,"_27421":55153,"_2948":55257},[],"`issuance_profile` embedded in the request",{"_3464":1949,"_30135":1907,"_20936":55259,"_5":14366,"_27421":55153,"_2948":55260},[],"Request `issuance_profile_id`",{"_3464":1950,"_30135":1907,"_20936":55262,"_5":14366,"_27421":55153,"_2948":55263},[],"CA default profile (`profile_id`).",{"_3464":1951,"_30135":1907,"_20936":55265,"_5":14366,"_27421":55153,"_2948":55266},[],"Issuance through a DMS",{"_3464":1952,"_30135":1907,"_20936":55268,"_5":14366,"_27421":55153,"_2948":55269},[],"`settings.issuance_profile_id`",{"_3464":1953,"_30135":1907,"_20936":55271,"_5":14366,"_27421":55153,"_2948":55272},[],"`settings.issuance_profile` embedded in the DMS",{"_3464":1954,"_30135":1907,"_20936":55274,"_5":14366,"_27421":55153,"_2948":55275},[],"Enrollment CA default profile.",{"_3464":1955,"_30135":1907,"_20936":55277,"_5":14366,"_27421":55153,"_2948":55278},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3464":1956,"_30135":1907,"_20936":55280,"_5":14366,"_27421":55153,"_2948":55281},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3464":1957,"_30135":1907,"_20936":55283,"_5":14366,"_27421":55161,"_2948":55284},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3464":1958,"_30135":1907,"_20936":55286,"_5":14366,"_27421":55165,"_2948":55287},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3464":1959,"_30135":1907,"_20936":55289,"_5":14366,"_27421":55169,"_2948":55290},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3464":1960,"_30135":1907,"_20936":55292,"_5":14366,"_27421":55173,"_2948":55293},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3464":1961,"_30135":1907,"_20936":55295,"_5":14366,"_27421":55177,"_2948":55296},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3464":1962,"_30135":1907,"_20936":55298,"_5":14366,"_27421":55177,"_2948":55299},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3464":1963,"_30135":1907,"_20936":55301,"_5":14366,"_27421":55181,"_2948":55302},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3464":1964,"_30135":1907,"_20936":55304,"_5":14366,"_27421":55181,"_2948":55305},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3464":1965,"_30135":1907,"_20936":55307,"_5":14366,"_27421":55181,"_2948":55308},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3464":1966,"_30135":1907,"_20936":55310,"_5":14366,"_27421":55181,"_2948":55311},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3464":1967,"_30135":1907,"_20936":55313,"_5":14366,"_27421":55185,"_2948":55314},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3464":1968,"_30135":1907,"_20936":55316,"_5":14366,"_27421":55185,"_2948":55317},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3464":1969,"_30135":1969,"_5":14718,"_2948":55319,"_30488":55320,"_20936":55322,"_27421":1969},"Certificate validation",[49202,50670,54682,55321],"Validation",[],{"_3464":1970,"_30135":1969,"_20936":55324,"_5":14366,"_27421":1969,"_2948":55325},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3464":1971,"_30135":1969,"_5":30485,"_20936":55327,"_27421":55328,"_2948":55329},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3464":1972,"_30135":1969,"_5":30485,"_20936":55331,"_27421":55332,"_2948":55333},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3464":1973,"_30135":1969,"_5":30485,"_20936":55335,"_27421":55336,"_2948":55337},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3464":1974,"_30135":1969,"_20936":55339,"_5":14366,"_27421":1969,"_2948":55340},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3464":1975,"_30135":1969,"_20936":55342,"_5":14366,"_27421":55328,"_2948":55343},[],"Verify these criteria together:",{"_3464":1976,"_30135":1969,"_20936":55345,"_5":14366,"_27421":55328,"_2948":54301},[],{"_3464":1977,"_30135":1969,"_20936":55347,"_5":14366,"_27421":55328,"_2948":55348},[],"Required result",{"_3464":1978,"_30135":1969,"_20936":55350,"_5":14366,"_27421":55328,"_2948":55351},[],"Chain and signature",{"_3464":1979,"_30135":1969,"_20936":55353,"_5":14366,"_27421":55328,"_2948":55354},[],"Valid chain to a root deliberately installed in the consumer.",{"_3464":1980,"_30135":1969,"_20936":55356,"_5":14366,"_27421":55328,"_2948":55357},[],"Dates",{"_3464":1981,"_30135":1969,"_20936":55359,"_5":14366,"_27421":55328,"_2948":55360},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3464":1982,"_30135":1969,"_20936":55362,"_5":14366,"_27421":55328,"_2948":50339},[],{"_3464":1983,"_30135":1969,"_20936":55364,"_5":14366,"_27421":55328,"_2948":55365},[],"Name, SAN or identifier matches the expected peer.",{"_3464":1984,"_30135":1969,"_20936":55367,"_5":14366,"_27421":55328,"_2948":49592},[],{"_3464":1985,"_30135":1969,"_20936":55369,"_5":14366,"_27421":55328,"_2948":55370},[],"KU, EKU and constraints permit the specific operation.",{"_3464":1986,"_30135":1969,"_20936":55372,"_5":14366,"_27421":55328,"_2948":55373},[],"Revocation",{"_3464":1987,"_30135":1969,"_20936":55375,"_5":14366,"_27421":55328,"_2948":55376},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3464":1988,"_30135":1969,"_20936":55378,"_5":14366,"_27421":55328,"_2948":55379},[],"Authorization",{"_3464":1989,"_30135":1969,"_20936":55381,"_5":14366,"_27421":55328,"_2948":55382},[],"The application permits that identity to perform the action.",{"_3464":1990,"_30135":1969,"_20936":55384,"_5":14366,"_27421":55328,"_2948":55385},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3464":1991,"_30135":1969,"_20936":55387,"_5":14366,"_27421":55332,"_2948":55388},[],"Mechanism",{"_3464":1992,"_30135":1969,"_20936":55390,"_5":14366,"_27421":55332,"_2948":55391},[],"When to use it",{"_3464":1993,"_30135":1969,"_20936":55393,"_5":14366,"_27421":55332,"_2948":55394},[],"What you must maintain",{"_3464":1994,"_30135":1969,"_20936":55396,"_5":14366,"_27421":55332,"_2948":55397},[],"OCSP",{"_3464":1995,"_30135":1969,"_20936":55399,"_5":14366,"_27421":55332,"_2948":55400},[],"Status query for a specific certificate.",{"_3464":1996,"_30135":1969,"_20936":55402,"_5":14366,"_27421":55332,"_2948":55403},[],"Responder access, signature verification and cache/freshness policy.",{"_3464":1997,"_30135":1969,"_20936":55405,"_5":14366,"_27421":55332,"_2948":55406},[],"CRL",{"_3464":1998,"_30135":1969,"_20936":55408,"_5":14366,"_27421":55332,"_2948":55409},[],"Local checks for many certificates or offline operation.",{"_3464":1999,"_30135":1969,"_20936":55411,"_5":14366,"_27421":55332,"_2948":55412},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3464":2000,"_30135":1969,"_20936":55414,"_5":14366,"_27421":55332,"_2948":55415},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3464":2001,"_30135":1969,"_20936":55417,"_5":14366,"_27421":55332,"_2948":55418},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3464":2002,"_30135":1969,"_20936":55420,"_5":14366,"_27421":55336,"_2948":55421},[],"Accept a current, authorized certificate with a known chain.",{"_3464":2003,"_30135":1969,"_20936":55423,"_5":14366,"_27421":55336,"_2948":55424},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3464":2004,"_30135":1969,"_20936":55426,"_5":14366,"_27421":55336,"_2948":55427},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3464":2005,"_30135":1969,"_20936":55429,"_5":14366,"_27421":55336,"_2948":55430},[],"Check that a new connection with that identity is rejected.",{"_3464":2006,"_30135":1969,"_20936":55432,"_5":14366,"_27421":55336,"_2948":55433},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3464":2007,"_30135":1969,"_20936":55435,"_5":14366,"_27421":55336,"_2948":55436},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3464":2008,"_30135":1969,"_20936":55438,"_5":14366,"_27421":55336,"_2948":55439},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3464":2009,"_30135":1969,"_20936":55441,"_5":14366,"_27421":55336,"_2948":55442},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":2010,"_30135":1969,"_20936":55444,"_5":14366,"_27421":55336,"_2948":55445},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3464":2011,"_30135":2011,"_5":14718,"_2948":55447,"_30488":55448,"_20936":55449,"_27421":2011},"Certificates",[49202,50670,54682,54683],[],{"_3464":2012,"_30135":2011,"_20936":55451,"_5":14366,"_27421":2011,"_2948":55452},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3464":2013,"_30135":2011,"_5":30485,"_20936":55454,"_27421":55455,"_2948":55456},[],"/docs/pr-preview/pr-61/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3464":2014,"_30135":2011,"_5":30485,"_20936":55458,"_27421":55459,"_2948":55460},[],"/docs/pr-preview/pr-61/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3464":2015,"_30135":2011,"_5":30485,"_20936":55462,"_27421":55463,"_2948":55464},[],"/docs/pr-preview/pr-61/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3464":2016,"_30135":2011,"_5":30485,"_20936":55466,"_27421":55467,"_2948":55468},[],"/docs/pr-preview/pr-61/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3464":2017,"_30135":2011,"_5":30485,"_20936":55470,"_27421":55471,"_2948":55472},[],"/docs/pr-preview/pr-61/platform/pki/certificates#open-the-action","Open the action",{"_3464":2018,"_30135":2011,"_5":30485,"_20936":55474,"_27421":55475,"_2948":55476},[],"/docs/pr-preview/pr-61/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3464":2019,"_30135":2011,"_5":30485,"_20936":55478,"_27421":55479,"_2948":55480},[],"/docs/pr-preview/pr-61/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3464":2020,"_30135":2011,"_5":30485,"_20936":55482,"_27421":55483,"_2948":55484},[],"/docs/pr-preview/pr-61/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3464":2021,"_30135":2011,"_5":30485,"_20936":55486,"_27421":55487,"_2948":55488},[],"/docs/pr-preview/pr-61/platform/pki/certificates#continue","Continue",{"_3464":2022,"_30135":2011,"_20936":55490,"_5":14366,"_27421":2011,"_2948":55491},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3464":2023,"_30135":2011,"_20936":55493,"_5":14366,"_27421":55455,"_2948":55494},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3464":2024,"_30135":2011,"_20936":55496,"_5":14366,"_27421":55455,"_2948":55497},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3464":2025,"_30135":2011,"_20936":55499,"_5":14366,"_27421":55455,"_2948":55500},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3464":2026,"_30135":2011,"_20936":55502,"_5":14366,"_27421":55455,"_2948":55503},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3464":2027,"_30135":2011,"_20936":55505,"_5":14366,"_27421":55455,"_2948":55506},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3464":2028,"_30135":2011,"_20936":55508,"_5":14366,"_27421":55455,"_2948":55509},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3464":2029,"_30135":2011,"_20936":55511,"_5":14366,"_27421":55455,"_2948":55512},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3464":2030,"_30135":2011,"_20936":55514,"_5":14366,"_27421":55459,"_2948":55515},[],"Download the PEM and inspect it:",{"_3464":2031,"_30135":2011,"_20936":55517,"_5":14366,"_27421":55459,"_2948":55518},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3464":2032,"_30135":2011,"_20936":55520,"_5":14366,"_27421":55463,"_2948":55521},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3464":2033,"_30135":2011,"_20936":55523,"_5":14366,"_27421":55463,"_2948":55524},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3464":2034,"_30135":2011,"_20936":55526,"_5":14366,"_27421":55463,"_2948":55527},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3464":2035,"_30135":2011,"_20936":55529,"_5":14366,"_27421":55463,"_2948":55530},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3464":2036,"_30135":2011,"_20936":55532,"_5":14366,"_27421":55463,"_2948":55533},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3464":2037,"_30135":2011,"_20936":55535,"_5":14366,"_27421":55463,"_2948":55536},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3464":2038,"_30135":2011,"_20936":55538,"_5":14366,"_27421":55463,"_2948":55539},[],"For browser key generation, follow Issue your first certificate.",{"_3464":2039,"_30135":2011,"_20936":55541,"_5":14366,"_27421":55467,"_2948":55542},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3464":2040,"_30135":2011,"_20936":55544,"_5":14366,"_27421":55471,"_2948":55545},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3464":2041,"_30135":2011,"_20936":55547,"_5":14366,"_27421":55475,"_2948":55548},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3464":2042,"_30135":2011,"_20936":55550,"_5":14366,"_27421":55479,"_2948":55551},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3464":2043,"_30135":2011,"_20936":55553,"_5":14366,"_27421":55479,"_2948":55554},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3464":2044,"_30135":2011,"_20936":55556,"_5":14366,"_27421":55479,"_2948":55557},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3464":2045,"_30135":2011,"_20936":55559,"_5":14366,"_27421":55483,"_2948":55560},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3464":2046,"_30135":2011,"_20936":55562,"_5":14366,"_27421":55483,"_2948":55563},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3464":2047,"_30135":2011,"_20936":55565,"_5":14366,"_27421":55483,"_2948":55566},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3464":2048,"_30135":2011,"_20936":55568,"_5":14366,"_27421":55487,"_2948":55569},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":2049,"_30135":2011,"_20936":55571,"_5":14366,"_27421":55487,"_2948":55572},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3464":2050,"_30135":2050,"_5":14718,"_2948":55574,"_30488":55575,"_20936":55577,"_27421":2050},"Certificate lifecycle",[49202,50670,54682,55576],"Concepts",[],{"_3464":2051,"_30135":2050,"_20936":55579,"_5":14366,"_27421":2050,"_2948":55580},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3464":2052,"_30135":2050,"_5":30485,"_20936":55582,"_27421":55583,"_2948":55584},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3464":2053,"_30135":2050,"_5":30485,"_20936":55586,"_27421":55587,"_2948":55588},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3464":2054,"_30135":2050,"_5":30485,"_20936":55590,"_27421":55591,"_2948":55592},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3464":2055,"_30135":2050,"_5":30485,"_20936":55594,"_27421":55595,"_2948":55596},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3464":2056,"_30135":2050,"_5":30485,"_20936":55598,"_27421":55599,"_2948":55600},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3464":2057,"_30135":2050,"_5":30485,"_20936":55602,"_27421":55603,"_2948":55604},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3464":2058,"_30135":2050,"_5":30485,"_20936":55606,"_27421":55607,"_2948":55608},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3464":2059,"_30135":2050,"_5":30485,"_20936":55610,"_27421":55611,"_2948":55612},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3464":2060,"_30135":2050,"_5":30485,"_20936":55614,"_27421":55615,"_2948":55616},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3464":2061,"_30135":2050,"_5":30485,"_20936":55618,"_27421":55619,"_2948":55620},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3464":2062,"_30135":2050,"_20936":55622,"_5":14366,"_27421":2050,"_2948":55623},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3464":2063,"_30135":2050,"_20936":55625,"_5":14366,"_27421":55587,"_2948":55626},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3464":2064,"_30135":2050,"_20936":55628,"_5":14366,"_27421":55591,"_2948":55629},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3464":2065,"_30135":2050,"_20936":55631,"_5":14366,"_27421":55595,"_2948":55632},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3464":2066,"_30135":2050,"_20936":55634,"_5":14366,"_27421":55599,"_2948":55635},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3464":2067,"_30135":2050,"_20936":55637,"_5":14366,"_27421":55603,"_2948":55638},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3464":2068,"_30135":2050,"_20936":55640,"_5":14366,"_27421":55607,"_2948":55641},[],"Lamassu persists four X.509 states:",{"_3464":2069,"_30135":2050,"_20936":55643,"_5":14366,"_27421":55607,"_2948":55644},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3464":2070,"_30135":2050,"_20936":55646,"_5":14366,"_27421":55607,"_2948":55647},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3464":2071,"_30135":2050,"_20936":55649,"_5":14366,"_27421":55607,"_2948":55650},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3464":2072,"_30135":2050,"_20936":55652,"_5":14366,"_27421":55607,"_2948":55653},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3464":2073,"_30135":2050,"_20936":55655,"_5":14366,"_27421":55607,"_2948":55656},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3464":2074,"_30135":2050,"_20936":55658,"_5":14366,"_27421":55611,"_2948":55659},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3464":2075,"_30135":2050,"_20936":55661,"_5":14366,"_27421":55611,"_2948":55662},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3464":2076,"_30135":2050,"_20936":55664,"_5":14366,"_27421":55611,"_2948":55665},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3464":2077,"_30135":2050,"_20936":55667,"_5":14366,"_27421":55615,"_2948":55668},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3464":2078,"_30135":2050,"_20936":55670,"_5":14366,"_27421":55615,"_2948":55671},[],"Before confirming:",{"_3464":2079,"_30135":2050,"_20936":55673,"_5":14366,"_27421":55615,"_2948":55674},[],"Identify DMSs, devices and services that trust that chain.",{"_3464":2080,"_30135":2050,"_20936":55676,"_5":14366,"_27421":55615,"_2948":55677},[],"Distribute the new chain of trust.",{"_3464":2081,"_30135":2050,"_20936":55679,"_5":14366,"_27421":55615,"_2948":55680},[],"Reissue the necessary identities.",{"_3464":2082,"_30135":2050,"_20936":55682,"_5":14366,"_27421":55615,"_2948":55683},[],"Check OCSP and CRL from a real consumer.",{"_3464":2083,"_30135":2050,"_20936":55685,"_5":14366,"_27421":55615,"_2948":55686},[],"Revoke the old CA once no legitimate traffic remains.",{"_3464":2084,"_30135":2050,"_20936":55688,"_5":14366,"_27421":55615,"_2948":55689},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3464":2085,"_30135":2050,"_20936":55691,"_5":14366,"_27421":55619,"_2948":55692},[],"Certificates entering the preventive or critical renewal window.",{"_3464":2086,"_30135":2050,"_20936":55694,"_5":14366,"_27421":55619,"_2948":55695},[],"Repeated enrollment or re-enrollment failures.",{"_3464":2087,"_30135":2050,"_20936":55697,"_5":14366,"_27421":55619,"_2948":55698},[],"Status changes and revocation reasons.",{"_3464":2088,"_30135":2050,"_20936":55700,"_5":14366,"_27421":55619,"_2948":55701},[],"OCSP and CRL publication and validity.",{"_3464":2089,"_30135":2050,"_20936":55703,"_5":14366,"_27421":55619,"_2948":55704},[],"Dependencies still presenting a replaced certificate.",{"_3464":2090,"_30135":2050,"_20936":55706,"_5":14366,"_27421":55619,"_2948":55707},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3464":2091,"_30135":2091,"_5":14718,"_2948":55709,"_30488":55710,"_20936":55711,"_27421":2091},"Trust model",[49202,50670,54682,55576],[],{"_3464":2092,"_30135":2091,"_20936":55713,"_5":14366,"_27421":2091,"_2948":55714},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3464":2093,"_30135":2091,"_5":30485,"_20936":55716,"_27421":55717,"_2948":55718},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3464":2094,"_30135":2091,"_5":30485,"_20936":55720,"_27421":55721,"_2948":55722},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3464":2095,"_30135":2091,"_5":30485,"_20936":55724,"_27421":55725,"_2948":55726},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3464":2096,"_30135":2091,"_5":30485,"_20936":55728,"_27421":55729,"_2948":55730},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3464":2097,"_30135":2091,"_5":30485,"_20936":55732,"_27421":55733,"_2948":55734},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3464":2098,"_30135":2091,"_5":30485,"_20936":55736,"_27421":55737,"_2948":55738},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3464":2099,"_30135":2091,"_5":30485,"_20936":55740,"_27421":55741,"_2948":55742},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3464":2100,"_30135":2091,"_5":30485,"_20936":55744,"_27421":55745,"_2948":55746},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3464":2101,"_30135":2091,"_5":30485,"_20936":55748,"_27421":55749,"_2948":55750},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3464":2102,"_30135":2091,"_5":30485,"_20936":55752,"_27421":55753,"_2948":55754},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3464":2103,"_30135":2091,"_20936":55756,"_5":14366,"_27421":2091,"_2948":55757},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3464":2104,"_30135":2091,"_20936":55759,"_5":14366,"_27421":55721,"_2948":55760},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3464":2105,"_30135":2091,"_20936":55762,"_5":14366,"_27421":55725,"_2948":55763},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3464":2106,"_30135":2091,"_20936":55765,"_5":14366,"_27421":55729,"_2948":55766},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3464":2107,"_30135":2091,"_20936":55768,"_5":14366,"_27421":55733,"_2948":55769},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3464":2108,"_30135":2091,"_20936":55771,"_5":14366,"_27421":55737,"_2948":55772},[],"The device proves it can enroll according to the DMS policy.",{"_3464":2109,"_30135":2091,"_20936":55774,"_5":14366,"_27421":55737,"_2948":55775},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3464":2110,"_30135":2091,"_20936":55777,"_5":14366,"_27421":55737,"_2948":55778},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3464":2111,"_30135":2091,"_20936":55780,"_5":14366,"_27421":55737,"_2948":55781},[],"The device installs the certificate and the chain it needs.",{"_3464":2112,"_30135":2091,"_20936":55783,"_5":14366,"_27421":55737,"_2948":55784},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3464":2113,"_30135":2091,"_20936":55786,"_5":14366,"_27421":55737,"_2948":55787},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3464":2114,"_30135":2091,"_20936":55789,"_5":14366,"_27421":55741,"_2948":55790},[],"A DMS relates three sets that are worth designing separately:",{"_3464":2115,"_30135":2091,"_20936":55792,"_5":14366,"_27421":55741,"_2948":55793},[],"**Enrollment CA:** signs the new identities.",{"_3464":2116,"_30135":2091,"_20936":55795,"_5":14366,"_27421":55741,"_2948":55796},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3464":2117,"_30135":2091,"_20936":55798,"_5":14366,"_27421":55741,"_2948":55799},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3464":2118,"_30135":2091,"_20936":55801,"_5":14366,"_27421":55741,"_2948":55802},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3464":2119,"_30135":2091,"_20936":55804,"_5":14366,"_27421":55745,"_2948":55805},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3464":2120,"_30135":2091,"_20936":55807,"_5":14366,"_27421":55745,"_2948":55808},[],"that the current date is between `Not Before` and `Not After`;",{"_3464":2121,"_30135":2091,"_20936":55810,"_5":14366,"_27421":55745,"_2948":55811},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3464":2122,"_30135":2091,"_20936":55813,"_5":14366,"_27421":55745,"_2948":55814},[],"that names, SANs and subject match the expected identity;",{"_3464":2123,"_30135":2091,"_20936":55816,"_5":14366,"_27421":55745,"_2948":55817},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3464":2124,"_30135":2091,"_20936":55819,"_5":14366,"_27421":55745,"_2948":55820},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3464":2125,"_30135":2091,"_20936":55822,"_5":14366,"_27421":55745,"_2948":55823},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3464":2126,"_30135":2091,"_20936":55825,"_5":14366,"_27421":55749,"_2948":55826},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3464":2127,"_30135":2091,"_20936":55828,"_5":14366,"_27421":55753,"_2948":55829},[],"Keep the root out of daily operations, or with very restricted access.",{"_3464":2128,"_30135":2091,"_20936":55831,"_5":14366,"_27421":55753,"_2948":55832},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3464":2129,"_30135":2091,"_20936":55834,"_5":14366,"_27421":55753,"_2948":55835},[],"Assign explicit profiles to every use case.",{"_3464":2130,"_30135":2091,"_20936":55837,"_5":14366,"_27421":55753,"_2948":55838},[],"Distribute the new trust before starting a rotation.",{"_3464":2131,"_30135":2091,"_20936":55840,"_5":14366,"_27421":55753,"_2948":55841},[],"Keep enough overlap to renew a disconnected fleet.",{"_3464":2132,"_30135":2091,"_20936":55843,"_5":14366,"_27421":55753,"_2948":55844},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3464":2133,"_30135":2091,"_20936":55846,"_5":14366,"_27421":55753,"_2948":55847},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3464":2134,"_30135":2134,"_5":14718,"_2948":55849,"_30488":55850,"_20936":55851,"_27421":2134},"Revocation lists (CRL)",[49202,50670,54682,55321],[],{"_3464":2135,"_30135":2134,"_20936":55853,"_5":14366,"_27421":2134,"_2948":55854},[],"Generate and distribute signed lists to validate certificates offline.",{"_3464":2136,"_30135":2134,"_5":30485,"_20936":55856,"_27421":55857,"_2948":55858},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings","CRL settings",{"_3464":2137,"_30135":2134,"_5":30485,"_20936":55860,"_27421":55861,"_2948":55862},[],"/docs/pr-preview/pr-61/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3464":2138,"_30135":2134,"_5":30485,"_20936":55864,"_27421":55865,"_2948":55866},[],"/docs/pr-preview/pr-61/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3464":2139,"_30135":2134,"_5":30485,"_20936":55868,"_27421":55869,"_2948":55870},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-contents","CRL contents",{"_3464":2140,"_30135":2134,"_5":30485,"_20936":55872,"_27421":55873,"_2948":55874},[],"/docs/pr-preview/pr-61/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3464":2141,"_30135":2134,"_5":30485,"_20936":55876,"_27421":55877,"_2948":55878},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings-api","CRL settings API",{"_3464":2142,"_30135":2134,"_5":30485,"_20936":55880,"_27421":55881,"_2948":55882},[],"/docs/pr-preview/pr-61/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3464":2143,"_30135":2134,"_5":30485,"_20936":55884,"_27421":55885,"_2948":55886},[],"/docs/pr-preview/pr-61/platform/pki/crl#from-the-interface","From the interface",{"_3464":2144,"_30135":2134,"_5":30485,"_20936":55888,"_27421":55889,"_2948":55890},[],"/docs/pr-preview/pr-61/platform/pki/crl#references","References",{"_3464":2145,"_30135":2134,"_20936":55892,"_5":14366,"_27421":2134,"_2948":55893},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3464":2146,"_30135":2134,"_20936":55895,"_5":14366,"_27421":55857,"_2948":55896},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3464":2147,"_30135":2134,"_20936":55898,"_5":14366,"_27421":55857,"_2948":55899},[],"Field",{"_3464":2148,"_30135":2134,"_20936":55901,"_5":14366,"_27421":55857,"_2948":49592},[],{"_3464":2149,"_30135":2134,"_20936":55903,"_5":14366,"_27421":55857,"_2948":55904},[],"`ca_id`",{"_3464":2150,"_30135":2134,"_20936":55906,"_5":14366,"_27421":55857,"_2948":55907},[],"ID of the CA the settings belong to.",{"_3464":2151,"_30135":2134,"_20936":55909,"_5":14366,"_27421":55857,"_2948":55910},[],"`status`",{"_3464":2152,"_30135":2134,"_20936":55912,"_5":14366,"_27421":55857,"_2948":55913},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3464":2153,"_30135":2134,"_20936":55915,"_5":14366,"_27421":55857,"_2948":55916},[],"`legacy_ski`",{"_3464":2154,"_30135":2134,"_20936":55918,"_5":14366,"_27421":55857,"_2948":55919},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3464":2155,"_30135":2134,"_20936":55921,"_5":14366,"_27421":55857,"_2948":55922},[],"`latest_crl`",{"_3464":2156,"_30135":2134,"_20936":55924,"_5":14366,"_27421":55857,"_2948":55925},[],"Version, validity start and end of the last published list. Read-only.",{"_3464":2157,"_30135":2134,"_20936":55927,"_5":14366,"_27421":55857,"_2948":55928},[],"`crl_options` field",{"_3464":2158,"_30135":2134,"_20936":55930,"_5":14366,"_27421":55857,"_2948":49592},[],{"_3464":2159,"_30135":2134,"_20936":55932,"_5":14366,"_27421":55857,"_2948":55933},[],"Initial value",{"_3464":2160,"_30135":2134,"_20936":55935,"_5":14366,"_27421":55857,"_2948":55936},[],"`validity`",{"_3464":2161,"_30135":2134,"_20936":55938,"_5":14366,"_27421":55857,"_2948":55939},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3464":2162,"_30135":2134,"_20936":55941,"_5":14366,"_27421":55857,"_2948":55942},[],"7 days.",{"_3464":2163,"_30135":2134,"_20936":55944,"_5":14366,"_27421":55857,"_2948":55945},[],"`refresh_interval`",{"_3464":2164,"_30135":2134,"_20936":55947,"_5":14366,"_27421":55857,"_2948":55948},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3464":2165,"_30135":2134,"_20936":55950,"_5":14366,"_27421":55857,"_2948":55951},[],"6 days and 23 hours.",{"_3464":2166,"_30135":2134,"_20936":55953,"_5":14366,"_27421":55857,"_2948":55954},[],"`regenerate_on_revoke`",{"_3464":2167,"_30135":2134,"_20936":55956,"_5":14366,"_27421":55857,"_2948":55957},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3464":2168,"_30135":2134,"_20936":55959,"_5":14366,"_27421":55857,"_2948":55960},[],"`true`.",{"_3464":2169,"_30135":2134,"_20936":55962,"_5":14366,"_27421":55857,"_2948":55963},[],"`signer_serial_number`",{"_3464":2170,"_30135":2134,"_20936":55965,"_5":14366,"_27421":55857,"_2948":55966},[],"Serial number of the existing certificate that signs the CRL.",{"_3464":2171,"_30135":2134,"_20936":55968,"_5":14366,"_27421":55857,"_2948":55969},[],"Serial number of the CA’s current certificate.",{"_3464":2172,"_30135":2134,"_20936":55971,"_5":14366,"_27421":55857,"_2948":55972},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3464":2173,"_30135":2134,"_20936":55974,"_5":14366,"_27421":55857,"_2948":55975},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3464":2174,"_30135":2134,"_20936":55977,"_5":14366,"_27421":55857,"_2948":55978},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3464":2175,"_30135":2134,"_20936":55980,"_5":14366,"_27421":55857,"_2948":55981},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3464":2176,"_30135":2134,"_20936":55983,"_5":14366,"_27421":55857,"_2948":55984},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3464":2177,"_30135":2134,"_20936":55986,"_5":14366,"_27421":55857,"_2948":55987},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3464":2178,"_30135":2134,"_20936":55989,"_5":14366,"_27421":55857,"_2948":55990},[],"Adjust validity and signer before deleting a CA.",{"_3464":2179,"_30135":2134,"_20936":55992,"_5":14366,"_27421":55857,"_2948":55993},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3464":2180,"_30135":2134,"_20936":55995,"_5":14366,"_27421":55857,"_2948":55996},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3464":2181,"_30135":2134,"_20936":55998,"_5":14366,"_27421":55857,"_2948":55999},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3464":2182,"_30135":2134,"_20936":56001,"_5":14366,"_27421":55861,"_2948":56002},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3464":2183,"_30135":2134,"_20936":56004,"_5":14366,"_27421":55861,"_2948":56005},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3464":2184,"_30135":2134,"_20936":56007,"_5":14366,"_27421":55861,"_2948":56008},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3464":2185,"_30135":2134,"_20936":56010,"_5":14366,"_27421":55861,"_2948":56011},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3464":2186,"_30135":2134,"_20936":56013,"_5":14366,"_27421":55865,"_2948":56014},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3464":2187,"_30135":2134,"_20936":56016,"_5":14366,"_27421":55865,"_2948":56017},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3464":2188,"_30135":2134,"_20936":56019,"_5":14366,"_27421":55865,"_2948":56020},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3464":2189,"_30135":2134,"_20936":56022,"_5":14366,"_27421":55865,"_2948":56023},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3464":2190,"_30135":2134,"_20936":56025,"_5":14366,"_27421":55865,"_2948":56026},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3464":2191,"_30135":2134,"_20936":56028,"_5":14366,"_27421":55865,"_2948":56029},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3464":2192,"_30135":2134,"_20936":56031,"_5":14366,"_27421":55865,"_2948":56032},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3464":2193,"_30135":2134,"_20936":56034,"_5":14366,"_27421":55865,"_2948":56035},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3464":2194,"_30135":2134,"_20936":56037,"_5":14366,"_27421":55865,"_2948":56038},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3464":2195,"_30135":2134,"_20936":56040,"_5":14366,"_27421":55869,"_2948":56041},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3464":2196,"_30135":2134,"_20936":56043,"_5":14366,"_27421":55869,"_2948":56044},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3464":2197,"_30135":2134,"_20936":56046,"_5":14366,"_27421":55873,"_2948":56047},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3464":2198,"_30135":2134,"_20936":56049,"_5":14366,"_27421":55873,"_2948":56050},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3464":2199,"_30135":2134,"_20936":56052,"_5":14366,"_27421":55873,"_2948":56053},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3464":2200,"_30135":2134,"_20936":56055,"_5":14366,"_27421":55873,"_2948":56056},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3464":2201,"_30135":2134,"_20936":56058,"_5":14366,"_27421":55873,"_2948":56059},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3464":2202,"_30135":2134,"_20936":56061,"_5":14366,"_27421":55877,"_2948":56062},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3464":2203,"_30135":2134,"_20936":56064,"_5":14366,"_27421":55877,"_2948":52440},[],{"_3464":2204,"_30135":2134,"_20936":56066,"_5":14366,"_27421":55877,"_2948":56067},[],"Relative path",{"_3464":2205,"_30135":2134,"_20936":56069,"_5":14366,"_27421":55877,"_2948":52437},[],{"_3464":2206,"_30135":2134,"_20936":56071,"_5":14366,"_27421":55877,"_2948":56072},[],"`GET`",{"_3464":2207,"_30135":2134,"_20936":56074,"_5":14366,"_27421":55877,"_2948":56075},[],"`/v1/crl-settings`",{"_3464":2208,"_30135":2134,"_20936":56077,"_5":14366,"_27421":55877,"_2948":56078},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3464":2209,"_30135":2134,"_20936":56080,"_5":14366,"_27421":55877,"_2948":56072},[],{"_3464":2210,"_30135":2134,"_20936":56082,"_5":14366,"_27421":55877,"_2948":56083},[],"`/v1/crl-settings/{ca-id}`",{"_3464":2211,"_30135":2134,"_20936":56085,"_5":14366,"_27421":55877,"_2948":56086},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3464":2212,"_30135":2134,"_20936":56088,"_5":14366,"_27421":55877,"_2948":56089},[],"`PUT`",{"_3464":2213,"_30135":2134,"_20936":56091,"_5":14366,"_27421":55877,"_2948":56083},[],{"_3464":2214,"_30135":2134,"_20936":56093,"_5":14366,"_27421":55877,"_2948":56094},[],"Replace the CRL configuration of a CA.",{"_3464":2215,"_30135":2134,"_20936":56096,"_5":14366,"_27421":55877,"_2948":56097},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3464":2216,"_30135":2134,"_20936":56099,"_5":14366,"_27421":55877,"_2948":56100},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3464":2217,"_30135":2134,"_20936":56102,"_5":14366,"_27421":55881,"_2948":56103},[],"Symptom",{"_3464":2218,"_30135":2134,"_20936":56105,"_5":14366,"_27421":55881,"_2948":56106},[],"Cause",{"_3464":2219,"_30135":2134,"_20936":56108,"_5":14366,"_27421":55881,"_2948":56109},[],"Action",{"_3464":2220,"_30135":2134,"_20936":56111,"_5":14366,"_27421":55881,"_2948":56112},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3464":2221,"_30135":2134,"_20936":56114,"_5":14366,"_27421":55881,"_2948":56115},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3464":2222,"_30135":2134,"_20936":56117,"_5":14366,"_27421":55881,"_2948":56118},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3464":2223,"_30135":2134,"_20936":56120,"_5":14366,"_27421":55881,"_2948":56121},[],"`PUT` returns 400.",{"_3464":2224,"_30135":2134,"_20936":56123,"_5":14366,"_27421":55881,"_2948":56124},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3464":2225,"_30135":2134,"_20936":56126,"_5":14366,"_27421":55881,"_2948":56127},[],"Set the serial number of a valid certificate of that CA.",{"_3464":2226,"_30135":2134,"_20936":56129,"_5":14366,"_27421":55881,"_2948":56130},[],"`PUT` returns 404.",{"_3464":2227,"_30135":2134,"_20936":56132,"_5":14366,"_27421":55881,"_2948":56133},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3464":2228,"_30135":2134,"_20936":56135,"_5":14366,"_27421":55881,"_2948":56136},[],"Check the CA ID and the signer serial number.",{"_3464":2229,"_30135":2134,"_20936":56138,"_5":14366,"_27421":55881,"_2948":56139},[],"`PUT` returns 400 from a 3.x client.",{"_3464":2230,"_30135":2134,"_20936":56141,"_5":14366,"_27421":55881,"_2948":56142},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3464":2231,"_30135":2134,"_20936":56144,"_5":14366,"_27421":55881,"_2948":56145},[],"Update the client to send the new field.",{"_3464":2232,"_30135":2134,"_20936":56147,"_5":14366,"_27421":55881,"_2948":56148},[],"The CRL does not change after revoking a certificate.",{"_3464":2233,"_30135":2134,"_20936":56150,"_5":14366,"_27421":55881,"_2948":56151},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3464":2234,"_30135":2134,"_20936":56153,"_5":14366,"_27421":55881,"_2948":56154},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3464":2235,"_30135":2134,"_20936":56156,"_5":14366,"_27421":55881,"_2948":56157},[],"A verifier rejects the CRL because of the issuer.",{"_3464":2236,"_30135":2134,"_20936":56159,"_5":14366,"_27421":55881,"_2948":56160},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3464":2237,"_30135":2134,"_20936":56162,"_5":14366,"_27421":55881,"_2948":56163},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3464":2238,"_30135":2134,"_20936":56165,"_5":14366,"_27421":55885,"_2948":56166},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3464":2239,"_30135":2134,"_20936":56168,"_5":14366,"_27421":55889,"_2948":56169},[],"RFC 5280: X.509 and CRL profile.",{"_3464":2240,"_30135":2134,"_20936":56171,"_5":14366,"_27421":55889,"_2948":56172},[],"OpenSSL: openssl-crl.",{"_3464":2241,"_30135":2134,"_20936":56174,"_5":14366,"_27421":55889,"_2948":56175},[],"OpenSSL: openssl-verify.",{"_3464":2242,"_30135":2134,"_20936":56177,"_5":14366,"_27421":55889,"_2948":56178},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":2243,"_30135":2134,"_20936":56180,"_5":14366,"_27421":55889,"_2948":56181},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3464":2244,"_30135":2244,"_5":14718,"_2948":56183,"_30488":56184,"_20936":56185,"_27421":2244},"Keys and cryptographic engines",[49202,50670,54682,54683],[],{"_3464":2245,"_30135":2244,"_20936":56187,"_5":14366,"_27421":2244,"_2948":56188},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3464":2246,"_30135":2244,"_5":30485,"_20936":56190,"_27421":56191,"_2948":56192},[],"/docs/pr-preview/pr-61/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3464":2247,"_30135":2244,"_5":30485,"_20936":56194,"_27421":56195,"_2948":56196},[],"/docs/pr-preview/pr-61/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3464":2248,"_30135":2244,"_5":30485,"_20936":56198,"_27421":56199,"_2948":56200},[],"/docs/pr-preview/pr-61/platform/pki/key-management#file-system","File System",{"_3464":2249,"_30135":2244,"_5":30485,"_20936":56202,"_27421":56203,"_2948":56204},[],"/docs/pr-preview/pr-61/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3464":2250,"_30135":2244,"_5":30485,"_20936":56206,"_27421":56207,"_2948":56208},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3464":2251,"_30135":2244,"_5":30485,"_20936":56210,"_27421":56211,"_2948":56212},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-kms","AWS KMS",{"_3464":2252,"_30135":2244,"_5":30485,"_20936":56214,"_27421":56215,"_2948":56216},[],"/docs/pr-preview/pr-61/platform/pki/key-management#pkcs11","PKCS#11",{"_3464":2253,"_30135":2244,"_5":30485,"_20936":56218,"_27421":56219,"_2948":56220},[],"/docs/pr-preview/pr-61/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3464":2254,"_30135":2244,"_5":30485,"_20936":56222,"_27421":56223,"_2948":56224},[],"/docs/pr-preview/pr-61/platform/pki/key-management#key-inventory","Key inventory",{"_3464":2255,"_30135":2244,"_5":30485,"_20936":56226,"_27421":56227,"_2948":56228},[],"/docs/pr-preview/pr-61/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3464":2256,"_30135":2244,"_5":30485,"_20936":56230,"_27421":56231,"_2948":56232},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3464":2257,"_30135":2244,"_5":30485,"_20936":56234,"_27421":56235,"_2948":56236},[],"/docs/pr-preview/pr-61/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3464":2258,"_30135":2244,"_5":30485,"_20936":56238,"_27421":56239,"_2948":56240},[],"/docs/pr-preview/pr-61/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3464":2259,"_30135":2244,"_5":30485,"_20936":56242,"_27421":56243,"_2948":56244},[],"/docs/pr-preview/pr-61/platform/pki/key-management#view-details","View details",{"_3464":2260,"_30135":2244,"_5":30485,"_20936":56246,"_27421":56247,"_2948":56248},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3464":2261,"_30135":2244,"_5":30485,"_20936":56250,"_27421":56251,"_2948":56252},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign","Sign",{"_3464":2262,"_30135":2244,"_5":30485,"_20936":56254,"_27421":56255,"_2948":56256},[],"/docs/pr-preview/pr-61/platform/pki/key-management#verify","Verify",{"_3464":2263,"_30135":2244,"_5":30485,"_20936":56258,"_27421":56259,"_2948":56260},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3464":2264,"_30135":2244,"_5":30485,"_20936":56262,"_27421":56263,"_2948":56264},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3464":2265,"_30135":2244,"_5":30485,"_20936":56266,"_27421":56267,"_2948":56268},[],"/docs/pr-preview/pr-61/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3464":2266,"_30135":2244,"_20936":56270,"_5":14366,"_27421":2244,"_2948":56271},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3464":2267,"_30135":2244,"_20936":56273,"_5":14366,"_27421":2244,"_2948":56274},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3464":2268,"_30135":2244,"_20936":56276,"_5":14366,"_27421":56191,"_2948":56277},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3464":2269,"_30135":2244,"_20936":56279,"_5":14366,"_27421":56191,"_2948":56280},[],"In practice, it lets you:",{"_3464":2270,"_30135":2244,"_20936":56282,"_5":14366,"_27421":56191,"_2948":56283},[],"Generate new key pairs from Lamassu IoT.",{"_3464":2271,"_30135":2244,"_20936":56285,"_5":14366,"_27421":56191,"_2948":56286},[],"Import keys created externally.",{"_3464":2272,"_30135":2244,"_20936":56288,"_5":14366,"_27421":56191,"_2948":56289},[],"Delegate custody and cryptographic operations to external engines.",{"_3464":2273,"_30135":2244,"_20936":56291,"_5":14366,"_27421":56191,"_2948":56292},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3464":2274,"_30135":2244,"_20936":56294,"_5":14366,"_27421":56195,"_2948":56295},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3464":2275,"_30135":2244,"_20936":56297,"_5":14366,"_27421":56195,"_2948":56298},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3464":2276,"_30135":2244,"_20936":56300,"_5":14366,"_27421":56195,"_2948":56301},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3464":2277,"_30135":2244,"_20936":56303,"_5":14366,"_27421":56199,"_2948":56304},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3464":2278,"_30135":2244,"_20936":56306,"_5":14366,"_27421":56203,"_2948":56307},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3464":2279,"_30135":2244,"_20936":56309,"_5":14366,"_27421":56203,"_2948":56310},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3464":2280,"_30135":2244,"_20936":56312,"_5":14366,"_27421":56207,"_2948":56313},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3464":2281,"_30135":2244,"_20936":56315,"_5":14366,"_27421":56211,"_2948":56316},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3464":2282,"_30135":2244,"_20936":56318,"_5":14366,"_27421":56215,"_2948":56319},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3464":2283,"_30135":2244,"_20936":56321,"_5":14366,"_27421":56219,"_2948":56322},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3464":2284,"_30135":2244,"_20936":56324,"_5":14366,"_27421":56219,"_2948":56325},[],"Lamassu shows the enabled engines in the console.",{"_3464":2285,"_30135":2244,"_20936":56327,"_5":14366,"_27421":56219,"_2948":56328},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3464":2286,"_30135":2244,"_20936":56330,"_5":14366,"_27421":56219,"_2948":56331},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3464":2287,"_30135":2244,"_20936":56333,"_5":14366,"_27421":56223,"_2948":56334},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3464":2288,"_30135":2244,"_20936":56336,"_5":14366,"_27421":56223,"_2948":56337},[],"The table includes the following fields:",{"_3464":2289,"_30135":2244,"_20936":56339,"_5":14366,"_27421":56223,"_2948":56340},[],"**Name**: descriptive name of the key.",{"_3464":2290,"_30135":2244,"_20936":56342,"_5":14366,"_27421":56223,"_2948":56343},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3464":2291,"_30135":2244,"_20936":56345,"_5":14366,"_27421":56223,"_2948":56346},[],"**Strength**: visual indicator of cryptographic strength.",{"_3464":2292,"_30135":2244,"_20936":56348,"_5":14366,"_27421":56223,"_2948":56349},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3464":2293,"_30135":2244,"_20936":56351,"_5":14366,"_27421":56223,"_2948":56352},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3464":2294,"_30135":2244,"_20936":56354,"_5":14366,"_27421":56223,"_2948":56355},[],"**Aliases**: alternative names associated with the key.",{"_3464":2295,"_30135":2244,"_20936":56357,"_5":14366,"_27421":56223,"_2948":56358},[],"**Tags**: labels for classification and search.",{"_3464":2296,"_30135":2244,"_20936":56360,"_5":14366,"_27421":56223,"_2948":56361},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3464":2297,"_30135":2244,"_20936":56363,"_5":14366,"_27421":56223,"_2948":56364},[],"From this view you also reach the most common actions:",{"_3464":2298,"_30135":2244,"_20936":56366,"_5":14366,"_27421":56223,"_2948":56367},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3464":2299,"_30135":2244,"_20936":56369,"_5":14366,"_27421":56223,"_2948":56370},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3464":2300,"_30135":2244,"_20936":56372,"_5":14366,"_27421":56223,"_2948":56373},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3464":2301,"_30135":2244,"_20936":56375,"_5":14366,"_27421":56223,"_2948":56376},[],"**Delete Key** to remove the key from the system.",{"_3464":2302,"_30135":2244,"_20936":56378,"_5":14366,"_27421":56227,"_2948":56379},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3464":2303,"_30135":2244,"_20936":56381,"_5":14366,"_27421":56231,"_2948":56382},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3464":2304,"_30135":2244,"_20936":56384,"_5":14366,"_27421":56231,"_2948":56385},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3464":2305,"_30135":2244,"_20936":56387,"_5":14366,"_27421":56231,"_2948":56388},[],"**Key Name**: unique and descriptive name.",{"_3464":2306,"_30135":2244,"_20936":56390,"_5":14366,"_27421":56231,"_2948":56391},[],"**Crypto Engine**: engine that will keep the key.",{"_3464":2307,"_30135":2244,"_20936":56393,"_5":14366,"_27421":56231,"_2948":56394},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3464":2308,"_30135":2244,"_20936":56396,"_5":14366,"_27421":56231,"_2948":56397},[],"**Tags**: metadata to classify the key.",{"_3464":2309,"_30135":2244,"_20936":56399,"_5":14366,"_27421":56231,"_2948":56400},[],"**Metadata**: additional information for advanced uses.",{"_3464":2310,"_30135":2244,"_20936":56402,"_5":14366,"_27421":56235,"_2948":56403},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3464":2311,"_30135":2244,"_20936":56405,"_5":14366,"_27421":56235,"_2948":56406},[],"When you have an exportable private key and the destination engine supports import.",{"_3464":2312,"_30135":2244,"_20936":56408,"_5":14366,"_27421":56235,"_2948":56409},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3464":2313,"_30135":2244,"_20936":56411,"_5":14366,"_27421":56235,"_2948":56412},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3464":2314,"_30135":2244,"_20936":56414,"_5":14366,"_27421":56235,"_2948":56415},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3464":2315,"_30135":2244,"_20936":56417,"_5":14366,"_27421":56235,"_2948":56418},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3464":2316,"_30135":2244,"_20936":56420,"_5":14366,"_27421":56235,"_2948":56421},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3464":2317,"_30135":2244,"_20936":56423,"_5":14366,"_27421":56235,"_2948":56424},[],"**Tags**: labels for organization and search.",{"_3464":2318,"_30135":2244,"_20936":56426,"_5":14366,"_27421":56235,"_2948":56427},[],"**Metadata**: additional optional information.",{"_3464":2319,"_30135":2244,"_20936":56429,"_5":14366,"_27421":56235,"_2948":56430},[],"**Private Key (PEM)**: private key in PEM format.",{"_3464":2320,"_30135":2244,"_20936":56432,"_5":14366,"_27421":56235,"_2948":56433},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3464":2321,"_30135":2244,"_20936":56435,"_5":14366,"_27421":56239,"_2948":56436},[],"Each registered key has a detail view and several operational actions.",{"_3464":2322,"_30135":2244,"_20936":56438,"_5":14366,"_27421":56243,"_2948":56439},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3464":2323,"_30135":2244,"_20936":56441,"_5":14366,"_27421":56243,"_2948":56442},[],"The **Overview** tab shows, among others, these fields:",{"_3464":2324,"_30135":2244,"_20936":56444,"_5":14366,"_27421":56243,"_2948":56445},[],"**Key Name**: descriptive name.",{"_3464":2325,"_30135":2244,"_20936":56447,"_5":14366,"_27421":56243,"_2948":56448},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3464":2326,"_30135":2244,"_20936":56450,"_5":14366,"_27421":56243,"_2948":56451},[],"**Tags**: associated labels.",{"_3464":2327,"_30135":2244,"_20936":56453,"_5":14366,"_27421":56243,"_2948":56454},[],"**Aliases**: alternative names.",{"_3464":2328,"_30135":2244,"_20936":56456,"_5":14366,"_27421":56243,"_2948":56457},[],"**Crypto Engine**: engine where the key resides.",{"_3464":2329,"_30135":2244,"_20936":56459,"_5":14366,"_27421":56243,"_2948":56460},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3464":2330,"_30135":2244,"_20936":56462,"_5":14366,"_27421":56243,"_2948":56463},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3464":2331,"_30135":2244,"_20936":56465,"_5":14366,"_27421":56243,"_2948":56466},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3464":2332,"_30135":2244,"_20936":56468,"_5":14366,"_27421":56247,"_2948":56469},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3464":2333,"_30135":2244,"_20936":56471,"_5":14366,"_27421":56247,"_2948":56472},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3464":2334,"_30135":2244,"_20936":56474,"_5":14366,"_27421":56247,"_2948":56475},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3464":2335,"_30135":2244,"_20936":56477,"_5":14366,"_27421":56251,"_2948":56478},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3464":2336,"_30135":2244,"_20936":56480,"_5":14366,"_27421":56251,"_2948":56481},[],"Main fields:",{"_3464":2337,"_30135":2244,"_20936":56483,"_5":14366,"_27421":56251,"_2948":56484},[],"**Algorithm**: signing algorithm available for the key type.",{"_3464":2338,"_30135":2244,"_20936":56486,"_5":14366,"_27421":56251,"_2948":56487},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3464":2339,"_30135":2244,"_20936":56489,"_5":14366,"_27421":56251,"_2948":56490},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3464":2340,"_30135":2244,"_20936":56492,"_5":14366,"_27421":56251,"_2948":56493},[],"**Message**: content to sign.",{"_3464":2341,"_30135":2244,"_20936":56495,"_5":14366,"_27421":56251,"_2948":56496},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3464":2342,"_30135":2244,"_20936":56498,"_5":14366,"_27421":56255,"_2948":56499},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3464":2343,"_30135":2244,"_20936":56501,"_5":14366,"_27421":56255,"_2948":56481},[],{"_3464":2344,"_30135":2244,"_20936":56503,"_5":14366,"_27421":56255,"_2948":56504},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3464":2345,"_30135":2244,"_20936":56506,"_5":14366,"_27421":56255,"_2948":56507},[],"**Message Type**: `Raw` or `Digest`.",{"_3464":2346,"_30135":2244,"_20936":56509,"_5":14366,"_27421":56255,"_2948":56510},[],"**Payload Encoding**: encoding of the message.",{"_3464":2347,"_30135":2244,"_20936":56512,"_5":14366,"_27421":56255,"_2948":56513},[],"**Message**: original message or hash.",{"_3464":2348,"_30135":2244,"_20936":56515,"_5":14366,"_27421":56255,"_2948":56516},[],"**Signature**: signature to check.",{"_3464":2349,"_30135":2244,"_20936":56518,"_5":14366,"_27421":56255,"_2948":56519},[],"**Result**: indicator of the validation result.",{"_3464":2350,"_30135":2244,"_20936":56521,"_5":14366,"_27421":56259,"_2948":56522},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3464":2351,"_30135":2244,"_20936":56524,"_5":14366,"_27421":56259,"_2948":56525},[],"This flow is useful for:",{"_3464":2352,"_30135":2244,"_20936":56527,"_5":14366,"_27421":56259,"_2948":56528},[],"Requesting certificates from an external CA.",{"_3464":2353,"_30135":2244,"_20936":56530,"_5":14366,"_27421":56259,"_2948":56531},[],"Renewing an identity while keeping the same key.",{"_3464":2354,"_30135":2244,"_20936":56533,"_5":14366,"_27421":56259,"_2948":56534},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3464":2355,"_30135":2244,"_20936":56536,"_5":14366,"_27421":56259,"_2948":56537},[],"**Common Name (CN)**: main name of the identity.",{"_3464":2356,"_30135":2244,"_20936":56539,"_5":14366,"_27421":56259,"_2948":56540},[],"**Organization (O)**: organization or company.",{"_3464":2357,"_30135":2244,"_20936":56542,"_5":14366,"_27421":56259,"_2948":56543},[],"**Organizational Unit (OU)**: department or unit.",{"_3464":2358,"_30135":2244,"_20936":56545,"_5":14366,"_27421":56259,"_2948":56546},[],"**Country (C)**: two-letter country code.",{"_3464":2359,"_30135":2244,"_20936":56548,"_5":14366,"_27421":56259,"_2948":56549},[],"**State / Province (ST)**: state or province.",{"_3464":2360,"_30135":2244,"_20936":56551,"_5":14366,"_27421":56259,"_2948":56552},[],"**Locality (L)**: city or locality.",{"_3464":2361,"_30135":2244,"_20936":56554,"_5":14366,"_27421":56259,"_2948":56555},[],"**Email Address**: contact email.",{"_3464":2362,"_30135":2244,"_20936":56557,"_5":14366,"_27421":56259,"_2948":56558},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3464":2363,"_30135":2244,"_20936":56560,"_5":14366,"_27421":56259,"_2948":56561},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3464":2364,"_30135":2244,"_20936":56563,"_5":14366,"_27421":56263,"_2948":56564},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3464":2365,"_30135":2244,"_20936":56566,"_5":14366,"_27421":56263,"_2948":56567},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3464":2366,"_30135":2244,"_20936":56569,"_5":14366,"_27421":56267,"_2948":56570},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3464":2367,"_30135":2244,"_20936":56572,"_5":14366,"_27421":56267,"_2948":56573},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3464":2368,"_30135":2368,"_5":14718,"_2948":56575,"_30488":56576,"_20936":56577,"_27421":2368},"Online validation with OCSP",[49202,50670,54682,55321],[],{"_3464":2369,"_30135":2368,"_20936":56579,"_5":14366,"_27421":2368,"_2948":56580},[],"Query signed status and verify the responder’s response.",{"_3464":2370,"_30135":2368,"_5":30485,"_20936":56582,"_27421":56583,"_2948":56584},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3464":2371,"_30135":2368,"_5":30485,"_20936":56586,"_27421":56587,"_2948":56588},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3464":2372,"_30135":2368,"_5":30485,"_20936":56590,"_27421":56591,"_2948":56592},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3464":2373,"_30135":2368,"_5":30485,"_20936":56594,"_27421":56595,"_2948":56596},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3464":2374,"_30135":2368,"_5":30485,"_20936":56598,"_27421":56599,"_2948":56600},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3464":2375,"_30135":2368,"_5":30485,"_20936":56602,"_27421":56603,"_2948":55890},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#references",{"_3464":2376,"_30135":2368,"_20936":56605,"_5":14366,"_27421":2368,"_2948":56606},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3464":2377,"_30135":2368,"_20936":56608,"_5":14366,"_27421":56583,"_2948":56609},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3464":2378,"_30135":2368,"_20936":56611,"_5":14366,"_27421":56583,"_2948":56612},[],"Record status",{"_3464":2379,"_30135":2368,"_20936":56614,"_5":14366,"_27421":56583,"_2948":56615},[],"Signed response",{"_3464":2380,"_30135":2368,"_20936":56617,"_5":14366,"_27421":56583,"_2948":53812},[],{"_3464":2381,"_30135":2368,"_20936":56619,"_5":14366,"_27421":56583,"_2948":56620},[],"`Good`.",{"_3464":2382,"_30135":2368,"_20936":56622,"_5":14366,"_27421":56583,"_2948":53829},[],{"_3464":2383,"_30135":2368,"_20936":56624,"_5":14366,"_27421":56583,"_2948":56625},[],"`Revoked`, with revocation reason and timestamp.",{"_3464":2384,"_30135":2368,"_20936":56627,"_5":14366,"_27421":56583,"_2948":56628},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3464":2385,"_30135":2368,"_20936":56630,"_5":14366,"_27421":56583,"_2948":56631},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3464":2386,"_30135":2368,"_20936":56633,"_5":14366,"_27421":56583,"_2948":56634},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3464":2387,"_30135":2368,"_20936":56636,"_5":14366,"_27421":56583,"_2948":56637},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3464":2388,"_30135":2368,"_20936":56639,"_5":14366,"_27421":56583,"_2948":56640},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3464":2389,"_30135":2368,"_20936":56642,"_5":14366,"_27421":56587,"_2948":56643},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3464":2390,"_30135":2368,"_20936":56645,"_5":14366,"_27421":56587,"_2948":56646},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3464":2391,"_30135":2368,"_20936":56648,"_5":14366,"_27421":56591,"_2948":56649},[],"The service accepts:",{"_3464":2392,"_30135":2368,"_20936":56651,"_5":14366,"_27421":56591,"_2948":52440},[],{"_3464":2393,"_30135":2368,"_20936":56653,"_5":14366,"_27421":56591,"_2948":56654},[],"VA service path",{"_3464":2394,"_30135":2368,"_20936":56656,"_5":14366,"_27421":56591,"_2948":56657},[],"Format",{"_3464":2395,"_30135":2368,"_20936":56659,"_5":14366,"_27421":56591,"_2948":56660},[],"`POST`",{"_3464":2396,"_30135":2368,"_20936":56662,"_5":14366,"_27421":56591,"_2948":56663},[],"`/ocsp`",{"_3464":2397,"_30135":2368,"_20936":56665,"_5":14366,"_27421":56591,"_2948":56666},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3464":2398,"_30135":2368,"_20936":56668,"_5":14366,"_27421":56591,"_2948":56072},[],{"_3464":2399,"_30135":2368,"_20936":56670,"_5":14366,"_27421":56591,"_2948":56671},[],"`/ocsp/{ocsp_request}`",{"_3464":2400,"_30135":2368,"_20936":56673,"_5":14366,"_27421":56591,"_2948":56674},[],"DER request encoded using padded URL Base64.",{"_3464":2401,"_30135":2368,"_20936":56676,"_5":14366,"_27421":56591,"_2948":56677},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3464":2402,"_30135":2368,"_20936":56679,"_5":14366,"_27421":56595,"_2948":56680},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3464":2403,"_30135":2368,"_20936":56682,"_5":14366,"_27421":56595,"_2948":56683},[],"Generate the request:",{"_3464":2404,"_30135":2368,"_20936":56685,"_5":14366,"_27421":56595,"_2948":56686},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3464":2405,"_30135":2368,"_20936":56688,"_5":14366,"_27421":56595,"_2948":56689},[],"Replace the example URL with the inspected endpoint:",{"_3464":2406,"_30135":2368,"_20936":56691,"_5":14366,"_27421":56595,"_2948":56692},[],"Verify the returned DER:",{"_3464":2407,"_30135":2368,"_20936":56694,"_5":14366,"_27421":56595,"_2948":56695},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3464":2408,"_30135":2368,"_20936":56697,"_5":14366,"_27421":56599,"_2948":56698},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3464":2409,"_30135":2368,"_20936":56700,"_5":14366,"_27421":56599,"_2948":56701},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3464":2410,"_30135":2368,"_20936":56703,"_5":14366,"_27421":56603,"_2948":56704},[],"RFC 6960: OCSP.",{"_3464":2411,"_30135":2368,"_20936":56706,"_5":14366,"_27421":56603,"_2948":56707},[],"OpenSSL: openssl-ocsp.",{"_3464":2412,"_30135":2368,"_20936":56709,"_5":14366,"_27421":56603,"_2948":56710},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3464":2413,"_30135":2368,"_20936":56712,"_5":14366,"_27421":56603,"_2948":56181},[],{"_3464":2414,"_30135":2414,"_5":14718,"_2948":54682,"_30488":56714,"_20936":56715,"_27421":2414},[49202,50670,54682],[],{"_3464":2415,"_30135":2414,"_20936":56717,"_5":14366,"_27421":2414,"_2948":56718},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3464":2416,"_30135":2414,"_5":30485,"_20936":56720,"_27421":56721,"_2948":53987},[],"/docs/pr-preview/pr-61/platform/pki/overview#start-here",{"_3464":2417,"_30135":2414,"_5":30485,"_20936":56723,"_27421":56724,"_2948":56725},[],"/docs/pr-preview/pr-61/platform/pki/overview#what-you-need","What you need",{"_3464":2418,"_30135":2414,"_5":30485,"_20936":56727,"_27421":56728,"_2948":54523},[],"/docs/pr-preview/pr-61/platform/pki/overview#core-capabilities",{"_3464":2419,"_30135":2414,"_5":30485,"_20936":56730,"_27421":56731,"_2948":54527},[],"/docs/pr-preview/pr-61/platform/pki/overview#build-your-trust-hierarchy",{"_3464":2420,"_30135":2414,"_5":30485,"_20936":56733,"_27421":56734,"_2948":54531},[],"/docs/pr-preview/pr-61/platform/pki/overview#protect-cryptographic-keys",{"_3464":2421,"_30135":2414,"_5":30485,"_20936":56736,"_27421":56737,"_2948":54535},[],"/docs/pr-preview/pr-61/platform/pki/overview#issue-and-control-certificates",{"_3464":2422,"_30135":2414,"_5":30485,"_20936":56739,"_27421":56740,"_2948":54543},[],"/docs/pr-preview/pr-61/platform/pki/overview#publish-validation-status",{"_3464":2423,"_30135":2414,"_5":30485,"_20936":56742,"_27421":56743,"_2948":56744},[],"/docs/pr-preview/pr-61/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3464":2424,"_30135":2414,"_5":30485,"_20936":56746,"_27421":56747,"_2948":55488},[],"/docs/pr-preview/pr-61/platform/pki/overview#continue",{"_3464":2425,"_30135":2414,"_20936":56749,"_5":14366,"_27421":2414,"_2948":56750},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3464":2426,"_30135":2414,"_20936":56752,"_5":14366,"_27421":56721,"_2948":56753},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3464":2427,"_30135":2414,"_20936":56755,"_5":14366,"_27421":56721,"_2948":56756},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3464":2428,"_30135":2414,"_20936":56758,"_5":14366,"_27421":56724,"_2948":56759},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3464":2429,"_30135":2414,"_20936":56761,"_5":14366,"_27421":56724,"_2948":56762},[],"An available cryptographic engine to keep the authority's key.",{"_3464":2430,"_30135":2414,"_20936":56764,"_5":14366,"_27421":56724,"_2948":56765},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3464":2431,"_30135":2414,"_20936":56767,"_5":14366,"_27421":56724,"_2948":56768},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3464":2432,"_30135":2414,"_20936":56770,"_5":14366,"_27421":56724,"_2948":56771},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3464":2433,"_30135":2414,"_20936":56773,"_5":14366,"_27421":56731,"_2948":56774},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3464":2434,"_30135":2414,"_20936":56776,"_5":14366,"_27421":56734,"_2948":56777},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3464":2435,"_30135":2414,"_20936":56779,"_5":14366,"_27421":56737,"_2948":56780},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3464":2436,"_30135":2414,"_20936":56782,"_5":14366,"_27421":56740,"_2948":56783},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3464":2437,"_30135":2414,"_20936":56785,"_5":14366,"_27421":56743,"_2948":56786},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3464":2438,"_30135":2414,"_20936":56788,"_5":14366,"_27421":56743,"_2948":56789},[],"its subject and extensions identify the expected client;",{"_3464":2439,"_30135":2414,"_20936":56791,"_5":14366,"_27421":56743,"_2948":56792},[],"its public key matches the client's private key;",{"_3464":2440,"_30135":2414,"_20936":56794,"_5":14366,"_27421":56743,"_2948":56795},[],"its chain reaches a root trusted by the consumer;",{"_3464":2441,"_30135":2414,"_20936":56797,"_5":14366,"_27421":56743,"_2948":56798},[],"its dates and usages allow the operation;",{"_3464":2442,"_30135":2414,"_20936":56800,"_5":14366,"_27421":56743,"_2948":56801},[],"the consumer applies revocation checks and authorization.",{"_3464":2443,"_30135":2414,"_20936":56803,"_5":14366,"_27421":56743,"_2948":56804},[],"The issuance path includes the first independent checks.",{"_3464":2444,"_30135":2414,"_20936":56806,"_5":14366,"_27421":56747,"_2948":56807},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3464":2445,"_30135":2414,"_20936":56809,"_5":14366,"_27421":56747,"_2948":56810},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3464":2446,"_30135":2414,"_20936":56812,"_5":14366,"_27421":56747,"_2948":56813},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3464":2447,"_30135":2447,"_5":14718,"_2948":56815,"_30488":56816,"_20936":56817,"_27421":2447},"Create your first CA",[49202,50670,54682,54112],[],{"_3464":2448,"_30135":2447,"_20936":56819,"_5":14366,"_27421":2447,"_2948":56820},[],"Create an evaluation root and check its certificate before issuing.",{"_3464":2449,"_30135":2447,"_5":30485,"_20936":56822,"_27421":56823,"_2948":49212},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3464":2450,"_30135":2447,"_5":30485,"_20936":56825,"_27421":56826,"_2948":56827},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3464":2451,"_30135":2447,"_5":30485,"_20936":56829,"_27421":56830,"_2948":56831},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3464":2452,"_30135":2447,"_5":30485,"_20936":56833,"_27421":56834,"_2948":56835},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3464":2453,"_30135":2447,"_5":30485,"_20936":56837,"_27421":56838,"_2948":56839},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3464":2454,"_30135":2447,"_5":30485,"_20936":56841,"_27421":56842,"_2948":56843},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3464":2455,"_30135":2447,"_5":30485,"_20936":56845,"_27421":56846,"_2948":56847},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3464":2456,"_30135":2447,"_5":30485,"_20936":56849,"_27421":56850,"_2948":54369},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3464":2457,"_30135":2447,"_5":30485,"_20936":56852,"_27421":56853,"_2948":49236},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3464":2458,"_30135":2447,"_20936":56855,"_5":14366,"_27421":2447,"_2948":56856},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3464":2459,"_30135":2447,"_20936":56858,"_5":14366,"_27421":56823,"_2948":56859},[],"Console access and permission to create keys and authorities.",{"_3464":2460,"_30135":2447,"_20936":56861,"_5":14366,"_27421":56823,"_2948":56862},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3464":2461,"_30135":2447,"_20936":56864,"_5":14366,"_27421":56823,"_2948":56865},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3464":2462,"_30135":2447,"_20936":56867,"_5":14366,"_27421":56823,"_2948":56868},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3464":2463,"_30135":2447,"_20936":56870,"_5":14366,"_27421":56826,"_2948":56871},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3464":2464,"_30135":2447,"_20936":56873,"_5":14366,"_27421":56826,"_2948":56874},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3464":2465,"_30135":2447,"_20936":56876,"_5":14366,"_27421":56830,"_2948":56877},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3464":2466,"_30135":2447,"_20936":56879,"_5":14366,"_27421":56830,"_2948":56880},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3464":2467,"_30135":2447,"_20936":56882,"_5":14366,"_27421":56834,"_2948":56883},[],"Select **Root CA** and complete:",{"_3464":2468,"_30135":2447,"_20936":56885,"_5":14366,"_27421":56834,"_2948":56886},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3464":2469,"_30135":2447,"_20936":56888,"_5":14366,"_27421":56834,"_2948":56889},[],"**Subject**: organization and country details for your evaluation.",{"_3464":2470,"_30135":2447,"_20936":56891,"_5":14366,"_27421":56834,"_2948":56892},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3464":2471,"_30135":2447,"_20936":56894,"_5":14366,"_27421":56834,"_2948":56895},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3464":2472,"_30135":2447,"_20936":56897,"_5":14366,"_27421":56834,"_2948":56898},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3464":2473,"_30135":2447,"_20936":56900,"_5":14366,"_27421":56838,"_2948":56901},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3464":2474,"_30135":2447,"_20936":56903,"_5":14366,"_27421":56842,"_2948":56904},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3464":2475,"_30135":2447,"_20936":56906,"_5":14366,"_27421":56842,"_2948":56907},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3464":2476,"_30135":2447,"_20936":56909,"_5":14366,"_27421":56846,"_2948":56910},[],"Run from the directory where you saved `ca.pem`:",{"_3464":2477,"_30135":2447,"_20936":56912,"_5":14366,"_27421":56846,"_2948":56913},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3464":2478,"_30135":2447,"_20936":56915,"_5":14366,"_27421":56846,"_2948":56916},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3464":2479,"_30135":2447,"_20936":56918,"_5":14366,"_27421":56850,"_2948":56919},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3464":2480,"_30135":2447,"_20936":56921,"_5":14366,"_27421":56850,"_2948":56922},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3464":2481,"_30135":2447,"_20936":56924,"_5":14366,"_27421":56850,"_2948":56925},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3464":2482,"_30135":2447,"_20936":56927,"_5":14366,"_27421":56850,"_2948":56928},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3464":2483,"_30135":2447,"_20936":56930,"_5":14366,"_27421":56853,"_2948":56931},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3464":2484,"_30135":2484,"_5":14718,"_2948":56933,"_30488":56934,"_20936":56935,"_27421":2484},"Issue and verify a certificate",[49202,50670,54682,54112],[],{"_3464":2485,"_30135":2484,"_20936":56937,"_5":14366,"_27421":2484,"_2948":56938},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3464":2486,"_30135":2484,"_5":30485,"_20936":56940,"_27421":56941,"_2948":49212},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3464":2487,"_30135":2484,"_5":30485,"_20936":56943,"_27421":56944,"_2948":56945},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3464":2488,"_30135":2484,"_5":30485,"_20936":56947,"_27421":56948,"_2948":56949},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3464":2489,"_30135":2484,"_5":30485,"_20936":56951,"_27421":56952,"_2948":56953},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3464":2490,"_30135":2484,"_5":30485,"_20936":56955,"_27421":56956,"_2948":56957},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3464":2491,"_30135":2484,"_5":30485,"_20936":56959,"_27421":56960,"_2948":56961},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3464":2492,"_30135":2484,"_5":30485,"_20936":56963,"_27421":56964,"_2948":56965},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3464":2493,"_30135":2484,"_5":30485,"_20936":56967,"_27421":56968,"_2948":56969},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3464":2494,"_30135":2484,"_5":30485,"_20936":56971,"_27421":56972,"_2948":56973},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3464":2495,"_30135":2484,"_5":30485,"_20936":56975,"_27421":56976,"_2948":56977},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3464":2496,"_30135":2484,"_5":30485,"_20936":56979,"_27421":56980,"_2948":54369},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3464":2497,"_30135":2484,"_5":30485,"_20936":56982,"_27421":56983,"_2948":49236},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#next-step",{"_3464":2498,"_30135":2484,"_20936":56985,"_5":14366,"_27421":2484,"_2948":56986},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3464":2499,"_30135":2484,"_20936":56988,"_5":14366,"_27421":56941,"_2948":56989},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3464":2500,"_30135":2484,"_20936":56991,"_5":14366,"_27421":56941,"_2948":56992},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3464":2501,"_30135":2484,"_20936":56994,"_5":14366,"_27421":56941,"_2948":56995},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3464":2502,"_30135":2484,"_20936":56997,"_5":14366,"_27421":56941,"_2948":56998},[],"A client identifier: here we use `device-001`.",{"_3464":2503,"_30135":2484,"_20936":57000,"_5":14366,"_27421":56941,"_2948":57001},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3464":2504,"_30135":2484,"_20936":57003,"_5":14366,"_27421":56944,"_2948":57004},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3464":2505,"_30135":2484,"_20936":57006,"_5":14366,"_27421":56948,"_2948":57007},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3464":2506,"_30135":2484,"_20936":57009,"_5":14366,"_27421":56948,"_2948":57010},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3464":2507,"_30135":2484,"_20936":57012,"_5":14366,"_27421":56952,"_2948":57013},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3464":2508,"_30135":2484,"_20936":57015,"_5":14366,"_27421":56952,"_2948":57016},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3464":2509,"_30135":2484,"_20936":57018,"_5":14366,"_27421":56956,"_2948":57019},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3464":2510,"_30135":2484,"_20936":57021,"_5":14366,"_27421":56956,"_2948":57022},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3464":2511,"_30135":2484,"_20936":57024,"_5":14366,"_27421":56960,"_2948":57025},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3464":2512,"_30135":2484,"_20936":57027,"_5":14366,"_27421":56964,"_2948":57028},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3464":2513,"_30135":2484,"_20936":57030,"_5":14366,"_27421":56968,"_2948":57031},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3464":2514,"_30135":2484,"_20936":57033,"_5":14366,"_27421":56972,"_2948":57034},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3464":2515,"_30135":2484,"_20936":57036,"_5":14366,"_27421":56972,"_2948":57037},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3464":2516,"_30135":2484,"_20936":57039,"_5":14366,"_27421":56972,"_2948":57040},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3464":2517,"_30135":2484,"_20936":57042,"_5":14366,"_27421":56976,"_2948":57043},[],"In Bash, compare the two public-key digests:",{"_3464":2518,"_30135":2484,"_20936":57045,"_5":14366,"_27421":56976,"_2948":57046},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3464":2519,"_30135":2484,"_20936":57048,"_5":14366,"_27421":56976,"_2948":57049},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3464":2520,"_30135":2484,"_20936":57051,"_5":14366,"_27421":56980,"_2948":54453},[],{"_3464":2521,"_30135":2484,"_20936":57053,"_5":14366,"_27421":56980,"_2948":57054},[],"What to review",{"_3464":2522,"_30135":2484,"_20936":57056,"_5":14366,"_27421":56980,"_2948":57057},[],"The CA rejects issuance",{"_3464":2523,"_30135":2484,"_20936":57059,"_5":14366,"_27421":56980,"_2948":57060},[],"Permissions, CA state and key, algorithm and profile.",{"_3464":2524,"_30135":2484,"_20936":57062,"_5":14366,"_27421":56980,"_2948":57063},[],"Different subject or usages",{"_3464":2525,"_30135":2484,"_20936":57065,"_5":14366,"_27421":56980,"_2948":57066},[],"Applied profile and requested values.",{"_3464":2526,"_30135":2484,"_20936":57068,"_5":14366,"_27421":56980,"_2948":57069},[],"Issuer cannot be found",{"_3464":2527,"_30135":2484,"_20936":57071,"_5":14366,"_27421":56980,"_2948":57072},[],"Downloaded CA and required intermediate chain.",{"_3464":2528,"_30135":2484,"_20936":57074,"_5":14366,"_27421":56980,"_2948":57075},[],"Validity fails",{"_3464":2529,"_30135":2484,"_20936":57077,"_5":14366,"_27421":56980,"_2948":57078},[],"Certificate and CA dates, and the computer's clock.",{"_3464":2530,"_30135":2484,"_20936":57080,"_5":14366,"_27421":56980,"_2948":57081},[],"Public-key digests differ",{"_3464":2531,"_30135":2484,"_20936":57083,"_5":14366,"_27421":56980,"_2948":57084},[],"Certificate and key files from the same issuance.",{"_3464":2532,"_30135":2484,"_20936":57086,"_5":14366,"_27421":56980,"_2948":57087},[],"See PKI diagnostics to narrow an issuance failure.",{"_3464":2533,"_30135":2484,"_20936":57089,"_5":14366,"_27421":56983,"_2948":57090},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3464":2534,"_30135":2484,"_20936":57092,"_5":14366,"_27421":56983,"_2948":57093},[],"Manage certificates for inspection, status and revocation.",{"_3464":2535,"_30135":2484,"_20936":57095,"_5":14366,"_27421":56983,"_2948":57096},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3464":2536,"_30135":2484,"_20936":57098,"_5":14366,"_27421":56983,"_2948":57099},[],"Prepare EST for the device to request its next identities.",{"_3464":2537,"_30135":2484,"_20936":57101,"_5":14366,"_27421":56983,"_2948":57102},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3464":2538,"_30135":2538,"_5":14718,"_2948":57104,"_30488":57105,"_20936":57106,"_27421":2538},"PKI getting started",[49202,50670,54682,54112],[],{"_3464":2539,"_30135":2538,"_20936":57108,"_5":14366,"_27421":2538,"_2948":57109},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3464":2540,"_30135":2538,"_5":30485,"_20936":57111,"_27421":57112,"_2948":49212},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#before-you-begin",{"_3464":2541,"_30135":2538,"_5":30485,"_20936":57114,"_27421":57115,"_2948":57116},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3464":2542,"_30135":2538,"_5":30485,"_20936":57118,"_27421":57119,"_2948":54304},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#expected-result",{"_3464":2543,"_30135":2538,"_5":30485,"_20936":57121,"_27421":57122,"_2948":57123},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3464":2544,"_30135":2538,"_20936":57125,"_5":14366,"_27421":2538,"_2948":57126},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3464":2545,"_30135":2538,"_20936":57128,"_5":14366,"_27421":57112,"_2948":57129},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3464":2546,"_30135":2538,"_20936":57131,"_5":14366,"_27421":57112,"_2948":57132},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3464":2547,"_30135":2538,"_20936":57134,"_5":14366,"_27421":57112,"_2948":57135},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3464":2548,"_30135":2538,"_20936":57137,"_5":14366,"_27421":57112,"_2948":57138},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3464":2549,"_30135":2538,"_20936":57140,"_5":14366,"_27421":57112,"_2948":57141},[],"A working directory with restricted access for the downloaded key.",{"_3464":2550,"_30135":2538,"_20936":57143,"_5":14366,"_27421":57115,"_2948":57144},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3464":2551,"_30135":2538,"_20936":57146,"_5":14366,"_27421":57115,"_2948":57147},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3464":2552,"_30135":2538,"_20936":57149,"_5":14366,"_27421":57115,"_2948":57150},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3464":2553,"_30135":2538,"_20936":57152,"_5":14366,"_27421":57115,"_2948":57153},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3464":2554,"_30135":2538,"_20936":57155,"_5":14366,"_27421":57119,"_2948":57156},[],"File or resource",{"_3464":2555,"_30135":2538,"_20936":57158,"_5":14366,"_27421":57119,"_2948":54301},[],{"_3464":2556,"_30135":2538,"_20936":57160,"_5":14366,"_27421":57119,"_2948":57161},[],"Active root CA and `ca.pem`",{"_3464":2557,"_30135":2538,"_20936":57163,"_5":14366,"_27421":57119,"_2948":57164},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3464":2558,"_30135":2538,"_20936":57166,"_5":14366,"_27421":57119,"_2948":57167},[],"End-entity certificate and `device.crt`",{"_3464":2559,"_30135":2538,"_20936":57169,"_5":14366,"_27421":57119,"_2948":57170},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3464":2560,"_30135":2538,"_20936":57172,"_5":14366,"_27421":57119,"_2948":57173},[],"Private key `device.key`",{"_3464":2561,"_30135":2538,"_20936":57175,"_5":14366,"_27421":57119,"_2948":57176},[],"Its public key matches the one included in `device.crt`.",{"_3464":2562,"_30135":2538,"_20936":57178,"_5":14366,"_27421":57119,"_2948":57179},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3464":2563,"_30135":2538,"_20936":57181,"_5":14366,"_27421":57122,"_2948":57182},[],"To operate certificates, continue with Certificates and Validation.",{"_3464":2564,"_30135":2538,"_20936":57184,"_5":14366,"_27421":57122,"_2948":57185},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3464":2565,"_30135":2538,"_20936":57187,"_5":14366,"_27421":57122,"_2948":57188},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3464":2566,"_30135":2566,"_5":14718,"_2948":57190,"_30488":57191,"_20936":57192,"_27421":2566},"PKI troubleshooting",[49202,50670,54682,53250],[],{"_3464":2567,"_30135":2566,"_20936":57194,"_5":14366,"_27421":2566,"_2948":57195},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3464":2568,"_30135":2566,"_5":30485,"_20936":57197,"_27421":57198,"_2948":57199},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3464":2569,"_30135":2566,"_5":30485,"_20936":57201,"_27421":57202,"_2948":57203},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3464":2570,"_30135":2566,"_5":30485,"_20936":57205,"_27421":57206,"_2948":57207},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3464":2571,"_30135":2566,"_20936":57209,"_5":14366,"_27421":2566,"_2948":57210},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3464":2572,"_30135":2566,"_20936":57212,"_5":14366,"_27421":2566,"_2948":57213},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3464":2573,"_30135":2566,"_20936":57215,"_5":14366,"_27421":57198,"_2948":54301},[],{"_3464":2574,"_30135":2566,"_20936":57217,"_5":14366,"_27421":57198,"_2948":57218},[],"What to inspect",{"_3464":2575,"_30135":2566,"_20936":57220,"_5":14366,"_27421":57198,"_2948":49236},[],{"_3464":2576,"_30135":2566,"_20936":57222,"_5":14366,"_27421":57198,"_2948":53517},[],{"_3464":2577,"_30135":2566,"_20936":57224,"_5":14366,"_27421":57198,"_2948":57225},[],"Exists, is active and has usable dates.",{"_3464":2578,"_30135":2566,"_20936":57227,"_5":14366,"_27421":57198,"_2948":57228},[],"Authorities.",{"_3464":2579,"_30135":2566,"_20936":57230,"_5":14366,"_27421":57198,"_2948":57231},[],"Key",{"_3464":2580,"_30135":2566,"_20936":57233,"_5":14366,"_27421":57198,"_2948":57234},[],"The record has a usable private key and the engine can sign.",{"_3464":2581,"_30135":2566,"_20936":57236,"_5":14366,"_27421":57198,"_2948":57237},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3464":2582,"_30135":2566,"_20936":57239,"_5":14366,"_27421":57198,"_2948":57240},[],"CSR",{"_3464":2583,"_30135":2566,"_20936":57242,"_5":14366,"_27421":57198,"_2948":57243},[],"Correct PEM and verifiable signature.",{"_3464":2584,"_30135":2566,"_20936":57245,"_5":14366,"_27421":57198,"_2948":57246},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3464":2585,"_30135":2566,"_20936":57248,"_5":14366,"_27421":57198,"_2948":57249},[],"Profile",{"_3464":2586,"_30135":2566,"_20936":57251,"_5":14366,"_27421":57198,"_2948":57252},[],"Selected source, existing ID, allowed algorithm and size.",{"_3464":2587,"_30135":2566,"_20936":57254,"_5":14366,"_27421":57198,"_2948":57255},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3464":2588,"_30135":2566,"_20936":57257,"_5":14366,"_27421":57198,"_2948":54453},[],{"_3464":2589,"_30135":2566,"_20936":57259,"_5":14366,"_27421":57198,"_2948":57260},[],"Appropriate subject, SAN, usages and dates.",{"_3464":2590,"_30135":2566,"_20936":57262,"_5":14366,"_27421":57198,"_2948":57263},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3464":2591,"_30135":2566,"_20936":57265,"_5":14366,"_27421":57198,"_2948":57266},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3464":2592,"_30135":2566,"_20936":57268,"_5":14366,"_27421":57198,"_2948":57269},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3464":2593,"_30135":2566,"_20936":57271,"_5":14366,"_27421":57202,"_2948":57272},[],"Check each boundary independently:",{"_3464":2594,"_30135":2566,"_20936":57274,"_5":14366,"_27421":57202,"_2948":57275},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3464":2595,"_30135":2566,"_20936":57277,"_5":14366,"_27421":57202,"_2948":57278},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3464":2596,"_30135":2566,"_20936":57280,"_5":14366,"_27421":57202,"_2948":57281},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3464":2597,"_30135":2566,"_20936":57283,"_5":14366,"_27421":57202,"_2948":57284},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3464":2598,"_30135":2566,"_20936":57286,"_5":14366,"_27421":57202,"_2948":57287},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3464":2599,"_30135":2566,"_20936":57289,"_5":14366,"_27421":57202,"_2948":57290},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3464":2600,"_30135":2566,"_20936":57292,"_5":14366,"_27421":57206,"_2948":57293},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3464":2601,"_30135":2566,"_20936":57295,"_5":14366,"_27421":57206,"_2948":57296},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3464":2602,"_30135":2602,"_5":14718,"_2948":57298,"_30488":57299,"_20936":57300,"_27421":2602},"Security",[49202],[],{"_3464":2603,"_30135":2602,"_20936":57302,"_5":14366,"_27421":2602,"_2948":57303},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3464":2604,"_30135":2602,"_5":30485,"_20936":57305,"_27421":57306,"_2948":57307},[],"/docs/pr-preview/pr-61/security#report-a-vulnerability","Report a vulnerability",{"_3464":2605,"_30135":2602,"_5":30485,"_20936":57309,"_27421":57310,"_2948":57311},[],"/docs/pr-preview/pr-61/security#what-to-include-in-a-report","What to include in a report",{"_3464":2606,"_30135":2602,"_5":30485,"_20936":57313,"_27421":57314,"_2948":57315},[],"/docs/pr-preview/pr-61/security#supported-versions","Supported versions",{"_3464":2607,"_30135":2602,"_5":30485,"_20936":57317,"_27421":57318,"_2948":57319},[],"/docs/pr-preview/pr-61/security#responsible-disclosure","Responsible disclosure",{"_3464":2608,"_30135":2602,"_20936":57321,"_5":14366,"_27421":2602,"_2948":57322},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3464":2609,"_30135":2602,"_20936":57324,"_5":14366,"_27421":57306,"_2948":57325},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3464":2610,"_30135":2602,"_20936":57327,"_5":14366,"_27421":57306,"_2948":57328},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3464":2611,"_30135":2602,"_20936":57330,"_5":14366,"_27421":57306,"_2948":14991},[],{"_3464":2612,"_30135":2602,"_20936":57332,"_5":14366,"_27421":57306,"_2948":14931},[],{"_3464":2613,"_30135":2602,"_20936":57334,"_5":14366,"_27421":57306,"_2948":14978},[],{"_3464":2614,"_30135":2602,"_20936":57336,"_5":14366,"_27421":57306,"_2948":57337},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3464":2615,"_30135":2602,"_20936":57339,"_5":14366,"_27421":57306,"_2948":57340},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3464":2616,"_30135":2602,"_20936":57342,"_5":14366,"_27421":57310,"_2948":57343},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3464":2617,"_30135":2602,"_20936":57345,"_5":14366,"_27421":57310,"_2948":57346},[],"Do not include in the report:",{"_3464":2618,"_30135":2602,"_20936":57348,"_5":14366,"_27421":57310,"_2948":57349},[],"Credentials, tokens, or private keys",{"_3464":2619,"_30135":2602,"_20936":57351,"_5":14366,"_27421":57310,"_2948":57352},[],"Customer data or customer-identifiable information",{"_3464":2620,"_30135":2602,"_20936":57354,"_5":14366,"_27421":57310,"_2948":57355},[],"Confidential architecture or internal infrastructure details",{"_3464":2621,"_30135":2602,"_20936":57357,"_5":14366,"_27421":57314,"_2948":57358},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3464":2622,"_30135":2602,"_20936":57360,"_5":14366,"_27421":57314,"_2948":57361},[],"For upgrade guidance, see Upgrades.",{"_3464":2623,"_30135":2602,"_20936":57363,"_5":14366,"_27421":57318,"_2948":57364},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3464":2624,"_30135":2602,"_20936":57366,"_5":14366,"_27421":57318,"_2948":57367},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3464":2625,"_30135":2602,"_20936":57369,"_5":14366,"_27421":57318,"_2948":57370},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3464":2626,"_30135":2602,"_20936":57372,"_5":14366,"_27421":57318,"_2948":57373},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3464":2627,"_30135":2602,"_20936":57375,"_5":14366,"_27421":57318,"_2948":57376},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3464":2628,"_30135":2628,"_5":14718,"_2948":57378,"_30488":57379,"_20936":57381,"_27421":2628},"3.8.0 to 4.0.0",[49202,57380],"Upgrades",[],{"_3464":2629,"_30135":2628,"_20936":57383,"_5":14366,"_27421":2628,"_2948":57384},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3464":2630,"_30135":2628,"_5":30485,"_20936":57386,"_27421":57387,"_2948":57388},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3464":2631,"_30135":2628,"_5":30485,"_20936":57390,"_27421":57391,"_2948":57392},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3464":2632,"_30135":2628,"_5":30485,"_20936":57394,"_27421":57395,"_2948":57396},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3464":2633,"_30135":2628,"_5":30485,"_20936":57398,"_27421":57399,"_2948":57400},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3464":2634,"_30135":2628,"_5":30485,"_20936":57402,"_27421":57403,"_2948":57404},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3464":2635,"_30135":2628,"_5":30485,"_20936":57406,"_27421":57407,"_2948":57408},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3464":2636,"_30135":2628,"_5":30485,"_20936":57410,"_27421":57411,"_2948":57412},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3464":2637,"_30135":2628,"_5":30485,"_20936":57414,"_27421":57415,"_2948":57416},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3464":2638,"_30135":2628,"_5":30485,"_20936":57418,"_27421":57419,"_2948":57420},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3464":2639,"_30135":2628,"_5":30485,"_20936":57422,"_27421":57423,"_2948":57424},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3464":2640,"_30135":2628,"_5":30485,"_20936":57426,"_27421":57427,"_2948":57428},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3464":2641,"_30135":2628,"_5":30485,"_20936":57430,"_27421":57431,"_2948":57432},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3464":2642,"_30135":2628,"_5":30485,"_20936":57434,"_27421":57435,"_2948":57436},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3464":2643,"_30135":2628,"_5":30485,"_20936":57438,"_27421":57439,"_2948":57440},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3464":2644,"_30135":2628,"_5":30485,"_20936":57442,"_27421":57443,"_2948":57444},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3464":2645,"_30135":2628,"_5":30485,"_20936":57446,"_27421":57447,"_2948":57448},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3464":2646,"_30135":2628,"_5":30485,"_20936":57450,"_27421":57451,"_2948":57452},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3464":2647,"_30135":2628,"_5":30485,"_20936":57454,"_27421":57455,"_2948":57456},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3464":2648,"_30135":2628,"_5":30485,"_20936":57458,"_27421":57459,"_2948":57460},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3464":2649,"_30135":2628,"_5":30485,"_20936":57462,"_27421":57463,"_2948":57464},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3464":2650,"_30135":2628,"_5":30485,"_20936":57466,"_27421":57467,"_2948":57468},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3464":2651,"_30135":2628,"_5":30485,"_20936":57470,"_27421":57471,"_2948":57472},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3464":2652,"_30135":2628,"_5":30485,"_20936":57474,"_27421":57475,"_2948":57476},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3464":2653,"_30135":2628,"_5":30485,"_20936":57478,"_27421":57479,"_2948":57480},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3464":2654,"_30135":2628,"_5":30485,"_20936":57482,"_27421":57483,"_2948":57484},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3464":2655,"_30135":2628,"_5":30485,"_20936":57486,"_27421":57487,"_2948":57488},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3464":2656,"_30135":2628,"_5":30485,"_20936":57490,"_27421":57491,"_2948":57492},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3464":2657,"_30135":2628,"_5":30485,"_20936":57494,"_27421":57495,"_2948":57496},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3464":2658,"_30135":2628,"_5":30485,"_20936":57498,"_27421":57499,"_2948":57500},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3464":2659,"_30135":2628,"_5":30485,"_20936":57502,"_27421":57503,"_2948":57504},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3464":2660,"_30135":2628,"_5":30485,"_20936":57506,"_27421":57507,"_2948":57508},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3464":2661,"_30135":2628,"_5":30485,"_20936":57510,"_27421":57511,"_2948":57512},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3464":2662,"_30135":2628,"_5":30485,"_20936":57514,"_27421":57515,"_2948":57516},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3464":2663,"_30135":2628,"_5":30485,"_20936":57518,"_27421":57519,"_2948":57520},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3464":2664,"_30135":2628,"_5":30485,"_20936":57522,"_27421":57523,"_2948":57524},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3464":2665,"_30135":2628,"_5":30485,"_20936":57526,"_27421":57527,"_2948":57528},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3464":2666,"_30135":2628,"_5":30485,"_20936":57530,"_27421":57531,"_2948":57532},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3464":2667,"_30135":2628,"_5":30485,"_20936":57534,"_27421":57535,"_2948":57536},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3464":2668,"_30135":2628,"_5":30485,"_20936":57538,"_27421":57539,"_2948":57540},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3464":2669,"_30135":2628,"_5":30485,"_20936":57542,"_27421":57543,"_2948":57544},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3464":2670,"_30135":2628,"_5":30485,"_20936":57546,"_27421":57547,"_2948":53250},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3464":2671,"_30135":2628,"_5":30485,"_20936":57549,"_27421":57550,"_2948":57551},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3464":2672,"_30135":2628,"_5":30485,"_20936":57553,"_27421":57554,"_2948":57555},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3464":2673,"_30135":2628,"_20936":57557,"_5":14366,"_27421":2628,"_2948":57558},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3464":2674,"_30135":2628,"_20936":57560,"_5":14366,"_27421":2628,"_2948":57561},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3464":2675,"_30135":2628,"_20936":57563,"_5":14366,"_27421":2628,"_2948":57564},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3464":2676,"_30135":2628,"_20936":57566,"_5":14366,"_27421":2628,"_2948":57567},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3464":2677,"_30135":2628,"_20936":57569,"_5":14366,"_27421":2628,"_2948":57570},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3464":2678,"_30135":2628,"_20936":57572,"_5":14366,"_27421":2628,"_2948":57573},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3464":2679,"_30135":2628,"_20936":57575,"_5":14366,"_27421":2628,"_2948":57576},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3464":2680,"_30135":2628,"_20936":57578,"_5":14366,"_27421":57391,"_2948":57579},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3464":2681,"_30135":2628,"_20936":57581,"_5":14366,"_27421":57391,"_2948":57582},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3464":2682,"_30135":2628,"_20936":57584,"_5":14366,"_27421":57395,"_2948":57585},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3464":2683,"_30135":2628,"_20936":57587,"_5":14366,"_27421":57395,"_2948":57588},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3464":2684,"_30135":2628,"_20936":57590,"_5":14366,"_27421":57399,"_2948":57591},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3464":2685,"_30135":2628,"_20936":57593,"_5":14366,"_27421":57403,"_2948":57594},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3464":2686,"_30135":2628,"_20936":57596,"_5":14366,"_27421":57403,"_2948":57597},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3464":2687,"_30135":2628,"_20936":57599,"_5":14366,"_27421":57403,"_2948":57600},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3464":2688,"_30135":2628,"_20936":57602,"_5":14366,"_27421":57403,"_2948":57603},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3464":2689,"_30135":2628,"_20936":57605,"_5":14366,"_27421":57403,"_2948":57606},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3464":2690,"_30135":2628,"_20936":57608,"_5":14366,"_27421":57407,"_2948":57609},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3464":2691,"_30135":2628,"_20936":57611,"_5":14366,"_27421":57407,"_2948":57612},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3464":2692,"_30135":2628,"_20936":57614,"_5":14366,"_27421":57407,"_2948":57615},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3464":2693,"_30135":2628,"_20936":57617,"_5":14366,"_27421":57407,"_2948":57618},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3464":2694,"_30135":2628,"_20936":57620,"_5":14366,"_27421":57407,"_2948":57621},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3464":2695,"_30135":2628,"_20936":57623,"_5":14366,"_27421":57407,"_2948":57624},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3464":2696,"_30135":2628,"_20936":57626,"_5":14366,"_27421":57411,"_2948":57627},[],"Change",{"_3464":2697,"_30135":2628,"_20936":57629,"_5":14366,"_27421":57411,"_2948":57630},[],"Who is affected",{"_3464":2698,"_30135":2628,"_20936":57632,"_5":14366,"_27421":57411,"_2948":57633},[],"Severity",{"_3464":2699,"_30135":2628,"_20936":57635,"_5":14366,"_27421":57411,"_2948":56109},[],{"_3464":2700,"_30135":2628,"_20936":57637,"_5":14366,"_27421":57411,"_2948":57420},[],{"_3464":2701,"_30135":2628,"_20936":57639,"_5":14366,"_27421":57411,"_2948":57640},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3464":2702,"_30135":2628,"_20936":57642,"_5":14366,"_27421":57411,"_2948":57643},[],"High: KMS and VA start on empty volumes",{"_3464":2703,"_30135":2628,"_20936":57645,"_5":14366,"_27421":57411,"_2948":57646},[],"Copy the data into the new volumes",{"_3464":2704,"_30135":2628,"_20936":57648,"_5":14366,"_27421":57411,"_2948":57424},[],{"_3464":2705,"_30135":2628,"_20936":57650,"_5":14366,"_27421":57411,"_2948":57651},[],"Every Helm release",{"_3464":2706,"_30135":2628,"_20936":57653,"_5":14366,"_27421":57411,"_2948":57654},[],"High: `helm upgrade` fails",{"_3464":2707,"_30135":2628,"_20936":57656,"_5":14366,"_27421":57411,"_2948":57657},[],"Remove or rename legacy keys",{"_3464":2708,"_30135":2628,"_20936":57659,"_5":14366,"_27421":57411,"_2948":57428},[],{"_3464":2709,"_30135":2628,"_20936":57661,"_5":14366,"_27421":57411,"_2948":57662},[],"Every deployment",{"_3464":2710,"_30135":2628,"_20936":57664,"_5":14366,"_27421":57411,"_2948":57665},[],"High: without a bootstrap principal there is no administrator",{"_3464":2711,"_30135":2628,"_20936":57667,"_5":14366,"_27421":57411,"_2948":57668},[],"Configure `services.authz`",{"_3464":2712,"_30135":2628,"_20936":57670,"_5":14366,"_27421":57411,"_2948":57432},[],{"_3464":2713,"_30135":2628,"_20936":57672,"_5":14366,"_27421":57411,"_2948":57651},[],{"_3464":2714,"_30135":2628,"_20936":57674,"_5":14366,"_27421":57411,"_2948":57675},[],"High: `helm upgrade` fails on the old keys",{"_3464":2715,"_30135":2628,"_20936":57677,"_5":14366,"_27421":57411,"_2948":57678},[],"Move JWKS and roles into `services.authz`",{"_3464":2716,"_30135":2628,"_20936":57680,"_5":14366,"_27421":57411,"_2948":57452},[],{"_3464":2717,"_30135":2628,"_20936":57682,"_5":14366,"_27421":57411,"_2948":57683},[],"3.8.0 deployments with per-service databases",{"_3464":2718,"_30135":2628,"_20936":57685,"_5":14366,"_27421":57411,"_2948":57686},[],"High: services find no data, or a migration aborts",{"_3464":2719,"_30135":2628,"_20936":57688,"_5":14366,"_27421":57411,"_2948":57689},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3464":2720,"_30135":2628,"_20936":57691,"_5":14366,"_27421":57411,"_2948":57456},[],{"_3464":2721,"_30135":2628,"_20936":57693,"_5":14366,"_27421":57411,"_2948":57694},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3464":2722,"_30135":2628,"_20936":57696,"_5":14366,"_27421":57411,"_2948":57697},[],"High: the backend no longer starts with them",{"_3464":2723,"_30135":2628,"_20936":57699,"_5":14366,"_27421":57411,"_2948":57700},[],"Move to PostgreSQL before upgrading",{"_3464":2724,"_30135":2628,"_20936":57702,"_5":14366,"_27421":57411,"_2948":57500},[],{"_3464":2725,"_30135":2628,"_20936":57704,"_5":14366,"_27421":57411,"_2948":57705},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3464":2726,"_30135":2628,"_20936":57707,"_5":14366,"_27421":57411,"_2948":57708},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3464":2727,"_30135":2628,"_20936":57710,"_5":14366,"_27421":57411,"_2948":57711},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3464":2728,"_30135":2628,"_20936":57713,"_5":14366,"_27421":57411,"_2948":57714},[],"Webhooks with file references",{"_3464":2729,"_30135":2628,"_20936":57716,"_5":14366,"_27421":57411,"_2948":57717},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3464":2730,"_30135":2628,"_20936":57719,"_5":14366,"_27421":57411,"_2948":57720},[],"High: enrollments calling the webhook fail",{"_3464":2731,"_30135":2628,"_20936":57722,"_5":14366,"_27421":57411,"_2948":57723},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3464":2732,"_30135":2628,"_20936":57725,"_5":14366,"_27421":57411,"_2948":57436},[],{"_3464":2733,"_30135":2628,"_20936":57727,"_5":14366,"_27421":57411,"_2948":57728},[],"Releases with per-service identity overrides or mounted key material",{"_3464":2734,"_30135":2628,"_20936":57730,"_5":14366,"_27421":57411,"_2948":57731},[],"Medium: services cannot read their files",{"_3464":2735,"_30135":2628,"_20936":57733,"_5":14366,"_27421":57411,"_2948":57734},[],"Remove the overrides and fix volume ownership",{"_3464":2736,"_30135":2628,"_20936":57736,"_5":14366,"_27421":57411,"_2948":57440},[],{"_3464":2737,"_30135":2628,"_20936":57738,"_5":14366,"_27421":57411,"_2948":57739},[],"Releases that set `amqp.tls`",{"_3464":2738,"_30135":2628,"_20936":57741,"_5":14366,"_27421":57411,"_2948":57742},[],"Medium: clients connect to the wrong port",{"_3464":2739,"_30135":2628,"_20936":57744,"_5":14366,"_27421":57411,"_2948":57745},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3464":2740,"_30135":2628,"_20936":57747,"_5":14366,"_27421":57411,"_2948":57460},[],{"_3464":2741,"_30135":2628,"_20936":57749,"_5":14366,"_27421":57411,"_2948":57750},[],"Installations whose CA keys predate the KMS",{"_3464":2742,"_30135":2628,"_20936":57752,"_5":14366,"_27421":57411,"_2948":57753},[],"Medium: CA keys stay unmanaged",{"_3464":2743,"_30135":2628,"_20936":57755,"_5":14366,"_27421":57411,"_2948":57756},[],"Run the CA-to-KMS migration",{"_3464":2744,"_30135":2628,"_20936":57758,"_5":14366,"_27421":57411,"_2948":57759},[],"Receiver certificate verification",{"_3464":2745,"_30135":2628,"_20936":57761,"_5":14366,"_27421":57411,"_2948":57762},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3464":2746,"_30135":2628,"_20936":57764,"_5":14366,"_27421":57411,"_2948":57765},[],"Medium: credentials go to an unverified receiver",{"_3464":2747,"_30135":2628,"_20936":57767,"_5":14366,"_27421":57411,"_2948":57768},[],"Set `insecure_skip_verify` to `false`",{"_3464":2748,"_30135":2628,"_20936":57770,"_5":14366,"_27421":57411,"_2948":57476},[],{"_3464":2749,"_30135":2628,"_20936":57772,"_5":14366,"_27421":57411,"_2948":57773},[],"Scripts and consoles that edit DMSs through the API",{"_3464":2750,"_30135":2628,"_20936":57775,"_5":14366,"_27421":57411,"_2948":57776},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3464":2751,"_30135":2628,"_20936":57778,"_5":14366,"_27421":57411,"_2948":57779},[],"Read the DMS before editing and use the new field",{"_3464":2752,"_30135":2628,"_20936":57781,"_5":14366,"_27421":57411,"_2948":57496},[],{"_3464":2753,"_30135":2628,"_20936":57783,"_5":14366,"_27421":57411,"_2948":57784},[],"Clients that create or update CRL settings through the API",{"_3464":2754,"_30135":2628,"_20936":57786,"_5":14366,"_27421":57411,"_2948":57787},[],"Medium: requests with the old field return an error",{"_3464":2755,"_30135":2628,"_20936":57789,"_5":14366,"_27421":57411,"_2948":57790},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3464":2756,"_30135":2628,"_20936":57792,"_5":14366,"_27421":57411,"_2948":57504},[],{"_3464":2757,"_30135":2628,"_20936":57794,"_5":14366,"_27421":57411,"_2948":57795},[],"Alert subscriptions and consumers of the VA events",{"_3464":2758,"_30135":2628,"_20936":57797,"_5":14366,"_27421":57411,"_2948":57798},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3464":2759,"_30135":2628,"_20936":57800,"_5":14366,"_27421":57411,"_2948":57801},[],"Review conditions filtering on the old event payload or subject",{"_3464":2760,"_30135":2628,"_20936":57803,"_5":14366,"_27421":57411,"_2948":57492},[],{"_3464":2761,"_30135":2628,"_20936":57805,"_5":14366,"_27421":57411,"_2948":57806},[],"Consumers that read the device `events` field",{"_3464":2762,"_30135":2628,"_20936":57808,"_5":14366,"_27421":57411,"_2948":57809},[],"Medium: the field disappears",{"_3464":2763,"_30135":2628,"_20936":57811,"_5":14366,"_27421":57411,"_2948":57812},[],"Use the new event endpoints",{"_3464":2764,"_30135":2628,"_20936":57814,"_5":14366,"_27421":57411,"_2948":57512},[],{"_3464":2765,"_30135":2628,"_20936":57816,"_5":14366,"_27421":57411,"_2948":57817},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3464":2766,"_30135":2628,"_20936":57819,"_5":14366,"_27421":57411,"_2948":57820},[],"Medium: the VA migration aborts",{"_3464":2767,"_30135":2628,"_20936":57822,"_5":14366,"_27421":57411,"_2948":57823},[],"Fix the affected roles before upgrading",{"_3464":2768,"_30135":2628,"_20936":57825,"_5":14366,"_27421":57411,"_2948":57444},[],{"_3464":2769,"_30135":2628,"_20936":57827,"_5":14366,"_27421":57411,"_2948":57828},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3464":2770,"_30135":2628,"_20936":57830,"_5":14366,"_27421":57411,"_2948":57831},[],"Low to medium: validation errors or changed defaults",{"_3464":2771,"_30135":2628,"_20936":57833,"_5":14366,"_27421":57411,"_2948":57834},[],"Update the values file",{"_3464":2772,"_30135":2628,"_20936":57836,"_5":14366,"_27421":57411,"_2948":57484},[],{"_3464":2773,"_30135":2628,"_20936":57838,"_5":14366,"_27421":57411,"_2948":57839},[],"Clients that send the DMS ID in the update body",{"_3464":2774,"_30135":2628,"_20936":57841,"_5":14366,"_27421":57411,"_2948":57842},[],"Low: the ID in the URL wins",{"_3464":2775,"_30135":2628,"_20936":57844,"_5":14366,"_27421":57411,"_2948":57845},[],"Send the ID in the URL",{"_3464":2776,"_30135":2628,"_20936":57847,"_5":14366,"_27421":57411,"_2948":57508},[],{"_3464":2777,"_30135":2628,"_20936":57849,"_5":14366,"_27421":57411,"_2948":57850},[],"Clients that send an `id` when creating or importing CAs",{"_3464":2778,"_30135":2628,"_20936":57852,"_5":14366,"_27421":57411,"_2948":57853},[],"Low: the ID in the body is ignored, and the field is removed",{"_3464":2779,"_30135":2628,"_20936":57855,"_5":14366,"_27421":57411,"_2948":57856},[],"Let the backend assign the ID and use the returned one",{"_3464":2780,"_30135":2628,"_20936":57858,"_5":14366,"_27421":57411,"_2948":57488},[],{"_3464":2781,"_30135":2628,"_20936":57860,"_5":14366,"_27421":57411,"_2948":57861},[],"Consumers that match on certificate `type`",{"_3464":2782,"_30135":2628,"_20936":57863,"_5":14366,"_27421":57411,"_2948":57864},[],"Low: two values are renamed",{"_3464":2783,"_30135":2628,"_20936":57866,"_5":14366,"_27421":57411,"_2948":57867},[],"Adapt consumers",{"_3464":2784,"_30135":2628,"_20936":57869,"_5":14366,"_27421":57411,"_2948":57480},[],{"_3464":2785,"_30135":2628,"_20936":57871,"_5":14366,"_27421":57411,"_2948":57872},[],"Any DMS",{"_3464":2786,"_30135":2628,"_20936":57874,"_5":14366,"_27421":57411,"_2948":57875},[],"Low: informational",{"_3464":2787,"_30135":2628,"_20936":57877,"_5":14366,"_27421":57411,"_2948":57878},[],"Read both blocks before editing",{"_3464":2788,"_30135":2628,"_20936":57880,"_5":14366,"_27421":57419,"_2948":57881},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3464":2789,"_30135":2628,"_20936":57883,"_5":14366,"_27421":57419,"_2948":57884},[],"Step 4 of the migration guide copies the data.",{"_3464":2790,"_30135":2628,"_20936":57886,"_5":14366,"_27421":57423,"_2948":57887},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3464":2791,"_30135":2628,"_20936":57889,"_5":14366,"_27421":57427,"_2948":57890},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3464":2792,"_30135":2628,"_20936":57892,"_5":14366,"_27421":57431,"_2948":57893},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3464":2793,"_30135":2628,"_20936":57895,"_5":14366,"_27421":57435,"_2948":57896},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3464":2794,"_30135":2628,"_20936":57898,"_5":14366,"_27421":57435,"_2948":57899},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3464":2795,"_30135":2628,"_20936":57901,"_5":14366,"_27421":57439,"_2948":57902},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3464":2796,"_30135":2628,"_20936":57904,"_5":14366,"_27421":57443,"_2948":57905},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3464":2797,"_30135":2628,"_20936":57907,"_5":14366,"_27421":57443,"_2948":57908},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3464":2798,"_30135":2628,"_20936":57910,"_5":14366,"_27421":57443,"_2948":57911},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3464":2799,"_30135":2628,"_20936":57913,"_5":14366,"_27421":57443,"_2948":57914},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3464":2800,"_30135":2628,"_20936":57916,"_5":14366,"_27421":57443,"_2948":57917},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3464":2801,"_30135":2628,"_20936":57919,"_5":14366,"_27421":57443,"_2948":57920},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3464":2802,"_30135":2628,"_20936":57922,"_5":14366,"_27421":57451,"_2948":57923},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3464":2803,"_30135":2628,"_20936":57925,"_5":14366,"_27421":57451,"_2948":57926},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3464":2804,"_30135":2628,"_20936":57928,"_5":14366,"_27421":57451,"_2948":57929},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3464":2805,"_30135":2628,"_20936":57931,"_5":14366,"_27421":57451,"_2948":57932},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3464":2806,"_30135":2628,"_20936":57934,"_5":14366,"_27421":57451,"_2948":57935},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3464":2807,"_30135":2628,"_20936":57937,"_5":14366,"_27421":57455,"_2948":57938},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3464":2808,"_30135":2628,"_20936":57940,"_5":14366,"_27421":57459,"_2948":57941},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3464":2809,"_30135":2628,"_20936":57943,"_5":14366,"_27421":57459,"_2948":57944},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3464":2810,"_30135":2628,"_20936":57946,"_5":14366,"_27421":57459,"_2948":57947},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3464":2811,"_30135":2628,"_20936":57949,"_5":14366,"_27421":57459,"_2948":57950},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3464":2812,"_30135":2628,"_20936":57952,"_5":14366,"_27421":57459,"_2948":57953},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3464":2813,"_30135":2628,"_20936":57955,"_5":14366,"_27421":57459,"_2948":57956},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3464":2814,"_30135":2628,"_20936":57958,"_5":14366,"_27421":57459,"_2948":57959},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3464":2815,"_30135":2628,"_20936":57961,"_5":14366,"_27421":57459,"_2948":57962},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3464":2816,"_30135":2628,"_20936":57964,"_5":14366,"_27421":57463,"_2948":57965},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3464":2817,"_30135":2628,"_20936":57967,"_5":14366,"_27421":57471,"_2948":57968},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3464":2818,"_30135":2628,"_20936":57970,"_5":14366,"_27421":57471,"_2948":57971},[],"Field in 3.8.0",{"_3464":2819,"_30135":2628,"_20936":57973,"_5":14366,"_27421":57471,"_2948":57974},[],"Field in 4.0.0",{"_3464":2820,"_30135":2628,"_20936":57976,"_5":14366,"_27421":57471,"_2948":57977},[],"`validate_server_cert`",{"_3464":2821,"_30135":2628,"_20936":57979,"_5":14366,"_27421":57471,"_2948":57980},[],"`insecure_skip_verify` (value negated)",{"_3464":2822,"_30135":2628,"_20936":57982,"_5":14366,"_27421":57471,"_2948":57983},[],"`oidc`",{"_3464":2823,"_30135":2628,"_20936":57985,"_5":14366,"_27421":57471,"_2948":57986},[],"`jwt_options`",{"_3464":2824,"_30135":2628,"_20936":57988,"_5":14366,"_27421":57471,"_2948":57989},[],"`apikey`",{"_3464":2825,"_30135":2628,"_20936":57991,"_5":14366,"_27421":57471,"_2948":57992},[],"`apikey_options`",{"_3464":2826,"_30135":2628,"_20936":57994,"_5":14366,"_27421":57471,"_2948":57995},[],"`mtls`",{"_3464":2827,"_30135":2628,"_20936":57997,"_5":14366,"_27421":57471,"_2948":57998},[],"`mtls_options`",{"_3464":2828,"_30135":2628,"_20936":58000,"_5":14366,"_27421":57471,"_2948":58001},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3464":2829,"_30135":2628,"_20936":58003,"_5":14366,"_27421":57471,"_2948":58004},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3464":2830,"_30135":2628,"_20936":58006,"_5":14366,"_27421":57471,"_2948":58007},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3464":2831,"_30135":2628,"_20936":58009,"_5":14366,"_27421":57475,"_2948":58010},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3464":2832,"_30135":2628,"_20936":58012,"_5":14366,"_27421":57475,"_2948":58013},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3464":2833,"_30135":2628,"_20936":58015,"_5":14366,"_27421":57475,"_2948":58016},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3464":2834,"_30135":2628,"_20936":58018,"_5":14366,"_27421":57479,"_2948":58019},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3464":2835,"_30135":2628,"_20936":58021,"_5":14366,"_27421":57483,"_2948":58022},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3464":2836,"_30135":2628,"_20936":58024,"_5":14366,"_27421":57487,"_2948":58025},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3464":2837,"_30135":2628,"_20936":58027,"_5":14366,"_27421":57491,"_2948":58028},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3464":2838,"_30135":2628,"_20936":58030,"_5":14366,"_27421":57491,"_2948":58031},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3464":2839,"_30135":2628,"_20936":58033,"_5":14366,"_27421":57491,"_2948":58034},[],"`POST /v1/devices/:id/events` creates an event.",{"_3464":2840,"_30135":2628,"_20936":58036,"_5":14366,"_27421":57491,"_2948":58037},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3464":2841,"_30135":2628,"_20936":58039,"_5":14366,"_27421":57495,"_2948":58040},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3464":2842,"_30135":2628,"_20936":58042,"_5":14366,"_27421":57499,"_2948":58043},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3464":2843,"_30135":2628,"_20936":58045,"_5":14366,"_27421":57499,"_2948":58046},[],"Route",{"_3464":2844,"_30135":2628,"_20936":58048,"_5":14366,"_27421":57499,"_2948":52437},[],{"_3464":2845,"_30135":2628,"_20936":58050,"_5":14366,"_27421":57499,"_2948":58051},[],"`GET /v1/crl-settings`",{"_3464":2846,"_30135":2628,"_20936":58053,"_5":14366,"_27421":57499,"_2948":58054},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3464":2847,"_30135":2628,"_20936":58056,"_5":14366,"_27421":57499,"_2948":58057},[],"`GET /v1/crl-settings/{ca-id}`",{"_3464":2848,"_30135":2628,"_20936":58059,"_5":14366,"_27421":57499,"_2948":58060},[],"Reads the settings of a CA.",{"_3464":2849,"_30135":2628,"_20936":58062,"_5":14366,"_27421":57499,"_2948":58063},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3464":2850,"_30135":2628,"_20936":58065,"_5":14366,"_27421":57499,"_2948":58066},[],"Replaces `crl_options`.",{"_3464":2851,"_30135":2628,"_20936":58068,"_5":14366,"_27421":57499,"_2948":58069},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3464":2852,"_30135":2628,"_20936":58071,"_5":14366,"_27421":57499,"_2948":58072},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3464":2853,"_30135":2628,"_20936":58074,"_5":14366,"_27421":57499,"_2948":58075},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3464":2854,"_30135":2628,"_20936":58077,"_5":14366,"_27421":57499,"_2948":58078},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3464":2855,"_30135":2628,"_20936":58080,"_5":14366,"_27421":57499,"_2948":58081},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3464":2856,"_30135":2628,"_20936":58083,"_5":14366,"_27421":57499,"_2948":58084},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3464":2857,"_30135":2628,"_20936":58086,"_5":14366,"_27421":57499,"_2948":58087},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3464":2858,"_30135":2628,"_20936":58089,"_5":14366,"_27421":57499,"_2948":58090},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3464":2859,"_30135":2628,"_20936":58092,"_5":14366,"_27421":57499,"_2948":58093},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3464":2860,"_30135":2628,"_20936":58095,"_5":14366,"_27421":57499,"_2948":58096},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3464":2861,"_30135":2628,"_20936":58098,"_5":14366,"_27421":57499,"_2948":58099},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3464":2862,"_30135":2628,"_20936":58101,"_5":14366,"_27421":57503,"_2948":58102},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3464":2863,"_30135":2628,"_20936":58104,"_5":14366,"_27421":57507,"_2948":58105},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3464":2864,"_30135":2628,"_20936":58107,"_5":14366,"_27421":57511,"_2948":58108},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3464":2865,"_30135":2628,"_20936":58110,"_5":14366,"_27421":57515,"_2948":58111},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3464":2866,"_30135":2628,"_20936":58113,"_5":14366,"_27421":57519,"_2948":58114},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3464":2867,"_30135":2628,"_20936":58116,"_5":14366,"_27421":57519,"_2948":58117},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3464":2868,"_30135":2628,"_20936":58119,"_5":14366,"_27421":57519,"_2948":58120},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3464":2869,"_30135":2628,"_20936":58122,"_5":14366,"_27421":57519,"_2948":58123},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3464":2870,"_30135":2628,"_20936":58125,"_5":14366,"_27421":57519,"_2948":58126},[],"Record the names of your local-storage PVCs:",{"_3464":2871,"_30135":2628,"_20936":58128,"_5":14366,"_27421":57519,"_2948":58129},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3464":2872,"_30135":2628,"_20936":58131,"_5":14366,"_27421":57523,"_2948":58132},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3464":2873,"_30135":2628,"_20936":58134,"_5":14366,"_27421":57523,"_2948":58135},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3464":2874,"_30135":2628,"_20936":58137,"_5":14366,"_27421":57523,"_2948":58138},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3464":2875,"_30135":2628,"_20936":58140,"_5":14366,"_27421":57523,"_2948":58141},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3464":2876,"_30135":2628,"_20936":58143,"_5":14366,"_27421":57523,"_2948":58144},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3464":2877,"_30135":2628,"_20936":58146,"_5":14366,"_27421":57527,"_2948":58147},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3464":2878,"_30135":2628,"_20936":58149,"_5":14366,"_27421":57527,"_2948":58150},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3464":2879,"_30135":2628,"_20936":58152,"_5":14366,"_27421":57527,"_2948":58153},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3464":2880,"_30135":2628,"_20936":58155,"_5":14366,"_27421":57527,"_2948":58156},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3464":2881,"_30135":2628,"_20936":58158,"_5":14366,"_27421":57527,"_2948":58159},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3464":2882,"_30135":2628,"_20936":58161,"_5":14366,"_27421":57527,"_2948":58162},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3464":2883,"_30135":2628,"_20936":58164,"_5":14366,"_27421":57527,"_2948":58165},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3464":2884,"_30135":2628,"_20936":58167,"_5":14366,"_27421":57527,"_2948":58168},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3464":2885,"_30135":2628,"_20936":58170,"_5":14366,"_27421":57527,"_2948":58171},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3464":2886,"_30135":2628,"_20936":58173,"_5":14366,"_27421":57527,"_2948":58174},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3464":2887,"_30135":2628,"_20936":58176,"_5":14366,"_27421":57527,"_2948":58177},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3464":2888,"_30135":2628,"_20936":58179,"_5":14366,"_27421":57527,"_2948":58180},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3464":2889,"_30135":2628,"_20936":58182,"_5":14366,"_27421":57531,"_2948":58183},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3464":2890,"_30135":2628,"_20936":58185,"_5":14366,"_27421":57531,"_2948":58186},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3464":2891,"_30135":2628,"_20936":58188,"_5":14366,"_27421":57535,"_2948":58189},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3464":2892,"_30135":2628,"_20936":58191,"_5":14366,"_27421":57535,"_2948":58192},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3464":2893,"_30135":2628,"_20936":58194,"_5":14366,"_27421":57535,"_2948":58195},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3464":2894,"_30135":2628,"_20936":58197,"_5":14366,"_27421":57535,"_2948":58198},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3464":2895,"_30135":2628,"_20936":58200,"_5":14366,"_27421":57535,"_2948":58201},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3464":2896,"_30135":2628,"_20936":58203,"_5":14366,"_27421":57535,"_2948":58204},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3464":2897,"_30135":2628,"_20936":58206,"_5":14366,"_27421":57535,"_2948":58207},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3464":2898,"_30135":2628,"_20936":58209,"_5":14366,"_27421":57535,"_2948":58210},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3464":2899,"_30135":2628,"_20936":58212,"_5":14366,"_27421":57535,"_2948":58213},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3464":2900,"_30135":2628,"_20936":58215,"_5":14366,"_27421":57535,"_2948":58216},[],"**Remove the helper and restore the recorded replica counts:**",{"_3464":2901,"_30135":2628,"_20936":58218,"_5":14366,"_27421":57535,"_2948":58219},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3464":2902,"_30135":2628,"_20936":58221,"_5":14366,"_27421":57539,"_2948":58222},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3464":2903,"_30135":2628,"_20936":58224,"_5":14366,"_27421":57539,"_2948":58225},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3464":2904,"_30135":2628,"_20936":58227,"_5":14366,"_27421":57543,"_2948":58228},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3464":2905,"_30135":2628,"_20936":58230,"_5":14366,"_27421":57543,"_2948":58231},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3464":2906,"_30135":2628,"_20936":58233,"_5":14366,"_27421":57543,"_2948":58234},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3464":2907,"_30135":2628,"_20936":58236,"_5":14366,"_27421":57543,"_2948":58237},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3464":2908,"_30135":2628,"_20936":58239,"_5":14366,"_27421":57543,"_2948":58240},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3464":2909,"_30135":2628,"_20936":58242,"_5":14366,"_27421":57543,"_2948":58243},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3464":2910,"_30135":2628,"_20936":58245,"_5":14366,"_27421":57543,"_2948":58246},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3464":2911,"_30135":2628,"_20936":58248,"_5":14366,"_27421":57543,"_2948":58249},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3464":2912,"_30135":2628,"_20936":58251,"_5":14366,"_27421":57547,"_2948":58252},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3464":2913,"_30135":2628,"_20936":58254,"_5":14366,"_27421":57547,"_2948":58255},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3464":2914,"_30135":2628,"_20936":58257,"_5":14366,"_27421":57547,"_2948":58258},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3464":2915,"_30135":2628,"_20936":58260,"_5":14366,"_27421":57547,"_2948":58261},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3464":2916,"_30135":2628,"_20936":58263,"_5":14366,"_27421":57547,"_2948":58264},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3464":2917,"_30135":2628,"_20936":58266,"_5":14366,"_27421":57547,"_2948":58267},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3464":2918,"_30135":2628,"_20936":58269,"_5":14366,"_27421":57547,"_2948":58270},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3464":2919,"_30135":2628,"_20936":58272,"_5":14366,"_27421":57547,"_2948":58273},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3464":2920,"_30135":2628,"_20936":58275,"_5":14366,"_27421":57547,"_2948":58276},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3464":2921,"_30135":2628,"_20936":58278,"_5":14366,"_27421":57547,"_2948":58279},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3464":2922,"_30135":2628,"_20936":58281,"_5":14366,"_27421":57547,"_2948":58282},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3464":2923,"_30135":2628,"_20936":58284,"_5":14366,"_27421":57550,"_2948":58285},[],"After the upgrade, check in this order:",{"_3464":2924,"_30135":2628,"_20936":58287,"_5":14366,"_27421":57550,"_2948":58288},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3464":2925,"_30135":2628,"_20936":58290,"_5":14366,"_27421":57550,"_2948":58291},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3464":2926,"_30135":2628,"_20936":58293,"_5":14366,"_27421":57550,"_2948":58294},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3464":2927,"_30135":2628,"_20936":58296,"_5":14366,"_27421":57550,"_2948":58297},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3464":2928,"_30135":2628,"_20936":58299,"_5":14366,"_27421":57550,"_2948":58300},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3464":2929,"_30135":2628,"_20936":58302,"_5":14366,"_27421":57550,"_2948":58303},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3464":2930,"_30135":2628,"_20936":58305,"_5":14366,"_27421":57550,"_2948":58306},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3464":2931,"_30135":2628,"_20936":58308,"_5":14366,"_27421":57550,"_2948":58309},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3464":2932,"_30135":2628,"_20936":58311,"_5":14366,"_27421":57550,"_2948":58312},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3464":2933,"_30135":2628,"_20936":58314,"_5":14366,"_27421":57550,"_2948":58315},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3464":2934,"_30135":2628,"_20936":58317,"_5":14366,"_27421":57550,"_2948":58318},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3464":2935,"_30135":2628,"_20936":58320,"_5":14366,"_27421":57550,"_2948":58321},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3464":2936,"_30135":2628,"_20936":58323,"_5":14366,"_27421":57550,"_2948":58324},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3464":2937,"_30135":2628,"_20936":58326,"_5":14366,"_27421":57550,"_2948":58327},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3464":2938,"_30135":2628,"_20936":58329,"_5":14366,"_27421":57550,"_2948":58330},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3464":2939,"_30135":2628,"_20936":58332,"_5":14366,"_27421":57554,"_2948":58333},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3464":2940,"_30135":2628,"_20936":58335,"_5":14366,"_27421":57554,"_2948":58336},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3464":2941,"_30135":2628,"_20936":58338,"_5":14366,"_27421":57554,"_2948":58339},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3464":2942,"_30135":2628,"_20936":58341,"_5":14366,"_27421":57554,"_2948":58342},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3464":2943,"_30135":2628,"_20936":58344,"_5":14366,"_27421":57554,"_2948":58345},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58348":58349,"_58350":58351,"_58352":58353,"_58354":58355,"_18137":2983,"_70085":2983},"language","english","sortableProperties",[2948,30135,5,27421],"sortablePropertiesWithTypes",{"_2948":25002,"_30135":25002,"_5":25002,"_27421":25002},"sorts",{"_2948":58356,"_30135":61289,"_5":64221,"_27421":67153},{"_4644":58357,"_58358":58359,"_5":25002},{"_14442":4182,"_14823":22549,"_14842":3203,"_29138":3645,"_14829":5053,"_19859":6463,"_14463":25164,"_14470":3434,"_29080":3437,"_29489":6995,"_29510":4621,"_29114":4709,"_34489":5956,"_29217":7496,"_29554":4935,"_34496":4786,"_34499":10122,"_34502":7632,"_34505":12432,"_29961":3666,"_34510":4001,"_34512":3252,"_29991":4574,"_14838":18151,"_34516":3329,"_34519":7531,"_34521":6190,"_29538":7599,"_29956":3365,"_30004":4985,"_34526":3093,"_34528":3339,"_34530":7474,"_29234":3048,"_34533":6688,"_34535":7544,"_34537"